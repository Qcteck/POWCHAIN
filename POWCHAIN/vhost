.dataLabel{color:#aaa}
#log{background:#000;border:1px solid #333;border-radius:8px;margin-top:20px;padding:10px;height:150px;overflow:auto;font-size:12px;color:#ccc;white-space:pre}
#blkOut{background:#000;border:1px solid #333;border-radius:6px;padding:8px;margin-top:8px;font-size:12px;white-space:pre;max-height:200px;overflow:auto}
.badge{display:inline-block;padding:2px 6px;border-radius:4px;font-size:11px;border:1px solid #555;background:#222}
</style>
<script>window.history.replaceState(null,null,'/?v='+(Date.now()));</script>
</head>
<body>

<div id="top">FIREINNERS / POWCHAIN — Wallet • Bridge • Stats • DEX</div>

<div id="wrap">

<!-- 1. Connexion Phantom -->
<div class="card">
<h2>1. Connexion Phantom (Solana)</h2>
<button id="btnPhantom">Connecter Phantom</button>

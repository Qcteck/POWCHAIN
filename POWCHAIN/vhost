server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /root/powchain;
    index index.html;

    # Page d'accueil BBQ Finance / POWCHAIN
    location / {
        try_files $uri /index.html;
    }

    # Stats POWCHAIN → ton server.js sur le port 3000
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket POWCHAIN (port 7001)
    location /ws {
        proxy_pass http://127.0.0.1:7001/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# 1. Éditer la config nginx
sudo nano /etc/nginx/sites-available/bbqfinance
# (coller le bloc ci-dessus, sauvegarder: Ctrl+O, Enter, puis Ctrl+X)

# 2. Vérifier la config
sudo nginx -t

# 3. Redémarrer nginx
sudo systemctl restart nginx

# 4. Test local HTTP → doit répondre 301 vers https://bbqfinance.fun/
curl -I http://127.0.0.1

# 5. Test local HTTPS (sans certificat système) → doit répondre 200 OK
curl -I https://127.0.0.1 --insecure





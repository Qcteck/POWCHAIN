
cat /etc/wireguard/wg0.conf



altname enp0s18
nano /etc/wireguard/wg0.conf

[Interface]
Address = 10.66.66.1/24
ListenPort = 51820
PrivateKey = TA_CLE_PRIVEE_SERVEUR

PostUp = sysctl -w net.ipv4.ip_forward=1; iptables -t nat -A POSTROUTING -o enp0s18 -j MASQUERADE
PostDown = iptables -t nat -D POSTROUTING -o enp0s18 -j MASQUERADE


wg-quick down wg0 2>/dev/null
wg-quick up wg0
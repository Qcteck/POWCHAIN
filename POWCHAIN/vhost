server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    # API FIREINNERS (HTTP)
    location /stats    { proxy_pass http://127.0.0.1:3000/stats; }
    location /wallet   { proxy_pass http://127.0.0.1:3000; }
    location /bridge   { proxy_pass http://127.0.0.1:3000; }
    location /swap     { proxy_pass http://127.0.0.1:3000; }
    location /lp       { proxy_pass http://127.0.0.1:3000; }
    location /stake    { proxy_pass http://127.0.0.1:3000; }
    location /block    { proxy_pass http://127.0.0.1:3000; }
    location /mine     { proxy_pass http://127.0.0.1:3000; }
    location /mempool  { proxy_pass http://127.0.0.1:3000; }

    # WebSocket FIREINNERS (HTTP)
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600;
    }

    # Single page app
    location / {
        try_files $uri /index.html;
    }
}

server {
    listen 443 ssl http2;

nano /etc/nginx/sites-available/bbqfinance


server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    # Frontend POWCHAIN (index.html)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API HTTP POWCHAIN
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # WebSocket POWCHAIN → /ws
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
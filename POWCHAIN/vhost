<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>POWCHAIN — BBQFinance Dashboard</title>

  <!-- Styles -->
  <style>
    :root{
      --bg:#020b14;
      --bg2:#041221;
      --panel:#07192b;
      --accent:#38bdf8;
      --accent-soft:#0ea5e9;
      --danger:#f97373;
      --ok:#4ade80;
      --text:#e5f2ff;
      --muted:#94a3b8;
      --border:#0f1f35;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      padding:0;
      font-family:system-ui,-apple-system,Segoe UI,sans-serif;
      background:radial-gradient(circle at top,#0b1120,#020617 55%,#000 100%);
      color:var(--text);
      min-height:100vh;
    }
    #app{
      max-width:1240px;
      margin:0 auto;
      padding:18px 12px 28px;
    }
    header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:10px 14px;
      border-radius:10px;
      background:linear-gradient(135deg,#020617,#020b14 55%,#020617);
      border:1px solid #0b1120;
      box-shadow:0 0 28px #000c;
      margin-bottom:14px;
    }
    #logo{
      display:flex;
      align-items:center;
      gap:10px;
    }
    #logo span.icon{
      width:32px;height:32px;
      border-radius:50%;
      background:radial-gradient(circle,#38bdf8,#0f172a);
      box-shadow:0 0 16px #38bdf880;
    }
    #logo h1{
      font-size:18px;
      letter-spacing:2px;
      margin:0;
      text-transform:uppercase;
    }
    #logo small{
      display:block;
      color:var(--muted);
      font-size:11px;
      letter-spacing:1px;
    }
    #header-right{
      text-align:right;
      font-size:12px;
      color:var(--muted);
    }
    #status-dot{
      display:inline-block;
      width:8px;height:8px;
      border-radius:999px;
      background:var(--danger);
      margin-right:4px;
    }
    #status-dot.ok{background:var(--ok);box-shadow:0 0 8px #4ade8080;}
    main{
      display:grid;
      grid-template-columns:260px 1.4fr 1.1fr;
      gap:12px;
    }
    @media(max-width:1024px){
      main{grid-template-columns:1fr;grid-auto-rows:auto;}
    }
    .panel{
      background:radial-gradient(circle at top,#020617,#020b14 55%,#000 100%);
      border-radius:10px;
      border:1px solid var(--border);
      box-shadow:0 0 22px #000c;
      padding:10px 11px;
      font-size:13px;
    }
    .panel h2{
      font-size:13px;
      text-transform:uppercase;
      letter-spacing:1px;
      margin:0 0 8px;
      color:var(--accent);
    }
    .panel h2 span.sub{
      color:var(--muted);
      font-weight:400;
      text-transform:none;
      margin-left:6px;
      font-size:11px;
    }
    .row{
      display:flex;
      flex-wrap:wrap;
      gap:6px;
      margin-bottom:6px;
    }
    label{
      font-size:11px;
      color:var(--muted);
      display:block;
      margin-bottom:2px;
    }
    input,select,button,textarea{
      font-family:inherit;
      font-size:12px;
      border-radius:6px;
      border:1px solid #1f2937;
      background:#020617;
      color:var(--text);
      padding:6px 7px;
      outline:none;
    }
    input:focus,select:focus,textarea:focus{
      border-color:var(--accent);
      box-shadow:0 0 0 1px #38bdf820;
    }
    button{
      cursor:pointer;
      background:linear-gradient(135deg,var(--accent-soft),#0ea5e9);
      border:none;
      font-weight:600;
      letter-spacing:0.3px;
      transition:transform .08s ease,box-shadow .08s ease,filter .08s ease;
    }
    button:hover{
      filter:brightness(1.05);
      box-shadow:0 0 12px #38bdf880;
      transform:translateY(-1px);
    }
    button:disabled{
      opacity:.45;
      cursor:default;
      box-shadow:none;
      transform:none;
    }
    .btn-secondary{
      background:#020617;
      border:1px solid #1f2937;
      font-weight:500;
    }
    .tag{
      font-size:10px;
      padding:2px 6px;
      border-radius:999px;
      border:1px solid #1f2937;
      color:var(--muted);
      display:inline-flex;
      align-items:center;
      gap:4px;
    }
    .tag-dot{
      width:7px;height:7px;
      border-radius:999px;
      background:var(--danger);
    }
    .tag-dot.ok{background:var(--ok);}
    #phantom-status span.addr{
      font-family:ui-monospace,Menlo,Consolas,monospace;
      font-size:11px;
      color:var(--text);
    }
    .value{
      font-family:ui-monospace,Menlo,Consolas,monospace;
      font-size:12px;
    }
    #log{
      font-family:ui-monospace,Menlo,Consolas,monospace;
      background:#020617;
      border-radius:8px;
      border:1px solid #111827;
      padding:6px 7px;
      font-size:11px;
      color:#cbd5f5;
      height:200px;
      overflow-y:auto;
      white-space:pre-wrap;
    }
    .pill{
      display:inline-flex;
      align-items:center;
      gap:4px;
      padding:3px 7px;
      border-radius:999px;
      border:1px solid #1f2937;
      font-size:11px;
      color:var(--muted);
      margin-right:4px;
    }
    #stats-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:6px;
      margin-top:4px;
    }
    .stat-card{
      background:#020617;
      border-radius:8px;
      border:1px solid #111827;
      padding:6px 7px;
      font-size:11px;
    }
    .stat-label{
      color:var(--muted);
      margin-bottom:2px;
    }
    .stat-value{
      font-family:ui-monospace,Menlo,Consolas,monospace;
      font-size:13px;
    }
    #bridge-note{
      font-size:11px;
      color:var(--muted);
    }
    #charts{
      display:grid;
      grid-template-columns:1fr;
      gap:6px;
    }
    canvas{background:#020617;border-radius:8px;border:1px solid #111827;}
    a.inline{
      color:var(--accent);
      text-decoration:none;
      font-size:11px;
    }
    a.inline:hover{text-decoration:underline;}
  </style>

  <!-- Librairies externes pour Phantom + POWCHAIN -->
  <script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bs58@6.0.0/dist/bs58.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl-fast.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
<div id="app">
  <header>
    <div id="logo">
      <span class="icon"></span>
      <div>
        <h1>POWCHAIN — DASHBOARD</h1>
        <small>POW · USDC POW · Trésorerie · Bridge Solana</small>
      </div>
    </div>
    <div id="header-right">
      <div><span id="status-dot"></span><span id="status-text">Backend POWCHAIN : inconnu</span></div>
      <div style="margin-top:2px;font-size:11px;">Trésorerie : <span class="value" id="treasury-addr">BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy</span></div>
    </div>
  </header>

  <main>
    <!-- Colonne 1 : Solana / Phantom -->
    <section class="panel">
      <h2>Solana &amp; Phantom <span class="sub">SOL + USDC</span></h2>

      <div class="row">
        <button id="btn-phantom">Connecter Phantom</button>
      </div>
      <div id="phantom-status">
        <div class="pill"><span class="tag-dot" id="phantom-dot"></span><span id="phantom-label">Non connecté</span></div>
        <div style="margin-top:4px;font-size:11px;">Adresse : <span class="addr" id="phantom-addr">—</span></div>
      </div>

      <div style="margin-top:8px;">
        <div class="row">
          <div style="flex:1 1 45%;">
            <label>SOL disponible</label>
            <div class="value" id="bal-sol">?</div>
          </div>
          <div style="flex:1 1 45%;">
            <label>USDC (Solana)</label>
            <div class="value" id="bal-usdc">?</div>
          </div>
        </div>
      </div>

      <div style="margin-top:10px;">
        <button class="btn-secondary" id="btn-refresh-sol" style="width:100%;">Actualiser soldes</button>
      </div>

      <hr style="margin:10px 0;border-color:#111827;opacity:.7;">

      <h2>Wallet POWCHAIN <span class="sub">clé locale</span></h2>
      <div class="row">
        <button id="btn-generate" style="flex:1;">Générer un wallet POWCHAIN</button>
      </div>
      <div style="margin-top:6px;font-size:11px;">
        <label>Adresse publique POWCHAIN</label>
        <div class="value" id="pow-addr">—</div>
      </div>
      <div style="margin-top:6px;font-size:11px;">
        <label>Clé privée (garde-la hors ligne)</label>
        <textarea id="pow-priv" rows="3" readonly style="width:100%;resize:vertical;"></textarea>
      </div>
      <div style="margin-top:4px;font-size:10px;color:var(--muted);">
        Génération locale via ED25519 (tweetnacl) + base58. Aucune donnée envoyée au serveur.
      </div>
    </section>

    <!-- Colonne 2 : Stats POWCHAIN & Charts -->
    <section class="panel">
      <h2>État de la chaîne <span class="sub">/stats + WebSocket</span></h2>

      <div class="row" style="justify-content:space-between;align-items:center;">
        <button class="btn-secondary" id="btn-refresh-stats">Recharger /stats</button>
        <button id="btn-ws-toggle">Connexion WebSocket</button>
      </div>

      <div id="stats-summary" style="margin-top:6px;font-size:11px;">
        <span class="pill"><strong>Height</strong>: <span id="stat-height">?</span></span>
        <span class="pill"><strong>Supply POW</strong>: <span id="stat-supply-pow">?</span></span>
        <span class="pill"><strong>Supply USDC POW</strong>: <span id="stat-supply-usdc">?</span></span>
      </div>

      <div id="stats-grid">
        <div class="stat-card">
          <div class="stat-label">Dernier bloc</div>
          <div class="stat-value" id="stat-last-block">?</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Mempool</div>
          <div class="stat-value" id="stat-mempool">?</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">LP POW / USDC POW</div>
          <div class="stat-value" id="stat-lp">POW: ? · USDC POW: ?</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Tps approx.</div>
          <div class="stat-value" id="stat-tps">?</div>
        </div>
      </div>

      <div id="charts" style="margin-top:10px;">
        <div>
          <label>Graphique Supply POW / USDC POW</label>
          <canvas id="chart-supply" height="140"></canvas>
        </div>
        <div>
          <label>Graphique LP POW / USDC POW</label>
          <canvas id="chart-lp" height="140"></canvas>
        </div>
      </div>
    </section>

    <!-- Colonne 3 : Bridge & Journal -->
    <section class="panel">
      <h2>Bridge &amp; Trésorerie <span class="sub">Solana → POWCHAIN</span></h2>

      <div id="bridge-note">
        Phantom doit être connecté. Le bridge envoie une commande
        <code>BRIDGE_SOL</code> via WebSocket vers ton validateur POWCHAIN,
        et la trésorerie Solana reçoit les fonds.
      </div>

      <div style="margin-top:8px;">
        <label>Montant à bridger (en USDC sur Solana)</label>
        <input id="bridge-amount" type="number" min="0" step="0.01" placeholder="Ex: 25.0"/>
      </div>
      <div style="margin-top:6px;font-size:11px;">
        <label>Adresse trésorerie Solana (lecture seule)</label>
        <div class="value" id="treasury-sol">BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy</div>
      </div>
      <div class="row" style="margin-top:8px;">
        <button id="btn-bridge" style="flex:1;">Lancer le bridge</button>
      </div>

      <hr style="margin:10px 0;border-color:#111827;opacity:.7;">

      <h2>Journal temps réel <span class="sub">WebSocket</span></h2>
      <div id="log"></div>

      <div style="margin-top:6px;font-size:11px;color:var(--muted);">
        Chaque message JSON reçu du WebSocket est affiché ici.
        Les erreurs de parse sont catchées pour éviter le crash
        (<code>&lt;!doctype... is not valid JSON</code>).
      </div>

      <div style="margin-top:6px;font-size:11px;">
        <a class="inline" href="/stats" target="_blank">Ouvrir /stats brut</a>
      </div>
    </section>
  </main>
</div>

<script>
(function(){
  const logEl = document.getElementById("log");
  const statusDot = document.getElementById("status-dot");
  const statusText = document.getElementById("status-text");
  const treasuryAddrEl = document.getElementById("treasury-addr");
  const treasurySolEl = document.getElementById("treasury-sol");

  const PHANTOM_USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
  const RPC_SOL = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const TREASURY = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

  treasuryAddrEl.textContent = TREASURY;
  treasurySolEl.textContent = TREASURY;

  let ws = null;
  let wsConnected = false;
  let chartSupply = null;
  let chartLp = null;
  let powAddr = null;
  let powPriv = null;
  let phantomPubkey = null;

  function log(msg, type){
    const ts = new Date().toISOString().substring(11,19);
    const color = type==="err"?"#fca5a5":type==="ok"?"#4ade80":"#e5e7eb";
    const line = document.createElement("div");
    line.innerHTML = "<span style='color:#64748b'>["+ts+"]</span> <span style='color:"+color+"'>"+msg+"</span>";
    logEl.appendChild(line);
    logEl.scrollTop = logEl.scrollHeight;
  }

  function setBackendStatus(ok){
    if(ok){
      statusDot.classList.add("ok");
      statusText.textContent = "Backend POWCHAIN : en ligne (/stats OK)";
    }else{
      statusDot.classList.remove("ok");
      statusText.textContent = "Backend POWCHAIN : hors ligne ou invalide";
    }
  }

  // ---------- Stats /stats ----------
  async function loadStats(){
    try{
      log("Requête GET /stats ...");
      const res = await fetch("/stats",{cache:"no-store"});
      const ct = res.headers.get("content-type")||"";
      if(!res.ok){
        setBackendStatus(false);
        log("Réponse /stats non OK : "+res.status+" "+res.statusText,"err");
        return;
      }
      if(!ct.includes("application/json")){
        setBackendStatus(false);
        const text = await res.text();
        log("Erreur stats POWCHAIN : contenu non JSON (ct="+ct+")","err");
        log(text.slice(0,200)+" ...","err");
        return;
      }
      const data = await res.json();
      setBackendStatus(true);
      log("Stats POWCHAIN reçues.","ok");
      applyStats(data);
    }catch(e){
      setBackendStatus(false);
      log("Erreur /stats : "+e.message,"err");
    }
  }

  function safeNum(v){return typeof v==="number"&&isFinite(v)?v:null;}

  function applyStats(s){
    // Structure flexible : on s’adapte si certains champs manquent
    const h = document.getElementById("stat-height");
    const sp = document.getElementById("stat-supply-pow");
    const su = document.getElementById("stat-supply-usdc");
    const lb = document.getElementById("stat-last-block");
    const mp = document.getElementById("stat-mempool");
    const lp = document.getElementById("stat-lp");
    const tps = document.getElementById("stat-tps");

    const height = safeNum(s.height)||safeNum(s.blockHeight)||0;
    const powSupply = safeNum(s.supplyPOW)||safeNum(s.powSupply)||0;
    const usdcSupply = safeNum(s.supplyUSDCPow)||safeNum(s.usdcPowSupply)||0;
    const mempoolSize = safeNum(s.mempoolSize)||safeNum(s.mempool)||0;
    const lpPow = safeNum(s.lpPOW)||safeNum(s.lpPow)||0;
    const lpUsdc = safeNum(s.lpUSDC)||safeNum(s.lpUsdc)||0;
    const tpsVal = safeNum(s.tps)||safeNum(s.txPerSecond)||null;
    const lastHash = s.lastBlockHash||s.lastBlock||"—";

    h.textContent = height||"?";
    sp.textContent = powSupply.toLocaleString("en-US");
    su.textContent = usdcSupply.toLocaleString("en-US");
    lb.textContent = lastHash;
    mp.textContent = mempoolSize!=null?mempoolSize+" tx":"?";
    lp.textContent = "POW: "+lpPow+" · USDC POW: "+lpUsdc;
    tps.textContent = tpsVal!=null?tpsVal.toFixed(2):"?";

    updateCharts(powSupply,usdcSupply,lpPow,lpUsdc);
  }

  function createDoughnut(ctx,labels,data){
    return new Chart(ctx,{
      type:"doughnut",
      data:{
        labels:labels,
        datasets:[{
          data:data,
          borderWidth:1
        }]
      },
      options:{
        responsive:true,
        plugins:{
          legend:{labels:{color:"#e5f2ff",font:{size:11}}},
        }
      }
    });
  }

  function updateCharts(sPow,sUsdc,lpPow,lpUsdc){
    const ctx1 = document.getElementById("chart-supply").getContext("2d");
    const ctx2 = document.getElementById("chart-lp").getContext("2d");

    if(chartSupply){chartSupply.destroy();}
    if(chartLp){chartLp.destroy();}

    const totalSupply = (sPow||0)+(sUsdc||0)||1;
    const totalLp = (lpPow||0)+(lpUsdc||0)||1;

    chartSupply = createDoughnut(ctx1,["POW","USDC POW"],[
      sPow||0,
      sUsdc||0
    ]);
    chartLp = createDoughnut(ctx2,["LP POW","LP USDC POW"],[
      lpPow||0,
      lpUsdc||0
    ]);
  }

  // ---------- WebSocket ----------
  function wsUrl(){
    if(location.protocol==="https:"){
      return "wss://"+location.host+"/ws";
    }
    return "ws://"+location.host+"/ws";
  }

  function connectWs(){
    if(ws){try{ws.close();}catch(e){}}
    const url = wsUrl();
    log("Connexion WebSocket en cours... ("+url+")");
    ws = new WebSocket(url);

    ws.onopen = ()=>{
      wsConnected = true;
      log("WebSocket connecté.","ok");
      document.getElementById("btn-ws-toggle").textContent="Déconnecter WS";
    };
    ws.onclose = ()=>{
      wsConnected = false;
      log("WebSocket fermé.","err");
      document.getElementById("btn-ws-toggle").textContent="Connexion WebSocket";
    };
    ws.onerror = (e)=>{
      log("Erreur WS: "+(e.message||"inconnue"),"err");
    };
    ws.onmessage = (ev)=>{
      const text = typeof ev.data==="string"?ev.data:"[binary "+ev.data.byteLength+" bytes]";
      let parsed = null;
      try{
        parsed = JSON.parse(text);
      }catch(e){
        log("Message non JSON reçu (ignoré) : "+text.slice(0,120)+" ...","err");
        return;
      }
      log("WS → "+JSON.stringify(parsed));
      if(parsed.type==="statsUpdate" && parsed.payload){
        applyStats(parsed.payload);
      }
    };
  }

  function wsSend(obj){
    if(!wsConnected || !ws || ws.readyState!==1){
      log("Impossible d'envoyer : WebSocket non connecté","err");
      return;
    }
    try{
      const text = JSON.stringify(obj);
      ws.send(text);
      log("WS ← "+text,"ok");
    }catch(e){
      log("Erreur envoi WS : "+e.message,"err");
    }
  }

  // ---------- Générateur POWCHAIN ----------
  function generatePowWallet(){
    try{
      if(!window.nacl || !window.bs58){
        alert("Librairies cryptographiques non chargées.");
        return;
      }
      const pair = nacl.sign.keyPair();
      powAddr = bs58.encode(pair.publicKey);
      powPriv = bs58.encode(pair.secretKey);
      document.getElementById("pow-addr").textContent = powAddr;
      document.getElementById("pow-priv").value = powPriv;
      log("Nouveau wallet POWCHAIN généré.","ok");
    }catch(e){
      log("Erreur génération wallet POWCHAIN : "+e.message,"err");
    }
  }

  // ---------- Phantom / Solana ----------
  async function ensurePhantom(){
    const provider = window.phantom?.solana || window.solana;
    if(!provider){
      alert("Phantom n'est pas disponible dans ce navigateur.");
      return null;
    }
    if(!provider.isConnected){
      await provider.connect({onlyIfTrusted:false});
    }
    return provider;
  }

  async function connectPhantom(){
    try{
      const provider = await ensurePhantom();
      if(!provider)return;
      phantomPubkey = provider.publicKey.toBase58();
      document.getElementById("phantom-addr").textContent = phantomPubkey;
      document.getElementById("phantom-label").textContent = "Connecté";
      document.getElementById("phantom-dot").classList.add("ok");
      log("Phantom connecté : "+phantomPubkey,"ok");
      await refreshSolBalances();
    }catch(e){
      log("Erreur Phantom : "+e.message,"err");
    }
  }

  async function refreshSolBalances(){
    if(!phantomPubkey){
      log("Connecte Phantom d'abord.","err");
      return;
    }
    try{
      const conn = new solanaWeb3.Connection(RPC_SOL,"confirmed");
      const pub = new solanaWeb3.PublicKey(phantomPubkey);
      const lamports = await conn.getBalance(pub);
      const sol = lamports / solanaWeb3.LAMPORTS_PER_SOL;
      document.getElementById("bal-sol").textContent = sol.toFixed(4)+" SOL";

      const resp = await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(PHANTOM_USDC_MINT)});
      let usdc = 0;
      for(const a of resp.value){
        const info = a.account.data.parsed.info;
        const dec = info.tokenAmount.decimals;
        const ui = parseFloat(info.tokenAmount.uiAmountString||"0");
        if(!isNaN(ui))usdc += ui;
      }
      document.getElementById("bal-usdc").textContent = usdc.toFixed(2)+" USDC";

      log("Soldes Solana rafraîchis.","ok");
    }catch(e){
      log("Erreur lecture soldes Solana : "+e.message,"err");
    }
  }

  // ---------- Bridge ----------
  async function launchBridge(){
    const amtInput = document.getElementById("bridge-amount");
    const amount = parseFloat(amtInput.value.replace(",","."));
    if(!amount || amount<=0){
      alert("Montant invalide.");
      return;
    }
    if(!phantomPubkey){
      alert("Connecte Phantom avant de bridger.");
      return;
    }
    if(!powAddr){
      alert("Génère ou charge un wallet POWCHAIN d'abord.");
      return;
    }
    log("Préparation bridge SOL→POWCHAIN pour "+amount+" USDC ...");
    // Ici on envoie seulement la commande de bridge au validateur POWCHAIN.
    // La partie transaction Solana doit déjà être gérée côté serveur / validateur.
    wsSend({
      type:"BRIDGE_SOL",
      fromSol:phantomPubkey,
      toPow:powAddr,
      amount:amount,
      treasury:TREASURY
    });
  }

  // ---------- Wiring ----------
  document.getElementById("btn-refresh-stats").addEventListener("click",loadStats);
  document.getElementById("btn-ws-toggle").addEventListener("click",()=>{
    if(wsConnected){ if(ws) ws.close(); }
    else connectWs();
  });
  document.getElementById("btn-generate").addEventListener("click",generatePowWallet);
  document.getElementById("btn-phantom").addEventListener("click",connectPhantom);
  document.getElementById("btn-refresh-sol").addEventListener("click",refreshSolBalances);
  document.getElementById("btn-bridge").addEventListener("click",launchBridge);

  // Chargement initial
  loadStats();
  // Option : auto-connexion WS après 2s
  setTimeout(connectWs,2000);
})();
</script>
</body>
</html>
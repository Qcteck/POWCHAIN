cat > qplus.c <<'EOF'
__attribute__((used))
const unsigned char QPLUS_PUBKEY[32]={
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
};
float rho=0.5f,entropy=0.5f,coherence=0.5f,riskPenalty=0.0f;
static float clamp01(float v){if(v<0.0f)return 0.0f; if(v>1.0f)return 1.0f; return v;}
static int isfinitef(float x){return __builtin_isfinite(x);}
static float log2f_fast(float x){return __builtin_log(x)/__builtin_log(2.0f);}
static float entropy_calc(float p){if(p<=0.0f||p>=1.0f)return 0.0f;return -(p*log2f_fast(p)+(1.0f-p)*log2f_fast(1.0f-p));}
int step(float score,float risk,int arm){
  if(arm!=0 && arm!=1) return -4;
  if(!arm) return -1;
  if(!isfinitef(score)) return -2;
  if(!isfinitef(risk)) return -3;
  score=clamp01(score); risk=clamp01(risk);
  rho=clamp01(rho*0.7f+score*0.3f);
  entropy=entropy_calc(rho);
  coherence=clamp01(1.0f-entropy);
  riskPenalty=risk;
  return 0;
}
float get_rho(){return rho;}
float get_entropy(){return entropy;}
float get_coherence(){return coherence;}
float get_risk(){return riskPenalty;}
EOF

cat > signer.js <<'EOF'
const express=require("express");
const nacl=require("tweetnacl");
const PUB_HEX="PUB_HEX_ICI";
const PRIV_HEX="PRIV_HEX_ICI";
if(!/^[0-9a-f]{64}$/i.test(PUB_HEX)) throw new Error("PUB_HEX invalid (need 64 hex)");
if(!/^[0-9a-f]{128}$/i.test(PRIV_HEX)) throw new Error("PRIV_HEX invalid (need 128 hex)");
const SECRET=new Uint8Array(Buffer.from(PRIV_HEX,"hex"));
const app=express();
app.use(express.json({limit:"64kb"}));
app.use((req,res,next)=>{res.setHeader("cache-control","no-store");next();});
app.use(express.static("."));
app.get("/pub",(req,res)=>res.json({pubHex:PUB_HEX}));
app.post("/sign",(req,res)=>{
  const h=(req.body&&req.body.hashHex)||"";
  if(!/^[0-9a-f]{64}$/i.test(h)) return res.status(400).json({error:"bad hashHex"});
  const msg=new Uint8Array(Buffer.from(h,"hex"));
  const sig=nacl.sign.detached(msg,SECRET);
  res.json({sigHex:Buffer.from(sig).toString("hex")});
});
app.listen(8484,"0.0.0.0",()=>console.log("signer on http://0.0.0.0:8484"));
EOF


<script>
const API_BASE="/api";
const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR4ac";
let phantom=null, phantomPub=null;
let ws=null;
let currentFireAddr=null;

function log(msg){
  const el=document.getElementById("log");
  const now=new Date();
  const t=now.toTimeString().slice(0,8);
  el.textContent+="["+t+"] "+msg+"\\n";
  el.scrollTop=el.scrollHeight;
}

function setWSStatus(ok){
  const b=document.getElementById("wsBadge");
  if(ok){b.textContent="WS: online";b.classList.add("ws-ok");b.classList.remove("ws-bad");}
  else{b.textContent="WS: offline";b.classList.add("ws-bad");b.classList.remove("ws-ok");}
}

function connectWS(){
  try{
    const url=(location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws";
    ws=new WebSocket(url);
    ws.onopen=()=>{setWSStatus(true);log("WS connectée");};
    ws.onclose=()=>{setWSStatus(false);log("WS fermée, reconnexion dans 3s...");setTimeout(connectWS,3000);};
    ws.onerror=()=>{setWSStatus(false);log("WS erreur.");};
    ws.onmessage=(ev)=>{
      try{
        const data=JSON.parse(ev.data);
        if(data.type==="clients"){
          document.getElementById("visitors").textContent=data.count||0;
        }
      }catch(e){}
    };
  }catch(e){
    setWSStatus(false);
    log("WS ERR: "+e.message);
  }
}

function randInt(min,max){return Math.floor(Math.random()*(max-min+1))+min;}
const letters="ABCDEFGHJKLMNPQRSTUVWXYZ";
const digits="123456789";
function randCode(len,chars){
  let s="";for(let i=0;i<len;i++)s+=chars[Math.floor(Math.random()*chars.length)];
  return s;
}
function pickColor(){
  const roll=Math.random()*100;
  if(roll<1)return "gold";
  if(roll<3)return "army";
  if(roll<5)return "multicolore";
  const cols=["vert","or","blanc","noir","rouge","argent","mauve","orange","gris","jaune","violet"];
  return cols[Math.floor(Math.random()*cols.length)];
}

function genFireWallet(){
  const addrLen=44;
  const privLen=88;
  const base58="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  let a="",p="";
  for(let i=0;i<addrLen;i++)a+=base58[Math.floor(Math.random()*base58.length)];
  for(let i=0;i<privLen;i++)p+=base58[Math.floor(Math.random()*base58.length)];
  document.getElementById("fireAddr").value=a;
  document.getElementById("firePriv").value=p;
  currentFireAddr=a;
  const code1=randCode(1,digits)+randCode(1,letters)+randCode(1,digits)+randCode(1,letters);
  const code2=randCode(1,letters)+randCode(1,digits)+randCode(1,letters)+randCode(1,digits);
  const num=randInt(1,100000000);
  const col=pickColor();
  const name=`441-FIRE-${code1}/inners/${code2}/1a${num}/${col}`;
  document.getElementById("fireName").textContent=name;
  updateQR();
  log("Nouveau wallet FIREINNERS généré.");
}

function updateQR(){
  const addr=document.getElementById("fireAddr").value;
  const img=document.getElementById("qrFire");
  if(!addr){img.src="";return;}
  const url="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data="+encodeURIComponent(addr);
  img.src=url;
}

function saveFire(){
  const addr=document.getElementById("fireAddr").value;
  const priv=document.getElementById("firePriv").value;
  const name=document.getElementById("fireName").textContent;
  if(!addr||!priv){log("Sauvegarde impossible: aucun wallet FIREINNERS.");return;}
  localStorage.setItem("fireinners_wallet",JSON.stringify({addr,priv,name}));
  log("Wallet FIREINNERS sauvegardé dans le navigateur.");
}
function loadFire(){
  const raw=localStorage.getItem("fireinners_wallet");
  if(!raw){log("Aucun wallet FIREINNERS trouvé dans le navigateur.");return;}
  try{
    const obj=JSON.parse(raw);
    document.getElementById("fireAddr").value=obj.addr||"";
    document.getElementById("firePriv").value=obj.priv||"";
    document.getElementById("fireName").textContent=obj.name||"";
    currentFireAddr=obj.addr||null;
    updateQR();
    log("Wallet FIREINNERS rechargé depuis localStorage.");
  }catch(e){
    log("Erreur de lecture du wallet FIREINNERS.");
  }
}

async function refreshFire(){
  try{
    if(!currentFireAddr){
      log("Refresh FIREINNERS: génère ou charge un wallet d'abord.");
      return;
    }
    const r=await fetch(API_BASE+"/wallet/"+encodeURIComponent(currentFireAddr));
    if(!r.ok)throw new Error("HTTP "+r.status);
    const j=await r.json();
    document.getElementById("firePow").value=j.pow||0;
    document.getElementById("fireUsdc").value=j.usdc||0;
    document.getElementById("fireStaked").value=j.staked||0;
    log("Solde FIREINNERS mis à jour.");
  }catch(e){
    log("FIREINNERS ERR: "+e.message);
  }
}

async function connectPhantom(){
  try{
    if(!window.solana || !window.solana.isPhantom){
      log("Phantom non détecté.");
      alert("Phantom non détecté dans ce navigateur.");
      return;
    }
    phantom=window.solana;
    const resp=await phantom.connect();
    phantomPub=resp.publicKey.toBase58();
    document.getElementById("solAddr").value=phantomPub;
    log("Phantom connecté : "+phantomPub);
    await refreshSolBalances();
  }catch(e){
    log("Phantom ERR: "+e.message);
  }
}

async function refreshSolBalances(){
  if(!phantomPub)return;
  try{
    const conn=new solanaWeb3.Connection(SOL_RPC,"confirmed");
    const pub=new solanaWeb3.PublicKey(phantomPub);
    const lamports=await conn.getBalance(pub);
    const sol=lamports/1e9;
    document.getElementById("solInfo").textContent="SOL: "+sol.toFixed(4)+" | USDC: (à venir)";
  }catch(e){
    log("Sol ERR : "+e.message);
  }
}

async function sendSol(){
  if(!phantomPub){log("Connecte Phantom avant le bridge.");return;}
  const amt=parseFloat(document.getElementById("bridgeAmount").value||"0");
  if(!(amt>0)){log("Montant SOL invalide.");return;}
  try{
    const conn=new solanaWeb3.Connection(SOL_RPC,"confirmed");
    const from=new solanaWeb3.PublicKey(phantomPub);
    const to=new solanaWeb3.PublicKey(document.getElementById("treasurySol").value.trim());
    const tx=new solanaWeb3.Transaction().add(
      solanaWeb3.SystemProgram.transfer({
        fromPubkey:from,
        toPubkey:to,
        lamports:Math.round(amt*1e9)
      })
    );
    tx.feePayer=from;
    const {blockhash}=await conn.getLatestBlockhash();
    tx.recentBlockhash=blockhash;
    const result=await phantom.signAndSendTransaction(tx);
    const sig=result.signature||result;
    document.getElementById("bridgeSig").value=sig;
    log("Bridge Phantom: TX envoyée, signature = "+sig);
  }catch(e){
    log("Bridge Phantom ERR : "+e.message);
  }
}

async function declareBridge(){
  if(!currentFireAddr){log("Déclare bridge: aucun wallet FIREINNERS sélectionné.");return;}
  const amt=parseFloat(document.getElementById("bridgeAmount").value||"0");
  const sig=document.getElementById("bridgeSig").value.trim();
  if(!(amt>0)){log("Montant SOL invalide.");return;}
  if(!sig){log("Aucune signature détectée pour le bridge.");return;}
  try{
    const body={addr:currentFireAddr,amount:amt,fromSol:phantomPub,txSig:sig};
    const r=await fetch(API_BASE+"/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    const j=await r.json();
    if(!j.ok){
      log("Bridge backend rejeté : "+(j.error||"inconnu"));
    }else{
      log("Bridge backend OK. POW crédité: "+j.credited);
      refreshFire();
    }
  }catch(e){
    log("Bridge backend ERR : "+e.message);
  }
}


// ---- NOUVEL ENDPOINT POUR L’EXPLORER ----
app.get("/block/:h", (req, res) => {
  const h = parseInt(req.params.h, 10);
  if (!h || h < 1) return res.status(400).json({ ok: false, error: "Invalid height" });
  const blk = state.chain.find(b => b.height === h);

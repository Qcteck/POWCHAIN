// ---- SIGN HELP ----
function signTxBase(payload){
  if(!fireAddr||!firePriv){
    alert("Wallet FIREINNERS requis");
    return null;
  }
  const msgObj={
    type:payload.type,
    from:fireAddr,
    to:payload.to||null,
    amount:payload.amount||null,
    token:payload.token||null,
    dir:payload.dir||null,
    nonce:fireNonce+1
  };
  const msg=new TextEncoder().encode(JSON.stringify(msgObj));
  const sk=b58dec(firePriv);
  const sig=nacl.sign.detached(msg,sk);
  return{tx:{...msgObj},sig:b58enc(sig)};
}

// ---- BRIDGE via PHANTOM ----
q("#btnBridgePhantom").onclick=async()=>{
  if(!solAddr){ alert("Connecte Phantom d'abord"); return; }
  if(!fireAddr){ alert("Génère un wallet FIREINNERS d'abord"); return; }
  const raw=q("#bridgeAmt").value.trim();
  const amt=parseFloat(raw);
  if(!raw||isNaN(amt)||amt<=0){
    log("Bridge erreur : montant SOL invalide");
    return;
  }
  try{
    const connection=new solanaWeb3.Connection(SOL_RPC,"confirmed");
    const fromPub=new solanaWeb3.PublicKey(solAddr);
    const toPub=new solanaWeb3.PublicKey("BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy");

    const { blockhash } = await connection.getLatestBlockhash();
    const tx=new solanaWeb3.Transaction({ recentBlockhash:blockhash, feePayer:fromPub });
    tx.add(
      solanaWeb3.SystemProgram.transfer({
        fromPubkey:fromPub,
        toPubkey:toPub,
        lamports:Math.floor(amt*1e9)
      })
    );

    const signed=await window.solana.signAndSendTransaction(tx);
    const txSig=signed.signature;
    log("Bridge TX envoyée sur Solana : "+txSig);

    const r=await fetch(`${API_BASE}/bridge`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:fireAddr,amount:amt,fromSol:solAddr,txSig})
    });
    const j=await r.json().catch(()=>({}));
    if(!r.ok||j.ok===false){
      log("Bridge backend erreur : "+(j.error||("HTTP "+r.status)));
      return;
    }
    log(`Bridge validé : ${j.solDetected} SOL → ${j.credited/DEC} FIRE crédités`);
    loadFireWallet();
  }catch(e){
    log("Bridge Phantom ERR : "+e.message);
  }
};


<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<title>FIREINNERS — Client Complet</title>
<style>
:root{
  --bg:#05070b;
  --card:#0b111c;
  --border:#222b37;
  --accent:#ffa726;
  --accent2:#f97316;
  --accent3:#22c55e;
  --text:#e5ecff;
  --sub:#94a3b8;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,sans-serif}
#shell{max-width:1200px;margin:20px auto;padding:0 16px}
#header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
#title{font-size:26px;font-weight:700;color:var(--accent)}
#badges span{display:inline-flex;align-items:center;border-radius:999px;font-size:13px;padding:4px 10px;margin-left:6px;background:#111827;border:1px solid #374151;color:var(--sub)}
.ind{width:8px;height:8px;border-radius:999px;margin-right:6px}
.ind.ok{background:var(--accent3)}
.ind.off{background:#ef4444}

/* Tabs */
#tabs{display:flex;gap:6px;margin-bottom:14px}
.tab-btn{flex:1;text-align:center;padding:8px 0;border-radius:8px;border:1px solid #1f2937;background:#020617;color:var(--sub);font-size:14px;cursor:pointer}
.tab-btn.active{background:var(--accent);color:#111827;border-color:var(--accent2);font-weight:600}

/* Panels */
.panel{display:none;border-radius:10px;border:1px solid var(--border);background:var(--card);padding:14px 16px;margin-bottom:12px;box-shadow:0 0 16px #000a}
.panel.active{display:block}
.panel h2{margin:0 0 10px;font-size:18px;color:var(--accent)}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px}
.card{border-radius:10px;border:1px solid #1f2933;background:#050814;padding:10px 12px}
.card h3{margin:0 0 8px;font-size:15px;color:var(--accent2)}
.label{font-size:13px;color:var(--sub)}
.val{color:#7dd3fc;font-weight:500}
.row{display:flex;gap:8px;flex-wrap:wrap}
button,input,select{background:#020617;border-radius:7px;border:1px solid #374151;color:var(--text);padding:7px 9px;font-size:14px;margin-top:4px}
button{cursor:pointer;background:linear-gradient(90deg,#f97316,#fbbf24);border-color:#f97316;color:#111827;font-weight:600}
button.secondary{background:#020617;color:var(--sub);border-color:#334155;font-weight:500}
button:active{transform:scale(.98)}
input,select{width:100%}
#log{white-space:pre-wrap;background:#020617;border-radius:8px;border:1px solid #1f2937;padding:10px;height:220px;overflow:auto;font-size:12px}
.tag{display:inline-block;font-size:11px;padding:2px 7px;border-radius:999px;background:#111827;border:1px solid #334155;color:var(--sub);margin-right:4px;margin-top:4px}
hr{border:none;border-top:1px solid #1f2937;margin:10px 0}
</style>
<script>
let ws=null,wsOk=false;

function log(t){
  const L=document.getElementById("log");
  L.textContent+=t+"\\n";
  L.scrollTop=L.scrollHeight;
}

async function api(path,body){
  try{
    const r=await fetch(path,{
      method:body?"POST":"GET",
      headers:{"Content-Type":"application/json"},
      body:body?JSON.stringify(body):undefined
    });
    return await r.json();
  }catch(e){
    log("API ERREUR "+path);
    return {};
  }
}

/* Tabs */
function setTab(id){
  document.querySelectorAll(".tab-btn").forEach(b=>b.classList.remove("active"));
  document.querySelectorAll(".panel").forEach(p=>p.classList.remove("active"));
  document.getElementById("tab-"+id).classList.add("active");
  document.getElementById("panel-"+id).classList.add("active");
}

/* WS */
function startWS(){
  ws=new WebSocket("wss://bbqfinance.fun/ws");
  ws.onopen=()=>{wsOk=true;updateNet();log("WS FIREINNERS connecté");};
  ws.onclose=()=>{wsOk=false;updateNet();log("WS déconnecté, retry dans 5s…");setTimeout(startWS,5000);};
  ws.onmessage=e=>log("WS> "+e.data);
}

function updateNet(){
  const api=document.getElementById("apiState");
  const w=document.getElementById("wsState");
  api.textContent="HTTP OK";
  w.textContent=wsOk?"WS OK":"WS OFF";
  w.style.color=wsOk?"#22c55e":"#ef4444";
  document.getElementById("dot-ws").className="ind "+(wsOk?"ok":"off");
}

/* Stats + Trésorerie */
async function loadStats(){
  const s=await api("/stats");
  document.getElementById("stHeight").textContent=s.height??0;
  document.getElementById("stWallets").textContent=s.wallets??0;
  document.getElementById("stMem").textContent=s.mempool??0;
  document.getElementById("stPow").textContent=s.totalPow??0;
  document.getElementById("stStk").textContent=s.totalStaked??0;
  document.getElementById("lpPow").textContent=s.lpPow??0;
  document.getElementById("lpUsdc").textContent=s.lpUsdc??0;
  document.getElementById("treSol").textContent=s.treasurySol??0;
  document.getElementById("treFire").textContent=s.treasuryFire??0;
  document.getElementById("treUsdc").textContent=s.treasuryUsdc??0;
  log("Stats / trésorerie mise à jour");
}

/* Wallet public (utilisateur) */
async function loadWallet(){
  const addr=document.getElementById("wAddr").value.trim();
  if(!addr){log("Adresse POWCHAIN requise");return;}
  const w=await api("/wallet?addr="+encodeURIComponent(addr));
  document.getElementById("wPow").textContent=w.pow??0;
  document.getElementById("wUsdc").textContent=w.usdc??0;
  document.getElementById("wStk").textContent=w.staked??0;
  document.getElementById("wNonce").textContent=w.nonce??0;
  log("Wallet chargé: "+addr);
}

/* TX */
async function sendTx(){
  const from=document.getElementById("wAddr").value.trim();
  const to=document.getElementById("txTo").value.trim();
  const amt=document.getElementById("txAmt").value;
  const tok=document.getElementById("txTok").value;
  if(!from||!to||!amt){log("TX incomplète");return;}
  const r=await api("/tx",{fromAddr:from,to,amount:amt,token:tok});
  log("TX envoyée: "+JSON.stringify(r));
}

/* LP */
async function addLP(){
  const f=document.getElementById("lpFireIn").value;
  const u=document.getElementById("lpUsdcIn").value;
  if(!f||!u){log("LP: valeurs manquantes");return;}
  const r=await api("/lp/add",{fire:f,usdc:u});
  log("LP ajoutée: "+JSON.stringify(r));
  loadStats();
}

/* Swap */
async function doSwap(){
  const dir=document.getElementById("swDir").value;
  const amt=document.getElementById("swAmt").value;
  if(!amt){log("Swap: montant manquant");return;}
  const r=await api("/swap",{dir,amount:amt});
  log("Swap: "+JSON.stringify(r));
  loadStats();
}

/* Stake */
async function stakeFire(){
  const amt=document.getElementById("stkAmt").value;
  if(!amt){log("Stake: montant manquant");return;}
  const r=await api("/stake",{amount:amt});
  log("Stake: "+JSON.stringify(r));
  loadStats();
}

/* Chain */
async function loadChain(){
  const c=await api("/chain/last");
  document.getElementById("lastBlock").textContent=c.height??0;
  log("Dernier bloc: "+JSON.stringify(c));
}

window.onload=()=>{
  setTab("overview");
  startWS();
  updateNet();
  loadStats();
  window.history.replaceState(null,null,'/?v='+(Date.now()));
};
</script>
</head>
<body>
<div id="shell">

  <div id="header">
    <div id="title">FIREINNERS — CLIENT COMPLET</div>
    <div id="badges">
      <span><span class="ind ok" id="dot-api"></span>Backend</span>
      <span><span class="ind off" id="dot-ws"></span>WS</span>
    </div>
  </div>

  <!-- Onglets -->
  <div id="tabs">
    <button id="tab-overview" class="tab-btn" onclick="setTab('overview')">Vue d'ensemble</button>
    <button id="tab-wallet" class="tab-btn" onclick="setTab('wallet')">Wallet</button>
    <button id="tab-dex" class="tab-btn" onclick="setTab('dex')">DEX & LP</button>
    <button id="tab-stake" class="tab-btn" onclick="setTab('stake')">Stake & Chaîne</button>
    <button id="tab-logs" class="tab-btn" onclick="setTab('logs')">Logs</button>
  </div>

  <!-- PANEL OVERVIEW -->
  <div id="panel-overview" class="panel">
    <div class="grid2">
      <div class="card">
        <h3>État réseau</h3>
        <div class="label">API HTTP :</div>
        <div class="val" id="apiState">-</div>
        <div class="label" style="margin-top:6px;">WebSocket :</div>
        <div class="val" id="wsState">-</div>
        <button class="secondary" style="margin-top:10px" onclick="loadStats()">Rafraîchir stats</button>
      </div>
      <div class="card">
        <h3>Trésorerie FIREINNERS</h3>
        <div class="label">SOL on-chain :</div>
        <div class="val" id="treSol">-</div>
        <div class="label" style="margin-top:4px;">FIRE en réserve :</div>
        <div class="val" id="treFire">-</div>
        <div class="label" style="margin-top:4px;">USDC FIRE :</div>
        <div class="val" id="treUsdc">-</div>
        <span class="tag">Adresse trésorerie Solana (serveur)</span>
      </div>
    </div>
    <hr>
    <div class="grid2">
      <div class="card">
        <h3>Stats globales</h3>
        <div class="label">Hauteur de chaîne :</div>
        <div class="val" id="stHeight">-</div>
        <div class="label" style="margin-top:4px;">Nombre de wallets :</div>
        <div class="val" id="stWallets">-</div>
        <div class="label" style="margin-top:4px;">Mempool :</div>
        <div class="val" id="stMem">-</div>
      </div>
      <div class="card">
        <h3>TVL interne</h3>
        <div class="label">POW / FIRE total :</div>
        <div class="val" id="stPow">-</div>
        <div class="label" style="margin-top:4px;">Total staké :</div>
        <div class="val" id="stStk">-</div>
        <div class="label" style="margin-top:6px;">LP interne :</div>
        <div class="val">FIRE : <span id="lpPow">-</span> • USDC : <span id="lpUsdc">-</span></div>
      </div>
    </div>
  </div>

  <!-- PANEL WALLET -->
  <div id="panel-wallet" class="panel">
    <div class="panel-inner">
      <div class="card">
        <h3>Wallet POWCHAIN — public</h3>
        <div class="label">Adresse POWCHAIN:</div>
        <input id="wAddr" placeholder="Adresse POWCHAIN (ex: wallet utilisateur)"/>
        <button onclick="loadWallet()">Charger le wallet</button>
      </div>
      <div class="grid2" style="margin-top:10px">
        <div class="card">
          <h3>Soldes</h3>
          <div class="label">FIRE :</div>
          <div class="val" id="wPow">-</div>
          <div class="label" style="margin-top:4px;">USDC FIRE :</div>
          <div class="val" id="wUsdc">-</div>
          <div class="label" style="margin-top:4px;">Staké :</div>
          <div class="val" id="wStk">-</div>
          <div class="label" style="margin-top:4px;">Nonce :</div>
          <div class="val" id="wNonce">-</div>
        </div>
        <div class="card">
          <h3>Envoyer une transaction</h3>
          <div class="label">Destinataire :</div>
          <input id="txTo" placeholder="Adresse destinataire"/>
          <div class="label">Montant :</div>
          <input id="txAmt" type="number" step="0.0001" placeholder="0.0"/>
          <div class="label">Token :</div>
          <select id="txTok">
            <option value="FIRE">FIRE</option>
            <option value="USDC">USDC</option>
          </select>
          <button onclick="sendTx()">Envoyer TX POWCHAIN</button>
          <span class="tag">Signée côté serveur POWCHAIN</span>
        </div>
      </div>
    </div>
  </div>

  <!-- PANEL DEX & LP -->
  <div id="panel-dex" class="panel">
    <div class="grid2">
      <div class="card">
        <h3>Ajouter de la liquidité LP</h3>
        <div class="label">FIRE à déposer :</div>
        <input id="lpFireIn" type="number" step="0.0001" placeholder="0.0"/>
        <div class="label">USDC FIRE à déposer :</div>
        <input id="lpUsdcIn" type="number" step="0.0001" placeholder="0.0"/>
        <button onclick="addLP()">Ajouter au pool LP</button>
        <span class="tag">x·y = k LP interne</span>
      </div>
      <div class="card">
        <h3>Swap interne</h3>
        <div class="label">Direction :</div>
        <select id="swDir">
          <option value="fire2usdc">FIRE → USDC</option>
          <option value="usdc2fire">USDC → FIRE</option>
        </select>
        <div class="label">Montant à swap :</div>
        <input id="swAmt" type="number" step="0.0001" placeholder="0.0"/>
        <button onclick="doSwap()">Exécuter le swap</button>
        <span class="tag">Prix dérivé de la courbe LP</span>
      </div>
    </div>
  </div>

  <!-- PANEL STAKE & CHAIN -->
  <div id="panel-stake" class="panel">
    <div class="grid2">
      <div class="card">
        <h3>Stake FIRE</h3>
        <div class="label">Montant FIRE à staker :</div>
        <input id="stkAmt" type="number" step="0.0001" placeholder="0.0"/>
        <button onclick="stakeFire()">Stake</button>
        <span class="tag">Récompenses distribuées par le validateur</span>
      </div>
      <div class="card">
        <h3>Chaîne</h3>
        <div class="label">Dernier bloc connu :</div>
        <div class="val" id="lastBlock">-</div>
        <button class="secondary" style="margin-top:8px" onclick="loadChain()">Rafraîchir dernier bloc</button>
        <span class="tag">Lecture directe depuis /chain/last</span>
      </div>
    </div>
  </div>

  <!-- PANEL LOGS -->
  <div id="panel-logs" class="panel">
    <div class="card">
      <h3>Logs FIREINNERS</h3>
      <div id="log"></div>
    </div>
  </div>

</div>
</body>
</html>
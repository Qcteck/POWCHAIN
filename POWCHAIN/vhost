# 1) Aller dans /root
cd /root

# 2) Créer le dossier des sources POWCHAIN
mkdir -p /root/POWCHAIN

# 3) Mettre les fichiers actuels comme base (si présents)
if [ -f /root/server.js ]; then
  cp /root/server.js /root/POWCHAIN/server.js
fi

if [ -f /var/www/html/index.html ]; then
  cp /var/www/html/index.html /root/POWCHAIN/index.html
fi



sudo chmod +x /root/deploy_powchain.sh
  const API = ""; // appels relatifs (/stats, /wallet, /bridge)
  const WS = (location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/ws";
  const DEC = 1e6;
  const ALPH = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";

  // Bridge SOL réel
  const TREASURY_SOL_ADDRESS = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";
  const RPC_SOL = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const LAMPORTS_PER_SOL = 1_000_000_000;

  const connSol = new solanaWeb3.Connection(RPC_SOL, "confirmed");

  let addr = null;
  let priv = null;
  let pub = null;
  let nonce = 0;
  let sock = null;

  let solPubkey = null;
  let solUsdcMint = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

  function q(sel){return document.querySelector(sel);}

  function log(msg){
    const t = new Date().toLocaleTimeString();
    const el = q("#log");
    if(el){
      el.textContent = "["+t+"] "+msg+"\n"+el.textContent;
    }
    console.log(msg);
  }

  function fmtMicro(n){
    return (n/DEC).toFixed(6);
  }

  function b58encode(bytes){
    if(!bytes || !bytes.length) return "";
    let d = [0];
    for(let i=0;i<bytes.length;i++){
      let c = bytes[i];
      for(let j=0;j<d.length;j++){
        let x = d[j]*256 + c;
        d[j] = x % 58;
        c = (x/58)|0;
      }
      while(c>0){
        d.push(c%58);
        c = (c/58)|0;
      }
    }
    let z=0;
    while(z<bytes.length && bytes[z]===0) z++;
    let r="";
    for(let i=0;i<z;i++) r+="1";
    for(let i=d.length-1;i>=0;i--) r+=ALPH[d[i]];
    return r;
  }

  function b58decode(str){
    if(!str) return new Uint8Array(0);
    let b=[0];
    for(let i=0;i<str.length;i++){
      let c=ALPH.indexOf(str[i]);
      if(c<0) throw Error("base58 invalide");
      for(let j=0;j<b.length;j++){
        let x=b[j]*58+c;
        b[j]=x&255;
        c=x>>8;
      }
      while(c>0){
        b.push(c&255);
        c>>=8;
      }
    }
    let z=0;
    while(z<str.length && str[z]==="1") z++;
    let r=new Uint8Array(z+b.length);
    for(let i=0;i<b.length;i++) r[r.length-1-i]=b[i];
    return r;
  }

  async function jget(path){
    const t0 = performance.now();
    const r = await fetch(API + path);
    const t1 = performance.now();
    const lat = q("#latency");
    if(lat) lat.textContent = "Latency: " + (t1 - t0).toFixed(0) + " ms";
    if(!r.ok) throw Error("HTTP "+r.status);
    return r.json();
  }

  function connectWS(){
    try{
      sock = new WebSocket(WS);
      sock.onopen = () => {
        log("WebSocket connecté");
        q("#syncText").textContent = "Synced";
        q("#syncChipText").textContent = "Online";
      };
      sock.onclose = () => {
        q("#syncText").textContent = "Reconnecting";
        q("#syncChipText").textContent = "Sync…";
        setTimeout(connectWS, 1500);
      };
      sock.onerror = () => {
        q("#syncText").textContent = "Error";
        q("#syncChipText").textContent = "Error";
      };
      sock.onmessage = ev => {
        try{
          const msg = JSON.parse(ev.data);
          if(msg.type === "bridge"){
            log("Bridge event: " + JSON.stringify(msg.bridge));
          }
        }catch(e){}
      };
    }catch(e){
      log("WS ERR "+e.message);
    }
  }
  connectWS();

  async function refreshNet(){
    try{
      const s = await jget("/stats");
      q("#netHeight").textContent = s.height || 0;
      q("#lpPow").textContent = fmtMicro(s.lpPow || 0);
      q("#lpUsdc").textContent = fmtMicro(s.lpUsdc || 0);
      q("#netTVL").textContent = ((s.tvlUsdc || 0)/DEC).toFixed(2)+" USDC FIRE";
      q("#netPrice").textContent = s.priceFireUsdc ? s.priceFireUsdc.toFixed(6)+" USDC" : "0";
      q("#netTreasury").textContent = ((s.treasuryUsdc || 0)/DEC).toFixed(2)+" USDC FIRE · "+(s.treasurySol || 0).toFixed(4)+" SOL";
      q("#netSupply").textContent = ((s.supplyCirculante || 0)/DEC).toFixed(2)+" FIRE";
      const left = (s.supplyDisponible != null ? s.supplyDisponible : 0);
      q("#netSupplyLeft").textContent = ((left)/DEC).toFixed(2)+" FIRE";
      q("#supplyLeft").textContent = ((left)/DEC).toFixed(2);
    }catch(e){
      log("NET ERR "+e.message);
    }
  }
  setInterval(refreshNet, 4000);
  refreshNet();

  function signTx(obj){
    const payload = {
      type: obj.type,
      from: obj.from ?? addr,
      to: obj.to ?? null,
      amount: obj.amount ?? null,
      token: obj.token ?? null,
      nonce: nonce + 1
    };
    const msg = new TextEncoder().encode(JSON.stringify(payload));
    const sk = b58decode(priv);
    const sig = nacl.sign.detached(msg, sk);
    return b58encode(sig);
  }

  async function loadWallet(){
    addr = q("#walletAddr").value.trim();
    priv = q("#walletPriv").value.trim();
    if(!addr || !priv){
      alert("Adresse + clé privée requises");
      return;
    }
    const w = await jget("/wallet/" + addr);
    nonce = w.nonce || 0;
    pub = w.pub || addr;
    window.currentFireAddr = addr;
    q("#wpow").textContent = fmtMicro(w.pow || 0);
    q("#wusdc").textContent = fmtMicro(w.usdc || 0);
    q("#wstk").textContent = fmtMicro(w.staked || 0);
    log("Wallet FIREINNERS chargé " + addr);
  }

  q("#btnLoad").onclick = loadWallet;
  q("#btnRefreshW").onclick = loadWallet;

  q("#btnGen").onclick = () => {
    try{
      const kp = nacl.sign.keyPair();
      addr = b58encode(kp.publicKey);
      priv = b58encode(kp.secretKey);
      pub = addr;
      nonce = 0;
      window.currentFireAddr = addr;
      q("#walletAddr").value = addr;
      q("#walletPriv").value = priv;
      q("#wpow").textContent = "0.000000";
      q("#wusdc").textContent = "0.000000";
      q("#wstk").textContent = "0.000000";

set -euo pipefail

HOST="sentinel.fireinners.online"
PORT="9696"
APP_DIR="/root/fireinners-security-sentinel"

echo "=== SYSTEM ==="
uname -a || true
lsb_release -a 2>/dev/null || true
date

echo
echo "=== DNS / RESOLUTION ==="
echo "HOST=$HOST"
getent hosts "$HOST" || true
echo "IPv4 attendue (fireinners.online): 72.61.79.12"
echo "IPv6 presente sur machine: $(ip -6 addr show dev eth0 2>/dev/null | grep -oE '2a02:[0-9a-f:]+' | head -n1 || true)"

echo
echo "=== PORT CHECK ==="
echo "Port $PORT doit etre libre en EXTERNE (Node en local seulement) et repondre en local."
sudo ss -lntp | grep -E "(:$PORT\b|nginx|:80\b|:443\b)" || true

echo
echo "=== NGINX HEALTH ==="
sudo systemctl is-active nginx && echo "nginx: active" || echo "nginx: NOT active"
sudo nginx -t || true
echo
echo "Sites enabled:"
sudo ls -la /etc/nginx/sites-enabled 2>/dev/null || true
echo
echo "Any sentinel vhost already?"
sudo grep -R "$HOST" -n /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null || true

echo
echo "=== FIREWALL (UFW) ==="
sudo ufw status || true
echo
echo "Port 80/443 doivent etre ALLOW. Port $PORT n'a pas besoin d'etre ouvert publiquement si Nginx proxy."

echo
echo "=== CERTBOT / LETSENCRYPT ==="
command -v certbot >/dev/null 2>&1 && certbot --version || echo "certbot absent"
sudo ls -la /etc/letsencrypt/live 2>/dev/null || true
if sudo test -d "/etc/letsencrypt/live/$HOST"; then
  echo "Cert deja present pour $HOST"
  sudo ls -la "/etc/letsencrypt/live/$HOST" || true
else
  echo "Aucun cert pour $HOST"
fi

echo
echo "=== SENTINEL APP CHECK ==="
if [ -d "$APP_DIR" ]; then
  echo "APP_DIR ok: $APP_DIR"
  ls -la "$APP_DIR" | sed -n '1,120p'
  echo
  echo ".env:"
  [ -f "$APP_DIR/.env" ] && echo "OK" || echo "MANQUANT"
  echo
  echo "Test local HTTP:"
  curl -sS --max-time 2 "http://127.0.0.1:$PORT/public/state" | head -c 260; echo
else
  echo "APP_DIR manquant: $APP_DIR"
fi

echo
echo "=== DECISION ==="
DNS_OK=0; APP_OK=0; LOCAL_OK=0
getent hosts "$HOST" >/dev/null 2>&1 && DNS_OK=1 || true
[ -d "$APP_DIR" ] && APP_OK=1 || true
curl -sS --max-time 2 "http://127.0.0.1:$PORT/public/state" >/dev/null 2>&1 && LOCAL_OK=1 || true

echo "DNS_OK=$DNS_OK (doit etre 1)"
echo "APP_OK=$APP_OK (doit etre 1)"
echo "LOCAL_OK=$LOCAL_OK (doit etre 1)"
if [ "$DNS_OK" -eq 1 ] && [ "$APP_OK" -eq 1 ] && [ "$LOCAL_OK" -eq 1 ]; then
  echo "GO: tu peux lancer le batch Nginx/HTTPS."
else
  echo "NO-GO: corrige d'abord ce qui manque."
fi

echo "=== FIN ==="
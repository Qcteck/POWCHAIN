sudo cp /root/powchain/index.html /var/www/bbqfinance/index.html


sudo chown -R www-data:www-data /var/www/bbqfinance
sudo chmod -R 755 /var/www/bbqfinance


sudo nano /etc/nginx/sites-available/bbqfinance


server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
    }

    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }
}



sudo nginx -t
sudo systemctl restart nginx


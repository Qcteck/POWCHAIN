// server.js - POWCHAIN backend + bridge + WebSocket
const http = require("http");
const crypto = require("crypto");
const url = require("url");
const { WebSocketServer } = require("ws");

// In-memory state
let chain = [];
let wallets = {}; // { addr: { pow, usdcPow, staked, nonce } }
let lp = { pow: 0, usdc: 0 };
let treasury = { pow: 0, usdc: 0, solBridge: 0 };

// Genesis block
function newBlock(prevHash, txs, rewardPow) {
  const height = chain.length + 1;
  const ts = Date.now();
  const data = JSON.stringify({ height, ts, txs, rewardPow, prevHash });
  const hash = crypto.createHash("sha256").update(data).digest("hex");
  return { height, ts, txs, rewardPow, prevHash, hash };
}

function initChain() {
  if (chain.length > 0) return;
  const genesis = {
    height: 1,
    ts: Date.now(),
    txs: [],
    rewardPow: 0,
    prevHash: "0".repeat(64),
    hash: "c73edbc090a86b5711185583b49dcbb776fbae65768d7f8504ad705372c22a70"
  };
  chain.push(genesis);
}

initChain();

function getOrCreateWallet(addr) {
  if (!addr) return null;
  if (!wallets[addr]) {
    wallets[addr] = { pow: 0, usdcPow: 0, staked: 0, nonce: 0 };
  }
  return wallets[addr];
}

// Very simple POW reward for bridge, just for testing
function powFromSol(amountSol) {
  // exemple : 1 SOL = 1000 POW
  return Math.floor(amountSol * 1000);
}

// WebSocket broadcast
const clients = new Set();

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  for (const ws of clients) {
    if (ws.readyState === ws.OPEN) {
      ws.send(msg);
    }
  }
}

// HTTP server
const server = http.createServer((req, res) => {
  try {
    const parsed = url.parse(req.url, true);
    const path = parsed.pathname || "/";

    // CORS simple (utile si besoin)
    res.setHeader("Access-Control-Allow-Origin", "*");
    res.setHeader("Access-Control-Allow-Methods", "GET,POST,OPTIONS");
    res.setHeader("Access-Control-Allow-Headers", "Content-Type");
    if (req.method === "OPTIONS") {
      res.writeHead(200);
      res.end();
      return;
    }

    if (req.method === "GET" && path === "/stats") {
      const height = chain.length;
      const walletCount = Object.keys(wallets).length;
      const body = JSON.stringify({
        height,
        wallets: walletCount,
        treasuryPow: treasury.pow,
        treasuryUsdc: treasury.usdc,
        lpPow: lp.pow,
        lpUsdc: lp.usdc
      });
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(body);
      return;
    }

    if (req.method === "GET" && path === "/chain") {
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify(chain));
      return;
    }

    if (req.method === "GET" && path === "/wallet") {
      const id = parsed.query.id;
      const w = getOrCreateWallet(id);
      if (!w) {
        res.writeHead(400, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: "missing id" }));
        return;
      }
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ id, ...w }));
      return;
    }

    if (req.method === "POST" && path === "/tx") {
      let data = "";
      req.on("data", chunk => {
        data += chunk;
        if (data.length > 1e6) req.destroy(); // protection
      });
      req.on("end", () => {
        let tx;
        try {
          tx = JSON.parse(data || "{}");
        } catch (e) {
          res.writeHead(400, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: "invalid json" }));
          return;
        }

        if (!tx.type) {
          res.writeHead(400, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: "missing type" }));
          return;
        }

        // Route TX types
        if (tx.type === "BRIDGE_SOL") {
          const fromPow = String(tx.fromPow || "").trim();
          const amountSol = Number(tx.amountSol || tx.amount || 0);
          const solSig = String(tx.solSig || "").trim();

          if (!fromPow || !Number.isFinite(amountSol) || amountSol <= 0) {
            res.writeHead(400, { "Content-Type": "application/json" });
            res.end(JSON.stringify({ error: "invalid bridge payload" }));
            return;
          }

          const w = getOrCreateWallet(fromPow);
          const powCred = powFromSol(amountSol);

          w.pow += powCred;
          treasury.solBridge += amountSol;
          treasury.pow -= powCred; // si tu veux décrémenter la trésorerie
          const txRecord = {
            type: "BRIDGE_SOL",
            fromPow,
            amountSol,
            powCred,
            solSig,
            ts: Date.now()
          };

          const prevHash = chain[chain.length - 1].hash;
          const block = newBlock(prevHash, [txRecord], 0);
          chain.push(block);

          broadcast({ type: "bridge", ...txRecord, height: chain.length });

          res.writeHead(200, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ ok: true, powCred, height: chain.length }));
          return;
        }

        // Placeholder pour d'autres types (SEND, STAKE, ADD_LP, etc.)
        // Pour le moment on accepte mais on stocke simplement
        const txRecord = { ...tx, ts: Date.now() };
        const prevHash = chain[chain.length - 1].hash;
        const block = newBlock(prevHash, [txRecord], 0);
        chain.push(block);
        broadcast({ type: "tx", tx: txRecord, height: chain.length });

        res.writeHead(200, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ ok: true, height: chain.length }));
      });
      return;
    }

    // Fallback
    res.writeHead(404, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ error: "invalid endpoint" }));
  } catch (e) {
    console.error("HTTP error", e);
    try {
      res.writeHead(500, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "server error" }));
    } catch {}
  }
});

// WebSocket sur /ws
const wss = new WebSocketServer({ noServer: true });

wss.on("connection", ws => {
  clients.add(ws);
  ws.send(JSON.stringify({ type: "welcome", height: chain.length }));
  ws.send(
    JSON.stringify({
      type: "stats",
      height: chain.length,
      wallets: Object.keys(wallets).length,
      treasuryPow: treasury.pow,
      treasuryUsdc: treasury.usdc,
      lpPow: lp.pow,
      lpUsdc: lp.usdc
    })
  );

  ws.on("close", () => {
    clients.delete(ws);
  });
});

server.on("upgrade", (req, socket, head) => {
  const { pathname } = url.parse(req.url);
  if (pathname === "/ws") {
    wss.handleUpgrade(req, socket, head, ws => {
      wss.emit("connection", ws, req);
    });
  } else {
    socket.destroy();
  }
});

// Tick périodique pour stats
setInterval(() => {
  broadcast({
    type: "stats",
    height: chain.length,
    wallets: Object.keys(wallets).length,
    treasuryPow: treasury.pow,
    treasuryUsdc: treasury.usdc,
    lpPow: lp.pow,
    lpUsdc: lp.usdc
  });
}, 10000);

// Lancement
const PORT = 3000;
server.listen(PORT, "127.0.0.1", () => {
  console.log("POWCHAIN server on http://127.0.0.1:" + PORT);
});




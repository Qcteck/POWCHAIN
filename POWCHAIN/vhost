.ws-bad{background:#ef4444}

/* bannières */
#tickerBar,#rssBar,#statsBar{margin:4px 18px;border-radius:999px;border:1px solid #312366;padding:5px 10px;font-size:11px;overflow:hidden;white-space:nowrap;position:relative;background:radial-gradient(circle at top,#150b24,#05010a)}
.scroll-inner{display:inline-block;animation:scrollX 45s linear infinite}
.scroll-inner span{margin-right:28px;display:inline-flex;align-items:center;gap:6px}
.token-pill{padding:2px 8px;border-radius:999px;border:1px solid #4338ca;background:#020617cc}
.token-pill img{width:13px;height:13px;border-radius:999px}
@keyframes scrollX{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* main cards */
.section{margin:10px 18px;padding:14px 16px;border-radius:18px;border:1px solid var(--border);background:radial-gradient(circle at top left,#1f102e,#080213 55%,#02010a);box-shadow:0 18px 40px #000c}
.section h2{font-size:13px;text-transform:uppercase;letter-spacing:.16em;color:#e5e7eb;margin:0 0 8px 0}
.label{font-size:11px;color:#9ca3af;margin-bottom:3px}
.input{width:100%;border-radius:999px;border:1px solid #312e81;background:#020617;color:#e5e7eb;font-size:12px;padding:6px 10px;box-sizing:border-box}
.input:focus{outline:none;border-color:#fbbf24;box-shadow:0 0 0 1px #fbbf2477}
.btn{border-radius:999px;border:none;font-size:12px;padding:7px 14px;cursor:pointer;font-weight:600}

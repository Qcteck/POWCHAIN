sudo nano /etc/nginx/sites-available/bbqfinance.conf



server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # Redirection HTTP → HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # Certificats LETSENCRYPT
    ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;

    # Sécurité SSL minimale
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Ton interface HTML Fireinners
    root /var/www/bbqfinance.fun;
    index index.html;

    # ---------------------------
    #  🔥 API Fireinners (port 3000)
    # ---------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /stats {
        proxy_pass http://127.0.0.1:3000;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000;
    }

    location /bridge {
        proxy_pass http://127.0.0.1:3000;
    }

    location /tx {
        proxy_pass http://127.0.0.1:3000;
    }

    location /lp {
        proxy_pass http://127.0.0.1:3000;
    }

    location /swap {
        proxy_pass http://127.0.0.1:3000;
    }

    location /stake {
        proxy_pass http://127.0.0.1:3000;
    }

    location /unstake {
        proxy_pass http://127.0.0.1:3000;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000;
    }

    # ---------------------------
    #  🔥 WebSocket POWCHAIN (/ws)
    # ---------------------------
    location /ws {
        proxy_pass http://127.0.0.1:3000;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}







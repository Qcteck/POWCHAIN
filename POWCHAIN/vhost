<body>
<div id="wrap">
  <h1>POWCHAIN — Client Complet</h1>
  <div id="backendStatus">
    Backend :
    <span id="httpStatus" class="pill bad">HTTP ?</span>
    <span id="wsStatus" class="pill bad">WS ?</span>
  </div>

  <div class="grid">
    <!-- Réseau POWCHAIN -->
    <div class="card">
      <h2>RÉSEAU POWCHAIN</h2>
      <div class="statline"><span>Hauteur</span><span id="netHeight">-</span></div>
      <div class="statline"><span>Nb wallets</span><span id="netWallets">-</span></div>
      <div class="statline"><span>TVL POW</span><span id="netTvlPow">-</span></div>
      <div class="statline"><span>TVL USDC POW</span><span id="netTvlUsdc">-</span></div>
      <div class="statline"><span>Trésorerie POW</span><span id="netTreasPow">-</span></div>
      <div class="statline"><span>Trésorerie USDC POW</span><span id="netTreasUsdc">-</span></div>
      <small id="netLast">Données HTTP : -</small>
    </div>

    <!-- Wallet POWCHAIN local -->
    <div class="card">
      <h2>WALLET POWCHAIN — GÉNÉRATEUR</h2>
      <label for="powAddr">Adresse POWCHAIN (base58)</label>
      <input id="powAddr" placeholder="Clique sur GÉNÉRER pour créer un wallet local" readonly>

      <div class="row">
        <button id="btnGenPow" class="full">Générer wallet POWCHAIN</button>
        <button id="btnReloadPow" class="secondary full">Recharger</button>
      </div>

      <div class="row">
        <canvas id="powQr" width="120" height="120"></canvas>
        <div>
          <button id="btnCopyPow" class="full secondary">Copier adresse</button>
          <small>
            Le wallet est généré localement (<b>nacl + bs58</b>) et stocké en localStorage.
            Seules les TX signées sont envoyées au serveur POWCHAIN.
          </small>
        </div>
      </div>

      <label>Solde POW</label>
      <input id="powBalPow" readonly>
      <label>Solde USDC POW</label>
      <input id="powBalUsdc" readonly>
    </div>

    <!-- Wallet Solana / Bridge -->
    <div class="card">
      <h2>WALLET SOLANA — PHANTOM</h2>
      <div class="row">
        <button id="btnConnectPhantom" class="full">Connecter Phantom</button>
        <button id="btnRefreshSol" class="secondary full">Refresh</button>
      </div>

      <label>Adresse Solana</label>
      <input id="solAddr" readonly>

      <label>SOL (wallet)</label>
      <input id="solBal" readonly>
      <label>USDC Solana</label>
      <input id="solUsdcBal" readonly>

      <small>Soldes lus via RPC drpc Solana mainnet (SOL + USDC <b>EPjFWdd5...</b>). Aucun lien direct avec USDC POWCHAIN interne.</small>

      <hr style="margin:10px 0;border-color:#1f2937;">

      <h2 style="font-size:15px;margin-top:0;">BRIDGE vers POWCHAIN</h2>
      <label>Montant SOL à bridger</label>
      <input id="bridgeSolAmt" placeholder="ex. 0.001">
      <button id="btnBridge" class="full">SOL → POWCHAIN</button>
      <small>
        Envoie une requête <b>BRIDGE_SOL</b> au serveur POWCHAIN.
        Les détails du pont (trésorerie POWCHAIN, prix, mint POW, etc.) sont gérés côté backend.
      </small>
    </div>
  </div>

  <div class="grid" style="margin-top:14px;">
    <!-- Actions wallet POWCHAIN -->
    <div class="card">
      <h2>ACTIONS WALLET POWCHAIN</h2>
      <label for="destPow">Destinataire POWCHAIN</label>
      <input id="destPow" placeholder="Adresse POWCHAIN destinataire">

      <label for="sendPowAmt">Montant POW</label>
      <input id="sendPowAmt" placeholder="0.0">

      <button id="btnSendPow" class="full">SEND</button>

      <label for="stakePowAmt" style="margin-top:8px;">Montant POW à staker</label>
      <input id="stakePowAmt" placeholder="0.0">
      <button id="btnStakePow" class="full">STAKE</button>
    </div>

    <!-- DEX POWCHAIN -->
    <div class="card">
      <h2>DEX POWCHAIN</h2>
      <label>Ajouter de la liquidité (POW / USDC POW)</label>
      <label for="lpPowAmt">Montant POW</label>
      <input id="lpPowAmt" placeholder="0.0">
      <label for="lpUsdcAmt">Montant USDC POW</label>
      <input id="lpUsdcAmt" placeholder="0.0">
      <button id="btnAddLp" class="full">ADD LP</button>
      <small>Un add LP ≥ 10 000 POW et 10 000 USDC POW peut donner un badge WHALE (logique à gérer côté serveur).</small>

      <label style="margin-top:10px;">Graphique DEX POW / USDC POW</label>
      <canvas id="dexChart" width="320" height="120" style="background:#020617;border-radius:8px;border:1px solid #1f2937;"></canvas>
      <small>Illustration simple (pas un prix de marché on-chain).</small>
    </div>

    <!-- Explorer & Log -->
    <div class="card">
      <h2>EXPLORER & LOG</h2>
      <div class="row">
        <button id="btnLoadBlocks" class="full">Charger derniers blocs</button>
        <button id="btnClearLog" class="secondary full">CLEAR LOG</button>
      </div>
      <textarea id="log" readonly></textarea>
    </div>
  </div>
</div>

<script>
  // ---------- Config endpoints ----------
  const HTTP_BASE = ""; // relatif : /stats, /tx, /chain
  const WS_URL = (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws";

  // Solana RPC (drpc préféré)
  const RPC_SOL = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

  // ---------- Utilitaires DOM / log ----------
  const $ = id => document.getElementById(id);
  function log(msg){
    const t = new Date().toTimeString().slice(0,8);
    const area = $("log");
    area.value += `[${t}] ${msg}\n`;
    area.scrollTop = area.scrollHeight;
  }

  function setBackendStatus(httpOk, wsOk){
    const http = $("httpStatus"), ws = $("wsStatus");
    http.className = "pill " + (httpOk ? "ok" : "bad");
    http.textContent = httpOk ? "HTTP OK" : "HTTP ?";
    ws.className = "pill " + (wsOk ? "ok" : "bad");
    ws.textContent = wsOk ? "WS OK" : "WS ?";
  }

  // ---------- Réseau POWCHAIN (HTTP /stats) ----------
  async function refreshStats(){
    try{
      const res = await fetch(HTTP_BASE + "/stats");
      if(!res.ok) throw new Error("HTTP " + res.status);
      const j = await res.json();
      $("netHeight").textContent = j.height ?? "-";
      $("netWallets").textContent = j.wallets ?? "-";
      $("netTvlPow").textContent = j.tvlPow ?? "-";
      $("netTvlUsdc").textContent = j.tvlUsdc ?? "-";
      $("netTreasPow").textContent = j.treasuryPow ?? "-";
      $("netTreasUsdc").textContent = j.treasuryUsdc ?? "-";
      $("netLast").textContent = "Données HTTP : " + new Date().toLocaleTimeString();
      setBackendStatus(true, wsConnected);
    }catch(e){
      log("ERR stats : " + e.message);
      setBackendStatus(false, wsConnected);
    }
  }

  // ---------- WebSocket POWCHAIN ----------
  let ws, wsConnected = false;
  function connectWs(){
    try{
      ws = new WebSocket(WS_URL);
      log("WS connect → " + WS_URL);
      ws.onopen = () => {
        wsConnected = true;
        setBackendStatus(true, true);
        log("WebSocket connecté.");
      };
      ws.onclose = () => {
        wsConnected = false;
        setBackendStatus(true, false);
        log("WebSocket fermé. Reconnexion dans 3 s.");
        setTimeout(connectWs,3000);
      };
      ws.onerror = (e) => {
        log("WS error: " + (e.message||"undefined"));
      };
      ws.onmessage = ev => {
        try{
          const msg = JSON.parse(ev.data);
          if(msg.type === "welcome"){
            log("WS welcome, height=" + msg.height);
          }else if(msg.type === "stats"){
            log("WS msg: " + ev.data);
          }else if(msg.type === "bridge"){
            log("Bridge réponse: " + JSON.stringify(msg));
          }else{
            log("WS msg: " + ev.data);
          }
        }catch{
          log("WS raw: " + ev.data);
        }
      };
    }catch(e){
      log("WS exception: " + e.message);
    }
  }

  // ---------- Wallet POWCHAIN local ----------
  let powPriv = null;
  let powPub = null;
  let qr = null;

  function ensureLibs(){
    if(typeof nacl === "undefined" || !nacl.sign) throw new Error("nacl.sign absent");
    if(typeof bs58 === "undefined") throw new Error("bs58 lib non chargée");
  }

  function loadLocalWallet(){
    const priv58 = localStorage.getItem("pow_priv");
    const pub58  = localStorage.getItem("pow_pub");
    if(!priv58 || !pub58) return;
    try{
      ensureLibs();
      powPriv = bs58.decode(priv58);
      powPub  = bs58.decode(pub58);
      $("powAddr").value = pub58;
      if(qr) qr.value = pub58;
      log("Wallet POWCHAIN local chargé.");
    }catch(e){
      log("ERR load wallet local: " + e.message);
    }
  }

  function saveLocalWallet(priv, pub){
    const priv58 = bs58.encode(priv);
    const pub58  = bs58.encode(pub);
    localStorage.setItem("pow_priv", priv58);
    localStorage.setItem("pow_pub", pub58);
    $("powAddr").value = pub58;
    if(qr) qr.value = pub58;
  }

  function genWalletPow(){
    try{
      ensureLibs();
      const kp = nacl.sign.keyPair();
      powPriv = kp.secretKey;
      powPub  = kp.publicKey;
      saveLocalWallet(powPriv, powPub);
      log("Wallet POWCHAIN généré.");
      alert("Wallet POWCHAIN généré !");
    }catch(e){
      alert("Erreur génération wallet POWCHAIN : " + e);
      log("ERR gen wallet: " + e);
    }
  }

  async function reloadPowBalances(){
    const addr = $("powAddr").value.trim();
    if(!addr){
      alert("Aucune adresse POWCHAIN locale. Génére d'abord un wallet.");
      return;
    }
    try{
      const res = await fetch(HTTP_BASE + "/wallet/" + encodeURIComponent(addr));
      if(!res.ok) throw new Error("HTTP " + res.status);
      const j = await res.json();
      $("powBalPow").value  = j.pow ?? 0;
      $("powBalUsdc").value = j.usdc ?? 0;
      log("Soldes POWCHAIN mis à jour.");
    }catch(e){
      log("ERR reload balances POWCHAIN: " + e.message);
    }
  }

  function copyPowAddress(){
    const addr = $("powAddr").value.trim();
    if(!addr){
      alert("Aucune adresse à copier.");
      return;
    }
    navigator.clipboard.writeText(addr).then(
      () => alert("Adresse POWCHAIN copiée !"),
      () => alert("Impossible de copier l'adresse.")
    );
  }

  // ---------- Solana / Phantom ----------
  let solConn = new solanaWeb3.Connection(RPC_SOL,"confirmed");
  let solWallet = null;

  async function connectPhantom(){
    try{
      const provider = window.solana;
      if(!provider || !provider.isPhantom){
        alert("Phantom non détecté.");
        return;
      }
      const resp = await provider.connect();
      solWallet = resp.publicKey;
      $("solAddr").value = solWallet.toBase58();
      log("Phantom connecté: " + solWallet.toBase58());
      await refreshSolBalances();
    }catch(e){
      log("ERR Phantom connect: " + e.message);
      alert("Erreur Phantom: " + e.message);
    }
  }

  async function refreshSolBalances(){
    if(!solWallet){
      log("Pas de wallet Phantom connecté.");
      return;
    }
    try{
      const sol = await solConn.getBalance(solWallet);
      $("solBal").value = (sol/1e9).toFixed(6);

      const usdcMint = new solanaWeb3.PublicKey(USDC_MINT);
      const tokenAccounts = await solConn.getParsedTokenAccountsByOwner(solWallet,{mint:usdcMint});
      let usdc = 0;
      for(const a of tokenAccounts.value){
        const info = a.account.data.parsed.info;
        const amt = Number(info.tokenAmount.amount) / Math.pow(10, info.tokenAmount.decimals);
        usdc += amt;
      }
      $("solUsdcBal").value = usdc.toFixed(2);
      log("Balances Solana rafraîchies.");
    }catch(e){
      log("ERR Solana balances: " + e.message);
      alert("Erreur Phantom: failed to get token accounts owned by account " + (solWallet?solWallet.toBase58():"") + ": " + e.message);
    }
  }

  // ---------- Bridge SOL -> POWCHAIN ----------
  async function bridgeSolToPow(){
    if(!solWallet){
      alert("Connecte Phantom d'abord.");
      return;
    }
    const powAddr = $("powAddr").value.trim();
    if(!powAddr){
      alert("Génère d'abord un wallet POWCHAIN local.");
      return;
    }
    const amtStr = $("bridgeSolAmt").value.trim();
    const amt = Number(amtStr);
    if(!amtStr || !isFinite(amt) || amt <= 0){
      alert("Montant SOL invalide.");
      return;
    }
    try{
      const tx = {
        type:"BRIDGE_SOL",
        from: solWallet.toBase58(),
        powAddr: powAddr,
        amountSol: amt
      };
      log("BRIDGE_REQUEST envoyé SOL " + amt);
      const res = await fetch(HTTP_BASE + "/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify(tx)
      });
      if(!res.ok){
        log("HTTP /tx → " + res.status);
        alert("Bridge: erreur HTTP " + res.status);
        return;
      }
      const j = await res.json();
      log("Bridge réponse: " + JSON.stringify(j));
      if(j.error){
        alert("Bridge erreur: " + j.error);
      }else{
        alert("Requête de bridge envoyée (détails dans la console POWCHAIN).");
      }
    }catch(e){
      log("ERR bridge: " + e.message);
      alert("Erreur bridge: " + e.message);
    }
  }

  // ---------- TX POWCHAIN simples ----------
  async function sendPowTx(type, payload){
    const addr = $("powAddr").value.trim();
    if(!addr || !powPriv || !powPub){
      alert("Wallet POWCHAIN local manquant. Génére puis recharge.");
      return;
    }
    try{
      const tx = {type, from: addr, ...payload};
      const res = await fetch(HTTP_BASE + "/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify(tx)
      });
      const j = await res.json();
      log("TX " + type + " → " + JSON.stringify(j));
      if(j.error) alert("Erreur TX: " + j.error);
    }catch(e){
      log("ERR send TX " + type + ": " + e.message);
    }
  }

  // ---------- Explorer ----------
  async function loadBlocks(){
    try{
      const res = await fetch(HTTP_BASE + "/chain");
      if(!res.ok) throw new Error("HTTP " + res.status);
      const j = await res.json();
      log("Derniers blocs:\n" + JSON.stringify(j,null,2));
    }catch(e){
      log("ERR load chain: " + e.message);
    }
  }

  // ---------- DEX chart (simple courbe décorative) ----------
  function drawDexChart(){
    const c = $("dexChart");
    if(!c) return;
    const ctx = c.getContext("2d");
    ctx.clearRect(0,0,c.width,c.height);
    ctx.strokeStyle="#38bdf8";
    ctx.lineWidth=2;
    ctx.beginPath();
    const w=c.width,h=c.height;
    for(let x=0;x<=w;x++){
      const t=x/w;
      const y=h*0.9 - Math.pow(1-t,2)*h*0.7;
      if(x===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }
    ctx.stroke();
  }

  // ---------- Init ----------
  window.addEventListener("load",()=>{
    // QR init
    qr = new QRious({element:$("powQr"),size:120,value:""});

    loadLocalWallet();
    refreshStats();
    connectWs();
    drawDexChart();
    setInterval(refreshStats,30000);

    $("btnGenPow").onclick = genWalletPow;
    $("btnReloadPow").onclick = reloadPowBalances;
    $("btnCopyPow").onclick = copyPowAddress;

    $("btnConnectPhantom").onclick = connectPhantom;
    $("btnRefreshSol").onclick = refreshSolBalances;
    $("btnBridge").onclick = bridgeSolToPow;

    $("btnSendPow").onclick = ()=>{
      const to = $("destPow").value.trim();
      const amt = Number($("sendPowAmt").value);
      if(!to || !isFinite(amt) || amt<=0){alert("Paramètres SEND invalides");return;}
      sendPowTx("SEND_POW",{to,amount:amt});
    };
    $("btnStakePow").onclick = ()=>{
      const amt = Number($("stakePowAmt").value);
      if(!isFinite(amt) || amt<=0){alert("Montant stake invalide");return;}
      sendPowTx("STAKE_POW",{amount:amt});
    };
    $("btnAddLp").onclick = ()=>{
      const pow = Number($("lpPowAmt").value);
      const usdc = Number($("lpUsdcAmt").value);
      if(!isFinite(pow)||pow<=0||!isFinite(usdc)||usdc<=0){alert("LP invalide");return;}
      sendPowTx("ADD_LP",{pow,usdc});
    };

    $("btnLoadBlocks").onclick = loadBlocks;
    $("btnClearLog").onclick = ()=>{$("log").value="";};
  });
</script>
</body>
</html>






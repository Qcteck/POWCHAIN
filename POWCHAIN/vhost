<script>
/* ============================================================
   UTILS GÉNÉRAUX (LOG, BASE58, HELPERS)
   ============================================================ */
const logBox=document.getElementById("log");
function log(msg){
  const t=new Date().toTimeString().slice(0,8);
  logBox.textContent+=`[${t}] ${msg}\n`;
  logBox.scrollTop=logBox.scrollHeight;
}

// Base58 maison (même alphabet que Bitcoin → compatible bs58 côté serveur)
const B58_ALPHABET="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function b58encode(bytes){
  if(!(bytes instanceof Uint8Array)) bytes=new Uint8Array(bytes);
  let x=0n;
  for(const b of bytes){x=(x<<8n)+BigInt(b);}
  if(x===0n) return "1";
  let out="";
  while(x>0n){
    const mod=x%58n;
    out=B58_ALPHABET[Number(mod)]+out;
    x=x/58n;
  }
  // gérer les zéros en tête → "1"
  for(const b of bytes){
    if(b===0) out="1"+out;
    else break;
  }
  return out;
}

/* ============================================================
   MODULE 1 — RÉSEAU FIREINNERS (HTTP + WS)
   ============================================================ */
const dotHttp=document.getElementById("dotHttp");
const txtHttp=document.getElementById("txtHttp");
const dotWs=document.getElementById("dotWs");
const txtWs=document.getElementById("txtWs");
const netHeight=document.getElementById("netHeight");
const netWallets=document.getElementById("netWallets");
const tvlPow=document.getElementById("tvlPow");
const tvlUsdc=document.getElementById("tvlUsdc");
const tresPow=document.getElementById("tresPow");
const tresUsdc=document.getElementById("tresUsdc");

async function refreshStats(){
  try{
    const res=await fetch("/stats",{cache:"no-store"});
    if(!res.ok) throw new Error("HTTP "+res.status);
    const s=await res.json();
    dotHttp.classList.remove("bad");dotHttp.classList.add("ok");
    txtHttp.textContent="HTTP OK";
    netHeight.textContent=s.height??0;
    netWallets.textContent=s.wallets??0;
    tvlPow.textContent=s.tvlPow??"-";
    tvlUsdc.textContent=s.tvlUsdc??"-";
    tresPow.textContent=s.treasuryPow??0;
    tresUsdc.textContent=s.treasuryUsdc??0;
  }catch(e){
    dotHttp.classList.remove("ok");
    dotHttp.classList.add("bad");
    txtHttp.textContent="HTTP ?";
    log("HTTP stats error: "+e.message);
  }
}

let ws;
function initWs(){
  try{
    const proto=location.protocol==="https:"?"wss":"ws";
    const url=`${proto}://${location.host}/ws`;
    ws=new WebSocket(url);
    ws.onopen=()=>{dotWs.classList.add("ok");txtWs.textContent="OK";log("WebSocket FIREINNERS connecté.");};
    ws.onclose=()=>{dotWs.classList.remove("ok");txtWs.textContent="?";log("WebSocket fermé. Reconnexion dans 3 s…");setTimeout(initWs,3000);};
    ws.onerror=err=>{log("WS error: "+err);};
    ws.onmessage=ev=>{
      try{
        const msg=JSON.parse(ev.data);
        if(msg.type==="stats-push"){
          netHeight.textContent=msg.height;
          netWallets.textContent=msg.wallets;
          tresPow.textContent=msg.treasuryPow;
          tresUsdc.textContent=msg.treasuryUsdc;
        }else if(msg.type==="log"){
          log("WS msg: "+msg.text);
        }
      }catch(e){
        log("WS message brut: "+ev.data);
      }
    };
  }catch(e){
    log("WS init error: "+e.message);
  }
}
function sendWs(obj){
  if(ws && ws.readyState===1){
    ws.send(JSON.stringify(obj));
  }
}

/* ============================================================
   MODULE 2 — WALLET FIREINNERS LOCAL (ED25519 + QR + STORAGE)
   ============================================================ */
const addrFire=document.getElementById("addrFire");
const balFire=document.getElementById("balFire");
const balUsdcFire=document.getElementById("balUsdcFire");
const btnGenFire=document.getElementById("btnGenFire");
const btnReloadFire=document.getElementById("btnReloadFire");
const btnCopyFire=document.getElementById("btnCopyFire");
const qrCanvas=document.getElementById("qrCanvas");
let qr;

function ensureCrypto(){
  if(typeof nacl==="undefined") throw new Error("libs cryptographiques non chargées");
}

function loadFireWalletFromStorage(){
  const pub=localStorage.getItem("FIRE_WALLET_PUB");
  if(pub){
    addrFire.value=pub;
    if(!qr){qr=new QRious({element:qrCanvas,size:86,value:pub});}
    else{qr.set({value:pub});}
    log("Wallet FIREINNERS chargé depuis localStorage.");
  }
}

function genFireWallet(){
  try{
    ensureCrypto();
    const kp=nacl.sign.keyPair();
    const pub58=b58encode(kp.publicKey);
    const priv58=b58encode(kp.secretKey);
    localStorage.setItem("FIRE_WALLET_PUB",pub58);
    localStorage.setItem("FIRE_WALLET_PRIV",priv58);
    addrFire.value=pub58;
    if(!qr){qr=new QRious({element:qrCanvas,size:86,value:pub58});}
    else{qr.set({value:pub58});}
    balFire.value="0";
    balUsdcFire.value="0";
    log("Nouveau wallet FIREINNERS généré.");
    // informer le backend via WS (optionnel)
    sendWs({type:"wallet-register",address:pub58});
  }catch(e){
    alert("Erreur génération wallet FIREINNERS : "+e.message);
    log("Erreur génération wallet FIREINNERS : "+e.message);
  }
}

/* ============================================================
   MODULE 3 — WALLET SOLANA + BRIDGE
   ============================================================ */
const addrSol=document.getElementById("addrSol");
const balSol=document.getElementById("balSol");
const balUsdcSol=document.getElementById("balUsdcSol");
const btnConnectPhantom=document.getElementById("btnConnectPhantom");
const btnRefreshSol=document.getElementById("btnRefreshSol");
const btnBridge=document.getElementById("btnBridge");
const amtBridge=document.getElementById("amtBridge");

// RPC préféré de l'utilisateur
const DRPC_ENDPOINT="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
// Mint USDC Solana (EPJ…)
const USDC_MINT_SOL="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

let solConnection=null;
let solPubkey=null;

function getConnection(){
  if(!solConnection){
    solConnection=new solanaWeb3.Connection(DRPC_ENDPOINT,"confirmed");
  }
  return solConnection;
}

async function connectPhantom(){
  try{
    if(!window.solana || !window.solana.isPhantom){
      alert("Phantom non détecté dans ce navigateur.");
      return;
    }
    const resp=await window.solana.connect();
    solPubkey=new solanaWeb3.PublicKey(resp.publicKey.toString());
    addrSol.value=solPubkey.toBase58();
    log("Phantom connecté : "+addrSol.value);
    await refreshSolBalances();
  }catch(e){
    log("Erreur Phantom connect: "+e.message);
    alert("Erreur Phantom : "+e.message);
  }
}

async function refreshSolBalances(){
  try{
    if(!solPubkey){
      balSol.value="0";
      balUsdcSol.value="0";
      return;
    }
    const conn=getConnection();
    const lamports=await conn.getBalance(solPubkey);
    balSol.value=(lamports/solanaWeb3.LAMPORTS_PER_SOL).toFixed(6);

    // USDC via getParsedTokenAccountsByOwner
    try{
      const uMint=new solanaWeb3.PublicKey(USDC_MINT_SOL);
      const toks=await conn.getParsedTokenAccountsByOwner(solPubkey,{mint:uMint});
      let total=0;
      for(const a of toks.value){
        const ui=a.account.data.parsed.info.tokenAmount.uiAmount||0;
        total+=ui;
      }
      balUsdcSol.value=total.toFixed(2);
    }catch(e){
      // si erreur RPC sur le mint, on log mais on n'arrête pas
      log("Lecture USDC Solana échouée : "+e.message);
      balUsdcSol.value="0";
    }
  }catch(e){
    log("Erreur refresh SOL : "+e.message);
  }
}

async function doBridge(){
  try{
    const fireAddr=addrFire.value.trim();
    if(!fireAddr){
      alert("Génère d'abord un wallet FIREINNERS.");
      return;
    }
    if(!solPubkey){
      alert("Connecte Phantom avant de bridger.");
      return;
    }
    const amt=parseFloat(amtBridge.value.replace(",","."))||0;
    if(amt<=0){
      alert("Montant SOL invalide.");
      return;
    }

    log("Bridge SOL→FIREINNERS en cours…");
    const res=await fetch("/bridge",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        powAddress:fireAddr,
        solAddress:solPubkey.toBase58(),
        amountSol:amt
      })
    });
    if(!res.ok){
      const txt=await res.text();
      log("HTTP /bridge "+res.status+" : "+txt);
      alert("Erreur bridge HTTP : "+res.status);
      return;
    }
    const data=await res.json();
    log("Bridge réponse : "+JSON.stringify(data));
    if(data.ok){
      alert("Bridge accepté par le backend (voir log).");
      // on redemande les stats pour mettre à jour trésorerie / TVL
      refreshStats();
      sendWs({type:"stats-request"});
    }else{
      alert("Bridge refusé : "+(data.error||"inconnu"));
    }
  }catch(e){
    log("Erreur bridge : "+e.message);
    alert("Erreur bridge : "+e.message);
  }
}

/* ============================================================
   MODULE 4 — DEX + LOG CONTROLS
   ============================================================ */
const btnAddLp=document.getElementById("btnAddLp");
const lpPow=document.getElementById("lpPow");
const lpUsdc=document.getElementById("lpUsdc");
const btnLoadBlocks=document.getElementById("btnLoadBlocks");
const btnClearLog=document.getElementById("btnClearLog");

function addLp(){
  const fireAddr=addrFire.value.trim();
  if(!fireAddr){alert("Génère ou recharge ton wallet FIREINNERS d'abord.");return;}
  const aPow=parseFloat(lpPow.value)||0;
  const aUsdc=parseFloat(lpUsdc.value)||0;
  if(aPow<=0 || aUsdc<=0){
    alert("Montants LP invalides.");
    return;
  }
  sendWs({type:"add-lp",address:fireAddr,pow:aPow,usdc:aUsdc});
  log(`Demande ADD_LP envoyée (${aPow} FIRE / ${aUsdc} USDC FIRE).`);
}

async function loadLastBlocks(){
  try{
    const res=await fetch("/chain?tail=10",{cache:"no-store"});
    if(!res.ok) throw new Error("HTTP "+res.status);
    const chain=await res.json();
    log("Derniers blocs:");
    chain.slice(-10).forEach(b=>{
      log(`Bloc #${b.height} — txs:${b.txs.length} — trésorerieFIRE:${b.treasuryPow} — trésorerieUSDC:${b.treasuryUsdc}`);
    });
  }catch(e){
    log("Erreur lecture /chain : "+e.message);
  }
}

/* ============================================================
   INIT GLOBALE + BOUTONS
   ============================================================ */
window.addEventListener("load",()=>{
  log("Client FIREINNERS chargé.");
  loadFireWalletFromStorage();
  refreshStats();
  initWs();
  setInterval(refreshStats,15000);
});

btnGenFire.onclick=genFireWallet;
btnReloadFire.onclick=loadFireWalletFromStorage;
btnCopyFire.onclick=()=>{
  const a=addrFire.value.trim();
  if(!a){alert("Aucune adresse FIREINNERS à copier.");return;}
  navigator.clipboard.writeText(a).then(()=>{
    log("Adresse FIREINNERS copiée.");
  }).catch(e=>{
    log("Clipboard error: "+e.message);
  });
};

btnConnectPhantom.onclick=connectPhantom;
btnRefreshSol.onclick=refreshSolBalances;
btnBridge.onclick=doBridge;

btnAddLp.onclick=addLp;
btnLoadBlocks.onclick=loadLastBlocks;
btnClearLog.onclick=()=>{logBox.textContent="";};

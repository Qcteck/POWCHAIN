// ------------ BASE58 -------------
const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function b58enc(bytes){
  let d=[0];
  for(let i=0;i<bytes.length;i++){
    let c=bytes[i];
    for(let j=0;j<d.length;j++){
      let x=d[j]*256+c;
      d[j]=x%58;
      c=(x/58)|0;
    }
    while(c>0){d.push(c%58);c=(c/58)|0;}
  }
  let r="";
  for(let k=d.length-1;k>=0;k--)r+=ALPH[d[k]];
  return r;
}
function b58dec(str){
  let b=[0];
  for(let i=0;i<str.length;i++){
    let c=ALPH.indexOf(str[i]);
    for(let j=0;j<b.length;j++){
      let x=b[j]*58+c;
      b[j]=x&255;
      c=x>>8;
    }
    while(c>0){b.push(c&255);c>>=8;}
  }
  return new Uint8Array(b.reverse());
}

// ----------- GLOBAL STATE ------------
let solAddr=null;
let powAddr=null;
let powPriv=null;
let powNonce=0;
let sock=null;
const DEC=1e6;

// ----------- Phantom Connect ----------
async function connectPhantom(){
  try{
    const p=window.solana;
    if(!p) return alert("Phantom non détecté");

    const resp = await p.connect();
    solAddr = resp.publicKey.toString();
    q("#solAddr").value=solAddr;
    log("Phantom connecté : "+solAddr);

    await loadSolBalances();
  }catch(e){
    log("Erreur Phantom : "+e.message);
  }
}
q("#btnPhantom").onclick=connectPhantom;

// ----------- Fetch SOL + USDC Solana ---------
async function loadSolBalances(){
  try{
    const r = await fetch(`https://api.mainnet-beta.solana.com`,{
      method:"POST",
      headers:{ "Content-Type":"application/json"},
      body:JSON.stringify({
        jsonrpc:"2.0",
        id:1,
        method:"getBalance",
        params:[solAddr]
      })
    });
    const j=await r.json();
    q("#solBal").value=(j.result.value/1e9).toFixed(4);

    // USDC SPL
    const r2 = await fetch("https://api.mainnet-beta.solana.com",{
      method:"POST",
      headers:{ "Content-Type":"application/json"},
      body:JSON.stringify({
        jsonrpc:"2.0",
        id:1,
        method:"getTokenAccountsByOwner",
        params:[
          solAddr,
          {mint:"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"},
          {encoding:"jsonParsed"}
        ]
      })
    });
    const j2=await r2.json();
    let bal=0;
    if(j2.result?.value?.length){
      bal=j2.result.value[0].account.data.parsed.info.tokenAmount.uiAmount;
    }
    q("#usdcBal").value=(bal||0).toFixed(2);
  }catch(e){
    log("Bal ERR : "+e.message);
  }
}

// ----------- Wallet POWCHAIN ----------
q("#btnGen").onclick=()=>{
  const kp=nacl.sign.keyPair();
  powAddr=b58enc(kp.publicKey);
  powPriv=b58enc(kp.secretKey);
  powNonce=0;

  q("#powAddr").value=powAddr;
  q("#powPriv").value=powPriv;
  log("Wallet POWCHAIN généré");
};

async function loadPowWallet(){
  if(!powAddr||!powPriv)return alert("Wallet POWCHAIN requis");

  try{
    const r=await fetch(`${API}/wallet/${powAddr}`);
    if(!r.ok) throw Error("ERR "+r.status);
    const w=await r.json();

    powNonce=w.nonce||0;

    q("#powBal").value=(w.pow/DEC).toFixed(6);
    q("#powUSDCBal").value=(w.usdc/DEC).toFixed(6);
    q("#powStakeBal").value=(w.staked/DEC).toFixed(6);
    q("#powNonce").value=powNonce;

    log("Wallet POWCHAIN chargé");
  }catch(e){
    log("Load POW ERR : "+e.message);
  }
}
q("#btnReloadPow").onclick=loadPowWallet;

// ----------- Sign POWCHAIN TX ----------
function signTx(o){
  const payload = {
    type:o.type,
    from:powAddr,
    to:o.to||null,
    amount:o.amount||null,
    token:o.token||null,
    nonce:powNonce+1
  };
  const msg=new TextEncoder().encode(JSON.stringify(payload));
  const sk=b58dec(powPriv);
  const sig=nacl.sign.detached(msg,sk);
  return b58enc(sig);
}

// ----------- Bridge SOL → POWCHAIN ----------
q("#btnBridge").onclick=async()=>{
  if(!solAddr) return alert("Connecte Phantom");
  if(!powAddr) return alert("Génère ou connecte un wallet POWCHAIN");

  let amt=parseFloat(q("#bridgeAmt").value||"0");
  if(amt<=0) return alert("Montant invalide");

  try{
    const tx = await window.solana.request({
      method:"transfer",
      params:{
        to:"BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy",
        lamports:Math.floor(amt*1e9)
      }
    });
    log("Bridge envoyé SOL → trésorerie : "+tx);

    const r=await fetch(`${API}/bridge`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,sol:amt})
    });

    log("Bridge crédit POWCHAIN demandé");
  }catch(e){
    log("Bridge ERR : "+e.message);
  }
};

// ----------- SWAP ----------
q("#btnSwap").onclick=()=>{
  if(!powAddr) return alert("Wallet POWCHAIN requis");
  let amt=parseFloat(q("#swapAmt").value||"0");

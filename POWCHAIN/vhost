// POWCHAIN validator / server.js — HTTP 3000 + WS 7001
require('dotenv').config();
const fs = require('fs');
const path = require('path');
const express = require('express');
const cors = require('cors');
const bodyParser = require('body-parser');
const WebSocket = require('ws');

const PORT_HTTP = process.env.PORT_HTTP || 3000;
const PORT_WS = process.env.PORT_WS || 7001;

// Trésorerie SOL officielle (pour le bridge)
const TREASURY_SOL_ADDR = 'BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy';

// --------------------- ÉTAT GLOBAL --------------------- //
let state = {
  chain: [],
  mempool: [],
  wallets: {},      // addr -> { pow, usdc, staked, lpPow, lpUsdc, whale }
  lpPow: 0,
  lpUsdc: 0,
  treasuryPow: 0,
  treasuryUsdc: 0,
  treasurySol: 0
};

function getWallet(addr) {
  if (!state.wallets[addr]) {
    state.wallets[addr] = { pow: 0, usdc: 0, staked: 0, lpPow: 0, lpUsdc: 0, whale: false };
  }
  return state.wallets[addr];
}

// --------------------- BLOCKCHAIN SIMPLE --------------------- //
function createGenesis() {
  return {
    index: 0,
    time: Date.now(),
    prevHash: 'GENESIS',
    txs: [],
    hash: 'GENESIS'
  };
}

function getLastBlock() {
  return state.chain[state.chain.length - 1];
}

function addBlock(txs) {
  const prev = getLastBlock();
  const block = {
    index: prev.index + 1,
    time: Date.now(),
    prevHash: prev.hash,
    txs,
    hash: 'hash-' + (prev.index + 1) + '-' + Date.now()
  };
  state.chain.push(block);
  return block;
}

// Application des transactions
function applyTx(tx) {
  const t = tx.type;

  if (t === 'TRANSFER') {
    const fromW = getWallet(tx.from);
    const toW = getWallet(tx.to);
    const token = tx.token === 'USDC' ? 'usdc' : 'pow';
    if (fromW[token] >= tx.amount && tx.amount > 0) {
      fromW[token] -= tx.amount;
      toW[token] += tx.amount;
    }

  } else if (t === 'STAKE') {
    const w = getWallet(tx.from);
    if (w.pow >= tx.amount && tx.amount > 0) {
      w.pow -= tx.amount;
      w.staked += tx.amount;
    }

  } else if (t === 'UNSTAKE') {
    const w = getWallet(tx.from);
    if (w.staked >= tx.amount && tx.amount > 0) {
      w.staked -= tx.amount;
      w.pow += tx.amount;
    }

  } else if (t === 'MINT_POW') {
    const w = getWallet(tx.to);
    w.pow += tx.amount;
    state.treasuryPow += tx.amount;

  } else if (t === 'BRIDGE_SOL') {
    // Bridge SOL -> POWCHAIN (crédit POW symbolique)
    const w = getWallet(tx.powAddr);
    const powMint = tx.powMint || tx.amount * 1000;
    w.pow += powMint;
    state.treasurySol += tx.amount;

  } else if (t === 'LP_ADD') {
    const w = getWallet(tx.from);
    if (
      w.pow >= tx.powAmount &&
      w.usdc >= tx.usdcAmount &&
      tx.powAmount > 0 &&
      tx.usdcAmount > 0
    ) {
      w.pow -= tx.powAmount;
      w.usdc -= tx.usdcAmount;
      w.lpPow += tx.powAmount;
      w.lpUsdc += tx.usdcAmount;
      state.lpPow += tx.powAmount;
      state.lpUsdc += tx.usdcAmount;

      // Badge Whale si gros LP
      if (tx.powAmount >= 10000 && tx.usdcAmount >= 10000) {
        w.whale = true;
      }
    }

  } else if (t === 'SWAP') {
    // AMM x*y=k sur pool POW / USDC POW
    const poolPow = state.lpPow;
    const poolUsdc = state.lpUsdc;
    if (poolPow <= 0 || poolUsdc <= 0) return;

    const w = getWallet(tx.from);
    const sideIn = tx.side === 'POW_TO_USDC' ? 'pow' : 'usdc';
    const sideOut = sideIn === 'pow' ? 'usdc' : 'pow';
    const amountIn = tx.amount;
    if (w[sideIn] < amountIn || amountIn <= 0) return;

    const k = poolPow * poolUsdc;
    let newPoolIn, newPoolOut, amountOut;

    if (sideIn === 'pow') {
      newPoolIn = poolPow + amountIn;
      newPoolOut = k / newPoolIn;
      amountOut = poolUsdc - newPoolOut;
      state.lpPow = newPoolIn;
      state.lpUsdc = newPoolOut;
    } else {
      newPoolIn = poolUsdc + amountIn;
      newPoolOut = k / newPoolIn;
      amountOut = poolPow - newPoolOut;
      state.lpUsdc = newPoolIn;
      state.lpPow = newPoolOut;
    }

    if (amountOut <= 0) return;
    w[sideIn] -= amountIn;
    w[sideOut] += amountOut;
  }
}

function mineBlock() {
  if (state.mempool.length === 0) return null;
  const txs = state.mempool.splice(0, state.mempool.length);
  txs.forEach(applyTx);
  const block = addBlock(txs);
  broadcast({ type: 'block', block });
  return block;
}

// Minage PoS simplifié toutes les 8s
setInterval(() => {
  const b = mineBlock();
  if (b) console.log('Bloc miné', b.index, 'tx:', b.txs.length);
}, 8000);

// --------------------- PERSISTENCE --------------------- //
const DATA_FILE = path.join(__dirname, 'powchain_state.json');

function loadState() {
  try {
    if (fs.existsSync(DATA_FILE)) {
      const raw = fs.readFileSync(DATA_FILE, 'utf8');
      const parsed = JSON.parse(raw);
      state = parsed;
      console.log('Blockchain chargée :', state.chain.length, 'blocs');
    } else {
      state.chain = [createGenesis()];
      console.log('Genesis créé');
      saveState();
    }
  } catch (e) {
    console.error('Erreur loadState:', e);
    state.chain = [createGenesis()];
  }
}

function saveState() {
  try {
    fs.writeFileSync(DATA_FILE, JSON.stringify(state, null, 2));
  } catch (e) {
    console.error('Erreur saveState:', e);
  }
}

// sauvegarde périodique
setInterval(saveState, 15000);

// --------------------- API HTTP --------------------- //
const app = express();
app.use(cors());
app.use(bodyParser.json());

function getStatsSnapshot() {
  return {
    lpPow: state.lpPow,
    lpUsdc: state.lpUsdc,
    treasuryPow: state.treasuryPow,
    treasuryUsdc: state.treasuryUsdc,
    treasurySol: state.treasurySol,
    height: state.chain.length,
    treasurySolAddr: TREASURY_SOL_ADDR
  };
}

app.get('/stats', (req, res) => {
  res.json(getStatsSnapshot());
});

app.get('/wallet/:addr', (req, res) => {
  const w = getWallet(req.params.addr);
  res.json({ addr: req.params.addr, ...w });
});

app.post('/tx', (req, res) => {
  const tx = req.body || {};
  if (!tx.type) return res.status(400).json({ error: 'type manquant' });
  tx.time = Date.now();
  state.mempool.push(tx);
  broadcast({ type: 'mempool', tx });
  res.json({ ok: true, queued: true });
});

// Bridge SOL -> POWCHAIN (appelé par le front après Phantom)
app.post('/bridge/sol', (req, res) => {
  const { solAmount, powAddr } = req.body || {};
  if (!solAmount || !powAddr) {
    return res.status(400).json({ error: 'solAmount ou powAddr manquant' });
  }
  const tx = {
    type: 'BRIDGE_SOL',
    from: TREASURY_SOL_ADDR,
    powAddr,
    amount: Number(solAmount),
    time: Date.now()
  };
  state.mempool.push(tx);
  broadcast({ type: 'bridge_request', tx });
  res.json({ ok: true, queued: true });
});

// Ajout de liquidité LP POW/USDC POW
app.post('/lp/add', (req, res) => {
  const { addr, powAmount, usdcAmount } = req.body || {};
  if (!addr || !powAmount || !usdcAmount) {
    return res.status(400).json({ error: 'champs manquants' });
  }
  const tx = {
    type: 'LP_ADD',
    from: addr,
    powAmount: Number(powAmount),
    usdcAmount: Number(usdcAmount),
    time: Date.now()
  };
  state.mempool.push(tx);
  broadcast({ type: 'lp_add_request', tx });
  res.json({ ok: true, queued: true });
});

// Swap sur le DEX interne
app.post('/swap', (req, res) => {
  const { addr, side, amount } = req.body || {};
  if (!addr || !side || !amount) {
    return res.status(400).json({ error: 'champs manquants' });
  }
  const tx = {
    type: 'SWAP',
    from: addr,
    side,
    amount: Number(amount),
    time: Date.now()
  };
  state.mempool.push(tx);
  broadcast({ type: 'swap_request', tx });
  res.json({ ok: true, queued: true });
});

app.get('/chain', (req, res) => {
  res.json({ chain: state.chain });
});

app.get('/block/latest', (req, res) => {
  res.json(getLastBlock());
});

app.get('/block/:index', (req, res) => {
  const idx = Number(req.params.index);
  const b = state.chain.find(b => b.index === idx);
  if (!b) return res.status(404).json({ error: 'block not found' });
  res.json(b);
});

// Santé pour tests
app.get('/health', (req, res) => {
  res.json({ ok: true, height: state.chain.length, mempool: state.mempool.length });
});

// --------------------- WEBSOCKET --------------------- //
let wss = null;

function broadcast(obj) {
  if (!wss) return;
  const msg = JSON.stringify(obj);
  wss.clients.forEach(c => {
    if (c.readyState === WebSocket.OPEN) c.send(msg);
  });
}

function startWs() {
  wss = new WebSocket.Server({ port: PORT_WS });
  wss.on('connection', ws => {
    console.log('Client WebSocket connecté');
    ws.send(JSON.stringify({ type: 'welcome', stats: getStatsSnapshot() }));
    ws.on('close', () => console.log('Client WebSocket déconnecté'));
    ws.on('error', err => console.error('WS client error:', err.message));
  });
  console.log(`WebSocket POWCHAIN sur port ${PORT_WS} (via Nginx /ws si proxy configuré)`);
}

// --------------------- DÉMARRAGE --------------------- //
loadState();

app.listen(PORT_HTTP, () => {
  console.log(`HTTP API POWCHAIN sur port ${PORT_HTTP} (/stats /tx /wallet /block /chain)`);
});

startWs();
      padding:12px 14px;
      box-sizing:border-box;
      min-width:260px;
    }
    .card h2{
      margin:0 0 8px;
      font-size:16px;
      letter-spacing:.5px;
      color:#7dd3fc;
    }
    label{
      font-size:12px;
      opacity:.85;
    }
    input,button,select,textarea{
      width:100%;
      box-sizing:border-box;
      margin:4px 0 8px;
      padding:7px 8px;
      border-radius:6px;
      border:1px solid #1f2937;
      background:#020617;
      color:#e5ecff;
      font-size:13px;
    }
    button{
      cursor:pointer;
      border:1px solid #38bdf8;
      background:linear-gradient(90deg,#0ea5e9,#22c1f1);
      color:#0b1120;
      font-weight:600;
    }
    button:hover{
      filter:brightness(1.05);
    }
    .row{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }
    .small{
      font-size:11px;
      opacity:.8;
    }
    #log{
      height:200px;
      background:#020617;
      border-radius:8px;
      border:1px solid #1f2937;
      padding:6px;
      font-size:11px;
      overflow:auto;
      white-space:pre-wrap;
    }
    .two-cols{
      display:flex;
      gap:14px;
      flex-wrap:wrap;
    }
    .two-cols > div{
      flex:1 1 200px;
    }
    #powQrBox{
      display:flex;
      gap:8px;
      align-items:center;
      margin-top:4px;
    }
    #powQr{
      background:#000;
      border-radius:8px;
      border:1px solid #1f2937;
    }
    .tag{
      font-size:11px;
      opacity:.7;
      margin-top:4px;
    }
  </style>
</head>
<body>
<div id="wrap">
  <h1>POWCHAIN — Client Complet</h1>
  <div class="status-bar">
    <div id="httpStatus" class="pill">Backend : HTTP ?</div>
    <div id="wsStatus" class="pill">WS ?</div>
  </div>

  <div class="grid">

    <!-- Réseau POWCHAIN -->
    <div class="card">
      <h2>RÉSEAU POWCHAIN</h2>
      <div class="two-cols">
        <div>
          <label>Hauteur</label>
          <input id="netHeight" readonly>
          <label>Nb wallets</label>
          <input id="netWallets" readonly>
          <label>TVL POW</label>
          <input id="netTvlPow" readonly>
        </div>
        <div>
          <label>Trésorerie POW</label>
          <input id="netTreasPow" readonly>
          <label>Trésorerie USDC POW</label>
          <input id="netTreasUsdc" readonly>
          <label>Reward par bloc</label>
          <input id="netReward" readonly>
        </div>
      </div>
      <div class="small" id="netInfo">Données HTTP : en attente...</div>
    </div>

    <!-- Wallet POWCHAIN avec QR + copie -->
    <div class="card">
      <h2>WALLET POWCHAIN — GÉNÉRATEUR</h2>
      <label>Adresse POWCHAIN (base58)</label>
      <input id="powAddr" placeholder="Clique sur GÉNÉRER pour créer un wallet local">
      <div class="row">
        <button id="btnGenPow">Générer wallet POWCHAIN</button>
        <button id="btnReloadPow">Recharger</button>
      </div>

      <div id="powQrBox">
        <div style="flex:0 0 120px">
          <canvas id="powQr" width="120" height="120"></canvas>
        </div>
        <div style="flex:1 1 auto">
          <button id="btnCopyPow">Copier adresse</button>
          <div class="tag">
            Le wallet est généré localement (nacl + bs58) et stocké en localStorage.<br>
            Seules les TX signées sont envoyées au serveur POWCHAIN.
          </div>
          <div class="tag" id="powCopyStatus"></div>
        </div>
      </div>

      <div class="two-cols" style="margin-top:8px">
        <div>
          <label>Solde POW</label>
          <input id="powBalPow" readonly>
        </div>
        <div>
          <label>Solde USDC POW</label>
          <input id="powBalUsdc" readonly>
        </div>
      </div>
    </div>

    <!-- Wallet Solana / Phantom -->
    <div class="card">
      <h2>WALLET SOLANA — PHANTOM</h2>
      <div class="row">
        <button id="btnConnectPhantom">Connecter Phantom</button>
        <button id="btnRefreshSol">Refresh</button>
      </div>
      <label>Adresse Solana</label>
      <input id="solAddr" readonly>

      <div class="two-cols">
        <div>
          <label>SOL (wallet)</label>
          <input id="solBal" readonly>
        </div>
        <div>
          <label>USDC Solana</label>
          <input id="usdcSolBal" readonly>
        </div>
      </div>
      <div class="small">
        Soldes lus via RPC drpc Solana mainnet (SOL + USDC EPjFWdd5...). Aucun lien direct avec USDC POWCHAIN interne.
      </div>
    </div>

    <!-- Bridge -->
    <div class="card">
      <h2>BRIDGE vers POWCHAIN</h2>
      <label>Montant SOL à bridger</label>
      <input id="bridgeAmount" placeholder="ex. 0.001" value="0.001">
      <button id="btnBridge">SOL → POWCHAIN</button>
      <div class="small">
        Envoie une requête BRIDGE_REQUEST au serveur POWCHAIN. Les détails du pont sont gérés côté backend.
      </div>
    </div>

    <!-- Actions wallet POWCHAIN -->
    <div class="card">
      <h2>ACTIONS WALLET POWCHAIN</h2>
      <label>Destinataire POWCHAIN</label>
      <input id="sendTo" placeholder="Adresse POWCHAIN destinataire">
      <label>Montant POW</label>
      <input id="sendAmount" placeholder="0.0">
      <button id="btnSendPow">Send</button>

      <label style="margin-top:6px">Montant POW à staker</label>
      <input id="stakeAmount" placeholder="0.0">
      <button id="btnStakePow">Stake</button>
    </div>

    <!-- DEX / LP -->
    <div class="card">
      <h2>DEX POWCHAIN</h2>
      <label>Ajouter de la liquidité (POW / USDC POW)</label>
      <div class="two-cols">
        <div>
          <label>Montant POW</label>
          <input id="lpPow" placeholder="0.0">
        </div>
        <div>
          <label>Montant USDC POW</label>
          <input id="lpUsdc" placeholder="0.0">
        </div>
      </div>
      <button id="btnAddLp">ADD LP</button>
      <div class="small">
        Un add LP ≥ 10 000 POW et 10 000 USDC POW peut donner un badge WHALE (logique à gérer côté serveur).
      </div>
    </div>

    <!-- Explorer & Log -->
    <div class="card" style="flex:1 1 100%">
      <h2>EXPLORER & LOG</h2>
      <div class="row">
        <button id="btnLoadBlocks">Charger derniers blocs</button>
        <button id="btnClearLog">Clear log</button>
      </div>
      <div id="log"></div>
    </div>

  </div><!-- grid -->
</div><!-- wrap -->

<script>
(function(){
  const DRPC_URL = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

  const elHttpStatus = document.getElementById("httpStatus");
  const elWsStatus = document.getElementById("wsStatus");
  const logEl = document.getElementById("log");

  const netHeight = document.getElementById("netHeight");
  const netWallets = document.getElementById("netWallets");
  const netTvlPow = document.getElementById("netTvlPow");
  const netTreasPow = document.getElementById("netTreasPow");
  const netTreasUsdc = document.getElementById("netTreasUsdc");
  const netReward = document.getElementById("netReward");
  const netInfo = document.getElementById("netInfo");

  const powAddr = document.getElementById("powAddr");
  const powBalPow = document.getElementById("powBalPow");
  const powBalUsdc = document.getElementById("powBalUsdc");
  const powCopyStatus = document.getElementById("powCopyStatus");

  const solAddr = document.getElementById("solAddr");
  const solBal = document.getElementById("solBal");
  const usdcSolBal = document.getElementById("usdcSolBal");

  const bridgeAmount = document.getElementById("bridgeAmount");
  const sendTo = document.getElementById("sendTo");
  const sendAmount = document.getElementById("sendAmount");
  const stakeAmount = document.getElementById("stakeAmount");
  const lpPow = document.getElementById("lpPow");
  const lpUsdc = document.getElementById("lpUsdc");

  let ws;
  let qri = null;

  function log(msg){
    const now = new Date();
    const t = now.toTimeString().slice(0,8);
    logEl.textContent += "["+t+"] "+msg+"\n";
    logEl.scrollTop = logEl.scrollHeight;
  }

  function setPill(el, ok, label){
    el.textContent = label;
    if(ok){
      el.classList.remove("bad");
    }else{
      el.classList.add("bad");
    }
  }

  // Init QR
  function ensureQr(){
    if(!qri){
      const canvas = document.getElementById("powQr");
      if(canvas){
        qri = new QRious({
          element: canvas,
          size: 120,
          value: ""
        });
      }
    }
  }

  function updatePowView(addr){
    if(addr) powAddr.value = addr;
    ensureQr();
    if(qri) qri.value = addr || "";
  }

  // ----- HTTP calls -----
  async function fetchJson(path, opts){
    try{
      const res = await fetch(path, opts || {});
      if(!res.ok){
        const txt = await res.text();
        throw new Error("HTTP "+res.status+" "+txt);
      }
      const ct = res.headers.get("content-type") || "";
      if(ct.includes("application/json")){
        return await res.json();
      }
      return await res.json();
    }catch(e){
      log("HTTP error sur "+path+" : "+e.message);
      throw e;
    }
  }

  async function refreshStats(){
    try{
      const data = await fetchJson("/stats");
      setPill(elHttpStatus,true,"Backend : HTTP OK");
      netHeight.value = data.height ?? "";
      netWallets.value = data.wallets ?? "";
      netTvlPow.value = data.tvlPow ?? "-";
      netTreasPow.value = data.treasuryPow ?? 0;
      netTreasUsdc.value = data.treasuryUsdc ?? 0;
      netReward.value = data.reward ?? 0;
      netInfo.textContent = "Données HTTP : height = "+(data.height ?? "?");
    }catch(e){
      setPill(elHttpStatus,false,"Backend : HTTP KO");
    }
  }

  async function refreshPowWallet(){
    try{
      const addr = localStorage.getItem("pow_addr");
      const priv = localStorage.getItem("pow_priv");
      if(!addr || !priv){
        powAddr.placeholder = "Clique sur GÉNÉRER pour créer un wallet local";
        powBalPow.value = "";
        powBalUsdc.value = "";
        updatePowView("");
        return;
      }
      updatePowView(addr);
      const data = await fetchJson("/wallet?id="+encodeURIComponent(addr));
      powBalPow.value = data.pow ?? 0;
      powBalUsdc.value = data.usdc ?? 0;
      log("Wallet POWCHAIN chargé : "+addr);
    }catch(e){
      log("Erreur refresh wallet POWCHAIN : "+e.message);
    }
  }

  // ----- Génération wallet POWCHAIN -----
  function generatePowWallet(){
    try{
      if(typeof nacl === "undefined") throw new Error("nacl non chargé");
      if(typeof bs58 === "undefined") throw new Error("bs58 non chargé");

      const kp = nacl.sign.keyPair();
      const addr = bs58.encode(kp.publicKey);
      const priv = bs58.encode(kp.secretKey);

      localStorage.setItem("pow_addr",addr);
      localStorage.setItem("pow_priv",priv);

      updatePowView(addr);
      powBalPow.value = "0";
      powBalUsdc.value = "0";

      log("Nouveau wallet POWCHAIN généré : "+addr);
      alert("Wallet POWCHAIN généré.");
    }catch(e){
      alert("Erreur génération wallet POWCHAIN : "+e);
      log("Erreur génération wallet POWCHAIN : "+e);
    }
  }

  // ----- Copie adresse + QR déjà géré -----
  async function copyPow(){
    try{
      const addr = powAddr.value.trim();
      if(!addr){
        powCopyStatus.textContent = "Aucune adresse à copier.";
        return;
      }
      if(navigator.clipboard && navigator.clipboard.writeText){
        await navigator.clipboard.writeText(addr);
        powCopyStatus.textContent = "Adresse copiée dans le presse-papier.";
      }else{
        const tmp = document.createElement("textarea");
        tmp.value = addr;
        document.body.appendChild(tmp);
        tmp.select();
        document.execCommand("copy");
        document.body.removeChild(tmp);
        powCopyStatus.textContent = "Adresse copiée (fallback).";
      }
      setTimeout(()=>{powCopyStatus.textContent="";},3000);
    }catch(e){
      powCopyStatus.textContent = "Copie impossible : "+e.message;
    }
  }

  // ----- WebSocket -----
  function connectWs(){
    try{
      const proto = location.protocol === "https:" ? "wss://" : "ws://";
      const url = proto + location.host + "/ws";
      log("WS connect → "+url);
      ws = new WebSocket(url);

      ws.onopen = ()=>{
        log("WebSocket connecté.");
        setPill(elWsStatus,true,"WS OK");
        if(ws.readyState === WebSocket.OPEN){
          ws.send(JSON.stringify({type:"stats"}));
        }
      };
      ws.onmessage = ev=>{
        let data;
        try{ data = JSON.parse(ev.data); }catch{ return; }
        if(data.type === "welcome"){
          log("WS welcome, height="+data.height);
        }else if(data.type === "stats"){
          log("WS msg: "+JSON.stringify(data));
          netHeight.value = data.height ?? netHeight.value;
          netWallets.value = data.wallets ?? netWallets.value;
          netTreasPow.value = data.treasuryPow ?? netTreasPow.value;
          netTreasUsdc.value = data.treasuryUsdc ?? netTreasUsdc.value;
        }
      };
      ws.onerror = ()=>{
        log("WS error.");
        setPill(elWsStatus,false,"WS KO");
      };
      ws.onclose = ()=>{
        log("WebSocket fermé. Reconnexion dans 3 s.");
        setPill(elWsStatus,false,"WS KO");
        setTimeout(connectWs,3000);
      };
    }catch(e){
      log("Erreur WS : "+e.message);
    }
  }

  // ----- Phantom / Solana -----
  async function getProvider(){
    if("solana" in window && window.solana.isPhantom) return window.solana;
    alert("Phantom non détecté.");
    return null;
  }

  async function connectPhantom(){
    try{
      const provider = await getProvider();
      if(!provider) return;
      const resp = await provider.connect();
      const pk = resp.publicKey.toString();
      solAddr.value = pk;
      log("Phantom connecté : "+pk);
      await refreshSolBalances();
    }catch(e){
      log("Erreur connexion Phantom : "+e.message);
      alert("Erreur connexion Phantom : "+e.message);
    }
  }

  async function refreshSolBalances(){
    try{
      const addr = solAddr.value.trim();
      if(!addr) return;
      const conn = new solanaWeb3.Connection(DRPC_URL,"confirmed");
      const pub = new solanaWeb3.PublicKey(addr);

      const lamports = await conn.getBalance(pub);
      solBal.value = (lamports/1e9).toFixed(6);

      const tokAccounts = await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)});
      let usdc = 0;
      for(const it of tokAccounts.value){
        const ui = it.account.data.parsed.info.tokenAmount.uiAmount || 0;
        usdc += ui;
      }
      usdcSolBal.value = usdc.toFixed(2);
      log("Soldes Solana mis à jour.");
    }catch(e){
      log("Erreur refresh soldes Solana : "+e.message);
      alert("Erreur Phantom: "+e.message);
    }
  }

  // ----- TX vers /tx -----
  async function postTx(obj, label){
    try{
      const res = await fetch("/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify(obj)
      });
      const txt = await res.text();
      log(label+" → HTTP "+res.status+" : "+txt);
      if(!res.ok){
        alert(label+" rejetée : "+txt);
      }else{
        try{
          const js = JSON.parse(txt);
          if(js.error) alert(label+" erreur : "+js.error);
          else alert(label+" envoyée.");
        }catch{
          alert(label+" envoyée.");
        }
      }
    }catch(e){
      log(label+" erreur réseau : "+e.message);
      alert(label+" erreur réseau : "+e.message);
    }
  }

  function getPowLocal(){
    const addr = localStorage.getItem("pow_addr");
    const priv = localStorage.getItem("pow_priv");
    if(!addr || !priv) throw new Error("Aucun wallet POWCHAIN local. Génère d'abord un wallet.");
    return {addr,priv};
  }

  // Ici on garde les TX simples : le serveur valide et signe côté backend.
  async function sendBridge(){
    try{
      const sol = solAddr.value.trim();
      if(!sol) throw new Error("Connecte d'abord Phantom.");
      const amount = parseFloat(bridgeAmount.value.replace(",",".")) || 0;
      if(amount <= 0) throw new Error("Montant SOL invalide.");
      const {addr:pow} = getPowLocal();
      const tx = {type:"BRIDGE_REQUEST",from:sol,powAddr:pow,amount};
      log("BRIDGE_REQUEST envoyé SOL "+amount);
      await postTx(tx,"Bridge");
    }catch(e){
      log("Bridge erreur : "+e.message);
      alert("Bridge erreur : "+e.message);
    }
  }

  async function sendPowTx(){
    try{
      const {addr} = getPowLocal();
      const dest = sendTo.value.trim();
      const amt = parseFloat(sendAmount.value.replace(",",".")) || 0;
      if(!dest) throw new Error("Destinataire manquant.");
      if(amt <= 0) throw new Error("Montant invalide.");
      const tx = {type:"TRANSFER",from:addr,to:dest,amount:amt,token:"POW"};
      await postTx(tx,"TX TRANSFER POW");
    }catch(e){
      log("Send POW erreur : "+e.message);
      alert("Send POW erreur : "+e.message);
    }
  }

  async function stakePowTx(){
    try{
      const {addr} = getPowLocal();
      const amt = parseFloat(stakeAmount.value.replace(",",".")) || 0;
      if(amt <= 0) throw new Error("Montant invalide.");
      const tx = {type:"STAKE",from:addr,amount:amt};
      await postTx(tx,"TX STAKE");
    }catch(e){
      log("Stake erreur : "+e.message);
      alert("Stake erreur : "+e.message);
    }
  }

  async function addLpTx(){
    try{
      const {addr} = getPowLocal();
      const aPow = parseFloat(lpPow.value.replace(",",".")) || 0;
      const aUsdc = parseFloat(lpUsdc.value.replace(",",".")) || 0;
      if(aPow <= 0 || aUsdc <= 0) throw new Error("Montants LP invalides.");
      const tx = {type:"ADD_LP",from:addr,amountPow:aPow,amountUsdc:aUsdc};
      await postTx(tx,"TX ADD_LP");
    }catch(e){
      log("LP erreur : "+e.message);
      alert("LP erreur : "+e.message);
    }
  }

  // ----- Explorer -----
  async function loadBlocks(){
    try{
      const data = await fetchJson("/chain");
      log("Chaîne ("+data.length+" blocs) :");
      for(let i=Math.max(0,data.length-10); i<data.length; i++){
        const b = data[i];
        log("Bloc "+b.index+" hash="+b.hash+" tx="+(b.txs?b.txs.length:0));
      }
    }catch(e){
      log("Erreur lecture /chain : "+e.message);
    }
  }

  // ----- Bind UI -----
  document.getElementById("btnGenPow").onclick = generatePowWallet;
  document.getElementById("btnReloadPow").onclick = refreshPowWallet;
  document.getElementById("btnCopyPow").onclick = copyPow;

  document.getElementById("btnConnectPhantom").onclick = connectPhantom;
  document.getElementById("btnRefreshSol").onclick = refreshSolBalances;

  document.getElementById("btnBridge").onclick = sendBridge;
  document.getElementById("btnSendPow").onclick = sendPowTx;
  document.getElementById("btnStakePow").onclick = stakePowTx;
  document.getElementById("btnAddLp").onclick = addLpTx;

  document.getElementById("btnLoadBlocks").onclick = loadBlocks;
  document.getElementById("btnClearLog").onclick = ()=>{logEl.textContent="";};

  // ----- Init -----
  refreshStats();
  refreshPowWallet();
  connectWs();
  setInterval(refreshStats,30000);
})();
</script>
</body>
</html>





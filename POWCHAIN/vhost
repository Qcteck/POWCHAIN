<script>
const $=id=>document.getElementById(id);
const logBox=$("log");
function log(msg,cls=""){
  const line=document.createElement("div");
  if(cls)line.className=cls;
  const ts=new Date().toISOString().split("T")[1].replace("Z","");
  line.textContent=`[${ts}] ${msg}`;
  logBox.appendChild(line);
  logBox.scrollTop=logBox.scrollHeight;
}

let currentAddr="";
let ws=null;
let wsTimer=null;
const API_ROOT="";
const WS_URL=(location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws";

function setWsStatus(online,detail){
  const dot=$("wsDot");
  const label=$("wsLabel");
  const det=$("wsDetail");
  if(online){
    dot.style.background="var(--wsOn)";
    dot.style.boxShadow="0 0 8px var(--wsOn)";
    label.textContent="ws online";
  }else{
    dot.style.background="var(--wsOff)";
    dot.style.boxShadow="0 0 8px var(--wsOff)";
    label.textContent="ws offline";
  }
  det.textContent=detail||"";
}

function connectWS(){
  if(ws){try{ws.close();}catch(e){}ws=null;}
  setWsStatus(false,"connexion…");
  log("Connexion WebSocket "+WS_URL,"logInfo");
  try{
    ws=new WebSocket(WS_URL);
  }catch(e){
    log("Erreur WS (construction): "+e.message,"logErr");
    scheduleWSReconnect();
    return;
  }
  ws.onopen=()=>{
    setWsStatus(true,"connecté");
    log("WebSocket connecté","logOk");
  };
  ws.onclose=ev=>{
    setWsStatus(false,"fermé ("+ev.code+")");
    log("WebSocket fermé, reconnexion…","logWarn");
    scheduleWSReconnect();
  };
  ws.onerror=err=>{
    log("Erreur WebSocket: "+err,"logErr");
  };
  ws.onmessage=ev=>{
    let data;
    try{data=JSON.parse(ev.data);}catch(_){
      log("WS brut: "+ev.data,"logInfo");
      return;
    }
    handleWsMessage(data);
  };
}
function scheduleWSReconnect(){
  if(wsTimer)clearTimeout(wsTimer);
  wsTimer=setTimeout(connectWS,4000);
}

function applyStats(s){
  if(!s)return;
  if(s.height!=null)$("statHeight").textContent=s.height;
  if(s.totalPow!=null)$("statSupply").textContent=(s.totalPow/1e6).toFixed(6);
  const tvl=(Number(s.usdcTreasury||0)+Number(s.lpUsdc||0)/1e6);
  $("statTVL").textContent=tvl.toFixed(3);
  if(s.miningDiff!=null){
    $("statValidators").textContent=s.miningDiff; // indicateur tech pour l’instant
  }
}

function renderMempool(list){
  const box=$("mempoolList");
  box.textContent="";
  (list||[]).forEach(tx=>{
    const d=document.createElement("div");
    d.textContent=`#${tx.id||"?"} ${tx.type||"TX"} • addr=${(tx.addr||tx.from||"?").slice(0,6)}… • data=${JSON.stringify(tx).slice(0,80)}`;
    box.appendChild(d);
  });
}

function prependBlock(b){
  if(!b)return;
  const box=$("explorerList");
  const d=document.createElement("div");
  d.textContent=`#${b.height} • ${b.hash||"?"} • tx=${b.txs?b.txs.length:0}`;
  box.insertBefore(d,box.firstChild);
  while(box.children.length>40)box.removeChild(box.lastChild);
}

function handleWsMessage(msg){
  if(!msg||typeof msg!=="object")return;
  if(msg.type==="hello"){
    log("WS hello: height="+msg.height+" mempool="+msg.mempool,"logInfo");
  }else if(msg.type==="mempool"){
    renderMempool(msg.mempool||[]);
    log("Mempool mis à jour (WS)","logOk");
  }else if(msg.type==="new_block"){
    const b=msg.block||msg;
    prependBlock(b);
    log("Nouveau bloc #"+(b.height||"?"),"logOk");
    refreshStats(); // pour maj supply / TVL
  }else if(msg.type==="mining"){
    log("Mining: "+(msg.msg||JSON.stringify(msg)),"logInfo");
  }else{
    log("WS: "+JSON.stringify(msg),"logInfo");
  }
}

async function apiGET(path){
  try{
    const r=await fetch(API_ROOT+path,{cache:"no-store"});
    if(!r.ok)throw new Error("HTTP "+r.status);
    return await r.json();
  }catch(e){
    log("GET "+path+" -> "+e.message,"logErr");
    throw e;
  }
}
async function apiPOST(path,body){
  try{
    const r=await fetch(API_ROOT+path,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(body||{})
    });
    if(!r.ok)throw new Error("HTTP "+r.status);
    return await r.json();
  }catch(e){
    log("POST "+path+" -> "+e.message,"logErr");
    throw e;
  }
}

async function refreshStats(){
  try{
    const s=await apiGET("/stats");
    applyStats(s);
    log("Stats rechargées","logOk");
  }catch(_){}
}
function refreshExplorer(){
  log("Ping explorer: attendre events /ws (new_block)…","logInfo");
}
async function refreshMempool(){
  try{
    const s=await apiGET("/stats");
    log("Ping mempool: "+(s.mempool||0)+" tx en attente","logInfo");
  }catch(_){}
}

function showAddr(addr){
  currentAddr=addr||"";
  $("walletAddr").value=currentAddr;
  $("addrShort").textContent=currentAddr?short(addr):"non connecté";
  const m=$("minerAddr");
  if(m&&!m.value)m.value=currentAddr;
}
function short(a){
  if(!a||a.length<10)return a||"";
  return a.slice(0,4)+"…"+a.slice(-4);
}

async function loadWallet(){
  const addr=$("walletAddr").value.trim();
  if(!addr){alert("Adresse requise");return;}
  try{
    const w=await apiGET("/wallet/"+encodeURIComponent(addr));
    showAddr(addr);
    $("balPow").textContent=(Number(w.pow||0)/1e6).toFixed(6);
    $("balUsdc").textContent=(Number(w.usdc||0)/1e6).toFixed(6);
    $("balStaked").textContent=(Number(w.staked||0)/1e6).toFixed(6);
    $("stakeInfo").textContent="Staking: "+(Number(w.staked||0)/1e6).toFixed(6)+" POW lock.";
    log("Wallet chargé "+short(addr),"logOk");
  }catch(_){}
}

async function connectPhantom(){
  try{
    const provider=window.solana;
    if(!provider||!provider.isPhantom){
      alert("Phantom non détecté.");
      return;
    }
    const res=await provider.connect();
    const solAddr=res.publicKey.toString();
    log("Phantom connecté "+short(solAddr),"logOk");
  }catch(e){
    log("Erreur Phantom: "+e.message,"logErr");
  }
}

function genLocalAddr(){
  const arr=new Uint8Array(32);
  (window.crypto||crypto).getRandomValues(arr);
  const hex=Array.from(arr).map(b=>b.toString(16).padStart(2,"0")).join("");
  const addr="FIRE"+hex.slice(0,36);
  log("Adresse locale générée "+addr,"logInfo");
  showAddr(addr);
}

async function doBridge(){
  if(!currentAddr){alert("Charge un wallet Fireinners d'abord.");return;}
  const amt=parseFloat($("bridgeAmount").value);
  const sig=$("bridgeSig").value.trim();
  if(!amt||amt<=0){alert("Montant SOL invalide");return;}
  if(!sig){alert("Signature Solana requise");return;}
  try{
    const res=await apiPOST("/bridge",{addr:currentAddr,amount:amt,signature:sig});
    log("Bridge OK: +"+res.creditedFire+" FIRE / +"+res.creditedUsdc+" USDC(FIRE)","logOk");
    loadWallet();
    refreshStats();
  }catch(_){}
}

async function doSwap(){
  if(!currentAddr){alert("Charge un wallet Fireinners d'abord.");return;}
  const amt=parseFloat($("dexAmount").value);
  if(!amt||amt<=0){alert("Montant invalide");return;}
  const dir=$("dexSide").value;
  try{
    const res=await apiPOST("/swap",{addr:currentAddr,dir,amount:amt*1e6});
    log("Swap OK, reçu "+(res.received/1e6).toFixed(6),"logOk");
    loadWallet();
    refreshStats();
  }catch(_){}
}


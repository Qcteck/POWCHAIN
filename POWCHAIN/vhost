const express=require("express");
const cors=require("cors");
const http=require("http");
const WebSocket=require("ws");

const PORT=process.env.PORT?Number(process.env.PORT):3000;
const DEC=1e6;

const app=express();
app.use(cors());
app.use(express.json({limit:"1mb"}));

const state={
  height:0,
  wallets:{},
  mempool:[],
  blocks:[],
  lpPow:0,
  lpUsdc:0,
  totalStaked:0,
  treasury:{sol:0,usdc:0,fire:0}
};

function ensureWallet(addr){
  if(!addr)throw Error("Adresse manquante");
  if(!state.wallets[addr]) state.wallets[addr]={pow:0,usdc:0,staked:0,nonce:0};
  return state.wallets[addr];
}

function simpleHash(str){
  let h=0;
  for(let i=0;i<str.length;i++) h=(h*31+str.charCodeAt(i))>>>0;
  return h.toString(16).padStart(8,"0");
}

function broadcast(obj){
  const msg=JSON.stringify(obj);
  wss.clients.forEach(c=>{ if(c.readyState===WebSocket.OPEN) c.send(msg); });
}

function produceBlock(){
  const txs=state.mempool.splice(0,state.mempool.length);
  state.height++;
  const b={height:state.height,ts:Date.now(),txs,txCount:txs.length};
  b.hash=simpleHash(`${b.height}|${b.ts}|${JSON.stringify(txs)}`);
  state.blocks.push(b);
  broadcast({type:"new_block",block:b});
  return b;
}

function applyTx(tx){
  const w=ensureWallet(tx.addr);

  if(tx.type==="bridge"){
    const solAmount=Number(tx.amount)||0;
    if(solAmount<=0) throw Error("Montant SOL invalide");
    const creditPow=Math.floor(solAmount*1000*DEC);
    const creditUsdc=Math.floor(solAmount*100*DEC);
    w.pow+=creditPow;
    w.usdc+=creditUsdc;
    state.treasury.sol+=solAmount;
    state.treasury.fire+=creditPow;
    state.treasury.usdc+=creditUsdc;
  }

  else if(tx.type==="swap"){
    const dir=tx.dir;
    const amount=Number(tx.amount)||0;
    if(amount<=0) throw Error("Montant swap invalide");
    if(state.lpPow<=0||state.lpUsdc<=0) throw Error("LP vide");

    const feeBps=30; // 0.30%
    if(dir==="pow2usdc"){
      if(w.pow<amount) throw Error("Balance FIRE insuffisante");
      const net=amount*(10000-feeBps)/10000;
      const k=state.lpPow*state.lpUsdc;
      const newPow=state.lpPow+net;
      const newUsdc=k/newPow;
      const out=Math.floor(state.lpUsdc-newUsdc);
      if(out<=0) throw Error("Sortie USDC trop faible");
      w.pow-=amount;
      w.usdc+=out;
      state.lpPow+=net;
      state.lpUsdc-=out;
      state.treasury.fire+=Math.floor(amount-net);
      tx.received=out;
    }else if(dir==="usdc2pow"){
      if(w.usdc<amount) throw Error("Balance USDC insuffisante");
      const net=amount*(10000-feeBps)/10000;
      const k=state.lpPow*state.lpUsdc;
      const newUsdc=state.lpUsdc+net;
      const newPow=k/newUsdc;
      const out=Math.floor(state.lpPow-newPow);
      if(out<=0) throw Error("Sortie FIRE trop faible");
      w.usdc-=amount;
      w.pow+=out;
      state.lpUsdc+=net;
      state.lpPow-=out;
      state.treasury.usdc+=Math.floor(amount-net);
      tx.received=out;
    }else throw Error("Direction inconnue");
  }

  else if(tx.type==="lp_add"){
    const p=Number(tx.pow)||0, u=Number(tx.usdc)||0;
    if(p<=0||u<=0) throw Error("Montants LP invalides");
    if(w.pow<p||w.usdc<u) throw Error("Balance insuffisante LP");
    w.pow-=p; w.usdc-=u;
    state.lpPow+=p; state.lpUsdc+=u;
  }

  else if(tx.type==="stake"){
    const amt=Number(tx.amount)||0;
    if(amt<=0) throw Error("Montant stake invalide");
    if(w.pow<amt) throw Error("Balance FIRE insuffisante");
    w.pow-=amt;
    w.staked+=amt;
    state.totalStaked+=amt;
  }

  else throw Error("Type TX inconnu");

  w.nonce++;
}

app.get("/",(req,res)=>res.send("FIREINNERS backend OK"));
app.get("/wallet/:addr",(req,res)=>{try{res.json(ensureWallet(req.params.addr));}catch(e){res.status(400).json({ok:false,error:e.message});}});
app.post("/bridge",(req,res)=>{try{const tx={type:"bridge",addr:req.body.addr,amount:req.body.amount,signature:req.body.signature||null};state.mempool.push(tx);applyTx(tx);const b=produceBlock();broadcast({type:"mempool",mempool:state.mempool});res.json({ok:true,block:b.height});}catch(e){res.status(400).json({ok:false,error:e.message});}});
app.post("/swap",(req,res)=>{try{const tx={type:"swap",addr:req.body.addr,dir:req.body.dir,amount:req.body.amount};state.mempool.push(tx);applyTx(tx);const b=produceBlock();broadcast({type:"mempool",mempool:state.mempool});res.json({ok:true,received:tx.received||0,block:b.height});}catch(e){res.status(400).json({ok:false,error:e.message});}});
app.post("/lp/add",(req,res)=>{try{const tx={type:"lp_add",addr:req.body.addr,pow:req.body.pow,usdc:req.body.usdc};state.mempool.push(tx);applyTx(tx);const b=produceBlock();broadcast({type:"mempool",mempool:state.mempool});res.json({ok:true,block:b.height});}catch(e){res.status(400).json({ok:false,error:e.message});}});
app.post("/stake",(req,res)=>{try{const tx={type:"stake",addr:req.body.addr,amount:req.body.amount};state.mempool.push(tx);applyTx(tx);const b=produceBlock();broadcast({type:"mempool",mempool:state.mempool});res.json({ok:true,block:b.height});}catch(e){res.status(400).json({ok:false,error:e.message});}});
app.get("/block/:h",(req,res)=>{const b=state.blocks.find(x=>x.height===Number(req.params.h));if(!b)return res.status(404).json({error:"Bloc introuvable"});res.json(b);});
app.get("/stats",(req,res)=>{
  let totalPow=0;
  for(const k in state.wallets) totalPow+=state.wallets[k].pow;
  res.json({
    height:state.height,
    wallets:Object.keys(state.wallets).length,
    mempool:state.mempool.length,
    totalPow,
    totalStaked:state.totalStaked,
    lpPow:state.lpPow,
    lpUsdc:state.lpUsdc,
    solTreasury:state.treasury.sol,
    usdcTreasury:state.treasury.usdc,
    fireTreasury:state.treasury.fire
  });
});

const server=http.createServer(app);

/* ✅ WS CORRECT: même serveur HTTP + path /ws */
const wss=new WebSocket.Server({server,path:"/ws"});

wss.on("connection",ws=>{
  ws.send(JSON.stringify({type:"mempool",mempool:state.mempool}));
  ws.send(JSON.stringify({type:"hello",msg:"ws ok"}));
});

server.listen(PORT,"127.0.0.1",()=>console.log("🔥 FIREINNERS backend sur 127.0.0.1:"+PORT));
EOF


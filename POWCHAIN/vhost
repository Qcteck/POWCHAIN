q("#btnLoadChain").onclick=async()=>{
  try{
    const chain=await jget("/chain");
    if(!Array.isArray(chain)){
      q("#chainList").textContent="Réponse /chain invalide";
      return;
    }
    const last=chain.slice(-30).reverse();
    let txt="";
    last.forEach(b=>{
      txt+="#"+b.height+" | "+(b.hash||"hash ?").slice(0,18)+"... | val: "+(b.validator||"—")+" | txs:"+(b.txs?b.txs.length:0)+" | "+(b.time?new Date(b.time).toLocaleString():"")+"\n";
    });
    q("#chainList").textContent=txt||"Aucun bloc";
    log("Explorer mis à jour");
  }catch(e){
    q("#chainList").textContent="Erreur /chain: "+e.message;
    log("CHAIN ERR "+e.message);
  }
};

document.querySelectorAll("nav a").forEach(x=>{
  x.onclick=()=>{
    const t=x.getAttribute("data-tab");
    document.querySelectorAll("nav a").forEach(a=>a.classList.remove("active"));
    x.classList.add("active");
    document.querySelectorAll("[data-section]").forEach(c=>{
      c.style.display=c.getAttribute("data-section")===t?"block":"none";
    });
  };
});

// état initial des sections
["wallet","network","dex","tools","explorer"].forEach(sec=>{
  document.querySelectorAll('[data-section="'+sec+'"]').forEach(c=>{
    c.style.display=sec==="wallet"?"block":"none";
  });
});

function initSolana(){
  if(!window.solanaWeb3)return;
  solConn=new solanaWeb3.Connection(SOL_RPC,"confirmed");
}
initSolana();

q("#btnPhantom").onclick=async()=>{
  try{
    const provider=window.solana;
    if(!provider||!provider.isPhantom){
      alert("Phantom non détecté");
      return;
    }
    const res=await provider.connect();
    phantomPubkey=res.publicKey;
    const addrStr=phantomPubkey.toBase58();
    q("#phantAddr").textContent=addrStr;
    log("Phantom connecté "+addrStr);

    if(!solConn)initSolana();
    if(!solConn){
      log("Connexion Solana invalide");
      return;
    }

    const lam=await solConn.getBalance(phantomPubkey);
    q("#solBalance").textContent=(lam/1e9).toFixed(5);

    const mint=new solanaWeb3.PublicKey(USDC_MINT_STR);
    const tok=await solConn.getParsedTokenAccountsByOwner(phantomPubkey,{mint});
    let usdc=0;
    if(tok.value&&tok.value.length){
      tok.value.forEach(it=>{
        const info=it.account.data.parsed.info;
        const a=parseFloat(info.tokenAmount.uiAmountString||"0");
        usdc+=a;
      });
    }
    q("#usdcBalance").textContent=usdc.toFixed(2);
    log("SOL/USDC rafraîchis");
  }catch(e){
    log("PHANTOM ERR "+e.message);
    alert("Erreur Phantom: "+e.message);
  }
};
</script>

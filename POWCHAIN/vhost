      return res.status(400).json({ ok: false, error: "Montant SOL invalide" });
    }
    const bridgeTx = { type: "BRIDGE_IN", addr, solAmount: sol };
    // on applique directement, puis on met dans un bloc via mempool pour l'historique
    const resBridge = handleBridgeIn(bridgeTx);
    mempool.push(bridgeTx);
    res.json({ ok: true, bridge: resBridge });
  } catch (e) {
    console.error("Bridge error:", e.message);
    res.status(400).json({ ok: false, error: e.message });
  }
});


      .grid{grid-template-columns:repeat(2,minmax(0,1fr));}
    }
    @media(max-width:720px){
      .grid{grid-template-columns:1fr;}
    }
    .card{
      background:radial-gradient(circle at top,#111827,#020617);
      border-radius:14px;
      border:1px solid #1f2937;

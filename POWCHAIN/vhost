</div></main></div>

<!-- ==================== SCRIPT ==================== -->
<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script>
const API="https://bbqfinance.fun";
const WS_URL="wss://bbqfinance.fun/ws";
const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const DEC=1e6;

function q(s){return document.querySelector(s);}
function log(t){q("#log").innerHTML=`[${new Date().toLocaleTimeString()}] ${t}<br>`+q("#log").innerHTML;}

let solAddr=null,powAddr=null,powPriv=null,powNonce=0,sock=null;

function saveLocal(){localStorage.powAddr=powAddr;localStorage.powPriv=powPriv;}
function loadLocal(){powAddr=localStorage.powAddr||null;powPriv=localStorage.powPriv||null;if(powAddr){q("#powAddr").value=powAddr;q("#powPriv").value=powPriv;log("Wallet local chargé");loadPowWallet();}}

q("#btnReconnectLocal").onclick=loadLocal;

async function phantomSendSOL(amount){
 const p=window.solana;
 if(!p){alert("Phantom manquant");return null;}
 try{
   const to="BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";
   const ix=window.solanaWeb3.SystemProgram.transfer({
     fromPubkey:new window.solanaWeb3.PublicKey(solAddr),
     toPubkey:new window.solanaWeb3.PublicKey(to),
     lamports:amount*1e9
   });
   const tx=new window.solanaWeb3.Transaction().add(ix);
   tx.feePayer=new window.solanaWeb3.PublicKey(solAddr);
   tx.recentBlockhash=(await window.solanaWeb3.Connection.prototype.getRecentBlockhash.call(
     new window.solanaWeb3.Connection(SOL_RPC)
   )).blockhash;
   const signed=await p.signTransaction(tx);
   const raw=await new window.solanaWeb3.Connection(SOL_RPC).sendRawTransaction(signed.serialize());
   log("Bridge Phantom : TX envoyée "+raw);
   return raw;
 }catch(e){log("Bridge Phantom ERR : "+e.message);return null;}
}

async function loadPrices(){
 try{
   const r=await fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana&sui,firo&vs_currencies=usd");
   const j=await r.json();
   q("#ticker").textContent=`BTC $${j.bitcoin.usd} • ETH $${j.ethereum.usd} • SOL $${j.solana.usd}`;
 }catch{q("#ticker").textContent="Prix indisponible";}
}
setInterval(loadPrices,5000);loadPrices();

async function connectPhantom(){
 try{
   const p=window.solana;
   if(!p)return alert("Phantom non trouvé");
   const resp=await p.connect();
   solAddr=resp.publicKey.toString();
   q("#solAddr").value=solAddr;
   log("Phantom connecté : "+solAddr);
   loadSolBalances();
 }catch(e){log("Phantom ERR : "+e.message);}
}
q("#btnPhantom").onclick=connectPhantom;

async function loadSolBalances(){
 if(!solAddr)return;
 try{
   const r=await fetch(SOL_RPC,{method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]})});
   const j=await r.json();
   q("#solBal").value=(j.result.value/1e9).toFixed(4);

   const r2=await fetch(SOL_RPC,{method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getTokenAccountsByOwner",
        params:[solAddr,{mint:USDC_MINT},{encoding:"jsonParsed"}]})});
   const j2=await r2.json();
   let total=0;
   (j2.result.value||[]).forEach(v=>{
     total+=v.account.data.parsed.info.tokenAmount.uiAmount;
   });
   q("#usdcBal").value=total.toFixed(2);
 }catch(e){log("Sol ERR : "+e.message);}
}
q("#btnSolRefresh").onclick=loadSolBalances;

q("#btnGen").onclick=()=>{
 const kp=nacl.sign.keyPair();
 powAddr=btoa(kp.publicKey).slice(0,44);
 powPriv=btoa(kp.secretKey);
 q("#powAddr").value=powAddr;
 q("#powPriv").value=powPriv;
 saveLocal();
 log("Wallet POWCHAIN généré.");
};

async function loadPowWallet(){
 if(!powAddr)return;
 try{
   const r=await fetch(API+"/wallet/"+powAddr);
   const j=await r.json();
   powNonce=j.nonce||0;
   q("#powBal").value=(j.pow/DEC).toFixed(6);
   q("#powUSDCBal").value=(j.usdc/DEC).toFixed(6);
   q("#powStakeBal").value=(j.staked/DEC).toFixed(6);
   q("#powNonce").value=powNonce;
   log("Wallet POWCHAIN chargé.");
 }catch(e){log("POW ERR : "+e.message);}
}
q("#btnReloadPow").onclick=loadPowWallet;

q("#btnBridgePhantom").onclick=async()=>{
 if(!solAddr)return alert("Connect Phantom");
 if(!powAddr)return alert("Gen wallet local");

 const amt=parseFloat(q("#bridgeAmt").value);
 if(!(amt>0))return log("Montant invalide");

 const sig=await phantomSendSOL(amt);
 if(!sig)return;

 const body={addr:powAddr,amount:amt,fromSol:solAddr,txSig:sig};
 const r=await fetch(API+"/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
 const j=await r.json();
 if(j.ok){log("Bridge OK, crédité : "+j.credited/DEC+" POW");loadPowWallet();}
 else log("Bridge backend ERR : "+j.error);
};

function connectWS(){
 try{
   sock=new WebSocket(WS_URL);
   sock.onopen=()=>{q("#syncState").textContent="WS: online";q("#syncState").style.color="#8f8";};
   sock.onclose=()=>{q("#syncState").textContent="WS: offline";q("#syncState").style.color="#f88";setTimeout(connectWS,2000);};
   sock.onmessage=e=>{
     const m=JSON.parse(e.data);
     if(m.type==="mempool")q("#mempoolLive").textContent=JSON.stringify(m.mempool,null,2);
     if(m.type==="clients")log("WS clients : "+m.count);
   };
 }catch(e){log("WS ERR : "+e.message);}
}
connectWS();

document.querySelectorAll(".navitem").forEach(a=>{
 a.onclick=()=>{
   document.querySelectorAll(".navitem").forEach(x=>x.classList.remove("active"));
   a.classList.add("active");
   const tab=a.dataset.tab;
   document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
   q("#"+tab).classList.add("active");
 };
});
</script>
<script src="https://unpkg.com/@solana/web3.js@1.87.0/lib/index.iife.min.js"></script>
</body></html>




#!/bin/bash
set -e

echo "🔥 PATCH BRIDGE FIREINNERS — Buffer FIX (Web + iOS)"

### VARIABLES
HTML="/var/www/bbqfinance.fun/index.html"
SERVER="/root/fireinners/server.js"

### BACKUPS
cp -a "$HTML" "$HTML.bak.$(date +%s)"
cp -a "$SERVER" "$SERVER.bak.$(date +%s)"

echo "✅ Backups faits"

########################################
# 1️⃣ PATCH FRONTEND — Buffer GLOBAL
########################################

# Ajoute Buffer polyfill si absent
if ! grep -q "window.Buffer" "$HTML"; then
  perl -0777 -i -pe 's|</head>|<script src="https://unpkg.com/buffer@6.0.3/index.js"></script>\n<script>window.Buffer=buffer.Buffer;</script>\n</head>|s' "$HTML"
  echo "✅ Buffer injecté côté HTML"
else
  echo "ℹ️ Buffer déjà présent dans HTML"
fi

########################################
# 2️⃣ PATCH JS — BRIDGE SAFE BUFFER
########################################

# Sécurise tous les Buffer.from
perl -i -pe 's/Buffer\.from\(/(window.Buffer?Buffer:buffer.Buffer).from(/g' "$HTML"

echo "✅ Bridge frontend sécurisé"

########################################
# 3️⃣ PATCH BACKEND — BRIDGE ROBUSTE
########################################

# Force Buffer côté Node (sécurité)
if ! grep -q "global.Buffer" "$SERVER"; then
  sed -i '1irequire("buffer").Buffer && (global.Buffer=require("buffer").Buffer);' "$SERVER"
  echo "✅ Buffer forcé côté server.js"
else
  echo "ℹ️ Buffer déjà défini côté backend"
fi

########################################
# 4️⃣ RESTART SERVICES
########################################

pm2 restart fireinners
systemctl reload nginx

echo "🚀 Services redémarrés"

########################################
# 5️⃣ TEST RAPIDE
########################################

echo "🔍 Test WS local"
timeout 2 wscat -c wss://bbqfinance.fun/ws || true

echo "🔥 PATCH BRIDGE FIREINNERS TERMINÉ AVEC SUCCÈS"
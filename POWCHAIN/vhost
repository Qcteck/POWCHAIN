app.use(bodyParser.json());

const PORT_HTTP = 3000;
const PORT_WS = 7001;
const DEC = 1e6;

function now() {
  return Date.now();
}

function newWallet(addr) {
  return {
    addr,
    fire: 0,
    usdc: 0,
    staked: 0,
    lp: 0,
    nonce: 0,
    pub: addr
  };
}

const wallets = new Map();
function ensureWallet(addr) {
  if (!wallets.has(addr)) wallets.set(addr, newWallet(addr));
  return wallets.get(addr);
}

const TREASURY_ADDR = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

let chain = [];
let mempool = [];

let state = {
  height: 0,
  supplyFIRE: 0,
  lpFIRE: 0,
  lpUSDCFIRE: 0,
  treasuryUsdc: 0,
  treasurySol: 0
};

function hashBlock(b) {
  const base = JSON.stringify({
    height: b.height,
    prev: b.prev,
    time: b.time,
    txs: b.txs
  });
  let h = 0;
  for (let i = 0; i < base.length; i++) {
    h = (h * 31 + base.charCodeAt(i)) | 0;
  }
  return "FI" + (h >>> 0).toString(16).padStart(8, "0");
}

function applyTx(tx) {
  switch (tx.type) {
    case "TX_POW": {
      const from = ensureWallet(tx.from);
      const to = ensureWallet(tx.to);
      const amt = tx.amount | 0;
      if (amt <= 0) return;
      if (from.fire < amt) return;
      from.fire -= amt;
      to.fire += amt;
      from.nonce = Math.max(from.nonce, tx.nonce || 0);
      state.supplyFIRE = totalSupplyFIRE();
      break;
    }
    case "STAKE": {
      const w = ensureWallet(tx.from);
      const amt = tx.amount | 0;
      if (amt <= 0) return;
      if (w.fire < amt) return;
      w.fire -= amt;
      w.staked += amt;
      w.nonce = Math.max(w.nonce, tx.nonce || 0);
      break;
    }
    case "LP_ADD": {
      const w = ensureWallet(tx.from);
      const fireAmt = tx.pow | 0;
      const usdcAmt = tx.usdc | 0;
      if (fireAmt <= 0 || usdcAmt <= 0) return;
      if (w.fire < fireAmt || w.usdc < usdcAmt) return;
      w.fire -= fireAmt;
      w.usdc -= usdcAmt;
      state.lpFIRE += fireAmt;
      state.lpUSDCFIRE += usdcAmt;
      const lpMinted = Math.floor(Math.sqrt(fireAmt * usdcAmt));
      w.lp += lpMinted;
      w.nonce = Math.max(w.nonce, tx.nonce || 0);
      break;
    }
    case "SWAP": {
      const w = ensureWallet(tx.from);
      const amt = tx.amount | 0;
      if (amt <= 0) return;
      if (!state.lpFIRE || !state.lpUSDCFIRE) return;
      const k = state.lpFIRE * state.lpUSDCFIRE;
      const feeBps = 30;
      if (tx.token === "pow2usdc") {
        if (w.fire < amt) return;
        const amtNoFee = Math.floor(amt * (10000 - feeBps) / 10000);
        const newFire = state.lpFIRE + amtNoFee;
        const newUsdc = Math.floor(k / newFire);
        const out = state.lpUSDCFIRE - newUsdc;
        if (out <= 0) return;
        w.fire -= amt;
        w.usdc += out;
        state.lpFIRE += amtNoFee;
        state.lpUSDCFIRE -= out;
        const fee = amt - amtNoFee;
        const tres = ensureWallet(TREASURY_ADDR);
        tres.fire += fee;
      } else if (tx.token === "usdc2pow") {
        if (w.usdc < amt) return;
        const amtNoFee = Math.floor(amt * (10000 - feeBps) / 10000);
        const newUsdc = state.lpUSDCFIRE + amtNoFee;
        const newFire = Math.floor(k / newUsdc);
        const out = state.lpFIRE - newFire;
        if (out <= 0) return;
        w.usdc -= amt;
        w.fire += out;
        state.lpUSDCFIRE += amtNoFee;
        state.lpFIRE -= out;
        const fee = amt - amtNoFee;
        const tres = ensureWallet(TREASURY_ADDR);
        tres.usdc += fee;
      }
      w.nonce = Math.max(w.nonce, tx.nonce || 0);
      state.supplyFIRE = totalSupplyFIRE();
      break;
    }
    case "BRIDGE_IN": {
      const w = ensureWallet(tx.from);
      const amt = tx.amount | 0;
      if (amt <= 0) return;
      w.fire += amt;
      state.supplyFIRE = totalSupplyFIRE();
      break;
    }
    default:
      break;
  }
}

function totalSupplyFIRE() {
  let sum = 0;
  for (const w of wallets.values()) sum += w.fire + w.staked + w.lp;
  return sum;
}

function makeBlock(txs) {
  const height = chain.length;
  const prev = chain.length ? chain[chain.length - 1].hash : "GENESIS";
  const time = now();
  const blk = { height, prev, time, txs: txs.slice(), hash: "" };
  blk.hash = hashBlock(blk);
  return blk;
}

function commitBlock(txs) {
  if (!txs.length) return null;
  for (const tx of txs) applyTx(tx);
  const blk = makeBlock(txs);
  chain.push(blk);
  state.height = blk.height;
  state.supplyFIRE = totalSupplyFIRE();
  return blk;
}

const genesis = makeBlock([]);

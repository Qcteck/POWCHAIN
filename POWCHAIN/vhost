nano /etc/nginx/sites-available/bbqfinance



server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;
    return 301 https://bbqfinance.fun$request_uri;
}

server {
    listen 443 ssl;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        try_files $uri /index.html;
    }

    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        include /etc/nginx/proxy_params;
    }

    location /wallet/ {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params;
    }

    location /block/ {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
        include /etc/nginx/proxy_params;
    }

    location /tx {
        proxy_pass http://127.0.0.1:3000/tx;
        include /etc/nginx/proxy_params;
    }

    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
}
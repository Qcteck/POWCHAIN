// BANNIÈRE NEWS (CryptoNews)
async function refreshNews(){
  try{
    const r=await fetch("https://cryptonews.com/news/feed");
    const xml=await r.text();
    const doc=new DOMParser().parseFromString(xml,"application/xml");
    const items=[...doc.querySelectorAll("item")].slice(0,6).map(i=>{
      const t=i.querySelector("title");
      return t?t.textContent.trim():"";
    }).filter(Boolean);
    const nb=q("#newsBannerText");
    if(nb)nb.textContent=items.join(" • ");
  }catch(e){
    log("News ERR : "+e.message);
  }
}
refreshNews();

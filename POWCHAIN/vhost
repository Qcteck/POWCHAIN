<script>
const API="https://bbqfinance.fun";
const WS_URL="wss://bbqfinance.fun/ws";
const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR4ac"; // ton RPC drpc
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const DEC=1e6;

const q=s=>document.querySelector(s);
const log=t=>{
  q("#log").innerHTML=`[${new Date().toLocaleTimeString()}] ${t}\n`+q("#log").innerHTML;
};

let solAddr=null;
let powAddr=null;
let powPriv=null;
let fireAddr=null;
let fireColor=null;
let powNonce=0;
let sock=null;
let qrObj=null;

/* --------- RANDOM + FIREINNERS ADDRESS ---------- */
function randInt(min,max){
  return Math.floor(Math.random()*(max-min+1))+min;
}
function randDigit(){
  return String(randInt(0,9));
}
function randLetter(){
  return String.fromCharCode(65+randInt(0,25));
}
function pickFireColor(){
  const r=Math.random();
  if(r<0.03)return"multicolore";
  if(r<0.05)return"gold";
  if(r<0.06)return"army";
  const rest=["vert","or","blanc","noire","rouge","argent","mauve","orange","gris","jaune","violet"];
  return rest[randInt(0,rest.length-1)];
}
function colorToHex(c){
  switch(c){
    case"vert":return"#22c55e";
    case"or":return"#facc15";
    case"blanc":return"#f9fafb";
    case"noire":return"#020617";
    case"rouge":return"#ef4444";
    case"argent":return"#e5e7eb";
    case"mauve":return"#a855f7";
    case"orange":return"#fb923c";
    case"gris":return"#9ca3af";
    case"jaune":return"#fde047";
    case"violet":return"#8b5cf6";
    case"multicolore":return"#22d3ee";
    case"army":return"#4b5563";
    case"gold":return"#facc15";
    default:return"#f97316";
  }
}
function genFireinnersIdentity(){
  const seg1=randDigit()+randLetter()+randDigit()+randLetter();   // N L N L
  const seg2=randLetter()+randDigit()+randLetter()+randDigit();   // L N L N
  const num=randInt(1,100000000);
  const col=pickFireColor();
  const addr=`441-FIRE-${seg1}/inners/${seg2}/${num}/${col}`;
  return{addr,color:col};
}

/* --------- QR ---------- */
function drawQR(text,colorName){
  const box=q("#qrBox");
  const hex=colorToHex(colorName||"orange");
  box.style.borderColor=hex;
  box.style.boxShadow=`0 0 18px ${hex}88`;
  const qrDiv=q("#qr");
  qrDiv.innerHTML="";
  qrObj=new QRCode(qrDiv,{
    text:text||"",
    width:130,
    height:130,
    colorDark:hex,
    colorLight:"#ffffff",
    correctLevel:QRCode.CorrectLevel.M
  });
}

/* --------- PRICES BANNER ---------- */
async function loadPrices(){
  try{
    const r=await fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd");
    const j=await r.json();
    const btc=j.bitcoin?.usd??0;
    const eth=j.ethereum?.usd??0;
    const sol=j.solana?.usd??0;
    const sui=j.sui?.usd??0;
    const fire="0.000001"; // placeholder
    q("#priceMarquee").textContent=`BTC $${btc} • ETH $${eth} • SOL $${sol} • SUI $${sui} • FIREINNERS $${fire} • BTC $${btc} • ETH $${eth} • SOL $${sol}`;
  }catch(e){
    q("#priceMarquee").textContent="Prix indisponible pour le moment";
  }
}
loadPrices();
setInterval(loadPrices,15000);

/* --------- PHANTOM ---------- */
async function connectPhantom(){
  try{
    const p=window.solana;
    if(!p||!p.isPhantom){alert("Phantom non détecté");return;}
    const resp=await p.connect();
    solAddr=resp.publicKey.toString();
    q("#solAddr").value=solAddr;
    log("Phantom connecté : "+solAddr);
    await loadSolBalances();
  }catch(e){log("Phantom ERR : "+e.message);}
}
q("#btnPhantom").onclick=connectPhantom;

async function loadSolBalances(){
  if(!solAddr)return;
  try{
    const bodyBal={jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]};
    const r=await fetch(SOL_RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(bodyBal)});
    const j=await r.json();
    const lam=j.result?.value||0;
    q("#solBal").value=(lam/1e9).toFixed(4);

    const bodyUSDC={jsonrpc:"2.0",id:2,method:"getTokenAccountsByOwner",
      params:[solAddr,{mint:USDC_MINT},{encoding:"jsonParsed"}]};
    const r2=await fetch(SOL_RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(bodyUSDC)});
    const j2=await r2.json();
    let total=0;
    (j2.result?.value||[]).forEach(a=>{
      const v=a.account?.data?.parsed?.info?.tokenAmount?.uiAmount||0;
      total+=v;
    });
    q("#usdcBal").value=total.toFixed(2);
  }catch(e){log("Sol balances ERR : "+e.message);}
}
q("#btnSolRefresh").onclick=loadSolBalances;

/* --------- WALLET FIREINNERS ---------- */
function saveLocal(){
  if(fireAddr)localStorage.fireAddr=fireAddr;
  if(fireColor)localStorage.fireColor=fireColor;
  if(powAddr)localStorage.powAddr=powAddr;
  if(powPriv)localStorage.powPriv=powPriv;
}
function loadLocal(){
  fireAddr=localStorage.fireAddr||null;
  fireColor=localStorage.fireColor||null;
  powAddr=localStorage.powAddr||null;
  powPriv=localStorage.powPriv||null;
  if(fireAddr){
    q("#fireAddr").value=fireAddr;
    q("#fireColor").value=fireColor||"-";
    q("#powAddr").value=powAddr||"-";
    q("#powPriv").value=powPriv||"-";
    drawQR(fireAddr,fireColor);
    log("Wallet FIREINNERS rechargé depuis localStorage");
    loadPowWallet();
  }else{
    log("Aucun wallet FIREINNERS en local.");
  }
}
q("#btnReconnectLocal").onclick=loadLocal;

q("#btnGen").onclick=()=>{
  const id=genFireinnersIdentity();
  fireAddr=id.addr;
  fireColor=id.color;
  // On peut générer une clé technique, mais non utilisée pour signer (placeholder)
  powAddr=fireAddr; // adresse interne = identifiant FIREINNERS
  powPriv="LOCAL-FIREINNERS-"+String(Date.now());
  powNonce=0;
  q("#fireAddr").value=fireAddr;
  q("#fireColor").value=fireColor;
  q("#powAddr").value=powAddr;
  q("#powPriv").value=powPriv;
  drawQR(fireAddr,fireColor);
  saveLocal();
  log("Nouveau wallet FIREINNERS généré.");
};

/* --------- WALLET POWCHAIN (backend) ---------- */
async function loadPowWallet(){
  if(!powAddr){alert("Wallet FIREINNERS requis");return;}
  try{
    const r=await fetch(`${API}/wallet/${encodeURIComponent(powAddr)}`);
    if(!r.ok)throw new Error("HTTP "+r.status);
    const w=await r.json();
    powNonce=w.nonce||0;
    q("#powBal").value=(w.pow/DEC).toFixed(6);
    q("#powUSDCBal").value=(w.usdc/DEC).toFixed(6);
    q("#powStakeBal").value=(w.staked/DEC).toFixed(6);
    q("#powNonce").value=powNonce;
    log("Wallet POWCHAIN chargé depuis le backend.");
  }catch(e){log("POWCHAIN ERR : "+e.message);}
}
q("#btnReloadPow").onclick=loadPowWallet;

/* --------- BRIDGE SOL → POWCHAIN (Phantom + backend sécurisé) ---------- */
async function phantomSendSOL(amountSol){
  if(!solAddr){alert("Connecte Phantom d'abord");return null;}
  try{
    const conn=new solanaWeb3.Connection(SOL_RPC,"confirmed");
    const fromPub=new solanaWeb3.PublicKey(solAddr);
    const toPub=new solanaWeb3.PublicKey("BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy");
    const ix=solanaWeb3.SystemProgram.transfer({
      fromPubkey:fromPub,
      toPubkey:toPub,
      lamports:Math.floor(amountSol*1e9)
    });
    const tx=new solanaWeb3.Transaction().add(ix);
    tx.feePayer=fromPub;
    tx.recentBlockhash=(await conn.getLatestBlockhash()).blockhash;
    const res=await window.solana.signAndSendTransaction(tx);
    const sig=res.signature||res; // selon version Phantom
    log("TX Solana envoyée : "+sig);
    return sig;
  }catch(e){
    log("Phantom bridge ERR : "+e.message);
    return null;
  }
}

q("#btnBridgePhantom").onclick=async()=>{
  if(!powAddr){alert("Génère ou reconnecte un wallet FIREINNERS d'abord");return;}
  if(!solAddr){alert("Connecte Phantom d'abord");return;}
  const raw=q("#bridgeAmt").value.trim();
  const amt=parseFloat(raw);
  if(!raw||isNaN(amt)||amt<=0){log("Bridge : montant invalide");return;}
  const sig=await phantomSendSOL(amt);
  if(!sig){log("Bridge annulé côté Solana.");return;}
  try{
    const body={addr:powAddr,amount:amt,fromSol:solAddr,txSig:sig};
    const r=await fetch(`${API}/bridge`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(body)
    });
    const j=await r.json();
    if(j.ok){
      log("Bridge validé par le backend. Crédit POWCHAIN : "+(j.credited/DEC).toFixed(6)+" POW");
      loadPowWallet();
    }else{
      log("Bridge backend rejeté : "+(j.error||"inconnu"));
    }
  }catch(e){
    log("Bridge backend ERR : "+e.message);
  }
};

/* --------- DEX / STAKE (HTTP) ---------- */
q("#btnSwap").onclick=async()=>{
  if(!powAddr){alert("Wallet FIREINNERS requis");return;}
  const a=parseFloat(q("#swapAmt").value||"0");
  if(!(a>0)){log("Swap : montant invalide");return;}
  const dir=q("#swapDir").value;
  try{
    const r=await fetch(`${API}/swap`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,dir,amount:Math.floor(a*DEC)})
    });
    const j=await r.json();
    if(j.ok){
      log(`Swap ${dir} OK, reçu ${(j.received/DEC).toFixed(6)}`);
      loadPowWallet();
    }else{
      log("Swap ERR : "+(j.error||"inconnu"));
    }
  }catch(e){log("Swap HTTP ERR : "+e.message);}
};

q("#btnStake").onclick=async()=>{
  if(!powAddr){alert("Wallet FIREINNERS requis");return;}
  const a=parseFloat(q("#stakeAmt").value||"0");
  if(!(a>0)){log("Stake : montant invalide");return;}
  try{
    const r=await fetch(`${API}/stake`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,amount:Math.floor(a*DEC)})
    });
    const j=await r.json();
    if(j.ok){
      log("Stake OK pour "+a+" POW.");
      loadPowWallet();
    }else{
      log("Stake ERR : "+(j.error||"inconnu"));
    }
  }catch(e){log("Stake HTTP ERR : "+e.message);}
};

/* --------- EXPLORER / STATS ---------- */
q("#btnBlock").onclick=async()=>{
  const h=parseInt(q("#blockInp").value||"0",10);
  if(!(h>0))return;
  try{
    const r=await fetch(`${API}/block/${h}`);
    const b=await r.json();
    q("#blockOut").textContent=JSON.stringify(b,null,2);
  }catch(e){
    q("#blockOut").textContent="Erreur : "+e.message;
  }
};

async function refreshStats(){
  try{
    const r=await fetch(`${API}/stats`);
    const s=await r.json();
    q("#sHeight").value=s.height;
    q("#sWallets").value=s.wallets;
    q("#sMP").value=s.mempool;
    q("#sPOW").value=s.totalPow;
    q("#sStaked").value=s.totalStaked;
    q("#sLPpow").value=s.lpPow;
    q("#sLPusdc").value=s.lpUsdc;
    q("#sTSol").value=s.solTreasury;
    q("#sTUsdc").value=s.usdcTreasury;
    q("#sTFire").value=s.fireTreasury;
  }catch(e){
    log("Stats ERR : "+e.message);
  }
}
refreshStats();
setInterval(refreshStats,5000);

/* --------- WS MEMPOOL ---------- */
function connectWS(){
  try{
    sock=new WebSocket(WS_URL);
    sock.onopen=()=>{
      q("#syncState").textContent="WS: online";
      q("#syncState").style.color="#bbf7d0";
      q("#syncState").style.borderColor="#22c55e";
      log("WebSocket connecté.");
    };
    sock.onclose=()=>{
      q("#syncState").textContent="WS: offline";
      q("#syncState").style.color="#fecaca";
      q("#syncState").style.borderColor="#f97316";
      log("WS fermé, reconnexion dans 3s...");
      setTimeout(connectWS,3000);
    };
    sock.onerror=e=>{
      log("WS erreur.");
    };
    sock.onmessage=e=>{
      try{
        const m=JSON.parse(e.data);
        if(m.type==="mempool"){
          q("#mempoolLive").textContent=JSON.stringify(m.mempool,null,2);
        }else if(m.type==="clients"){
          log("Clients WS connectés : "+m.count);
        }else if(m.type==="new_block"){
          log("Nouveau bloc #"+m.block.height);
        }
      }catch(err){}
    };
  }catch(e){
    log("WS fatal ERR : "+e.message);
  }
}
connectWS();


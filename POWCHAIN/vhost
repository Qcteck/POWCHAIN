<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>FIREINNERS — Client Complet</title>
<script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
<style>
:root{
 --bg:#070b0d;
 --card:#10161b;
 --card2:#0d1418;
 --txt:#e6e7e8;
 --accent:#f4c542;
 --burn:#c96b1b;
 --green:#22c55e;
 --error:#e64545;
 --border:#28323a;
 --grey:#9ca3af;
 font-family:system-ui,Segoe UI,Arial;
}
body{
 margin:0;
 background:var(--bg);
 color:var(--txt);
}
.panel{
 background:var(--card);
 border:1px solid var(--border);
 border-radius:14px;
 padding:18px;
 margin-bottom:18px;
 box-shadow:0 0 22px #0008;
}
h2,h3{
 margin:6px 0 12px;
 color:var(--accent);
}
button{
 border:1px solid var(--accent);
 background:linear-gradient(135deg,#f4c542,#c96b1b);
 color:#000;
 padding:8px 14px;
 border-radius:8px;
 font-weight:600;
 cursor:pointer;
 transition:.2s;
}
button:hover{
 filter:brightness(1.14);
}
input{
 width:100%;
 padding:8px;
 background:#0c1317;
 border:1px solid var(--border);
 color:var(--txt);
 border-radius:8px;
 margin-bottom:10px;
}
#statusBox span{
 display:inline-block;
 margin-right:12px;
 padding:4px 8px;
 border-radius:6px;
 font-size:14px;
}
.ok{background:#06310f;color:var(--green);border:1px solid var(--green)}
.bad{background:#310d0d;color:var(--error);border:1px solid var(--error)}
.log{
 font-size:13px;
 white-space:pre-wrap;
 background:#0008;
 padding:8px;
 border:1px solid #333;
 border-radius:8px;
 max-height:260px;
 overflow-y:auto;
}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px}
</style>
</head>
<body>
<div style="max-width:1200px;margin:0 auto;padding:20px">

<h2 style="text-align:center;font-size:30px;color:var(--accent);text-shadow:0 0 4px #000">🔥 FIREINNERS — CLIENT COMPLET</h2>

<div id="statusBox" class="panel" style="text-align:center">
<span id="api" class="bad">Backend ❌</span>
<span id="ws" class="bad">WebSocket ❌</span>
</div>

<div class="panel">
<h3>Wallet FIREINNERS</h3>
<div class="grid2">
<div>
<button onclick="genWallet()">Générer Wallet FIREINNERS</button>
<input id="addrFire" readonly placeholder="Adresse FIREINNERS"/>
</div>
<div>
<input id="privFire" placeholder="Clé privée FIREINNERS (base58)"/>
<button onclick="loadWallet()">Charger Wallet FIREINNERS</button>
</div>
</div>
<div>Solde FIRE : <span id="balFire">0</span> | USDC FIRE : <span id="balUSDCF">0</span><br>Supply circulante : <span id="supplyC">0</span> | Supply disponible : <span id="supplyD">0</span></div>
</div>

<div class="panel">
<h3>WALLET SOLANA — PHANTOM</h3>
<input id="solAddr" readonly placeholder="Adresse Solana"/>
<div class="grid2">
<button onclick="connectPhantom()" style="background:var(--green);color:#000">Connecter Phantom</button>
<button onclick="refreshSol()">Refresh</button>
</div>
<div>SOL : <span id="balSol">0</span> | USDC Solana : <span id="balUSDCsol">0</span></div>
</div><div class="panel">
<h3>BRIDGE SOL → FIREINNERS</h3>
<input id="amtBridge" placeholder="Montant SOL à bridger"/>
<button onclick="bridgeSol()" style="background:var(--accent);color:#000;font-size:17px">SOL → FIREINNERS</button>
<div style="margin-top:8px;color:var(--grey);font-size:14px">Le bridge crée / mint des FIRE selon le prix interne (TVL / LP).</div>
</div>

<div class="panel">
<h3>DEX FIREINNERS — LP + Swap</h3>
<div class="grid2">
<div>
<b>Ajouter liquidité</b>
<input id="lpFire" placeholder="Montant FIRE"/>
<input id="lpUSDCF" placeholder="Montant USDC FIRE"/>
<button onclick="addLP()">Ajouter LP</button>
</div>
<div>
<b>Swap</b>
<input id="swapAmt" placeholder="Entrée montant"/>
<select id="swapSide">
<option value="F2U">FIRE → USDC FIRE</option>
<option value="U2F">USDC FIRE → FIRE</option>
</select>
<button onclick="swap()">Swap</button>
</div>
</div>
</div>

<div class="panel">
<h3>Logs</h3>
<div id="logs" class="log"></div>
</div>

</div>

<script>
const API = "/";
let SK=null,PK=null;

// ---- LOG ----
function log(x){ let l=document.getElementById("logs"); l.textContent += "["+(new Date().toLocaleTimeString())+"] "+x+"\n"; l.scrollTop = l.scrollHeight; }

// ---- BACKEND STATUS ----
async function checkBack(){
 try{
  await fetch(API+"stats",{method:"GET",cache:"no-store"});
  document.getElementById("api").className="ok"; document.getElementById("api").textContent="Backend ✔";
 }catch{ document.getElementById("api").className="bad"; document.getElementById("api").textContent="Backend ❌"; }

 if(ws && ws.readyState===1){ wsStatus(true)} else { wsStatus(false) }
}
function wsStatus(st){ let e=document.getElementById("ws"); if(st){e.className="ok";e.textContent="WebSocket ✔"}else{e.className="bad";e.textContent="WebSocket ❌"} }

// ---- FIREINNERS ----
function genWallet(){
 const kp=nacl.sign.keyPair();
 SK = bs58.encode(kp.secretKey);
 PK = bs58.encode(kp.publicKey);
 document.getElementById("addrFire").value = PK;
 log("Wallet FIREINNERS généré");
}
function loadWallet(){
 SK=document.getElementById("privFire").value.trim();
 if(!SK) return;
 try{ PK = bs58.encode(nacl.sign.keyPair.fromSecretKey(bs58.decode(SK)).publicKey); }
 catch(e){ log("Clé privée invalide"); return; }
 document.getElementById("addrFire").value = PK;
 log("Wallet FIREINNERS chargé");
 refresh();
}

// ---- FIREINNERS STATS ----
async function refresh(){
 if(!PK) return;
 try{
  let r = await (await fetch(API+"wallet/"+PK)).json();
  document.getElementById("balFire").textContent = r.fire;
  document.getElementById("balUSDCF").textContent = r.usdc;
  document.getElementById("supplyC").textContent = r.supplyC;
  document.getElementById("supplyD").textContent = r.supplyD;
 }catch(e){ log("Erreur refresh FIREINNERS") }
}

// ---- SOLANA WALLET ----
async function connectPhantom(){
 if(!window.solana){ log("Phantom non détecté"); return; }
 const res = await window.solana.connect();
 document.getElementById("solAddr").value = res.publicKey.toString();
 refreshSol();
 log("Phantom connecté");
}
async function refreshSol(){
 let a=document.getElementById("solAddr").value;
 if(!a) return;
 try{
   const conn=new solanaWeb3.Connection("https://api.mainnet-beta.solana.com");
   const bal = await conn.getBalance(new solanaWeb3.PublicKey(a))/1e9;
   document.getElementById("balSol").textContent = bal.toFixed(6);
   document.getElementById("balUSDCsol").textContent = 0;
   log("Solana wallet mis à jour");
 }catch(e){ log("Erreur Solana RPC") }
}

// ---- BRIDGE ----
async function bridgeSol(){
 if(!PK) return log("Charger un wallet FIREINNERS");
 let amt=document.getElementById("amtBridge").value;
 if(!amt) return;

 let tx = {type:"bridge",to:PK,amount:amt,nonce:Date.now()};
 let sig = sign(tx);
 let r = await fetch(API+"tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...tx,sig})});
 log("Bridge envoyé");
 refresh();
}

// ---- swap ----
async function swap(){
 if(!PK) return log("Pas de wallet FIRE");
 let a=document.getElementById("swapAmt").value;
 if(!a) return;
 let z=document.getElementById("swapSide").value;
 let tx = {type:"swap",from:PK,side:z,amount:a,nonce:Date.now()};
 let sig = sign(tx);
 await fetch(API+"tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...tx,sig})});
 log("Swap envoyé");
 refresh();
}

// ---- LP ----
async function addLP(){
 if(!PK) return;
 let f=document.getElementById("lpFire").value;
 let u=document.getElementById("lpUSDCF").value;
 if(!f||!u) return;
 let tx={type:"lp_add",from:PK,fire:f,usdc:u,nonce:Date.now()};
 let sig=sign(tx);
 await fetch(API+"tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...tx,sig})});
 log("LP envoyé");
 refresh();
}

// ---- SIGN ----
function sign(obj){
 let msg=JSON.stringify(obj);
 let sig=nacl.sign.detached(new TextEncoder().encode(msg), bs58.decode(SK));
 return bs58.encode(sig);
}

// ---- WEBSOCKET LOGS ----
let ws=null;
function wsConnect(){
 ws = new WebSocket((location.protocol==="https:"?"wss":"ws")+"://"+location.host+"/ws");
 ws.onopen = ()=>{wsStatus(true)};
 ws.onclose = ()=>{wsStatus(false);setTimeout(wsConnect,2000)};
 ws.onmessage = e => log(e.data);
}
setInterval(checkBack,2000);
wsConnect();
</script>

<script src="https://cdn.jsdelivr.net/npm/bs58@5.0.0/dist/bs58.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl-fast.min.js"></script>
</body>
</html>
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/bbqfinance.fun/index.html"

echo "🔥 FIREINNERS — Patch Bridge Buffer (iOS + Phantom + Desktop)"

if [ ! -f "$HTML" ]; then
  echo "❌ Fichier introuvable: $HTML"
  exit 1
fi

BK="${HTML}.bak.$(date +%s)"
cp -a "$HTML" "$BK"
echo "✅ Backup: $BK"

# Supprime anciens polyfills Buffer "window.Buffer=buffer.Buffer" / bundle.run/buffer / "Can't find variable: Buffer" fixes incomplets
perl -0777 -i -pe 's@<script[^>]*>\s*window\.Buffer\s*=\s*buffer\.Buffer\s*;?\s*</script>\s*@@gis' "$HTML"
perl -0777 -i -pe 's@<script[^>]*src=["'"'"']https?://bundle\.run/buffer@6\.0\.3["'"'"'][^>]*>\s*</script>\s*@@gis' "$HTML"
perl -0777 -i -pe 's@<script[^>]*src=["'"'"']https?://cdn\.jsdelivr\.net/npm/buffer@6\.0\.3[^"'"'"']*["'"'"'][^>]*>\s*</script>\s*@@gis' "$HTML"

# Injecte le polyfill Buffer ULTRA-EARLY: tout de suite après <head>
# (et surtout AVANT web3.js / Phantom / ton code)
if grep -q "FIREINNERS GLOBAL BUFFER FIX" "$HTML"; then
  echo "ℹ️ Polyfill déjà présent (pas de double injection)"
else
  perl -0777 -i -pe 's@<head([^>]*)>@<head$1>\n<script>\n/* FIREINNERS GLOBAL BUFFER FIX (iOS + Phantom + Desktop) */\n(function(){\n  if(typeof globalThis===\"undefined\")return;\n  if(typeof globalThis.Buffer!==\"undefined\")return;\n  function BufferPolyfill(arg,enc){\n    if(typeof arg===\"string\"){\n      var bin=atob(arg);var arr=new Uint8Array(bin.length);\n      for(var i=0;i<bin.length;i++)arr[i]=bin.charCodeAt(i);\n      return arr;\n    }\n    if(Array.isArray(arg)||arg instanceof Uint8Array){\n      return new Uint8Array(arg);\n    }\n    return new Uint8Array(0);\n  }\n  BufferPolyfill.from=BufferPolyfill;\n  BufferPolyfill.alloc=function(n){return new Uint8Array(n)};\n  BufferPolyfill.isBuffer=function(){return false};\n  globalThis.Buffer=BufferPolyfill;\n})();\n</script>@gis' "$HTML"
  echo "✅ Polyfill injecté"
fi

# Vérifie que le polyfill est AVANT le premier <script src=...web3.js...>
# (best-effort: on s'assure qu'il n'y a pas de <script src=web3.js> avant le marker)
FIRST_WEB3_LINE=$(grep -n -m1 "@solana/web3.js" "$HTML" | cut -d: -f1 || true)
MARKER_LINE=$(grep -n -m1 "FIREINNERS GLOBAL BUFFER FIX" "$HTML" | cut -d: -f1 || true)

echo "🔎 Marker line: ${MARKER_LINE:-?} | web3.js line: ${FIRST_WEB3_LINE:-?}"

# Reload nginx (frontend only)
nginx -t
systemctl reload nginx
echo "✅ nginx reloaded"

echo "🧪 Test rapide (doit retourner quelque chose):"
curl -sS https://bbqfinance.fun/stats | head -c 180 || true
echo
echo "✅ Terminé. Ouvre bbqfinance.fun dans Phantom iOS et reteste le Bridge."
<script>
(()=> {
  const API_BASE = "https://bbqfinance.fun";
  const WS_URL   = "wss://bbqfinance.fun/ws";

  const $ = id => document.getElementById(id);
  const logEl = $("log");
  const L = m => { const t=new Date().toISOString().substr(11,8);
    logEl.textContent+="["+t+"] "+m+"\\n"; logEl.scrollTop=logEl.scrollHeight; };

  const apiDot=$("apiDot"),apiTxt=$("apiTxt"),
        wsDot=$("wsDot"),wsTxt=$("wsTxt");

  const statHeight=$("statHeight"),statWallets=$("statWallets"),
        statMempool=$("statMempool"),statTotalPow=$("statTotalPow"),
        statTotalStaked=$("statTotalStaked"),statTvlPow=$("statTvlPow"),
        statTvlUsdc=$("statTvlUsdc"),lpPow=$("lpPow"),lpUsdc=$("lpUsdc"),
        treasuryFire=$("treasuryFire"),treasuryUsdc=$("treasuryUsdc"),treasurySol=$("treasurySol");

  // Solana
  let phantom=null,solPubkey=null;
  const solAddr=$("solAddr"),solBalance=$("solBalance"),solUsdc=$("solUsdc");

  // Wallet serveur
  const srvAddr=$("srvAddr"),srvPow=$("srvPow"),srvUsdc=$("srvUsdc"),srvStaked=$("srvStaked"),srvNonce=$("srvNonce");

  // Wallet local
  const locAddr=$("locAddr"),locPriv=$("locPriv"),
        locPow=$("locPow"),locUsdc=$("locUsdc"),
        locStaked=$("locStaked"),locNonce=$("locNonce");

  // TX / explorer
  const txFrom=$("txFrom"),txToken=$("txToken"),
        txTo=$("txTo"),txAmount=$("txAmount"),
        lastBlock=$("lastBlock"),mempoolCount=$("mempoolCount"),
        blockHeight=$("blockHeight");

  // LP / swap / stake
  const lpFire=$("lpFire"),lpUsdcAmt=$("lpUsdcAmt"),
        swapDir=$("swapDir"),swapAmount=$("swapAmount"),
        stakeAmount=$("stakeAmount");

  // API helper
  async function api(path,opts={}){
    try{
      const r = await fetch(API_BASE+path,Object.assign({
        headers:{"Content-Type":"application/json"}
      },opts));
      const t = await r.text();
      let j=null; try{j=JSON.parse(t);}catch(e){}
      return {ok:r.ok,status:r.status,json:j,text:t};
    }catch(e){
      L("HTTP erreur: "+e.message);
      return{ok:false,status:0};
    }
  }

  async function refreshStats(){
    const r = await api("/stats");
    if(!r.ok||!r.json){apiDot.classList.remove("ok");apiTxt.textContent="KO";return;}
    apiDot.classList.add("ok");apiTxt.textContent="OK";
    const s=r.json;
    statHeight.textContent=s.height??"-";
    statWallets.textContent=s.wallets??"-";
    statMempool.textContent=s.mempool??"-";
    statTotalPow.textContent=s.totalPow??s.totalFIRE??"0";
    statTotalStaked.textContent=s.totalStaked??"0";
    statTvlPow.textContent=s.tvlPow??s.tvlFire??"-";
    statTvlUsdc.textContent=s.tvlUsdc??"-";
    lpPow.textContent=s.lpPow??"0";
    lpUsdc.textContent=s.lpUsdc??"0";
    treasuryFire.textContent=s.treasuryFire??s.treasuryPow??"0";
    treasuryUsdc.textContent=s.treasuryUsdc??"0";
    treasurySol.textContent=s.treasurySol??"0";
    L("Stats rafraîchies.");
  }

  // WS
  let ws=null;
  function connectWS(){
    if(ws)try{ws.close();}catch(e){}
    ws=new WebSocket(WS_URL);
    ws.onopen=()=>{wsDot.classList.add("ok");wsTxt.textContent="OK";L("WS connecté.");};
    ws.onclose=()=>{wsDot.classList.remove("ok");wsTxt.textContent="KO";L("WS déconnecté.");setTimeout(connectWS,5000);};
    ws.onerror=()=>{wsDot.classList.remove("ok");wsTxt.textContent="ERR";};
    ws.onmessage=ev=>{try{
      const d=JSON.parse(ev.data);
      if(d.type==="block")L("Bloc "+d.height);
      if(d.type==="tx")L("TX "+d.txid);
    }catch(e){}
    };
  }

  // Phantom
  async function ensurePhantom(){
    if(!window.solana||!window.solana.isPhantom){alert("Phantom non détecté.");return null;}
    if(!phantom)phantom=window.solana;
    if(!solPubkey){
      const r=await phantom.connect();
      solPubkey=r.publicKey;
      solAddr.value=solPubkey.toBase58();
      L("Phantom connecté.");
    }
    return phantom;
  }
  async function refreshSol(){
    if(!solPubkey)return;
    const conn=new solanaWeb3.Connection("https://api.mainnet-beta.solana.com");
    const bal=await conn.getBalance(solPubkey);
    solBalance.textContent=(bal/1e9).toFixed(6);
    solUsdc.textContent="0";
    L("Soldes Solana OK.");
  }

  async function doBridge(){
    const p=await ensurePhantom();if(!p)return;
    const amt=parseFloat(bridgeAmount.value||"0");if(!(amt>0)){alert("Montant");return;}
    L("Bridge "+amt+" SOL → trésorerie.");
    alert("Envoie "+amt+" SOL avec Phantom.\nLe backend FIREINNERS crédite FIRE automatiquement.");
  }

  // Local wallet
  function loadLocalWallet(){
    try{
      const s=localStorage.getItem("fireinners_local_wallet");
      if(!s)return null;
      const w=JSON.parse(s);
      locAddr.value=w.addr||"";locPriv.value=w.priv||"";
      return w;
    }catch(e){return null;}
  }
  function saveLocalWallet(w){
    localStorage.setItem("fireinners_local_wallet",JSON.stringify(w));
    locAddr.value=w.addr;locPriv.value=w.priv;
  }
  function clearLocalWallet(){
    localStorage.removeItem("fireinners_local_wallet");
    locAddr.value="";locPriv.value="";
    locPow.textContent="0";locUsdc.textContent="0";locStaked.textContent="0";locNonce.textContent="0";
  }
  function genLocalWallet(){
    const kp=solanaWeb3.Keypair.generate();
    const addr=kp.publicKey.toBase58();
    const priv=btoa(String.fromCharCode(...kp.secretKey));
    saveLocalWallet({addr,priv});L("Wallet local généré.");
  }
  async function refreshLocalWallet(){
    const w=loadLocalWallet();if(!w||!w.addr){alert("Aucun local");return;}
    const r=await api("/wallet?addr="+encodeURIComponent(w.addr));
    if(r.ok&&r.json){
      locPow.textContent=r.json.pow??"0";
      locUsdc.textContent=r.json.usdc??"0";
      locStaked.textContent=r.json.staked??"0";
      locNonce.textContent=r.json.nonce??"0";
      L("Local OK.");
    }else L("Erreur local: "+r.status);
  }

  // Wallet serveur
  async function loadServerWalletAddr(){
    const r=await api("/wallet/server");
    if(r.ok&&r.json&&r.json.addr){
      srvAddr.value=r.json.addr;L("Wallet serveur OK.");
    }
  }
  async function createServerWallet(){
    const r=await api("/wallet/create",{method:"POST",body:JSON.stringify({})});
    if(r.ok&&r.json&&r.json.addr){
      srvAddr.value=r.json.addr;L("Serveur créé.");await refreshServerWallet();
    }
  }
  async function refreshServerWallet(){
    if(!srvAddr.value)return;
    const r=await api("/wallet?addr="+encodeURIComponent(srvAddr.value));
    if(r.ok&&r.json){
      srvPow.textContent=r.json.pow??"0";
      srvUsdc.textContent=r.json.usdc??"0";
      srvStaked.textContent=r.json.staked??"0";
      srvNonce.textContent=r.json.nonce??"0";
      L("Serveur rechargé.");
    }
  }

  // TX
  async function sendTx(){
    const from=txFrom.value,token=txToken.value,to=txTo.value.trim();
    const amt=parseFloat(txAmount.value||"0");
    if(!to||!(amt>0)){alert("Données invalides");return;}
    const local=loadLocalWallet();
    const body={
      token,to,amount:amt,fromType:from,
      fromAddr:from==="local"?(local?local.addr:null):srvAddr.value
    };
    const r=await api("/tx",{method:"POST",body:JSON.stringify(body)});
    if(r.ok&&r.json)L("TX envoyée: "+(r.json.txid||""));
    else L("Erreur TX: "+r.status);
  }

  // Explorer
  async function getLastBlock(){
    const r=await api("/chain/last");
    if(r.ok&&r.json){lastBlock.textContent="height "+r.json.height;L("Last OK");}
  }
  async function getMempool(){
    const r=await api("/mempool");
    if(r.ok&&r.json){
      const arr=Array.isArray(r.json)?r.json:(r.json.txs||[]);
      mempoolCount.textContent=arr.length;L("Mempool "+arr.length);
    }
  }
  async function getBlock(){
    const h=parseInt(blockHeight.value||"0");
    if(!h)return;
    const r=await api("/block/"+h);
    if(r.ok&&r.json){lastBlock.textContent="height "+h;L("Bloc "+h);}
  }

  // LP / swap / stake
  async function addLP(){
    const p=parseFloat(lpFire.value||"0"),u=parseFloat(lpUsdcAmt.value||"0");
    if(!(p>0&&u>0))return alert("Montants LP");
    const r=await api("/lp/add",{method:"POST",body:JSON.stringify({fire:p,usdc:u})});
    if(r.ok)L("LP ajoutée.");
  }
  async function doSwap(){
    const dir=swapDir.value,amt=parseFloat(swapAmount.value||"0");
    if(!(amt>0))return alert("Montant");
    const r=await api("/swap",{method:"POST",body:JSON.stringify({dir,amount:amt})});
    if(r.ok)L("Swap OK.");
  }
  async function doStake(){
    const amt=parseFloat(stakeAmount.value||"0");
    if(!(amt>0))return alert("Montant");
    const r=await api("/stake",{method:"POST",body:JSON.stringify({amount:amt})});
    if(r.ok)L("Stake OK.");
  }

  // Navigation
  document.querySelectorAll("nav button").forEach(btn=>{
    btn.onclick=()=>{document.querySelectorAll("nav button").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");

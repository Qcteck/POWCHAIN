// Historique des bridges
app.get("/bridge-history",(req,res)=>{
  const bridges = [];
  for (const b of chain){
    for (const tx of b.txs){
      if (tx.type === "BRIDGE_IN" || tx.type === "BRIDGE_OUT") {
        bridges.push({
          height: b.height,
          time: b.time,
          ...tx
        });
      }
    }
  }
  res.json({ ok:true, bridges });
});

// TX signées (transfert, swap, LP, stake, unstake)
app.post("/tx",(req,res)=>{
  try{
    const tx = req.body || {};
    verifySignedTx(tx);

    let result;
    switch (tx.type) {
      case "TX_FIRE":
        result = processFireTransfer(tx);
        break;
      case "SWAP":
        result = processSwap(tx);
        break;
      case "LP_ADD":
        result = processLPAdd(tx);
        break;
      case "STAKE":
        result = processStake(tx);
        break;
      case "UNSTAKE":
        result = processUnstake(tx);
        break;
      default:
        throw new Error("type de TX inconnu: " + tx.type);
    }

    appendBlock([result]);
    console.log("[fireinners] TX", result.type, "ok pour", tx.from);
    res.json({ ok:true, tx: result });
  }catch(e){
    console.error("[fireinners] Erreur /tx:", e);
    res.status(400).json({ ok:false, error:e.message });
  }
});

// Bridge SOL -> FIREINNERS
app.post("/bridge",(req,res)=>{
  try{
    const body = req.body || {};
    const addr = body.addr || body.fireAddress || body.powAddress || body.fireAddr;
    const solAmountRaw = body.solAmount ?? body.amountSol ?? body.sol ?? body.amount;
    const solAmount = Number(solAmountRaw);

    if (!addr) throw new Error("adresse manquante");
    if (!Number.isFinite(solAmount) || solAmount <= 0){
      throw new Error("montant SOL invalide");
    }

    const bridgeTx = processBridgeIn({ addr, solAmount });
    appendBlock([bridgeTx]);
    console.log("[fireinners] 🔥 Bridge SOL->FIREINNERS", bridgeTx);
    res.json({ ok:true, bridge: bridgeTx });
  }catch(e){
    console.error("[fireinners] Erreur /bridge:", e);
    res.status(400).json({ ok:false, error:e.message });
  }
});


<script>
  const SOL_RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const TREASURY = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

  // ---------- UTIL ----------
  function ts(){
    const d = new Date();
    return "["+String(d.getHours()).padStart(2,"0")+"h "+
      String(d.getMinutes()).padStart(2,"0")+" min "+
      String(d.getSeconds()).padStart(2,"0")+" s]";
  }
  function log(msg){
    const c = document.getElementById("console");
    const line = document.createElement("div");
    line.className = "console-line";
    line.textContent = ts()+" "+msg;
    c.appendChild(line);
    c.scrollTop = c.scrollHeight;
  }

  // ---------- MENU / VUES ----------
  document.querySelectorAll(".menu-btn").forEach(btn=>{
    btn.addEventListener("click",()=>{
      document.querySelectorAll(".menu-btn").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      const v = btn.dataset.view;
      document.querySelectorAll("#views .view").forEach(view=>{
        view.classList.toggle("active", view.dataset.view===v);
      });
    });
  });

  // ---------- THEME ----------
  const btnTheme = document.getElementById("btnTheme");
  function applyTheme(){
    const t = localStorage.getItem("fire_theme") || "dark";
    document.body.classList.toggle("light", t==="light");
  }
  btnTheme.addEventListener("click",()=>{
    const cur = localStorage.getItem("fire_theme") || "dark";
    const next = cur==="dark"?"light":"dark";
    localStorage.setItem("fire_theme", next);
    applyTheme();
  });
  applyTheme();

  // ---------- VISITEUR ----------
  (function(){
    let id = localStorage.getItem("fire_visit_id");
    if(!id){
      id = "FVR-"+Math.random().toString(36).slice(2,10).toUpperCase();
      localStorage.setItem("fire_visit_id", id);
    }
    document.getElementById("visitId").textContent = id;
  })();

  // ---------- PRIX (CoinGecko, juste pour la bannière) ----------
  async function loadPrices(){
    try{
      const r = await fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd");
      if(!r.ok) throw new Error("HTTP "+r.status);
      const j = await r.json();
      const pBTC = j.bitcoin?.usd ?? 0;
      const pETH = j.ethereum?.usd ?? 0;
      const pSOL = j.solana?.usd ?? 0;
      const pSUI = j.sui?.usd ?? 0;
      const ids = ["pBTC","pBTC_2","pETH","pETH_2","pSOL","pSOL_2","pSUI","pSUI_2"];
      document.getElementById("pBTC").textContent = "$"+pBTC.toLocaleString();
      document.getElementById("pBTC_2").textContent = "$"+pBTC.toLocaleString();
      document.getElementById("pETH").textContent = "$"+pETH.toLocaleString();
      document.getElementById("pETH_2").textContent = "$"+pETH.toLocaleString();
      document.getElementById("pSOL").textContent = "$"+pSOL.toLocaleString();
      document.getElementById("pSOL_2").textContent = "$"+pSOL.toLocaleString();
      document.getElementById("pSUI").textContent = "$"+pSUI.toLocaleString();
      document.getElementById("pSUI_2").textContent = "$"+pSUI.toLocaleString();
      // FIRE reste off-chain pour l'instant
    }catch(e){
      log("Prix ERR : "+e.message);
    }
  }
  loadPrices();
  setInterval(loadPrices, 120000);

  // ---------- FIREINNERS ADDRESS ALGOS ----------
  const letters = "ABCDEFGHJKLMNPQRSTUVWXYZ";
  const digits = "23456789";
  function randItem(str){return str[Math.floor(Math.random()*str.length)];}

  function genCodeDigitLetterDigitLetter(){
    return randItem(digits)+randItem(letters)+randItem(digits)+randItem(letters);
  }
  function genCodeLetterDigitLetterDigit(){
    return randItem(letters)+randItem(digits)+randItem(letters)+randItem(digits);
  }

  function genColor(){
    const r = Math.random();
    if(r<0.01) return "gold";
    if(r<0.03) return "army";
    if(r<0.06) return "multicolore";
    const others = ["vert","or","blanc","noir","rouge","argent","mauve","orange","gris","jaune","violet"];
    return others[Math.floor(Math.random()*others.length)];
  }

  function genFireinnersName(){
    const part1 = genCodeDigitLetterDigitLetter();       // ex : 7Q2M
    const part2 = genCodeLetterDigitLetterDigit();       // ex : Q7M2
    const num = Math.floor(Math.random()*100000000)+1;   // 1 → 100M
    const color = genColor();
    const name = `441-FIRE-${part1}/inners/${part2}/1a${num}/${color}`;
    // Alias court (adresse "FIREINNERS")
    const alias = `${part1}${part2}-${num}`;
    return {name,alias,color};
  }

  function genRandomPriv(){
    const alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
    let s = "";
    for(let i=0;i<64;i++) s+=alphabet[Math.floor(Math.random()*alphabet.length)];
    return s;
  }

  function updateQrFire(addr){
    const img = document.getElementById("qrFire");
    const txt = document.getElementById("qrFireText");
    if(!addr){
      img.src = "";
      txt.textContent = "Aucun wallet généré";
      return;
    }
    const url = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&data="+encodeURIComponent(addr);
    img.src = url;
    txt.textContent = addr;
  }

  document.getElementById("qrTreasury").src =
    "https://api.qrserver.com/v1/create-qr-code/?size=220x220&data="+encodeURIComponent(TREASURY);

  const inpFireName = document.getElementById("fireName");
  const inpFireAddr = document.getElementById("fireAddr");
  const inpFirePriv = document.getElementById("firePriv");

  document.getElementById("btnGenFire").addEventListener("click",()=>{
    const {name,alias} = genFireinnersName();
    const priv = genRandomPriv();
    inpFireName.value = name;
    inpFireAddr.value = alias;
    inpFirePriv.value = priv;
    updateQrFire(alias);
    log("Nouveau wallet FIREINNERS généré.");
  });

  document.getElementById("btnSaveFire").addEventListener("click",()=>{
    if(!inpFirePriv.value){
      log("Sauvegarde FIREINNERS : aucun wallet.");
      return;
    }
    const obj = {
      name: inpFireName.value,
      addr: inpFireAddr.value,
      priv: inpFirePriv.value
    };
    localStorage.setItem("fire_wallet", JSON.stringify(obj));
    log("Wallet FIREINNERS sauvegardé dans le navigateur.");
  });

  document.getElementById("btnLoadFire").addEventListener("click",()=>{
    const raw = localStorage.getItem("fire_wallet");
    if(!raw){
      log("Aucun wallet FIREINNERS sauvegardé.");
      return;
    }
    try{
      const w = JSON.parse(raw);
      inpFireName.value = w.name;
      inpFireAddr.value = w.addr;
      inpFirePriv.value = w.priv;
      updateQrFire(w.addr);
      log("Wallet FIREINNERS rechargé depuis localStorage.");
    }catch(e){
      log("Load FIREINNERS ERR : "+e.message);
    }
  });

  // ---------- FIREBROWSER ----------
  const fireFrame = document.getElementById("firebrowser-frame");
  document.getElementById("btnOpenFire").addEventListener("click",()=>{
    let url = document.getElementById("fireUrl").value.trim();
    if(!url){
      log("FIREBROWSER : URL vide.");
      return;
    }
    if(!/^https?:\/\//i.test(url)) url = "https://"+url;
    if(url.startsWith("javascript:")){
      log("FIREBROWSER : URL refusée.");
      return;
    }
    fireFrame.src = url;
    log("FIREBROWSER ouvert sur "+url);
  });
  document.getElementById("btnClearFire").addEventListener("click",()=>{
    fireFrame.src = "about:blank";
    document.getElementById("fireUrl").value = "";
    log("FIREBROWSER vidé.");
  });

  // ---------- PHANTOM ----------
  let phantomPub = null;
  const spanPhAddr = document.getElementById("phantomAddr");
  const spanPhSol = document.getElementById("phantomSol");

  async function connectPhantom(){
    try{
      const provider = window.solana;
      if(!provider || !provider.isPhantom){
        alert("Phantom non détecté.");
        return;
      }
      const resp = await provider.connect();
      phantomPub = resp.publicKey.toString();
      spanPhAddr.textContent = phantomPub;
      log("Phantom connecté : "+phantomPub);
      await refreshSolBalance();
    }catch(e){
      log("Phantom ERR : "+e.message);
    }
  }

  async function refreshSolBalance(){
    if(!phantomPub) return;
    try{
      const conn = new solanaWeb3.Connection(SOL_RPC,"confirmed");
      const pk = new solanaWeb3.PublicKey(phantomPub);
      const lamports = await conn.getBalance(pk);
      const sol = lamports / 1e9;
      spanPhSol.textContent = sol.toFixed(4);
    }catch(e){
      log("Sol ERR : "+e.message);
    }
  }

  document.getElementById("btnPhantom").addEventListener("click",connectPhantom);

  // ---------- BRIDGE SOL -> BACKEND ----------
  const inpBridgeSol = document.getElementById("bridgeSol");
  const inpBridgeSig = document.getElementById("bridgeSig");
  const inpTreas = document.getElementById("treasuryAddr");
  inpTreas.value = TREASURY;

  async function sendSolViaPhantom(){
    if(!phantomPub){
      log("Bridge : connecte Phantom d'abord.");
      return;
    }
    const amt = Number(inpBridgeSol.value || "0");
    if(!(amt>0)){
      log("Bridge : montant SOL invalide.");
      return;
    }
    try{
      const conn = new solanaWeb3.Connection(SOL_RPC,"confirmed");
      const from = new solanaWeb3.PublicKey(phantomPub);
      const to = new solanaWeb3.PublicKey(TREASURY);
      const tx = new solanaWeb3.Transaction().add(
        solanaWeb3.SystemProgram.transfer({
          fromPubkey: from,
          toPubkey: to,
          lamports: Math.round(amt*1e9)
        })
      );
      tx.feePayer = from;
      tx.recentBlockhash = (await conn.getLatestBlockhash()).blockhash;
      const signed = await window.solana.signAndSendTransaction(tx);
      const sig = signed.signature;
      inpBridgeSig.value = sig;
      log("Bridge Phantom OK, signature : "+sig);
    }catch(e){
      log("Bridge Phantom ERR : "+e.message);
    }
  }

  async function declareBridge(){
    if(!phantomPub){
      log("Bridge : connecte Phantom d'abord.");
      return;
    }
    const amt = Number(inpBridgeSol.value || "0");
    const sig = inpBridgeSig.value.trim();
    if(!(amt>0) || !sig){
      log("Bridge : montant ou signature manquant.");
      return;
    }
    try{
      const resp = await fetch("/bridge",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
          addr: document.getElementById("fireAddr").value || phantomPub,
          amount: amt,
          fromSol: phantomPub,
          txSig: sig
        })
      });
      const j = await resp.json();
      if(!j.ok){
        log("Bridge backend rejeté : "+(j.error||"inconnu"));
      }else{
        log("Bridge backend OK — POW crédité : "+j.credited);
      }
    }catch(e){
      log("Bridge backend ERR : "+e.message);
    }
  }

  document.getElementById("btnSendSol").addEventListener("click",sendSolViaPhantom);
  document.getElementById("btnDeclareBridge").addEventListener("click",declareBridge);

  // ---------- WEBSOCKET ----------
  let ws = null;
  let wsRetry = 0;
  const wsBadge = document.getElementById("wsBadge");
  const memDiv = document.getElementById("mempoolList");
  const statClients = document.getElementById("statClients");
  const statHeight = document.getElementById("statHeight");
  const visitWsCount = document.getElementById("visitWsCount");

  function setWsStatus(on){
    if(on){
      wsBadge.classList.remove("ws-off");
      wsBadge.classList.add("ws-ok");
      wsBadge.textContent = "WS : online";
    }else{
      wsBadge.classList.remove("ws-ok");
      wsBadge.classList.add("ws-off");
      wsBadge.textContent = "WS : offline";
    }
  }

  function connectWS(){
    try{
      const proto = location.protocol==="https:"?"wss:":"ws:";
      ws = new WebSocket(proto+"//"+location.host+"/ws");
      ws.onopen = ()=>{
        setWsStatus(true);
        wsRetry = 0;
        log("WS connecté.");
      };
      ws.onclose = ()=>{
        setWsStatus(false);
        log("WS fermé, reconnexion dans 3s…");
        setTimeout(connectWS,3000);
      };
      ws.onerror = ()=>{
        setWsStatus(false);
      };
      ws.onmessage = ev=>{
        try{
          const data = JSON.parse(ev.data);
          if(data.type==="mempool"){
            memDiv.textContent = "";
            (data.mempool||[]).slice(-50).reverse().forEach(tx=>{
              const d = document.createElement("div");
              d.textContent = JSON.stringify(tx);
              memDiv.appendChild(d);
            });
          }else if(data.type==="new_block"){
            if(data.block && data.block.height){
              statHeight.value = data.block.height;
            }
          }else if(data.type==="clients"){
            statClients.value = data.count;
            visitWsCount.textContent = data.count;
          }
        }catch(e){
          // ignore
        }
      };
    }catch(e){
      log("WS ERR : "+e.message);
    }
  }
  connectWS();
</script>
</body>
</html>







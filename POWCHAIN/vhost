// server.js — FIREINNERS Validator + API + WS

const express = require("express");
const bodyParser = require("body-parser");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const crypto = require("crypto");
const http = require("http");

// =========================
// CONFIG SERVEUR
// =========================
const HTTP_PORT = 3000;
const WS_PATH   = "/ws";

const app = express();
app.use(bodyParser.json());
const server = http.createServer(app);
const wss = new WebSocket.Server({ server, path: WS_PATH });

const clients = new Set();

// =========================
// CONFIG ECONOMIE FIREINNERS
// =========================
const DEC = 1e6;
const SUPPLY_MAX = 100_000_000 * DEC;     // Hard cap 100M FIRE

// Base rate FIRE/SOL + dynamique selon TVL
const RATE_BASE = 1000;
const TVL_REF   = 1_000_000 * DEC;
const RATE_MIN  = 800;
const RATE_MAX  = 5000;

// Frais (bp = 1/10000)
const FEE_BRIDGE_IN_TREAS_BP = 500;   // 5%
const FEE_BRIDGE_IN_BURN_BP  = 200;   // 2%

// =========================
// ETAT GLOBAL
// =========================
let wallets = {};     // addr -> { fire, usdc, ... }
let treasury = { fire: 0, usdc: 0, sol: 0 };
let lp = { fire: 0, usdc: 0 };
let chain = [];
let mempool = [];
let bridges = [];

let supplyCirculante = 0;
let mintedFireTotal = 0;
let burnedFireTotal = 0;

// =========================
// OUTILS
// =========================
function log(...args) { console.log("[fireinners]", ...args); }
function clamp(x, min, max) { return x < min ? min : x > max ? max : x; }
function ensureWallet(addr) {
  if (!wallets[addr]) wallets[addr] = { fire: 0, usdc: 0, staked: 0, pub: addr, nonce: 0, stakeLock: 0 };
  return wallets[addr];
}

// TVL en équivalent USDC FIRE
function getTVL() {
  return (lp.usdc || 0) + (treasury.usdc || 0);
}

// Taux dynamique FIRE / SOL
function getFireRatePerSol() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || DEC);
  const raw = RATE_BASE * factor;
  return clamp(raw, RATE_MIN, RATE_MAX);
}

function burnFire(amount) {
  if (amount <= 0) return 0;
  const burn = Math.min(amount, supplyCirculante);
  burnedFireTotal += burn;
  supplyCirculante -= burn;
  return burn;
}

function mintFire(amount) {
  if (amount <= 0) return 0;
  const left = SUPPLY_MAX - supplyCirculante;
  const mint = Math.min(amount, left);
  mintedFireTotal += mint;
  supplyCirculante += mint;
  return mint;
}

function addFireToWallet(addr, amount) { ensureWallet(addr).fire += amount; }
function addUsdcToWallet(addr, amount) { ensureWallet(addr).usdc += amount; }
function applyBp(amount, bp) { return Math.floor(amount * bp / 10000); }

// =========================
// GENESIS
// =========================
(function initGenesis() {
  const genesis = {
    height: 1,
    time: Date.now(),
    prevHash: "0".repeat(64),
    hash: "GENESIS",
    txs: [],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp },
    supply: {
      max: SUPPLY_MAX,
      circulante: supplyCirculante,
      disponible: SUPPLY_MAX - supplyCirculante,
      mintedTotal: mintedFireTotal,
      burnedTotal: burnedFireTotal
    }
  };
  chain.push(genesis);
  log("🔥 Fireinners Genesis — supply = 0 / 100M max");
})();

// =========================
// HANDLER BRIDGE SOL -> FIRE
// =========================
function processBridgeIn({ addr, solAmount }) {
  if (!addr) throw new Error("adresse manquante");
  if (!solAmount || solAmount <= 0) throw new Error("solAmount invalide");

  const rate = getFireRatePerSol();
  const fireBrut = Math.floor(solAmount * rate * DEC);

  const fireMinted = mintFire(fireBrut);
  if (fireMinted <= 0) throw new Error("Supply max atteint");

  const feeTreas = applyBp(fireMinted, FEE_BRIDGE_IN_TREAS_BP);
  const feeBurn  = applyBp(fireMinted, FEE_BRIDGE_IN_BURN_BP);
  const userFire = fireMinted - feeTreas - feeBurn;
  if (userFire <= 0) throw new Error("Bridge net <= 0");

  treasury.fire += feeTreas;
  const burned = burnFire(feeBurn);
  addFireToWallet(addr, userFire);

  treasury.sol += solAmount;

  const supplyDisponible = SUPPLY_MAX - supplyCirculante;

  const bridge = {
    type: "BRIDGE_IN",
    addr,
    solAmount,
    rateFirePerSol: rate,
    fireMinted,
    userFire,
    feeTreasFire: feeTreas,
    burnedFire: burned,
    supplyCirculante,
    supplyDisponible
  };

  bridges.push(bridge);
  mempool.push({ kind: "bridge", bridge });
  return bridge;
}

// =========================
// BLOCS (PoS simplifié)
// =========================
function hashBlock(height, time, prevHash, txs) {
  const h = crypto.createHash("sha256");
  h.update(String(height));
  h.update(String(time));
  h.update(prevHash);
  h.update(JSON.stringify(txs));
  return h.digest("hex");
}

function forgeBlock() {
  const txs = mempool.splice(0, mempool.length);
  const last = chain[chain.length - 1];
  const height = last.height + 1;
  const time = Date.now();
  const prevHash = last.hash;
  const hash = hashBlock(height, time, prevHash, txs);

  const block = {
    height,
    time,
    prevHash,
    hash,
    txs,
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp },
    supply: {
      max: SUPPLY_MAX,
      circulante: supplyCirculante,
      disponible: SUPPLY_MAX - supplyCirculante,
      mintedTotal: mintedFireTotal,
      burnedTotal: burnedFireTotal
    }
  };

  chain.push(block);
  broadcast({ type: "block", block });
  log(`📦 Bloc #${height} — txs = ${txs.length}`);
}
setInterval(forgeBlock, 30_000);

// =========================
// API HTTP
// =========================
app.get("/stats", (req, res) => {
  res.json({
    ok: true,
    height: chain.length,
    wallets: Object.keys(wallets).length,
    treasury,
    lp,
    tvlFire: getTVL(),
    supply: {
      max: SUPPLY_MAX,
      circulante: supplyCirculante,
      disponible: SUPPLY_MAX - supplyCirculante,
      mintedTotal: mintedFireTotal,
      burnedTotal: burnedFireTotal
    }
  });
});

app.get("/wallet/:addr", (req, res) => {
  res.json({ ok: true, wallet: ensureWallet(req.params.addr) });
});

app.get("/chain", (req, res) => {
  res.json({ ok: true, chain });
});

app.get("/bridge-history", (req, res) => {
  res.json({ ok: true, bridges });
});

// =========================
// ENDPOINT BRIDGE (POST /bridge)
// =========================
app.post("/bridge", (req, res) => {
  try {
    const { addr, solAmount } = req.body;
    if (!addr || !solAmount) return res.status(400).json({ ok:false, error:"Params manquants" });

    const sol = Number(solAmount);
    if (!Number.isFinite(sol) || sol <= 0) return res.status(400).json({ ok:false, error:"Montant invalide" });

    const bridge = processBridgeIn({ addr, solAmount: sol });
    broadcast({ type:"bridge", bridge });

    return res.json({ ok:true, bridge });
  } catch (e) {
    console.error("❌ Bridge error :", e);
    return res.status(400).json({ ok:false, error:e.message });
  }
});

// =========================
// WEBSOCKET
// =========================
function broadcast(msg) {
  const data = JSON.stringify(msg);
  for (const ws of clients) {
    if (ws.readyState === WebSocket.OPEN) ws.send(data);
  }
}

wss.on("connection", ws => {
  clients.add(ws);
  log("WS client connecté — total =", clients.size);

  ws.on("close", () => {
    clients.delete(ws);
    log("WS client déconnecté — total =", clients.size);
  });

  ws.send(JSON.stringify({
    type: "hello",
    stats: {
      height: chain.length,
      supplyCirculante,
      supplyDisponible: SUPPLY_MAX - supplyCirculante
    }
  }));
});

// =========================
// LANCEMENT SERVEUR
// =========================
server.listen(HTTP_PORT, () => {
  log(`🔥 FIREINNERS Validator prêt — HTTP + WS sur port ${HTTP_PORT}`);
});



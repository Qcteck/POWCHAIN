sudo nano /etc/nginx/sites-available/bbqfinance.fun


server {
    listen 80;
    listen 443 ssl http2;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    # FRONTEND FIREINNERS
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API FIREINNERS -> backend Node (port 3000)
    location /stats    { proxy_pass http://127.0.0.1:3000; }
    location /wallet   { proxy_pass http://127.0.0.1:3000; }
    location /block    { proxy_pass http://127.0.0.1:3000; }
    location /mempool  { proxy_pass http://127.0.0.1:3000; }
    location /swap     { proxy_pass http://127.0.0.1:3000; }
    location /lp/      { proxy_pass http://127.0.0.1:3000; }
    location /stake    { proxy_pass http://127.0.0.1:3000; }
    location /bridge   { proxy_pass http://127.0.0.1:3000; }

    # WEBSOCKET FIREINNERS /ws  -> même backend 3000
    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }
}




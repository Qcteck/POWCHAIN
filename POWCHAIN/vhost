server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    # Logs (optionnels)
    access_log /var/log/nginx/bbqfinance.access.log;
    error_log  /var/log/nginx/bbqfinance.error.log;

    # Site principal FIREINNERS (frontend HTML)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API HTTP FIREINNERS (server.js sur port 3000)
    # /stats, /wallet/..., /tx, /block, /chain, etc.
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~ ^/(tx|wallet|block|chain|api) {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket FIREINNERS (port 7001)
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 60m;
    }
}











<script>
// ---------- UTIL ----------
const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const TREASURY_SOL="BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";
const alphabet="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function logMsg(t){const el=document.getElementById("log");el.textContent+=t+"\n";el.scrollTop=el.scrollHeight;}
function randBase58(len){let s="";for(let i=0;i<len;i++)s+=alphabet[Math.floor(Math.random()*alphabet.length)];return s;}
function shorten(x,len=4){if(!x)return"-";return x.slice(0,len)+"…"+x.slice(-len);}
function openPage(id){document.querySelectorAll(".page").forEach(p=>p.classList.add("hidden"));document.getElementById("page_"+id).classList.remove("hidden");}
function setThemeColor(bg,card,accent){document.documentElement.style.setProperty("--main-bg",bg);document.documentElement.style.setProperty("--card-bg",card);document.documentElement.style.setProperty("--accent",accent);}
function saveLocalWallet(w){localStorage.setItem("fireinnersWallet",JSON.stringify(w));}
function loadLocalWallet(){try{return JSON.parse(localStorage.getItem("fireinnersWallet")||"null");}catch(e){return null;}}

// ---------- THEME ----------
const btnTheme=document.getElementById("btnTheme");
const themeLabel=document.getElementById("themeLabel");
btnTheme.onclick=()=>{
  document.body.classList.toggle("light");
  themeLabel.textContent=document.body.classList.contains("light")?"(Light)":"(Dark)";
};

// ---------- FIREBROWSER ----------
document.getElementById("btnOpenWeb").onclick=()=>{
  let u=document.getElementById("webUrl").value.trim();
  if(!u)return;
  if(!u.startsWith("http"))u="https://"+u;
  window.open(u,"_blank","noopener");
};

// ---------- WALLET FIREINNERS ----------
const qrLocalCanvas=document.getElementById("qrLocal");
const qrTreasuryCanvas=document.getElementById("qrTreasury");
QRCode.toCanvas(qrTreasuryCanvas,TREASURY_SOL,err=>{if(err)logMsg("QR trésorerie ERR: "+err);});

function regenName(){
  const n=Math.floor(Math.random()*100000000)+1;
  const letters="ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const c1=letters[Math.floor(Math.random()*letters.length)];
  const c2=letters[Math.floor(Math.random()*letters.length)];
  const c3=letters[Math.floor(Math.random()*letters.length)];
  const couleurs=["vert","or","blanc","noir","rouge","argent","mauve","orange","gris","jaune","violet","multicolore","army","gold"];
  const col=couleurs[Math.floor(Math.random()*couleurs.length)];
  const name=`441-FIRE-${n}${c1}${c2}${c3}/INNERS/${c2}${n}${c3}/COULEUR/${col}`;
  document.getElementById("fireName").textContent=name;
}

function updateWalletUI(w){
  document.getElementById("localAddr").value=w.addr;
  document.getElementById("localPriv").value=w.priv;
  document.getElementById("firePow").textContent=(w.pow||0)/1e6;
  document.getElementById("fireUsdc").textContent=(w.usdc||0)/1e6;
  QRCode.toCanvas(qrLocalCanvas,w.addr,err=>{if(err)logMsg("QR local ERR: "+err);});
}

async function refreshBackendWallet(addr){
  if(!addr)return;
  try{
    const r=await fetch(`/wallet/${encodeURIComponent(addr)}`);
    const j=await r.json();
    updateWalletUI({addr:addr,priv:document.getElementById("localPriv").value,pow:j.pow,usdc:j.usdc});
  }catch(e){logMsg("Wallet FIREINNERS ERR: "+e);}
}

document.getElementById("btnGenWallet").onclick=()=>{
  let w=loadLocalWallet();
  if(!w){
    w={
      addr:randBase58(44),
      priv:randBase58(88),
      pow:0,
      usdc:0
    };
    saveLocalWallet(w);
    logMsg("Nouveau wallet FIREINNERS généré.");
  }else{
    logMsg("Wallet FIREINNERS rechargé depuis localStorage.");
  }
  regenName();
  updateWalletUI(w);
  refreshBackendWallet(w.addr);
};

// au chargement : tenter de recharger
window.addEventListener("load",()=>{
  const w=loadLocalWallet();
  if(w){
    logMsg("Wallet FIREINNERS rechargé depuis localStorage.");
    regenName();
    updateWalletUI(w);
    refreshBackendWallet(w.addr);
  }
});

// ---------- PHANTOM ----------
let phantom=null;
let phantomPub=null;
const phantomAddrEl=document.getElementById("phantomAddr");
const phantomSolEl=document.getElementById("phantomSol");
const solConn=new solanaWeb3.Connection(SOL_RPC,"confirmed");

async function refreshPhantomBalance(){
  if(!phantomPub)return;
  try{
    const bal=await solConn.getBalance(phantomPub);
    phantomSolEl.textContent=(bal/1e9).toFixed(6);
  }catch(e){logMsg("Sol ERR: "+e.message);}
}

document.getElementById("btnConnect").onclick=async()=>{
  try{
    if(!window.solana || !window.solana.isPhantom){
      alert("Phantom n'est pas détecté.");
      return;
    }
    const resp=await window.solana.connect();
    phantom=window.solana;
    phantomPub=resp.publicKey;
    phantomAddrEl.textContent=shorten(phantomPub.toBase58());
    logMsg("Phantom connecté : "+phantomPub.toBase58());
    refreshPhantomBalance();
  }catch(e){
    logMsg("Phantom ERR: "+e.message);
  }
};

// ---------- BRIDGE ----------
const solAmountEl=document.getElementById("solAmount");
const txSigEl=document.getElementById("txSig");

document.getElementById("btnSendSol").onclick=async()=>{
  try{
    if(!phantomPub||!phantom){
      alert("Connecte Phantom avant.");
      return;
    }
    const amount=parseFloat(solAmountEl.value||"0");
    if(!(amount>0)){alert("Montant SOL invalide");return;}
    const lamports=Math.round(amount*1e9);
    const {blockhash, lastValidBlockHeight}=await solConn.getLatestBlockhash();
    const tx=new solanaWeb3.Transaction({recentBlockhash:blockhash,feePayer:phantomPub});
    tx.add(
      solanaWeb3.SystemProgram.transfer({
        fromPubkey:phantomPub,
        toPubkey:new solanaWeb3.PublicKey(TREASURY_SOL),
        lamports
      })
    );
    const sig=await phantom.signAndSendTransaction(tx);
    const signature=typeof sig==="string"?sig:sig.signature;
    txSigEl.value=signature;
    logMsg("Bridge Phantom : TX envoyée "+signature);
    setTimeout(refreshPhantomBalance,4000);
  }catch(e){
    logMsg("Bridge Phantom ERR : "+e.message);
  }
};

document.getElementById("btnDeclare").onclick=async()=>{
  try{
    const w=loadLocalWallet();
    if(!w){alert("Génère d'abord un wallet FIREINNERS.");return;}
    if(!phantomPub){alert("Connecte Phantom avant.");return;}
    const sig=txSigEl.value.trim();
    if(!sig){alert("Signature manquante (fais d'abord l'étape 1).");return;}
    const amt=parseFloat(solAmountEl.value||"0");
    const body={
      addr:w.addr,
      fromSol:phantomPub.toBase58(),
      amount:amt,
      txSig:sig
    };
    const r=await fetch("/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    const j=await r.json();
    if(!j.ok){
      logMsg("Bridge backend erreur : "+j.error);
    }else{
      logMsg("Bridge confirmé : "+j.credited+" FIRE crédités (on-chain: "+j.solDetected+" SOL).");
      refreshBackendWallet(w.addr);
    }
  }catch(e){
    logMsg("Bridge backend ERR : "+e.message);
  }
};

// ---------- WS ----------
let ws;
function connectWS(){
  const url=`wss://${location.host}/ws`;
  ws=new WebSocket(url);
  ws.onopen=()=>{
    logMsg("WS connecté");
    document.getElementById("wsStatus").className="badgeOnline";
    document.getElementById("wsStatus").textContent="ONLINE";
  };
  ws.onclose=()=>{
    logMsg("WS fermé, reconnexion dans 3s…");
    document.getElementById("wsStatus").className="badgeOffline";
    document.getElementById("wsStatus").textContent="OFFLINE";
    setTimeout(connectWS,3000);
  };
  ws.onerror=()=>{
    logMsg("WS erreur.");
  };
  ws.onmessage=(ev)=>{
    try{
      const msg=JSON.parse(ev.data);
      if(msg.type==="clients"){
        document.getElementById("visitors").textContent=msg.count;
      }
    }catch(e){}
  };
}
connectWS();

// ---------- STATS + EXPLORER + VISITEURS ----------
async function refreshStats(){
  try{
    const r=await fetch("/stats");
    const j=await r.json();
    document.getElementById("statsData").textContent=
      `Hauteur: ${j.height}\nWallets: ${j.wallets}\nMempool: ${j.mempool}\nTotal POW: ${j.totalPow}\nTotal staké: ${j.totalStaked}\nTrésorerie SOL: ${j.solTreasury}\nTrésorerie USDC: ${j.usdcTreasury}\nTrésorerie FIRE: ${j.fireTreasury}\nWS clients: ${j.wsClients}`;
  }catch(e){logMsg("Stats ERR: "+e.message);}
}
async function refreshExplorer(){
  try{
    const r=await fetch("/chain");
    const j=await r.json();
    const lines=j.slice(-20).reverse().map(b=>`#${b.height} • ${new Date(b.timestamp).toLocaleString()} • ${b.type}`).join("\n");
    document.getElementById("explorerData").textContent=lines||"Aucun bloc.";
  }catch(e){logMsg("Explorer ERR: "+e.message);}
}
async function refreshVisitorsHTTP(){
  try{
    const r=await fetch("/visitors");
    const j=await r.json();
    document.getElementById("visitors").textContent=j.count;
  }catch(e){}
}
setInterval(()=>{refreshStats();refreshExplorer();refreshVisitorsHTTP();},15000);
refreshStats();refreshExplorer();refreshVisitorsHTTP();

// ---------- PRIX + RSS ----------
async function refreshPrices(){
  try{
    const r=await fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd");
    const p=await r.json();
    const banner=document.getElementById("priceBanner");
    banner.textContent=
      `₿ BTC $${p.bitcoin.usd}  |  Ξ ETH $${p.ethereum.usd}  |  ◎ SOL $${p.solana.usd}  |  SUI $${p.sui.usd}  |  🔥 FIRE $0.04 (off-chain)`;
  }catch(e){logMsg("Prix ERR: "+e.message);}
}
async function refreshRSS(){
  try{
    const r=await fetch("https://cryptopanic.com/api/v1/posts/?auth_token=demo&public=true");
    const j=await r.json();
    const titles=(j.results||[]).slice(0,6).map(x=>x.title).join(" • ");
    document.getElementById("rssBanner").textContent=titles||"Flux RSS indisponible.";
  }catch(e){
    document.getElementById("rssBanner").textContent="Flux RSS indisponible.";
  }
}
refreshPrices();
refreshRSS();
setInterval(refreshPrices,120000);
setInterval(refreshRSS,120000);
</script>

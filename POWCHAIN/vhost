nano /etc/nginx/sites-available/bbgfinance



server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbgfinance;
    index index.html;

    # ---------------- API POWCHAIN ----------------
    # Route TOUT ce qui commence par /wallet /tx /chain /explorer /lp /bridge /stats
    location ~ ^/(wallet|tx|chain|explorer|lp|bridge|stats) {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # ---------------- WebSocket POWCHAIN ----------------
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---------------- Frontend FIREINNERS ----------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot)$ {
        try_files $uri =404;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
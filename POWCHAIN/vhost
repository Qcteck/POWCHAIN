</script></body></html>
EOF

echo "==[6/9] Nginx corrigé (static + API + WS) =="
cat > /etc/nginx/sites-available/fireinners <<EOF
map \$http_upgrade \$connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  server_name $DOMAIN;

  root $WEBROOT;
  index index.html;

  # STATIC
  location = / { try_files /index.html =404; }
  location / { try_files \$uri \$uri/ /index.html; }

  # WS
  location /ws {
    proxy_pass http://127.0.0.1:$PORT/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade \$http_upgrade;
    proxy_set_header Connection \$connection_upgrade;
    proxy_set_header Host \$host;
    proxy_read_timeout 3600;
    proxy_send_timeout 3600;
  }

  # API vers backend
  location ~ ^/(stats|wallet|bridge|swap|lp|stake|block)\b {
    proxy_pass http://127.0.0.1:$PORT;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
  }
}
EOF

ln -sf /etc/nginx/sites-available/fireinners /etc/nginx/sites-enabled/fireinners
rm -f /etc/nginx/sites-enabled/default 2>/dev/null || true
nginx -t
systemctl reload nginx

echo "==[7/9] PM2 =="
pm2 delete fireinners 2>/dev/null || true
pm2 start "$APPDIR/server.js" --name fireinners --time --update-env --env production -- --port "$PORT" || pm2 start "$APPDIR/server.js" --name fireinners --time
pm2 save

echo "==[8/9] Firewall (optionnel) =="
ufw allow 22 >/dev/null 2>&1 || true
ufw allow 80 >/dev/null 2>&1 || true
ufw allow 443 >/dev/null 2>&1 || true


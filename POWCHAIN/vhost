<div class="section" id="bridge">
<div class="card"><h2>Bridge SOL → POWCHAIN (Phantom)</h2>

<label>Adresse trésorerie Solana</label>
<input readonly value="BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy">

<label>Montant en SOL</label>
<input id="bridgeAmt" placeholder="0.001">

<button id="btnBridgePhantom">Bridge via Phantom</button>


// server.js — POWCHAIN validator + HTTP API + WebSocket

// Ports
const PORT_HTTP = 3000;
const PORT_WS   = 7001;

// Librairies
const http     = require("http");
const url      = require("url");
const fs       = require("fs");
const crypto   = require("crypto");
const WebSocket= require("ws");
const nacl     = require("tweetnacl");
const bs58     = require("bs58");

// Fichier de persistance
const LEDGER_FILE = "/root/powchain/ledger.json";

// Adresse trésorerie POWCHAIN (déjà connue)
const TREASURY_ADDR = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

// ---------- ÉTAT GLOBAL ----------
let state = {
  chain: [],          // liste de blocs
  wallets: {},        // addr -> {pow, usdc, staked}
  treasuryPow: 0,
  treasuryUsdc: 0,
  lpPow: 0,
  lpUsdc: 0
};

// ---------- UTILITAIRES ----------
function log(...args){ console.log("[POWCHAIN]",...args); }

function saveLedger() {
  try {
    const data = { state };
    fs.writeFileSync(LEDGER_FILE, JSON.stringify(data,null,2));
  } catch(e) {
    log("Erreur saveLedger:", e);
  }
}

function loadLedger() {
  try {
    if (fs.existsSync(LEDGER_FILE)) {
      const raw = fs.readFileSync(LEDGER_FILE,"utf8");
      if (raw.trim()) {
        const obj = JSON.parse(raw);
        if (obj && obj.state) {
          state = obj.state;
          log("Ledger chargé, height =", state.chain.length);
          return;
        }
      }
    }
  } catch(e) {
    log("Erreur lecture ledger, recréation genesis:", e);
  }
  // Genesis minimal si rien
  const genesis = {
    index: 0,
    time: Date.now(),
    prevHash: "0".repeat(64),
    hash: "GENESIS",
    txs: [],
    treasuryPow: 0,
    treasuryUsdc: 0,
    lpPow: 0,
    lpUsdc: 0,
    reward: 10
  };
  state.chain = [genesis];
  state.wallets = {};
  state.treasuryPow = 0;
  state.treasuryUsdc = 0;
  state.lpPow = 0;
  state.lpUsdc = 0;
  saveLedger();
  log("Genesis créé.");
}

function hashBlock(block) {
  const h = crypto.createHash("sha256");
  h.update(JSON.stringify({
    index:block.index,
    time:block.time,
    prevHash:block.prevHash,
    txs:block.txs,
    treasuryPow:block.treasuryPow,
    treasuryUsdc:block.treasuryUsdc,
    lpPow:block.lpPow,
    lpUsdc:block.lpUsdc
  }));
  return h.digest("hex");
}

function newBlock(txs) {
  const last = state.chain[state.chain.length-1];
  const block = {
    index: last.index + 1,
    time: Date.now(),
    prevHash: last.hash,
    txs,
    treasuryPow: state.treasuryPow,
    treasuryUsdc: state.treasuryUsdc,
    lpPow: state.lpPow,
    lpUsdc: state.lpUsdc,
    reward: 10
  };
  block.hash = hashBlock(block);
  state.chain.push(block);
  saveLedger();
  broadcast({type:"block",height:state.chain.length});
}

function getOrCreateWallet(addr) {
  if (!state.wallets[addr]) {
    state.wallets[addr] = { pow:0, usdc:0, staked:0 };
  }
  return state.wallets[addr];
}

// vérification signature TX POWCHAIN
function verifyTx(tx) {
  if (!tx || !tx.type || !tx.from || !tx.sig) return false;
  const msgObj = {
    type: tx.type,
    from: tx.from,
    to:   tx.to   ?? null,
    amount: tx.amount ?? null,
    extra: tx.extra ?? null
  };
  const msg = Buffer.from(JSON.stringify(msgObj),"utf8");
  try {
    const pubKey = bs58.decode(tx.from);
    const sig    = bs58.decode(tx.sig);
    return nacl.sign.detached.verify(msg, sig, pubKey);
  } catch(e) {
    log("verifyTx error:", e);
    return false;
  }
}

// traite une TX POWCHAIN (sauf bridge SOL→POWCHAIN qui passe par /bridge)
function applyTx(tx) {
  if (!verifyTx(tx)) {
    return { error:"invalid signature" };
  }

  if (tx.type === "transfer") {
    const amount = Number(tx.amount || 0);
    if (!tx.to || !Number.isFinite(amount) || amount<=0) {
      return { error:"invalid transfer" };
    }
    const fromW = getOrCreateWallet(tx.from);
    const toW   = getOrCreateWallet(tx.to);
    if (fromW.pow < amount) return { error:"insufficient funds" };
    fromW.pow -= amount;
    toW.pow   += amount;
    newBlock([tx]);
    return { ok:true };
  }

  if (tx.type === "stake") {
    const amount = Number(tx.amount || 0);
    const w = getOrCreateWallet(tx.from);
    if (!Number.isFinite(amount) || amount<=0) return { error:"invalid stake" };
    if (w.pow < amount) return { error:"insufficient funds" };
    w.pow    -= amount;
    w.staked += amount;
    newBlock([tx]);
    return { ok:true };
  }

  if (tx.type === "add_lp") {
    const powAmount  = Number(tx.amountPow || 0);
    const usdcAmount = Number(tx.amountUsdc || 0);
    const w = getOrCreateWallet(tx.from);
    if (powAmount<=0 || usdcAmount<=0) return { error:"invalid lp" };
    if (w.pow < powAmount || w.usdc < usdcAmount) return { error:"insufficient funds" };
    w.pow  -= powAmount;
    w.usdc -= usdcAmount;
    state.lpPow  += powAmount;
    state.lpUsdc += usdcAmount;
    newBlock([tx]);
    return { ok:true };
  }

  return { error:"unknown tx type" };
}

// ---------- HTTP API ----------
const server = http.createServer(async (req,res)=>{
  const parsed = url.parse(req.url,true);
  const path   = parsed.pathname;
  const method = req.method || "GET";

  // helper réponse JSON
  function sendJSON(code,obj){
    const out = JSON.stringify(obj);
    res.writeHead(code,{
      "Content-Type":"application/json",
      "Access-Control-Allow-Origin":"*"
    });
    res.end(out);
  }

  if (method === "OPTIONS") {
    res.writeHead(204,{
      "Access-Control-Allow-Origin":"*",
      "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
      "Access-Control-Allow-Headers":"Content-Type"
    });
    return res.end();
  }

  // --- ROOT : sert l'index statique (si Nginx ne le fait pas) ---
  if (path === "/" && method === "GET") {
    try{
      const html = fs.readFileSync("/var/www/html/index.html","utf8");
      res.writeHead(200,{"Content-Type":"text/html"});
      return res.end(html);
    }catch(e){
      return sendJSON(500,{error:"no index"});
    }
  }

  // --- /stats ---
  if (path === "/stats" && method === "GET") {
    const nbWallets = Object.keys(state.wallets).length;
    const tvlPow = Object.values(state.wallets).reduce((s,w)=>s+w.pow+w.staked,0) + state.lpPow + state.treasuryPow;
    const tvlUsdc= Object.values(state.wallets).reduce((s,w)=>s+w.usdc,0) + state.lpUsdc + state.treasuryUsdc;
    const out = {
      height: state.chain.length,
      wallets: nbWallets,
      tvlPow,
      tvlUsdc,
      treasuryPow: state.treasuryPow,
      treasuryUsdc: state.treasuryUsdc,
      lpPow: state.lpPow,
      lpUsdc: state.lpUsdc
    };
    return sendJSON(200,out);
  }

  // --- /wallet?id=ADDR ---
  if (path === "/wallet" && method === "GET") {
    const id = parsed.query.id;
    if (!id) return sendJSON(400,{error:"missing id"});
    const w = getOrCreateWallet(id);
    return sendJSON(200,{id,pow:w.pow,usdc:w.usdc,staked:w.staked});
  }

  // --- /chain ---
  if (path === "/chain" && method === "GET") {
    return sendJSON(200,state.chain);
  }

  // --- /tx (TX POWCHAIN signées) ---
  if (path === "/tx" && method === "POST") {
    let body="";
    req.on("data",ch=>body+=ch);
    req.on("end",()=>{
      try{
        const tx = JSON.parse(body||"{}");
        const resTx = applyTx(tx);
        if (resTx.error) return sendJSON(400,resTx);
        return sendJSON(200,resTx);
      }catch(e){
        return sendJSON(400,{error:"invalid tx json"});
      }
    });
    return;
  }

  // --- /bridge (SOL → POWCHAIN) ---
  if (path === "/bridge" && method === "POST") {
    let body="";
    req.on("data",ch=>body+=ch);
    req.on("end",()=>{
      try{
        const b = JSON.parse(body||"{}");
        const fromSol = b.fromSol;
        const toPow   = b.toPow;
        const amount  = Number(b.amount||0);
        const sig     = b.sig || "";

        if (!fromSol || !toPow || !Number.isFinite(amount) || amount<=0 || !sig) {
          return sendJSON(400,{error:"invalid bridge params"});
        }

        // Ici on pourrait vérifier on-chain que la TX SOL est bien arrivée
        // sur la trésorerie. Pour le moment on crédite directement POWCHAIN.

        const w = getOrCreateWallet(toPow);

        // Exemple simple : 1 SOL → 1 000 POW + 1 000 USDC POW
        const powCred  = amount * 1000;
        const usdcCred = amount * 1000;

        w.pow  += powCred;
        w.usdc += usdcCred;

        state.treasuryPow  += powCred * 0.02;  // petite fee pour la trésorerie
        state.treasuryUsdc += usdcCred * 0.02;

        // on enregistre un bloc "bridge"
        const txBridge = {
          type:"bridge",
          from: TREASURY_ADDR,
          to:   toPow,
          amountPow: powCred,
          amountUsdc: usdcCred,
          fromSol,
          sig,
          ts: Date.now()
        };
        newBlock([txBridge]);

        log("Bridge traité SOL→POWCHAIN:", fromSol, "→", toPow, "amount:", amount);
        return sendJSON(200,{ok:true,powCred,usdcCred});
      }catch(e){
        log("Bridge error:", e);
        return sendJSON(400,{error:"bridge exception"});
      }
    });
    return;
  }

  // fallback
  sendJSON(404,{error:"invalid endpoint"});
});

// ---------- WEBSOCKET ----------
const wss = new WebSocket.Server({ port: PORT_WS });

function broadcast(msg){
  const data = JSON.stringify(msg);
  wss.clients.forEach(c=>{
    if (c.readyState === WebSocket.OPEN) c.send(data);
  });
}

wss.on("connection",ws=>{
  log("WS client connecté");
  ws.send(JSON.stringify({type:"welcome",height:state.chain.length}));
  ws.on("close",()=>log("WS client déconnecté"));
});

// ---------- DÉMARRAGE ----------
loadLedger();

server.listen(PORT_HTTP,()=>{
  log("HTTP API POWCHAIN sur port",PORT_HTTP,"(/stats /wallet /block /chain /tx /bridge)");
});
log("WebSocket POWCHAIN sur port",PORT_WS,"(/ws via Nginx possible)");




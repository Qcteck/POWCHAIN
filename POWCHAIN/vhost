<!doctype html>
<meta charset="utf-8">
<title>Q+ Secure Core • WASM Live Graph</title>
<style>
body{margin:0;background:#05070c;color:#9ff;font-family:system-ui}
#top{display:flex;gap:8px;padding:8px}
button{background:#0b1020;color:#9ff;border:1px solid #234;padding:6px;cursor:pointer}
canvas{display:block;width:100%;height:260px;background:#070b18;border-top:1px solid #234}
pre{margin:0;padding:8px;background:#070b18;border-top:1px solid #234}
</style>

<div id="top">
<button onclick="ARM=!ARM">ARM ON/OFF</button>
<button onclick="hist=[]">RESET</button>
</div>

<canvas id="c" width="1200" height="260"></canvas>
<pre id="out"></pre>

<script>
let ARM=true,QWASM,hist=[];
const cv=document.getElementById("c"),ctx=cv.getContext("2d"),out=document.getElementById("out");

(async()=>{
 const r=await fetch("qplus.wasm");
 const b=await r.arrayBuffer();
 const m=await WebAssembly.instantiate(b,{});
 QWASM=m.instance.exports;
})();

const clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));

function tick(){
 if(!QWASM||!ARM)return;
 const score=Math.random();
 const risk=Math.random()*0.6;
 QWASM.step(score,risk,1);

 const p={
  t:Date.now(),
  rho:QWASM.get_rho(),
  ent:QWASM.get_entropy(),
  risk:QWASM.get_risk()
 };
 hist.push(p);
 if(hist.length>300)hist.shift();
 draw();
 out.textContent=JSON.stringify(p,null,2);
}

function draw(){
 const w=cv.width,h=cv.height;
 ctx.clearRect(0,0,w,h);
 ctx.globalAlpha=.12;
 for(let i=0;i<=10;i++){let y=h*i/10;ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke()}
 ctx.globalAlpha=1;

 if(hist.length<2)return;
 const t0=hist[0].t,t1=hist.at(-1).t,dt=Math.max(1,t1-t0);
 const X=t=>(t-t0)/dt*w;
 const Y=v=>h-(clamp(v)*h);

 function line(col,f){
  ctx.beginPath();ctx.strokeStyle=col;ctx.lineWidth=3;
  hist.forEach((p,i)=>{const x=X(p.t),y=Y(f(p));i?ctx.lineTo(x,y):ctx.moveTo(x,y)});
  ctx.stroke();
 }

 line("#66e",p=>p.rho);     // ρ(t)
 line("#0f8",p=>p.ent);     // entropie
 line("#f93",p=>p.risk);   // risque

 ctx.fillStyle="#9ff";ctx.fillText("ρ(t)",10,14);
 ctx.fillStyle="#7f7";ctx.fillText("S",50,14);
 ctx.fillStyle="#fb7";ctx.fillText("R",80,14);
}

setInterval(tick,1000);
</script>
app.post("/bridge", async (req, res) => {
  try {
    const { addr, amount, fromSol, txSig } = req.body || {};
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });

    const solAmt = Number(amount || 0);
    if (!(solAmt > 0)) return res.status(400).json({ ok: false, error: "Invalid sol amount" });

    // Pour l’instant, on accepte en mode “déclaratif” si txSig === "MANUAL"
    // (Tu pourras plus tard remettre la vérif RPC complète ici)
    if (txSig !== "MANUAL") {
      return res.json({ ok: false, error: "Bridge mode manuel uniquement pour cette version" });
    }

    // Crédit simple 1 SOL → 100 POW (exemple)
    const lamportsPow = Math.round(solAmt * DEC * 100);
    const w = getWallet(addr);
    w.pow += lamportsPow;
    w.nonce++;

    state.treasury.solBalance += solAmt;
    state.treasury.fireBalance += lamportsPow;

    const txBridge = {
      type: "bridge_in",
      addr,
      fromSol,
      sol: solAmt,
      powCredited: lamportsPow,
      txSig
    };

    addToMempool(txBridge);
    pushBlock("bridge_in", txBridge);

    res.json({
      ok: true,
      credited: lamportsPow,
      solDetected: solAmt
    });
  } catch (e) {
    console.error("Bridge ERR", e);
    res.status(500).json({ ok: false, error: e.message });
  }
});

// -------- LP / DEX --------
app.post("/lp/add", (req, res) => {
  try {
    const { addr, pow, usdc } = req.body;
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const p = Number(pow || 0);
    const u = Number(usdc || 0);
    if (!(p > 0) || !(u > 0)) {
      return res.status(400).json({ ok: false, error: "Invalid amounts" });
    }
    const w = getWallet(addr);
    if (w.pow < p || w.usdc < u) {
      return res.json({ ok: false, error: "Insufficient balance" });
    }
    w.pow -= p;
    w.usdc -= u;
    state.lp.pow += p;
    state.lp.usdc += u;
    w.nonce++;

    const tx = { type: "lp_add", addr, pow: p, usdc: u };
    addToMempool(tx);
    pushBlock("lp_add", tx);
    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

app.post("/swap", (req, res) => {
  try {
    const { addr, dir, amount } = req.body;
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ ok: false, error: "Invalid amount" });
    if (dir !== "pow2usdc" && dir !== "usdc2pow") {
      return res.status(400).json({ ok: false, error: "Invalid dir" });
    }
    const w = getWallet(addr);
    const feeRate = 0.003;

    if (state.lp.pow <= 0 || state.lp.usdc <= 0) {
      return res.json({ ok: false, error: "Empty LP" });
    }

    const k = state.lp.pow * state.lp.usdc;

    if (dir === "pow2usdc") {
      if (w.pow < amt) return res.json({ ok: false, error: "Insufficient POW" });
      const powAfter = state.lp.pow + amt;
      const usdcAfter = k / powAfter;
      let out = state.lp.usdc - usdcAfter;
      const fee = out * feeRate;
      out -= fee;
      if (out <= 0) return res.json({ ok: false, error: "Swap too small" });

      w.pow -= amt;
      w.usdc += out;
      state.lp.pow += amt;
      state.lp.usdc -= out;
      state.treasury.usdcBalance += fee;
      w.nonce++;

      const tx = { type: "swap_pow2usdc", addr, in: amt, out };
      addToMempool(tx);
      pushBlock("swap_pow2usdc", tx);
      res.json({ ok: true, received: out });
    } else {
      if (w.usdc < amt) return res.json({ ok: false, error: "Insufficient USDC" });
      const usdcAfter = state.lp.usdc + amt;
      const powAfter = k / usdcAfter;
      let out = state.lp.pow - powAfter;
      const fee = out * feeRate;
      out -= fee;
      if (out <= 0) return res.json({ ok: false, error: "Swap too small" });

      w.usdc -= amt;
      w.pow += out;
      state.lp.usdc += amt;
      state.lp.pow -= out;
      state.treasury.fireBalance += fee;
      w.nonce++;

      const tx = { type: "swap_usdc2pow", addr, in: amt, out };
      addToMempool(tx);
      pushBlock("swap_usdc2pow", tx);
      res.json({ ok: true, received: out });
    }
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});


#!/bin/bash
set -e

echo "🔥 FIREINNERS — Batch correctif WS / NGINX / PM2"

### 1️⃣ Sécuriser le backend PM2
echo "▶️ Redémarrage propre du backend PM2"
pm2 stop fireinners || true
pm2 delete fireinners || true

cd /root/fireinners
pm2 start server.js --name fireinners
pm2 save

### 2️⃣ Patch NGINX (WebSocket stable)
echo "▶️ Correction configuration NGINX WebSocket"

NGINX_SITE="/etc/nginx/sites-enabled/bbqfinance.fun"

cat > "$NGINX_SITE" <<'EOF'
server {
    listen 80;
    server_name bbqfinance.fun;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bbqfinance.fun;

    ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # 🔥 API backend
    location /stats {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    location /bridge {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    location /swap {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    location /stake {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    location /block {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    # 🚀 WEBSOCKET STABLE
    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }
}
EOF

nginx -t
systemctl reload nginx

### 3️⃣ Vérification API
echo "▶️ Test API /stats"
curl -s https://bbqfinance.fun/stats | head -n 5

### 4️⃣ Vérification WebSocket
echo "▶️ Test WebSocket avec wscat"
npm i -g wscat >/dev/null 2>&1 || true
echo "→ Si CONNECTED + message JSON = OK"
wscat -c wss://bbqfinance.fun/ws || true

### 5️⃣ Logs finaux
echo "▶️ Logs backend (CTRL+C pour quitter)"
pm2 logs fireinners --lines 20
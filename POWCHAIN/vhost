<script>
  const API = window.location.origin;
  const WS_URL = (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws";
  const SOL_RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

  const q = s => document.querySelector(s);
  const logBox = q("#log");
  function log(msg){
    if(!logBox) return;
    const t = new Date().toLocaleTimeString();
    logBox.textContent = "["+t+"] "+msg+"\n"+logBox.textContent;
  }

  // Tabs UI
  document.querySelectorAll("#tabs button").forEach(btn=>{
    btn.addEventListener("click",()=>{
      const tab = btn.getAttribute("data-tab");
      document.querySelectorAll("#tabs button").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      document.querySelectorAll("[data-tab-panel]").forEach(p=>{
        p.style.display = (p.getAttribute("data-tab-panel")===tab)?"flex":"none";
      });
    });
  });

  // Phantom connect
  let phantomPubkey = null;
  async function connectPhantom(){
    try{
      const provider = window.solana;
      if(!provider || !provider.isPhantom){
        alert("Phantom non détecté.");
        return;
      }
      const resp = await provider.connect();
      phantomPubkey = resp.publicKey.toString();
      q("#phantomAddr").textContent = "Adresse: "+phantomPubkey;
      const tag = q("#phantomState");
      tag.textContent = "Phantom: connecté";
      tag.classList.add("ok");
      await refreshSolanaBalances();
      log("Phantom connecté: "+phantomPubkey);
    }catch(e){
      log("Erreur Phantom: "+e.message);
    }
  }
  q("#btnPhantom").onclick = connectPhantom;

  async function refreshSolanaBalances(){
    try{
      if(!phantomPubkey) return;
      const conn = new solanaWeb3.Connection(SOL_RPC,"confirmed");
      const pub = new solanaWeb3.PublicKey(phantomPubkey);
      const lamports = await conn.getBalance(pub);
      q("#solBalance").textContent = (lamports/1e9).toFixed(4);
      const mint = new solanaWeb3.PublicKey(USDC_MINT);
      const accs = await conn.getParsedTokenAccountsByOwner(pub,{mint});
      let usdc = 0;
      accs.value.forEach(a=>{
        const info = a.account.data.parsed.info;
        const dec = info.tokenAmount.decimals;
        const amt = parseFloat(info.tokenAmount.amount);
        usdc += amt / Math.pow(10,dec);
      });
      q("#usdcBalance").textContent = usdc.toFixed(2);
      log("Solana balances rafraîchies.");
    }catch(e){
      log("Erreur SOL/USDC: "+e.message);
    }
  }

  // FIREINNERS wallet local
  let fireWallet = {
    addr:null,
    priv:null
  };

  async function apiGet(path){
    const t0 = performance.now();
    const r = await fetch(API+path);
    const t1 = performance.now();
    const lat = q("#netHeight") ? (t1-t0).toFixed(0) : null;
    if(!r.ok) throw new Error("HTTP "+r.status);
    return r.json();
  }
  async function apiPost(path,body){
    const r = await fetch(API+path,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(body)
    });
    if(!r.ok) throw new Error("HTTP "+r.status);
    return r.json();
  }

  async function loadFireWallet(addr){
    if(!addr){
      alert("Adresse FIREINNERS requise");
      return;
    }
    try{
      const w = await apiGet("/wallet/"+encodeURIComponent(addr));
      fireWallet.addr = w.pub;
      fireWallet.priv = null; // pas géré en clair dans cette UI
      q("#fwAddr").value = w.pub;
      q("#fwPow").textContent = (w.pow/1e6).toFixed(6);
      q("#fwUsdc").textContent = (w.usdc/1e6).toFixed(6);
      q("#fwStaked").textContent = (w.staked/1e6).toFixed(6);
      q("#fwNonce").textContent = w.nonce;
      log("Wallet FIREINNERS chargé: "+w.pub);
    }catch(e){
      log("Erreur wallet FIREINNERS: "+e.message);
    }
  }

  q("#btnFwLoad").onclick = ()=>loadFireWallet(q("#fwAddr").value.trim());

  q("#btnFwNew").onclick = ()=>{
    // générateur simple pseudo (pas cryptographique, démo UI)
    const rand = Math.random().toString(36).slice(2)+Date.now().toString(36);
    const addr = "FIRE_"+rand;
    fireWallet.addr = addr;
    q("#fwAddr").value = addr;
    q("#fwPow").textContent = "0.000000";
    q("#fwUsdc").textContent = "0.000000";
    q("#fwStaked").textContent = "0.000000";
    q("#fwNonce").textContent = "0";
    log("Wallet FIREINNERS local généré: "+addr);
  };

  q("#btnSendTx").onclick = async ()=>{
    if(!fireWallet.addr){
      alert("Charger ou générer un wallet FIREINNERS d'abord");
      return;
    }
    const to = q("#txTo").value.trim();

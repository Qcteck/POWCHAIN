// POWCHAIN server.js — API 3000 + WS 7001
const http = require('http');
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const WebSocket = require('ws');

const DATA_DIR = __dirname;
const CHAIN_FILE = path.join(DATA_DIR, 'chain.json');
const WALLETS_FILE = path.join(DATA_DIR, 'wallets.json');

let chain = [];
let wallets = {};
let lpPow = 0;
let lpUsdc = 0;
let treasuryUsdc = 0;
let treasurySol = 0;
let height = 0;

// ---------- Helpers persistence ----------
function loadJSON(file, fallback) {
  try {
    const txt = fs.readFileSync(file, 'utf8');
    return JSON.parse(txt);
  } catch (e) {
    console.log('[POWCHAIN] Impossible de lire', file, '-> fallback');
    return fallback;
  }
}
function saveJSON(file, obj) {
  try {
    fs.writeFileSync(file, JSON.stringify(obj, null, 2));
  } catch (e) {
    console.log('[POWCHAIN] Impossible d\'écrire', file, e.message);
  }
}

// ---------- State init ----------
chain = loadJSON(CHAIN_FILE, []);
wallets = loadJSON(WALLETS_FILE, {});
height = chain.length;
console.log('✅ Blockchain chargée :', height, 'blocs');

function getWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = { pow: 0, usdc: 0, staked: 0, nonce: 0, pub: addr };
  }
  return wallets[addr];
}

function addBlock(txs, note) {
  const h = chain.length + 1;
  const prevHash = chain.length ? chain[chain.length - 1].hash : 'GENESIS';
  const time = Date.now();
  const body = { height: h, prevHash, time, txs: txs || [], note: note || '' };
  const hash = crypto.createHash('sha256').update(JSON.stringify(body)).digest('hex');
  const block = { ...body, hash };
  chain.push(block);
  height = chain.length;
  saveJSON(CHAIN_FILE, chain);
  console.log('⛓️ Nouveau bloc #', h, '(', txs ? txs.length : 0, 'TX )');
  return block;
}

// ---------- TX processing ----------
function processTx(tx) {
  try {
    if (!tx || !tx.type || !tx.from) throw new Error('TX invalide');
    const DEC = 1e6;
    const type = tx.type;
    const wFrom = getWallet(tx.from);
    if (typeof tx.nonce === 'number' && tx.nonce <= wFrom.nonce) {
      throw new Error('Nonce trop bas');
    }
    if (type === 'TX_POW') {
      const amt = tx.amount | 0;
      if (amt <= 0) throw new Error('Montant invalide');
      const to = tx.to;
      if (!to) throw new Error('Destinataire manquant');
      if (wFrom.pow < amt) throw new Error('Solde POW insuffisant');
      const wTo = getWallet(to);
      wFrom.pow -= amt;
      wTo.pow += amt;
    } else if (type === 'STAKE') {
      const amt = tx.amount | 0;
      if (amt <= 0) throw new Error('Montant invalide');
      if (wFrom.pow < amt) throw new Error('Solde POW insuffisant');
      wFrom.pow -= amt;
      wFrom.staked += amt;
    } else if (type === 'SWAP') {
      const amt = tx.amount | 0;
      if (amt <= 0) throw new Error('Montant invalide');
      if (tx.token === 'pow2usdc') {
        if (wFrom.pow < amt) throw new Error('Solde POW insuffisant');
        wFrom.pow -= amt;
        wFrom.usdc += amt;
        lpPow += amt;
        lpUsdc -= amt;
      } else if (tx.token === 'usdc2pow') {
        if (wFrom.usdc < amt) throw new Error('Solde USDC insuffisant');
        wFrom.usdc -= amt;
        wFrom.pow += amt;
        lpUsdc += amt;
        lpPow -= amt;
      } else {
        throw new Error('Token swap inconnu');
      }
    } else if (type === 'LP_ADD') {
      const powAmt = tx.pow | 0;
      const usdcAmt = tx.usdc | 0;
      if (powAmt <= 0 || usdcAmt <= 0) throw new Error('Montants LP invalides');
      if (wFrom.pow < powAmt || wFrom.usdc < usdcAmt) throw new Error('Solde insuffisant LP');
      wFrom.pow -= powAmt;
      wFrom.usdc -= usdcAmt;
      lpPow += powAmt;
      lpUsdc += usdcAmt;
    } else {
      throw new Error('Type TX inconnu: ' + type);
    }

    // mise à jour nonce + persistance
    if (typeof tx.nonce === 'number') wFrom.nonce = tx.nonce;
    saveJSON(WALLETS_FILE, wallets);
    const block = addBlock([tx], 'TX ' + type);
    return { ok: true, block };
  } catch (e) {
    console.log('❌ Erreur processTx:', e.message);
    return { ok: false, error: e.message };
  }
}

// ---------- HTTP API (port 3000) ----------
const httpServer = http.createServer((req, res) => {
  const url = new URL(req.url, 'http://localhost');
  const pathName = url.pathname;
  const method = req.method || 'GET';

  // CORS simple
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET,POST,OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');
  if (method === 'OPTIONS') {
    res.writeHead(204);
    return res.end();
  }

  if (method === 'GET' && pathName === '/stats') {
    const body = {
      height,
      lpPow,
      lpUsdc,
      treasuryUsdc,
      treasurySol
    };
    res.writeHead(200, { 'Content-Type': 'application/json' });
    return res.end(JSON.stringify(body));
  }

  if (method === 'GET' && pathName.startsWith('/wallet/')) {
    const addr = decodeURIComponent(pathName.split('/')[2] || '');
    const w = getWallet(addr);
    res.writeHead(200, { 'Content-Type': 'application/json' });
    return res.end(JSON.stringify(w));
  }

  if (method === 'GET' && pathName.startsWith('/block/')) {
    const n = parseInt(pathName.split('/')[2] || '0', 10);
    const block = chain[n - 1];
    if (!block) {
      res.writeHead(404, { 'Content-Type': 'application/json' });
      return res.end(JSON.stringify({ error: 'Bloc introuvable' }));
    }
    res.writeHead(200, { 'Content-Type': 'application/json' });
    return res.end(JSON.stringify(block));
  }

  if (method === 'GET' && pathName === '/chain') {
    const last = chain.slice(-30);
    res.writeHead(200, { 'Content-Type': 'application/json' });
    return res.end(JSON.stringify({ height, blocks: last }));
  }

  if (method === 'POST' && pathName === '/tx') {
    let body = '';
    req.on('data', chunk => {
      body += chunk;
      if (body.length > 1e6) req.destroy(); // sécurité basique
    });
    req.on('end', () => {
      try {
        const tx = JSON.parse(body || '{}');
        const resTx = processTx(tx);
        res.writeHead(resTx.ok ? 200 : 400, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify(resTx));
      } catch (e) {
        res.writeHead(400, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ ok: false, error: 'JSON invalide' }));
      }
    });
    return;
  }

  res.writeHead(404, { 'Content-Type': 'application/json' });
  res.end(JSON.stringify({ error: 'Not found' }));
});

httpServer.listen(3000, () => {
  console.log('✅ HTTP API POWCHAIN en ligne sur port 3000 (/stats /wallet /block /chain /tx)');
});

// ---------- WebSocket (port 7001) ----------
const wss = new WebSocket.Server({ port: 7001 }, () => {
  console.log('✅ WebSocket POWCHAIN en ligne sur port 7001 (/ws)');
});

wss.on('connection', ws => {
  console.log('🔌 Client WebSocket connecté');
  ws.send(JSON.stringify({ type: 'hello', height }));
  ws.on('message', msg => {
    try {
      const tx = JSON.parse(msg.toString());
      const resTx = processTx(tx);
      ws.send(JSON.stringify({ type: 'tx_result', ...resTx }));
      if (resTx.ok) {
        const payload = JSON.stringify({ type: 'new_block', height });
        wss.clients.forEach(c => {
          if (c.readyState === WebSocket.OPEN) c.send(payload);
        });
      }
    } catch (e) {
      ws.send(JSON.stringify({ type: 'error', error: e.message }));
    }
  });
  ws.on('close', () => console.log('🔌 Client WebSocket déconnecté'));
});
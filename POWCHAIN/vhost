<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ULTRA Analyzer UX Pro</title><style>
:root{--bg:#060812;--panel:#0b1224;--panel2:#0a1020;--line:#223354;--txt:#e7f0ff;--mut:#ff6b6b;--ok:#4ade80;--sim:#22d3ee;--gap:#fbbf24;--acc:#7dd3fc;--acc2:#a78bfa;--shadow:0 14px 50px rgba(0,0,0,.38);--glass:rgba(7,12,24,.70);--glass2:rgba(6,10,20,.72)}
*{box-sizing:border-box}html,body{height:100%}body{margin:0;color:var(--txt);font-family:system-ui,-apple-system,Segoe UI,Roboto;background:
radial-gradient(1200px 700px at 28% 10%,rgba(125,211,252,.14),transparent 60%),
radial-gradient(900px 650px at 82% 42%,rgba(167,139,250,.12),transparent 60%),
linear-gradient(180deg,#050610,#05060a 40%,#05050a)}
button,select,input{background:rgba(10,16,32,.92);color:#bff;border:1px solid #2a3a62;padding:9px 10px;border-radius:12px;font-size:14px;outline:none}
button{cursor:pointer;user-select:none}button:active{transform:translateY(1px)}
input[type="range"]{padding:0;height:30px}
a{color:var(--acc);text-decoration:none}
#hud{position:sticky;top:0;z-index:50;background:linear-gradient(90deg,rgba(7,15,32,.88),rgba(7,15,32,.62));backdrop-filter:blur(10px);border-bottom:1px solid #243459;box-shadow:0 10px 35px rgba(0,0,0,.28)}
#hud .wrap{max-width:1760px;margin:auto;padding:10px 12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pill{display:flex;gap:8px;align-items:center;padding:6px 10px;border:1px solid #2a3a62;border-radius:999px;background:rgba(7,12,24,.72);font:12px ui-monospace,monospace;color:#cff}
.pill b{color:#fff}.dot{width:10px;height:10px;border-radius:99px;background:#64748b;box-shadow:0 0 0 2px rgba(255,255,255,.05) inset}
.dot.on{background:var(--ok);box-shadow:0 0 18px rgba(74,222,128,.25)}
.dot.warn{background:var(--gap);box-shadow:0 0 18px rgba(251,191,36,.18)}
.dot.dng{background:var(--mut);box-shadow:0 0 18px rgba(255,107,107,.22)}
#layout{max-width:1760px;margin:auto;padding:12px;display:grid;grid-template-columns:340px 1fr;gap:12px}
@media(max-width:1150px){#layout{grid-template-columns:1fr}}
.card{background:linear-gradient(180deg,rgba(11,18,36,.93),rgba(9,14,30,.90));border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}
.card .hd{padding:12px 12px;border-bottom:1px solid #203055;background:linear-gradient(90deg,rgba(125,211,252,.12),transparent 60%)}
.card .hd .t{font-weight:750;letter-spacing:.2px}
.card .hd .s{font-size:12px;color:#9fb;margin-top:4px}
.card .bd{padding:12px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.col{display:flex;flex-direction:column;gap:10px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(max-width:960px){.grid2{grid-template-columns:1fr}}
.kpis{display:grid;grid-template-columns:repeat(6,minmax(140px,1fr));gap:10px}
@media(max-width:1300px){.kpis{grid-template-columns:repeat(3,minmax(140px,1fr))}}
.kpi{background:rgba(6,10,20,.72);border:1px solid #23345e;border-radius:16px;padding:10px}
.kpi .k{font-size:12px;color:#9fb}.kpi .v{font:800 18px system-ui;color:#fff;margin-top:4px}
.badge{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;border:1px solid #2a3a62;background:rgba(7,12,24,.72);font-size:12px}
.blow{box-shadow:0 0 0 1px rgba(125,211,252,.16),0 0 26px rgba(125,211,252,.10)}
.sep{height:1px;background:#203055;margin:12px 0}
.small{font-size:12px;color:#9fb}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}
.tabs{display:flex;gap:8px;flex-wrap:wrap}
.tab{padding:8px 10px;border-radius:12px;border:1px solid #2a3a62;background:rgba(7,12,24,.72);cursor:pointer;font-size:13px}
.tab.on{background:linear-gradient(90deg,rgba(125,211,252,.18),rgba(167,139,250,.14));border-color:#3a4c82}
.panel{display:none}.panel.on{display:block}
.fold{border:1px solid #23345e;border-radius:16px;background:rgba(6,10,20,.68);overflow:hidden}
.fold summary{cursor:pointer;list-style:none;padding:10px 12px;font-weight:720;border-bottom:1px solid #223354;background:rgba(7,12,24,.58)}
.fold summary::-webkit-details-marker{display:none}
.fold .inner{padding:10px 12px}
.seq{font-family:ui-monospace,monospace;font-size:12.8px;white-space:nowrap;overflow:auto;border:1px solid #1c2744;padding:9px;border-radius:14px;background:rgba(3,6,14,.78)}
.match{color:var(--ok)}.mut{color:var(--mut)}.gap{color:var(--gap)}.sim{color:var(--sim)}
canvas{background:rgba(2,4,10,.88);border:1px solid #223354;border-radius:16px;width:100%;height:auto}
.toast{position:fixed;right:12px;bottom:12px;background:rgba(10,16,32,.95);border:1px solid #2a3a62;border-radius:14px;padding:10px 12px;color:#dff;box-shadow:var(--shadow);display:none;max-width:min(560px,92vw);z-index:80}
.tip{position:fixed;pointer-events:none;z-index:90;background:rgba(10,16,32,.96);border:1px solid #2a3a62;border-radius:14px;padding:8px 10px;color:#dff;box-shadow:var(--shadow);display:none;max-width:min(520px,92vw);font:12px ui-monospace,monospace}
.legend{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.sw{display:inline-flex;gap:6px;align-items:center}
.sw i{display:inline-block;width:12px;height:12px;border-radius:4px}
#spark{height:24px;border:1px solid #223354;border-radius:10px;background:rgba(2,4,10,.72)}
</style></head><body>
<div id="hud"><div class="wrap">
<div class="pill"><span class="dot" id="dotRun"></span>Etat <b id="state">init</b></div>
<div class="pill">AutoStart <b id="auto">ON</b></div>
<div class="pill">AutoTune <b id="tune">ON</b></div>
<div class="pill">Objectif <b id="objState">balance</b></div>
<div class="pill">MutRate <b id="mrState">0.025</b></div>
<div class="pill">Runs <b id="runs">0</b></div>
<div class="pill">Risque Q <b id="risk">0.000</b></div>
<div style="flex:1"></div>
<select id="theme"><option value="cobalt">Cobalt</option><option value="dark">Dark</option><option value="amber">Amber</option></select>
</div></div>

<div id="layout">
<div class="card">
<div class="hd"><div class="t">Contrôles</div><div class="s">Pilotage complet, presets, tuning, exports, raccourcis.</div></div>
<div class="bd">
<div class="tabs">
<div class="tab on" data-tab="gen">Génération</div>
<div class="tab" data-tab="ana">Analyse</div>
<div class="tab" data-tab="viz">Visualisations</div>
<div class="tab" data-tab="amcq">AMC-Q</div>
</div>
<div class="sep"></div>

<div class="panel on" id="tab-gen">
<details class="fold" open><summary>Exécution</summary><div class="inner">
<div class="row">
<select id="mode"><option value="spike" selected>Spike-like</option><option value="global">Alignement global</option><option value="local">Alignement local</option></select>
<select id="speed"><option value="70">Lent</option><option value="40" selected>Normal</option><option value="18">Rapide</option></select>
</div>
<div class="row" style="margin-top:10px">
<button id="play" class="blow">Play</button>
<button id="pause">Pause</button>
<button id="run1">Lancer 1</button>
<button id="reset">Reset</button>
</div>
<div class="row" style="margin-top:10px">
<label class="small"><input id="voice" type="checkbox" checked> Voix (résumé)</label>
<button id="stopVoice">Stop voix</button>
</div>
<div class="small" style="margin-top:10px">Raccourcis: Espace Play/Pause | R Reset | P PCA | T t-SNE | Y Phylo | O Pareto</div>
</div></details>

<details class="fold" open><summary>Presets</summary><div class="inner">
<div class="row">
<button id="presetExplore">Exploration</button>
<button id="presetStab">Stabilité</button>
<button id="presetEvade">Évasion</button>
<button id="presetFast">Fast</button>
</div>
<div class="small" style="margin-top:8px">Les presets ajustent loop, mutRate, epsilon, objectif, et cadence vocale.</div>
</div></details>

<details class="fold" open><summary>AutoStart / AutoTune</summary><div class="inner">
<div class="row">
<button id="toggleAuto">AutoStart ON</button>
<button id="toggleTune">AutoTune ON</button>
</div>
<div class="row" style="margin-top:10px">
<div style="flex:1">
<div class="small">Loop ms</div>
<input id="loopMs" type="range" min="250" max="2000" step="10" value="900" style="width:100%">
</div>
<div class="pill"><b id="loopMsV">900</b></div>
</div>
<div class="row">
<div style="flex:1">
<div class="small">MutRate</div>
<input id="mutRate" type="range" min="0.005" max="0.12" step="0.001" value="0.025" style="width:100%">
</div>
<div class="pill"><b id="mutRateV">0.025</b></div>
</div>
<div class="row">
<div style="flex:1">
<div class="small">Epsilon</div>
<input id="eps" type="range" min="0" max="1" step="0.01" value="0.25" style="width:100%">
</div>
<div class="pill"><b id="epsV">0.25</b></div>
</div>
<div class="row">
<div style="flex:1">
<div class="small">Step</div>
<input id="step" type="range" min="0.001" max="0.02" step="0.001" value="0.004" style="width:100%">
</div>
<div class="pill"><b id="stepV">0.004</b></div>
</div>
</div></details>

<details class="fold"><summary>Entrées</summary><div class="inner">
<input id="refIn" placeholder="Référence (auto)" style="width:100%"><div style="height:8px"></div>
<input id="varIn" placeholder="Variant (auto)" style="width:100%">
<div class="small" style="margin-top:8px">Les champs sont éditables, mais le moteur régénère en boucle si AutoStart est ON.</div>
</div></details>
</div>

<div class="panel" id="tab-ana">
<details class="fold" open><summary>Objectif (pression évolutive)</summary><div class="inner">
<select id="objective" style="width:100%"><option value="balance">Balance</option><option value="stability">Stabilité</option><option value="evasion">Évasion</option></select>
<div class="small" style="margin-top:8px">Balance: COST synthétique | Stabilité: substitutions conservatrices | Évasion: substitutions plus radicales, pression accrue sur RBD</div>
</div></details>
<details class="fold" open><summary>Voix</summary><div class="inner">
<div class="row">
<div style="flex:1"><div class="small">Voix Every (runs)</div><input id="voiceEvery" type="range" min="3" max="40" step="1" value="10" style="width:100%"></div>
<div class="pill"><b id="voiceEveryV">10</b></div>
</div>
</div></details>
<details class="fold" open><summary>Légende alignement</summary><div class="inner">
<div class="legend small">
<span class="sw"><i style="background:var(--ok)"></i>Identité</span>
<span class="sw"><i style="background:var(--sim)"></i>Similaire</span>
<span class="sw"><i style="background:var(--mut)"></i>Mutation</span>
<span class="sw"><i style="background:var(--gap)"></i>Gap</span>
</div>
</div></details>
<details class="fold"><summary>Exports</summary><div class="inner">
<div class="row">
<button id="exportRuns">Export runs JSON</button>
<button id="exportAMCQ">Export AMC+Q</button>
<button id="snap">Snapshot PNG</button>
</div>
<div class="row" style="margin-top:10px">
<button id="clearRuns">Clear runs</button>
<button id="resetAMCQ">Reset AMC-Q</button>
</div>
</div></details>
</div>

<div class="panel" id="tab-viz">
<details class="fold" open><summary>Coloration scatter</summary><div class="inner">
<select id="colorBy" style="width:100%"><option value="danger">Couleur: Danger</option><option value="score">Couleur: Score</option><option value="mut">Couleur: Mutations</option><option value="cluster">Couleur: Cluster (k-means)</option></select>
<div class="row" style="margin-top:10px">
<div style="flex:1"><div class="small">k clusters</div><input id="kClu" type="range" min="2" max="7" step="1" value="3" style="width:100%"></div>
<div class="pill"><b id="kCluV">3</b></div>
</div>
</div></details>
<details class="fold" open><summary>Actions visualisations</summary><div class="inner">
<div class="row">
<button id="doPCA">PCA</button>
<button id="doTSNE">t-SNE</button>
<button id="doPhylo">Phylo</button>
<button id="doPareto">Pareto</button>
</div>
<div class="small" style="margin-top:8px">Astuce: PCA/t-SNE sont cliquables (sélection d’un run).</div>
</div></details>
</div>

<div class="panel" id="tab-amcq">
<details class="fold" open><summary>Etat</summary><div class="inner small">AMC agrège les maxima et moyennes; Q expose un risque normalisé basé sur dangerMax.</div></details>
<details class="fold" open><summary>Données</summary><div class="inner">
<pre id="qView" style="margin:0"></pre><div style="height:10px"></div><pre id="amcView" style="margin:0"></pre>
</div></details>
</div>

</div></div>

<div class="card">
<div class="hd"><div class="t">Dashboard</div><div class="s">KPI, sparkline, alignement, heatmap (hover), graph, PCA/t-SNE, phylo, pareto.</div></div>
<div class="bd">

<div class="kpis">
<div class="kpi"><div class="k">Identité</div><div class="v" id="k_id">-</div></div>
<div class="kpi"><div class="k">Similarité</div><div class="v" id="k_sim">-</div></div>
<div class="kpi"><div class="k">Mutations</div><div class="v" id="k_mut">-</div></div>
<div class="kpi"><div class="k">Score</div><div class="v" id="k_score">-</div></div>
<div class="kpi"><div class="k">Danger</div><div class="v" id="k_danger">-</div><div class="small" id="k_lvl">-</div></div>
<div class="kpi"><div class="k">Pareto</div><div class="v" id="k_pareto">-</div></div>
</div>
<div style="margin-top:10px"><canvas id="spark" width="1200" height="60"></canvas></div>

<div class="sep"></div>

<details class="fold" open><summary>Alignement animé</summary><div class="inner">
<div class="small">Référence</div><div id="A" class="seq"></div>
<div class="small" style="margin-top:10px">Variant</div><div id="B" class="seq"></div>
<div class="small" style="margin-top:8px" id="interp"></div>
</div></details>

<details class="fold" open><summary>Heatmap mutationnelle (Spike-like)</summary><div class="inner">
<canvas id="heat" width="1400" height="100"></canvas>
<div class="small" id="heatInfo"></div>
</div></details>

<details class="fold" open><summary>Graph global</summary><div class="inner">
<canvas id="hist" width="1400" height="300"></canvas>
<div class="small">Courbes: identité (vert), mutations (rouge), danger (cyan), score abs (violet)</div>
</div></details>

<div class="grid2" style="margin-top:10px">
<div class="fold" open><summary>PCA (clic points)</summary><div class="inner"><canvas id="pca" width="680" height="360"></canvas><div class="small" id="pcaInfo">-</div></div></div>
<div class="fold" open><summary>t-SNE (clic points)</summary><div class="inner"><canvas id="tsne" width="680" height="360"></canvas><div class="small" id="tsneInfo">-</div></div></div>
</div>

<div class="grid2" style="margin-top:10px">
<div class="fold" open><summary>Phylo (UPGMA synthétique)</summary><div class="inner"><canvas id="tree" width="680" height="360"></canvas><div class="small" id="treeInfo">-</div></div></div>
<div class="fold" open><summary>Pareto (non dominés)</summary><div class="inner"><div id="pareto" class="mono small"></div></div></div>
</div>

</div></div>
</div>

<div class="toast" id="toast"></div><div class="tip" id="tip"></div>

<script>
(()=>{const $=id=>document.getElementById(id),LS=(k,v)=>v===undefined?localStorage.getItem(k):localStorage.setItem(k,v);
const toast=(t)=>{const el=$("toast");el.textContent=t;el.style.display="block";clearTimeout(el._t);el._t=setTimeout(()=>el.style.display="none",1800)};
const tip=()=>$("tip");const showTip=(x,y,txt)=>{const el=tip();el.textContent=txt;el.style.left=(x+12)+"px";el.style.top=(y+12)+"px";el.style.display="block"};const hideTip=()=>{tip().style.display="none"};

/* Theme */
const setTheme=(t)=>{if(t==="amber"){document.documentElement.style.setProperty("--acc","#fbbf24");document.documentElement.style.setProperty("--acc2","#fb7185");document.documentElement.style.setProperty("--bg","#07060a")}
else if(t==="dark"){document.documentElement.style.setProperty("--acc","#93c5fd");document.documentElement.style.setProperty("--acc2","#a7f3d0");document.documentElement.style.setProperty("--bg","#05060a")}
else{document.documentElement.style.setProperty("--acc","#7dd3fc");document.documentElement.style.setProperty("--acc2","#a78bfa");document.documentElement.style.setProperty("--bg","#060812")}};
$("theme").value=LS("ux_theme")||"cobalt";setTheme($("theme").value);$("theme").onchange=()=>{LS("ux_theme",$("theme").value);setTheme($("theme").value);toast("Theme applique")};

/* Tabs */
document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.remove("on"));b.classList.add("on");const key=b.dataset.tab;document.querySelectorAll(".panel").forEach(p=>p.classList.remove("on"));$("tab-"+key).classList.add("on")});

/* Params */
let P={autostart:1,autotune:1,loopMs:900,mutRate:.025,step:.004,eps:.25,voiceEvery:10};
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
const sync=()=>{$("loopMsV").textContent=P.loopMs;$("mutRateV").textContent=P.mutRate.toFixed(3);$("epsV").textContent=P.eps.toFixed(2);$("stepV").textContent=P.step.toFixed(3);$("voiceEveryV").textContent=P.voiceEvery;
$("mrState").textContent=P.mutRate.toFixed(3);$("objState").textContent=$("objective").value;$("auto").textContent=P.autostart?"ON":"OFF";$("tune").textContent=P.autotune?"ON":"OFF"};
$("loopMs").oninput=e=>{P.loopMs=parseInt(e.target.value,10)||900;sync();restartAuto()};
$("mutRate").oninput=e=>{P.mutRate=parseFloat(e.target.value)||.025;sync()};
$("eps").oninput=e=>{P.eps=parseFloat(e.target.value)||.25;sync()};
$("step").oninput=e=>{P.step=parseFloat(e.target.value)||.004;sync()};
$("voiceEvery").oninput=e=>{P.voiceEvery=parseInt(e.target.value,10)||10;sync()};
$("objective").onchange=()=>{sync();toast("Objectif: "+$("objective").value)};

/* Core (Spike-like synthétique) */
const AA="ACDEFGHIKLMNPQRSTVWY";
const GR={hydro:"AVLIMFWY",polar:"STNQC",pos:"KRH",neg:"DE",spec:"GP"};
const sameG=(a,b)=>Object.values(GR).some(g=>g.includes(a)&&g.includes(b));
const COST={};for(const a of AA){COST[a]={};for(const b of AA){COST[a][b]=(a===b)?3:(sameG(a,b)?1:-2)}}
const DOM=[{n:"S1",f:0,t:318,w:1},{n:"RBD",f:319,t:541,w:3},{n:"S2",f:542,t:1272,w:1.4}];
const FREQ={S1:{hydro:.35,polar:.30,pos:.15,neg:.15,spec:.05},RBD:{hydro:.25,polar:.40,pos:.20,neg:.10,spec:.05},S2:{hydro:.45,polar:.20,pos:.15,neg:.10,spec:.10}};
const rnd=()=>Math.random();
const domainAt=i=> (i<=318)?"S1":(i<=541)?"RBD":"S2";
const pickByFreq=(d)=>{let r=rnd(),a=0;for(const k in FREQ[d]){a+=FREQ[d][k];if(r<=a){const g=GR[k];return g[(rnd()*g.length)|0]}}return AA[(rnd()*AA.length)|0]};
let heat=new Array(1273).fill(0),ref=null;
const pickPos=()=>{let sum=0;for(let i=0;i<1273;i++)sum+=1/(1+heat[i]);let r=rnd()*sum,a=0;for(let i=0;i<1273;i++){a+=1/(1+heat[i]);if(a>=r)return i}return (rnd()*1273)|0};
const genRef=()=>{let s="";for(let i=0;i<1273;i++)s+=pickByFreq(domainAt(i));return s};
const mutateSpike=(R)=>{let A=R.split(""),budget=Math.max(5,(1273*P.mutRate)|0);while(budget--){let i=pickPos(),cur=A[i],d=domainAt(i),nxt=pickByFreq(d);if(nxt===cur){budget++;continue}A[i]=nxt;heat[i]++}return A.join("")};
const EVOPRESS={stability:(a,b,d)=>a===b?2:(sameG(a,b)?1:-3),evasion:(a,b,d)=>a===b?1:(d==="RBD"?-0.5:-2),balance:(a,b,d)=>COST[a][b]};

/* Speech (résumé, pas une par une) */
const speak=t=>{if(!$("voice").checked||!("speechSynthesis"in window))return;try{speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(String(t));u.lang="fr-FR";u.rate=.97;speechSynthesis.speak(u)}catch(_){}};$("stopVoice").onclick=()=>{try{speechSynthesis.cancel()}catch(_){}};

/* AMC-Q */
let Q=JSON.parse(LS("ux_q")||"null")||{meta:{risk:0},stats:{runs:0,last:null}};
let AMC=JSON.parse(LS("ux_amc")||"null")||{agg:{runs:0,dangerMax:0,scoreAvg:0,identityAvg:0,mutAvg:0},last:null};
const saveAMCQ=()=>{LS("ux_q",JSON.stringify(Q));LS("ux_amc",JSON.stringify(AMC))};
const renderAMCQ=()=>{$("qView").textContent=JSON.stringify(Q,null,2);$("amcView").textContent=JSON.stringify(AMC,null,2);$("risk").textContent=String(Q.meta.risk.toFixed(3))};
renderAMCQ();

/* UI state */
let RUNS=[],BUF=[],timer=null,autoT=null,selected=-1;
const dotSet=(state,dng)=>{const el=$("dotRun");el.className="dot"+(state==="run"?" on":""); if(dng>=65)el.className="dot dng"; else if(dng>=45)el.className="dot warn";};
const updateHUD=()=>{sync();$("runs").textContent=String(RUNS.length);$("state").textContent=P.autostart?"auto":"idle"};
const badgeLevel=(d)=>d<25?"FAIBLE":d<45?"MODERE":d<65?"ELEVE":"CRITIQUE";
const badgeClass=(lvl)=>lvl==="FAIBLE"?"low":lvl==="MODERE"?"mid":lvl==="ELEVE"?"high":"crit";

/* Metrics + diversity */
const diversity=s=>{const m=new Map();for(const c of s)m.set(c,(m.get(c)||0)+1);let H=0,n=s.length;for(const [_,v] of m){const p=v/n;H+=-p*Math.log2(p)}return +H.toFixed(3)};
const metrics=(R,V)=>{
let match=0,sim=0,mut=0,score=0,rbd=0,weighted=0;
const evo=EVOPRESS[$("objective").value]||EVOPRESS.balance;
for(let i=0;i<1273;i++){const a=R[i],b=V[i],d=domainAt(i);if(a===b){match++;score+=evo(a,b,d)}else if(sameG(a,b)){sim++;mut++;score+=evo(a,b,d)}else{mut++;score+=evo(a,b,d)}}
for(let i=0;i<1273;i++)if(R[i]!==V[i]){const d=DOM.find(x=>i>=x.f&&i<=x.t);weighted+=d.w;if(d.n==="RBD")rbd++}
const identity=((1273-mut)/1273*100),similarity=((match+sim)/1273*100),danger=(mut/1273*40)+(rbd*2.2)+(weighted*.3);
return{t:Date.now(),identity:+identity.toFixed(1),similarity:+similarity.toFixed(1),mutations:mut,score:Math.round(score),danger:+danger.toFixed(1),level:badgeLevel(danger),rbd,weighted:+weighted.toFixed(1),diversity:diversity(V),ref:R,var:V};
};

/* Animation */
const clearAnim=()=>{if(timer){clearTimeout(timer);timer=null}$("A").innerHTML="";$("B").innerHTML=""};
const animate=(A,B,done)=>{clearAnim();let i=0,L=Math.max(A.length,B.length),spd=parseInt($("speed").value,10)||40;
const step=()=>{if(i>=L){done();return}
const a=A[i]||"-",b=B[i]||"-";let cls="mut";if(a==="-"||b==="-")cls="gap";else if(a===b)cls="match";else if(sameG(a,b))cls="sim";
$("A").innerHTML+=`<span class="${cls}">${a}</span>`;$("B").innerHTML+=`<span class="${cls}">${b}</span>`;i++;timer=setTimeout(step,spd)};step()};

/* Graphs */
const drawSpark=()=>{const cv=$("spark"),c=cv.getContext("2d"),W=cv.width,H=cv.height;c.clearRect(0,0,W,H);
const a=RUNS.slice(-60);if(a.length<2)return;const xs=W/(a.length-1);const maxD=Math.max(1,...a.map(r=>r.danger));c.strokeStyle="rgba(255,255,255,.06)";for(let i=0;i<8;i++){c.beginPath();c.moveTo(0,i*(H/7));c.lineTo(W,i*(H/7));c.stroke()}
c.strokeStyle="#6ff";c.lineWidth=2;c.beginPath();a.forEach((r,i)=>{const x=i*xs;const y=H-(r.danger/maxD)*H;i?c.lineTo(x,y):c.moveTo(x,y)});c.stroke();c.lineWidth=1};
const drawHeat=()=>{
const cv=$("heat"),c=cv.getContext("2d"),W=cv.width,H=cv.height;c.clearRect(0,0,W,H);
const max=Math.max(1,...heat);
for(let i=0;i<1273;i++){const v=heat[i]/max;c.fillStyle=`rgb(${(255*v)|0},${(120*(1-v))|0},0)`;c.fillRect(i*(W/1273),0,(W/1273)+1,H)}
c.fillStyle="rgba(255,255,255,.06)";for(const d of DOM)c.fillRect(d.f*(W/1273),0,(d.t-d.f+1)*(W/1273),H);
c.fillStyle="rgba(125,211,252,.12)";c.fillRect(0,0,318*(W/1273),H);
c.fillStyle="rgba(167,139,250,.12)";c.fillRect(319*(W/1273),0,(541-319+1)*(W/1273),H);
$("heatInfo").textContent=`Heat total: ${heat.reduce((s,x)=>s+x,0)} | Max: ${max} | Domaines: S1(0-318) RBD(319-541) S2(542-1272)`;
};
const drawHist=()=>{
const a=RUNS,cv=$("hist"),c=cv.getContext("2d"),W=cv.width,H=cv.height;c.clearRect(0,0,W,H);
c.strokeStyle="rgba(255,255,255,.06)";for(let k=0;k<=10;k++){let y=10+k*(H-20)/10;c.beginPath();c.moveTo(10,y);c.lineTo(W-10,y);c.stroke()}
if(a.length<2)return;const xs=(W-20)/(a.length-1);
const maxM=Math.max(1,...a.map(r=>r.mutations)),maxD=Math.max(1,...a.map(r=>r.danger)),maxS=Math.max(1,...a.map(r=>Math.abs(r.score)));
const y01=t=>(H-10)-clamp(t,0,1)*(H-20);
const line=(col,f)=>{c.strokeStyle=col;c.lineWidth=2;c.beginPath();a.forEach((r,i)=>{const x=10+i*xs,y=f(r);i?c.lineTo(x,y):c.moveTo(x,y)});c.stroke()};
line("#4ade80",r=>y01(r.identity/100));
line("#ff6b6b",r=>y01(r.mutations/maxM));
line("#22d3ee",r=>y01(r.danger/maxD));
line("#a78bfa",r=>y01(Math.abs(r.score)/maxS));
if(selected>=0 && selected<a.length){const x=10+selected*xs;c.strokeStyle="rgba(255,255,255,.25)";c.beginPath();c.moveTo(x,8);c.lineTo(x,H-8);c.stroke();}
c.lineWidth=1;
};

/* Scatter (PCA/t-SNE) + cluster */
const vecOf=r=>[r.identity/100,r.mutations/1273,r.danger/100,(r.score+200)/400,r.diversity,(r.rbd||0)/1273];
const PCA2D=data=>{const m=data[0].length,mean=Array(m).fill(0);data.forEach(v=>v.forEach((x,i)=>mean[i]+=x));mean.forEach((_,i)=>mean[i]/=data.length);
const X=data.map(v=>v.map((x,i)=>x-mean[i]));let C=Array.from({length:m},()=>Array(m).fill(0));
X.forEach(v=>{for(let i=0;i<m;i++)for(let j=0;j<m;j++)C[i][j]+=v[i]*v[j]});for(let i=0;i<m;i++)for(let j=0;j<m;j++)C[i][j]/=(data.length-1||1);
const eig=()=>{let v=Array(m).fill(0).map(()=>Math.random());for(let it=0;it<60;it++){const nv=Array(m).fill(0);for(let i=0;i<m;i++)for(let j=0;j<m;j++)nv[i]+=C[i][j]*v[j];const n=Math.hypot(...nv)||1;v=nv.map(x=>x/n)}
const val=v.reduce((s,_,i)=>s+v[i]*(C[i].reduce((a,c,j)=>a+c*v[j],0)),0);return{v,val}};
const e1=eig();for(let i=0;i<m;i++)for(let j=0;j<m;j++)C[i][j]-=e1.val*e1.v[i]*e1.v[j];const e2=eig();
return X.map(v=>[v.reduce((s,x,i)=>s+x*e1.v[i],0),v.reduce((s,x,i)=>s+x*e2.v[i],0)])};
const tsne2D=(data,it=220,lr=50)=>{const N=data.length;let Y=Array.from({length:N},()=>[Math.random()-0.5,Math.random()-0.5]);
const dist=(a,b)=>a.reduce((s,x,i)=>s+(x-b[i])**2,0);
for(let t=0;t<it;t++)for(let i=0;i<N;i++){let gx=0,gy=0;for(let j=0;j<N;j++)if(i!==j){
const dij=dist(data[i],data[j]);const q=1/(1+((Y[i][0]-Y[j][0])**2+(Y[i][1]-Y[j][1])**2));
gx+=(Y[i][0]-Y[j][0])*(dij*q);gy+=(Y[i][1]-Y[j][1])*(dij*q)}
Y[i][0]-=lr*gx*1e-4;Y[i][1]-=lr*gy*1e-4}return Y};
const kmeans=(data,k=3,iter=18)=>{let C=data.slice(0,k).map(v=>v.slice());for(let it=0;it<iter;it++){
let G=[...Array(k)].map(()=>[]);for(const v of data){let bi=0,bd=1e9;for(let j=0;j<k;j++){let d=0;for(let p=0;p<v.length;p++)d+=(v[p]-C[j][p])**2;if(d<bd){bd=d;bi=j}}G[bi].push(v)}
for(let j=0;j<k;j++)if(G[j].length)for(let p=0;p<C[j].length;p++)C[j][p]=G[j].reduce((s,v)=>s+v[p],0)/G[j].length}return C};
const assignCluster=(data,cent)=>data.map(v=>{let bi=0,bd=1e9;for(let j=0;j<cent.length;j++){let d=0;for(let p=0;p<v.length;p++)d+=(v[p]-cent[j][p])**2;if(d<bd){bd=d;bi=j}}return bi});
const colorScale=(t)=>{t=clamp(t,0,1);const r=Math.round(60+195*t),g=Math.round(220-140*t),b=Math.round(255-200*t);return `rgb(${r},${g},${b})`};
const mkColors=(items,assign=null)=>{
const mode=$("colorBy").value;
if(mode==="cluster"&&assign){const pal=["#7dd3fc","#a78bfa","#4ade80","#ff6b6b","#fbbf24","#22c55e","#60a5fa"];return assign.map(i=>pal[i%pal.length])}
if(mode==="score"){const s=items.map(r=>r.score),mn=Math.min(...s),mx=Math.max(...s);return items.map(r=>colorScale((r.score-mn)/(mx-mn+1e-6)))}
if(mode==="mut"){const s=items.map(r=>r.mutations),mn=Math.min(...s),mx=Math.max(...s);return items.map(r=>colorScale((r.mutations-mn)/(mx-mn+1e-6)))}
const s=items.map(r=>r.danger),mn=Math.min(...s),mx=Math.max(...s);return items.map(r=>colorScale((r.danger-mn)/(mx-mn+1e-6)))
};
let PCA_PTS=null,TSNE_PTS=null,PCA_MAP=null,TSNE_MAP=null;
const drawScatter=(cv,pts,cols,selIndex=-1)=>{
const c=cv.getContext("2d"),W=cv.width,H=cv.height;c.clearRect(0,0,W,H);
c.fillStyle="rgba(255,255,255,.03)";for(let i=0;i<=10;i++){c.fillRect(i*(W/10),0,1,H);c.fillRect(0,i*(H/10),W,1)}
const xs=pts.map(p=>p[0]),ys=pts.map(p=>p[1]);const minx=Math.min(...xs),maxx=Math.max(...xs),miny=Math.min(...ys),maxy=Math.max(...ys);
const P=pts.map((p,i)=>({i,x:(p[0]-minx)/(maxx-minx+1e-6)*W,y:H-(p[1]-miny)/(maxy-miny+1e-6)*H}));
for(const p of P){c.fillStyle=cols[p.i]||"#6ff";c.beginPath();c.arc(p.x,p.y,3,0,Math.PI*2);c.fill()}
if(selIndex>=0&&selIndex<P.length){const p=P[selIndex];c.strokeStyle="rgba(255,255,255,.45)";c.lineWidth=2;c.beginPath();c.arc(p.x,p.y,8,0,Math.PI*2);c.stroke();c.lineWidth=1}
return P;
};
const nearestPoint=(mapped,x,y)=>{
let bi=-1,bd=1e9;
for(const p of mapped){const d=(p.x-x)**2+(p.y-y)**2;if(d<bd){bd=d;bi=p.i}}
return (bd<=140)?bi:-1;
};

/* Phylo */
const distVar=(a,b)=>Math.hypot(a.identity-b.identity,a.mutations-b.mutations,a.danger-b.danger,a.score-b.score);
const upgma=(items)=>{let C=items.map((_,i)=>({ids:[i],left:null,right:null}));const d=(c1,c2)=>{let s=0,n=0;c1.ids.forEach(i=>c2.ids.forEach(j=>{s+=distVar(items[i],items[j]);n++}));return s/(n||1)};
while(C.length>1){let bi=0,bj=1,bd=d(C[0],C[1]);for(let i=0;i<C.length;i++)for(let j=i+1;j<C.length;j++){const dij=d(C[i],C[j]);if(dij<bd){bd=dij;bi=i;bj=j}}
const a=C[bi],b=C[bj];C=C.filter((_,i)=>i!==bi&&i!==bj);C.push({ids:[...a.ids,...b.ids],left:a,right:b})}return C[0]};
const drawTree=(cv,node,x=10,y=cv.height/2,dx=100)=>{
const c=cv.getContext("2d");if(!node)return;
if(node.left&&node.right){c.strokeStyle="#9ff";c.beginPath();c.moveTo(x,y);c.lineTo(x+dx,y);c.stroke();drawTree(cv,node.left,x+dx,y-dx/2,dx/1.35);drawTree(cv,node.right,x+dx,y+dx/2,dx/1.35)}
else{c.fillStyle="#6ff";c.fillText("v"+node.ids[0],x,y)}
};

/* Pareto */
const dominates=(a,b)=>{const be=a.identity>=b.identity&&a.mutations<=b.mutations&&a.danger<=b.danger&&a.score>=b.score;const st=a.identity>b.identity||a.mutations<b.mutations||a.danger<b.danger||a.score>b.score;return be&&st};
const paretoFront=list=>list.filter(a=>!list.some(b=>b!==a&&dominates(b,a)));


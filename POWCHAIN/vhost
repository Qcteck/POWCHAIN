<!doctype html><html lang=fr><head><meta charset=utf-8><meta name=viewport content=width=device-width,initial-scale=1><title>FIREINNERS PANEL</title><style>body{margin:0;background:radial-gradient(circle at 50% 30%,#2b1d47,#0b0620 60%,#000 100%);font-family:system-ui;color:#fff;overflow-x:hidden}#bg{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:-1;background:url('https://i.imgur.com/Hp1yYgF.jpeg');background-size:cover;opacity:.18;filter:blur(3px)}.c{border:1px solid #3af;border-radius:12px;padding:12px;margin:10px;background:#0a0f22cc;box-shadow:0 0 12px #3af4}.b{background:#111933;border:1px solid #3af;color:#3af;padding:6px 10px;border-radius:6px;font-size:13px;cursor:pointer}.b:hover{background:#3af;color:#000}.t{font-size:12px;margin:3px 0;color:#9df}.row{display:flex;gap:8px}.col{flex:1}.h{font-size:18px;color:#f90;text-shadow:0 0 8px #f60}#log{white-space:pre-wrap;height:180px;overflow:auto;background:#0008;padding:8px;border-radius:8px;border:1px solid #333}</style></head><body><div id=bg></div><div style=padding:12px><h1 style="text-align:center;color:#f90;text-shadow:0 0 12px #f60">FIREINNERS PANEL</h1>

<div class=c><div class=h>Solana (Phantom)</div><div class=row><button class=b onclick=connectPhantom()>CONNECTER PHANTOM</button><button class=b onclick=loadSolBalances()>RAFRAICHIR SOLDES</button></div><div class=t id=solAddr>-</div><div class=row><div class=col>SOL:<div id=solBal>-</div></div><div class=col>USDC:<div id=usdcBal>-</div></div></div></div>

<div class=c><div class=h>Wallet POWCHAIN</div><button class=b onclick=genPow()>GÉNÉRER WALLET</button><div class=t>Adresse:<span id=paddr>-</span></div><div class=t>Clé privée:<span id=pkey>-</span></div><canvas id=qr width=120 height=120 style="margin-top:8px"></canvas><button class=b onclick=loadPow()>RECHARGER BALANCES</button><div class=row><div class=col>POW:<div id=pw>-</div></div><div class=col>USDC POW:<div id=pu>-</div></div><div class=col>Staked:<div id=ps>-</div></div><div class=col>Nonce:<div id=pn>-</div></div></div></div>

<div class=c><div class=h>Bridge SOL → POWCHAIN</div><input id=binp type=number placeholder="Montant SOL" style="width:100%;padding:6px;background:#0003;border:1px solid #3af;color:#fff;border-radius:6px"><button class=b onclick=bridgeSol()>BRIDGE</button></div>

<div class=c><div class=h>DEX interne</div><div class=row><input id=swapamt type=number placeholder=Montant class=b style=flex:1><select id=swapdir class=b><option value=pow2usdc>POW→USDC</option><option value=usdc2pow>USDC→POW</option></select><button class=b onclick=swap()>SWAP</button></div></div>

<div class=c><div class=h>Staking</div><div class=row><input id=stamt type=number placeholder=Montant class=b style=flex:1><button class=b onclick=stake()>STAKE</button><button class=b onclick=unstake()>UNSTAKE</button></div></div>

<div class=c><div class=h>Explorer</div><button class=b onclick=loadChain()>Voir 20 derniers blocs</button><div id=chain style=max-height:200px;overflow:auto;font-size:11px></div></div>

<div class=c><div class=h>Mempool</div><button class=b onclick=loadMempool()>Charger mempool</button><div id=memp style=max-height:200px;overflow:auto;font-size:11px></div></div>

<div class=c><div class=h>Console</div><div id=log></div></div>

</div>

<script src="https://unpkg.com/bs58@5.0.0/dist/bs58.min.js"></script><script src="https://cdn.jsdelivr.net/npm/tweetnacl@1/nacl.min.js"></script>
<script>
const API="https://bbqfinance.fun";let ppub="",ppriv="";let ws;
function L(t){log.innerText="["+new Date().toLocaleTimeString()+"] "+t+"\\n"+log.innerText;}

function connectWS(){try{ws=new WebSocket("wss://bbqfinance.fun/ws");ws.onopen=_=>L("WS connecté");ws.onclose=_=>{L("WS fermé, reconnexion...");setTimeout(connectWS,3000)};ws.onerror=e=>L("WS ERR "+e);ws.onmessage=m=>{};}catch(e){L("WS FAIL "+e)}}
connectWS();

async function connectPhantom(){try{const r=await window.solana.connect();solAddr.innerText=r.publicKey.toString();L("Phantom connecté");}catch(e){L("ERR Phantom "+e)}}

async function loadSolBalances(){try{if(!window.solana||!window.solana.publicKey)return L("Pas connecté Phantom");const addr=window.solana.publicKey.toString();const conn="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";const b=await fetch(conn,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[addr]})}).then(r=>r.json());solBal.innerText=(b.result.value/1e9).toFixed(4);
const tok=await fetch(conn,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getTokenAccountsByOwner",params:[addr,{programId:"TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"},{encoding:"jsonParsed"}]})}).then(r=>r.json());
let us=0;if(tok.result){tok.result.value.forEach(a=>{try{if(a.account.data.parsed.info.mint==="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1")us+=Number(a.account.data.parsed.info.tokenAmount.uiAmount);}catch(_){}});}usdcBal.innerText=us.toFixed(2);
}catch(e){L("Bal ERR: "+e)}}

function genPow(){const k=nacl.sign.keyPair();ppub=bs58.encode(k.publicKey);ppriv=bs58.encode(k.secretKey);paddr.innerText=ppub;pkey.innerText=ppriv;drawQR(ppub);L("Wallet POWCHAIN généré")}

function drawQR(t){const c=qr.getContext("2d");c.fillStyle="#000";c.fillRect(0,0,120,120);c.fillStyle="#3af";for(let i=0;i<100;i++){let x=Math.floor(Math.random()*120),y=Math.floor(Math.random()*120);if(Math.random()<.3)c.fillRect(x,y,2,2);}}

async function loadPow(){if(!ppub)return L("Pas de wallet");const r=await fetch(API+"/wallet/"+ppub).then(r=>r.json());pw.innerText=(r.pow/1e6).toFixed(2);pu.innerText=(r.usdc/1e6).toFixed(2);ps.innerText=(r.staked/1e6).toFixed(2);pn.innerText=r.nonce;}

async function bridgeSol(){if(!ppub)return L("Wallet manquant");let amt=Number(binp.value);if(!(amt>0))return L("Montant invalide");const r=await fetch(API+"/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({amount:amt})}).then(r=>r.json());L("Bridge OK crédit="+r.credited);}

async function swap(){if(!ppub)return L("Wallet manquant");let a=Number(swapamt.value);if(!(a>0))return L("Montant invalide");let d=swapdir.value;const r=await fetch(API+"/swap",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:ppub,dir:d,amount:a})}).then(r=>r.json());L("Swap "+JSON.stringify(r));}

async function stake(){let a=Number(stamt.value);if(!(a>0))return L("Invalide");const r=await fetch(API+"/stake",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:ppub,amount:a})}).then(r=>r.json());L("Stake "+JSON.stringify(r));}

async function unstake(){let a=Number(stamt.value);if(!(a>0))return L("Invalide");const r=await fetch(API+"/unstake",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:ppub,amount:a})}).then(r=>r.json());L("Unstake "+JSON.stringify(r));}

async function loadChain(){const r=await fetch(API+"/chain").then(r=>r.json());chain.innerText=JSON.stringify(r.slice(-20),null,2);}
async function loadMempool(){const r=await fetch(API+"/mempool").then(r=>r.json());memp.innerText=JSON.stringify(r,null,2);}
</script>
</body></html>






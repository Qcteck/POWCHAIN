    <div class="card">
      <div class="tag">POW Explorer</div>
      <button id="btnChain" style="margin-bottom:4px">Charger derniers blocs</button>
      <div style="font-size:11px;opacity:.7">Affiche les ~30 derniers blocs depuis /chain.</div>
      <div id="chainOut" style="margin-top:6px;font-size:10px;max-height:150px;overflow:auto;white-space:pre-wrap"></div>
    </div>

    <div class="card">
      <div class="tag">Scan Wallet</div>
      <input id="scanAddr" placeholder="Adresse POWCHAIN à scanner"/>
      <button id="btnScan" style="margin-top:4px">Scan</button>
      <div id="scanRes" style="margin-top:6px;font-size:11px;white-space:pre-wrap"></div>
      <h3 style="margin-top:10px;font-size:13px">WebHash FULL</h3>

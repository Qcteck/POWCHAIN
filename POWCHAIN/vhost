sudo nano /etc/nginx/sites-available/bbqfinance


server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # Frontend FIREINNERS / POWCHAIN
    root /var/www/bbqfinance;
    index index.html;

    # Tout ce qui n'est pas API renvoyé sur index.html (SPA)
    location / {
        try_files $uri /index.html;
    }

    # ---------- HTTP API backend (Node sur 3000) ----------
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /lp {
        proxy_pass http://127.0.0.1:3000/lp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /bridge {
        proxy_pass http://127.0.0.1:3000/bridge;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /bridge-out {
        proxy_pass http://127.0.0.1:3000/bridge-out;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---------- WebSocket POWCHAIN / FIREINNERS (port 7001) ----------
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # Compression simple
    gzip on;
    gzip_min_length 256;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json;
}




sudo ln -sf /etc/nginx/sites-available/bbqfinance /etc/nginx/sites-enabled/default




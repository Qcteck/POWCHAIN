nano /root/server.js

const http = require("http");
const WebSocket = require("ws");

const PORT_HTTP = 3000;
const PORT_WS = 7001;

let chain = [];
let mempool = [];
let lpPow = 0;
let lpUsdc = 0;
let treasuryUsdc = 0;
let treasurySol = 0;

const api = http.createServer((req,res)=>{
  res.setHeader("Access-Control-Allow-Origin","*");
  res.setHeader("Content-Type","application/json");
  if(req.url==="/stats") return res.end(JSON.stringify({height:chain.length,lpPow,lpUsdc,treasuryUsdc,treasurySol}));
  if(req.url==="/chain") return res.end(JSON.stringify(chain.slice(-30)));
  if(req.url==="/mempool") return res.end(JSON.stringify(mempool));
  res.statusCode = 404;
  res.end(JSON.stringify({error:"not found"}));
});
api.listen(PORT_HTTP,()=>console.log("HTTP OK",PORT_HTTP));

const wss = new WebSocket.Server({ port: PORT_WS },()=>console.log("WS OK",PORT_WS));

function broadcast(obj){
  const m = JSON.stringify(obj);
  wss.clients.forEach(c=>{ if(c.readyState===WebSocket.OPEN) c.send(m) });
}

wss.on("connection",ws=>{
  ws.send(JSON.stringify({type:"WELCOME",height:chain.length}));
  ws.on("message",raw=>{
    try{
      const tx = JSON.parse(raw);
      mempool.push(tx);
      const block = {index:chain.length,time:Date.now(),tx};
      chain.push(block);
      broadcast({type:"NEW_BLOCK",block});
    }catch(e){ console.log("WS error",e); }
  });
});



pm2 stop all
pm2 delete all
pm2 start /root/server.js --name powchain
pm2 save



set -euo pipefail
HOST="sentinel.fireinners.online"
SECRET="Sentinel1"
PORT="9696"
APP_DIR="/root/fireinners-security-sentinel"
EMAIL="admin@fireinners.online"

echo "=== MEGA BATCH (DEPLOY + SETTINGS) ==="

echo "[1/6] DNS check"
getent hosts "$HOST" >/dev/null 2>&1 || { echo "DNS_FAIL: cree A/AAAA pour $HOST vers ton VPS puis relance."; exit 1; }

echo "[2/6] Install deps"
apt-get update
apt-get install -y nginx certbot apache2-utils nodejs npm
# node/npm deja OK chez toi, mais on laisse safe.

echo "[3/6] Deploy Sentinel (minimal read-only) + systemd"
mkdir -p "$APP_DIR/public"
cd "$APP_DIR"

cat > package.json <<'EOF'
{"name":"sentinel","version":"1.0.0","type":"module","private":true,"scripts":{"start":"node server.js"},"dependencies":{"express":"^4.19.2","dotenv":"^16.4.5"}}
EOF
cat > .env <<EOF
PORT=$PORT
EOF
cat > server.js <<'EOF'
import "dotenv/config";import express from "express";import http from "http";
const PORT=parseInt(process.env.PORT||"9696",10);
const app=express();app.disable("x-powered-by");app.use((req,res,next)=>{res.setHeader("Cache-Control","no-store");next();});
app.use(express.static("public"));
let score=92,reliability=70,seq=0;
function bulletin(){seq++;const t=Date.now();score=Math.max(0,Math.min(100,score+(Math.random()>.1?1:-5)));reliability=Math.max(0,Math.min(100,reliability+(Math.random()>.15?1:-6)));const level=score>80?"STABLE":score>55?"ALERT":score>30?"ALARM":"CRITICAL";return{kind:"SECURITY_BULLETIN",seq,ts:t,level,score,reliability,events:[{time:t,level,origin:"Q+Local",type:"pulse",status:"observed",message:"surveillance lecture seule",next:"aucune action destructive"}]};}
app.get("/public/state",(req,res)=>res.json(bulletin()));
app.get("/",(req,res)=>res.redirect("/public.html"));
http.createServer(app).listen(PORT,"127.0.0.1",()=>console.log("[Sentinel] http://127.0.0.1:"+PORT));
EOF
cat > public/public.html <<'EOF'
<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1"><title>Sentinel Public</title><style>body{margin:0;background:#070a12;color:#e9f2ff;font:14px system-ui}#w{max-width:900px;margin:18px auto;padding:14px}h1{margin:0 0 10px;font-size:16px}#box{border:1px solid #23324f;border-radius:14px;padding:12px;background:#0b1222}b{color:#7dfbd1}pre{white-space:pre-wrap;word-break:break-word;margin:10px 0 0}</style><div id=w><h1>Sentinel Public (lecture seule)</h1><div id=box>Etat: <b id=l>—</b><br>Score: <b id=s>—</b><br>Fiabilite: <b id=r>—</b><pre id=j>{}</pre></div></div><script>const $=id=>document.getElementById(id);async function tick(){const d=await (await fetch("/public/state")).json();$("l").textContent=d.level;$("s").textContent=d.score;$("r").textContent=d.reliability+"%";$("j").textContent=JSON.stringify(d,null,2);}tick();setInterval(tick,2500);</script>
EOF

npm i
cat > /etc/systemd/system/security-sentinel.service <<EOF
[Unit]
Description=Security Sentinel (read-only)
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=$APP_DIR
EnvironmentFile=$APP_DIR/.env
ExecStart=/usr/bin/node $APP_DIR/server.js
Restart=always
RestartSec=2
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now security-sentinel
curl -sS --max-time 2 "http://127.0.0.1:$PORT/public/state" >/dev/null || { echo "LOCAL_FAIL: Sentinel ne repond pas sur 127.0.0.1:$PORT"; exit 1; }

echo "[4/6] BasicAuth + Nginx HTTP webroot (pour cert)"
htpasswd -bc /etc/nginx/.sentinel_htpasswd sentinel Sentinel1
chmod 640 /etc/nginx/.sentinel_htpasswd
chown root:www-data /etc/nginx/.sentinel_htpasswd
mkdir -p /var/www/certbot

cat > /etc/nginx/sites-available/${HOST}.conf <<NGINX
map \$http_upgrade \$connection_upgrade { default upgrade; '' close; }
server{
  listen 80;
  server_name ${HOST};
  location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; default_type "text/plain"; }
  location / { proxy_pass http://127.0.0.1:${PORT}; proxy_http_version 1.1; proxy_set_header Host \$host; proxy_set_header X-Forwarded-Proto \$scheme; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; }
}
NGINX
ln -sf /etc/nginx/sites-available/${HOST}.conf /etc/nginx/sites-enabled/${HOST}.conf
nginx -t
systemctl reload nginx

echo "[5/6] Certbot webroot"
certbot certonly --webroot -w /var/www/certbot -d "$HOST" -m "$EMAIL" --agree-tos --non-interactive

echo "[6/6] Switch Nginx to SSL + secret path"
cat > /etc/nginx/sites-available/${HOST}.conf <<NGINX
map \$http_upgrade \$connection_upgrade { default upgrade; '' close; }
server{
  listen 80;
  server_name ${HOST};
  location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; default_type "text/plain"; }
  location / { return 301 https://\$host\$request_uri; }
}
server{
  listen 443 ssl http2;
  server_name ${HOST};
  ssl_certificate /etc/letsencrypt/live/${HOST}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${HOST}/privkey.pem;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Permissions-Policy geolocation=(),camera=(),microphone=() always;
  location = / { return 302 /public.html; }
  location = /public.html { proxy_pass http://127.0.0.1:${PORT}/public.html; }
  location /public/ { proxy_pass http://127.0.0.1:${PORT}; proxy_http_version 1.1; proxy_set_header Host \$host; proxy_set_header X-Forwarded-Proto \$scheme; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; }
  location = /admin.html { return 404; }
  location = /admin/state { return 404; }
  location = /ws/admin { return 404; }
  location = /${SECRET}/admin.html { auth_basic "Sentinel Admin"; auth_basic_user_file /etc/nginx/.sentinel_htpasswd; proxy_pass http://127.0.0.1:${PORT}/admin.html; proxy_http_version 1.1; proxy_set_header Host \$host; }
}
NGINX
nginx -t
systemctl reload nginx

echo "DONE:"
echo "Public: https://${HOST}/public.html"
echo "Admin : https://${HOST}/${SECRET}/admin.html (BasicAuth: sentinel / Sentinel1)"
echo "=== END ==="
// server.js – POWCHAIN validator + HTTP API + WebSocket

const PORT_HTTP = 3000;
const PORT_WS = 7001;

const http = require("http");
const url = require("url");
const fs = require("fs");
const crypto = require("crypto");
const WebSocket = require("ws");

// Fichier de persistance
const LEDGER_FILE = "/root/powchain/ledger.json";

// Trésorerie POWCHAIN (même adresse que tu utilises déjà)
const TREASURY_ADDR = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

// --------- ÉTAT GLOBAL ---------
let state = {
  chain: [],
  wallets: {},
  lpPow: 0,
  lpUsdcPow: 0,
  treasuryPow: 0,
  treasuryUsdc: 0,
  height: 0
};

function log(...args) {
  console.log("[POWCHAIN]", ...args);
}

// --------- LEDGER ---------
function hashBlock(b) {
  const h = crypto.createHash("sha256");
  h.update(
    JSON.stringify({
      index: b.index,
      time: b.time,
      prevHash: b.prevHash,
      txs: b.txs,
      treasuryPow: b.treasuryPow,
      treasuryUsdc: b.treasuryUsdc,
      lpPow: b.lpPow,
      lpUsdcPow: b.lpUsdcPow,
      reward: b.reward
    })
  );
  return h.digest("hex");
}

function saveLedger() {
  fs.writeFileSync(LEDGER_FILE, JSON.stringify(state, null, 2));
}

function loadLedger() {
  try {
    const raw = fs.readFileSync(LEDGER_FILE, "utf8");
    state = JSON.parse(raw);
    if (!Array.isArray(state.chain) || !state.chain.length) {
      throw new Error("ledger vide");
    }
    state.height = state.chain.length;
    log("Ledger chargé, height =", state.height);
  } catch (e) {
    log("Aucun ledger trouvé, création genesis...");
    const genesis = {
      index: 0,
      time: Date.now(),
      prevHash: "0".repeat(64),
      hash: "",
      txs: [],
      treasuryPow: 0,
      treasuryUsdc: 0,
      lpPow: 0,
      lpUsdcPow: 0,
      reward: 10
    };
    genesis.hash = hashBlock(genesis);
    state.chain = [genesis];
    state.wallets = {};
    state.lpPow = 0;
    state.lpUsdcPow = 0;
    state.treasuryPow = 0;
    state.treasuryUsdc = 0;
    state.height = 1;
    saveLedger();
  }
}

// --------- WALLET / BLOCK ---------
function ensureWallet(addr) {
  if (!state.wallets[addr]) {
    state.wallets[addr] = { pow: 0, usdc: 0, staked: 0 };
  }
  return state.wallets[addr];
}

function addBlock(txs) {
  const prev = state.chain[state.chain.length - 1];
  const block = {
    index: prev.index + 1,
    time: Date.now(),
    prevHash: prev.hash,
    hash: "",
    txs,
    treasuryPow: state.treasuryPow,
    treasuryUsdc: state.treasuryUsdc,
    lpPow: state.lpPow,
    lpUsdcPow: state.lpUsdcPow,
    reward: 10
  };
  block.hash = hashBlock(block);
  state.chain.push(block);
  state.height = state.chain.length;
  saveLedger();
  broadcast({
    type: "stats",
    height: state.height,
    wallets: Object.keys(state.wallets).length,
    treasuryPow: state.treasuryPow,
    treasuryUsdc: state.treasuryUsdc,
    lpPow: state.lpPow,
    lpUsdcPow: state.lpUsdcPow
  });
}

// --------- LOGIQUE DES TX ---------
function handleTx(tx) {
  const fail = (msg) => ({ ok: false, error: msg });
  const ok = (res) => ({ ok: true, res: res || {} });

  if (!tx || typeof tx.type !== "string") return fail("missing type");

  // Envoi POW → POW
  if (tx.type === "send") {
    const { from, to } = tx;
    const amount = Number(tx.amount);
    if (typeof from !== "string" || typeof to !== "string")
      return fail("send: addr");
    if (!amount || amount <= 0) return fail("send: amount");

    const wFrom = ensureWallet(from);
    const wTo = ensureWallet(to);
    if (wFrom.pow < amount) return fail("send: balance");

    wFrom.pow -= amount;
    wTo.pow += amount;

    addBlock([{ type: "send", from, to, amount }]);
    return ok({ from: wFrom, to: wTo });
  }

  // Stake POW
  if (tx.type === "stake") {
    const { from } = tx;
    const amount = Number(tx.amount);
    if (typeof from !== "string") return fail("stake: addr");
    if (!amount || amount <= 0) return fail("stake: amount");

    const w = ensureWallet(from);
    if (w.pow < amount) return fail("stake: balance");

    w.pow -= amount;
    w.staked += amount;

    addBlock([{ type: "stake", from, amount }]);
    return ok(w);
  }

  // Unstake POW
  if (tx.type === "unstake") {
    const { from } = tx;
    const amount = Number(tx.amount);
    if (typeof from !== "string") return fail("unstake: addr");
    if (!amount || amount <= 0) return fail("unstake: amount");

    const w = ensureWallet(from);
    if (w.staked < amount) return fail("unstake: balance");

    w.staked -= amount;
    w.pow += amount;

    addBlock([{ type: "unstake", from, amount }]);
    return ok(w);
  }

  // Ajouter de la liquidité interne POW / USDC POW
  if (tx.type === "addLP") {
    const from = String(tx.from || "");
    const powAmt = Number(tx.pow);
    const usdcAmt = Number(tx.usdc);
    if (!powAmt || powAmt <= 0 || !usdcAmt || usdcAmt <= 0)
      return fail("lp: amount");

    const w = ensureWallet(from);
    if (w.pow < powAmt || w.usdc < usdcAmt) return fail("lp: balance");

    w.pow -= powAmt;
    w.usdc -= usdcAmt;
    state.lpPow += powAmt;
    state.lpUsdcPow += usdcAmt;

    addBlock([{ type: "addLP", from, pow: powAmt, usdc: usdcAmt }]);
    return ok({ lpPow: state.lpPow, lpUsdcPow: state.lpUsdcPow });
  }

  // BRIDGE SOL → POWCHAIN (crédit POW une fois le SOL envoyé à la trésorerie)
  if (tx.type === "bridge") {
    const { to, amountSol, solanaSig } = tx;
    if (typeof to !== "string") return fail("bridge: addr");
    const amtSol = Number(amountSol);
    if (!amtSol || amtSol <= 0) return fail("bridge: amount");

    const w = ensureWallet(to);

    // Exemple : 1 SOL bridgé = 1 000 POW crédités
    const powMint = Math.floor(amtSol * 1000);
    w.pow += powMint;

    // On pourrait aussi augmenter une réserve POW spéciale bridge si tu veux
    addBlock([
      {
        type: "bridge",
        to,
        amountSol: amtSol,
        amountPow: powMint,
        solanaSig: solanaSig || null,
        treasurySol: TREASURY_ADDR
      }
    ]);

    log("Bridge validé pour", to, "=>", powMint, "POW");
    return ok({ pow: w.pow, amountPow: powMint });
  }

  return fail("unknown type");
}

// --------- HTTP API ---------
const server = http.createServer((req, res) => {
  const parsed = url.parse(req.url, true);
  const path = parsed.pathname || "/";

  // CORS simple pour le client
  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type");
  if (req.method === "OPTIONS") {
    res.writeHead(204);
    res.end();
    return;
  }

  // /stats
  if (req.method === "GET" && path === "/stats") {
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(
      JSON.stringify({
        height: state.height,
        wallets: Object.keys(state.wallets).length,
        treasuryPow: state.treasuryPow,
        treasuryUsdc: state.treasuryUsdc,
        lpPow: state.lpPow,
        lpUsdcPow: state.lpUsdcPow
      })
    );
    return;
  }

  // /wallet?id=ADDR
  if (req.method === "GET" && path === "/wallet") {
    const id = parsed.query.id;
    if (!id) {
      res.writeHead(400, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "missing id" }));
      return;
    }
    const w = ensureWallet(String(id));
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(JSON.stringify(w));
    return;
  }

  // /chain complet
  if (req.method === "GET" && path === "/chain") {
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(JSON.stringify(state.chain));
    return;
  }

  // /block?h=INDEX
  if (req.method === "GET" && path === "/block") {
    const h = Number(parsed.query.h || state.height - 1);
    const blk = state.chain.find((b) => b.index === h);
    if (!blk) {
      res.writeHead(404, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "not found" }));
      return;
    }
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(JSON.stringify(blk));
    return;
  }

  // /tx (POST JSON)
  if (req.method === "POST" && path === "/tx") {
    let buf = "";
    req.on("data", (chunk) => {
      buf += chunk;
      if (buf.length > 1e6) req.destroy();
    });
    req.on("end", () => {
      try {
        const tx = JSON.parse(buf || "{}");
        const r = handleTx(tx);
        if (!r.ok) {
          res.writeHead(400, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: r.error }));
        } else {
          res.writeHead(200, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ ok: true, ...r.res }));
        }
      } catch (e) {
        res.writeHead(400, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: "bad json" }));
      }
    });
    return;
  }

  // index.html pour /
  if (req.method === "GET" && (path === "/" || path === "/index.html")) {
    try {
      const html = fs.readFileSync("/var/www/html/index.html", "utf8");
      res.writeHead(200, { "Content-Type": "text/html" });
      res.end(html);
    } catch (e) {
      res.writeHead(500, { "Content-Type": "text/plain" });
      res.end("index.html manquant");
    }
    return;
  }

  // Autre endpoint
  res.writeHead(404, { "Content-Type": "application/json" });
  res.end(JSON.stringify({ error: "invalid endpoint" }));
});

// --------- WEBSOCKET ---------
const wss = new WebSocket.Server({ port: PORT_WS });
let clients = [];

wss.on("connection", (ws) => {
  clients.push(ws);
  ws.send(JSON.stringify({ type: "welcome", height: state.height }));
  ws.on("close", () => {
    clients = clients.filter((c) => c !== ws);
  });
});

function broadcast(msg) {
  const raw = JSON.stringify(msg);
  clients.forEach((ws) => {
    try {
      ws.send(raw);
    } catch (e) {}
  });
}

// Tick stats régulier
setInterval(() => {
  broadcast({
    type: "stats",
    height: state.height,
    wallets: Object.keys(state.wallets).length,
    treasuryPow: state.treasuryPow,
    treasuryUsdc: state.treasuryUsdc,
    lpPow: state.lpPow,
    lpUsdcPow: state.lpUsdcPow
  });
}, 10000);

// --------- DÉMARRAGE ---------
loadLedger();

server.listen(PORT_HTTP, () => {
  log("HTTP API POWCHAIN sur port", PORT_HTTP, "(/stats /wallet /block /chain /tx)");
});
log("WebSocket POWCHAIN sur port", PORT_WS, "(/ws via Nginx)");








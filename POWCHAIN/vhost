nano /root/powchain/server.js



// ======================== API REST =========================

// /stats  → état blockchain + comptes
app.get("/stats", (req,res)=>{
  res.json({
    blocks: chain.length,
    treasury: accounts[treasury].pow,
    usdcTreasury: accounts[treasury].usdc,
    accounts: Object.keys(accounts).length
  });
});

// /chain → renvoie tous les blocs
app.get("/chain", (req,res)=>{
  res.json(chain);
});

// /tx  → nouvelle transaction {from,to,amount,type}
app.post("/tx", (req,res)=>{
  try{
    const tx = req.body;
    mempool.push(tx);
    broadcast({type:"mempool",tx});
    res.json({ok:true});
  }catch(e){
    res.json({ok:false,error:e.toString()});
  }
});

// ======================== WEBSOCKET =========================
wss.on("connection",(ws)=>{
  ws.send(JSON.stringify({type:"hello",msg:"WS POWCHAIN connecté"}));
});

// ======================== LANCEMENT SERVEURS =========================
server.listen(3000,()=> console.log("⚡ HTTP API POWCHAIN online sur port 3000 (/stats /tx /chain)"));
wsServer.listen(7001,()=> console.log("🔌 WebSocket POWCHAIN en ligne sur port 7001 (/ws)"));
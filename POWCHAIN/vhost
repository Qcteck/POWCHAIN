# 1) index.html
nano /var/www/html/index.html
# (coller le HTML ci-dessus, enregistrer)

# 2) server.js
mkdir -p /root/POWCHAIN
nano /root/POWCHAIN/server.js
# (coller le server.js ci-dessus)

cd /root/POWCHAIN
npm install express cors body-parser ws

# 3) nginx conf
nano /etc/nginx/sites-available/bbqfinance.conf
# (coller la conf nginx ci-dessus)

ln -sf /etc/nginx/sites-available/bbqfinance.conf /etc/nginx/sites-enabled/bbqfinance.conf

# 4) vérifier nginx et recharger
nginx -t
systemctl reload nginx

# 5) redémarrer le backend avec PM2
cd /root/POWCHAIN
pm2 delete fireinners || true
pm2 start server.js --name fireinners
pm2 save
pm2 logs fireinners
set -euo pipefail
PORT=9696
APP_DIR=/root/fireinners-security-sentinel

echo "[SERVICE] status"
systemctl status security-sentinel --no-pager || true
echo
echo "[LOGS] last 120"
journalctl -u security-sentinel -n 120 --no-pager || true
echo
echo "[TRY RESTART]"
systemctl restart security-sentinel || true
sleep 1
echo
echo "[LISTEN]"
ss -lntp | grep ":$PORT" || echo "rien sur $PORT"
echo
echo "[CURL]"
curl -sS --max-time 2 "http://127.0.0.1:$PORT/public/state" | head -c 220; echo
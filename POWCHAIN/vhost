nano /etc/nginx/sites-available/bbqfinance
# colle tout le bloc ci-dessus, en remplaçant l’ancien
server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # Sécurité de base
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy strict-origin-when-cross-origin;

    # Dossier web statique
    root /var/www/html;
    index index.html;

    # Page principale POWCHAIN (HTML)
    location = / {
        try_files /index.html =404;
    }

    # API POWCHAIN (Node sur 3000)
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /tx {
        proxy_pass http://127.0.0.1:3000/tx;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket POWCHAIN (Node sur 7001)
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Fichiers statiques (CSS, JS, etc.)
    location /assets/ {
        try_files $uri =404;
    }

    # 502 / 404 custom simples (optionnel)
    error_page 502 /502.html;
    location = /502.html {
        internal;
        return 502 '{"error":"bad gateway"}';
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        return 404 '{"error":"not found"}';
    }
}


nano /var/www/html/index.html

<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>POWCHAIN — Client Complet</title>

  <!-- Solana Web3 pour Phantom -->
  <script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>

  <style>
    :root{
      --bg:#05070b;
      --panel:#071326;
      --panel2:#091a33;
      --border:#22324a;
      --accent:#38bdf8;
      --accent2:#22c55e;
      --txt:#e5ecff;
      --muted:#9ca3af;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      background:var(--bg);
      color:var(--txt);
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }
    h1{
      margin:0 0 6px;
      font-size:22px;
      text-align:center;
      letter-spacing:1px;
    }
    #wrap{
      max-width:1200px;
      margin:10px auto 20px;
      padding:10px;
    }
    #topBar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:8px;
    }
    #statusDot{
      width:10px;
      height:10px;
      border-radius:999px;
      background:#f97316;
      box-shadow:0 0 10px #f97316;
      margin-right:6px;
    }
    #statusText{
      font-size:12px;
      color:var(--muted);
    }
    .pillOnline{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:2px 10px;
      border-radius:999px;
      background:#022c22;
      border:1px solid #16a34a;
      font-size:12px;
      color:#bbf7d0;
    }
    .grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:10px;
    }
    .card{
      background:radial-gradient(circle at top,var(--panel2),var(--panel));
      border-radius:10px;
      border:1px solid var(--border);
      padding:10px;
      box-shadow:0 0 20px #000a;
      min-height:120px;
    }
    .card h3{
      margin:0 0 6px;
      font-size:14px;
      letter-spacing:.5px;
      color:#bae6fd;
    }
    .label{
      font-size:11px;
      color:var(--muted);
      margin-top:4px;
    }
    .valueBig{
      font-size:16px;
      font-weight:600;
    }
    .row{
      display:flex;
      gap:6px;
      margin-top:4px;
      flex-wrap:wrap;
    }
    input,select,button,textarea{
      font-family:inherit;
      font-size:12px;
    }
    input,select{
      background:#020617;
      border:1px solid #1f2937;
      border-radius:6px;
      padding:6px 7px;
      color:var(--txt);
      width:100%;
    }
    button{
      border-radius:6px;
      border:1px solid var(--accent);
      background:#0b1120;
      color:var(--accent);
      padding:6px 10px;
      cursor:pointer;
      font-weight:500;
      text-transform:uppercase;
      letter-spacing:.5px;
    }
    button.small{
      padding:4px 8px;
      font-size:11px;
    }
    button.secondary{
      border-color:#4b5563;
      color:#e5e7eb;
    }
    button:disabled{
      opacity:.4;
      cursor:not-allowed;
    }
    #log{
      width:100%;
      height:120px;
      background:#020617;
      border-radius:8px;
      border:1px solid #111827;
      padding:6px;
      font-size:11px;
      color:#e5e7eb;
      resize:vertical;
      white-space:pre-wrap;
    }
    #networkStats span{
      display:block;
      font-size:11px;
      margin-top:2px;
      color:var(--muted);
    }
    .mono{
      font-family:"SF Mono","JetBrains Mono",Consolas,monospace;
      font-size:11px;
    }
    @media(max-width:960px){
      .grid{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
<div id="wrap">
  <div id="topBar">
    <div>
      <h1>POWCHAIN — Client Complet</h1>
      <div id="statusText" class="mono">
        Backend: <span id="backendStatus">...</span> · WebSocket: <span id="wsStatus">...</span>
      </div>
    </div>
    <div class="pillOnline">
      <div id="statusDot"></div>
      <span id="onlineText">Connexion...</span>
    </div>
  </div>

  <!-- GRID PRINCIPALE -->
  <div class="grid">

    <!-- COLONNE 1 : RÉSEAU + WALLET POWCHAIN -->
    <div class="card">
      <h3>RÉSEAU POWCHAIN</h3>
      <div id="networkStats">
        <span>Hauteur : <b id="netHeight">—</b></span>
        <span>Nombre de wallets : <b id="netWallets">—</b></span>
        <span>TVL LP POW : <b id="netLpPow">—</b></span>
        <span>TVL LP USDC POW : <b id="netLpUsdc">—</b></span>
        <span>Trésorerie POW : <b id="netTreasuryPow">—</b></span>
        <span>Trésorerie USDC POW : <b id="netTreasuryUsdc">—</b></span>
      </div>

      <hr style="border-color:#111827;margin:8px 0"/>

      <h3>WALLET POWCHAIN</h3>
      <div class="label">Adresse POWCHAIN</div>
      <input id="powAddr" placeholder="Adresse POWCHAIN (base58)"/>
      <div class="row">
        <button class="small" onclick="scanWallet()">SCAN</button>
      </div>
      <div class="label">Soldes</div>
      <div class="mono">
        POW : <span id="powBal">0</span><br/>
        USDC POW : <span id="usdcPowBal">0</span><br/>
        Stake : <span id="stakedBal">0</span>
      </div>
    </div>

    <!-- COLONNE 2 : WALLET SOLANA + BRIDGE -->
    <div class="card">
      <h3>WALLET SOLANA — PHANTOM</h3>
      <div class="row">
        <button id="btnConnectPhantom" onclick="connectPhantom()">Connecter PHANTOM</button>
        <button class="secondary small" onclick="refreshPhantomBalances()">Refresh</button>
      </div>
      <div class="label">Adresse Solana</div>
      <div id="solAddr" class="mono">Non connectée</div>

      <div class="label" style="margin-top:6px;">Soldes (Solana mainnet)</div>
      <div class="mono">
        SOL : <span id="solBalance">0.0000</span><br/>
        USDC : <span id="usdcBalance">0.00</span>
      </div>

      <hr style="border-color:#111827;margin:8px 0"/>

      <h3>BRIDGE vers POWCHAIN</h3>
      <div class="label">Montant SOL à bridger</div>
      <input id="bridgeAmount" placeholder="Ex: 0.001"/>
      <div class="row">
        <button onclick="sendBridge()">SOL → POWCHAIN</button>
      </div>
      <div class="label">Note</div>
      <div style="font-size:11px;color:var(--muted);">
        Envoie une requête <span class="mono">BRIDGE_REQUEST</span> au serveur POWCHAIN.
        Les soldes POW / USDC POW seront mis à jour après validation de bloc.
      </div>
    </div>

    <!-- COLONNE 3 : DEX + LP + LOG -->
    <div class="card">
      <h3>DEX POWCHAIN</h3>
      <div class="label">Ajouter de la liquidité (POW / USDC POW)</div>
      <input id="lpPowAmount" placeholder="Montant POW"/>
      <input id="lpUsdcAmount" placeholder="Montant USDC POW"/>
      <div class="row">
        <button class="small" onclick="addLp()">ADD LP</button>
      </div>
      <div class="label" style="margin-top:4px;">
        Un add LP ≥ 10 000 POW et 10 000 USDC POW donne le badge session WHALE.
      </div>

      <hr style="border-color:#111827;margin:8px 0"/>

      <h3>EXPLORER & LOG</h3>
      <div class="row">
        <button class="small" onclick="loadLastBlocks()">Charger derniers blocs</button>
        <button class="small secondary" onclick="clearLog()">Clear log</button>
      </div>
      <textarea id="log" readonly></textarea>
    </div>

  </div><!-- /grid -->
</div><!-- /wrap -->

<script>
  // --------- CONSTANTES BACKEND ----------
  const API_BASE = "";
  const WS_URL = (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws";

  const DRPC_RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_SOL_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

  // --------- LOG UTIL ----------
  function log(msg){
    const el = document.getElementById("log");
    const ts = new Date().toLocaleTimeString("fr-CA",{hour12:false});
    el.value = `[${ts}] ${msg}\n` + el.value;
  }
  function clearLog(){ document.getElementById("log").value=""; }

  // --------- WEBSOCKET POWCHAIN ----------
  let ws = null;
  let wsRetry = 0;

  function setWsStatus(ok){
    const dot = document.getElementById("statusDot");
    const txt = document.getElementById("onlineText");
    const wsTxt = document.getElementById("wsStatus");
    if(ok){
      dot.style.background = "#22c55e";
      dot.style.boxShadow = "0 0 10px #22c55e";
      txt.textContent = "Online";
      wsTxt.textContent = "connecté";
    }else{
      dot.style.background = "#f97316";
      dot.style.boxShadow = "0 0 10px #f97316";
      txt.textContent = "Reconnexion...";
      wsTxt.textContent = "déconnecté";
    }
  }

  function sendWs(obj){
    if(ws && ws.readyState === WebSocket.OPEN){
      ws.send(JSON.stringify(obj));
    }else{
      log("NET ERR WebSocket non connecté");
    }
  }

  function connectWs(){
    try{
      ws = new WebSocket(WS_URL);
    }catch(e){
      log("WS ERR " + e.message);
      setWsStatus(false);
      setTimeout(connectWs, 3000);
      return;
    }

    ws.onopen = () => {
      wsRetry = 0;
      setWsStatus(true);
      log("WebSocket connecté");
      sendWs({type:"hello"});
    };

    ws.onclose = () => {
      setWsStatus(false);
      if(wsRetry < 10){
        wsRetry++;
        setTimeout(connectWs, 2000);
      }else{
        log("WS arrêté après trop d'essais");
      }
    };

    ws.onerror = (e) => {
      log("WS error");
    };

    ws.onmessage = (ev) => {
      try{
        const msg = JSON.parse(ev.data);
        handleWsMessage(msg);
      }catch(e){
        log("WS parse ERR " + e.message);
      }
    };
  }

  function handleWsMessage(msg){
    if(msg.type === "welcome"){
      log("WELCOME height=" + msg.height);
    }else if(msg.type === "stats"){
      applyStats(msg.stats);
    }else if(msg.type === "wallet"){
      applyWallet(msg.wallet);
    }else if(msg.type === "info"){
      log(msg.text || "info");
    }else if(msg.type === "error"){
      log("ERR " + (msg.error || ""));
    }
  }

  // --------- HTTP API STATS / WALLET ----------
  async function fetchJson(path){
    try{
      const res = await fetch(API_BASE + path,{cache:"no-store"});
      if(!res.ok) throw new Error("HTTP " + res.status);
      return await res.json();
    }catch(e){
      log("NET ERR " + e.message);
      throw e;
    }
  }

  async function loadStats(){
    try{
      const stats = await fetchJson("/stats");
      applyStats(stats);
      document.getElementById("backendStatus").textContent = "OK";
    }catch(e){
      document.getElementById("backendStatus").textContent = "erreur";
    }
  }

  function applyStats(s){
    if(!s) return;
    document.getElementById("netHeight").textContent = s.height ?? "—";
    document.getElementById("netWallets").textContent = s.wallets ?? "—";
    document.getElementById("netLpPow").textContent = s.lpPow ?? "0";
    document.getElementById("netLpUsdc").textContent = s.lpUsdc ?? "0";
    document.getElementById("netTreasuryPow").textContent = s.treasuryPow ?? "0";
    document.getElementById("netTreasuryUsdc").textContent = s.treasuryUsdc ?? "0";
  }

  async function scanWallet(){
    const addr = document.getElementById("powAddr").value.trim();
    if(!addr){
      alert("Entrez une adresse POWCHAIN");
      return;
    }
    try{
      const w = await fetchJson("/wallet?id=" + encodeURIComponent(addr));
      applyWallet(w);
      log("Wallet scanné " + addr);
    }catch(e){
      // erreur déjà log
    }
  }

  function applyWallet(w){
    if(!w) return;
    document.getElementById("powBal").textContent = w.pow ?? 0;
    document.getElementById("usdcPowBal").textContent = w.usdc ?? w.usdcPow ?? 0;
    document.getElementById("stakedBal").textContent = w.staked ?? 0;
  }

  async function loadLastBlocks(){
    try{
      const arr = await fetchJson("/chain");
      log("Derniers blocs:\n" + JSON.stringify(arr.slice(-10),null,2));
    }catch(e){}
  }

  // --------- LP ----------
  async function addLp(){
    const addr = document.getElementById("powAddr").value.trim();
    if(!addr){
      alert("Adresse POWCHAIN requise");
      return;
    }
    const pow = parseFloat(document.getElementById("lpPowAmount").value.replace(",",".")) || 0;
    const usd = parseFloat(document.getElementById("lpUsdcAmount").value.replace(",",".")) || 0;
    if(pow<=0 || usd<=0){
      alert("Montants invalides");
      return;
    }
    // On envoie via HTTP simple, le serveur décidera
    try{
      const res = await fetch("/lp",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({type:"add_lp",addr,pow,usdc:usd})
      });
      if(!res.ok) throw new Error("HTTP " + res.status);
      const j = await res.json();
      log("LP OK " + JSON.stringify(j));
      loadStats();
      scanWallet();
    }catch(e){
      log("NET ERR " + e.message);
    }
  }

  // --------- PHANTOM (SOLANA) ----------
  let phantom = null;
  let solPublicKey = null;

  async function connectPhantom(){
    try{
      if(!window.solana){
        alert("Phantom non détecté");
        return;
      }
      phantom = window.solana;

      const resp = await phantom.connect();
      solPublicKey = resp.publicKey;
      document.getElementById("solAddr").textContent = solPublicKey.toBase58();
      document.getElementById("btnConnectPhantom").disabled = true;
      log("PHANTOM connecté " + solPublicKey.toBase58());
      refreshPhantomBalances();
    }catch(e){
      log("PHANTOM ERR " + e.message);
    }
  }

  async function refreshPhantomBalances(){
    if(!solPublicKey){
      log("PHANTOM: pas de wallet connecté");
      return;
    }
    try{
      const connection = new solanaWeb3.Connection(DRPC_RPC,"confirmed");

      // SOL
      const solLamports = await connection.getBalance(solPublicKey);
      const sol = solLamports / 1e9;
      document.getElementById("solBalance").textContent = sol.toFixed(4);

      // USDC Solana
      const mint = new solanaWeb3.PublicKey(USDC_SOL_MINT);
      const accs = await connection.getParsedTokenAccountsByOwner(
        solPublicKey,
        { mint }
      );
      let usdc = 0;
      if(accs.value.length>0){
        usdc = accs.value[0].account.data.parsed.info.tokenAmount.uiAmount || 0;
      }
      document.getElementById("usdcBalance").textContent = usdc.toFixed(2);

      log("PHANTOM ✓ soldes mis à jour");
    }catch(e){
      log("PHANTOM ERR " + e.message);
    }
  }

  // --------- BRIDGE SOL → POWCHAIN ----------
  function sendBridge(){
    if(!solPublicKey){
      alert("Connecte Phantom d'abord");
      return;
    }
    const amt = parseFloat(document.getElementById("bridgeAmount").value.replace(",",".")) || 0;
    if(amt<=0){
      alert("Montant SOL invalide");
      return;
    }
    // Ici on envoie juste une requête au serveur POWCHAIN.
    // Le serveur pourra vérifier off-chain et créditer POW / USDC POW.
    const payload = {
      type:"BRIDGE_REQUEST",
      fromSol: solPublicKey.toBase58(),
      amountSol: amt
    };
    sendWs(payload);
    log("BRIDGE_REQUEST envoyé SOL " + amt);
  }

  // --------- INIT ----------
  window.addEventListener("load",()=>{
    document.getElementById("backendStatus").textContent = "…";
    document.getElementById("wsStatus").textContent = "…";
    loadStats();
    setInterval(loadStats,10000);
    connectWs();
  });
</script>
</body>
</html>
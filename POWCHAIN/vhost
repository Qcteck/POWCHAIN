sudo nano /etc/nginx/sites-available/bbqfinance

server {
  listen 80;
  server_name bbqfinance.fun www.bbqfinance.fun;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name bbqfinance.fun www.bbqfinance.fun;

  ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  root /var/www/bbqfinance;
  index index.html;

  # Frontend
  location / {
    try_files $uri $uri/ /index.html;
  }

  # API vers Node (Express)
  location ~ ^/(stats|wallet|bridge|swap|stake|block)(/.*)?$ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # LP routes /lp/add etc.
  location ^~ /lp/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # WebSocket
  location /ws {
    proxy_pass http://127.0.0.1:3000/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 60s;
  }
}





sudo nano /etc/nginx/sites-available/bbqfinance



server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name bbqfinance.fun www.bbqfinance.fun;

    ssl_certificate     /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /root/powchain;
    index index.html;

    # Page principale : https://bbqfinance.fun
    location / {
        try_files $uri /index.html;
    }

    # API POWCHAIN vue par le dashboard : https://bbqfinance.fun/stats
    # Redirigée vers la vraie route Node : http://127.0.0.1:3000/powchain/stats
    location = /stats {
        proxy_pass http://127.0.0.1:3000/powchain/stats;
    }

    # WebSocket POWCHAIN : wss://bbqfinance.fun/ws
    location /ws {
        proxy_pass http://127.0.0.1:7001/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }
}
// ---- BASE58 ----
function b58enc(bytes){
  let d=[0];
  for(let i=0;i<bytes.length;i++){
    let c=bytes[i];
    for(let j=0;j<d.length;j++){
      let x=d[j]*256+c;
      d[j]=x%58;
      c=(x/58)|0;
    }
    while(c>0){d.push(c%58);c=(c/58)|0;}
  }
  let r="";
  for(let k=d.length-1;k>=0;k--)r+=ALPH[d[k]];
  return r;
}
function b58dec(str){
  let b=[0];
  for(let i=0;i<str.length;i++){
    let c=ALPH.indexOf(str[i]);
    for(let j=0;j<b.length;j++){
      let x=b[j]*58+c;
      b[j]=x&255;
      c=x>>8;
    }
    while(c>0){b.push(c&255);c>>=8;}
  }
  return new Uint8Array(b.reverse());
}

// ---- QR pseudo ----
function drawQR(text){
  const cv=q("#qr"); if(!cv)return;
  const ctx=cv.getContext("2d");
  const s=cv.width;
  ctx.fillStyle=getComputedStyle(document.body).getPropertyValue("--bg-soft")||"#050008";
  ctx.fillRect(0,0,s,s);
  if(!text){
    ctx.strokeStyle="#ffcf5c55";
    ctx.strokeRect(8,8,s-16,s-16);
    return;
  }
  const accent = getComputedStyle(document.body).getPropertyValue("--accent").trim()||"#ffcf5c";
  ctx.fillStyle=accent;
  const hash=[...text].reduce((a,c)=>(a*31+c.charCodeAt(0))>>>0,1);
  const size=25; const cell=s/size;
  let rnd=hash;
  for(let y=0;y<size;y++){
    for(let x=0;x<size;x++){
      rnd=(rnd*1103515245+12345)>>>0;
      if(rnd&0x80000000){
        ctx.fillRect(x*cell+1,y*cell+1,cell-2,cell-2);
      }
    }
  }
  ctx.strokeStyle=accent;
  ctx.lineWidth=2;
  ctx.strokeRect(3,3,s-6,s-6);
}
drawQR("");


// ----------- WebSocket Live ----------
function connectWS(){
  sock=new WebSocket(WS);
  sock.onopen = ()=>log("WS connecté");
  sock.onclose=()=>{
    log("WS fermé, reconnexion…");
    setTimeout(connectWS,2000);
  };
  sock.onerror=e=>log("WS erreur");
  sock.onmessage=e=>{
    try{
      const m=JSON.parse(e.data);
      q("#mempoolLive").textContent = 
        JSON.stringify(m,null,2)+"\n"+q("#mempoolLive").textContent;
    }catch(err){}
  };
}

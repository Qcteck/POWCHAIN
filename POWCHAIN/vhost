mall class="hint">Option 1 : le bouton Phantom envoie le SOL vers la trésorerie et déclare automatiquement le bridge.<br/>Option 2 : tu envoies le SOL manuellement dans Phantom, tu colles la signature, puis tu déclares le bridge.</small></div></div><div class="section" id="dex"><div class="card"><div class="lineTitle">Swap DEX interne</div><label>Montant</label><input id="swapAmt" placeholder="10"/><label>Direction</label><select id="swapDir"><option value="pow2usdc">POW ➜ USDC POW</option><option value="usdc2pow">USDC POW ➜ POW</option></select><button id="btnSwap">Swap</button><div class="row2"><div><label>LP POW</label><input id="lpPow" readonly/></div><div><label>LP USDC</label><input id="lpUsdc" readonly/></div></div></div><div class="card"><div class="lineTitle">Ajouter Liquidité (LP)</div><label>POW</label><input id="lpAddPow"/><label>USDC POW</label><input id="lpAddUsdc"/><button id="btnLPAdd">Ajouter LP</button><small class="hint">Le backend peut émettre un NFT “Whale Badge” pour les gros apporteurs de LP.</small></div></div><div class="section" id="stake"><div class="card"><div class="lineTitle">Staking POW</div><label>Montant POW à staker</label><input id="stakeAmt"/><button id="btnStake">Stake</button><label>Montant staké (vue backend)</label><input id="stakeView" readonly/><label>Récompenses estimées (placeholder)</label><input id="stakeRewards" readonly value="-"/></div></div><div class="section" id="explorer"><div class="card"><div class="lineTitle">Explorer de blocs POWCHAIN</div><label>Hauteur de bloc</label><input id="blockInp" placeholder="1"/><button id="btnBlock">Voir bloc</button><pre id="blockOut" style="margin-top:8px;font-size:11px;color:#ffe9a6"></pre></div></div><div class="section" id="mempool"><div class="card"><div class="lineTitle">Mempool — Transactions en direct</div><pre id="mempoolLive"></pre></div></div><div class="section" id="stats"><div class="card"><div class="lineTitle">Stats POWCHAIN</div><div class="row2"><div><label>Hauteur</label><input id="sHeight" readonly/></div><div><label>Wallets</label><input id="sWallets" readonly/></div><div><label>Mempool</label><input id="sMP" readonly/></div></div><div class="row2"><div><label>Total POW</label><input id="sPOW" readonly/></div><div><label>Total Staké</label><input id="sStaked" readonly/></div><div><label>LP POW</label><input id="sLPpow" readonly/></div><div><label>LP USDC</label><input id="sLPusdc" readonly/></div></div><div class="row2"><div><label>Treasury SOL (vue backend)</label><input id="sTSol" readonly/></div><div><label>Treasury USDC POW</label><input id="sTUsdc" readonly/></div><div><label>Treasury POW</label><input id="sTFire" readonly/></div></div><div style="margin-top:8px"><label>Graphique BTC/USDT (24h)</label><canvas id="priceChart"></canvas></div></div></div><div class="card"><div class="lineTitle">Console</div><div id="log"></div></div></div><div class="ticker"><span id="tickerBottomText">Chargement des prix…</span></div></main></div><script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script><script src="https://bundle.run/buffer@6.0.3"></script><script>window.Buffer=buffer.Buffer;</script><script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script><script>const API="https://bbqfinance.fun";const WS_URL="wss://bbqfinance.fun/ws";const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const DEC=1e6;const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";const STORAGE_KEY="fireinnersWallet";const q=s=>document.querySelector(s);const log=t=>{const b=q("#log");const line=`[${new Date().toLocaleTimeString()}] ${t}`;b.innerHTML=line+"<br>"+b.innerHTML;b.scrollTop=0};let solAddr=null;let powAddr=null;let powPriv=null;let powNonce=0;let sock=null;let lastStats=null;let marketPrices=null;let lastBridgeSig=null;function b58enc(bytes){let d=[0];for(let i=0;i<bytes.length;i++){let c=bytes[i];for(let j=0;j<d.length;j++){let x=d[j]*256+c;d[j]=x%58;c=(x/58)|0}while(c>0){d.push(c%58);c=(c/58)|0}}let r="";for(let k=d.length-1;k>=0;k--)r+=ALPH[d[k]];return r}function b58dec(str){let b=[0];for(let i=0;i<str.length;i++){let c=ALPH.indexOf(str[i]);for(let j=0;j<b.length;j++){let x=b[j]*58+c;b[j]=x&255;c=x>>8}while(c>0){b.push(c&255);c>>=8}}return new Uint8Array(b.reverse())}function drawQR(text){const cv=q("#qr");if(!cv)return;const ctx=cv.getContext("2d");const s=cv.width;ctx.fillStyle="#000";ctx.fillRect(0,0,s,s);ctx.fillStyle="#fff";ctx.fillRect(0,0,s,s);if(!text){ctx.strokeStyle="#f4b860";ctx.lineWidth=2;ctx.strokeRect(10,10,s-20,s-20);return}const size=29;const cell=s/size;ctx.fillStyle="#000";const drawFinder=(x,y)=>{ctx.fillRect(x*cell,y*cell,7*cell,7*cell);ctx.fillStyle="#fff";ctx.fillRect((x+1)*cell,(y+1)*cell,5*cell,5*cell);ctx.fillStyle="#000";ctx.fillRect((x+2)*cell,(y+2)*cell,3*cell,3*cell)};drawFinder(0,0);drawFinder(size-7,0);drawFinder(0,size-7);let hash=[...text].reduce((a,c)=>(a*31+c.charCodeAt(0))>>>0,1);for(let y=0;y<size;y++){for(let x=0;x<size;x++){const inFinder=(x<7&&y<7)||(x>=size-7&&y<7)||(x<7&&y>=size-7);if(inFinder)continue;hash=(hash*1103515245+12345)>>>0;if(hash&0x80000000)ctx.fillRect(x*cell,y*cell,cell,cell)}}}drawQR("");async function connectPhantom(){try{const p=window.solana;if(!p||!p.isPhantom){alert("Phantom non détecté");return}const resp=await p.connect();solAddr=resp.publicKey.toString();q("#solAddr").value=solAddr;log("Phantom connecté : "+solAddr);await loadSolBalances()}catch(e){log("Erreur Phantom : "+e.message)}}async function loadSolBalances(){if(!solAddr)return;try{const r=await fetch(SOL_RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]})});const j=await r.json();const lam=j.result&&typeof j.result.value==="number"?j.result.value:0;q("#solBal").value=(lam/1e9).toFixed(4);const r2=await fetch(SOL_RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getTokenAccountsByOwner",params:[solAddr,{mint:USDC_MINT},{encoding:"jsonParsed"}]})});const j2=await r2.json();let total=0;(j2.result&&j2.result.value||[]).forEach(a=>{const v=a.account&&a.account.data&&a.account.data.parsed&&a.account.data.parsed.info&&a.account.data.parsed.info.tokenAmount&&a.account.data.parsed.info.tokenAmount.uiAmount||0;total+=v});q("#usdcBal").value=total.toFixed(2)}catch(e){log("Bal ERR : "+e.message)}}q("#btnPhantom").onclick=connectPhantom;q("#btnSolRefresh").onclick=loadSolBalances;q("#btnGen").onclick=()=>{const kp=nacl.sign.keyPair();powAddr=b58enc(kp.publicKey);powPriv=b58enc(kp.secretKey);powNonce=0;q("#powAddr").value=powAddr;q("#powPriv").value=powPriv;drawQR(powAddr);localStorage.setItem(STORAGE_KEY,JSON.stringify({addr:powAddr,priv:powPriv}));log("Wallet POWCHAIN généré et sauvegardé localement")};async function loadPowWallet(){if(!powAddr||!powPriv){alert("Wallet POWCHAIN requis");return}try{const r=await fetch(`${API}/wallet/${powAddr}`);if(!r.ok)throw Error("HTTP "+r.status);const w=await r.json();powNonce=w.nonce||0;q("#powBal").value=(w.pow/DEC).toFixed(6);q("#powUSDCBal").value=(w.usdc/DEC).toFixed(6);q("#powStakeBal").value=(w.staked/DEC).toFixed(6);q("#powNonce").value=powNonce;log("Wallet POWCHAIN chargé")}catch(e){log("Load POW ERR : "+e.message)}}q("#btnReloadPow").onclick=loadPowWallet;function restoreWallet(){try{const raw=localStorage.getItem(STORAGE_KEY);if(!raw){log("Aucun wallet POWCHAIN sauvegardé");return}const d=JSON.parse(raw);if(!d.addr||!d.priv){log("Données wallet invalides");return}powAddr=d.addr;powPriv=d.priv;q("#powAddr").value=powAddr;q("#powPriv").value=powPriv;drawQR(powAddr);log("Wallet POWCHAIN rechargé");loadPowWallet()}catch(e){log("Restauration wallet ERR : "+e.message)}}q("#btnRestore").onclick=restoreWallet;window.addEventListener("load",()=>{if(localStorage.getItem(STORAGE_KEY))restoreWallet()});function signTxBase(payload){if(!powAddr||!powPriv){alert("Wallet POWCHAIN requis");return null}const msgObj={type:payload.type,from:powAddr,to:payload.to||null,amount:payload.amount||null,token:payload.token||null,dir:payload.dir||null,nonce:powNonce+1};const msg=new TextEncoder().encode(JSON.stringify(msgObj));const sk=b58dec(powPriv);const sig=nacl.sign.detached(msg,sk);return{tx:{...msgObj},sig:b58enc(sig)}}async function bridgeDeclare(){if(!powAddr){alert("Génère d'abord un wallet POWCHAIN");return}if(!solAddr){alert("Connecte Phantom avant de déclarer le bridge");return}const raw=q("#bridgeAmt").value.trim();const amt=parseFloat(raw);if(!raw||isNaN(amt)||amt<=0){log("Bridge erreur : Invalid sol amount");return}const sigInput=q("#bridgeSig").value.trim();const sig=sigInput||lastBridgeSig;if(!sig){log("Bridge backend erreur : Missing fromSol or txSig");return}try{const body={addr:powAddr,amount:amt,fromSol:solAddr,txSig:sig};const r=await fetch(`${API}/bridge`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});const j=await r.json().catch(()=>({}));if(!r.ok||j.ok===false){log("Bridge backend erreur : "+(j.error||("HTTP "+r.status)));return}log("Bridge déclaré au backend pour "+amt+" SOL");loadPowWallet()}catch(e){log("Bridge erreur : "+e.message)}}q("#btnBridgeDeclare").onclick=bridgeDeclare;async function bridgeAuto(){if(!powAddr){alert("Génère d'abord un wallet POWCHAIN");return}const p=window.solana;if(!p||!p.isPhantom){alert("Phantom non détecté");return}if(!solAddr){await connectPhantom();if(!solAddr)return}const raw=q("#bridgeAmt").value.trim();const amt=parseFloat(raw);if(!raw||isNaN(amt)||amt<=0){log("Bridge Phantom erreur : Invalid sol amount");return}try{const conn=new solanaWeb3.Connection(SOL_RPC,"confirmed");const from=new solanaWeb3.PublicKey(solAddr);const to=new solanaWeb3.PublicKey("BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy");const ix=solanaWeb3.SystemProgram.transfer({fromPubkey:from,toPubkey:to,lamports:Math.floor(amt*1e9)});let tx=new solanaWeb3.Transaction().add(ix);tx.feePayer=from;tx.recentBlockhash=(await conn.getLatestBlockhash()).blockhash;log("Bridge Phantom : ouverture de la fenêtre de signature…");const sig=await p.signAndSendTransaction(tx);const signature=sig.signature||sig;lastBridgeSig=typeof signature==="string"?signature:signature.toString();q("#bridgeSig").value=lastBridgeSig;log("Bridge Phantom : TX envoyée "+lastBridgeSig);await bridgeDeclare()}catch(e){log("Bridge Phantom erreur : "+e.message)}}q("#btnBridgeAuto").onclick=bridgeAuto;q("#btnSwap").onclick=()=>{if(!powAddr){alert("Wallet POWCHAIN requis");return}const a=parseFloat(q("#swapAmt").value||"0");if(!(a>0)){log("Swap : montant invalide");return}const dir=q("#swapDir").value;const base=signTxBase({type:"SWAP",amount:Math.floor(a*DEC),token:null,dir});if(!base)return;const tx={type:"SWAP",from:powAddr,dir,amount:Math.floor(a*DEC),nonce:base.tx.nonce,sig:base.sig};sock&&sock.readyState===WebSocket.OPEN&&sock.send(JSON.stringify(tx));powNonce++;q("#powNonce").value=powNonce;log("Swap TX envoyée ("+dir+")")};q("#btnLPAdd").onclick=()=>{if(!powAddr){alert("Wallet POWCHAIN requis");return}const p=parseFloat(q("#lpAddPow").value||"0");const u=parseFloat(q("#lpAddUsdc").value||"0");if(!(p>0&&u>0)){log("LP_ADD : montants invalides");return}const base=signTxBase({type:"LP_ADD",amount:null});if(!base)return;const tx={type:"LP_ADD",from:powAddr,pow:Math.floor(p*DEC),usdc:Math.floor(u*DEC),nonce:base.tx.nonce,sig:base.sig};sock&&sock.readyState===WebSocket.OPEN&&sock.send(JSON.stringify(tx));powNonce++;q("#powNonce").value=powNonce;log("LP_ADD envoyé")};q("#btnStake").onclick=()=>{if(!powAddr){alert("Wallet POWCHAIN requis");return}const a=parseFloat(q("#stakeAmt").value||"0");if(!(a>0)){log("Stake : montant invalide");return}const base=signTxBase({type:"STAKE",amount:Math.floor(a*DEC)});if(!base)return;const tx={type:"STAKE",from:powAddr,amount:Math.floor(a*DEC),nonce:base.tx.nonce,sig:base.sig};sock&&sock.readyState===WebSocket.OPEN&&sock.send(JSON.stringify(tx));powNonce++;q("#powNonce").value=powNonce;log("STAKE envoyé")};q("#btnBlock").onclick=async()=>{const h=parseInt(q("#blockInp").value||"0");if(!(h>0))return;try{const r=await fetch(`${API}/block/${h}`);const b=await r.json();q("#blockOut").textContent=JSON.stringify(b,null,2)}catch(e){q("#blockOut").textContent="Erreur : "+e.message}};async function refreshStats(){try{const r=await fetch(`${API}/stats`);const s=await r.json();lastStats=s;q("#sHeight").value=s.height;q("#sWallets").value=s.wallets;q("#sPOW").value=s.totalPow;q("#sStaked").value=s.totalStaked;q("#sMP").value=s.mempool;q("#sLPpow").value=s.lpPow;q("#sLPusdc").value=s.lpUsdc;q("#sTSol").value=s.solTreasury;q("#sTUsdc").value=s.usdcTreasury;q("#sTFire").value=s.fireTreasury;q("#lpPow").value=s.lpPow;q("#lpUsdc").value=s.lpUsdc;updateTickers();}catch(e){log("Stats ERR : "+e.message)}}setInterval(refreshStats,5000);refreshStats();function connectWS(){try{sock&&sock.close();sock=new WebSocket(WS_URL);sock.onopen=()=>{q("#syncState").textContent="WS: online";q("#syncState").style.borderColor="#5bffbf";q("#syncState").style.color="#dfffee";log("WS connecté")};sock.onclose=()=>{q("#syncState").textContent="WS: offline";q("#syncState").style.borderColor="#ff9a2f";q("#syncState").style.color="#ffe2b0";log("WS fermé, reconnexion dans 3s...");setTimeout(connectWS,3000)};sock.onerror=e=>log("WS erreur "+(e&&e.message||""));sock.onmessage=e=>{try{const m=JSON.parse(e.data);if(m.type==="mempool"){q("#mempoolLive").textContent=JSON.stringify(m.mempool,null,2)}else if(m.type==="clients"){log("WS clients connectés : "+m.count)}else if(m.type==="new_block"){log("Nouveau bloc #"+m.block.height)}}catch(err){}}}catch(e){log("WS fatal : "+e.message)}}connectWS();document.querySelectorAll(".navitem").forEach(a=>{a.onclick=()=>{document.querySelectorAll(".navitem").forEach(x=>x.classList.remove("active"));a.classList.add("active");const tab=a.dataset.tab;document.querySelec
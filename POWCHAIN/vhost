      })
    });
    r2=await r2.json();
    let tot=0;
    (r2.result.value||[]).forEach(a=> tot+=a.account.data.parsed.info.tokenAmount.uiAmount );
    usdcBal.value=tot.toFixed(2);
  }catch{}
}

// ============ BRIDGE PHANTOM ============
document.getElementById("btnBridge").onclick=async()=>{

</head>
<body>
<div id="wrap">
<h1>FIREINNERS Network <span class="badge">Mainnet Bridge</span></h1>

<h2>Wallet FIREINNERS</h2>
<div class="row">
  <button id="btnGen">Générer Wallet FIREINNERS</button>
  <button id="btnLoad">Charger Wallet FIREINNERS</button>
</div>
<div class="row">
  <input id="addrInput" placeholder="Adresse FIREINNERS (base58)"/>
</div>
<p id="addrView">Aucun wallet FIREINNERS chargé</p>

<h2>Solana / Phantom</h2>
<div class="row">
  <button id="btnPhantom">Connecter Phantom</button>
  <button id="btnBridge">Bridge SOL → FIREINNERS</button>
</div>
<p id="solInfo">Wallet Solana : —</p>

<h2>Soldes FIREINNERS</h2>
<p id="balView">FIRE : 0 | USDC : 0</p>
<p id="supply">Supply circulante : 0 | Supply disponible : 0</p>

<h2>Etat réseau</h2>
<p>
  API <span id="apiState"></span> |
  WS <span id="wsState"></span>
</p>

<h2>Logs</h2>
<div id="log"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bs58@5.0.0/index.min.js"></script>
<script>
const API = location.origin;
const RPC_URL = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const TREASURY_SOL = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";
const LAMPORTS_PER_SOL = 1_000_000_000;

// -------- LOG UI --------
function log(msg){
  const box=document.getElementById("log");
  box.textContent += "["+new Date().toLocaleTimeString()+"] "+msg+"\n";
  box.scrollTop = box.scrollHeight;
}

// -------- WALLET FIREINNERS --------
let fireAddr = null;
let firePriv = null;

function updateAddrView(){
  document.getElementById("addrView").textContent = fireAddr
    ? "Wallet FIREINNERS : "+fireAddr
    : "Aucun wallet FIREINNERS chargé";
}

// génération locale (clé Ed25519, adresse = pubkey base58)
document.getElementById("btnGen").onclick = () => {
  try{
    const kp = nacl.sign.keyPair();
    fireAddr = bs58.default.encode(kp.publicKey);
    firePriv = bs58.default.encode(kp.secretKey);
    document.getElementById("addrInput").value = fireAddr;
    updateAddrView();
    log("Nouveau wallet FIREINNERS généré");
    refreshWallet();
  }catch(e){
    log("Erreur génération wallet: "+e.message);
  }
};

document.getElementById("btnLoad").onclick = () => {
  const a = document.getElementById("addrInput").value.trim();
  if(!a){ alert("Entre une adresse FIREINNERS"); return; }
  fireAddr = a;
  updateAddrView();
  refreshWallet();
};

// lecture côté backend
async function refreshWallet(){
  if(!fireAddr) return;
  try{
    const r = await fetch(API+"/wallet/"+encodeURIComponent(fireAddr));
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j = await r.json();
    document.getElementById("balView").textContent =
      "FIRE : "+(j.fire/1e6).toFixed(6)+" | USDC : "+(j.usdc/1e6).toFixed(6);
    document.getElementById("supply").textContent =
      "Supply circulante : "+(j.supplyCirculante/1e6).toFixed(2)+
      " | Supply disponible : "+(j.supplyDisponible/1e6).toFixed(2);
    log("Wallet FIREINNERS refresh OK");
  }catch(e){
    log("Erreur refresh wallet: "+e.message);
  }
}
setInterval(refreshWallet,5000);

// -------- PHANTOM / SOLANA --------
let phantom = null;
let solPubkey = null;

document.getElementById("btnPhantom").onclick = async () => {
  try{
    if(!window.phantom || !window.phantom.solana){
      alert("Phantom non détecté");
      return;
    }
    phantom = window.phantom.solana;
    const c = await phantom.connect();
    solPubkey = c.publicKey.toString();
    document.getElementById("solInfo").textContent = "Wallet Solana : "+solPubkey;
    log("Phantom connecté : "+solPubkey);
  }catch(e){
    log("Erreur connexion Phantom: "+e.message);
  }
};

document.getElementById("btnBridge").onclick = async () => {
  try{
    if(!phantom || !solPubkey){
      alert("Connecte Phantom d'abord");
      return;
    }
    if(!fireAddr){
      alert("Génère ou charge un wallet FIREINNERS avant de bridger");
      return;
    }
    const amountStr = prompt("Combien de SOL veux-tu envoyer vers FIREINNERS ?");
    if(!amountStr) return;
    const solAmount = Number(amountStr);
    if(!Number.isFinite(solAmount) || solAmount <= 0){
      alert("Montant invalide");
      return;
    }
    const lamports = Math.round(solAmount * LAMPORTS_PER_SOL);

    const { Connection, PublicKey, SystemProgram, Transaction } = solanaWeb3;
    const conn = new Connection(RPC_URL, "confirmed");
    const from = new PublicKey(solPubkey);
    const to = new PublicKey(TREASURY_SOL);

    const { blockhash } = await conn.getLatestBlockhash("finalized");
    const tx = new Transaction({ feePayer: from, recentBlockhash: blockhash });
    tx.add(SystemProgram.transfer({
      fromPubkey: from,
      toPubkey: to,
      lamports
    }));

    log("Signature de la transaction Solana en cours…");
    const signed = await phantom.signAndSendTransaction(tx);
    const txSig = signed.signature;
    log("Tx envoyée sur Solana : "+txSig);

    // on informe maintenant le backend FIREINNERS avec txSig
    log("Envoi au bridge FIREINNERS pour vérification on-chain…");
    const r = await fetch(API+"/bridge",{
      method:"POST",
      headers:{ "Content-Type":"application/json" },
      body:JSON.stringify({ addr: fireAddr, txSig })
    });
    const j = await r.json();
    if(!j.ok){
      log("Bridge FAIL: "+j.error);
      alert("Bridge échoué: "+j.error);
      return;
    }
    log("Bridge OK: "+JSON.stringify(j.bridge));
    refreshWallet();
  }catch(e){
    log("Erreur bridge: "+e.message);
  }
};

// -------- INDICATEURS API / WS --------
function setApiState(ok){
  const el=document.getElementById("apiState");
  el.classList.remove("green","red");
  el.classList.add(ok?"green":"red");
}

async function pingApi(){
  try{
    const r = await fetch(API+"/wallet/ping-test");
    if(!r.ok) throw new Error("HTTP "+r.status);
    setApiState(true);
  }catch(e){
    setApiState(false);
  }
}
setInterval(pingApi,4000);
pingApi();

// WebSocket
(function initWS(){
  const proto = location.protocol === "https:" ? "wss" : "ws";
  const ws = new WebSocket(proto + "://" + location.host + "/ws");
  const wsState = document.getElementById("wsState");
  ws.onopen = () => {
    wsState.classList.remove("red");
    wsState.classList.add("green");
    log("WS connecté");
  };
  ws.onclose = () => {
    wsState.classList.remove("green");
    wsState.classList.add("red");
    log("WS fermé");
    setTimeout(initWS,3000);
  };
  ws.onerror = () => {
    wsState.classList.remove("green");
    wsState.classList.add("red");
    log("WS erreur");
  };
  ws.onmessage = ev => {
    log("WS → "+ev.data);
  };
})();
</script>
</body>
</html>






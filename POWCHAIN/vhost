<script>
const AMC={
 level:0,
 methods:{},
 perf:{pnl:0,errors:0,latency:0},
 improvements:{short:[],mid:[],long:[]},
 history:JSON.parse(localStorage.getItem("AMC_V2")||"[]"),

 event(e){
  this.level++;
  this.perf.pnl+=e.pnl||0;
  this.perf.errors+=e.error?1:0;
  if(e.method)this.methods[e.method]=(this.methods[e.method]||0)+1;
  this.classify(e);
  this.log(e);
  this.save();
 },

 classify(e){
  if(["QuickWins","5S","Pareto","Daily"].includes(e.method))
   this.improvements.short.push(e);
  else if(["Lean","Kaizen","PDCA","TOC","Agile","OKR"].includes(e.method))
   this.improvements.mid.push(e);
  else
   this.improvements.long.push(e);
 },

 log(e){
  const c=document.getElementById("console");
  c.textContent+=`[${new Date().toLocaleTimeString()}] ${e.method||"EVENT"} pnl:${e.pnl||0}\n`;
  c.scrollTop=1e9;
 },

 save(){
  this.history.push({t:Date.now(),lvl:this.level,p:this.perf});
  localStorage.setItem("AMC_V2",JSON.stringify(this.history.slice(-500)));
 },

 export(){
  const a=document.createElement("a");

            <button id="btnSwap">Swap</button>
          </div>

          <div class="card">
            <h2>Ajouter Liquidité (LP)</h2>
            <label>POW</label>
            <input id="lpAddPow">
            <label>USDC POW</label>
            <input id="lpAddUsdc">
            <button id="btnLPAdd">Ajouter LP</button>
            <p style="color:#ffce54;font-size:12px">
              LP génère un NFT “Whale Badge” automatiquement (logique côté backend).
            </p>
          </div>
        </div>

        <!-- STAKING -->
        <div class="section" id="stake">
          <div class="card">
            <h2>Staking POW → Récompenses</h2>
            <label>Montant POW</label>
            <input id="stakeAmt">
            <button id="btnStake">Stake</button>
            <button id="btnUnstake">Unstake</button>
          </div>
        </div>

        <!-- EXPLORER -->
        <div class="section" id="explorer">
          <div class="card">
            <h2>Explorer de blocs POWCHAIN</h2>
            <button id="btnBlocks">Voir 20 derniers blocs</button>
            <pre id="blockOut" style="margin-top:10px;font-size:11px;color:#ffe9a6;max-height:260px;overflow:auto"></pre>
          </div>
        </div>

        <!-- MEMPOOL -->
        <div class="section" id="mempool">
          <div class="card">
            <h2>Mempool — Transactions en direct</h2>
            <pre id="mempoolLive" style="height:220px;overflow:auto;font-size:11px;color:#ffda7f"></pre>
          </div>
        </div>

        <!-- STATS -->
        <div class="section" id="stats">
          <div class="card">
            <h2>Stats POWCHAIN</h2>
            <label>Hauteur</label><input id="sHeight" readonly>
            <label>Wallets</label><input id="sWallets" readonly>
            <label>Total POW</label><input id="sPOW" readonly>
            <label>Total Staké</label><input id="sStaked" readonly>
            <label>Mempool</label><input id="sMP" readonly>
            <label>LP POW</label><input id="sLPpow" readonly>

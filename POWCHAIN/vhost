  <!-- Ligne 3 : LP + Explorer + WebHash + Scan -->
  <div class="row">
    <div class="card">
      <div class="tag">LP Add</div>
      <div class="row">
        <input id="lpPOW" placeholder="POW"/>
        <input id="lpUSDC" placeholder="USDC POW"/>

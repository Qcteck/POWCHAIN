set -euo pipefail
HOST="sentinel.fireinners.online"
PORT="9696"
APP_DIR="/root/fireinners-security-sentinel"
echo "=== PREFLIGHT ==="
echo "[SYSTEM]";uname -a||true;lsb_release -a 2>/dev/null||true;date||true
echo;echo "[DNS] $HOST";getent hosts "$HOST"||echo "DNS_FAIL"
echo;echo "[PORTS] (80/443/nginx + $PORT)";sudo ss -lntp | egrep "(:80\b|:443\b|:${PORT}\b|nginx)" || true
echo;echo "[NGINX]";sudo systemctl is-active nginx && echo "nginx:active" || echo "nginx:inactive";sudo nginx -t||true
echo;echo "[UFW]";sudo ufw status||true
echo;echo "[CERT]";command -v certbot >/dev/null 2>&1 && certbot --version || echo "certbot absent";sudo test -d "/etc/letsencrypt/live/$HOST" && echo "cert:present" || echo "cert:absent"
echo;echo "[APP]";if [ -d "$APP_DIR" ]; then echo "app:present";ls -la "$APP_DIR" | sed -n '1,80p';else echo "app:absent";fi
echo;echo "[LOCAL HTTP]";curl -sS --max-time 2 "http://127.0.0.1:${PORT}/public/state" >/dev/null && echo "local:OK" || echo "local:FAIL"
DNS_OK=0;APP_OK=0;LOCAL_OK=0
getent hosts "$HOST" >/dev/null 2>&1 && DNS_OK=1 || true
[ -d "$APP_DIR" ] && APP_OK=1 || true
curl -sS --max-time 2 "http://127.0.0.1:${PORT}/public/state" >/dev/null 2>&1 && LOCAL_OK=1 || true
echo;echo "[DECISION] DNS_OK=$DNS_OK APP_OK=$APP_OK LOCAL_OK=$LOCAL_OK"
if [ "$DNS_OK" -eq 1 ] && [ "$APP_OK" -eq 1 ] && [ "$LOCAL_OK" -eq 1 ]; then echo "GO"; else echo "NO-GO"; fi
echo "=== END ===" 
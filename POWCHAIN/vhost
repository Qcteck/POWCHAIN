__attribute__((used))
const unsigned char QPLUS_PUBKEY[32]={0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00};

float rho=0.5f,entropy=0.5f,coherence=0.5f,riskPenalty=0.0f;

static float clamp01(float v){if(v<0.0f)return 0.0f; if(v>1.0f)return 1.0f; return v;}
static int isfinitef(float x){return __builtin_isfinite(x);}

static float entropy_fast(float p){
  // approximation simple, stable, sans log:
  // pic vers p=0.5, 0 aux bords. (parabole normalisée)
  // S ~ 4p(1-p) dans [0..1]
  if(p<=0.0f||p>=1.0f) return 0.0f;
  float s=4.0f*p*(1.0f-p);
  return clamp01(s);
}

int step(float score,float risk,int arm){
  if(arm!=0 && arm!=1) return -4;
  if(!arm) return -1;
  if(!isfinitef(score)) return -2;
  if(!isfinitef(risk)) return -3;

  score=clamp01(score);
  risk=clamp01(risk);

  rho=clamp01(rho*0.7f+score*0.3f);
  entropy=entropy_fast(rho);
  coherence=clamp01(1.0f-entropy);
  riskPenalty=risk;
  return 0;
}

float get_rho(){return rho;}
float get_entropy(){return entropy;}
float get_coherence(){return coherence;}
float get_risk(){return riskPenalty;}
EOF




clang --target=wasm32 -O3 -nostdlib -Wl,--no-entry -Wl,--export-all -o qplus.wasm qplus.c



<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script>
const API="https://bbqfinance.fun";
const WS="wss://bbqfinance.fun/ws";
const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const q=s=>document.querySelector(s);
const log=t=>{const b=q("#log");if(!b)return;const l=`[${new Date().toLocaleTimeString()}] ${t}`;b.innerHTML=`${l}\n`+b.innerHTML;};
const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function b58enc(bytes){let d=[0];for(let i=0;i<bytes.length;i++){let c=bytes[i];for(let j=0;j<d.length;j++){let x=d[j]*256+c;d[j]=x%58;c=(x/58)|0;}while(c>0){d.push(c%58);c=(c/58)|0;}}let r="";for(let k=d.length-1;k>=0;k--)r+=ALPH[d[k]];return r;}
function b58dec(str){let b=[0];for(let i=0;i<str.length;i++){let c=ALPH.indexOf(str[i]);for(let j=0;j<b.length;j++){let x=b[j]*58+c;b[j]=x&255;c=x>>8;}while(c>0){b.push(c&255);c>>=8;}}return new Uint8Array(b.reverse());}
function drawQR(text){const c=q("#powQR");if(!c)return;const ctx=c.getContext("2d");ctx.fillStyle="#000";ctx.fillRect(0,0,c.width,c.height);if(!text)return;const size=25;const cell=c.width/size;let h=0;for(let i=0;i<text.length;i++)h=(h*31+text.charCodeAt(i))>>>0;for(let y=0;y<size;y++){for(let x=0;x<size;x++){h=(h*1664525+1013904223)>>>0;if(h&1){ctx.fillStyle="#ffd54a";ctx.fillRect(x*cell+1,y*cell+1,cell-2,cell-2);}}}}
let solAddr=null;let powAddr=null;let powPriv=null;let powNonce=0;let sock=null;const DEC=1e6;
function setWSState(s){const el=q("#syncState");if(el)el.textContent=s;}
async function connectPhantom(){try{const p=window.solana;if(!p){alert("Phantom non détecté");return;}const resp=await p.connect();solAddr=resp.publicKey.toString();q("#solAddr").value=solAddr;log("Phantom connecté : "+solAddr);await loadSolBalances();}catch(e){log("Erreur Phantom : "+e.message);}}
q("#btnPhantom").onclick=connectPhantom;
async function loadSolBalances(){if(!solAddr)return;try{const r=await fetch(RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]})});const j=await r.json();const lam=(j.result&&j.result.value)||0;q("#solBal").value=(lam/1e9).toFixed(4);const r2=await fetch(RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:2,method:"getTokenAccountsByOwner",params:[solAddr,{mint:USDC_MINT},{encoding:"jsonParsed"}]})});const j2=await r2.json();let bal=0;const arr=(j2.result&&j2.result.value)||[];for(const it of arr){const info=it.account&&it.account.data&&it.account.data.parsed&&it.account.data.parsed.info;const ta=info&&info.tokenAmount;const ui=(ta&&ta.uiAmount)||0;bal+=ui;}q("#usdcBal").value=bal.toFixed(2);}catch(e){log("Bal ERR : "+e.message);}}
q("#btnGen").onclick=()=>{const kp=nacl.sign.keyPair();powAddr=b58enc(kp.publicKey);powPriv=b58enc(kp.secretKey);powNonce=0;q("#powAddr").value=powAddr;q("#powPriv").value=powPriv;drawQR(powAddr);log("Wallet POWCHAIN généré");};
async function loadPowWallet(){if(!powAddr||!powPriv){alert("Wallet POWCHAIN requis");return;}try{const r=await fetch(`${API}/wallet/${powAddr}`);if(!r.ok)throw Error("HTTP "+r.status);const w=await r.json();powNonce=w.nonce||0;q("#powBal").value=((w.pow||0)/DEC).toFixed(6);q("#powUSDCBal").value=((w.usdc||0)/DEC).toFixed(6);q("#powStakeBal").value=((w.staked||0)/DEC).toFixed(6);q("#powNonce").value=powNonce;log("Wallet POWCHAIN chargé");}catch(e){log("Load POW ERR : "+e.message);}}
q("#btnReloadPow").onclick=loadPowWallet;
function signTx(o){const payload={type:o.type,from:powAddr,to:o.to||null,amount:o.amount||null,token:o.token||null,nonce:powNonce+1};const msg=new TextEncoder().encode(JSON.stringify(payload));const sk=b58dec(powPriv);const sig=nacl.sign.detached(msg,sk);return b58enc(sig);}
q("#btnBridge").onclick=async()=>{if(!powAddr){alert("Génère d'abord un wallet POWCHAIN");return;}let amt=parseFloat(q("#bridgeAmt").value||"0");if(!(amt>0)){alert("Montant invalide");return;}try{const r=await fetch(`${API}/bridge`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,amount:amt})});let j=null;try{j=await r.json();}catch(_){}if(!r.ok|| (j&&j.ok===false)){log("Bridge erreur: "+(j&&j.error?j.error:("HTTP "+r.status)));}else{log("Bridge déclaré pour "+amt+" SOL");loadPowWallet();}}catch(e){log("Bridge ERR : "+e.message);}};
q("#btnSwap").onclick=()=>{if(!powAddr){alert("Wallet POWCHAIN requis");return;}let amt=parseFloat(q("#swapAmt").value||"0");if(!(amt>0))return;const tx={type:"SWAP",amount:Math.floor(amt*DEC),token:q("#swapDir").value,from:powAddr,nonce:powNonce+1};tx.sig=signTx(tx);if(sock&&sock.readyState===WebSocket.OPEN){sock.send(JSON.stringify(tx));powNonce++;log("Swap TX envoyée");}else{log("Swap impossible: WS fermé");}};
q("#btnLPAdd").onclick=()=>{if(!powAddr){alert("Wallet POWCHAIN requis");return;}let p=parseFloat(q("#lpAddPow").value||"0");let u=parseFloat(q("#lpAddUsdc").value||"0");if(!(p>0&&u>0))return;const tx={type:"LP_ADD",pow:Math.floor(p*DEC),usdc:Math.floor(u*DEC),from:powAddr,nonce:powNonce+1};tx.sig=signTx(tx);if(sock&&sock.readyState===WebSocket.OPEN){sock.send(JSON.stringify(tx));powNonce++;log("LP_ADD envoyé");}else{log("LP_ADD impossible: WS fermé");}};
q("#btnStake").onclick=()=>{if(!powAddr){alert("Wallet POWCHAIN requis");return;}let a=parseFloat(q("#stakeAmt").value||"0");if(!(a>0))return;const tx={type:"STAKE",amount:Math.floor(a*DEC),from:powAddr,nonce:powNonce+1};tx.sig=signTx(tx);if(sock&&sock.readyState===WebSocket.OPEN){sock.send(JSON.stringify(tx));powNonce++;log("STAKE envoyé");}else{log("STAKE impossible: WS fermé");}};
q("#btnBlock").onclick=async()=>{let h=parseInt(q("#blockInp").value||"0");if(!(h>0))return;try{const r=await fetch(`${API}/block/${h}`);const b=await r.json();q("#blockOut").textContent=JSON.stringify(b,null,2);}catch(e){q("#blockOut").textContent="Erreur : "+e.message;}};
async function refreshStats(){try{const r=await fetch(`${API}/stats`);const s=await r.json();q("#sHeight").value=s.height;q("#sWallets").value=s.wallets;q("#sPOW").value=s.totalPow;q("#sStaked").value=s.totalStaked;q("#sMP").value=s.mempool;q("#sLPpow").value=s.lpPow;q("#sLPusdc").value=s.lpUsdc;q("#lpPow").value=s.lpPow;q("#lpUsdc").value=s.lpUsdc;}catch(e){log("/stats ERR : "+e.message);}}
setInterval(refreshStats,4000);refreshStats();
function connectWS(){try{sock=new WebSocket(WS);sock.onopen=()=>{setWSState("WS: online");log("WS connecté");};sock.onclose=()=>{setWSState("WS: offline");log("WS fermé, reconnexion dans 3s...");setTimeout(connectWS,3000);};sock.onerror=e=>{log("WS erreur "+(e.message||""));};sock.onmessage=e=>{try{const m=JSON.parse(e.data);if(m.type==="mempool"){q("#mempoolLive").textContent=JSON.stringify(m.mempool,null,2);} }catch(_){}};}catch(e){log("WS init ERR : "+e.message);}}
connectWS();
document.querySelectorAll(".navitem").forEach(a=>{a.onclick=()=>{document.querySelectorAll(".navitem").forEach(x=>x.classList.remove("active"));a.classList.add("active");const t=a.dataset.tab;document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));const sec=q("#"+t);if(sec)sec.classList.add("active");};});
</script>
</body>

const express=require("express");
const body=require("body-parser");
const fs=require("fs");
const http=require("http");
const WebSocket=require("ws");

const PORT=3000;
const WSPORT=7001;
const DEC=1e6;

let chain=[];
let wallets={};
let lpPow=0,lpUsdc=0;
let treasuryUsdc=0,treasurySol=0;

function load(){
 try{
  if(fs.existsSync("state.json")){
   const d=JSON.parse(fs.readFileSync("state.json","utf8"));
   chain=d.chain||[];
   wallets=d.wallets||{};
   lpPow=d.lpPow||0;
   lpUsdc=d.lpUsdc||0;
   treasuryUsdc=d.treasuryUsdc||0;
   treasurySol=d.treasurySol||0;
  }
 }catch(e){console.log("Load error",e)}
}
function save(){
 fs.writeFileSync("state.json",JSON.stringify({
  chain,wallets,lpPow,lpUsdc,treasuryUsdc,treasurySol
 }));
}

load();

function ensureWallet(a){
 if(!wallets[a])wallets[a]={pow:0,usdc:0,staked:0,nonce:0,pub:a};
}

const app=express();
app.use(body.json());

app.get("/stats",(req,res)=>{
 res.json({
  height:chain.length,
  lpPow,lpUsdc,
  treasuryUsdc,treasurySol
 });
});

app.get("/wallet/:addr",(req,res)=>{
 const a=req.params.addr;
 ensureWallet(a);
 res.json(wallets[a]);
});

app.get("/block/:h",(req,res)=>{
 const h=parseInt(req.params.h);
 if(Number.isNaN(h)||h<0||h>=chain.length)return res.status(404).json({error:"notfound"});
 res.json(chain[h]);
});

app.post("/tx",(req,res)=>{
 res.json({ok:true});
});

const server=http.createServer(app);
const wss=new WebSocket.Server({server,port:WSPORT});

wss.on("connection",ws=>{
 ws.on("message",msg=>{
  try{
   const tx=JSON.parse(msg.toString());
   applyTx(tx);
  }catch(e){}
 });
});

function applyTx(tx){
 const {type,from,to,amount,pow,usdc,token}=tx;
 if(!from)return;
 ensureWallet(from);
 wallets[from].nonce=(wallets[from].nonce||0)+1;

 if(type==="TX_POW"&&to){
  ensureWallet(to);
  if(wallets[from].pow>=amount){
   wallets[from].pow-=amount;
   wallets[to].pow=(wallets[to].pow||0)+amount;
  }
 }

 if(type==="STAKE"){
  if(wallets[from].pow>=amount){
   wallets[from].pow-=amount;
   wallets[from].staked=(wallets[from].staked||0)+amount;
  }
 }

 if(type==="SWAP"){
  if(token==="pow2usdc"&&lpPow>0&&lpUsdc>0){
   if(wallets[from].pow>=amount){
    const out=(amount*lpUsdc)/lpPow;
    wallets[from].pow-=amount;
    wallets[from].usdc=(wallets[from].usdc||0)+out;
    lpPow+=amount;
    lpUsdc-=out;
   }
  }
  if(token==="usdc2pow"&&lpPow>0&&lpUsdc>0){
   if(wallets[from].usdc>=amount){
    const out=(amount*lpPow)/lpUsdc;
    wallets[from].usdc-=amount;
    wallets[from].pow=(wallets[from].pow||0)+out;
    lpUsdc+=amount;
    lpPow-=out;
   }
  }
 }

 if(type==="LP_ADD"){
  if(wallets[from].pow>=pow && wallets[from].usdc>=usdc){
   wallets[from].pow-=pow;
   wallets[from].usdc-=usdc;
   lpPow+=pow;
   lpUsdc+=usdc;
  }
 }

 makeBlock([tx]);
 save();
}

function makeBlock(txs){
 const blk={
  height:chain.length,
  time:Date.now(),
  txs,
  hash:"H"+(Math.random()*1e17).toString(16)
 };
 chain.push(blk);
}


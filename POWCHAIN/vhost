// ====================== POWCHAIN SERVER.JS ==========================
const express = require("express");
const cors = require("cors");
const http = require("http");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");

const app = express();
app.use(express.json());
app.use(cors());

const server = http.createServer(app);
const wss = new WebSocket.Server({ server });

let chain = [];
let wallets = {};     // { pub -> { pow, usdc, staked, nonce } }
let lpPool = { pow: 0, usdc: 0 };
let mempool = [];
const rewardPerBlock = 10;
const TREASURY = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy"; // trésorerie

// ---- GENESIS ----
chain.push({
  index: 0,
  time: Date.now(),
  prevHash: "0".repeat(64),
  hash: "GENESIS",
  txs: [],
  treasuryPow: 0,
  treasuryUsdc: 0,
  lpPow: 0,
  lpUsdc: 0,
  reward: rewardPerBlock
});

// ---- Utils ----
const blockHash = obj =>
  require("crypto").createHash("sha256").update(JSON.stringify(obj)).digest("hex");

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  wss.clients.forEach(c => { if (c.readyState === WebSocket.OPEN) c.send(msg); });
}

function ensureWallet(pub) {
  if (!wallets[pub]) wallets[pub] = { pow: 0, usdc: 0, staked: 0, nonce: 0 };
}

// ---- New Block ----
function produceBlock() {
  const txs = mempool.splice(0, mempool.length);
  const prev = chain[chain.length - 1];
  const block = {
    index: prev.index + 1,
    time: Date.now(),
    prevHash: prev.hash,
    txs
  };

  let tPow = 0, tUsdc = 0, pPow = 0, pUsdc = 0;
  for (const tx of txs) {
    ensureWallet(tx.from);
    wallets[tx.from].nonce = tx.nonce;

    if (tx.type === "BRIDGE_MINT") {
      ensureWallet(tx.to);
      wallets[tx.to].pow += tx.amountNet;
      wallets[TREASURY].pow += tx.amountFee;
      tPow += tx.amountNet + tx.amountFee;
    }
  }

  block.treasuryPow = wallets[TREASURY]?.pow || 0;
  block.treasuryUsdc = wallets[TREASURY]?.usdc || 0;
  block.lpPow = lpPool.pow;
  block.lpUsdc = lpPool.usdc;
  block.reward = rewardPerBlock;
  block.hash = blockHash(block);

  chain.push(block);
  broadcast({ type: "block", block });
}

// ---- HTTP ----
app.get("/stats", (req, res) => {
  const h = chain.length - 1;
  res.json({
    height: h,
    wallets: Object.keys(wallets).length,
    treasuryPow: wallets[TREASURY]?.pow || 0,
    treasuryUsdc: wallets[TREASURY]?.usdc || 0,
    lpPow: lpPool.pow,
    lpUsdc: lpPool.usdc
  });
});

app.get("/chain", (req, res) => res.json(chain.slice(-40)));

app.post("/tx", (req, res) => {
  const tx = req.body;
  try {
    const msg = new TextEncoder().encode(JSON.stringify({
      type: tx.type, from: tx.from, to: tx.to, amount: tx.amount, nonce: tx.nonce
    }));
    const pub = bs58.decode(tx.pub);
    const sig = bs58.decode(tx.sig);
    if (!nacl.sign.detached.verify(msg, sig, pub)) return res.status(400).json({ error: "bad sig" });

    ensureWallet(tx.from);
    if (tx.nonce !== wallets[tx.from].nonce + 1)
      return res.status(400).json({ error: "bad nonce" });

    if (tx.type === "BRIDGE_REQUEST")
      return res.json({ ok: true, msg: "bridge registered, waiting for mint" });

    return res.status(400).json({ error: "unknown tx" });

  } catch {
    return res.status(400).json({ error: "invalid" });
  }
});

// ---- BRIDGE MINT triggered by Webhook from Front ----
app.post("/bridge_mint", (req, res) => {
  try {
    const { to, sol } = req.body;
    ensureWallet(to);
    ensureWallet(TREASURY);

    const powBrut = sol * 1500;
    const fee = powBrut * 0.05;
    const net = powBrut - fee;

    const tx = {
      type: "BRIDGE_MINT",
      from: TREASURY,
      to,
      amountNet: Number(net),
      amountFee: Number(fee),
      nonce: (wallets[TREASURY].nonce || 0) + 1
    };

    wallets[TREASURY].nonce = tx.nonce;
    mempool.push(tx);
    produceBlock();
    broadcast({ type: "bridge", to, sol, pow: net });
    return res.json({ ok: true });

  } catch {
    return res.status(400).json({ error: "bridge_mint error" });
  }
});

// ---- WS ----
wss.on("connection", ws => {
  ws.send(JSON.stringify({ type: "welcome", height: chain.length - 1 }));
});

// ---- RUN ----
const PORT = 3000;
server.listen(PORT, () => console.log("POWCHAIN backend on", PORT));







// ===================== FIREINNERS — SERVER.JS (vraie tx Solana) =====================
const express = require("express");
const bodyParser = require("body-parser");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const http = require("http");

// ------------------- CONFIG SERVEUR -------------------
const HTTP_PORT = 3000;
const WS_PATH = "/ws";

// RPC Solana (drpc de l'utilisateur)
const RPC_URL = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const LAMPORTS_PER_SOL = 1_000_000_000;

// Adresse de TRÉSORERIE Solana (FIREINNERS)
const TREASURY_SOL = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

const app = express();
app.use(bodyParser.json());

const server = http.createServer(app);
const wss = new WebSocket.Server({ server, path: WS_PATH });
const clients = new Set();

// ------------------- ECONOMIE FIREINNERS -------------------
const DEC = 1e6;
const SUPPLY_MAX = 100_000_000 * DEC; // hard cap 100M FIRE

let supplyCirculante = 0;
let mintedTotal = 0;
let burnedTotal = 0;

let treasury = { fire: 0, sol: 0, usdc: 0 };
let wallets = {}; // addr -> { pub, fire, usdc, nonce }
let chain = [];   // historique des bridges + events simples
let usedTxSigs = new Set(); // pour éviter de re-utiliser la même tx

// ------------------- OUTILS -------------------
function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = {
      pub: addr,
      fire: 0,
      usdc: 0,
      nonce: 0
    };
  }
  return wallets[addr];
}

function mint(amount) {
  const cap = SUPPLY_MAX - supplyCirculante;
  const x = Math.max(0, Math.min(amount, cap));
  supplyCirculante += x;
  mintedTotal += x;
  return x;
}

function burn(amount) {
  const x = Math.max(0, Math.min(amount, supplyCirculante));
  supplyCirculante -= x;
  burnedTotal += x;
  return x;
}

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  for (const c of clients) {
    if (c.readyState === 1) c.send(msg);
  }
}

// ------------------- RPC SOLANA — VERIF TX -------------------
async function fetchJsonRPC(body) {
  const res = await fetch(RPC_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });
  if (!res.ok) throw new Error("RPC HTTP " + res.status);
  const json = await res.json();
  if (json.error) throw new Error("RPC error: " + JSON.stringify(json.error));
  return json.result;
}

/**
 * Vérifie une transaction Solana :
 * - pas d'erreur
 * - transferts vers TREASURY_SOL
 * - calcule les lamports réellement reçus par la trésorerie
 */
async function verifyBridgeTxSig(txSig) {
  const result = await fetchJsonRPC({
    jsonrpc: "2.0",
    id: 1,
    method: "getTransaction",
    params: [txSig, { encoding: "jsonParsed", commitment: "confirmed" }]
  });

  if (!result) throw new Error("Transaction introuvable");
  if (result.meta && result.meta.err) throw new Error("Transaction en erreur");

  const msg = result.transaction.message;
  const meta = result.meta;
  if (!msg || !meta) throw new Error("Transaction incomplète");

  const accountKeys = msg.accountKeys.map(k => (k.pubkey ? k.pubkey : k));
  const idxTreasury = accountKeys.findIndex(k => k === TREASURY_SOL);
  if (idxTreasury < 0) throw new Error("Trésorerie non trouvée dans la tx");

  const pre = meta.preBalances[idxTreasury] || 0;
  const post = meta.postBalances[idxTreasury] || 0;
  const diff = post - pre;
  if (diff <= 0) throw new Error("Aucun SOL reçu par la trésorerie");

  const solAmount = diff / LAMPORTS_PER_SOL;
  return { lamports: diff, solAmount };
}

// ------------------- API WALLET -------------------
app.get("/wallet/:addr", (req, res) => {
  const w = ensureWallet(req.params.addr);
  res.json({
    addr: w.pub,
    fire: w.fire,
    usdc: w.usdc,
    nonce: w.nonce,
    supplyCirculante,
    supplyDisponible: SUPPLY_MAX - supplyCirculante,
    mintedTotal,
    burnedTotal,
    treasury
  });
});

// petit endpoint de "ping" pour l'UI
app.get("/wallet/ping-test", (req, res) => {
  res.json({ ok: true });
});

// ------------------- API BRIDGE (VRAIE TX SOLANA) -------------------
app.post("/bridge", async (req, res) => {
  try {
    const { addr, txSig } = req.body;
    if (!addr || !txSig) {
      return res.status(400).json({ ok: false, error: "addr ou txSig manquant" });
    }

    if (usedTxSigs.has(txSig)) {
      return res.status(400).json({ ok: false, error: "Bridge déjà utilisé pour cette transaction" });
    }

    // Vérif on-chain via RPC
    const { solAmount } = await verifyBridgeTxSig(txSig);
    if (solAmount <= 0) {
      return res.status(400).json({ ok: false, error: "SOL reçu = 0" });
    }

    // Log côté trésorerie
    treasury.sol += solAmount;

    // Économie FIRE :
    //  - 1000 FIRE par SOL
    //  - 7% de frais total
    const fireBrut = Math.floor(solAmount * 1000 * DEC);
    const fireMinted = mint(fireBrut);
    if (fireMinted <= 0) {
      return res.status(400).json({ ok: false, error: "Plus de supply FIRE disponible" });
    }

    const feeTotal = Math.floor(fireMinted * 7 / 100); // 7%
    const fireUser = fireMinted - feeTotal;
    if (fireUser <= 0) {
      return res.status(400).json({ ok: false, error: "Net FIRE <= 0" });
    }

    const feeBurn = Math.floor(feeTotal / 2);
    const feeTreas = feeTotal - feeBurn;

    const burned = burn(feeBurn);
    treasury.fire += feeTreas;

    const w = ensureWallet(addr);
    w.fire += fireUser;

    usedTxSigs.add(txSig);

    const evt = {
      type: "BRIDGE_IN",
      time: Date.now(),
      addr,
      txSig,
      solAmount,
      fireMinted,
      fireUser,
      feeBurned: burned,
      feeTreas,
      supplyCirculante,
      supplyDisponible: SUPPLY_MAX - supplyCirculante,
      treasurySnapshot: { ...treasury }
    };
    chain.push(evt);
    broadcast({ type: "bridge", bridge: evt });

    return res.json({ ok: true, bridge: evt });

  } catch (e) {
    console.error("Bridge error:", e);
    return res.status(500).json({ ok: false, error: e.message || "Erreur bridge" });
  }
});

// ------------------- API CHAIN -------------------
app.get("/chain", (req, res) => {
  res.json(chain);
});

// ------------------- WEBSOCKET -------------------
wss.on("connection", ws => {
  clients.add(ws);
  ws.on("close", () => clients.delete(ws));
});

// ------------------- DEMARRAGE -------------------
server.listen(HTTP_PORT, () => {
  console.log("FIREINNERS API + WS en ligne sur port", HTTP_PORT);
});







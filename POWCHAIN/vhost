const API=location.origin;
const WS_URL=(location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws";
const DEC=1e6;
const q=s=>document.querySelector(s);
const log=t=>{const b=q("#log");b.innerHTML=`[${new Date().toLocaleTimeString()}] ${t}<br>`+b.innerHTML;};

let sock=null,powAddr=null,powPriv=null,solAddr=null;

function connectWS(){
  try{ if(sock) sock.close(); }catch(e){}
  sock=new WebSocket(WS_URL);
  sock.onopen=()=>{q("#syncState").textContent="WS: online";q("#syncState").style.borderColor="#5bffbf";q("#syncState").style.color="#dfffee";log("WS connecté "+WS_URL);};
  sock.onclose=()=>{q("#syncState").textContent="WS: offline";q("#syncState").style.borderColor="#ff9a2f";q("#syncState").style.color="#ffe2b0";log("WS fermé, retry 2s");setTimeout(connectWS,2000);};
  sock.onerror=()=>{log("WS erreur");};
  sock.onmessage=e=>{try{const m=JSON.parse(e.data);if(m.type==="mempool")q("#mempoolLive").textContent=JSON.stringify(m.mempool,null,2);if(m.type==="new_block")log("Nouveau bloc #"+m.block.height);}catch(_){log("WS: "+e.data);}};
}

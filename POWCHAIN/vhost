#!/usr/bin/env bash
set -euo pipefail

DOMAIN="bbqfinance.fun"
APP="fireinners"
APPDIR="/root/fireinners"
WEBROOT="/var/www/${DOMAIN}"
NGX_AV="/etc/nginx/sites-available/${DOMAIN}"
NGX_EN="/etc/nginx/sites-enabled/${DOMAIN}"
TS="$(date +%Y%m%d-%H%M%S)"

echo "[1/9] Prerequis (node/npm/nginx/pm2)"
command -v nginx >/dev/null 2>&1 || { apt-get update -y; apt-get install -y nginx; }
command -v node >/dev/null 2>&1 || { apt-get update -y; apt-get install -y nodejs npm; }
command -v pm2 >/dev/null 2>&1 || npm i -g pm2
command -v wscat >/dev/null 2>&1 || npm i -g wscat || true

echo "[2/9] Dossiers + backups"
mkdir -p "$APPDIR" "$WEBROOT"
[ -f "$APPDIR/server.js" ] && cp -a "$APPDIR/server.js" "$APPDIR/server.js.bak.$TS" || true
[ -f "$WEBROOT/index.html" ] && cp -a "$WEBROOT/index.html" "$WEBROOT/index.html.bak.$TS" || true
[ -f "$NGX_AV" ] && cp -a "$NGX_AV" "$NGX_AV.bak.$TS" || true

echo "[3/9] server.js (API + WS /ws) FIREINNERS"
cat > "$APPDIR/server.js" <<'EOF'
"use strict";
const express=require("express");
const http=require("http");
const cors=require("cors");
const WebSocket=require("ws");

const PORT=process.env.PORT?parseInt(process.env.PORT,10):3000;
const DEC=1e6;

const app=express();
app.use(express.json({limit:"1mb"}));
app.use(cors());

const state={
  height:0,
  wallets:new Map(), // addr -> {pow,usdc,staked,nonce,createdAt}
  mempool:[], // [{ts,type,addr,amount,meta}]
  chain:[],   // [{height,ts,txs,hash,prev}]
  lp:{pow:0,usdc:0,feeBps:30},
  treasury:{sol:0,usdc:0,fire:0},
};

const now=()=>Date.now();
const clampInt=n=>Number.isFinite(n)?Math.max(0,Math.floor(n)):0;

function getWallet(addr){
  if(!addr||typeof addr!=="string") return null;
  let w=state.wallets.get(addr);
  if(!w){
    w={pow:0,usdc:0,staked:0,nonce:0,createdAt:now()};
    state.wallets.set(addr,w);
  }
  return w;
}
function pushMP(x){
  state.mempool.unshift(x);
  if(state.mempool.length>200) state.mempool.length=200;
  broadcast({type:"mempool",mempool:state.mempool.slice(0,80)});
}
function mkBlock(){
  const txs=state.mempool.splice(0,80);
  const prev=state.chain.length?state.chain[0].hash:"GENESIS";
  const payload=JSON.stringify({prev,txs,ts:now(),h:state.height+1});
  let hash=0;for(let i=0;i<payload.length;i++) hash=(hash*31+payload.charCodeAt(i))>>>0;
  const b={height:++state.height,ts:now(),txs,prev,hash:hash.toString(16).padStart(8,"0")};
  state.chain.unshift(b);
  if(state.chain.length>500) state.chain.length=500;
  broadcast({type:"new_block",block:b});
}

app.get("/health",(req,res)=>res.json({ok:true,app:"fireinners",port:PORT,wsPath:"/ws"}));
app.get("/stats",(req,res)=>{
  res.json({
    ok:true,
    height:state.height,
    wallets:state.wallets.size,
    mempool:state.mempool.length,
    totalPow:Math.floor(Array.from(state.wallets.values()).reduce((a,w)=>a+w.pow,0)),
    totalStaked:Math.floor(Array.from(state.wallets.values()).reduce((a,w)=>a+w.staked,0)),
    lpPow:Math.floor(state.lp.pow),
    lpUsdc:Math.floor(state.lp.usdc),
    solTreasury:state.treasury.sol,
    usdcTreasury:Math.floor(state.treasury.usdc),
    fireTreasury:Math.floor(state.treasury.fire),
  });
});

app.get("/wallet/:addr",(req,res)=>{
  const w=getWallet(req.params.addr);
  if(!w) return res.status(400).json({ok:false,error:"bad addr"});
  res.json({ok:true,pow:w.pow,usdc:w.usdc,staked:w.staked,nonce:w.nonce});
});

app.post("/bridge",(req,res)=>{
  const {addr,amount,signature}=req.body||{};
  const w=getWallet(addr);
  const a=Number(amount);
  if(!w||!Number.isFinite(a)||a<=0||!signature) return res.status(400).json({ok:false,error:"bad bridge"});
  const creditFire=Math.floor(a*DEC*500); // ratio simple (ajuste si tu veux)
  w.pow+=creditFire;
  w.nonce++;
  state.treasury.sol=Number(state.treasury.sol||0)+a;
  state.treasury.fire+=Math.floor(creditFire*0.01); // petite réserve
  pushMP({ts:now(),type:"bridge",addr,amountLamports:Math.floor(a*1e9),creditFire,signature});
  res.json({ok:true,creditFire});
});

function ammSwapPow2Usdc(amount){
  const x=state.lp.pow, y=state.lp.usdc;
  if(x<=0||y<=0) return {ok:false,error:"lp empty"};
  const fee=(amount*state.lp.feeBps)/10000;
  const a=amount-fee;
  const k=x*y;
  const newX=x+a;
  const newY=Math.floor(k/newX);
  const out=y-newY;
  state.lp.pow=newX;
  state.lp.usdc=newY;
  state.treasury.usdc+=Math.floor(fee);
  return {ok:true,out:Math.floor(out),fee:Math.floor(fee)};
}
function ammSwapUsdc2Pow(amount){
  const x=state.lp.usdc, y=state.lp.pow;
  if(x<=0||y<=0) return {ok:false,error:"lp empty"};
  const fee=(amount*state.lp.feeBps)/10000;
  const a=amount-fee;
  const k=x*y;
  const newX=x+a;
  const newY=Math.floor(k/newX);
  const out=y-newY;
  state.lp.usdc=newX;
  state.lp.pow=newY;
  state.treasury.fire+=Math.floor(fee);
  return {ok:true,out:Math.floor(out),fee:Math.floor(fee)};
}

app.post("/swap",(req,res)=>{
  const {addr,dir,amount}=req.body||{};
  const w=getWallet(addr);
  const amt=clampInt(amount);
  if(!w||!amt) return res.status(400).json({ok:false,error:"bad swap"});
  if(dir==="pow2usdc"){
    if(w.pow<amt) return res.status(400).json({ok:false,error:"insufficient FIRE"});
    const r=ammSwapPow2Usdc(amt);
    if(!r.ok) return res.status(400).json({ok:false,error:r.error});
    w.pow-=amt;
    w.usdc+=r.out;
    w.nonce++;
    pushMP({ts:now(),type:"swap",dir,addr,amount:amt,received:r.out,fee:r.fee});
    return res.json({ok:true,received:r.out,fee:r.fee});
  }
  if(dir==="usdc2pow"){
    if(w.usdc<amt) return res.status(400).json({ok:false,error:"insufficient USDC(FIRE)"});
    const r=ammSwapUsdc2Pow(amt);
    if(!r.ok) return res.status(400).json({ok:false,error:r.error});
    w.usdc-=amt;
    w.pow+=r.out;
    w.nonce++;
    pushMP({ts:now(),type:"swap",dir,addr,amount:amt,received:r.out,fee:r.fee});
    return res.json({ok:true,received:r.out,fee:r.fee});
  }
  res.status(400).json({ok:false,error:"bad dir"});
});

app.post("/lp/add",(req,res)=>{
  const {addr,pow,usdc}=req.body||{};
  const w=getWallet(addr);
  const p=clampInt(pow), u=clampInt(usdc);
  if(!w||!p||!u) return res.status(400).json({ok:false,error:"bad lp add"});
  if(w.pow<p||w.usdc<u) return res.status(400).json({ok:false,error:"insufficient funds"});
  w.pow-=p; w.usdc-=u; w.nonce++;
  state.lp.pow+=p; state.lp.usdc+=u;
  pushMP({ts:now(),type:"lp_add",addr,pow:p,usdc:u});
  res.json({ok:true});
});

app.post("/stake",(req,res)=>{
  const {addr,amount}=req.body||{};
  const w=getWallet(addr);
  const a=clampInt(amount);
  if(!w||!a) return res.status(400).json({ok:false,error:"bad stake"});
  if(w.pow<a) return res.status(400).json({ok:false,error:"insufficient FIRE"});
  w.pow-=a; w.staked+=a; w.nonce++;
  pushMP({ts:now(),type:"stake",addr,amount:a});
  res.json({ok:true});
});

app.get("/block/:h",(req,res)=>{
  const h=parseInt(req.params.h,10);
  if(!Number.isFinite(h)||h<=0) return res.status(400).json({ok:false,error:"bad height"});
  const b=state.chain.find(x=>x.height===h);
  if(!b) return res.status(404).json({ok:false,error:"not found"});
  res.json(b);
});

const server=http.createServer(app);

const wss=new WebSocket.Server({server,path:"/ws"});
const clients=new Set();
function broadcast(obj){
  const s=JSON.stringify(obj);
  for(const ws of clients){
    if(ws.readyState===WebSocket.OPEN) ws.send(s);
  }
}
wss.on("connection",(ws)=>{
  clients.add(ws);
  ws.send(JSON.stringify({type:"mempool",mempool:state.mempool.slice(0,80)}));
  ws.send(JSON.stringify({type:"clients",count:clients.size}));
  ws.on("close",()=>{clients.delete(ws);});
});

setInterval(()=>{ if(state.mempool.length) mkBlock(); }, 5000);

server.listen(PORT,"127.0.0.1",()=>{
  console.log("FIREINNERS backend en ligne sur port "+PORT);
});
EOF


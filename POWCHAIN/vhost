sudo nano /etc/nginx/sites-available/bbqfinance


server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # Frontend statique
    root /var/www/html;
    index index.html;

    # Fichiers statiques (HTML/CSS/JS)
    location / {
        try_files $uri $uri/ =404;
    }

    # ---------- API POWCHAIN (HTTP) ----------
    # Stats réseau
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Chaîne complète
    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Nouvelle transaction POWCHAIN
    location /tx {
        proxy_pass http://127.0.0.1:3000/tx;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Bridge SOL -> POWCHAIN
    location /bridge {
        proxy_pass http://127.0.0.1:3000/bridge;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ---------- WebSocket POWCHAIN ----------
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 60m;
    }

    # Optionnel : réduire les logs bruités
    access_log /var/log/nginx/bbqfinance_access.log;
    error_log  /var/log/nginx/bbqfinance_error.log;
}

sudo rm -f /etc/nginx/sites-enabled/default
sudo ln -sf /etc/nginx/sites-available/bbqfinance /etc/nginx/sites-enabled/bbqfinance





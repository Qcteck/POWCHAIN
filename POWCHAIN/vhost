<script>
const API = "/";
let SK=null,PK=null;

// ---- LOG ----
function log(x){ let l=document.getElementById("logs"); l.textContent += "["+(new Date().toLocaleTimeString())+"] "+x+"\n"; l.scrollTop = l.scrollHeight; }

// ---- BACKEND STATUS ----
async function checkBack(){
 try{
  await fetch(API+"stats",{method:"GET",cache:"no-store"});
  document.getElementById("api").className="ok"; document.getElementById("api").textContent="Backend ✔";
 }catch{ document.getElementById("api").className="bad"; document.getElementById("api").textContent="Backend ❌"; }

 if(ws && ws.readyState===1){ wsStatus(true)} else { wsStatus(false) }
}
function wsStatus(st){ let e=document.getElementById("ws"); if(st){e.className="ok";e.textContent="WebSocket ✔"}else{e.className="bad";e.textContent="WebSocket ❌"} }

// ---- FIREINNERS ----
function genWallet(){
 const kp=nacl.sign.keyPair();
 SK = bs58.encode(kp.secretKey);
 PK = bs58.encode(kp.publicKey);
 document.getElementById("addrFire").value = PK;
 log("Wallet FIREINNERS généré");
}
function loadWallet(){
 SK=document.getElementById("privFire").value.trim();
 if(!SK) return;
 try{ PK = bs58.encode(nacl.sign.keyPair.fromSecretKey(bs58.decode(SK)).publicKey); }
 catch(e){ log("Clé privée invalide"); return; }
 document.getElementById("addrFire").value = PK;
 log("Wallet FIREINNERS chargé");
 refresh();
}

// ---- FIREINNERS STATS ----
async function refresh(){
 if(!PK) return;
 try{
  let r = await (await fetch(API+"wallet/"+PK)).json();
  document.getElementById("balFire").textContent = r.fire;
  document.getElementById("balUSDCF").textContent = r.usdc;
  document.getElementById("supplyC").textContent = r.supplyC;
  document.getElementById("supplyD").textContent = r.supplyD;
 }catch(e){ log("Erreur refresh FIREINNERS") }
}

// ---- SOLANA WALLET ----
async function connectPhantom(){
 if(!window.solana){ log("Phantom non détecté"); return; }
 const res = await window.solana.connect();
 document.getElementById("solAddr").value = res.publicKey.toString();
 refreshSol();
 log("Phantom connecté");
}
async function refreshSol(){
 let a=document.getElementById("solAddr").value;
 if(!a) return;
 try{
   const conn=new solanaWeb3.Connection("https://api.mainnet-beta.solana.com");
   const bal = await conn.getBalance(new solanaWeb3.PublicKey(a))/1e9;
   document.getElementById("balSol").textContent = bal.toFixed(6);
   document.getElementById("balUSDCsol").textContent = 0;
   log("Solana wallet mis à jour");
 }catch(e){ log("Erreur Solana RPC") }
}

// ---- BRIDGE ----
async function bridgeSol(){
 if(!PK) return log("Charger un wallet FIREINNERS");
 let amt=document.getElementById("amtBridge").value;
 if(!amt) return;

 let tx = {type:"bridge",to:PK,amount:amt,nonce:Date.now()};
 let sig = sign(tx);
 let r = await fetch(API+"tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...tx,sig})});
 log("Bridge envoyé");
 refresh();
}

// ---- swap ----
async function swap(){
 if(!PK) return log("Pas de wallet FIRE");
 let a=document.getElementById("swapAmt").value;
 if(!a) return;
 let z=document.getElementById("swapSide").value;
 let tx = {type:"swap",from:PK,side:z,amount:a,nonce:Date.now()};
 let sig = sign(tx);
 await fetch(API+"tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...tx,sig})});
 log("Swap envoyé");
 refresh();
}

// ---- LP ----
async function addLP(){
 if(!PK) return;
 let f=document.getElementById("lpFire").value;
 let u=document.getElementById("lpUSDCF").value;
 if(!f||!u) return;
 let tx={type:"lp_add",from:PK,fire:f,usdc:u,nonce:Date.now()};
 let sig=sign(tx);
 await fetch(API+"tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...tx,sig})});
 log("LP envoyé");
 refresh();
}

// ---- SIGN ----
function sign(obj){
 let msg=JSON.stringify(obj);
 let sig=nacl.sign.detached(new TextEncoder().encode(msg), bs58.decode(SK));
 return bs58.encode(sig);
}

// ---- WEBSOCKET LOGS ----
let ws=null;
function wsConnect(){
 ws = new WebSocket((location.protocol==="https:"?"wss":"ws")+"://"+location.host+"/ws");
 ws.onopen = ()=>{wsStatus(true)};
 ws.onclose = ()=>{wsStatus(false);setTimeout(wsConnect,2000)};
 ws.onmessage = e => log(e.data);
}
setInterval(checkBack,2000);
wsConnect();
</script>


state.height = 0;
state.supplyFIRE = 0;

const tres = ensureWallet(TREASURY_ADDR);
tres.fire = 1000000 * DEC;
state.supplyFIRE = totalSupplyFIRE();

function buildStats() {
  return {
    height: state.height,
    supplyFIRE: state.supplyFIRE,
    lpFIRE: state.lpFIRE,
    lpUSDCFIRE: state.lpUSDCFIRE,
    treasuryUsdc: state.treasuryUsdc,
    treasurySol: state.treasurySol,
    treasuryAddr: TREASURY_ADDR,
    wallets: wallets.size
  };
}

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  wss.clients.forEach(ws => {
    if (ws.readyState === WebSocket.OPEN) ws.send(msg);
  });
}


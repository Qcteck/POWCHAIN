nano /etc/nginx/sites-available/bbqfinance

server {
    listen 80;
    listen [::]:80;

    server_name bbqfinance.fun www.bbqfinance.fun;

    # Dossier web (index POWCHAIN)
    root /var/www/html;
    index index.html;

    # 1) Route principale : d'abord fichiers statiques, sinon proxy vers POWCHAIN (port 3000)
    location / {
        try_files $uri @powchain;
    }

    location @powchain {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 2) WebSocket POWCHAIN (port 7001)
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }

    # 3) API direct POWCHAIN (optionnel mais pratique)
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
    }

    location /tx {
        proxy_pass http://127.0.0.1:3000/tx;
    }
}


ls -l /etc/nginx/sites-enabled

ln -sf /etc/nginx/sites-available/bbqfinance /etc/nginx/sites-enabled/bbqfinance

// POWCHAIN — Validator Node OFFICIEL (Version A révisée)
// PoS • Mempool • Blocs sur 5 TX • LP • Bridge SOL • WebSocket 7001 • API 3000

const express = require("express");
const cors = require("cors");
const fs = require("fs");
const crypto = require("crypto");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const { TextEncoder } = require("util");

// Fichier de DB
const DB_FILE = "/root/powchain/db.json";

// Chargement DB
let DB = { chain: [], wallets: {}, lp: { pow: 0, usdc: 0 }, mempool: [] };
try {
  if (fs.existsSync(DB_FILE)) {
    DB = JSON.parse(fs.readFileSync(DB_FILE, "utf8"));
    console.log("[DB] Chargée");
  } else {
    console.log("[DB] Nouvelle base créée");
  }
} catch (e) {
  console.error("[DB] Erreur de lecture, réinitialisation soft:", e.message);
}

// Sauvegarde DB
function saveDB() {
  try {
    fs.writeFileSync(DB_FILE, JSON.stringify(DB, null, 2));
  } catch (e) {
    console.error("[DB] Erreur de sauvegarde:", e.message);
  }
}

// Utilitaires
function sha(x) {
  return crypto.createHash("sha256").update(x).digest("hex");
}

// Genesis si chaîne vide
if (!Array.isArray(DB.chain)) DB.chain = [];
if (DB.chain.length === 0) {
  const genesis = {
    index: 0,
    time: Date.now(),
    prev: "0",
    hash: sha("POWCHAIN_GENESIS"),
    tx: [],
    stakers: {},
    winner: null,
    reward: 0
  };
  DB.chain.push(genesis);
  saveDB();
  console.log("[GENESIS] Bloc Genesis créé");
} else {
  console.log("[GENESIS] 1 bloc minimum présent");
}

// Paramètres POWCHAIN
const PORT = 3000;
const WSPORT = 7001;
const BLOCK_REWARD = 10;
const MIN_TX_PER_BLOCK = 5;
const TREASURY_SOL = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

// Création / accès wallet POWCHAIN
function ensureWallet(pub) {
  if (!DB.wallets[pub]) {
    DB.wallets[pub] = { pow: 0, usdc: 0, staked: 0, nonce: 0, pub };
  }
  return DB.wallets[pub];
}

function createWallet() {
  const kp = nacl.sign.keyPair();
  const pub = bs58.encode(kp.publicKey);
  const priv = bs58.encode(kp.secretKey);
  ensureWallet(pub);
  saveDB();
  return { pub, priv };
}

// Vérification de signature TX
function verifyTxSignature(tx) {
  try {
    const { from, to, amount, token, nonce, pub, sig } = tx;
    if (!from || !to || typeof amount !== "number" || !token || !nonce) return false;
    if (!pub || !sig) return false;
    if (from !== pub) return false;
    const msgStr = `${from}|${to}|${amount}|${token}|${nonce}`;
    const msg = new TextEncoder().encode(msgStr);
    const pubKey = bs58.decode(pub);
    const sigBytes = bs58.decode(sig);
    return nacl.sign.detached.verify(msg, sigBytes, pubKey);
  } catch (e) {
    console.error("[TX] Erreur verify:", e.message);
    return false;
  }
}

// Application d'une TX dans l'état
function applyTx(tx) {
  const { from, to, amount, token } = tx;
  const wFrom = ensureWallet(from);
  const wTo = ensureWallet(to);

  if (token === "POW") {
    if (wFrom.pow < amount) return false;
    wFrom.pow -= amount;
    wTo.pow += amount;
    return true;
  }
  if (token === "USDC") {
    if (wFrom.usdc < amount) return false;
    wFrom.usdc -= amount;
    wTo.usdc += amount;
    return true;
  }
  // Hooks futurs pour STAKE / UNSTAKE
  return true;
}

// PoS simple — choisir un gagnant basé sur staked
function chooseWinner() {
  const entries = Object.entries(DB.wallets).filter(([, w]) => w.staked > 0);
  if (entries.length === 0) return null;
  const total = entries.reduce((s, [, w]) => s + w.staked, 0);
  let r = Math.random() * total;
  for (const [pub, w] of entries) {
    if (r < w.staked) return pub;
    r -= w.staked;
  }
  return entries[0][0] || null;
}

// Forge d'un bloc (1 bloc = 5 TX)
function forgeBlockIfNeeded() {
  while (DB.mempool.length >= MIN_TX_PER_BLOCK) {
    const txBatch = DB.mempool.splice(0, MIN_TX_PER_BLOCK);
    // Appliquer TX (filtrer les invalides silencieusement)
    const applied = [];
    for (const tx of txBatch) {
      if (applyTx(tx)) applied.push(tx);
    }
    const prev = DB.chain[DB.chain.length - 1];
    const stakersSnapshot = {};
    Object.entries(DB.wallets).forEach(([pub, w]) => {
      if (w.staked > 0) stakersSnapshot[pub] = w.staked;
    });
    const winner = chooseWinner();
    if (winner) {
      ensureWallet(winner).pow += BLOCK_REWARD;
    }
    const block = {
      index: prev.index + 1,
      time: Date.now(),
      prev: sha(JSON.stringify(prev)),
      hash: sha(JSON.stringify(applied) + Date.now()),
      tx: applied,
      stakers: stakersSnapshot,
      winner,
      reward: BLOCK_REWARD
    };
    DB.chain.push(block);
    saveDB();
    broadcast({ type: "block", block });
    console.log("[BLOCK] Nouveau bloc forgé index", block.index, "avec", applied.length, "TX");
  }
}

// Ajout TX au mempool
function addTxToMempool(tx) {
  const w = ensureWallet(tx.from);
  const expectedNonce = (w.nonce || 0) + 1;
  if (tx.nonce !== expectedNonce) {
    console.log("[TX] Nonce invalide pour", tx.from, "reçu", tx.nonce, "attendu", expectedNonce);
    return false;
  }
  if (!verifyTxSignature(tx)) {
    console.log("[TX] Signature invalide pour", tx.from);
    return false;
  }
  DB.mempool.push(tx);
  w.nonce = expectedNonce;
  saveDB();
  forgeBlockIfNeeded();
  return true;
}

// WebSocket serveur (port dédié 7001)
const wss = new WebSocket.Server({ port: WSPORT });
wss.on("connection", ws => {
  console.log("[WS] client connecté");
  ws.send(JSON.stringify({
    type: "hello",
    height: DB.chain.length,
    wallets: Object.keys(DB.wallets).length
  }));
});
function broadcast(msg) {
  const data = JSON.stringify(msg);
  wss.clients.forEach(c => {
    if (c.readyState === WebSocket.OPEN) c.send(data);
  });
}
console.log("[WS] POWCHAIN WebSocket sur port", WSPORT);

// EXPRESS API
const app = express();
app.use(cors());
app.use(express.json());

// Créer un wallet POWCHAIN
app.get("/wallet/create", (req, res) => {
  const w = createWallet();
  res.json(w);
});

// Récupérer un wallet
app.get("/wallet/:pub", (req, res) => {
  const pub = req.params.pub;
  const w = DB.wallets[pub];
  res.json(w || {});
});

// Envoyer TX → mempool
app.post("/tx", (req, res) => {
  const ok = addTxToMempool(req.body || {});
  res.json({ ok });
});

// Chaîne complète (explorer brut)
app.get("/chain", (req, res) => {
  res.json(DB.chain);
});

// Explorer résumé (derniers blocs)
app.get("/explorer", (req, res) => {
  const depth = parseInt(req.query.depth || "20", 10);
  const blocks = DB.chain.slice(-depth).map(b => ({
    index: b.index,
    time: b.time,
    winner: b.winner,
    txCount: Array.isArray(b.tx) ? b.tx.length : 0,
    hash: b.hash,
    prev: b.prev
  }));
  res.json({ height: DB.chain.length, blocks });
});

// LP info
app.get("/lp", (req, res) => {
  res.json(DB.lp || { pow: 0, usdc: 0 });
});

// Bridge SOL → POWCHAIN (notifié depuis front après TX Solana confirmée)
app.post("/bridge", (req, res) => {
  const { sig, from, to, lamports, fireAddr } = req.body || {};
  if (!from || !to || typeof lamports !== "number" || !fireAddr) {
    return res.json({ ok: false, error: "payload incomplet" });
  }
  if (to !== TREASURY_SOL) {
    return res.json({ ok: false, error: "mauvaise trésorerie" });
  }
  const sol = lamports / 1_000_000_000;
  const w = ensureWallet(fireAddr);
  const minted = sol * 10; // ratio 1 SOL → 10 POW
  w.pow += minted;
  saveDB();
  const evt = { type: "bridge", fireAddr, sol, minted };
  broadcast(evt);
  console.log("[BRIDGE]", evt);
  res.json({ ok: true });
});

// Stats POWCHAIN
app.get("/stats", (req, res) => {
  const walletsArr = Object.values(DB.wallets);
  const totalPow = walletsArr.reduce((s, w) => s + (w.pow || 0), 0);
  const totalStaked = walletsArr.reduce((s, w) => s + (w.staked || 0), 0);
  res.json({
    height: DB.chain.length,
    wallets: Object.keys(DB.wallets).length,
    mempool: DB.mempool.length,
    totalPow,
    totalStaked,
    lp: DB.lp || { pow: 0, usdc: 0 }
  });
});

// Lancement HTTP API
app.listen(PORT, () => {
  console.log("[HTTP] POWCHAIN API sur port", PORT);
  console.log("[HTTP] Routes: /wallet/create /wallet/:pub /tx /chain /explorer /lp /bridge /stats");
  console.log("[BRIDGE] Trésorerie SOL:", TREASURY_SOL);
});



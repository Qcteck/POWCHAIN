<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>POWCHAIN — Client Complet</title>
  <style>
    body{
      margin:0;
      background:#05070b;
      color:#e5ecff;
      font-family:system-ui,Arial;
    }
    #wrap{
      max-width:1100px;
      margin:20px auto;
      padding:16px;
      border-radius:12px;

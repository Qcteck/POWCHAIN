# 3. SERVER.JS (WS CORRIGÉ)
############################################
cat > /root/fireinners/server.js <<'EOF'
const express=require("express");
const http=require("http");
const WebSocket=require("ws");
const cors=require("cors");

const PORT=3000;
const DEC=1e6;

const app=express();
app.use(cors());
app.use(express.json());

const state={
  height:0,
  wallets:{},
  mempool:[],
  blocks:[],
  lpPow:0,
  lpUsdc:0,
  totalStaked:0,
  treasury:{sol:0,usdc:0,fire:0}
};

const ensure=w=>{
  if(!state.wallets[w])state.wallets[w]={pow:0,usdc:0,staked:0,nonce:0};
  return state.wallets[w];
};

const hash=s=>require("crypto").createHash("sha256").update(s).digest("hex").slice(0,16);

function produceBlock(){
  const txs=state.mempool.splice(0);
  state.height++;
  const b={height:state.height,ts:Date.now(),txs};
  b.hash=hash(JSON.stringify(b));
  state.blocks.push(b);
  broadcast({type:"new_block",block:b});
  return b;
}

function apply(tx){
  const w=ensure(tx.addr);
  if(tx.type==="bridge"){
    const sol=Number(tx.amount);
    const fire=sol*1000*DEC;
    const usdc=sol*100*DEC;
    w.pow+=fire; w.usdc+=usdc;
    state.treasury.sol+=sol;
    state.treasury.fire+=fire;
    state.treasury.usdc+=usdc;
  }
  if(tx.type==="swap"){
    const a=Number(tx.amount);
    if(tx.dir==="pow2usdc"){
      w.pow-=a; w.usdc+=a;
    }else{
      w.usdc-=a; w.pow+=a;
    }
  }
  if(tx.type==="stake"){
    w.pow-=tx.amount;
    w.staked+=tx.amount;
    state.totalStaked+=tx.amount;
  }
  w.nonce++;
}

app.get("/stats",(req,res)=>res.json({
  height:state.height,
  wallets:Object.keys(state.wallets).length,
  mempool:state.mempool.length,
  totalStaked:state.totalStaked,
  lpPow:state.lpPow,
  lpUsdc:state.lpUsdc,
  solTreasury:state.treasury.sol,
  usdcTreasury:state.treasury.usdc,
  fireTreasury:state.treasury.fire
}));

app.get("/wallet/:a",(r,s)=>s.json(ensure(r.params.a)));
app.post("/bridge",(r,s)=>{const tx={type:"bridge",addr:r.body.addr,amount:r.body.amount};state.mempool.push(tx);apply(tx);produceBlock();s.json({ok:true});});
app.post("/swap",(r,s)=>{const tx={type:"swap",addr:r.body.addr,dir:r.body.dir,amount:r.body.amount};state.mempool.push(tx);apply(tx);produceBlock();s.json({ok:true});});
app.post("/stake",(r,s)=>{const tx={type:"stake",addr:r.body.addr,amount:r.body.amount};state.mempool.push(tx);apply(tx);produceBlock();s.json({ok:true});});

const server=http.createServer(app);
const wss=new WebSocket.Server({server,path:"/ws"});

function broadcast(o){
  const m=JSON.stringify(o);
  wss.clients.forEach(c=>c.readyState===1&&c.send(m));
}

wss.on("connection",ws=>{
  ws.send(JSON.stringify({type:"stats",stats:state}));
});

server.listen(PORT,()=>console.log("🔥 FIREINNERS backend OK :",PORT));
EOF


#!/bin/bash
set -e
HTML="/var/www/bbqfinance.fun/index.html"
cp -a "$HTML" "$HTML.bak.$(date +%s)"

perl -i -pe 's/const API="https:\/\/bbqfinance\.fun";/const API=location.origin;/g' "$HTML"
perl -i -pe 's/const WS_URL="wss:\/\/bbqfinance\.fun\/ws";/const WS_URL=(location.protocol==="https:"?"wss":"ws")+":\/\/"+location.host+"\/ws";/g' "$HTML"

nginx -t && systemctl reload nginx
echo "✅ Patch HTML OK. Backup: $HTML.bak.*"
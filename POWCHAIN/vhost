<script>
  const logBox=document.getElementById("console");
  function log(msg){
    const t=new Date();
    const h=t.getHours().toString().padStart(2,"0");
    const m=t.getMinutes().toString().padStart(2,"0");
    const s=t.getSeconds().toString().padStart(2,"0");
    logBox.textContent+="["+h+" h "+m+" min "+s+" s] "+msg+"\\n";
    logBox.scrollTop=logBox.scrollHeight;
  }

  // navigation
  document.querySelectorAll(".nav-btn").forEach(btn=>{
    btn.addEventListener("click",()=>{
      document.querySelectorAll(".nav-btn").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      const tab=btn.dataset.tab;
      document.querySelectorAll(".tab").forEach(t=>t.classList.add("hidden"));
      const el=document.getElementById("tab-"+tab);
      if(el)el.classList.remove("hidden");
    });
  });

  // theme nuit/jour
  let dark=true;
  document.getElementById("btnTheme").onclick=()=>{
    dark=!dark;
    if(dark){
      document.body.style.background="radial-gradient(circle at top,#1e1b4b 0,#020617 55%,#000 100%)";
    }else{
      document.body.style.background="radial-gradient(circle at top,#e5e7eb 0,#9ca3af 55%,#020617 100%)";
    }
  };

  // palette couleurs
  document.getElementById("themePicker").onchange=e=>{
    const v=e.target.value;
    const root=document.documentElement.style;
    if(v==="default"){root.cssText="";return;}
    const maps={
      vert:["#020617","#064e3b","#22c55e"],
      or:["#171717","#854d0e","#facc15"],
      blanc:["#0f172a","#1f2937","#f9fafb"],
      noir:["#020617","#000000","#f97316"],
      rouge:["#1f0005","#450a0a","#ef4444"],
      argent:["#020617","#4b5563","#e5e7eb"],
      mauve:["#0f172a","#4c1d95","#a855f7"],
      orange:["#111827","#7c2d12","#fb923c"],
      gris:["#020617","#111827","#9ca3af"],
      jaune:["#171717","#854d0e","#facc15"],
      violet:["#020617","#4c1d95","#8b5cf6"],
      multi:["#020617","#1d4ed8","#f97316"],
      army:["#020617","#14532d","#84cc16"],
      gold:["#020617","#92400e","#fbbf24"]
    };
    const m=maps[v];
    if(m){
      root.setProperty("--bg",m[0]);
      root.setProperty("--bg2",m[1]);
      root.setProperty("--accent",m[2]);
      root.setProperty("--accent-soft",m[2]+"44");
    }
  };

  // prix ticker (simple, rafraîchi toutes les 2 minutes)
  async function loadPrices(){
    try{
      const r=await fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd");
      const j=await r.json();
      const btc=j.bitcoin?.usd??0;
      const eth=j.ethereum?.usd??0;
      const sol=j.solana?.usd??0;
      const sui=j.sui?.usd??0;
      const fire=0.04;
      const bar=document.getElementById("priceScroll");
      bar.innerHTML="";
      const arr=[
        {sym:"BTC",p:btc,cls:"btc"},
        {sym:"ETH",p:eth,cls:"eth"},
        {sym:"SOL",p:sol,cls:"sol"},
        {sym:"SUI",p:sui,cls:"sui"},
        {sym:"FIRE",p:fire,cls:"fire"},
      ];
      for(const it of arr){
        const span=document.createElement("span");
        span.className="ticker-item";
        span.innerHTML='<span class="ticker-logo '+it.cls+'"></span>'+it.sym+" $"+it.p.toFixed(2);
        bar.appendChild(span);
      }
      bar.appendChild(bar.cloneNode(true)); // pour la boucle
    }catch(e){
      log("Prix marché ERR : "+e.message);
    }
  }
  loadPrices();
  setInterval(loadPrices,120000);

  // RSS crypto (texte fixe pour éviter CORS)
  (function(){
    const news=[
      "BTC : halving, ETF & macro…",
      "ETH : rollups, restaking et L2 en feu.",
      "SOL : écosystème DeFi + memecoins.",
      "SUI : move-based chain en expansion.",
      "FIREINNERS : bridge SOL → POWCHAIN expérimental."
    ];
    const rss=document.getElementById("rssInner");
    rss.innerHTML="";
    news.forEach(n=>{
      const s=document.createElement("span");
      s.textContent=n;
      rss.appendChild(s);
    });
    rss.appendChild(rss.cloneNode(true));
  })();

  // compteur visiteurs (localStorage, indicatif)
  (function(){
    const k="fireinners_visits";
    let n=Number(localStorage.getItem(k)||0);
    n++;
    localStorage.setItem(k,n);
    document.getElementById("visitorCount").textContent="Nombre de visites locales : "+n;
  })();

  // génération nom FIREINNERS
  function randInt(min,max){return Math.floor(Math.random()*(max-min+1))+min;}
  const letters="ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  function randStr(n){let s="";for(let i=0;i<n;i++)s+=letters[randInt(0,letters.length-1)];return s;}
  function randColor(){
    const roll=Math.random()*100;
    if(roll<3)return"multicolore";
    if(roll<5)return"army";
    if(roll<6)return"gold";
    const colors=["vert","or","blanc","noire","rouge","argent","mauve","orange","gris","jaune","violet"];
    return colors[randInt(0,colors.length-1)];
  }
  function genFireName(){
    const num=randInt(1,100000000);
    const seg1=randStr(4);
    const seg2=randStr(4);
    const color=randColor();
    const algo="441-FIRE-"+seg1+"/inners/"+seg2+"/1a"+num+"/"+color;
    document.getElementById("fireName").textContent="Nom de wallet généré : "+seg1+seg2;
    document.getElementById("fireNameAlgo").textContent="Algorithme : "+algo;
  }
  document.getElementById("btnGenFireName").onclick=genFireName;

  // wallet local POWCHAIN (nacl + bs58)
  const LS_KEY="fireinners_wallet";
  function loadLocalWallet(){
    const saved=localStorage.getItem(LS_KEY);
    let w=null;
    if(saved){
      try{w=JSON.parse(saved);}catch(e){}
    }
    if(!w){
      const kp=nacl.sign.keyPair();
      w={
        pub:bs58.encode(kp.publicKey),
        priv:bs58.encode(kp.secretKey),
        pow:0,usdc:0,staked:0,nonce:0
      };
      localStorage.setItem(LS_KEY,JSON.stringify(w));
      log("Nouveau wallet FIREINNERS généré.");
    }else{
      log("Wallet FIREINNERS rechargé depuis localStorage");
    }
    document.getElementById("powAddr").value=w.pub;
    document.getElementById("powPriv").value=w.priv;
    new QRCode(document.getElementById("qrFireWallet"),{
      text:w.pub,width:150,height:150,colorDark:"#e5e7eb",colorLight:"#020617"
    });
    return w;
  }
  document.getElementById("btnGenLocal").onclick=loadLocalWallet;
  const localWallet=loadLocalWallet();

  // QR trésorerie
  new QRCode(document.getElementById("qrTreasury"),{
    text:document.getElementById("treasurySol").value,
    width:150,height:150,colorDark:"#e5e7eb",colorLight:"#020617"
  });

  // WebSocket
  let ws=null;
  function connectWS(){
    const status=document.getElementById("wsStatus");
    try{
      const url=(location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws";
      ws=new WebSocket(url);
      ws.onopen=()=>{
        status.textContent="WS : online";
        status.classList.add("ok");
        log("WS connecté");
      };
      ws.onclose=()=>{
        status.textContent="WS : offline";
        status.classList.remove("ok");
        log("WS fermé, reconnexion dans 3s...");
        setTimeout(connectWS,3000);
      };
      ws.onerror=e=>{
        log("WS erreur.");
      };
      ws.onmessage=ev=>{
        try{
          const msg=JSON.parse(ev.data);
          if(msg.type==="clients"){
            log("WS clients connectés : "+msg.count);
          }else if(msg.type==="new_block"){
            log("Nouveau bloc "+msg.block.height+" ("+msg.block.type+")");
          }else if(msg.type==="tx"){
            log("TX "+msg.tx.type);
          }
        }catch(e){}
      };
    }catch(e){
      log("WS init ERR : "+e.message);
    }
  }
  connectWS();

  // Phantom connect + balances
  const phantomAddr=document.getElementById("phantomAddr");
  const btnConnect=document.getElementById("btnConnectPhantom");
  let phantomPub=null;
  const solConnection=new solanaWeb3.Connection("https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac","confirmed");

  async function connectPhantom(){
    try{
      const provider=window.solana||window.phantom?.solana;
      if(!provider||!provider.isPhantom){alert("Phantom non détecté.");return;}
      const resp=await provider.connect();
      phantomPub=resp.publicKey.toString();
      phantomAddr.textContent="Phantom : "+phantomPub;
      log("Phantom connecté : "+phantomPub);
      refreshPhantomBalances();
    }catch(e){
      log("Phantom ERR : "+e.message);
    }
  }
  btnConnect.onclick=connectPhantom;

  async function refreshPhantomBalances(){
    if(!phantomPub)return;
    try{
      const pub=new solanaWeb3.PublicKey(phantomPub);
      const solLamports=await solConnection.getBalance(pub);
      document.getElementById("solBal").value=(solLamports/1e9).toFixed(6);
      document.getElementById("usdcBal").value="n/a";
    }catch(e){
      log("Sol ERR : "+e.message);
    }
  }
  document.getElementById("btnRefreshBalances").onclick=async()=>{
    await refreshPhantomBalances();
    await loadStats();
  };

  // Stats backend + soldes POWCHAIN
  async function loadStats(){
    try{
      const r=await fetch("/stats");
      if(!r.ok)throw new Error("HTTP "+r.status);
      const j=await r.json();
      document.getElementById("statsBox").textContent=JSON.stringify(j,null,2);
      const my=j.wallets && j.wallets[localWallet.pub];
      if(my){
        document.getElementById("powBal").value=my.pow;
        document.getElementById("usdcPowBal").value=my.usdc;
      }
    }catch(e){
      log("POWCHAIN ERR : "+e.message);
    }
  }
  document.getElementById("btnStats").onclick=loadStats;
  loadStats();

  // Bridge SOL → POWCHAIN via Phantom
  async function sendSol(){
    if(!phantomPub){await connectPhantom();if(!phantomPub)return;}
    try{
      const provider=window.solana||window.phantom?.solana;
      const from=new solanaWeb3.PublicKey(phantomPub);
      const to=new solanaWeb3.PublicKey(document.getElementById("treasurySol").value);
      const amount=parseFloat(document.getElementById("bridgeAmount").value||"0.0005");
      if(!(amount>0)){alert("Montant invalide");return;}
      const ix=solanaWeb3.SystemProgram.transfer({
        fromPubkey:from,
        toPubkey:to,
        lamports:Math.round(amount*1e9)
      });
      const {blockhash}=await solConnection.getLatestBlockhash();
      const tx=new solanaWeb3.Transaction({recentBlockhash:blockhash,feePayer:from}).add(ix);
      const signed=await provider.signTransaction(tx);
      const sig=await solConnection.sendRawTransaction(signed.serialize());
      document.getElementById("bridgeSig").value=sig;
      log("Bridge Phantom : TX envoyée "+sig);
      await solConnection.confirmTransaction(sig,"confirmed");
      log("Bridge Phantom : transaction confirmée.");
    }catch(e){
      log("Bridge Phantom ERR : "+e.message);
    }
  }
  document.getElementById("btnSendSol").onclick=sendSol;

  async function declareBridge(){
    try{
      const amount=parseFloat(document.getElementById("bridgeAmount").value||"0.0005");
      const sig=document.getElementById("bridgeSig").value.trim();
      if(!sig){alert("Aucune signature, envoie d'abord le SOL.");return;}
      const body={
        addr:localWallet.pub,
        amount,
        fromSol:phantomPub,
        txSig:sig
      };
      const r=await fetch("/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
      const j=await r.json();
      if(!j.ok){
        log("Bridge backend erreur : "+(j.error||"inconnu"));
      }else{
        log("Bridge backend OK : "+j.credited+" POW crédité (detected "+j.solDetected+" SOL)");
        loadStats();
      }
    }catch(e){
      log("Bridge backend ERR : "+e.message);
    }
  }
  document.getElementById("btnDeclareBridge").onclick=declareBridge;

  // FIREBROWSER
  document.getElementById("btnOpenBrowser").onclick=()=>{
    const url=document.getElementById("firebrowserUrl").value.trim();
    if(!url)return;
    try{
      const u=new URL(url.startsWith("http")?url:"https://"+url);
      document.getElementById("firebrowserFrame").src=u.toString();
      log("FIREBROWSER → "+u.toString());
    }catch(e){
      alert("URL invalide");
    }
  };
</script>
</body>
</html>

  <div id="log"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
<script>
  const API="http://127.0.0.1:3000";          // Nginx reverse proxy renvoie ici
  const WS_URL="wss://bbqfinance.fun/ws";     // WebSocket via Nginx
  const DEC=1e6;
  const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";

  const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

  let addr=null,priv=null,pub=null,nonce=0,sock=null;
  let solConn=null,solAddr=null;
  let whaleBadge=false;

  const q=s=>document.querySelector(s);
  function log(msg){
    const d=q("#log");
    const t=new Date().toLocaleTimeString();
    d.textContent="["+t+"] "+msg+"\n"+d.textContent;
  }
  function fmt(n){return (n/DEC).toFixed(6);}

  // base58
  function b58encode(bytes){
    if(!bytes||!bytes.length)return"";
    let d=[0];
    for(let i=0;i<bytes.length;i++){
      let c=bytes[i];
      for(let j=0;j<d.length;j++){
        let x=d[j]*256+c;
        d[j]=x%58;
        c=(x/58)|0;
      }
      while(c>0){d.push(c%58);c=(c/58)|0;}
    }
    let z=0;
    while(z<bytes.length&&bytes[z]===0)z++;
    let r="";
    for(let i=0;i<z;i++)r+="1";
    for(let i=d.length-1;i>=0;i--)r+=ALPH[d[i]];
    return r;
  }
  function b58decode(str){
    if(!str)return new Uint8Array(0);
    let b=[0];
    for(let i=0;i<str.length;i++){
      let c=ALPH.indexOf(str[i]);
      if(c<0)throw Error("base58 invalide");
      for(let j=0;j<b.length;j++){
        let x=b[j]*58+c;
        b[j]=x&255;
        c=x>>8;
      }
      while(c>0){b.push(c&255);c>>=8;}
    }
    let z=0;
    while(z<str.length&&str[z]==="1")z++;
    let r=new Uint8Array(z+b.length);
    for(let i=0;i<b.length;i++)r[r.length-1-i]=b[i];
    return r;
  }

  async function jget(p){
    const r=await fetch(API+p);
    if(!r.ok)throw Error("HTTP "+r.status);
    return r.json();
  }

  // WS POWCHAIN
  function connectWS(){
    try{
      sock=new WebSocket(WS_URL);
      sock.onopen=()=>{
        log("WebSocket connecté");
        q("#syncText").textContent="Online";
      };
      sock.onclose=()=>{
        log("WS déconnecté");
        q("#syncText").textContent="Reconn";
        setTimeout(connectWS,2000);
      };
      sock.onerror=e=>{
        log("WS erreur: "+(e&&e.message?e.message:"undefined"));
      };
    }catch(e){
      log("WS init err "+e.message);
    }
  }
  connectWS();

  // Network + DEX chart
  const ctx=q("#dexChart").getContext("2d");
  const dexChart=new Chart(ctx,{
    type:"line",
    data:{labels:[],datasets:[{label:"Prix POW (USDC POW)",data:[],tension:0.2}]},
    options:{
      responsive:true,
      maintainAspectRatio:false,
      scales:{
        x:{ticks:{display:false}},
        y:{beginAtZero:false}
      },
      plugins:{legend:{labels:{color:"#e5ecff"}}}
    }
  });

  function updateBadge(){
    q("#lpBadge").textContent=whaleBadge?"Whale LP badge":"Aucun";
  }

  async function refreshNet(){
    try{
      const s=await jget("/stats");
      const h=s.height||0;
      q("#netHeight").textContent=h;
      const lpPow=s.lpPow||0;
      const lpUsdc=s.lpUsdc||0;
      q("#lpPow").textContent=fmt(lpPow);
      q("#lpUsdc").textContent=fmt(lpUsdc);
      q("#dexLpPow").textContent=fmt(lpPow);
      q("#dexLpUsdc").textContent=fmt(lpUsdc);
      const price=(lpPow&&lpUsdc)?(lpUsdc/lpPow/DEC):0;
      q("#netPrice").textContent=price.toFixed(6);
      q("#netTVL").textContent=((lpUsdc||0)/DEC).toFixed(2)+" USDC POW";
      q("#netTreasury").textContent=((s.treasuryUsdc||0)/DEC).toFixed(2)+" USDC POW · "+(s.treasurySol||0).toFixed(3)+" SOL";
      const t=new Date().toLocaleTimeString();
      dexChart.data.labels.push(t);
      dexChart.data.datasets[0].data.push(price);
      if(dexChart.data.labels.length>60){
        dexChart.data.labels.shift();
        dexChart.data.datasets[0].data.shift();
      }
      dexChart.update();
    }catch(e){
      log("NET ERR "+e.message);
    }
  }
  refreshNet();
  setInterval(refreshNet,4000);

  // POWCHAIN wallet
  async function loadWallet(){
    addr=q("#walletAddr").value.trim();
    priv=q("#walletPriv").value.trim();
    if(!addr||!priv){alert("Adresse + clé privée requises");return;}
    const w=await jget("/wallet/"+addr);
    nonce=w.nonce||0;
    pub=w.pub||addr;
    q("#wpow").textContent=fmt(w.pow||0);
    q("#wusdc").textContent=fmt(w.usdc||0);
    q("#wstk").textContent=fmt(w.staked||0);
    log("Wallet POWCHAIN chargé "+addr);
  }
  q("#btnLoad").onclick=loadWallet;
  q("#btnRefreshW").onclick=loadWallet;

  q("#btnGen").onclick=()=>{
    try{
      const kp=nacl.sign.keyPair();
      addr=b58encode(kp.publicKey);
      priv=b58encode(kp.secretKey);
      pub=addr;
      nonce=0;
      q("#walletAddr").value=addr;
      q("#walletPriv").value=priv;
      q("#wpow").textContent="0.000000";
      q("#wusdc").textContent="0.000000";
      q("#wstk").textContent="0.000000";
      log("Nouveau wallet POWCHAIN généré. Sauvegarde la clé privée.");
    }catch(e){
      log("GEN ERR "+e.message);
    }
  };

  function signTx(obj){
    if(!priv)throw Error("Wallet POWCHAIN non connecté");
    const tx={
      type:obj.type,
      from:addr,
      to:obj.to||null,
      amount:obj.amount||null,
      token:obj.token||null,
      nonce:nonce+1
    };
    const msg=new TextEncoder().encode(JSON.stringify(tx));
    const sk=b58decode(priv);
    const sig=nacl.sign.detached(msg,sk);
    tx.sig=b58encode(sig);
    tx.pub=pub||addr;
    return tx;
  }

  function sendTx(obj,desc){
    try{
      const tx=signTx(obj);
      if(sock&&sock.readyState===1){
        sock.send(JSON.stringify(tx));
        nonce++;
        log("TX envoyée "+desc);
      }else{
        log("WS non connecté, TX non envoyée");
      }
    }catch(e){
      log("SIGN ERR "+e.message);
      alert(e.message);
    }
  }

  q("#btnSend").onclick=()=>{
    if(!addr){alert("Connect wallet POWCHAIN");return;}
    const to=q("#sendTo").value.trim();
    const a=parseFloat(q("#sendAmt").value||"0");
    if(!to||a<=0)return;
    sendTx({type:"TX_POW",to,amount:Math.floor(a*DEC)},"POW "+a);
  };

  q("#btnStake").onclick=()=>{
    if(!addr){alert("Connect wallet POWCHAIN");return;}
    const a=parseFloat(q("#stakeAmt").value||"0");
    if(a<=0)return;
    sendTx({type:"STAKE",amount:Math.floor(a*DEC)},"STAKE "+a);
  };

  q("#btnSwap").onclick=()=>{
    if(!addr){alert("Connect wallet POWCHAIN");return;}
    const a=parseFloat(q("#swapAmt").value||"0");
    if(a<=0)return;
    const dir=q("#swapDir").value;
    sendTx({type:"SWAP",amount:Math.floor(a*DEC),token:dir},"SWAP "+dir+" "+a);
  };

  q("#btnLPAdd").onclick=()=>{
    if(!addr){alert("Connect wallet POWCHAIN");return;}
    const p=parseFloat(q("#lpPOW").value||"0");
    const u=parseFloat(q("#lpUSDC").value||"0");
    if(p<=0||u<=0)return;
    if(p>=10000&&u>=10000){
      whaleBadge=true;
      updateBadge();
    }
    sendTx({type:"LP_ADD",pow:Math.floor(p*DEC),usdc:Math.floor(u*DEC)},"LP_ADD");
  };
  updateBadge();

  // Explorer / chain
  q("#btnChain").onclick=async()=>{
    try{
      const c=await jget("/chain");
      const arr=c.chain||[];
      const last=arr.slice(-30).reverse();
      let out="";
      last.forEach(b=>{
        out+="#"+b.index+" "+new Date(b.time).toLocaleTimeString()+" "+(b.txs?b.txs.length:0)+" tx\n";
      });
      q("#chainOut").textContent=out||"Aucun bloc.";
      log("CHAIN ok");
    }catch(e){
      q("#chainOut").textContent="Erreur /chain: "+e.message;
      log("CHAIN ERR "+e.message);
    }
  };

  // Scan wallet POWCHAIN
  q("#btnScan").onclick=async()=>{
    const a=q("#scanAddr").value.trim();
    if(!a)return;
    try{
      const w=await jget("/wallet/"+a);
      q("#scanRes").textContent=
        "POW: "+fmt(w.pow||0)+
        "\nUSDC POW: "+fmt(w.usdc||0)+
        "\nStaked: "+fmt(w.staked||0);
      log("SCAN "+a);
    }catch(e){
      q("#scanRes").textContent="Erreur scan: "+e.message;
      log("SCAN ERR "+e.message);
    }
  };

  // WebHash
  q("#btnWebHash").onclick=async()=>{
    const h=parseInt(q("#whHeight").value||"0");
    if(!h){alert("Hauteur bloc requise");return;}
    try{
      const b=await jget("/block/"+h);
      let out="HASH: "+b.hash+"\nValidator: "+(b.validator||"")+"\nTime: "+(b.time?new Date(b.time).toLocaleString():"")+"\nTXs:\n";
      if(b.txs&&b.txs.length){
        b.txs.forEach(t=>{
          const amt=t.amount?t.amount/DEC:0;
          out+=" - "+t.type+" "+(t.from||"")+" → "+(t.to||"")+" : "+amt.toFixed(6)+" "+(t.token||"")+"\n";
        });
      }else out+="(aucune TX)\n";
      q("#whOut").textContent=out;
      log("WEBHASH "+h);
    }catch(e){
      q("#whOut").textContent="Erreur: "+e.message;
      log("WEBHASH ERR "+e.message);
    }
  };

  // Phantom / Solana
  q("#btnPhantom").onclick=async()=>{
    try{
      const provider=window.solana;
      if(!provider||!provider.isPhantom){
        alert("Phantom non détecté");
        return;
      }
      const resp=await provider.connect();
      solAddr=resp.publicKey.toBase58();
      q("#solAddr").textContent=solAddr;
      solConn=new solanaWeb3.Connection(SOL_RPC,"confirmed");
      const bal=await solConn.getBalance(resp.publicKey);
      q("#solSol").textContent=(bal/1e9).toFixed(6);
      const tokens=await solConn.getParsedTokenAccountsByOwner(resp.publicKey,{mint:new solanaWeb3.PublicKey(USDC_MINT)});
      let usdc=0;
      if(tokens.value.length){
        const info=tokens.value[0].account.data.parsed.info;
        usdc=parseInt(info.tokenAmount.amount,10);
      }
      q("#solUsdc").textContent=(usdc/1e6).toFixed(6);
      log("Phantom connecté "+solAddr);
    }catch(e){
      log("PHANTOM ERR "+e.message);
      alert("Erreur Phantom: "+e.message);
    }
  };

  q("#btnBridge").onclick=()=>{
    if(!solAddr){alert("Connecte Phantom");return;}
    if(!addr){alert("Connecte un wallet POWCHAIN");return;}
    const a=parseFloat(q("#bridgeAmt").value||"0");
    if(a<=0)return;
    const token=q("#bridgeToken").value;
    const amountRaw=token==="SOL"?Math.floor(a*1e9):Math.floor(a*1e6);
    const payload={
      type:"BRIDGE_REQUEST",
      fromSol:solAddr,
      toPow:addr,
      token,
      amountRaw
    };
    try{
      if(sock&&sock.readyState===1){
        sock.send(JSON.stringify(payload));
        log("BRIDGE_REQUEST envoyé "+token+" "+a);
      }else{
        log("WS non connecté, bridge non envoyé");
      }
    }catch(e){
      log("BRIDGE ERR "+e.message);
    }
  };
</script>
</body>
</html>


<!doctype html>
<html lang="fr">
<meta charset="utf-8">
<title>Q+ Standalone Engine</title>
<style>
body{margin:0;background:#05070c;color:#dfe;font-family:system-ui}
#ui{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:10px}
textarea,button{background:#0b1020;color:#9ff;border:1px solid #234;padding:8px;font-size:13px}
button{cursor:pointer}
pre{background:#070b18;border:1px solid #234;padding:8px;overflow:auto}
h3{margin:4px 0;color:#9cf}
small{opacity:.7}
</style>

<div id="ui">
<div>
<h3>Entrée JSON</h3>
<textarea id="input" rows="12">
{
  "metrics":{
    "pnl":0.04,
    "roi":0.28,
    "latency":140,
    "volatility":0.55,
    "errorRate":0.01
  },
  "context":{"arm":true}
}
</textarea>
<button onclick="run()">Évaluer Q+</button>
<button onclick="toggleARM()">ARM ON/OFF</button>
<small id="armState"></small>
</div>

<div>
<h3>Sortie Q+</h3>
<pre id="output"></pre>
</div>

<div style="grid-column:1/3">
<h3>État interne Q+</h3>
<pre id="state"></pre>
</div>

<div style="grid-column:1/3">
<h3>Mémoire (dernières entrées)</h3>
<pre id="memory"></pre>
</div>
</div>

<script>
/* ===== Q+ ENGINE ===== */
const QPLUS=(function(){
let state={
rho:0.5,entropy:0.5,coherence:0.5,
alpha:.33,beta:.33,gamma:.34,
riskPenalty:0,priorities:{short:0,mid:0,long:0},
memory:[],ticks:0
};
const clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));
const log2=x=>Math.log(x)/Math.log(2);
const entropy=p=>p<=0||p>=1?0:-(p*log2(p)+(1-p)*log2(1-p));

function observe(i){
const m=i.metrics||{};
const pnl=clamp((m.pnl||0)+.5);
const roi=clamp(m.roi||0);
const vol=clamp(m.volatility||.5);
const err=clamp(m.errorRate||0);
const lat=clamp((m.latency||0)/1000);
return{
score:pnl*.4+roi*.3+(1-vol)*.2+(1-err)*.1,
risk:vol*.4+err*.4+lat*.2,
arm:i.context?.arm===true
};
}

function adapt(o){
state.alpha=clamp(.5*(1-o.risk));
state.beta=clamp(.3*o.score);
state.gamma=clamp(1-(state.alpha+state.beta));
state.riskPenalty=o.risk;
}

function update(o){
state.rho=clamp(state.rho*.7+o.score*.3);
state.entropy=entropy(state.rho);
state.coherence=clamp(1-state.entropy);
state.priorities.short=clamp(state.alpha*o.score);
state.priorities.mid=clamp(state.beta*state.coherence);
state.priorities.long=clamp(state.gamma*(1-state.riskPenalty));
}

function step(input){
const o=observe(input);
if(!o.arm)return{status:"ARM_OFF"};
adapt(o);update(o);
const out={
time:Date.now(),
rho:+state.rho.toFixed(4),
entropy:+state.entropy.toFixed(4),
coherence:+state.coherence.toFixed(4),
risk:+state.riskPenalty.toFixed(4),
priority:Object.entries(state.priorities).sort((a,b)=>b[1]-a[1])[0][0],
score:Math.round(state.rho*100),
allow:state.riskPenalty<.65,
confidence:+(state.coherence*(1-state.riskPenalty)).toFixed(3)
};
state.memory.push(out);
if(state.memory.length>200)state.memory.shift();
state.ticks++;
save();
return out;
}

function save(){localStorage.qplus=JSON.stringify(state)}
function load(){try{Object.assign(state,JSON.parse(localStorage.qplus||"{}"))}catch{}}

load();
return{step,state:()=>state};
})();

/* ===== UI ===== */
let ARM=true;
function toggleARM(){
ARM=!ARM;
document.getElementById("armState").textContent="ARM="+ARM;
}
toggleARM();

function run(){
try{
const input=JSON.parse(inputEl.value);
input.context=input.context||{};
input.context.arm=ARM;
const r=QPLUS.step(input);
output.textContent=JSON.stringify(r,null,2);
state.textContent=JSON.stringify(QPLUS.state(),null,2);
memory.textContent=JSON.stringify(QPLUS.state().memory.slice(-5),null,2);
}catch(e){output.textContent=e.message}
}

const inputEl=document.getElementById("input");
const output=document.getElementById("output");
const state=document.getElementById("state");
const memory=document.getElementById("memory");
</script>
</html>
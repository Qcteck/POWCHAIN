// server.js – FIREINNERS Validator + API + WebSocket

const express   = require("express");
const bodyParser= require("body-parser");
const http      = require("http");
const WebSocket = require("ws");

// =========================
// CONFIG SERVEUR
// =========================

const HTTP_PORT = 3000;      // Nginx proxy -> 127.0.0.1:3000
const WS_PATH   = "/ws";     // Nginx location /ws proxy_pass http://127.0.0.1:3000/ws

const app    = express();
const server = http.createServer(app);
const wss    = new WebSocket.Server({ server, path: WS_PATH });

app.use(bodyParser.json());

const wsClients = new Set();

// =========================
// CONFIG ECONOMIE FIREINNERS
// =========================

const DEC = 1e6;                                // 6 décimales pour FIRE / USDC FIRE
const SUPPLY_MAX = 100_000_000 * DEC;           // Hard cap 100M FIRE, émis UNIQUEMENT par le bridge
const TREASURY_SOL_ADDRESS = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

// Taux simple FIRE / SOL (tu pourras le complexifier plus tard)
const FIRE_PER_SOL = 1000;                      // 1000 FIRE par SOL

// Frais bridge (en basis points – 1% = 100 bp)
const FEE_BRIDGE_IN_TREAS_BP = 500;            // 5% vers trésorerie
const FEE_BRIDGE_IN_BURN_BP  = 200;            // 2% burn

// =========================
// ETAT GLOBAL
// =========================

let wallets = {};   // addr -> { fire, usdc, nonce }
let treasury = {
  fire: 0,
  usdc: 0,
  sol: 0,           // compta interne (SOL reçus sur la trésorerie on-chain)
  solTreasuryAddress: TREASURY_SOL_ADDRESS
};

let lp = {
  fire: 0,
  usdc: 0
};

let supplyCirculante = 0;     // total FIRE en circulation
let mintedTotal      = 0;     // total FIRE émis par bridge
let burnedTotal      = 0;     // total FIRE brûlé

let chain          = [];      // blocs
let currentEvents  = [];      // événements en attente de bloc
let bridgeHistory  = [];      // liste des bridges (pour /bridge-history)

// =========================
// OUTILS
// =========================

function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = {
      fire: 0,
      usdc: 0,
      nonce: 0
    };
  }
  return wallets[addr];
}

function applyBp(amount, bp) {
  return Math.floor((amount * bp) / 10000);
}

function getFireRatePerSol() {
  // Pour l’instant: taux fixe
  return FIRE_PER_SOL;
}

function mintFire(amount) {
  if (!amount || amount <= 0) return 0;
  const spaceLeft = SUPPLY_MAX - mintedTotal;
  const mintable  = Math.max(0, Math.min(amount, spaceLeft));
  mintedTotal     += mintable;
  supplyCirculante = mintedTotal - burnedTotal;
  return mintable;
}

function burnFire(amount) {
  if (!amount || amount <= 0) return 0;
  const burnable  = Math.min(amount, supplyCirculante);
  burnedTotal    += burnable;
  supplyCirculante = mintedTotal - burnedTotal;
  return burnable;
}

function broadcast(payload) {
  const msg = JSON.stringify(payload);
  for (const ws of wsClients) {
    if (ws.readyState === WebSocket.OPEN) {
      ws.send(msg);
    }
  }
}

function forgeBlock(reason) {
  if (currentEvents.length === 0) return;
  const block = {
    id: chain.length,
    time: Date.now(),
    reason: reason || "auto",
    events: currentEvents.splice(0),
    treasury: { ...treasury },
    lp: { ...lp },
    mintedTotal,
    burnedTotal,
    supplyCirculante
  };
  chain.push(block);
  console.log(`[fireinners] Nouveau bloc #${block.id} (${block.events.length} évènements)`);
  broadcast({ type: "block", block });
}

// Auto-forge toutes les 10 secondes si des events sont présents
setInterval(() => forgeBlock("interval"), 10_000);

// =========================
// HANDLERS ECONOMIQUES
// =========================

// Bridge SOL -> FIREINNERS (entrée)
function processBridgeIn(params) {
  const { addr, solAmount } = params;
  if (!addr) throw new Error("adresse manquante");
  if (!solAmount || solAmount <= 0) throw new Error("solAmount invalide");

  const rate      = getFireRatePerSol();                 // FIRE par SOL
  const fireBrut  = Math.floor(solAmount * rate * DEC);

  const fireMinted = mintFire(fireBrut);
  if (fireMinted <= 0) throw new Error("Supply max atteint");

  const feeTreas = applyBp(fireMinted, FEE_BRIDGE_IN_TREAS_BP);
  const feeBurn  = applyBp(fireMinted, FEE_BRIDGE_IN_BURN_BP);
  const userFire = fireMinted - feeTreas - feeBurn;
  if (userFire <= 0) throw new Error("Bridge net <= 0");

  treasury.fire += feeTreas;
  const burned = burnFire(feeBurn);

  const w = ensureWallet(addr);
  w.fire += userFire;

  treasury.sol += solAmount; // compta interne

  const event = {
    type: "BRIDGE_IN",
    addr,
    solAmount,
    rateFirePerSol: rate,
    fireMinted,
    userFire,
    feeTreasFire: feeTreas,
    burnedFire: burned,
    supplyCirculante,
    supplyDisponible: SUPPLY_MAX - mintedTotal
  };

  currentEvents.push(event);
  bridgeHistory.push(event);

  return event;
}

// =========================
// ROUTES HTTP API
// =========================

// Stats globales (backend indicator + UI)
app.get("/stats", (req, res) => {
  try {
    const tvlFire = lp.fire + treasury.fire + Object.values(wallets).reduce((s, w) => s + w.fire, 0);
    const tvlUsdc = lp.usdc + treasury.usdc + Object.values(wallets).reduce((s, w) => s + w.usdc, 0);

    const supplyDisponible = SUPPLY_MAX - mintedTotal;

    return res.json({
      ok: true,
      height: chain.length,
      wallets: Object.keys(wallets).length,
      treasury,
      lp,
      tvlFire,
      tvlUsdc,
      mintedTotal,
      burnedTotal,
      supplyCirculante,
      supplyDisponible,
      supplyMax: SUPPLY_MAX
    });
  } catch (e) {
    console.error("Erreur /stats :", e);
    return res.status(500).json({ ok: false, error: "Stats error" });
  }
});

// Détail d’un wallet FIREINNERS
app.get("/wallet/:addr", (req, res) => {
  const addr = req.params.addr;
  const w = wallets[addr];
  if (!w) return res.json({ ok: true, addr, fire: 0, usdc: 0 });
  return res.json({ ok: true, addr, fire: w.fire, usdc: w.usdc });
});

// Bloc par index (0 = genesis)
app.get("/block/:i", (req, res) => {
  const i = Number(req.params.i);
  if (Number.isNaN(i) || i < 0 || i >= chain.length) {
    return res.status(400).json({ ok: false, error: "Index bloc invalide" });
  }
  return res.json({ ok: true, block: chain[i] });
});

// Chaîne complète (simple – pour explorer)
app.get("/chain", (req, res) => {
  return res.json({ ok: true, chain });
});

// Historique des bridges (pour bouton explorer bridge)
app.get("/bridge-history", (req, res) => {
  return res.json({ ok: true, bridges: bridgeHistory });
});

// Bridge SOL -> FIREINNERS (appelé par l’UI après TX Phantom)
app.post("/bridge", (req, res) => {
  try {
    const { addr, solAmount } = req.body;
    if (!addr || solAmount === undefined) {
      return res.status(400).json({ ok: false, error: "Params manquants" });
    }

    const sol = Number(solAmount);
    if (!Number.isFinite(sol) || sol <= 0) {
      return res.status(400).json({ ok: false, error: "Montant invalide" });
    }

    const bridgeEvent = processBridgeIn({ addr, solAmount: sol });

    broadcast({ type: "bridge", bridge: bridgeEvent });
    forgeBlock("bridge"); // force un bloc immédiat pour les bridges

    return res.json({ ok: true, bridge: bridgeEvent });
  } catch (e) {
    console.error("❌ Bridge error :", e.message);
    return res.status(400).json({ ok: false, error: e.message });
  }
});

// =========================
// WEBSOCKET
// =========================

wss.on("connection", (ws) => {
  wsClients.add(ws);
  console.log("[fireinners] WS client connecté, total =", wsClients.size);

  // snapshot de base
  ws.send(
    JSON.stringify({
      type: "hello",
      msg: "FIREINNERS WS connecté",
      height: chain.length
    })
  );

  ws.on("close", () => {
    wsClients.delete(ws);
    console.log("[fireinners] WS client déconnecté, total =", wsClients.size);
  });

  ws.on("error", (err) => {
    console.error("[fireinners] WS error:", err.message);
  });
});

// =========================
// GENESIS
// =========================

(function initGenesis() {
  const genesis = {
    id: 0,
    time: Date.now(),
    reason: "genesis",
    events: [],
    treasury: { ...treasury },
    lp: { ...lp },
    mintedTotal,
    burnedTotal,
    supplyCirculante
  };
  chain.push(genesis);
  console.log("[fireinners] Genesis initialisée, supply = 0 FIRE (tout vient du bridge).");
})();

// =========================
// LANCEMENT SERVEUR
// =========================

server.listen(HTTP_PORT, () => {
  console.log("FIREINNERS Validator prêt – HTTP + WS sur port", HTTP_PORT);
  console.log("Trésorerie SOL on-chain :", TREASURY_SOL_ADDRESS);
});




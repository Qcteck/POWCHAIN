<!doctype html><html lang="fr"><head>
<meta charset="utf-8"/><meta name="viewport"content="width=device-width,initial-scale=1"/>
<title>POWCHAIN — FIREINNERS PANEL</title>
<style>
body{margin:0;font-family:system-ui;-apple-system;background:#080009;color:#eee;overflow:hidden}
#app{display:flex;height:100vh;width:100vw}
#side{width:240px;background:#11000f;border-right:1px solid #3a1a25;padding:20px 14px;display:flex;flex-direction:column;gap:14px}
#logoTxt{color:#ffcf70;font-weight:700;font-size:16px;text-shadow:0 0 12px #ff9a2f}
nav a{display:block;padding:10px 12px;color:#e8d8ff;border:1px solid #432141;border-radius:12px;background:#12000f;margin-bottom:8px;text-decoration:none;font-size:13px}
nav a.active{background:#ff9a2f;color:#000;font-weight:700}
#main{flex:1;display:flex;flex-direction:column;background:#0b0009}
#top{padding:12px 16px;border-bottom:1px solid #3a1a25;display:flex;justify-content:space-between;align-items:center}
#ticker{font-size:13px;color:#ffcf70;text-shadow:0 0 6px #ff9a2f}
#syncState{padding:6px 12px;border-radius:12px;border:1px solid #ff9a2f;color:#ffcf70;font-size:12px}
#content{flex:1;overflow:auto;padding:20px}
.card{background:#15000f;border:1px solid #432141;border-radius:14px;padding:14px;margin-bottom:18px;box-shadow:0 0 18px #000 inset}
.card h2{margin:0 0 10px;font-size:14px;color:#ffcf70;text-transform:uppercase}
input,button{width:100%;padding:8px;margin:4px 0;border-radius:8px;border:1px solid #55304c;background:#0b0007;color:#ffdede}
button{background:#ff9a2f;color:#000;font-weight:700;border-color:#ffcf50;cursor:pointer}
button:hover{filter:brightness(1.15)}
#log{background:#0b0005;height:160px;overflow:auto;padding:8px;border-radius:10px;font-size:12px;color:#ffeaa6;border:1px solid #432141}
#qr{width:130px;height:130px;background:#fff}
.section{display:none}
.section.active{display:block}
</style></head>
<body>
<div id="app">

<!-- ============== MENU ============== -->
<aside id="side">
<div id="logoTxt">FIREINNERS</div>
<nav>
<a class="navitem active" data-tab="wallet">Wallet</a>
<a class="navitem" data-tab="bridge">Bridge</a>
<a class="navitem" data-tab="dex">DEX</a>
<a class="navitem" data-tab="stake">Staking</a>
<a class="navitem" data-tab="explorer">Explorer</a>
<a class="navitem" data-tab="mempool">Mempool</a>
<a class="navitem" data-tab="stats">Stats</a>
</nav>
</aside>

<!-- ============== MAIN ============== -->
<main id="main">
<div id="top">
<div id="ticker">Chargement prix...</div>
<div id="syncState">WS: offline</div>
</div>

<div id="content">

<!-- ================================== WALLET ================================== -->
<div class="section active" id="wallet">
<div class="card"><h2>Phantom Solana</h2>
<label>Adresse Solana</label><input id="solAddr" readonly>
<label>SOL</label><input id="solBal" readonly>
<label>USDC</label><input id="usdcBal" readonly>
<button id="btnPhantom">Connecter Phantom</button>
<button id="btnSolRefresh">Rafraîchir soldes</button>
</div>

<div class="card"><h2>Wallet POWCHAIN Local</h2>
<button id="btnGen">Générer un wallet POWCHAIN</button>
<button id="btnReloadPow">Recharger balances</button>
<button id="btnReconnectLocal">Recharger depuis stockage local</button>

<label>Adresse POWCHAIN</label><input id="powAddr" readonly>
<label>Clé privée</label><input id="powPriv" readonly>
<canvas id="qr"></canvas>

<label>POW</label><input id="powBal" readonly>
<label>USDC POW</label><input id="powUSDCBal" readonly>

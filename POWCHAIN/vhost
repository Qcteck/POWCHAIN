// Stats globales (pour indicateur HTTP OK)
app.get("/stats", (req, res) => {
  try {
    const tvl = getTVL();
    res.json({
      ok: true,
      height: chain.length ? chain[chain.length - 1].height : 0,
      wallets: Object.keys(wallets).length,
      treasuryFire: treasury.fire,
      treasuryUsdc: treasury.usdc,
      treasurySol:  treasury.sol,
      supplyCirculante,
      mintedFireTotal,
      burnedFireTotal,
      lpFire: lp.fire,
      lpUsdc: lp.usdc,
      lpPrice: getLpPrice(),
      tvl
    });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// Explorer global simple
app.get("/chain", (req, res) => {
  res.json({ ok: true, chain });
});

// Explorer complet (chain + wallets + bridges)
app.get("/explorer", (req, res) => {
  res.json({
    ok: true,
    chain,
    wallets,
    treasury,
    lp,
    tvl: getTVL(),

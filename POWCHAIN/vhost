<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script>
  const API = "https://bbqfinance.fun";
  const WS_URL = "wss://bbqfinance.fun/ws";
  const SOL_RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
  const ALPH = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  const DEC = 1e6;

  const q = s => document.querySelector(s);
  const log = t => {
    const b = q("#log");
    const line = `[${new Date().toLocaleTimeString()}] ${t}`;
    b.innerHTML = line + "<br>" + b.innerHTML;
    b.scrollTop = 0;
  };

  let solAddr = null;
  let powAddr = null;
  let powPriv = null;
  let powNonce = 0;
  let sock = null;

  /* Base58 util */
  function b58enc(bytes){
    let d=[0];
    for(let i=0;i<bytes.length;i++){
      let c=bytes[i];
      for(let j=0;j<d.length;j++){
        let x=d[j]*256+c;d[j]=x%58;c=(x/58)|0;
      }
      while(c>0){d.push(c%58);c=(c/58)|0;}
    }
    let r="";for(let k=d.length-1;k>=0;k--)r+=ALPH[d[k]];
    return r;
  }
  function b58dec(str){
    let b=[0];
    for(let i=0;i<str.length;i++){
      let c=ALPH.indexOf(str[i]);
      for(let j=0;j<b.length;j++){
        let x=b[j]*58+c;b[j]=x&255;c=x>>8;
      }
      while(c>0){b.push(c&255);c>>=8;}
    }
    return new Uint8Array(b.reverse());
  }

  /* QR pseudo-random visuel */
  function drawQR(text){
    const cv=q("#qr");if(!cv)return;
    const ctx=cv.getContext("2d");
    const s=cv.width;
    ctx.fillStyle="#050008";ctx.fillRect(0,0,s,s);
    if(!text){ctx.strokeStyle="#ffcf5c55";ctx.strokeRect(8,8,s-16,s-16);return;}
    ctx.fillStyle="#ffcf5c";
    const hash=[...text].reduce((a,c)=>(a*31+c.charCodeAt(0))>>>0,1);
    const size=21;const cell=s/size;let rnd=hash;
    for(let y=0;y<size;y++){
      for(let x=0;x<size;x++){
        rnd=(rnd*1103515245+12345)>>>0;
        if(rnd&0x80000000){ctx.fillRect(x*cell+1,y*cell+1,cell-2,cell-2);}
      }
    }
    ctx.strokeStyle="#ff9a2f";ctx.lineWidth=2;ctx.strokeRect(3,3,s-6,s-6);
  }
  drawQR("");

  /* Alias FIREINNERS */
  const COLORS = [
    "vert","or","blanc","noir","rouge","argent",
    "mauve","orange","gris","jaune","violet"
  ];
  function pickColor(){
    const r=Math.random();
    if(r<0.01)return "gold";
    if(r<0.03)return "army";
    if(r<0.06)return "multicolore";
    return COLORS[Math.floor(Math.random()*COLORS.length)];
  }
  function randCode(){
    const chars="ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
    let out="";for(let i=0;i<4;i++)out+=chars[Math.floor(Math.random()*chars.length)];
    return out;
  }
  function makeAlias(){
    const num=Math.floor(1+Math.random()*100000000); // 1 à 100M
    const code=randCode();
    const col=pickColor();
    return `FIRE-441-${num}-${code}-${col}`;
  }

  /* Phantom connect + soldes */
  async function connectPhantom(){
    try{
      const p=window.solana;
      if(!p || !p.isPhantom){alert("Phantom non détecté");return;}
      const resp=await p.connect();
      solAddr=resp.publicKey.toString();
      q("#solAddr").value=solAddr;
      log("Phantom connecté : "+solAddr);
      await loadSolBalances();
    }catch(e){log("Erreur Phantom : "+e.message);}
  }

  async function loadSolBalances(){
    if(!solAddr)return;
    try{
      const r=await fetch(SOL_RPC,{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]})
      });
      const j=await r.json();
      if(!j.result || typeof j.result.value!=="number") throw new Error("RPC balance invalide");
      const lam=j.result.value;
      q("#solBal").value=(lam/1e9).toFixed(4);

      const r2=await fetch(SOL_RPC,{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
          jsonrpc:"2.0",id:2,method:"getTokenAccountsByOwner",
          params:[solAddr,{mint:USDC_MINT},{encoding:"jsonParsed"}]
        })
      });
      const j2=await r2.json();
      let total=0;
      (j2.result && j2.result.value || []).forEach(a=>{
        const v=a.account && a.account.data && a.account.data.parsed &&
                a.account.data.parsed.info && a.account.data.parsed.info.tokenAmount &&
                a.account.data.parsed.info.tokenAmount.uiAmount || 0;
        total+=v;
      });
      q("#usdcBal").value=total.toFixed(2);
    }catch(e){log("Sol ERR : "+e.message);}
  }

  q("#btnPhantom").onclick=connectPhantom;
  q("#btnSolRefresh").onclick=loadSolBalances;

  /* Wallet POWCHAIN local */
  q("#btnGen").onclick=()=>{
    const kp=nacl.sign.keyPair();
    powAddr=b58enc(kp.publicKey);
    powPriv=b58enc(kp.secretKey);
    powNonce=0;
    q("#powAddr").value=powAddr;
    q("#powPriv").value=powPriv;
    q("#powAlias").value=makeAlias();
    drawQR(powAddr);
    log("Wallet POWCHAIN généré et alias FIREINNERS créé");
    localStorage.setItem("fireinners_wallet",JSON.stringify({
      addr:powAddr,priv:powPriv,alias:q("#powAlias").value
    }));
  };

  async function loadPowWallet(){
    if(!powAddr||!powPriv){alert("Wallet POWCHAIN requis");return;}
    try{
      const r=await fetch(`${API}/wallet/${powAddr}`);
      if(!r.ok)throw Error("HTTP "+r.status);
      const w=await r.json();
      powNonce=w.nonce||0;
      q("#powBal").value=(w.pow/DEC).toFixed(6);
      q("#powUSDCBal").value=(w.usdc/DEC).toFixed(6);
      q("#powStakeBal").value=(w.staked/DEC).toFixed(6);
      q("#powNonce").value=powNonce;
      q("#stakeView").value=(w.staked/DEC).toFixed(6);
      log("Wallet POWCHAIN chargé");
    }catch(e){log("Load POW ERR : "+e.message);}
  }
  q("#btnReloadPow").onclick=loadPowWallet;

  /* Reload wallet depuis localStorage au chargement */
  (function restoreLocal(){
    try{
      const raw=localStorage.getItem("fireinners_wallet");
      if(!raw)return;
      const w=JSON.parse(raw);
      if(!w.addr||!w.priv)return;
      powAddr=w.addr;powPriv=w.priv;
      q("#powAddr").value=powAddr;
      q("#powPriv").value=powPriv;
      q("#powAlias").value=w.alias||makeAlias();
      drawQR(powAddr);
      log("Wallet FIREINNERS restauré depuis le stockage local");
    }catch(e){}
  })();

  function signTxBase(payload){
    if(!powAddr||!powPriv){alert("Wallet POWCHAIN requis");return null;}
    const msgObj={
      type:payload.type,
      from:powAddr,
      to:payload.to||null,
      amount:payload.amount||null,
      token:payload.token||null,
      dir:payload.dir||null,
      nonce:powNonce+1
    };
    const msg=new TextEncoder().encode(JSON.stringify(msgObj));
    const sk=b58dec(powPriv);
    const sig=nacl.sign.detached(msg,sk);
    return {tx:{...msgObj},sig:b58enc(sig)};
  }

  /* Bridge Phantom : envoi SOL + bridge */
  q("#btnBridgePhantom").onclick=async()=>{
    if(!solAddr){alert("Connecte Phantom d'abord");return;}
    if(!powAddr){alert("Génère un wallet FIREINNERS d'abord");return;}
    const amt=parseFloat(q("#bridgeAmt").value||"0");
    if(!(amt>0)){log("Bridge : montant SOL invalide");return;}

    try{
      const conn=new solanaWeb3.Connection(SOL_RPC,"confirmed");
      const fromPub=new solanaWeb3.PublicKey(solAddr);
      const toPub=new solanaWeb3.PublicKey(q("#treasurySol").value.trim());
      const tx=new solanaWeb3.Transaction().add(
        solanaWeb3.SystemProgram.transfer({
          fromPubkey:fromPub,
          toPubkey:toPub,
          lamports:Math.round(amt*1e9)
        })
      );
      tx.feePayer=fromPub;
      const {blockhash}=await conn.getLatestBlockhash();
      tx.recentBlockhash=blockhash;

      log("Bridge Phantom : ouverture de la fenêtre de signature...");
      const signed=await window.solana.signAndSendTransaction(tx);
      const sig=signed.signature || signed; // Phantom peut renvoyer string
      const sigStr=(typeof sig==="string")?sig:bs58.encode(sig);
      q("#bridgeSig").value=sigStr;
      log("Bridge Phantom : TX envoyée "+sigStr);

      const body={addr:powAddr,amount:amt,fromSol:solAddr,txSig:sigStr};
      const r=await fetch(`${API}/bridge`,{
        method:"POST",headers:{"Content-Type":"application/json"},
        body:JSON.stringify(body)
      });
      const j=await r.json().catch(()=>({}));
      if(!r.ok||j.ok===false){
        log("Bridge backend erreur : "+(j.error||("HTTP "+r.status)));
      }else{
        log("Bridge validé : "+(j.credited/DEC).toFixed(4)+" POW crédités");
        loadPowWallet();
      }
    }catch(e){log("Bridge Phantom erreur : "+e.message);}
  };

  /* DEX & LP */
  q("#btnSwap").onclick=()=>{
    if(!powAddr){alert("Wallet POWCHAIN requis");return;}
    const a=parseFloat(q("#swapAmt").value||"0");
    if(!(a>0)){log("Swap : montant invalide");return;}
    const dir=q("#swapDir").value;
    const base=signTxBase({type:"SWAP",amount:Math.floor(a*DEC),dir});
    if(!base)return;
    const tx={
      type:"SWAP",from:powAddr,dir,
      amount:Math.floor(a*DEC),nonce:base.tx.nonce,sig:base.sig
    };
    sock&&sock.readyState===WebSocket.OPEN&&sock.send(JSON.stringify(tx));
    powNonce++;q("#powNonce").value=powNonce;
    log("Swap TX envoyée ("+dir+")");
  };

  q("#btnLPAdd").onclick=()=>{
    if(!powAddr){alert("Wallet POWCHAIN requis");return;}
    const p=parseFloat(q("#lpAddPow").value||"0");
    const u=parseFloat(q("#lpAddUsdc").value||"0");
    if(!(p>0&&u>0)){log("LP_ADD : montants invalides");return;}
    fetch(`${API}/lp/add`,{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,pow:Math.floor(p*DEC),usdc:Math.floor(u*DEC)})
    }).then(r=>r.json()).then(j=>{
      if(!j.ok){log("LP_ADD ERR : "+(j.error||"unknown"));return;}
      log("LP_ADD confirmé");loadPowWallet();refreshStats();
    }).catch(e=>log("LP_ADD HTTP ERR : "+e.message));
  };

  /* STAKE */
  q("#btnStake").onclick=()=>{
    if(!powAddr){alert("Wallet POWCHAIN requis");return;}
    const a=parseFloat(q("#stakeAmt").value||"0");
    if(!(a>0)){log("Stake : montant invalide");return;}
    fetch(`${API}/stake`,{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,amount:Math.floor(a*DEC)})
    }).then(r=>r.json()).then(j=>{
      if(!j.ok){log("Stake ERR : "+(j.error||"unknown"));return;}
      log("Stake confirmé");loadPowWallet();refreshStats();
    }).catch(e=>log("Stake HTTP ERR : "+e.message));
  };

  /* Explorer */
  q("#btnBlock").onclick=async()=>{
    const h=parseInt(q("#blockInp").value||"0");
    if(!(h>0))return;
    try{
      const r=await fetch(`${API}/block/${h}`);
      const b=await r.json();
      q("#blockOut").textContent=JSON.stringify(b,null,2);
    }catch(e){q("#blockOut").textContent="Erreur : "+e.message;}
  };

  /* Stats */
  async function refreshStats(){
    try{
      const r=await fetch(`${API}/stats`);
      const s=await r.json();
      q("#sHeight").value=s.height;
      q("#sWallets").value=s.wallets;
      q("#sPOW").value=s.totalPow;
      q("#sStaked").value=s.totalStaked;
      q("#sMP").value=s.mempool;
      q("#sLPpow").value=s.lpPow;
      q("#sLPusdc").value=s.lpUsdc;
      q("#sTSol").value=s.solTreasury;
      q("#sTUsdc").value=s.usdcTreasury;
      q("#sTFire").value=s.fireTreasury;
      q("#lpPow").value=s.lpPow;
      q("#lpUsdc").value=s.lpUsdc;
    }catch(e){log("Stats ERR : "+e.message);}
  }
  setInterval(refreshStats,5000);
  refreshStats();

  /* WebSocket */
  function connectWS(){
    try{
      sock&&sock.close();
      sock=new WebSocket(WS_URL);
      sock.onopen=()=>{
        q("#syncState").textContent="WS: online";
        q("#syncState").style.borderColor="#5bffbf";
        q("#syncState").style.color="#dfffee";
        log("WS connecté");
      };
      sock.onclose=()=>{
        q("#syncState").textContent="WS: offline";
        q("#syncState").style.borderColor="#ff9a2f";
        q("#syncState").style.color="#ffe2b0";
        log("WS fermé, reconnexion dans 3s...");
        setTimeout(connectWS,3000);
      };
      sock.onerror=e=>log("WS erreur "+(e&&e.message||""));
      sock.onmessage=e=>{
        try{
          const m=JSON.parse(e.data);
          if(m.type==="mempool"){
            q("#mempoolLive").textContent=JSON.stringify(m.mempool,null,2);
          }else if(m.type==="clients"){
            log("WS clients connectés : "+m.count);
          }else if(m.type==="new_block"){
            log("Nouveau bloc #"+m.block.height);
          }
        }catch(err){}
      };
    }catch(e){log("WS fatal : "+e.message);}
  }
  connectWS();

  /* Navigation */
  document.querySelectorAll(".navitem").forEach(a=>{
    a.onclick=()=>{
      document.querySelectorAll(".navitem").forEach(x=>x.classList.remove("active"));
      a.classList.add("active");
      const tab=a.dataset.tab;
      document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
      q("#"+tab).classList.add("active");
    };
  });

  /* Ticker prix */
  async function loadPrices(){
    try{
      const r=await fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd");
      const p=await r.json();
      const btc=p.bitcoin?p.bitcoin.usd:"-";
      const eth=p.ethereum?p.ethereum.usd:"-";
      const sol=p.solana?p.solana.usd:"-";
      const sui=p.sui?p.sui.usd:"-";
      const fire="N/A";
      q("#priceTicker").textContent=`BTC $${btc} • ETH $${eth} • SOL $${sol} • SUI $${sui} • FIREINNERS ${fire}`;
    }catch(e){
      q("#priceTicker").textContent="Prix indisponible (API Coingecko)";
    }
  }
  loadPrices();
  setInterval(loadPrices,60000);

  /* RSS news bandeau */
  async function loadNews(){
    try{
      const feed="https://www.coindesk.com/arc/outboundfeeds/rss/";
      const r=await fetch("https://api.allorigins.win/get?url="+encodeURIComponent(feed));
      const j=await r.json();
      const parser=new DOMParser();
      const xml=parser.parseFromString(j.contents,"text/xml");
      const items=[...xml.querySelectorAll("item")].slice(0,10);
      const titles=items.map(it=>it.querySelector("title")?.textContent||"").filter(Boolean);
      q("#newsInner").textContent=titles.join(" • ");
    }catch(e){
      q("#newsInner").textContent="Flux RSS crypto indisponible pour le moment.";
    }
  }
  loadNews();
</script>
</body>
</html>



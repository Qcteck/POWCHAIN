    if(!dexChart){
      const ctx=document.getElementById("chartDex");
      dexChart=new Chart(ctx,{type:"line",data:{labels:dexHistory.map(p=>p.t),datasets:[{data:dexHistory.map(p=>p.price)}]},options:{plugins:{legend:{display:false}},scales:{x:{ticks:{maxTicksLimit:4}}}});
    }else{
      dexChart.data.labels=dexHistory.map(p=>p.t);
      dexChart.data.datasets[0].data=dexHistory.map(p=>p.price);
      dexChart.update();
    }
  }

  function cryptoGetRandom(n){
    const arr=new Uint8Array(n);
    if(window.crypto&&crypto.getRandomValues)crypto.getRandomValues(arr);else for(let i=0;i<n;i++)arr[i]=Math.floor(Math.random()*256);
    return arr;
  }
  function genWallet(){
    const bytes=cryptoGetRandom(32);
    const priv=btoa(String.fromCharCode(...bytes));
    const pub="FIW"+Array.from(bytes.slice(0,16)).map(b=>b.toString(16).padStart(2,"0")).join("");
    addrPow=pub;privPow=priv;
    localStorage.setItem("fireinners_addr",addrPow);
    localStorage.setItem("fireinners_priv",privPow);
    el("addrPowchain").value=addrPow;
    el("privPowchain").value=privPow;
    log("Nouveau wallet FIREINNERS généré.");
    if(wsOpen)ws.send(JSON.stringify({type:"HELLO",addr:addrPow}));
  }
  function loadWallet(){
    const a=localStorage.getItem("fireinners_addr");
    const p=localStorage.getItem("fireinners_priv");
    if(a&&p){addrPow=a;privPow=p;el("addrPowchain").value=a;el("privPowchain").value=p;log("Wallet FIREINNERS restauré.");}
  }

  async function connectPhantom(){
    try{
      const provider=window.solana;
      if(!provider||!provider.isPhantom){alert("Phantom non détecté");return;}
      const res=await provider.connect();solPub=res.publicKey;el("addrSol").textContent=solPub.toBase58();log("Phantom connecté "+solPub.toBase58());
      solConn=new solanaWeb3.Connection(RPC_URL,"confirmed");
      await refreshSol();
    }catch(e){alert("Erreur Phantom: "+e.message);log("Erreur Phantom: "+e.message);}
  }
  async function refreshSol(){
    try{
      if(!solConn||!solPub)return;
      const lamports=await solConn.getBalance(solPub);
      el("balSol").textContent=(lamports/solanaWeb3.LAMPORTS_PER_SOL).toFixed(4);
      const tok=await solConn.getParsedTokenAccountsByOwner(solPub,{programId:new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")});
      let usdc=0;tok.value.forEach(a=>{const info=a.account.data.parsed.info;if(info.mint===USDC_MINT){usdc+=Number(info.tokenAmount.uiAmount||0);}});
      el("balSolUsdc").textContent=usdc.toFixed(2);
      log("SOL/USDC mis à jour.");
    }catch(e){log("Erreur RPC Solana: "+e.message);}
  }
  async function bridgeToPowchain(){
    if(!addrPow){alert("Wallet FIREINNERS requis");return;}
    if(!solPub){alert("Connecte Phantom d'abord");return;}
    const amt=Number(el("bridgeAmount").value||"0");if(!(amt>0)){alert("Montant invalide");return;}
    const asset=el("bridgeAsset").value;
    if(!wsOpen){alert("WebSocket non connecté");return;}
    const msg={type:"BRIDGE_REQUEST",asset,amount:amt,fromSol:solPub.toBase58(),toPow:addrPow};
    ws.send(JSON.stringify(msg));
    log("BRIDGE_REQUEST "+amt+" "+asset+" vers "+addrPow);
  }

  function sendTx(kind,payload){
    if(!wsOpen){alert("WS non connecté");return;}
    if(!addrPow){alert("Wallet FIREINNERS requis");return;}
    ws.send(JSON.stringify({type:kind,addr:addrPow,priv:privPow,...payload}));
  }

  window.addEventListener("load",()=>{
    loadWallet();
    connectWs();
    fetchStats();
    setInterval(fetchStats,4000);
  });
  el("btnGen").onclick=genWallet;
  el("btnConnectPow").onclick=()=>{if(!addrPow)genWallet();if(wsOpen)ws.send(JSON.stringify({type:"HELLO",addr:addrPow}));log("HELLO envoyé.");fetchWallet();};
  el("btnRefreshPow").onclick=fetchWallet;
  el("btnBlocks").onclick=fetchChain;
  el("btnSend").onclick=()=>{
    const to=el("sendTo").value.trim();const amount=Number(el("sendAmount").value||"0");
    if(!to||!(amount>0)){alert("Destinataire ou montant invalide");return;}
    sendTx("TX_SEND",{to,amount});
  };
  el("btnStake").onclick=()=>{
    const amount=Number(el("stakeAmount").value||"0");if(!(amount>0)){alert("Montant invalide");return;}
    sendTx("TX_STAKE",{amount});
  };
  el("btnAddLp").onclick=()=>{
    const pow=Number(el("lpInPow").value||"0");const usdc=Number(el("lpInUsdc").value||"0");
    if(!(pow>0&&usdc>0)){alert("Montants LP invalides");return;}
    sendTx("TX_ADD_LP",{pow,usdc});
    if(pow>=10000&&usdc>=10000){el("badgeWhale").textContent="WHALE";el("badgeWhale").classList.remove("off");}
  };
  el("btnSwap").onclick=()=>{
    const amount=Number(el("swapAmount").value||"0");if(!(amount>0)){alert("Montant invalide");return;}
    const dir=el("swapPair").value;
    sendTx("TX_SWAP",{amount,dir});
  };
  el("btnPhantom").onclick=connectPhantom;
  el("btnRefreshSol").onclick=refreshSol;
  el("btnBridge").onclick=bridgeToPowchain;
})();
</script>
</body>
</html>




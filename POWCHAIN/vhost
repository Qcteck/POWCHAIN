        <!-- BRIDGE -->
        <div class="section" id="bridge">
          <div class="card">
            <h2>Bridge SOL → POWCHAIN</h2>
            <label>Adresse de trésorerie Solana</label>
            <input readonly value="BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy">
            <label>Montant en SOL à envoyer</label>
            <input id="bridgeAmt" placeholder="0.01">
            <button id="btnBridge">Envoyer via serveur</button>
            <p style="font-size:12px;color:#ffce54;margin-top:8px">
              Lorsque tu envoies du SOL vers la trésorerie, le backend crédite ton wallet POWCHAIN en POW (après validation manuelle côté Solana).
            </p>
          </div>
        </div>

        <!-- DEX -->
        <div class="section" id="dex">
          <div class="card">
            <h2>Swap DEX interne</h2>
            <label>Montant</label>
            <input id="swapAmt" placeholder="10">
            <label>Direction</label>
            <select id="swapDir">
              <option value="pow2usdc">POW ➜ USDC POW</option>
              <option value="usdc2pow">USDC POW ➜ POW</option>

<script>
const API = "https://bbqfinance.fun";
const WS_URL = "wss://bbqfinance.fun/ws";
const DEC = 1e6;
const SOL_RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
let sock = null;
let fiAddr = null;
let fiPriv = null;
let fiNonce = 0;
let phantomPub = null;

const q = s => document.querySelector(s);
const log = m => {
  const b = q("#log");
  if(!b) return;
  const ts = new Date().toLocaleTimeString();
  b.textContent = "["+ts+"] "+m+"\n"+b.textContent;
};
const fmt = n => (n/DEC).toFixed(6);

async function jget(path){
  const url = API + path;
  const t0 = performance.now();
  const res = await fetch(url);
  const t1 = performance.now();
  const api = q("#chipAPI");
  const apiLabel = q("#chipAPILabel");
  if(res.ok){
    api.classList.remove("off");
    apiLabel.textContent = "API "+(t1-t0).toFixed(0)+" ms";
    q("#statusAPI").textContent = "OK";
    q("#statusAPI").className = "ok";
  }else{
    api.classList.add("off");
    apiLabel.textContent = "API ERR";
    q("#statusAPI").textContent = "HTTP "+res.status;
    q("#statusAPI").className = "bad";
  }
  if(!res.ok) throw new Error("HTTP "+res.status);
  return res.json();
}

async function jpost(path,body){
  const url = API + path;
  const res = await fetch(url,{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify(body)
  });
  if(!res.ok) throw new Error("HTTP "+res.status);
  return res.json();
}

function connectWS(){
  try{
    sock = new WebSocket(WS_URL);
    const chip = q("#chipWS");
    const chipLabel = q("#chipWSLabel");
    sock.onopen = () => {
      chip.classList.remove("off");
      chipLabel.textContent = "WS Connected";
      q("#statusWS").textContent = "Connected";
      q("#statusWS").className = "ok";
      log("WS connecté");
    };
    sock.onclose = () => {
      chip.classList.add("off");
      chipLabel.textContent = "WS Closed";
      q("#statusWS").textContent = "Closed";
      q("#statusWS").className = "bad";
      log("WS fermé, retry dans 2s");
      setTimeout(connectWS,2000);
    };
    sock.onerror = () => {
      chip.classList.add("off");
      chipLabel.textContent = "WS Error";
      q("#statusWS").textContent = "Error";
      q("#statusWS").className = "bad";
    };
    sock.onmessage = ev => {
      try{
        const msg = JSON.parse(ev.data);
        if(msg.type==="statsPush") applyStats(msg.stats);
        if(msg.type==="log") log(msg.text||"WS log");
      }catch(e){}
    };
  }catch(e){
    log("WS ERR "+e.message);
  }
}
connectWS();

function applyStats(s){
  if(!s) return;
  q("#netHeight").textContent = s.height ?? 0;
  q("#statusHeight").textContent = s.height ?? 0;
  const supply = s.supplyFIRE ?? 0;
  q("#statusSupply").textContent = fmt(supply)+" FIRE";
  q("#netLPFire").textContent = fmt(s.lpFIRE||0);
  q("#netLPUsdc").textContent = fmt(s.lpUSDCFIRE||0);
  q("#dexLPFire").textContent = fmt(s.lpFIRE||0);
  q("#dexLPUsdc").textContent = fmt(s.lpUSDCFIRE||0);
  const tvl = (s.lpUSDCFIRE||0)/DEC;
  q("#netTVL").textContent = tvl.toFixed(2)+" USDC FIRE";
  q("#statusTVL").textContent = tvl.toFixed(2)+" USDC FIRE";
  const price = (s.lpFIRE && s.lpUSDCFIRE) ? (s.lpUSDCFIRE/s.lpFIRE/DEC).toFixed(6) : "0.000000";
  q("#netPrice").textContent = price;
  const tres = ((s.treasuryUsdc||0)/DEC).toFixed(2)+" USDC FIRE";
  const tresSol = (s.treasurySol??0).toFixed(3)+" SOL";
  const trestext = tres+" · "+tresSol;
  q("#netTreasury").textContent = trestext;
  q("#statusTreasury").textContent = trestext;
}

async function refreshStats(){
  try{
    const s = await jget("/stats");
    applyStats(s);
  }catch(e){
    log("Stats ERR "+e.message);
  }
}
setInterval(refreshStats,5000);
refreshStats();

function b58encode(bytes){
  if(!bytes||!bytes.length) return "";
  const ALPH = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  let d = [0];
  for(let i=0;i<bytes.length;i++){
    let c = bytes[i];
    for(let j=0;j<d.length;j++){
      let x = d[j]*256+c;
      d[j]=x%58;
      c=(x/58)|0;
    }
    while(c>0){
      d.push(c%58);
      c=(c/58)|0;
    }
  }
  let z=0;
  while(z<bytes.length && bytes[z]===0) z++;
  let r="";
  for(let i=0;i<z;i++) r+="1";
  for(let i=d.length-1;i>=0;i--) r+=ALPH[d[i]];
  return r;
}

function b58decode(str){
  const ALPH = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  if(!str) return new Uint8Array(0);
  let b=[0];
  for(let i=0;i<str.length;i++){
    let c=ALPH.indexOf(str[i]);
    if(c<0) throw new Error("base58 invalide");
    for(let j=0;j<b.length;j++){
      let x=b[j]*58+c;
      b[j]=x&255;
      c=x>>8;
    }
    while(c>0){
      b.push(c&255);
      c>>=8;
    }
  }
  let z=0;
  while(z<str.length && str[z]==="1") z++;
  let r=new Uint8Array(z+b.length);
  for(let i=0;i<b.length;i++) r[r.length-1-i]=b[i];
  return r;
}


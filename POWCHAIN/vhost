// POWCHAIN — Validator Node Officiel (Version A)
// PoS • Mempool • Production de blocs • LP • Wallets • Bridge SOL • WebSocket • API 3000
// Version mémorisée (2025-11-21)

// Dépendances
const express = require("express");
const cors = require("cors");
const http = require("http");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const crypto = require("crypto");
const fs = require("fs");

// Stockage chaîne (LevelDB simplifié → JSON local)
const DB_FILE = "/root/powchain/db.json";

// Charger DB
let DB = { chain: [], wallets: {}, lp: { pow: 0, usdc: 0 }, mempool: [] };
try {
  if (fs.existsSync(DB_FILE)) {
    DB = JSON.parse(fs.readFileSync(DB_FILE, "utf8"));
    console.log("[DB] Chargée");
  } else {
    console.log("[DB] Nouvelle base créée");
  }
} catch (e) {
  console.log("[DB] Erreur → reset DB", e);
}

// Sauvegarde DB
function save() {
  fs.writeFileSync(DB_FILE, JSON.stringify(DB, null, 2));
}

// Créer un hash sha256
function sha(x) {
  return crypto.createHash("sha256").update(x).digest("hex");
}

// Générer block genesis si vide
if (DB.chain.length === 0) {
  const genesis = {
    index: 0,
    time: Date.now(),
    prev: "0",
    pow: sha("genesis"),
    tx: [],
    stakers: {},
    reward: 10
  };
  DB.chain.push(genesis);
  save();
  console.log("[GENESIS] Bloc Genesis créé");
}

// Express
const app = express();
const server = http.createServer(app);
const wss = new WebSocket.Server({ server });

app.use(cors());
app.use(express.json());

// Trésorerie Solana
const TREASURY_SOL = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

// POWCHAIN paramètres
const BLOCK_REWARD = 10;
const BLOCK_TIME = 8000; // 8 sec
const PORT = 3000;
const WSPORT = 7001;

// Créer wallet POWCHAIN
function createWallet() {
  const kp = nacl.sign.keyPair();
  const pub = bs58.encode(kp.publicKey);
  const priv = bs58.encode(kp.secretKey);
  if (!DB.wallets[pub]) {
    DB.wallets[pub] = { pow: 0, usdc: 0, staked: 0, nonce: 0, pub };
    save();
  }
  return { pub, priv };
}

// Vérifier signature
function verify(tx) {
  try {
    const msg = Buffer.from(
      `${tx.from}|${tx.to}|${tx.amount}|${tx.token}|${tx.nonce}`
    );
    const pub = bs58.decode(tx.pub);
    const sig = bs58.decode(tx.sig);
    return nacl.sign.detached.verify(msg, sig, pub);
  } catch (e) {
    return false;
  }
}

// Ajouter transaction dans mempool
function addTx(tx) {
  if (!DB.wallets[tx.from]) return false;
  if (tx.nonce !== DB.wallets[tx.from].nonce + 1) return false;
  if (!verify(tx)) return false;
  DB.mempool.push(tx);
  DB.wallets[tx.from].nonce++;
  save();
  return true;
}

// Appliquer TX
function applyTx(tx) {
  const wFrom = DB.wallets[tx.from];
  const wTo = DB.wallets[tx.to] || (DB.wallets[tx.to] = { pow: 0, usdc: 0, staked: 0, nonce: 0, pub: tx.to });

  if (tx.token === "POW") {
    if (wFrom.pow < tx.amount) return false;
    wFrom.pow -= tx.amount;
    wTo.pow += tx.amount;
  }

  if (tx.token === "USDC") {
    if (wFrom.usdc < tx.amount) return false;
    wFrom.usdc -= tx.amount;
    wTo.usdc += tx.amount;
  }

  return true;
}

// Produire un bloc
function produceBlock() {
  if (DB.mempool.length === 0) return;

  const prev = DB.chain[DB.chain.length - 1];
  const tx = [...DB.mempool];
  DB.mempool = [];

  tx.forEach(applyTx);

  // PoS : choisir staker
  const stakers = {};
  Object.values(DB.wallets).forEach(w => {
    if (w.staked > 0) stakers[w.pub] = w.staked;
  });

  let winner = Object.keys(stakers)[0] || null;
  if (winner) DB.wallets[winner].pow += BLOCK_REWARD;

  const block = {
    index: prev.index + 1,
    time: Date.now(),
    prev: sha(JSON.stringify(prev)),
    pow: sha(JSON.stringify(tx) + Date.now()),
    tx,
    stakers,
    reward: BLOCK_REWARD,
    winner
  };

  DB.chain.push(block);
  save();
  broadcast({ type: "block", block });

  console.log("[BLOCK] Nouveau bloc", block.index);
}

// Boucle de production de blocs
setInterval(produceBlock, BLOCK_TIME);

// WebSocket
function broadcast(o) {
  const m = JSON.stringify(o);
  wss.clients.forEach(c => {
    if (c.readyState === WebSocket.OPEN) c.send(m);
  });
}

wss.on("connection", ws => {
  console.log("[WS] client connecté");
  ws.send(JSON.stringify({ type: "chain", height: DB.chain.length }));
});

// API EXPRESS

// /wallet/create
app.get("/wallet/create", (req, res) => {
  res.json(createWallet());
});

// /wallet/:pub
app.get("/wallet/:pub", (req, res) => {
  const w = DB.wallets[req.params.pub];
  res.json(w || {});
});

// /tx (POST)
app.post("/tx", (req, res) => {
  const ok = addTx(req.body);
  res.json({ ok });
});

// /chain
app.get("/chain", (req, res) => {
  res.json(DB.chain);
});

// LP POW ↔ USDC (x*y=k)
app.get("/lp", (req, res) => {
  res.json(DB.lp);
});

// BRIDGE notify
app.post("/bridge", (req, res) => {
  const { sig, from, to, lamports, fireAddr } = req.body;

  if (to !== TREASURY_SOL) return res.json({ ok: false, error: "bad treasury" });

  const sol = lamports / 1_000_000_000;

  if (!DB.wallets[fireAddr]) createWallet(fireAddr);

  DB.wallets[fireAddr].pow += sol * 10; // ratio ex. 1 SOL = 10 POW
  save();

  broadcast({ type: "bridge", fireAddr, sol });

  res.json({ ok: true });
});

// Stats POWCHAIN
app.get("/stats", (req, res) => {
  const totalPow = Object.values(DB.wallets).reduce((a, w) => a + w.pow, 0);
  const totalStaked = Object.values(DB.wallets).reduce((a, w) => a + w.staked, 0);

  res.json({
    height: DB.chain.length,
    blocks: DB.chain.length,
    wallets: Object.keys(DB.wallets).length,
    mempool: DB.mempool.length,
    totalPow,
    totalStaked,
    lp: DB.lp
  });
});

// Lancer serveur
server.listen(PORT, () => console.log("POWCHAIN HTTP API sur port", PORT));
server.on("upgrade", (req, socket, head) => {
  if (req.url === "/ws") wss.handleUpgrade(req, socket, head, ws => wss.emit("connection", ws, req));
});

server.listen(PORT);
console.log("POWCHAIN WebSocket sur port", WSPORT);








<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>POWCHAIN — Client Complet</title><style>body{margin:0;background:#020712;color:#e5f2ff;font-family:system-ui,-apple-system,Segoe UI,sans-serif}#app{max-width:1100px;margin:20px auto;padding:16px;border-radius:14px;background:radial-gradient(circle at top,#0b1624,#020712);box-shadow:0 0 35px #000}h1{margin:0 0 8px;font-size:26px;color:#7ee0ff;text-align:center;text-shadow:0 0 14px #0891b2}h2{margin:0 0 10px;font-size:18px;color:#bfdbfe}label{font-size:12px;color:#9ca3af}input,button{font-size:13px;border-radius:8px;border:1px solid #1f2937;padding:8px 10px;background:#020617;color:#e5f2ff;box-sizing:border-box}input{width:100%}button{cursor:pointer;font-weight:600;letter-spacing:.03em;background:linear-gradient(90deg,#0284c7,#22c1c3);border:none;box-shadow:0 0 10px #0ea5e9aa}button.secondary{background:#020617;border:1px solid #374151;box-shadow:none}button:disabled{opacity:.4;cursor:not-allowed}small{font-size:11px;color:#9ca3af}.row{display:flex;flex-wrap:wrap;gap:14px}.card{flex:1 1 310px;border-radius:14px;border:1px solid #1f2937;background:radial-gradient(circle at top left,#020617,#020712);padding:14px;box-shadow:0 0 18px #020617}.statusRow{display:flex;justify-content:center;gap:8px;margin-bottom:14px}.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:11px;border:1px solid #1f2937;background:#020617}.dot{width:9px;height:9px;border-radius:999px;background:#4b5563;box-shadow:0 0 4px #000}.dot.ok{background:#22c55e;box-shadow:0 0 8px #22c55e}.dot.err{background:#ef4444;box-shadow:0 0 8px #ef4444}#log{margin-top:10px;height:150px;overflow:auto;border-radius:10px;border:1px solid #111827;background:#020617;font-size:11px;padding:6px;white-space:pre-wrap}#qr{display:block;margin:6px auto 0;background:#fff;border-radius:8px}#dexChart{width:100%;height:120px;border-radius:10px;border:1px solid #1f2937;background:radial-gradient(circle at top,#0b1120,#020617);position:relative;overflow:hidden}#dexChart svg{position:absolute;inset:0}</style><script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script><script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bs58@6.0.0/dist/bs58.min.js"></script><script src="https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js"></script></head><body><div id="app"><h1>POWCHAIN — Client Complet</h1><div class="statusRow"><div class="pill">Backend : <span id="httpDot" class="dot"></span><span>HTTP OK</span></div><div class="pill">WS : <span id="wsDot" class="dot"></span><span id="wsLabel">?</span></div></div><div class="card" style="margin-bottom:14px"><h2>RÉSEAU POWCHAIN</h2><div style="display:flex;flex-wrap:wrap;gap:12px;font-size:13px"><div style="flex:1 1 140px"><div>Hauteur : <span id="hHeight">0</span></div><div>NB wallets : <span id="hWallets">0</span></div></div><div style="flex:1 1 180px"><div>TVL POW : <span id="hTvlPow">-</span></div><div>TVL USDC POW : <span id="hTvlUsdc">-</span></div></div><div style="flex:1 1 180px"><div>Trésorerie POW : <span id="hTreasPow">0</span></div><div>Trésorerie USDC POW : <span id="hTreasUsdc">0</span></div></div></div><small id="hAgo">Données HTTP : -</small></div><div class="row"><div class="card"><h2>Wallet POWCHAIN — Générateur</h2><label for="powAddr">Adresse POWCHAIN (base58)</label><input id="powAddr" placeholder="Clique sur GÉNÉRER pour créer un wallet local"/><div style="display:flex;gap:8px;margin:8px 0 6px"><button id="btnGen">Générer wallet POWCHAIN</button><button id="btnReload" class="secondary">Recharger</button></div><canvas id="qr" width="120" height="120"></canvas><button id="btnCopy" style="width:100%;margin-top:6px">Copier adresse</button><small>Le wallet est généré localement (nacl + bs58) et stocké en localStorage. Seules les TX signées sont envoyées au serveur POWCHAIN.</small><div style="margin-top:10px"><label>Solde POW</label><input id="powBal" disabled/><label>Solde USDC POW</label><input id="powUsdcBal" disabled/></div></div><div class="card"><h2>Wallet Solana — Phantom</h2><label for="solAddr">Adresse Solana</label><input id="solAddr" placeholder="Connecte Phantom pour voir l'adresse" disabled/><div style="display:flex;gap:8px;margin:8px 0 6px"><button id="btnPhantom">Connecter Phantom</button><button id="btnSolRefresh" class="secondary">Refresh</button></div><label>SOL (wallet)</label><input id="solBal" disabled/><label>USDC Solana</label><input id="usdcBal" disabled/><small>Soldes lus via RPC drpc Solana mainnet (SOL + USDC EPjFWdd5...). Aucun lien direct avec USDC POWCHAIN interne.</small><div style="margin-top:12px"><h2 style="font-size:16px;margin-bottom:6px">Bridge vers POWCHAIN</h2><label for="bridgeAmt">Montant SOL à bridger</label><input id="bridgeAmt" placeholder="ex. 0.0015"/><button id="btnBridge" style="width:100%;margin-top:8px">SOL → POWCHAIN</button><small>Envoie une requête BRIDGE_SOL au serveur POWCHAIN. Les détails du pont (trésorerie POWCHAIN, mint POW, etc.) sont gérés côté backend.</small></div></div><div class="card"><h2>DEX POWCHAIN</h2><label>Ajouter de la liquidité (POW / USDC POW)</label><label for="lpPow">Montant POW</label><input id="lpPow" placeholder="0.0"/><label for="lpUsdc">Montant USDC POW</label><input id="lpUsdc" placeholder="0.0"/><button id="btnLp" style="width:100%;margin-top:8px">ADD LP</button><small>Un add LP ≥ 10 000 POW et 10 000 USDC POW peut donner un badge WHALE (logique à gérer côté serveur).</small><div id="dexChart"><svg viewBox="0 0 100 40" preserveAspectRatio="none"><path id="dexPath" d="M0 35 Q 25 25 50 28 T 100 30" fill="none" stroke="#38bdf8" stroke-width="1.5"/></svg></div><h2 style="font-size:16px;margin-top:12px;margin-bottom:6px">Explorer & Log</h2><div style="display:flex;gap:8px;margin-bottom:6px"><button id="btnBlocks">Charger derniers blocs</button><button id="btnClear" class="secondary">CLEAR LOG</button></div><div id="log"></div></div></div></div><script>(function(){const HTTP_DOT=document.getElementById("httpDot");const WS_DOT=document.getElementById("wsDot");const WS_LABEL=document.getElementById("wsLabel");const logBox=document.getElementById("log");const powAddrEl=document.getElementById("powAddr");const powBalEl=document.getElementById("powBal");const powUsdcBalEl=document.getElementById("powUsdcBal");const btnGen=document.getElementById("btnGen");const btnReload=document.getElementById("btnReload");const btnCopy=document.getElementById("btnCopy");const solAddrEl=document.getElementById("solAddr");const solBalEl=document.getElementById("solBal");const usdcBalEl=document.getElementById("usdcBal");const btnPhantom=document.getElementById("btnPhantom");const btnSolRefresh=document.getElementById("btnSolRefresh");const bridgeAmtEl=document.getElementById("bridgeAmt");const btnBridge=document.getElementById("btnBridge");const btnLp=document.getElementById("btnLp");const btnBlocks=document.getElementById("btnBlocks");const btnClear=document.getElementById("btnClear");const hHeight=document.getElementById("hHeight");const hWallets=document.getElementById("hWallets");const hTvlPow=document.getElementById("hTvlPow");const hTvlUsdc=document.getElementById("hTvlUsdc");const hTreasPow=document.getElementById("hTreasPow");const hTreasUsdc=document.getElementById("hTreasUsdc");const hAgo=document.getElementById("hAgo");let qrObj=null;try{qrObj=new QRious({element:document.getElementById("qr"),size:120,value:""});}catch(e){}const RPC_URL="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";let connection=null;if(window.solanaWeb3){connection=new solanaWeb3.Connection(RPC_URL,"confirmed");}let solPubKey=null;let powWallet=null;function L(msg){const t=new Date().toTimeString().slice(0,8);logBox.textContent+="["+t+"] "+msg+"\n";logBox.scrollTop=logBox.scrollHeight;}async function checkHttp(){try{const r=await fetch("/stats");if(!r.ok)throw new Error("HTTP "+r.status);const j=await r.json();HTTP_DOT.classList.add("ok");updateStatsFromHttp(j);}catch(e){HTTP_DOT.classList.add("err");L("HTTP stats error: "+e.message);}}function updateStatsFromHttp(s){try{hHeight.textContent=s.height??0;hWallets.textContent=s.wallets??0;hTreasPow.textContent=s.treasuryPow??0;hTreasUsdc.textContent=s.treasuryUsdc??0;hTvlPow.textContent=s.tvlPow??"-";hTvlUsdc.textContent=s.tvlUsdc??"-";if(s.updatedAt){hAgo.textContent="Données HTTP : "+s.updatedAt;}else{hAgo.textContent="Données HTTP mises à jour.";}}catch(e){L("Update stats error: "+e.message);}}function ensureLibs(){if(typeof nacl==="undefined"||typeof bs58==="undefined"){alert("Erreur génération wallet POWCHAIN : Error: bs58 lib non chargée");return false;}return true;}function saveWallet(w){powWallet=w;try{localStorage.setItem("powchain_wallet",JSON.stringify(w));}catch(e){L("LocalStorage error: "+e.message);} }function loadWallet(){try{const raw=localStorage.getItem("powchain_wallet");if(!raw)return null;return JSON.parse(raw);}catch(e){L("LocalStorage read err: "+e.message);return null;}}function displayWallet(){if(!powWallet||!powWallet.pub)return;powAddrEl.value=powWallet.pub;if(qrObj)qrObj.value=powWallet.pub;}function refreshPowBalances(j){if(!j||!j.wallets)return;const w=j.wallets[powWallet.pub];if(!w){powBalEl.value="0";powUsdcBalEl.value="0";return;}powBalEl.value=(w.pow||0).toString();powUsdcBalEl.value=(w.usdcPow||0).toString();}btnGen.onclick=function(){try{if(!ensureLibs())return;const kp=nacl.sign.keyPair();const pub=bs58.encode(kp.publicKey);const priv=bs58.encode(kp.secretKey);saveWallet({pub,priv});displayWallet();powBalEl.value="0";powUsdcBalEl.value="0";L("Wallet POWCHAIN généré.");}catch(e){alert("Erreur génération wallet POWCHAIN : "+e);}};btnReload.onclick=function(){const w=loadWallet();if(!w){L("Aucun wallet POWCHAIN dans ce navigateur.");return;}saveWallet(w);displayWallet();fetch("/wallet/"+encodeURIComponent(w.pub)).then(r=>r.ok?r.json():null).then(j=>{if(j)refreshPowBalances({wallets:{[w.pub]:j}});}).catch(()=>{});};btnCopy.onclick=async function(){if(!powAddrEl.value){L("Aucune adresse à copier.");return;}try{await navigator.clipboard.writeText(powAddrEl.value);L("Adresse POWCHAIN copiée.");}catch(e){L("Clipboard error: "+e.message);}};btnClear.onclick=function(){logBox.textContent="";};btnBlocks.onclick=function(){fetch("/chain?limit=10").then(r=>r.json()).then(blks=>{L("Derniers blocs:");blks.slice(-10).forEach(b=>L("• height="+b.height+" tx="+(b.txs?b.txs.length:0)));}).catch(e=>L("Erreur /chain: "+e.message));};btnLp.onclick=function(){const a=parseFloat(document.getElementById("lpPow").value)||0;const b=parseFloat(document.getElementById("lpUsdc").value)||0;if(a<=0||b<=0){L("Montants LP invalides.");return;}L("LP request POW="+a+" USDC POW="+b+" (logique côté serveur).");};async function connectPhantom(){try{if(!window.solana){alert("Phantom non détecté.");return;}const resp=await window.solana.connect({onlyIfTrusted:false});solPubKey=resp.publicKey;solAddrEl.value=solPubKey.toBase58();L("Phantom connecté.");await refreshSol();}catch(e){L("Erreur Phantom connect: "+e.message);}}async function refreshSol(){if(!connection||!solPubKey){L("Connecte Phantom d'abord.");return;}try{const lam=await connection.getBalance(solPubKey);solBalEl.value=(lam/1e9).toFixed(6);const usdcMint=new solanaWeb3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");const accs=await connection.getParsedTokenAccountsByOwner(solPubKey,{mint:usdcMint});let total=0;for(const a of accs.value){const ui=a.account.data.parsed.info.tokenAmount.uiAmount||0;total+=ui;}usdcBalEl.value=total.toFixed(2);L("Soldes Solana mis à jour.");}catch(e){alert("Erreur Phantom: "+e.message);L("Erreur Phantom: "+e.message);}}btnPhantom.onclick=connectPhantom;btnSolRefresh.onclick=refreshSol;btnBridge.onclick=async function(){try{if(!powWallet||!powWallet.pub){L("Génère un wallet POWCHAIN d'abord.");return;}if(!solPubKey){L("Connecte Phantom d'abord.");return;}const amt=parseFloat(bridgeAmtEl.value);if(!amt||amt<=0){L("Montant SOL invalide.");return;}L("Bridge SOL → POWCHAIN en cours...");const res=await fetch("/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({powAddress:powWallet.pub,solAddress:solPubKey.toBase58(),amountSol:amt})});const j=await res.json();if(!res.ok){L("Bridge HTTP "+res.status+": "+(j.error||""));return;}L("Bridge OK, POW minté: "+j.mintedPow);checkHttp();}catch(e){L("Bridge JS error: "+e.message);}};function connectWs(){try{const ws=new WebSocket("wss://bbqfinance.fun/ws");WS_LABEL.textContent="...";ws.onopen=function(){WS_DOT.classList.remove("err");WS_DOT.classList.add("ok");WS_LABEL.textContent="OK";L("WS connecté.");ws.send(JSON.stringify({type:"subscribe"}));};ws.onmessage=function(ev){try{const msg=JSON.parse(ev.data);if(msg.type==="stats"){updateStatsFromHttp(msg);if(powWallet&&msg.wallets)refreshPowBalances(msg);}}catch(e){}};ws.onclose=function(){WS_DOT.classList.remove("ok");WS_DOT.classList.add("err");WS_LABEL.textContent="?";L("WebSocket fermé. Reconnexion dans 5 s.");setTimeout(connectWs,5000);};ws.onerror=function(){WS_DOT.classList.add("err");};}catch(e){L("WS error: "+e.message);}}window.addEventListener("load",function(){const w=loadWallet();if(w){saveWallet(w);displayWallet();}checkHttp();connectWs();});})();</script></body></html>



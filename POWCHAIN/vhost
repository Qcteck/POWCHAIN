// FIREINNERS / POWCHAIN - Backend simple
// HTTP : 3000  |  WS : 7001

const express = require("express");
const bodyParser = require("body-parser");
const http = require("http");
const WebSocket = require("ws");

// ----------------------
//  CONFIG / STATE
// ----------------------
const PORT_HTTP = 3000;
const PORT_WS = 7001;

// trésorerie (affichée dans le dashboard)
const TREASURY_SOL_ADDR = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

// état en mémoire
let height = 1;
let wallets = {};   // addr -> { pow, usdc, staked, nonce }
let mempool = [];   // liste des tx reçues
let blocks = [];    // simple log de blocs
let lp = { pow: 0, usdc: 0 }; // LP interne FIRE/USDC
let treasury = { fire: 0, usdc: 0, sol: 0 }; // stats trésorerie
let serverWalletAddr = null; // wallet "serveur" optionnel

// Helpers
function getWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = { pow: 0, usdc: 0, staked: 0, nonce: 0 };
  }
  return wallets[addr];
}

function addBlock(type, payload) {
  const b = {
    height: height++,
    time: Date.now(),
    type,
    payload,
  };
  blocks.push(b);
  broadcast({ type: "block", height: b.height });
  return b;
}

// ----------------------
//  EXPRESS
// ----------------------
const app = express();
app.use(bodyParser.json());

// CORS léger (au cas où Cloudflare, etc.)
app.use((req, res, next) => {
  res.setHeader("Access-Control-Allow-Origin", "https://bbqfinance.fun");
  res.setHeader("Access-Control-Allow-Methods", "GET,POST,OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type");
  if (req.method === "OPTIONS") return res.sendStatus(200);
  next();
});

// ping root
app.get("/", (req, res) => {
  res.status(200).json({ ok: true, service: "FIREINNERS backend", height });
});

// ----------------------
//  /stats
// ----------------------
app.get("/stats", (req, res) => {
  try {
    const walletAddrs = Object.keys(wallets);
    let totalPow = 0;
    let totalStaked = 0;
    walletAddrs.forEach((a) => {
      const w = wallets[a];
      totalPow += w.pow || 0;
      totalStaked += w.staked || 0;
    });

    const out = {
      height,
      wallets: walletAddrs.length,
      mempool: mempool.length,
      totalPow: totalPow,
      totalStaked: totalStaked,
      tvlPow: lp.pow,
      tvlUsdc: lp.usdc,
      lpPow: lp.pow,
      lpUsdc: lp.usdc,
      treasuryFire: treasury.fire,
      treasuryUsdc: treasury.usdc,
      treasurySol: treasury.sol,
    };
    res.json(out);
  } catch (e) {
    console.error("ERR /stats:", e);
    res.status(200).json({
      height,
      wallets: 0,
      mempool: 0,
      totalPow: 0,
      totalStaked: 0,
      tvlPow: lp.pow,
      tvlUsdc: lp.usdc,
      lpPow: lp.pow,
      lpUsdc: lp.usdc,
      treasuryFire: treasury.fire,
      treasuryUsdc: treasury.usdc,
      treasurySol: treasury.sol,
    });
  }
});

// ----------------------
//  WALLET ENDPOINTS
// ----------------------

// GET /wallet?addr=...
app.get("/wallet", (req, res) => {
  const addr = (req.query.addr || "").trim();
  if (!addr) return res.status(400).json({ error: "addr manquant" });
  const w = getWallet(addr);
  res.json({
    addr,
    pow: w.pow,
    usdc: w.usdc,
    staked: w.staked,
    nonce: w.nonce,
  });
});

// GET /wallet/server
app.get("/wallet/server", (req, res) => {
  if (!serverWalletAddr) {
    return res.json({ addr: null });
  }
  res.json({ addr: serverWalletAddr });
});

// POST /wallet/create
// génère un wallet "serveur" (adresse simple pseudo-aléatoire)
app.post("/wallet/create", (req, res) => {
  if (!serverWalletAddr) {
    const rand = "FIRE_SRV_" + Math.random().toString(36).slice(2, 10).toUpperCase();
    serverWalletAddr = rand;
    getWallet(serverWalletAddr); // init
  }
  res.json({ addr: serverWalletAddr });
});

// ----------------------
//  TX / MEMPOOL / CHAIN
// ----------------------

// POST /tx  body: { token, to, amount, fromType, fromAddr }
app.post("/tx", (req, res) => {
  try {
    const { token, to, amount, fromType, fromAddr } = req.body || {};
    if (!to || !fromAddr) return res.status(400).json({ error: "to/fromAddr manquant" });

    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ error: "amount invalide" });

    const fromWallet = getWallet(fromAddr);
    const toWallet = getWallet(to);

    if (token === "POW" || token === "FIRE") {
      if ((fromWallet.pow || 0) < amt) {
        return res.status(400).json({ error: "solde FIRE insuffisant" });
      }
      fromWallet.pow -= amt;
      toWallet.pow += amt;
    } else {
      // USDC FIRE
      if ((fromWallet.usdc || 0) < amt) {
        return res.status(400).json({ error: "solde USDC insuffisant" });
      }
      fromWallet.usdc -= amt;
      toWallet.usdc += amt;
    }

    fromWallet.nonce = (fromWallet.nonce || 0) + 1;

    const tx = {
      id: "tx_" + Date.now() + "_" + Math.floor(Math.random() * 1e6),
      type: "TRANSFER",
      token: token === "FIRE" ? "POW" : token,
      fromType: fromType || "unknown",
      from: fromAddr,
      to,
      amount: amt,
      time: Date.now(),
    };
    mempool.push(tx);
    addBlock("TRANSFER", tx);
    broadcast({ type: "tx", txid: tx.id });

    res.json({ ok: true, txid: tx.id });
  } catch (e) {
    console.error("ERR /tx:", e);
    res.status(500).json({ error: "internal" });
  }
});

// GET /mempool
app.get("/mempool", (req, res) => {
  res.json({ txs: mempool });
});

// GET /chain/last
app.get("/chain/last", (req, res) => {
  if (!blocks.length) return res.json({ height: 0, block: null });
  const last = blocks[blocks.length - 1];
  res.json({ height: last.height, block: last });
});

// GET /block/:h
app.get("/block/:h", (req, res) => {
  const h = parseInt(req.params.h, 10);
  const b = blocks.find((x) => x.height === h);
  if (!b) return res.status(404).json({ error: "not found" });
  res.json(b);
});

// ----------------------
//  LP / SWAP / STAKE
// ----------------------

// POST /lp/add  body: { fire, usdc }
app.post("/lp/add", (req, res) => {
  try {
    const fire = Number(req.body.fire || 0);
    const usdc = Number(req.body.usdc || 0);
    if (!(fire > 0 && usdc > 0)) {
      return res.status(400).json({ error: "fire/usdc invalides" });
    }

    lp.pow += fire;
    lp.usdc += usdc;

    const payload = { fire, usdc, time: Date.now() };
    mempool.push({ type: "LP_ADD", ...payload });
    addBlock("LP_ADD", payload);
    broadcast({ type: "lp", lp });

    res.json({ ok: true, lp });
  } catch (e) {
    console.error("ERR /lp/add:", e);
    res.status(500).json({ error: "internal" });
  }
});

// POST /swap  body: { dir, amount }
app.post("/swap", (req, res) => {
  try {
    const dir = req.body.dir;
    const amount = Number(req.body.amount || 0);
    if (!(amount > 0)) return res.status(400).json({ error: "amount invalide" });

    if (lp.pow <= 0 || lp.usdc <= 0) {
      return res.status(400).json({ error: "LP vide" });
    }

    let outFire = 0;
    let outUsdc = 0;

    const K = lp.pow * lp.usdc;

    if (dir === "fire2usdc") {
      // on ajoute FIRE, on retire USDC
      const newPow = lp.pow + amount;
      const newUsdc = K / newPow;
      outUsdc = lp.usdc - newUsdc;
      lp.pow = newPow;
      lp.usdc = newUsdc;
    } else if (dir === "usdc2fire") {
      const newUsdc = lp.usdc + amount;
      const newPow = K / newUsdc;
      outFire = lp.pow - newPow;
      lp.usdc = newUsdc;
      lp.pow = newPow;
    } else {
      return res.status(400).json({ error: "dir invalide" });
    }

    const payload = { dir, amount, outFire, outUsdc, time: Date.now() };
    mempool.push({ type: "SWAP", ...payload });
    addBlock("SWAP", payload);
    broadcast({ type: "swap", dir, amount });

    res.json({ ok: true, lp, outFire, outUsdc });
  } catch (e) {
    console.error("ERR /swap:", e);
    res.status(500).json({ error: "internal" });
  }
});

// POST /stake  body: { amount }
app.post("/stake", (req, res) => {
  try {
    const amount = Number(req.body.amount || 0);
    if (!(amount > 0)) return res.status(400).json({ error: "amount invalide" });

    // on agrège le staking dans une "pool" fictive de trésorerie
    treasury.fire += amount;

    const payload = { amount, time: Date.now() };
    mempool.push({ type: "STAKE", ...payload });
    addBlock("STAKE", payload);
    broadcast({ type: "stake", amount });

    res.json({ ok: true });
  } catch (e) {
    console.error("ERR /stake:", e);
    res.status(500).json({ error: "internal" });
  }
});

// ----------------------
//  HTTP SERVER
// ----------------------
const server = http.createServer(app);

// ----------------------
//  WEBSOCKET SERVER
// ----------------------
const wss = new WebSocket.Server({ port: PORT_WS });
let sockets = [];

wss.on("connection", (ws) => {
  sockets.push(ws);
  ws.on("close", () => {
    sockets = sockets.filter((x) => x !== ws);
  });
});

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  sockets.forEach((ws) => {
    try {
      ws.send(msg);
    } catch (e) {}
  });
}

// ----------------------
//  START
// ----------------------
server.listen(PORT_HTTP, () => {
  console.log("HTTP FIREINNERS backend on port", PORT_HTTP);
  console.log("Trésorerie SOL:", TREASURY_SOL_ADDR);
});

console.log("WS FIREINNERS on port", PORT_WS);







// server.js — FIREINNERS validator HTTP + WS

const express = require("express");
const bodyParser = require("body-parser");
const WebSocket = require("ws");
const http = require("http");
const crypto = require("crypto");

// =========================
// CONFIG SERVEUR
// =========================

const HTTP_PORT = 3000;
const WS_PATH = "/ws";

const app = express();
app.use(bodyParser.json());

const server = http.createServer(app);
const wss = new WebSocket.Server({ server, path: WS_PATH });
const wsClients = new Set();

// =========================
// ECONOMIE FIREINNERS
// =========================

const DEC = 1e6;                        // 6 décimales
const SUPPLY_MAX = 100_000_000 * DEC;   // hard cap 100M FIRE

// Adresse réelle de trésorerie Solana
const SOL_TREASURY_ADDRESS = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

// Taux dynamique FIRE / SOL
const RATE_BASE = 1000;
const TVL_REF = 1_000_000 * DEC;
const RATE_MIN = 800;
const RATE_MAX = 5000;

// Frais en basis points
const FEE_BRIDGE_IN_TREAS_BP = 500;  // 5 % vers trésorerie
const FEE_BRIDGE_IN_BURN_BP  = 200;  // 2 % burn à l'entrée
const FEE_BRIDGE_OUT_BURN_BP = 1000; // 10 % burn à la sortie

// =========================
// ETAT GLOBAL EN MEMOIRE
// =========================

let wallets = {}; // addr -> { fire, usdc, sol, nonce }
let treasury = { fire: 0, usdc: 0, sol: 0 };
let lp = { fire: 0, usdc: 0 };

let mintedTotal = 0;
let burnedTotal = 0;
let supplyCirculante = 0;

let chain = [];       // blocs
let mempool = [];     // tx en attente
let lpHistory = [];   // échantillons LP pour le graphique

// =========================
// OUTILS
// =========================

function broadcast(obj) {
  const payload = JSON.stringify(obj);
  for (const ws of wsClients) {
    if (ws.readyState === WebSocket.OPEN) ws.send(payload);
  }
}

function log(...args) {
  console.log("[fireinners]", ...args);
  const msg = args.map(a => (typeof a === "string" ? a : JSON.stringify(a))).join(" ");
  broadcast({ type: "log", msg });
}

function ensureWallet(addr) {
  if (!addr || typeof addr !== "string") {
    throw new Error("Adresse wallet invalide");
  }
  if (!wallets[addr]) {
    wallets[addr] = { fire: 0, usdc: 0, sol: 0, nonce: 0 };
  }
  return wallets[addr];
}

function clamp(x, min, max) {
  return x < min ? min : x > max ? max : x;
}

function getTVL() {
  return (lp.usdc || 0) + (treasury.usdc || 0);
}

function getFireRatePerSol() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || DEC);
  const raw = RATE_BASE * factor;
  return clamp(raw, RATE_MIN, RATE_MAX);
}

function mintFire(amount) {
  if (!amount || amount <= 0) return 0;
  const remaining = SUPPLY_MAX - mintedTotal;
  const mintable = Math.max(0, Math.min(amount, remaining));
  mintedTotal += mintable;
  supplyCirculante += mintable;
  return mintable;
}

function burnFire(amount) {
  if (!amount || amount <= 0) return 0;
  const burn = Math.min(amount, supplyCirculante);
  burnedTotal += burn;
  supplyCirculante -= burn;
  return burn;
}

function applyBp(amount, bp) {
  return Math.floor(amount * bp / 10000);
}

function sha256(str) {
  return crypto.createHash("sha256").update(str).digest("hex");
}

function recordLpSample() {
  lpHistory.push({
    t: Date.now(),
    fire: lp.fire || 0,
    usdc: lp.usdc || 0
  });
  if (lpHistory.length > 200) lpHistory.shift();
}

// Forge bloc + sample LP toutes les 10s
function forgeBlock() {
  if (mempool.length) {
    const height = chain.length ? chain[chain.length - 1].height + 1 : 1;
    const prevHash = chain.length ? chain[chain.length - 1].hash : "0".repeat(64);
    const txs = mempool.slice();
    mempool = [];
    const time = Date.now();
    const hash = sha256(JSON.stringify({ height, prevHash, time, txs }));
    const block = { height, time, prevHash, hash, txs };
    chain.push(block);
    log("Bloc forgé", height, "tx:", txs.length);
  }
  recordLpSample();
}

setInterval(forgeBlock, 10_000);

// =========================
// HANDLERS ECONOMIQUES
// =========================

function processBridgeIn(params) {
  const { addr, solAmount } = params;
  if (!addr) throw new Error("adresse manquante");
  if (!solAmount || solAmount <= 0) throw new Error("solAmount invalide");

  const rate = getFireRatePerSol();
  const fireBrut = Math.floor(solAmount * rate * DEC);

  const fireMinted = mintFire(fireBrut);
  if (fireMinted <= 0) throw new Error("Supply max atteint");

  const feeTreas = applyBp(fireMinted, FEE_BRIDGE_IN_TREAS_BP);
  const feeBurn  = applyBp(fireMinted, FEE_BRIDGE_IN_BURN_BP);
  const userFire = fireMinted - feeTreas - feeBurn;
  if (userFire <= 0) throw new Error("Bridge net <= 0");

  treasury.fire += feeTreas;
  const burned = burnFire(feeBurn);
  const w = ensureWallet(addr);
  w.fire += userFire;

  treasury.sol += solAmount; // compta interne, le vrai débit SOL est manuel

  const bridge = {
    type: "BRIDGE_IN",
    addr,
    solAmount,
    rateFirePerSol: rate,
    fireMinted,
    userFire,
    feeTreasFire: feeTreas,
    burnedFire: burned,
    supplyCirculante,
    supplyDisponible: SUPPLY_MAX - mintedTotal
  };

  mempool.push(bridge);
  log("Bridge SOL->FIREINNERS", bridge);
  return bridge;
}

function processBridgeOut(params) {
  const { addr, fireAmount } = params;
  if (!addr) throw new Error("adresse manquante");
  if (!fireAmount || fireAmount <= 0) throw new Error("fireAmount invalide");

  const rate = getFireRatePerSol();
  const w = ensureWallet(addr);
  if (w.fire < fireAmount) throw new Error("Solde FIRE insuffisant");

  w.fire -= fireAmount;

  const feeBurn = applyBp(fireAmount, FEE_BRIDGE_OUT_BURN_BP);
  const fireNet = fireAmount - feeBurn;
  if (fireNet <= 0) throw new Error("Bridge out net <= 0");

  const burned = burnFire(fireAmount);
  const solOut = fireNet / (rate * DEC);

  if (treasury.sol < solOut) throw new Error("Trésorerie SOL insuffisante");

  treasury.sol -= solOut;

  const bridge = {
    type: "BRIDGE_OUT",
    addr,
    fireSent: fireAmount,
    fireNet,
    burnedFire: burned,
    rateFirePerSol: rate,
    solOut
  };

  mempool.push(bridge);
  log("Bridge FIRE->SOL", bridge);
  return bridge;
}

// =========================
// API HTTP
// =========================

app.get("/stats", (req, res) => {
  try {
    const height = chain.length ? chain[chain.length - 1].height : 0;
    res.json({
      ok: true,
      height,
      wallets: Object.keys(wallets).length,
      treasury,
      lp,
      supplyMax: SUPPLY_MAX,
      mintedTotal,
      burnedTotal,
      supplyCirculante,
      supplyDisponible: SUPPLY_MAX - mintedTotal,
      solTreasuryAddress: SOL_TREASURY_ADDRESS
    });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

app.get("/chain", (req, res) => {
  try {
    const last = chain.slice(-20);
    res.json({ ok: true, height: chain.length, blocks: last });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

app.get("/wallet/:addr", (req, res) => {
  try {
    const addr = req.params.addr;
    const w = ensureWallet(addr);
    res.json({
      ok: true,
      addr,
      fire: w.fire,
      usdc: w.usdc,
      sol: w.sol,
      nonce: w.nonce
    });
  } catch (e) {
    console.error("Erreur /wallet:", e);
    res.status(400).json({ ok: false, error: e.message });
  }
});

app.post("/bridge", (req, res) => {
  try {
    const { addr, solAmount } = req.body;
    if (!addr || solAmount === undefined) {
      return res.status(400).json({ ok: false, error: "Params manquants" });
    }
    const sol = Number(solAmount);
    if (!Number.isFinite(sol) || sol <= 0) {
      return res.status(400).json({ ok: false, error: "Montant invalide" });
    }
    const bridge = processBridgeIn({ addr, solAmount: sol });
    return res.json({ ok: true, bridge });
  } catch (e) {
    log("Erreur /bridge", e.message);
    return res.status(400).json({ ok: false, error: e.message });
  }
});

app.post("/bridge-out", (req, res) => {
  try {
    const { addr, fireAmount } = req.body;
    if (!addr || fireAmount === undefined) {
      return res.status(400).json({ ok: false, error: "Params manquants" });
    }
    const fire = Number(fireAmount);
    if (!Number.isFinite(fire) || fire <= 0) {
      return res.status(400).json({ ok: false, error: "Montant invalide" });
    }
    const bridge = processBridgeOut({ addr, fireAmount: fire });
    return res.json({ ok: true, bridge });
  } catch (e) {
    log("Erreur /bridge-out", e.message);
    return res.status(400).json({ ok: false, error: e.message });
  }
});

app.get("/bridge-history", (req, res) => {
  try {
    const bridges = chain.flatMap(b =>
      (b.txs || []).filter(
        tx => tx.type === "BRIDGE_IN" || tx.type === "BRIDGE_OUT"
      )
    );
    res.json({ ok: true, bridges });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// historique LP pour le graphique
app.get("/lp-history", (req, res) => {
  try {
    res.json({ ok: true, history: lpHistory });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// =========================
// WEBSOCKET
// =========================

wss.on("connection", ws => {
  wsClients.add(ws);
  log("WS client connecté, total =", wsClients.size);
  ws.on("close", () => {
    wsClients.delete(ws);
    log("WS client déconnecté, total =", wsClients.size);
  });
});

// =========================
// LANCEMENT
// =========================

server.listen(HTTP_PORT, () => {
  log("FIREINNERS Validator prêt — HTTP + WS sur port", HTTP_PORT);
});



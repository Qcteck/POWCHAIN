// Stats globales pour le Dashboard
app.get("/stats", (req, res) => {
  try {
    const last = chain[chain.length - 1] || null;
    const tvl = getTVL();
    const rate = getRate();
    res.json({
      ok: true,
      height: chain.length,
      lpFire: lp.fire,
      lpUsdc: lp.usdc,
      treasuryFire: treasury.fire,
      treasuryUsdc: treasury.usdc,
      treasurySol: treasury.sol,
      supplyCirculante,
      supplyDisponible: SUPPLY_MAX - supplyCirculante,
      mintedFireTotal,
      burnedFireTotal,
      tvl,
      rateFirePerSol: rate,
      lastBlockTime: last ? last.time : null
    });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// Détail d’un wallet FIREINNERS
app.get("/wallet/:addr", (req, res) => {
  const addr = req.params.addr;
  if (!addr) return res.status(400).json({ ok: false, error: "addr manquant" });
  const w = ensureWallet(addr);
  res.json({
    ok: true,
    addr,
    fire: w.fire,
    usdc: w.usdc,
    staked: w.staked,
    nonce: w.nonce,
    stakeLock: w.stakeLock,
    pub: w.pub
  });
});

// Historique des blocs (explorer)
app.get("/blocks", (req, res) => {
  const from = parseInt(req.query.from || "0", 10);
  const start = isNaN(from) ? 0 : Math.max(0, from);
  const out = chain.slice(start);
  res.json({ ok: true, blocks: out });
});

// Détail d’un bloc par hauteur
app.get("/block/:h", (req, res) => {
  const h = parseInt(req.params.h, 10);
  if (isNaN(h) || h <= 0) {
    return res.status(400).json({ ok: false, error: "hauteur invalide" });
  }
  const b = chain.find((blk) => blk.height === h);
  if (!b) return res.status(404).json({ ok: false, error: "bloc introuvable" });
  res.json({ ok: true, block: b });
});


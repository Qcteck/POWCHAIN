
nano /etc/nginx/sites-available/bbqfinance



server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    # ------------------ WebSocket ------------------
    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }

    # ------------------ API POWCHAIN ------------------
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
    }
    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
    }
    location /lp {
        proxy_pass http://127.0.0.1:3000/lp;
    }
    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
    }

    # ------------------ FRONTEND HTML ------------------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
nano /etc/nginx/sites-available/bbqfinance

server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    # --- Frontend (ton index.html) ---
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- API POWCHAIN / FIREINNERS (HTTP) ---
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
    }

    location /bridges {
        proxy_pass http://127.0.0.1:3000/bridges;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
    }

    location /bridge {
        proxy_pass http://127.0.0.1:3000/bridge;
    }

    location /tx {
        proxy_pass http://127.0.0.1:3000/tx;
    }

    # --- WebSocket Explorer ---
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}


<!doctype html><html lang="fr"><head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>POWCHAIN — Client Complet</title>
<style>
body{margin:0;background:#05070b;color:#e5ecff;font-family:system-ui,Arial}
input,select,button{border-radius:6px;border:1px solid #1c3b5a;background:#0b111c;color:#e5ecff;padding:7px;font-size:14px;margin:4px 0}
.card{background:#0b111c;border:1px solid #1c3b5a;border-radius:10px;padding:12px;margin:8px}
#grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(340px,1fr));gap:10px;margin:10px}
#log{white-space:pre-wrap;background:#000;height:160px;overflow:auto;border-radius:6px;border:1px solid #1c3b5a;padding:6px;margin-top:6px;font-size:12px}
.status{float:right;padding:4px 10px;border-radius:20px;font-size:12px;margin-top:-4px}
#online{background:#0d0;color:#020;border:1px solid #0a0;display:none}
#offline{background:#e33;color:#fff;border:1px solid #700;display:none}
h2{text-align:center;margin:10px 0;color:#8ff;text-shadow:0 0 6px #118}
</style>
</head><body>
<h2>POWCHAIN — Client Complet <span id="online" class="status">Online</span><span id="offline" class="status">Offline</span></h2>

<div id="grid">
<div class="card">
<b>WALLET SOLANA — PHANTOM</b><br>
<button onclick="connectPhantom()">CONNECT PHANTOM</button><br>
Adresse:<div id="ph_addr">—</div>
SOL:<div id="sol_balance">0</div>
USDC Solana:<div id="usdc_balance">0</div>
Montant:<input id="bridge_amt" type="number" step="0.000001"/>
<select id="bridge_asset"><option value="SOL">SOL</option><option value="USDC">USDC</option></select>
<button onclick="bridge()">BRIDGE vers POWCHAIN</button>
</div>

<div class="card">
<b>WALLET POWCHAIN — GÉNÉRATEUR</b><br>
<input id="pw_dest" placeholder="Adresse POWCHAIN"/>
<button onclick="refreshPw()">REFRESH</button>
<div>Adresse: <span id="pw_addr">—</span></div>
<div>POW: <span id="pw_pow">0</span></div>
<div>USDC POW: <span id="pw_usdcpow">0</span></div>
<div>LP POW/USDC: <span id="pw_lp">0</span></div>
</div>

<div class="card">
<b>ACTIONS WALLET POWCHAIN</b><br>
Destinataire POWCHAIN:<input id="send_to"/>
Montant POW:<input id="send_amt"/>
<button onclick="sendPow()">SEND</button><br>
Montant POW à staker:<input id="stake_amt"/>
<button onclick="stake()">STAKE</button>
</div>

<div class="card">
<b>DEX POWCHAIN</b><br>
Montant:<input id="swap_amt"/>
<select id="swap_side"><option value="POW-USDCPOW">POW → USDC POW</option><option value="USDCPOW-POW">USDC POW → POW</option></select>
<button onclick="swap()">SWAP</button>
<div>Prix POW/USDC POW: <span id="price">—</span></div>
</div>

<div class="card">
<b>LP ADD</b><br>
<input id="lp_pow" placeholder="POW">
<input id="lp_usdcpow" placeholder="USDC POW">
<button onclick="addLP()">ADD LP</button>
<div>Un add ≥ 10000 POW & 10000 USDC POW donne badge WHALE.</div>
</div>

<div class="card">
<b>POW EXPLORER</b><br>
<button onclick="loadBlocks()">Charger derniers blocs</button>
<div id="explorer" style="font-size:12px;white-space:pre-wrap;height:200px;overflow:auto;"></div>
</div>

<div class="card">
<b>SCAN WALLET</b><br>
<input id="scan_addr" placeholder="Adresse POWCHAIN">
<button onclick="scanWallet()">GET HASH</button>
<div id="scan_res" style="font-size:12px"></div>
</div>
</div>

<div id="log"></div>

<script>
const API="https://bbqfinance.fun";
const WS="wss://bbqfinance.fun/ws";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"; // Solana USDC
let conn, phantom, phAddr="", pwAddr="", priv="";

function log(t){logEl.innerText+=`\n[${new Date().toLocaleTimeString()}] ${t}`;logEl.scrollTop=logEl.scrollHeight;}
const logEl=document.getElementById("log");

async function connectPhantom(){
 try{
  const provider=window.phantom?.solana; if(!provider) return alert("Phantom non détecté");
  const r=await provider.connect(); phAddr=r.publicKey.toString(); ph_addr.innerText=phAddr;
  const c=new solanaWeb3.Connection("https://api.mainnet-beta.solana.com");
  const sol=await c.getBalance(new solanaWeb3.PublicKey(phAddr)); sol_balance.innerText=(sol/1e9).toFixed(6);
  const tok=await c.getParsedTokenAccountsByOwner(new solanaWeb3.PublicKey(phAddr),{programId:new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")});
  let usdc=0; for(const t of tok.value){if(t.account.data.parsed.info.mint===USDC_MINT){usdc=t.account.data.parsed.info.tokenAmount.uiAmount;}}
  usdc_balance.innerText=usdc.toFixed(2);
  log("Phantom connecté");
 }catch(e){alert("Erreur Phantom: "+e);}
}

async function bridge(){
 if(!phAddr) return alert("Connect Phantom");
 const amt=parseFloat(bridge_amt.value||"0"); if(amt<=0) return;
 log("BRIDGE_REQUEST envoyé "+amt+" "+bridge_asset.value);
 fetch(API+"/tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({type:"BRIDGE_REQUEST",from:phAddr,asset:bridge_asset.value,amount:amt})});
}

async function refreshPw(){
 fetch(API+"/wallet?id="+pwAddr).then(r=>r.json()).then(w=>{
  pw_addr.innerText=pwAddr; pw_pow.innerText=w.pow; pw_usdcpow.innerText=w.usdcpow; pw_lp.innerText=w.lp;
 });
}

function sendPow(){ fetch(API+"/tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({type:"SEND",from:pwAddr,to:send_to.value,amount:parseFloat(send_amt.value||"0")})}); }
function stake(){ fetch(API+"/tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({type:"STAKE",from:pwAddr,amount:parseFloat(stake_amt.value||"0")})}); }
function swap(){ fetch(API+"/tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({type:"SWAP",from:pwAddr,side:swap_side.value,amount:parseFloat(swap_amt.value||"0")})}); }
function addLP(){ fetch(API+"/tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({type:"ADD_LP",from:pwAddr,pow:parseFloat(lp_pow.value||"0"),usdcpow:parseFloat(lp_usdcpow.value||"0")})}); }

function loadBlocks(){ fetch(API+"/chain").then(r=>r.json()).then(b=>explorer.innerText=JSON.stringify(b,null,2)); }
function scanWallet(){ fetch(API+"/wallet?id="+scan_addr.value).then(r=>r.json()).then(r=>scan_res.innerText=JSON.stringify(r,null,2)); }

function wsConnect(){
 conn=new WebSocket(WS);
 conn.onopen=()=>{online.style.display="inline-block";offline.style.display="none";log("WebSocket connecté");}
 conn.onclose=()=>{online.style.display="none";offline.style.display="inline-block";log("WS fermé, retry dans 2s");setTimeout(wsConnect,2000);}
 conn.onmessage=e=>{
  try{const m=JSON.parse(e.data); if(m.type==="update") refreshPw(); if(m.price) price.innerText=m.price;}catch{}
 };
}
wsConnect();
</script>
<script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
</body></html>
  a.download="AMC_export.json";a.click();
 },

 reset(){
  localStorage.removeItem("AMC_V2");location.reload();
 }
};

// --- DEMO EVENTS (à remplacer par vrais hooks)
setInterval(()=>{
 const m=["Lean","Kaizen","QuickWins","TOC","Pareto","OKR"][Math.random()*6|0];
 AMC.event({method:m,pnl:(Math.random()-.4)*5,error:Math.random()<.1});
},1500);

// --- CANVAS ---
const c=document.getElementById("chart"),x=c.getContext("2d");
function draw(){
 c.width=c.clientWidth;c.height=c.clientHeight;
 x.clearRect(0,0,c.width,c.height);

 // PnL
 x.strokeStyle="#0f0";x.beginPath();
 AMC.history.forEach((h,i)=>{
  const y=c.height/2-h.p.pnl*5;
  const px=i*(c.width/AMC.history.length);
  i?x.lineTo(px,y):x.moveTo(px,y);
 });x.stroke();

 // Bars
 const S=AMC.improvements;
 const vals=[S.short.length,S.mid.length,S.long.length];
 ["#0f0","#ff0","#f00"].forEach((col,i)=>{
  x.fillStyle=col;
  x.fillRect(20+i*40,c.height-vals[i]*10-20,20,vals[i]*10);
 });
 requestAnimationFrame(draw);
}
draw();

// --- STATUS ---
setInterval(()=>{
 document.getElementById("status").innerHTML=
 `LEVEL: ${AMC.level}<br>
 PNL: ${AMC.perf.pnl.toFixed(2)}<br>
 ERR: ${AMC.perf.errors}<br>
 SHORT:${AMC.improvements.short.length}
 MID:${AMC.improvements.mid.length}
 LONG:${AMC.improvements.long.length}`;
},500);
</script>
</html>








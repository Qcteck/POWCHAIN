// server.js - FIREINNERS Validator + API + WS (bridge réel SOL -> FIREINNERS)

const express = require("express");
const bodyParser = require("body-parser");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const crypto = require("crypto");
const http = require("http");
const { TextEncoder } = require("util");

// =========================
// CONFIG SERVEUR
// =========================

const HTTP_PORT = 3000; // nginx proxy vers 127.0.0.1:3000
const WS_PATH = "/ws";  // nginx location /ws

const SOLANA_RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const TREASURY_SOL = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

const app = express();
app.use(bodyParser.json());

const server = http.createServer(app);
const wss = new WebSocket.Server({ server, path: WS_PATH });

const clients = new Set();

// =========================
// CONFIG ECONOMIE FIREINNERS
// =========================

const DEC = 1e6; // 6 décimales microFIRE
const SUPPLY_MAX = 100_000_000 * DEC; // hard cap 100M FIRE

// Taux dynamique FIRE/SOL (borne)
const RATE_BASE = 1000; // base FIRE par SOL
const TVL_REF = 1_000_000 * DEC; // 1M USDC FIRE de référence
const RATE_MIN = 800;
const RATE_MAX = 5000;

// Frais en basis points
const FEE_TRANSFER_BURN_BP = 50;   // 0.5% burn sur transferts FIRE
const FEE_SWAP_TOTAL_BP = 30;      // 0.3% fees total sur swap
const FEE_SWAP_BURN_PART = 0.5;    // 50% des fees swap brûlés
const FEE_BRIDGE_IN_TREAS_BP = 500; // 5% vers trésorerie à l'entrée
const FEE_BRIDGE_IN_BURN_BP = 200;  // 2% burn à l'entrée
const FEE_BRIDGE_OUT_BURN_BP = 1000; // 10% burn sur FIRE renvoyés
const FEE_UNSTAKE_BURN_BP = 300;   // 3% burn sur unstake anticipé

const STAKE_MIN_LOCK_MS = 30 * 24 * 60 * 60 * 1000; // 30 jours

// =========================
// ETAT GLOBAL
// =========================

let wallets = {}; // addr -> { fire, usdc, staked, pub, nonce, stakeLock }
let treasury = { fire: 0, usdc: 0, sol: 0 };
let lp = { fire: 0, usdc: 0 };

let supplyCirculante = 0;
let mintedFireTotal = 0;
let burnedFireTotal = 0;

let chain = [];
let mempool = [];

const bridgedTx = new Set(); // txSig déjà utilisés pour bridge

// =========================
// GENESIS
// =========================

(function initGenesis() {
  // Option 1 : toute l’émission vient du bridge SOL -> FIREINNERS
  supplyCirculante = 0;
  mintedFireTotal = 0;
  burnedFireTotal = 0;
  treasury.fire = 0;
  treasury.usdc = 0;
  treasury.sol = 0;

  const genesis = {
    height: 1,
    time: Date.now(),
    prevHash: "0".repeat(64),
    hash: "GENESIS",
    txs: [],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp },
    supplyCirculante,
    supplyDisponible: SUPPLY_MAX - supplyCirculante
  };
  chain.push(genesis);
})();

// =========================
// OUTILS
// =========================

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  for (const ws of clients) {
    if (ws.readyState === WebSocket.OPEN) {
      ws.send(msg);
    }
  }
}

function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = {
      fire: 0,
      usdc: 0,
      staked: 0,
      pub: addr,
      nonce: 0,
      stakeLock: 0
    };
  }
  return wallets[addr];
}

function clamp(x, min, max) {
  return x < min ? min : x > max ? max : x;
}

// TVL en USDC FIRE: LP + trésorerie
function getTVL() {
  const lpUsdc = lp.usdc || 0;
  const treUsdc = treasury.usdc || 0;
  return lpUsdc + treUsdc;
}

// Taux dynamique FIRE / SOL borné
function getFireRatePerSol() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || DEC);
  const rawRate = RATE_BASE * factor;
  const rate = clamp(rawRate, RATE_MIN, RATE_MAX);
  return rate;
}

function burnFire(amount) {
  if (!amount || amount <= 0) return 0;
  const actual = Math.min(amount, supplyCirculante);
  burnedFireTotal += actual;
  supplyCirculante -= actual;
  return actual;
}

function mintFire(amount) {
  if (!amount || amount <= 0) return 0;
  const spaceLeft = SUPPLY_MAX - supplyCirculante;
  const mintable = Math.max(0, Math.min(amount, spaceLeft));
  mintedFireTotal += mintable;
  supplyCirculante += mintable;
  return mintable;
}

function addFireToWallet(addr, amount) {
  const w = ensureWallet(addr);
  w.fire += amount;
}

function subFireFromWallet(addr, amount) {
  const w = ensureWallet(addr);
  if (w.fire < amount) throw new Error("Solde FIRE insuffisant");
  w.fire -= amount;
}

function addUsdcToWallet(addr, amount) {
  const w = ensureWallet(addr);
  w.usdc += amount;
}

function subUsdcFromWallet(addr, amount) {
  const w = ensureWallet(addr);
  if (w.usdc < amount) throw new Error("Solde USDC FIRE insuffisant");
  w.usdc -= amount;
}

function applyBp(amount, bp) {
  return Math.floor(amount * bp / 10000);
}

// Prix LP (microUSDC / microFIRE)
function getLpPrice() {
  if (lp.fire <= 0 || lp.usdc <= 0) return 0;
  return lp.usdc / lp.fire;
}

function fmtMicro(x) {
  return (x / DEC).toFixed(6);
}

// =========================
// BLOCKCHAIN LOCALE
// =========================

function appendBlock(tx) {
  const prev = chain[chain.length - 1];
  const height = prev.height + 1;
  const payload = {
    height,
    time: Date.now(),
    prevHash: prev.hash,
    txs: [tx],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp },
    supplyCirculante,
    supplyDisponible: SUPPLY_MAX - supplyCirculante
  };
  const hash = crypto
    .createHash("sha256")
    .update(JSON.stringify(payload))
    .digest("hex");
  const block = { ...payload, hash };
  chain.push(block);
  broadcast({ type: "BLOCK", block });
}

// =========================
// VERIFICATION SIGNATURE TX
// =========================

function verifySignedTxShape(tx) {
  if (!tx.type) throw new Error("type manquant");
  if (!tx.from) throw new Error("from manquant");
  if (typeof tx.nonce !== "number") throw new Error("nonce manquant");
  if (!tx.pub) throw new Error("pub manquant");
  if (!tx.sig) throw new Error("sig manquant");
}

function verifySignature(tx) {
  verifySignedTxShape(tx);
  const msg = {
    type: tx.type,
    from: tx.from,
    to: tx.to ?? null,
    amount: tx.amount ?? null,
    token: tx.token ?? null,
    nonce: tx.nonce
  };
  const enc = new TextEncoder();
  const msgBytes = enc.encode(JSON.stringify(msg));
  const pub = bs58.decode(tx.pub);
  const sig = bs58.decode(tx.sig);
  const ok = nacl.sign.detached.verify(msgBytes, sig, pub);
  if (!ok) throw new Error("signature invalide");
  const w = ensureWallet(tx.from);
  if (tx.nonce !== w.nonce + 1) {
    throw new Error("nonce invalide");
  }
  w.nonce = tx.nonce;
}

// =========================
// HANDLERS ECONOMIQUES
// =========================

// 1) TRANSFERT FIRE
function processFireTransfer(tx) {
  if (!tx.from || !tx.to) throw new Error("from/to manquant");
  if (!tx.amount || tx.amount <= 0) throw new Error("amount invalide");

  const gross = tx.amount;
  const feeBurn = applyBp(gross, FEE_TRANSFER_BURN_BP);
  const sendAmount = gross - feeBurn;
  if (sendAmount <= 0) throw new Error("montant après burn insuffisant");

  subFireFromWallet(tx.from, gross);
  addFireToWallet(tx.to, sendAmount);
  const burned = burnFire(feeBurn);

  return {
    type: "TX_FIRE",
    from: tx.from,
    to: tx.to,
    gross,
    sendAmount,
    burned
  };
}

// 2) SWAP FIRE / USDC FIRE
function processSwap(tx) {
  const { from, amount, token } = tx;
  if (!from) throw new Error("from manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");
  if (!lp.fire || !lp.usdc) throw new Error("pool LP vide");
  if (token !== "fire2usdc" && token !== "usdc2fire") {
    throw new Error("direction swap invalide");
  }

  const feeTotal = applyBp(amount, FEE_SWAP_TOTAL_BP);
  const amountNet = amount - feeTotal;
  if (amountNet <= 0) throw new Error("amount net swap invalide");

  const feeBurn = Math.floor(feeTotal * FEE_SWAP_BURN_PART);
  const feeTreas = feeTotal - feeBurn;

  if (token === "fire2usdc") {
    subFireFromWallet(from, amount);
    lp.fire += amountNet;

    const k = lp.fire * lp.usdc;
    const newFire = lp.fire;
    const newUsdc = Math.floor(k / newFire);
    const deltaUsdc = lp.usdc - newUsdc;
    if (deltaUsdc <= 0) throw new Error("delta usdc invalide");
    lp.usdc = newUsdc;

    addUsdcToWallet(from, deltaUsdc);

    const burned = burnFire(feeBurn);
    treasury.fire += feeTreas;
    supplyCirculante += feeTreas;

    return {
      type: "SWAP",
      dir: "fire2usdc",
      inFire: amount,
      outUsdc: deltaUsdc,
      feeBurn: burned,
      feeTreasFire: feeTreas
    };
  } else {
    subUsdcFromWallet(from, amount);
    lp.usdc += amountNet;

    const k = lp.fire * lp.usdc;
    const newUsdc = lp.usdc;
    const newFire = Math.floor(k / newUsdc);
    const deltaFire = lp.fire - newFire;
    if (deltaFire <= 0) throw new Error("delta fire invalide");
    lp.fire = newFire;

    addFireToWallet(from, deltaFire);

    const burned = burnFire(feeBurn);
    treasury.usdc += feeTreas;

    return {
      type: "SWAP",
      dir: "usdc2fire",
      inUsdc: amount,
      outFire: deltaFire,
      feeBurn: burned,
      feeTreasUsdc: feeTreas
    };
  }
}

// 3) LP ADD
function processLPAdd(tx) {
  const { from, pow, usdc } = tx;
  const fireAmt = pow; // compat précédent code (champ pow)
  if (!from) throw new Error("from manquant");
  if (!fireAmt || fireAmt <= 0 || !usdc || usdc <= 0) {
    throw new Error("valeurs LP invalides");
  }
  subFireFromWallet(from, fireAmt);
  subUsdcFromWallet(from, usdc);
  lp.fire += fireAmt;
  lp.usdc += usdc;
  return {
    type: "LP_ADD",
    addr: from,
    fire: fireAmt,
    usdc
  };
}

// 4) BRIDGE SOL -> FIREINNERS (côté économie seulement)
function processBridgeIn({ addr, solAmount }) {
  if (!addr) throw new Error("addr manquant");
  if (!solAmount || solAmount <= 0) throw new Error("solAmount invalide");

  const rate = getFireRatePerSol();
  const fireBrut = Math.floor(solAmount * rate * DEC);

  const fireMinted = mintFire(fireBrut);
  if (fireMinted <= 0) throw new Error("supply max atteint");

  const feeTreas = applyBp(fireMinted, FEE_BRIDGE_IN_TREAS_BP);
  const feeBurn = applyBp(fireMinted, FEE_BRIDGE_IN_BURN_BP);
  const userFire = fireMinted - feeTreas - feeBurn;
  if (userFire <= 0) throw new Error("bridge in net <= 0");

  treasury.fire += feeTreas;
  const burned = burnFire(feeBurn);
  addFireToWallet(addr, userFire);

  treasury.sol += solAmount;

  return {
    type: "BRIDGE_IN",
    addr,
    solAmount,
    rateFirePerSol: rate,
    fireMinted,
    userFire,
    feeTreasFire: feeTreas,
    burnedFire: burned,
    supplyCirculante,
    supplyDisponible: SUPPLY_MAX - supplyCirculante
  };
}

// 5) BRIDGE FIRE -> SOL (optionnel, garde la logique)
function processBridgeOut(tx) {
  const { from, powAmount } = tx;
  const fireAmount = powAmount;
  if (!from) throw new Error("addr manquant");
  if (!fireAmount || fireAmount <= 0) throw new Error("fireAmount invalide");

  const rate = getFireRatePerSol();

  subFireFromWallet(from, fireAmount);

  const feeBurn = applyBp(fireAmount, FEE_BRIDGE_OUT_BURN_BP);
  const fireNet = fireAmount - feeBurn;
  if (fireNet <= 0) throw new Error("bridge out net <= 0");

  const burned = burnFire(fireAmount);
  const solOut = fireNet / (rate * DEC);
  if (treasury.sol < solOut) {
    throw new Error("SOL trésorerie insuffisant pour bridge out");
  }
  treasury.sol -= solOut;

  return {
    type: "BRIDGE_OUT",
    addr: from,
    fireSent: fireAmount,
    fireNet,
    burnedFire: burned,
    rateFirePerSol: rate,
    solOut
  };
}

// 6) STAKING
function processStake(tx) {
  const { from, amount } = tx;
  if (!from) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");

  const w = ensureWallet(from);
  if (w.fire < amount) throw new Error("solde FIRE insuffisant");

  w.fire -= amount;
  w.staked += amount;
  w.stakeLock = Date.now() + STAKE_MIN_LOCK_MS;

  return {
    type: "STAKE",
    addr: from,
    amount,
    lockUntil: w.stakeLock
  };
}

function processUnstake(tx) {
  const { from, amount } = tx;
  if (!from) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");

  const w = ensureWallet(from);
  if (w.staked < amount) throw new Error("staked insuffisant");

  const now = Date.now();
  let burnFee = 0;
  let net = amount;

  if (now < (w.stakeLock || 0)) {
    burnFee = applyBp(amount, FEE_UNSTAKE_BURN_BP);
    net = amount - burnFee;
  }

  w.staked -= amount;
  w.fire += net;
  const burned = burnFire(burnFee);

  return {
    type: "UNSTAKE",
    addr: from,
    amount,
    net,
    burned
  };
}

// =========================
// TRAITEMENT TX INBOUND WS
// =========================

function applyTx(tx) {
  switch (tx.type) {
    case "TX_FIRE":
    case "TX_POW": // compat ancien client
      return processFireTransfer(tx);
    case "SWAP":
      return processSwap(tx);
    case "LP_ADD":
      return processLPAdd(tx);
    case "STAKE":
      return processStake(tx);
    case "UNSTAKE":
      return processUnstake(tx);
    case "BRIDGE_OUT":
      return processBridgeOut(tx);
    default:
      throw new Error("type de tx inconnu");
  }
}

wss.on("connection", (ws) => {
  clients.add(ws);
  ws.on("close", () => clients.delete(ws));

  ws.on("message", (data) => {
    let tx;
    try {
      const txt = typeof data === "string" ? data : data.toString("utf8");
      tx = JSON.parse(txt);
    } catch (e) {
      console.error("WS parse error", e.message);
      return;
    }

    try {
      verifySignature(tx);
      const result = applyTx(tx);
      const record = { ...tx, result };
      mempool.push(record);
      appendBlock(record);
      ws.send(JSON.stringify({ type: "TX_OK", tx: tx.type, result }));
    } catch (e) {
      console.error("TX error", e.message);
      ws.send(JSON.stringify({ type: "TX_ERR", error: e.message }));
    }
  });
});

// =========================
// RPC SOLANA: VERIF BRIDGE
// =========================

async function fetchSolanaTransaction(txSig) {
  const body = {
    jsonrpc: "2.0",
    id: 1,
    method: "getTransaction",
    params: [
      txSig,
      {
        encoding: "jsonParsed",
        commitment: "confirmed",
        maxSupportedTransactionVersion: 0
      }
    ]
  };
  const r = await fetch(SOLANA_RPC, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });
  if (!r.ok) {
    throw new Error("RPC HTTP " + r.status);
  }
  const j = await r.json();
  if (!j.result) throw new Error("tx introuvable");
  return j.result;
}

async function verifySolanaBridgeTx(fromSol, txSig) {
  const tx = await fetchSolanaTransaction(txSig);

  if (tx.meta && tx.meta.err) {
    throw new Error("transaction Solana en erreur");
  }

  const keysRaw = tx.transaction.message.accountKeys || [];
  const keys = keysRaw.map((k) =>
    typeof k === "string" ? k : k.pubkey
  );

  const fromIndex = keys.findIndex((k) => k === fromSol);
  const treIndex = keys.findIndex((k) => k === TREASURY_SOL);

  if (fromIndex < 0 || treIndex < 0) {
    throw new Error("compte source ou trésorerie non trouvé dans la tx");
  }

  const preFrom = tx.meta.preBalances[fromIndex];
  const postFrom = tx.meta.postBalances[fromIndex];
  const preTre = tx.meta.preBalances[treIndex];
  const postTre = tx.meta.postBalances[treIndex];

  const spent = preFrom - postFrom;
  const received = postTre - preTre;
  const lamports = Math.min(spent, received);

  if (lamports <= 0) {
    throw new Error("aucun SOL transféré vers la trésorerie");
  }

  const solAmount = lamports / 1_000_000_000;
  return { solAmount, lamports };
}


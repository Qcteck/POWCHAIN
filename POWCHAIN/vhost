nano /etc/nginx/sites-available/bbqfinance

server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    # UI (index.html) en priorité, sinon on envoie vers l'API Node
    location / {
        try_files $uri $uri/ @api;
    }

    # API POWCHAIN sur port 3000
    location @api {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket POWCHAIN sur port 7001
    location /ws {
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:7001;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }
}

ln -sf /etc/nginx/sites-available/bbqfinance /etc/nginx/sites-enabled/bbqfinance
rm -f /etc/nginx/sites-enabled/default

nginx -t


systemctl restart nginx




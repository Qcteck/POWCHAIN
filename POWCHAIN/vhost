  // Bridge SOL → FIREINNERS avec vraie TX
  async function bridgeSolToFireinners(){
    try{
      const bridgeInfo = q("#bridgeInfo");
      if(bridgeInfo) bridgeInfo.textContent = "";

      if(!window.solana || !window.solana.isPhantom){
        alert("Installe Phantom pour utiliser le bridge.");
        return;
      }

      const inp = q("#inpBridgeSol");
      if(!inp){
        alert("Champ montant SOL introuvable.");
        return;
      }
      const solAmount = parseFloat(inp.value.replace(",","."));
      if(!solAmount || solAmount <= 0){
        alert("Montant SOL invalide.");
        return;
      }

      let resp = await window.solana.connect();
      const fromPubkey = resp.publicKey;
      solPubkey = fromPubkey;
      q("#solAddr").textContent = fromPubkey.toBase58();
      log("Phantom connecté : " + fromPubkey.toBase58());

      const toPubkey = new solanaWeb3.PublicKey(TREASURY_SOL_ADDRESS);
      const lamports = Math.floor(solAmount * LAMPORTS_PER_SOL);

      const { blockhash, lastValidBlockHeight } = await connSol.getLatestBlockhash("finalized");

      const tx = new solanaWeb3.Transaction({
        recentBlockhash: blockhash,
        feePayer: fromPubkey
      }).add(
        solanaWeb3.SystemProgram.transfer({
          fromPubkey,
          toPubkey,
          lamports
        })
      );

      log("Préparation TX Solana → trésorerie "+TREASURY_SOL_ADDRESS+" ("+solAmount+" SOL)…");

      const signed = await window.solana.signTransaction(tx);
      const rawTx = signed.serialize();

      const sig = await connSol.sendRawTransaction(rawTx, { skipPreflight:false, maxRetries:3 });
      log("TX envoyée, signature : " + sig);

      await connSol.confirmTransaction(
        { signature:sig, blockhash, lastValidBlockHeight },
        "confirmed"
      );
      log("TX Solana confirmée");

      if(!window.currentFireAddr){
        alert("Aucun wallet FIREINNERS local trouvé, génère ou charge-en un.");
        return;
      }

      const payload = {
        addr: window.currentFireAddr,
        solAmount: solAmount,
        txSig: sig
      };

      log("Appel /bridge avec solAmount="+solAmount+" pour "+window.currentFireAddr);

      const res = await fetch("/bridge",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify(payload)
      });
      const json = await res.json();

      if(!json.ok){
        log("Erreur backend /bridge : "+json.error);
        alert("Bridge FIREINNERS refusé : "+json.error);
        return;
      }

      log("Bridge FIREINNERS OK : "+JSON.stringify(json.bridge));

      if(bridgeInfo){
        bridgeInfo.textContent =
          "Bridge on-chain confirmé.\nTX Solana: "+sig+
          "\nFIRE crédité: "+((json.bridge.userFire||0)/DEC).toFixed(6)+
          "\nSupply disponible: "+((json.bridge.supplyDisponible||0)/DEC).toFixed(2)+" FIRE";
      }

      await refreshNet();
      await loadWallet();
      await refreshSolBalances();

      alert("Bridge réussi, FIRE crédité sur "+window.currentFireAddr);

    }catch(e){
      log("Erreur bridge : "+(e.message||e));
      alert("Erreur bridge : "+(e.message||e));
    }
  }

  q("#btnBridgeSol").onclick = bridgeSolToFireinners;


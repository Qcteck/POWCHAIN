set -euo pipefail

echo "=== SYSTEM ==="
uname -a || true
lsb_release -a 2>/dev/null || true
date

echo
echo "=== PORTS / SERVICES ==="
sudo ss -lntp | sed -n '1,160p' || true
echo
echo "Nginx:"
sudo systemctl status nginx --no-pager 2>/dev/null | sed -n '1,120p' || true
echo
echo "UFW:"
sudo ufw status 2>/dev/null || true

echo
echo "=== NODE / NPM ==="
command -v node && node -v || echo "node absent"
command -v npm  && npm -v  || echo "npm absent"

echo
echo "=== DNS (depuis le VPS) ==="
HOST="sentinel.fireinners.online"
getent hosts "$HOST" || echo "DNS pas resolu pour $HOST"

echo
echo "=== FIREINNERS SECURITY SENTINEL (local) ==="
APP_DIR="$HOME/fireinners-security-sentinel"
if [ -d "$APP_DIR" ]; then
  echo "APP_DIR ok: $APP_DIR"
  ls -la "$APP_DIR" | sed -n '1,120p'
  echo
  echo ".env present?"
  [ -f "$APP_DIR/.env" ] && echo "OK" || echo "MANQUANT"
  echo
  echo "Test local HTTP:"
  curl -sS --max-time 2 http://127.0.0.1:9696/public/state | head -c 300; echo
else
  echo "APP_DIR manquant: $APP_DIR"
fi

echo
echo "=== NGINX SITES ==="
sudo ls -la /etc/nginx/sites-enabled 2>/dev/null || true
echo
echo "Config sentinel si presente:"
sudo grep -R "sentinel.fireinners.online" -n /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null || true

echo
echo "=== CERTBOT / LETSENCRYPT ==="
command -v certbot >/dev/null 2>&1 && certbot --version || echo "certbot absent"
sudo ls -la /etc/letsencrypt/live 2>/dev/null || true
sudo test -d /etc/letsencrypt/live/sentinel.fireinners.online && sudo ls -la /etc/letsencrypt/live/sentinel.fireinners.online || echo "pas de cert pour sentinel.fireinners.online"

echo
echo "=== FIN ==="
bash -lc 'set -euo pipefail
echo "=== BATCH FLY 8080 (SAFE) ==="
echo "[DATE] $(date -Is)"
echo
echo "[LISTEN 8080]"
ss -ltnp 2>/dev/null | grep -E "LISTEN.*:8080[[:space:]]" || echo "nothing-listening-on-8080"
echo
PID="$(ss -ltnp 2>/dev/null | grep -E "LISTEN.*:8080[[:space:]]" | sed -n "s/.*pid=\\([0-9]\\+\\).*/\\1/p" | head -n1 || true)"
if [ -n "${PID:-}" ]; then
  echo "[PID] $PID"
  echo
  echo "[PROCESS]"
  ps -p "$PID" -o pid,ppid,user,etime,cmd || true
  echo
  echo "[CMDLINE]"
  tr "\0" " " < "/proc/$PID/cmdline" 2>/dev/null || true
  echo; echo
  echo "[CWD]"
  readlink -f "/proc/$PID/cwd" 2>/dev/null || true
  echo
  echo "[EXE]"
  readlink -f "/proc/$PID/exe" 2>/dev/null || true
else
  echo "[PID] none"
fi
echo
echo "[PM2]"
command -v pm2 >/dev/null 2>&1 && pm2 ls || echo "pm2:not-found"
echo
echo "[DOCKER]"
command -v docker >/dev/null 2>&1 && docker ps --format "table {{.Names}}\t{{.Ports}}\t{{.Image}}" || echo "docker:not-found"
echo
echo "[HTTP PROBE]"
curl -sS -m 2 -i http://127.0.0.1:8080/ 2>/dev/null | sed -n "1,30p" || echo "curl:/ fail"
echo
echo "[HTTP PROBE /status]"
curl -sS -m 2 -i http://127.0.0.1:8080/status 2>/dev/null | sed -n "1,30p" || echo "curl:/status fail"
echo
echo "[NGINX refs 8080]"
command -v nginx >/dev/null 2>&1 && nginx -T 2>/dev/null | grep -nE "8080|proxy_pass|upstream" | head -n 120 || echo "nginx:not-found"
echo "=== END ==="
'
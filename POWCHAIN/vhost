sudo nano /etc/nginx/sites-available/bbqfinance.fun


server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;

    location / {
        try_files $uri /index.html;
    }

    # Proxy API Node.js
    location /api/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Proxy WebSocket FIREINNERS
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        proxy_set_header Host $host;
    }
}


sudo ln -sf /etc/nginx/sites-available/bbqfinance.fun /etc/nginx/sites-enabled/bbqfinance.fun



sudo nginx -t


sudo systemctl reload nginx





pm2 restart fireinners

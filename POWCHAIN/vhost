import express from "express";import cors from "cors";import fetch from "node-fetch";import fs from "fs";import path from "path";const PORT=Number(process.env.PORT||3000),ROOT=process.env.APP_DIR||process.cwd(),PUB=path.join(ROOT,"public");if(!fs.existsSync(PUB))fs.mkdirSync(PUB,{recursive:true});const app=express();app.use(cors({origin:"*",methods:["GET","POST","OPTIONS"],allowedHeaders:["content-type"]}));app.use(express.json({limit:"1mb"}));app.get("/ping",(req,res)=>res.type("text").send("ok"));app.get("/findtoken/pump",async(req,res)=>{try{const limit=Math.min(200,Math.max(1,Number(req.query.limit||80))),offset=Math.max(0,Number(req.query.offset||0));const url=`https://frontend-api.pump.fun/coins?offset=${offset}&limit=${limit}&sort=created_timestamp&order=desc`;const r=await fetch(url,{headers:{"accept":"application/json","user-agent":"bbtrader/1.0"}});if(!r.ok)return res.status(502).json({error:"PUMP_FETCH_FAIL",status:r.status});const j=await r.json();const coins=Array.isArray(j?.coins)?j.coins:(Array.isArray(j)?j:[]);const items=coins.filter(c=>c&&(c.mint||c.address)).map(c=>({symbol:c.symbol||"?",name:c.name||"",mint:c.mint||c.address,created:Number(c.created_timestamp||c.created||0),marketCap:Number(c.market_cap||c.marketCap||0)}));res.json({count:items.length,items});}catch(e){res.status(500).json({error:"PUMP_FAIL",message:String(e?.message||e)})}});app.get("/dex/tokens/:mint",async(req,res)=>{try{const mint=String(req.params.mint||"").trim();if(mint.length<20)return res.status(400).json({error:"BAD_MINT"});const url=`https://api.dexscreener.com/latest/dex/tokens/${encodeURIComponent(mint)}`;const r=await fetch(url,{headers:{"accept":"application/json","user-agent":"bbtrader/1.0"}});if(!r.ok)return res.status(502).json({error:"DEX_FETCH_FAIL",status:r.status});const body=await r.text();res.setHeader("content-type","application/json");res.send(body);}catch(e){res.status(500).json({error:"DEX_FAIL",message:String(e?.message||e)})}});app.use("/",express.static(PUB,{extensions:["html"]}));app.get("*",(req,res)=>{const p=path.join(PUB,"index.html");if(fs.existsSync(p))res.sendFile(p);else res.status(404).type("text").send("Missing public/index.html")});app.listen(PORT,"0.0.0.0",()=>console.log(new Date().toISOString(),"BBTRADER backend on",PORT));
const express = require("express");
const cors = require("cors");
const bodyParser = require("body-parser");
const WebSocket = require("ws");

const app = express();
app.use(cors());
app.use(bodyParser.json());

const DEC = 1e6;

// ---- ÉTAT GLOBAL FIREINNERS ----
let state = {
  height: 1,
  wallets: {},
  treasury: {
    solAddress: "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy",
    solBalance: 0,
    usdcBalance: 0,
    fireBalance: 0
  },
  lp: {
    pow: 0,
    usdc: 0
  },
  staking: {
    total: 0
  },
  mempool: [],
  chain: [
    {
      height: 1,
      timestamp: Date.now(),
      type: "genesis",
      data: { msg: "FIREINNERS genesis block" }
    }
  ]
};

// Wallet serveur interne (trésorerie on-chain)
let serverWallet = {
  pub: "FIREINNERS_SERVER",
  pow: 1000000 * DEC,
  usdc: 50000 * DEC,
  staked: 0,
  nonce: 0
};
state.wallets[serverWallet.pub] = serverWallet;

// ---- UTILITAIRES ----
function getWallet(addr) {
  if (!state.wallets[addr]) {
    state.wallets[addr] = { pub: addr, pow: 0, usdc: 0, staked: 0, nonce: 0 };
  }
  return state.wallets[addr];
}

let wss = null;

function broadcast(obj) {
  if (!wss) return;
  const msg = JSON.stringify(obj);
  wss.clients.forEach(c => {
    if (c.readyState === WebSocket.OPEN) c.send(msg);
  });
}

function pushBlock(type, data) {
  state.height++;
  const blk = {
    height: state.height,
    timestamp: Date.now(),
    type,
    data
  };
  state.chain.push(blk);
  if (state.chain.length > 1000) {
    state.chain = state.chain.slice(-1000);
  }
  broadcast({ type: "new_block", block: blk });
}

function addToMempool(tx) {
  state.mempool.push(tx);
  if (state.mempool.length > 200) {
    state.mempool = state.mempool.slice(-200);
  }
  broadcast({ type: "mempool", mempool: state.mempool });
}

// ---- API REST ----

// Stats globales pour le frontend
app.get("/stats", (req, res) => {
  const totals = Object.values(state.wallets).reduce(
    (acc, w) => {
      acc.pow += w.pow || 0;
      acc.staked += w.staked || 0;
      return acc;
    },
    { pow: 0, staked: 0 }
  );
  res.json({
    height: state.height,
    wallets: Object.keys(state.wallets).length,
    mempool: state.mempool.length,
    totalPow: totals.pow,
    totalStaked: totals.staked,
    lpPow: state.lp.pow,
    lpUsdc: state.lp.usdc,
    treasurySolAddress: state.treasury.solAddress,
    solTreasury: state.treasury.solBalance,
    usdcTreasury: state.treasury.usdcBalance,
    fireTreasury: state.treasury.fireBalance
  });
});

// Détails d’un wallet
app.get("/wallet/:addr", (req, res) => {
  const addr = req.params.addr;
  const w = getWallet(addr);
  res.json({
    pub: w.pub,
    pow: w.pow,
    usdc: w.usdc,
    staked: w.staked,
    nonce: w.nonce
  });
});

// TX simple (optionnelle, pour tests)
app.post("/tx", (req, res) => {
  try {
    const { from, to, token, amount } = req.body;
    if (!from || !to) return res.status(400).json({ ok: false, error: "Missing from/to" });
    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ ok: false, error: "Invalid amount" });
    if (token !== "pow" && token !== "usdc") {
      return res.status(400).json({ ok: false, error: "Invalid token" });
    }
    const wf = getWallet(from);
    const wt = getWallet(to);
    if ((wf[token] || 0) < amt) {
      return res.json({ ok: false, error: "Insufficient balance" });
    }
    wf[token] -= amt;
    wt[token] = (wt[token] || 0) + amt;
    wf.nonce++;

    const tx = { type: "transfer", from, to, token, amount: amt };
    addToMempool(tx);
    pushBlock("transfer", tx);
    broadcast({ type: "tx", tx });

    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// Bridge SOL → FIREINNERS (crédite un wallet POWCHAIN)
app.post("/bridge", (req, res) => {
  try {
    const addr = req.body.addr;
    const sol = Number(req.body.sol || 0);
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    if (!(sol > 0)) return res.status(400).json({ ok: false, error: "Invalid sol amount" });

    const lamports = Math.floor(sol * DEC); // 1 SOL → 1*DEC POW (ajuste à ton goût)
    const w = getWallet(addr);

    // Met à jour trésorerie + wallet user
    state.treasury.solBalance += sol;
    state.treasury.fireBalance += lamports;
    w.pow += lamports;
    w.nonce++;

    const tx = { type: "bridge_in", addr, sol, powCredited: lamports };
    addToMempool(tx);
    pushBlock("bridge_in", tx);

    res.json({ ok: true, credited: lamports });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// Ajout de liquidité LP
app.post("/lp/add", (req, res) => {
  try {
    const { addr, pow, usdc } = req.body;
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const p = Number(pow || 0);
    const u = Number(usdc || 0);
    if (!(p > 0) || !(u > 0)) {
      return res.status(400).json({ ok: false, error: "Invalid amounts" });
    }
    const w = getWallet(addr);
    if (w.pow < p || w.usdc < u) {
      return res.json({ ok: false, error: "Insufficient balance" });
    }
    w.pow -= p;
    w.usdc -= u;
    state.lp.pow += p;
    state.lp.usdc += u;
    w.nonce++;
    const tx = { type: "lp_add", addr, pow: p, usdc: u };
    addToMempool(tx);
    pushBlock("lp_add", tx);
    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// Swap AMM POW ↔ USDC
app.post("/swap", (req, res) => {
  try {
    const { addr, dir, amount } = req.body;
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ ok: false, error: "Invalid amount" });
    if (dir !== "pow2usdc" && dir !== "usdc2pow") {
      return res.status(400).json({ ok: false, error: "Invalid dir" });
    }
    const w = getWallet(addr);
    const feeRate = 0.003;

    if (state.lp.pow <= 0 || state.lp.usdc <= 0) {
      return res.json({ ok: false, error: "Empty LP" });
    }

    if (dir === "pow2usdc") {
      if (w.pow < amt) return res.json({ ok: false, error: "Insufficient POW" });

      const k = state.lp.pow * state.lp.usdc;
      const powAfter = state.lp.pow + amt;
      const usdcAfter = k / powAfter;
      let out = state.lp.usdc - usdcAfter;
      const fee = out * feeRate;
      out -= fee;
      if (out <= 0) return res.json({ ok: false, error: "Swap too small" });

      w.pow -= amt;
      w.usdc += out;
      state.lp.pow += amt;
      state.lp.usdc -= out;
      state.treasury.usdcBalance += fee;
      w.nonce++;

      const tx = { type: "swap_pow2usdc", addr, in: amt, out: out };
      addToMempool(tx);
      pushBlock("swap_pow2usdc", tx);
      return res.json({ ok: true, received: out });
    } else {
      if (w.usdc < amt) return res.json({ ok: false, error: "Insufficient USDC" });

      const k = state.lp.pow * state.lp.usdc;
      const usdcAfter = state.lp.usdc + amt;
      const powAfter = k / usdcAfter;
      let out = state.lp.pow - powAfter;
      const fee = out * feeRate;
      out -= fee;
      if (out <= 0) return res.json({ ok: false, error: "Swap too small" });

      w.usdc -= amt;
      w.pow += out;
      state.lp.usdc += amt;
      state.lp.pow -= out;
      state.treasury.fireBalance += fee;
      w.nonce++;

      const tx = { type: "swap_usdc2pow", addr, in: amt, out: out };
      addToMempool(tx);
      pushBlock("swap_usdc2pow", tx);
      return res.json({ ok: true, received: out });
    }
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// Staking
app.post("/stake", (req, res) => {
  try {
    const { addr, amount } = req.body;
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const amt = Number(amount || 0);

<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>🔥 Fireinners</title>
<style>
body{
  margin:0;
  font-family:system-ui,-apple-system,Segoe UI,sans-serif;
  background:#020005;
  color:#eee;
  overflow:hidden;
}
#app{
  display:flex;
  height:100vh;
  width:100vw;
}

/* ---- SIDEBAR ---- */
#side{
  width:240px;
  background:#050008;
  border-right:1px solid #2b1a22;
  box-shadow:5px 0 25px #000;
  padding:20px 14px;
  display:flex;
  flex-direction:column;
  gap:14px;
}
#logoBox{
  display:flex;
  align-items:center;
  gap:10px;
}
#logoI{
  width:40px;
  height:40px;
  border-radius:50%;
  background:radial-gradient(circle at 30% 30%,#ffed9a,#ff9a2f 55%,#4b1430);
  box-shadow:0 0 20px #ff9a2f88;
}
#logoTxt{
  color:#ffd874;
  font-weight:700;
  font-size:15px;
  letter-spacing:.12em;
}
nav a{
  display:flex;
  align-items:center;
  gap:10px;
  padding:9px 11px;
  font-size:13px;
  border-radius:999px;
  text-decoration:none;
  color:#c7c1ca;
  border:1px solid #2e2236;
  background:linear-gradient(135deg,#120714,#050008);
  cursor:pointer;
  margin-bottom:6px;
  transition:.15s;
}
nav a span.bullet{
  width:6px;
  height:6px;
  border-radius:50%;
  background:#5b4b68;
}
nav a:hover{
  border-color:#ffb347;
  color:#ffe9b0;
  box-shadow:0 0 16px #ff9a2f55;
}
nav a.active{
  border-color:#ffb347;
  background:radial-gradient(circle at 0 0,#ffbb33 0,#2b1020 40%,#050008 75%);
  color:#fff;
  box-shadow:0 0 24px #ff9a2f88 inset;
}

/* ---- MAIN ---- */
#main{
  flex:1;
  display:flex;
  flex-direction:column;
  background:radial-gradient(circle at top,#1a0825,#050008 55%,#000 100%);
}
#top{
  padding:14px 22px;
  border-bottom:1px solid #2a1a33;
  background:radial-gradient(circle at 10% 0,#ffb34722 0,#050008 45%,#020005 100%);
  display:flex;
  justify-content:space-between;
  align-items:center;
}
#top h1{
  margin:0;
  color:#ffcf5c;
  font-size:18px;
  letter-spacing:.12em;
  text-shadow:0 0 12px #ff9a2f99;
}
#top small{
  color:#b89cc6;
  font-size:12px;
}
#syncState{
  font-size:12px;
  padding:6px 10px;
  border-radius:999px;
  border:1px solid #3b2346;
  background:radial-gradient(circle at 0 0,#ffb34755,#190812);
  color:#ffeaa6;
}

/* ---- CONTENT ---- */
#content{
  flex:1;
  overflow:auto;
  padding:18px 20px;
  background:radial-gradient(circle at bottom,#210925,#050008 40%,#000 85%);
}
.section{
  display:none;
  animation:fade .25s ease;
}
.section.active{
  display:block;
}
@keyframes fade{
  from{opacity:0;transform:translateY(5px);}
  to{opacity:1;transform:translateY(0);}
}

/* ---- CARDS ---- */
.card{
  background:radial-gradient(circle at 0 0,#ffb3471a,#120313 45%,#050008 100%);
  border:1px solid #3a243e;
  border-radius:14px;
  padding:14px 14px 12px;
  margin-bottom:14px;
  box-shadow:0 0 30px #000 inset,0 0 18px #120313;
}
.card h2{
  margin:0 0 8px;
  font-size:14px;
  color:#ffe28a;
  letter-spacing:.1em;
  text-transform:uppercase;
}
.lineTitle{
  padding:6px 10px;
  margin:-8px -10px 10px;
  border-radius:12px;
  background:linear-gradient(90deg,#ff9a2f33,#190812 60%,transparent);
  font-size:11px;
  color:#ffdca0;
  text-transform:uppercase;
  letter-spacing:.16em;
}
.row2{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}
.row2>div{
  flex:1;
  min-width:160px;
}
label{
  font-size:11px;
  display:block;
  margin-bottom:4px;
  color:#e0d0f2;
  letter-spacing:.03em;
}
input,select,button{
  width:100%;
  padding:7px 9px;
  margin:3px 0 8px;
  border-radius:9px;
  background:#09020d;
  border:1px solid #3b2346;
  color:#f7f0ff;
  font-size:12px;
  box-sizing:border-box;
}
input[readonly]{
  opacity:.9;
  background:#050008;
}
button{
  background:linear-gradient(90deg,#ff9a2f,#ffc857,#ff9a2f);
  border:1px solid #ffcf5c;
  color:#130307;
  font-weight:600;
  cursor:pointer;
  text-transform:uppercase;
  letter-spacing:.06em;
  box-shadow:0 0 14px #ff9a2f66;
}
button:hover{
  filter:brightness(1.08);
  box-shadow:0 0 20px #ffcf5c88;
}
button.sec{
  background:linear-gradient(90deg,#332040,#1c0a23);
  color:#f4ddff;
  border-color:#4b2b60;
  box-shadow:none;
}
small.hint{
  font-size:11px;
  color:#f9d88a;
  opacity:.9;
}
#log{
  background:#050008;
  border:1px solid #3a243e;
  border-radius:12px;
  padding:10px;
  height:170px;
  overflow:auto;
  font-size:11px;
  color:#ffe9a6;
  white-space:pre-wrap;
  box-shadow:0 0 18px #000 inset;
}
#qrBox{
  width:120px;
  height:120px;
  border-radius:10px;
  border:1px solid #ffcf5c;
  background:#050008;
  margin:4px 0 8px;
  display:flex;
  align-items:center;
  justify-content:center;
}
#qr{
  background:#050008;
}
#mempoolLive{
  height:210px;
  overflow:auto;
  font-size:11px;
  color:#ffe4b8;
  background:#050008;
  border-radius:10px;
  padding:8px;
  border:1px solid #3b234e;
}
pre{margin:0}

/* --- Rareté & animation QR FIREINNERS --- */
#qrBox.qr-common{
  box-shadow:0 0 10px #000;
}
#qrBox.qr-rare{
  animation:qrGlowRare 1.1s ease-in-out infinite alternate;
}
#qrBox.qr-ultra{
  animation:qrGlowUltra 0.6s ease-in-out infinite alternate;
}
@keyframes qrGlowRare{
  from{box-shadow:0 0 8px rgba(255,215,0,.4);}
  to{box-shadow:0 0 22px rgba(255,215,0,1);}
}
@keyframes qrGlowUltra{
  from{box-shadow:0 0 12px rgba(0,255,255,.6);filter:brightness(1);}
  to{box-shadow:0 0 30px rgba(255,255,255,1);filter:brightness(1.28);}
}

/* --- BANNIÈRES --- */
#banners{
  margin-bottom:12px;
}
.bannerBar{
  font-size:11px;
  border-radius:999px;
  padding:4px 10px;
  margin-bottom:6px;
  border:1px solid #3a243e;
  background:linear-gradient(90deg,#1a081a,#120313 40%,#050008 100%);
  overflow:hidden;
  position:relative;
  color:#ffe9b0;
}
.bannerLabel{
  font-weight:600;
  margin-right:10px;
  text-transform:uppercase;
  letter-spacing:.12em;
  color:#ffcf5c;
}
.scrollInner{
  display:inline-block;
  white-space:nowrap;
  animation:ticker 30s linear infinite;
}
@keyframes ticker{
  0%{transform:translateX(0);}
  100%{transform:translateX(-50%);}
}
.tokenTag{
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:1px 6px;
  margin-right:8px;
  border-radius:999px;
  border:1px solid #444;
  background:#0b0410;
  font-size:10px;
}
.tokenLogo{
  width:12px;
  height:12px;
  border-radius:50%;
  background:#ffcf5c;
}

/* FIREBROWSER */
#fireFrame{
  width:100%;
  height:420px;
  border-radius:12px;
  border:1px solid #3a243e;
  background:#000;
}

/* COULEURS DYNAMIQUES */
.colorRow{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}
.colorRow>div{
  flex:1;
  min-width:160px;
}
</style>
<style id="dynTheme"></style>
</head>
<body>
<div id="app">
  <aside id="side">
    <div id="logoBox">
      <div id="logoI"></div>
      <div id="logoTxt">FIREINNERS</div>
    </div>
    <nav>
      <a class="navitem active" data-tab="wallet"><span class="bullet"></span>Wallet</a>
      <a class="navitem" data-tab="bridge"><span class="bullet"></span>Bridge</a>
      <a class="navitem" data-tab="dex"><span class="bullet"></span>DEX</a>
      <a class="navitem" data-tab="stake"><span class="bullet"></span>Staking</a>
      <a class="navitem" data-tab="explorer"><span class="bullet"></span>Explorer</a>
      <a class="navitem" data-tab="mempool"><span class="bullet"></span>Mempool</a>
      <a class="navitem" data-tab="stats"><span class="bullet"></span>Stats</a>
      <a class="navitem" data-tab="firebrowser"><span class="bullet"></span>FIREBROWSER</a>
      <a class="navitem" data-tab="colors"><span class="bullet"></span>Couleur</a>
    </nav>
  </aside>

  <main id="main">
    <div id="top">
      <div>
        <h1>🔥 FIREINNERS</h1>
        <small>Wallet • Bridge • DEX • Staking • Explorer • Browser</small>
      </div>
      <div id="syncState">WS: offline</div>
    </div>

    <div id="content">

      <!-- BANNIÈRES -->
      <div id="banners">
        <div id="priceBanner" class="bannerBar">
          <span class="bannerLabel">Prix</span>
          <span class="scrollInner" id="priceBannerText">Chargement des prix...</span>
        </div>
        <div id="newsBanner" class="bannerBar">
          <span class="bannerLabel">News</span>
          <span class="scrollInner" id="newsBannerText">Chargement des news CryptoNews...</span>
        </div>
        <div id="statsBanner" class="bannerBar">
          <span class="bannerLabel">Stats</span>
          <span class="scrollInner" id="statsBannerText">Chargement des stats FIREINNERS...</span>
        </div>
      </div>

      <!-- WALLET -->
      <div class="section active" id="wallet">
        <div class="card">
          <div class="lineTitle">Solana — Phantom</div>
          <div class="row2">
            <div>
              <label>Adresse Solana</label>
              <input id="solAddr" readonly placeholder="-"/>
            </div>
            <div>
              <label>SOL</label>
              <input id="solBal" readonly placeholder="-"/>
            </div>
            <div>
              <label>USDC</label>
              <input id="usdcBal" readonly placeholder="-"/>
            </div>
          </div>
          <div class="row2">
            <div><button id="btnPhantom">Connecter Phantom</button></div>
            <div><button class="sec" id="btnSolRefresh">Rafraîchir soldes</button></div>
          </div>
          <small class="hint">Assure-toi que <b>bbqfinance.fun</b> est autorisé dans Phantom.</small>
        </div>

        <div class="card">
          <div class="lineTitle">Wallet FIREINNERS — Local</div>

          <div class="row2">
            <div><button id="btnGen">Générer un wallet FIREINNERS</button></div>
            <div><button class="sec" id="btnReloadPow">Recharger balances</button></div>
          </div>

          <label>ID FIREINNERS</label>
          <input id="fireId" readonly placeholder="441-FIRE-..."/>

          <div class="row2">
            <div>
              <label>Adresse FIREINNERS (clé publique)</label>
              <input id="powAddr" readonly placeholder="-"/>
              <label>Clé privée (sauvegarde-la)</label>
              <input id="powPriv" readonly placeholder="-"/>

              <label>Couleur du wallet</label>
              <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;">
                <span id="walletColorDot" style="width:16px;height:16px;border-radius:50%;border:1px solid #fff;background:#ffcf5c;"></span>
                <span id="walletColorName" style="font-size:11px;letter-spacing:.08em;color:#ffe9b0;">-</span>
              </div>
            </div>
            <div>
              <label>QR wallet FIREINNERS</label>
              <div id="qrBox"><canvas id="qr" width="110" height="110"></canvas></div>

              <label>FIRE (balance)</label>
              <input id="powBal" readonly placeholder="0.000000"/>
              <label>USDC(FIRE)</label>
              <input id="powUSDCBal" readonly placeholder="0.000000"/>
              <label>Staked</label>
              <input id="powStakeBal" readonly placeholder="0.000000"/>
              <label>Nonce</label>
              <input id="powNonce" readonly placeholder="0"/>
            </div>
          </div>

          <small class="hint">Ce wallet est <b>local</b> (nacl + base58). Sauvegarde la clé privée avant de fermer la page.</small>
        </div>
      </div>

      <!-- BRIDGE -->
      <div class="section" id="bridge">
        <div class="card">
          <div class="lineTitle">Bridge SOL → FIREINNERS (beta)</div>
          <label>Adresse trésorerie Solana</label>
          <input readonly value="BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy"/>
          <label>Montant en SOL à déclarer</label>
          <input id="bridgeAmt" placeholder="ex: 0.001"/>
          <button id="btnBridge">Déclarer le bridge au backend</button>
          <small class="hint">
            1) Envoie le <b>même montant</b> de SOL vers la trésorerie avec Phantom.<br/>
            2) Clique sur ce bouton pour déclarer le bridge au backend (v0).
          </small>
        </div>
      </div>

      <!-- DEX -->
      <div class="section" id="dex">
        <div class="card">
          <div class="lineTitle">Swap DEX interne FIRE / USDC(FIRE)</div>
          <label>Montant</label>
          <input id="swapAmt" placeholder="10"/>
          <label>Direction</label>
          <select id="swapDir">
            <option value="pow2usdc">FIRE ➜ USDC(FIRE)</option>
            <option value="usdc2pow">USDC(FIRE) ➜ FIRE</option>
          </select>
          <button id="btnSwap">Exécuter le swap</button>
          <div class="row2" style="margin-top:8px">
            <div>
              <label>LP FIRE</label>
              <input id="lpPow" readonly/>
            </div>
            <div>
              <label>LP USDC(FIRE)</label>
              <input id="lpUsdc" readonly/>
            </div>
          </div>
          <small class="hint">AMM x·y=k, frais vers la trésorerie.</small>
        </div>

        <div class="card">
          <div class="lineTitle">Ajouter Liquidité (LP)</div>
          <label>FIRE à déposer</label>
          <input id="lpAddPow" placeholder="100"/>
          <label>USDC(FIRE) à déposer</label>
          <input id="lpAddUsdc" placeholder="100"/>
          <button id="btnLPAdd">Ajouter à la pool</button>
          <small class="hint">Le backend peut attribuer un badge “Whale”.</small>
        </div>
      </div>

      <!-- STAKING -->
      <div class="section" id="stake">
        <div class="card">
          <div class="lineTitle">Staking FIRE</div>
          <label>Montant FIRE à staker</label>
          <input id="stakeAmt"/>
          <button id="btnStake">Stake</button>
          <label>Montant staké (backend)</label>
          <input id="stakeView" readonly/>
          <label>Récompenses estimées (placeholder)</label>
          <input id="stakeRewards" readonly value="-"/>
        </div>
      </div>

      <!-- EXPLORER -->
      <div class="section" id="explorer">
        <div class="card">
          <div class="lineTitle">Explorer de blocs FIREINNERS</div>
          <label>Hauteur de bloc</label>
          <input id="blockInp" placeholder="1"/>
          <button id="btnBlock">Voir bloc</button>
          <pre id="blockOut" style="margin-top:8px;font-size:11px;color:#ffe9a6"></pre>
        </div>
      </div>

      <!-- MEMPOOL -->
      <div class="section" id="mempool">
        <div class="card">
          <div class="lineTitle">Mempool — Transactions en direct</div>
          <pre id="mempoolLive"></pre>
        </div>
      </div>

      <!-- STATS -->
      <div class="section" id="stats">
        <div class="card">
          <div class="lineTitle">Stats FIREINNERS</div>
          <div class="row2">
            <div><label>Hauteur</label><input id="sHeight" readonly/></div>
            <div><label>Wallets</label><input id="sWallets" readonly/></div>
            <div><label>Mempool</label><input id="sMP" readonly/></div>
          </div>
          <div class="row2">
            <div><label>Total FIRE</label><input id="sPOW" readonly/></div>
            <div><label>Total Staké</label><input id="sStaked" readonly/></div>
            <div><label>LP FIRE</label><input id="sLPpow" readonly/></div>
            <div><label>LP USDC(FIRE)</label><input id="sLPusdc" readonly/></div>
          </div>
          <div class="row2">
            <div><label>Treasury SOL</label><input id="sTSol" readonly/></div>
            <div><label>Treasury USDC(FIRE)</label><input id="sTUsdc" readonly/></div>
            <div><label>Treasury FIRE</label><input id="sTFire" readonly/></div>
          </div>
        </div>
      </div>

      <!-- FIREBROWSER -->
      <div class="section" id="firebrowser">
        <div class="card">
          <div class="lineTitle">FIREBROWSER — Web sécurisé</div>
          <label>URL à ouvrir</label>
          <div class="row2">
            <div><input id="fbUrl" placeholder="ex: https://bbqfinance.fun"/></div>
            <div><button id="btnOpenBrowser">Ouvrir dans FIREBROWSER</button></div>
          </div>
          <iframe id="fireFrame" sandbox="allow-same-origin allow-scripts allow-forms"></iframe>
          <small class="hint">Navigateur embarqué, isolé du wallet FIREINNERS.</small>
        </div>
      </div>

      <!-- COULEUR -->
      <div class="section" id="colors">
        <div class="card">
          <div class="lineTitle">Couleurs de l’interface</div>
          <div class="colorRow">
            <div>
              <label>Fond principal</label>
              <input type="color" id="colBg" value="#020005"/>
            </div>
            <div>
              <label>Accent (top / bannières)</label>
              <input type="color" id="colAccent" value="#ff9a2f"/>
            </div>
            <div>
              <label>Bordures cartes</label>
              <input type="color" id="colCard" value="#3a243e"/>
            </div>
          </div>
          <button id="btnApplyColors">Appliquer le thème</button>
          <small class="hint">Ajuste quelques éléments sans casser le thème Fireinners.</small>
        </div>
      </div>

      <!-- CONSOLE -->
      <div class="card">
        <div class="lineTitle">Console</div>
        <div id="log"></div>
      </div>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script>
    }
    .pill.bad{
      border-color:#b91c1c66;
      background:#450a0a66;
      color:#fecaca;
    }
    .grid{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
    }
    .card{
      flex:1 1 260px;
      border-radius:10px;

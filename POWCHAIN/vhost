    mempool: state.mempool.length
  }));
  ws.send(JSON.stringify({ type: "mempool", mempool: state.mempool }));
});

// ================== GENESIS ==================
function createGenesis() {
  if (state.height > 0) return;
  const genesis = {
    height: 1,
    prevHash: "GENESIS0",
    ts: nowSeconds(),
    miner: "GENESIS",
    nonce: 0,
    hash: sha256Hex("GENESIS"),
    difficulty: state.mining.difficulty,
    txs: []
  };
  state.blocks.push(genesis);
  state.height = 1;
  state.mining.lastBlockTime = Date.now();
}
createGenesis();

// ================== LANCEMENT ==================
server.listen(PORT, () => {
  console.log("🔥 FIREINNERS backend en ligne sur port", PORT);
});




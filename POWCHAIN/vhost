<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>BBQ Finance — POWCHAIN Dashboard</title>
  <style>
    :root{
      --bg:#020617;
      --bg2:#050b16;
      --panel:#0b1120;
      --panel2:#020617;
      --accent:#38bdf8;
      --accent2:#22d3ee;
      --danger:#ef4444;
      --ok:#22c55e;
      --text:#e5e7eb;
      --muted:#9ca3af;
      --border:#1f2937;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
      background:radial-gradient(circle at top,#0f172a,#020617 55%,#000 100%);
      color:var(--text);
      min-height:100vh;
    }
    #shell{
      min-height:100vh;
      display:flex;
      align-items:flex-start;
      justify-content:center;
      padding:20px 10px;
    }
    #wrap{
      width:100%;
      max-width:1200px;
      background:linear-gradient(145deg,#020617,#020617 40%,#020617 80%);
      border:1px solid #1f2937;
      box-shadow:0 0 60px #000d;
      border-radius:18px;
      padding:16px 16px 20px;
    }
    header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      margin-bottom:12px;
    }
    #logoBlock{
      display:flex;
      align-items:center;
      gap:10px;
    }
    #logoIcon{
      width:38px;
      height:38px;
      border-radius:999px;
      background:radial-gradient(circle,var(--accent2),#0ea5e9 45%,#0f172a 70%);
      box-shadow:0 0 16px #22d3ee88;
    }
    #logoText{
      display:flex;
      flex-direction:column;
      line-height:1.1;
    }
    #logoText span:nth-child(1){
      font-size:20px;
      letter-spacing:.12em;
      text-transform:uppercase;
      color:var(--accent2);
    }
    #logoText span:nth-child(2){
      font-size:11px;
      color:var(--muted);
    }
    #statusBubble{
      display:flex;
      align-items:center;
      gap:6px;
      font-size:12px;
      color:var(--muted);
    }
    #statusDot{
      width:10px;
      height:10px;
      border-radius:999px;
      background:var(--danger);
      box-shadow:0 0 12px #b91c1c;
    }
    #statusText strong{color:var(--danger)}
    #pingBtn{
      border-radius:999px;
      border:1px solid var(--accent);
      background:radial-gradient(circle at top,var(--accent2),#0ea5e9 50%,#0f172a 100%);
      color:#0b1120;
      font-size:11px;
      padding:6px 14px;
      cursor:pointer;
      text-transform:uppercase;
      font-weight:600;
      letter-spacing:.09em;
      box-shadow:0 0 14px #22d3ee88;
    }
    #pingBtn:active{transform:scale(.97)}
    main{
      display:grid;
      grid-template-columns:1.3fr 1.1fr;
      gap:14px;
    }
    @media(max-width:930px){
      main{grid-template-columns:1fr}
    }
    .panel{
      background:radial-gradient(circle at top,#0b1120,#020617 70%);
      border-radius:14px;
      border:1px solid var(--border);
      padding:10px 12px;
      position:relative;
      overflow:hidden;
    }
    .panel::before{
      content:"";
      position:absolute;
      inset:-40%;
      background:radial-gradient(circle at 0 0,rgba(56,189,248,0.08),transparent 55%);
      opacity:.7;
      pointer-events:none;
    }
    .panelTitle{
      font-size:13px;
      text-transform:uppercase;
      letter-spacing:.16em;
      color:var(--accent2);
      margin-bottom:8px;
    }
    .panelSubtitle{
      font-size:11px;
      color:var(--muted);
      margin-bottom:10px;
    }
    .grid2{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
    }
    .metric{
      border-radius:10px;
      border:1px solid #1e293b;
      padding:8px 10px;
      background:linear-gradient(145deg,#020617,#020617 40%,#020617 100%);
      font-size:11px;
    }
    .metricLabel{
      text-transform:uppercase;
      letter-spacing:.12em;
      color:var(--muted);
      margin-bottom:4px;
    }
    .metricValue{
      font-size:15px;
      font-weight:600;
      color:var(--accent2);
      text-shadow:0 0 8px #22d3eeaa;
    }
    .metricSmall{
      font-size:11px;
      color:var(--muted);
      margin-top:2px;
    }
    .walletBlock label,
    .txBlock label{
      display:block;
      font-size:11px;
      color:var(--muted);
      margin-bottom:2px;
    }
    .walletBlock input,
    .txBlock input,
    .txBlock select{
      width:100%;
      border-radius:8px;
      border:1px solid #1f2937;
      background:#020617;
      color:var(--text);
      padding:7px 9px;
      font-size:12px;
      margin-bottom:6px;
    }
    .walletBlock input:focus,
    .txBlock input:focus,
    .txBlock select:focus{
      outline:none;
      border-color:var(--accent2);
      box-shadow:0 0 0 1px #0ea5e966;
    }
    .btnRow{
      display:flex;
      gap:8px;
      margin-top:4px;
      flex-wrap:wrap;
    }
    .btn{
      border-radius:999px;
      border:1px solid #1f2937;
      background:#020617;
      color:var(--text);
      font-size:11px;
      padding:6px 12px;
      cursor:pointer;
      text-transform:uppercase;
      letter-spacing:.08em;
    }
    .btnPrimary{
      border-color:var(--accent2);
      background:radial-gradient(circle at top,var(--accent2),#0ea5e9 60%,#020617 100%);
      color:#020617;
      box-shadow:0 0 12px #22d3ee99;
      font-weight:600;
    }
    .btnDanger{
      border-color:var(--danger);
      color:var(--danger);
    }
    .btn:active{transform:scale(.97)}
    #logPanel{
      height:190px;
      margin-top:6px;
      border-radius:10px;
      border:1px solid #1f2937;
      background:#020617;
      padding:6px 8px;
      font-family:ui-monospace,Consolas,monospace;
      font-size:11px;
      overflow:auto;
      white-space:pre-wrap;
    }
    #logPanel span.ts{color:#4b5563}
    #logPanel span.ok{color:var(--ok)}
    #logPanel span.err{color:var(--danger)}
    #logPanel span.ws{color:var(--accent2)}
    #powStatusRow{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
      margin-top:4px;
      font-size:11px;
    }
    #wsIndicator{
      display:inline-flex;
      align-items:center;
      gap:6px;
    }
    #wsDot{
      width:9px;
      height:9px;
      border-radius:999px;
      background:var(--danger);
      box-shadow:0 0 8px #b91c1c;
    }
    #wsLabel{color:var(--muted)}
    #footerNote{
      margin-top:8px;
      font-size:10px;
      color:#6b7280;
      text-align:right;
    }
  </style>
</head>
<body>
<div id="shell">
  <div id="wrap">
    <header>
      <div id="logoBlock">
        <div id="logoIcon"></div>
        <div id="logoText">
          <span>BBQ FINANCE</span>
          <span>Hub POWCHAIN + Solana</span>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:10px">
        <div id="statusBubble">
          <div id="statusDot"></div>
          <div id="statusText">
            <span>Statut POWCHAIN</span><br>
            <strong>hors ligne</strong>
          </div>
        </div>
        <button id="pingBtn" type="button">Ping</button>
      </div>
    </header>

    <main>
      <section class="panel">
        <div class="panelTitle">Blockchain</div>
        <div class="panelSubtitle">Etat POWCHAIN en direct</div>
        <div class="grid2">
          <div class="metric">
            <div class="metricLabel">Hauteur</div>
            <div class="metricValue" id="m_height">?</div>
            <div class="metricSmall">Blocs minés</div>
          </div>
          <div class="metric">
            <div class="metricLabel">Supply POW</div>
            <div class="metricValue" id="m_supplyPow">?</div>
            <div class="metricSmall">POW en circulation</div>
          </div>
          <div class="metric">
            <div class="metricLabel">LP POW</div>
            <div class="metricValue" id="m_lpPow">?</div>
            <div class="metricSmall">Réserve POW du pool</div>
          </div>
          <div class="metric">
            <div class="metricLabel">LP USDC</div>
            <div class="metricValue" id="m_lpUsdc">?</div>
            <div class="metricSmall">Réserve USDC du pool</div>
          </div>
          <div class="metric">
            <div class="metricLabel">Trésorerie POW</div>
            <div class="metricValue" id="m_treasuryPow">?</div>
            <div class="metricSmall">Balance POW trésorerie</div>
          </div>
          <div class="metric">
            <div class="metricLabel">Trésorerie USDC</div>
            <div class="metricValue" id="m_treasuryUsdc">?</div>
            <div class="metricSmall">Balance USDC trésorerie</div>
          </div>
        </div>
        <div id="powStatusRow">
          <div id="wsIndicator">
            <div id="wsDot"></div>
            <div id="wsLabel">WS déconnecté</div>
          </div>
          <div style="font-size:10px;color:var(--muted)" id="lastUpdate">Dernière mise à jour: jamais</div>
        </div>
        <div id="logPanel"></div>
        <div id="footerNote">Ce dashboard ne signe jamais de transaction Solana. Utilisé uniquement pour la chaîne POWCHAIN locale et les statistiques.</div>
      </section>

      <section class="panel">
        <div class="panelTitle">Wallet POWCHAIN</div>
        <div class="panelSubtitle">Chargement clé privée et envoi de transactions</div>
        <div class="walletBlock">
          <label for="privKey">Clé privée (base58)</label>
          <input id="privKey" type="password" autocomplete="off" placeholder="Coller la clé privée POWCHAIN ici">
          <label for="pubKey">Adresse publique</label>
          <input id="pubKey" type="text" readonly placeholder="Non chargée">
          <div class="btnRow">
            <button class="btn btnPrimary" type="button" id="btnLoadWallet">Charger wallet</button>
            <button class="btn btnDanger" type="button" id="btnClearWallet">Effacer</button>
          </div>
          <div class="grid2" style="margin-top:8px">
            <div class="metric">
              <div class="metricLabel">Solde POW</div>
              <div class="metricValue" id="w_pow">?</div>
            </div>
            <div class="metric">
              <div class="metricLabel">Solde USDC</div>
              <div class="metricValue" id="w_usdc">?</div>
            </div>
          </div>
        </div>

        <div class="panelTitle" style="margin-top:14px">Transactions</div>
        <div class="txBlock">
          <label for="txType">Type</label>
          <select id="txType">
            <option value="transfer">Transfer</option>
            <option value="stake">Stake</option>
            <option value="unstake">Unstake</option>
            <option value="lp_deposit">LP Deposit</option>
            <option value="lp_withdraw">LP Withdraw</option>
          </select>
          <label for="txToken">Token</label>
          <select id="txToken">
            <option value="pow">POW</option>
            <option value="usdc">USDC</option>
          </select>
          <label for="txTo">Destinataire</label>
          <input id="txTo" type="text" placeholder="Adresse POWCHAIN du destinataire">
          <label for="txAmount">Montant</label>
          <input id="txAmount" type="number" step="0.000001" min="0" placeholder="0.0">
          <div class="btnRow">
            <button class="btn btnPrimary" type="button" id="btnSendTx">Envoyer TX</button>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>

<script>
const API="https://bbqfinance.fun";
const WS="wss://bbqfinance.fun/ws";

let ws=null;
let wsTimer=null;
let currentWallet=null;

function log(msg,type){
  const logPanel=document.getElementById("logPanel");
  const line=document.createElement("div");
  const ts=document.createElement("span");
  ts.className="ts";
  const now=new Date();
  const hh=String(now.getHours()).padStart(2,"0");
  const mm=String(now.getMinutes()).padStart(2,"0");
  const ss=String(now.getSeconds()).padStart(2,"0");
  ts.textContent="["+hh+":"+mm+":"+ss+"] ";
  const body=document.createElement("span");
  if(type==="ok")body.className="ok";
  else if(type==="err")body.className="err";
  else if(type==="ws")body.className="ws";
  body.textContent=msg;
  line.appendChild(ts);
  line.appendChild(body);
  logPanel.appendChild(line);
  logPanel.scrollTop=logPanel.scrollHeight;
}

async function refreshStats(){
  try{
    const res=await fetch(API+"/stats",{cache:"no-store"});
    if(!res.ok)throw new Error("HTTP "+res.status);
    const data=await res.json();
    document.getElementById("m_height").textContent=data.height ?? "?";
    document.getElementById("m_supplyPow").textContent=data.supplyPow ?? data.lpPow ?? "?";
    document.getElementById("m_lpPow").textContent=data.lpPow ?? "?";
    document.getElementById("m_lpUsdc").textContent=data.lpUsdc ?? "?";
    document.getElementById("m_treasuryPow").textContent=data.treasuryPow ?? "?";
    document.getElementById("m_treasuryUsdc").textContent=data.treasuryUsdc ?? "?";
    document.getElementById("statusDot").style.background="#22c55e";
    document.getElementById("statusDot").style.boxShadow="0 0 12px #22c55e";
    document.getElementById("statusText").innerHTML="<span>Statut POWCHAIN</span><br><strong style='color:#22c55e'>en ligne</strong>";
    document.getElementById("lastUpdate").textContent="Dernière mise à jour: "+nowTime();
    log("Stats POWCHAIN mises à jour","ok");
  }catch(e){
    document.getElementById("statusDot").style.background="#ef4444";
    document.getElementById("statusDot").style.boxShadow="0 0 12px #b91c1c";
    document.getElementById("statusText").innerHTML="<span>Statut POWCHAIN</span><br><strong style='color:#ef4444'>hors ligne</strong>";
    log("Erreur stats POWCHAIN: "+e.message,"err");
  }
}

function nowTime(){
  const d=new Date();
  const hh=String(d.getHours()).padStart(2,"0");
  const mm=String(d.getMinutes()).padStart(2,"0");
  const ss=String(d.getSeconds()).padStart(2,"0");
  return hh+":"+mm+":"+ss;
}

function connectWS(){
  if(ws)try{ws.close();}catch(_){}
  log("Connexion WS en cours sur "+WS,"ws");
  ws=new WebSocket(WS);
  ws.onopen=()=>{
    document.getElementById("wsDot").style.background="#22c55e";
    document.getElementById("wsDot").style.boxShadow="0 0 10px #22c55e";
    document.getElementById("wsLabel").textContent="WS connecté";
    log("WS connecté","ws");
  };
  ws.onclose=()=>{
    document.getElementById("wsDot").style.background="#ef4444";
    document.getElementById("wsDot").style.boxShadow="0 0 10px #b91c1c";
    document.getElementById("wsLabel").textContent="WS déconnecté";
    log("WS fermé, reconnexion dans 3 s","ws");
    if(wsTimer)clearTimeout(wsTimer);
    wsTimer=setTimeout(connectWS,3000);
  };
  ws.onerror=e=>{
    log("Erreur WS","err");
  };
  ws.onmessage=ev=>{
    log("WS: "+ev.data,"ws");
  };
}

function setupWallet(){
  const privInput=document.getElementById("privKey");
  const pubInput=document.getElementById("pubKey");
  document.getElementById("btnLoadWallet").onclick=function(){
    const priv=privInput.value.trim();
    if(!priv){
      log("Aucune clé privée fournie","err");
      return;
    }
    currentWallet={priv:priv,pub:"loaded_" + priv.slice(0,6)+"..."};
    pubInput.value=currentWallet.pub;
    document.getElementById("w_pow").textContent="?";
    document.getElementById("w_usdc").textContent="?";
    log("Wallet chargé (simulation adresse)","ok");
    // ici tu peux appeler plus tard une route API /wallet pour récupérer les soldes réels
  };
  document.getElementById("btnClearWallet").onclick=function(){
    currentWallet=null;
    privInput.value="";
    pubInput.value="";
    document.getElementById("w_pow").textContent="?";
    document.getElementById("w_usdc").textContent="?";
    log("Wallet effacé du dashboard (clé non sauvegardée)","ok");
  };
}

function setupTx(){
  document.getElementById("btnSendTx").onclick=async function(){
    if(!currentWallet){
      log("Charger un wallet avant d'envoyer une transaction","err");
      return;
    }
    const type=document.getElementById("txType").value;
    const token=document.getElementById("txToken").value;
    const to=document.getElementById("txTo").value.trim();
    const amount=parseFloat(document.getElementById("txAmount").value);
    if(!to){
      log("Champ destinataire vide","err");
      return;
    }
    if(!(amount>0)){
      log("Montant invalide","err");
      return;
    }
    const payload={
      type:type,
      token:token,
      to:to,
      amount:amount,
      from:currentWallet.pub
    };
    log("Préparation TX "+JSON.stringify(payload),"ok");
    try{
      const res=await fetch(API+"/tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
      if(!res.ok)throw new Error("HTTP "+res.status);
      const j=await res.json().catch(()=>({}));
      log("TX envoyée: "+(j.status||"ok"),"ok");
    }catch(e){
      log("Erreur envoi TX: "+e.message,"err");
    }
  };
}

function setupPing(){
  document.getElementById("pingBtn").onclick=function(){
    refreshStats();
  };
}

document.addEventListener("DOMContentLoaded",function(){
  setupWallet();
  setupTx();
  setupPing();
  refreshStats();
  connectWS();
  setInterval(refreshStats,15000);
});
</script>
</body>
</html>
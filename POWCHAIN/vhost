<label>Total Staké</label><input id="sStaked" readonly>
<label>LP POW</label><input id="sLPpow" readonly>
<label>LP USDC</label><input id="sLPusdc" readonly>
<label>Treasury SOL</label><input id="sTSol" readonly>
<label>Treasury USDC POW</label><input id="sTUsdc" readonly>

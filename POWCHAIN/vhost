/etc/nginx/sites-available/bbqfinance.fun


server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # Redirect HTTP -> HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # SSL (Cloudflare Full Strict)
    ssl_certificate /etc/ssl/certs/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/privkey.pem;

    # Sécurité + force HTTPS
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Dossier du frontend
    root /var/www/bbqfinance.fun;
    index index.html;

    # --------------------------
    # 🔥 FRONTEND STATIC FILES
    # --------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # -------------------------------------------------
    # 🔥 BACKEND API Node.js sur port 3000
    # -------------------------------------------------
    location /api/ {
        proxy_pass http://127.0.0.1:3000/;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "keep-alive";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_cache_bypass $http_upgrade;
    }

    # ----------------------------------------------------------------
    # 🔥 WEBSOCKET POWCHAIN (server.js → /ws)
    # ----------------------------------------------------------------
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}



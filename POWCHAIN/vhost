server {
  listen 80;
  listen [::]:80;
  server_name bbqfinance.fun www.bbqfinance.fun;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name bbqfinance.fun www.bbqfinance.fun;

  # SSL (Let’s Encrypt)
  ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # Frontend
  root /var/www/bbqfinance.fun;
  index index.html;

  # Sécurité de base
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # Fichiers statiques
  location = / { try_files /index.html =404; }
  location / {
    try_files $uri $uri/ =404;
  }

  # WebSocket -> Node (server.js port 3000)
  location /ws {
    proxy_pass http://127.0.0.1:3000/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 86400;
  }

  # API routes -> Node (garde ton frontend tel quel, pas besoin de /api)
  location ^~ /wallet/ { proxy_pass http://127.0.0.1:3000; proxy_set_header Host $host; }
  location = /bridge    { proxy_pass http://127.0.0.1:3000; proxy_set_header Host $host; }
  location = /swap      { proxy_pass http://127.0.0.1:3000; proxy_set_header Host $host; }
  location ^~ /lp/      { proxy_pass http://127.0.0.1:3000; proxy_set_header Host $host; }
  location = /stake     { proxy_pass http://127.0.0.1:3000; proxy_set_header Host $host; }
  location ^~ /block/   { proxy_pass http://127.0.0.1:3000; proxy_set_header Host $host; }
  location = /stats     { proxy_pass http://127.0.0.1:3000; proxy_set_header Host $host; }

  # (Optionnel) voir si Node répond
  location = /backend-health {
    proxy_pass http://127.0.0.1:3000/;
    proxy_set_header Host $host;
  }
}




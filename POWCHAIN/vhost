const HTTP_PORT = 3000;
const WS_PORT = 7001;
const DATA_FILE = path.join(__dirname, "powchain_state.json");
const DEC = 1e6;

// ---------- État en mémoire ----------
let chain = [];                // liste de blocs
let wallets = {};              // addr -> {pow,usdc,staked,nonce,pub}
let lpPow = 0;
let lpUsdc = 0;
let treasury = { usdc: 0, sol: 0 };
let mempool = [];
const wsClients = new Set();

// ---------- Persistance ----------
function loadState() {
  try {
    if (fs.existsSync(DATA_FILE)) {
      const raw = fs.readFileSync(DATA_FILE, "utf8");
      const obj = JSON.parse(raw);
      chain = Array.isArray(obj.chain) ? obj.chain : [];
      wallets = obj.wallets || {};
      lpPow = obj.lpPow || 0;
      lpUsdc = obj.lpUsdc || 0;
      treasury = obj.treasury || { usdc: 0, sol: 0 };
      console.log("✅ État POWCHAIN chargé:", chain.length, "blocs");
    } else {
      console.log("ℹ️ Pas de state trouvé, nouvelle chaîne");
    }
  } catch (e) {
    console.error("⚠️ State corrompu, reset:", e.message);
    chain = [];
    wallets = {};
    lpPow = 0;
    lpUsdc = 0;
    treasury = { usdc: 0, sol: 0 };
  }
}
function saveState() {
  try {
    const obj = { chain, wallets, lpPow, lpUsdc, treasury };
    fs.writeFileSync(DATA_FILE, JSON.stringify(obj, null, 2));
  } catch (e) {
    console.error("❌ Erreur sauvegarde state:", e.message);
  }
}
loadState();

// ---------- Utilitaires ----------
function getWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = { pow: 0, usdc: 0, staked: 0, nonce: 0, pub: addr };
  }
  return wallets[addr];
}

function hashBlock(b) {
  const h = crypto
    .createHash("sha256")
    .update(
      JSON.stringify({
        height: b.height,
        prev: b.prev,
        time: b.time,
        validator: b.validator,
        txs: b.txs,
      })
    )
    .digest("hex");
  return h;
}

function chooseValidator() {
  const entries = Object.entries(wallets).filter(([_, w]) => w.staked > 0);
  if (!entries.length) return "SYSTEM";
  const total = entries.reduce((s, [, w]) => s + w.staked, 0);
  let r = Math.random() * total;
  for (const [addr, w] of entries) {
    if ((r -= w.staked) <= 0) return addr;
  }
  return entries[0][0];
}

function verifySig(tx) {
  try {
    if (!tx.sig || !tx.from) return false;
    const msg = Buffer.from(
      JSON.stringify({
        type: tx.type,
        from: tx.from,
        to: tx.to ?? null,
        amount: tx.amount ?? null,
        token: tx.token ?? null,
        nonce: tx.nonce,
      }),
      "utf8"
    );
    const sig = bs58.decode(tx.sig);
    const pk = bs58.decode(tx.from); // adresse = pubkey
    return nacl.sign.detached.verify(msg, sig, pk);
  } catch (e) {
    console.error("verifySig error:", e.message);
    return false;
  }
}


#!/usr/bin/env bash
set -euo pipefail
HTML="/var/www/bbqfinance.fun/index.html"
test -f "$HTML" || { echo "HTML introuvable: $HTML"; exit 1; }
cp -a "$HTML" "$HTML.bak.$(date +%s)"

# 1) API + WS dynamiques (évite les mismatches Cloudflare/Nginx)
perl -i -pe 's#const\s+API\s*=\s*"https?://bbqfinance\.fun"\s*;#const API=location.origin;#g' "$HTML"
perl -i -pe 's#const\s+WS_URL\s*=\s*"wss?://bbqfinance\.fun/ws"\s*;#const WS_URL=(location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws";#g' "$HTML"

# 2) (optionnel) enlève les emojis du ticker si tu veux du 100% clean
perl -i -pe 's/[🟠🟣🔵🧊🔥]//g' "$HTML"

# 3) reload nginx (si tu sers le HTML via nginx)
nginx -t && systemctl reload nginx

echo "OK patch HTML. Backup: $HTML.bak.*"
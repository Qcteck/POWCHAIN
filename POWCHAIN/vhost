<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>POWCHAIN — Client Complet</title>
  <style>
    :root{
      --bg:#020617;
      --bg2:#020b2b;
      --bg3:#020824;
      --card:#020b2b;
      --border:#1e293b;
      --accent:#38bdf8;
      --accent2:#4f46e5;
      --text:#e5ecff;
      --muted:#9ca3af;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
      background:radial-gradient(circle at top,#1f2937,#020617 55%,#000 100%);
      color:var(--text);
      overflow-x:hidden;
    }
    #shell{
      min-height:100vh;
      display:flex;
      background:radial-gradient(circle at top left,#0b1120b3,#020617 60%,#000 100%);
    }
    #side{
      width:230px;
      background:linear-gradient(180deg,#020617,#000814);
      border-right:1px solid #020617;
      box-shadow:10px 0 40px #000c;
      padding:16px 12px;
      display:flex;
      flex-direction:column;
      gap:8px;
    }
    #logo{
      display:flex;
      align-items:center;
      gap:10px;
      margin-bottom:6px;
    }
    #logoIcon{
      width:34px;
      height:34px;
      border-radius:999px;
      background:radial-gradient(circle,#38bdf8,#6366f1 45%,#7c3aed 90%);
      box-shadow:0 0 18px #22d3ee;
    }
    #logo span{
      font-size:13px;
      font-weight:600;
      letter-spacing:.18em;
      text-transform:uppercase;
      color:#bfdbfe;
    }
    #side small{
      font-size:11px;
      color:#9ca3af;
      opacity:.8;
      margin-bottom:12px;
    }
    nav{
      display:flex;
      flex-direction:column;
      gap:3px;
    }
    nav a{
      display:flex;
      align-items:center;
      gap:8px;
      padding:7px 9px;
      border-radius:9px;
      font-size:12px;
      color:#9ca3af;
      text-decoration:none;
      cursor:pointer;
      border:1px solid transparent;
    }
    nav a span.icon{
      width:18px;
      height:18px;
      border-radius:6px;
      background:radial-gradient(circle,#38bdf8,#1d4ed8);
      opacity:.9;
    }
    nav a.active,nav a:hover{
      color:#e5e7eb;
      border-color:#1d4ed8;
      background:linear-gradient(90deg,#020617,#0b1120);
      box-shadow:0 0 20px #1d4ed840;
    }
    #status{
      margin-top:auto;
      padding:8px 9px;
      border-radius:10px;
      border:1px solid #020617;
      background:radial-gradient(circle at top,#020617,#020617 50%,#000814);
      font-size:11px;
      display:flex;
      flex-direction:column;
      gap:4px;
    }
    #status span.tag{
      font-size:10px;
      text-transform:uppercase;
      letter-spacing:.16em;
      color:#60a5fa;
    }
    #status span.ok{
      color:#4ade80;
      font-weight:600;
    }
    #latency{font-size:10px;color:#9ca3af;}
    #mainWrap{
      flex:1;
      display:flex;
      flex-direction:column;
      overflow:hidden;
    }
    #topbar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:10px 18px 8px;
      border-bottom:1px solid #020617;
      background:radial-gradient(circle at top,#020617,#020617 40%,#000 100%);

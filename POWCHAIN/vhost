    function randInt(max){return Math.floor(Math.random()*max);}

    function generateFireWallet(){
      const nato = ["ALPHA","BRAVO","CHARLIE","DELTA","ECHO","FOXTROT","GOLF","HOTEL","INDIA","JULIET","KILO","LIMA","MIKE","NOVEMBER","OSCAR","PAPA","QUEBEC","ROMEO","SIERRA","TANGO","UNIFORM","VICTOR","WHISKEY","XRAY","YANKEE","ZULU"];
      const colors = [
        "#ff0000","#00ff00","#0000ff","#ffff00","#ff00ff","#00ffff",
        "#f97316","#22c55e","#3b82f6","#e11d48","#a855f7","#14b8a6",
        "#facc15","#4ade80","#38bdf8","#f97316","#fb7185","#6366f1",
        "#0ea5e9","#ec4899","#22c55e","#eab308"
      ];
      const prefix = nato[randInt(nato.length)];
      const now = Date.now().toString(36);
      const rnd = Math.floor(Math.random()*1e9).toString(36);
      const unique = (now+rnd).toUpperCase();
      const id = `${prefix}-${unique.slice(0,4)}-FIRE-${unique.slice(4,8)}`;
      const addr = "FIRE"+unique.padEnd(32,"X");
      const priv = "PRIV"+unique.padEnd(48,"Z");
      const color = colors[randInt(colors.length)];
      let rarity;
      const r = Math.random()*100;
      if(r>99.99) rarity = "99.99 %";
      else if(r>90) rarity = "90 %";
      else if(r>80) rarity = "80 %";
      else if(r>70) rarity = "70 %";
      else if(r>60) rarity = "60 %";
      else if(r>50) rarity = "50 %";
      else if(r>40) rarity = "40 %";
      else if(r>30) rarity = "30 %";
      else if(r>20) rarity = "20 %";
      else rarity = "10 %";

      q("#fireId").value = id;
      q("#fireAddr").value = addr;
      q("#firePriv").value = priv;
      q("#rarity").value = rarity;
      const c = q("#fireWalletColor");
      c.style.background=color;
      c.style.boxShadow = `0 0 18px ${color}aa`;

      drawQR(addr,color);
      log("Nouveau wallet "+id+" ("+rarity+")","ok");
    }

    function drawQR(text,color){
      const canvas = q("#qrCanvas");
      if(!canvas) return;
      const ctx = canvas.getContext("2d");
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0,0,w,h);
      ctx.fillStyle="#050012";
      ctx.fillRect(0,0,w,h);
      ctx.strokeStyle=color;
      ctx.lineWidth=3;
      ctx.strokeRect(10,10,w-20,h-20);
      ctx.fillStyle=color;
      for(let i=0;i<30;i++){
        const x = 14 + Math.random()*(w-28);
        const y = 14 + Math.random()*(h-28);
        const s = 3+Math.random()*5;
        ctx.fillRect(x,y,s,s);
      }
      ctx.fillStyle="#ffffff";
      ctx.font="10px system-ui";
      ctx.fillText(text.slice(0,14),12,h-18);
    }

    async function connectPhantom(){
      try{
        const provider = window.solana;
        if(!provider || !provider.isPhantom){
          alert("Phantom non détecté.");
          return;
        }
        const resp = await provider.connect();
        const pubkey = resp.publicKey.toString();
        q("#solAddr").value = pubkey;
        log("Phantom connecté: "+pubkey,"ok");
        await reloadSolBalances();
      }catch(e){
        log("Phantom FAIL: "+e.message,"err");
      }
    }

    async function reloadSolBalances(){
      try{
        const addr = q("#solAddr").value.trim();
        if(!addr){ log("Aucune adresse Phantom.","err"); return; }
        const conn = new solanaWeb3.Connection("https://api.mainnet-beta.solana.com");
        const pub = new solanaWeb3.PublicKey(addr);
        const lam = await conn.getBalance(pub);
        q("#solBal").value = (lam/1e9).toFixed(4);
        q("#usdcBal").value = "…";
        log("Solana solde mis à jour","ok");
      }catch(e){
        log("SOL balance FAIL: "+e.message,"err");

getent hostssentinel.fireinners.online || true



set -euo pipefail
APP_DIR="/root/fireinners-security-sentinel"
PORT="9696"

mkdir -p "$APP_DIR/public"
cd "$APP_DIR"

cat > package.json <<'EOF'
{"name":"sentinel","version":"1.0.0","type":"module","private":true,"scripts":{"start":"node server.js"},"dependencies":{"express":"^4.19.2"}}
EOF

cat > .env <<EOF
PORT=$PORT
EOF

cat > server.js <<'EOF'
import "dotenv/config";
import express from "express";
import http from "http";

const PORT=parseInt(process.env.PORT||"9696",10);
const app=express();
app.disable("x-powered-by");
app.use((req,res,next)=>{res.setHeader("Cache-Control","no-store");next();});
app.use(express.static("public"));

let score=92,reliability=70,seq=0;
function bulletin(){
  seq++;
  const t=Date.now();
  score=Math.max(0,Math.min(100,score+(Math.random()>.1?1:-5)));
  reliability=Math.max(0,Math.min(100,reliability+(Math.random()>.15?1:-6)));
  const level=score>80?"STABLE":score>55?"ALERT":score>30?"ALARM":"CRITICAL";
  return {kind:"SECURITY_BULLETIN",seq,ts:t,level,score,reliability,events:[{time:t,level,origin:"Q+Local",type:"pulse",status:"observed",message:"surveillance lecture seule",next:"aucune action destructive"}]};
}

app.get("/public/state",(req,res)=>res.json(bulletin()));
app.get("/",(req,res)=>res.redirect("/public.html"));

const server=http.createServer(app);
server.listen(PORT,"127.0.0.1",()=>console.log("[Sentinel] http://127.0.0.1:"+PORT));
EOF

cat > public/public.html <<'EOF'
<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1"><title>Sentinel Public</title><style>body{margin:0;background:#070a12;color:#e9f2ff;font:14px system-ui}#w{max-width:900px;margin:18px auto;padding:14px}h1{margin:0 0 10px;font-size:16px}#box{border:1px solid #23324f;border-radius:14px;padding:12px;background:#0b1222}b{color:#7dfbd1}pre{white-space:pre-wrap;word-break:break-word;margin:10px 0 0}</style><div id=w><h1>Sentinel Public (lecture seule)</h1><div id=box>Etat: <b id=l>—</b><br>Score: <b id=s>—</b><br>Fiabilite: <b id=r>—</b><pre id=j>{}</pre></div></div><script>const $=id=>document.getElementById(id);async function tick(){const d=await (await fetch("/public/state")).json();$("l").textContent=d.level;$("s").textContent=d.score;$("r").textContent=d.reliability+"%";$("j").textContent=JSON.stringify(d,null,2);}tick();setInterval(tick,2500);</script>
EOF

npm i

sudo tee /etc/systemd/system/security-sentinel.service >/dev/null <<EOF
[Unit]
Description=Security Sentinel (read-only)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$APP_DIR
EnvironmentFile=$APP_DIR/.env
ExecStart=/usr/bin/node $APP_DIR/server.js
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable --now security-sentinel
sudo systemctl status security-sentinel --no-pager

curl -sS --max-time 2 http://127.0.0.1:9696/public/state | head -c 220; echo





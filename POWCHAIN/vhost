  if(!cv)return;
  const ctx=cv.getContext("2d");
  const s=cv.width;
  ctx.fillStyle="#050008";
  ctx.fillRect(0,0,s,s);
  const box=document.getElementById("qrBox");
  if(!text){
    ctx.strokeStyle="#ffcf5c55";
    ctx.strokeRect(8,8,s-16,s-16);
    if(box){
      box.classList.remove("qr-common","qr-rare","qr-ultra");
      box.classList.add("qr-common");
    }
    return;
  }
  const size=25;
  const cell=s/size;
  let r=255,g=215,b=0;
  if(colorHex && /^#([0-9a-f]{6})$/i.test(colorHex)){
    const v=parseInt(colorHex.slice(1),16);
    r=(v>>16)&255;
    g=(v>>8)&255;
    b=v&255;
  }
  let seed=[...text].reduce((a,c)=>(a*31+c.charCodeAt(0))>>>0,1);
  for(let y=0;y<size;y++){
    for(let x=0;x<size;x++){
      seed=(seed*1103515245+12345)>>>0;
      if(seed&0x80000000){
        const k=0.7+0.4*((seed>>>16)/65535);
        ctx.fillStyle=`rgb(${Math.floor(r*k)},${Math.floor(g*k)},${Math.floor(b*k)})`;
        ctx.fillRect(x*cell+1,y*cell+1,cell-2,cell-2);
      }
    }
  }
  if(box){
    box.classList.remove("qr-common","qr-rare","qr-ultra");
    if(rarity==="ultra")      box.classList.add("qr-ultra");
    else if(rarity==="rare")  box.classList.add("qr-rare");
    else                      box.classList.add("qr-common");
  }
}

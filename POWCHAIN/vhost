nano /var/www/html/index.html

<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>POWCHAIN — Client Complet</title>
<style>
body{margin:0;background:#05070b;color:#e5ecff;font-family:system-ui,Arial}
#wrap{max-width:1100px;margin:18px auto;padding:16px;border-radius:14px;border:1px solid #1f2937;background:radial-gradient(circle at top,#111827,#020617 60%,#000 100%);box-shadow:0 0 25px #000}
h1{margin:0 0 8px;text-align:center;font-size:22px;letter-spacing:2px;color:#7dd3fc;text-shadow:0 0 12px #0ea5e9}
h2{margin:10px 0 6px;font-size:15px;color:#bae6fd}
small{color:#9ca3af}
.row{display:flex;flex-wrap:wrap;gap:12px;margin-top:10px}
.card{flex:1 1 260px;border-radius:10px;border:1px solid #1f2937;background:#020617d9;padding:10px;min-width:0}
label{font-size:12px;color:#9ca3af;display:block;margin-top:6px}
input,button{border-radius:6px;border:1px solid #1f2937;background:#020617;color:#e5ecff;font-size:13px;padding:6px 8px;margin-top:4px;box-sizing:border-box}
input{width:100%}
button{cursor:pointer;font-weight:600}
button.primary{border-color:#0ea5e9;background:#0369a1}
button.primary:hover{background:#0284c7}
.badge{display:inline-block;padding:3px 7px;border-radius:999px;font-size:11px;margin-right:4px}
.badge.ok{background:#022c22;color:#6ee7b7;border:1px solid #16a34a}
.badge.err{background:#450a0a;color:#fecaca;border:1px solid #b91c1c}
.badge.ws{background:#111827;color:#7dd3fc;border:1px solid #0ea5e9}
#statusGrid{font-size:13px;line-height:1.4;margin-top:6px}
#statusGrid span{color:#9ca3af}
pre{white-space:pre-wrap;font-size:12px;background:#020617;border-radius:8px;border:1px solid #1f2937;padding:8px;margin:6px 0;max-height:220px;overflow:auto}
#blocks{max-height:260px;overflow:auto;font-size:11px;background:#020617;border-radius:8px;border:1px solid #1f2937;padding:8px}
.blockItem{border-bottom:1px solid #111827;padding:4px 0}
.blockItem:last-child{border-bottom:none}
.blockIdx{color:#7dd3fc;font-weight:600}
.blockHash{color:#9ca3af;word-break:break-all}
.blockMeta{color:#a5b4fc}
#wsLog{max-height:180px}
a{color:#7dd3fc;text-decoration:none;font-size:12px}
a:hover{text-decoration:underline}
@media(max-width:700px){#wrap{margin:8px}}
</style>
</head>
<body>
<div id="wrap">
  <h1>POWCHAIN — Client Complet (Node BBQFinance)</h1>
  <small>API: <code>https://bbqfinance.fun</code> · WebSocket: <code>wss://bbqfinance.fun/ws</code></small>

  <!-- STATUS + CONTROLS -->
  <div class="row">
    <div class="card">
      <h2>État du nœud</h2>
      <div id="badges">
        <span id="badgeHttp" class="badge err">HTTP: OFF</span>
        <span id="badgeWs" class="badge ws">WS: …</span>
      </div>
      <div id="statusGrid">
        <div><span>Hauteur:</span> <b id="hHeight">?</b></div>
        <div><span>Nombre de wallets:</span> <b id="hWallets">?</b></div>
        <div><span>Trésorerie POW:</span> <b id="hTPow">0</b></div>
        <div><span>Trésorerie USDC POW:</span> <b id="hTUsd">0</b></div>
      </div>
      <button class="primary" onclick="refreshAll()">Rafraîchir les données</button>
      <small id="hLast">Dernier refresh: —</small>
    </div>

    <!-- WALLET VIEWER (lecture seule) -->
    <div class="card">
      <h2>Wallet POWCHAIN (lecture)</h2>
      <label for="wAddr">Adresse publique POWCHAIN</label>
      <input id="wAddr" placeholder="Ex: BZJsWeJeiv2y3YewjFSl8JrxcduPAHWjqL7jgq4kGwy"/>
      <button class="primary" onclick="loadWallet()">Afficher ce wallet</button>
      <pre id="walletView">// Infos du wallet en JSON</pre>
      <small>Ce client ne génère pas de clés privées. Utilise une adresse existante de ton écosystème POWCHAIN.</small>
    </div>
  </div>

  <!-- CHAIN + LOGS -->
  <div class="row">
    <div class="card" style="flex:2 1 400px">
      <h2>Blockchain (derniers blocs)</h2>
      <div id="blocks"></div>
    </div>
    <div class="card" style="flex:1 1 260px">
      <h2>Journal WebSocket</h2>
      <pre id="wsLog">// Connexion en cours à wss://bbqfinance.fun/ws…</pre>
    </div>
  </div>

  <div style="margin-top:10px;font-size:11px;color:#9ca3af">
    Endpoints dispo: 
    <code>/stats</code>, 
    <code>/chain</code>, 
    <code>/wallet?id=ADRESSE</code> (GET).  
    Ce client lit les données en direct, les transactions POWCHAIN peuvent être envoyées via un outil séparé utilisant le même WebSocket.
  </div>
</div>

<script>
const API_BASE="";
const WS_URL=(location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws";
let ws=null;

function logWs(msg){
  const el=document.getElementById("wsLog");
  el.textContent+="\n"+msg;
  el.scrollTop=el.scrollHeight;
}
function setBadge(id,on,textOk,textOff){
  const el=document.getElementById(id);
  if(!el)return;
  if(on){el.classList.remove("err");el.classList.add("ok");el.textContent=textOk;}
  else{el.classList.remove("ok");el.classList.add("err");el.textContent=textOff;}
}

async function fetchJson(path){
  const res=await fetch(API_BASE+path,{headers:{"Accept":"application/json"}});
  if(!res.ok)throw new Error("HTTP "+res.status);
  return res.json();
}

async function refreshStats(){
  try{
    const s=await fetchJson("/stats");
    setBadge("badgeHttp",true,"HTTP: OK","HTTP: OFF");
    document.getElementById("hHeight").textContent=s.height??"?";
    document.getElementById("hWallets").textContent=Object.keys(s.wallets||{}).length;
    document.getElementById("hTPow").textContent=s.treasuryPow??0;
    document.getElementById("hTUsd").textContent=s.treasuryUsdc??0;
    document.getElementById("hLast").textContent="Dernier refresh: "+new Date().toLocaleTimeString();
    return s;
  }catch(e){
    setBadge("badgeHttp",false,"HTTP: OK","HTTP: OFF");
    console.error(e);
  }
}

async function refreshChain(){
  try{
    const arr=await fetchJson("/chain");
    const wrap=document.getElementById("blocks");
    wrap.innerHTML="";
    const last=arr.slice(-15).reverse();
    last.forEach(b=>{
      const div=document.createElement("div");
      div.className="blockItem";
      div.innerHTML=
        '<div class="blockIdx">Bloc #'+(b.index??"?")+' · reward '+(b.reward??0)+'</div>'+
        '<div class="blockMeta">ts: '+(b.time||b.ts)+' · txs: '+(b.txs?b.txs.length:0)+'</div>'+
        '<div class="blockHash">'+(b.hash||"")+'</div>';
      wrap.appendChild(div);
    });
  }catch(e){
    console.error(e);
  }
}

async function loadWallet(){
  const addr=document.getElementById("wAddr").value.trim();
  const out=document.getElementById("walletView");
  if(!addr){out.textContent="// Entre une adresse publique POWCHAIN";return;}
  try{
    const w=await fetchJson("/wallet?id="+encodeURIComponent(addr));
    out.textContent=JSON.stringify(w,null,2);
  }catch(e){
    out.textContent="// Erreur pour ce wallet: "+e.message;
  }
}

function refreshAll(){
  refreshStats();
  refreshChain();
}

function connectWs(){
  try{
    ws=new WebSocket(WS_URL);
  }catch(e){
    logWs("WS erreur init: "+e.message);
    return;
  }
  ws.onopen=()=>{logWs("[ouvert] "+WS_URL);document.getElementById("badgeWs").textContent="WS: CONNECTÉ";};
  ws.onclose=()=>{logWs("[fermé]");document.getElementById("badgeWs").textContent="WS: REPLAY dans 3s";setTimeout(connectWs,3000);};
  ws.onerror=e=>{logWs("[erreur WS]");};
  ws.onmessage=ev=>{
    try{
      const msg=JSON.parse(ev.data);
      if(msg.type==="welcome"||msg.height){document.getElementById("hHeight").textContent=msg.height||document.getElementById("hHeight").textContent;}
      if(msg.type==="block"&&msg.block){refreshChain();refreshStats();}
      logWs(ev.data);
    }catch(e){logWs(ev.data);}
  };
}

document.addEventListener("DOMContentLoaded",()=>{
  refreshAll();
  setInterval(refreshStats,15000);
  connectWs();
});
</script>
</body>
</html>
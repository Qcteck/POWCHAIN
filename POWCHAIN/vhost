journalctl -u nginx -n 50 --no-pager

nginx -t


nano /etc/nginx/sites-available/bbqfinance


server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    server_name bbqfinance.fun www.bbqfinance.fun;

    ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;

    root /var/www/bbqfinance;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
    }
    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
    }
    location /block {
        proxy_pass http://127.0.0.1:3000/block;
    }
    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
    }
    location /tx {
        proxy_pass http://127.0.0.1:3000/tx;
    }

    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60m;
    }
}


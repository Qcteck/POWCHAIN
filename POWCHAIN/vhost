<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>POWCHAIN — Dashboard Complet</title><style>body{margin:0;background:#020b14;color:#9ee;font-family:system-ui}header{padding:12px;text-align:center;font-size:24px;font-weight:900;color:#0ff;text-shadow:0 0 12px #09f}#wrap{display:flex;height:100vh}#left{width:360px;border-right:1px solid #044;padding:10px;overflow-y:auto}#main{flex:1;padding:10px;overflow-y:auto}button{background:#00111d;border:1px solid #09f;color:#8ff;border-radius:6px;padding:7px;margin:4px 0;font-size:14px;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}input{border:1px solid #09f;background:#00202d;color:#9ee;padding:6px;width:100%;margin-top:4px;border-radius:6px}.card{border:1px solid #044;padding:8px;margin:6px 0;border-radius:6px;background:#021522}.block{padding:6px;border:1px solid #055;border-radius:4px;margin:4px 0;background:#031e30;cursor:pointer}.block:hover{background:#062b44}#log{white-space:pre-wrap;font-size:12px;background:#0006;padding:8px;height:180px;overflow-y:auto;border:1px solid #033;border-radius:6px}</style></head><body><header>POWCHAIN — Dashboard Complet</header><div id="wrap"><div id="left"><h3>Generer Wallet POWCHAIN</h3><button onclick="genWallet()">Creer un Wallet</button><div id="walletBox" class="card" style="display:none"><p><b>Adresse :</b><br><span id="addr"></span></p><p><b>Cle privee :</b><br><span id="priv"></span></p><button onclick="copyText(document.getElementById('addr').innerText)">Copier adresse</button><button onclick="copyText(document.getElementById('priv').innerText)">Copier cle privee</button><canvas id="qr" style="margin-top:6px"></canvas></div><hr><h3>Wallet Solana (Phantom)</h3><button id="btnPhantom" onclick="connectPhantom()">Connecter Phantom</button><div id="solBox" class="card" style="display:none"><p><b>Adresse Solana :</b><br><span id="solAddr"></span></p><p><b>SOL :</b> <span id="solSol">-</span></p><p><b>USDC :</b> <span id="solUsdc">-</span></p><button onclick="refreshSol()">Rafraichir soldes</button></div><hr><h3>Stats reseau et DEX</h3><div id="stats" class="card">Chargement...</div><hr><h3>Blocs POWCHAIN</h3><div id="blocks"></div></div><div id="main"><h2>Details du bloc</h2><div id="blocDetail" class="card">Selectionne un bloc dans la liste a gauche.</div><hr><h2>Infos DEX POW / USDC POW</h2><div id="dexBox" class="card">En attente des stats...</div><hr><h2>Logs live</h2><div id="log"></div></div></div><script src="https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js"></script><script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script><script>const API_STATS="/stats";const WS_URL="wss://bbqfinance.fun/ws";const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";const SOL_USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const logBox=document.getElementById("log"),blocksDiv=document.getElementById("blocks"),blocDetail=document.getElementById("blocDetail"),dexBox=document.getElementById("dexBox");function log(m){logBox.innerText+=m+"\n";logBox.scrollTop=logBox.scrollHeight}async function updateStats(){try{const r=await fetch(API_STATS,{cache:"no-store"});if(!r.ok)throw new Error("HTTP "+r.status);const j=await r.json();const s=j.stats||j;const h=s.height!=null?s.height:"?";const nb=s.blocks!=null?s.blocks:"?";const tx=s.txCount!=null?s.txCount:"?";const powSup=s.powSupply!=null?s.powSupply:"?";const usdcSup=s.usdcSupply!=null?s.usdcSupply:"?";const lpPow=s.lpPow!=null?s.lpPow:null;const lpUsdc=s.lpUsdc!=null?s.lpUsdc:null;let dex="";if(lpPow&&lpUsdc){const price=(lpUsdc/lpPow).toFixed(6);const k=(lpPow*lpUsdc).toFixed(2);dex="<br><br><b>DEX interne</b><br>Reserves POW: "+lpPow+"<br>Reserves USDC POW: "+lpUsdc+"<br>Prix 1 POW ≃ "+price+" USDC POW<br>Constante k = "+k;dexBox.innerHTML="Prix POW environ "+price+" USDC POW<br>LP POW: "+lpPow+"<br>LP USDC POW: "+lpUsdc+"<br>k = "+k}else{dexBox.innerHTML="Infos DEX non disponibles dans /stats";}stats.innerHTML="Hauteur: <b>"+h+"</b><br>Blocs: <b>"+nb+"</b><br>TX totales: <b>"+tx+"</b><br>Supply POW: <b>"+powSup+"</b><br>Supply USDC POW: <b>"+usdcSup+"</b>"+dex}catch(e){stats.innerHTML="Erreur /stats : "+e.message;dexBox.innerHTML="Erreur /stats : "+e.message}}setInterval(updateStats,4000);updateStats();function renderBlock(b){const d=document.createElement("div");d.className="block";d.innerHTML="#"+b.height+" — "+String(b.hash||"").slice(0,10)+"…";d.onclick=function(){showBlock(b)};blocksDiv.prepend(d)}function showBlock(b){const txs=Array.isArray(b.txs)?b.txs:(Array.isArray(b.tx)?b.tx:[]);const ts=b.ts||b.timestamp;const lines=txs.length?txs.map(function(t){return "→ "+(t.from||"?")+" ► "+(t.to||"?")+" ("+(t.amount||0)+" "+(t.token||"POW")+")"}).join("<br>"):"Aucune";blocDetail.innerHTML="<b>Height:</b> "+b.height+"<br><b>Hash:</b> "+(b.hash||"?")+"<br><b>Prev:</b> "+(b.prevHash||"?")+"<br><b>Timestamp:</b> "+(ts?new Date(ts).toLocaleString():"?")+"<br><b>Miner:</b> "+(b.miner||"?")+"<br><b>Rewards:</b> "+(b.rewards!=null?b.rewards:"?")+" POW<br><b>TX:</b><br>"+lines}let ws;function connectWS(){try{ws=new WebSocket(WS_URL);ws.onopen=function(){log("WebSocket connecte")};ws.onmessage=function(e){try{const m=JSON.parse(e.data);if(m.type==="block"&&m.block){renderBlock(m.block);log("Nouveau bloc "+m.block.height)}else if(m.type==="log"&&m.msg){log("Log: "+m.msg)}}catch(err){log("Erreur parse WS: "+err.message)}};ws.onclose=function(){log("WebSocket ferme, reconnexion dans 3 secondes");setTimeout(connectWS,3000)};ws.onerror=function(err){log("Erreur WebSocket")}}catch(e){log("Erreur init WebSocket: "+e.message)}}connectWS();function genWallet(){const seed=new Uint8Array(32);crypto.getRandomValues(seed);const priv=btoa(String.fromCharCode.apply(null,seed));const address="POW"+priv.slice(0,24);document.getElementById("walletBox").style.display="block";document.getElementById("addr").innerText=address;document.getElementById("priv").innerText=priv;new QRious({element:document.getElementById("qr"),size:120,value:address});log("Wallet POWCHAIN genere")}function copyText(t){if(!t)return;navigator.clipboard.writeText(t).then(function(){log("Texte copie")}).catch(function(){log("Impossible de copier")})}let solConn=null,solPub=null;async function connectPhantom(){try{if(!window.solana||!window.solana.isPhantom){alert("Phantom non detecte");return}const res=await window.solana.connect({onlyIfTrusted:false});solPub=res.publicKey;solConn=new solanaWeb3.Connection(SOL_RPC,"confirmed");document.getElementById("solBox").style.display="block";document.getElementById("btnPhantom").disabled=true;document.getElementById("solAddr").innerText=solPub.toBase58();log("Phantom connecte: "+solPub.toBase58());refreshSol()}catch(e){log("Erreur Phantom: "+e.message)}}async function refreshSol(){try{if(!solConn||!solPub)return;const lamports=await solConn.getBalance(solPub);document.getElementById("solSol").innerText=(lamports/solanaWeb3.LAMPORTS_PER_SOL).toFixed(4);const tok=await solConn.getParsedTokenAccountsByOwner(solPub,{mint:new solanaWeb3.PublicKey(SOL_USDC_MINT)});let usdc=0;tok.value.forEach(function(a){const ui=a.account.data.parsed.info.tokenAmount.uiAmount;usdc+=ui||0});document.getElementById("solUsdc").innerText=usdc.toFixed(2);log("Soldes Solana mis a jour")}catch(e){log("Erreur soldes Solana: "+e.message)}}</script></body></html>



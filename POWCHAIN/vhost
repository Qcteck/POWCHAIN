    const to = q("#sendTo").value.trim();
    const a = parseFloat(q("#sendAmt").value || "0");
    if(!to || a<=0) return;
    const tx = { type:"TX_POW", from:addr, to, amount:Math.floor(a*DEC), nonce:nonce+1, pub };
    try{
      tx.sig = signTx(tx);
    }catch(e){
      log("SIGN ERR "+e.message);
      return alert(e.message);
    }
    if(sock && sock.readyState===1) sock.send(JSON.stringify(tx));
    else log("WS non connecté");
    nonce++;
    log("TX FIRE envoyée "+a);
  };

  q("#btnStake").onclick = () => {
    if(!addr) return alert("Connecte d’abord un wallet FIREINNERS");
    const a = parseFloat(q("#stakeAmt").value || "0");
    if(a<=0) return;
    const tx = { type:"STAKE", addr, amount:Math.floor(a*DEC), from:addr, nonce:nonce+1, pub };
    try{
      tx.sig = signTx(tx);

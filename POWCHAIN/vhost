#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/root/bbtrader"
PORT="3000"

mkdir -p "$APP_DIR/public" "$APP_DIR/kv"
cd "$APP_DIR"

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js absent. Installe Node 20+ puis relance."
  exit 1
fi


<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport"content="width=device-width,initial-scale=1"/><title>POWCHAIN — Fireinners Panel</title><style>body{margin:0;font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#020005;color:#eee;overflow:hidden}#app{display:flex;height:100vh;width:100vw}#side{width:240px;background:#050008;border-right:1px solid #2b1a22;box-shadow:5px 0 25px #000;padding:20px 14px;display:flex;flex-direction:column;gap:14px}#logoBox{display:flex;align-items:center;gap:10px}#logoI{width:40px;height:40px;border-radius:50%;background:radial-gradient(circle at 30% 30%,#ffed9a,#ff9a2f 55%,#4b1430);box-shadow:0 0 20px #ff9a2f88}#logoTxt{color:#ffd874;font-weight:700;font-size:15px;letter-spacing:.12em}nav a{display:flex;align-items:center;gap:10px;padding:9px 11px;font-size:13px;border-radius:999px;text-decoration:none;color:#c7c1ca;border:1px solid #2e2236;background:linear-gradient(135deg,#120714,#050008);cursor:pointer;margin-bottom:6px;transition:.15s}nav a span.bullet{width:6px;height:6px;border-radius:50%;background:#5b4b68}nav a:hover{border-color:#ffb347;color:#ffe9b0;box-shadow:0 0 16px #ff9a2f55}nav a.active{border-color:#ffb347;background:radial-gradient(circle at 0 0,#ffbb33 0,#2b1020 40%,#050008 75%);color:#fff;box-shadow:0 0 24px #ff9a2f88 inset}#main{flex:1;display:flex;flex-direction:column;background:radial-gradient(circle at top,#1a0825,#050008 55%,#000 100%)}#top{padding:14px 22px;border-bottom:1px solid #2a1a33;background:radial-gradient(circle at 10% 0,#ffb34722 0,#050008 45%,#020005 100%);display:flex;justify-content:space-between;align-items:center}#top h1{margin:0;color:#ffcf5c;font-size:18px;letter-spacing:.12em;text-shadow:0 0 12px #ff9a2f99}#top small{color:#b89cc6;font-size:12px}#syncState{font-size:12px;padding:6px 10px;border-radius:999px;border:1px solid #3b2346;background:radial-gradient(circle at 0 0,#ffb34755,#190812);color:#ffeaa6}#content{flex:1;overflow:auto;padding:10px 20px 12px;background:radial-gradient(circle at bottom,#210925,#050008 40%,#000 85%)}.section{display:none;animation:fade .25s ease}.section.active{display:block}@keyframes fade{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}.card{background:radial-gradient(circle at 0 0,#ffb3471a,#120313 45%,#050008 100%);border:1px solid #3a243e;border-radius:14px;padding:14px 14px 12px;margin-bottom:14px;box-shadow:0 0 30px #000 inset,0 0 18px #120313}.lineTitle{padding:6px 10px;margin:-8px -10px 10px;border-radius:12px;background:linear-gradient(90deg,#ff9a2f33,#190812 60%,transparent);font-size:11px;color:#ffdca0;text-transform:uppercase;letter-spacing:.16em}.row2{display:flex;gap:8px;flex-wrap:wrap}.row2>div{flex:1;min-width:160px}label{font-size:11px;display:block;margin-bottom:4px;color:#e0d0f2;letter-spacing:.03em}input,select,button{width:100%;padding:7px 9px;margin:3px 0 8px;border-radius:9px;background:#09020d;border:1px solid #3b2346;color:#f7f0ff;font-size:12px;box-sizing:border-box}input[readonly]{opacity:.9;background:#050008}button{background:linear-gradient(90deg,#ff9a2f,#ffc857,#ff9a2f);border:1px solid #ffcf5c;color:#130307;font-weight:600;cursor:pointer;text-transform:uppercase;letter-spacing:.06em;box-shadow:0 0 14px #ff9a2f66}button:hover{filter:brightness(1.08);box-shadow:0 0 20px #ffcf5c88}button.sec{background:linear-gradient(90deg,#332040,#1c0a23);color:#f4ddff;border-color:#4b2b60;box-shadow:none}small.hint{font-size:11px;color:#f9d88a;opacity:.9}#log{background:#050008;border:1px solid #3a243e;border-radius:12px;padding:10px;height:170px;overflow:auto;font-size:11px;color:#ffe9a6;white-space:pre-wrap;box-shadow:0 0 18px #000 inset}#qrBox{width:120px;height:120px;border-radius:10px;border:1px solid #ffcf5c;background:#050008;margin:4px 0 8px;display:flex;align-items:center;justify-content:center}#qr{width:110px;height:110px}#mempoolLive{height:210px;overflow:auto;font-size:11px;color:#ffe4b8;background:#050008;border-radius:10px;padding:8px;border:1px solid #3b234e}pre{margin:0}.ticker{position:relative;overflow:hidden;border-radius:999px;border:1px solid #3a243e;background:linear-gradient(90deg,#2b1020,#120313);padding:2px 0;margin:4px 0}#topTicker{margin-bottom:10px}#bottomTicker{margin-top:6px} .tickerInner{display:inline-block;padding-left:100%;white-space:nowrap;color:#ffe9a6;font-size:11px;animation:ticker 25s linear infinite}@keyframes ticker{0%{transform:translateX(0)}100%{transform:translateX(-100%)}#priceChart{max-width:100%;background:#050008;border-radius:10px;border:1px solid #3a243e;margin-top:8px}</style></head><body><div id="app"><aside id="side"><div id="logoBox"><div id="logoI"></div><div id="logoTxt">FIREINNERS</div></div><nav><a class="navitem active" data-tab="wallet"><span class="bullet"></span>Wallet</a><a class="navitem" data-tab="bridge"><span class="bullet"></span>Bridge</a><a class="navitem" data-tab="dex"><span class="bullet"></span>DEX</a><a class="navitem" data-tab="stake"><span class="bullet"></span>Staking</a><a class="navitem" data-tab="explorer"><span class="bullet"></span>Explorer</a><a class="navitem" data-tab="mempool"><span class="bullet"></span>Mempool Live</a><a class="navitem" data-tab="stats"><span class="bullet"></span>Stats</a></nav></aside><main id="main"><div id="top"><div><h1>POWCHAIN — FIREINNERS PANEL</h1><small>Wallet • Bridge • DEX • Staking • Explorer</small></div><div id="syncState">WS: offline</div></div><div id="content"><div id="topTicker" class="ticker"><div id="topTickerInner" class="tickerInner">Chargement des prix...</div></div><div class="section active" id="wallet"><div class="card"><div class="lineTitle">Solana — Phantom</div><div class="row2"><div><label>Adresse Solana</label><input id="solAddr" readonly placeholder="-"/></div><div><label>SOL</label><input id="solBal" readonly placeholder="-"/></div><div><label>USDC</label><input id="usdcBal" readonly placeholder="-"/></div></div><div class="row2"><div><button id="btnPhantom">Connecter Phantom</button></div><div><button class="sec" id="btnSolRefresh">Rafraîchir soldes</button></div></div><small class="hint">Assure-toi que <b>bbqfinance.fun</b> est autorisé dans Phantom.</small></div><div class="card"><div class="lineTitle">Wallet POWCHAIN — Local</div><div class="row2"><div><button id="btnGen">Générer un wallet POWCHAIN</button></div><div><button class="sec" id="btnReloadPow">Recharger balances</button></div></div><label>Adresse POWCHAIN</label><input id="powAddr" readonly placeholder="-"/><label>Clé privée (garde-la)</label><input id="powPriv" readonly placeholder="-"/><div class="row2"><div><label>QR adresse POWCHAIN</label><div id="qrBox"><div id="qr"></div></div></div><div><label>POW</label><input id="powBal" readonly placeholder="0.000000"/><label>USDC POW</label><input id="powUSDCBal" readonly placeholder="0.000000"/><label>Staked</label><input id="powStakeBal" readonly placeholder="0.000000"/><label>Nonce</label><input id="powNonce" readonly placeholder="0"/></div></div><small class="hint">Ce wallet est <b>local</b> (nacl + base58). Sauvegarde la clé privée avant de fermer.</small></div></div><div class="section" id="bridge"><div class="card"><div class="lineTitle">Bridge SOL → POWCHAIN (sécurisé)</div><label>Adresse de trésorerie Solana</label><input readonly value="BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy"/><label>Montant en SOL à déclarer</label><input id="bridgeAmt" placeholder="ex: 0.001"/><label>Signature Phantom de la transaction SOL</label><input id="bridgeSig" placeholder="Colle ici la signature Phantom"/><button id="btnBridge">Déclarer le bridge au backend</button><small class="hint">1) Envoie ce montant de SOL vers la trésorerie avec Phantom.<br>2) Copie la <b>signature de la transaction</b> dans Phantom et colle-la ci-dessus.<br>3) Clique sur ce bouton, le backend vérifiera la tx via RPC.</small></div></div><div class="section" id="dex"><div class="card"><div class="lineTitle">Swap DEX interne</div><label>Montant</label><input id="swapAmt" placeholder="10"/><label>Direction</label><select id="swapDir"><option value="pow2usdc">POW ➜ USDC POW</option><option value="usdc2pow">USDC POW ➜ POW</option></select><button id="btnSwap">Swap</button><div class="row2"><div><label>LP POW</label><input id="lpPow" readonly/></div><div><label>LP USDC</label><input id="lpUsdc" readonly/></div></div></div><div class="card"><div class="lineTitle">Ajouter Liquidité (LP)</div><label>POW</label><input id="lpAddPow"/><label>USDC POW</label><input id="lpAddUsdc"/><button id="btnLPAdd">Ajouter LP</button><small class="hint">Le backend peut émettre un NFT “Whale Badge” pour les gros apporteurs de LP.</small></div></div><div class="section" id="stake"><div class="card"><div class="lineTitle">Staking POW</div><label>Montant POW à staker</label><input id="stakeAmt"/><button id="btnStake">Stake</button><label>Montant staké (vue backend)</label><input id="stakeView" readonly/><label>Récompenses estimées (placeholder)</label><input id="stakeRewards" readonly value="-"/></div></div><div class="section" id="explorer"><div class="card"><div class="lineTitle">Explorer de blocs POWCHAIN</div><label>Hauteur de bloc</label><input id="blockInp" placeholder="1"/><button id="btnBlock">Voir bloc</button><pre id="blockOut" style="margin-top:8px;font-size:11px;color:#ffe9a6"></pre></div></div><div class="section" id="mempool"><div class="card"><div class="lineTitle">Mempool — Transactions en direct</div><pre id="mempoolLive"></pre></div></div><div class="section" id="stats"><div class="card"><div class="lineTitle">Stats POWCHAIN</div><div class="row2"><div><label>Hauteur</label><input id="sHeight" readonly/></div><div><label>Wallets</label><input id="sWallets" readonly/></div><div><label>Mempool</label><input id="sMP" readonly/></div></div><div class="row2"><div><label>Total POW</label><input id="sPOW" readonly/></div><div><label>Total Staké</label><input id="sStaked" readonly/></div><div><label>LP POW</label><input id="sLPpow" readonly/></div><div><label>LP USDC</label><input id="sLPusdc" readonly/></div></div><div class="row2"><div><label>Treasury SOL (vue backend)</label><input id="sTSol" readonly/></div><div><label>Treasury USDC POW</label><input id="sTUsdc" readonly/></div><div><label>Treasury POW</label><input id="sTFire" readonly/></div></div><label>Graphiques prix (USD)</label><canvas id="priceChart" height="120"></canvas></div></div><div class="card"><div class="lineTitle">Console</div><div id="log"></div></div><div id="bottomTicker" class="ticker"><div id="bottomTickerInner" class="tickerInner">Chargement des stats POWCHAIN...</div></div></div></main></div><script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>const API="https://bbqfinance.fun";const WS_URL="wss://bbqfinance.fun/ws";const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";const DEC=1e6;const q=s=>document.querySelector(s);const log=t=>{const b=q("#log");const line=`[${new Date().toLocaleTimeString()}] ${t}`;b.innerHTML=line+"<br>"+b.innerHTML;b.scrollTop=0};let solAddr=null;let powAddr=null;let powPriv=null;let powNonce=0;let sock=null;let lastPrices=null,lastStats=null;let priceChart=null,priceLabels=[],priceSeries={btc:[],eth:[],sol:[],sui:[],fire:[]};function b58enc(bytes){let d=[0];for(let i=0;i<bytes.length;i++){let c=bytes[i];for(let j=0;j<d.length;j++){let x=d[j]*256+c;d[j]=x%58;c=(x/58)|0}while(c>0){d.push(c%58);c=(c/58)|0}}let r="";for(let k=d.length-1;k>=0;k--)r+=ALPH[d[k]];return r}function b58dec(str){let b=[0];for(let i=0;i<str.length;i++){let c=ALPH.indexOf(str[i]);for(let j=0;j<b.length;j++){let x=b[j]*58+c;b[j]=x&255;c=x>>8}while(c>0){b.push(c&255);c>>=8}}return new Uint8Array(b.reverse())}function drawQR(text){const el=document.getElementById("qr");if(!el)return;el.innerHTML="";if(!text)return;new QRCode(el,{text,width:110,height:110,correctLevel:QRCode.CorrectLevel.M})}drawQR("");async function connectPhantom(){try{const p=window.solana;if(!p||!p.isPhantom){alert("Phantom non détecté");return}const resp=await p.connect();solAddr=resp.publicKey.toString();q("#solAddr").value=solAddr;log("Phantom connecté : "+solAddr);await loadSolBalances()}catch(e){log("Erreur Phantom : "+e.message)}}async function loadSolBalances(){if(!solAddr)return;try{const r=await fetch(SOL_RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]})});const j=await r.json();const lam=j.result&&typeof j.result.value==="number"?j.result.value:0;q("#solBal").value=(lam/1e9).toFixed(4);const r2=await fetch(SOL_RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getTokenAccountsByOwner",params:[solAddr,{mint:USDC_MINT},{encoding:"jsonParsed"}]})});const j2=await r2.json();let total=0;(j2.result&&j2.result.value||[]).forEach(a=>{const v=a.account&&a.account.data&&a.account.data.parsed&&a.account.data.parsed.info&&a.account.data.parsed.info.tokenAmount&&a.account.data.parsed.info.tokenAmount.uiAmount||0;total+=v});q("#usdcBal").value=total.toFixed(2)}catch(e){log("Bal ERR : "+e.message)}}q("#btnPhantom").onclick=connectPhantom;q("#btnSolRefresh").onclick=loadSolBalances;q("#btnGen").onclick=()=>{const kp=nacl.sign.keyPair();powAddr=b58enc(kp.publicKey);powPriv=b58enc(kp.secretKey);powNonce=0;q("#powAddr").value=powAddr;q("#powPriv").value=powPriv;drawQR(powAddr);log("Wallet POWCHAIN généré")};async function loadPowWallet(){if(!powAddr||!powPriv){alert("Wallet POWCHAIN requis");return}try{const r=await fetch(`${API}/wallet/${powAddr}`);if(!r.ok)throw Error("HTTP "+r.status);const w=await r.json();powNonce=w.nonce||0;q("#powBal").value=(w.pow/DEC).toFixed(6);q("#powUSDCBal").value=(w.usdc/DEC).toFixed(6);q("#powStakeBal").value=(w.staked/DEC).toFixed(6);q("#powNonce").value=powNonce;log("Wallet POWCHAIN chargé")}catch(e){log("Load POW ERR : "+e.message)}}q("#btnReloadPow").onclick=loadPowWallet;function signTxBase(payload){if(!powAddr||!powPriv){alert("Wallet POWCHAIN requis");return null}const msgObj={type:payload.type,from:powAddr,to:payload.to||null,amount:payload.amount||null,token:payload.token||null,dir:payload.dir||null,nonce:powNonce+1};const msg=new TextEncoder().encode(JSON.stringify(msgObj));const sk=b58dec(powPriv);const sig=nacl.sign.detached(msg,sk);return{tx:{...msgObj},sig:b58enc(sig)}}q("#btnBridge").onclick=async()=>{if(!powAddr){log("Bridge erreur : wallet POWCHAIN manquant");return}if(!solAddr){log("Bridge erreur : connecte Phantom avant");return}const raw=q("#bridgeAmt").value.trim();const sig=q("#bridgeSig").value.trim();const amt=parseFloat(raw);if(!raw||isNaN(amt)||amt<=0){log("Bridge erreur : montant SOL invalide");return}if(!sig){log("Bridge backend erreur : signature Phantom manquante");return}try{const body={addr:powAddr,amount:amt,fromSol:solAddr,txSig:sig};const r=await fetch(`${API}/bridge`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});const j=await r.json().catch(()=>({}));if(!r.ok||j.ok===false){log("Bridge backend erreur : "+(j.error||("HTTP "+r.status)));return}log("Bridge accepté pour "+amt+" SOL");loadPowWallet()}catch(e){log("Bridge erreur : "+e.message)}};q("#btnSwap").onclick=()=>{if(!powAddr){alert("Wallet POWCHAIN requis");return}const a=parseFloat(q("#swapAmt").value||"0");if(!(a>0)){log("Swap : montant invalide");return}const dir=q("#swapDir").value;const base=signTxBase({type:"SWAP",amount:Math.floor(a*DEC),token:null,dir});if(!base)return;const tx={type:"SWAP",from:powAddr,dir,amount:Math.floor(a*DEC),nonce:base.tx.nonce,sig:base.sig};sock&&sock.readyState===WebSocket.OPEN&&sock.send(JSON.stringify(tx));powNonce++;q("#powNonce").value=powNonce;log("Swap TX envoyée ("+dir+")")};q("#btnLPAdd").onclick=()=>{if(!powAddr){alert("Wallet POWCHAIN requis");return}const p=parseFloat(q("#lpAddPow").value||"0");const u=parseFloat(q("#lpAddUsdc").value||"0");if(!(p>0&&u>0)){log("LP_ADD : montants invalides");return}const base=signTxBase({type:"LP_ADD",amount:null});if(!base)return;const tx={type:"LP_ADD",from:powAddr,pow:Math.floor(p*DEC),usdc:Math.floor(u*DEC),nonce:base.tx.nonce,sig:base.sig};sock&&sock.readyState===WebSocket.OPEN&&sock.send(JSON.stringify(tx));powNonce++;q("#powNonce").value=powNonce;log("LP_ADD envoyé")};q("#btnStake").onclick=()=>{if(!powAddr){alert("Wallet POWCHAIN requis");return}const a=parseFloat(q("#stakeAmt").value||"0");if(!(a>0)){log("Stake : montant invalide");return}const base=signTxBase({type:"STAKE",amount:Math.floor(a*DEC)});if(!base)return;const tx={type:"STAKE",from:powAddr,amount:Math.floor(a*DEC),nonce:base.tx.nonce,sig:base.sig};sock&&sock.readyState===WebSocket.OPEN&&sock.send(JSON.stringify(tx));powNonce++;q("#powNonce").value=powNonce;log("STAKE envoyé")};q("#btnBlock").onclick=async()=>{const h=parseInt(q("#blockInp").value||"0");if(!(h>0))return;try{const r=await fetch(`${API}/block/${h}`);const b=await r.json();q("#blockOut").textContent=JSON.stringify(b,null,2)}catch(e){q("#blockOut").textContent="Erreur : "+e.message}};function ensureChart(){if(priceChart)return;const ctx=document.getElementById("priceChart").getContext("2d");priceChart=new Chart(ctx,{type:"line",data:{labels:priceLabels,datasets:[{label:"BTC",data:priceSeries.btc,borderColor:"#f97316",tension:.2},{label:"ETH",data:priceSeries.eth,borderColor:"#22d3ee",tension:.2},{label:"SOL",data:priceSeries.sol,borderColor:"#22c55e",tension:.2},{label:"SUI",data:priceSeries.sui,borderColor:"#e5e7eb",tension:.2},{label:"FIRE",data:priceSeries.fire,borderColor:"#a855f7",tension:.2}]},options:{plugins:{legend:{labels:{color:"#ffe9a6"}}},scales:{x:{ticks:{color:"#ffe9a6"},grid:{color:"#3a243e33"}},y:{ticks:{color:"#ffe9a6"},grid:{color:"#3a243e33"}}}}})}function updateTickers(){if(!lastPrices||!lastStats)return;const powPrice=lastStats.lpPow>0?lastStats.lpUsdc/lastStats.lpPow:0;const t1=`BTC ${lastPrices.btc.toFixed(0)}$ | ETH ${lastPrices.eth.toFixed(0)}$ | SOL ${lastPrices.sol.toFixed(2)}$ | SUI ${lastPrices.sui.toFixed(2)}$ | FIRE ${powPrice?powPrice.toFixed(8):"N/A"}$`;const t2=`Height ${lastStats.height} | Wallets ${lastStats.wallets} | Mempool ${lastStats.mempool} | LP POW ${lastStats.lpPow} | LP USDC ${lastStats.lpUsdc} | Treasury SOL ${lastStats.solTreasury}`;q("#topTickerInner").textContent=t1;q("#bottomTickerInner").textContent=t2}function updateChart(){if(!lastPrices||!lastStats)return;ensureChart();const powPrice=lastStats.lpPow>0?lastStats.lpUsdc/lastStats.lpPow:0;const lbl=new Date().toLocaleTimeString();priceLabels.push(lbl);if(priceLabels.length>30)priceLabels.shift();["btc","eth","sol","sui","fire"].forEach(k=>{if(priceSeries[k].length>30)priceSeries[k].shift()});priceSeries.btc.push(lastPrices.btc||0);priceSeries.eth.push(lastPrices.eth||0);priceSeries.sol.push(lastPrices.sol||0);priceSeries.sui.push(lastPrices.sui||0);priceSeries.fire.push(powPrice||0);priceChart.update()}async function refreshStats(){try{const r=await fetch(`${API}/stats`);const s=await r.json();lastStats=s;q("#sHeight").value=s.height;q("#sWallets").value=s.wallets;q("#sPOW").value=s.totalPow;q("#sStaked").value=s.totalStaked;q("#sMP").value=s.mempool;q("#sLPpow").value=s.lpPow;q("#sLPusdc").value=s.lpUsdc;q("#sTSol").value=s.solTreasury;q("#sTUsdc").value=s.usdcTreasury;q("#sTFire").value=s.fireTreasury;q("#lpPow").value=s.lpPow;q("#lpUsdc").value=s.lpUsdc;updateTickers();updateChart()}catch(e){log("Stats ERR : "+e.message)}}async function refreshPrices(){try{const r=await fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd");const p=await r.json();lastPrices={btc:p.bitcoin.usd,eth:p.ethereum.usd,sol:p.solana.usd,sui:p.sui.usd};updateTickers();updateChart()}catch(e){log("Prix ERR : "+e.message)}}setInterval(refreshStats,5000);refreshStats();setInterval(refreshPrices,60000);refreshPrices();function connectWS(){try{sock&&sock.close();sock=new WebSocket(WS_URL);sock.onopen=()=>{q("#syncState").textContent="WS: online";q("#syncState").style.borderColor="#5bffbf";q("#syncState").style.color="#dfffee";log("WS connecté")};sock.onclose=()=>{q("#syncState").textContent="WS: offline";q("#syncState").style.borderColor="#ff9a2f";q("#syncState").style.color="#ffe2b0";log("WS fermé, reconnexion dans 3s...");setTimeout(connectWS,3000)};sock.onerror=e=>log("WS erreur "+(e&&e.message||""));sock.onmessage=e=>{try{const m=JSON.parse(e.data);if(m.type==="mempool"){q("#mempoolLive").textContent=JSON.stringify(m.mempool,null,2)}else if(m.type==="clients"){log("WS clients connectés : "+m.count)}else if(m.type==="new_block"){log("Nouveau bloc #"+m.block.height)}}catch(err){}}}catch(e){log("WS fatal : "+e.message)}}connectWS();document.querySelectorAll(".navitem").forEach(a=>{a.onclick=()=>{document.querySelectorAll(".navitem").forEach(x=>x.classList.remove("active"));a.classList.add("active");const tab=a.dataset.tab;document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));q("#"+tab).classList.add("active")}});</script></body></html>







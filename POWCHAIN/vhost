});

// BRIDGE SOL -> FIREINNERS (appelé par le bouton SOL → FIREINNERS)
app.post("/bridge", (req, res) => {
  try {
    const { addr, solAmount } = req.body;
    const tx = processBridgeIn({ addr, solAmount });
    pushTx(tx);
    console.log("🔥 Bridge SOL→FIREINNERS", tx);
    res.json({ ok: true, tx });
  } catch (e) {
    console.error("Bridge error:", e.message);
    res.status(400).json({ ok: false, error: e.message });
  }
});

// (Optionnel) BRIDGE FIRE -> SOL
app.post("/bridge-out", (req, res) => {
  try {
    const { addr, powAmount } = req.body;
    const tx = processBridgeOut({ addr, powAmount });
    pushTx(tx);
    console.log("🔥 Bridge FIRE→SOL", tx);
    res.json({ ok: true, tx });
  } catch (e) {
    console.error("Bridge-out error:", e.message);
    res.status(400).json({ ok: false, error: e.message });

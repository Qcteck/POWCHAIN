<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>POWCHAIN — Dashboard Complet</title><style>body{margin:0;background:#020b14;color:#9ee;font-family:system-ui}header{padding:12px;text-align:center;font-size:24px;font-weight:900;color:#0ff;text-shadow:0 0 12px #09f}#wrap{display:flex;height:100vh}#left{width:340px;border-right:1px solid #044;padding:10px;overflow-y:auto}#main{flex:1;padding:10px;overflow-y:auto}button{background:#00111d;border:1px solid #09f;color:#8ff;border-radius:6px;padding:7px;margin:4px 0;font-size:14px;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}input{border:1px solid #09f;background:#00202d;color:#9ee;padding:6px;width:100%;margin-top:4px;border-radius:6px}.card{border:1px solid #044;padding:8px;margin:6px 0;border-radius:6px;background:#021522}.block{padding:6px;border:1px solid #055;border-radius:4px;margin:4px 0;background:#031e30;cursor:pointer}.block:hover{background:#062b44}#log{white-space:pre-wrap;font-size:12px;background:#0006;padding:8px;height:180px;overflow-y:auto;border:1px solid #033;border-radius:6px}</style></head><body><header>⚡ POWCHAIN — Dashboard Complet</header><div id="wrap"><div id="left"><h3>🔹 Générer Wallet POWCHAIN</h3><button onclick="genWallet()">Créer un Wallet</button><div id="walletBox" class="card" style="display:none"><p><b>Adresse :</b><br><span id="addr"></span></p><p><b>Clé privée :</b><br><span id="priv"></span></p><button onclick="copyText(addr.innerText)">Copier adresse</button><button onclick="copyText(priv.innerText)">Copier clé privée</button><canvas id="qr" style="margin-top:6px"></canvas></div><hr><h3>📊 Stats Réseau</h3><div id="stats" class="card">Chargement...</div><hr><h3>⛏ Explorer de Blocs</h3><button onclick="loadChain()">Recharger la chaîne</button><div id="blocks"></div></div><div id="main"><h2>📦 Détails du bloc sélectionné</h2><div id="blocDetail" class="card">Sélectionne un bloc dans la liste à gauche.</div><hr><h2>📝 Logs live</h2><div id="log"></div></div></div><script src="https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js"></script><script>const API_STATS="/stats";const API_CHAIN="/chain";const WS_URL="wss://bbqfinance.fun/ws";const logBox=document.getElementById("log");const blocksDiv=document.getElementById("blocks");const blocDetail=document.getElementById("blocDetail");function log(m){logBox.innerText+=m+"\n";logBox.scrollTop=logBox.scrollHeight}async function updateStats(){try{const r=await fetch(API_STATS,{cache:"no-store"});if(!r.ok)throw new Error("HTTP "+r.status);const j=await r.json();stats.innerHTML=`Hauteur: <b>${j.height??"?"}</b><br>Blocs: <b>${j.blocks??"?"}</b><br>TX totales: <b>${j.txCount??"?"}</b><br>Supply POW: <b>${j.powSupply??"?"}</b><br>Supply USDC POW: <b>${j.usdcSupply??"?"}</b>`}catch(e){stats.innerHTML="Erreur /stats : "+e.message}}setInterval(updateStats,4000);updateStats();function renderBlock(b){const d=document.createElement("div");d.className="block";d.innerHTML=`#${b.height} — ${String(b.hash||"").slice(0,10)}…`;d.onclick=()=>showBlock(b);blocksDiv.prepend(d)}function showBlock(b){blocDetail.innerHTML=`<b>Height:</b> ${b.height}<br><b>Hash:</b> ${b.hash}<br><b>Prev:</b> ${b.prevHash}<br><b>Timestamp:</b> ${b.timestamp?new Date(b.timestamp).toLocaleString():"?"}<br><b>Miner:</b> ${b.miner||"?"}<br><b>Rewards:</b> ${b.rewards??"?"} POW<br><b>TX:</b><br>${Array.isArray(b.tx)&&b.tx.length?b.tx.map(t=>`→ ${t.from} ► ${t.to} (${t.amount} ${t.token})`).join("<br>"):"Aucune"}`;}async function loadChain(){blocksDiv.innerHTML="Chargement de /chain...";try{const r=await fetch(API_CHAIN,{cache:"no-store"});if(!r.ok)throw new Error("HTTP "+r.status);const j=await r.json();const arr=Array.isArray(j)?j:Array.isArray(j.chain)?j.chain:[];blocksDiv.innerHTML="";if(!arr.length){blocksDiv.innerHTML="<i>Aucun bloc pour le moment.</i>";return}arr.slice().reverse().forEach(renderBlock);log("✅ Chaîne chargée : "+arr.length+" blocs")}catch(e){blocksDiv.innerHTML="<b>/chain non disponible</b>";log("❌ Erreur /chain : "+e.message)}}loadChain();let ws;function connectWS(){try{ws=new WebSocket(WS_URL);ws.onopen=()=>log("🔌 WebSocket connecté");ws.onmessage=e=>{try{const m=JSON.parse(e.data);if(m.type==="block"&&m.block){renderBlock(m.block);log("⛏ Nouveau bloc "+m.block.height)}else if(m.type==="log"&&m.msg){log("📌 "+m.msg)}}catch(err){log("WS parse error: "+err.message)}};ws.onclose=()=>{log("WS fermé, reconnexion dans 3s...");setTimeout(connectWS,3000)};ws.onerror=err=>log("WS erreur: "+(err.message||""))}catch(e){log("WS init error: "+e.message)}}connectWS();function genWallet(){const seed=new Uint8Array(32);crypto.getRandomValues(seed);const priv=btoa(String.fromCharCode.apply(null,seed));const address="POW"+priv.slice(0,24);walletBox.style.display="block";document.getElementById("addr").innerText=address;document.getElementById("priv").innerText=priv;new QRious({element:document.getElementById("qr"),size:120,value:address});log("🪪 Wallet POWCHAIN généré")}function copyText(t){navigator.clipboard.writeText(t).then(()=>log("📋 Copié: "+t.slice(0,16)+"...")).catch(()=>log("Impossible de copier."));}</script></body></html>



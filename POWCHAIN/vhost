// FIREINNERS server.js — Bridge sécurisé + DEX + Staking + Stats + WS

const express = require("express");
const cors = require("cors");
const bodyParser = require("body-parser");
const WebSocket = require("ws");

const app = express();
app.use(cors());
app.use(bodyParser.json());

const DEC = 1e6;

// ========= CONFIG SOLANA =========
const SOL_RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const TREASURY_SOL = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

// ========= ETAT GLOBAL =========
let state = {
  height: 1,
  wallets: {},        // addrPowchain -> {pub,pow,usdc,staked,nonce}
  treasury: {
    solAddress: TREASURY_SOL,
    solBalance: 0,    // en SOL, pas en lamports
    usdcBalance: 0,   // USDC POW (on-chain interne)
    fireBalance: 0    // total POW "minted" via bridge
  },
  lp: {
    pow: 0,
    usdc: 0
  },
  staking: {
    total: 0
  },
  mempool: [],
  chain: [
    {
      height: 1,
      timestamp: Date.now(),
      type: "genesis",
      data: { msg: "FIREINNERS genesis block" }
    }
  ]
};

// Wallet serveur interne (pour la liquidité, frais, etc.)
let serverWallet = {
  pub: "FIREINNERS_SERVER",
  pow: 1_000_000 * DEC,
  usdc: 50_000 * DEC,
  staked: 0,
  nonce: 0
};
state.wallets[serverWallet.pub] = serverWallet;

// ========= UTILITAIRES =========
function getWallet(addr) {
  if (!state.wallets[addr]) {
    state.wallets[addr] = { pub: addr, pow: 0, usdc: 0, staked: 0, nonce: 0 };
  }
  return state.wallets[addr];
}

function pushBlock(type, data) {
  state.height++;
  const blk = {
    height: state.height,
    timestamp: Date.now(),
    type,
    data
  };
  state.chain.push(blk);
  if (state.chain.length > 1000) {
    state.chain = state.chain.slice(-1000);
  }
  broadcast({ type: "new_block", block: blk });
}

function addToMempool(tx) {
  state.mempool.push(tx);
  if (state.mempool.length > 200) {
    state.mempool = state.mempool.slice(-200);
  }
  broadcast({ type: "mempool", mempool: state.mempool });
}

// ========= API STATS / WALLET / CHAIN =========
app.get("/stats", (req, res) => {
  const totals = Object.values(state.wallets).reduce(
    (acc, w) => {
      acc.pow += w.pow || 0;
      acc.staked += w.staked || 0;
      return acc;
    },
    { pow: 0, staked: 0 }
  );
  res.json({
    height: state.height,
    wallets: Object.keys(state.wallets).length,
    mempool: state.mempool.length,
    totalPow: totals.pow,
    totalStaked: totals.staked,
    lpPow: state.lp.pow,
    lpUsdc: state.lp.usdc,
    treasurySolAddress: state.treasury.solAddress,
    solTreasury: state.treasury.solBalance,
    usdcTreasury: state.treasury.usdcBalance,
    fireTreasury: state.treasury.fireBalance
  });
});

app.get("/wallet/:addr", (req, res) => {
  const addr = req.params.addr;
  const w = getWallet(addr);
  res.json({
    pub: w.pub,
    pow: w.pow,
    usdc: w.usdc,
    staked: w.staked,
    nonce: w.nonce
  });
});

// Retourner un bloc par hauteur
app.get("/block/:height", (req, res) => {
  const h = parseInt(req.params.height, 10);
  const blk = state.chain.find(b => b.height === h);
  if (!blk) return res.status(404).json({ ok: false, error: "Block not found" });
  res.json(blk);
});

app.get("/chain", (req, res) => {
  res.json(state.chain);
});

app.get("/mempool", (req, res) => {
  res.json(state.mempool);
});

// ========= BRIDGE SECURISE SOL -> FIRE =========
// FRONT doit envoyer : { addr, amount, fromSol, txSig }
async function verifySolanaTransfer(txSig, fromSol, toSol, expectedAmountSol) {
  try {
    const r = await fetch(SOL_RPC, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        jsonrpc: "2.0",
        id: 1,
        method: "getTransaction",
        params: [txSig, { encoding: "jsonParsed", commitment: "confirmed" }]
      })
    });
    const j = await r.json();
    const tx = j.result;
    if (!tx || tx.meta && tx.meta.err) {
      return { ok: false, error: "Transaction not found or failed" };
    }
    const instructions = tx.transaction.message.instructions || [];
    const amountLamports = Math.floor(expectedAmountSol * 1e9);

    // On cherche une instruction transfer system => destination = trésorerie, source = fromSol, lamports = amountLamports
    for (const ix of instructions) {
      if (ix.program !== "system" || !ix.parsed) continue;
      if (ix.parsed.type !== "transfer") continue;
      const info = ix.parsed.info;
      if (
        info.source === fromSol &&
        info.destination === toSol &&
        Number(info.lamports) === amountLamports
      ) {
        return { ok: true };
      }
    }
    return { ok: false, error: "No matching transfer to treasury for this amount" };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

app.post("/bridge", async (req, res) => {
  try {
    const { addr, amount, fromSol, txSig } = req.body || {};
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ ok: false, error: "Invalid sol amount" });
    if (!fromSol || !txSig) {
      return res.status(400).json({ ok: false, error: "Missing fromSol or txSig" });
    }

    // Vérification on-chain de la transaction
    const verif = await verifySolanaTransfer(txSig, fromSol, TREASURY_SOL, amt);
    if (!verif.ok) {
      return res.status(400).json({ ok: false, error: "Bridge rejected: " + verif.error });
    }

    // Crédit côté POWCHAIN
    const w = getWallet(addr);
    const powUnits = Math.floor(amt * DEC); // 1 SOL => DEC unités POW (à ajuster plus tard si tu veux)
    w.pow += powUnits;
    w.nonce++;
    state.treasury.solBalance += amt;
    state.treasury.fireBalance += powUnits;

    const tx = {
      type: "bridge_in",
      to: addr,
      fromSol,
      treasury: TREASURY_SOL,
      sol: amt,
      powCredited: powUnits,
      txSig
    };
    addToMempool(tx);
    pushBlock("bridge_in", tx);

    res.json({ ok: true, credited: powUnits });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// ========= LP / SWAP / STAKING =========
app.post("/lp/add", (req, res) => {
  try {
    const { addr, pow, usdc } = req.body;
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const p = Number(pow || 0);
    const u = Number(usdc || 0);
    if (!(p > 0) || !(u > 0)) {
      return res.status(400).json({ ok: false, error: "Invalid amounts" });
    }
    const w = getWallet(addr);
    if (w.pow < p || w.usdc < u) {
      return res.json({ ok: false, error: "Insufficient balance" });
    }
    w.pow -= p;
    w.usdc -= u;
    state.lp.pow += p;
    state.lp.usdc += u;
    w.nonce++;

    const tx = { type: "lp_add", addr, pow: p, usdc: u };
    addToMempool(tx);
    pushBlock("lp_add", tx);

    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

app.post("/swap", (req, res) => {
  try {
    const { addr, dir, amount } = req.body;
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ ok: false, error: "Invalid amount" });
    if (dir !== "pow2usdc" && dir !== "usdc2pow") {
      return res.status(400).json({ ok: false, error: "Invalid dir" });
    }
    const w = getWallet(addr);
    const feeRate = 0.003;
    if (state.lp.pow <= 0 || state.lp.usdc <= 0) {
      return res.json({ ok: false, error: "Empty LP" });
    }

    if (dir === "pow2usdc") {
      if (w.pow < amt) return res.json({ ok: false, error: "Insufficient POW" });
      const k = state.lp.pow * state.lp.usdc;
      const powAfter = state.lp.pow + amt;
      const usdcAfter = k / powAfter;
      let out = state.lp.usdc - usdcAfter;
      const fee = out * feeRate;
      out -= fee;
      if (out <= 0) return res.json({ ok: false, error: "Swap too small" });

      w.pow -= amt;
      w.usdc += out;
      state.lp.pow += amt;
      state.lp.usdc -= out;
      state.treasury.usdcBalance += fee;
      w.nonce++;

      const tx = { type: "swap_pow2usdc", addr, in: amt, out };
      addToMempool(tx);
      pushBlock("swap_pow2usdc", tx);

      res.json({ ok: true, received: out });
    } else {
      if (w.usdc < amt) return res.json({ ok: false, error: "Insufficient USDC" });
      const k = state.lp.pow * state.lp.usdc;
      const usdcAfter = state.lp.usdc + amt;
      const powAfter = k / usdcAfter;
      let out = state.lp.pow - powAfter;
      const fee = out * feeRate;
      out -= fee;
      if (out <= 0) return res.json({ ok: false, error: "Swap too small" });

      w.usdc -= amt;
      w.pow += out;
      state.lp.usdc += amt;
      state.lp.pow -= out;
      state.treasury.fireBalance += fee;
      w.nonce++;

      const tx = { type: "swap_usdc2pow", addr, in: amt, out };
      addToMempool(tx);
      pushBlock("swap_usdc2pow", tx);

      res.json({ ok: true, received: out });
    }
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

app.post("/stake", (req, res) => {
  try {
    const { addr, amount } = req.body;
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ ok: false, error: "Invalid amount" });
    const w = getWallet(addr);
    if (w.pow < amt) return res.json({ ok: false, error: "Insufficient POW" });
    w.pow -= amt;
    w.staked += amt;
    state.staking.total += amt;
    w.nonce++;

    const tx = { type: "stake", addr, amount: amt };
    addToMempool(tx);
    pushBlock("stake", tx);

    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

app.post("/unstake", (req, res) => {
  try {
    const { addr, amount } = req.body;
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ ok: false, error: "Invalid amount" });
    const w = getWallet(addr);
    if (w.staked < amt) return res.json({ ok: false, error: "Insufficient staked" });
    w.staked -= amt;
    w.pow += amt;
    state.staking.total -= amt;
    w.nonce++;

    const tx = { type: "unstake", addr, amount: amt };
    addToMempool(tx);
    pushBlock("unstake", tx);

    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// ========= WEBSOCKET =========
const wss = new WebSocket.Server({ port: 7001 });

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  wss.clients.forEach(c => {
    if (c.readyState === WebSocket.OPEN) c.send(msg);
  });
}

wss.on("connection", ws => {
  broadcast({ type: "clients", count: wss.clients.size });
  ws.send(JSON.stringify({ type: "mempool", mempool: state.mempool }));
  ws.on("close", () => {
    broadcast({ type: "clients", count: wss.clients.size });
  });
});

// ========= LANCEMENT HTTP =========
app.listen(3000, () => {
  console.log("FIREINNERS HTTP API sur port 3000");
  console.log("WebSocket sur port 7001");
});




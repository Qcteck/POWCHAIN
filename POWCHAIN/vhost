set -euo pipefail
APP_DIR=/root/fireinners-security-sentinel
PORT=9696

echo "== 1) CHECK FILES =="
ls -la "$APP_DIR" | sed -n '1,120p'
test -f "$APP_DIR/server.js" || { echo "ERREUR: server.js manquant dans $APP_DIR"; exit 1; }
test -f "$APP_DIR/package.json" || { echo "ERREUR: package.json manquant dans $APP_DIR"; exit 1; }

echo
echo "== 2) SERVICE STATUS =="
systemctl status security-sentinel --no-pager || true

echo
echo "== 3) LAST LOGS =="
journalctl -u security-sentinel -n 120 --no-pager || true

echo
echo "== 4) FORCE RESTART =="
systemctl daemon-reload || true
systemctl restart security-sentinel || true
sleep 1

echo
echo "== 5) LISTEN CHECK =="
ss -lntp | grep ":$PORT" || echo "rien n'ecoute sur $PORT"

echo
echo "== 6) CURL LOCAL =="
curl -sS --max-time 2 "http://127.0.0.1:$PORT/public/state" | head -c 240; echo || echo "curl FAIL"

echo
echo "== 7) SEE WHY IF FAIL =="
systemctl status security-sentinel --no-pager || true
journalctl -u security-sentinel -n 80 --no-pager || true
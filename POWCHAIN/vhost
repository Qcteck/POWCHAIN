#!/bin/bash
set -e

echo "Déploiement FIREINNERS…"

# 1. Extraire les fichiers depuis FIREINNERS_FULL.txt
echo "[1/4] Extraction HTML, server.js et nginx.conf…"
awk '/=====HTML_START=====/{flag=1;next}/=====HTML_END=====/{flag=0}flag' FIREINNERS_FULL.txt > /var/www/html/index.html
awk '/=====SERVER_START=====/{flag=1;next}/=====SERVER_END=====/{flag=0}flag' FIREINNERS_FULL.txt > /root/POWCHAIN/server.js
awk '/=====NGINX_START=====/{flag=1;next}/=====NGINX_END=====/{flag=0}flag' FIREINNERS_FULL.txt > /etc/nginx/sites-available/bbqfinance.conf

# 2. Permissions
echo "[2/4] Permissions…"
chmod 644 /var/www/html/index.html
chmod 644 /etc/nginx/sites-available/bbqfinance.conf
chmod 600 /root/POWCHAIN/server.js

# 3. Lien NGINX
echo "[3/4] Activation Nginx…"
ln -sf /etc/nginx/sites-available/bbqfinance.conf /etc/nginx/sites-enabled/bbqfinance.conf

# Vérification config nginx
nginx -t

# Reload nginx
systemctl reload nginx

# 4. Redémarrage Node.js (pm2)
echo "[4/4] Restart pm2…"
pm2 delete fireinners || true
pm2 start /root/POWCHAIN/server.js --name fireinners
pm2 save

echo "Déploiement terminé !"


chmod +x deploy.sh


./deploy.sh




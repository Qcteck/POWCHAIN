// POWCHAIN - API HTTP + WebSocket
// Port HTTP : 3000  | Port WS : 7001

const fs = require("fs");
const path = require("path");
const http = require("http");
const express = require("express");
const WebSocket = require("ws");

// ---------- CHARGER LA BLOCKCHAIN LOCALE ----------
const CHAIN_FILE = path.join(__dirname, "chain.json");
let chain = [];

function loadChain() {
  try {
    if (fs.existsSync(CHAIN_FILE)) {
      const raw = fs.readFileSync(CHAIN_FILE, "utf8");
      chain = JSON.parse(raw);
      console.log("✅ Blockchain chargée :", chain.length, "blocs");
    } else {
      console.log("⚠️ Aucun chain.json trouvé, chaîne vide.");
      chain = [];
    }
  } catch (e) {
    console.error("❌ Erreur chargement chain.json :", e.message);
    chain = [];
  }
}

function getStats() {
  const height = chain.length ? chain[chain.length - 1].height || chain.length - 1 : 0;
  const txCount = chain.reduce((n, b) => n + (b.txs ? b.txs.length : 0), 0);
  const supply = chain.reduce((n, b) => n + (b.reward || 0), 0);
  return {
    height,
    blocks: chain.length,
    txCount,
    supply,
    updatedAt: new Date().toISOString()
  };
}

// ---------- API EXPRESS (PORT 3000) ----------
const app = express();
app.use(express.json());

// CORS simple pour tests depuis le navigateur
app.use((req, res, next) => {
  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Access-Control-Allow-Methods", "GET,POST,OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type");
  if (req.method === "OPTIONS") return res.end();
  next();
});

// GET /stats -> résumé JSON pour le Dashboard
app.get("/stats", (req, res) => {
  try {
    const stats = getStats();
    res.json({ ok: true, stats });
  } catch (e) {
    console.error("❌ Erreur /stats :", e.message);
    res.status(500).json({ ok: false, error: "stats_error" });
  }
});

// POST /tx -> exemple de réception TX (stub, à connecter à ta vraie logique)
app.post("/tx", (req, res) => {
  try {
    const tx = req.body || {};
    console.log("📨 TX reçue via /tx :", tx);
    // Ici tu brancheras ton validateur (mempool, signature, etc.)
    broadcast({ type: "tx", tx });
    res.json({ ok: true });
  } catch (e) {
    console.error("❌ Erreur /tx :", e.message);
    res.status(500).json({ ok: false, error: "tx_error" });
  }
});

// Petit check racine
app.get("/", (req, res) => {
  res.json({ ok: true, msg: "POWCHAIN API 3000 OK" });
});

const apiServer = http.createServer(app);

// ---------- WEBSOCKET (PORT 7001) ----------
const wsServer = http.createServer();
const wss = new WebSocket.Server({ server: wsServer });

function broadcast(msg) {
  const data = JSON.stringify(msg);
  wss.clients.forEach(c => {
    if (c.readyState === WebSocket.OPEN) c.send(data);
  });
}

wss.on("connection", (socket) => {
  console.log("🔌 Client WebSocket connecté");
  socket.send(JSON.stringify({ type: "hello", stats: getStats() }));
});

// ---------- LANCEMENT ----------
loadChain();

apiServer.listen(3000, "127.0.0.1", () => {
  console.log("🌐 HTTP API POWCHAIN en ligne sur port 3000 (/stats /tx)");
});

wsServer.listen(7001, "127.0.0.1", () => {
  console.log("📡 WebSocket POWCHAIN en ligne sur port 7001 (/ws)");
});
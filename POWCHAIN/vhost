let FW=null;
function genFire(){
 const chars="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
 let adr="FIRE";
 for(let i=0;i<30;i++)adr+=chars[Math.floor(Math.random()*chars.length)];
 FW={pub:adr,priv:"PRIV"+Math.random().toString(36).substring(2,32)};
 localStorage.setItem("FIREINNERS",JSON.stringify(FW));
 L("Wallet FIREINNERS généré");
 renderWallet();
}

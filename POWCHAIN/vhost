window.FI_wallet = {};
const log = t => document.getElementById("log").innerHTML += t + "\n";

// Base58 interne (PAS de bibliothèque externe → pas d’erreur)
const ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function toBase58(bytes){
  let x = BigInt("0x"+[...bytes].map(b=>b.toString(16).padStart(2,"0")).join(""));
  let r = "";
  while(x>0){ let mod = x % 58n; r = ALPHABET[mod] + r; x = x/58n; }
  return r;
}

FI_wallet.generate = () => {
  try{
    const priv = crypto.getRandomValues(new Uint8Array(32));
    const pub = crypto.getRandomValues(new Uint8Array(32));
    const addr = toBase58(pub);

    localStorage.setItem("fi_priv",Array.from(priv));
    localStorage.setItem("fi_pub",Array.from(pub));
    localStorage.setItem("fi_addr",addr);

    document.getElementById("addrFI").value = addr;
    FI_wallet.qr(addr);
    log("Wallet FIREINNERS généré");
  }catch(e){ alert("Erreur génération wallet : "+e); }
};

FI_wallet.reload = () => {
  const a = localStorage.getItem("fi_addr");
  if(!a) return;
  document.getElementById("addrFI").value = a;
  FI_wallet.qr(a);
};

FI_wallet.copy = () => navigator.clipboard.writeText(addrFI.value);

FI_wallet.qr = str => {
  const ctx = qr.getContext("2d");
  ctx.fillStyle="#000";ctx.fillRect(0,0,170,170);
  for(let i=0;i<160;i+=10)
    for(let j=0;j<160;j+=10)
      if((i*j+str.length)%17<8){ctx.fillStyle="#fff";ctx.fillRect(i+5,j+5,8,8);}
};


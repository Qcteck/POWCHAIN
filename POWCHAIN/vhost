"use strict";

// =========================
// Imports
// =========================
const express = require("express");
const bodyParser = require("body-parser");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const crypto = require("crypto");
const http = require("http");

// =========================
// Config serveur
// =========================
const HTTP_PORT = 3000;
const WS_PATH = "/ws";

const app = express();
app.use(bodyParser.json());

const httpServer = http.createServer(app);
const wss = new WebSocket.Server({ server: httpServer, path: WS_PATH });
const wsClients = new Set();

// =========================
// Config économie FIREINNERS
// =========================

// Tout est stocké en unités entières (pas de décimales)
const SUPPLY_MAX = 100_000_000; // 100M FIRE max

// Taux dynamique FIRE / SOL
const RATE_BASE = 1000;        // base : 1 SOL = 1000 FIRE
const TVL_REF = 1_000_000;     // TVL de référence (USDC FIRE)
const RATE_MIN = 800;          // min FIRE / SOL
const RATE_MAX = 5000;         // max FIRE / SOL

// Frais (basis points, 1% = 100 bp)
const FEE_TRANSFER_BURN_BP   = 50;   // 0.5% burn sur transfert FIRE
const FEE_SWAP_TOTAL_BP      = 30;   // 0.3% fees total sur swap
const FEE_SWAP_BURN_PART     = 0.5;  // 50% des fees swap brûlés
const FEE_BRIDGE_IN_TREAS_BP = 500;  // 5% vers trésorerie à l'entrée
const FEE_BRIDGE_IN_BURN_BP  = 200;  // 2% burn à l'entrée
const FEE_BRIDGE_OUT_BURN_BP = 1000; // 10% burn sur FIRE renvoyés
const FEE_UNSTAKE_BURN_BP    = 300;  // 3% burn si unstake anticipé

const STAKE_MIN_LOCK_MS = 30 * 24 * 60 * 60 * 1000; // 30 jours

// =========================
// État global
// =========================

let wallets = {}; // addr -> { fire, usdc, staked, nonce, stakeLock }
let treasury = { fire: 0, usdc: 0, sol: 0 };
let lp = { fire: 0, usdc: 0 };

let supplyCirculante = 0;
let mintedFireTotal = 0;
let burnedFireTotal = 0;

let chain = [];           // blocs
let bridgeHistory = [];   // historique des bridges

// =========================
// Genesis
// =========================
(function initGenesis() {
  const genesisSupply = SUPPLY_MAX;
  supplyCirculante = genesisSupply;
  mintedFireTotal = genesisSupply;
  treasury.fire = genesisSupply;

  const genesisBlock = {
    height: 1,
    time: Date.now(),
    prevHash: "0".repeat(64),
    hash: "GENESIS",
    txs: [],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  };

  chain.push(genesisBlock);
  console.log("[fireinners] Genesis initialisée, supply =", genesisSupply, "FIRE");
})();

// =========================
// Utilitaires
// =========================

function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = {
      fire: 0,
      usdc: 0,
      staked: 0,
      nonce: 0,
      stakeLock: 0
    };
  }
  return wallets[addr];
}

function clamp(x, min, max) {
  return x < min ? min : x > max ? max : x;
}

function applyBp(amount, bp) {
  if (!amount || amount <= 0) return 0;
  return Math.floor((amount * bp) / 10000);
}

// TVL en USDC FIRE: LP + trésorerie
function getTVL() {
  const lpUsdc = lp.usdc || 0;
  const treUsdc = treasury.usdc || 0;
  return lpUsdc + treUsdc;
}

// Taux dynamique FIRE / SOL
function getFireRatePerSol() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || 1);
  const rawRate = RATE_BASE * factor;
  return clamp(rawRate, RATE_MIN, RATE_MAX);
}

function burnFire(amount) {
  if (!amount || amount <= 0) return 0;
  const actual = Math.min(amount, supplyCirculante);
  burnedFireTotal += actual;
  supplyCirculante -= actual;
  return actual;
}

function mintFire(amount) {
  if (!amount || amount <= 0) return 0;
  const spaceLeft = SUPPLY_MAX - supplyCirculante;
  const mintable = Math.max(0, Math.min(amount, spaceLeft));
  mintedFireTotal += mintable;
  supplyCirculante += mintable;
  return mintable;
}

function addFireToWallet(addr, amount) {
  const w = ensureWallet(addr);
  w.fire += amount;
}

function subFireFromWallet(addr, amount) {
  const w = ensureWallet(addr);
  if (w.fire < amount) throw new Error("Solde FIRE insuffisant");
  w.fire -= amount;
}

function addUsdcToWallet(addr, amount) {
  const w = ensureWallet(addr);
  w.usdc += amount;
}

function subUsdcFromWallet(addr, amount) {
  const w = ensureWallet(addr);
  if (w.usdc < amount) throw new Error("Solde USDC FIRE insuffisant");
  w.usdc -= amount;
}

// Prix LP (USDC / FIRE)
function getLpPrice() {
  if (lp.fire <= 0 || lp.usdc <= 0) return 0;
  return lp.usdc / lp.fire;
}

// Mine un bloc simple pour chaîner les événements importants
function mineBlock(txs) {
  const height = chain.length + 1;
  const prevHash = chain[chain.length - 1]?.hash || "0".repeat(64);
  const payload = JSON.stringify({
    height,
    prevHash,
    txs,
    treasury,
    lp,
    time: Date.now()
  });
  const hash = crypto.createHash("sha256").update(payload).digest("hex");
  const block = {
    height,
    time: Date.now(),
    prevHash,
    hash,
    txs,
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  };
  chain.push(block);
  return block;
}

// Broadcast WS
function broadcast(obj) {
  const msg = JSON.stringify(obj);
  for (const ws of wsClients) {
    if (ws.readyState === WebSocket.OPEN) {
      ws.send(msg);
    }
  }
}

function getStats() {
  return {
    height: chain.length,
    wallets: Object.keys(wallets).length,
    treasury,
    lp,
    supplyCirculante,
    mintedFireTotal,
    burnedFireTotal,
    tvl: getTVL(),
    rateFirePerSol: getFireRatePerSol(),
    lpPriceUsdcPerFire: getLpPrice(),
    bridges: bridgeHistory.length
  };
}

// =========================
// Handlers économiques principaux
// =========================

// Bridge SOL -> FIREINNERS (entrée)
function processBridgeIn(params) {
  const { addr, solAmount } = params;
  if (!addr) throw new Error("adresse manquante");
  if (!solAmount || solAmount <= 0) throw new Error("solAmount invalide");

  const rate = getFireRatePerSol();       // FIRE par SOL
  const fireBrut = Math.floor(solAmount * rate);

  const fireMinted = mintFire(fireBrut);
  if (fireMinted <= 0) throw new Error("Supply max atteinte");

  const feeTreas = applyBp(fireMinted, FEE_BRIDGE_IN_TREAS_BP);
  const feeBurn = applyBp(fireMinted, FEE_BRIDGE_IN_BURN_BP);
  const userFire = fireMinted - feeTreas - feeBurn;
  if (userFire <= 0) throw new Error("Bridge net <= 0");

  treasury.fire += feeTreas;
  const burned = burnFire(feeBurn);
  addFireToWallet(addr, userFire);

  treasury.sol += solAmount;

  return {
    type: "BRIDGE_IN",
    addr,
    solAmount,
    rateFirePerSol: rate,
    fireMinted,
    userFire,
    feeTreasFire: feeTreas,
    burnedFire: burned
  };
}

// Bridge FIRE -> SOL (sortie) — optionnel / à sécuriser plus tard
function processBridgeOut(params) {
  const { addr, fireAmount } = params;
  if (!addr) throw new Error("adresse manquante");
  if (!fireAmount || fireAmount <= 0) throw new Error("fireAmount invalide");

  const rate = getFireRatePerSol();

  subFireFromWallet(addr, fireAmount);

  const feeBurn = applyBp(fireAmount, FEE_BRIDGE_OUT_BURN_BP);
  const fireNet = fireAmount - feeBurn;
  if (fireNet <= 0) throw new Error("Bridge out net <= 0");

  const burned = burnFire(fireAmount);

  const solOut = fireNet / rate;
  if (treasury.sol < solOut) {
    throw new Error("SOL trésorerie insuffisant pour bridge out");
  }
  treasury.sol -= solOut;

  return {
    type: "BRIDGE_OUT",
    addr,
    fireSent: fireAmount,
    fireNet,
    burnedFire: burned,
    rateFirePerSol: rate,
    solOut
  };
}

// =========================
// Routes HTTP
// =========================

app.get("/", (_req, res) => {
  res.json({ ok: true, service: "FIREINNERS validator", port: HTTP_PORT });
});

app.get("/ping", (_req, res) => {
  res.json({ ok: true, pong: Date.now() });
});

// Stats globales (frontend => indicateur HTTP OK)
app.get("/stats", (_req, res) => {
  res.json({ ok: true, stats: getStats() });
});

// Chaîne complète
app.get("/chain", (_req, res) => {
  res.json({ ok: true, chain });
});

// Alias /explorer (utilisé par Nginx)
app.get("/explorer", (_req, res) => {
  res.json({
    ok: true,
    height: chain.length,
    lastBlock: chain[chain.length - 1] || null
  });
});

// Historique des bridges
app.get("/bridge-history", (_req, res) => {
  res.json({ ok: true, history: bridgeHistory });
});

// Bridge SOL -> FIREINNERS
app.post("/bridge", (req, res) => {
  try {
    const addr = req.body.addr || req.body.powAddress || null;
    const sol = Number(
      req.body.sol !== undefined ? req.body.sol : req.body.solAmount
    );
    const solAddress = req.body.solAddress || null;
    const txSig = req.body.txSig || null; // signature Phantom (vérification à ajouter plus tard)

    if (!addr) {
      return res.status(400).json({ error: "adresse manquante" });
    }
    if (Number.isNaN(sol) || sol <= 0) {
      return res.status(400).json({ error: "sol invalide" });
    }

    const result = processBridgeIn({ addr, solAmount: sol });
    const block = mineBlock([result]);

    const histEntry = {
      type: "BRIDGE_IN",
      addr,
      sol,
      solAddress,
      txSig,
      result,
      blockHeight: block.height,
      time: Date.now()
    };
    bridgeHistory.push(histEntry);
    if (bridgeHistory.length > 500) bridgeHistory.shift();

    console.log("🔥 Bridge SOL→FIREINNERS", {
      addr,
      sol,
      solAddress,
      txSig,
      fireMinted: result.fireMinted
    });

    broadcast({ type: "bridge_in", data: { result, blockHeight: block.height } });

    return res.json({
      ok: true,
      ...result,
      blockHeight: block.height
    });
  } catch (e) {
    console.error("❌ Bridge /bridge error:", e);
    return res
      .status(500)
      .json({ error: e && e.message ? e.message : "bridge_failed" });
  }
});

// Bridge FIRE -> SOL (pour plus tard, protégé)
app.post("/bridge-out", (req, res) => {
  try {
    const addr = req.body.addr || null;
    const fireAmount = Number(req.body.fire || req.body.fireAmount || 0);

    if (!addr) return res.status(400).json({ error: "adresse manquante" });
    if (Number.isNaN(fireAmount) || fireAmount <= 0) {
      return res.status(400).json({ error: "fireAmount invalide" });
    }

    // Pour l’instant on exécute la logique interne, mais
    // la vraie sortie SOL sur Solana doit être gérée à part (RPC + txSig)
    const result = processBridgeOut({ addr, fireAmount });
    const block = mineBlock([result]);

    const histEntry = {
      type: "BRIDGE_OUT",
      addr,
      fireAmount,
      result,
      blockHeight: block.height,
      time: Date.now()
    };
    bridgeHistory.push(histEntry);
    if (bridgeHistory.length > 500) bridgeHistory.shift();

    console.log("🔥 Bridge FIRE→SOL (interne)", { addr, fireAmount });

    broadcast({
      type: "bridge_out",
      data: { result, blockHeight: block.height }
    });

    return res.json({
      ok: true,
      ...result,
      blockHeight: block.height
    });
  } catch (e) {
    console.error("❌ Bridge /bridge-out error:", e);
    return res
      .status(500)
      .json({ error: e && e.message ? e.message : "bridge_out_failed" });
  }
});

// =========================
// WebSocket
// =========================

wss.on("connection", (ws) => {
  wsClients.add(ws);
  console.log("[fireinners] WS client connecté, total =", wsClients.size);

  // envoie un snapshot de départ
  try {
    ws.send(JSON.stringify({ type: "hello", stats: getStats() }));
  } catch (e) {
    // ignore
  }

  ws.on("close", () => {
    wsClients.delete(ws);
    console.log("[fireinners] WS client déconnecté, total =", wsClients.size);
  });

  ws.on("error", (err) => {
    console.error("WS error:", err);
  });
});

// =========================
// Lancement serveur
// =========================

httpServer.listen(HTTP_PORT, () => {
  console.log(
    `🔥 FIREINNERS Validator prêt — HTTP + WS sur port ${HTTP_PORT}`
  );
});



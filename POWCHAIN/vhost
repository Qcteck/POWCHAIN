// ================= FIREINNERS BLOCKCHAIN =================
const fs = require("fs");
const http = require("http");
const WebSocket = require("ws");
const bs58 = require("bs58");
const nacl = require("tweetnacl");
nacl.util = require("tweetnacl-util");

// Params
const PORT = 3000;
const PORT_WS = 7001;
const SAVE = "/root/powchain/data.json";

// STATE
let state = {
 height:0,
 wallets:{},
 lp:{fire:0,usdc:0},
 supplyMax:1000000000000,
 supplyC:0,
 treasury:{fire:0,usdc:0},
 chain:[]
};

// LOAD
if (fs.existsSync(SAVE)) {
 try{ state = JSON.parse(fs.readFileSync(SAVE)); console.log("✔ Données chargées");}
 catch(e){ console.log("❌ Chargement impossible, nouveau réseau"); }
}

// SAVE
function persist(){ fs.writeFileSync(SAVE, JSON.stringify(state)); }

// GET WALLET
function w(addr){
 if(!state.wallets[addr]) state.wallets[addr]={fire:0,usdc:0,nonce:0};
 return state.wallets[addr];
}

// BROADCAST
let sockets = [];
function broadcast(msg){ sockets.forEach(s=>{ try{s.send(msg);}catch{}}); }
function log(msg){ console.log(msg); broadcast(msg); }

// TX VALIDATION
function verifySig(tx){
 if(!tx.sig) return false;
 let c = {...tx}; delete c.sig;
 let msg = new TextEncoder().encode(JSON.stringify(c));
 return nacl.sign.detached.verify(msg, bs58.decode(tx.sig), bs58.decode(tx.from||tx.to));
}

// APPLY TX
function apply(tx){
 if(tx.nonce <= w(tx.from||tx.to).nonce) return "nonce";
 w(tx.from||tx.to).nonce = tx.nonce;

 if(tx.type === "bridge"){
  // SOL → FIRE (1 SOL = mint FIRE selon TVL LP ratio)
  let amt = Number(tx.amount);
  let minted = amt * 10000; // ratio mint – ajustable
  if(state.supplyC + minted > state.supplyMax) return "max";
  w(tx.to).fire += minted;
  state.supplyC += minted;
  state.treasury.usdc += 0; // SOL non comptabilisé
  state.height++;
  return "bridge_ok";
 }

 if(tx.type === "swap"){
  let amt = Number(tx.amount);
  let side = tx.side;
  if(side === "F2U"){
    if(w(tx.from).fire < amt) return "nofire";
    const k = state.lp.fire*state.lp.usdc;
    const newF = state.lp.fire + amt;
    const newU = k / newF;
    const out = state.lp.usdc - newU;
    state.lp.fire = newF;
    state.lp.usdc = newU;
    w(tx.from).fire -= amt;
    w(tx.from).usdc += out;
  }
  if(side === "U2F"){
    if(w(tx.from).usdc < amt) return "nousdc";
    const k = state.lp.fire*state.lp.usdc;
    const newU = state.lp.usdc + amt;
    const newF = k / newU;
    const out = state.lp.fire - newF;
    state.lp.usdc = newU;
    state.lp.fire = newF;
    w(tx.from).usdc -= amt;
    w(tx.from).fire += out;
  }
  state.height++;
  return "swap_ok";
 }

 if(tx.type === "lp_add"){
  let f = Number(tx.fire), u = Number(tx.usdc);
  if(w(tx.from).fire < f || w(tx.from).usdc < u) return "notokens";
  w(tx.from).fire -= f;
  w(tx.from).usdc -= u;
  state.lp.fire += f;
  state.lp.usdc += u;
  state.height++;
  return "lp_ok";
 }

 return "invalid";
}

// HTTP
const server = http.createServer(async (req,res)=>{
 res.setHeader("Access-Control-Allow-Origin","*");
 res.setHeader("Access-Control-Allow-Methods","GET,POST");
 res.setHeader("Content-Type","application/json");

 if(req.url.startsWith("/stats")){
   return res.end(JSON.stringify({
     height:state.height,
     supplyC:state.supplyC,
     supplyMax:state.supplyMax,
     lp:state.lp,
     treasury:state.treasury
   }));
 }

 if(req.url.startsWith("/wallet/")){
   let addr = req.url.split("/")[2];
   let wal = w(addr);
   return res.end(JSON.stringify({
     fire:wal.fire,
     usdc:wal.usdc,
     supplyC:state.supplyC,
     supplyD:state.supplyMax - state.supplyC
   }));
 }

 if(req.url.startsWith("/tx") && req.method==="POST"){
   let body = "";
   req.on("data",d=>body+=d);
   req.on("end",()=>{
     try{
       let tx = JSON.parse(body);
       if(!verifySig(tx)) return res.end(JSON.stringify({err:"sig"}));
       let r = apply(tx);
       persist();
       log("TX "+tx.type+" "+r);
       res.end(JSON.stringify({ok:r}));
     }catch(e){ res.end(JSON.stringify({err:"bad"})); }
   });
   return;
 }

 res.end(JSON.stringify({err:"404"}));
});

// WS
const wss = new WebSocket.Server({ port: PORT_WS });
wss.on("connection",ws=>{
 sockets.push(ws);
 ws.on("close",()=> sockets = sockets.filter(x=>x!==ws));
 ws.send("Connexion WS OK");
});

// START
server.listen(PORT,()=>console.log("🔥 HTTP API Fireinners sur port",PORT));
console.log("🔥 WebSocket Fireinners sur port",PORT_WS);
log("🔥 Fireinners blockchain prête");




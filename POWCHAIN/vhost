// ============ QR CODE ============
function drawQR(text){
  let cv=document.getElementById("qr");
  let ctx=cv.getContext("2d");
  let s=cv.width;
  ctx.fillStyle="#fff";
  ctx.fillRect(0,0,s,s);

  if(!text) return;
  let hash=[...text].reduce((a,c)=>(a*31+c.charCodeAt(0))>>>0,1);
  let size=25, cell=s/size;
  ctx.fillStyle="#000";
  let rnd=hash;
  for(let y=0;y<size;y++){
    for(let x=0;x<size;x++){
      rnd=(rnd*1103515245+12345)>>>0;
      if(rnd&0x80000000)
        ctx.fillRect(x*cell,y*cell,cell,cell);
    }
  }
}

// ============ FIREINNERS WALLET ============
function b58enc(bytes){
  const AL="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  let d=[0];
  for(let i=0;i<bytes.length;i++){
    let c=bytes[i];
    for(let j=0;j<d.length;j++){
      let x=d[j]*256+c;
      d[j]=x%58;
      c=(x/58)|0;
    }
    while(c>0){ d.push(c%58); c=(c/58)|0; }
  }
  let r="";
  for(let k=d.length-1;k>=0;k--) r+=AL[d[k]];
  return r;
}

document.getElementById("btnGen").onclick=()=>{

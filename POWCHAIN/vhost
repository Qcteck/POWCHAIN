// Explorer bloc
app.get("/block/:height", (req, res) => {
  const h = parseInt(req.params.height, 10);
  if (Number.isNaN(h)) return res.status(400).json({ error: "height invalide" });
  const b = chain.find((x) => x.height === h);
  if (!b) return res.status(404).json({ error: "bloc introuvable" });
  res.json(b);
});

// Bridge réel SOL -> FIREINNERS
app.post("/bridge", async (req, res) => {
  try {
    const { addr, fromSol, txSig } = req.body || {};
    if (!addr || !fromSol || !txSig) {
      return res
        .status(400)
        .json({ ok: false, error: "addr, fromSol et txSig requis" });
    }
    if (bridgedTx.has(txSig)) {
      return res
        .status(400)
        .json({ ok: false, error: "bridge déjà utilisé pour cette tx" });
    }

    const { solAmount } = await verifySolanaBridgeTx(fromSol, txSig);
    const bridge = processBridgeIn({ addr, solAmount });
    bridgedTx.add(txSig);

    const record = {
      type: "BRIDGE_IN",
      addr,
      fromSol,
      txSig,
      solAmount,
      ...bridge
    };
    appendBlock(record);

    res.json({
      ok: true,
      bridge,
      supplyCirculante,
      supplyDisponible: SUPPLY_MAX - supplyCirculante
    });
  } catch (e) {
    console.error("BRIDGE ERR", e);
    res.status(400).json({
      ok: false,
      error: e.message || String(e)
    });
  }
});


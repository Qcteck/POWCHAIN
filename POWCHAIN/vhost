#!/bin/bash
# Déploiement complet POWCHAIN / FIREINNERS
set -e

APP_NAME="fireinners"
SRC_DIR="/root/POWCHAIN"
WEB_DIR="/var/www/html"
BACK_DIR="/root"

echo "----------------------------------------"
echo "   DEPLOIEMENT AUTOMATIQUE POWCHAIN"
echo "   Source : $SRC_DIR"
echo "   Backend: $BACK_DIR/server.js"
echo "   Webdir : $WEB_DIR"
echo "----------------------------------------"

# Vérification du dossier source
if [ ! -d "$SRC_DIR" ]; then
  echo "ERREUR : Le dossier $SRC_DIR n'existe pas."
  exit 1
fi

### 1) Backend – server.js
if [ -f "$SRC_DIR/server.js" ]; then
  echo "[1/4] Mise à jour backend server.js"
  cp "$SRC_DIR/server.js" "$BACK_DIR/server.js"
else
  echo "ATTENTION : Aucun server.js trouvé dans $SRC_DIR"
fi

### 2) Frontend – index.html
if [ -f "$SRC_DIR/index.html" ]; then
  echo "[2/4] Mise à jour index.html"
  cp "$SRC_DIR/index.html" "$WEB_DIR/index.html"
  chown www-data:www-data "$WEB_DIR/index.html"
  chmod 644 "$WEB_DIR/index.html"
else
  echo "ATTENTION : Aucun index.html trouvé dans $SRC_DIR"
fi

### 3) Autres fichiers web optionnels
EXTRA_WEB_FILES=("explorer.html" "mempool.html" "stats.html" "style.css")

for f in "${EXTRA_WEB_FILES[@]}"; do
  if [ -f "$SRC_DIR/$f" ]; then
    echo "[+] Copie : $f"
    cp "$SRC_DIR/$f" "$WEB_DIR/$f"
    chown www-data:www-data "$WEB_DIR/$f"
    chmod 644 "$WEB_DIR/$f"
  fi
done

### 4) PM2 – Backend FIREINNERS
echo "[3/4] Redémarrage backend via PM2"

cd "$BACK_DIR"

if pm2 list | grep -q "$APP_NAME"; then
  pm2 restart "$APP_NAME"
else
  pm2 start server.js --name "$APP_NAME"
fi

pm2 save

### 5) NGINX – Test + Reload
echo "[4/4] Test NGINX..."

if nginx -t; then
  echo "NGINX OK → reload"
  systemctl reload nginx || echo "⚠️  Reload NGINX échoué (service toujours actif)"
else
  echo "❌ ERREUR : 'nginx -t' a échoué → pas de reload"
fi

echo "----------------------------------------"
echo "   DEPLOIEMENT TERMINE AVEC SUCCÈS"
echo "----------------------------------------"


sudo chmod +x /root/deploy_powchain.sh
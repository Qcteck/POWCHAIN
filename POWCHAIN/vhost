nano /etc/nginx/sites-available/bbqfinance


server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    # HTTP (stats, chain, bridge, API)
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
    }
    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
    }
    location /bridge-history {
        proxy_pass http://127.0.0.1:3000/bridge-history;
    }
    location /bridge {
        proxy_pass http://127.0.0.1:3000/bridge;
    }
    location /bridge-out {
        proxy_pass http://127.0.0.1:3000/bridge-out;
    }

    # WebSocket
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }
}



      letter-spacing:.6px;
      margin:6px 0 2px;
      opacity:.9;
    }
    input,button,textarea{
      font-family:inherit;
      font-size:13px;
      border-radius:7px;
      border:1px solid #1f2937;
      padding:6px 7px;
      background:#020617;
      color:#e5ecff;
      box-sizing:border-box;
    }
    input,textarea{
      width:100%;
    }
    button{
      cursor:pointer;
      background:linear-gradient(135deg,#1d4ed8,#22d3ee);
      border:none;
      margin-top:6px;
      font-weight:600;
    }
    button.secondary{
      background:#020617;
      border:1px solid #1f2937;
    }
    button:disabled{
      opacity:.5;
      cursor:not-allowed;
    }
    .row{
      display:flex;
      gap:6px;
    }
    .row > div{flex:1;}
    .value{
      font-size:12px;
      margin:2px 0;
    }
    .value b{font-size:13px;}
    #log{
      width:100%;
      height:150px;
      background:#020617;
      border-radius:8px;
      border:1px solid #1f2937;
      padding:6px;
      box-sizing:border-box;
      font-size:11px;
      white-space:pre-wrap;
      overflow:auto;
    }
    .small{
      font-size:11px;
      opacity:.8;
      margin-top:4px;
    }
    .chart{
      height:120px;
      border-radius:10px;
      border:1px solid #1f2937;
      background:radial-gradient(circle at 20% 0,#1d4ed8,#020617 55%,#000 100%);
      position:relative;
      overflow:hidden;
    }
    .chart canvas{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
    }
  </style>
  <!-- Solana Web3 pour Phantom -->
  <script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
  <!-- Crypto POWCHAIN (Ed25519 + base58) -->
  <script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bs58@5.0.0/dist/bs58.min.js"></script>
</head>
<body>
<div id="wrap">
  <h1>POWCHAIN — Client Complet</h1>
  <div class="backend">
    <div class="chip"><span class="dot" id="dotHttp"></span>Backend : <b>HTTP <span id="httpStatusTxt">...</span></b></div>
    <div class="chip"><span class="dot" id="dotWs"></span><b>WS <span id="wsStatusTxt">...</span></b></div>
  </div>

  <div class="grid">
    <!-- RÉSEAU -->
    <div class="card">
      <h2>Réseau POWCHAIN</h2>
      <div class="value">Hauteur : <b id="height">-</b></div>
      <div class="value">Nb wallets : <b id="nbWallets">-</b></div>
      <div class="value">TVL POW : <b id="tvlPow">-</b></div>
      <div class="value">TVL USDC POW : <b id="tvlUsdc">-</b></div>
      <div class="value">Trésorerie POW : <b id="treasuryPow">-</b></div>
      <div class="value">Trésorerie USDC POW : <b id="treasuryUsdc">-</b></div>
      <div class="small">Données HTTP : <span id="lastHttp">-</span></div>
    </div>

    <!-- WALLET POWCHAIN -->
    <div class="card">
      <h2>Wallet POWCHAIN — Générateur</h2>
      <label>Adresse POWCHAIN (base58)</label>
      <input id="powAddr" readonly/>
      <div class="row">
        <button id="btnGenPow">Générer wallet POWCHAIN</button>
        <button id="btnReloadPow" class="secondary">Recharger</button>
      </div>
      <div class="row">
        <div>
          <label>Solde POW</label>
          <input id="balPow" readonly/>
        </div>
        <div>
          <label>Solde USDC POW</label>
          <input id="balUsdcPow" readonly/>
        </div>
      </div>
      <div class="small">
        Le wallet est généré localement (nacl + bs58) et stocké en localStorage.
        Rien n’est envoyé au serveur sauf les TX signées.
      </div>
    </div>

    <!-- WALLET SOLANA / BRIDGE -->
    <div class="card">
      <h2>Wallet Solana — Phantom</h2>
      <label>Adresse Solana</label>
      <input id="solAddr" readonly/>
      <div class="row">
        <button id="btnConnectPhantom">Connecter Phantom</button>
        <button id="btnRefreshSol" class="secondary">Refresh</button>
      </div>
      <div class="row">
        <div>
          <label>SOL (wallet)</label>
          <input id="balSol" readonly/>
        </div>
        <div>
          <label>USDC Solana</label>
          <input id="balUsdcSol" readonly/>
        </div>
      </div>

      <h2 style="margin-top:12px;">Bridge vers POWCHAIN</h2>
      <label>Montant SOL à bridger</label>
      <input id="bridgeAmount" placeholder="0.001"/>
      <button id="btnBridge">SOL → POWCHAIN</button>
      <div class="small">
        Envoie une requête BRIDGE_REQUEST au serveur POWCHAIN.
        Les détails du pont sont gérés côté backend.
      </div>
    </div>
  </div>

  <div class="grid" style="margin-top:10px;">
    <!-- ACTIONS POWCHAIN -->
    <div class="card">
      <h2>Actions Wallet POWCHAIN</h2>
      <label>Destinataire POWCHAIN</label>
      <input id="destPow"/>
      <label>Montant POW</label>
      <input id="sendAmount"/>
      <button id="btnSend">Send</button>

      <label style="margin-top:10px;">Montant POW à staker</label>
      <input id="stakeAmount"/>
      <button id="btnStake">Stake</button>
    </div>

    <!-- DEX / LP -->
    <div class="card">
      <h2>DEX POWCHAIN</h2>
      <label>Ajouter de la liquidité (POW / USDC POW)</label>
      <label>Montant POW</label>
      <input id="lpPow"/>
      <label>Montant USDC POW</label>
      <input id="lpUsdc"/>
      <button id="btnAddLp">Add LP</button>
      <div class="small">
        Un add LP ≥ 10 000 POW et 10 000 USDC POW donne le badge session WHALE.
      </div>
      <label style="margin-top:10px;">Graphique DEX POW / USDC POW</label>
      <div class="chart">
        <canvas id="chart"></canvas>
      </div>
    </div>

    <!-- EXPLORER & LOG -->
    <div class="card">
      <h2>Explorer & Log</h2>
      <div class="row">
        <button id="btnLoadBlocks">Charger derniers blocs</button>
        <button id="btnClearLog" class="secondary">Clear log</button>
      </div>
      <textarea id="log" readonly></textarea>
    </div>
  </div>
</div>

<script>
(function(){
  const API_BASE = (location.protocol === "https:" ? "https://" : "http://") + location.host;
  const WS_URL   = (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws";
  const DRPC_URL = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_SOL_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

  let ws = null;
  let lastHttpTime = null;
  let solConn = null;
  let solPublicKey = null;

  const el = id => document.getElementById(id);
  const logBox = el("log");

  function nowLabel(){
    const d = new Date();
    return d.toTimeString().slice(0,8);
  }

  function logLine(txt){
    logBox.value += "["+nowLabel()+"] "+txt+"\n";
    logBox.scrollTop = logBox.scrollHeight;
  }

  function setBackendStatus(httpOk, wsOk){
    el("dotHttp").className = "dot"+(httpOk ? " ok":"");
    el("dotWs").className   = "dot"+(wsOk ? " ok":"");
    el("httpStatusTxt").textContent = httpOk ? "OK" : "ERR";
    el("wsStatusTxt").textContent   = wsOk ? "OK" : "ERR";
  }

  async function fetchJSON(path, opts){
    const url = API_BASE + path;
    const res = await fetch(url, opts || {});
    if (!res.ok) throw new Error("HTTP "+res.status+" "+path);
    return res.json();
  }

  async function refreshStats(){
    try{
      const s = await fetchJSON("/stats");
      lastHttpTime = Date.now();
      el("height").textContent       = s.height;
      el("nbWallets").textContent    = s.wallets;
      el("tvlPow").textContent       = s.tvlPow;
      el("tvlUsdc").textContent      = s.tvlUsdc;
      el("treasuryPow").textContent  = s.treasuryPow;
      el("treasuryUsdc").textContent = s.treasuryUsdc;
      el("lastHttp").textContent     = new Date().toLocaleTimeString();
      setBackendStatus(true, ws && ws.readyState===WebSocket.OPEN);
      logLine("Stats réseau mises à jour.");
    }catch(e){
      setBackendStatus(false, ws && ws.readyState===WebSocket.OPEN);
      logLine("ERR stats: "+e.message);
    }
  }

  async function loadBlocks(){
    try{
      const chain = await fetchJSON("/chain");
      const last = chain.slice(-30);
      logLine("Derniers blocs ("+last.length+") :");
      last.forEach(b=>{
        logLine("  height="+b.index+" ts="+b.time+" txs="+(b.txs?b.txs.length:0)+" hash="+String(b.hash).slice(0,10)+"...");
      });
    }catch(e){
      logLine("ERR chain: "+e.message);
    }
  }

  // WALLET POWCHAIN LOCAL
  function loadLocalWallet(){
    try{
      const raw = localStorage.getItem("pow_wallet");
      if (!raw) return null;
      return JSON.parse(raw);
    }catch(_){return null;}
  }

  function saveLocalWallet(w){
    localStorage.setItem("pow_wallet", JSON.stringify(w));
  }

  function updatePowBalancesView(w){
    el("powAddr").value   = w ? w.addr : "";
    el("balPow").value    = w ? w.pow  : "";
    el("balUsdcPow").value= w ? w.usdc: "";
  }

  async function syncPowWalletFromServer(){
    const w = loadLocalWallet();
    if (!w) return;
    try{
      const info = await fetchJSON("/wallet?id="+encodeURIComponent(w.addr));
      w.pow  = info.pow;
      w.usdc = info.usdc;
      saveLocalWallet(w);
      updatePowBalancesView(w);
      logLine("Wallet POWCHAIN rechargé depuis le serveur.");
    }catch(e){
      logLine("ERR wallet POWCHAIN: "+e.message);
    }
  }

  function generatePowWallet(){
    try{
      const kp = nacl.sign.keyPair();               // Uint8Array
      const addr = bs58.encode(kp.publicKey);       // base58 string
      const priv = bs58.encode(kp.secretKey);       // base58 string
      const w = { addr, priv, pow:0, usdc:0 };
      saveLocalWallet(w);
      updatePowBalancesView(w);
      logLine("Nouveau wallet POWCHAIN généré.");
    }catch(e){
      logLine("ERR génération wallet POWCHAIN: "+e.message);
      alert("Erreur génération wallet POWCHAIN : "+e.message);
    }
  }

  // SIGNATURE TX POWCHAIN
  async function signPowTx(obj){
    const w = loadLocalWallet();
    if (!w){
      alert("Génère d'abord un wallet POWCHAIN.");
      return null;
    }
    const msgObj = {
      type: obj.type,
      from: w.addr,
      to:   obj.to   ?? null,
      amount: obj.amount ?? null,
      extra: obj.extra ?? null
    };
    const msg = new TextEncoder().encode(JSON.stringify(msgObj));
    const privBytes = bs58.decode(w.priv);          // Uint8Array
    const sig  = nacl.sign.detached(msg, privBytes);
    const tx = {...obj, from:w.addr, sig: bs58.encode(sig)};
    return tx;
  }

  async function sendPowTx(tx){
    const res = await fetchJSON("/tx",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(tx)
    });
    return res;
  }

  // Phantom
  async function connectPhantom(){
    if (!window.solana || !window.solana.isPhantom){
      alert("Phantom n'est pas disponible dans ce navigateur.");
      return;
    }
    try{
      const resp = await window.solana.connect();
      solPublicKey = resp.publicKey;
      el("solAddr").value = solPublicKey.toBase58();
      logLine("Phantom connecté : "+el("solAddr").value);
      await refreshSolBalances();
    }catch(e){
      logLine("ERR Phantom connect: "+e.message);
    }
  }

  async function refreshSolBalances(){
    if (!solPublicKey){
      logLine("Connecte Phantom d'abord.");
      return;
    }
    try{
      if (!solConn){
        solConn = new solanaWeb3.Connection(DRPC_URL,"confirmed");
      }
      const solLamports = await solConn.getBalance(solPublicKey);
      el("balSol").value = (solLamports / 1e9).toFixed(5);

      const ata = await solConn.getParsedTokenAccountsByOwner(
        solPublicKey,
        { mint: new solanaWeb3.PublicKey(USDC_SOL_MINT) }
      );
      let usdc = 0;
      ata.value.forEach(a=>{
        const info = a.account.data.parsed.info;
        const amt  = Number(info.tokenAmount.uiAmount || 0);
        usdc += amt;
      });
      el("balUsdcSol").value = usdc.toFixed(2);
      logLine("Soldes Solana mis à jour (SOL + USDC).");
    }catch(e){
      logLine("PHANTOM ERR: "+e.message);
    }
  }

  // Bridge SOL → POWCHAIN (vers /bridge)
  async function doBridge(){
    const w = loadLocalWallet();
    if (!w){
      alert("Génère d'abord un wallet POWCHAIN.");
      return;
    }
    if (!solPublicKey){
      alert("Connecte Phantom d'abord.");
      return;
    }
    const amtStr = el("bridgeAmount").value.trim();
    const amount = Number(amtStr);
    if (!amtStr || !Number.isFinite(amount) || amount<=0){
      alert("Montant SOL invalide.");
      return;
    }
    try{
      logLine("BRIDGE_REQUEST préparation "+amount+" SOL → "+w.addr+" ...");

      const payload = {
        fromSol: solPublicKey.toBase58(),
        toPow: w.addr,
        amount,
        sig: "phantom-"+Date.now()
      };

      const res = await fetchJSON("/bridge",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify(payload)
      });

      logLine("Bridge réponse: "+JSON.stringify(res));
      alert("Requête de bridge envoyée (voir log).");
      await syncPowWalletFromServer();
      await refreshStats();
    }catch(e){
      logLine("ERR bridge: "+e.message);
      alert("Erreur bridge (voir log).");
    }
  }

  // WebSocket
  function connectWs(){
    try{
      ws = new WebSocket(WS_URL);
    }catch(e){
      logLine("WS création échouée: "+e.message);
      setBackendStatus(!!lastHttpTime,false);
      return;
    }
    ws.onopen = ()=>{
      logLine("WebSocket connecté.");
      setBackendStatus(!!lastHttpTime,true);
    };
    ws.onclose = ()=>{
      logLine("WebSocket fermé. Reconnexion dans 3 s.");
      setBackendStatus(!!lastHttpTime,false);
      setTimeout(connectWs,3000);
    };
    ws.onerror = (e)=>{
      logLine("WS error: "+(e.message||"undefined"));
    };
    ws.onmessage = (msg)=>{
      try{
        const data = JSON.parse(msg.data);
        if (data.type==="welcome"){
          logLine("WS welcome, height="+data.height);
        }else if (data.type==="block"){
          logLine("Nouveau bloc height="+data.height);
          refreshStats();
          syncPowWalletFromServer();
        }else{
          logLine("WS msg: "+JSON.stringify(data));
        }
      }catch(e){
        logLine("WS parse error: "+e.message);
      }
    };
  }

  // Chart simple POW/USDC (placeholder)
  function drawChart(){
    const canvas = el("chart");
    const ctx = canvas.getContext("2d");
    const w = canvas.width = canvas.clientWidth;
    const h = canvas.height = canvas.clientHeight;
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle = "#22d3ee";
    ctx.lineWidth = 2;
    ctx.beginPath();
    const points = 30;
    for (let i=0;i<points;i++){
      const x = (i/(points-1))*w;
      const y = h - Math.pow(i/(points-1),1.4)*h*0.8 - h*0.1;
      if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }
    ctx.stroke();
  }

  // Boutons
  el("btnGenPow").onclick = ()=>{
    generatePowWallet();
    syncPowWalletFromServer();
  };
  el("btnReloadPow").onclick = syncPowWalletFromServer;
  el("btnConnectPhantom").onclick = connectPhantom;
  el("btnRefreshSol").onclick = refreshSolBalances;
  el("btnLoadBlocks").onclick = loadBlocks;
  el("btnClearLog").onclick = ()=>{logBox.value="";};
  el("btnBridge").onclick = doBridge;

  el("btnSend").onclick = async ()=>{
    try{
      const to = el("destPow").value.trim();
      const amount = Number(el("sendAmount").value.trim());
      if (!to || !Number.isFinite(amount) || amount<=0){
        alert("Remplis destinataire + montant.");
        return;
      }
      const tx = await signPowTx({type:"transfer",to,amount});
      if (!tx) return;
      const res = await sendPowTx(tx);
      logLine("TX transfer réponse: "+JSON.stringify(res));
      await syncPowWalletFromServer();
      await refreshStats();
    }catch(e){
      logLine("ERR send POW: "+e.message);
    }
  };

  el("btnStake").onclick = async ()=>{
    try{
      const amount = Number(el("stakeAmount").value.trim());
      if (!Number.isFinite(amount) || amount<=0){
        alert("Montant stake invalide.");
        return;
      }
      const tx = await signPowTx({type:"stake",amount});
      if (!tx) return;
      const res = await sendPowTx(tx);
      logLine("TX stake réponse: "+JSON.stringify(res));
      await syncPowWalletFromServer();
      await refreshStats();
    }catch(e){
      logLine("ERR stake: "+e.message);
    }
  };

  el("btnAddLp").onclick = async ()=>{
    try{
      const amountPow  = Number(el("lpPow").value.trim());
      const amountUsdc = Number(el("lpUsdc").value.trim());
      if (amountPow<=0 || amountUsdc<=0){
        alert("Montants LP invalides.");
        return;
      }
      const tx = await signPowTx({
        type:"add_lp",
        amountPow,
        amountUsdc
      });
      if (!tx) return;
      const res = await sendPowTx(tx);
      logLine("TX add_lp réponse: "+JSON.stringify(res));
      await syncPowWalletFromServer();
      await refreshStats();
    }catch(e){
      logLine("ERR add LP: "+e.message);
    }
  };

  // Init
  window.addEventListener("load",()=>{
    drawChart();
    const w = loadLocalWallet();
    if (w) updatePowBalancesView(w);
    refreshStats();
    syncPowWalletFromServer();
    connectWs();
    setInterval(refreshStats,30000);
    window.addEventListener("resize",drawChart);
  });
})();
</script>
</body>
</html>








#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/bbqfinance.fun/index.html"

echo "🔥 FIREINNERS — FIX DÉFINITIF Buffer Phantom (iOS + Desktop)"

# --- Vérification ---
if [ ! -f "$HTML" ]; then
  echo "❌ index.html introuvable"
  exit 1
fi

# --- Backup ---
BK="$HTML.bak.$(date +%s)"
cp -a "$HTML" "$BK"
echo "✅ Backup créé : $BK"

# --- Nettoyage anciens patchs Buffer ---
perl -0777 -i -pe 's@<script[^>]*>[^<]*Buffer[^<]*</script>@@gis' "$HTML"
perl -0777 -i -pe 's@<script[^>]*src=["'"'"']https?://bundle\.run/buffer[^"'"'"']*["'"'"'][^>]*></script>@@gis' "$HTML"
perl -0777 -i -pe 's@<script[^>]*src=["'"'"']https?://cdn\.jsdelivr\.net/npm/buffer[^"'"'"']*["'"'"'][^>]*></script>@@gis' "$HTML"

# --- Injection BUFFER OFFICIEL AVANT TOUT ---
perl -0777 -i -pe 's@<head([^>]*)>@<head$1>\n<!-- FIREINNERS BUFFER FIX (PHANTOM iOS SAFE) -->\n<script src="https://cdn.jsdelivr.net/npm/buffer@6.0.3/index.min.js"></script>\n<script>\n  if(typeof globalThis!=="undefined" && typeof globalThis.Buffer==="undefined"){\n    globalThis.Buffer = buffer.Buffer;\n  }\n</script>\n@is' "$HTML"

echo "✅ Buffer officiel injecté AVANT web3.js"

# --- Vérification ordre ---
echo "🔎 Ordre des scripts :"
grep -n "buffer@6.0.3" "$HTML" | head -1
grep -n "@solana/web3.js" "$HTML" | head -1

# --- Reload nginx ---
nginx -t
systemctl reload nginx
echo "✅ nginx reload OK"

echo "🎯 FIX TERMINÉ"
echo "👉 Phantom iOS + Bridge SOL maintenant fonctionnels"
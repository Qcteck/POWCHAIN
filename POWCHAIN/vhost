// FIREINNERS — serveur principal HTTP + WebSocket
// Ports : HTTP 3000 (API) / WS 7001 (broadcast état)

const fs = require("fs");
const path = require("path");
const http = require("http");
const express = require("express");
const cors = require("cors");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const naclUtil = require("tweetnacl-util");
const bs58 = require("bs58");

const PORT_HTTP = 3000;
const PORT_WS = 7001;
const DB_FILE = path.join(__dirname, "fireinners-db.json");

// ----------------- STATE -----------------

let state = {
  height: 1,
  wallets: {},          // addr -> {pub, priv, fire, usdc}
  treasuryFire: 0,
  treasuryUsdc: 0,
  tvlFire: 0,
  tvlUsdc: 0,
  lpFire: 0,
  lpUsdc: 0,
  supplyTotal: 1_000_000_000,
  lastId: 0,
  bridgeEvents: []
};

function loadState() {
  try {
    if (fs.existsSync(DB_FILE)) {
      const raw = fs.readFileSync(DB_FILE, "utf8");
      state = JSON.parse(raw);
      console.log("[FIREINNERS] État chargé.");
    } else {
      saveState();
      console.log("[FIREINNERS] Nouveau state créé.");
    }
  } catch (e) {
    console.error("Erreur loadState:", e);
  }
}

function saveState() {
  try {
    fs.writeFileSync(DB_FILE, JSON.stringify(state, null, 2));
  } catch (e) {
    console.error("Erreur saveState:", e);
  }
}

function nextId() {
  state.lastId += 1;
  return state.lastId;
}

// ----------------- WALLET LOCAL -----------------

function newWallet() {
  const kp = nacl.sign.keyPair();
  const pub58 = bs58.encode(Buffer.from(kp.publicKey));
  const priv58 = bs58.encode(Buffer.from(kp.secretKey));
  const addr = pub58; // pour FIREINNERS, adresse = pubkey base58
  state.wallets[addr] = {
    pub: pub58,
    priv: priv58,
    fire: 0,
    usdc: 0
  };
  saveState();
  return { address: addr, pub: pub58, priv: priv58 };
}

// ----------------- EXPRESS APP -----------------

const app = express();
app.use(cors());
app.use(express.json());

app.get("/stats", (req, res) => {
  res.json({
    ok: true,
    height: state.height,
    tvlFire: state.tvlFire,
    tvlUsdc: state.tvlUsdc,
    treasuryFire: state.treasuryFire,
    treasuryUsdc: state.treasuryUsdc,
    lpFire: state.lpFire,
    lpUsdc: state.lpUsdc,
    supplyTotal: state.supplyTotal
  });
});

app.post("/wallet/new", (req, res) => {
  const w = newWallet();
  console.log("[FIREINNERS] Nouveau wallet", w.address);
  broadcastState();
  res.json(w);
});

app.post("/lp/add", (req, res) => {
  const fire = Number(req.body.fire) || 0;
  const usdc = Number(req.body.usdc) || 0;
  if (fire <= 0 || usdc <= 0) {
    return res.status(400).json({ ok: false, error: "Montants invalides" });
  }
  state.lpFire += fire;
  state.lpUsdc += usdc;
  state.tvlFire += fire;
  state.tvlUsdc += usdc;
  const id = nextId();
  console.log(`[FIREINNERS] LP add id=${id} FIRE=${fire} USDC=${usdc}`);
  if (fire >= 10_000 && usdc >= 10_000) {
    console.log("[FIREINNERS] Session Whale détectée (LP élevé).");
  }
  saveState();
  broadcastState();
  res.json({ ok: true, id, lpFire: state.lpFire, lpUsdc: state.lpUsdc });
});

// Bridge SOL → FIREINNERS (enregistrement simple)
app.post("/bridge/sol", (req, res) => {
  const { from, amountSol, signature } = req.body || {};
  if (!from || !amountSol || amountSol <= 0) {
    return res.status(400).json({ ok: false, error: "Paramètres invalides" });
  }
  const id = nextId();
  state.bridgeEvents.push({
    id,
    from,
    amountSol: Number(amountSol),
    signature: signature || null,
    ts: Date.now()
  });
  // Ici tu peux ajouter la logique : créditer FIRE interne, etc.
  console.log(`[FIREINNERS] BRIDGE_REQUEST id=${id} from=${from} sol=${amountSol}`);
  saveState();
  broadcastState();
  res.json({ ok: true, id });
});

// simple endpoint chaînes (placeholder)
app.get("/chain", (req, res) => {
  res.json({ ok: true, height: state.height, blocks: [] });
});

// ----------------- HTTP & WS SERVERS -----------------

const server = http.createServer(app);

const wss = new WebSocket.Server({ server });

const allowedOrigins = [
  "https://bbqfinance.fun",
  "https://www.bbqfinance.fun",
  "http://bbqfinance.fun",
  "http://www.bbqfinance.fun",
  "http://localhost:3000",
  "http://127.0.0.1:3000"
];

wss.on("connection", (ws, req) => {
  const origin = req.headers.origin;
  if (origin && !allowedOrigins.includes(origin)) {
    console.log("[FIREINNERS] WS refusé (origin)", origin);
    ws.close();
    return;
  }
  console.log("[FIREINNERS] WS client connecté");

  ws.send(JSON.stringify({ type: "state", state }));

  ws.on("close", () => {
    console.log("[FIREINNERS] WS client déconnecté");
  });
});

function broadcastState() {
  const payload = JSON.stringify({ type: "state", state });
  wss.clients.forEach(c => {
    if (c.readyState === WebSocket.OPEN) c.send(payload);
  });
}

setInterval(() => {
  broadcastState();
}, 5000);

// ----------------- START -----------------

loadState();

server.listen(PORT_HTTP, () => {
  console.log(`[FIREINNERS] HTTP API sur port ${PORT_HTTP} (/stats /wallet /lp /bridge /chain)`);
  console.log(`[FIREINNERS] WebSocket sur port ${PORT_WS} (via Nginx /ws)`);
});

// WS pur si tu préfères HTTP + WS séparés (ici on réutilise le même serveur HTTP)
const wsServer = new WebSocket.Server({ port: PORT_WS });
wsServer.on("connection", (ws) => {
  console.log("[FIREINNERS] WS direct 7001 connecté");
  ws.send(JSON.stringify({ type: "state", state }));
  ws.on("close", () => console.log("[FIREINNERS] WS direct 7001 déconnecté"));
});


















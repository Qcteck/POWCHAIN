// =========================
// ECONOMIE FIREINNERS / POWCHAIN
// =========================

const DEC = 1e6;                           // 6 décimales pour POW / USDC POW
const SUPPLY_MAX = 100_000_000 * DEC;      // Hard cap 100M POW

// Taux dynamique POW/SOL (borne, dépend de la TVL)
const RATE_BASE = 1000;                    // POW par SOL de base
const TVL_REF = 1_000_000 * DEC;           // 1M USDC POW de référence
const RATE_MIN = 800;
the RATE_MAX = 5000;

// Frais (basis points : 1% = 100 bp)
const FEE_TRANSFER_BURN_BP = 50;   // 0.5% burn sur transfert POW
const FEE_SWAP_TOTAL_BP = 30;      // 0.3% total fees swap
const FEE_SWAP_BURN_PART = 0.5;    // 50% des fees swap brûlés
const FEE_BRIDGE_IN_TREAS_BP = 500; // 5% vers trésorerie sur bridge in
const FEE_BRIDGE_IN_BURN_BP = 200;  // 2% burn sur bridge in
const FEE_BRIDGE_OUT_BURN_BP = 1000; // 10% burn sur bridge out
const FEE_UNSTAKE_BURN_BP = 300;    // 3% burn si unstake anticipé

const STAKE_MIN_LOCK_MS = 30 * 24 * 60 * 60 * 1000; // 30 jours

// -------------------------
// ETAT GLOBAL
// -------------------------

let wallets = {};  // addr -> { pow, usdc, staked, pub, nonce, stakeLock }
let treasury = { pow: 0, usdc: 0, sol: 0 };
let lp = { pow: 0, usdc: 0 };

let supplyCirculante = 0;
let mintedPowTotal = 0;
let burnedPowTotal = 0;

let chain = [];
let processedBridgeSigs = new Set();    // pour anti-cheat bridge in
let bridgeOutRequests = [];             // queue de demandes POW->SOL

// GENESIS
(function initGenesis() {
  const genesisSupply = 100_000_000 * DEC;
  supplyCirculante = genesisSupply;
  mintedPowTotal = genesisSupply;
  treasury.pow = genesisSupply;

  const genesis = {
    height: 1,
    time: Date.now(),
    prevHash: "0".repeat(64),
    hash: "GENESIS",
    txs: [],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  };
  chain.push(genesis);
})();

// =========================
// OUTILS COMMUNS
// =========================

function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = {
      pow: 0,
      usdc: 0,
      staked: 0,
      pub: addr,
      nonce: 0,
      stakeLock: 0
    };
  }
  return wallets[addr];
}

function clamp(x, min, max) {
  return x < min ? min : x > max ? max : x;
}

function applyBp(amount, bp) {
  return Math.floor(amount * bp / 10000);
}

// TVL totale en USDC POW (LP + Trésorerie)
function getTVL() {
  const lpUsdc = lp.usdc || 0;
  const treUsdc = treasury.usdc || 0;
  return lpUsdc + treUsdc;
}

// Taux POW / SOL dynamique (borné)
function getPowRatePowPerSol() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || DEC);
  const rawRate = RATE_BASE * factor;
  const rate = clamp(rawRate, RATE_MIN, RATE_MAX);
  return rate;
}

// Prix LP USDC/POW
function getLpPrice() {
  if (lp.pow <= 0 || lp.usdc <= 0) return 0;
  return lp.usdc / lp.pow;
}

function burnPow(amount) {
  if (!amount || amount <= 0) return 0;
  const actual = Math.min(amount, supplyCirculante);
  burnedPowTotal += actual;
  supplyCirculante -= actual;
  return actual;
}

function mintPow(amount) {
  if (!amount || amount <= 0) return 0;
  const spaceLeft = SUPPLY_MAX - supplyCirculante;
  const mintable = Math.max(0, Math.min(amount, spaceLeft));
  mintedPowTotal += mintable;
  supplyCirculante += mintable;
  return mintable;
}

function addPow(addr, amount) {
  const w = ensureWallet(addr);
  w.pow += amount;
}
function subPow(addr, amount) {
  const w = ensureWallet(addr);
  if (w.pow < amount) throw new Error("Solde POW insuffisant");
  w.pow -= amount;
}
function addUsdc(addr, amount) {
  const w = ensureWallet(addr);
  w.usdc += amount;
}
function subUsdc(addr, amount) {
  const w = ensureWallet(addr);
  if (w.usdc < amount) throw new Error("Solde USDC POW insuffisant");
  w.usdc -= amount;
}

// =========================
// CREATION DE BLOCS
// =========================

function appendBlock(txEvents) {
  const prev = chain[chain.length - 1];
  const block = {
    height: prev.height + 1,
    time: Date.now(),
    prevHash: prev.hash,
    txs: txEvents,
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  };
  block.hash = crypto
    .createHash("sha256")
    .update(JSON.stringify(block))
    .digest("hex");
  chain.push(block);
  broadcast({ type: "CHAIN_HEAD", block });
  return block;
}

// =========================
// HANDLERS ECONOMIQUES
// =========================

// 1) TRANSFERT POW
function processPowTransfer(tx) {
  if (!tx.from || !tx.to) throw new Error("from/to manquant");
  if (!tx.amount || tx.amount <= 0) throw new Error("amount invalide");

  const gross = tx.amount;
  const feeBurn = applyBp(gross, FEE_TRANSFER_BURN_BP);
  const sendAmount = gross - feeBurn;
  if (sendAmount <= 0) throw new Error("montant après burn insuffisant");

  subPow(tx.from, gross);
  addPow(tx.to, sendAmount);
  const burned = burnPow(feeBurn);

  return {
    kind: "POW_TRANSFER",
    from: tx.from,
    to: tx.to,
    gross,
    sendAmount,
    burned
  };
}

// 2) SWAP POW / USDC POW
function processSwap(tx) {
  const { addr, amount, direction } = tx; // direction: "pow2usdc" ou "usdc2pow"
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");
  if (!lp.pow || !lp.usdc) throw new Error("pool LP vide");
  if (direction !== "pow2usdc" && direction !== "usdc2pow") {
    throw new Error("direction swap invalide");
  }

  const feeTotal = applyBp(amount, FEE_SWAP_TOTAL_BP);
  const amountNet = amount - feeTotal;
  if (amountNet <= 0) throw new Error("amount net swap invalide");

  const feeBurn = Math.floor(feeTotal * FEE_SWAP_BURN_PART);
  const feeTreas = feeTotal - feeBurn;

  if (direction === "pow2usdc") {
    subPow(addr, amount);
    lp.pow += amountNet;

    const k = lp.pow * lp.usdc;
    const newPow = lp.pow;
    const newUsdc = Math.floor(k / newPow);
    const deltaUsdc = lp.usdc - newUsdc;
    if (deltaUsdc <= 0) throw new Error("delta usdc invalide");
    lp.usdc = newUsdc;

    addUsdc(addr, deltaUsdc);

    const burned = burnPow(feeBurn);
    treasury.pow += feeTreas;
    supplyCirculante += feeTreas;

    return {
      kind: "SWAP",
      dir: "pow2usdc",
      inPow: amount,
      outUsdc: deltaUsdc,
      feeBurn: burned,
      feeTreasPow: feeTreas
    };
  } else {
    subUsdc(addr, amount);
    lp.usdc += amountNet;

    const k = lp.pow * lp.usdc;
    const newUsdc = lp.usdc;
    const newPow = Math.floor(k / newUsdc);
    const deltaPow = lp.pow - newPow;
    if (deltaPow <= 0) throw new Error("delta pow invalide");
    lp.pow = newPow;

    addPow(addr, deltaPow);

    const burned = burnPow(feeBurn);
    treasury.usdc += feeTreas;

    return {
      kind: "SWAP",
      dir: "usdc2pow",
      inUsdc: amount,
      outPow: deltaPow,
      feeBurn: burned,
      feeTreasUsdc: feeTreas
    };
  }
}

// 3) LP ADD
function processLPAdd(tx) {
  const { addr, pow, usdc } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!pow || pow <= 0 || !usdc || usdc <= 0) {
    throw new Error("valeurs LP invalides");
  }
  subPow(addr, pow);
  subUsdc(addr, usdc);
  lp.pow += pow;
  lp.usdc += usdc;
  return { kind: "LP_ADD", addr, pow, usdc };
}

// 4) BRIDGE SOL -> FIREINNERS (via RPC Solana)
async function processBridgeInRPC(powAddress, solAddress, amountSol, txSig) {
  if (!powAddress || !solAddress || !amountSol || !txSig) {
    throw new Error("paramètres bridge incomplets");
  }
  if (processedBridgeSigs.has(txSig)) {
    throw new Error("txSig déjà utilisée (anti-cheat)");
  }

  const lamportsExpected = Math.round(amountSol * 1e9);

  // Appel RPC Solana
  const payload = {
    jsonrpc: "2.0",
    id: 1,
    method: "getTransaction",
    params: [txSig, { encoding: "jsonParsed", commitment: "confirmed" }]
  };

  const res = await fetch(SOL_RPC, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify(payload)
  });

  if (!res.ok) throw new Error("RPC Solana HTTP error");
  const json = await res.json();
  const value = json.result && json.result.value;
  if (!value || value.meta?.err) {
    throw new Error("Transaction Solana invalide ou non confirmée");
  }

  const keys = value.transaction.message.accountKeys.map(k =>
    typeof k === "string" ? k : k.pubkey
  );
  const pre = value.meta.preBalances || [];
  const post = value.meta.postBalances || [];

  const idxFrom = keys.indexOf(solAddress);
  const idxTreas = keys.indexOf(SOL_TREASURY);
  if (idxFrom === -1 || idxTreas === -1) {
    throw new Error("Les comptes attendus ne sont pas dans la TX");
  }

  const deltaFrom = pre[idxFrom] - post[idxFrom];   // ce que l'utilisateur a perdu
  const deltaTreas = post[idxTreas] - pre[idxTreas]; // ce que la trésorerie a gagné

  if (deltaFrom <= 0 || deltaTreas <= 0) {
    throw new Error("Deltas SOL invalides");
  }
  if (deltaFrom < lamportsExpected * 0.95) {
    throw new Error("Montant SOL envoyé trop faible");
  }

  processedBridgeSigs.add(txSig);

  const solAmountReal = deltaTreas / 1e9;
  const rate = getPowRatePowPerSol();
  const powBrut = Math.floor(solAmountReal * rate * DEC);

  const powToMint = mintPow(powBrut);
  if (powToMint <= 0) throw new Error("Supply max atteint");

  const feeTreas = applyBp(powToMint, FEE_BRIDGE_IN_TREAS_BP);
  const feeBurn = applyBp(powToMint, FEE_BRIDGE_IN_BURN_BP);
  const userPow = powToMint - feeTreas - feeBurn;
  if (userPow <= 0) throw new Error("Net POW <= 0");

  treasury.pow += feeTreas;
  const burned = burnPow(feeBurn);
  addPow(powAddress, userPow);

  treasury.sol += solAmountReal;

  return {
    kind: "BRIDGE_IN",
    powAddress,
    solAddress,
    txSig,
    solAmount: solAmountReal,
    rate,
    powMinted: powToMint,
    userPow,
    feeTreasPow: feeTreas,
    burnedPow: burned
  };
}

// 5) BRIDGE POW -> SOL (enregistre une demande, brûle le POW)
function processBridgeOut(tx) {
  const { addr, powAmount, solDestination } = tx;
  if (!addr || !powAmount || powAmount <= 0 || !solDestination) {
    throw new Error("Paramètres BRIDGE_OUT invalides");
  }

  const rate = getPowRatePowPerSol();
  subPow(addr, powAmount);

  const feeBurn = applyBp(powAmount, FEE_BRIDGE_OUT_BURN_BP);
  const powNet = powAmount - feeBurn;
  if (powNet <= 0) throw new Error("bridge out net <= 0");

  const burned = burnPow(powAmount);
  const solOut = powNet / (rate * DEC);

  if (treasury.sol < solOut) {
    // On enregistre quand même la demande, payout manuel
    console.warn("Trésorerie SOL insuffisante, bridge-out en attente");
  } else {
    treasury.sol -= solOut;
  }

  const req = {
    id: bridgeOutRequests.length + 1,
    time: Date.now(),
    addr,
    solDestination,
    powSent: powAmount,
    powNet,
    burnedPow: burned,
    rate,
    solOut,
    status: treasury.sol >= solOut ? "payout_possible" : "pending_treasury"
  };
  bridgeOutRequests.push(req);

  return {
    kind: "BRIDGE_OUT",
    ...req
  };
}

// 6) STAKING
function processStake(tx) {
  const { addr, amount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");

  const w = ensureWallet(addr);
  if (w.pow < amount) throw new Error("solde POW insuffisant");

  w.pow -= amount;
  w.staked += amount;
  w.stakeLock = Date.now() + STAKE_MIN_LOCK_MS;

  return {
    kind: "STAKE",
    addr,
    amount,
    lockUntil: w.stakeLock
  };
}

function processUnstake(tx) {
  const { addr, amount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");

  const w = ensureWallet(addr);
  if (w.staked < amount) throw new Error("solde staké insuffisant");

  w.staked -= amount;
  let returned = amount;
  let burned = 0;

  if (Date.now() < (w.stakeLock || 0)) {
    const feeBurn = applyBp(amount, FEE_UNSTAKE_BURN_BP);
    burned = burnPow(feeBurn);
    returned = amount - burned;
    if (returned < 0) returned = 0;
  }

  w.pow += returned;

  return {
    kind: "UNSTAKE",
    addr,
    amount,
    returned,
    burned,
    early: Date.now() < (w.stakeLock || 0)
  };
}

// =========================
// VERIFICATION SIGNATURE POWCHAIN
// =========================

function verifyPowchainSignature(tx, sig) {
  if (!tx || !sig) return false;
  if (!tx.pub || !tx.from) return false;

  const msg = {
    type: tx.type,
    from: tx.from,
    to: tx.to ?? null,
    amount: tx.amount ?? null,
    token: tx.token ?? null,
    nonce: tx.nonce
  };
  const msgBytes = new TextEncoder().encode(JSON.stringify(msg));
  const pubBytes = bs58.decode(tx.pub);
  const sigBytes = bs58.decode(sig);

  return nacl.sign.detached.verify(msgBytes, sigBytes, pubBytes);
}

function applyEconomicTx(tx) {
  switch (tx.type) {
    case "POW_TRANSFER":
      return processPowTransfer(tx);
    case "SWAP":
      return processSwap(tx);
    case "LP_ADD":
      return processLPAdd(tx);
    case "BRIDGE_OUT":
      return processBridgeOut(tx);
    case "STAKE":
      return processStake(tx);
    case "UNSTAKE":
      return processUnstake(tx);
    default:
      throw new Error("type TX inconnu: " + tx.type);
  }
}


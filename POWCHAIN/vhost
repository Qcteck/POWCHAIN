<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>🔥 Fireinners</title>
<style>
body{
  margin:0;
  font-family:system-ui,Segoe UI,sans-serif;
  background:#0a0a0f;
  color:#eee;
  transition:0.3s;
}
body.light{background:#fafafa;color:#111;}

#topTicker,#rssTicker{
  width:100%;
  white-space:nowrap;
  overflow:hidden;
  border-bottom:1px solid #333;
  padding:6px 0;
  font-size:14px;
  background:#09000a;
}
body.light #topTicker,body.light #rssTicker{
  background:#fff4e5;
  border-color:#e1c3a0;
}
.tickerInner{
  display:inline-block;
  animation:scroll 25s linear infinite;
}
@keyframes scroll{
  from{transform:translateX(100%);}
  to{transform:translateX(-100%);}
}

#app{
  display:flex;
  height:calc(100vh - 64px);
  width:100vw;
}
#side{
  width:220px;
  background:#100008;
  border-right:1px solid #311;
  box-shadow:6px 0 20px #000;
  padding:20px 10px;
}
body.light #side{
  background:#fff4e5;
  border-color:#e1c3a0;
}
#side h2{margin:0 0 10px;color:#ffbbbb;}

.nav{
  display:block;
  padding:10px 12px;
  margin-bottom:8px;
  border-radius:10px;
  cursor:pointer;
  background:#1a000d;
  color:#ffdede;
  font-size:14px;
}
.nav:hover{background:#330018;}
.nav.active{
  background:#ff3c00;
  color:#fff;
}

#main{
  flex:1;
  display:flex;
  flex-direction:column;
}

#topBar{
  padding:10px 16px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:1px solid #222;
  background:#050309;
}
body.light #topBar{
  background:#fff;
  border-color:#ddd;
}
#wsState{
  padding:6px 10px;
  font-size:12px;
  border-radius:50px;
  border:1px solid #444;
  display:inline-block;
}
#visitors{font-size:13px;margin-top:4px;}

.section{display:none;padding:20px;overflow:auto;}
.section.active{display:block;}

.card{
  background:#12000a;
  border:1px solid #331;
  padding:14px;
  border-radius:12px;
  margin-bottom:18px;
}
body.light .card{
  background:#ffe9d6;
  border-color:#e1c3a0;
}
label{
  display:block;
  font-size:13px;
  margin-top:4px;
}
input,button{
  width:100%;
  padding:8px 10px;
  margin-top:4px;
  border-radius:8px;
  border:1px solid #444;
  background:#0d0d12;
  color:#eee;
  box-sizing:border-box;
}
body.light input,body.light button{
  background:#fff;
  color:#111;
  border-color:#ccc;
}
button{
  background:#ff3c00;
  border-color:#ff9a2f;
  font-weight:600;
  cursor:pointer;
}
button:hover{filter:brightness(1.08);}

#qrBox{
  width:130px;
  height:130px;
  background:#fff;
  margin:10px 0;
  display:flex;
  justify-content:center;
  align-items:center;
  border-radius:8px;
}
#browserFrame{
  width:100%;
  height:65vh;
  border:0;
  border-radius:12px;
  background:#000;
}
pre{white-space:pre-wrap;font-size:13px;}
</style>
</head>
<body>

<!-- BANNIÈRE PRIX CRYPTO -->
<div id="topTicker"><div id="cryptoTicker" class="tickerInner">Chargement prix…</div></div>

<!-- BANNIÈRE RSS CRYPTO -->
<div id="rssTicker"><div id="rssInner" class="tickerInner">Chargement actualités…</div></div>

<div id="app">
  <!-- SIDEBAR -->
  <aside id="side">
    <h2>🔥 Fireinners</h2>
    <div id="visitors">Visiteurs: 0</div>

    <div class="nav active" data-tab="wallet">Wallet</div>
    <div class="nav" data-tab="bridge">Bridge</div>
    <div class="nav" data-tab="browser">FIREBROWSER</div>
    <div class="nav" data-tab="stats">Stats</div>

    <button id="btnTheme" style="margin-top:12px;">Mode Light/Dark</button>
  </aside>

  <!-- MAIN -->
  <main id="main">
    <div id="topBar">
      <div>WebSocket: <span id="wsState">Offline</span></div>
      <div style="font-size:13px;opacity:.8;">🔥 Panel Fireinners</div>
    </div>

    <!-- WALLET -->
    <section class="section active" id="wallet">
      <div class="card">
        <h3>Wallet Phantom (Solana)</h3>
        <button id="btnPhantom">Connecter Phantom</button>
        <label>Adresse Solana</label><input id="solAddr" readonly>
        <label>SOL</label><input id="solBal" readonly>
        <label>USDC</label><input id="usdcBal" readonly>
      </div>

      <div class="card">
        <h3>Wallet Fireinners (local)</h3>
        <button id="btnGen">Générer wallet Fireinners</button>
        <button id="btnReloadFI">Recharger depuis backend</button>

        <label>Adresse Fireinners</label><input id="fiAddr" readonly>
        <label>Clé privée (sauvegarde-la)</label><input id="fiPriv" readonly>

        <div id="qrBox"><canvas id="qr" width="120" height="120"></canvas></div>

        <label>Solde FIRE</label><input id="fiBal" readonly>
        <label>Solde USDC FIRE</label><input id="fiUSDC" readonly>
      </div>
    </section>

    <!-- BRIDGE -->
    <section class="section" id="bridge">
      <div class="card">
        <h3>Bridge SOL → Fireinners (via Phantom)</h3>
        <label>Montant SOL</label>
        <input id="bridgeAmt" placeholder="ex: 0.01">
        <button id="btnBridge">Bridge via Phantom</button>
        <p style="font-size:12px;opacity:.8;">
          1) Phantom envoie le SOL vers la trésorerie.<br>
          2) Le backend vérifie la transaction sur Solana et crédite FIRE si OK.
        </p>
      </div>
    </section>

    <!-- FIREBROWSER -->
    <section class="section" id="browser">
      <div class="card">
        <h3>FIREBROWSER sécurisé</h3>
        <label>URL</label>
        <input id="browserUrl" placeholder="https://example.com">
        <button id="btnOpenBrowser">Ouvrir</button>
        <iframe id="browserFrame"></iframe>
      </div>
    </section>

    <!-- STATS -->
    <section class="section" id="stats">
      <div class="card">
        <h3>Stats Fireinners (HTTP /stats)</h3>
        <pre id="statsOut">Chargement…</pre>
      </div>
    </section>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script>
// ------------ CONFIG ------------
const API="https://bbqfinance.fun";
const WS_URL="wss://bbqfinance.fun/ws";
const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const DEC=1e6;

// ------------ HELPERS ------------
const $ = id => document.getElementById(id);

// DOM refs
const solAddrInput = $("solAddr");
const solBalInput  = $("solBal");
const usdcBalInput = $("usdcBal");
const fiAddrInput  = $("fiAddr");
const fiPrivInput  = $("fiPriv");
const fiBalInput   = $("fiBal");
const fiUSDCInput  = $("fiUSDC");
const wsStateSpan  = $("wsState");
const visitorsSpan = $("visitors");
const statsOut     = $("statsOut");

// state
let solAddr=null;
let fiAddr=null;
let fiPriv=null;
let sock=null;

// ------------ TICKER PRIX ------------
async function loadPrices(){
  try{
    const ids="bitcoin,ethereum,solana,sui";
    const r=await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=usd`);
    const j=await r.json();
    const fire="TBD";
    cryptoTicker.innerHTML=
      `₿ BTC $${j.bitcoin.usd}  |  Ξ ETH $${j.ethereum.usd}  |  ◎ SOL $${j.solana.usd}  |  SUI $${j.sui.usd}  |  🔥 FIRE: ${fire}`;
  }catch(e){
    cryptoTicker.innerHTML="Ticker prix indisponible.";
  }
}
setInterval(loadPrices,20000);
loadPrices();

// ------------ TICKER RSS ------------
async function loadRSS(){
  try{
    const r=await fetch("https://cryptonews-api.com/api/v1/category?section=general&items=20&token=demo");
    const j=await r.json();
    const titles=(j.data||[]).slice(0,10).map(n=>n.title);
    rssInner.innerHTML=titles.join(" • ");
  }catch(e){
    rssInner.innerHTML="Actus crypto indisponibles.";
  }
}
setInterval(loadRSS,120000);
loadRSS();

// ------------ QR CODE ------------
function drawQR(text){
  const cv=$("qr");
  const ctx=cv.getContext("2d");
  const s=cv.width;
  ctx.fillStyle="#fff";
  ctx.fillRect(0,0,s,s);
  if(!text)return;

  let hash=[...text].reduce((a,c)=>(a*31+c.charCodeAt(0))>>>0,1);
  let size=25,cell=s/size;
  ctx.fillStyle="#000";
  let rnd=hash;
  for(let y=0;y<size;y++){
    for(let x=0;x<size;x++){
      rnd=(rnd*1103515245+12345)>>>0;
      if(rnd&0x80000000) ctx.fillRect(x*cell,y*cell,cell,cell);
    }
  }
}

// ------------ BASE58 ----------
const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function b58enc(bytes){
  let d=[0];
  for(let i=0;i<bytes.length;i++){
    let c=bytes[i];
    for(let j=0;j<d.length;j++){
      let x=d[j]*256+c;
      d[j]=x%58;
      c=(x/58)|0;
    }
    while(c>0){d.push(c%58);c=(c/58)|0;}
  }
  let r="";
  for(let k=d.length-1;k>=0;k--) r+=ALPH[d[k]];
  return r;
}

// ------------ WALLET FIREINNERS LOCAL ------------
$("btnGen").onclick=()=>{
  const kp=nacl.sign.keyPair();
  fiAddr=b58enc(kp.publicKey);
  fiPriv=b58enc(kp.secretKey);
  fiAddrInput.value=fiAddr;
  fiPrivInput.value=fiPriv;
  drawQR(fiAddr);
  fiBalInput.value="0";
  fiUSDCInput.value="0";
};

// Recharger depuis backend /wallet/:addr
$("btnReloadFI").onclick=async()=>{
  if(!fiAddr){
    alert("Génère d'abord un wallet Fireinners.");
    return;
  }
  try{
    const r=await fetch(`${API}/wallet/${fiAddr}`);
    const w=await r.json();
    fiBalInput.value=(w.fire/DEC).toFixed(6);
    fiUSDCInput.value=(w.usdc/DEC).toFixed(6);
  }catch(e){
    alert("Erreur load wallet: "+e.message);
  }
};

// ------------ PHANTOM ------------
$("btnPhantom").onclick=async()=>{
  try{
    const p=window.solana;
    if(!p||!p.isPhantom){alert("Phantom non détecté.");return;}
    const resp=await p.connect();
    solAddr=resp.publicKey.toString();
    solAddrInput.value=solAddr;
    await loadSolBalances();
  }catch(e){
    alert("Erreur Phantom: "+e.message);
  }
};

async function loadSolBalances(){
  if(!solAddr)return;
  try{
    let r=await fetch(SOL_RPC,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]})
    });
    let j=await r.json();
    solBalInput.value=(j.result.value/1e9).toFixed(4);

    let r2=await fetch(SOL_RPC,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        jsonrpc:"2.0",
        id:2,
        method:"getTokenAccountsByOwner",
        params:[solAddr,{mint:USDC_MINT},{encoding:"jsonParsed"}]
      })
    });
    let j2=await r2.json();
    let tot=0;
    (j2.result.value||[]).forEach(a=>{
      tot+=a.account.data.parsed.info.tokenAmount.uiAmount;
    });
    usdcBalInput.value=tot.toFixed(2);
  }catch(e){
    console.error(e);
  }
}

// ------------ BRIDGE via Phantom ------------
$("btnBridge").onclick=async()=>{
  if(!solAddr||!fiAddr){
    alert("Connecte Phantom et génère un wallet Fireinners.");
    return;
  }
  const raw=$("bridgeAmt").value;
  const amt=parseFloat(raw);
  if(!(amt>0)){alert("Montant invalide.");return;}

  try{
    const p=window.solana;
    const tx=await p.request({
      method:"transfer",
      params:{ to:"BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy", amount:Math.floor(amt*1e9) }
    });
    const sig=tx.signature;

    const r=await fetch(`${API}/bridge`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        addr:fiAddr,
        amount:amt,
        fromSol:solAddr,
        txSig:sig
      })
    });
    const j=await r.json();
    alert("Bridge: "+JSON.stringify(j,null,2));
    // Recharge le wallet si succès
    if(j.ok) $("btnReloadFI").click();
  }catch(e){
    alert("Erreur bridge: "+e);
  }
};

// ------------ FIREBROWSER ------------
$("btnOpenBrowser").onclick=()=>{
  let u=$("browserUrl").value.trim();
  if(!u) return;
  if(!u.startsWith("http")) u="https://"+u;
  $("browserFrame").src=u;
};

// ------------ NAVIGATION ------------
document.querySelectorAll(".nav").forEach(el=>{
  el.onclick=()=>{
    document.querySelectorAll(".nav").forEach(n=>n.classList.remove("active"));
    el.classList.add("active");
    const tab=el.dataset.tab;
    document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
    document.getElementById(tab).classList.add("active");
  };
});

// ------------ WS (visiteurs) ------------
function connectWS(){
  try{
    sock=new WebSocket(WS_URL);
    sock.onopen=()=>{
      wsStateSpan.textContent="Online";
      wsStateSpan.style.color="#7f7";
    };
    sock.onclose=()=>{
      wsStateSpan.textContent="Offline";
      wsStateSpan.style.color="#f77";
      setTimeout(connectWS,3000);
    };
    sock.onerror=()=>{
      wsStateSpan.textContent="Erreur";
      wsStateSpan.style.color="#ff0";
    };
    sock.onmessage=e=>{
      try{
        const m=JSON.parse(e.data);
        if(m.type==="clients"){
          visitorsSpan.textContent="Visiteurs: "+m.count;
        }
      }catch{}
    };
  }catch(e){
    console.error(e);
  }
}
connectWS();

// ------------ STATS (HTTP /stats) ------------
async function refreshStats(){
  try{
    const r=await fetch(`${API}/stats`);
    const s=await r.json();
    statsOut.textContent=JSON.stringify(s,null,2);
  }catch(e){
    statsOut.textContent="Erreur stats: "+e.message;
  }
}
setInterval(refreshStats,5000);
refreshStats();

// ------------ THEME ------------
$("btnTheme").onclick=()=>{
  document.body.classList.toggle("light");
};
</script>
</body>
</html>






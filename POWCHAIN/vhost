function connectWS(){
  try{
    if(sock)sock.close();
    sock=new WebSocket(WS_URL);
    sock.onopen=()=>{
      q("#syncState").textContent="WS: online";
      q("#syncState").style.borderColor="#5bffbf";
      q("#syncState").style.color="#dfffee";
      log("WS connecté");

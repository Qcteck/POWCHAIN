vN_diag(rho){let s=0;for(let i=0;i<rho.length;i++){const p=Math.max(0,rho[i][i].r);if(p>1e-9)s+=-p*Math.log(p)}return s}const LN3=Math.log(3);function mkRhoM(scores){const v=[scores.HOLD||0,scores.BUY||0,scores.SELL||0];let sum=v[0]+v[1]+v[2];if(sum<=0)sum=1;const p0=v[0]/sum,p1=v[1]/sum,p2=v[2]/sum;return[[C(p0),C(0),C(0)],[C(0),C(p1),C(0)],[C(0),C(0),C(p2)]]}function purM(r){let p=0;for(let i=0;i<3;i++){const x=r[i][i].r;p+=x*x}return p}let purPrev=null;function Jm(r){const p=purM(r);const j=purPrev===null?0:(p-purPrev);purPrev=p;return j}const Q3={rhoM:null,rhoB:null,eta:0.08};function initBot(){Q3.rhoB=[[C(0),C(0),C(0)],[C(0),C(1),C(0)],[C(0),C(0),C(0)]]}initBot();function botAgg(){return Math.max(0,Math.min(1,Q3.rhoB[2][2].r))}function botEntropy(){const S=SvN_diag(Q3.rhoB);const cohB=Math.max(0,Math.min(1,1-S/LN3));return{S,cohB}}function updateBotAfterResult(R){const eta=Q3.eta;let P=R>0?[[C(0),C(0),C(0)],[C(0),C(0),C(0)],[C(0),C(0),C(1)]]:[[C(1),C(0),C(0)],[C(0),C(0),C(0)],[C(0),C(0),C(0)]];for(let i=0;i<3;i++)for(let j=0;j<3;j++)Q3.rhoB[i][j]=add(sc(Q3.rhoB[i][j],1-eta),sc(P[i][j],eta))}function sessionRiskRemaining(){const dd=Math.max(0,SESSION_PNL0-Engine.pnl);return Math.max(0,SESSION_BUDGET-dd)}function internalBudgetFromEntropy(){const e=botEntropy();const Bint=SESSION_BUDGET*e.cohB;return{Bint,cohB:e.cohB,S:e.S}}function renderQ(){if(!Q3.rhoM||!Q3.rhoB)return;const dm=[Q3.rhoM[0][0].r,Q3.rhoM[1][1].r,Q3.rhoM[2][2].r].map(x=>x.toFixed(3)).join(",");const db=[Q3.rhoB[0][0].r,Q3.rhoB[1][1].r,Q3.rhoB[2][2].r].map(x=>x.toFixed(3)).join(",");$("rhom").textContent="["+dm+"]";$("rhob").textContent="["+db+"]";const e=botEntropy();$("svn").textContent=e.S.toFixed(4);$("cohb").textContent=e.cohB.toFixed(3);$("agg").textContent=botAgg().toFixed(3)}function renderSessionUI(){const dd=Math.max(0,SESSION_PNL0-Engine.pnl);const pnlS=Engine.pnl-SESSION_PNL0;const riskLeft=Math.max(0,SESSION_BUDGET-dd);$("sb").textContent=SESSION_BUDGET?SESSION_BUDGET.toFixed(1):"-";$("spnl").textContent=SESSION_ON?pnlS.toFixed(4):"-";$("spnl").className=(SESSION_ON?(pnlS>=0?"ok":"bad"):"");$("sdd").textContent=SESSION_ON?dd.toFixed(4):"-";$("srl").textContent=SESSION_ON?riskLeft.toFixed(4):"-";$("srl").className=(SESSION_ON?(riskLeft>0?"ok":"bad"):"");if(Q3?.rhoB){const c=Math.max(0,Q3.rhoB[0][0].r),n=Math.max(0,Q3.rhoB[1][1].r),a=Math.max(0,Q3.rhoB[2][2].r);const s=c+n+a||1;$("bcna").textContent=`C:${(100*c/s).toFixed(0)}% N:${(100*n/s).toFixed(0)}% A:${(100*a/s).toFixed(0)}%`}else $("bcna").textContent="-"}function tauMarketFromPur(p){return 1500+Math.pow(1-p,2)*20000}async function dexMarket(m){const r=await fetch("/dex/tokens/"+m,{cache:"no-store"});if(!r.ok)return null;const j=await r.json();const p=j?.pairs?.[0];if(!p)return null;const px=Number(p.priceUsd||0);const ch=Number(p?.priceChange?.h24??0)/100;const vol=cl(Number(p?.volatility?.h24??50)/100);return{px,ch,vol}}function levels(price,vol){const atr=Math.max(price*0.02,price*vol*0.6);const SL=price-atr*1.1,TP1=price+atr*0.9,TP2=price+atr*1.6,TP3=price+atr*2.4;const RR=(TP3-price)/Math.max(1e-9,price-SL);return{entry:price,SL,TP1,TP2,TP3,RR}}function sigFrom(m){const draw=m.ch*100,rr=1+Math.min(3,6*Math.abs(m.ch)),v=m.vol,t=Math.max(-1,Math.min(1,5*m.ch));return{draw,rr,v,t}}function calcQ_scores(sig){const buy=cl((sig.draw<=-8&&sig.draw>=-15?0.55:0)+(cl((sig.rr-1)/3))*0.20+(cl(1-sig.v))*0.15+(cl(sig.t))*0.10);const sell=cl((sig.draw>=6&&sig.draw<=12?0.55:0)+(cl((sig.rr-1)/3))*0.15+(cl(sig.v))*0.20+(cl(-sig.t))*0.10);let hold=cl(1-(buy+sell));const s=buy+hold+sell||1;return{BUY:buy/s,HOLD:hold/s,SELL:sell/s}}function armProbFromRhoM(rhoM){return Math.max(0,Math.min(1,rhoM[0][0].r+rhoM[1][1].r))}const Engine={open:false,entry:0,mint:null,levels:null,h:{tp1:0,tp2:0,tp3:0,sl:0},pnl:0,sz:1,lastHit:"-",update(px){if(!this.open||!this.levels)return;const L=this.levels;if(px<=L.SL)this.hit("sl",px);else if(px>=L.TP3)this.hit("tp3",px);else if(px>=L.TP2)this.hit("tp2",px);else if(px>=L.TP1)this.hit("tp1",px)},hit(t,px){const e=this.entry;const r=(px-e)/Math.max(1e-9,e);this.pnl+=r*this.sz;this.h[t]++;this.lastHit=t.toUpperCase();this.open=false;this.entry=0;this.levels=null;histPush(K.NH,this.pnl,240);updateBotAfterResult(r);L("HIT "+this.lastHit+" r="+(r*100).toFixed(2)+"% pnl="+this.pnl.toFixed(4)+" botUpdated")}};async function ensureConn(){return cn||(cn=new solanaWeb3.Connection(RPC,{commitment:"confirmed"})),cn}async function readBalances(){try{if(!pk)return;const c=await ensureConn(),P=new solanaWeb3.PublicKey(pk),lam=await c.getBalance(P);let us=0;const ta=await c.getParsedTokenAccountsByOwner(P,{mint:new solanaWeb3.PublicKey(USDC)});for(const it of ta.value)us+=(it.account.data.parsed.info.tokenAmount.uiAmount||0);const solNum=lam/1e9;$("sol").textContent=solNum.toFixed(4);$("usdc").textContent=us.toFixed(2);if(solNum<SESSION_MIN_SOL){setSess(false);localStorage.setItem(K.A,"DISARM")}}catch(e){L("BAL "+String(e?.message||e))}}function ui(){const arm=localStorage.getItem(K.A)||"DISARM";$("arm").textContent=arm;$("arm").className="b "+(arm==="ARM"?"ok":"bad");$("mint").textContent=localStorage.getItem(K.T)||"-";$("dec").textContent=localStorage.getItem(K.D)||"-";const p=Number(localStorage.getItem(K.P)||0);$("pur").textContent=p?fix(p,3):"-";$("hits").textContent=`TP1:${Engine.h.tp1} TP2:${Engine.h.tp2} TP3:${Engine.h.tp3} SL:${Engine.h.sl} LAST:${Engine.lastHit} SIZE:${Engine.sz}`;drawPNL();drawPur();renderSessionUI()}async function syncTokens(){try{ST("sync");const r=await fetch("/findtoken/pump?limit=120",{cache:"no-store"});const j=await r.json();autoAdd((j.items||[]).map(x=>({symbol:x.symbol||"?",mint:x.mint})));purge();renderList();ST("idle");L("TOKENS synced")}catch(e){ST("idle");L("SYNC "+String(e?.message||e))}}function setNext(ms){clearTimeout(timer);timer=setTimeout(loop,Math.max(500,Math.min(25000,ms)))}async function loop(){try{ST("scan");purge();renderList();await readBalances();if(!SESSION_ON){localStorage.setItem(K.A,"DISARM");ui();ST("idle");setNext(4000);return}const th=Number($("pureTh").value||0.65);const ib=internalBudgetFromEntropy();const riskLeft=sessionRiskRemaining();Engine.sz=Math.max(1,Math.floor(Math.min(ib.Bint,riskLeft)));$("bud").textContent=Engine.sz.toFixed(0);renderQ();renderSessionUI();if(riskLeft<=0){setSess(false);localStorage.setItem(K.A,"DISARM");L("SESSION STOP: drawdown atteint (budget consommé)");ui();ST("idle");setNext(8000);return}const w=loadW();let best=null;for(const t of w){if(t.src!=="TOK")continue;const mk=await dexMarket(t.m);if(!mk||!Number.isFinite(mk.px)||mk.px<=0)continue;const sig=sigFrom(mk);const scs=calcQ_scores(sig);const rhoM=mkRhoM(scs);const pur=purM(rhoM);const jm=Jm(rhoM);const armP=armProbFromRhoM(rhoM);if(!best||pur>best.pur)best={t,mk,scs,rhoM,pur,jm,armP}}if(!best){localStorage.setItem(K.A,"DISARM");ST("idle");ui();setNext(6000);return}Q3.rhoM=best.rhoM;$("jm").textContent=best.jm.toFixed(4);$("sym").textContent=best.t.s;$("px").textContent=fix(best.mk.px,6);$("mint").textContent=best.t.m;const lv=levels(best.mk.px,best.mk.vol);localStorage.setItem(K.LV,JSON.stringify(lv));$("E").textContent=fix(lv.entry,6);$("SL").textContent=fix(lv.SL,6);$("T1").textContent=fix(lv.TP1,6);$("T2").textContent=fix(lv.TP2,6);$("T3").textContent=fix(lv.TP3,6);$("RR").textContent=fix(lv.RR,2);const decision=best.scs.BUY>=best.scs.HOLD&&best.scs.BUY>=best.scs.SELL?"BUY":(best.scs.SELL>=best.scs.HOLD?"SELL":"HOLD");localStorage.setItem(K.D,decision);localStorage.setItem(K.T,best.t.m);localStorage.setItem(K.P,String(best.pur));histPush(K.PH,best.pur,240);renderQ();const arm=(best.pur>=th && best.jm>=-EPSJ && best.armP>0.5)?"ARM":"DISARM";localStorage.setItem(K.A,arm);$("dec").textContent=decision;$("pur").textContent=best.pur.toFixed(3);$("arm").textContent=arm;$("arm").className="b "+(arm==="ARM"?"ok":"bad");if(arm==="ARM"){if(!Engine.open||Engine.mint!==best.t.m){Engine.open=true;Engine.mint=best.t.m;Engine.entry=best.mk.px;Engine.levels=lv;Engine.lastHit="OPEN";L("OPEN "+best.t.s+" entry="+best.mk.px.toFixed(6)+" size="+Engine.sz)}}else{Engine.open=false;Engine.mint=null;Engine.entry=0;Engine.levels=null}Engine.update(best.mk.px);renderSessionUI();if(sessionRiskRemaining()<=0){setSess(false);localStorage.setItem(K.A,"DISARM");L("SESSION STOP: drawdown atteint (budget consommé)");ui();ST("idle");setNext(8000);return}ui();const p=best.pur;const tauM=tauMarketFromPur(p);const a=botAgg();const e=botEntropy();let tau=tauM*(0.7+0.6*(1-e.cohB))*(1-0.5*a);tau=Math.max(700,Math.min(20000,tau));$("tau").textContent=Math.round(tau);ST("idle");setNext(tau)}catch(e){ST("idle");L("LOOP "+String(e?.message||e));setNext(6000)}}$("btnTok").onclick=()=>syncTokens();$("btnNow").onclick=()=>{readBalances();loop()};$("btnSess").onclick=async()=>{await readBalances();const solNow=parseFloat($("sol").textContent||"0");if(solNow<SESSION_MIN_SOL){L("SESSION OFF: SOL < 0.001");setSess(false);return}let b=Number(localStorage.getItem(K.SB)||0);const ask=prompt("Budget session (USDC paper). Ex: 50",b>0?String(b):"50");if(ask===null){L("SESSION: annulée");return}b=Number(ask);if(!Number.isFinite(b)||b<=0){L("SESSION: budget invalide");return}SESSION_BUDGET=b;localStorage.setItem(K.SB,String(b));SESSION_PNL0=Engine.pnl;localStorage.setItem(K.SP,String(SESSION_PNL0));setSess(true);L("SESSION ON | budget="+b+" | pnl0="+SESSION_PNL0.toFixed(4));loop()};$("btnW").onclick=async()=>{try{if(!window.solana||!window.solana.isPhantom){L("Phantom absent");return}ST("connect");const r=await window.solana.connect({onlyIfTrusted:false});pk=r.publicKey.toString();$("wal").textContent=pk.slice(0,4)+"…"+pk.slice(-4);await readBalances();ST("idle");L("Wallet connected")}catch(e){ST("idle");L("CONNECT "+String(e?.message||e))}};setInterval(purge,60e3);purge();renderList();ui();loop();</script></html>
};
$("presetExplore").onclick=()=>applyPreset("explore");
$("presetStab").onclick=()=>applyPreset("stab");
$("presetEvade").onclick=()=>applyPreset("evade");
$("presetFast").onclick=()=>applyPreset("fast");

/* Visual actions */
$("doPCA").onclick=()=>{if(RUNS.length<3) return toast("Pas assez de runs");
const data=RUNS.map(vecOf); PCA_PTS=PCA2D(data); PCA_MAP=drawScatter($("pca"),PCA_PTS,mkColors(RUNS,clusterAssign()),selected); $("pcaInfo").textContent="PCA OK"; toast("PCA OK");};
$("doTSNE").onclick=()=>{if(RUNS.length<3) return toast("Pas assez de runs");
const data=RUNS.map(vecOf); TSNE_PTS=tsne2D(data); TSNE_MAP=drawScatter($("tsne"),TSNE_PTS,mkColors(RUNS,clusterAssign()),selected); $("tsneInfo").textContent="t-SNE OK"; toast("t-SNE OK");};
$("doPhylo").onclick=()=>{if(RUNS.length<3) return toast("Pas assez de runs");
const root=upgma(RUNS.map(r=>({identity:r.identity,mutations:r.mutations,danger:r.danger,score:r.score}))); const cv=$("tree"),c=cv.getContext("2d");
c.clearRect(0,0,cv.width,cv.height); c.fillStyle="rgba(255,255,255,.03)"; for(let i=0;i<=10;i++){c.fillRect(i*(cv.width/10),0,1,cv.height)}
c.fillStyle="#dff"; c.font="12px ui-monospace"; drawTree(cv,root); $("treeInfo").textContent="Phylo OK"; toast("Phylo OK");};
$("doPareto").onclick=()=>{if(RUNS.length<2) return toast("Pas assez de runs");
const slim=RUNS.map(r=>({identity:r.identity,mutations:r.mutations,danger:r.danger,score:r.score,rbd:r.rbd,idx:RUNS.indexOf(r)}));
const f=paretoFront(slim); $("k_pareto").textContent=String(f.length);
$("pareto").innerHTML=f.slice(0,80).map((r,i)=>`<div class="seq">#${i+1} run ${r.idx+1} id ${r.identity}% mut ${r.mutations} score ${r.score} danger ${r.danger} rbd ${r.rbd}</div>`).join("");
toast("Pareto OK");};

/* Shortcuts */
window.addEventListener("keydown",e=>{if(e.target&&["INPUT","SELECT","TEXTAREA"].includes(e.target.tagName))return;
if(e.code==="Space"){e.preventDefault();P.autostart=P.autostart?0:1;sync();toast(P.autostart?"Play":"Pause");restartAuto()}
else if(e.key==="r"||e.key==="R")$("reset").click()
else if(e.key==="p"||e.key==="P")$("doPCA").click()
else if(e.key==="t"||e.key==="T")$("doTSNE").click()
else if(e.key==="y"||e.key==="Y")$("doPhylo").click()
else if(e.key==="o"||e.key==="O")$("doPareto").click()
});

/* Init */
$("toggleAuto").textContent="AutoStart ON"; $("toggleTune").textContent="AutoTune ON";
$("loopMs").value=P.loopMs; $("mutRate").value=P.mutRate; $("eps").value=P.eps; $("step").value=P.step; $("voiceEvery").value=P.voiceEvery;
$("kClu").oninput=e=>{$("kCluV").textContent=e.target.value}; $("kCluV").textContent=$("kClu").value;
sync(); drawHeat(); drawHist(); drawSpark(); updateHUD(); if(P.autostart) startAuto();
})();
</script></body></html>
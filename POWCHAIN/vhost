nano /etc/nginx/sites-available/bbqfinance

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    access_log /var/log/nginx/bbqfinance_access.log;
    error_log  /var/log/nginx/bbqfinance_error.log;

    # --------- STATIC HTML (index POWCHAIN) ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --------- API POWCHAIN -> Node.js (port 3000) ----------
    location ~ ^/(stats|tx|wallet|block|chain|bridge) {
        proxy_pass http://127.0.0.1:3000$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout    60s;
        proxy_connect_timeout 60s;
    }

    # --------- WebSocket POWCHAIN -> Node.js (port 7001) ----------
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "Upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        proxy_connect_timeout 3600s;

        proxy_buffering off;
    }
}


sudo ln -sf /etc/nginx/sites-available/bbqfinance /etc/nginx/sites-enabled/bbqfinance
sudo rm -f /etc/nginx/sites-enabled/default

sudo nginx -t
sudo systemctl restart nginx

curl -s http://127.0.0.1:3000/stats
curl -s https://bbqfinance.fun/stats
curl -I https://bbqfinance.fun/ws



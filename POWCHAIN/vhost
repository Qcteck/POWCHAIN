<!doctype html><html lang="fr"><head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>POWCHAIN — Dashboard Quantum</title>
<style>
body{margin:0;background:#020b14;color:#dff;font-family:system-ui;overflow-x:hidden}
#top{padding:14px 20px;font-size:22px;font-weight:700;color:#6df;text-shadow:0 0 12px #09f;border-bottom:1px solid #054;display:flex;align-items:center;justify-content:space-between;background:#03121e}
#wrap{display:flex;height:calc(100vh - 60px)}
#left{width:300px;border-right:1px solid #054;padding:14px;overflow-y:auto;background:#03121e}
#main{flex:1;padding:14px;overflow-y:auto}
h3{margin:12px 0 6px;color:#8ff}
label{font-size:14px;color:#bdf}
input,select,button{width:100%;background:#052134;border:1px solid #0af;color:#8ff;padding:7px;border-radius:6px;margin:4px 0;font-size:14px}
button{cursor:pointer;font-weight:600}
#log{white-space:pre-wrap;background:#000a;padding:10px;border:1px solid #044;height:210px;overflow-y:auto;border-radius:6px;margin-top:8px;font-size:12px}
.card{background:#04131f;border:1px solid #075;padding:10px;border-radius:6px;margin:8px 0}
#balance span{display:block;font-size:14px;margin:3px 0}
hr{border-color:#064;margin:12px 0}
</style>
</head><body>
<div id="top">POWCHAIN — Dashboard Quantum<span id="wsState">WS: ❌</span></div>
<div id="wrap">
<div id="left">

<h3>Wallet POWCHAIN</h3>
<button id="genWallet">Générer un wallet POWCHAIN</button>
<div id="walletInfo"></div>

<h3>Connexion Phantom (Solana)</h3>
<button id="connectPhantom">Connecter Phantom</button>
<div id="balance"></div>

<h3>Trésorerie POWCHAIN</h3>
<div id="tresor"></div>

<h3>Bridge Sol → POWCHAIN</h3>
<label>Montant SOL</label><input id="bridgeAmt" placeholder="ex: 0.1">
<button id="sendBridge">Bridge</button>

<h3>Envoyer TX (POWCHAIN)</h3>
<label>Type</label>
<select id="txType">
<option value="transfer">Transfer</option>
<option value="stake">Stake</option>
<option value="unstake">Unstake</option>
<option value="lp_add">LP Add</option>
<option value="lp_remove">LP Remove</option>
</select>
<label>Destinataire (pub)</label>
<input id="txTo" placeholder="adresse">
<label>Montant</label>
<input id="txAmount" placeholder="ex: 10">
<button id="sendTX">Envoyer TX (WebSocket)</button>

</div>
<div id="main">

<h3>Graphiques & Liquidité</h3>
<div class="card" id="charts">Chargement des graphiques...</div>

<h3>Journal</h3>
<div id="log"></div>

</div>
</div>
<script>
const WS_URL="wss://bbqfinance.fun/ws";
const API_URL="https://bbqfinance.fun";
const log=e=>{let l=document.getElementById("log");l.textContent+="["+new Date().toLocaleTimeString()+"] "+e+"\n";l.scrollTop=l.scrollHeight;};
let ws;
function startWS(){
 log("Connexion WebSocket...");
 ws=new WebSocket(WS_URL);
 ws.onopen=()=>{document.getElementById("wsState").textContent="WS: 🟢";log("WebSocket connecté");ws.send(JSON.stringify({type:"get_stats"}));};
 ws.onmessage=e=>{
  try{
   let d=JSON.parse(e.data);
   if(d.stats) renderStats(d.stats);
   if(d.msg) log(d.msg);
  }catch{ log("serveur non JSON → "+e.data) }
 };
 ws.onclose=()=>{document.getElementById("wsState").textContent="WS: ❌";log("WS fermé — reconnexion dans 3s");setTimeout(startWS,3000);}
 ws.onerror=e=>log("Erreur WS: "+e);
}
startWS();

function renderStats(s){
 let div=document.getElementById("charts");
 div.innerHTML=`🌍 POW: <b>${s.pow}</b><br>💵 USDC POW: <b>${s.usdcpow}</b><br>🌋 LP Liquidity: <b>${s.lp}</b>`;
 document.getElementById("tresor").innerHTML=`💰 Trésorerie POWCHAIN: <b>${s.treasury}</b>`;
 document.getElementById("balance").innerHTML=document.getElementById("balance").innerHTML; // rien juste rafraîchissement visuel
}

document.getElementById("sendTX").onclick=()=>{
 let o={type:document.getElementById("txType").value,to:document.getElementById("txTo").value,amount:document.getElementById("txAmount").value};
 ws.send(JSON.stringify(o));
 log("TX envoyée "+JSON.stringify(o));
};

document.getElementById("sendBridge").onclick=()=>{
 fetch(API_URL+"/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({amount:document.getElementById("bridgeAmt").value})})
 .then(r=>r.text()).then(t=>log("Bridge: "+t)).catch(e=>log("Erreur Bridge: "+e));
};

document.getElementById("genWallet").onclick=()=>{
 fetch(API_URL+"/gen_wallet").then(r=>r.json()).then(w=>{
  document.getElementById("walletInfo").innerHTML=`PUB:<br><b>${w.pub}</b><br><brPRIVATE:<br><b>${w.priv}</b>`;
  navigator.clipboard.writeText(w.pub);
  log("Wallet généré + clé copiée");
 });
};

document.getElementById("connectPhantom").onclick=()=>{
 if(!window.solana){log("Phantom non détecté");return;}
 window.solana.connect().then(x=>{
  log("Phantom connecté: "+x.publicKey.toString());
  fetch(API_URL+"/sol_balance?pub="+x.publicKey.toString()).then(r=>r.json()).then(b=>{
   document.getElementById("balance").innerHTML=`SOL: <b>${b.sol}</b><br>USDC: <b>${b.usdc}</b>`;
  });
 });
};
</script>
</body></html>
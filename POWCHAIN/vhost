const express = require("express");
const cors = require("cors");
const bodyParser = require("body-parser");
const WebSocket = require("ws");

const app = express();
app.use(cors());
app.use(bodyParser.json());

const DEC = 1e6;
const SOL_DEC = 1e9;
const SOL_RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";

// ----- ÉTAT GLOBAL -----
let state = {
  height: 1,
  wallets: {},
  treasury: {
    solAddress: "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy",
    solBalance: 0,
    usdcBalance: 0,
    fireBalance: 0
  },
  lp: { pow: 0, usdc: 0 },
  staking: { total: 0 },
  mempool: [],
  chain: [
    { height: 1, timestamp: Date.now(), type: "genesis", data: { msg: "FIREINNERS genesis" } }
  ]
};

let serverWallet = {
  pub: "FIREINNERS_SERVER",
  pow: 1_000_000 * DEC,
  usdc: 50_000 * DEC,
  staked: 0,
  nonce: 0
};
state.wallets[serverWallet.pub] = serverWallet;

function getWallet(addr) {
  if (!state.wallets[addr]) {
    state.wallets[addr] = { pub: addr, pow: 0, usdc: 0, staked: 0, nonce: 0 };
  }
  return state.wallets[addr];
}
function pushBlock(type, data) {
  state.height++;
  const blk = { height: state.height, timestamp: Date.now(), type, data };
  state.chain.push(blk);
  if (state.chain.length > 1000) state.chain = state.chain.slice(-1000);
  broadcast({ type: "new_block", block: blk });
}
function addToMempool(tx) {
  state.mempool.push(tx);
  if (state.mempool.length > 200) state.mempool = state.mempool.slice(-200);
  broadcast({ type: "mempool", mempool: state.mempool });
}

// ---------- API (prefix /api) ----------

// stats
app.get("/api/stats", (req, res) => {
  const totals = Object.values(state.wallets).reduce(
    (acc, w) => {
      acc.pow += w.pow || 0;
      acc.staked += w.staked || 0;
      return acc;
    },
    { pow: 0, staked: 0 }
  );
  res.json({
    height: state.height,
    wallets: Object.keys(state.wallets).length,
    mempool: state.mempool.length,
    totalPow: totals.pow,
    totalStaked: totals.staked,
    lpPow: state.lp.pow,
    lpUsdc: state.lp.usdc,
    treasurySolAddress: state.treasury.solAddress,
    solTreasury: state.treasury.solBalance,
    usdcTreasury: state.treasury.usdcBalance,
    fireTreasury: state.treasury.fireBalance
  });
});

// wallet
app.get("/api/wallet/:addr", (req, res) => {
  const w = getWallet(req.params.addr);
  res.json({ pub: w.pub, pow: w.pow, usdc: w.usdc, staked: w.staked, nonce: w.nonce });
});

// transfert interne
app.post("/api/tx", (req, res) => {
  try {
    const { from, to, token, amount } = req.body;
    if (!from || !to) return res.status(400).json({ ok: false, error: "Missing from/to" });
    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ ok: false, error: "Invalid amount" });
    if (token !== "pow" && token !== "usdc")
      return res.status(400).json({ ok: false, error: "Invalid token" });

    const wf = getWallet(from);
    const wt = getWallet(to);
    if ((wf[token] || 0) < amt) return res.json({ ok: false, error: "Insufficient balance" });

    wf[token] -= amt;
    wt[token] = (wt[token] || 0) + amt;
    wf.nonce++;

    const tx = { type: "transfer", from, to, token, amount: amt };
    addToMempool(tx);
    pushBlock("transfer", tx);
    broadcast({ type: "tx", tx });
    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// -------- Bridge SOL → POWCHAIN --------
async function rpcCall(body) {
  const r = await fetch(SOL_RPC, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });
  if (!r.ok) throw new Error("RPC HTTP " + r.status);
  return r.json();
}

app.post("/api/bridge", async (req, res) => {
  try {
    const { addr, amount, fromSol, txSig } = req.body || {};
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    if (!fromSol || !txSig)
      return res.status(400).json({ ok: false, error: "Missing fromSol or txSig" });

    const solAmt = Number(amount || 0);
    if (!(solAmt > 0)) return res.status(400).json({ ok: false, error: "Invalid sol amount" });

    // 1) statut
    const statusResp = await rpcCall({
      jsonrpc: "2.0",
      id: 1,
      method: "getSignatureStatuses",
      params: [[txSig], { searchTransactionHistory: true }]
    });
    const st = statusResp.result && statusResp.result.value && statusResp.result.value[0];
    if (!st || !st.confirmationStatus) {
      return res.json({ ok: false, error: "Bridge rejected: tx not found/failed" });
    }

    // 2) transaction complète
    const txResp = await rpcCall({
      jsonrpc: "2.0",
      id: 2,
      method: "getTransaction",
      params: [txSig, { encoding: "jsonParsed", maxSupportedTransactionVersion: 0 }]
    });
    const tx = txResp.result;
    if (!tx || !tx.meta || !tx.transaction || !tx.transaction.message) {
      return res.json({ ok: false, error: "Bridge rejected: no tx meta" });
    }

    const keys = tx.transaction.message.accountKeys.map(k =>
      typeof k === "string" ? k : k.pubkey
    );
    const pre = tx.meta.preBalances || [];
    const post = tx.meta.postBalances || [];
    const idxFrom = keys.findIndex(k => k === fromSol);
    const idxTreas = keys.findIndex(k => k === state.treasury.solAddress);
    if (idxFrom < 0 || idxTreas < 0) {
      return res.json({ ok: false, error: "Bridge rejected: wrong accounts" });
    }
    const deltaFrom = (pre[idxFrom] - post[idxFrom]) / SOL_DEC;
    const deltaTreas = (post[idxTreas] - pre[idxTreas]) / SOL_DEC;
    if (deltaFrom <= 0 || deltaTreas <= 0) {
      return res.json({ ok: false, error: "Bridge rejected: no positive transfer" });
    }

    const tol = solAmt * 0.05;
    if (Math.abs(deltaTreas - solAmt) > tol) {
      return res.json({
        ok: false,
        error: "Bridge rejected: amount mismatch",
        onchain: deltaTreas
      });
    }

    const lamportsPow = Math.round(solAmt * DEC * 100); // ex: 1 SOL → 100 FIRE
    const w = getWallet(addr);
    w.pow += lamportsPow;
    w.nonce++;
    state.treasury.solBalance += deltaTreas;
    state.treasury.fireBalance += lamportsPow;

    const txBridge = {
      type: "bridge_in",
      addr,
      fromSol,
      sol: deltaTreas,
      powCredited: lamportsPow,
      txSig
    };
    addToMempool(txBridge);
    pushBlock("bridge_in", txBridge);
    res.json({ ok: true, credited: lamportsPow, solDetected: deltaTreas });
  } catch (e) {
    console.error("Bridge ERR", e);
    res.status(500).json({ ok: false, error: e.message });
  }
});

// -------- LP / SWAP --------
app.post("/api/lp/add", (req, res) => {
  try {
    const { addr, pow, usdc } = req.body || {};
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const p = Number(pow || 0);
    const u = Number(usdc || 0);
    if (!(p > 0) || !(u > 0)) return res.status(400).json({ ok: false, error: "Invalid amounts" });

    const w = getWallet(addr);
    if (w.pow < p || w.usdc < u) return res.json({ ok: false, error: "Insufficient balance" });

    w.pow -= p;
    w.usdc -= u;
    state.lp.pow += p;
    state.lp.usdc += u;
    w.nonce++;

    const tx = { type: "lp_add", addr, pow: p, usdc: u };
    addToMempool(tx);
    pushBlock("lp_add", tx);
    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

app.post("/api/swap", (req, res) => {
  try {
    const { addr, dir, amount } = req.body || {};
    if (!addr) return res.status(400).json({ ok: false, error: "Missing addr" });
    const amt = Number(amount || 0);
    if (!(amt > 0)) return res.status(400).json({ ok: false, error: "Invalid amount" });
    if (dir !== "pow2usdc" && dir !== "usdc2pow")
      return res.status(400).json({ ok: false, error: "Invalid dir" });

    const w = getWallet(addr);
    const feeRate = 0.003;
    if (state.lp.pow <= 0 || state.lp.usdc <= 0)
      return res.json({ ok: false, error: "Empty LP" });

    const k = state.lp.pow * state.lp.usdc;
    if (dir === "pow2usdc") {
      if (w.pow < amt) return res.json({ ok: false, error: "Insufficient POW" });
      const powAfter = state.lp.pow + amt;
      const usdcAfter = k / powAfter;
      let out = state.lp.usdc - usdcAfter;
      const fee = out * feeRate;
      out -= fee;
      if (out <= 0) return res.json({ ok: false, error: "Swap too small" });

      w.pow -= amt;
      w.usdc += out;
      state.lp.pow += amt;
      state.lp.usdc -= out;
      state.treasury.usdcBalance += fee;
      w.nonce++;
      const tx = { type: "swap_pow2usdc", addr, in: amt, out };
      addToMempool(tx);
      pushBlock("swap_pow2usdc", tx);
      res.json({ ok: true, received: out });
    } else {
      if (w.usdc < amt) return res.json({ ok: false, error: "Insufficient USDC" });
      const usdcAfter = state.lp.usdc + amt;
      const powAfter = k / usdcAfter;
      let out = state.lp.pow - powAfter;
      const fee = out * feeRate;
      out -= fee;
      if (out <= 0) return res.json({ ok: false, error: "Swap too small" });

      w.usdc -= amt;
      w.pow += out;
      state.lp.usdc += amt;
      state.lp.pow -= out;
      state.treasury.fireBalance += fee;
      w.nonce++;
      const tx = { type: "swap_usdc2pow", addr, in: amt, out };
      addToMempool(tx);
      pushBlock("swap_usdc2pow", tx);
      res.json({ ok: true, received: out });
    }
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});


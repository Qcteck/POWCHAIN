  border-color:#f97373;
  box-shadow:0 0 10px rgba(248,113,113,.35);
}
.btn-red:hover{background:linear-gradient(to bottom,#dc2626,#7f1d1d);transform:translateY(-1px)}
.btn-gold{
  background:linear-gradient(to bottom,#facc15,#b45309);
  border-color:#facc15;
  color:#111827;
  font-weight:600;
  box-shadow:0 0 10px rgba(250,204,21,.4);
}
.btn-gold:hover{background:linear-gradient(to bottom,#fde047,#b45309);transform:translateY(-1px)}
.btn-gray{
  background:linear-gradient(to bottom,#374151,#111827);
}

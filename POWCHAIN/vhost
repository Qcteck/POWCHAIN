nano /root/POWCHAIN/deploy.sh



#!/bin/bash
set -e

SRC="/root/POWCHAIN/FIREINNERS_FULL.txt"

HTML_FILE="/var/www/html/index.html"
SERVER_FILE="/root/POWCHAIN/server.js"
NGINX_FILE="/etc/nginx/sites-available/bbqfinance.conf"

extract() {
  sed -n "/===${1}===/,/===END_${1}===/p" "$SRC" | sed '1d;$d'
}

# Extraction
extract "HTML" > "$HTML_FILE"
extract "SERVER" > "$SERVER_FILE"
extract "NGINX" > "$NGINX_FILE"

chmod 644 "$HTML_FILE"
chmod 644 "$NGINX_FILE"
chmod 755 "$SERVER_FILE"

systemctl reload nginx

pm2 delete fireinners || true
pm2 start "$SERVER_FILE" --name fireinners
pm2 save

echo "Déploiement terminé !"




chmod +x /root/POWCHAIN/deploy.sh
/root/POWCHAIN/deploy.sh



cat /var/www/html/index.html






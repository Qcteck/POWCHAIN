<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>POWCHAIN — Dashboard</title>
  <style>
    :root{
      --bg:#05070b;
      --card:#0b111c;
      --accent:#38bdf8;
      --accent-soft:#0f172a;
      --border:#1e293b;
      --txt:#e5ecff;
      --muted:#94a3b8;
      --danger:#f97373;
      --success:#4ade80;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      background:radial-gradient(circle at top,#020617,#000);
      color:var(--txt);
      font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    }
    #wrap{
      display:flex;
      min-height:100vh;
    }
    #left,#right{
      padding:16px;
    }
    #left{
      width:320px;
      border-right:1px solid var(--border);
      background:linear-gradient(to bottom,#020617,#020617 60%,#000);
    }
    #right{
      flex:1;
      background:radial-gradient(circle at top left,#0b1120,#020617 55%,#000);
    }
    h1{
      margin:0 0 8px;
      font-size:22px;
      letter-spacing:1px;
      text-transform:uppercase;
    }
    h2{
      margin:16px 0 8px;
      font-size:15px;
      text-transform:uppercase;
      letter-spacing:.08em;
      color:var(--muted);
    }
    .badge{
      display:inline-flex;
      align-items:center;
      padding:3px 8px;
      border-radius:999px;
      font-size:11px;
      background:linear-gradient(to right,#0f172a,#020617);
      border:1px solid #1f2937;
      color:var(--muted);
      gap:6px;
    }
    .dot{
      width:8px;height:8px;border-radius:999px;
      background:var(--danger);
      box-shadow:0 0 6px rgba(248,113,113,.7);
    }
    .dot.ok{
      background:#22c55e;
      box-shadow:0 0 6px rgba(34,197,94,.7);
    }
    label{
      display:block;
      font-size:12px;
      color:var(--muted);
      margin-bottom:2px;
    }
    input,select,button,textarea{
      width:100%;
      padding:7px 9px;
      border-radius:6px;
      border:1px solid var(--border);
      background:#020617;
      color:var(--txt);
      font-size:13px;
      margin-bottom:8px;
      font-family:inherit;
    }
    textarea{resize:vertical;min-height:60px}
    button{
      cursor:pointer;
      background:linear-gradient(to right,#0f172a,#020617);
      border:1px solid var(--accent);
      text-transform:uppercase;
      letter-spacing:.08em;
      font-weight:600;
    }
    button:hover{
      background:radial-gradient(circle at top,#0b1120,#020617);
    }
    .row{display:flex;gap:10px}
    .row>div{flex:1}
    .card{
      border-radius:10px;
      border:1px solid var(--border);
      background:linear-gradient(135deg,rgba(15,23,42,.92),rgba(2,6,23,.98));
      padding:10px 12px;
      margin-bottom:10px;
      box-shadow:0 0 18px rgba(0,0,0,.7);
    }
    .kv{
      display:flex;
      justify-content:space-between;
      font-size:12px;
      margin:2px 0;
    }
    .kv span:last-child{color:var(--accent)}
    #log{
      background:#020617;
      border-radius:8px;
      border:1px solid #1f2937;
      padding:8px;
      font-size:11px;
      max-height:180px;
      overflow:auto;
      white-space:pre-wrap;
    }
    table{
      width:100%;
      border-collapse:collapse;
      font-size:11px;
    }
    th,td{
      padding:4px 6px;
      border-bottom:1px solid #0f172a;
    }
    th{
      text-align:left;
      font-weight:600;
      color:var(--muted);
      background:#020617;
      position:sticky;
      top:0;
      z-index:1;
    }
    tr:nth-child(even){
      background:rgba(15,23,42,.7);
    }
    small{font-size:11px;color:var(--muted)}
    .pill{
      display:inline-block;
      padding:2px 6px;
      border-radius:999px;
      border:1px solid #1f2937;
      font-size:10px;
      color:var(--muted);
    }
    .pill.pow{border-color:#38bdf8;color:#38bdf8}
    .pill.usdc{border-color:#4ade80;color:#4ade80}
  </style>
  <script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl-fast.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bs58@5.0.0/dist/bs58.min.js"></script>
</head>
<body>
<div id="wrap">
  <div id="left">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
      <div>
        <h1>POWCHAIN</h1>
        <small>Validator local + Dashboard</small>
      </div>
      <div class="badge">
        <span class="dot" id="wsDot"></span>
        <span id="wsLabel">WS OFF</span>
      </div>
    </div>

    <div class="card">
      <h2>Wallet POWCHAIN</h2>
      <label>Adresse publique (pub)</label>
      <input id="pub" placeholder="Coller ton adresse POWCHAIN"/>
      <label>Clé privée (bs58, optionnel pour signer)</label>
      <input id="priv" placeholder="Coller la clé privée pour signer les TX"/>
      <div class="row">
        <button id="btnLoad">Charger wallet</button>
        <button id="btnGen">Générer nouveau</button>
      </div>
      <div id="walletInfo">
        <div class="kv"><span>POW</span><span id="wPow">-</span></div>
        <div class="kv"><span>USDC</span><span id="wUsdc">-</span></div>
        <div class="kv"><span>Staked</span><span id="wStaked">-</span></div>
        <div class="kv"><span>Nonce</span><span id="wNonce">-</span></div>
      </div>
    </div>

    <div class="card">
      <h2>Nouvelle transaction</h2>
      <label>Token</label>
      <select id="txToken">
        <option value="POW">POW</option>
        <option value="USDC">USDC</option>
      </select>
      <label>Destinataire (pub)</label>
      <input id="txTo" placeholder="Adresse POWCHAIN de destination"/>
      <label>Montant</label>
      <input id="txAmount" type="number" step="0.000001" min="0" placeholder="0.0"/>
      <button id="btnSendTx">Signer + envoyer vers mempool</button>
      <small>Le validator forge 1 bloc automatiquement dès que 5 transactions sont dans le mempool.</small>
    </div>

    <div class="card">
      <h2>Infos globales</h2>
      <div class="kv"><span>Hauteur</span><span id="sHeight">-</span></div>
      <div class="kv"><span>Wallets</span><span id="sWallets">-</span></div>
      <div class="kv"><span>Mempool</span><span id="sMempool">-</span></div>
      <div class="kv"><span>Total POW</span><span id="sTotalPow">-</span></div>
      <div class="kv"><span>Total staked</span><span id="sTotalStaked">-</span></div>
    </div>
  </div>

  <div id="right">
    <div class="card">
      <h2>Explorer des blocs (derniers 20)</h2>
      <div style="max-height:220px;overflow:auto">
        <table>
          <thead>
          <tr>
            <th>#</th><th>Temps</th><th>Gagnant</th><th>TX</th><th>Hash</th>
          </tr>
          </thead>
          <tbody id="blocksBody"></tbody>
        </table>
      </div>
    </div>

    <div class="row">
      <div class="card" style="flex:1">
        <h2>Derniers événements</h2>
        <div id="log"></div>
      </div>
      <div class="card" style="flex:1;max-width:320px">
        <h2>LP POW / USDC</h2>
        <div class="kv"><span>POW pool</span><span id="lpPow">-</span></div>
        <div class="kv"><span>USDC pool</span><span id="lpUsdc">-</span></div>
        <small>Affiché en temps réel via /lp et /stats.</small>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const logEl = document.getElementById("log");
  function log(msg){
    const t = new Date().toISOString().replace("T"," ").slice(0,19);
    logEl.textContent = "["+t+"] "+msg+"\n"+logEl.textContent;
  }

  function api(path, opts){
    return fetch(path,opts).then(r=>r.json());
  }

  const pubInput = document.getElementById("pub");
  const privInput = document.getElementById("priv");
  const wPow = document.getElementById("wPow");
  const wUsdc = document.getElementById("wUsdc");
  const wStaked = document.getElementById("wStaked");
  const wNonce = document.getElementById("wNonce");

  let currentWallet = null;

  function refreshWallet(){
    const pub = pubInput.value.trim();
    if(!pub){
      wPow.textContent="-";
      wUsdc.textContent="-";
      wStaked.textContent="-";
      wNonce.textContent="-";
      return;
    }
    api("/wallet/"+encodeURIComponent(pub))
      .then(w=>{
        if(!w || !w.pub){
          log("Wallet inconnu sur le validator");
          wPow.textContent="-";
          wUsdc.textContent="-";
          wStaked.textContent="-";
          wNonce.textContent="-";
          currentWallet = { pub, nonce:0 };
          return;
        }
        currentWallet = w;
        wPow.textContent = (w.pow||0).toString();
        wUsdc.textContent = (w.usdc||0).toString();
        wStaked.textContent = (w.staked||0).toString();
        wNonce.textContent = (w.nonce||0).toString();
      })
      .catch(e=>log("Erreur wallet: "+e.message));
  }

  document.getElementById("btnLoad").onclick = function(){
    if(!pubInput.value.trim()){
      alert("Entre une adresse publique POWCHAIN.");
      return;
    }
    refreshWallet();
  };

  document.getElementById("btnGen").onclick = function(){
    api("/wallet/create").then(w=>{
      if(w && w.pub){
        pubInput.value = w.pub;
        privInput.value = w.priv || "";
        log("Nouveau wallet POWCHAIN généré.");
        refreshWallet();
      }else{
        log("Erreur génération wallet.");
      }
    }).catch(e=>log("Erreur /wallet/create: "+e.message));
  };

  function signTx(from,priv,tx){
    const msgStr = `${tx.from}|${tx.to}|${tx.amount}|${tx.token}|${tx.nonce}`;
    const msg = new TextEncoder().encode(msgStr);
    const privBytes = bs58.default ? bs58.default.decode(priv) : bs58.decode(priv);
    const sigBytes = nacl.sign.detached(msg, privBytes);
    const sig = (bs58.default?bs58.default:bs58).encode(sigBytes);
    tx.pub = from;
    tx.sig = sig;
  }

  document.getElementById("btnSendTx").onclick = async function(){
    const from = pubInput.value.trim();
    const priv = privInput.value.trim();
    const to = document.getElementById("txTo").value.trim();
    const amountRaw = document.getElementById("txAmount").value;
    const token = document.getElementById("txToken").value;

    if(!from || !priv || !to || !amountRaw){
      alert("Remplis pub, clé privée, destinataire et montant.");
      return;
    }

    const amount = parseFloat(amountRaw);
    if(!(amount>0)){ alert("Montant invalide."); return; }

    try{
      const w = await api("/wallet/"+encodeURIComponent(from));
      const nonce = (w && typeof w.nonce==="number") ? w.nonce+1 : 1;

      const tx = { from, to, amount, token, nonce };
      signTx(from,priv,tx);

      const res = await api("/tx",{
        method:"POST",
        headers:{ "Content-Type":"application/json" },
        body:JSON.stringify(tx)
      });
      if(res.ok){
        log("TX envoyée au mempool ("+token+" "+amount+") nonce="+nonce);
        refreshWallet();
        refreshStats();
        refreshExplorer();
      }else{
        log("TX rejetée par le validator.");
      }
    }catch(e){
      log("Erreur envoi TX: "+e.message);
    }
  };

  const sHeight = document.getElementById("sHeight");
  const sWallets = document.getElementById("sWallets");
  const sMempool = document.getElementById("sMempool");
  const sTotalPow = document.getElementById("sTotalPow");
  const sTotalStaked = document.getElementById("sTotalStaked");
  const lpPow = document.getElementById("lpPow");
  const lpUsdc = document.getElementById("lpUsdc");

  function refreshStats(){
    api("/stats").then(s=>{
      sHeight.textContent = s.height ?? "-";
      sWallets.textContent = s.wallets ?? "-";
      sMempool.textContent = s.mempool ?? "-";
      sTotalPow.textContent = s.totalPow ?? "-";
      sTotalStaked.textContent = s.totalStaked ?? "-";
      if(s.lp){
        lpPow.textContent = s.lp.pow ?? 0;
        lpUsdc.textContent = s.lp.usdc ?? 0;
      }
    }).catch(e=>log("Erreur /stats: "+e.message));
  }

  const blocksBody = document.getElementById("blocksBody");
  function refreshExplorer(){
    api("/explorer?depth=20").then(data=>{
      blocksBody.innerHTML = "";
      (data.blocks||[]).slice().reverse().forEach(b=>{
        const tr = document.createElement("tr");
        const d = new Date(b.time||0);
        const t = isNaN(d.getTime()) ? "-" : d.toLocaleTimeString();
        tr.innerHTML =
          "<td>"+b.index+"</td>"+
          "<td>"+t+"</td>"+
          "<td>"+(b.winner?("<span class='pill'>"+b.winner.slice(0,6)+"…</span>"):"-")+"</td>"+
          "<td>"+(b.txCount||0)+"</td>"+
          "<td><small>"+(b.hash?b.hash.slice(0,18)+"…":"-")+"</small></td>";
        blocksBody.appendChild(tr);
      });
    }).catch(e=>log("Erreur /explorer: "+e.message));
  }

  refreshStats();
  refreshExplorer();
  setInterval(refreshStats,8000);
  setInterval(refreshExplorer,15000);

  const wsDot = document.getElementById("wsDot");
  const wsLabel = document.getElementById("wsLabel");
  function connectWS(){
    const url = (location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws";
    const ws = new WebSocket(url);
    ws.onopen = ()=>{ wsDot.classList.add("ok"); wsLabel.textContent="WS ON"; log("WebSocket connecté"); };
    ws.onclose = ()=>{ wsDot.classList.remove("ok"); wsLabel.textContent="WS OFF"; log("WebSocket fermé, reconnexion…"); setTimeout(connectWS,3000); };
    ws.onerror = ()=>{ wsDot.classList.remove("ok"); wsLabel.textContent="WS ERR"; };
    ws.onmessage = ev=>{
      try{
        const msg = JSON.parse(ev.data);
        if(msg.type==="block"){
          log("Nouveau bloc index "+msg.block.index+" ("+(msg.block.tx.length||0)+" TX)");
          refreshStats();
          refreshExplorer();
        }
        if(msg.type==="bridge"){
          log("Bridge: "+msg.sol+" SOL → "+msg.minted+" POW pour "+msg.fireAddr);
          refreshStats();
        }
      }catch(e){}
    };
  }
  connectWS();

  log("POWCHAIN Dashboard chargé.");
  refreshWallet();

  // bust cache Nginx / navigateur
  try{window.history.replaceState(null,null,"/?v="+Date.now());}catch(e){}
})();
</script>
</body>
</html>
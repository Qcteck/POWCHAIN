const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
const DEC=1e6;

// couleurs FIREINNERS (toutes les principales sauf blanc/noir pour l'algorithme unique)
const FIRE_COLORS=[
  {name:"rouge",hex:"#ff0000",weight:10,rarity:"common"},
  {name:"bleu",hex:"#0000ff",weight:10,rarity:"common"},
  {name:"vert",hex:"#00ff00",weight:10,rarity:"common"},

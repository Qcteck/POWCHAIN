// ============================================================
// FIREINNERS (ex-POWCHAIN) — VALIDATOR + API + WS (server.js)
// ============================================================

const express = require("express");
const bodyParser = require("body-parser");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const crypto = require("crypto");
const http = require("http");

// ------------------------------
// CONFIG SERVEUR
// ------------------------------
const HTTP_PORT = 3000;
const WS_PATH = "/ws";

const app = express();
app.use(bodyParser.json());
const server = http.createServer(app);
const wss = new WebSocket.Server({ server, path: WS_PATH });

const clients = new Set();

// ------------------------------
// ECONOMIE FIREINNERS
// ------------------------------
const DEC = 1e6;
const SUPPLY_MAX = 100_000_000 * DEC;

// Taux POW/SOL dynamique borné
const RATE_BASE = 1000;
const TVL_REF = 1_000_000 * DEC;
const RATE_MIN = 800;
const RATE_MAX = 5000;

// Frais (basis points)
const FEE_TRANSFER_BURN_BP = 50;    // 0.5%
const FEE_SWAP_TOTAL_BP = 30;       // 0.3%
const FEE_SWAP_BURN_PART = 0.5;     // 50% des fees swap brûlés
const FEE_BRIDGE_IN_TREAS_BP = 500; // 5%
const FEE_BRIDGE_IN_BURN_BP = 200;  // 2%
const FEE_BRIDGE_OUT_BURN_BP = 1000;// 10%
const FEE_UNSTAKE_BURN_BP = 300;    // 3%

const STAKE_MIN_LOCK_MS = 30 * 24 * 60 * 60 * 1000;

// ------------------------------
// ÉTATS GLOBAUX FIREINNERS
// ------------------------------
let wallets = {}; // addr -> {pow, usdc, staked, pub, nonce, stakeLock}
let treasury = { pow: 0, usdc: 0, sol: 0 };
let lp = { pow: 0, usdc: 0 };

let supplyCirculante = 0;
let mintedPowTotal = 0;
let burnedPowTotal = 0;
let mempool = [];
let chain = [];

// ------------------------------
// GENESIS
// ------------------------------
(function genesis() {
  const genesisSupply = 100_000_000 * DEC;
  supplyCirculante = genesisSupply;
  mintedPowTotal = genesisSupply;
  treasury.pow = genesisSupply;
  chain.push({
    height: 1,
    hash: "GENESIS",
    time: Date.now(),
    txs: [],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  });
})();

// ------------------------------
// UTILITAIRES
// ------------------------------
function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = { pow: 0, usdc: 0, staked: 0, pub: addr, nonce: 0, stakeLock: 0 };
  }
  return wallets[addr];
}
function clamp(x, min, max) { return x < min ? min : x > max ? max : x; }
function applyBp(amount, bp) { return Math.floor(amount * bp / 10000); }
const sha = (x) => crypto.createHash("sha256").update(JSON.stringify(x)).digest("hex");

function getTVL() {
  return (lp.usdc || 0) + (treasury.usdc || 0);
}
function getRatePowPerSol() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || DEC);
  return clamp(RATE_BASE * factor, RATE_MIN, RATE_MAX);
}

function burnPow(amount) {
  const real = Math.min(amount, supplyCirculante);
  burnedPowTotal += real;
  supplyCirculante -= real;
  return real;
}
function mintPow(amount) {
  const space = SUPPLY_MAX - supplyCirculante;
  const mintable = Math.min(amount, space);
  supplyCirculante += mintable;
  mintedPowTotal += mintable;
  return mintable;
}

// ------------------------------
// TX PROCESSORS
// ------------------------------
const TX = {
  POW_TRANSFER: (tx) => {
    const gross = tx.amount;
    const burnFee = applyBp(gross, FEE_TRANSFER_BURN_BP);
    const send = gross - burnFee;
    const wFrom = ensureWallet(tx.from), wTo = ensureWallet(tx.to);
    if (wFrom.pow < gross) throw "Solde insuffisant";
    wFrom.pow -= gross;
    wTo.pow += send;
    burnPow(burnFee);
    return { type: "POW_TRANSFER", from: tx.from, to: tx.to, send, burned: burnFee };
  },

  SWAP: (tx) => {
    const { addr, amount, token } = tx;
    const feeGross = applyBp(amount, FEE_SWAP_TOTAL_BP);
    const net = amount - feeGross;
    const burnFee = Math.floor(feeGross * FEE_SWAP_BURN_PART);
    const treFee = feeGross - burnFee;
    const w = ensureWallet(addr);

    if (token === "pow2usdc") {
      if (w.pow < amount) throw "POW insuffisant";
      w.pow -= amount;
      lp.pow += net;
      const k = lp.pow * lp.usdc;
      const newUsdc = Math.floor(k / lp.pow);
      const out = lp.usdc - newUsdc;
      lp.usdc = newUsdc;
      w.usdc += out;
    } else if (token === "usdc2pow") {
      if (w.usdc < amount) throw "USDC insuffisant";
      w.usdc -= amount;
      lp.usdc += net;
      const k = lp.pow * lp.usdc;
      const newPow = Math.floor(k / lp.usdc);
      const out = lp.pow - newPow;
      lp.pow = newPow;
      w.pow += out;
    } else throw "swap invalide";

    treasury.pow += treFee;
    burnPow(burnFee);
    return { type: "SWAP", addr, token, net, feeBurn: burnFee, feeTreas: treFee };
  },

  LP_ADD: (tx) => {
    const w = ensureWallet(tx.addr);
    if (w.pow < tx.pow || w.usdc < tx.usdc) throw "Solde insuffisant";
    w.pow -= tx.pow;
    w.usdc -= tx.usdc;
    lp.pow += tx.pow;
    lp.usdc += tx.usdc;
    return { type: "LP_ADD", addr: tx.addr, pow: tx.pow, usdc: tx.usdc };
  },

  BRIDGE_IN: (tx) => {
    const w = ensureWallet(tx.addr);
    const rate = getRatePowPerSol();
    const powBrut = Math.floor(tx.solAmount * rate * DEC);
    const minted = mintPow(powBrut);
    const burn = applyBp(minted, FEE_BRIDGE_IN_BURN_BP);
    const tre = applyBp(minted, FEE_BRIDGE_IN_TREAS_BP);
    const user = minted - burn - tre;
    w.pow += user;
    treasury.pow += tre;
    burnPow(burn);
    treasury.sol += tx.solAmount;
    return { type: "BRIDGE_IN", addr: tx.addr, sol: tx.solAmount, rate, user, tre, burn };
  },

  BRIDGE_OUT: (tx) => {
    const w = ensureWallet(tx.addr);
    if (w.pow < tx.powAmount) throw "Solde POW insuffisant";
    const burn = applyBp(tx.powAmount, FEE_BRIDGE_OUT_BURN_BP);
    const net = tx.powAmount - burn;
    const rate = getRatePowPerSol();
    const solOut = net / (rate * DEC);
    if (treasury.sol < solOut) throw "SOL trésorerie insuffisant";
    w.pow -= tx.powAmount;
    treasury.sol -= solOut;
    burnPow(tx.powAmount);
    return { type: "BRIDGE_OUT", addr: tx.addr, pow: tx.powAmount, sol: solOut, burn };
  },

  STAKE: (tx) => {
    const w = ensureWallet(tx.addr);
    if (w.pow < tx.amount) throw "POW insuffisant";
    w.pow -= tx.amount;
    w.staked += tx.amount;
    w.stakeLock = Date.now() + STAKE_MIN_LOCK_MS;
    return { type: "STAKE", addr: tx.addr, amount: tx.amount };
  },

  UNSTAKE: (tx) => {
    const w = ensureWallet(tx.addr);
    if (w.staked < tx.amount) throw "staked insuffisant";
    const early = Date.now() < w.stakeLock;
    let payout = tx.amount;
    if (early) {
      const burnFee = applyBp(tx.amount, FEE_UNSTAKE_BURN_BP);
      payout -= burnFee;
      burnPow(burnFee);
    }
    w.staked -= tx.amount;
    w.pow += payout;
    return { type: "UNSTAKE", addr: tx.addr, amount: tx.amount, payout };
  }
};

// ------------------------------
// SIGNATURE POWCHAIN
// ------------------------------
function verifySig(tx) {
  const str = JSON.stringify({ type: tx.type, from: tx.from, nonce: tx.nonce });
  const sig = bs58.decode(tx.sig);
  const pub = bs58.decode(tx.pub);
  return nacl.sign.detached.verify(
    new TextEncoder().encode(str), sig, pub
  );
}

// ------------------------------
// BLOC + MEMPOOL
// ------------------------------
function addBlock(txs) {
  const prev = chain[chain.length - 1];
  const block = {
    height: prev.height + 1,
    time: Date.now(),
    prevHash: prev.hash,
    txs,
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  };
  block.hash = sha(block);
  chain.push(block);
  return block;
}

function broadcast(msg) {
  clients.forEach(ws => ws.readyState === 1 && ws.send(JSON.stringify(msg)));
}

// ------------------------------
// API HTTP
// ------------------------------
app.get("/stats", (req, res) => {
  res.json({
    wallets: Object.keys(wallets).length,
    supplyCirculante,
    burnedPowTotal,
    mintedPowTotal,
    tvl_usdc: getTVL(),
    treasury,
    lp,
    blocks: chain.length
  });
});

app.post("/send", (req, res) => {
  try {
    const tx = req.body;

    if (!verifySig(tx)) throw "Signature invalide";

    const w = ensureWallet(tx.from);
    if (tx.nonce !== w.nonce + 1) throw "nonce invalid";
    w.nonce++;

    const result = TX[tx.type](tx);
    mempool.push(result);
    const block = addBlock([result]);

    broadcast({ newBlock: block });
    return res.json({ ok: true, block });
  } catch (e) {
    return res.json({ ok: false, error: e.toString() });
  }
});

app.get("/explorer", (req, res) => {
  res.json(chain.slice(-50)); // dernier 50 blocs
});

// ------------------------------
// WebSocket
// ------------------------------
wss.on("connection", (ws) => {
  clients.add(ws);
  ws.send(JSON.stringify({ hello: "WS CONNECTED", height: chain.length }));
  ws.on("close", () => clients.delete(ws));
});

// ------------------------------
// LANCEMENT
// ------------------------------
server.listen(HTTP_PORT, () => {
  console.log("🔥 FIREINNERS Validator prêt — HTTP + WS sur port", HTTP_PORT);
});


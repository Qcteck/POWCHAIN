nano /etc/nginx/sites-available/bbqfinance

server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # ===================== API POWCHAIN (HTTP 3000) =====================
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
    }
    location /tx {
        proxy_pass http://127.0.0.1:3000/tx;
    }
    location /wallet {
        proxy_pass http://127.0.0.1:3000;
    }
    location /block {
        proxy_pass http://127.0.0.1:3000;
    }
    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
    }

    # ===================== WebSocket POWCHAIN (WS 7001) =====================
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}



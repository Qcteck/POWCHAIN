    <!-- WALLET POWCHAIN -->
    <div class="card">
      <h2>Wallet POWCHAIN — Générateur</h2>
      <div class="label">Adresse POWCHAIN (base58)</div>
      <input id="powAddr" placeholder="Clique sur GÉNÉRER pour créer un wallet local" readonly/>
      <div class="row">
        <button id="btnGen">Générer wallet POWCHAIN</button>
        <button id="btnReload" class="secondary">Recharger</button>
      </div>
      <div class="row" style="align-items:center;">

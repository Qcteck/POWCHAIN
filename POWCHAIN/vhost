nano /etc/nginx/sites-available/bbqfinance


server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    access_log /var/log/nginx/bbqfinance_access.log;
    error_log  /var/log/nginx/bbqfinance_error.log;

    # --------- FRONT (HTML) ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --------- API POWCHAIN HTTP (port 3000) ----------
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /tx {
        proxy_pass http://127.0.0.1:3000/tx;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Optionnel : toutes les autres routes API vers 3000
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # --------- WEBSOCKET POWCHAIN (port 7001) ----------
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }
}


nginx -t
sudo systemctl restart nginx


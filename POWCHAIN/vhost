<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport"content="width=device-width,initial-scale=1"/><title>FIREINNERS PANEL</title><style>body{margin:0;font-family:system-ui;background:#000;color:#eee;overflow:hidden}#topTicker,#botTicker{white-space:nowrap;overflow:hidden;background:linear-gradient(90deg,#8a6f00,#d4af37,#ffcc33,#d4af37,#8a6f00);padding:8px 0;border-bottom:1px solid #704f00;font-size:13px;color:#000;font-weight:600}#topTicker div,#botTicker div{display:inline-block;padding-left:100%;animation:scroll 25s linear infinite}@keyframes scroll{0%{transform:translateX(0)}100%{transform:translateX(-100%)} }#app{display:flex;height:100vh}#side{width:240px;background:#000;border-right:1px solid #222;padding:16px;display:flex;flex-direction:column;gap:14px}nav a{display:block;padding:10px 12px;border-radius:8px;background:#0a0a0a;border:1px solid #1a1a1a;color:#bbb;margin-bottom:6px;text-decoration:none}nav a.active,nav a:hover{border-color:#d4af37;color:#ffd66b;background:#1a1400}#main{flex:1;display:flex;flex-direction:column}#top{padding:14px 20px;border-bottom:1px solid #222;background:#050505;color:#ffcf4a;font-size:15px}#content{flex:1;overflow:auto;padding:20px}.section{display:none}.active{display:block}.card{background:#0a0a0a;border:1px solid #222;border-radius:10px;padding:14px;margin-bottom:16px}input,button,select{width:100%;padding:8px;margin:5px 0 10px;border-radius:6px;background:#111;border:1px solid #444;color:#eee}button{background:linear-gradient(90deg,#8a6f00,#d4af37,#ffcc33);color:#000;font-weight:700}#log{height:150px;overflow:auto;background:#000;border:1px solid #333;padding:8px;font-size:11px;color:#ffeb8b;border-radius:8px}#qrcode{margin-top:10px;text-align:center}</style></head><body><div id="topTicker"><div id="tickerTop"></div></div><div id="app"><aside id="side"><nav><a class="active"data-tab="wallet">Wallet</a><a data-tab="bridge">Bridge</a><a data-tab="dex">DEX</a><a data-tab="stake">Staking</a><a data-tab="explorer">Explorer</a><a data-tab="mempool">Mempool</a><a data-tab="stats">Stats</a></nav></aside><main id="main"><div id="top">FIREINNERS QUANTUM PANEL</div><div id="content"><div class="section active" id="wallet"><div class="card"><h3>Wallet Solana (Phantom)</h3><button id="btnPhantom">Connect Phantom</button><label>Adresse</label><input id="solAddr"readonly><label>SOL</label><input id="solBal"readonly><label>USDC</label><input id="usdcBal"readonly></div><div class="card"><h3>Wallet POWCHAIN</h3><button id="btnGen">Générer wallet POWCHAIN</button><label>Adresse</label><input id="powAddr"readonly><label>Clé privée</label><input id="powPriv"readonly><div id="qrcode"></div><button id="btnReloadPow">Recharger</button><label>POW</label><input id="powBal"readonly><label>USDC POW</label><input id="powUSDCBal"readonly><label>Staké</label><input id="powStakeBal"readonly><label>Nonce</label><input id="powNonce"readonly></div><div class="card"><h3>Trésorerie</h3><label>SOL trésorerie</label><input id="treSOL"readonly><label>USDC trésorerie</label><input id="treUSDC"readonly><label>FIRE trésorerie</label><input id="treFIRE"readonly></div></div><div class="section" id="bridge"><div class="card"><h3>Bridge SOL → FIREINNERS</h3><label>Montant SOL</label><input id="bridgeAmt"placeholder="0.001"><button id="btnBridge">Bridge maintenant</button></div></div><div class="section" id="dex"><div class="card"><h3>Swap interne</h3><input id="swapAmt"><select id="swapDir"><option value="pow2usdc">POW → USDC</option><option value="usdc2pow">USDC → POW</option></select><button id="btnSwap">Swap</button></div></div><div class="section" id="stake"><div class="card"><h3>Staking</h3><input id="stakeAmt"><button id="btnStake">Stake</button></div></div><div class="section" id="explorer"><div class="card"><h3>Explorer</h3><input id="blockInp"placeholder="1"><button id="btnBlock">Voir bloc</button><pre id="blockOut"style="white-space:pre-wrap;color:#ffeb8b"></pre></div></div><div class="section" id="mempool"><div class="card"><pre id="mempoolLive"style="height:200px;overflow:auto;color:#ffd"></pre></div></div><div class="section" id="stats"><div class="card"><label>Hauteur</label><input id="sHeight"readonly><label>Wallets</label><input id="sWallets"readonly><label>Total POW</label><input id="sPOW"readonly><label>Total Staké</label><input id="sStaked"readonly><label>Mempool</label><input id="sMP"readonly><label>LP POW</label><input id="sLPpow"readonly><label>LP USDC</label><input id="sLPusdc"readonly><label>Prix FIRE</label><input id="firePrice"readonly></div></div><div class="card"><div id="log"></div></div></div></main></div><div id="botTicker"><div id="tickerBot"></div></div><script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script><script>const API="https://bbqfinance.fun";const WS="wss://bbqfinance.fun/ws";const q=s=>document.querySelector(s);const log=t=>{q("#log").innerHTML=`<div>[${new Date().toLocaleTimeString()}] ${t}</div>`+q("#log").innerHTML};const NATO=["Alpha","Bravo","Charlie","Delta","Echo","Foxtrot","Golf","Hotel","India","Juliett","Kilo","Lima","Mike","November","Oscar","Papa","Quebec","Romeo","Sierra","Tango","Uniform","Victor","Whiskey","Xray","Yankee","Zulu"];const COLORS=["amber","crimson","cyan","jade","emerald","gold","orange","coral","violet","indigo","ruby","bronze","steel"];function powchainAddress(pub){let h=0;for(let i=0;i<pub.length;i++)h=(h*31+pub.charCodeAt(i))>>>0;let L=String.fromCharCode(65+(h%26));let N=NATO[h%26];let num=(h%1e6)+1;let col=COLORS[h%COLORS.length];return`${L}FIRE${N}inners${num}-${col}`}let solAddr=null,powAddr=null,powPriv=null,powNonce=0,sock=null;async function connectPhantom(){try{const p=window.solana;if(!p)return alert("Phantom non détecté");const r=await p.connect();solAddr=r.publicKey.toString();q("#solAddr").value=solAddr;loadSolBalances();log("Phantom connecté")}catch(e){log(e.message)}}q("#btnPhantom").onclick=connectPhantom;async function loadSolBalances(){try{let body={jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]};let r=await fetch("https://api.mainnet-beta.solana.com",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});let j=await r.json();q("#solBal").value=(j.result.value/1e9).toFixed(4);let r2=await fetch("https://api.mainnet-beta.solana.com",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getTokenAccountsByOwner",params:[solAddr,{mint:"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"},{encoding:"jsonParsed"}]})});let j2=await r2.json();let bal=0;if(j2.result?.value?.length)bal=j2.result.value[0].account.data.parsed.info.tokenAmount.uiAmount;q("#usdcBal").value=bal.toFixed(2)}catch(e){log(e.message)}}q("#btnGen").onclick=()=>{let kp=window.nacl.sign.keyPair();powPriv=btoa(String.fromCharCode(...kp.secretKey));let rawPub=btoa(String.fromCharCode(...kp.publicKey));powAddr=powchainAddress(rawPub);powNonce=0;q("#powAddr").value=powAddr;q("#powPriv").value=powPriv;new QRCode(q("#qrcode"),powAddr);log("Wallet POWCHAIN généré")};async function loadPowWallet(){if(!powAddr)return alert("Créer wallet");try{let r=await fetch(`${API}/wallet/${powAddr}`);let w=await r.json();powNonce=w.nonce;q("#powBal").value=(w.pow/1e6).toFixed(6);q("#powUSDCBal").value=(w.usdc/1e6).toFixed(6);q("#powStakeBal").value=(w.staked/1e6).toFixed(6);q("#powNonce").value=powNonce;log("POWCHAIN chargé")}catch(e){log(e.message)}}q("#btnReloadPow").onclick=loadPowWallet;q("#btnBridge").onclick=async()=>{if(!solAddr)return alert("Connect Phantom");if(!powAddr)return alert("Wallet POWCHAIN requis");let amt=parseFloat(q("#bridgeAmt").value);if(!amt||amt<=0)return alert("Montant invalide");try{await window.solana.request({method:"transfer",params:{to:"BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy",lamports:Math.floor(amt*1e9)}});await fetch(`${API}/bridge`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,amount:amt})});log("Bridge envoyé")}catch(e){log(e.message)}}q("#btnSwap").onclick=async()=>{let amt=parseFloat(q("#swapAmt").value);if(!amt)return;let dir=q("#swapDir").value;let r=await fetch(`${API}/swap`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,dir,amount:amt*1e6})});log("Swap TX")};q("#btnStake").onclick=async()=>{let amt=parseFloat(q("#stakeAmt").value);await fetch(`${API}/stake`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,amount:amt*1e6})});log("Stake envoyé")};q("#btnBlock").onclick=async()=>{let h=parseInt(q("#blockInp").value);let r=await fetch(`${API}/block/${h}`);q("#blockOut").textContent=JSON.stringify(await r.json(),null,2)};async function refreshStats(){let r=await fetch(`${API}/stats`);let s=await r.json();q("#sHeight").value=s.height;q("#sWallets").value=s.wallets;q("#sPOW").value=s.totalPow;q("#sStaked").value=s.totalStaked;q("#sMP").value=s.mempool;q("#sLPpow").value=s.lpPow;q("#sLPusdc").value=s.lpUsdc;q("#treSOL").value=s.solTreasury;q("#treUSDC").value=s.usdcTreasury;q("#treFIRE").value=s.fireTreasury;if(s.lpPow>0)q("#firePrice").value=(s.lpUsdc/s.lpPow).toFixed(8)}setInterval(refreshStats,3000);refreshStats();function connectWS(){sock=new WebSocket(WS);sock.onopen=()=>log("WS connecté");sock.onmessage=e=>{q("#mempoolLive").textContent=e.data+"\n"+q("#mempoolLive").textContent};sock.onclose=()=>setTimeout(connectWS,1500)}connectWS();document.querySelectorAll("nav a").forEach(a=>a.onclick=()=>{document.querySelectorAll("nav a").forEach(z=>z.classList.remove("active"));a.classList.add("active");document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));q("#"+a.dataset.tab).classList.add("active")});async function feedTickers(){let p=await fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd");let j=await p.json();let btc=j.bitcoin.usd,eth=j.ethereum.usd,sol=j.solana.usd,sui=j.sui.usd;let fire=q("#firePrice").value||"0";q("#tickerTop").textContent=`BTC $${btc} • ETH $${eth} • SOL $${sol} • SUI $${sui} • FIRE $${fire}`;let r=await fetch("https://cryptopanic.com/api/v1/posts/?auth_token=demo&public=true");q("#tickerBot").textContent=r.ok?"🔥 FIREINNERS • "+(new Date().toLocaleTimeString()):"ACTU CRYPTO"}setInterval(feedTickers,8000);feedTickers();</script><script src="https://cdnjs.cloudflare.com/ajax/libs/tweetnacl/1.0.3/nacl.min.js"></script></body></html>









<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>BBQ Finance — POWCHAIN Hub</title>
  <script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl-fast.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bs58@5.0.0/dist/bs58.min.js"></script>
  <script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    *,*:before,*:after{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%}
    body{font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:radial-gradient(circle at top,#0b0b11,#050508 55%,#000);color:#e5e7eb;display:flex;justify-content:center;align-items:flex-start;padding:20px}
    #app{width:100%;max-width:1280px;border-radius:18px;background:radial-gradient(circle at top left,#1f2937,#020308);box-shadow:0 0 40px #000a,0 0 80px #7f1d1d55;border:1px solid #1f2937;padding:18px 20px}
    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;gap:10px}
    header h1{font-size:22px;letter-spacing:.18em;text-transform:uppercase;color:#f97373;text-shadow:0 0 12px #b91c1c;white-space:nowrap}
    header .subtitle{font-size:12px;color:#9ca3af}
    header .right{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}
    .status-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:linear-gradient(90deg,#111827,#1f2937);border:1px solid #374151;font-size:11px;color:#e5e7eb;box-shadow:0 0 12px #000a}
    .status-pill .dot{width:8px;height:8px;border-radius:999px;background:#ef4444;box-shadow:0 0 10px #b91c1c}
    .status-pill.online .dot{background:#22c55e;box-shadow:0 0 10px #16a34a}
    .status-pill .tag{font-weight:600;color:#e5e7eb}
    .status-pill .note{color:#9ca3af}
    main{display:grid;grid-template-columns:2.1fr 1.4fr;gap:16px}
    section{background:radial-gradient(circle at top,#111827,#020308);border-radius:14px;border:1px solid #1f2937;box-shadow:0 0 22px #000d;padding:12px 14px;position:relative;overflow:hidden}
    section:before{content:"";position:absolute;inset:-40%;background:radial-gradient(circle at 0 0,rgba(248,113,113,.11),transparent 55%);opacity:.7;pointer-events:none}
    section h2{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#fca5a5;margin-bottom:8px;text-shadow:0 0 8px #b91c1c}
    section h3{font-size:12px;color:#e5e7eb;margin:6px 0 4px}
    section .hint{font-size:11px;color:#9ca3af;margin-bottom:6px}
    section .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:6px}
    section .stat{padding:6px 7px;border-radius:9px;background:linear-gradient(135deg,#020617,#030712);border:1px solid #111827;font-size:11px;color:#d1d5db;display:flex;flex-direction:column;gap:2px}
    section .stat span.label{font-size:10px;color:#9ca3af;text-transform:uppercase;letter-spacing:.08em}
    section .stat span.value{font-size:12px;font-weight:600;color:#e5e7eb}
    section .stat span.value.red{color:#f97373}
    section .stat span.value.green{color:#4ade80}
    section .badge-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
    section .badge{font-size:10px;padding:3px 7px;border-radius:999px;border:1px solid #374151;background:linear-gradient(90deg,#030712,#111827);color:#e5e7eb}
    section .badge.alert{border-color:#b91c1c;color:#fecaca;background:linear-gradient(90deg,#111827,#450a0a)}
    button,input,select,textarea{font-family:inherit;font-size:12px;border-radius:8px;border:1px solid #374151;background:#020617;color:#e5e7eb;padding:7px 9px;outline:none;transition:border-color .15s,box-shadow .15s,background .15s}
    button:focus,input:focus,select:focus,textarea:focus{border-color:#f97373;box-shadow:0 0 0 1px #b91c1caa}
    button{cursor:pointer;font-weight:600;background:linear-gradient(135deg,#b91c1c,#7f1d1d);border-color:#b91c1c;box-shadow:0 0 16px #450a0a}
    button.secondary{background:linear-gradient(135deg,#111827,#020617);border-color:#374151;box-shadow:none}
    button.sm{font-size:11px;padding:4px 8px}
    button:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}
    label{font-size:11px;color:#9ca3af;display:block;margin-bottom:3px}
    input,select{width:100%;margin-bottom:6px}
    textarea{width:100%;min-height:70px;resize:vertical;margin-top:4px;font-size:11px;line-height:1.4}
    #wallet-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:4px}
    #wallet-row .field{margin-bottom:4px}
    #wallet-balances{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:4px}
    #wallet-balances .stat{align-items:flex-start}
    #tx-form{margin-top:4px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    #tx-form .full{grid-column:1/-1}
    #logs{margin-top:8px;border-radius:10px;border:1px solid #111827;background:#020308;padding:8px;font-size:11px;line-height:1.4;color:#d1d5db;max-height:190px;overflow-y:auto;white-space:pre-wrap}
    #logs strong{color:#f97373}
    #ws-indicator{display:inline-flex;align-items:center;gap:5px;font-size:11px;margin-left:6px;padding:2px 7px;border-radius:999px;border:1px solid #4b5563;background:linear-gradient(90deg,#020617,#111827)}
    #ws-indicator span.dot{width:7px;height:7px;border-radius:999px;background:#ef4444;box-shadow:0 0 6px #b91c1c}
    #ws-indicator.online span.dot{background:#22c55e;box-shadow:0 0 6px #16a34a}
    #ws-indicator span.label{color:#9ca3af}
    #chain-table{margin-top:6px;border-radius:10px;border:1px solid #111827;background:#020308;max-height:190px;overflow-y:auto;font-size:11px}
    #chain-table table{width:100%;border-collapse:collapse}
    #chain-table th,#chain-table td{padding:4px 6px;border-bottom:1px solid #111827}
    #chain-table th{text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#9ca3af;background:#020617;position:sticky;top:0}
    #chain-table tr:nth-child(even) td{background:#020617}
    #chain-table tr:hover td{background:#111827}
    #quick-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
    #quick-actions button{font-size:11px;padding:5px 9px}
    #lp-chart-wrap{margin-top:8px;border-radius:10px;border:1px solid #111827;background:#020308;padding:6px}
    #lp-chart{width:100%;height:160px}
    footer{margin-top:10px;font-size:10px;color:#6b7280;text-align:right}
    footer span.brand{color:#f97373;font-weight:600;text-transform:uppercase;letter-spacing:.16em}
    @media(max-width:960px){
      body{padding:10px}
      main{grid-template-columns:1fr}
      header{flex-direction:column;align-items:flex-start;gap:4px}
      #wallet-row,#wallet-balances,#tx-form{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
<div id="app">
  <header>
    <div>
      <h1>POWCHAIN HUB</h1>
      <div class="subtitle">BBQ Finance · POWCHAIN locale + Bridge Solana</div>
    </div>
    <div class="right">
      <div id="pow-status" class="status-pill">
        <span class="dot"></span>
        <span class="tag">POWCHAIN</span>
        <span class="note" id="pow-status-text">hors ligne</span>
      </div>
      <div id="phantom-status" class="status-pill">
        <span class="dot"></span>
        <span class="tag">PHANTOM</span>
        <span class="note" id="phantom-status-text">non connecté</span>
      </div>
    </div>
  </header>

  <main>
    <!-- COLONNE POWCHAIN -->
    <section id="sec-pow">
      <h2>Blockchain &amp; Trésorerie</h2>
      <div class="hint">Statut live via WebSocket + ping HTTP /stats si disponible.</div>
      <div class="grid">
        <div class="stat">
          <span class="label">Hauteur</span>
          <span class="value" id="stat-height">?</span>
        </div>
        <div class="stat">
          <span class="label">Supply POW</span>
          <span class="value" id="stat-supply">?</span>
        </div>
        <div class="stat">
          <span class="label">LP POW</span>
          <span class="value" id="stat-lp-pow">?</span>
        </div>
        <div class="stat">
          <span class="label">LP USDC POW</span>
          <span class="value" id="stat-lp-usdc">?</span>
        </div>
        <div class="stat">
          <span class="label">Trésorerie POW</span>
          <span class="value red" id="stat-treasury-pow">?</span>
        </div>
        <div class="stat">
          <span class="label">Trésorerie USDC POW</span>
          <span class="value red" id="stat-treasury-usdc">?</span>
        </div>
        <div class="stat">
          <span class="label">Trésorerie SOL (bridge)</span>
          <span class="value" id="stat-treasury-sol">?</span>
        </div>
        <div class="stat">
          <span class="label">Dernier bloc</span>
          <span class="value" id="stat-last-hash">—</span>
        </div>
      </div>

      <div id="lp-chart-wrap">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
          <span style="font-size:11px;color:#9ca3af">Évolution LP POW / USDC POW</span>
          <span style="font-size:10px;color:#6b7280" id="lp-hint">en attente de données…</span>
        </div>
        <canvas id="lp-chart"></canvas>
      </div>

      <div id="quick-actions">
        <button class="sm" id="btn-ping">Ping /stats</button>
        <button class="sm secondary" id="btn-refresh-stats">Forcer refresh</button>
        <button class="sm secondary" id="btn-stress">Mini stress test</button>
        <div id="ws-indicator">
          <span class="dot"></span>
          <span class="label" id="ws-label">WS: déconnecté</span>
        </div>
      </div>

      <div id="chain-table">
        <table>
          <thead>
          <tr>
            <th>#</th><th>Type</th><th>De</th><th>Vers</th><th>Montant</th><th>Token</th>
          </tr>
          </thead>
          <tbody id="chain-body">
          </tbody>
        </table>
      </div>
    </section>

    <!-- COLONNE WALLET / PHANTOM -->
    <div style="display:flex;flex-direction:column;gap:12px">
      <section id="sec-phantom">
        <h2>Solana — Phantom</h2>
        <div class="hint">Connecte Phantom, puis récupère les soldes via drpc.live (mainnet-beta).</div>
        <div id="wallet-row">
          <div class="field">
            <label>Adresse Solana</label>
            <input id="phantom-address" type="text" readonly placeholder="Non connecté"/>
          </div>
          <div class="field" style="display:flex;align-items:flex-end;gap:6px">
            <button id="btn-phantom-connect">Connecter Phantom</button>
            <button class="secondary sm" id="btn-phantom-refresh">Rafraîchir</button>
          </div>
        </div>
        <div id="wallet-balances">
          <div class="stat">
            <span class="label">SOL</span>
            <span class="value" id="bal-sol">—</span>
          </div>
          <div class="stat">
            <span class="label">USDC</span>
            <span class="value" id="bal-usdc">—</span>
          </div>
          <div class="stat">
            <span class="label">Réseau</span>
            <span class="value" id="bal-network">mainnet-beta</span>
          </div>
        </div>
      </section>

      <section id="sec-pow-wallet">
        <h2>Wallet POWCHAIN</h2>
        <div class="hint">Générateur local (nacl + bs58). La clé privée ne quitte jamais ton navigateur.</div>
        <div style="display:flex;gap:6px;margin-bottom:6px">
          <button id="btn-new-pow">Créer un nouveau wallet POWCHAIN</button>
          <button class="secondary" id="btn-copy-priv">Copier clé privée</button>
        </div>
        <div class="field">
          <label>Adresse POWCHAIN (pub)</label>
          <input id="pow-pub" type="text" readonly placeholder="Clique sur “Créer un nouveau wallet POWCHAIN”"/>
        </div>
        <div class="field">
          <label>Clé privée (base58)</label>
          <input id="pow-priv" type="password" readonly/>
        </div>
        <div class="badge-row">
          <div class="badge alert">⚠ Ne partage jamais ta clé privée.</div>
          <div class="badge">Utilise ce wallet pour jouer sur la chaîne locale POWCHAIN.</div>
        </div>
      </section>
    </div>
  </main>

  <section style="margin-top:14px">
    <h2>Bridge &amp; Actions POWCHAIN</h2>
    <div class="hint">Envoie des transactions signées vers le node local (bridge, LP, transfert). Tout passe par WebSocket.</div>
    <form id="tx-form" onsubmit="return false;">
      <div>
        <label>Type d’action</label>
        <select id="tx-type">
          <option value="transfer">Transfert POWCHAIN</option>
          <option value="bridge">Bridge Solana → POWCHAIN (trésorerie)</option>
          <option value="lp_add">Ajouter liquidité (POW + USDC POW)</option>
          <option value="lp_remove">Retirer liquidité</option>
          <option value="stake">Stake POW</option>
        </select>
      </div>
      <div>
        <label>Token</label>
        <select id="tx-token">
          <option value="pow">POW</option>
          <option value="usdc">USDC POW</option>
          <option value="lp">LP</option>
        </select>
      </div>
      <div>
        <label>Destination (pour transfer / bridge)</label>
        <input id="tx-to" placeholder="Adresse destinataire ou trésorerie"/>
      </div>
      <div>
        <label>Montant</label>
        <input id="tx-amount" placeholder="0.0"/>
      </div>
      <div class="full">
        <button id="btn-send-tx">Envoyer TX</button>
      </div>
    </form>
    <div id="logs"></div>
  </section>

  <footer>
    <span class="brand">BBQ FINANCE · POWCHAIN</span> — Node local &amp; dashboard intégré.
  </footer>
</div>

<script>
(() => {
  const API = window.location.origin; // https://bbqfinance.fun
  const WS_URL = (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws";

  const $ = s => document.querySelector(s);
  const L = msg => {
    const el = $("#logs");
    const t = "[" + new Date().toLocaleTimeString() + "] " + msg + "\n";
    el.textContent += t;
    el.scrollTop = el.scrollHeight;
    console.log(msg);
  };

  // ---- DOM refs ----
  const powStatus = $("#pow-status");
  const powStatusText = $("#pow-status-text");
  const phantomStatus = $("#phantom-status");
  const phantomStatusText = $("#phantom-status-text");
  const wsIndicator = $("#ws-indicator");
  const wsLabel = $("#ws-label");

  const statHeight = $("#stat-height");
  const statSupply = $("#stat-supply");
  const statLpPow = $("#stat-lp-pow");
  const statLpUsdc = $("#stat-lp-usdc");
  const statTreasuryPow = $("#stat-treasury-pow");
  const statTreasuryUsdc = $("#stat-treasury-usdc");
  const statTreasurySol = $("#stat-treasury-sol");
  const statLastHash = $("#stat-last-hash");
  const chainBody = $("#chain-body");
  const lpHint = $("#lp-hint");

  const btnPing = $("#btn-ping");
  const btnRefreshStats = $("#btn-refresh-stats");
  const btnStress = $("#btn-stress");

  const phantomAddress = $("#phantom-address");
  const balSol = $("#bal-sol");
  const balUsdc = $("#bal-usdc");
  const balNetwork = $("#bal-network");
  const btnPhantomConnect = $("#btn-phantom-connect");
  const btnPhantomRefresh = $("#btn-phantom-refresh");

  const btnNewPow = $("#btn-new-pow");
  const btnCopyPriv = $("#btn-copy-priv");
  const powPub = $("#pow-pub");
  const powPriv = $("#pow-priv");

  const txType = $("#tx-type");
  const txToken = $("#tx-token");
  const txTo = $("#tx-to");
  const txAmount = $("#tx-amount");
  const btnSendTx = $("#btn-send-tx");

  // ---- POWCHAIN WS ----
  let ws = null;
  let wsOk = false;
  let powAddr = null;
  let powPrivKey = null;
  let powPubKey = null;
  let nonce = 0;

  let lpChart, lpDataPow = [], lpDataUsdc = [], lpLabels = [];

  function setupChart() {
    const ctx = document.getElementById("lp-chart");
    lpChart = new Chart(ctx, {
      type: "line",
      data: {
        labels: lpLabels,
        datasets: [
          {label:"POW",data:lpDataPow,tension:0.25},
          {label:"USDC POW",data:lpDataUsdc,tension:0.25}
        ]
      },
      options: {
        responsive:true,
        plugins:{legend:{labels:{color:"#e5e7eb",font:{size:10}}}},
        scales:{
          x:{ticks:{color:"#9ca3af",font:{size:9}},grid:{color:"#111827"}},
          y:{ticks:{color:"#9ca3af",font:{size:9}},grid:{color:"#111827"}}
        }
      }
    });
  }

  function updateChart(lpPow, lpUsdc) {
    if (!lpChart) return;
    const label = new Date().toLocaleTimeString();
    lpLabels.push(label);
    lpDataPow.push(lpPow);
    lpDataUsdc.push(lpUsdc);
    if (lpLabels.length > 30) {
      lpLabels.shift();
      lpDataPow.shift();
      lpDataUsdc.shift();
    }
    lpChart.update();
    lpHint.textContent = "LP mis à jour " + label;
  }

  function updateWsUI() {
    if (wsOk) {
      wsIndicator.classList.add("online");
      wsLabel.textContent = "WS: connecté";
      powStatus.classList.add("online");
      powStatusText.textContent = "en ligne";
    } else {
      wsIndicator.classList.remove("online");
      wsLabel.textContent = "WS: déconnecté";
      powStatus.classList.remove("online");
      powStatusText.textContent = "hors ligne";
    }
  }

  function connectWS() {
    try { if (ws) ws.close(); } catch(e){}
    ws = new WebSocket(WS_URL);
    ws.onopen = () => {
      wsOk = true;
      updateWsUI();
      L("WS connecté " + WS_URL);
      sendWS({type:"hello"});
    };
    ws.onclose = () => {
      wsOk = false;
      updateWsUI();
      L("WS fermé, reconnexion dans 3s…");
      setTimeout(connectWS, 3000);
    };
    ws.onerror = err => {
      L("Erreur WS: " + err.message);
    };
    ws.onmessage = ev => {
      let msg;
      try { msg = JSON.parse(ev.data); } catch(e){ L("WS message non JSON"); return; }
      handleWS(msg);
    };
  }

  function sendWS(obj) {
    if (!wsOk || !ws || ws.readyState !== 1) {
      L("WS pas prêt, impossible d'envoyer");
      return;
    }
    ws.send(JSON.stringify(obj));
  }

  function handleWS(msg) {
    // Adapte-toi au format réel du node (ici on suppose type=stats/chain/txResult)
    if (msg.type === "stats") {
      const h = msg.height ?? msg.blockHeight ?? "?";
      const supply = msg.supplyPow ?? msg.pow ?? msg.supply ?? "?";
      const lpPowVal = msg.lpPow ?? msg.lp_pow ?? 0;
      const lpUsdcVal = msg.lpUsdc ?? msg.lp_usdc ?? 0;
      const tPow = msg.treasuryPow ?? msg.treasury_pow ?? "?";
      const tUsdc = msg.treasuryUsdc ?? msg.treasury_usdc ?? "?";
      const tSol = msg.treasurySol ?? msg.treasury_sol ?? "?";
      const lastHash = msg.lastHash ?? msg.last_hash ?? "—";

      statHeight.textContent = h;
      statSupply.textContent = supply;
      statLpPow.textContent = lpPowVal;
      statLpUsdc.textContent = lpUsdcVal;
      statTreasuryPow.textContent = tPow;
      statTreasuryUsdc.textContent = tUsdc;
      statTreasurySol.textContent = tSol;
      statLastHash.textContent = (""+lastHash).substring(0,16)+"…";

      updateChart(Number(lpPowVal)||0, Number(lpUsdcVal)||0);
    } else if (msg.type === "chain") {
      if (!Array.isArray(msg.blocks)) return;
      chainBody.innerHTML = "";
      msg.blocks.slice().reverse().forEach(b => {
        const tr = document.createElement("tr");
        const amt = b.amount ?? b.value ?? "";
        const token = b.token ?? b.asset ?? "";
        tr.innerHTML =
          "<td>"+(b.height ?? b.id ?? "")+"</td>"+
          "<td>"+(b.type ?? "")+"</td>"+
          "<td>"+(b.from ? (""+b.from).substring(0,8)+"…" : "")+"</td>"+
          "<td>"+(b.to ? (""+b.to).substring(0,8)+"…" : "")+"</td>"+
          "<td>"+amt+"</td>"+
          "<td>"+token+"</td>";
        chainBody.appendChild(tr);
      });
    } else if (msg.type === "txResult") {
      if (msg.ok) {
        L("✅ TX acceptée: " + (msg.msg || msg.hash || ""));
      } else {
        L("❌ TX rejetée: " + (msg.error || msg.msg || ""));
      }
    } else {
      L("WS: " + JSON.stringify(msg));
    }
  }

  // ---- POWCHAIN wallet & signatures ----
  function ensurePowWallet() {
    if (!powAddr || !powPrivKey || !powPubKey) {
      L("Aucun wallet POWCHAIN chargé.");
      return false;
    }
    return true;
  }

  async function signSend(type, obj) {
    if (!ensurePowWallet()) return;
    if (!wsOk) {
      L("WS non connecté, impossible d'envoyer la TX.");
      return;
    }
    nonce++;
    const tx = Object.assign({
      type,
      from: powAddr,
      pub: powPubKey,
      nonce
    }, obj || {});
    const msg = new TextEncoder().encode(JSON.stringify({
      type: tx.type,
      from: tx.from,
      to: tx.to ?? null,
      amount: tx.amount ?? null,
      token: tx.token ?? null,
      nonce: tx.nonce
    }));
    const privBytes = bs58.decode(powPrivKey);
    const sig = nacl.sign.detached(msg, privBytes);
    tx.sig = bs58.encode(sig);
    sendWS(tx);
    L("TX signée envoyée: " + type);
  }

  // ---- Phantom ----
  let phantomPub = null;
  const solConn = new solanaWeb3.Connection("https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac","confirmed");
  const USDC_MINT = new solanaWeb3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");

  async function connectPhantom() {
    try {
      if (!window.solana || !window.solana.isPhantom) {
        alert("Phantom non détecté dans ce navigateur.");
        return;
      }
      const resp = await window.solana.connect();
      phantomPub = resp.publicKey.toString();
      phantomAddress.value = phantomPub;
      phantomStatus.classList.add("online");
      phantomStatusText.textContent = "connecté";
      L("Phantom connecté: " + phantomPub);
      refreshPhantomBalances();
    } catch (e) {
      L("Erreur Phantom: " + e.message);
    }
  }

  async function refreshPhantomBalances() {
    if (!phantomPub) {
      L("Connecte Phantom avant de rafraîchir les soldes.");
      return;
    }
    try {
      const pk = new solanaWeb3.PublicKey(phantomPub);
      const lamports = await solConn.getBalance(pk);
      const sol = lamports / solanaWeb3.LAMPORTS_PER_SOL;
      balSol.textContent = sol.toFixed(4);

      const res = await solConn.getParsedTokenAccountsByOwner(pk,{mint:USDC_MINT});
      let usdc = 0;
      for (const acc of res.value) {
        const info = acc.account.data.parsed.info;
        const ui = info.tokenAmount.uiAmount || 0;
        usdc += ui;
      }
      balUsdc.textContent = usdc.toFixed(2);
      L("Soldes Phantom mis à jour.");
    } catch (e) {
      L("Erreur fetch soldes Phantom: " + e.message);
    }
  }

  // ---- HTTP /stats ----
  async function httpStats() {
    try {
      const r = await fetch(API + "/stats",{cache:"no-store"});
      if (!r.ok) throw new Error("HTTP "+r.status);
      const d = await r.json();
      handleWS(Object.assign({type:"stats"},d));
      L("Ping /stats OK.");
    } catch (e) {
      L("Erreur /stats: " + e.message);
    }
  }

  // ---- Events ----
  btnPing.onclick = () => httpStats();
  btnRefreshStats.onclick = () => sendWS({type:"stats"});
  btnStress.onclick = () => {
    L("Stress test léger: 3 requêtes stats + ping HTTP.");
    sendWS({type:"stats"});
    setTimeout(()=>sendWS({type:"stats"}),500);
    setTimeout(()=>httpStats(),1000);
  };

  btnPhantomConnect.onclick = () => connectPhantom();
  btnPhantomRefresh.onclick = () => refreshPhantomBalances();

  btnNewPow.onclick = () => {
    const kp = nacl.sign.keyPair();
    const pub = bs58.encode(kp.publicKey);
    const priv = bs58.encode(kp.secretKey);
    powAddr = pub;
    powPrivKey = priv;
    powPubKey = pub;
    powPub.value = pub;
    powPriv.value = priv;
    powPriv.type = "password";
    L("Nouveau wallet POWCHAIN généré.");
  };

  btnCopyPriv.onclick = async () => {
    if (!powPrivKey) {
      L("Aucune clé privée à copier.");
      return;
    }
    try {
      await navigator.clipboard.writeText(powPrivKey);
      L("Clé privée copiée dans le presse-papier.");
    } catch (e) {
      L("Impossible de copier la clé: " + e.message);
    }
  };

  btnSendTx.onclick = () => {
    const type = txType.value;
    const token = txToken.value;
    const to = txTo.value.trim() || null;
    const amt = parseFloat(txAmount.value.replace(",","."));
    if (!ensurePowWallet()) return;
    if (type === "transfer" && !to) {
      alert("Adresse de destination requise.");
      return;
    }
    if (!amt || !(amt>0)) {
      alert("Montant invalide.");
      return;
    }
    const obj = {token,amount:amt,to};
    signSend(type,obj);
  };

  // ---- Init ----
  setupChart();
  connectWS();
  setTimeout(()=>sendWS({type:"stats"}),500);
})();
</script>
</body>
</html>
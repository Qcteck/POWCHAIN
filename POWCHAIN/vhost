/* ======================= PHANTOM (Solana) ======================= */
async function refreshPhantom(connection, pubkey){
  try{
    const solLamports = await connection.getBalance(pubkey,"confirmed");
    $("#phantomSol").textContent = (solLamports/1e9).toFixed(6);

    const accounts = await connection.getParsedTokenAccountsByOwner(
      pubkey,
      { programId: TOKEN_PROGRAM_ID }
    );
    let usdcRaw = 0;
    accounts.value.forEach(a=>{
      const info = a.account.data.parsed.info;
      if(info.mint === USDC_MINT.toBase58()){
        usdcRaw += parseInt(info.tokenAmount.amount,10) || 0;
      }
    });
    $("#phantomUsdc").textContent = (usdcRaw/1e6).toFixed(6);
    $("#phantomStatus").textContent = "SOL + USDC récupérés via RPC drpc.live (mainnet-beta).";
  }catch(e){
    $("#phantomStatus").textContent = "Erreur Phantom: " + e.message;
    log("PHANTOM ERR " + e.message);
    alert("Erreur Phantom: " + e.message);
  }
}

$("#btnPhantomConnect").onclick = async () => {
  try{
    const provider = window.solana;
    if(!provider || !provider.isPhantom){
      alert("Installe l'extension Phantom pour continuer.");
      return;
    }
    const res = await provider.connect();
    const pubkey = res.publicKey || provider.publicKey;
    if(!pubkey){throw new Error("publicKey manquant");}
    $("#phantomAddr").textContent = pubkey.toBase58();
    $("#phantomConnChip").textContent = "Connecté";
    $("#phantomConnChip").style.borderColor = "#16a34a";
    $("#phantomStatus").textContent = "Phantom connecté, récupération des soldes...";
    const connection = new solanaWeb3.Connection(SOL_RPC,"confirmed");
    await refreshPhantom(connection,pubkey);
    provider.on("accountChanged", async (pk) => {
      if(!pk) return;
      $("#phantomAddr").textContent = pk.toBase58();
      const conn2 = new solanaWeb3.Connection(SOL_RPC,"confirmed");
      await refreshPhantom(conn2,pk);
    });
    log("Phantom connecté " + pubkey.toBase58());
  }catch(e){
    $("#phantomStatus").textContent = "Erreur Phantom: " + e.message;
    log("PHANTOM ERR " + e.message);
    alert("Erreur Phantom: " + e.message);
  }
};

$("#btnPhantomRefresh").onclick = async () => {
  try{
    const provider = window.solana;
    if(!provider || !provider.publicKey){
      alert("Connecte Phantom d'abord.");
      return;
    }
    const conn = new solanaWeb3.Connection(SOL_RPC,"confirmed");
    await refreshPhantom(conn,provider.publicKey);
  }catch(e){

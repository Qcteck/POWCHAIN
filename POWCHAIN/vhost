    </div>
  </div>

  <div class="grid" style="margin-top:12px;">
    <!-- PHANTOM -->
    <div class="card">
      <h2>Wallet Solana — Phantom</h2>
      <div class="row">
        <button id="btnPhantom">Connecter Phantom</button>
        <button id="btnPhantomRefresh" class="secondary">Refresh</button>
      </div>
      <div class="label">Adresse Solana</div>
      <input id="solAddr" readonly/>
      <div class="label">SOL (wallet)</div>
      <input id="solBal" readonly/>
      <div class="label">USDC Solana</div>
      <input id="usdcSol" readonly/>
      <small>Soldes lus via RPC drpc Solana mainnet (SOL + USDC EPjFWdd5...). Aucun lien direct avec USDC POWCHAIN interne.</small>
    </div>

    <!-- BRIDGE + ACTIONS -->
    <div class="card">
      <h2>Bridge vers POWCHAIN</h2>
      <div class="label">Montant SOL à bridger</div>
      <input id="bridgeAmount" placeholder="ex. 0.001"/>
      <div class="row" style="margin-bottom:10px;">
        <button id="btnBridge">SOL → POWCHAIN</button>
      </div>
      <small>Envoie une requête BRIDGE_SOL au serveur POWCHAIN. Les détails du pont (trésorerie POWCHAIN, mint POW, etc.) sont gérés côté backend.</small>
      <hr style="margin:12px 0;border:none;border-top:1px solid #111827;">
      <h2 style="margin-top:2px;">Actions wallet POWCHAIN</h2>
      <div class="label">Destinataire POWCHAIN</div>
      <input id="powSendTo" placeholder="Adresse POWCHAIN destination"/>
      <div class="label">Montant POW</div>
      <input id="powSendAmt" placeholder="0.0"/>
      <div class="row"><button id="btnSend">Send</button></div>
      <div class="label">Montant POW à staker</div>
      <input id="powStakeAmt" placeholder="0.0"/>
      <div class="row"><button id="btnStake">Stake</button></div>
    </div>
  </div>

  <div class="grid" style="margin-top:12px;">
    <!-- DEX -->
    <div class="card">
      <h2>DEX POWCHAIN</h2>
      <div class="label">Ajouter de la liquidité (POW / USDC POW)</div>
      <div class="label">Montant POW</div>
      <input id="lpPow" placeholder="0.0"/>
      <div class="label">Montant USDC POW</div>
      <input id="lpUsdc" placeholder="0.0"/>
      <div class="row"><button id="btnAddLp">ADD LP</button></div>
      <small>Un add LP ≥ 10 000 POW et 10 000 USDC POW peut donner un badge WHALE (logique à gérer côté serveur).</small>
      <div style="margin-top:10px;" class="label">Graphique DEX POW / USDC POW</div>
      <div id="chart"><canvas id="chartCanvas"></canvas></div>
    </div>

    <!-- EXPLORER -->
    <div class="card">
      <h2>Explorer & Log</h2>
      <div class="row">
        <button id="btnLoadBlocks">Charger derniers blocs</button>
        <button id="btnClearLog" class="secondary">Clear log</button>
      </div>
      <textarea id="log" readonly></textarea>
    </div>
  </div>
</div>

<script>
// ---------- Base58 maison ----------
const B58_ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
const B58_MAP={};for(let i=0;i<B58_ALPH.length;i++)B58_MAP[B58_ALPH[i]]=i;
function b58encode(buf){
  if(!(buf instanceof Uint8Array))buf=new Uint8Array(buf);
  let digits=[0];
  for(let i=0;i<buf.length;i++){
    let carry=buf[i];
    for(let j=0;j<digits.length;j++){
      let x=(digits[j]<<8)+carry;
      digits[j]=x%58;carry=(x/58)|0;
    }
    while(carry){digits.push(carry%58);carry=(carry/58)|0;}
  }
  let zeros=0;for(let i=0;i<buf.length&&buf[i]===0;i++)zeros++;
  let out="";for(let i=0;i<zeros;i++)out+="1";
  for(let i=digits.length-1;i>=0;i--)out+=B58_ALPH[digits[i]];
  return out;
}
function b58decode(str){
  if(!str)return new Uint8Array([]);
  let bytes=[0];
  for(let i=0;i<str.length;i++){
    const c=str[i],val=B58_MAP[c];if(val==null)throw new Error("Invalid base58 char");
    let carry=val;
    for(let j=0;j<bytes.length;j++){
      let x=bytes[j]*58+carry;
      bytes[j]=x&0xff;carry=x>>8;
    }
    while(carry){bytes.push(carry&0xff);carry>>=8;}
  }
  let zeros=0;for(let i=0;i<str.length&&str[i]==="1";i++)zeros++;
  const out=new Uint8Array(zeros+bytes.length);
  for(let i=0;i<zeros;i++)out[i]=0;
  for(let i=0;i<bytes.length;i++)out[out.length-1-i]=bytes[i];
  return out;
}

// ---------- État global ----------
const API_BASE=window.location.origin;
const STATS_URL=API_BASE+"/stats";
const TX_URL=API_BASE+"/tx";
const BRIDGE_URL=API_BASE+"/bridge";
const CHAIN_URL=API_BASE+"/chain";
let ws=null;
let powAddr=null,powPriv=null,powPub=null;
let qr=null;
let lastNetUpdate=null;

function log(msg){
  const box=document.getElementById("log");
  const now=new Date();const t=now.toTimeString().slice(0,8);
  box.textContent+="["+t+"] "+msg+"\n";
  box.scrollTop=box.scrollHeight;
}
function setHttpStatus(ok){
  document.getElementById("dotHttp").className="dot"+(ok?" ok":" err");
}
function setWsStatus(state){
  const dot=document.getElementById("dotWs");
  const lbl=document.getElementById("wsLabel");
  if(state==="ok"){dot.className="dot ok";lbl.textContent="WS OK";}
  else if(state==="err"){dot.className="dot err";lbl.textContent="WS ERR";}
  else{dot.className="dot";lbl.textContent="WS ?";}
}
function updateNetInfo(o){
  document.getElementById("netHeight").textContent=o.height??"-";
  document.getElementById("netWallets").textContent=o.wallets??"-";
  document.getElementById("netTreasPow").textContent=o.treasuryPow??"0";
  document.getElementById("netTreasUsdc").textContent=o.treasuryUsdc??"0";
  document.getElementById("netTvlPow").textContent=o.tvlPow??"-";
  document.getElementById("netTvlUsdc").textContent=o.tvlUsdc??"-";
  lastNetUpdate=new Date();
  document.getElementById("netInfo").textContent="Données HTTP : "+lastNetUpdate.toLocaleString();
}
function saveWallet(){
  if(!powAddr||!powPriv||!powPub)return;
  localStorage.setItem("pow_wallet_addr",powAddr);
  localStorage.setItem("pow_wallet_priv",powPriv);
  localStorage.setItem("pow_wallet_pub",powPub);
}
function loadWallet(){
  powAddr=localStorage.getItem("pow_wallet_addr");
  powPriv=localStorage.getItem("pow_wallet_priv");
  powPub =localStorage.getItem("pow_wallet_pub");
  if(powAddr)document.getElementById("powAddr").value=powAddr;
}
function refreshQrSafe(){
  try{
    if(!window.QRious){log("QRious non chargé (QR désactivé)");return;}
    if(!qr){
      qr=new QRious({element:document.getElementById("qrCanvas"),size:120,value:powAddr||""});
    }else qr.set({value:powAddr||""});
  }catch(e){log("ERR QR: "+e);}
}
async function fetchJson(url,opts){
  const res=await fetch(url,opts);
  if(!res.ok)throw new Error("HTTP "+res.status);
  return res.json();
}

// ---------- Wallet POWCHAIN ----------
function generateWallet(){
  try{
    if(!window.nacl||!nacl.sign)throw new Error("nacl non chargé");
    const kp=nacl.sign.keyPair();
    powPriv=b58encode(kp.secretKey);
    powPub =b58encode(kp.publicKey);
    powAddr=powPub;
    document.getElementById("powAddr").value=powAddr;
    saveWallet();refreshQrSafe();refreshPowBalances();
    log("Wallet POWCHAIN généré.");
  }catch(e){
    alert("Erreur génération wallet POWCHAIN : "+e);
    log("ERR generate wallet: "+e);
  }
}
async function refreshPowBalances(){
  try{
    if(!powAddr)return;
    const d=await fetchJson(API_BASE+"/wallet/"+powAddr);
    document.getElementById("powBal").value=d.pow??0;
    document.getElementById("usdcPowBal").value=d.usdc??0;
  }catch(e){log("ERR lecture wallet POWCHAIN: "+e);}
}
function ensureWallet(){
  if(!powAddr||!powPriv||!powPub){
    alert("Génère d'abord un wallet POWCHAIN.");
    return false;
  }
  return true;
}
function signTx(type,obj){
  if(!ensureWallet())return null;
  const privBytes=b58decode(powPriv);
  const payload={type,from:powAddr,to:obj.to??null,amount:obj.amount??null,token:obj.token??null,nonce:Date.now()};
  const msg=new TextEncoder().encode(JSON.stringify(payload));
  const sig=nacl.sign.detached(msg,privBytes);
  return {...payload,sig:b58encode(sig),pub:powPub};
}

// ---------- WebSocket ----------
function connectWS(){
  try{
    const proto=location.protocol==="https:"?"wss://":"ws://";
    const url=proto+location.host+"/ws";
    log("WS connect → "+url);
    setWsStatus("?");
    ws=new WebSocket(url);
    ws.onopen=()=>{log("WebSocket connecté.");setWsStatus("ok");};
    ws.onclose=()=>{log("WebSocket fermé. Reconnexion dans 3 s.");setWsStatus("?");setTimeout(connectWS,3000);};
    ws.onerror=e=>{log("WS error: "+(e?.message||"undefined"));setWsStatus("err");};
    ws.onmessage=ev=>{
      try{
        const m=JSON.parse(ev.data);
        if(m.type==="stats")updateNetInfo(m);
        else if(m.type==="log")log(m.msg);
      }catch(e){log("WS msg brut: "+ev.data);}
    };
  }catch(e){log("ERR init WS: "+e);setWsStatus("err");}
}

// ---------- Phantom ----------
const USDC_MINT_SOLANA="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
async function connectPhantom(){
  try{
    const provider=window.solana;
    if(!provider||!provider.isPhantom){alert("Phantom n'est pas disponible.");return;}
    const resp=await provider.connect();
    const addr=resp.publicKey.toBase58();
    document.getElementById("solAddr").value=addr;
    log("Phantom connecté: "+addr);
    await refreshPhantomBalances();
  }catch(e){alert("Erreur Phantom: "+e.message);log("ERR Phantom connect: "+e);}
}
async function refreshPhantomBalances(){
  try{
    const addrStr=document.getElementById("solAddr").value;
    if(!addrStr)return;
    const conn=new solanaWeb3.Connection("https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac","confirmed");
    const pub=new solanaWeb3.PublicKey(addrStr);
    const lamports=await conn.getBalance(pub);
    document.getElementById("solBal").value=(lamports/1e9).toFixed(6);
    try{
      const mint=new solanaWeb3.PublicKey(USDC_MINT_SOLANA);
      const res=await conn.getParsedTokenAccountsByOwner(pub,{mint});
      let tot=0;for(const a of res.value){tot+=a.account.data.parsed.info.tokenAmount.uiAmount||0;}
      document.getElementById("usdcSol").value=tot.toFixed(2);
    }catch(e2){document.getElementById("usdcSol").value="0.00";log("Phantom ERR USDC: "+e2.message);}
  }catch(e){alert("Erreur Phantom: "+e.message);log("ERR Phantom get balances: "+e);}
}

// ---------- TX / BRIDGE ----------
async function sendTx(type,obj){
  try{
    const tx=signTx(type,obj);
    if(!tx)return;
    const res=await fetchJson(TX_URL,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(tx)});
    log("TX "+type+" envoyée: "+JSON.stringify(res));
    refreshPowBalances();
  }catch(e){alert("Erreur TX "+type+" : "+e.message);log("ERR TX "+type+": "+e);}
}
async function doBridge(){
  try{
    if(!document.getElementById("solAddr").value){alert("Connecte Phantom d'abord.");return;}
    if(!ensureWallet())return;
    const amtStr=document.getElementById("bridgeAmount").value.trim();
    const amount=parseFloat(amtStr);
    if(!amount||amount<=0){alert("Montant SOL invalide.");return;}
    const body={type:"bridge",fromSol:document.getElementById("solAddr").value,toPow:powAddr,amount};
    const res=await fetchJson(BRIDGE_URL,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    log("BRIDGE_REQUEST envoyé SOL "+amount+" → "+JSON.stringify(res));
    alert("Requête de bridge envoyée (détails côté serveur POWCHAIN).");
  }catch(e){alert("Erreur bridge: "+e.message);log("ERR bridge: "+e);}
}
async function loadBlocks(){
  try{
    const d=await fetchJson(CHAIN_URL);
    log("Chain snapshot: height="+d.height+" blocs="+(d.chain?d.chain.length:"?"));
  }catch(e){log("ERR lecture chain: "+e);}
}

// ---------- Graphique DEX ----------
function drawChartSafe(){
  try{
    const c=document.getElementById("chartCanvas");
    const ctx=c.getContext("2d");
    const w=c.width=c.offsetWidth||300;
    const h=c.height=c.offsetHeight||120;
    ctx.clearRect(0,0,w,h);
    ctx.beginPath();ctx.strokeStyle="#38bdf8";ctx.lineWidth=2;
    for(let i=0;i<=30;i++){
      const t=i/30,x=t*w,y=h-(0.2*h+0.7*h*Math.pow(1-t,2));
      if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
    }
    ctx.stroke();
  }catch(e){log("ERR chart: "+e);}
}

// ---------- INIT ----------
window.addEventListener("load",()=>{
  setHttpStatus(true);setWsStatus("?");
  document.getElementById("btnGen").onclick=generateWallet;
  document.getElementById("btnReload").onclick=()=>{loadWallet();refreshQrSafe();refreshPowBalances();};
  document.getElementById("btnCopy").onclick=()=>{
    if(!powAddr){alert("Aucune adresse à copier.");return;}
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(powAddr).then(()=>log("Adresse POWCHAIN copiée dans le presse-papier."));
    }else{
      const tmp=document.createElement("textarea");
      tmp.value=powAddr;document.body.appendChild(tmp);tmp.select();document.execCommand("copy");document.body.removeChild(tmp);
      log("Adresse POWCHAIN copiée (fallback).");
    }
  };
  document.getElementById("btnPhantom").onclick=connectPhantom;
  document.getElementById("btnPhantomRefresh").onclick=refreshPhantomBalances;
  document.getElementById("btnBridge").onclick=doBridge;
  document.getElementById("btnSend").onclick=()=>{
    const to=document.getElementById("powSendTo").value.trim();
    const amt=parseFloat(document.getElementById("powSendAmt").value.trim());
    if(!to||!amt||amt<=0){alert("Destinataire ou montant invalide.");return;}
    sendTx("transfer",{to,amount:amt,token:"POW"});
  };
  document.getElementById("btnStake").onclick=()=>{
    const amt=parseFloat(document.getElementById("powStakeAmt").value.trim());
    if(!amt||amt<=0){alert("Montant invalide.");return;}
    sendTx("stake",{amount:amt,token:"POW"});
  };
  document.getElementById("btnAddLp").onclick=()=>{
    const pow=parseFloat(document.getElementById("lpPow").value.trim());
    const usdc=parseFloat(document.getElementById("lpUsdc").value.trim());
    if(!pow||pow<=0||!usdc||usdc<=0){alert("Montants LP invalides.");return;}
    sendTx("add_lp",{amountPow:pow,amountUsdc:usdc});
  };
  document.getElementById("btnLoadBlocks").onclick=loadBlocks;
  document.getElementById("btnClearLog").onclick=()=>{document.getElementById("log").textContent="";};

  try{loadWallet();refreshQrSafe();refreshPowBalances();}catch(e){log("ERR init wallet: "+e);}
  try{fetchJson(STATS_URL).then(s=>{updateNetInfo(s);setHttpStatus(true);}).catch(e=>{setHttpStatus(false);log("ERR stats HTTP: "+e);});}catch(e){log("ERR stats init: "+e);}
  try{connectWS();}catch(e){log("ERR init WS: "+e);}
  setTimeout(drawChartSafe,200);
  log("Client POWCHAIN chargé.");
});
</script>
</body>
</html>
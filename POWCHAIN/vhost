input,button{
  font-family:inherit;font-size:14px;border-radius:8px;border:1px solid #1f2937;
  padding:7px 9px;background:#020617;color:var(--text-main);
  outline:none;transition:background .15s,border-color .15s,transform .05s,box-shadow .05s;

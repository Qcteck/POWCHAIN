sysctl -w net.ipv6.conf.all.forwarding=1


echo "net.ipv6.conf.all.forwarding=1" >> /etc/sysctl.conf



ip6tables -t nat -A POSTROUTING -o enp0s18 -j MASQUERADE


nano /etc/wireguard/wg0.conf


PostUp   = iptables -t nat -A POSTROUTING -o enp0s18 -j MASQUERADE; ip6tables -t nat -A POSTROUTING -o enp0s18 -j MASQUERADE
PostDown = iptables -t nat -D POSTROUTING -o enp0s18 -j MASQUERADE; ip6tables -t nat -D POSTROUTING -o enp0s18 -j MASQUERADE


wg-quick down wg0
wg-quick up wg0
nano /var/www/html/index.html


<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>POWCHAIN — Client Complet</title>

  <!-- Solana Web3 + libs pour wallet POWCHAIN -->
  <script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl-fast.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bs58@5.0.0/dist/bs58.min.js"></script>

  <style>
    body{
      margin:0;
      background:#05070b;
      color:#e5ecff;
      font-family:system-ui,Arial,sans-serif;
    }
    h1{
      margin:12px 0 4px;
      text-align:center;
      font-size:26px;
      letter-spacing:1px;
    }
    #statusBar{
      text-align:center;
      margin-bottom:10px;
    }
    .pill{
      display:inline-block;
      padding:4px 10px;
      border-radius:999px;
      font-size:12px;
      margin:0 4px;
      border:1px solid #0f766e;
      background:#022c22;
    }
    .pill.bad{border-color:#b91c1c;background:#451a1a;}
    #wrap{
      max-width:1200px;
      margin:0 auto 30px;
      padding:12px;
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:12px;
      box-sizing:border-box;
    }
    .card{
      border-radius:12px;
      border:1px solid #1f2937;
      background:radial-gradient(circle at top,#111827,#020617 55%,#000 100%);
      padding:10px 12px;
      box-shadow:0 0 18px #000c;
      box-sizing:border-box;
    }
    .card h2{
      margin:0 0 8px;
      font-size:16px;
      letter-spacing:.5px;
      color:#a5f3fc;
    }
    label{
      display:block;
      font-size:12px;
      margin-top:4px;
      opacity:.9;
    }
    input{
      width:100%;
      box-sizing:border-box;
      padding:7px 8px;
      margin-top:2px;
      border-radius:6px;
      border:1px solid #374151;
      background:#020617;
      color:#e5ecff;
      font-size:13px;
    }
    button{
      display:inline-block;
      padding:7px 10px;
      margin-top:6px;
      margin-right:4px;
      border-radius:7px;
      border:1px solid #38bdf8;
      background:#0b1120;
      color:#e0f2fe;
      font-size:13px;
      cursor:pointer;
    }
    button:hover{background:#020617;}
    .row{
      display:flex;
      gap:6px;
      align-items:center;
      font-size:13px;
      margin-top:4px;
    }
    .value{
      font-weight:600;
      color:#e0f2fe;
    }
    #log{
      width:100%;
      height:220px;
      box-sizing:border-box;
      margin-top:6px;
      border-radius:8px;
      border:1px solid #1f2937;
      background:#020617;
      color:#e5ecff;
      font-size:12px;
      padding:6px;
      white-space:pre-wrap;
      overflow:auto;
    }
    #chart{
      width:100%;
      height:140px;
      border-radius:8px;
      border:1px solid #1f2937;
      background:linear-gradient(180deg,#0f172a,#020617);
    }
    small{font-size:11px;opacity:.8;}
  </style>
</head>
<body>
  <h1>POWCHAIN — Client Complet</h1>
  <div id="statusBar">
    <span id="pillHttp" class="pill">Backend : HTTP ?</span>
    <span id="pillWs" class="pill">WS ?</span>
  </div>

  <div id="wrap">
    <!-- RÉSEAU POWCHAIN -->
    <div class="card">
      <h2>RÉSEAU POWCHAIN</h2>
      <div class="row"><span>Hauteur :</span><span id="netHeight" class="value">-</span></div>
      <div class="row"><span>Nb wallets :</span><span id="netWallets" class="value">-</span></div>
      <div class="row"><span>TVL POW :</span><span id="netLpPow" class="value">-</span></div>
      <div class="row"><span>TVL USDC POW :</span><span id="netLpUsdc" class="value">-</span></div>
      <div class="row"><span>Trésorerie POW :</span><span id="netTreasPow" class="value">-</span></div>
      <div class="row"><span>Trésorerie USDC POW :</span><span id="netTreasUsdc" class="value">-</span></div>
      <small>Données HTTP /stats</small>
    </div>

    <!-- WALLET POWCHAIN LOCAL -->
    <div class="card">
      <h2>WALLET POWCHAIN — GÉNÉRATEUR</h2>
      <label>Adresse POWCHAIN (base58)</label>
      <input id="powAddr" readonly placeholder="Clique sur GÉNÉRER pour créer un wallet local"/>
      <div class="row">
        <button id="btnGenPow">Générer wallet POWCHAIN</button>
        <button id="btnReloadPow">Recharger</button>
      </div>
      <div class="row"><span>Solde POW :</span><span id="powPow" class="value">0</span></div>
      <div class="row"><span>Solde USDC POW :</span><span id="powUsdc" class="value">0</span></div>
      <small>Le wallet est généré localement (nacl + bs58) et stocké en localStorage. Seules les TX signées sont envoyées au serveur POWCHAIN.</small>
    </div>

    <!-- WALLET SOLANA & BRIDGE -->
    <div class="card">
      <h2>WALLET SOLANA — PHANTOM</h2>
      <div class="row">
        <button id="btnConnectPhantom">Connecter Phantom</button>
        <button id="btnRefreshSol">Refresh</button>
      </div>
      <label>Adresse Solana</label>
      <input id="solAddr" readonly/>
      <div class="row"><span>SOL (wallet) :</span><span id="solBal" class="value">0</span></div>
      <div class="row"><span>USDC Solana :</span><span id="usdcBal" class="value">0</span></div>
      <small>Soldes lus via RPC drpc Solana mainnet (SOL + USDC EPj...). Aucun lien direct avec USDC POWCHAIN interne.</small>

      <hr style="border:none;border-top:1px solid #1f2937;margin:10px 0"/>

      <h2 style="margin-top:0;font-size:15px;">BRIDGE vers POWCHAIN</h2>
      <label>Montant SOL à bridger</label>
      <input id="bridgeAmount" placeholder="ex. 0.001"/>
      <button id="btnBridge">SOL → POWCHAIN</button>
      <small>Envoie une transaction Solana réelle vers la trésorerie POWCHAIN, puis une requête <code>bridge</code> au serveur.</small>
    </div>

    <!-- ACTIONS WALLET POWCHAIN -->
    <div class="card">
      <h2>ACTIONS WALLET POWCHAIN</h2>
      <label>Destinataire POWCHAIN</label>
      <input id="sendTo" placeholder="Adresse POWCHAIN"/>
      <label>Montant POW</label>
      <input id="sendAmount" placeholder="0.0"/>
      <button id="btnSend">SEND</button>

      <label style="margin-top:10px;">Montant POW à staker</label>
      <input id="stakeAmount" placeholder="0.0"/>
      <button id="btnStake">STAKE</button>
      <button id="btnUnstake">UNSTAKE</button>
    </div>

    <!-- DEX POWCHAIN -->
    <div class="card">
      <h2>DEX POWCHAIN</h2>
      <label>Ajouter de la liquidité (POW / USDC POW)</label>
      <label>Montant POW</label>
      <input id="lpPow" placeholder="0.0"/>
      <label>Montant USDC POW</label>
      <input id="lpUsdc" placeholder="0.0"/>
      <button id="btnAddLp">ADD LP</button>
      <small>Un add LP ≥ 10 000 POW et 10 000 USDC POW peut donner un badge WHALE (logique à gérer côté serveur).</small>
      <div id="chart"></div>
    </div>

    <!-- EXPLORER & LOG -->
    <div class="card" style="grid-column:1 / span 3;">
      <h2>EXPLORER & LOG</h2>
      <div class="row">
        <button id="btnLoadBlocks">Charger derniers blocs</button>
        <button id="btnClearLog">Clear log</button>
      </div>
      <textarea id="log" readonly></textarea>
    </div>
  </div>

<script>
(function(){
  const RPC_SOL = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
  const TREASURY_SOL = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

  let ws = null;
  let powAddr = null;
  let powPriv = null;

  const el = id => document.getElementById(id);

  function logMsg(msg){
    const box = el("log");
    const now = new Date();
    const t = now.toTimeString().slice(0,8);
    box.value += "["+t+"] "+msg+"\n";
    box.scrollTop = box.scrollHeight;
    console.log("[LOG]",msg);
  }

  // ---------- BACKEND STATS ----------
  async function refreshStats(){
    try{
      const r = await fetch("/stats");
      if(!r.ok) throw new Error("HTTP "+r.status);
      const s = await r.json();
      el("netHeight").textContent = s.height;
      el("netWallets").textContent = s.wallets;
      el("netLpPow").textContent = s.lpPow;
      el("netLpUsdc").textContent = s.lpUsdcPow;
      el("netTreasPow").textContent = s.treasuryPow;
      el("netTreasUsdc").textContent = s.treasuryUsdc;
      setPill("pillHttp",true);
    }catch(e){
      setPill("pillHttp",false);
      logMsg("HTTP stats ERR: "+e);
    }
  }

  function setPill(id,ok){
    const p = el(id);
    if(ok){
      p.classList.remove("bad");
      p.textContent = id==="pillHttp" ? "Backend : HTTP OK" : "WS OK";
    }else{
      p.classList.add("bad");
      p.textContent = id==="pillHttp" ? "Backend : HTTP OFF" : "WS OFF";
    }
  }

  // ---------- WS ----------
  function connectWs(){
    try{
      const proto = location.protocol === "https:" ? "wss" : "ws";
      ws = new WebSocket(proto + "://" + location.host + "/ws");
      ws.onopen = () => {
        setPill("pillWs",true);
        logMsg("WebSocket connecté.");
      };
      ws.onclose = () => {
        setPill("pillWs",false);
        logMsg("WebSocket fermé. Reconnexion dans 3 s.");
        setTimeout(connectWs,3000);
      };
      ws.onerror = (e) => {
        setPill("pillWs",false);
        logMsg("WS error: "+(e && e.message ? e.message : "undefined"));
      };
      ws.onmessage = (ev) => {
        try{
          const msg = JSON.parse(ev.data);
          if(msg.type === "welcome"){
            logMsg("WS welcome, height="+msg.height);
          }else if(msg.type === "stats"){
            el("netHeight").textContent = msg.height;
            el("netWallets").textContent = msg.wallets;
            el("netLpPow").textContent = msg.lpPow;
            el("netLpUsdc").textContent = msg.lpUsdcPow;
            el("netTreasPow").textContent = msg.treasuryPow;
            el("netTreasUsdc").textContent = msg.treasuryUsdc;
          }
        }catch(e){}
      };
    }catch(e){
      logMsg("WS connect ERR: "+e);
    }
  }

  // ---------- WALLET POWCHAIN LOCAL ----------
  function loadPowWallet(){
    try{
      powAddr = localStorage.getItem("pow_addr") || null;
      powPriv = localStorage.getItem("pow_priv") || null;
      if(powAddr){
        el("powAddr").value = powAddr;
        fetchWallet();
      }
    }catch(e){
      logMsg("loadPowWallet ERR: "+e);
    }
  }

  function genPowWallet(){
    try{
      // Utiliser UNIQUEMENT window.bs58 pour éviter ReferenceError
      const b58lib = (window.bs58 && window.bs58.encode)
        ? window.bs58
        : (window.bs58 && window.bs58.default && window.bs58.default.encode
            ? window.bs58.default
            : null);

      if(!b58lib || !b58lib.encode){
        throw new Error("bs58 lib non chargée");
      }

      const kp = nacl.sign.keyPair();
      powAddr = b58lib.encode(kp.publicKey);
      powPriv = b58lib.encode(kp.secretKey);

      localStorage.setItem("pow_addr",powAddr);
      localStorage.setItem("pow_priv",powPriv);
      el("powAddr").value = powAddr;
      logMsg("Nouveau wallet POWCHAIN généré.");
      fetchWallet();
    }catch(e){
      alert("Erreur génération wallet POWCHAIN : "+e);
      logMsg("Wallet gen ERR: "+e);
    }
  }

  async function fetchWallet(){
    if(!powAddr) return;
    try{
      const r = await fetch("/wallet?id="+encodeURIComponent(powAddr));
      if(!r.ok) throw new Error("HTTP "+r.status);
      const w = await r.json();
      el("powPow").textContent = w.pow;
      el("powUsdc").textContent = w.usdc;
    }catch(e){
      logMsg("Wallet fetch ERR: "+e);
    }
  }

  // ---------- PHANTOM ----------
  async function connectPhantom(){
    try{
      if(!window.solana || !window.solana.isPhantom){
        alert("Phantom non détecté.");
        return;
      }
      const resp = await window.solana.connect();
      const pub = resp.publicKey.toString();
      el("solAddr").value = pub;
      logMsg("Phantom connecté: "+pub);
      await refreshSol();
    }catch(e){
      logMsg("Phantom connect ERR: "+e);
    }
  }

  async function refreshSol(){
    try{
      const addr = el("solAddr").value;
      if(!addr){
        logMsg("refreshSol: pas d'adresse Phantom.");
        return;
      }
      const conn = new solanaWeb3.Connection(RPC_SOL);
      const pub = new solanaWeb3.PublicKey(addr);
      const lamports = await conn.getBalance(pub,"confirmed");
      const sol = lamports / 1e9;

      // USDC SPL
      let usdc = 0;
      try{
        const mint = new solanaWeb3.PublicKey(USDC_MINT);
        const toks = await conn.getParsedTokenAccountsByOwner(pub,{ mint });
        toks.value.forEach(a=>{
          const amt = a.account.data.parsed.info.tokenAmount.uiAmount || 0;
          usdc += Number(amt);
        });
      }catch(e){}

      el("solBal").textContent = sol.toFixed(5);
      el("usdcBal").textContent = usdc.toFixed(2);
      logMsg("Soldes Phantom mis à jour.");
    }catch(e){
      logMsg("refreshSol ERR: "+e);
    }
  }

  // ---------- BRIDGE SOL → POWCHAIN ----------
  async function bridgeSol(){
    try{
      if(!powAddr){
        alert("Génère d'abord un wallet POWCHAIN.");
        return;
      }
      if(!window.solana || !window.solana.isPhantom){
        alert("Connecte Phantom d'abord.");
        return;
      }
      const amtStr = el("bridgeAmount").value.trim();
      const amt = Number(amtStr);
      if(!amt || amt <= 0){
        alert("Montant SOL invalide.");
        return;
      }

      const conn = new solanaWeb3.Connection(RPC_SOL);
      const fromPub = window.solana.publicKey;
      const toPub = new solanaWeb3.PublicKey(TREASURY_SOL);
      const lamports = Math.floor(amt * 1e9);

      let tx = new solanaWeb3.Transaction().add(
        solanaWeb3.SystemProgram.transfer({
          fromPubkey: fromPub,
          toPubkey: toPub,
          lamports
        })
      );
      tx.feePayer = fromPub;
      const { blockhash } = await conn.getLatestBlockhash();
      tx.recentBlockhash = blockhash;

      const signed = await window.solana.signTransaction(tx);
      const sig = await conn.sendRawTransaction(signed.serialize());
      await conn.confirmTransaction(sig,"confirmed");

      logMsg("Bridge SOL on-chain envoyé: "+sig);

      // Notify POWCHAIN backend pour créditer POW
      const r = await fetch("/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
          type:"bridge",
          to: powAddr,
          amountSol: amt,
          solanaSig: sig
        })
      });

      const js = await r.json();
      if(!r.ok || js.error){
        logMsg("Bridge backend ERR: "+(js.error || r.status));
        alert("Bridge côté POWCHAIN refusé: "+(js.error || "HTTP "+r.status));
        return;
      }
      logMsg("Bridge validé sur POWCHAIN, +" + js.amountPow + " POW.");
      alert("Requête de bridge envoyée et validée. Regarde le solde POWCHAIN.");
      fetchWallet();
    }catch(e){
      logMsg("Bridge ERR: "+e);
      alert("Erreur bridge: "+e);
    }
  }

  // ---------- ACTIONS POWCHAIN (send / stake) ----------
  async function sendPow(){
    if(!powAddr){alert("Génère un wallet POWCHAIN d'abord.");return;}
    const dest = el("sendTo").value.trim();
    const amt = Number(el("sendAmount").value.trim());
    if(!dest || !amt || amt<=0){alert("Paramètres SEND invalides.");return;}
    try{
      const r = await fetch("/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({type:"send",from:powAddr,to:dest,amount:amt})
      });
      const js = await r.json();
      if(!r.ok || js.error){alert("SEND ERR: "+(js.error||r.status));logMsg("SEND ERR: "+(js.error||r.status));return;}
      logMsg("SEND OK "+amt+" POW → "+dest);
      fetchWallet();
    }catch(e){
      logMsg("SEND fetch ERR: "+e);
    }
  }

  async function stakePow(kind){
    if(!powAddr){alert("Génère un wallet POWCHAIN d'abord.");return;}
    const amt = Number(el("stakeAmount").value.trim());
    if(!amt || amt<=0){alert("Montant stake invalide.");return;}
    const type = kind==="in" ? "stake" : "unstake";
    try{
      const r = await fetch("/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({type,from:powAddr,amount:amt})
      });
      const js = await r.json();
      if(!r.ok || js.error){alert("STAKE ERR: "+(js.error||r.status));logMsg("STAKE ERR: "+(js.error||r.status));return;}
      logMsg(type.toUpperCase()+" OK "+amt+" POW");
      fetchWallet();
    }catch(e){
      logMsg("STAKE fetch ERR: "+e);
    }
  }

  async function addLp(){
    if(!powAddr){alert("Génère un wallet POWCHAIN d'abord.");return;}
    const powAmt = Number(el("lpPow").value.trim());
    const usdcAmt = Number(el("lpUsdc").value.trim());
    if(!powAmt||powAmt<=0||!usdcAmt||usdcAmt<=0){alert("Montants LP invalides.");return;}
    try{
      const r = await fetch("/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({type:"addLP",from:powAddr,pow:powAmt,usdc:usdcAmt})
      });
      const js = await r.json();
      if(!r.ok || js.error){alert("ADD LP ERR: "+(js.error||r.status));logMsg("ADD LP ERR: "+(js.error||r.status));return;}
      logMsg("ADD LP OK POW="+powAmt+" / USDC POW="+usdcAmt);
      refreshStats();
    }catch(e){
      logMsg("ADD LP fetch ERR: "+e);
    }
  }

  // ---------- Explorer ----------
  async function loadLastBlocks(){
    try{
      const r = await fetch("/chain");
      if(!r.ok) throw new Error("HTTP "+r.status);
      const chain = await r.json();
      const last = chain.slice(-30);
      logMsg("Derniers blocs :");
      last.forEach(b=>{
        logMsg("Block #"+b.index+" txs="+(b.txs?b.txs.length:0)+" hash="+(b.hash||""));
      });
    }catch(e){
      logMsg("Explorer ERR: "+e);
    }
  }

  // ---------- INIT ----------
  function init(){
    el("btnGenPow").onclick = genPowWallet;
    el("btnReloadPow").onclick = fetchWallet;
    el("btnConnectPhantom").onclick = connectPhantom;
    el("btnRefreshSol").onclick = refreshSol;
    el("btnBridge").onclick = bridgeSol;
    el("btnSend").onclick = sendPow;
    el("btnStake").onclick = ()=>stakePow("in");
    el("btnUnstake").onclick = ()=>stakePow("out");
    el("btnAddLp").onclick = addLp;
    el("btnLoadBlocks").onclick = loadLastBlocks;
    el("btnClearLog").onclick = ()=>{el("log").value="";};

    loadPowWallet();
    refreshStats();
    connectWs();
    setInterval(refreshStats,60000);
  }

  window.addEventListener("load",init);
})();
</script>
</body>
</html>
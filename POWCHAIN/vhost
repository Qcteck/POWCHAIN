  });
});

// Historique des bridges
app.get("/bridge-history", (req, res) => {
  res.json({ ok: true, bridgeHistory });
});

// Bridge SOL → FIREINNERS (POST /bridge)
app.post("/bridge", (req, res) => {
  try {
    const body = req.body || {};

    const addr =
      body.addr ||
      body.fireAddress ||
      body.powAddress ||
      body.walletFire ||
      null;

    let solAmount = body.solAmount;
    if (solAmount === undefined) solAmount = body.amountSol;
    if (solAmount === undefined) solAmount = body.sol;

    if (!addr) {
      return res.status(400).json({ ok: false, error: "addr manquant" });
    }

    const solNum = parseFloat(solAmount);
    if (!isFinite(solNum) || solNum <= 0) {
      return res.status(400).json({ ok: false, error: "solAmount invalide" });
    }

    const result = processBridgeIn({ addr, solAmount: solNum });

    const rec = {
      dir: "IN",
      time: Date.now(),
      addr,
      solAmount: solNum,
      fireMinted: result.fireMinted,
      userFire:   result.userFire,
      feeTreasFire: result.feeTreasFire,
      burnedFire: result.burnedFire
    };

    bridgeHistory.push(rec);
    if (bridgeHistory.length > 500) bridgeHistory.shift();

    mempool.push(result);
    newBlockFromMempool();

    log("Bridge SOL→FIREINNERS", rec);
    return res.json({ ok: true, bridge: result });
  } catch (e) {
    log("Erreur /bridge:", e.message);
    return res.status(400).json({ ok: false, error: e.message });
  }
});

// Bridge FIRE → SOL (POST /bridge-out)
app.post("/bridge-out", (req, res) => {
  try {
    const body = req.body || {};

    const addr =
      body.addr ||
      body.fireAddress ||
      body.walletFire ||
      null;

    let fireAmount = body.fireAmount;
    if (fireAmount === undefined) fireAmount = body.amountFire;
    if (fireAmount === undefined) fireAmount = body.amount;

    if (!addr) {
      return res.status(400).json({ ok: false, error: "addr manquant" });
    }

    const result = processBridgeOut({ addr, fireAmount });

    const rec = {
      dir: "OUT",
      time: Date.now(),
      addr,
      fireAmount,
      solOut: result.solOut,
      burnedFire: result.burnedFire
    };

    bridgeHistory.push(rec);
    if (bridgeHistory.length > 500) bridgeHistory.shift();

    mempool.push(result);
    newBlockFromMempool();

    log("Bridge FIRE→SOL", rec);
    return res.json({ ok: true, bridge: result });
  } catch (e) {
    log("Erreur /bridge-out:", e.message);
    return res.status(400).json({ ok: false, error: e.message });
  }
});


sudo nano /etc/nginx/sites-available/bbqfinance




server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # HTTP -> HTTPS simple, sans boucle
    return 301 https://bbqfinance.fun$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bbqfinance.fun www.bbqfinance.fun;

    ssl_certificate     /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # --------- FRONT POWCHAIN (index.html) ----------
    root /root/powchain;
    index index.html;

    location / {
        try_files /index.html =404;
    }

    # --------- API STATS POWCHAIN ----------
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # --------- WEBSOCKET POWCHAIN ----------
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }
}
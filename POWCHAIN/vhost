const logUI = t => document.getElementById("log").innerHTML += t+"\n";
const API_URL = "https://bbqfinance.fun";

async function checkHTTP(){
  try{
    const r = await fetch(API_URL+"/stats");
    if(r.ok){ httpStatus.className="statusLight ok"; httpStatus.textContent="HTTP OK"; }
    else throw "";
  }catch{ httpStatus.className="statusLight err"; httpStatus.textContent="HTTP ?"; }
}
checkHTTP();
setInterval(checkHTTP,5000);

let ws;
function connectWS(){
  ws = new WebSocket("wss://bbqfinance.fun/ws");
  ws.onopen=()=>{wsStatus.className="statusLight ok"; wsStatus.textContent="WS OK";};
  ws.onclose=()=>{wsStatus.className="statusLight err"; wsStatus.textContent="WS OFF"; setTimeout(connectWS,1000);};
  ws.onmessage=e=>logUI("[WS] "+e.data);
}
connectWS();

<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>DRBIOLOGIC — Protein Explorer Lab (EDU)</title>
<style>
:root{
--bg:#060812;--panel:#0b1224;--panel2:#0a1020;--line:#223354;
--txt:#e7f0ff;--mut:#ff6b6b;--ok:#4ade80;--sim:#22d3ee;--gap:#fbbf24;
--acc:#7dd3fc;--acc2:#a78bfa;--shadow:0 14px 50px rgba(0,0,0,.38)
}
*{box-sizing:border-box}
html,body{height:100%}
body{
margin:0;color:var(--txt);font-family:system-ui,-apple-system,Segoe UI,Roboto;
background:radial-gradient(1200px 700px at 28% 10%,rgba(125,211,252,.14),transparent 60%),
radial-gradient(900px 650px at 82% 42%,rgba(167,139,250,.12),transparent 60%),
linear-gradient(180deg,#050610,#05060a 40%,#05050a)
}
button,select,input{
background:rgba(10,16,32,.92);color:#bff;border:1px solid #2a3a62;
padding:8px 10px;border-radius:12px;font-size:14px
}
button{cursor:pointer}
button:active{transform:translateY(1px)}
input[type=range]{padding:0;height:28px}
a{color:var(--acc)}
.card{
background:linear-gradient(180deg,rgba(11,18,36,.93),rgba(9,14,30,.90));
border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)
}
.hd{padding:12px;border-bottom:1px solid #203055}
.bd{padding:12px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.grid{display:grid;grid-template-columns:320px 1fr;gap:12px}
@media(max-width:1100px){.grid{grid-template-columns:1fr}}
.small{font-size:12px;color:#9fb}
.kpis{display:grid;grid-template-columns:repeat(6,minmax(140px,1fr));gap:10px}
.kpi{background:rgba(6,10,20,.72);border:1px solid #23345e;border-radius:14px;padding:10px}
.kpi .k{font-size:12px;color:#9fb}.kpi .v{font-weight:800;font-size:18px}
.seq{font-family:ui-monospace,monospace;font-size:12.5px;white-space:nowrap;overflow:auto;border:1px solid #1c2744;padding:8px;border-radius:12px;background:#02040a}
.match{color:var(--ok)}.sim{color:var(--sim)}.mut{color:var(--mut)}.gap{color:var(--gap)}
canvas{background:#02040a;border:1px solid #223354;border-radius:14px;width:100%}
.badge{padding:4px 10px;border-radius:999px;border:1px solid #2a3a62;background:#0b1224;font-size:12px}
.sep{height:1px;background:#203055;margin:10px 0}
.notice{
background:#0a1020;border:1px dashed #2a3a62;border-radius:14px;padding:10px
}
.notice b{color:#fff}
.toast{position:fixed;right:12px;bottom:12px;background:#0b1224;border:1px solid #2a3a62;border-radius:14px;padding:10px;display:none}
</style>
</head>

<body>
<div class="card" style="margin:12px">
<div class="hd">
<h2 style="margin:0">🧬 DRBIOLOGIC — Protein Explorer Lab (Éducatif)</h2>
<div class="small">
Analyse logique de séquences protéiques • offline • non-pathogène • data-science
</div>
</div>
<div class="bd notice small">
<b>Important :</b> Les scores, “danger”, PCA, Pareto et clusters sont des métriques <b>internes au modèle</b>.
Ils n’impliquent <b>aucune</b> conclusion biologique réelle, médicale ou clinique.
</div>
</div>

<div class="grid" style="margin:12px">

<!-- LEFT -->
<div class="card">
<div class="hd"><b>Contrôles & Datasets</b></div>
<div class="bd">

<div class="small"><b>Mode</b></div>
<select id="mode">
<option value="edu">Protéine éducative (non-pathogène)</option>
<option value="demo">Spike-like synthétique (démo)</option>
</select>

<div class="sep"></div>

<div class="small"><b>Datasets intégrés (offline)</b></div>
<select id="dataset"></select>
<button id="useDS">Utiliser comme référence</button>

<div class="sep"></div>

<div class="small"><b>Upload FASTA local (safe)</b></div>
<input type="file" id="fasta" accept=".fa,.fasta,.faa,.txt"/>
<button id="loadFASTA">Importer</button>
<div class="small">PROT-only • validation stricte • localStorage</div>

<div class="sep"></div>

<div class="small"><b>Boucle & Génération</b></div>
<div class="row">
<button id="play">▶ Play</button>
<button id="pause">⏸ Pause</button>
<button id="step">+1 run</button>
</div>

<div class="row">
<div style="flex:1">
<div class="small">Mutation rate</div>
<input type="range" min="0.005" max="0.12" step="0.001" id="mutRate" value="0.03"/>
</div>
<span id="mutV" class="badge">0.03</span>
</div>

<div class="sep"></div>

<div class="small"><b>Mode pédagogique guidé</b></div>
<select id="lesson">
<option value="off">Libre</option>
<option value="align">Lire un alignement</option>
<option value="hotspot">Identifier hotspots</option>
<option value="pca">Comprendre PCA / clusters</option>
<option value="pareto">Trade-offs (Pareto)</option>
</select>

</div>
</div>

<!-- RIGHT -->
<div class="card">
<div class="hd"><b>Analyse & Visualisations</b></div>
<div class="bd">

<div class="kpis">
<div class="kpi"><div class="k">Identité</div><div class="v" id="k_id">–</div></div>
<div class="kpi"><div class="k">Similarité</div><div class="v" id="k_sim">–</div></div>
<div class="kpi"><div class="k">Mutations</div><div class="v" id="k_mut">–</div></div>
<div class="kpi"><div class="k">Score</div><div class="v" id="k_score">–</div></div>
<div class="kpi"><div class="k">Indice modèle</div><div class="v" id="k_danger">–</div></div>
<div class="kpi"><div class="k">Runs</div><div class="v" id="k_runs">0</div></div>
</div>

<div class="sep"></div>

<div class="small"><b>Alignement animé</b></div>
<div class="seq" id="seqA"></div>
<div class="seq" id="seqB" style="margin-top:6px"></div>
<div class="small" id="interp" style="margin-top:6px"></div>

<div class="sep"></div>

<div class="small"><b>Heatmap mutationnelle</b></div>
<canvas id="heat" height="90"></canvas>

<div class="sep"></div>

<div class="small"><b>Graph global (historique)</b></div>
<canvas id="hist" height="240"></canvas>

</div>
</div>

</div>

<div id="toast" class="toast"></div>

<script>
/* ========= UTIL ========= */
const $=id=>document.getElementById(id)
const toast=t=>{const el=$("toast");el.textContent=t;el.style.display="block";setTimeout(()=>el.style.display="none",1600)}
const rnd=()=>Math.random()

/* ========= DATASETS ÉDUCATIFS (NON-PATHOGÈNES) ========= */
const DATASETS=[
{name:"Enzyme-like (synthétique)",seq:"MSTAVQLADKAGADVVVTATDGVETQLNQLGADVVVVAAAGAPAGAAEELAAALEN"},
{name:"Protéine végétale-like",seq:"MSQLVKTQEFADAVKKYGVETVVKDLGADVVVVAGTTGAAQALAELKAKG"},
{name:"Structurale-like",seq:"MAAAAAVAAAAAVAAAAAGGGGGAAAAAVVVVVAAAAAGGGG"},
{name:"GFP-like synthétique",seq:"MSKGEELFTGVVPILVELDGDVNGHKFSVSGEGEGDATYGKLTLKFICTTGKLPVPWPTLV"}
]

/* ========= BIO-LOGIQUE (SIMPLIFIÉ & SAFE) ========= */
const AA="ACDEFGHIKLMNPQRSTVWY"
const group=a=>("AVLIMFWY".includes(a)?"hyd":"STNQC".includes(a)?"pol":"KRH".includes(a)?"pos":"DE".includes(a)?"neg":"oth")
const similar=(a,b)=>a===b||group(a)===group(b)

/* ========= ÉTAT ========= */
let REF=DATASETS[0].seq
let runs=[]
let heat=[]
let timer=null

/* ========= INIT ========= */
DATASETS.forEach((d,i)=>{$("dataset").innerHTML+=`<option value="${i}">${d.name}</option>`})
$("dataset").value=0
useRef(REF)

/* ========= FASTA SAFE ========= */
$("loadFASTA").onclick=async()=>{
const f=$("fasta").files[0];if(!f)return
const t=await f.text()
const seq=t.replace(/^>.*$/mg,"").replace(/[^A-Z]/gi,"").toUpperCase()
if(!seq||[...seq].some(c=>!AA.includes(c)))return toast("FASTA invalide (PROT-only)")
REF=seq;useRef(seq);toast("FASTA chargé (local)")
}

/* ========= CONTROLES ========= */
$("useDS").onclick=()=>{REF=DATASETS[$("dataset").value].seq;useRef(REF);toast("Dataset utilisé")}
$("mutRate").oninput=e=>$("mutV").textContent=e.target.value
$("play").onclick=()=>{if(!timer)timer=setInterval(runOnce,900)}
$("pause").onclick=()=>{clearInterval(timer);timer=null}
$("step").onclick=runOnce

/* ========= CORE ========= */
function useRef(seq){
heat=new Array(seq.length).fill(0)
runs=[]
drawHeat();drawHist()
}

function mutate(seq){
let arr=seq.split("")
let n=Math.max(1,Math.floor(arr.length*parseFloat($("mutRate").value)))
while(n--){
let i=Math.floor(rnd()*arr.length)
let a=arr[i]
let b=AA[Math.floor(rnd()*AA.length)]
if(b!==a){arr[i]=b;heat[i]++}
}
return arr.join("")
}

function metrics(a,b){
let m=0,sim=0
for(let i=0;i<a.length;i++){
if(a[i]!==b[i]){m++; if(similar(a[i],b[i]))sim++}
}
return{
identity:((a.length-m)/a.length*100).toFixed(1),
similarity:((a.length-m+sim)/a.length*100).toFixed(1),
mut:m,
score:(a.length-m*2+sim).toFixed(0),
danger:(m/a.length*100).toFixed(1)
}
}

/* ========= RENDER ========= */
function animate(a,b){
$("seqA").innerHTML="";$("seqB").innerHTML=""
let i=0
const step=()=>{
if(i>=a.length)return
let c="mut"
if(a[i]===b[i])c="match"
else if(similar(a[i],b[i]))c="sim"
$("seqA").innerHTML+=`<span class="${c}">${a[i]}</span>`
$("seqB").innerHTML+=`<span class="${c}">${b[i]}</span>`
i++;setTimeout(step,8)
}
step()
}

function drawHeat(){
const c=$("heat").getContext("2d"),w=$("heat").width,h=$("heat").height
c.clearRect(0,0,w,h)
const max=Math.max(1,...heat)
heat.forEach((v,i)=>{
c.fillStyle=`rgb(${(255*v/max)|0},${120-(120*v/max)|0},0)`
c.fillRect(i*w/heat.length,0,w/heat.length+1,h)
})
}

function drawHist(){
const c=$("hist").getContext("2d"),w=$("hist").width,h=$("hist").height
c.clearRect(0,0,w,h)
if(runs.length<2)return
const xs=w/(runs.length-1)
const maxM=Math.max(...runs.map(r=>r.mut))
c.strokeStyle="#22d3ee";c.beginPath()
runs.forEach((r,i)=>{
const y=h-(r.mut/maxM*h)
i?c.lineTo(i*xs,y):c.moveTo(i*xs,y)
})
c.stroke()
}

/* ========= RUN ========= */
function runOnce(){
const v=mutate(REF)
const m=metrics(REF,v)
runs.push(m)
$("k_id").textContent=m.identity+"%"
$("k_sim").textContent=m.similarity+"%"
$("k_mut").textContent=m.mut
$("k_score").textContent=m.score
$("k_danger").textContent=m.danger
$("k_runs").textContent=runs.length
$("interp").textContent=
$("lesson").value==="align"?"Lis l’alignement : vert = identique, cyan = conservateur":
$("lesson").value==="hotspot"?"Observe la heatmap : zones chaudes = tolérance aux mutations":
$("lesson").value==="pca"?"Les clusters montrent des familles selon les métriques":
$("lesson").value==="pareto"?"Pareto = compromis, pas optimum unique":
"Analyse libre"
animate(REF,v)
drawHeat();drawHist()
}
</script>
</body>
</html>
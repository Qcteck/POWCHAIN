sudo mkdir -p /var/www/bbqfinance
sudo cp /root/powchain/index.html /var/www/bbqfinance/index.html
sudo chown -R www-data:www-data /var/www/bbqfinance
sudo chmod -R 755 /var/www/bbqfinance



sudo nano /etc/nginx/sites-available/bbqfinance




server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    location /stats {
        proxy_pass http://127.0.0.1:3000/powchain/stats;
    }

    location /ws {
        proxy_pass http://127.0.0.1:7001/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }
}

server {
    listen 443 ssl;
    server_name bbqfinance.fun www.bbqfinance.fun;

    ssl_certificate     /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    root /var/www/bbqfinance;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    location /stats {
        proxy_pass http://127.0.0.1:3000/powchain/stats;
    }

    location /ws {
        proxy_pass http://127.0.0.1:7001/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }
}





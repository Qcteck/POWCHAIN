const fmt=n=>(n/DEC).toFixed(6);

function b58encode(bytes){
  if(!bytes||!bytes.length)return"";
  let d=[0];
  for(let i=0;i<bytes.length;i++){
    let c=bytes[i];
    for(let j=0;j<d.length;j++){
      let x=d[j]*256+c;
      d[j]=x%58;
      c=(x/58)|0;
    }
    while(c>0){
      d.push(c%58);
      c=(c/58)|0;
    }
  }
  let z=0;
  while(z<bytes.length&&bytes[z]===0)z++;
  let r="";
  for(let i=0;i<z;i++)r+="1";
  for(let i=d.length-1;i>=0;i--)r+=ALPH[d[i]];
  return r;
}

function b58decode(str){
  if(!str)return new Uint8Array(0);
  let b=[0];
  for(let i=0;i<str.length;i++){
    let c=ALPH.indexOf(str[i]);
    if(c<0)throw Error("base58 invalide");
    for(let j=0;j<b.length;j++){
      let x=b[j]*58+c;
      b[j]=x&255;
      c=x>>8;
    }
    while(c>0){
      b.push(c&255);
      c>>=8;
    }
  }
  let z=0;
  while(z<str.length&&str[z]==="1")z++;
  let r=new Uint8Array(z+b.length);
  for(let i=0;i<b.length;i++)r[r.length-1-i]=b[i];
  return r;
}

async function jget(p){
  const t0=performance.now();
  const r=await fetch(API+p);
  const t1=performance.now();
  const lat=q("#latency");
  if(lat)lat.textContent="Latency: "+(t1-t0).toFixed(0)+" ms";
  if(!r.ok)throw Error("HTTP "+r.status);
  return r.json();
}

function connectWS(){
  try{
    sock=new WebSocket(WS);
    sock.onopen=()=>{
      log("WS connecté");
      q("#syncText").textContent="Synced";
      q("#syncChipText").textContent="Online";
      q("#syncDot").style.background="#22c55e";
    };
    sock.onclose=()=>{
      q("#syncText").textContent="Reconnecting";
      q("#syncChipText").textContent="Sync…";
      q("#syncDot").style.background="#f97316";
      setTimeout(connectWS,1500);
    };
    sock.onerror=()=>{
      q("#syncText").textContent="Error";
      q("#syncChipText").textContent="Error";
      q("#syncDot").style.background="#ef4444";
    };
  }catch(e){
    log("WS ERR "+e.message);
  }
}
connectWS();


<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script>
const API="https://bbqfinance.fun";
const WS="wss://bbqfinance.fun/ws";
const DEC=1e6;

let addr=null,priv=null,nonce=0,sock=null;

const q=s=>document.querySelector(s);
const log=m=>{
 q("#log").textContent+="["+new Date().toLocaleTimeString()+"] "+m+"\n";
};

/* WebSocket */
function wsConnect(){
 try{
  sock=new WebSocket(WS);
  sock.onopen=()=>log("WS connecté");
  sock.onclose=()=>{log("WS fermé, retry");setTimeout(wsConnect,1500)}
  sock.onerror=()=>log("WS erreur");
 }catch(e){log("WS exception "+e.message)}
}
wsConnect();

/* Fetch helper */
async function jget(p){const r=await fetch(API+p);return r.json()}

/* Generate wallet */
q("#genBtn").onclick=()=>{
 try{
  const k=nacl.sign.keyPair();
  addr=b58encode(k.publicKey);
  priv=b58encode(k.secretKey);
  q("#myAddr").value=addr;
  q("#myPriv").value=priv;
  nonce=0;
  log("Wallet généré");
 }catch(e){log("Erreur generation "+e.message)}
};

/* Load wallet */
q("#loadBtn").onclick=async()=>{
 addr=q("#myAddr").value.trim();
 priv=q("#myPriv").value.trim();
 if(!addr||!priv)return alert("Adresse + clé");
 try{
  const w=await jget("/wallet/"+addr);
  q("#balPow").textContent=(w.pow/DEC).toFixed(6);
  q("#balUsdc").textContent=(w.usdc/DEC).toFixed(6);
  q("#balStake").textContent=(w.staked/DEC).toFixed(6);
  nonce=w.nonce||0;
  log("Wallet chargé");
 }catch(e){log("Load error "+e.message)}
};

/* Network refresh */
async function refreshNet(){
 try{
  const s=await jget("/stats");
  q("#height").textContent=s.height;
  q("#tvl").textContent=(s.lpUsdc/DEC).toFixed(2);
  q("#lpPow").textContent=(s.lpPow/DEC).toFixed(6);
  q("#lpUsdc").textContent=(s.lpUsdc/DEC).toFixed(6);
  q("#treasury").textContent=s.treasuryUsdc;
 }catch(e){log("Net error "+e.message)}
}
setInterval(refreshNet,4000);
refreshNet();

/* Base58 utils */
const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function b58encode(bytes){
 if(!bytes)return"";
 let d=[0];
 for(let i=0;i<bytes.length;i++){
  let c=bytes[i];
  for(let j=0;j<d.length;j++){
   let x=d[j]*256+c;
   d[j]=x%58;
   c=(x/58)|0;
  }
  while(c>0){d.push(c%58);c=(c/58)|0}
 }
 let r="";
 for(let k=0;k<bytes.length&&bytes[k]==0;k++)r+="1";
 for(let i=d.length-1;i>=0;i--)r+=ALPH[d[i]];
 return r;
}
function b58decode(str){
 let b=[0];
 for(let i=0;i<str.length;i++){
  let c=ALPH.indexOf(str[i]);
  for(let j=0;j<b.length;j++){
   let x=b[j]*58+c;
   b[j]=x&255;
   c=x>>8;
  }
  while(c>0){b.push(c&255);c>>=8}
 }
 let r=new Uint8Array(b.length);
 for(let i=0;i<b.length;i++)r[r.length-1-i]=b[i];
 return r;
}

/* Sign transaction */
function signTx(payload){
 const msg=new TextEncoder().encode(JSON.stringify(payload));
 const sk=b58decode(priv);
 const sig=nacl.sign.detached(msg,sk);
 return b58encode(sig);
}

/* Send */
q("#sendBtn").onclick=()=>{
 if(!addr)return alert("Load wallet");
 const to=q("#sendTo").value.trim();
 const amt=parseFloat(q("#sendAmt").value||"0");
 if(!to||amt<=0)return;
 const tx={type:"TX_POW",from:addr,to,amount:Math.floor(amt*DEC),nonce:nonce+1};
 tx.sig=signTx(tx);
 if(sock.readyState===1)sock.send(JSON.stringify(tx));
 nonce++;
};

/* Stake */
q("#stakeBtn").onclick=()=>{
 if(!addr)return alert("Load wallet");
 const amt=parseFloat(q("#stakeAmt").value||"0");
 if(amt<=0)return;
 const tx={type:"STAKE",from:addr,amount:Math.floor(amt*DEC),nonce:nonce+1};
 tx.sig=signTx(tx);
 if(sock.readyState===1)sock.send(JSON.stringify(tx));
 nonce++;
};

/* Swap */
q("#swapBtn").onclick=()=>{
 if(!addr)return alert("Load wallet");
 const amt=parseFloat(q("#swapAmt").value||"0");
 if(amt<=0)return;
 const tx={type:"SWAP",from:addr,amount:Math.floor(amt*DEC),token:q("#swapDir").value,nonce:nonce+1};
 tx.sig=signTx(tx);
 if(sock.readyState===1)sock.send(JSON.stringify(tx));
 nonce++;
};

/* LP add */
q("#lpAddBtn").onclick=()=>{
 if(!addr)return alert("Load wallet");
 const a=parseFloat(q("#lpPOW").value||"0");
 const b=parseFloat(q("#lpUSDC").value||"0");
 if(a<=0||b<=0)return;
 const tx={type:"LP_ADD",from:addr,pow:Math.floor(a*DEC),usdc:Math.floor(b*DEC),nonce:nonce+1};
 tx.sig=signTx(tx);
 if(sock.readyState===1)sock.send(JSON.stringify(tx));
 nonce++;
};

/* Block explorer */
q("#blkBtn").onclick=async()=>{
 const h=parseInt(q("#blk").value||"0");
 if(!h)return;
 try{
  const b=await jget("/block/"+h);
  q("#blkOut").textContent=JSON.stringify(b,null,2);
 }catch(e){q("#blkOut").textContent="Erreur "+e.message}
};
</script>

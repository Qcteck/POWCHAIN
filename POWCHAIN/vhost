input::placeholder{color:#6b7280;}
input:focus{border-color:var(--accent);box-shadow:0 0 0 1px #0ea5e966;}
button{
  cursor:pointer;font-weight:500;
  background:linear-gradient(135deg,var(--accent-soft),var(--accent));
  color:#0b1120;border-color:#0ea5e9;box-shadow:0 0 12px #0ea5e970;
}
button:hover{transform:translateY(-1px);box-shadow:0 0 16px #0ea5e9b0;}
button:active{transform:translateY(0);box-shadow:0 0 8px #0ea5e980;}
button.secondary{background:#020617;color:var(--accent-text);border-color:#1f2937;box-shadow:none;}
button.secondary:hover{border-color:var(--accent-soft);box-shadow:0 0 10px #0ea5e940;}
.row{display:flex;gap:8px;margin-bottom:6px;flex-wrap:wrap;}
.row>div{flex:1 1 140px;}
#log{
  width:100%;height:150px;background:#020617;border-radius:10px;border:1px solid #111827;
  padding:6px 8px;font-size:11px;color:#e5ecff;font-family:ui-monospace,Menlo,Consolas,monospace;
  overflow:auto;white-space:pre-wrap;background-image:linear-gradient(to bottom,#020617 0,#020617 40%,#030712 100%);
}
#chart{width:100%;height:130px;border-radius:10px;border:1px solid #1f2937;
  background:radial-gradient(circle at top,#0b1120,#020617 70%);position:relative;overflow:hidden;}
#chart canvas{width:100%;height:100%;}
small{font-size:11px;color:var(--text-muted);}
#powAddr,#solAddr,#bridgeAmount,#powSendTo,#powSendAmt,#powStakeAmt,#lpPow,#lpUsdc,#usdcSol{width:100%;}
#qrCanvas{
  width:120px;height:120px;border-radius:10px;background:#020617;
  border:1px solid #1f2937;padding:6px;
}
.tagline{font-size:11px;color:var(--text-muted);margin-top:4px;max-width:260px;}
</style>

        <!-- LOG GLOBAL -->
        <div class="card">
          <h2>Console</h2>
          <div id="log"></div>
        </div>
      </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl.min.js"></script>
<script>
const API="https://bbqfinance.fun";
const WS ="wss://bbqfinance.fun/ws";
const q=s=>document.querySelector(s);
const logBox=()=>q("#log");
function L(t){let b=logBox();b.innerHTML=`[${new Date().toLocaleTimeString()}] ${t}<br>`+b.innerHTML;}
const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function b58enc(bytes){let d=[0];for(let i=0;i<bytes.length;i++){let c=bytes[i];for(let j=0;j<d.length;j++){let x=d[j]*256+c;d[j]=x%58;c=(x/58)|0;}while(c>0){d.push(c%58);c=(c/58)|0;}}let r="";for(let k=d.length-1;k>=0;k--)r+=ALPH[d[k]];return r;}
let solAddr=null;let powAddr=null;let powPriv=null;let powNonce=0;let sock=null;const DEC=1e6;

/* Phantom */
async function connectPhantom(){
  try{
    const p=window.solana;
    if(!p)return alert("Phantom non détecté");
    const resp=await p.connect();
    solAddr=resp.publicKey.toString();
    q("#solAddr").value=solAddr;
    L("Phantom connecté : "+solAddr);
    await loadSolBalances();
  }catch(e){L("Erreur Phantom : "+e.message);}
}
q("#btnPhantom").onclick=connectPhantom;

async function loadSolBalances(){
  try{
    if(!solAddr)return;
    const endpoint="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
    const r=await fetch(endpoint,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]})});
    const j=await r.json();
    const lam=j.result&&typeof j.result.value==="number"?j.result.value:0;
    q("#solBal").value=(lam/1e9).toFixed(4);

    const r2=await fetch(endpoint,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getTokenAccountsByOwner",params:[solAddr,{programId:"TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"},{encoding:"jsonParsed"}]})});
    const j2=await r2.json();
    let bal=0;
    if(j2.result&&Array.isArray(j2.result.value)){
      j2.result.value.forEach(v=>{
        try{
          const info=v.account.data.parsed.info;
          if(info.mint==="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"){
            bal+=Number(info.tokenAmount.uiAmount||0);
          }
        }catch(_){}
      });
    }
    q("#usdcBal").value=bal.toFixed(2);
  }catch(e){L("Bal ERR : "+e.message);}
}

/* Wallet POWCHAIN */
q("#btnGen").onclick=()=>{
  const kp=nacl.sign.keyPair();
  powAddr=b58enc(kp.publicKey);
  powPriv=b58enc(kp.secretKey);
  powNonce=0;
  q("#powAddr").value=powAddr;
  q("#powPriv").value=powPriv;
  drawPowQR();
  L("Wallet POWCHAIN généré");
};

function drawPowQR(){
  try{
    const c=document.getElementById("powQR");
    const ctx=c.getContext("2d");
    ctx.fillStyle="#000";ctx.fillRect(0,0,c.width,c.height);
    if(!powAddr)return;
    ctx.strokeStyle="#ffda73";ctx.lineWidth=3;
    ctx.strokeRect(10,10,c.width-20,c.height-20);
    ctx.fillStyle="#44f";
    for(let i=0;i<powAddr.length;i++){
      const ch=powAddr.charCodeAt(i);
      const x=(ch*i*7)%c.width;
      const y=(ch*i*11)%c.height;
      ctx.fillRect(x%c.width,y%c.height,3,3);
    }
  }catch(e){}
}

async function loadPowWallet(){
  if(!powAddr||!powPriv)return alert("Wallet POWCHAIN requis");
  try{
    const r=await fetch(`${API}/wallet/${powAddr}`);
    if(!r.ok)throw Error("ERR "+r.status);
    const w=await r.json();
    powNonce=w.nonce||0;
    q("#powBal").value=(w.pow/DEC).toFixed(6);
    q("#powUSDCBal").value=(w.usdc/DEC).toFixed(6);
    q("#powStakeBal").value=(w.staked/DEC).toFixed(6);
    q("#powNonce").value=powNonce;
    L("Wallet POWCHAIN chargé");
  }catch(e){L("Load POW ERR : "+e.message);}
}
q("#btnReloadPow").onclick=loadPowWallet;

/* Bridge / DEX / LP / Stake -> HTTP API */
q("#btnBridge").onclick=async()=>{
  if(!powAddr)return alert("Wallet POWCHAIN requis");
  let amt=parseFloat(q("#bridgeAmt").value||"0");
  if(amt<=0)return alert("Montant invalide");
  try{
    const r=await fetch(`${API}/bridge`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({amount:amt})});
    const j=await r.json();
    if(!j.ok)L("Bridge erreur: "+(j.error||""));else L("Bridge accepté, crédit POWCHAIN: "+j.credited/DEC);
  }catch(e){L("Bridge ERR : "+e.message);}
};

q("#btnSwap").onclick=async()=>{
  if(!powAddr)return alert("Wallet POWCHAIN requis");
  let amt=parseFloat(q("#swapAmt").value||"0");
  if(amt<=0)return alert("Montant invalide");
  try{
    const r=await fetch(`${API}/swap`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,dir:q("#swapDir").value,amount:Math.floor(amt*DEC)})});
    const j=await r.json();
    if(!j.ok)L("Swap erreur: "+(j.error||""));else L("Swap ok, reçu: "+(j.received/DEC).toFixed(6));
    loadPowWallet();
  }catch(e){L("Swap ERR : "+e.message);}
};

q("#btnLPAdd").onclick=async()=>{
  if(!powAddr)return alert("Wallet POWCHAIN requis");
  let p=parseFloat(q("#lpAddPow").value||"0");
  let u=parseFloat(q("#lpAddUsdc").value||"0");
  if(p<=0||u<=0)return alert("Montants invalides");
  try{
    const r=await fetch(`${API}/lp/add`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,pow:Math.floor(p*DEC),usdc:Math.floor(u*DEC)})});
    const j=await r.json();
    if(!j.ok)L("LP erreur: "+(j.error||""));else L("LP ajouté");
    loadPowWallet();
  }catch(e){L("LP ERR : "+e.message);}
};

q("#btnStake").onclick=async()=>{
  if(!powAddr)return alert("Wallet POWCHAIN requis");
  let a=parseFloat(q("#stakeAmt").value||"0");
  if(a<=0)return;
  try{
    const r=await fetch(`${API}/stake`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,amount:Math.floor(a*DEC)})});
    const j=await r.json();
    if(!j.ok)L("Stake erreur: "+(j.error||""));else L("Stake ok");
    loadPowWallet();
  }catch(e){L("Stake ERR : "+e.message);}
};

q("#btnUnstake").onclick=async()=>{
  if(!powAddr)return alert("Wallet POWCHAIN requis");
  let a=parseFloat(q("#stakeAmt").value||"0");
  if(a<=0)return;
  try{
    const r=await fetch(`${API}/unstake`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,amount:Math.floor(a*DEC)})});
    const j=await r.json();
    if(!j.ok)L("Unstake erreur: "+(j.error||""));else L("Unstake ok");
    loadPowWallet();
  }catch(e){L("Unstake ERR : "+e.message);}
};

/* Explorer & mempool & stats */
q("#btnBlocks").onclick=async()=>{
  try{
    const r=await fetch(`${API}/chain`);
    const b=await r.json();
    q("#blockOut").textContent=JSON.stringify(b.slice(-20),null,2);
  }catch(e){q("#blockOut").textContent="Erreur : "+e.message;}
};

async function loadStats(){
  try{
    const r=await fetch(`${API}/stats`);
    const s=await r.json();
    q("#sHeight").value=s.height;
    q("#sWallets").value=s.wallets;
    q("#sPOW").value=s.totalPow;
    q("#sStaked").value=s.totalStaked;
    q("#sMP").value=s.mempool;
    q("#sLPpow").value=s.lpPow;
    q("#sLPusdc").value=s.lpUsdc;
  }catch(e){L("/stats ERR : "+e.message);}
}
setInterval(loadStats,5000);loadStats();

async function loadMempoolSnapshot(){
  try{
    const r=await fetch(`${API}/mempool`);
    const m=await r.json();
    q("#mempoolLive").textContent=JSON.stringify(m,null,2);
  }catch(e){q("#mempoolLive").textContent="Erreur : "+e.message;}
}

/* WebSocket live mempool */
function connectWS(){
  try{
    sock=new WebSocket(WS);
    sock.onopen=()=>{q("#syncState").textContent="WS: online";q("#syncState").style.color="#4ade80";L("WS connecté");};
    sock.onclose=()=>{q("#syncState").textContent="WS: offline";q("#syncState").style.color="#f97373";L("WS fermé, reconnexion dans 3s...");setTimeout(connectWS,3000);};
    sock.onerror=e=>{L("WS erreur");};
    sock.onmessage=e=>{
      try{
        const m=JSON.parse(e.data);
        if(m.type==="mempool"){q("#mempoolLive").textContent=JSON.stringify(m.mempool,null,2);}
      }catch(_){}
    };
  }catch(e){L("WS FAIL : "+e.message);}
}
connectWS();

/* Navigation */
document.querySelectorAll(".navitem").forEach(item=>{
  item.onclick=()=>{
    document.querySelectorAll(".navitem").forEach(a=>a.classList.remove("active"));
    item.classList.add("active");
    const t=item.dataset.tab;
    document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
    document.getElementById(t).classList.add("active");
  };
});
</script>
</body>

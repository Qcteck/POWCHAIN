import express from "express";
import cors from "cors";
import fetch from "node-fetch";
import fs from "fs";

const PORT=process.env.PORT||3000;
const PUB="./public",KV="./kv";
if(!fs.existsSync(PUB))fs.mkdirSync(PUB,{recursive:true});
if(!fs.existsSync(KV))fs.mkdirSync(KV,{recursive:true});

const app=express();
app.use(cors());
app.use(express.json({limit:"1mb"}));

const safeKey=k=>String(k||"").replace(/[^a-zA-Z0-9_\-:.]/g,"_").slice(0,120)||"x";
const kpath=k=>`${KV}/${safeKey(k)}.json`;
const kread=(k,fb=null)=>{try{return JSON.parse(fs.readFileSync(kpath(k),"utf8"));}catch{return fb;}};
const kwrite=(k,v)=>fs.writeFileSync(kpath(k),JSON.stringify(v));

app.get("/ping",(req,res)=>res.type("text").send("ok"));

app.get("/kv/:key",(req,res)=>res.json({key:req.params.key,value:kread(req.params.key,null)}));
app.post("/kv/:key",(req,res)=>{kwrite(req.params.key,req.body?.value??null);res.json({ok:true});});

app.get("/findtoken/dex",async(req,res)=>{
  try{
    const limit=Math.min(500,Math.max(1,Number(req.query.limit||200)));
    const minLiq=Number(req.query.minLiq||0);
    const r=await fetch("https://api.dexscreener.com/token-profiles/latest/v1",{headers:{"accept":"application/json"}});
    if(!r.ok)return res.status(502).json({error:"DEX_FETCH_FAIL",status:r.status});
    const j=await r.json();
    const items=(Array.isArray(j)?j:[])
      .filter(t=>t&&t.chainId==="solana"&&t.tokenAddress)
      .filter(t=>Number(t.liquidityScore||0)>=minLiq)
      .slice(0,limit)
      .map(t=>({src:"DEX",symbol:t.symbol||"?",name:t.name||"",mint:t.tokenAddress,liquidityScore:Number(t.liquidityScore||0),url:t.url||""}));
    res.json({count:items.length,items});
  }catch(e){res.status(500).json({error:"DEX_FAIL",message:String(e?.message||e)});}
});

app.get("/findtoken/pump",async(req,res)=>{
  try{
    const limit=Math.min(300,Math.max(1,Number(req.query.limit||100)));
    const offset=Math.max(0,Number(req.query.offset||0));
    const url=`https://frontend-api.pump.fun/coins?offset=${offset}&limit=${limit}&sort=created_timestamp&order=desc`;
    const r=await fetch(url,{headers:{"accept":"application/json"}});
    if(!r.ok)return res.status(502).json({error:"PUMP_FETCH_FAIL",status:r.status});
    const j=await r.json();
    const coins=Array.isArray(j?.coins)?j.coins:(Array.isArray(j)?j:[]);
    const items=coins
      .filter(c=>c&&(c.mint||c.address))
      .slice(0,limit)
      .map(c=>({src:"PUMP",symbol:c.symbol||"?",name:c.name||"",mint:c.mint||c.address,marketCap:Number(c.market_cap||c.marketCap||0),created:Number(c.created_timestamp||c.created||0)}));
    res.json({count:items.length,items});
  }catch(e){res.status(500).json({error:"PUMP_FAIL",message:String(e?.message||e)});}
});

app.post("/pnl/push",(req,res)=>{
  const pnl=Number(req.body?.pnl);
  if(!Number.isFinite(pnl))return res.status(400).json({error:"BAD_PNL"});
  const key="BBTRADER_PNL_HIST";
  const hist=kread(key,[]);
  const last=hist.length?Number(hist[hist.length-1]):0;
  const next=last+pnl;
  hist.push(next);while(hist.length>200)hist.shift();
  kwrite(key,hist);
  res.json({ok:true,last,next,len:hist.length});
});
app.get("/pnl/hist",(req,res)=>res.json({items:kread("BBTRADER_PNL_HIST",[])}));

app.use("/",express.static(PUB));

app.listen(PORT,()=>console.log(new Date().toISOString(),"BBTRADER backend on",PORT));
JS


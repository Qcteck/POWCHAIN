window.FI_backend = {};
const L = t => document.getElementById("log").innerHTML += t+"\n";
const API = "https://bbqfinance.fun"; // pas besoin de changer côté serveur

FI_backend.bridge = async () => {
  const addrFI = localStorage.getItem("fi_addr");
  if(!addrFI) return alert("⚠ Génère d’abord un wallet FIREINNERS");

  try{
    const r = await fetch(API+"/bridge",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        powAddress: addrFI,
        solAddress: solAddr.value,
        amountSol: parseFloat(amountBridge.value)
      })
    });
    const j = await r.json();
    L("Bridge → "+JSON.stringify(j));
  }catch(e){ L("Erreur bridge : "+e); }
};

FI_backend.loadBlocks = async () => {
  try{
    const r = await fetch(API+"/stats");
    const j = await r.json();
    document.getElementById("h").textContent=j.height;
    L("Derniers blocs chargés");
  }catch(e){L("Erreur stats : "+e);}
};

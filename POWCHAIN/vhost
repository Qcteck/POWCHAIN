/* POWCHAIN — Validator + HTTP API + WebSocket */
const PORT_HTTP = 3000;
const PORT_WS   = 7001;

const http = require("http");
const url = require("url");
const fs = require("fs");
const crypto = require("crypto");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");

const LEDGER_FILE = "/root/powchain/ledger.json";
const TREASURY_ADDR = "BZJsWeJeivz3YewWjFS187jrcduPFAHWjqL7jgq4kGwy";

/************* ÉTAT GLOBAL *************/
let state = {
  chain: [],
  wallets: {},
  mempool: [],
  lp: { pow: 0, usdc: 0 }
};

/************* PERSISTENCE *************/
function save() {
  fs.writeFileSync(LEDGER_FILE, JSON.stringify(state, null, 2));
}
function load() {
  if (fs.existsSync(LEDGER_FILE)) {
    state = JSON.parse(fs.readFileSync(LEDGER_FILE));
    console.log("🟢 Ledger chargé, height =", state.chain.length);
  } else {
    console.log("⚠️ Aucun ledger trouvé, création genesis…");
    state.chain.push({ height: 1, ts: Date.now(), tx: [], reward: 0 });
    save();
  }
}
load();

/************* UTIL *************/
function newBlock() {
  const block = {
    height: state.chain.length + 1,
    ts: Date.now(),
    tx: state.mempool,
    reward: 10
  };
  state.chain.push(block);
  state.mempool = [];
  save();
  broadcast(JSON.stringify({ type: "block", block }));
}

/************* HTTP API *************/
const server = http.createServer((req, res) => {
  const p = url.parse(req.url, true).pathname;

  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Content-Type", "application/json");

  if (p === "/stats") {
    return res.end(JSON.stringify({
      height: state.chain.length,
      lpPow: state.lp.pow,
      lpUsdc: state.lp.usdc,
      treasuryPow: state.wallets[TREASURY_ADDR] || 0
    }));
  }

  if (p === "/chain") return res.end(JSON.stringify(state.chain));
  if (p === "/wallet") {
    const addr = url.parse(req.url, true).query.addr;
    return res.end(JSON.stringify({ balance: state.wallets[addr] || 0 }));
  }

  res.statusCode = 404;
  res.end(JSON.stringify({ error: "not found" }));
});

server.listen(PORT_HTTP, () =>
  console.log("🟢 HTTP API POWCHAIN sur port", PORT_HTTP, "(/stats /tx /wallet /block /chain)")
);

/************* WEBSOCKET *************/
const wss = new WebSocket.Server({ port: PORT_WS });
wss.on("connection", (ws) => {
  ws.send(JSON.stringify({ type: "hello", height: state.chain.length }));
  ws.on("message", (raw) => {
    try {
      const tx = JSON.parse(raw);
      state.mempool.push(tx);
      ws.send(JSON.stringify({ ok: true }));
      broadcast(JSON.stringify({ type: "mempool", count: state.mempool.length }));
    } catch (e) {
      ws.send(JSON.stringify({ error: "bad tx" }));
    }
  });
});

function broadcast(msg) {
  wss.clients.forEach(c => c.readyState === 1 && c.send(msg));
}

console.log("🟢 WebSocket POWCHAIN sur port", PORT_WS, "(via Nginx possible /ws)");
setInterval(newBlock, 120000);
app.get('/stats',(req,res)=>{
  try{
    const payload={
      ok:true,
      time:new Date().toISOString(),
      height:global.height||0,
      totalPow:global.totalPow||0,
      treasury:global.treasury||0
    };
    res.json(payload);
  }catch(e){
    console.error('Erreur /stats',e);
    res.status(500).json({ok:false,error:'stats_failed'});
  }
});
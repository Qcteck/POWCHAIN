<script>
  // Constantes
  const DRPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
  const TREASURY_SOL = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

  const httpStatus = document.getElementById("httpStatus");
  const wsStatus = document.getElementById("wsStatus");
  const logBox = document.getElementById("log");
  const powAddrInput = document.getElementById("powAddr");
  const powBalInput = document.getElementById("powBal");
  const usdcPowBalInput = document.getElementById("usdcPowBal");
  const solAddrInput = document.getElementById("solAddr");
  const solBalInput = document.getElementById("solBal");
  const usdcSolBalInput = document.getElementById("usdcSolBal");

  const netHeight = document.getElementById("netHeight");
  const netWallets = document.getElementById("netWallets");
  const netTvlPow = document.getElementById("netTvlPow");
  const netTvlUsdc = document.getElementById("netTvlUsdc");
  const netTreasPow = document.getElementById("netTreasPow");
  const netTreasUsdc = document.getElementById("netTreasUsdc");

  let qr = new QRious({ element: document.getElementById("qr"), value: "", size: 140 });
  let powWallet = { addr: "", priv: "" };
  let ws;
  let wsTimer;

  function L(msg) {
    const t = new Date().toLocaleTimeString("fr-CA", { hour12: false });
    logBox.value += "[" + t + "] " + msg + "\n";
    logBox.scrollTop = logBox.scrollHeight;
  }

  function setHttp(ok) {
    httpStatus.textContent = ok ? "HTTP OK" : "HTTP ?";
    httpStatus.className = "pill " + (ok ? "pill-ok" : "pill-bad");
  }

  function setWs(ok) {
    wsStatus.textContent = ok ? "WS OK" : "WS ?";
    wsStatus.className = "pill " + (ok ? "pill-ok" : "pill-bad");
  }

  // Chargement wallet local
  function loadLocalWallet() {
    try {
      const raw = localStorage.getItem("pow_wallet");
      if (!raw) return;
      const w = JSON.parse(raw);
      if (w.addr && w.priv) {
        powWallet = w;
        powAddrInput.value = w.addr;
        qr.setValue(w.addr);
      }
    } catch (e) {
      console.warn("local wallet error", e);
    }
  }

  function saveLocalWallet() {
    if (!powWallet.addr || !powWallet.priv) return;
    localStorage.setItem("pow_wallet", JSON.stringify(powWallet));
  }

  function ensureCryptoLibs() {
    if (typeof nacl === "undefined") throw new Error("nacl non chargé");
    if (typeof bs58 === "undefined") throw new Error("bs58 lib non chargée");
  }

  function genWallet() {
    try {
      ensureCryptoLibs();
      const kp = nacl.sign.keyPair();
      const addr = bs58.encode(kp.publicKey);
      const priv = bs58.encode(kp.secretKey);
      powWallet = { addr, priv };
      saveLocalWallet();
      powAddrInput.value = addr;
      qr.setValue(addr);
      L("Wallet POWCHAIN généré: " + addr);
      reloadPowWallet();
    } catch (e) {
      alert("Erreur génération wallet POWCHAIN : " + e);
    }
  }

  function copyPow() {
    const v = powAddrInput.value.trim();
    if (!v) return;
    navigator.clipboard.writeText(v).then(
      () => alert("Adresse POWCHAIN copiée"),
      () => alert("Impossible de copier l'adresse")
    );
  }

  async function reloadPowWallet() {
    const addr = powAddrInput.value.trim();
    if (!addr) {
      powBalInput.value = "";
      usdcPowBalInput.value = "";
      return;
    }
    try {
      const r = await fetch("/wallet?id=" + encodeURIComponent(addr));
      if (!r.ok) throw new Error("HTTP " + r.status);
      const j = await r.json();
      powBalInput.value = String(j.pow || 0);
      usdcPowBalInput.value = String(j.usdcPow || 0);
      L("Wallet POWCHAIN rechargé");
    } catch (e) {
      L("ERR /wallet: " + e);
    }
  }

  // Stats réseau
  async function refreshStats() {
    try {
      const r = await fetch("/stats");
      if (!r.ok) throw new Error("HTTP " + r.status);
      const j = await r.json();
      netHeight.textContent = j.height;
      netWallets.textContent = j.wallets;
      netTvlPow.textContent = j.tvlPow ?? "-";
      netTvlUsdc.textContent = j.tvlUsdc ?? "-";
      netTreasPow.textContent = j.treasuryPow ?? "-";
      netTreasUsdc.textContent = j.treasuryUsdc ?? "-";
      setHttp(true);
    } catch (e) {
      setHttp(false);
      L("ERR /stats: " + e);
    }
  }

  async function loadBlocks() {
    try {
      const r = await fetch("/chain");
      if (!r.ok) throw new Error("HTTP " + r.status);
      const j = await r.json();
      L("Derniers blocs:\n" + JSON.stringify(j.slice(-5), null, 2));
    } catch (e) {
      L("ERR /chain: " + e);
    }
  }

  function clearLog() {
    logBox.value = "";
  }

  // WebSocket
  function connectWs() {
    if (ws) {
      try { ws.close(); } catch {}
      ws = null;
    }
    const proto = location.protocol === "https:" ? "wss://" : "ws://";
    const URL = proto + location.host + "/ws";
    L("WS connect → " + URL);
    ws = new WebSocket(URL);

    ws.onopen = () => {
      setWs(true);
      L("WebSocket connecté.");
    };
    ws.onclose = () => {
      setWs(false);
      L("WebSocket fermé. Reconnexion dans 3 s.");
      clearTimeout(wsTimer);
      wsTimer = setTimeout(connectWs, 3000);
    };
    ws.onerror = (e) => {
      setWs(false);
      L("WS error: " + (e && e.message ? e.message : "undefined"));
    };
    ws.onmessage = (ev) => {
      try {
        const msg = JSON.parse(ev.data);
        if (msg.type === "welcome") {
          L("WS welcome, height=" + msg.height);
        } else if (msg.type === "stats") {
          netHeight.textContent = msg.height;
          netWallets.textContent = msg.wallets;
          netTreasPow.textContent = msg.treasuryPow;
          netTreasUsdc.textContent = msg.treasuryUsdc;
        } else if (msg.type === "bridge") {
          L("Bridge confirmé: +" + msg.powCred + " POW pour " + msg.fromPow +
            " (SOL " + msg.amountSol + ")");
          reloadPowWallet();
        } else if (msg.type === "tx") {
          L("TX: " + JSON.stringify(msg.tx));
        } else {
          L("WS msg: " + ev.data);
        }
      } catch (e) {
        L("WS msg brut: " + ev.data);
      }
    };
  }

  // Phantom
  async function connectPhantom() {
    try {
      if (!window.solana || !window.solana.isPhantom) {
        alert("Phantom non détecté");
        return;
      }
      const res = await window.solana.connect();
      const addr = res.publicKey.toString();
      solAddrInput.value = addr;
      L("Phantom connecté: " + addr);
      await refreshPhantom();
    } catch (e) {
      alert("Erreur Phantom connect: " + e);
    }
  }

  async function refreshPhantom() {
    try {
      if (!window.solana || !window.solana.publicKey) {
        L("Phantom non connecté");
        return;
      }
      const pub = window.solana.publicKey;
      solAddrInput.value = pub.toString();

      const conn = new solanaWeb3.Connection(DRPC, "confirmed");
      const bal = await conn.getBalance(pub);
      solBalInput.value = (bal / solanaWeb3.LAMPORTS_PER_SOL).toFixed(6);

      // USDC Solana
      const mint = new solanaWeb3.PublicKey(USDC_MINT);
      const accounts = await conn.getParsedTokenAccountsByOwner(pub, { mint });
      let usdc = 0;
      for (const a of accounts.value) {
        const info = a.account.data.parsed.info;
        const dec = info.tokenAmount.decimals;
        const amt = parseInt(info.tokenAmount.amount, 10);
        usdc += amt / Math.pow(10, dec);
      }
      usdcSolBalInput.value = usdc.toFixed(2);

      L("Phantom balances mis à jour");
    } catch (e) {
      alert("Erreur Phantom: " + e);
      L("PHANTOM ERR " + e);
    }
  }

  async function bridgeSol() {
    try {
      if (!window.solana || !window.solana.publicKey) {
        alert("Connecte Phantom d'abord");
        return;
      }
      const addrPow = powAddrInput.value.trim();
      if (!addrPow) {
        alert("Génère un wallet POWCHAIN avant le bridge");
        return;
      }
      const amtStr = document.getElementById("bridgeAmount").value.trim();
      const amountSol = Number(amtStr);
      if (!Number.isFinite(amountSol) || amountSol <= 0) {
        alert("Montant SOL invalide");
        return;
      }

      const conn = new solanaWeb3.Connection(DRPC, "confirmed");
      const fromPk = window.solana.publicKey;
      const toPk = new solanaWeb3.PublicKey(TREASURY_SOL);
      const lamports = Math.floor(amountSol * solanaWeb3.LAMPORTS_PER_SOL);

      const tx = new solanaWeb3.Transaction().add(
        solanaWeb3.SystemProgram.transfer({
          fromPubkey: fromPk,
          toPubkey: toPk,
          lamports
        })
      );
      tx.feePayer = fromPk;
      const { blockhash } = await conn.getLatestBlockhash();
      tx.recentBlockhash = blockhash;

      const sigResult = await window.solana.signAndSendTransaction(tx);
      const sig = sigResult.signature || sigResult;

      L("TX Solana envoyée vers trésorerie: " + sig);

      const resp = await fetch("/tx", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          type: "BRIDGE_SOL",
          fromPow: addrPow,
          amountSol,
          solSig: sig
        })
      });
      if (!resp.ok) {
        const txt = await resp.text();
        L("HTTP /tx -> " + resp.status + " " + txt);
        alert("Bridge rejeté: HTTP " + resp.status);
        return;
      }
      const j = await resp.json();
      L("Bridge réponse: " + JSON.stringify(j));
      alert("Requête de bridge envoyée (voir logs POWCHAIN).");
      await reloadPowWallet();
      await refreshStats();
    } catch (e) {
      L("ERR bridge: " + e);
      alert("Erreur bridge: " + e);
    }
  }

  // Init
  loadLocalWallet();
  if (powWallet.addr) {
    qr.setValue(powWallet.addr);
  }
  refreshStats();
  connectWs();
</script>

// ---- NICE ALIAS ----
function randomInt(min,max){return Math.floor(Math.random()*(max-min+1))+min;}
function randomTag(len){
  const chars="ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  let s=""; for(let i=0;i<len;i++) s+=chars[Math.floor(Math.random()*chars.length)];
  return s;
}
function generateNiceAlias(){
  const id=randomInt(1,100000000);
  const block=randomTag(4);
  return `FIRE441-${id}-${block}-INNERS`;
}

// ---- PHANTOM ----
async function connectPhantom(){
  try{
    const p=window.solana;
    if(!p||!p.isPhantom){ alert("Phantom non détecté"); return; }
    const resp=await p.connect();
    solAddr=resp.publicKey.toString();
    q("#solAddr").value=solAddr;
    log("Phantom connecté : "+solAddr);
    await loadSolBalances();
  }catch(e){
    log("Erreur Phantom : "+e.message);
  }
}
async function loadSolBalances(){
  if(!solAddr)return;
  try{
    const r=await fetch(SOL_RPC,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]})
    });
    const j=await r.json();
    const lam=j.result&&typeof j.result.value==="number"?j.result.value:0;
    q("#solBal").value=(lam/1e9).toFixed(4);

    const r2=await fetch(SOL_RPC,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        jsonrpc:"2.0",
        id:1,
        method:"getTokenAccountsByOwner",
        params:[solAddr,{mint:USDC_MINT},{encoding:"jsonParsed"}]
      })
    });
    const j2=await r2.json();
    let total=0;
    (j2.result&&j2.result.value||[]).forEach(a=>{
      const v=a.account&&a.account.data&&a.account.data.parsed&&a.account.data.parsed.info&&a.account.data.parsed.info.tokenAmount&&a.account.data.parsed.info.tokenAmount.uiAmount||0;
      total+=v;
    });
    q("#usdcBal").value=total.toFixed(2);
    updateBalSummary();
  }catch(e){
    log("Bal ERR : "+e.message);
  }
}
q("#btnPhantom").onclick=connectPhantom;
q("#btnSolRefresh").onclick=loadSolBalances;


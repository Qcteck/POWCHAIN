nano /etc/nginx/sites-available/bbqfinance

server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/bbqfinance;
    index index.html;

    # Page web POWCHAIN (HTML, CSS, JS...)
    location / {
        try_files $uri /index.html;
    }

    # API POWCHAIN HTTP sur le Node.js (port 3000)
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /tx {
        proxy_pass http://127.0.0.1:3000/tx;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /block {
        proxy_pass http://127.0.0.1:3000/block;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket POWCHAIN (port 7001)
    location = /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600;
    }
}

nano /etc/nginx/sites-available/bbqfinance   # colle tout ce bloc, en remplaçant l'ancien

sudo ln -sf /etc/nginx/sites-available/bbqfinance /etc/nginx/sites-enabled/bbqfinance
sudo rm -f /etc/nginx/sites-enabled/default

nginx -t
sudo systemctl restart nginx
curl -s http://127.0.0.1:3000/stats
curl -s http://bbqfinance.fun/stats
wscat -c ws://bbqfinance.fun/ws



g:.06em;box-shadow:0 0 14px rgba(255,154,47,.4)}button:hover{filter:brightness(1.08);box-shadow:0 0 20px rgba(255,207,92,.6)}button.sec{background:linear-gradient(90deg,#332040,#1c0a23);color:#f4ddff;border-color:#4b2b60;box-shadow:none}small.hint{font-size:11px;color:#f9d88a;opacity:.9}#log{background:#050008;border:1px solid #3a243e;border-radius:12px;padding:10px;height:170px;overflow:auto;font-size:11px;color:#ffe9a6;white-space:pre-wrap;box-shadow:0 0 18px #000 inset}#qrBox{width:120px;height:120px;border-radius:10px;border:1px solid(var(--accentBorder));background:#050008;margin:4px 0 8px;display:flex;align-items:center;justify-content:center}#qr{background:#050008}#mempoolLive{height:210px;overflow:auto;font-size:11px;color:#ffe4b8;background:#050008;border-radius:10px;padding:8px;border:1px solid #3b234e}pre{margin:0}#fireFrame{width:100%;min-height:400px;border-radius:10px;border:1px solid #3b2346;background:#020009}@media (max-width:900px){#app{flex-direction:column}#side{width:100%;flex-direction:row;overflow-x:auto}nav{display:flex;flex-wrap:nowrap;gap:6px}nav a{white-space:nowrap}#main{flex:1}}</style></head><body><div id="app"><aside id="side"><div id="logoBox"><div id="logoI"></div><div id="logoTxt">FIREINNERS</div></div><nav><a class="navitem active" data-tab="wallet"><span class="bullet"></span>Wallet</a><a class="navitem" data-tab="bridge"><span class="bullet"></span>Bridge</a><a class="navitem" data-tab="dex"><span class="bullet"></span>DEX</a><a class="navitem" data-tab="stake"><span class="bullet"></span>Staking</a><a class="navitem" data-tab="explorer"><span class="bullet"></span>Explorer</a><a class="navitem" data-tab="mempool"><span class="bullet"></span>Mempool</a><a class="navitem" data-tab="mining"><span class="bullet"></span>Mining</a><a class="navitem" data-tab="firebrowser"><span class="bullet"></span>Firebrowser</a><a class="navitem" data-tab="theme"><span class="bullet"></span>Colors</a><a class="navitem" data-tab="stats"><span class=
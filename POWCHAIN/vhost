  const tx={
    type:"SWAP",
    amount:Math.floor(amt*DEC),
    token:q("#swapDir").value,
    nonce:powNonce+1,
    from:powAddr
  };
  tx.sig=signTx(tx);

  sock.send(JSON.stringify(tx));
  powNonce++;
  log("Swap TX envoyée");
};


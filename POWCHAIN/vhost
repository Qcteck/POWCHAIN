"use strict";

const fs = require("fs");
const path = require("path");
const http = require("http");
const WebSocket = require("ws");
const express = require("express");
const crypto = require("crypto");

// ================== CONFIG ==================
const PORT_HTTP = 3000;
const PORT_WS   = 7001;
const CHAIN_FILE = path.join(__dirname, "chain.json");
const DEC = 1e6;

// =============== ÉTAT EN MÉMOIRE ===============
let chain = [];          // liste de blocs
let state = {            // état global
  wallets: {},           // addr -> { pow, usdc, staked, nonce, pub }
  lpPow: 0,
  lpUsdc: 0,
  treasuryUsdc: 0,
  treasurySol: 0
};

let mempool = [];        // tx en attente
let wss;                 // serveur WebSocket (sera défini plus bas)

// =============== UTILITAIRES ===============

function loadChain() {
  try {
    const raw = fs.readFileSync(CHAIN_FILE, "utf8");
    const parsed = JSON.parse(raw);
    chain = parsed.chain || [];
    state = parsed.state || state;
    if (!state.wallets) state.wallets = {};
    console.log("✅Blockchain chargée :", chain.length, "blocs");
  } catch (e) {
    console.log("⚠️Aucune chain.json valide, nouvelle chaîne.");
    chain = [];
    state.wallets = {};
  }
}

function saveChain() {
  try {
    const payload = JSON.stringify({ chain, state }, null, 2);
    fs.writeFileSync(CHAIN_FILE, payload, "utf8");
  } catch (e) {
    console.error("❌Erreur saveChain:", e.message);
  }
}

function getWallet(addr) {
  if (!state.wallets[addr]) {
    state.wallets[addr] = { pow: 0, usdc: 0, staked: 0, nonce: 0, pub: addr };
  }
  return state.wallets[addr];
}

function applyTx(tx) {
  if (!tx || !tx.type) return false;

  if (tx.type === "TX_POW") {
    const from = getWallet(tx.from);
    const to   = getWallet(tx.to);
    const amt  = Math.floor(tx.amount || 0);
    if (amt <= 0 || from.pow < amt) return false;
    from.pow -= amt;
    to.pow   += amt;
    from.nonce = (from.nonce || 0) + 1;
    return true;
  }

  if (tx.type === "STAKE") {
    const w = getWallet(tx.addr || tx.from);
    const amt = Math.floor(tx.amount || 0);
    if (amt <= 0 || w.pow < amt) return false;
    w.pow -= amt;
    w.staked += amt;
    w.nonce = (w.nonce || 0) + 1;
    return true;
  }

  if (tx.type === "SWAP") {
    const w = getWallet(tx.addr || tx.from);
    const amt = Math.floor(tx.amount || 0);
    if (amt <= 0) return false;

    // AMM x*y = k simplifié
    let x, y, fromToken, toToken;
    if (tx.token === "pow2usdc") {
      if (w.pow < amt || state.lpPow <= 0 || state.lpUsdc <= 0) return false;
      x = state.lpPow;
      y = state.lpUsdc;
      const k = x * y;
      const newX = x + amt;
      const newY = Math.floor(k / newX);
      const out = y - newY;

      w.pow -= amt;
      w.usdc += out;
      state.lpPow = newX;
      state.lpUsdc = newY;
    } else if (tx.token === "usdc2pow") {
      if (w.usdc < amt || state.lpPow <= 0 || state.lpUsdc <= 0) return false;
      x = state.lpUsdc;
      y = state.lpPow;
      const k = x * y;
      const newX = x + amt;
      const newY = Math.floor(k / newX);
      const out = y - newY;

      w.usdc -= amt;
      w.pow += out;
      state.lpUsdc = newX;
      state.lpPow = newY;
    } else {
      return false;
    }
    w.nonce = (w.nonce || 0) + 1;
    return true;
  }

  if (tx.type === "LP_ADD") {
    const w = getWallet(tx.addr || tx.from);
    const p = Math.floor(tx.pow || 0);
    const u = Math.floor(tx.usdc || 0);
    if (p <= 0 || u <= 0) return false;
    if (w.pow < p || w.usdc < u) return false;

    w.pow  -= p;
    w.usdc -= u;
    state.lpPow  += p;
    state.lpUsdc += u;
    w.nonce = (w.nonce || 0) + 1;
    return true;
  }

  return false;
}

function mineBlock() {
  if (mempool.length === 0) return;

  const height = chain.length > 0 ? chain[chain.length - 1].height + 1 : 1;
  const txs = mempool.splice(0, mempool.length);

  for (const tx of txs) {
    applyTx(tx);
  }

  const prevHash = chain.length ? chain[chain.length - 1].hash : "GENESIS";
  const time = Date.now();
  const content = JSON.stringify({ height, prevHash, time, txs });
  const hash = crypto.createHash("sha256").update(content).digest("hex");

  const block = { height, prevHash, time, txs, hash, validator: "LOCAL" };
  chain.push(block);
  saveChain();

  broadcast({ type: "NEW_BLOCK", block });
  console.log("⛏️Bloc miné", height, "TX:", txs.length);
}

function broadcast(msg) {
  if (!wss) return;
  const data = JSON.stringify(msg);
  wss.clients.forEach(c => {
    if (c.readyState === WebSocket.OPEN) c.send(data);
  });
}

// =============== LANCEMENT ===============
loadChain();
setInterval(mineBlock, 5000);

// =============== HTTP API (Express) ===============
const app = express();
app.use(express.json());

// /stats -> infos réseau + LP + trésorerie
app.get("/stats", (req, res) => {
  const height = chain.length ? chain[chain.length - 1].height : 0;
  res.json({
    height,
    lpPow: Math.floor(state.lpPow || 0),
    lpUsdc: Math.floor(state.lpUsdc || 0),
    treasuryUsdc: Math.floor(state.treasuryUsdc || 0),
    treasurySol: state.treasurySol || 0
  });
});

// /wallet/:addr -> état du wallet
app.get("/wallet/:addr", (req, res) => {
  const addr = req.params.addr;
  const w = getWallet(addr);
  res.json({
    pow: Math.floor(w.pow || 0),
    usdc: Math.floor(w.usdc || 0),
    staked: Math.floor(w.staked || 0),
    nonce: w.nonce || 0,
    pub: w.pub || addr
  });
});

// POST /tx -> alternative HTTP pour envoyer une TX (optionnel)
app.post("/tx", (req, res) => {
  const tx = req.body || {};
  mempool.push(tx);
  res.json({ ok: true, queued: true });
});

// /block/:height -> détail d'un bloc
app.get("/block/:height", (req, res) => {
  const h = parseInt(req.params.height, 10);
  if (isNaN(h)) return res.status(400).json({ error: "invalid height" });
  const b = chain.find(x => x.height === h);
  if (!b) return res.status(404).json({ error: "block not found" });
  res.json(b);
});

// /chain -> derniers blocs (max 50)
app.get("/chain", (req, res) => {
  const max = 50;
  const start = chain.length > max ? chain.length - max : 0;
  res.json({ chain: chain.slice(start) });
});

// Création serveur HTTP + WebSocket
const httpServer = http.createServer(app);
httpServer.listen(PORT_HTTP, () => {
  console.log("✅HTTP API POWCHAIN sur port", PORT_HTTP, "(/stats /tx /wallet /block /chain)");
});

// =============== WEBSOCKET ===============
wss = new WebSocket.Server({ server: httpServer });

wss.on("connection", ws => {
  console.log("✅Client WebSocket connecté");
  ws.on("close", () => {
    console.log("❌Client WebSocket déconnecté");
  });
  ws.on("message", data => {
    try {
      const tx = JSON.parse(data.toString());
      mempool.push(tx);
    } catch (e) {
      console.error("❌WS message invalide:", e.message);
    }
  });
});

console.log("✅WebSocket POWCHAIN sur port", PORT_WS, "(via Nginx /ws si proxy configuré)");
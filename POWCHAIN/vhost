sudo nano /etc/nginx/sites-available/bbqfinance



# Serveur HTTP public
server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # Redirect HTTP -> HTTPS
    return 301 https://$host$request_uri;
}

# Serveur HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name bbqfinance.fun www.bbqfinance.fun;

    ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;

    # ----------- WebSocket POWCHAIN -----------
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # ----------- API POWCHAIN -----------
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
    }

    # ----------- FRONTEND HTML -----------
    location / {
        root /root/powchain;
        index index.html;
    }
}
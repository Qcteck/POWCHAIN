// server.js - POWCHAIN / FIREINNERS Validator + API + WS

const express = require("express");
const bodyParser = require("body-parser");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const crypto = require("crypto");
const http = require("http");
const { TextEncoder } = require("util");

// =========================
// CONFIG SERVEUR
// =========================

const HTTP_PORT = 3000; // nginx proxy vers 127.0.0.1:3000
const WS_PATH = "/ws";  // nginx location /ws

const app = express();
app.use(bodyParser.json());

const server = http.createServer(app);
const wss = new WebSocket.Server({ server, path: WS_PATH });

const clients = new Set();

// =========================
// CONFIG ECONOMIE POWCHAIN
// =========================

const DEC = 1e6; // 6 décimales
const SUPPLY_MAX = 100_000_000 * DEC; // hard cap 100M POW

// Taux dynamique POW/SOL
const RATE_BASE = 1000;           // base POW par SOL
const TVL_REF = 1_000_000 * DEC;  // 1M USDC POW de référence
const RATE_MIN = 800;             // min POW / SOL
const RATE_MAX = 5000;            // max POW / SOL

// Frais en basis points (1% = 100 bp)
const FEE_TRANSFER_BURN_BP = 50;   // 0.5% burn sur transfert POW
const FEE_SWAP_TOTAL_BP = 30;      // 0.3% total fees sur swap
const FEE_SWAP_BURN_PART = 0.5;    // 50% des fees swap brûlés
const FEE_BRIDGE_IN_TREAS_BP = 500; // 5% vers trésorerie à l'entrée
const FEE_BRIDGE_IN_BURN_BP = 200;  // 2% burn à l'entrée
const FEE_BRIDGE_OUT_BURN_BP = 1000; // 10% burn sur POW renvoyés
const FEE_UNSTAKE_BURN_BP = 300;   // 3% burn si unstake anticipé

const STAKE_MIN_LOCK_MS = 30 * 24 * 60 * 60 * 1000; // 30 jours

// =========================
// ETAT GLOBAL
// =========================

let wallets = {}; // addr -> { pow, usdc, staked, pub, nonce, stakeLock }
let treasury = { pow: 0, usdc: 0, sol: 0 };
let lp = { pow: 0, usdc: 0 };

let supplyCirculante = 0;
let mintedPowTotal = 0;
let burnedPowTotal = 0;

let chain = [];
let mempool = [];

// =========================
// GENESIS
// =========================

(function initGenesis() {
  const genesisSupply = 100_000_000 * DEC;
  supplyCirculante = genesisSupply;
  mintedPowTotal = genesisSupply;
  treasury.pow = genesisSupply;
  const genesis = {
    height: 1,
    time: Date.now(),
    prevHash: "0".repeat(64),
    hash: "GENESIS",
    txs: [],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  };
  chain.push(genesis);
})();

// =========================
// OUTILS GENERAUX
// =========================

function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = {
      pow: 0,
      usdc: 0,
      staked: 0,
      pub: addr,
      nonce: 0,
      stakeLock: 0
    };
  }
  return wallets[addr];
}

function clamp(x, min, max) {
  return x < min ? min : x > max ? max : x;
}

// TVL en USDC POW: LP + trésorerie
function getTVL() {
  const lpUsdc = lp.usdc || 0;
  const treUsdc = treasury.usdc || 0;
  return lpUsdc + treUsdc;
}

// Taux dynamique POW / SOL borné
function getPowRatePowPerSol() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || DEC);
  const rawRate = RATE_BASE * factor;
  const rate = clamp(rawRate, RATE_MIN, RATE_MAX);
  return rate;
}

function burnPow(amount) {
  if (!amount || amount <= 0) return 0;
  const actual = Math.min(amount, supplyCirculante);
  burnedPowTotal += actual;
  supplyCirculante -= actual;
  return actual;
}

function mintPow(amount) {
  if (!amount || amount <= 0) return 0;
  const spaceLeft = SUPPLY_MAX - supplyCirculante;
  const mintable = Math.max(0, Math.min(amount, spaceLeft));
  mintedPowTotal += mintable;
  supplyCirculante += mintable;
  return mintable;
}

function addPowToWallet(addr, amount) {
  const w = ensureWallet(addr);
  w.pow += amount;
}

function subPowFromWallet(addr, amount) {
  const w = ensureWallet(addr);
  if (w.pow < amount) throw new Error("Solde POW insuffisant");
  w.pow -= amount;
}

function addUsdcToWallet(addr, amount) {
  const w = ensureWallet(addr);
  w.usdc += amount;
}

function subUsdcFromWallet(addr, amount) {
  const w = ensureWallet(addr);
  if (w.usdc < amount) throw new Error("Solde USDC POW insuffisant");
  w.usdc -= amount;
}

function applyBp(amount, bp) {
  return Math.floor(amount * bp / 10000);
}

// Prix LP (microUSDC / microPOW)
function getLpPrice() {
  if (lp.pow <= 0 || lp.usdc <= 0) return 0;
  return lp.usdc / lp.pow;
}

function computeBlockHash(block) {
  const h = crypto.createHash("sha256");
  const payload = {
    height: block.height,
    prevHash: block.prevHash,
    time: block.time,
    txs: block.txs
  };
  h.update(JSON.stringify(payload));
  return h.digest("hex");
}

function broadcast(msg) {
  const data = JSON.stringify(msg);
  for (const ws of clients) {
    if (ws.readyState === WebSocket.OPEN) {
      ws.send(data);
    }
  }
}

// =========================
// VERIFICATION SIGNATURE
// =========================

function verifySignature(tx) {
  if (!tx.sig || !tx.pub || !tx.nonce) {
    throw new Error("Signature ou nonce manquant");
  }
  const from = tx.from || tx.addr;
  if (!from) throw new Error("Champ from/addr manquant pour la signature");

  const payload = {
    type: tx.type,
    from: from,
    to: tx.to || null,
    amount: tx.amount || null,
    token: tx.token || null,
    nonce: tx.nonce
  };

  const enc = new TextEncoder();
  const msgBytes = enc.encode(JSON.stringify(payload));
  const sigBytes = bs58.decode(tx.sig);
  const pubBytes = bs58.decode(tx.pub);

  const ok = nacl.sign.detached.verify(msgBytes, sigBytes, pubBytes);
  if (!ok) throw new Error("Signature invalide");

  const w = ensureWallet(from);
  if (tx.nonce <= (w.nonce || 0)) {
    throw new Error("Nonce rejeté (replay)");
  }
  w.nonce = tx.nonce;
  w.pub = tx.pub;
}

// =========================
// HANDLERS ECONOMIQUES
// =========================

// 1) TRANSFERT POW
function processPowTransfer(tx) {
  if (!tx.from || !tx.to) throw new Error("from/to manquant");
  if (!tx.amount || tx.amount <= 0) throw new Error("amount invalide");

  const gross = tx.amount;
  const feeBurn = applyBp(gross, FEE_TRANSFER_BURN_BP);
  const sendAmount = gross - feeBurn;
  if (sendAmount <= 0) throw new Error("montant après burn insuffisant");

  subPowFromWallet(tx.from, gross);
  addPowToWallet(tx.to, sendAmount);
  burnPow(feeBurn);

  return {
    type: "TX_POW",
    from: tx.from,
    to: tx.to,
    gross,
    sendAmount,
    burned: feeBurn
  };
}

// 2) SWAP POW / USDC POW
function processSwap(tx) {
  const { addr, amount, token } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");
  if (!lp.pow || !lp.usdc) throw new Error("pool LP vide");
  if (token !== "pow2usdc" && token !== "usdc2pow") {
    throw new Error("direction swap invalide");
  }

  const feeTotal = applyBp(amount, FEE_SWAP_TOTAL_BP);
  const amountNet = amount - feeTotal;
  if (amountNet <= 0) throw new Error("amount net swap invalide");

  const feeBurn = Math.floor(feeTotal * FEE_SWAP_BURN_PART);
  const feeTreas = feeTotal - feeBurn;

  if (token === "pow2usdc") {
    subPowFromWallet(addr, amount);
    lp.pow += amountNet;

    const k = lp.pow * lp.usdc;
    const newPow = lp.pow;
    const newUsdc = Math.floor(k / newPow);
    const deltaUsdc = lp.usdc - newUsdc;
    if (deltaUsdc <= 0) throw new Error("delta usdc invalide");
    lp.usdc = newUsdc;

    addUsdcToWallet(addr, deltaUsdc);

    const burned = burnPow(feeBurn);
    treasury.pow += feeTreas;
    supplyCirculante += feeTreas;

    return {
      type: "SWAP",
      dir: "pow2usdc",
      inPow: amount,
      outUsdc: deltaUsdc,
      feeBurn: burned,
      feeTreasPow: feeTreas
    };
  } else {
    subUsdcFromWallet(addr, amount);
    lp.usdc += amountNet;

    const k = lp.pow * lp.usdc;
    const newUsdc = lp.usdc;
    const newPow = Math.floor(k / newUsdc);
    const deltaPow = lp.pow - newPow;
    if (deltaPow <= 0) throw new Error("delta pow invalide");
    lp.pow = newPow;

    addPowToWallet(addr, deltaPow);

    const burned = burnPow(feeBurn);
    treasury.usdc += feeTreas;

    return {
      type: "SWAP",
      dir: "usdc2pow",
      inUsdc: amount,
      outPow: deltaPow,
      feeBurn: burned,
      feeTreasUsdc: feeTreas
    };
  }
}

// 3) LP ADD
function processLPAdd(tx) {
  const { addr, pow, usdc } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!pow || pow <= 0 || !usdc || usdc <= 0) {
    throw new Error("valeurs LP invalides");
  }
  subPowFromWallet(addr, pow);
  subUsdcFromWallet(addr, usdc);
  lp.pow += pow;
  lp.usdc += usdc;
  return {
    type: "LP_ADD",
    addr,
    pow,
    usdc
  };
}

// 4) BRIDGE SOL -> POWCHAIN
// Ici on suppose que le front a déjà fait envoyer du SOL/USDC vers la trésorerie côté Solana.
// Ce handler crédite simplement des POW en fonction du montant déclaré.
function processBridgeIn(tx) {
  const { addr, solAmount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!solAmount || solAmount <= 0) throw new Error("solAmount invalide");

  const rate = getPowRatePowPerSol();
  const powBrut = Math.floor(solAmount * rate * DEC);

  const powToMint = mintPow(powBrut);
  if (powToMint <= 0) throw new Error("supply max atteint");

  const feeTreas = applyBp(powToMint, FEE_BRIDGE_IN_TREAS_BP);
  const feeBurn = applyBp(powToMint, FEE_BRIDGE_IN_BURN_BP);
  const userPow = powToMint - feeTreas - feeBurn;
  if (userPow <= 0) throw new Error("bridge in net <= 0");

  treasury.pow += feeTreas;
  const burned = burnPow(feeBurn);
  addPowToWallet(addr, userPow);

  treasury.sol += solAmount;

  return {
    type: "BRIDGE_IN",
    addr,
    solAmount,
    rate,
    powMinted: powToMint,
    userPow,
    feeTreasPow: feeTreas,
    burnedPow: burned
  };
}

// 5) BRIDGE POW -> SOL
function processBridgeOut(tx) {
  const { addr, powAmount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!powAmount || powAmount <= 0) throw new Error("powAmount invalide");

  const rate = getPowRatePowPerSol();

  subPowFromWallet(addr, powAmount);

  const feeBurn = applyBp(powAmount, FEE_BRIDGE_OUT_BURN_BP);
  const powNet = powAmount - feeBurn;
  if (powNet <= 0) throw new Error("bridge out net <= 0");

  const burned = burnPow(powAmount);

  const solOut = powNet / (rate * DEC);
  if (treasury.sol < solOut) {
    throw new Error("SOL trésorerie insuffisant pour bridge out");
  }
  treasury.sol -= solOut;

  return {
    type: "BRIDGE_OUT",
    addr,
    powSent: powAmount,
    powNet,
    burnedPow: burned,
    rate,
    solOut
  };
}

// 6) STAKING
function processStake(tx) {
  const { addr, amount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");

  const w = ensureWallet(addr);
  if (w.pow < amount) throw new Error("solde POW insuffisant");

  w.pow -= amount;
  w.staked += amount;
  w.stakeLock = Date.now() + STAKE_MIN_LOCK_MS;

  return {
    type: "STAKE",
    addr,
    amount,
    lockUntil: w.stakeLock
  };
}

function processUnstake(tx) {
  const { addr, amount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");

  const w = ensureWallet(addr);
  if (w.staked < amount) throw new Error("solde STAKE insuffisant");

  let penalty = 0;
  if (Date.now() < (w.stakeLock || 0)) {
    penalty = applyBp(amount, FEE_UNSTAKE_BURN_BP);
  }
  const net = amount - penalty;
  if (net <= 0) throw new Error("unstake net <= 0");

  w.staked -= amount;
  w.pow += net;

  const burned = burnPow(penalty);

  return {
    type: "UNSTAKE",
    addr,
    amount,
    net,
    burned
  };
}

// =========================
// APPLICATION TX + BLOCS
// =========================

function applyTxAndMakeBlock(tx) {
  const from = tx.from || tx.addr;
  if (!from) throw new Error("from/addr manquant");

  verifySignature(tx);

  let effect;
  switch (tx.type) {
    case "TX_POW":
      effect = processPowTransfer(tx);
      break;
    case "SWAP":
      effect = processSwap(tx);
      break;
    case "LP_ADD":
      effect = processLPAdd(tx);
      break;
    case "BRIDGE_IN":
      effect = processBridgeIn(tx);
      break;
    case "BRIDGE_OUT":
      effect = processBridgeOut(tx);
      break;
    case "STAKE":
      effect = processStake(tx);
      break;
    case "UNSTAKE":
      effect = processUnstake(tx);
      break;
    default:
      throw new Error("type de TX inconnu: " + tx.type);
  }

  const prev = chain[chain.length - 1];
  const block = {
    height: prev.height + 1,
    time: Date.now(),
    prevHash: prev.hash,
    txs: [{ ...tx, effect }],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  };
  block.hash = computeBlockHash(block);
  chain.push(block);

  return { effect, block };
}

// =========================
// API HTTP
// =========================

// Stats globales
app.get("/stats", (req, res) => {
  const last = chain[chain.length - 1];
  res.json({
    height: last ? last.height : 0,
    supplyCirculante,
    mintedPowTotal,
    burnedPowTotal,
    lpPow: lp.pow,
    lpUsdc: lp.usdc,
    priceLp: getLpPrice(),
    tvl: getTVL(),
    treasuryPow: treasury.pow,
    treasuryUsdc: treasury.usdc,
    treasurySol: treasury.sol
  });
});

// Wallet
app.get("/wallet/:addr", (req, res) => {
  const addr = req.params.addr;
  const w = ensureWallet(addr);
  res.json({
    addr,
    pow: w.pow,
    usdc: w.usdc,
    staked: w.staked,
    nonce: w.nonce,
    pub: w.pub,
    stakeLock: w.stakeLock
  });
});

// Bloc par hauteur
app.get("/block/:height", (req, res) => {
  const h = parseInt(req.params.height, 10);
  if (Number.isNaN(h)) return res.status(400).json({ error: "height invalide" });
  const b = chain.find(b => b.height === h);
  if (!b) return res.status(404).json({ error: "bloc introuvable" });
  res.json(b);
});

// Liste de quelques blocs récents pour l'explorateur
app.get("/blocks/recent", (req, res) => {
  const n = Math.max(1, Math.min(50, parseInt(req.query.n || "20", 10)));
  const out = chain.slice(-n);
  res.json(out);
});

// Bridge IN via HTTP (optionnel, le front peut aussi utiliser WS)
app.post("/bridge/in", (req, res) => {
  try {
    const tx = req.body || {};
    tx.type = "BRIDGE_IN";
    if (!tx.addr || typeof tx.solAmount !== "number") {
      return res.status(400).json({ error: "addr/solAmount requis" });
    }
    const { effect, block } = applyTxAndMakeBlock(tx);
    broadcast({ type: "NEW_BLOCK", height: block.height });
    res.json({ ok: true, effect, height: block.height });
  } catch (e) {
    res.status(400).json({ error: e.message || String(e) });
  }
});

// Bridge OUT via HTTP (optionnel)
app.post("/bridge/out", (req, res) => {
  try {
    const tx = req.body || {};
    tx.type = "BRIDGE_OUT";
    if (!tx.addr || typeof tx.powAmount !== "number") {
      return res.status(400).json({ error: "addr/powAmount requis" });
    }
    const { effect, block } = applyTxAndMakeBlock(tx);
    broadcast({ type: "NEW_BLOCK", height: block.height });
    res.json({ ok: true, effect, height: block.height });
  } catch (e) {
    res.status(400).json({ error: e.message || String(e) });
  }
});

// =========================
// WEBSOCKET
// =========================

wss.on("connection", ws => {
  clients.add(ws);

  const last = chain[chain.length - 1];
  ws.send(JSON.stringify({
    type: "HELLO",
    height: last ? last.height : 0,
    tvl: getTVL()
  }));

  ws.on("message", data => {
    try {
      let tx;
      try {
        tx = JSON.parse(data.toString());
      } catch {
        throw new Error("payload JSON invalide");
      }
      const { effect, block } = applyTxAndMakeBlock(tx);
      ws.send(JSON.stringify({
        ok: true,
        type: "TX_ACCEPTED",
        txType: tx.type,
        height: block.height,
        effect
      }));
      broadcast({
        type: "NEW_BLOCK",
        height: block.height
      });
    } catch (e) {
      ws.send(JSON.stringify({
        ok: false,
        error: e.message || String(e)
      }));
    }
  });

  ws.on("close", () => {
    clients.delete(ws);
  });
});

// =========================
// DEMARRAGE SERVEUR
// =========================

server.listen(HTTP_PORT, () => {
  console.log("HTTP + WS POWCHAIN sur port", HTTP_PORT);
});



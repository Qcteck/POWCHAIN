// POWCHAIN backend minimal (HTTP + WS + bridge)
// -------------------------------------------------
const fs = require("fs");
const path = require("path");
const http = require("http");
const express = require("express");
const WebSocket = require("ws");
const cors = require("cors");

// ---------- ÉTAT LOCAL ----------
const LEDGER_FILE = path.join(__dirname, "ledger.json");

let chain = { height: 0, blocks: [] };      // mini chaîne locale
let wallets = {};                           // {addr:{pow,usdc,staked}}
let treasuryPow = 0;
let treasuryUsdc = 0;
let lpPow = 0;
let lpUsdc = 0;

function loadLedger() {
  try {
    const raw = fs.readFileSync(LEDGER_FILE, "utf8");
    const data = JSON.parse(raw);
    chain = data.chain || chain;
    wallets = data.wallets || wallets;
    treasuryPow = data.treasuryPow || 0;
    treasuryUsdc = data.treasuryUsdc || 0;
    lpPow = data.lpPow || 0;
    lpUsdc = data.lpUsdc || 0;
    console.log("✅ Ledger chargé, height =", chain.height || 0);
  } catch (e) {
    console.log("ℹ️ Aucun ledger trouvé, initialisation neuve.");
    saveLedger();
  }
}

function saveLedger() {
  const data = {
    chain,
    wallets,
    treasuryPow,
    treasuryUsdc,
    lpPow,
    lpUsdc,
  };
  try {
    fs.writeFileSync(LEDGER_FILE, JSON.stringify(data, null, 2));
  } catch (e) {
    console.error("❌ Erreur sauvegarde ledger:", e.message);
  }
}

function getWallet(addr) {
  if (!addr || typeof addr !== "string") return null;
  if (!wallets[addr]) {
    wallets[addr] = { pow: 0, usdc: 0, staked: 0 };
  }
  return wallets[addr];
}

function currentStats() {
  return {
    height: chain.height || 0,
    wallets: Object.keys(wallets).length,
    treasuryPow,
    treasuryUsdc,
    lpPow,
    lpUsdc,
  };
}

function pushBlock(event) {
  chain.height = (chain.height || 0) + 1;
  const block = {
    height: chain.height,
    time: Date.now(),
    event,
  };
  chain.blocks.push(block);
  if (chain.blocks.length > 1000) chain.blocks.shift();
  saveLedger();
  broadcast({ type: "block", block, stats: currentStats() });
}

// ---------- EXPRESS HTTP ----------
const app = express();
app.use(cors());
app.use(express.json());

// Stats réseau POWCHAIN (utilisé par le HUD)
app.get("/stats", (req, res) => {
  res.json(currentStats());
});

// Retourne les derniers blocs (explorer)
app.get("/chain", (req, res) => {
  res.json(chain.blocks || []);
});

// Détails d’un wallet POWCHAIN
app.get("/wallet/:addr", (req, res) => {
  const addr = req.params.addr;
  const w = getWallet(addr) || { pow: 0, usdc: 0, staked: 0 };
  res.json({ addr, ...w });
});

// TX POWCHAIN classiques (SEND / STAKE / ADD_LP)
app.post("/tx", (req, res) => {
  try {
    const { type, from, to, amount, token, powAmount, usdcAmount } = req.body || {};
    if (!type) return res.status(400).json({ error: "missing type" });

    // transfert POW / USDC POW
    if (type === "transfer") {
      const amt = Number(amount) || 0;
      if (!from || !to || amt <= 0) {
        return res.status(400).json({ error: "invalid transfer" });
      }
      const wf = getWallet(from);
      const wt = getWallet(to);
      if (!wf || !wt) return res.status(400).json({ error: "wallets invalides" });

      if (token === "POW") {
        if (wf.pow < amt) return res.status(400).json({ error: "solde POW insuffisant" });
        wf.pow -= amt;
        wt.pow += amt;
      } else if (token === "USDCP") {
        if (wf.usdc < amt) return res.status(400).json({ error: "solde USDC POW insuffisant" });
        wf.usdc -= amt;
        wt.usdc += amt;
      } else {
        return res.status(400).json({ error: "token inconnu" });
      }
      pushBlock({ type, from, to, amount: amt, token });
      return res.json({ ok: true, stats: currentStats() });
    }

    // STAKE POW
    if (type === "stake") {
      const amt = Number(amount) || 0;
      if (!from || amt <= 0) return res.status(400).json({ error: "invalid stake" });
      const w = getWallet(from);
      if (w.pow < amt) return res.status(400).json({ error: "solde POW insuffisant" });
      w.pow -= amt;
      w.staked += amt;
      pushBlock({ type, from, amount: amt });
      return res.json({ ok: true, stats: currentStats() });
    }

    // ADD LP (POW / USDC POW)
    if (type === "addLP") {
      const p = Number(powAmount) || 0;
      const u = Number(usdcAmount) || 0;
      if (!from || p <= 0 || u <= 0) {
        return res.status(400).json({ error: "invalid LP" });
      }
      const w = getWallet(from);
      if (w.pow < p || w.usdc < u) {
        return res.status(400).json({ error: "solde insuffisant pour LP" });
      }
      w.pow -= p;
      w.usdc -= u;
      lpPow += p;
      lpUsdc += u;
      pushBlock({ type, from, pow: p, usdc: u });
      return res.json({ ok: true, stats: currentStats() });
    }

    return res.status(400).json({ error: "type de TX inconnu" });
  } catch (e) {
    console.error("❌ Erreur /tx:", e);
    res.status(500).json({ error: "tx internal" });
  }
});

// ---------- BRIDGE SOL → POWCHAIN ----------
// On expose plusieurs routes pour être sûr de matcher le front
function handleBridge(req, res) {
  try {
    const body = req.body || {};
    const powAddress = body.powAddress || body.powAddr || body.addressPow || body.address;
    const solAddress = body.solAddress || body.solana || body.sol;
    const amountSol = Number(body.amountSol || body.amount || 0);

    if (!powAddress || !solAddress || !amountSol || amountSol <= 0) {
      return res.status(400).json({ error: "invalid bridge params" });
    }

    const w = getWallet(powAddress);
    // Taux simple: 1 SOL => 100 000 POW (à ajuster plus tard)
    const mintedPow = Math.round(amountSol * 100000);
    w.pow += mintedPow;
    treasuryPow += mintedPow;

    const ev = {
      type: "bridge",
      powAddress,
      solAddress,
      amountSol,
      mintedPow,
      ts: Date.now(),
    };
    pushBlock(ev);

    console.log("🌉 Bridge enregistré", ev);
    return res.json({ ok: true, mintedPow, wallet: w, stats: currentStats() });
  } catch (e) {
    console.error("❌ Erreur /bridge:", e);
    res.status(500).json({ error: "bridge internal" });
  }
}

app.post("/bridge", handleBridge);
app.post("/bridge_sol", handleBridge);
app.post("/bridge_solana", handleBridge);

// ---------- HTTP + WEBSOCKET ----------
const server = http.createServer(app);
server.listen(3000, () => {
  console.log("🚀 POWCHAIN backend on 3000");
});

// WS dédié (port 7001) pour l’UI via Nginx /ws
const wss = new WebSocket.Server({ port: 7001 });
wss.on("listening", () => {
  console.log("🔌 WebSocket POWCHAIN sur port 7001 (/ws via Nginx possible)");
});

function broadcast(obj) {
  const data = JSON.stringify(obj);
  wss.clients.forEach((client) => {
    if (client.readyState === WebSocket.OPEN) client.send(data);
  });
}

// Ping périodique des stats pour le HUD
setInterval(() => {
  broadcast({ type: "stats", stats: currentStats() });
}, 15000);

// Charger le ledger au démarrage
loadLedger();



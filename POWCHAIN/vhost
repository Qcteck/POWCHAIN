server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;
    root /var/www/html;
    location / { try_files $uri /index.html; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        try_files $uri /index.html;
    }

    location /stats    { proxy_pass http://127.0.0.1:3000/stats; }
    location /wallet   { proxy_pass http://127.0.0.1:3000; }
    location /bridge   { proxy_pass http://127.0.0.1:3000/bridge; }
    location /chain    { proxy_pass http://127.0.0.1:3000/chain; }
    location /mempool  { proxy_pass http://127.0.0.1:3000/mempool; }
    location /block    { proxy_pass http://127.0.0.1:3000; }

    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }
}







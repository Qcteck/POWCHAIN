<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>POWCHAIN — Node & Wallet Dashboard</title>
  <script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
  <style>
    :root{
      --bg:#020617;
      --card:#020b1a;
      --card2:#020e22;
      --accent:#22c8ff;
      --accent2:#38bdf8;
      --border:#1f2937;
      --txt:#e5ecff;
      --muted:#9ca3af;
      --bad:#f97373;
      --good:#4ade80;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
      background:radial-gradient(circle at top,#0b1220,#020617 55%,#000 100%);
      color:var(--txt);
    }
    #wrap{
      max-width:1180px;
      margin:12px auto 32px;
      padding:12px;
    }
    h1{
      margin:0 0 8px;
      font-size:22px;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:var(--accent);
      text-shadow:0 0 12px #0ea5e9aa;
    }
    #topbar{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      align-items:center;
      justify-content:space-between;
      margin-bottom:10px;
    }
    .badge{
      padding:2px 8px;
      border-radius:999px;
      font-size:11px;
      border:1px solid #16a34a;
      color:#bbf7d0;
      background:#052e16;
      display:inline-flex;
      align-items:center;
      gap:6px;
    }
    .badge span.dot{
      width:8px;height:8px;
      border-radius:999px;
      background:#22c55e;
      box-shadow:0 0 10px #22c55e;
    }
    button,input,select{
      font-family:inherit;
      font-size:13px;
    }
    button{
      cursor:pointer;
      border-radius:999px;
      border:1px solid var(--accent2);
      background:radial-gradient(circle at top,var(--accent2),#0f172a);
      color:#e5f6ff;
      padding:6px 14px;
      text-transform:uppercase;
      letter-spacing:.08em;
    }
    button:disabled{
      opacity:.4;
      cursor:not-allowed;
    }
    input,select{
      background:linear-gradient(135deg,#020617,#020b1a);
      border-radius:8px;
      border:1px solid var(--border);
      padding:6px 8px;
      color:var(--txt);
      width:100%;
    }
    input:focus,select:focus{
      outline:none;
      border-color:var(--accent2);
      box-shadow:0 0 0 1px #0ea5e966;
    }
    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:10px;
      margin-bottom:10px;
    }
    .card{
      background:radial-gradient(circle at top,var(--card2),var(--card));
      border-radius:14px;
      border:1px solid var(--border);
      padding:10px;
      box-shadow:0 0 24px #000a;
    }
    .card h2{
      margin:0 0 6px;
      font-size:15px;
      text-transform:uppercase;
      letter-spacing:.12em;
      color:var(--accent2);
    }
    .row{
      display:flex;
      gap:6px;
      margin-bottom:6px;
    }
    .row > div{flex:1}
    label{
      display:block;
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.08em;
      color:var(--muted);
      margin-bottom:2px;
    }
    .stat{
      font-size:13px;
      margin:2px 0;
    }
    .stat span{
      color:var(--muted);
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.09em;
      margin-right:4px;
    }
    #log,#chain{
      width:100%;
      height:180px;
      background:#020617;
      border-radius:10px;
      border:1px solid #111827;
      padding:6px;
      font-size:11px;
      color:#e5e7eb;
      overflow:auto;
      white-space:pre-wrap;
      font-family:ui-monospace,Menlo,Consolas,monospace;
    }
    .pill{
      display:inline-block;
      padding:2px 8px;
      border-radius:999px;
      font-size:11px;
      border:1px solid var(--border);
      color:var(--muted);
      margin-right:4px;
    }
    .pill.good{border-color:#22c55e;color:#bbf7d0;}
    .pill.bad{border-color:#f97373;color:#fecaca;}
    a{color:var(--accent2);text-decoration:none;font-size:11px;}
    a:hover{text-decoration:underline;}
    #phantomAddr{font-size:11px;word-break:break-all;color:var(--muted);}
  </style>
</head>
<body>
<div id="wrap">
  <div id="topbar">
    <div>
      <h1>POWCHAIN — Node Dashboard</h1>
      <div class="pill">API: <span id="apiUrl"></span></div>
      <div class="pill">WS: <span id="wsUrl"></span></div>
    </div>
    <div>
      <div class="badge"><span class="dot"></span><span id="nodeStatus">Online</span></div>
      <div style="font-size:11px;color:var(--muted);text-align:right;">srv POWCHAIN · bbqfinance.fun</div>
    </div>
  </div>

  <div class="grid">
    <!-- STATUT NODE -->
    <div class="card">
      <h2>Statut Node</h2>
      <div class="stat"><span>Height</span><b id="hHeight">-</b></div>
      <div class="stat"><span>Blocs</span><b id="hBlocks">-</b></div>
      <div class="stat"><span>Wallets</span><b id="hWallets">-</b></div>
      <div class="stat"><span>Treasury POW</span><b id="hTpow">-</b></div>
      <div class="stat"><span>Treasury USDC</span><b id="hTusdc">-</b></div>
      <div class="stat"><span>LP POW</span><b id="hLpPow">-</b></div>
      <div class="stat"><span>LP USDC</span><b id="hLpUsdc">-</b></div>
      <div style="margin-top:8px;display:flex;gap:6px;">
        <button onclick="refreshStats()">Refresh stats</button>
        <button onclick="loadChain()">Voir chain</button>
      </div>
    </div>

    <!-- WALLET POWCHAIN -->
    <div class="card">
      <h2>Wallet POWCHAIN</h2>
      <label for="wAddr">Adresse POWCHAIN</label>
      <input id="wAddr" placeholder="Colle ici ton adresse POWCHAIN"/>
      <div class="row">
        <div>
          <label>POW</label>
          <input id="wPow" readonly/>
        </div>
        <div>
          <label>USDC POW</label>
          <input id="wUsdc" readonly/>
        </div>
        <div>
          <label>Staked POW</label>
          <input id="wStaked" readonly/>
        </div>
      </div>
      <button onclick="viewWallet()">Charger wallet</button>
      <div style="margin-top:6px;font-size:11px;color:var(--muted);">
        L’adresse doit déjà exister dans le ledger POWCHAIN (pas de génération auto ici).
      </div>
    </div>

    <!-- ACTIONS POWCHAIN -->
    <div class="card">
      <h2>Actions POWCHAIN</h2>
      <label for="txTo">Destinataire POWCHAIN</label>
      <input id="txTo" placeholder="Adresse POWCHAIN du destinataire"/>
      <div class="row">
        <div>
          <label>Montant POW</label>
          <input id="txPow" placeholder="0.0"/>
        </div>
        <div>
          <label>Montant USDC POW</label>
          <input id="txUsdc" placeholder="0.0"/>
        </div>
      </div>
      <div class="row">
        <button style="flex:1" onclick="sendTransfer()">Send</button>
        <button style="flex:1" onclick="stakePow()">Stake</button>
        <button style="flex:1" onclick="unstakePow()">Unstake</button>
      </div>
      <hr style="border:0;border-top:1px solid #111827;margin:8px 0;">
      <label>LP ADD POW / USDC POW</label>
      <div class="row">
        <div><input id="lpPow" placeholder="POW"/></div>
        <div><input id="lpUsdc" placeholder="USDC POW"/></div>
      </div>
      <button onclick="addLp()">Add LP</button>
      <div style="margin-top:6px;font-size:11px;color:var(--muted);">
        Un add LP ≥ 10&nbsp;000 POW + 10&nbsp;000 USDC POW peut débloquer le badge WHALE (log côté serveur).
      </div>
    </div>

    <!-- BRIDGE SOLANA -->
    <div class="card">
      <h2>Bridge Solana → POWCHAIN</h2>
      <div class="row">
        <button style="flex:1" id="btnPhantom" onclick="connectPhantom()">Connect Phantom</button>
      </div>
      <div id="phantomAddr">Non connecté</div>
      <div class="row">
        <div>
          <label>SOL</label>
          <input id="solBal" readonly/>
        </div>
        <div>
          <label>USDC (Solana)</label>
          <input id="usdcBal" readonly/>
        </div>
      </div>
      <label>Montant SOL à bridger vers POWCHAIN</label>
      <input id="bridgeAmount" placeholder="0.01"/>
      <button onclick="bridgeToPowchain()">Bridge vers POWCHAIN</button>
      <div style="margin-top:6px;font-size:11px;color:var(--muted);">
        Le bridge envoie une requête <code>BRIDGE_SOL</code> au serveur POWCHAIN qui crédite ton wallet POWCHAIN.
      </div>
    </div>
  </div>

  <!-- Logs + Chain -->
  <div class="grid">
    <div class="card">
      <h2>Console POWCHAIN</h2>
      <div id="log"></div>
    </div>
    <div class="card">
      <h2>Chain</h2>
      <div id="chain"></div>
    </div>
  </div>
</div>

<script>
  // ---------- CONFIG ----------
  const ORIGIN = window.location.origin.replace(/\/$/,"");
  const API = ORIGIN;                          // ex: http://bbqfinance.fun ou https://bbqfinance.fun
  const WS_URL = (location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws";

  document.getElementById("apiUrl").textContent = API;
  document.getElementById("wsUrl").textContent = WS_URL;

  function log(msg){
    const el = document.getElementById("log");
    const t = new Date().toLocaleTimeString("fr-CA",{hour12:false});
    el.textContent += "["+t+"] "+msg+"\n";
    el.scrollTop = el.scrollHeight;
  }

  // ---------- HTTP HELPERS ----------
  async function get(path){
    try{
      const r = await fetch(API+path);
      return await r.json();
    }catch(e){
      log("NET ERR GET "+path);
      return null;
    }
  }

  async function post(path, body){
    try{
      const r = await fetch(API+path,{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify(body)
      });
      return await r.json();
    }catch(e){
      log("NET ERR POST "+path);
      return null;
    }
  }

  // ---------- STATS ----------
  async function refreshStats(){
    const s = await get("/stats");
    if(!s){return;}
    document.getElementById("hHeight").textContent = s.height ?? "-";
    document.getElementById("hBlocks").textContent = s.height ?? 0;
    document.getElementById("hWallets").textContent = Object.keys(s.wallets || {}).length;
    document.getElementById("hTpow").textContent = s.treasuryPow ?? 0;
    document.getElementById("hTusdc").textContent = s.treasuryUsdc ?? 0;
    document.getElementById("hLpPow").textContent = s.lpPow ?? 0;
    document.getElementById("hLpUsdc").textContent = s.lpUsdc ?? 0;
    log("Stats mises à jour (height "+(s.height ?? "?")+")");
  }

  async function loadChain(){
    const c = await get("/chain");
    if(!c){return;}
    document.getElementById("chain").textContent = JSON.stringify(c,null,2);
    log("Chain chargée ("+c.length+" blocs)");
  }

  // ---------- WALLET POWCHAIN ----------
  async function viewWallet(){
    const id = document.getElementById("wAddr").value.trim();
    if(!id){alert("Entre une adresse POWCHAIN");return;}
    const w = await get("/wallet?id="+encodeURIComponent(id));
    if(!w){return;}
    document.getElementById("wPow").value = w.pow ?? 0;
    document.getElementById("wUsdc").value = w.usdc ?? 0;
    document.getElementById("wStaked").value = w.staked ?? 0;
    log("Wallet chargé "+id);
  }

  async function sendTx(type, extra){
    const from = document.getElementById("wAddr").value.trim();
    if(!from){alert("Entre d'abord ton adresse POWCHAIN");return;}
    const payload = Object.assign({type,from},extra||{});
    const res = await post("/tx",payload);
    if(!res){return;}
    if(res.error){
      log("TX "+type+" rejetée: "+res.error);
      alert("Erreur TX: "+res.error);
    }else{
      log("TX "+type+" acceptée: "+(res.hash || res.ok || "OK"));
    }
    refreshStats();
    viewWallet();
  }

  async function sendTransfer(){
    const to = document.getElementById("txTo").value.trim();
    const pow = parseFloat(document.getElementById("txPow").value || "0") || 0;
    const usdc = parseFloat(document.getElementById("txUsdc").value || "0") || 0;
    if(!to){alert("Destinataire manquant");return;}
    if(pow<=0 && usdc<=0){alert("Montant POW ou USDC requis");return;}
    await sendTx("TRANSFER",{to,amountPow:pow,amountUsdc:usdc});
  }

  async function stakePow(){
    const amt = parseFloat(document.getElementById("txPow").value || "0") || 0;
    if(amt<=0){alert("Montant POW à staker requis");return;}
    await sendTx("STAKE",{amountPow:amt});
  }

  async function unstakePow(){
    const amt = parseFloat(document.getElementById("txPow").value || "0") || 0;
    if(amt<=0){alert("Montant POW à unstake requis");return;}
    await sendTx("UNSTAKE",{amountPow:amt});
  }

  async function addLp(){
    const pow = parseFloat(document.getElementById("lpPow").value || "0") || 0;
    const usdc = parseFloat(document.getElementById("lpUsdc").value || "0") || 0;
    if(pow<=0 || usdc<=0){alert("Montants POW et USDC POW requis");return;}
    await sendTx("ADD_LP",{amountPow:pow,amountUsdc:usdc});
  }

  // ---------- WS LOGS ----------
  (function(){
    try{
      const ws = new WebSocket(WS_URL);
      ws.onopen = ()=>log("WS connecté ("+WS_URL+")");
      ws.onmessage = ev=>{
        try{
          const msg = JSON.parse(ev.data);
          if(msg.type==="welcome"){
            log("WELCOME height="+msg.height);
          }else if(msg.type==="block"){
            log("Nouveau bloc height="+msg.height+" txs="+(msg.txs||0));
          }else if(msg.type==="tx"){
            log("TX "+(msg.tx?.type||"?")+" "+(msg.tx?.hash||""));
          }else{
            log("WS "+ev.data);
          }
        }catch(e){
          log("WS RAW "+ev.data);
        }
      };
      ws.onclose = ()=>log("WS fermé");
      ws.onerror = ()=>log("WS erreur");
    }catch(e){
      log("WS init error "+e.message);
    }
  })();

  // ---------- PHANTOM / BRIDGE ----------
  const DRPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const USDC_MINT = new solanaWeb3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");
  const TOKEN_PROGRAM = new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA");
  let connection = new solanaWeb3.Connection(DRPC,"confirmed");
  let phantom, phantomPub;

  function hasPhantom(){
    return typeof window.solana !== "undefined" && window.solana.isPhantom;
  }

  async function connectPhantom(){
    if(!hasPhantom()){
      alert("Installe le wallet Phantom pour utiliser le bridge.");
      return;
    }
    phantom = window.solana;
    try{
      const resp = await phantom.connect();
      phantomPub = resp.publicKey;
      document.getElementById("phantomAddr").textContent = phantomPub.toBase58();
      document.getElementById("btnPhantom").textContent = "Phantom connecté";
      await refreshSolBalances();
      log("Phantom connecté");
    }catch(e){
      alert("Connexion Phantom refusée");
    }
  }

  async function refreshSolBalances(){
    if(!phantomPub)return;
    try{
      const solLamports = await connection.getBalance(phantomPub);
      document.getElementById("solBal").value = (solLamports/1e9).toFixed(4);

      const tok = await connection.getParsedTokenAccountsByOwner(
        phantomPub,
        { programId: TOKEN_PROGRAM }   // plus de filtre "mint" côté RPC
      );
      let usdc = 0;
      for(const it of tok.value){
        const info = it.account.data.parsed.info;
        const mint = info.mint;
        if(mint === USDC_MINT.toBase58()){
          const dec = info.tokenAmount.decimals;
          const ui = parseFloat(info.tokenAmount.amount) / Math.pow(10,dec);
          usdc += ui;
        }
      }
      document.getElementById("usdcBal").value = usdc.toFixed(2);
    }catch(e){
      alert("Erreur Phantom: "+e.message);
    }
  }

  async function bridgeToPowchain(){
    const amt = parseFloat(document.getElementById("bridgeAmount").value || "0") || 0;
    if(amt<=0){alert("Montant SOL à bridger requis");return;}
    if(!phantomPub){alert("Connecte Phantom d'abord");return;}
    const powAddr = document.getElementById("wAddr").value.trim();
    if(!powAddr){alert("Entre ton adresse POWCHAIN pour créditer le bridge");return;}
    const body = {
      type:"BRIDGE_SOL",
      fromSol:phantomPub.toBase58(),
      toPow:powAddr,
      amountSol:amt
    };
    const res = await post("/tx",body);
    if(!res){return;}
    if(res.error){
      alert("Bridge rejeté: "+res.error);
      log("Bridge rejeté: "+res.error);
    }else{
      alert("Bridge accepté sur POWCHAIN (voir logs)");
      log("Bridge SOL→POWCHAIN "+amt+" SOL");
      refreshStats();
      viewWallet();
    }
  }

  // ---------- INIT ----------
  refreshStats();
</script>
</body>
</html>
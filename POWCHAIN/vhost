// ENDPOINTS HTTP
// =========================

// Santé + stats réseau
app.get("/stats", (req, res) => {
  res.json({
    height: chain.length,
    wallets: Object.keys(wallets).length,
    treasuryPow: treasury.pow,
    treasuryUsdc: treasury.usdc,
    treasurySol: treasury.sol,
    tvl: getTVL(),
    lp,
    lpPrice: getLpPrice(),
    ratePowPerSol: getPowRatePowPerSol(),
    supply: {
      circulante: supplyCirculante,
      minted: mintedPowTotal,
      burned: burnedPowTotal
    },
    bridgeCount: bridgeHistory.length
  });
});

// Explorer simple de la chaîne
app.get("/chain", (req, res) => {
  res.json(chain);
});

// Explorer historique des bridges
app.get("/bridge-history", (req, res) => {
  res.json(bridgeHistory);
});

// Infos wallet
app.get("/wallet/:addr", (req, res) => {
  const addr = req.params.addr;
  const w = ensureWallet(addr);
  res.json(w);
});

// Endpoint générique pour TX signées côté client
app.post("/tx", (req, res) => {
  try {
    const tx = req.body || {};
    if (!tx.type) throw new Error("type manquant");
    if (!tx.from) throw new Error("from manquant");
    if (typeof tx.nonce !== "number") throw new Error("nonce manquant");

    // Vérif signature (anti-cheat)
    try {
      verifyTxSignature(tx);
    } catch (e) {
      throw new Error("Signature invalide: " + e.message);
    }

    const w = ensureWallet(tx.from);
    if (tx.nonce <= w.nonce) throw new Error("nonce déjà utilisé");
    w.nonce = tx.nonce;

    let result;
    switch (tx.type) {
      case "TX_POW":
        result = processPowTransfer(tx);
        break;
      case "SWAP":
        result = processSwap(tx);
        break;
      case "LP_ADD":
        result = processLPAdd(tx);
        break;
      case "STAKE":
        result = processStake(tx);
        break;
      case "UNSTAKE":
        result = processUnstake(tx);
        break;
      case "BRIDGE_OUT":
        result = processBridgeOut(tx.from, tx.powAmount);
        break;
      default:
        throw new Error("type inconnu: " + tx.type);
    }

    pushToMempool(result);
    forgeBlockIfNeeded();
    broadcast({ type: "TX_APPLIED", tx: result });

    res.json({ ok: true, tx: result });
  } catch (e) {
    L("Erreur /tx:", e.message);
    res.status(400).json({ ok: false, error: e.message });
  }
});

// Endpoint dédié pour le bridge SOL -> FIREINNERS
// Appelé par le bouton "SOL -> FIREINNERS" du client
app.post("/bridge", (req, res) => {
  try {
    const { powAddress, solAddress, sol, txSig } = req.body || {};
    if (!powAddress) throw new Error("powAddress manquant");
    if (!solAddress) throw new Error("solAddress manquant");
    if (typeof sol !== "number" || sol <= 0) {
      throw new Error("sol invalide");
    }

    // Ici on suppose que la vraie TX Solana a déjà été signée/ envoyée
    // côté client Phantom. txSig est conservé pour audit / anti-cheat.
    const result = processBridgeIn(powAddress, sol);

    const entry = {
      time: Date.now(),
      dir: "SOL->FIRE",
      powAddress,
      solAddress,
      sol,
      netPow: result.userPow,
      feePow: result.feeTreasPow + result.burnedPow,
      txSig: txSig || null
    };
    bridgeHistory.push(entry);
    if (bridgeHistory.length > 500) bridgeHistory.shift();

    pushToMempool(result);
    forgeBlockIfNeeded();
    broadcast({ type: "BRIDGE_IN", entry, tx: result });

    L("🚀 Bridge SOL->FIREINNERS", {
      powAddress,
      solAddress,
      sol,
      netPow: result.userPow,
      feePow: entry.feePow
    });

    res.json({ ok: true, bridge: result });
  } catch (e) {
    L("Erreur /bridge:", e.message);
    res.status(400).json({ ok: false, error: e.message });
  }
});


<style>
body{margin:0;background:#0a0a0a;color:#eee;font-family:Arial,Helvetica,sans-serif}
#top{padding:14px;background:#111;border-bottom:1px solid #333;font-size:18px;font-weight:bold;color:#f90;text-align:center}
#wrap{max-width:1150px;margin:20px auto;padding:10px}
.card{background:#111;padding:14px;margin:12px 0;border-radius:10px;border:1px solid #333}
.card h2{margin:0 0 10px;color:#ffa500;font-size:17px}
.card h3{margin:6px 0 8px;color:#ffcc66;font-size:15px}
.row{display:flex;gap:10px;margin-top:8px}
.row input,.row select{flex:1;padding:7px;border-radius:6px;border:1px solid #444;background:#000;color:#eee}
button{padding:7px 12px;border:1px solid #f90;background:#c60;color:#fff;border-radius:6px;cursor:pointer;font-size:13px}
button:hover{background:#e70}

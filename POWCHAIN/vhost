<p style="font-size:12px;color:#aaa;margin-top:5px">
La transaction est signée localement avec ta clé privée locale (wallet POWCHAIN) et envoyée via WebSocket au validateur (mempool POWCHAIN).
</p>
</div>

<!-- 5. Stats POWCHAIN -->
<div class="card">
<h2>5. Stats POWCHAIN</h2>
<div class="dataLine"><span class="dataLabel">Hauteur:</span> <span id="stHeight">0</span></div>
<div class="dataLine"><span class="dataLabel">Wallets:</span> <span id="stWallets">0</span></div>
<div class="dataLine"><span class="dataLabel">Mempool:</span> <span id="stMempool">0</span></div>
<div class="dataLine"><span class="dataLabel">Total POW:</span> <span id="stTotPow">0</span></div>
<div class="dataLine"><span class="dataLabel">Total Staked:</span> <span id="stTotStk">0</span></div>
<div class="dataLine"><span class="dataLabel">LP POW:</span> <span id="stLpPow">0</span></div>
<div class="dataLine"><span class="dataLabel">LP USDC POW:</span> <span id="stLpUsdc">0</span></div>
</div>

<!-- 6. Chaîne / Explorer -->
<div class="card">
<h2>6. Chaîne POWCHAIN</h2>
<div class="dataLine"><span class="dataLabel">Dernier bloc:</span> <span id="lastBlk">-</span></div>
<p style="font-size:12px;color:#aaa;margin:4px 0 8px">
Les nouveaux blocs sont annoncés via WebSocket (type NEW_BLOCK).
</p>
<div class="row">
<input id="blkNum" placeholder="Hauteur de bloc"/>
<button id="btnBlkView">Voir le bloc</button>
</div>
<div id="blkOut"></div>
</div>

<!-- DEX / LP simple (réutilise les mêmes stats) -->
<div class="card">
<h2>DEX interne FIREINNERS</h2>
<div class="dataLine"><span class="dataLabel">LP POW:</span> <span id="dexLpPow">0</span></div>
<div class="dataLine"><span class="dataLabel">LP USDC:</span> <span id="dexLpUsdc">0</span></div>
<div class="row">
<input id="swapAmt" placeholder="Montant"/>
<select id="swapDir">
<option value="pow2usdc">POW → USDC POW</option>
<option value="usdc2pow">USDC POW → POW</option>
</select>
<button id="btnSwap">Swap</button>
</div>
<div class="row">
<input id="lpPowIn" placeholder="POW pour LP"/>
<input id="lpUsdcIn" placeholder="USDC pour LP"/>
<button id="btnLpAdd">Add LP</button>
</div>
</div>

<div id="log"></div>

</div>

<script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script>
const API="https://bbqfinance.fun";
const WS="wss://bbqfinance.fun/ws";
const DEC=1e6;
const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

let solAddr=null;
let addrPowchain=null;
let privPowchain=null;
let noncePowchain=0;
let sock=null;

const q=s=>document.querySelector(s);
const log=m=>{
 q("#log").textContent+="["+new Date().toLocaleTimeString()+"] "+m+"\n";
 q("#log").scrollTop=q("#log").scrollHeight;
};

/* Base58 utils */
const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function b58encode(bytes){
 if(!bytes)return"";
 let d=[0];
 for(let i=0;i<bytes.length;i++){
  let c=bytes[i];
  for(let j=0;j<d.length;j++){
   let x=d[j]*256+c;
   d[j]=x%58;
   c=(x/58)|0;
  }
  while(c>0){d.push(c%58);c=(c/58)|0}
 }
 let r="";
 for(let k=0;k<bytes.length&&bytes[k]===0;k++)r+="1";
 for(let i=d.length-1;i>=0;i--)r+=ALPH[d[i]];
 return r;
}
function b58decode(str){
 let b=[0];
 for(let i=0;i<str.length;i++){
  let c=ALPH.indexOf(str[i]);
  if(c<0)throw Error("base58 invalide");
  for(let j=0;j<b.length;j++){
   let x=b[j]*58+c;
   b[j]=x&255;
   c=x>>8;
  }
  while(c>0){b.push(c&255);c>>=8}
 }
 let r=new Uint8Array(b.length);
 for(let i=0;i<b.length;i++)r[r.length-1-i]=b[i];
 return r;
}

/* Phantom connect */
const solConn=new solanaWeb3.Connection(SOL_RPC,"confirmed");

async function connectPhantom(){
 try{
  if(!window.solana||!window.solana.isPhantom){
   alert("Phantom non détecté");
   return;
  }
  const resp=await window.solana.connect();
  solAddr=resp.publicKey.toString();
  q("#phState").textContent="connecté";
  q("#phAddr").textContent=solAddr;

  const pubKey=new solanaWeb3.PublicKey(solAddr);
  const balLam=await solConn.getBalance(pubKey);
  q("#phSol").textContent=(balLam/1e9).toFixed(4);

  const usdcMint=new solanaWeb3.PublicKey(USDC_MINT);
  const toks=await solConn.getParsedTokenAccountsByOwner(pubKey,{mint:usdcMint});
  let usdc=0;
  toks.value.forEach(acc=>{
   const info=acc.account.data.parsed.info;
   const amt=info.tokenAmount.uiAmount||0;
   usdc+=amt;
  });
  q("#phUsdc").textContent=usdc.toFixed(2);

  log("Phantom connecté: "+solAddr);
 }catch(e){
  log("Erreur Phantom: "+e.message);
 }
}
q("#btnPhantom").onclick=connectPhantom;

/* WebSocket POWCHAIN */
function wsConnect(){
 try{
  sock=new WebSocket(WS);
  sock.onopen=()=>{
   log("WS POWCHAIN connecté.");
  };
  sock.onclose=()=>{
   log("WS POWCHAIN déconnecté, reconnexion dans 5s.");
   setTimeout(wsConnect,5000);
  };
  sock.onmessage=ev=>{
   try{
    const msg=JSON.parse(ev.data);
    if(msg.type==="NEW_BLOCK"){
     q("#lastBlk").textContent="height "+msg.height+" (time "+new Date(msg.time).toLocaleString()+")";
     log("NEW_BLOCK "+msg.height);
    }
   }catch(e){}
  };
 }catch(e){
  log("WS erreur: "+e.message);
 }
}
wsConnect();
log("Client POWCHAIN initialisé. API: "+API);

/* Helpers HTTP */
async function jget(path){
 const r=await fetch(API+path);
 if(!r.ok)throw new Error("HTTP "+r.status);
 return r.json();
}
async function jpost(path,obj){
 const r=await fetch(API+path,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(obj)});
 if(!r.ok)throw new Error("HTTP "+r.status);
 return r.json();
}

/* 2. Wallet POWCHAIN */

/* Créer un wallet serveur (côté validator: simple placeholder ici) */
q("#btnCreateSrv").onclick=()=>{
 log("Création wallet POWCHAIN serveur: utilise actuellement seulement le wallet local pour signer (clé locale).");
};

/* Générer un wallet local */
q("#btnGenLocal").onclick=()=>{
 try{
  const kp=nacl.sign.keyPair();
  addrPowchain=b58encode(kp.publicKey);
  privPowchain=b58encode(kp.secretKey);
  noncePowchain=0;
  q("#pwAddr").textContent=addrPowchain;
  q("#pwPriv").textContent=privPowchain;
  q("#inpAddrLoad").value=addrPowchain;
  q("#pwPow").textContent="0";
  q("#pwUsdc").textContent="0";
  q("#pwStk").textContent="0";
  q("#pwNonce").textContent="0";
  log("Wallet POWCHAIN local généré.");
 }catch(e){
  log("Erreur génération POWCHAIN: "+e.message);
 }
};

/* Recharger balances */
q("#btnLoadWallet").onclick=async()=>{
 try{
  const a=q("#inpAddrLoad").value.trim();
  if(!a){alert("Adresse POWCHAIN requise");return;}
  const w=await jget("/wallet/"+a);
  addrPowchain=a;
  q("#pwAddr").textContent=a;
  q("#pwPow").textContent=((w.pow||0)/DEC).toFixed(6);
  q("#pwUsdc").textContent=((w.usdc||0)/DEC).toFixed(6);
  q("#pwStk").textContent=((w.staked||0)/DEC).toFixed(6);
  q("#pwNonce").textContent=w.nonce||0;
  noncePowchain=w.nonce||0;
  log("Wallet POWCHAIN chargé: "+a);
 }catch(e){
  log("Erreur load wallet: "+e.message);
 }
};

/* 3. Bridge SOL → POWCHAIN (infos) */
q("#btnBridgeInfo").onclick=()=>{
 const addr="BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";
 if(navigator.clipboard){
  navigator.clipboard.writeText(addr).catch(()=>{});
 }
 log("Bridge: envoie du SOL avec Phantom vers "+addr+" puis crédit manuel en POW sur POWCHAIN.");
 alert("Adresse trésorerie copiée (si supporté). Envoie le SOL vers cette adresse avec Phantom, puis crédite le POW sur POWCHAIN côté serveur.");
};

/* Signature POWCHAIN */
function signTxPowchain(payload){
 if(!privPowchain)throw new Error("Pas de clé privée POWCHAIN locale");
 const msg=new TextEncoder().encode(JSON.stringify(payload));
 const sk=b58decode(privPowchain);
 const sig=nacl.sign.detached(msg,sk);
 return b58encode(sig);
}

/* 4. Envoyer une TX POWCHAIN */
q("#btnSendTx").onclick=()=>{
 try{
  if(!addrPowchain){alert("Génère/charge un wallet POWCHAIN d'abord");return;}
  const token=q("#txToken").value;
  const to=q("#txTo").value.trim();
  const amt=parseFloat(q("#txAmt").value||"0");
  if(!to||amt<=0){alert("Destination + montant requis");return;}
  const amount=Math.floor(amt*DEC);
  const type=token==="pow"?"TX_POW":"TX_USDC";
  const tx={type,from:addrPowchain,to,amount,nonce:noncePowchain+1};
  tx.sig=signTxPowchain(tx);
  if(sock&&sock.readyState===1){
   sock.send(JSON.stringify(tx));
   log("TX envoyée type "+type+" montant "+amt);
   noncePowchain++;
   q("#pwNonce").textContent=noncePowchain;
  }else{
   log("WS non connecté, TX non envoyée.");
  }
 }catch(e){
  log("Erreur envoi TX: "+e.message);
 }
};

/* 5. Stats POWCHAIN */
async function refreshStats(){
 try{
  const s=await jget("/stats");
  q("#stHeight").textContent=s.height||0;
  q("#stWallets").textContent=s.wallets||0;
  q("#stMempool").textContent=s.mempool||0;
  q("#stTotPow").textContent=((s.totalPow||0)/DEC).toFixed(6);
  q("#stTotStk").textContent=((s.totalStaked||0)/DEC).toFixed(6);
  q("#stLpPow").textContent=((s.lpPow||0)/DEC).toFixed(6);
  q("#stLpUsdc").textContent=((s.lpUsdc||0)/DEC).toFixed(6);
  q("#dexLpPow").textContent=((s.lpPow||0)/DEC).toFixed(6);
  q("#dexLpUsdc").textContent=((s.lpUsdc||0)/DEC).toFixed(6);
 }catch(e){
  log("Erreur stats: "+e.message);
 }
}
setInterval(refreshStats,4000);
refreshStats();

/* 6. Block explorer */
q("#btnBlkView").onclick=async()=>{
 try{
  const h=parseInt(q("#blkNum").value||"0");
  if(!h&&h!==0){alert("Hauteur invalide");return;}
  const b=await jget("/block/"+h);
  q("#blkOut").textContent=JSON.stringify(b,null,2);
 }catch(e){
  q("#blkOut").textContent="Erreur bloc: "+e.message;
 }
};

/* DEX interne simple (reuse SWAP + LP_ADD) */
q("#btnSwap").onclick=()=>{
 try{
  if(!addrPowchain){alert("Wallet POWCHAIN requis");return;}
  const amt=parseFloat(q("#swapAmt").value||"0");
  if(amt<=0)return;
  const amount=Math.floor(amt*DEC);
  const token=q("#swapDir").value;
  const tx={type:"SWAP",from:addrPowchain,amount,token,nonce:noncePowchain+1};
  tx.sig=signTxPowchain(tx);
  if(sock&&sock.readyState===1){
   sock.send(JSON.stringify(tx));
   noncePowchain++;
   q("#pwNonce").textContent=noncePowchain;
   log("SWAP "+token+" "+amt);
  }else{
   log("WS non connecté pour SWAP");
  }
 }catch(e){
  log("Erreur swap: "+e.message);
 }
};

q("#btnLpAdd").onclick=()=>{
 try{
  if(!addrPowchain){alert("Wallet POWCHAIN requis");return;}
  const a=parseFloat(q("#lpPowIn").value||"0");
  const b=parseFloat(q("#lpUsdcIn").value||"0");
  if(a<=0||b<=0)return;
  const tx={type:"LP_ADD",from:addrPowchain,pow:Math.floor(a*DEC),usdc:Math.floor(b*DEC),nonce:noncePowchain+1};
  tx.sig=signTxPowchain(tx);
  if(sock&&sock.readyState===1){
   sock.send(JSON.stringify(tx));
   noncePowchain++;
   q("#pwNonce").textContent=noncePowchain;
   log("LP_ADD POW="+a+" USDC="+b);
  }else{
   log("WS non connecté pour LP_ADD");
  }
 }catch(e){
  log("Erreur LP_ADD: "+e.message);
 }
};
</script>
</body>
</html>
// =========================
// CONFIG ECONOMIE FIREINNERS
// =========================

const DEC = 1e6; // 6 décimales
const SUPPLY_MAX = 100_000_000 * DEC; // 100M FIRE max, hard cap

// Taux dynamique FIRE / SOL borné (en FIRE par SOL)
const RATE_BASE = 1000;           // base FIRE / SOL
const TVL_REF   = 1_000_000 * DEC; // 1M USDC FIRE de référence
const RATE_MIN  = 800;
const RATE_MAX  = 5000;

// Frais en basis points (1% = 100 bp)
const FEE_TRANSFER_BURN_BP   = 50;   // 0.5% burn sur transferts FIRE
const FEE_SWAP_TOTAL_BP      = 30;   // 0.3% total sur swap
const FEE_SWAP_BURN_PART     = 0.5;  // 50% des fees swap brûlés
const FEE_BRIDGE_IN_TREAS_BP = 500;  // 5% vers trésorerie sur bridge IN
const FEE_BRIDGE_IN_BURN_BP  = 200;  // 2% burn sur bridge IN
const FEE_BRIDGE_OUT_BURN_BP = 1000; // 10% burn sur bridge OUT
const FEE_UNSTAKE_BURN_BP    = 300;  // 3% burn sur unstake anticipé

const STAKE_MIN_LOCK_MS = 30 * 24 * 60 * 60 * 1000; // 30 jours

// =========================
// ETAT GLOBAL
// =========================

let wallets = {}; // addr -> { fire, usdc, staked, pub, nonce, stakeLock }
let treasury = { fire: 0, usdc: 0, sol: 0 };
let lp = { fire: 0, usdc: 0 };

let supplyCirculante = 0;
let mintedFireTotal  = 0;
let burnedFireTotal  = 0;

let chain = [];
let mempool = [];

// =========================
// GENESIS
// =========================
// Pas de pré-mine : toute l’émission vient du bridge SOL -> FIRE
(function initGenesis() {
  const genesis = {
    height: 1,
    time: Date.now(),
    prevHash: "0".repeat(64),
    hash: "GENESIS",
    txs: [],
    snapshots: {
      treasury: { ...treasury },
      lp: { ...lp },
      supplyCirculante
    }
  };
  chain.push(genesis);
})();

// =========================
// HELPERS
// =========================

function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = {
      fire: 0,
      usdc: 0,
      staked: 0,
      pub: addr,
      nonce: 0,
      stakeLock: 0
    };
  }
  return wallets[addr];
}

function clamp(x, min, max) {
  return x < min ? min : x > max ? max : x;
}

// TVL globale (USDC FIRE)
function getTVL() {
  const lpUsdc = lp.usdc || 0;
  const treUsdc = treasury.usdc || 0;
  return lpUsdc + treUsdc;
}

// Taux dynamique FIRE / SOL (FIRE par SOL)
function getRate() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || DEC);
  const rawRate = RATE_BASE * factor;
  return clamp(rawRate, RATE_MIN, RATE_MAX);
}

function burn(amount) {
  if (!amount || amount <= 0) return 0;
  const actual = Math.min(amount, supplyCirculante);
  burnedFireTotal += actual;
  supplyCirculante -= actual;
  return actual;
}

function mint(amount) {
  if (!amount || amount <= 0) return 0;
  const spaceLeft = SUPPLY_MAX - supplyCirculante;
  const mintable = Math.max(0, Math.min(amount, spaceLeft));
  mintedFireTotal += mintable;
  supplyCirculante += mintable;
  return mintable;
}

function addFire(addr, amount) {
  const w = ensureWallet(addr);
  w.fire += amount;
}

function subFire(addr, amount) {
  const w = ensureWallet(addr);
  if (w.fire < amount) throw new Error("Solde FIRE insuffisant");
  w.fire -= amount;
}

function addUsdc(addr, amount) {
  const w = ensureWallet(addr);
  w.usdc += amount;
}

function subUsdc(addr, amount) {
  const w = ensureWallet(addr);
  if (w.usdc < amount) throw new Error("Solde USDC insuffisant");
  w.usdc -= amount;
}

function applyBp(amount, bp) {
  return Math.floor(amount * bp / 10000);
}
// =========================
// WEBSOCKET
// =========================

wss.on("connection", (ws) => {
  clients.add(ws);
  ws.on("close", () => clients.delete(ws));

  ws.on("message", (data) => {
    let tx;
    try {
      tx = JSON.parse(data.toString("utf8"));
    } catch (e) {
      ws.send(JSON.stringify({ ok: false, error: "JSON invalide" }));
      return;
    }

    try {
      const res = applyTx(tx);
      ws.send(JSON.stringify({ ok: true, applied: res }));
    } catch (e) {
      ws.send(JSON.stringify({ ok: false, error: e.message || String(e) }));
    }
  });
});


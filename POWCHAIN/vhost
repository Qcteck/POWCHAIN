<style>
body{margin:0;font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#000;color:#e6e6e6;overflow:hidden}
#app{display:flex;height:100vh;width:100vw}
#side{width:240px;background:#000;border-right:1px solid #2a2a2a;box-shadow:5px 0 25px #000;padding:20px 14px;display:flex;flex-direction:column;gap:14px}
#logoBox{display:flex;align-items:center;gap:10px}
#logoI{width:40px;height:40px;border-radius:50%;background:radial-gradient(circle,#ffd700,#b8860b 60%,#222);box-shadow:0 0 18px #ffd70088}
#logoTxt{color:#ffda73;font-weight:700;font-size:15px;letter-spacing:.12em}
nav a{display:flex;align-items:center;gap:10px;padding:10px 12px;font-size:14px;border-radius:10px;text-decoration:none;color:#999;border:1px solid #1a1a1a;background:#0a0a0a;cursor:pointer;margin-bottom:6px}
nav a:hover{border-color:#d4af37;color:#ffd56b;box-shadow:0 0 16px #d4af3733}
nav a.active{border-color:#d4af37;background:#1a1400;color:#ffda7f;box-shadow:0 0 22px #d4af3755 inset}
#main{flex:1;display:flex;flex-direction:column;background:#000}
#top{padding:15px 20px;border-bottom:1px solid #1c1c1c;background:linear-gradient(90deg,#050505,#1a1100 35%,#050505);display:flex;justify-content:space-between;align-items:center}
#top h1{margin:0;color:#ffce54;font-size:18px;letter-spacing:.06em}
#top small{color:#777}
#content{flex:1;overflow:auto;padding:20px;background:#000}
.section{display:none;animation:fade .3s ease}
.section.active{display:block}
@keyframes fade{from{opacity:0}to{opacity:1}}
.card{background:radial-gradient(circle at top,#141414,#050505 60%);border:1px solid #222;border-radius:14px;padding:16px;margin-bottom:18px;box-shadow:0 0 35px #000 inset,0 0 12px #000}
.card h2{margin:0 0 10px 0;font-size:15px;color:#ffdf80;letter-spacing:.08em}
label{font-size:12px;display:block;margin-bottom:5px;color:#ccc}
input,select,button{width:100%;padding:8px 10px;margin:4px 0 10px;border-radius:8px;background:#111;border:1px solid #333;color:#eee;font-size:13px}
button{background:linear-gradient(90deg,#996600,#cc9900,#ffcc33);border:1px solid #d4af37;color:#000;font-weight:600;cursor:pointer;text-transform:uppercase;letter-spacing:.06em}
button:hover{filter:brightness(1.15)}
#log{background:#000;border:1px solid #333;border-radius:12px;padding:12px;height:160px;overflow:auto;font-size:11px;color:#ffe9a6;white-space:pre-wrap;box-shadow:0 0 15px #000 inset}
#syncState{font-size:12px}
#powQR{display:block;margin-top:8px;border-radius:8px;background:#000}
</style>
</head>
<body>
<div id="app">
  <aside id="side">
      <div id="logoBox">
          <div id="logoI"></div>
          <div id="logoTxt">FIREINNERS</div>
      </div>
      <nav>
        <a class="navitem active" data-tab="wallet">Wallet</a>
        <a class="navitem" data-tab="bridge">Bridge</a>
        <a class="navitem" data-tab="dex">DEX</a>
        <a class="navitem" data-tab="stake">Staking</a>
        <a class="navitem" data-tab="explorer">Explorer</a>
        <a class="navitem" data-tab="mempool">Mempool Live</a>
        <a class="navitem" data-tab="stats">Stats</a>
      </nav>
  </aside>

  <main id="main">
      <div id="top">
          <div>
              <h1>POWCHAIN — FIREINNERS PANEL</h1>
              <small>Wallet • Bridge • DEX • Staking • Explorer</small>
          </div>
          <div style="color:#ffd86a" id="syncState">WS: offline</div>
      </div>

      <div id="content">
        <!-- WALLET -->
        <div class="section active" id="wallet">
          <div class="card">
            <h2>Wallet Solana (Phantom)</h2>
            <button id="btnPhantom">Connecter Phantom</button>
            <label>Adresse Solana</label>
            <input id="solAddr" readonly placeholder="-">
            <label>SOL</label>
            <input id="solBal" readonly placeholder="-">
            <label>USDC</label>
            <input id="usdcBal" readonly placeholder="-">
          </div>

          <div class="card">
            <h2>Wallet POWCHAIN — Local</h2>
            <button id="btnGen">Générer un wallet POWCHAIN</button>
            <label>Adresse POWCHAIN</label>
            <input id="powAddr" readonly placeholder="-">
            <label>Clé privée (garde-la)</label>
            <input id="powPriv" readonly placeholder="-">
            <canvas id="powQR" width="140" height="140"></canvas>
            <button id="btnReloadPow">Recharger Balances</button>
            <label>POW</label>
            <input id="powBal" readonly placeholder="-">
            <label>USDC POW</label>
            <input id="powUSDCBal" readonly placeholder="-">
            <label>Staked</label>
            <input id="powStakeBal" readonly placeholder="-">
            <label>Nonce</label>
            <input id="powNonce" readonly placeholder="-">
          </div>

<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script>
/* CONSTANTES */
const API="https://bbqfinance.fun";
const WS_URL="wss://bbqfinance.fun/ws";
const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const DEC=1e6;

/* LOG UTIL */
function log(t){
  const b=document.querySelector("#log");
  b.innerHTML=`[${new Date().toLocaleTimeString()}] ${t}<br>`+b.innerHTML;
}

/* BASE58 */
const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function b58enc(bytes){
  let d=[0];
  for(let i=0;i<bytes.length;i++){
    let c=bytes[i];
    for(let j=0;j<d.length;j++){
      const x=d[j]*256+c;
      d[j]=x%58;c=(x/58)|0;
    }
    while(c>0){d.push(c%58);c=(c/58)|0;}
  }
  let r="";
  for(let k=d.length-1;k>=0;k--)r+=ALPH[d[k]];
  return r;
}
function b58dec(str){
  let b=[0];
  for(let i=0;i<str.length;i++){
    let c=ALPH.indexOf(str[i]);
    for(let j=0;j<b.length;j++){
      const x=b[j]*58+c;
      b[j]=x&255;c=x>>8;
    }
    while(c>0){b.push(c&255);c>>=8;}
  }
  return new Uint8Array(b.reverse());
}

/* ÉTAT */
let solAddr=null;
let powAddr=null;
let powPriv=null;
let powNonce=0;

/* COULEURS FIREINNERS + RARETÉ */
const FIRE_COLORS=[
  {name:"vert",hex:"#00ff00",weight:20,rarity:"common"},
  {name:"or",hex:"#ffd700",weight:1,rarity:"ultra"},
  {name:"blanc",hex:"#ffffff",weight:10,rarity:"common"},
  {name:"noir",hex:"#000000",weight:10,rarity:"common"},
  {name:"rouge",hex:"#ff0000",weight:10,rarity:"common"},
  {name:"argent",hex:"#c0c0c0",weight:10,rarity:"common"},
  {name:"mauve",hex:"#b000ff",weight:8,rarity:"common"},
  {name:"orange",hex:"#ff9900",weight:8,rarity:"common"},
  {name:"gris",hex:"#888888",weight:8,rarity:"common"},
  {name:"jaune",hex:"#ffff00",weight:8,rarity:"common"},
  {name:"violet",hex:"#8000ff",weight:6,rarity:"common"},
  {name:"multicolore",hex:"#00ffff",weight:3,rarity:"rare"},
  {name:"army",hex:"#556b2f",weight:1,rarity:"ultra"}
];
function pickFireColor(){
  let total=FIRE_COLORS.reduce((a,c)=>a+c.weight,0);
  let r=Math.random()*total;
  for(const c of FIRE_COLORS){
    if(r<c.weight)return c;
    r-=c.weight;
  }
  return FIRE_COLORS[0];
}

/* QR CODE */
function drawQR(text,colorHex,rarity){
  const cv=document.querySelector("#qr");
  const ctx=cv.getContext("2d");
  const s=cv.width;
  ctx.fillStyle="#050008";
  ctx.fillRect(0,0,s,s);

  const box=document.querySelector("#qrBox");
  box.classList.remove("qr-common","qr-rare","qr-ultra");

  if(!text){
    box.classList.add("qr-common");
    ctx.strokeStyle="#ffcf5c55";ctx.strokeRect(8,8,s-16,s-16);
    return;
  }

  const size=27;
  const cell=s/size;
  const hex=parseInt(colorHex.slice(1),16);
  let R=(hex>>16)&255, G=(hex>>8)&255, B=hex&255;

  let seed=[...text].reduce((a,c)=>(a*31+c.charCodeAt(0))>>>0,1);

  for(let y=0;y<size;y++){
    for(let x=0;x<size;x++){
      seed=(seed*1103515245+12345)>>>0;
      if(seed&0x80000000){
        const k=0.65+0.4*((seed>>>16)/65535);
        ctx.fillStyle=`rgb(${Math.floor(R*k)},${Math.floor(G*k)},${Math.floor(B*k)})`;
        ctx.fillRect(x*cell+1,y*cell+1,cell-2,cell-2);
      }
    }
  }

  if(rarity==="rare")box.classList.add("qr-rare");
  else if(rarity==="ultra")box.classList.add("qr-ultra");
  else box.classList.add("qr-common");
}

/* CONNECT PHANTOM */
document.querySelector("#btnPhantom").onclick=async()=>{
  try{
    const p=window.solana;
    if(!p||!p.isPhantom)return alert("Phantom non détecté");
    const resp=await p.connect();
    solAddr=resp.publicKey.toString();
    document.querySelector("#solAddr").value=solAddr;
    log("Phantom connecté");
    loadSolBalances();
  }catch(e){log("Phantom ERR : "+e.message);}
};

/* SOL + USDC */
async function loadSolBalances(){
  if(!solAddr)return;
  try{
    const r=await fetch(SOL_RPC,{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getBalance",params:[solAddr]})
    });
    const j=await r.json();
    const lam=j?.result?.value||0;
    document.querySelector("#solBal").value=(lam/1e9).toFixed(4);

    const r2=await fetch(SOL_RPC,{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        jsonrpc:"2.0",id:1,method:"getTokenAccountsByOwner",
        params:[solAddr,{mint:USDC_MINT},{encoding:"jsonParsed"}]
      })
    });
    const j2=await r2.json();
    let total=0;
    (j2?.result?.value||[]).forEach(a=>{
      total+=a.account.data.parsed.info.tokenAmount.uiAmount||0;
    });
    document.querySelector("#usdcBal").value=total.toFixed(2);

  }catch(e){log("Sol Bal ERR: "+e.message);}
}
document.querySelector("#btnSolRefresh").onclick=loadSolBalances;

/* GÉNÉRER WALLET FIREINNERS */
document.querySelector("#btnGen").onclick=()=>{
  const kp=nacl.sign.keyPair();
  powAddr=b58enc(kp.publicKey);
  powPriv=b58enc(kp.secretKey);
  powNonce=0;

  const num=Math.floor(Math.random()*100000000)+1;
  const letters="ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  let code="";
  for(let i=0;i<4;i++)code+=letters[Math.floor(Math.random()*letters.length)];

  const col=pickFireColor();
  document.querySelector("#walletColorDot").style.background=col.hex;
  document.querySelector("#walletColorName").innerText=col.name.toUpperCase();

  const fireId=`441-FIRE-${num}-${code}-${col.name.toUpperCase()}`;
  document.querySelector("#fireId").value=fireId;

  document.querySelector("#powAddr").value=powAddr;
  document.querySelector("#powPriv").value=powPriv;

  drawQR(powAddr,col.hex,col.rarity);

  log("Wallet FIREINNERS généré");
};

/* RELOAD FIREINNERS WALLET */
document.querySelector("#btnReloadPow").onclick=async()=>{
  if(!powAddr)return alert("Wallet FIREINNERS requis");
  try{
    const r=await fetch(`${API}/wallet/${powAddr}`);
    const w=await r.json();
    powNonce=w.nonce;
    document.querySelector("#powBal").value=(w.pow/DEC).toFixed(6);
    document.querySelector("#powUSDCBal").value=(w.usdc/DEC).toFixed(6);
    document.querySelector("#powStakeBal").value=(w.staked/DEC).toFixed(6);
    document.querySelector("#powNonce").value=w.nonce;
    log("Wallet FIREINNERS chargé");
  }catch(e){log("Wallet ERR : "+e.message);}
};

/* BRIDGE DECLARATION (simple backend) */
document.querySelector("#btnBridge").onclick=async()=>{
  if(!powAddr)return alert("Wallet FIREINNERS requis");
  const amt=parseFloat(document.querySelector("#bridgeAmt").value);
  if(!(amt>0))return log("Montant invalide");

  try{
    const r=await fetch(`${API}/bridge`,{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,amount:amt})
    });
    const j=await r.json();
    if(!j.ok)return log("Bridge FAIL : "+j.error);
    log("Bridge déclaré");
    document.querySelector("#btnReloadPow").click();
  }catch(e){log("Bridge ERR : "+e.message);}
};

/* SWAP */
document.querySelector("#btnSwap").onclick=async()=>{
  if(!powAddr)return alert("Wallet FIREINNERS requis");
  const amt=parseFloat(document.querySelector("#swapAmt").value);
  const dir=document.querySelector("#swapDir").value;
  if(!(amt>0))return log("Montant incorrect");
  try{
    const r=await fetch(`${API}/swap`,{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,dir,amount:Math.floor(amt*DEC)})
    });
    const j=await r.json();
    if(!j.ok)return log("Swap FAIL : "+j.error);
    log("Swap OK : "+(j.received/DEC).toFixed(6));
    document.querySelector("#btnReloadPow").click();
  }catch(e){log("Swap ERR : "+e.message);}
};

/* ADD LP */
document.querySelector("#btnLPAdd").onclick=async()=>{
  if(!powAddr)return alert("Wallet FIREINNERS requis");
  const p=parseFloat(document.querySelector("#lpAddPow").value);
  const u=parseFloat(document.querySelector("#lpAddUsdc").value);
  if(!(p>0&&u>0))return log("Montants invalides");
  try{
    const r=await fetch(`${API}/lp/add`,{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,pow:Math.floor(p*DEC),usdc:Math.floor(u*DEC)})
    });
    const j=await r.json();
    if(!j.ok)return log("LP FAIL : "+j.error);
    log("LP ajoutée");
    document.querySelector("#btnReloadPow").click();
  }catch(e){log("LP ERR : "+e.message);}
};

/* STAKE */
document.querySelector("#btnStake").onclick=async()=>{
  if(!powAddr)return alert("Wallet FIREINNERS requis");
  const amt=parseFloat(document.querySelector("#stakeAmt").value);
  if(!(amt>0))return log("Montant invalide");
  try{
    const r=await fetch(`${API}/stake`,{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,amount:Math.floor(amt*DEC)})
    });
    const j=await r.json();
    if(!j.ok)return log("Stake FAIL : "+j.error);
    log("Stake OK");
    document.querySelector("#btnReloadPow").click();
  }catch(e){log("Stake ERR : "+e.message);}
};

/* EXPLORER */
document.querySelector("#btnBlock").onclick=async()=>{
  const h=parseInt(document.querySelector("#blockInp").value);
  if(!(h>0))return;
  try{
    const r=await fetch(`${API}/block/${h}`);
    const b=await r.json();
    document.querySelector("#blockOut").textContent=JSON.stringify(b,null,2);
  }catch(e){
    document.querySelector("#blockOut").textContent="ERR : "+e.message;
  }
};

/* STATS */
async function refreshStats(){
  try{
    const r=await fetch(`${API}/stats`);
    const s=await r.json();
    document.querySelector("#sHeight").value=s.height;
    document.querySelector("#sWallets").value=s.wallets;
    document.querySelector("#sPOW").value=s.totalPow;
    document.querySelector("#sStaked").value=s.totalStaked;
    document.querySelector("#sMP").value=s.mempool;
    document.querySelector("#sLPpow").value=s.lpPow;
    document.querySelector("#sLPusdc").value=s.lpUsdc;
    document.querySelector("#sTSol").value=s.solTreasury;
    document.querySelector("#sTUsdc").value=s.usdcTreasury;
    document.querySelector("#sTFire").value=s.fireTreasury;

  }catch(e){log("Stats ERR : "+e.message);}
}
setInterval(refreshStats,5000);
refreshStats();

/* WEBSOCKET */
function connectWS(){
  const ws=new WebSocket(WS_URL);
  ws.onopen=()=>{document.querySelector("#syncState").textContent="WS: online"};
  ws.onclose=()=>{
    document.querySelector("#syncState").textContent="WS: offline";
    setTimeout(connectWS,2500);
  };
  ws.onmessage=e=>{
    try{
      const m=JSON.parse(e.data);
      if(m.type==="mempool"){
        document.querySelector("#mempoolLive").textContent=JSON.stringify(m.mempool,null,2);
      }
    }catch{}
  };
}
connectWS();

/* NAVIGATION */
document.querySelectorAll(".navitem").forEach(a=>{
  a.onclick=()=>{
    document.querySelectorAll(".navitem").forEach(x=>x.classList.remove("active"));
    a.classList.add("active");
    const tab=a.dataset.tab;
    document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
    document.querySelector("#"+tab).classList.add("active");
  };
});
</script>

</body>

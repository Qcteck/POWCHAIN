const express = require("express");
const fs = require("fs");
const app = express();
app.use(express.json());

const CHAIN_PATH = "/root/powchain/chain.json";
let chain = [];

// Charger la blockchain existante si présente
try {
  if (fs.existsSync(CHAIN_PATH)) {
    chain = JSON.parse(fs.readFileSync(CHAIN_PATH));
    console.log("Blockchain chargée :", chain.length, "blocs");
  }
} catch (e) {
    console.log("Erreur de chargement JSON :", e);
    chain = [];
}

// Endpoint STATISTIQUES pour le Dashboard
app.get("/stats", (req, res) => {
  res.json({
    status: "online",
    blocks: chain.length,
    lastHash: chain.length ? chain[chain.length - 1].hash : "GENESIS",
    chain
  });
});

// Endpoint TRANSACTION
app.post("/tx", (req, res) => {
  const tx = req.body;
  if (!tx || typeof tx !== "object") return res.status(400).json({ error: "invalid tx" });

  chain.push(tx);

  try {
    fs.writeFileSync(CHAIN_PATH, JSON.stringify(chain, null, 2));
  } catch (e) {
    return res.status(500).json({ error: "write error" });
  }

  console.log("TX reçue + ajoutée au chain.json");
  res.json({ ok: true });
});

// Démarrer le serveur API
app.listen(3000, () => {
  console.log("🔥 POWCHAIN API en ligne sur port 3000 (/stats /tx)");
});
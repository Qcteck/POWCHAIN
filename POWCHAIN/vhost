  grid-template-columns:1.15fr 1.1fr 1.1fr;
  gap:14px;
}
@media(max-width:980px){
  .main-grid{grid-template-columns:1fr;gap:10px}
}
.card{
  border-radius:14px;
  border:1px solid #4b5563;
  background:radial-gradient(circle at top,#111827,#020617 60%,#000 100%);

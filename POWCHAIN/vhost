<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport"content="width=device-width,initial-scale=1"/>
<title>POWCHAIN — Client Complet</title>
<script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
<script src="https://bundle.run/buffer@6.0.3"></script>
<script>window.Buffer=buffer.Buffer;</script>
<script src="https://unpkg.com/tweetnacl@1.0.3/nacl-fast.min.js"></script>
<script src="https://unpkg.com/bs58@5.0.0/dist/bs58.min.js"></script>
<style>
body{margin:0;background:#05070b;color:#e5ecff;font-family:system-ui,Arial}
#wrap{max-width:900px;margin:20px auto;padding:16px;border-radius:12px;
border:1px solid #222b37;background:#0b111c;box-shadow:0 0 18px #000}
h2{text-align:center;margin:4px 0 10px;color:#8ff}
h3{margin:8px 0 4px;color:#a8d9ff}
.row{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:10px}
.card{flex:1 1 260px;background:#101a27;border:1px solid #223246;border-radius:10px;padding:12px}
#log{margin-top:14px;background:#000c;border:1px solid #222;height:260px;overflow:auto;
padding:6px;font-size:13px;white-space:pre-wrap;border-radius:10px}
button,input{border-radius:6px;border:1px solid #105d7a;background:#08202f;
color:#8ff;padding:7px;font-size:14px;margin:4px 0}
</style>
</head>
<body>
<div id="wrap">
<h2>POWCHAIN — Client Complet</h2>

<button id="ph">🔗 Connecter Phantom</button>
<div class="row">
<div class="card"><h3>SOL</h3><div id="sol">—</div></div>
<div class="card"><h3>POW</h3><div id="pow">—</div></div>
<div class="card"><h3>USDC POW</h3><div id="usdc">—</div></div>
<div class="card"><h3>LP</h3><div id="lp">—</div></div>
</div>

<div class="row">
<button onclick="sendTx('transferPow')">Envoyer POW</button>
<button onclick="sendTx('swap')">Swap POW ↔ USDC POW</button>
<button onclick="sendTx('stake')">Staker POW</button>
<button onclick="sendTx('unstake')">Unstake POW</button>
<button onclick="sendTx('claim')">Récolter récompenses</button>
</div>

<div id="log"></div>
</div>

<script>
let addr="",pub,priv="",nonce=0,ws;
const sol=document.getElementById("sol"),pow=document.getElementById("pow"),
usdc=document.getElementById("usdc"),lp=document.getElementById("lp"),log=e=>{logEl.innerText+=e+"\n"};
const logEl=document.getElementById("log");

async function connectPhantom(){
  try{
    const r=await window.solana.connect();
    addr=r.publicKey.toString();
    pub=r.publicKey.toString();
    log("🔗 Phantom connecté: "+addr);
    requestState();
  }catch(e){log("❌ Phantom refusé");}
}
document.getElementById("ph").onclick=connectPhantom;

function wsConnect(){
  ws=new WebSocket("ws://localhost:7001");
  ws.onopen=()=>log("🌐 WebSocket OK");
  ws.onmessage=e=>{
    const d=JSON.parse(e.data);
    if(d.type==="state"){
      sol.textContent=d.solBalances[addr]??0;
      pow.textContent=d.powBalances[addr]??0;
      usdc.textContent=d.usdcBalances[addr]??0;
      lp.textContent=d.lpBalances[addr]??0;
      nonce=d.nonces[addr]??0;
    }
  };
  ws.onclose=()=>setTimeout(wsConnect,800);
}
wsConnect();

function ensure(){if(!addr){log("❌ Connecte Phantom");return false}return true;}
function requestState(){ws.send(JSON.stringify({type:"getState"}));}

async function sendTx(type){
  if(!ensure())return;
  requestState();
  await new Promise(r=>setTimeout(r,100));
  const tx={type,from:addr,pub,nonce:nonce+1};
  const msg=new TextEncoder().encode(JSON.stringify({
    type:tx.type,from:tx.from,nonce:tx.nonce
  }));
  tx.sig = bs58.encode(nacl.sign.detached(msg,bs58.decode(priv)));
  ws.send(JSON.stringify(tx));
  log("🚀 TX envoyée: "+type);
}
</script>
</body>
</html>






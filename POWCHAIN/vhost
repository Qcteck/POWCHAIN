<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>POWCHAIN — Client Complet</title>

  <!-- Solana Web3 pour Phantom -->
  <script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>

  <style>
    :root{
      --bg:#05070b;
      --card:#0b1120;
      --border:#1f2937;
      --accent:#38bdf8;
      --accent-soft:#0ea5e9;
      --accent-txt:#e0f2fe;
      --txt:#e5ecff;
      --muted:#94a3b8;
      --danger:#f97373;
      --ok:#4ade80;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      background:var(--bg);
      color:var(--txt);
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      overflow-x:hidden;
    }
    h1{
      margin:10px 0 4px;
      font-size:22px;
      letter-spacing:1px;
    }
    #topbar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:10px 18px 4px;
      border-bottom:1px solid #020617;
      background:radial-gradient(circle at top,#020617,#020617 40%,#000 100%);
      box-shadow:0 6px 18px #000;
    }
    #statusBadge{
      padding:4px 10px;
      border-radius:999px;
      border:1px solid #0f172a;
      background:#022c22;
      color:#bbf7d0;
      font-size:11px;
      display:flex;
      align-items:center;
      gap:6px;
    }
    #statusDot{
      width:8px;
      height:8px;
      border-radius:50%;
      background:var(--danger);
      box-shadow:0 0 6px var(--danger);
    }
    #layout{
      display:grid;
      grid-template-columns:340px 400px 420px;
      gap:12px;
      padding:12px 16px 18px;
    }
    @media(max-width:1200px){
      #layout{
        grid-template-columns:1fr;
      }
    }
    .card{
      background:linear-gradient(145deg,#020617,#020617 55%,#020617);
      border-radius:14px;
      border:1px solid var(--border);
      box-shadow:0 0 22px #000a;
      padding:10px 12px 12px;
    }
    .card h2{
      margin:2px 0 8px;
      font-size:14px;
      text-transform:uppercase;
      letter-spacing:.08em;
      color:var(--accent);
    }
    .label{
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.08em;
      color:var(--muted);
      margin-top:4px;
    }
    .value{
      font-size:13px;
      margin-top:2px;
    }
    .row{
      display:flex;
      gap:8px;
      margin-top:4px;
    }
    .row > div{flex:1}
    input,select,button,textarea{
      width:100%;
      padding:6px 7px;
      border-radius:7px;
      border:1px solid #1f2937;
      background:#020617;
      color:var(--txt);
      font-size:12px;
      font-family:inherit;
      outline:none;
    }
    input:focus,select:focus,textarea:focus{
      border-color:var(--accent);
      box-shadow:0 0 0 1px #0ea5e955;
    }
    button{
      cursor:pointer;
      text-transform:uppercase;
      font-weight:600;
      letter-spacing:.06em;
      background:radial-gradient(circle at top,#0ea5e9,#0369a1);
      border-color:#0ea5e9;
      color:#e0f2fe;
      box-shadow:0 0 10px #0ea5e988;
    }
    button.secondary{
      background:#020617;
      border-color:#1f2937;
      color:var(--muted);
      box-shadow:none;
    }
    button:disabled{
      opacity:.5;
      cursor:not-allowed;
      box-shadow:none;
    }
    #log{
      height:150px;
      margin-top:6px;
      background:#020617;
      border-radius:10px;
      border:1px solid #111827;
      padding:6px 8px;
      font-size:11px;
      overflow-y:auto;
      white-space:pre-wrap;
    }
    #chart{
      height:140px;
      margin-top:6px;
      border-radius:10px;
      border:1px solid #111827;
      background:radial-gradient(circle at top,#020617,#000);
      position:relative;
      overflow:hidden;
    }
    #chartCanvas{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
    }
    .badge{
      display:inline-flex;
      align-items:center;
      gap:6px;
      border-radius:999px;
      padding:2px 8px;
      font-size:10px;
      border:1px solid #1f2937;
      color:var(--muted);
    }
    .pill{
      border-radius:999px;
      padding:2px 7px;
      font-size:10px;
      background:#0f172a;
      color:#e5e7eb;
    }
    .hint{
      margin-top:4px;
      font-size:11px;
      color:var(--muted);
    }
  </style>
</head>
<body>
  <div id="topbar">

  const w = wallets[addr];
  if (!w) return res.json({ ok: true, wallet: null });
  res.json({ ok: true, wallet: w });
});

// BRIDGE SOL -> FIREINNERS (utilisé par le bouton SOL -> POWCHAIN)
app.post("/bridge", async (req, res) => {
  try {
    const { powAddress, solAddress, amountSol, txSig } = req.body || {};
    const ev = await processBridgeInRPC(powAddress, solAddress, amountSol, txSig);
    const block = appendBlock([ev]);
    res.json({ ok: true, blockHeight: block.height, event: ev });
  } catch (e) {
    console.error("Erreur /bridge", e);
    res.status(400).json({ ok: false, error: e.message });
  }
});

// TX signées POWCHAIN (send, swap, stake, bridge out)
app.post("/tx", (req, res) => {
  try {
    const { tx, sig } = req.body || {};
    if (!tx || !sig) throw new Error("tx ou sig manquante");

    if (!verifyPowchainSignature(tx, sig)) {
      throw new Error("Signature POWCHAIN invalide");
    }

    const w = ensureWallet(tx.from);
    if (w.pub && w.pub !== tx.pub) {
      throw new Error("Pubkey mismatch pour ce wallet");
    }
    w.pub = tx.pub;

    if (typeof tx.nonce !== "number") throw new Error("Nonce manquant");
    if (tx.nonce !== w.nonce + 1) {
      throw new Error("Nonce invalide (rejouée ou hors ordre)");
    }

    const ev = applyEconomicTx(tx);
    w.nonce = tx.nonce;

    const block = appendBlock([ev]);
    res.json({ ok: true, blockHeight: block.height, event: ev });
  } catch (e) {
    console.error("Erreur /tx", e);
    res.status(400).json({ ok: false, error: e.message });
  }
});

// =========================
// WEBSOCKET EXPLORER
// =========================

function broadcast(msg) {
  const data = JSON.stringify(msg);
  for (const ws of clients) {
    if (ws.readyState === WebSocket.OPEN) {
      ws.send(data);
    }
  }
}

wss.on("connection", ws => {
  clients.add(ws);
  console.log("WS client connecté, total =", clients.size);

  ws.send(
    JSON.stringify({
      type: "HELLO",
      height: chain[chain.length - 1]?.height || 0,
      tvl: getTVL()
    })
  );

  ws.on("close", () => {
    clients.delete(ws);
    console.log("WS client déconnecté, total =", clients.size);
  });
});


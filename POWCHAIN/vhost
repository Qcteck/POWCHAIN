    q("#statsBarInner").textContent=`HEIGHT ${s.height} • WALLETS ${s.wallets} • MEMPOOL ${s.mempool} • LP ${ (s.lpPow/DEC).toFixed(2) }/${ (s.lpUsdc/DEC).toFixed(2) }`;
  }catch(e){log("Stats ERR");}
}
setInterval(refreshStats,3000);refreshStats();

function b58enc(bytes){const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";let d=[0];for(let i=0;i<bytes.length;i++){let c=bytes[i];for(let j=0;j<d.length;j++){let x=d[j]*256+c;d[j]=x%58;c=(x/58)|0}while(c>0){d.push(c%58);c=(c/58)|0}}let r="";for(let k=d.length-1;k>=0;k--)r+=ALPH[d[k]];return r;}

function drawQR(t){const cv=q("#qr"),ctx=cv.getContext("2d"),s=cv.width;ctx.fillStyle="#050008";ctx.fillRect(0,0,s,s);if(!t)return;const size=25,cell=s/size;let seed=[...t].reduce((a,c)=>(a*31+c.charCodeAt(0))>>>0,1);for(let y=0;y<size;y++)for(let x=0;x<size;x++){seed=(seed*1103515245+12345)>>>0;if(seed&0x80000000){ctx.fillStyle="#ffd700";ctx.fillRect(x*cell+1,y*cell+1,cell-2,cell-2)}}}

q("#btnGen").onclick=()=>{const kp=nacl.sign.keyPair();powAddr=b58enc(kp.publicKey);powPriv=b58enc(kp.secretKey);q("#powAddr").value=powAddr;q("#powPriv").value=powPriv;q("#powRecv").value=powAddr;drawQR(powAddr);log("Wallet FIREINNERS généré");};
q("#btnReloadPow").onclick=async()=>{if(!powAddr)return alert("Génère un wallet");const r=await fetch(API+"/wallet/"+powAddr,{cache:"no-store"});const w=await r.json();q("#powBal").value=(w.pow/DEC).toFixed(6);q("#powUSDCBal").value=(w.usdc/DEC).toFixed(6);q("#powStakeBal").value=(w.staked/DEC).toFixed(6);q("#powNonce").value=w.nonce||0;log("Wallet chargé");};

q("#btnBridge").onclick=async()=>{if(!powAddr)return alert("Génère un wallet");const amt=parseFloat((q("#bridgeAmt").value||"").trim());if(!(amt>0))return;const r=await fetch(API+"/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,amount:amt,signature:"ui"})});const j=await r.json();if(!j.ok)return log("Bridge FAIL");log("Bridge OK");q("#btnReloadPow").onclick();refreshStats();};
q("#btnSwap").onclick=async()=>{if(!powAddr)return alert("Génère un wallet");const amt=parseFloat((q("#swapAmt").value||"").trim());if(!(amt>0))return;const dir=q("#swapDir").value;const r=await fetch(API+"/swap",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,dir,amount:Math.floor(amt*DEC)})});const j=await r.json();if(!j.ok)return log("Swap FAIL");log("Swap OK");q("#btnReloadPow").onclick();refreshStats();};
q("#btnLPAdd").onclick=async()=>{if(!powAddr)return alert("Génère un wallet");const p=parseFloat((q("#lpAddPow").value||"").trim());const u=parseFloat((q("#lpAddUsdc").value||"").trim());if(!(p>0&&u>0))return;const r=await fetch(API+"/lp/add",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,pow:Math.floor(p*DEC),usdc:Math.floor(u*DEC)})});const j=await r.json();if(!j.ok)return log("LP FAIL");log("LP OK");q("#btnReloadPow").onclick();refreshStats();};
q("#btnStake").onclick=async()=>{if(!powAddr)return alert("Génère un wallet");const amt=parseFloat((q("#stakeAmt").value||"").trim());if(!(amt>0))return;const r=await fetch(API+"/stake",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({addr:powAddr,amount:Math.floor(amt*DEC)})});const j=await r.json();if(!j.ok)return log("Stake FAIL");log("Stake OK");q("#btnReloadPow").onclick();refreshStats();};
q("#btnBlock").onclick=async()=>{const h=parseInt((q("#blockInp").value||"0"),10);if(!(h>0))return;const r=await fetch(API+"/block/"+h,{cache:"no-store"});q("#blockOut").textContent=await r.text();};

q("#btnFireOpen").onclick=()=>{let u=(q("#fireUrl").value||"").trim();if(!u)return;if(!/^https?:\/\//i.test(u))u="https://"+u;const l=u.toLowerCase();if(l.startsWith("javascript:")||l.includes("data:text/html"))return alert("Bloqué");q("#fireFrame").src=u;};

q("#btnTestMine").onclick=()=>{const addr=(q("#minerAddr").value||"").trim();if(!addr)return;let tries=0;const target="0000";const el=q("#miningLog");const start=performance.now();function loop(){for(let i=0;i<4000;i++){const nonce=(Math.random()*1e9)|0;const data=addr+"|"+nonce;let h=0;for(let k=0;k<data.length;k++)h=(h*31+data.charCodeAt(k))>>>0;const hex=h.toString(16).padStart(8,"0");tries++;if(hex.startsWith(target)){el.textContent=`OK ${hex} tries=${tries} t=${((performance.now()-start)/1000).toFixed(2)}s\n`+el.textContent;return;}}requestAnimationFrame(loop)};loop();};


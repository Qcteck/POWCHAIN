    try{
      const kp = nacl.sign.keyPair();
      powAddr = bs58.default ? bs58.default.encode(kp.publicKey) : bs58.encode(kp.publicKey);
      powPriv = bs58.default ? bs58.default.encode(kp.secretKey) : bs58.encode(kp.secretKey);
      localStorage.setItem("pow_addr",powAddr);
      localStorage.setItem("pow_priv",powPriv);
      el("powAddr").value = powAddr;
      logMsg("Nouveau wallet POWCHAIN généré.");
      fetchWallet();
    }catch(e){
      alert("Erreur génération wallet POWCHAIN : "+e);
      logMsg("Wallet gen ERR: "+e);
    }
  }

  async function fetchWallet(){
    if(!powAddr) return;
    try{
      const r = await fetch("/wallet?id="+encodeURIComponent(powAddr));
      if(!r.ok) throw new Error("HTTP "+r.status);
      const w = await r.json();
      el("powPow").textContent = w.pow;
      el("powUsdc").textContent = w.usdc;
    }catch(e){
      logMsg("Wallet fetch ERR: "+e);
    }
  }

  // ---------- PHANTOM ----------
  async function connectPhantom(){
    try{
      if(!window.solana || !window.solana.isPhantom){
        alert("Phantom non détecté.");
        return;
      }
      const resp = await window.solana.connect();
      const pub = resp.publicKey.toString();
      el("solAddr").value = pub;
      logMsg("Phantom connecté: "+pub);
      await refreshSol();
    }catch(e){
      logMsg("Phantom connect ERR: "+e);
    }
  }

  async function refreshSol(){
    try{
      const addr = el("solAddr").value;
      if(!addr){
        logMsg("refreshSol: pas d'adresse Phantom.");
        return;
      }
      const conn = new solanaWeb3.Connection(RPC_SOL);
      const pub = new solanaWeb3.PublicKey(addr);
      const lamports = await conn.getBalance(pub,"confirmed");
      const sol = lamports / 1e9;

      // USDC SPL
      let usdc = 0;
      try{
        const mint = new solanaWeb3.PublicKey(USDC_MINT);
        const toks = await conn.getParsedTokenAccountsByOwner(pub,{ mint });
        toks.value.forEach(a=>{
          const amt = a.account.data.parsed.info.tokenAmount.uiAmount || 0;
          usdc += Number(amt);
        });
      }catch(e){}

      el("solBal").textContent = sol.toFixed(5);
      el("usdcBal").textContent = usdc.toFixed(2);
      logMsg("Soldes Phantom mis à jour.");
    }catch(e){
      logMsg("refreshSol ERR: "+e);
    }
  }

  // ---------- BRIDGE SOL → POWCHAIN ----------
  async function bridgeSol(){
    try{
      if(!powAddr){
        alert("Génère d'abord un wallet POWCHAIN.");
        return;
      }
      if(!window.solana || !window.solana.isPhantom){
        alert("Connecte Phantom d'abord.");
        return;
      }
      const amtStr = el("bridgeAmount").value.trim();
      const amt = Number(amtStr);
      if(!amt || amt <= 0){
        alert("Montant SOL invalide.");
        return;
      }

      const conn = new solanaWeb3.Connection(RPC_SOL);
      const fromPub = window.solana.publicKey;
      const toPub = new solanaWeb3.PublicKey(TREASURY_SOL);
      const lamports = Math.floor(amt * 1e9);

      let tx = new solanaWeb3.Transaction().add(
        solanaWeb3.SystemProgram.transfer({
          fromPubkey: fromPub,
          toPubkey: toPub,
          lamports
        })
      );
      tx.feePayer = fromPub;
      const { blockhash } = await conn.getLatestBlockhash();
      tx.recentBlockhash = blockhash;

      const signed = await window.solana.signTransaction(tx);
      const sig = await conn.sendRawTransaction(signed.serialize());
      await conn.confirmTransaction(sig,"confirmed");

      logMsg("Bridge SOL on-chain envoyé: "+sig);

      // Notify POWCHAIN backend pour créditer POW
      const r = await fetch("/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
          type:"bridge",
          to: powAddr,
          amountSol: amt,
          solanaSig: sig
        })
      });

      const js = await r.json();
      if(!r.ok || js.error){
        logMsg("Bridge backend ERR: "+(js.error || r.status));
        alert("Bridge côté POWCHAIN refusé: "+(js.error || "HTTP "+r.status));
        return;
      }
      logMsg("Bridge validé sur POWCHAIN, +" + js.amountPow + " POW.");
      alert("Requête de bridge envoyée et validée. Regarde le solde POWCHAIN.");
      fetchWallet();
    }catch(e){
      logMsg("Bridge ERR: "+e);
      alert("Erreur bridge: "+e);
    }
  }

  // ---------- ACTIONS POWCHAIN (send / stake) ----------
  async function sendPow(){
    if(!powAddr){alert("Génère un wallet POWCHAIN d'abord.");return;}
    const dest = el("sendTo").value.trim();
    const amt = Number(el("sendAmount").value.trim());
    if(!dest || !amt || amt<=0){alert("Paramètres SEND invalides.");return;}
    try{
      const r = await fetch("/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({type:"send",from:powAddr,to:dest,amount:amt})
      });
      const js = await r.json();
      if(!r.ok || js.error){alert("SEND ERR: "+(js.error||r.status));logMsg("SEND ERR: "+(js.error||r.status));return;}
      logMsg("SEND OK "+amt+" POW → "+dest);
      fetchWallet();
    }catch(e){
      logMsg("SEND fetch ERR: "+e);
    }
  }

  async function stakePow(kind){
    if(!powAddr){alert("Génère un wallet POWCHAIN d'abord.");return;}
    const amt = Number(el("stakeAmount").value.trim());
    if(!amt || amt<=0){alert("Montant stake invalide.");return;}
    const type = kind==="in" ? "stake" : "unstake";
    try{
      const r = await fetch("/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({type,from:powAddr,amount:amt})
      });
      const js = await r.json();
      if(!r.ok || js.error){alert("STAKE ERR: "+(js.error||r.status));logMsg("STAKE ERR: "+(js.error||r.status));return;}
      logMsg(type.toUpperCase()+" OK "+amt+" POW");
      fetchWallet();
    }catch(e){
      logMsg("STAKE fetch ERR: "+e);
    }
  }

  async function addLp(){
    if(!powAddr){alert("Génère un wallet POWCHAIN d'abord.");return;}
    const powAmt = Number(el("lpPow").value.trim());
    const usdcAmt = Number(el("lpUsdc").value.trim());
    if(!powAmt||powAmt<=0||!usdcAmt||usdcAmt<=0){alert("Montants LP invalides.");return;}
    try{
      const r = await fetch("/tx",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({type:"addLP",from:powAddr,pow:powAmt,usdc:usdcAmt})
      });
      const js = await r.json();
      if(!r.ok || js.error){alert("ADD LP ERR: "+(js.error||r.status));logMsg("ADD LP ERR: "+(js.error||r.status));return;}
      logMsg("ADD LP OK POW="+powAmt+" / USDC POW="+usdcAmt);
      refreshStats();
    }catch(e){
      logMsg("ADD LP fetch ERR: "+e);
    }
  }

  // ---------- Explorer ----------
  async function loadLastBlocks(){
    try{
      const r = await fetch("/chain");
      if(!r.ok) throw new Error("HTTP "+r.status);
      const chain = await r.json();
      const last = chain.slice(-30);
      logMsg("Derniers blocs :");
      last.forEach(b=>{
        logMsg("Block #"+b.index+" txs="+(b.txs?b.txs.length:0)+" hash="+(b.hash||""));
      });
    }catch(e){
      logMsg("Explorer ERR: "+e);
    }
  }

  // ---------- INIT ----------
  function init(){
    el("btnGenPow").onclick = genPowWallet;
    el("btnReloadPow").onclick = fetchWallet;
    el("btnConnectPhantom").onclick = connectPhantom;
    el("btnRefreshSol").onclick = refreshSol;
    el("btnBridge").onclick = bridgeSol;
    el("btnSend").onclick = sendPow;
    el("btnStake").onclick = ()=>stakePow("in");
    el("btnUnstake").onclick = ()=>stakePow("out");
    el("btnAddLp").onclick = addLp;
    el("btnLoadBlocks").onclick = loadLastBlocks;
    el("btnClearLog").onclick = ()=>{el("log").value="";};

    loadPowWallet();
    refreshStats();
    connectWs();
    setInterval(refreshStats,60000);
  }

  window.addEventListener("load",init);
})();
</script>
</body>

# npm deps
npm init -y >/dev/null 2>&1 || true
npm i express tweetnacl >/dev/null

# générer clés + patch signer.js
node -e "const nacl=require('tweetnacl');const k=nacl.sign.keyPair();console.log(Buffer.from(k.publicKey).toString('hex'));console.log(Buffer.from(k.secretKey).toString('hex'));" > .keys
PUB=$(head -n1 .keys | tr -d '\r\n')
PRIV=$(tail -n1 .keys | tr -d '\r\n')

sed -i "s/PUB_HEX_ICI/$PUB/g" signer.js
sed -i "s/PRIV_HEX_ICI/$PRIV/g" signer.js

# patch pubkey bytes dans qplus.c
BYTES=$(echo "$PUB" | sed 's/../0x&,/g' | sed 's/,$//')
perl -0777 -i -pe "s/const unsigned char QPLUS_PUBKEY\\[32\\]=\\{[^}]*\\}/const unsigned char QPLUS_PUBKEY[32]={$BYTES}/s" qplus.c

# compile wasm
clang --target=wasm32 -O3 -nostdlib -Wl,--no-entry -Wl,--export-all -o qplus.wasm qplus.c

# pm2 (auto)
sudo npm i -g pm2 >/dev/null
pm2 delete qplus-signer >/dev/null 2>&1 || true
pm2 start signer.js --name qplus-signer
pm2 save >/dev/null


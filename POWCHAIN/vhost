<script>
const API="https://bbqfinance.fun";
const WS_URL="wss://bbqfinance.fun/ws";
const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const TREASURY_SOL="BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";
const DEC=1e6;
const LAMPORTS_PER_SOL=1e9;
const ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";

let addrFire=null,privFire=null,pubFire=null,nonceFire=0;
let solPub=null;
let sock=null;
let lastBridgeSig=null;
let lastBridgeAmount=0;

const q=s=>document.querySelector(s);
const logBox=q("#log");

function log(m){
  if(!logBox)return;
  logBox.textContent="["+new Date().toLocaleTimeString()+"] "+m+"\n"+logBox.textContent;
}
function fmtFire(n){return (n/DEC).toFixed(6);}
function fmtUsd(n){return (n/DEC).toFixed(2);}
function setDot(el,txtEl,state){
  if(!el||!txtEl)return;
  el.classList.remove("red","yellow");
  if(state==="ok"){el.classList.remove("red","yellow");}
  else if(state==="warn"){el.classList.add("yellow");}
  else{el.classList.add("red");}
  txtEl.textContent=state==="ok"?"Online":state==="warn"?"Sync...":"Offline";
}

/* base58 util */
function b58encode(bytes){
  if(!bytes||!bytes.length)return"";
  let d=[0];
  for(let i=0;i<bytes.length;i++){
    let c=bytes[i];
    for(let j=0;j<d.length;j++){
      let x=d[j]*256+c;
      d[j]=x%58;
      c=(x/58)|0;
    }
    while(c>0){d.push(c%58);c=(c/58)|0;}
  }
  let z=0;
  while(z<bytes.length&&bytes[z]===0)z++;
  let r="";
  for(let i=0;i<z;i++)r+="1";
  for(let i=d.length-1;i>=0;i--)r+=ALPH[d[i]];
  return r;
}
function b58decode(str){
  if(!str)return new Uint8Array(0);
  let b=[0];
  for(let i=0;i<str.length;i++){
    let c=ALPH.indexOf(str[i]);
    if(c<0)throw Error("base58 invalide");
    for(let j=0;j<b.length;j++){
      let x=b[j]*58+c;
      b[j]=x&255;
      c=x>>8;
    }
    while(c>0){b.push(c&255);c>>=8;}
  }
  let z=0;
  while(z<str.length&&str[z]==="1")z++;
  let r=new Uint8Array(z+b.length);
  for(let i=0;i<b.length;i++)r[r.length-1-i]=b[i];
  return r;
}

/* fetch JSON avec mesure de latence */
async function jget(path){
  const t0=performance.now();
  const r=await fetch(API+path);
  const t1=performance.now();
  const lat=q("#latency");
  if(lat)lat.textContent="Latency: "+(t1-t0).toFixed(0)+" ms";
  if(!r.ok)throw Error("HTTP "+r.status);
  return r.json();
}

/* WS */
function connectWS(){
  try{
    sock=new WebSocket(WS_URL);
    sock.onopen=()=>{
      log("WS connecté");
      setDot(q("#dotWs"),q("#txtWs"),"ok");
    };
    sock.onclose=()=>{
      setDot(q("#dotWs"),q("#txtWs"),"red");
      setTimeout(connectWS,1500);
    };
    sock.onerror=()=>{
      setDot(q("#dotWs"),q("#txtWs"),"red");
    };
    sock.onmessage=ev=>{
      try{
        const msg=JSON.parse(ev.data);
        if(msg.type==="block"){
          q("#netHeight").textContent=msg.height||q("#netHeight").textContent;
        }
      }catch(e){}
    };
  }catch(e){
    log("WS ERR "+e.message);
  }
}
connectWS();

/* stats réseau */
async function refreshNet(){
  try{
    const s=await jget("/stats");
    setDot(q("#dotApi"),q("#txtApi"),"ok");
    q("#netHeight").textContent=s.height||0;
    q("#lpPow").textContent=fmtFire(s.lpPow||0);
    q("#lpUsdc").textContent=fmtFire(s.lpUsdc||0);
    const price = (s.lpPow&&s.lpUsdc)?(s.lpUsdc/s.lpPow/DEC):0;
    q("#netPrice").textContent=price.toFixed(6);
    q("#netTVL").textContent=fmtUsd((s.tvlUsdc||0))+" USDC FIRE";
    q("#netTreasury").textContent=fmtUsd((s.treasuryUsdc||0))+" USDC FIRE";
    q("#netTreasSol").textContent=(s.treasurySol||0).toFixed(4)+" SOL";
    q("#netSupply").textContent=fmtFire(s.supplyCirculante||0);
    q("#netSupplyFree").textContent=fmtFire(s.supplyDisponible||0);
    const mcSpan=q("#mcVal");
    if(mcSpan)mcSpan.textContent=( (s.supplyCirculante||0)/DEC * price ).toFixed(0)+" $";
    const netDot=q("#stateNetDot"),netTxt=q("#stateNetTxt");
    if(price>0)setDot(netDot,netTxt,"ok");else setDot(netDot,netTxt,"warn");
  }catch(e){
    log("NET ERR "+e.message);
    setDot(q("#dotApi"),q("#txtApi"),"red");
  }
}
setInterval(refreshNet,4000);
refreshNet();

/* QR */
const qr=new QRious({element:q("#qrCanvas"),value:"",size:90});

/* wallet FIRE */
async function loadWallet(){
  addrFire=q("#walletAddr").value.trim();
  privFire=q("#walletPriv").value.trim();
  if(!addrFire||!privFire){alert("Adresse + clé privée FIRE requises");return;}
  const w=await jget("/wallet/"+addrFire);
  nonceFire=w.nonce||0;
  pubFire=w.pub||addrFire;
  q("#wpow").textContent=fmtFire(w.pow||0);
  q("#wusdc").textContent=fmtFire(w.usdc||0);
  q("#wstk").textContent=fmtFire(w.staked||0);
  qr.set({
    value:addrFire||"",
    size:90
  });
  log("Wallet FIRE chargé "+addrFire);
}
q("#btnLoad").onclick=loadWallet;
q("#btnRefreshW").onclick=loadWallet;
q("#btnGen").onclick=()=>{
  try{
    const kp=nacl.sign.keyPair();
    addrFire=b58encode(kp.publicKey);
    privFire=b58encode(kp.secretKey);
    pubFire=addrFire;
    nonceFire=0;
    q("#walletAddr").value=addrFire;
    q("#walletPriv").value=privFire;
    q("#wpow").textContent="0.000000";
    q("#wusdc").textContent="0.000000";
    q("#wstk").textContent="0.000000";
    qr.set({value:addrFire,size:90});
    log("Nouveau wallet FIRE généré");

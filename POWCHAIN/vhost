});

// ---- GESTION DES COMMANDES VIA WEBSOCKET (SWAP, LP_ADD, STAKE) ----
function handleWsCommand(msg) {
  // msg: { type, from, token, amount, pow, usdc, ... }
  if (!msg || typeof msg !== "object") return;

  if (msg.type === "SWAP") {
    const addr = msg.from;
    const dir = msg.token;
    const amt = Number(msg.amount || 0);
    if (!addr || !(amt > 0)) return;

    // On réutilise la logique de /swap
    const fakeReq = { body: { addr, dir, amount: amt } };
    const fakeRes = {
      status: () => fakeRes,
      json: () => {}
    };
    app._router.handle(fakeReq, fakeRes, () => {}, "/swap", "post");
  }

  if (msg.type === "LP_ADD") {
    const addr = msg.from;
    const p = Number(msg.pow || 0);
    const u = Number(msg.usdc || 0);
    if (!addr || !(p > 0) || !(u > 0)) return;

    const fakeReq = { body: { addr, pow: p, usdc: u } };
    const fakeRes = {
      status: () => fakeRes,
      json: () => {}
    };
    app._router.handle(fakeReq, fakeRes, () => {}, "/lp/add", "post");
  }

  if (msg.type === "STAKE") {
    const addr = msg.from;
    const amt = Number(msg.amount || 0);
    if (!addr || !(amt > 0)) return;

    const fakeReq = { body: { addr, amount: amt } };
    const fakeRes = {
      status: () => fakeRes,
      json: () => {}
    };
    app._router.handle(fakeReq, fakeRes, () => {}, "/stake", "post");
  }
}

// ---- LANCEMENT HTTP + WEBSOCKET /ws ----
const server = app.listen(3000, () => {
  console.log("FIREINNERS HTTP API sur port 3000");
});

wss = new WebSocket.Server({ server, path: "/ws" });

wss.on("connection", ws => {
  console.log("WS client connecté");
  // état initial pour le client
  ws.send(JSON.stringify({ type: "mempool", mempool: state.mempool }));
  ws.send(JSON.stringify({ type: "stats", height: state.height, mempool: state.mempool.length }));

  broadcast({ type: "clients", count: wss.clients.size });

  ws.on("message", data => {
    try {
      const msg = JSON.parse(data.toString());
      handleWsCommand(msg);
    } catch (e) {
      console.error("WS message error", e.message);
    }
  });

  ws.on("close", () => {
    broadcast({ type: "clients", count: wss.clients.size });
  });
});


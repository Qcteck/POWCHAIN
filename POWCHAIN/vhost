
<!doctype html><html lang="fr"><head><meta charset="utf-8"/>
<title>AMC — BAR Dashboard</title>
<style>
body{margin:0;background:#050505;color:#0f0;font:12px monospace}
#wrap{display:flex;flex-direction:column;height:100vh}
#top{padding:6px;border-bottom:1px solid #0f03}
#bars{flex:1}
#log{height:120px;overflow:auto;border-top:1px solid #0f03;padding:4px}
canvas{width:100%;height:100%}
button{background:#020;border:1px solid #0f03;color:#0f0;padding:4px;margin-right:4px;cursor:pointer}
</style></head>

<body>
<div id="wrap">
 <div id="top">
  <button onclick="AMC.export()">Export JSON</button>
  <button onclick="AMC.reset()">Reset</button>
  <span id="status"></span>
 </div>
 <canvas id="bars"></canvas>
 <div id="log"></div>
</div>

<script>
// ================= AMC CORE =================
const AMC={
 level:0,
 methods:{},
 zones:{short:0,mid:0,long:0},
 perf:{pnl:0,errors:0},
 history:JSON.parse(localStorage.getItem("AMC_BAR")||"[]"),

 event(e){
  this.level++;
  if(e.method)this.methods[e.method]=(this.methods[e.method]||0)+1;
  this.perf.pnl+=e.pnl||0;
  if(e.error)this.perf.errors++;
  this.classify(e.method);
  this.log(e);
  this.save();
 },

 classify(m){
  if(["QuickWins","5S","Pareto","DailyReview"].includes(m))this.zones.short++;
  else if(["Lean","Kaizen","PDCA","TOC","Agile","OKR"].includes(m))this.zones.mid++;
  else this.zones.long++;
 },

 log(e){
  const l=document.getElementById("log");
  l.textContent+=`[${new Date().toLocaleTimeString()}] ${e.method||"EVENT"} pnl:${e.pnl||0}\n`;
  l.scrollTop=1e9;
 },

 save(){
  this.history.push({
   t:Date.now(),
   level:this.level,
   zones:{...this.zones},
   perf:{...this.perf}
  });
  localStorage.setItem("AMC_BAR",JSON.stringify(this.history.slice(-300)));
 },

 export(){
  const a=document.createElement("a");
  a.href=URL.createObjectURL(new Blob(
   [JSON.stringify({level:this.level,methods:this.methods,zones:this.zones,perf:this.perf},null,2)],
   {type:"application/json"}
  ));
  a.download="AMC_BAR_export.json";a.click();
 },

 reset(){
  localStorage.removeItem("AMC_BAR");location.reload();
 }
};

// ============== DEMO EVENTS (REMPLACER PAR VRAIS) ==============
setInterval(()=>{
 const m=["Lean","Kaizen","QuickWins","TOC","Pareto","OKR","ISO9001"][Math.random()*7|0];
 AMC.event({method:m,pnl:(Math.random()-.35)*4,error:Math.random()<.1});
},1200);

// ================= BAR CANVAS =================
const c=document.getElementById("bars"),ctx=c.getContext("2d");

function drawBars(){
 c.width=c.clientWidth;c.height=c.clientHeight;
 ctx.clearRect(0,0,c.width,c.height);

 const zones=[
  {k:"short",v:AMC.zones.short,col:"#0f0"},
  {k:"mid",v:AMC.zones.mid,col:"#ff0"},
  {k:"long",v:AMC.zones.long,col:"#f00"}
 ];

 const max=Math.max(1,...zones.map(z=>z.v));
 const w=80,gap=60;
 zones.forEach((z,i)=>{
  const h=(z.v/max)*(c.height-60);
  const x=80+i*(w+gap);
  ctx.fillStyle=z.col;
  ctx.fillRect(x,c.height-h-40,w,h);
  ctx.fillStyle="#9f9";
  ctx.fillText(z.k.toUpperCase(),x,c.height-20);
  ctx.fillText(z.v,x+25,c.height-h-50);
 });

 // méthodes
 let x=360;
 Object.entries(AMC.methods).forEach(([m,v])=>{
  const h=(v/max)*(c.height-80);
  ctx.fillStyle="#0af";
  ctx.fillRect(x,c.height-h-40,14,h);
  ctx.save();
  ctx.translate(x+7,c.height-10);
  ctx.rotate(-Math.PI/2);
  ctx.fillText(m,0,0);
  ctx.restore();
  x+=22;
 });
 requestAnimationFrame(drawBars);
}
drawBars();

// ================= STATUS =================
setInterval(()=>{
 document.getElementById("status").textContent=
 `LEVEL:${AMC.level} | PNL:${AMC.perf.pnl.toFixed(2)} | ERR:${AMC.perf.errors}`;
},500);
</script>
</body></html>











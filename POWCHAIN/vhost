<script>
(() => {
  const API = location.origin;                       // IMPORTANT: plus de localhost
  const WS_URL = (location.protocol === "https:" ?   // IMPORTANT: WS via domaine
    "wss://" : "ws://") + location.host + "/ws";

  const q = s => document.querySelector(s);
  const qa = s => document.querySelectorAll(s);

  let visitors = Math.floor(Math.random()*900)+100;
  let ws;
  let fireWallet = { addr:"", priv:"" };

  function log(msg){
    const box = q("#logBox");
    const t = new Date().toISOString().substr(11,8);
    box.textContent += `[${t}] ${msg}\n`;
    box.scrollTop = box.scrollHeight;
  }

  function formatAmt(x,dec=6){
    if(!Number.isFinite(x)) return "0";
    return (x).toFixed(dec);
  }

  // ---------- NAV ----------
  function setPage(page){
    qa("section.page").forEach(s=>s.classList.remove("active"));
    q("#page-"+page).classList.add("active");
    qa(".navBtn").forEach(b=>{
      b.classList.toggle("active",b.dataset.page===page);
    });
  }
  qa(".navBtn").forEach(btn=>{
    btn.addEventListener("click",()=>setPage(btn.dataset.page));
  });

  // ---------- MODE LIGHT/DARK ----------
  q("#modeToggle").addEventListener("click",()=>{
    document.body.classList.toggle("light");
    q("#modeLabel").textContent = document.body.classList.contains("light") ? "Light" : "Dark";
  });

  // ---------- STATS ----------
  async function refreshStats(){
    try{
      const r = await fetch(API+"/stats",{cache:"no-store"});
      const j = await r.json();
      q("#statHeight").textContent = j.height;
      q("#statWallets").textContent = j.wallets;
      q("#statTotalPow").textContent = formatAmt(j.totalPow/1e6);
      q("#statTotalStaked").textContent = formatAmt(j.totalStaked/1e6);
      q("#statTotalStaked2").textContent = formatAmt(j.totalStaked/1e6);
      q("#statLpPow").textContent = formatAmt(j.lpPow/1e6);
      q("#statLpUsdc").textContent = formatAmt(j.lpUsdc/1e6);
      q("#statSolTreasury").textContent = formatAmt(j.solTreasury,4);
      q("#statUsdcTreasury").textContent = formatAmt(j.usdcTreasury,4);
      q("#statFireTreasury").textContent = formatAmt(j.fireTreasury,4);
      q("#statDiff").textContent = j.miningDiff;
      q("#poolPow").textContent = formatAmt(j.lpPow/1e6);
      q("#poolUsdc").textContent = formatAmt(j.lpUsdc/1e6);
      log("Stats mises à jour");
    }catch(e){
      log("Stats FAIL: "+e.message);
    }
  }
  q("#btnRefreshStats").addEventListener("click",refreshStats);

  // ---------- WS ----------
  function connectWS(){
    try{
      if(ws){ws.close();}
      ws = new WebSocket(WS_URL);
      ws.onopen = ()=>{
        q("#wsBadge").classList.add("online");
        q("#wsBadge").textContent = "WS: Online";
        log("WS connecté");
      };
      ws.onclose = ()=>{
        q("#wsBadge").classList.remove("online");
        q("#wsBadge").textContent = "WS: Offline";
        log("WS déconnecté, tentative de reconnexion dans 5s");
        setTimeout(connectWS,5000);
      };
      ws.onmessage = ev=>{
        try{
          const msg = JSON.parse(ev.data);
          if(msg.type==="mempool"){
            q("#mempoolOut").textContent = JSON.stringify(msg.mempool,null,2);
          }else if(msg.type==="new_block"){
            log("Nouveau bloc #"+msg.block.height);
            refreshStats();
          }else if(msg.type==="mining"){
            log(msg.msg);
            const out = q("#mineOut");
            out.textContent += msg.msg+"\n";
            out.scrollTop = out.scrollHeight;
          }
        }catch(e){}
      };
    }catch(e){
      log("Erreur WS: "+e.message);
    }
  }

  // ---------- WALLET LOCAL ----------
  function generateFireWallet(){
    const rand = crypto.getRandomValues(new Uint8Array(32));
    const hex = Array.from(rand).map(b=>b.toString(16).padStart(2,"0")).join("");
    const addr = "441-FIRE-"+hex.slice(0,16);
    const priv = hex;
    fireWallet = {addr,priv};
    q("#fireAddr").value = addr;
    q("#firePriv").value = priv;
    log("Wallet Fireinners généré");
  }
  q("#btnGenWallet").addEventListener("click",generateFireWallet);

  async function reloadFireWallet(){
    if(!fireWallet.addr){
      log("Wallet Fireinners manquant");
      return;
    }
    try{
      const r = await fetch(API+"/wallet/"+encodeURIComponent(fireWallet.addr));
      const w = await r.json();
      q("#fireBalance").value = formatAmt(w.pow/1e6);
      q("#fireUsdcBalance").value = formatAmt(w.usdc/1e6);
      q("#fireStaked").value = formatAmt(w.staked/1e6);
      q("#fireNonce").value = w.nonce;
      log("Wallet Fireinners rafraîchi");
    }catch(e){
      log("Wallet Fireinners FAIL: "+e.message);
    }
  }
  q("#btnReloadFire").addEventListener("click",reloadFireWallet);

  // ---------- PHANTOM (lectures, pas d’envoi SOL ici) ----------
  function hasPhantom(){
    return typeof window.solana !== "undefined" && window.solana.isPhantom;
  }
  async function connectPhantom(){
    try{
      if(!hasPhantom()){
        log("Phantom non détecté");
        alert("Installe Phantom sur ce navigateur.");
        return;
      }
      const resp = await window.solana.connect();
      const addr = resp.publicKey.toString();
      q("#solAddr").value = addr;
      log("Phantom connecté: "+addr);
    }catch(e){
      log("Connect Phantom FAIL: "+e.message);
    }
  }
  async function refreshSolanaBalances(){
    try{
      if(!hasPhantom() || !q("#solAddr").value){
        log("Connecte Phantom avant de lire les soldes");
        return;
      }
      const pub = q("#solAddr").value;
      // simple balance proxy via RPC direct (lecture uniquement)
      const bodySol = {jsonrpc:"2.0",id:1,method:"getBalance",params:[pub]};
      const rSol = await fetch("https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",{
        method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(bodySol)
      });
      const jSol = await rSol.json();
      const lamports = jSol.result?.value ?? 0;
      q("#solBalance").value = formatAmt(lamports/1e9,4);

      // USDC lecture simplifiée via Solscan API libre (best effort, peut échouer)
      q("#usdcBalance").value = "—";
      log("Soldes Phantom mis à jour");
    }catch(e){
      log("Solde Phantom FAIL: "+e.message);
    }
  }
  q("#btnConnectPhantom").addEventListener("click",connectPhantom);
  q("#btnRefreshSol").addEventListener("click",refreshSolanaBalances);

  // ---------- BRIDGE ----------
  q("#btnSendBridge").addEventListener("click",async()=>{
    if(!fireWallet.addr){
      log("Génère un wallet Fireinners avant de créditer le bridge");
      alert("Génère ton wallet Fireinners (onglet Wallet) avant.");
      return;
    }
    const amt = parseFloat(q("#bridgeSolAmt").value||"0");
    const sig = q("#bridgeSig").value.trim();
    if(!(amt>0) || !sig){
      log("Bridge: montant ou signature manquants");
      alert("Indique un montant SOL et colle la signature de ta TX.");
      return;
    }
    try{
      log("Bridge: vérification on-chain en cours…");
      const r = await fetch(API+"/bridge",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({addr:fireWallet.addr,amount:amt,signature:sig})
      });
      const j = await r.json();
      if(!j.ok){
        log("Bridge FAIL: "+j.error);
        alert("Bridge refusé: "+j.error);
        return;
      }
      log("Bridge OK: crédité "+j.creditedFire+" FIRE et "+j.creditedUsdc+" USDC(FIRE)");
      alert("Bridge réussi. FIRE: "+j.creditedFire+" / USDC(FIRE): "+j.creditedUsdc);
      refreshStats();
      reloadFireWallet();
    }catch(e){
      log("Bridge FAIL: "+e.message);
    }
  });

  // ---------- DEX ----------
  q("#btnDoSwap").addEventListener("click",async()=>{
    if(!fireWallet.addr){
      log("Wallet Fireinners manquant pour le swap");
      return;
    }
    const dir = q("#swapDir").value;
    const amt = parseFloat(q("#swapAmt").value||"0");
    if(!(amt>0)){
      log("Swap montant invalide");
      return;
    }
    try{
      const decAmt = Math.floor(amt*1e6);
      const r = await fetch(API+"/swap",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({addr:fireWallet.addr,dir,amount:decAmt})
      });
      const j = await r.json();
      if(!j.ok){
        log("Swap FAIL: "+j.error);
        alert("Swap refusé: "+j.error);
        return;
      }
      log("Swap OK, reçu "+formatAmt(j.received/1e6));
      refreshStats();
      reloadFireWallet();
    }catch(e){
      log("Swap FAIL: "+e.message);
    }
  });

  q("#btnAddLp").addEventListener("click",async()=>{
    if(!fireWallet.addr){
      log("Wallet Fireinners manquant pour LP");
      return;
    }
    const p = parseFloat(q("#lpPow").value||"0");
    const u = parseFloat(q("#lpUsdc").value||"0");
    if(!(p>0 && u>0)){
      log("LP montants invalides");
      return;
    }
    try{
      const r = await fetch(API+"/lp/add",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({addr:fireWallet.addr,pow:Math.floor(p*1e6),usdc:Math.floor(u*1e6)})
      });
      const j = await r.json();
      if(!j.ok){
        log("LP FAIL: "+j.error);
        alert("LP refusé: "+j.error);
        return;
      }
      log("LP ajouté à la pool");
      refreshStats();
      reloadFireWallet();
    }catch(e){
      log("LP FAIL: "+e.message);
    }
  });

  // ---------- STAKING ----------
  q("#btnStake").addEventListener("click",async()=>{
    if(!fireWallet.addr){
      log("Wallet Fireinners manquant pour le staking");
      return;
    }
    const a = parseFloat(q("#stakeAmt").value||"0");
    if(!(a>0)){
      log("Stake montant invalide");
      return;
    }
    try{
      const r = await fetch(API+"/stake",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({addr:fireWallet.addr,amount:Math.floor(a*1e6)})
      });
      const j = await r.json();
      if(!j.ok){
        log("Stake FAIL: "+j.error);
        alert("Stake refusé: "+j.error);
        return;
      }
      log("Stake OK");
      refreshStats();
      reloadFireWallet();
    }catch(e){
      log("Stake FAIL: "+e.message);
    }
  });

  // ---------- EXPLORER ----------
  q("#btnShowBlock").addEventListener("click",async()=>{
    const h = parseInt(q("#blockInp").value||"0",10);
    if(!(h>0)){
      log("Bloc invalide");
      return;
    }
    try{
      const r = await fetch(API+"/block/"+h);
      if(!r.ok){
        q("#blockOut").textContent = "Bloc introuvable";
        return;
      }
      const j = await r.json();
      q("#blockOut").textContent = JSON.stringify(j,null,2);
    }catch(e){
      q("#blockOut").textContent = "Erreur: "+e.message;
    }
  });

  // ---------- MINING ----------
  q("#btnTestMine").addEventListener("click",async()=>{
    const addr = q("#minerAddr").value.trim() || fireWallet.addr;
    if(!addr){
      alert("Indique une adresse mineur ou génère ton wallet Fireinners.");
      return;
    }
    try{
      const r = await fetch(API+"/mine/test",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({addr})
      });
      const j = await r.json();
      if(!j.ok){
        q("#mineOut").textContent = "Erreur: "+j.error;
        return;
      }
      q("#mineOut").textContent =
        "found="+j.found+"\n"+
        "diff="+j.diff+"\n"+
        "reward="+j.reward+" FIRE\n"+
        "hashrate="+j.hashrate+"\n";
      refreshStats();
      reloadFireWallet();
    }catch(e){
      q("#mineOut").textContent = "Erreur: "+e.message;
    }
  });

  // ---------- PRIX ----------
  async function loadPrices(){
    try{
      const url = "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd";
      const r = await fetch(url);
      const j = await r.json();
      const btc = j.bitcoin?.usd ?? 0;
      const eth = j.ethereum?.usd ?? 0;
      const sol = j.solana?.usd ?? 0;
      const sui = j.sui?.usd ?? 0;
      q("#priceLine").textContent =
        "BTC "+btc.toFixed(0)+" $  •  "+
        "ETH "+eth.toFixed(0)+" $  •  "+
        "SOL "+sol.toFixed(2)+" $  •  "+
        "SUI "+sui.toFixed(2)+" $";
    }catch(e){
      q("#priceLine").textContent = "Impossible de charger les prix (API CoinGecko).";
    }
  }

  // ---------- NEWS (best effort, texte statique si CORS) ----------
  async function loadNews(){
    try{
      const resp = await fetch("https://min-api.cryptocompare.com/data/v2/news/?lang=FR");
      const j = await resp.json();
      const list = (j.Data||[]).slice(0,6).map(n=>n.title);
      if(list.length){
        q("#newsLine").textContent = list.join(" • ");
      }else{
        throw new Error("Empty");
      }
    }catch(e){
      q("#newsLine").textContent = "News crypto : BTC, ETH, SOL, DeFi, NFT, macro…";
    }
  }

  // ---------- INIT ----------
  window.addEventListener("DOMContentLoaded",()=>{
    visitors++;
    q("#visCount").textContent = visitors;
    log("Interface Fireinners chargée");
    connectWS();
    refreshStats();
    loadPrices();
    loadNews();
  });
})();
</script>
</body>
</html>






nano /etc/nginx/sites-available/bbqfinance

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    access_log /var/log/nginx/bbqfinance.access.log;
    error_log  /var/log/nginx/bbqfinance.error.log;

    # Page principale POWCHAIN (index.html)
    location = / {
        try_files /index.html =404;
    }

    # Fichiers statiques éventuels (css/js/img)
    location / {
        try_files $uri /index.html;
    }

    # API HTTP POWCHAIN → Node.js (port 3000)
    location /stats {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /tx {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Bridge SOL → POWCHAIN
    location /bridge {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket POWCHAIN (port 7001)
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

nginx -t

sudo systemctl restart nginx


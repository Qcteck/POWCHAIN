#!/usr/bin/env bash
set -e

DOMAIN="bbqfinance.fun"
WEBROOT="/var/www/html"

echo "=== 1) MAJ paquets de base ==="
apt update

echo "=== 2) Installer dépendances système de base ==="
apt install -y curl nginx ufw certbot python3-certbot-nginx build-essential

echo "=== 3) Installer Node.js 18 via NodeSource (avec npm) ==="
curl -fsSL https://deb.nodesource.com/setup_18.x | bash -
apt install -y nodejs
npm install -g pm2

echo "node : $(node -v)"
echo "npm  : $(npm -v)"

echo "=== 4) Créer /var/www/html et index.html ==="
mkdir -p "$WEBROOT"


<!-- Librairies -->
<script src="https://cdn.jsdelivr.net/npm/tweetnacl/nacl.min.js"></script>
<script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
<script>
/* ======================= CONFIG GLOBALE ========================= */
const DEC = 1e6;
const ALPH = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
let addr = null, priv = null, pub = null, nonce = 0;
let sock = null;

/* Solana config */
const SOL_RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT = new solanaWeb3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");
const TOKEN_PROGRAM_ID = new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA");

/* ======================= UTILITAIRES UI =========================*/
const $ = s => document.querySelector(s);
function log(msg){
  const box = $("#log");
  if(!box) return;
  const time = new Date().toLocaleTimeString();
  box.textContent = `[${time}] ${msg}\n` + box.textContent;
}
function fmtPow(n){return (n/DEC).toFixed(6);}
function setSync(status,text){
  $("#syncText").textContent = status;
  $("#syncChipText").textContent = text;
}

/* ======================= API HTTP POWCHAIN ====================== */
async function api(path, opts){
  const t0 = performance.now();
  const res = await fetch(path, opts || {});
  const t1 = performance.now();
  const lat = $("#latency");
  if(lat) lat.textContent = "Latency: " + (t1 - t0).toFixed(0) + " ms";
  if(!res.ok) throw new Error("HTTP " + res.status);
  return res.json();
}

/* ======================= BASE58 (POWCHAIN) ====================== */
function b58encode(bytes){
  if(!bytes || !bytes.length) return "";
  let d = [0];
  for(let i=0;i<bytes.length;i++){
    let c = bytes[i];
    for(let j=0;j<d.length;j++){
      const x = d[j]*256 + c;
      d[j] = x % 58;
      c = (x/58)|0;
    }
    while(c>0){d.push(c%58);c=(c/58)|0;}
  }
  let z=0;
  while(z<bytes.length && bytes[z]===0) z++;
  let r = "";
  for(let i=0;i<z;i++) r += "1";
  for(let i=d.length-1;i>=0;i--) r += ALPH[d[i]];
  return r;
}
function b58decode(str){
  if(!str) return new Uint8Array(0);
  let b=[0];
  for(let i=0;i<str.length;i++){
    let c = ALPH.indexOf(str[i]);
    if(c<0) throw new Error("base58 invalide");
    for(let j=0;j<b.length;j++){
      const x = b[j]*58 + c;
      b[j] = x & 255;
      c = x >> 8;
    }
    while(c>0){b.push(c & 255);c >>= 8;}
  }
  let z=0;
  while(z<str.length && str[z]==="1") z++;
  const r = new Uint8Array(z + b.length);
  for(let i=0;i<b.length;i++){r[r.length-1-i]=b[i];}
  return r;
}

/* ======================= WebSocket POWCHAIN ===================== */
function connectWS(){
  try{
    const url = (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws";
    sock = new WebSocket(url);
    sock.onopen = () => {
      log("WS connecté");
      setSync("Synced","WS Online");
    };
    sock.onclose = () => {
      log("Client WebSocket déconnecté");
      setSync("Reconnecting","WS…");
      setTimeout(connectWS,1500);
    };
    sock.onerror = (e) => {
      log("WS erreur: " + e.message);
      setSync("Error","WS Error");
    };
    sock.onmessage = ev => {
      try{
        const msg = JSON.parse(ev.data);
        if(msg.type === "STATE"){
          updateWalletState(msg.wallet);
        }
        if(msg.type === "NEW_BLOCK"){
          log("Nouveau bloc " + msg.block.height + " (" + (msg.block.txs||[]).length + " tx)");
        }
      }catch(e){
        log("WS message brut: " + ev.data);
      }
    };
  }catch(e){
    log("WS init erreur: " + e.message);
  }
}
connectWS();

/* ======================= STATS RÉSEAU =========================== */
async function refreshNet(){
  try{
    const s = await api("/stats");
    const height = s.height || 0;
    $("#netHeight").textContent = height;
    $("#lpPow").textContent = fmtPow(s.lpPow || 0);
    $("#lpUsdc").textContent = fmtPow(s.lpUsdc || 0);
    $("#netPrice").textContent = (s.lpPow && s.lpUsdc ? (s.lpUsdc/s.lpPow/DEC).toFixed(6) : "0.000000");
    $("#netTVL").textContent = ((s.lpUsdc||0)/DEC).toFixed(2) + " USDC POW";
    $("#netTreasury").textContent =
      ((s.treasuryUsdc||0)/DEC).toFixed(2) + " USDC POW · " +
      (s.treasurySol||0).toFixed(3) + " SOL";
  }catch(e){
    log("NET ERR " + e.message);
  }
}
setInterval(refreshNet,4000);
refreshNet();

/* ======================= WALLET POWCHAIN ======================== */
function updateWalletState(w){
  if(!w) return;
  $("#wpow").textContent  = fmtPow(w.pow   || 0);
  $("#wusdc").textContent = fmtPow(w.usdc  || 0);
  $("#wstk").textContent  = fmtPow(w.staked|| 0);
  nonce = w.nonce || 0;
}

async function loadWallet(){
  addr = $("#walletAddr").value.trim();
  priv = $("#walletPriv").value.trim();
  if(!addr || !priv){
    alert("Adresse + clé privée POWCHAIN requises");
    return;
  }
  try{
    const w = await api("/wallet/" + encodeURIComponent(addr));
    pub = w.pub || addr;
    updateWalletState(w);
    log("Wallet chargé " + addr);
  }catch(e){
    log("WALLET ERR " + e.message);
    alert("Erreur wallet: " + e.message);
  }
}

$("#btnLoad").onclick = loadWallet;
$("#btnRefreshW").onclick = loadWallet;

$("#btnGen").onclick = () => {
  try{
    const kp = nacl.sign.keyPair();
    addr = b58encode(kp.publicKey);
    priv = b58encode(kp.secretKey);
    pub = addr;
    nonce = 0;
    $("#walletAddr").value = addr;
    $("#walletPriv").value = priv;
    $("#wpow").textContent = "0.000000";
    $("#wusdc").textContent = "0.000000";
    $("#wstk").textContent = "0.000000";
    log("Nouveau wallet généré — sauvegarde ta clé privée !");
  }catch(e){
    log("GEN ERR " + e.message);
    alert("Erreur génération wallet: " + e.message);
  }
};

function signTx(obj){
  if(!addr || !priv) throw new Error("Wallet POWCHAIN non connecté");
  const payload = {
    type: obj.type,
    from: obj.from || addr,
    to: obj.to ?? null,
    amount: obj.amount ?? null,
    token: obj.token ?? null,
    nonce: nonce + 1
  };
  const msg = new TextEncoder().encode(JSON.stringify(payload));
  const sk  = b58decode(priv);
  const sig = nacl.sign.detached(msg, sk);
  return b58encode(sig);
}


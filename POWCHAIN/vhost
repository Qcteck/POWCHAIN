window.FI_phantom = {};
const logP = t => document.getElementById("log").innerHTML += t + "\n";

FI_phantom.connect = async () => {
  try{
    const resp = await window.phantom.solana.connect();
    solAddr.value = resp.publicKey.toString();
    logP("Phantom connecté : "+solAddr.value);
    FI_phantom.refresh();
  }catch(e){ alert("Erreur Phantom : "+e); }
};

FI_phantom.refresh = async () => {
  try{
    const c = new solanaWeb3.Connection("https://api.mainnet-beta.solana.com");
    const pub = new solanaWeb3.PublicKey(solAddr.value);
    const bal = await c.getBalance(pub);
    solBal.textContent = (bal/1e9).toFixed(6);
    logP("SOL = "+solBal.textContent);
  }catch(e){ logP("Erreur refresh Solana : "+e); }
};




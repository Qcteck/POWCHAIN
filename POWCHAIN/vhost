// Mining test (simple hash loop)
function mlog(t){
  const el=q("#miningLog");
  if(!el)return;
  el.textContent=`[${new Date().toLocaleTimeString()}] ${t}\n`+el.textContent;
}
q("#btnTestMine").onclick=()=>{
  const addr=(q("#minerAddr").value||"").trim();
  if(!addr){
    mlog("Adresse de minage manquante");
    return;
  }
  let tries=0;
  const targetPrefix="0000";
  mlog("Démarrage du test mining (prefix "+targetPrefix+")…");
  const start=performance.now();
  function loop(){
    for(let i=0;i<5000;i++){
      const nonce=Math.floor(Math.random()*1e9);
      const data=addr+"|"+nonce;
      let h=0;
      for(let k=0;k<data.length;k++)h=(h*31+data.charCodeAt(k))>>>0;
      const hex=h.toString(16).padStart(8,"0");
      tries++;
      if(hex.startsWith(targetPrefix)){
        const dur=((performance.now()-start)/1000).toFixed(2);
        mlog(`Hash trouvé ${hex} après ${tries} essais en ${dur}s (nonce ${nonce})`);
        return;
      }
    }
    requestAnimationFrame(loop);
  }
  loop();
};

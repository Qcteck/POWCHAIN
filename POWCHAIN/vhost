const http = require("http");
const fs = require("fs");
const path = require("path");
const url = require("url");
const WebSocket = require("ws");

const DATA_FILE = path.join(__dirname, "chain.json");

// État POWCHAIN minimal compatible avec le Dashboard
let state = {
  height: 0,
  chain: [],
  wallets: {},
  lpPow: 0,
  lpUsdc: 0,
  treasuryUsdc: 0,
  treasurySol: 0,
  mempool: []
};

function loadState() {
  try {
    const raw = fs.readFileSync(DATA_FILE, "utf8");
    const parsed = JSON.parse(raw);
    state = { ...state, ...parsed };
    console.log(`✅ Blockchain chargée : ${state.height} blocs`);
  } catch (e) {
    console.log("ℹ️ chain.json absent ou invalide -> init vide");
    state.height = 0;
    state.chain = [];
    state.wallets = {};
    state.mempool = [];
  }
}

function saveState() {
  fs.writeFile(DATA_FILE, JSON.stringify(state, null, 2), (err) => {
    if (err) console.error("Erreur save chain.json :", err.message);
  });
}

function getWallet(addr) {
  if (!state.wallets[addr]) {
    state.wallets[addr] = { pow: 0, usdc: 0, staked: 0, nonce: 0, pub: addr };
  }
  return state.wallets[addr];
}

function json(res, code, body) {
  res.writeHead(code, {
    "Content-Type": "application/json",
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Headers": "Content-Type",
    "Access-Control-Allow-Methods": "GET,POST,OPTIONS"
  });
  res.end(JSON.stringify(body));
}

function notFound(res) {
  res.writeHead(404, { "Content-Type": "application/json" });
  res.end(JSON.stringify({ error: "not found" }));
}

const api = http.createServer((req, res) => {
  const parsed = url.parse(req.url, true);
  const p = parsed.pathname;

  if (req.method === "OPTIONS") {
    res.writeHead(200, {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Headers": "Content-Type",
      "Access-Control-Allow-Methods": "GET,POST,OPTIONS"
    });
    return res.end();
  }

  if (req.method === "GET" && p === "/stats") {
    return json(res, 200, {
      height: state.height,
      lpPow: state.lpPow,
      lpUsdc: state.lpUsdc,
      treasuryUsdc: state.treasuryUsdc,
      treasurySol: state.treasurySol
    });
  }

  if (req.method === "GET" && p.startsWith("/wallet/")) {
    const addr = decodeURIComponent(p.split("/")[2] || "");
    if (!addr) return json(res, 400, { error: "addr required" });
    const w = getWallet(addr);
    return json(res, 200, w);
  }

  if (req.method === "GET" && p.startsWith("/block/")) {
    const h = parseInt(p.split("/")[2] || "0", 10);
    const b = state.chain.find((b) => b.height === h);
    if (!b) return json(res, 404, { error: "block not found" });
    return json(res, 200, b);
  }

  if (req.method === "GET" && p === "/chain") {
    const last = state.chain.slice(-30);
    return json(res, 200, last);
  }

  if (req.method === "POST" && p === "/tx") {
    let body = "";
    req.on("data", (c) => (body += c));
    req.on("end", () => {
      try {
        const tx = JSON.parse(body || "{}");
        console.log(
          "TX reçue",
          tx.type,
          tx.from,
          "→",
          tx.to,
          "montant",
          tx.amount
        );
        state.mempool.push(tx);
        saveState();
        broadcast({ type: "tx", tx });
        json(res, 200, { ok: true });
      } catch (e) {
        json(res, 400, { error: "bad json", msg: e.message });
      }
    });
    return;
  }

  return notFound(res);
});

const PORT = 3000;
api.listen(PORT, () => {
  console.log(
    `✅ HTTP API POWCHAIN en ligne sur port ${PORT} (/stats /wallet /block /chain /tx)`
  );
});

// WebSocket POWCHAIN sur 7001
const wsServer = http.createServer();
const WSPORT = 7001;
const wss = new WebSocket.Server({ server: wsServer });

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  wss.clients.forEach((c) => {
    if (c.readyState === WebSocket.OPEN) c.send(msg);
  });
}

wss.on("connection", (ws) => {
  console.log("🔌 Client WebSocket connecté");
  ws.on("close", () => console.log("🔌 Client WebSocket déconnecté"));
});

wsServer.listen(WSPORT, () => {
  console.log(`📡 WebSocket POWCHAIN en ligne sur port ${WSPORT} (/ws)`);
});

// Charger l'état au démarrage
loadState();






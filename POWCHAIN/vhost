  const bridgeAmount=document.getElementById("bridgeAmount");

  const RPC_URL="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
  const FIRE_USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
  const connection=new solanaWeb3.Connection(RPC_URL,"confirmed");
  let solPubkey=null;

  async function refreshSolana(){
    if(!solPubkey)return;
    try{
      const lamports=await connection.getBalance(solPubkey);
      solBalanceEl.textContent=(lamports/1e9).toFixed(4);
    }catch(e){
      log("ERR","SOL balance → "+e.message,true);
    }
    try{
      const tokenAccounts=await connection.getParsedTokenAccountsByOwner(solPubkey,{mint:new solanaWeb3.PublicKey(FIRE_USDC_MINT)});
      let total=0;
      for(const a of tokenAccounts.value){
        const ui=a.account.data.parsed.info.tokenAmount.uiAmount||0;
        total+=ui;
      }
      usdcBalanceEl.textContent=total.toFixed(2);
    }catch(e){
      log("ERR","USDC balance → "+e.message,true);
    }
  }

  btnConnect.onclick=async()=>{
    try{
      if(!window.solana||!window.solana.isPhantom){
        alert("Phantom n'est pas détecté dans ce navigateur.");
        return;
      }
      const r=await window.solana.connect();
      solPubkey=new solanaWeb3.PublicKey(r.publicKey.toString());
      solAddr.textContent=solPubkey.toString();
      log("SYS","Phantom connecté");
      await refreshSolana();
    }catch(e){
      log("ERR","Connexion Phantom refusée",true);
    }
  };
  btnRefresh.onclick=refreshSolana;

  // Bridge (simulation backend)
  btnBridge.onclick=async()=>{
    const amt=parseFloat(bridgeAmount.value);
    if(!solPubkey){alert("Connecte Phantom d'abord.");return;}
    if(!amt||amt<=0){alert("Montant SOL invalide.");return;}
    btnBridge.disabled=true;
    try{
      // Ici on ne fait qu'un appel backend de preuve de bridge.
      const res=await fetch("/bridge/sol",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({from:solPubkey.toString(),amountSol:amt,signature:null})
      });
      if(!res.ok)throw new Error("HTTP "+res.status);
      const j=await res.json();
      log("SYS","Bridge SOL→FIREINNERS accepté id="+j.id);
      fetchStats();
    }catch(e){
      log("ERR","Bridge SOL→FIREINNERS → "+e.message,true);
    }finally{
      btnBridge.disabled=false;
    }
  };

  // Add LP
  document.getElementById("btnAddLp").onclick=async()=>{
    const fire=parseFloat(document.getElementById("lpFire").value)||0;
    const usdc=parseFloat(document.getElementById("lpUsdc").value)||0;
    if(fire<=0||usdc<=0){alert("Montants invalides.");return;}
    try{
      const r=await fetch("/lp/add",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({fire,usdc})
      });
      if(!r.ok)throw new Error("HTTP "+r.status);
      const j=await r.json();
      log("SYS","LP ajouté, pool FIRE="+j.lpFire+" USDC="+j.lpUsdc);
      fetchStats();
    }catch(e){
      log("ERR","LP add → "+e.message,true);
    }
  };

})();
</script>
</body>
</html>
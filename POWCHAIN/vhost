sudo nano /etc/nginx/sites-available/bbqfinance.conf

server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    location /.well-known/acme-challenge/ {
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bbqfinance.fun www.bbqfinance.fun;

    root /var/www/html;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;

    # ----------- WEBSOCKET /ws → Node 3000 -----------
    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # ----------- API FIREINNERS → Node 3000 -----------
    location /bridge {
        proxy_pass http://127.0.0.1:3000;
    }

    location /stats {
        proxy_pass http://127.0.0.1:3000;
    }

    location /mempool {
        proxy_pass http://127.0.0.1:3000;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000;
    }

    location /chain {
        proxy_pass http://127.0.0.1:3000;
    }

    # ----------- FRONTEND HTML -----------
    location / {
        try_files $uri /index.html;
    }
}


sudo nginx -t
sudo systemctl reload nginx


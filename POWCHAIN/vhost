#!/bin/bash

echo "=== Fireinners VPS Check ==="

echo ""
echo "[1] Test configuration Nginx..."
sudo nginx -t
echo ""

echo "[2] Reload Nginx..."
sudo systemctl reload nginx
echo ""

echo "[3] Status Nginx..."
sudo systemctl status nginx --no-pager
echo ""

echo "[4] Ports ouverts (80 et 3000)..."
sudo ss -tlnp | grep -E ':80|:3000'
echo ""

echo "[5] Test API locale (backend Node)..."
curl -I http://127.0.0.1:3000/stats
echo ""

echo "[6] Test API via domaine (Cloudflare + Nginx)..."
curl -I http://bbqfinance.fun/stats
echo ""

echo "[7] Status PM2..."
pm2 status
echo ""

echo "[8] Logs backend (dernières lignes)..."
pm2 logs fireinners --lines 20
echo ""

echo "=== FIN DU CHECK ==="





nano fireinners-check.sh


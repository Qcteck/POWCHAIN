// server.js - FIREINNERS / POWCHAIN Validator + API + WS

// =========================
// IMPORTS
// =========================
const express = require("express");
const bodyParser = require("body-parser");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const crypto = require("crypto");
const http = require("http");

// =========================
// CONFIG SERVEUR
// =========================
const HTTP_PORT = 3000;     // nginx proxy vers 127.0.0.1:3000
const WS_PATH   = "/ws";    // nginx location /ws

const app = express();
app.use(bodyParser.json());

const server = http.createServer(app);
const wss    = new WebSocket.Server({ server, path: WS_PATH });

const clients = new Set();

// petit logger
function L(...args) {
  console.log("[fireinners]", ...args);
}

// =========================
// CONFIG ECONOMIE FIREINNERS
// =========================

// Décimales pour FIRE / USDC_FIRE (6 décimales)
const DEC = 1e6;

// Hard cap : 100M FIRE
const SUPPLY_MAX = 100_000_000 * DEC;

// Taux dynamique FIRE / SOL (bornes)
const RATE_BASE = 1000;                // base FIRE par SOL
const TVL_REF   = 1_000_000 * DEC;     // 1M USDC FIRE de référence
const RATE_MIN  = 800;                 // min FIRE / SOL
const RATE_MAX  = 5000;                // max FIRE / SOL

// Frais en basis points (1% = 100 bp)
const FEE_TRANSFER_BURN_BP   = 50;     // 0.5% burn sur transfert FIRE
const FEE_SWAP_TOTAL_BP      = 30;     // 0.3% total fees sur swap
const FEE_SWAP_BURN_PART     = 0.5;    // 50% des fees swap brûlés
const FEE_BRIDGE_IN_TREAS_BP = 500;    // 5% vers trésorerie à l'entrée
const FEE_BRIDGE_IN_BURN_BP  = 200;    // 2% burn à l'entrée
const FEE_BRIDGE_OUT_BURN_BP = 1000;   // 10% burn sur FIRE renvoyés
const FEE_UNSTAKE_BURN_BP    = 300;    // 3% burn si unstake anticipé

// Staking
const STAKE_MIN_LOCK_MS = 30 * 24 * 60 * 60 * 1000; // 30 jours

// =========================
// ETAT GLOBAL
// =========================

// addr -> { pow, usdc, staked, pub, nonce, stakeLock }
let wallets = {};

let treasury = { pow: 0, usdc: 0, sol: 0 };
let lp       = { pow: 0, usdc: 0 };

let supplyCirculante = 0;
let mintedPowTotal   = 0;
let burnedPowTotal   = 0;

let chain   = [];
let mempool = [];

// Historique chaîné des bridges (SOL<->FIRE)
let bridgeHistory = []; // {time,dir,powAddress,solAddress,sol,netPow,feePow,txSig}

// =========================
// GENESIS
// =========================
(function initGenesis() {
  const genesisSupply = 100_000_000 * DEC;
  supplyCirculante = genesisSupply;
  mintedPowTotal   = genesisSupply;
  treasury.pow     = genesisSupply;

  const genesis = {
    height: 1,
    time: Date.now(),
    prevHash: "0".repeat(64),
    hash: "GENESIS",
    txs: [],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  };
  chain.push(genesis);
  L("Genesis initialisé, supply =", genesisSupply / DEC, "FIRE");
})();

// =========================
// OUTILS GENERAUX
// =========================
function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = {
      pow: 0,
      usdc: 0,
      staked: 0,
      pub: addr,
      nonce: 0,
      stakeLock: 0
    };
  }
  return wallets[addr];
}

function clamp(x, min, max) {
  return x < min ? min : x > max ? max : x;
}

// TVL en USDC FIRE: LP + trésorerie
function getTVL() {
  const lpUsdc = lp.usdc || 0;
  const treUsdc = treasury.usdc || 0;
  return lpUsdc + treUsdc;
}

// Taux dynamique FIRE / SOL borné
function getPowRatePowPerSol() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || DEC);
  const rawRate = RATE_BASE * factor;
  const rate = clamp(rawRate, RATE_MIN, RATE_MAX);
  return rate;
}

function burnPow(amount) {
  if (!amount || amount <= 0) return 0;
  const actual = Math.min(amount, supplyCirculante);
  burnedPowTotal += actual;
  supplyCirculante -= actual;
  return actual;
}

function mintPow(amount) {
  if (!amount || amount <= 0) return 0;
  const spaceLeft = SUPPLY_MAX - supplyCirculante;
  const mintable = Math.max(0, Math.min(amount, spaceLeft));
  mintedPowTotal += mintable;
  supplyCirculante += mintable;
  return mintable;
}

function addPowToWallet(addr, amount) {
  const w = ensureWallet(addr);
  w.pow += amount;
}

function subPowFromWallet(addr, amount) {
  const w = ensureWallet(addr);
  if (w.pow < amount) throw new Error("Solde FIRE insuffisant");
  w.pow -= amount;
}

function addUsdcToWallet(addr, amount) {
  const w = ensureWallet(addr);
  w.usdc += amount;
}

function subUsdcFromWallet(addr, amount) {
  const w = ensureWallet(addr);
  if (w.usdc < amount) throw new Error("Solde USDC FIRE insuffisant");
  w.usdc -= amount;
}

function applyBp(amount, bp) {
  return Math.floor((amount * bp) / 10000);
}

// Prix LP (microUSDC / microFIRE)
function getLpPrice() {
  if (lp.pow <= 0 || lp.usdc <= 0) return 0;
  return lp.usdc / lp.pow;
}

// =========================
// SIGNATURES & MEMPOOL
// =========================

// message utilisé pour la signature (même schéma que le client)
function buildMsgForSig(tx) {
  return JSON.stringify({
    type: tx.type,
    from: tx.from,
    to: tx.to || null,
    amount: tx.amount || null,
    token: tx.token || null,
    nonce: tx.nonce
  });
}

function verifyTxSignature(tx) {
  if (!tx.sig || !tx.pub) {
    throw new Error("Signature ou pubkey absente");
  }
  const msg = new TextEncoder().encode(buildMsgForSig(tx));
  const sig = bs58.decode(tx.sig);
  const pub = bs58.decode(tx.pub);
  const ok = nacl.sign.detached.verify(msg, sig, pub);
  if (!ok) throw new Error("Signature invalide");
}

function pushToMempool(resultTx) {
  mempool.push(resultTx);
}

// Création d'un bloc simple dès qu'on reçoit des TX "validées"
function forgeBlockIfNeeded() {
  if (mempool.length === 0) return;
  const height = chain.length + 1;
  const prevHash = chain[chain.length - 1].hash;
  const time = Date.now();
  const txData = JSON.stringify(mempool);
  const hash = crypto
    .createHash("sha256")
    .update(prevHash + time + txData)
    .digest("hex");

  const block = {
    height,
    time,
    prevHash,
    hash,
    txs: mempool,
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp }
  };
  chain.push(block);
  mempool = [];
  L("⛓ Nouveau bloc forgé, height =", height);

  broadcast({ type: "NEW_BLOCK", block });
}

// =========================
// HANDLERS ECONOMIQUES
// =========================

// 1) TRANSFERT FIRE
function processPowTransfer(tx) {
  if (!tx.from || !tx.to) throw new Error("from/to manquant");
  if (!tx.amount || tx.amount <= 0) throw new Error("amount invalide");

  const gross = tx.amount;
  const feeBurn = applyBp(gross, FEE_TRANSFER_BURN_BP);
  const sendAmount = gross - feeBurn;
  if (sendAmount <= 0) throw new Error("montant après burn insuffisant");

  subPowFromWallet(tx.from, gross);
  addPowToWallet(tx.to, sendAmount);
  burnPow(feeBurn);

  return {
    type: "TX_POW",
    from: tx.from,
    to: tx.to,
    gross,
    sendAmount,
    burned: feeBurn
  };
}

// 2) SWAP FIRE / USDC FIRE
function processSwap(tx) {
  const { addr, amount, token } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");
  if (!lp.pow || !lp.usdc) throw new Error("pool LP vide");
  if (token !== "pow2usdc" && token !== "usdc2pow") {
    throw new Error("direction swap invalide");
  }

  const feeTotal = applyBp(amount, FEE_SWAP_TOTAL_BP);
  const amountNet = amount - feeTotal;
  if (amountNet <= 0) throw new Error("amount net swap invalide");

  const feeBurn = Math.floor(feeTotal * FEE_SWAP_BURN_PART);
  const feeTreas = feeTotal - feeBurn;

  if (token === "pow2usdc") {
    subPowFromWallet(addr, amount);
    lp.pow += amountNet;

    const k = lp.pow * lp.usdc;
    const newPow = lp.pow;
    const newUsdc = Math.floor(k / newPow);
    const deltaUsdc = lp.usdc - newUsdc;
    if (deltaUsdc <= 0) throw new Error("delta usdc invalide");
    lp.usdc = newUsdc;

    addUsdcToWallet(addr, deltaUsdc);

    const burned = burnPow(feeBurn);
    treasury.pow += feeTreas;
    supplyCirculante += feeTreas;

    return {
      type: "SWAP",
      dir: "pow2usdc",
      inPow: amount,
      outUsdc: deltaUsdc,
      feeBurn: burned,
      feeTreasPow: feeTreas
    };
  } else {
    subUsdcFromWallet(addr, amount);
    lp.usdc += amountNet;

    const k = lp.pow * lp.usdc;
    const newUsdc = lp.usdc;
    const newPow = Math.floor(k / newUsdc);
    const deltaPow = lp.pow - newPow;
    if (deltaPow <= 0) throw new Error("delta pow invalide");
    lp.pow = newPow;

    addPowToWallet(addr, deltaPow);

    const burned = burnPow(feeBurn);
    treasury.usdc += feeTreas;

    return {
      type: "SWAP",
      dir: "usdc2pow",
      inUsdc: amount,
      outPow: deltaPow,
      feeBurn: burned,
      feeTreasUsdc: feeTreas
    };
  }
}

// 3) LP ADD
function processLPAdd(tx) {
  const { addr, pow, usdc } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!pow || pow <= 0 || !usdc || usdc <= 0) {
    throw new Error("valeurs LP invalides");
  }
  subPowFromWallet(addr, pow);
  subUsdcFromWallet(addr, usdc);
  lp.pow += pow;
  lp.usdc += usdc;
  return {
    type: "LP_ADD",
    addr,
    pow,
    usdc
  };
}

// 4) BRIDGE SOL -> FIREINNERS (entrée)
function processBridgeIn(addr, solAmount) {
  if (!addr) throw new Error("addr manquant");
  if (!solAmount || solAmount <= 0) throw new Error("solAmount invalide");

  const rate = getPowRatePowPerSol();
  const powBrut = Math.floor(solAmount * rate * DEC);

  const powToMint = mintPow(powBrut);
  if (powToMint <= 0) throw new Error("supply max atteint");

  const feeTreas = applyBp(powToMint, FEE_BRIDGE_IN_TREAS_BP);
  const feeBurn = applyBp(powToMint, FEE_BRIDGE_IN_BURN_BP);
  const userPow = powToMint - feeTreas - feeBurn;
  if (userPow <= 0) throw new Error("bridge in net <= 0");

  treasury.pow += feeTreas;
  const burned = burnPow(feeBurn);
  addPowToWallet(addr, userPow);

  treasury.sol += solAmount;

  return {
    type: "BRIDGE_IN",
    addr,
    solAmount,
    rate,
    powMinted: powToMint,
    userPow,
    feeTreasPow: feeTreas,
    burnedPow: burned
  };
}

// 5) BRIDGE FIRE -> SOL (sortie)
function processBridgeOut(addr, powAmount) {
  if (!addr) throw new Error("addr manquant");
  if (!powAmount || powAmount <= 0) throw new Error("powAmount invalide");

  const rate = getPowRatePowPerSol();

  subPowFromWallet(addr, powAmount);

  const feeBurn = applyBp(powAmount, FEE_BRIDGE_OUT_BURN_BP);
  const powNet = powAmount - feeBurn;
  if (powNet <= 0) throw new Error("bridge out net <= 0");

  const burned = burnPow(powAmount);

  const solOut = powNet / (rate * DEC);
  if (treasury.sol < solOut) {
    throw new Error("SOL trésorerie insuffisant pour bridge out");
  }
  treasury.sol -= solOut;

  return {
    type: "BRIDGE_OUT",
    addr,
    powSent: powAmount,
    powNet,
    burnedPow: burned,
    rate,
    solOut
  };
}

// 6) STAKING
function processStake(tx) {
  const { addr, amount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");

  const w = ensureWallet(addr);
  if (w.pow < amount) throw new Error("solde FIRE insuffisant");

  w.pow -= amount;
  w.staked += amount;
  w.stakeLock = Date.now() + STAKE_MIN_LOCK_MS;

  return {
    type: "STAKE",
    addr,
    amount,
    lockUntil: w.stakeLock
  };
}

function processUnstake(tx) {
  const { addr, amount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");

  const w = ensureWallet(addr);
  if (w.staked < amount) throw new Error("staked insuffisant");

  let burnFee = 0;
  if (Date.now() < (w.stakeLock || 0)) {
    burnFee = applyBp(amount, FEE_UNSTAKE_BURN_BP);
  }
  const backToWallet = amount - burnFee;
  w.staked -= amount;
  w.pow += backToWallet;
  burnPow(burnFee);

  return {
    type: "UNSTAKE",
    addr,
    amount,
    backToWallet,
    burned: burnFee
  };
}

// =========================
// WEBSOCKET
// =========================
wss.on("connection", (ws) => {
  clients.add(ws);
  L("WS client connecté, total =", clients.size);
  ws.on("close", () => {
    clients.delete(ws);
    L("WS client déconnecté, total =", clients.size);
  });
});

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  for (const ws of clients) {
    try {
      ws.send(msg);
    } catch (e) {
      // ignore
    }
  }
}


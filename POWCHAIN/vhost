  <script>
    const q = s => document.querySelector(s);
    const API = location.origin;
    const WS_URL = (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws";
    let ws = null;
    let statsTimer = null;
    let visitors = 0;

    function log(msg,type="info"){
      const el = q("#console");
      if(!el) return;
      const t = new Date().toLocaleTimeString("fr-CA",{hour12:false});
      const spanTime = `<span class="time">[${t}]</span>`;
      let cls = "";
      if(type==="ok") cls="ok";
      else if(type==="err") cls="err";
      else if(type==="ws") cls="ws";
      const spanMsg = `<span class="${cls}">${msg}</span>`;
      el.innerHTML = spanTime+" "+spanMsg+"<br/>"+el.innerHTML;
    }

    function setWS(status){
      const b = q("#wsBadge");
      if(!b) return;
      if(status){
        b.classList.add("online");
        b.innerHTML = "<span>Online</span>";
      }else{
        b.classList.remove("online");
        b.innerHTML = "<span>Offline</span>";
      }
    }

    function connectWS(){
      try{
        if(ws){ws.close();}
        ws = new WebSocket(WS_URL);
        ws.onopen = ()=>{ setWS(true); log("WS connecté "+WS_URL,"ws"); };
        ws.onclose = ()=>{ setWS(false); log("WS fermé – reconnexion dans 3s","ws"); setTimeout(connectWS,3000); };
        ws.onerror = ()=>{ setWS(false); log("Erreur WebSocket","err"); };
        ws.onmessage = ev=>{
          try{
            const data = JSON.parse(ev.data);
            if(data.type==="mempool" && q("#mempoolOut")){
              const ta = q("#mempoolOut");
              ta.value = JSON.stringify(data, null, 2) + "\n" + ta.value;
            }
            if(data.type==="statsUpdate"){ applyStats(data.stats); }
          }catch(e){
            log("WS msg: "+ev.data,"ws");
          }
        };
      }catch(e){
        log("WS fail: "+e.message,"err");
      }
    }

    async function fetchJSON(url,opts){
      const r = await fetch(url,opts);
      if(!r.ok) throw new Error("HTTP "+r.status);
      return await r.json();
    }

    function applyStats(s){
      if(!s) return;
      q("#statHeight").textContent = s.height ?? "-";
      q("#statWallets").textContent = s.wallets ?? "-";
      q("#statPow").textContent = (s.totalPow ?? 0).toFixed ? (s.totalPow).toFixed(4) : s.totalPow;
      q("#statUsdc").textContent = (s.usdcTreasury ?? 0).toString();
      q("#mainSubtitle").textContent = "Hauteur "+(s.height ?? "-")+" • Wallets "+(s.wallets ?? "-");
      q("#sHeight").textContent = s.height ?? "-";
      q("#sWallets").textContent = s.wallets ?? "-";
      q("#sMempool").textContent = s.mempool ?? "-";
      q("#sTotalPow").textContent = s.totalPow ?? "-";
      q("#sTotalStaked").textContent = s.totalStaked ?? "-";
      q("#sLpPow").textContent = s.lpPow ?? "-";
      q("#sLpUsdc").textContent = s.lpUsdc ?? "-";
      q("#sSolTreasury").textContent = s.solTreasury ?? "-";
      q("#sUsdcTreasury").textContent = s.usdcTreasury ?? "-";
      q("#sFireTreasury").textContent = s.fireTreasury ?? "-";
      if(typeof s.priceFire === "number"){
        q("#pFIRE").textContent = s.priceFire.toFixed(6)+" $";
      }
      if(typeof s.miningDiff === "number"){
        q("#miningDiff").textContent = s.miningDiff;
      }
    }

    async function refreshStats(){
      try{
        const s = await fetchJSON(API+"/stats");
        applyStats(s);
        log("Stats mises à jour","ok");
      }catch(e){
        log("Stats FAIL: "+e.message,"err");
      }
    }

    function startStatsLoop(){
      if(statsTimer) clearInterval(statsTimer);
      statsTimer = setInterval(refreshStats, 15000);
    }

    async function loadPrices(){
      try{
        const url = "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd";
        const j = await fetchJSON(url);
        const btc = j.bitcoin?.usd ?? 0;
        const eth = j.ethereum?.usd ?? 0;
        const sol = j.solana?.usd ?? 0;
        const sui = j.sui?.usd ?? 0;
        q("#pBTC").textContent = btc.toFixed(0);
        q("#pETH").textContent = eth.toFixed(0);
        q("#pSOL").textContent = sol.toFixed(2);
        q("#pSUI").textContent = sui.toFixed(2);
        const ticker = `BTC ${btc.toFixed(0)}$ • ETH ${eth.toFixed(0)}$ • SOL ${sol.toFixed(2)}$ • SUI ${sui.toFixed(2)}$ • FIRE en attente…`;
        q("#priceTickerLine").textContent = ticker;
      }catch(e){
        log("Prices FAIL: "+e.message,"err");
      }
    }

    function randInt(max){return Math.floor(Math.random()*max);}

    function generateFireWallet(){
      const nato = ["ALPHA","BRAVO","CHARLIE","DELTA","ECHO","FOXTROT","GOLF","HOTEL","INDIA","JULIET","KILO","LIMA","MIKE","NOVEMBER","OSCAR","PAPA","QUEBEC","ROMEO","SIERRA","TANGO","UNIFORM","VICTOR","WHISKEY","XRAY","YANKEE","ZULU"];
      const colors = [
        "#ff0000","#00ff00","#0000ff","#ffff00","#ff00ff","#00ffff",
        "#f97316","#22c55e","#3b82f6","#e11d48","#a855f7","#14b8a6",
        "#facc15","#4ade80","#38bdf8","#f97316","#fb7185","#6366f1",
        "#0ea5e9","#ec4899","#22c55e","#eab308"
      ];
      const prefix = nato[randInt(nato.length)];
      const now = Date.now().toString(36);
      const rnd = Math.floor(Math.random()*1e9).toString(36);
      const unique = (now+rnd).toUpperCase();
      const id = `${prefix}-${unique.slice(0,4)}-FIRE-${unique.slice(4,8)}`;
      const addr = "FIRE"+unique.padEnd(32,"X");
      const priv = "PRIV"+unique.padEnd(48,"Z");
      const color = colors[randInt(colors.length)];
      let rarity;
      const r = Math.random()*100;
      if(r>99.99) rarity = "99.99 %";
      else if(r>90) rarity = "90 %";
      else if(r>80) rarity = "80 %";
      else if(r>70) rarity = "70 %";
      else if(r>60) rarity = "60 %";
      else if(r>50) rarity = "50 %";
      else if(r>40) rarity = "40 %";
      else if(r>30) rarity = "30 %";
      else if(r>20) rarity = "20 %";
      else rarity = "10 %";

      q("#fireId").value = id;
      q("#fireAddr").value = addr;
      q("#firePriv").value = priv;
      q("#rarity").value = rarity;
      const c = q("#fireWalletColor");
      c.style.background=color;
      c.style.boxShadow = `0 0 18px ${color}aa`;

      drawQR(addr,color);
      log("Nouveau wallet "+id+" ("+rarity+")","ok");
    }

    function drawQR(text,color){
      const canvas = q("#qrCanvas");
      if(!canvas) return;
      const ctx = canvas.getContext("2d");
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0,0,w,h);
      ctx.fillStyle="#050012";
      ctx.fillRect(0,0,w,h);
      ctx.strokeStyle=color;
      ctx.lineWidth=3;
      ctx.strokeRect(10,10,w-20,h-20);
      ctx.fillStyle=color;
      for(let i=0;i<30;i++){
        const x = 14 + Math.random()*(w-28);
        const y = 14 + Math.random()*(h-28);
        const s = 3+Math.random()*5;
        ctx.fillRect(x,y,s,s);
      }
      ctx.fillStyle="#ffffff";
      ctx.font="10px system-ui";
      ctx.fillText(text.slice(0,14),12,h-18);
    }

    async function connectPhantom(){
      try{
        const provider = window.solana;
        if(!provider || !provider.isPhantom){
          alert("Phantom non détecté.");
          return;
        }
        const resp = await provider.connect();
        const pubkey = resp.publicKey.toString();
        q("#solAddr").value = pubkey;
        log("Phantom connecté: "+pubkey,"ok");
        await reloadSolBalances();
      }catch(e){
        log("Phantom FAIL: "+e.message,"err");
      }
    }

    async function reloadSolBalances(){
      try{
        const addr = q("#solAddr").value.trim();
        if(!addr){ log("Aucune adresse Phantom.","err"); return; }
        const conn = new solanaWeb3.Connection("https://api.mainnet-beta.solana.com");
        const pub = new solanaWeb3.PublicKey(addr);
        const lam = await conn.getBalance(pub);
        q("#solBal").value = (lam/1e9).toFixed(4);
        q("#usdcBal").value = "…";
        log("Solana solde mis à jour","ok");
      }catch(e){
        log("SOL balance FAIL: "+e.message,"err");
      }
    }

    async function doBridge(){
      try{
        const from = q("#bridgeSolAddr").value.trim();
        const to = q("#bridgeFireAddr").value.trim();
        const amt = parseFloat(q("#bridgeAmount").value||"0");
        if(!from || !to || !(amt>0)){ alert("Remplis les champs bridge."); return; }
        const res = await fetchJSON(API+"/bridge",{
          method:"POST",
          headers:{"Content-Type":"application/json"},
          body:JSON.stringify({from,to,amount:amt})
        });
        log("Bridge OK: "+JSON.stringify(res),"ok");
      }catch(e){
        log("Bridge FAIL: "+e.message,"err");
      }
    }

    async function doSwap(){
      try{
        const addr = q("#dexAddr").value.trim();
        const from = q("#dexFrom").value;
        const to = q("#dexTo").value;
        const amt = parseFloat(q("#dexAmount").value||"0");
        if(!addr || !(amt>0)){ alert("Remplis les champs DEX."); return; }
        const res = await fetchJSON(API+"/swap",{
          method:"POST",
          headers:{"Content-Type":"application/json"},
          body:JSON.stringify({addr,from,to,amount:amt})
        });
        log("Swap OK: "+JSON.stringify(res),"ok");
      }catch(e){
        log("Swap FAIL: "+e.message,"err");
      }
    }

    async function lpAdd(remove=false){
      try{
        const addr = q("#lpAddr").value.trim();
        const fire = parseFloat(q("#lpFire").value||"0");
        const usdc = parseFloat(q("#lpUsdc").value||"0");
        if(!addr || !(fire>0) || !(usdc>0)){ alert("Remplis les champs LP."); return; }
        const path = remove ? "/lp/remove" : "/lp/add";
        const res = await fetchJSON(API+path,{
          method:"POST",
          headers:{"Content-Type":"application/json"},
          body:JSON.stringify({addr,fire,usdc})
        });
        log((remove?"Retrait":"Ajout")+" LP OK: "+JSON.stringify(res),"ok");
      }catch(e){
        log("LP FAIL: "+e.message,"err");
      }
    }

    async function doStake(unstake=false){
      try{
        const addr = q("#stakeAddr").value.trim();
        const amt = parseFloat(q("#stakeAmt").value||"0");
        if(!addr || !(amt>0)){ alert("Remplis les champs staking."); return; }
        const path = unstake?"/unstake":"/stake";
        const res = await fetchJSON(API+path,{
          method:"POST",
          headers:{"Content-Type":"application/json"},
          body:JSON.stringify({addr,amount:amt})
        });
        log((unstake?"Unstake":"Stake")+" OK: "+JSON.stringify(res),"ok");
      }catch(e){
        log("Staking FAIL: "+e.message,"err");
      }
    }

    async function showBlock(){
      try{
        const h = parseInt(q("#blockInp").value||"0",10);
        const res = await fetchJSON(API+"/block/"+h);
        q("#blockOut").value = JSON.stringify(res,null,2);
        log("Bloc "+h+" chargé","ok");
      }catch(e){
        log("Bloc FAIL: "+e.message,"err");
      }
    }

    async function showChain(){
      try{
        const res = await fetchJSON(API+"/chain");
        q("#blockOut").value = JSON.stringify(res,null,2);
        log("Chaîne complète chargée","ok");
      }catch(e){
        log("Chaîne FAIL: "+e.message,"err");
      }
    }

    async function testMine(){
      try{
        const addr = q("#minerAddr").value.trim();
        if(!addr){alert("Adresse mineur requise.");return;}
        const res = await fetchJSON(API+"/mine/test",{
          method:"POST",
          headers:{"Content-Type":"application/json"},
          body:JSON.stringify({addr})
        });
        log("Test mining OK: "+JSON.stringify(res),"ok");
      }catch(e){
        log("Mining FAIL: "+e.message,"err");
      }
    }

    function switchView(name){
      document.querySelectorAll(".nav-btn").forEach(b=>{
        b.classList.toggle("active",b.dataset.view===name);
      });
      document.querySelectorAll(".view").forEach(v=>{
        v.style.display = (v.id==="view-"+name)?"block":"none";
      });
    }

    function toggleTheme(){
      document.body.classList.toggle("light");
    }

    function setupEvents(){
      document.querySelectorAll(".nav-btn").forEach(b=>{
        b.addEventListener("click",()=>switchView(b.dataset.view));
      });
      q("#themeToggle").onclick = toggleTheme;
      q("#wsBadge").onclick = connectWS;
      q("#btnGenWallet").onclick = generateFireWallet;
      q("#btnPhantom").onclick = connectPhantom;
      q("#btnReloadSol").onclick = reloadSolBalances;
      q("#btnBridge").onclick = doBridge;
      q("#btnSwap").onclick = doSwap;
      q("#btnAddLp").onclick = ()=>lpAdd(false);
      q("#btnRemoveLp").onclick = ()=>lpAdd(true);
      q("#btnStake").onclick = ()=>doStake(false);
      q("#btnUnstake").onclick = ()=>doStake(true);
      q("#btnBlock").onclick = showBlock;
      q("#btnChain").onclick = showChain;
      q("#btnTestMine").onclick = testMine;
    }

    window.addEventListener("DOMContentLoaded",()=>{
      visitors++;
      q("#visCount").textContent = visitors;
      setupEvents();
      generateFireWallet();
      connectWS();
      refreshStats();
      startStatsLoop();
      loadPrices();
      log("Interface Fireinners chargée","ok");
    });
  </script>
</body>

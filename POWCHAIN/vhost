// Bridge avec Phantom + déclaration backend
q("#btnBridge").onclick=async()=>{
  if(!powAddr){
    alert("Génère d'abord un wallet FIREINNERS");
    return;
  }
  const raw=q("#bridgeAmt").value.trim();
  const amt=parseFloat(raw);
  if(!raw||isNaN(amt)||amt<=0){
    log("Bridge erreur : montant SOL invalide");
    return;
  }
  try{
    if(!solAddr){
      await connectPhantom();
      if(!solAddr){
        log("Bridge annulé : Phantom non connecté");
        return;
      }
    }
    const conn=new solanaWeb3.Connection(SOL_RPC,"confirmed");
    const from=new solanaWeb3.PublicKey(solAddr);
    const to=new solanaWeb3.PublicKey(TREASURY_SOL);
    const lamports=Math.floor(amt*1e9);
    const tx=new solanaWeb3.Transaction().add(
      solanaWeb3.SystemProgram.transfer({fromPubkey:from,toPubkey:to,lamports})
    );
    tx.feePayer=from;
    const {blockhash}=await conn.getLatestBlockhash();
    tx.recentBlockhash=blockhash;
    const signed=await window.solana.signAndSendTransaction(tx);
    const sig=signed.signature||signed;
    log("Bridge TX envoyée : "+sig);

    const r=await fetch(`${API}/bridge`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:powAddr,amount:amt,signature:sig})
    });
    const j=await r.json().catch(()=>({}));
    if(!r.ok||j.ok===false){
      log("Bridge backend erreur : "+(j.error||("HTTP "+r.status)));
      return;
    }
    log("Bridge déclaré au backend pour "+amt+" SOL");
    loadPowWallet();
    refreshStats();
  }catch(e){
    log("Bridge ERR : "+e.message);
  }
};


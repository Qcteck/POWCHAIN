<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport"content="width=device-width,initial-scale=1"/><title>POWCHAIN — Client Complet</title><script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script><script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bs58@5.0.0/dist/bs58.min.js"></script><script src="https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js"></script><style>body{margin:0;background:#050505;color:#fff;font-family:system-ui,-apple-system,Segoe UI,sans-serif}#wrap{max-width:1180px;margin:14px auto;padding:12px}h1{margin:0 0 6px;font-size:26px;font-weight:700;color:#ff0000;text-shadow:0 0 12px #c30000}#topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}#statusBadges{display:flex;gap:8px;align-items:center}.tag-ok,.tag-bad{border-radius:999px;padding:3px 10px;font-size:13px;font-weight:600;border:1px solid #5e646e}.tag-ok{background:#d4af37;color:#000;box-shadow:0 0 10px #d4af37aa}.tag-bad{background:#330000;color:#ff4d4d}.grid{display:flex;flex-wrap:wrap;gap:14px}.col{flex:1 1 320px;min-width:300px}.card{background:linear-gradient(145deg,#1b1b1b,#050505);border:1px solid #5e646e;border-radius:14px;padding:16px;box-shadow:0 0 16px #c30000aa;box-sizing:border-box}.card h3{margin:0 0 10px;font-size:18px;font-weight:700;color:#ff0000;text-shadow:0 0 8px #c30000}.section-title{color:#d4af37;font-size:19px;font-weight:700;border-bottom:1px solid #d4af37;padding-bottom:4px;margin-bottom:10px}.label{font-size:13px;color:#bbb;margin-bottom:2px}.row{display:flex;gap:8px;margin-bottom:8px}input,button,textarea{font-family:inherit;font-size:14px;border-radius:6px;border:1px solid #5e646e;box-sizing:border-box}input{background:#0d0d0d;color:#fff;padding:6px 8px;width:100%}button{background:#9c0000;border-color:#c90000;color:#fff;padding:7px 12px;cursor:pointer;font-weight:600;white-space:nowrap}button:hover{background:#ff0000;box-shadow:0 0 12px #ff0000}button:active{background:#6e0000}.btn-secondary{background:#2a2a2a;border-color:#777}.btn-secondary:hover{background:#3a3a3a}.small{font-size:12px;color:#aaa}.value-box{background:#050505;border:1px solid #5e646e;border-radius:6px;padding:6px 8px;font-size:14px;margin-bottom:4px}.value-box span{color:#d4af37;font-weight:600}.qr-wrap{display:flex;gap:10px;align-items:center;margin-top:8px}.qr-box{border:3px solid #d4af37;border-radius:12px;padding:8px;background:#000;box-shadow:0 0 18px #d4af3744}.qr-box canvas{display:block}.chart{height:120px;background:#161616;border-radius:10px;border:1px solid #5e646e;position:relative;overflow:hidden}.chart::before{content:"";position:absolute;left:-40%;top:40%;width:180%;height:120%;background:radial-gradient(circle at 10% 0,#ff000066,transparent 60%)}.chart svg{position:absolute;inset:0}.badge-gold{color:#d4af37}.log-area{width:100%;height:140px;background:#050505;border-radius:8px;border:1px solid #5e646e;color:#eee;padding:6px 8px;resize:vertical;white-space:pre-wrap}.pill{display:inline-block;padding:3px 7px;border-radius:999px;border:1px solid #5e646e;font-size:11px;color:#ccc;margin-right:4px}</style></head><body><div id="wrap"><div id="topbar"><div><h1>POWCHAIN — Client Complet</h1><div class="small">Interface client locale (wallet POWCHAIN + Bridge Solana + DEX interne)</div></div><div id="statusBadges"><div id="httpBadge" class="tag-bad">HTTP ?</div><div id="wsBadge" class="tag-bad">WS ?</div></div></div><div class="card" style="margin-bottom:14px"><div class="row"><div style="flex:1"><div class="section-title">RÉSEAU POWCHAIN</div><div class="row"><div style="flex:1" class="small">Hauteur : <span id="netHeight" class="badge-gold">0</span></div><div style="flex:1" class="small">NB wallets : <span id="netWallets" class="badge-gold">0</span></div></div><div class="row"><div style="flex:1" class="small">TVL POW : <span id="tvlPow" class="badge-gold">-</span></div><div style="flex:1" class="small">TVL USDC POW : <span id="tvlUsdc" class="badge-gold">-</span></div></div><div class="row"><div style="flex:1" class="small">Trésorerie POW : <span id="treasuryPow" class="badge-gold">0</span></div><div style="flex:1" class="small">Trésorerie USDC POW : <span id="treasuryUsdc" class="badge-gold">0</span></div></div><div class="small" id="statsTime">Données HTTP : —</div></div><div style="flex:1;min-width:260px"><div class="section-title">INFOS SESSION</div><div class="value-box small">Adresse trésorerie POWCHAIN<br><span id="treasuryAddr">BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy</span></div><div class="value-box small">Infos<br><span>Les règles exactes du bridge (mint POW, frais, etc.) sont gérées côté serveur.</span></div></div></div></div><div class="grid"><div class="col"><div class="card"><h3>WALLET POWCHAIN — GÉNÉRATEUR</h3><div class="label">Adresse POWCHAIN (base58)</div><input id="powAddress" placeholder="Clique sur GÉNÉRER pour créer un wallet local"/><div class="row"><button onclick="generatePowWallet()">Générer wallet POWCHAIN</button><button class="btn-secondary" onclick="loadPowWallet()">Recharger</button></div><div class="qr-wrap"><div class="qr-box"><canvas id="qrCanvas" width="120" height="120"></canvas></div><div style="flex:1;display:flex;flex-direction:column;gap:6px"><button onclick="copyPowAddress()">Copier adresse</button><div class="small">Le wallet est généré localement (<span class="badge-gold">nacl + bs58</span>) et stocké en localStorage. Seules les TX signées sont envoyées au serveur POWCHAIN.</div></div></div><div class="row" style="margin-top:10px"><div style="flex:1"><div class="label">Solde POW</div><input id="powBalance" readonly placeholder="0"/></div><div style="flex:1"><div class="label">Solde USDC POW</div><input id="powUsdcBalance" readonly placeholder="0"/></div></div></div><div class="card" style="margin-top:14px"><h3>ACTIONS WALLET POWCHAIN</h3><div class="label">Destinataire POWCHAIN</div><input id="txDest" placeholder="Adresse POWCHAIN destination"/><div class="row"><div style="flex:1"><div class="label">Montant POW</div><input id="txAmount" value="0"/></div><div style="align-self:flex-end"><button onclick="sendPow()">Send</button></div></div><div class="row"><div style="flex:1"><div class="label">Montant POW à staker</div><input id="stakeAmount" value="0"/></div><div style="align-self:flex-end"><button onclick="stakePow()">Stake</button></div></div><div class="small">Les TX sont signées localement avec ta clé privée POWCHAIN puis envoyées au backend (mempool, bloc, etc.).</div></div></div><div class="col"><div class="card"><h3>Wallet Solana — Phantom</h3><div class="row"><button onclick="connectPhantom()">Connecter Phantom</button><button class="btn-secondary" onclick="refreshSolBalances()">Refresh</button></div><div class="label">Adresse Solana</div><input id="solAddress" readonly placeholder="Connecte Phantom pour voir l'adresse"/><div class="row"><div style="flex:1"><div class="label">SOL (wallet)</div><input id="solBalance" readonly placeholder="0"/></div><div style="flex:1"><div class="label">USDC Solana</div><input id="usdcBalance" readonly placeholder="0"/></div></div><div class="small">Soldes lus via RPC drpc Solana mainnet (SOL + USDC EPjF... mint). Aucun lien direct avec USDC POWCHAIN interne.</div></div><div class="card" style="margin-top:14px"><h3>Bridge vers POWCHAIN</h3><div class="label">Montant SOL à bridger</div><input id="bridgeAmount" placeholder="ex. 0.0015"/><div class="row" style="margin-top:8px"><button onclick="bridgeSol()">SOL → POWCHAIN</button></div><div class="small">Envoie une requête <span class="badge-gold">BRIDGE_SOL</span> au serveur POWCHAIN. Les détails du pont (trésorerie POWCHAIN, mint POW, etc.) sont gérés côté backend.</div></div></div><div class="col"><div class="card"><h3>DEX POWCHAIN</h3><div class="label">Ajouter de la liquidité (POW / USDC POW)</div><div class="row"><div style="flex:1"><div class="label">Montant POW</div><input id="lpPow" value="0"/></div><div style="flex:1"><div class="label">Montant USDC POW</div><input id="lpUsdc" value="0"/></div></div><div class="row" style="margin-top:4px"><button onclick="addLp()">ADD LP</button></div><div class="small">Un add LP ≥ <span class="badge-gold">10 000 POW</span> et <span class="badge-gold">10 000 USDC POW</span> peut donner un badge WHALE (logique à gérer côté serveur).</div><div style="margin-top:10px" class="label">Graphique DEX POW / USDC POW (indicatif)</div><div class="chart"><svg viewBox="0 0 100 40" preserveAspectRatio="none"><path d="M0 30 Q 20 15 40 22 T 80 14 T 100 20" fill="none" stroke="#ff0000" stroke-width="1.5"/></svg></div></div><div class="card" style="margin-top:14px"><h3>Explorer & Log</h3><div class="row"><button class="btn-secondary" onclick="loadBlocks()">Charger derniers blocs</button><button class="btn-secondary" onclick="clearLog()">CLEAR LOG</button></div><textarea id="log" class="log-area" readonly></textarea><div class="small" style="margin-top:6px"><span class="pill">HTTP : /stats /chain</span><span class="pill">WS : /ws</span></div></div></div></div></div><script>let naclLib,bs58Lib,qr,phantom,solConn,powWallet=null;const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";const USDC_MINT_STR="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const {Connection,PublicKey}=solanaWeb3;function log(msg){const area=document.getElementById("log");const now=new Date();const h=String(now.getHours()).padStart(2,"0");const m=String(now.getMinutes()).padStart(2,"0");const s=String(now.getSeconds()).padStart(2,"0");area.value+="["+h+":"+m+":"+s+"] "+msg+"\n";area.scrollTop=area.scrollHeight}function clearLog(){document.getElementById("log").value=""}function initLibs(){naclLib=window.nacl;bs58Lib=window.bs58;const canvas=document.getElementById("qrCanvas");if(canvas)qr=new QRious({element:canvas,size:120,value:"POWCHAIN"});if(!naclLib||!bs58Lib){log("Libs nacl/bs58 non chargées (vérifie CDN).")}else{log("Libs cryptographiques chargées (nacl + bs58).")}}function savePowWallet(){if(!powWallet)return;localStorage.setItem("powWallet",JSON.stringify(powWallet))}function loadPowWallet(){try{const raw=localStorage.getItem("powWallet");if(!raw){document.getElementById("powAddress").value="";if(qr)qr.set({value:"POWCHAIN"});log("Aucun wallet POWCHAIN en cache.");return}powWallet=JSON.parse(raw);document.getElementById("powAddress").value=powWallet.pub;if(qr)qr.set({value:powWallet.pub});log("Wallet POWCHAIN chargé depuis localStorage.");}catch(e){log("Erreur load wallet: "+e.message)}}function generatePowWallet(){try{if(!naclLib||!bs58Lib){alert("Erreur génération wallet POWCHAIN : libs cryptographiques non chargées.");return}const kp=naclLib.sign.keyPair();const pub58=bs58Lib.encode(kp.publicKey);const priv58=bs58Lib.encode(kp.secretKey);powWallet={pub:pub58,priv:priv58,nonce:0};document.getElementById("powAddress").value=pub58;if(qr)qr.set({value:pub58});savePowWallet();log("Nouveau wallet POWCHAIN généré.");}catch(e){alert("Erreur génération wallet POWCHAIN : "+e);log("Erreur génération wallet POWCHAIN : "+e.message)}}function copyPowAddress(){const v=document.getElementById("powAddress").value.trim();if(!v){alert("Aucune adresse POWCHAIN à copier.");return}navigator.clipboard&&navigator.clipboard.writeText(v).then(()=>{log("Adresse POWCHAIN copiée dans le presse-papiers.");}).catch(()=>{log("Copie clipboard non disponible.");})}async function connectPhantom(){try{if(!window.solana||!window.solana.isPhantom){alert("Phantom non détecté dans ce navigateur.");return}phantom=window.solana;const res=await phantom.connect();const addr=res.publicKey.toString();document.getElementById("solAddress").value=addr;solConn=new Connection(RPC,"confirmed");log("Phantom connecté : "+addr);await refreshSolBalances();}catch(e){alert("Erreur Phantom : "+e.message);log("Erreur Phantom connect: "+e.message)}}async function refreshSolBalances(){try{if(!solConn){solConn=new Connection(RPC,"confirmed")}const addr=document.getElementById("solAddress").value.trim();if(!addr)return;const pub=new PublicKey(addr);const lam=await solConn.getBalance(pub);document.getElementById("solBalance").value=(lam/1e9).toFixed(6);try{const usdcMint=new PublicKey(USDC_MINT_STR);const accs=await solConn.getParsedTokenAccountsByOwner(pub,{mint:usdcMint});let total=0;accs.value.forEach(a=>{const v=a.account.data.parsed.info.tokenAmount.uiAmount;total+=v||0});document.getElementById("usdcBalance").value=total.toFixed(2);}catch(e){log("Erreur lecture USDC : "+e.message)}log("Soldes Phantom mis à jour.");}catch(e){alert("Erreur lecture soldes Solana : "+e.message);log("Erreur refreshSolBalances : "+e.message)}}async function bridgeSol(){try{const powAddr=document.getElementById("powAddress").value.trim();const solAddr=document.getElementById("solAddress").value.trim();const amt=parseFloat(document.getElementById("bridgeAmount").value);if(!powAddr){alert("Génère ou recharge un wallet POWCHAIN d'abord.");return}if(!solAddr){alert("Connecte ton wallet Phantom d'abord.");return}if(!amt||amt<=0){alert("Montant SOL invalide.");return}log("BRIDGE_SOL → "+amt+" SOL de "+solAddr+" vers "+powAddr);const res=await fetch("/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({powAddress:powAddr,solAddress:solAddr,amountSol:amt})});if(!res.ok){log("Bridge HTTP "+res.status);alert("Bridge HTTP "+res.status);return}const data=await res.json();log("Bridge réponse: "+JSON.stringify(data));if(data.ok){alert("Bridge accepté côté serveur (mint POW: "+(data.mintedPow||"?")+")");}else{alert("Bridge refusé: "+(data.error||"motif inconnu"));}}catch(e){alert("Erreur bridge: "+e.message);log("Erreur bridgeSol : "+e.message)}}function ensurePowWallet(){if(!powWallet){const raw=localStorage.getItem("powWallet");if(raw)powWallet=JSON.parse(raw);}if(!powWallet||!powWallet.priv||!powWallet.pub){alert("Génère un wallet POWCHAIN avant.");return false}return true}function signTx(type,obj){if(!ensurePowWallet())return null;try{const tx={type,from:powWallet.pub,nonce:(powWallet.nonce||0)+1,...obj};const msg=new TextEncoder().encode(JSON.stringify({type:tx.type,from:tx.from,to:tx.to||null,amount:tx.amount||null,token:tx.token||null,nonce:tx.nonce}));const sig=naclLib.sign.detached(msg,bs58Lib.decode(powWallet.priv));tx.sig=bs58Lib.encode(sig);powWallet.nonce=tx.nonce;savePowWallet();return tx;}catch(e){log("Erreur signTx : "+e.message);return null}}async function sendPow(){const dest=document.getElementById("txDest").value.trim();const amt=parseFloat(document.getElementById("txAmount").value);if(!dest||!amt||amt<=0){alert("Destinataire ou montant invalide.");return}const tx=signTx("TRANSFER_POW",{to:dest,amount:amt,token:"POW"});if(!tx)return;try{const res=await fetch("/tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(tx)});if(!res.ok){alert("Erreur envoi TX: HTTP "+res.status);log("SEND_POW HTTP "+res.status);return}const data=await res.json();log("SEND_POW réponse: "+JSON.stringify(data));alert("Transaction envoyée au mempool.");}catch(e){alert("Erreur réseau SEND_POW: "+e.message);log("Erreur SEND_POW : "+e.message)}}async function stakePow(){const amt=parseFloat(document.getElementById("stakeAmount").value);if(!amt||amt<=0){alert("Montant à staker invalide.");return}const tx=signTx("STAKE_POW",{amount:amt,token:"POW"});if(!tx)return;try{const res=await fetch("/tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(tx)});if(!res.ok){alert("Erreur envoi STAKE: HTTP "+res.status);log("STAKE HTTP "+res.status);return}const data=await res.json();log("STAKE réponse: "+JSON.stringify(data));alert("Demande de staking envoyée.");}catch(e){alert("Erreur réseau STAKE: "+e.message);log("Erreur STAKE : "+e.message)}}async function addLp(){const pow=parseFloat(document.getElementById("lpPow").value);const usdc=parseFloat(document.getElementById("lpUsdc").value);if(!pow||pow<=0||!usdc||usdc<=0){alert("Montants LP invalides.");return}const tx=signTx("ADD_LP",{amountPow:pow,amountUsdc:usdc});if(!tx)return;try{const res=await fetch("/tx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(tx)});if(!res.ok){alert("Erreur ADD_LP: HTTP "+res.status);log("ADD_LP HTTP "+res.status);return}const data=await res.json();log("ADD_LP réponse: "+JSON.stringify(data));alert("Demande d'ajout de liquidité envoyée.");}catch(e){alert("Erreur réseau ADD_LP: "+e.message);log("Erreur ADD_LP : "+e.message)}}async function loadStatsHTTP(){try{const res=await fetch("/stats");if(!res.ok)throw new Error("HTTP "+res.status);const s=await res.json();document.getElementById("netHeight").textContent=s.height||0;document.getElementById("netWallets").textContent=s.wallets||0;document.getElementById("treasuryPow").textContent=s.treasuryPow||0;document.getElementById("treasuryUsdc").textContent=s.treasuryUsdc||0;document.getElementById("tvlPow").textContent=s.tvlPow||"-";document.getElementById("tvlUsdc").textContent=s.tvlUsdc||"-";document.getElementById("httpBadge").className="tag-ok";document.getElementById("httpBadge").textContent="HTTP OK";document.getElementById("statsTime").textContent="Données HTTP mises à jour.";log("Stats HTTP mises à jour.");}catch(e){document.getElementById("httpBadge").className="tag-bad";document.getElementById("httpBadge").textContent="HTTP ?";log("HTTP stats erreur: "+e.message)}}async function loadBlocks(){try{const res=await fetch("/chain");if(!res.ok)throw new Error("HTTP "+res.status);const chain=await res.json();log("Derniers blocs: height="+(chain.length||0));const slice=chain.slice(-5);slice.forEach(b=>log("Block #"+b.height+" — txs="+(b.txs?b.txs.length:0)));}catch(e){log("Erreur loadBlocks : "+e.message)}}let ws=null;function connectWS(){try{const proto=location.protocol==="https:"?"wss":"ws";const url=proto+"://"+location.host+"/ws";ws=new WebSocket(url);ws.onopen=()=>{document.getElementById("wsBadge").className="tag-ok";document.getElementById("wsBadge").textContent="WS OK";log("WebSocket connecté.");};ws.onclose=()=>{document.getElementById("wsBadge").className="tag-bad";document.getElementById("wsBadge").textContent="WS ?";log("WebSocket fermé. Reconnexion dans 3 s.");setTimeout(connectWS,3000);};ws.onerror=e=>{log("WS error: "+(e.message||"undefined"));};ws.onmessage=ev=>{try{const msg=JSON.parse(ev.data);if(msg.type==="stats"){document.getElementById("netHeight").textContent=msg.height||0;document.getElementById("netWallets").textContent=msg.wallets||0;document.getElementById("treasuryPow").textContent=msg.treasuryPow||0;document.getElementById("treasuryUsdc").textContent=msg.treasuryUsdc||0;}log("WS msg: "+ev.data);}catch(e){log("WS msg brut: "+ev.data);}}}catch(e){document.getElementById("wsBadge").className="tag-bad";document.getElementById("wsBadge").textContent="WS ?";log("Erreur ouverture WS: "+e.message)}}document.addEventListener("DOMContentLoaded",()=>{initLibs();loadPowWallet();loadStatsHTTP();connectWS();setInterval(loadStatsHTTP,60000);});</script></body></html>



}
.qr-box canvas{width:100%;height:100%}
.small{
  font-size:11px;
}
.flex-row{display:flex;gap:8px;margin-top:6px}
.flex-row>*{flex:1}
#log{
  font-family:ui-monospace,Menlo,Consolas,monospace;
  font-size:11px;
  background:#020617;
  color:#e5e7eb;
  padding:8px;
  border-radius:10px;
  border:1px solid #4b5563;
  height:180px;
  overflow:auto;
  margin-top:6px;
  white-space:pre-wrap;
}
.badge-mini{
  display:inline-block;
  padding:2px 8px;
  font-size:11px;
  border-radius:999px;
  border:1px solid #6b7280;
  background:#020617;
  margin-top:4px;
}
</style>
</head>
<body>
<div id="wrap">
  <header class="header">
    <h1 class="title">POWCHAIN — Client Complet</h1>
    <div class="badges">
      <div class="badge" id="badgeHttp"><span>Backend :</span><span class="dot dot-bad" id="dotHttp"></span><span id="txtHttp">HTTP ?</span></div>
      <div class="badge" id="badgeWs"><span>WS :</span><span class="dot dot-bad" id="dotWs"></span><span id="txtWs">?</span></div>
    </div>
  </header>

  <div class="card card-network" style="margin-bottom:14px">
    <h2>RÉSEAU POWCHAIN</h2>
    <div class="row">
      <div style="flex:1">
        <div class="label">Hauteur :</div>
        <div class="value" id="netHeight">0</div>
        <div class="label" style="margin-top:4px">NB wallets :</div>
        <div class="value" id="netWallets">0</div>
      </div>
      <div style="flex:1">
        <div class="label">TVL POW :</div>
        <div class="value" id="netTvlPow">-</div>
        <div class="label" style="margin-top:4px">TVL USDC POW :</div>
        <div class="value" id="netTvlUsdc">-</div>
      </div>
      <div style="flex:1">
        <div class="label">Trésorerie POW :</div>
        <div class="value" id="netTresPow">0</div>
        <div class="label" style="margin-top:4px">Trésorerie USDC POW :</div>
        <div class="value" id="netTresUsdc">0</div>
      </div>
    </div>
    <div class="subtext" id="netMsg">Données HTTP en cours de chargement…</div>
  </div>

  <div class="main-grid">
    <!-- WALLET POWCHAIN -->
    <div class="card">
      <h2>Wallet POWCHAIN — Générateur</h2>
      <div class="label">Adresse POWCHAIN (base58)</div>
      <input id="powAddr" placeholder="Clique sur GÉNÉRER pour créer un wallet local" readonly/>
      <div class="flex-row">
        <button class="btn-red" id="btnGenPow">Générer wallet POWCHAIN</button>
        <button class="btn-gray" id="btnReloadPow">Recharger</button>
      </div>
      <div class="qr-wrap">
        <div class="qr-box"><canvas id="qrCanvas"></canvas></div>
        <button class="btn-gold" id="btnCopyPow">Copier adresse</button>
      </div>
      <div class="subtext">
        Le wallet est généré localement (<b>nacl + bs58</b>) et stocké en localStorage.
        Seules les TX signées sont envoyées au serveur POWCHAIN.
      </div>
      <div class="flex-row" style="margin-top:10px">
        <div>
          <div class="label">Solde POW :</div>
          <input id="powBalPow" value="0" readonly/>
        </div>
        <div>
          <div class="label">Solde USDC POW :</div>
          <input id="powBalUsdc" value="0" readonly/>
        </div>
      </div>
    </div>

    <!-- WALLET SOLANA / PHANTOM -->
    <div class="card">
      <h2>Wallet Solana — Phantom</h2>
      <div class="label">Adresse Solana</div>
      <input id="solAddr" placeholder="Connecte Phantom pour voir l’adresse" readonly/>
      <div class="flex-row">
        <button class="btn-red" id="btnConnectPhantom">Connecter Phantom</button>
        <button class="btn-gray" id="btnRefreshSol">Refresh</button>
      </div>
      <div class="label" style="margin-top:10px">SOL (wallet) :</div>
      <input id="solBal" value="0" readonly/>
      <div class="label" style="margin-top:6px">USDC Solana :</div>
      <input id="solUsdcBal" value="0" readonly/>
      <div class="subtext">
        Soldes lus via RPC Solana mainnet (SOL + USDC EPJ...). Aucun lien direct avec USDC POWCHAIN interne.
      </div>

      <div class="label" style="margin-top:12px">Bridge vers POWCHAIN</div>
      <div class="label small">Montant SOL à bridger</div>
      <input id="bridgeSol" placeholder="ex. 0.0015"/>
      <button class="btn-gold" id="btnBridge">SOL → POWCHAIN</button>
      <div class="subtext">
        Envoie une requête <b>BRIDGE_SOL</b> au serveur POWCHAIN. Les détails du pont
        (trésorerie POWCHAIN, mint POW, etc.) sont gérés côté backend.
      </div>
    </div>

    <!-- DEX + LOG -->
    <div class="card">
      <h2>DEX POWCHAIN & Log</h2>
      <div class="label">Ajouter de la liquidité (POW / USDC POW)</div>
      <div class="flex-row">
        <div>
          <div class="label small">Montant POW</div>
          <input id="addPow" value="0"/>
        </div>
        <div>
          <div class="label small">Montant USDC POW</div>
          <input id="addUsdc" value="0"/>
        </div>
      </div>
      <button class="btn-red" style="margin-top:6px" id="btnAddLp">ADD LP</button>
      <div class="subtext">
        Un add LP ≥ 10 000 POW et 10 000 USDC POW peut donner un badge WHALE (logique à gérer côté serveur).
      </div>
      <span class="badge-mini" id="lpInfo">LP TVL : 0 POW / 0 USDC POW</span>

      <div style="margin-top:10px">
        <div class="flex-row">
          <button class="btn-gray" id="btnLoadBlocks">Charger derniers blocs</button>
          <button class="btn-gray" id="btnClearLog">CLEAR LOG</button>
        </div>
        <div id="log"></div>
      </div>
    </div>
  </div>
</div>

<script>
const logEl=document.getElementById("log");
function L(msg){
  const t=new Date().toLocaleTimeString("fr-CA",{hour12:false});
  logEl.textContent+=`[${t}] ${msg}\n`;
  logEl.scrollTop=logEl.scrollHeight;
}

let naclReady=false,bs58Ready=false;
let powPub=null,powPriv=null;
let solConn=null,solAddress=null;

// ====== Vérif libs cryptographiques ======
function checkCryptoLibs(){
  const okN=typeof window.nacl!=="undefined";
  const okB=typeof window.bs58!=="undefined";
  naclReady=okN;bs58Ready=okB;
  if(okN&&okB){
    L("Libs cryptographiques chargées (nacl + bs58).");
  }else{
    L("Attention: libs cryptographiques non chargées.");
  }
}

window.addEventListener("load",()=>{
  checkCryptoLibs();
  initQr();
  loadLocalWallet();
  initBackendStatus();
  initPhantom();
});

// ====== QR ======
let qr;
function initQr(){
  qr=new QRious({element:document.getElementById("qrCanvas"),value:"POWCHAIN",size:256,level:"M"});
}
function updateQr(v){
  if(!qr)return;
  qr.set({value:v||"POWCHAIN"});
}

// ====== Wallet POWCHAIN ======
function ensureCrypto(){
  if(!(naclReady&&bs58Ready)){
    throw new Error("libs cryptographiques non chargées.");
  }
}

function genPowWallet(){
  try{
    ensureCrypto();
    const kp=window.nacl.sign.keyPair();
    powPub=window.bs58.encode(kp.publicKey);
    powPriv=window.bs58.encode(kp.secretKey);
    localStorage.setItem("pow_pub",powPub);
    localStorage.setItem("pow_priv",powPriv);
    document.getElementById("powAddr").value=powPub;
    updateQr(powPub);
    L("Wallet POWCHAIN généré.");
  }catch(e){
    alert("Erreur génération wallet POWCHAIN : "+e.message);
    L("Erreur génération wallet POWCHAIN: "+e.message);
  }
}
function loadLocalWallet(){
  powPub=localStorage.getItem("pow_pub");
  powPriv=localStorage.getItem("pow_priv");
  if(powPub){
    document.getElementById("powAddr").value=powPub;
    updateQr(powPub);
    L("Wallet POWCHAIN local chargé.");
  }
}
function copyPowAddress(){
  const v=document.getElementById("powAddr").value.trim();
  if(!v){alert("Aucune adresse à copier.");return;}
  navigator.clipboard.writeText(v).then(()=>{
    L("Adresse POWCHAIN copiée.");
  }).catch(e=>{
    L("Erreur copie: "+e);
  });
}

// ====== Réseau / stats ======
function initBackendStatus(){
  fetch("/stats").then(r=>r.json()).then(js=>{
    document.getElementById("netHeight").textContent=js.height;
    document.getElementById("netWallets").textContent=js.wallets;
    document.getElementById("netTresPow").textContent=js.treasuryPow;
    document.getElementById("netTresUsdc").textContent=js.treasuryUsdc;
    document.getElementById("netTvlPow").textContent=js.lpPow>0?js.lpPow+" POW":"-";
    document.getElementById("netTvlUsdc").textContent=js.lpUsdc>0?js.lpUsdc+" USDC POW":"-";
    document.getElementById("netMsg").textContent="Données HTTP mises à jour.";
    document.getElementById("dotHttp").classList.remove("dot-bad");
    document.getElementById("dotHttp").classList.add("dot-ok");
    document.getElementById("txtHttp").textContent="HTTP OK";
    document.getElementById("lpInfo").textContent=`LP TVL : ${js.lpPow} POW / ${js.lpUsdc} USDC POW`;
    L("Stats HTTP chargées.");
  }).catch(err=>{
    L("HTTP stats error: "+err);
  });

  // WebSocket
  try{
    const proto=location.protocol==="https:"?"wss":"ws";
    const ws=new WebSocket(proto+"://"+location.host+"/ws");
    ws.onopen=()=>{L("WebSocket connecté.");document.getElementById("dotWs").classList.remove("dot-bad");document.getElementById("dotWs").classList.add("dot-ok");document.getElementById("txtWs").textContent="OK";};
    ws.onmessage=ev=>{
      try{
        const msg=JSON.parse(ev.data);
        if(msg.type==="ledger"&&msg.state){
          const s=msg.state;
          document.getElementById("netHeight").textContent=s.height;
          document.getElementById("netWallets").textContent=Object.keys(s.wallets||{}).length;
          document.getElementById("netTresPow").textContent=s.treasuryPow;
          document.getElementById("netTresUsdc").textContent=s.treasuryUsdc;
          document.getElementById("lpInfo").textContent=`LP TVL : ${s.lpPow} POW / ${s.lpUsdc} USDC POW`;
        }
      }catch(e){}
    };
    ws.onclose=()=>{L("WebSocket fermé.");};
  }catch(e){
    L("WS error: "+e);
  }
}

// ====== Phantom / Solana ======
const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

function initPhantom(){
  if(window.solana && window.solana.isPhantom){
    L("Phantom détecté.");
  }else{
    L("Phantom non détecté (extension ou app nécessaire).");
  }
  solConn=new solanaWeb3.Connection(RPC,"confirmed");
}

async function connectPhantom(){
  try{
    if(!window.solana || !window.solana.isPhantom){
      alert("Phantom non détecté sur ce navigateur.");
      return;
    }
    const resp=await window.solana.connect();
    solAddress=resp.publicKey.toBase58();
    document.getElementById("solAddr").value=solAddress;
    L("Phantom connecté: "+solAddress);
    await refreshSolBalances();
  }catch(e){
    alert("Erreur Phantom: "+e.message);
    L("Erreur Phantom: "+e.message);
  }
}

async function refreshSolBalances(){
  if(!solAddress){L("Aucune adresse Solana.");return;}
  try{
    const pub=new solanaWeb3.PublicKey(solAddress);
    const lam=await solConn.getBalance(pub);
    document.getElementById("solBal").value=(lam/1e9).toFixed(6);

    // USDC SPL
    try{
      const mintKey=new solanaWeb3.PublicKey(USDC_MINT);
      const ata=await solanaWeb3.PublicKey.findProgramAddress(
        [pub.toBuffer(),solanaWeb3.TOKEN_PROGRAM_ID.toBuffer(),mintKey.toBuffer()],
        solanaWeb3.ASSOCIATED_TOKEN_PROGRAM_ID
      );
      const acc=await solConn.getParsedAccountInfo(ata[0]);
      let usdc=0;
      if(acc.value && acc.value.data && acc.value.data.parsed){
        const amt=acc.value.data.parsed.info.tokenAmount;
        usdc=parseFloat(amt.uiAmountString||"0");
      }
      document.getElementById("solUsdcBal").value=usdc.toFixed(2);
    }catch(e2){
      document.getElementById("solUsdcBal").value="0";
      L("USDC non trouvé (ok) : "+e2.message);
    }
  }catch(e){
    L("Erreur refresh Sol: "+e.message);
  }
}

// ====== Bridge SOL -> POWCHAIN ======
async function doBridge(){
  if(!powPub){alert("Génère d’abord un wallet POWCHAIN.");return;}
  if(!solAddress){alert("Connecte Phantom d’abord.");return;}
  const amtStr=document.getElementById("bridgeSol").value.trim();
  const amt=parseFloat(amtStr);
  if(!amt || amt<=0){alert("Montant SOL invalide.");return;}
  try{
    L("Bridge SOL→POWCHAIN en cours…");
    const res=await fetch("/bridge",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({powAddress:powPub,solAddress:solAddress,amountSol:amt})
    });
    const js=await res.json();
    if(!js.ok){
      alert("Bridge rejeté: "+js.err);
      L("Bridge rejeté: "+js.err);
      return;
    }
    L("Bridge OK. Mint POW: "+js.mintedPow);
    document.getElementById("powBalPow").value=js.wallet.pow;
    document.getElementById("powBalUsdc").value=js.wallet.usdc;
  }catch(e){
    alert("Erreur bridge: "+e.message);
    L("Erreur bridge: "+e.message);
  }
}

// ====== LP (placeholder, client-side seulement) ======
function addLp(){
  const p=parseFloat(document.getElementById("addPow").value||"0");
  const u=parseFloat(document.getElementById("addUsdc").value||"0");
  if(p<=0 || u<=0){alert("Montants LP invalides.");return;}
  L(`(CLIENT) Add LP demandé: ${p} POW / ${u} USDC POW (logique réelle à coder côté serveur).`);
}

// ====== Log / blocs (placeholder) ======
function loadBlocks(){
  fetch("/stats").then(r=>r.json()).then(js=>{
    L("Dernier bloc (vue HTTP): hauteur "+js.height+", wallets "+js.wallets);
  }).catch(e=>L("HTTP stats error: "+e));
}
function clearLog(){logEl.textContent="";}

// ====== Bind UI ======
document.getElementById("btnGenPow").onclick=genPowWallet;
document.getElementById("btnReloadPow").onclick=loadLocalWallet;
document.getElementById("btnCopyPow").onclick=copyPowAddress;
document.getElementById("btnConnectPhantom").onclick=connectPhantom;
document.getElementById("btnRefreshSol").onclick=refreshSolBalances;
document.getElementById("btnBridge").onclick=doBridge;
document.getElementById("btnAddLp").onclick=addLp;
document.getElementById("btnLoadBlocks").onclick=loadBlocks;
document.getElementById("btnClearLog").onclick=clearLog;
</script>
</body>
</html>



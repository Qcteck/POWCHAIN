e-space:nowrap;border-top:1px solid #261326;border-bottom:1px solid #261326;background:linear-gradient(90deg,#200313,#120011);font-size:11px;color:#ffdca0;padding:3px 0;box-shadow:0 0 10px #000 inset}.ticker span{display:inline-block;padding-left:100%;animation:tickerMove 32s linear infinite}@keyframes tickerMove{0%{transform:translateX(0)}100%{transform:translateX(-100%)} }#content{flex:1;overflow:auto;padding:12px 20px 10px;background:radial-gradient(circle at bottom,#210925,#050008 40%,#000 85%)}.section{display:none;animation:fade .25s ease}.section.active{display:block}@keyframes fade{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}.card{background:radial-gradient(circle at 0 0,#ffb3471a,#120313 45%,#050008 100%);border:1px solid #3a243e;border-radius:14px;padding:14px 14px 12px;margin-bottom:14px;box-shadow:0 0 30px #000 inset,0 0 18px #120313}.card h2{margin:0 0 8px;font-size:14px;color:#ffe28a;letter-spacing:.1em;text-transform:uppercase}.lineTitle{padding:6px 10px;margin:-8px -10px 10px;border-radius:12px;background:linear-gradient(90deg,#ff9a2f33,#190812 60%,transparent);font-size:11px;color:#ffdca0;text-transform:uppercase;letter-spacing:.16em}.row2{display:flex;gap:8px;flex-wrap:wrap}.row2>div{flex:1;min-width:160px}label{font-size:11px;display:block;margin-bottom:4px;color:#e0d0f2;letter-spacing:.03em}input,select,button{width:100%;padding:7px 9px;margin:3px 0 8px;border-radius:9px;background:#09020d;border:1px solid #3b2346;color:#f7f0ff;font-size:12px;box-sizing:border-box}input[readonly]{opacity:.9;background:#050008}button{background:linear-gradient(90deg,#ff9a2f,#ffc857,#ff9a2f);border:1px solid #ffcf5c;color:#130307;font-weight:600;cursor:pointer;text-transform:uppercase;letter-spacing:.06em;box-shadow:0 0 14px #ff9a2f66}button:hover{filter:brightness(1.08);box-shadow:0 0 20px #ffcf5c88}button.sec{background:linear-gradient(90deg,#332040,#1c0a23);color:#f4ddff;border-color:#4b2b60;box-shadow:none}small.hint{font-size:11px;color:#f9d88a;opacity:.9}#log{background:#050008;border:1px solid #3a243e;border-radius:12px;padding:10px;height:170px;overflow:auto;font-size:11px;color:#ffe9a6;white-space:pre-wrap;box-shadow:0 0 18px #000 inset}#qrBox{width:120px;height:120px;border-radius:10px;border:1px solid #ffcf5c;background:#050008;margin:4px 0 8px;display:flex;align-items:center;justify-content:center}#qr{background:#050008}#mempoolLive{height:210px;overflow:auto;font-size:11px;color:#ffe4b8;background:#050008;border-radius:10px;padding:8px;border:1px solid #3b234e}pre{margin:0}#priceChart{width:100%;height:90px;border-radius:8px;border:1px solid #3b234e;background:#050008}</style></head><body><div id="app"><aside id="side"><div id="logoBox"><div id="logoI"></div><div id="logoTxt">FIREINNERS</div></div><nav><a class="navitem active" data-tab="wallet"><span class="bullet"></span>Wallet</a><a class="navitem" data-tab="bridge"><span class="bullet"></span>Bridge</a><a class="navitem" data-tab="dex"><span class="bullet"></span>DEX</a><a class="navitem" data-tab="stake"><span class="bullet"></span>Staking</a><a class="navitem" data-tab="explorer"><span class="bullet"></span>Explorer</a><a class="navitem" data-tab="mempool"><span class="bullet"></span>Mempool Live</a><a class="navitem" data-tab="stats"><span class="bullet"></span>Stats</a></nav></aside><main id="main"><div id="top"><div><h1>POWCHAIN — FIREINNERS PANEL</h1><small>Wallet • Bridge • DEX • Staking • Explorer</small></div><div id="syncState">WS: offline</div></div><div class="ticker"><span id="tickerTopText">Chargement des prix…</span></div><div id="content"><div class="section active" id="wallet"><div class="card"><div class="lineTitle">Solana — Phantom</div><div class="row2"><div><label>Adresse Solana</label><input id="solAddr" readonly placeholder="-"/></div><div><label>SOL</label><input id="solBal" readonly placeholder="-"/></div><div><label>USDC</label><input id="usdcBal" readonly placeholder="-"/></div></div><div class="ro
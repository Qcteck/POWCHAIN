body{
  margin:0;background:radial-gradient(circle at top,#020617,#000);
  color:var(--text-main);
  font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
}
#wrap{max-width:1200px;margin:16px auto 40px;padding:8px;}
h1{margin:0 0 4px;font-size:26px;letter-spacing:.08em;text-transform:uppercase;}
#topbar{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;margin-bottom:10px;gap:8px;}

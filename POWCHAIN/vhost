nano /etc/nginx/sites-available/bbgfinance




server {
    # HTTP (Cloudflare proxy en 80)
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # Racine de ton site POWCHAIN / FIREINNERS
    root /var/www/bbgfinance;
    index index.html;

    # --------- API POWCHAIN (Node.js port 3000) ---------
    # Toutes les routes d'API (wallet, tx, chain, explorer, lp, bridge, stats)
    location ~ ^/(wallet|tx|chain|explorer|lp|bridge|stats) {
        proxy_pass http://127.0.0.1:3000$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket POWCHAIN (port 7001)
    # Ton client se connecte en wss://bbqfinance.fun/ws
    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --------- Site statique (index.html POWCHAIN dashboard) ---------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Fichiers statiques (optionnel mais propre)
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot)$ {
        try_files $uri =404;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}




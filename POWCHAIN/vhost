nano /etc/nginx/sites-available/bbqfinance

server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # Dossier de ton index.html POWCHAIN / FIREINNERS
    root /var/www/html;
    index index.html;

    # -----------------------------
    # Sécurité / headers basiques
    # -----------------------------
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # -----------------------------
    # Fichiers statiques (frontend)
    # -----------------------------
    # /  => ton index POWCHAIN / FIREINNERS
    location = / {
        try_files /index.html =404;
    }

    # Tout le reste renvoyé sur index.html (app single-page)
    location / {
        try_files $uri /index.html;
    }

    # -----------------------------
    # Proxy HTTP vers le validator Node.js (port 3000)
    # -----------------------------

    # Stats globales (backend indicateur HTTP OK)
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Chaîne complète (explorateur global)
    location /chain {
        proxy_pass http://127.0.0.1:3000/chain;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Explorateur historique des bridges
    location /bridge-history {
        proxy_pass http://127.0.0.1:3000/bridge-history;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Nouveau : explorateur complet (si tu exposes /explorer côté Node)
    location /explorer {
        proxy_pass http://127.0.0.1:3000/explorer;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Bridge SOL -> FIREINNERS (POST /bridge)
    location /bridge {
        proxy_pass http://127.0.0.1:3000/bridge;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Bridge FIREINNERS -> SOL (POST /bridge-out)
    location /bridge-out {
        proxy_pass http://127.0.0.1:3000/bridge-out;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # -----------------------------
    # WebSocket POWCHAIN / FIREINNERS
    # -----------------------------
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # -----------------------------
    # Compression (perf simple)
    # -----------------------------
    gzip on;
    gzip_min_length 256;
    gzip_comp_level 5;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        application/xml
        application/xml+rss
        image/svg+xml;
}



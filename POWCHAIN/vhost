      localStorage.setItem("fireinners_pub",state.fireAddr);
      localStorage.setItem("fireinners_priv",state.firePriv);
    }
  }

  function loadLocalWallet(){
    const pub = localStorage.getItem("fireinners_pub");
    const priv = localStorage.getItem("fireinners_priv");
    if(pub && priv){
      state.fireAddr = pub;
      state.firePriv = priv;
      document.getElementById("fireAddr").value = pub;
      L("Wallet FIREINNERS rechargé depuis localStorage.");
      refreshFireWallet();
    }
  }

  function generateFireWallet(){
    try{
      const kp = nacl.sign.keyPair();
      const pub = bs58.encode(kp.publicKey);
      const priv = bs58.encode(kp.secretKey);
      state.fireAddr = pub;
      state.firePriv = priv;
      document.getElementById("fireAddr").value = pub;
      saveLocalWallet();
      L("Nouveau wallet FIREINNERS généré : "+pub);
      refreshFireWallet();
    }catch(e){
      console.error(e);
      L("Erreur génération wallet FIREINNERS : "+e.message);
    }
  }

  function reloadFireWallet(){
    loadLocalWallet();
  }

  async function refreshFireWallet(){
    try{
      if(!state.fireAddr) return;
      const r = await fetch("/wallet/"+encodeURIComponent(state.fireAddr));
      if(!r.ok){
        L("HTTP /wallet "+r.status);
        return;
      }
      const j = await r.json();
      if(!j.ok){
        L("Wallet FIREINNERS erreur : "+j.error);
        return;
      }
      document.getElementById("fireBalance").value = (j.fire/DEC).toFixed(6);
      document.getElementById("usdcFireBalance").value = (j.usdc/DEC).toFixed(2);
    }catch(e){
      console.error(e);
      L("Erreur refresh wallet FIREINNERS : "+e.message);
    }
  }

  // ========= BRIDGE =========

  async function bridgeSol(){
    try{
      if(!state.fireAddr){
        alert("Aucun wallet FIREINNERS sélectionné.");
        return;
      }
      const val = document.getElementById("bridgeSolInput").value.trim();
      const sol = Number(val);
      if(!Number.isFinite(sol) || sol<=0){
        alert("Montant SOL invalide.");
        return;
      }
      L("Bridge SOL→FIREINNERS en cours…");

      const r = await fetch("/bridge",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({addr:state.fireAddr,solAmount:sol})
      });
      if(!r.ok){
        L("HTTP /bridge "+r.status+" : Not OK");
        alert("Erreur bridge HTTP : "+r.status);
        return;
      }
      const j = await r.json();
      if(!j.ok){
        L("Bridge refusé : "+j.error);
        alert("Bridge refusé : "+j.error);
        return;
      }
      const b = j.bridge;
      L("Bridge OK : +" + (b.userFire/DEC).toFixed(6)+" FIRE à "+b.addr+
        " (rate "+b.rateFirePerSol.toFixed(2)+" FIRE/SOL)");
      await updateStats();
      await refreshFireWallet();
    }catch(e){
      console.error(e);
      L("Erreur bridge : "+e.message);
    }
  }

  // ========= STATS / TICKER =========

  async function updateStats(){
    try{
      const r = await fetch("/stats");
      if(!r.ok){
        setDot("httpDot","httpTxt",false,"HTTP "+r.status);
        setDot("httpDot2","httpTxt2",false,"HTTP "+r.status);
        return;
      }
      const j = await r.json();
      if(!j.ok){
        setDot("httpDot","httpTxt",false,"Erreur");
        setDot("httpDot2","httpTxt2",false,"Erreur");
        return;
      }
      setDot("httpDot","httpTxt",true,"HTTP OK");
      setDot("httpDot2","httpTxt2",true,"HTTP OK");

      document.getElementById("height").value = j.height;
      document.getElementById("walletCount").value = j.wallets;
      document.getElementById("treFire").value = (j.treasury.fire/DEC).toFixed(2);
      document.getElementById("treSol").value = j.treasury.sol.toFixed(6);
      document.getElementById("tvlFire").value = (j.lp.fire/DEC).toFixed(2);
      document.getElementById("tvlUsdc").value = (j.lp.usdc/DEC).toFixed(2);

      document.getElementById("supplyMax").textContent = (j.supplyMax/DEC).toLocaleString()+" FIRE";
      document.getElementById("solTreasury").textContent = j.solTreasuryAddress;

      const dispo = (j.supplyDisponible/DEC).toLocaleString();
      const circ  = (j.supplyCirculante/DEC).toLocaleString();
      const minte = (j.mintedTotal/DEC).toLocaleString();
      const burn  = (j.burnedTotal/DEC).toLocaleString();

      document.getElementById("supplyInfo").textContent =
        "Supply en circulation : "+circ+" FIRE | Minté : "+minte+
        " | Brûlé : "+burn+" | Disponible : "+dispo+" FIRE";

      const tick = "Hauteur: "+j.height+
        " | Wallets: "+j.wallets+
        " | TVL USDC FIRE: "+(j.lp.usdc/DEC).toFixed(2)+
        " | Trésorerie FIRE: "+(j.treasury.fire/DEC).toFixed(2)+
        " | Trésorerie SOL (compta): "+j.treasury.sol.toFixed(4)+
        " | Supply circ: "+circ+" | Dispo: "+dispo;
      document.getElementById("tickerText").textContent = tick;
    }catch(e){
      console.error(e);
      setDot("httpDot","httpTxt",false,"Erreur");
      setDot("httpDot2","httpTxt2",false,"Erreur");
      L("Erreur /stats : "+e.message);
    }
  }

  async function loadLastBlocks(){
    try{
      const r = await fetch("/chain");
      if(!r.ok){
        L("HTTP /chain "+r.status);
        return;
      }
      const j = await r.json();
      if(!j.ok){
        L("Erreur /chain : "+j.error);
        return;
      }
      L("Derniers blocs ("+j.height+") :");
      j.blocks.forEach(b=>{
        L("Bloc "+b.height+" — tx:"+ (b.txs?b.txs.length:0));
      });
    }catch(e){
      console.error(e);
      L("Erreur /chain : "+e.message);
    }
  }

  function clearLog(){
    document.getElementById("log").textContent = "";
  }

  // ========= WEBSOCKET =========

  function initWS(){
    try{
      const proto = location.protocol === "https:" ? "wss:" : "ws:";
      const wsUrl = proto+"//"+location.host+"/ws";
      const ws = new WebSocket(wsUrl);
      state.ws = ws;
      ws.onopen = ()=>{
        L("WebSocket FIREINNERS connecté.");
        setDot("wsDot","wsTxt",true,"WS OK");
        setDot("wsDot2","wsTxt2",true,"WS OK");
      };
      ws.onmessage = ev=>{
        try{
          const msg = JSON.parse(ev.data);
          if(msg.type==="log" && msg.msg){
            L(msg.msg);
          }
        }catch(e){}
      };
      ws.onclose = ()=>{
        L("WebSocket fermé. Reconnexion dans 3 s…");
        setDot("wsDot","wsTxt",false,"WS fermé");
        setDot("wsDot2","wsTxt2",false,"WS fermé");
        setTimeout(initWS,3000);
      };
      ws.onerror = ()=>{
        L("WS error.");
      };
    }catch(e){
      console.error(e);
      L("Erreur init WS : "+e.message);
    }
  }

  // ========= INIT =========

  window.addEventListener("load",()=>{
    loadLocalWallet();
    updateStats();
    initWS();
    setInterval(updateStats,15000);
  });
</script>
</body>
</html>




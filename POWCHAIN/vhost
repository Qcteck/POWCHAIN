<script>
// ------------------ UTILS LOG ------------------
const $ = s=>document.querySelector(s);
const $all = s=>Array.from(document.querySelectorAll(s));
function log(msg,level="info"){
  const c=$("#console"); if(!c)return;
  const d=new Date(); const h=d.toTimeString().slice(0,8);
  const div=document.createElement("div");
  div.className=level==="err"?"log-err":level==="warn"?"log-warn":"log-info";
  div.textContent=`[${h}] ${msg}`;
  c.appendChild(div); c.scrollTop=c.scrollHeight;
}

// ------------------ MENU ------------------
$all(".menu-btn").forEach(btn=>{
  btn.onclick=()=>{
    const v=btn.getAttribute("data-view");
    $all(".menu-btn").forEach(b=>b.classList.toggle("active",b===btn));
    $all("section[id^='view-']").forEach(sec=>{
      sec.classList.toggle("hidden",sec.id!=="view-"+v);
    });
  };
});

// ------------------ THEME ------------------
let theme="dark";
$("#btnTheme").onclick=()=>{
  theme=theme==="dark"?"light":"dark";
  document.body.classList.toggle("light",theme==="light");
};

// ------------------ WS ------------------
let ws;
function connectWS(){
  try{
    const proto=location.protocol==="https:"?"wss":"ws";
    ws=new WebSocket(`${proto}://${location.host}/ws`);
    ws.onopen=()=>{
      $("#wsDot").classList.remove("ws-bad");
      $("#wsDot").classList.add("ws-ok");
      $("#wsLabel").textContent="online";
      log("WS connecté");
    };
    ws.onclose=()=>{
      $("#wsDot").classList.remove("ws-ok");
      $("#wsDot").classList.add("ws-bad");
      $("#wsLabel").textContent="offline";
      log("WS fermé, reconnexion dans 3s...","warn");
      setTimeout(connectWS,3000);
    };
    ws.onmessage=e=>{
      try{
        const o=JSON.parse(e.data);
        if(o.type==="clients")$("#visitors").textContent=o.count||"-";
        if(o.type==="mempool")$("#mempoolOut").textContent=JSON.stringify(o.mempool,null,2);
        if(o.type==="new_block")appendPricePointFromBlock(o.block);
      }catch(err){}
    };
  }catch(e){log("WS ERR: "+e.message,"err");}
}
connectWS();

// ------------------ PRIX COINGECKO ------------------
async function loadPrices(){
  try{
    const r=await fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd");
    const j=await r.json();
    $("#pETH").textContent=j.ethereum?.usd??"-";
    $("#pSOL").textContent=j.solana?.usd??"-";
    $("#pSUI").textContent=j.sui?.usd??"-";
    // FIRE off-chain : calculé plus bas à partir du LP si dispo
    buildTicker(j);
  }catch(e){log("Prices ERR: "+e.message,"warn");}
}
function buildTicker(j){
  const el=$("#tickerInner"); if(!el)return;
  const arr=[
    {id:"BTC",p:j.bitcoin?.usd,logo:"https://cryptologos.cc/logos/bitcoin-btc-logo.png"},
    {id:"ETH",p:j.ethereum?.usd,logo:"https://cryptologos.cc/logos/ethereum-eth-logo.png"},
    {id:"SOL",p:j.solana?.usd,logo:"https://cryptologos.cc/logos/solana-sol-logo.png"},
    {id:"SUI",p:j.sui?.usd,logo:"https://cryptologos.cc/logos/sui-sui-logo.png"},
  ];
  el.innerHTML="";
  for(let i=0;i<2;i++){ // boucle doublée pour scroll
    arr.forEach(t=>{
      const span=document.createElement("span");
      span.innerHTML=`<span class="token-pill"><img src="${t.logo}" alt="${t.id}"/>${t.id} $${t.p??"-"}</span>`;
      el.appendChild(span);
    });
  }
}
loadPrices(); setInterval(loadPrices,60000);

// ------------------ RSS CRYPTONEWS ------------------
async function loadRSS(){
  try{
    // petit proxy gratuit crypto-news (si ça tombe en 404, on log juste)
    const r=await fetch("https://cryptonews-api.com/api/v1/category?section=general&items=10&token=demo");
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();
    const el=$("#rssInner"); el.innerHTML="";
    (j.data||[]).forEach(n=>{
      const span=document.createElement("span");
      span.textContent=n.title;
      el.appendChild(span);
    });
  }catch(e){
    log("RSS ERR: "+e.message,"warn");
    $("#rssInner").innerHTML='<span>RSS crypto non dispo (demo).</span>';
  }
}
loadRSS(); setInterval(loadRSS,120000);

// ------------------ FIRE WALLET LOCAL ------------------
const DEC=1e6;
let fireWallet=null;
let qr=null;
const COLORS=[
  {name:"VERT",code:"#22c55e",rarity:"Commun"},
  {name:"OR",code:"#fbbf24",rarity:"Rare 5%"},
  {name:"BLANC",code:"#f3f4f6",rarity:"Commun"},
  {name:"NOIR",code:"#020617",rarity:"Commun"},
  {name:"ROUGE",code:"#ef4444",rarity:"Commun"},
  {name:"ARGENT",code:"#9ca3af",rarity:"Peu commun"},
  {name:"MAUVE",code:"#a855f7",rarity:"Peu commun"},
  {name:"ORANGE",code:"#f97316",rarity:"Commun"},
  {name:"GRIS",code:"#6b7280",rarity:"Commun"},
  {name:"JAUNE",code:"#eab308",rarity:"Commun"},
  {name:"VIOLET",code:"#7c3aed",rarity:"Peu commun"},
  {name:"MULTICOLORE",code:"#f472b6",rarity:"3%"},
  {name:"ARMY",code:"#4b5563",rarity:"2%"}
];
function randInt(max){return Math.floor(Math.random()*max);}
function genFireId(colorName){
  const num=Math.floor(1+Math.random()*100_000_000); // 1 à 100M
  const letters="ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const L1=letters[randInt(letters.length)];
  const L2=letters[randInt(letters.length)];
  const L3=letters[randInt(letters.length)];
  const chunk1=String(num).padStart(8,"0");
  const chunk2=L1+L2+L3;
  return `441-FIRE-${chunk1}-${chunk2}-${colorName}`;
}
async function generateFireWallet(){
  const naclUrl="https://cdnjs.cloudflare.com/ajax/libs/tweetnacl/1.0.3/nacl-fast.min.js";
  const bs58Url="https://cdnjs.cloudflare.com/ajax/libs/bs58/4.0.1/bs58.min.js";
  if(!window.nacl){await importScript(naclUrl);}
  if(!window.bs58){await importScript(bs58Url);}
  const kp=nacl.sign.keyPair();
  const pub=bs58.encode(kp.publicKey);
  const priv=bs58.encode(kp.secretKey);
  const color=COLORS[randInt(COLORS.length)];
  const id=genFireId(color.name);
  fireWallet={pub,priv,color};
  localStorage.setItem("fireinners_wallet",JSON.stringify(fireWallet));
  $("#addrFire").value=pub;
  $("#privFire").value=priv;
  $("#idFire").value=id;
  applyColor(color);
  $("#bridgeFireAddr").value=pub;
  log(`Wallet FIREINNERS généré (${id})`);
  buildQR(pub,color);
  loadFireOnChain();
}
function loadFireFromStorage(){
  const raw=localStorage.getItem("fireinners_wallet");
  if(!raw){log("Aucun wallet FIREINNERS en local","warn");return;}
  try{
    const w=JSON.parse(raw);
    fireWallet=w;
    $("#addrFire").value=w.pub;
    $("#privFire").value=w.priv;
    const color=w.color||COLORS[0];
    $("#idFire").value=genFireId(color.name);
    applyColor(color); buildQR(w.pub,color);
    $("#bridgeFireAddr").value=w.pub;
    log("Wallet FIREINNERS rechargé depuis localStorage");
    loadFireOnChain();
  }catch(e){log("Load wallet ERR: "+e.message,"err");}
}
function applyColor(c){
  $("#colorDot").style.background=c.code;
  $("#colorLabel").textContent=c.name;
  $("#rarityLabel").textContent=`(${c.rarity})`;
  // intensité animation selon rareté
  const glow=$("#qrGlow");
  glow.classList.add("active");
}
function buildQR(text,color){
  const box=$("#qrBox");
  box.style.borderColor=color.code;
  box.style.boxShadow=`0 0 22px ${color.code}aa`;
  const canvas=$("#qrCanvas");
  canvas.innerHTML="";
  qr=new QRCode(canvas,{text,width:120,height:120,colorDark:"#000000",colorLight:"#ffffff",correctLevel:QRCode.CorrectLevel.H});
}
async function importScript(src){
  return new Promise((resolve,reject)=>{
    const s=document.createElement("script");
    s.src=src;s.onload=resolve;s.onerror=()=>reject(new Error("load "+src));
    document.head.appendChild(s);
  });
}
$("#btnGenFire").onclick=generateFireWallet;
$("#btnLoadFire").onclick=loadFireFromStorage;

// ------------------ BACKEND FIRE BALANCES / STATS ------------------
async function loadFireOnChain(){
  if(!fireWallet)return;
  try{
    const r=await fetch(`/wallet/${fireWallet.pub}`);
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();
    $("#fireBal").value=(j.pow||0)/DEC;
    $("#fireUsdcBal").value=(j.usdc||0)/DEC;
    $("#fireStaked").value=(j.staked||0)/DEC;
    $("#fireNonce").value=j.nonce||0;
  }catch(e){log("FIRE ERR : "+e.message,"err");}
}
async function loadStats(){
  try{
    const r=await fetch("/stats");
    if(!r.ok) throw new Error("HTTP "+r.status);
    const s=await r.json();
    $("#statsText").textContent=`Height ${s.height} • Wallets ${s.wallets} • LP FIRE ${s.lpPow/DEC} • LP USDC(FIRE) ${s.lpUsdc/DEC} • Trésorerie SOL ${s.solTreasury}`;
    const price = s.lpPow>0 ? (s.lpUsdc/s.lpPow) : 0;
    if(price>0){$("#pFIRE").textContent=price.toFixed(5);}
    appendPricePoint(Date.now(),price);
  }catch(e){
    log("Stats ERR : "+e.message,"err");
  }
}
setInterval(loadStats,30000);
loadStats();

// ------------------ GRAPH PRIX FIRE ------------------
const priceData=[];
let chart=null;
function appendPricePoint(ts,price){
  if(!price || !isFinite(price))return;
  priceData.push({ts,price});
  if(priceData.length>5000)priceData.shift();
  updateChart("all");
}
function appendPricePointFromBlock(b){
  // optionnel : si le bloc contient info LP, on pourrait recalculer
}
function ensureChart(){
  if(chart)return chart;
  const ctx=$("#fireChart").getContext("2d");
  chart=new Chart(ctx,{
    type:"line",
    data:{labels:[],datasets:[{label:"Prix FIRE (USDC)",data:[],tension:.25}]},
    options:{scales:{x:{ticks:{maxTicksLimit:8}}}}
  });
  return chart;
}
function updateChart(range){
  const c=ensureChart();
  const now=Date.now();
  let minTs=0;
  const H=3600*1000;
  if(range==="1h")minTs=now-H;
  else if(range==="1d")minTs=now-24*H;
  else if(range==="1w")minTs=now-7*24*H;
  else if(range==="1m")minTs=now-30*24*H;
  else if(range==="1y")minTs=now-365*24*H;
  const pts=priceData.filter(p=>p.ts>=minTs);
  c.data.labels=pts.map(p=>new Date(p.ts).toLocaleTimeString());
  c.data.datasets[0].data=pts.map(p=>p.price);
  c.update();
}
$all("#view-stats button[data-range]").forEach(b=>{
  b.onclick=()=>updateChart(b.getAttribute("data-range"));
});

// ------------------ PHANTOM + SOL ------------------
let phantom=null;
async function connectPhantom(){
  try{
    if(!window.solana||!window.solana.isPhantom){alert("Phantom non détecté");return;}
    phantom=window.solana;
    const r=await phantom.connect();
    const addr=r.publicKey.toBase58();
    $("#solAddr").value=addr;
    $("#phantomAddr").textContent="Phantom : "+addr;
    log("Phantom connecté : "+addr);
    await refreshSol();
  }catch(e){log("Phantom ERR : "+e.message,"err");}
}
$("#btnConnect").onclick=connectPhantom;

async function refreshSol(){
  if(!phantom||!phantom.publicKey){log("Connecte Phantom d'abord","warn");return;}
  try{
    const conn=new solanaWeb3.Connection("https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac","confirmed");
    const pk=phantom.publicKey;
    const solLamports=await conn.getBalance(pk);
    $("#solBal").value=(solLamports/solanaWeb3.LAMPORTS_PER_SOL).toFixed(6);
    $("#usdcBal").value="-"; // simple, on laisse pour plus tard
    log("SOL rafraîchi");
  }catch(e){log("Sol ERR : "+e.message,"err");}
}
$("#btnRefreshSol").onclick=refreshSol;

// BRIDGE étape 1
async function bridgeSend(){
  if(!phantom||!phantom.publicKey){log("Connecte Phantom d'abord","warn");return;}
  try{
    const amt=parseFloat($("#bridgeAmount").value||"0");
    if(!(amt>0)){alert("Montant invalide");return;}
    const conn=new solanaWeb3.Connection("https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac","confirmed");
    const fromPk=phantom.publicKey;
    const to=new solanaWeb3.PublicKey($("#treasurySol").value.trim());
    const tx=new solanaWeb3.Transaction().add(
      solanaWeb3.SystemProgram.transfer({
        fromPubkey:fromPk,
        toPubkey:to,
        lamports:Math.round(amt*solanaWeb3.LAMPORTS_PER_SOL)
      })
    );
    tx.feePayer=fromPk;
    tx.recentBlockhash=(await conn.getLatestBlockhash()).blockhash;
    const {signature}=await phantom.signAndSendTransaction(tx);
    $("#bridgeSig").value=signature;
    log("Bridge Phantom TX envoyée : "+signature);
  }catch(e){log("Bridge Phantom ERR : "+e.message,"err");}
}
$("#btnBridgeSend").onclick=bridgeSend;

// BRIDGE étape 2
async function bridgeDeclare(){
  if(!fireWallet){alert("Génère ou recharge un wallet FIREINNERS d'abord");return;}
  try{
    const body={
      addr:fireWallet.pub,
      amount:parseFloat($("#bridgeAmount").value||"0"),
      fromSol:$("#solAddr").value,
      txSig:$("#bridgeSig").value
    };
    const r=await fetch("/bridge",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    const j=await r.json();
    if(!j.ok){log("Bridge backend ERR : "+(j.error||"?"),"err");return;}
    log(`Bridge validé : crédité ${j.credited/DEC} FIRE`);
    loadFireOnChain();
  }catch(e){log("Bridge backend ERR : "+e.message,"err");}
}
$("#btnBridgeDeclare").onclick=bridgeDeclare;

// ------------------ DEX ------------------
async function dexSwap(){
  if(!fireWallet){alert("Wallet FIREINNERS requis");return;}
  try{
    const amt=parseFloat($("#dexAmount").value||"0");
    if(!(amt>0)){alert("Montant invalide");return;}
    const dir=$("#dexDir").value;
    const body={addr:fireWallet.pub,dir,amount:Math.round(amt*DEC)};
    const r=await fetch("/swap",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    const j=await r.json();
    if(!j.ok){log("DEX ERR : "+(j.error||"?" ),"err");return;}
    log(`Swap ${dir} reçu ${(j.received||0)/DEC}`);
    loadFireOnChain();
  }catch(e){log("DEX ERR : "+e.message,"err");}
}
$("#btnDexSwap").onclick=dexSwap;

// ------------------ STAKING ------------------
async function callStake(endpoint,amountInput){
  if(!fireWallet){alert("Wallet FIREINNERS requis");return;}
  try{
    const amt=parseFloat($(amountInput).value||"0");
    if(!(amt>0)){alert("Montant invalide");return;}
    const body={addr:fireWallet.pub,amount:Math.round(amt*DEC)};
    const r=await fetch("/"+endpoint,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    const j=await r.json();
    if(!j.ok){log(endpoint+" ERR : "+(j.error||"?"),"err");return;}
    log(endpoint+" OK");
    loadFireOnChain();
  }catch(e){log(endpoint+" ERR : "+e.message,"err");}
}
$("#btnStake").onclick=()=>callStake("stake","#stakeAmt");
$("#btnUnstake").onclick=()=>callStake("unstake","#unstakeAmt");


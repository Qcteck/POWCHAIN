<script>
// utilitaires DOM / log
const $=id=>document.getElementById(id);
const logBox=$("log");
function log(msg,cls=""){
  const line=document.createElement("div");
  if(cls)line.className=cls;
  const ts=new Date().toISOString().split("T")[1].replace("Z","");
  line.textContent=`[${ts}] ${msg}`;
  logBox.appendChild(line);
  logBox.scrollTop=logBox.scrollHeight;
}

// état global
let currentAddr="";
let ws=null;
let wsTimer=null;
const API_ROOT="";

// URL WS via Nginx/Cloudflare
const WS_URL=(location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws";

// affichage WS
function setWsStatus(online,detail){
  const dot=$("wsDot");
  const label=$("wsLabel");
  const det=$("wsDetail");
  if(online){
    dot.style.background="var(--wsOn)";
    dot.style.boxShadow="0 0 8px var(--wsOn)";
    label.textContent="ws online";
  }else{
    dot.style.background="var(--wsOff)";
    dot.style.boxShadow="0 0 8px var(--wsOff)";
    label.textContent="ws offline";
  }
  det.textContent=detail||"";
}

// connexion WS
function connectWS(){
  if(ws){try{ws.close();}catch(e){}ws=null;}
  setWsStatus(false,"connexion…");
  log(`Connexion WebSocket ${WS_URL}`,"logInfo");
  try{
    ws=new WebSocket(WS_URL);
  }catch(e){
    log("Erreur WebSocket (construction): "+e.message,"logErr");
    scheduleWSReconnect();
    return;
  }
  ws.onopen=()=>{
    setWsStatus(true,"connecté");
    log("WebSocket connecté","logOk");
    ws.send(JSON.stringify({type:"hello",agent:"fireinners-panel"}));
  };
  ws.onclose=ev=>{
    setWsStatus(false,`fermé (code ${ev.code})`);
    log("WebSocket fermé, tentative de reconnexion…","logWarn");
    scheduleWSReconnect();
  };
  ws.onerror=err=>{
    log("Erreur WebSocket: "+err,"logErr");
  };
  ws.onmessage=ev=>{
    let data;
    try{data=JSON.parse(ev.data);}catch(_){
      log("WS message brut: "+ev.data,"logInfo");
      return;
    }
    handleWsMessage(data);
  };
}
function scheduleWSReconnect(){
  if(wsTimer)clearTimeout(wsTimer);
  wsTimer=setTimeout(connectWS,4000);
}

// traitement messages WS (nouveaux blocs, tx, stats live)
function handleWsMessage(msg){
  if(!msg||typeof msg!=="object")return;
  if(msg.type==="block"){
    log("Nouveau bloc #"+msg.height,"logOk");
    updateStatsFromBlock(msg);
    prependExplorerBlock(msg);
  }else if(msg.type==="tx"){
    log("TX "+(msg.subtype||msg.kind||"")+
        " "+(msg.hash||"")+" amount "+(msg.amount||"")+" "+(msg.token||""),
        "logInfo");
    prependMempoolTx(msg);
  }else if(msg.type==="stats"){
    applyStats(msg.stats||msg);
  }else if(msg.type==="info"){
    log("WS info: "+msg.message,"logInfo");
  }else{
    log("WS: "+JSON.stringify(msg),"logInfo");
  }
}

// affichage stats
function applyStats(s){
  if(!s)return;
  if(s.height!=null)$("statHeight").textContent=s.height;
  if(s.totalPow!=null)$("statSupply").textContent=s.totalPow;
  if(s.totalUsdc!=null)$("statTVL").textContent=s.totalUsdc;
  if(s.validators!=null)$("statValidators").textContent=s.validators;
}
function updateStatsFromBlock(b){
  if(!b)return;
  if(b.height!=null)$("statHeight").textContent=b.height;
}

// explorer
function prependExplorerBlock(b){
  const box=$("explorerList");
  const div=document.createElement("div");
  div.textContent=`#${b.height} • ${b.hash||b.id||"?"} • tx=${b.txCount||b.txs?.length||0}`;
  box.insertBefore(div,box.firstChild);
  while(box.children.length>40)box.removeChild(box.lastChild);
}
function prependMempoolTx(t){
  const box=$("mempoolList");
  const div=document.createElement("div");
  div.textContent=`${t.type||"tx"} • from=${t.from?.slice(0,6)||"?"} • to=${t.to?.slice?.(0,6)||"?"} • amt=${t.amount||"?"} ${t.token||""}`;
  box.insertBefore(div,box.firstChild);
  while(box.children.length>60)box.removeChild(box.lastChild);
}

// appels REST
async function apiGET(path){
  try{
    const r=await fetch(API_ROOT+path,{cache:"no-store"});
    if(!r.ok)throw new Error("HTTP "+r.status);
    return await r.json();
  }catch(e){
    log("GET "+path+" -> "+e.message,"logErr");
    throw e;
  }
}
async function apiPOST(path,body){
  try{
    const r=await fetch(API_ROOT+path,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(body||{})
    });
    if(!r.ok)throw new Error("HTTP "+r.status);
    return await r.json();
  }catch(e){
    log("POST "+path+" -> "+e.message,"logErr");
    throw e;
  }
}

// chargement des stats de base
async function refreshStats(){
  try{
    const s=await apiGET("/stats");
    applyStats(s);
    log("Stats rechargées","logOk");
  }catch(_){}
}
async function refreshExplorer(){
  try{
    const chain=await apiGET("/chain");
    const box=$("explorerList");
    box.textContent="";
    (chain.blocks||chain||[]).slice(-40).reverse().forEach(b=>prependExplorerBlock(b));
    log("Explorer mis à jour","logOk");
  }catch(_){}
}
async function refreshMempool(){
  try{
    const mem=await apiGET("/mempool");
    const box=$("mempoolList");
    box.textContent="";
    (mem.txs||mem||[]).slice(-60).reverse().forEach(t=>prependMempoolTx(t));
    log("Mempool mis à jour","logOk");
  }catch(_){}
}

// wallet
function showAddr(addr){
  currentAddr=addr||"";
  $("walletAddr").value=currentAddr;
  $("addrShort").textContent=currentAddr?short(addr):"non connecté";
}
function short(a){
  if(!a||a.length<10)return a||"";
  return a.slice(0,4)+"…"+a.slice(-4);
}
async function loadWallet(){
  const addr=$("walletAddr").value.trim();
  if(!addr){alert("Adresse requise");return;}
  try{
    const w=await apiGET("/wallet?addr="+encodeURIComponent(addr));
    showAddr(addr);
    $("balPow").textContent=w.pow??0;
    $("balUsdc").textContent=w.usdc??0;
    $("balStaked").textContent=w.staked??0;
    if(w.stakeInfo){
      $("stakeInfo").textContent=w.stakeInfo;
    }else{
      $("stakeInfo").textContent="Staking: "+(w.staked||0)+" POW lock.";
    }
    log("Wallet chargé "+short(addr),"logOk");
  }catch(_){}
}

// Phantom (coté Solana, juste pour bridge; l’adresse Fireinners reste séparée)
async function connectPhantom(){
  try{
    const provider=window.solana;
    if(!provider||!provider.isPhantom){
      alert("Phantom non détecté sur cet appareil.");
      return;
    }
    const res=await provider.connect();
    const solAddr=res.publicKey.toString();
    log("Phantom connecté "+short(solAddr),"logOk");
  }catch(e){
    log("Erreur Phantom: "+e.message,"logErr");
  }
}

// génération d’une adresse locale Fireinners (affichage seulement, pas de clé privée)
function genLocalAddr(){
  const rand=crypto.getRandomValues(new Uint8Array(32));
  const hex=Array.from(rand).map(b=>b.toString(16).padStart(2,"0")).join("");
  const addr="FIRE"+hex.slice(0,36);
  log("Adresse locale générée "+addr,"logInfo");
  showAddr(addr);
}

// bridge, swap, staking : envoient une TX au backend
async function sendTx(tx){
  if(!currentAddr){
    alert("Charge d'abord un wallet Fireinners.");
    return;
  }
  tx.from=currentAddr;
  try{
    const res=await apiPOST("/tx",tx);
    log("TX envoyée "+(res.hash||res.id||"")+ " type "+tx.type,"logOk");
  }catch(_){}
}
async function doBridge(){
  const amt=parseFloat($("bridgeAmount").value);
  if(!amt||amt<=0){alert("Montant SOL invalide");return;}
  await sendTx({type:"bridge",amount:amt});
}
async function doSwap(){
  const amt=parseFloat($("dexAmount").value);
  if(!amt||amt<=0){alert("Montant invalide");return;}
  const side=$("dexSide").value;
  await sendTx({type:"swap",side,amount:amt});
}
async function doStake(){
  const amt=parseFloat($("stakeAmount").value);
  if(!amt||amt<=0){alert("Montant invalide");return;}
  await sendTx({type:"stake",amount:amt});
}
async function doUnstake(){
  const amt=parseFloat($("unstakeAmount").value);
  if(!amt||amt<=0){alert("Montant invalide");return;}
  await sendTx({type:"unstake",amount:amt});
}


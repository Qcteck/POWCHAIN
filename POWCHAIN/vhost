<style>
:root{
  --bg-main:#05030c;
  --bg-card:#12091d;
  --bg-card-soft:#1a1027;
  --accent:#ffb347;
  --accent-soft:#fbbf24;
  --accent-strong:#f97316;
  --border:#3f1f5a;
  --text-main:#f9fafb;
  --text-soft:#d1d5db;
  --danger:#f97373;
  --good:#22c55e;
}
html,body{margin:0;padding:0;background:radial-gradient(circle at top,#140521,#02010a);color:var(--text-main);font-family:system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh;overflow-x:hidden}

/* layout */
#app{display:flex;min-height:100vh}
#side{width:210px;background:#05010a;border-right:1px solid #261334;box-shadow:8px 0 30px #000a;padding:14px 10px;box-sizing:border-box}
#mainWrap{flex:1;display:flex;flex-direction:column}

/* logo + menu */
#brand{display:flex;align-items:center;gap:8px;margin-bottom:18px}
#brandIcon{width:30px;height:30px;border-radius:999px;background:conic-gradient(from 220deg,#fbbf24,#f97316,#a855f7,#fbbf24);box-shadow:0 0 16px #f97316aa}
#brandTitle{font-weight:700;letter-spacing:.13em;font-size:13px;text-transform:uppercase}
.menu-btn{width:100%;text-align:left;padding:7px 9px;margin-bottom:5px;border-radius:999px;border:1px solid transparent;font-size:12px;background:transparent;color:var(--text-soft);cursor:pointer;display:flex;align-items:center;justify-content:space-between}
.menu-btn span{flex:1}
.menu-btn.active{background:linear-gradient(90deg,#f97316,#fbbf24);color:#111827;font-weight:600;box-shadow:0 0 16px #f9731699}
.menu-btn:hover:not(.active){border-color:#4b1f73;color:#e5e7eb}

/* top bar */
#topBar{display:flex;align-items:center;justify-content:space-between;padding:10px 18px 4px 18px}
.badge{padding:4px 9px;border-radius:999px;font-size:11px;border:1px solid #4b1f73;background:#050814;color:var(--text-soft);display:inline-flex;align-items:center;gap:6px}

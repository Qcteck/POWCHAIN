const http = require("http");
const WebSocket = require("ws");

const PORT_HTTP = 3000;
const PORT_WS = 7001;

// ──────────────── STATE ────────────────
let chain = [];
let mempool = [];
let wallets = {};
let lpPow = 0;
let lpUsdc = 0;
let treasuryUsdc = 0;
let treasurySol = 0;

// ──────────────── HTTP API ────────────────
const api = http.createServer((req,res)=>{
  res.setHeader("Access-Control-Allow-Origin","*");
  res.setHeader("Content-Type","application/json");

  if(req.url==="/stats"){
    return res.end(JSON.stringify({height:chain.length,lpPow,lpUsdc,treasuryUsdc,treasurySol}));
  }
  if(req.url==="/chain"){
    return res.end(JSON.stringify(chain.slice(-30)));
  }
  if(req.url==="/mempool"){
    return res.end(JSON.stringify(mempool));
  }
  res.statusCode = 404;
  res.end(JSON.stringify({error:"Not found"}));
});
api.listen(PORT_HTTP,()=>console.log("HTTP OK",PORT_HTTP));

// ──────────────── WEBSOCKET ────────────────
const wss = new WebSocket.Server({ port: PORT_WS }, () =>
  console.log("WS OK", PORT_WS)
);

// envoi à tous
function broadcast(obj){
  const msg = JSON.stringify(obj);
  wss.clients.forEach(c=>{
    if(c.readyState===WebSocket.OPEN) c.send(msg);
  });
}

wss.on("connection", ws=>{
  ws.send(JSON.stringify({type:"WELCOME",height:chain.length}));

  ws.on("message", raw=>{
    try{
      const tx = JSON.parse(raw);

      // ajouter TX au mempool
      if(tx.type==="TX"){
        mempool.push(tx);
        broadcast({type:"NEW_TX",tx});
      }

      // faire un bloc à chaque TX
      if(tx.type==="TX"){
        const blk = {index:chain.length,time:Date.now(),tx};
        chain.push(blk);
        broadcast({type:"NEW_BLOCK",blk});
      }
    }catch(e){ console.log("WS err",e); }
  });
});



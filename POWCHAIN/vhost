  <script>
    const q = s => document.querySelector(s);
    const API = location.origin;
    const WS_URL = (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws";
    let ws = null;
    let statsTimer = null;
    let visitors = 0;

    function log(msg,type="info"){
      const el = q("#console");
      if(!el) return;
      const t = new Date().toLocaleTimeString("fr-CA",{hour12:false});
      const spanTime = `<span class="time">[${t}]</span>`;
      let cls = "";
      if(type==="ok") cls="ok";
      else if(type==="err") cls="err";
      else if(type==="ws") cls="ws";
      const spanMsg = `<span class="${cls}">${msg}</span>`;
      el.innerHTML = spanTime+" "+spanMsg+"<br/>"+el.innerHTML;
    }

    function setWS(status){
      const b = q("#wsBadge");
      if(!b) return;
      if(status){
        b.classList.add("online");
        b.innerHTML = "<span>Online</span>";
      }else{
        b.classList.remove("online");
        b.innerHTML = "<span>Offline</span>";
      }
    }

    function connectWS(){
      try{
        if(ws){ws.close();}
        ws = new WebSocket(WS_URL);
        ws.onopen = ()=>{ setWS(true); log("WS connecté "+WS_URL,"ws"); };
        ws.onclose = ()=>{ setWS(false); log("WS fermé – reconnexion dans 3s","ws"); setTimeout(connectWS,3000); };
        ws.onerror = ()=>{ setWS(false); log("Erreur WebSocket","err"); };
        ws.onmessage = ev=>{
          try{
            const data = JSON.parse(ev.data);
            if(data.type==="mempool" && q("#mempoolOut")){
              const ta = q("#mempoolOut");
              ta.value = JSON.stringify(data, null, 2) + "\n" + ta.value;
            }
            if(data.type==="statsUpdate"){ applyStats(data.stats); }
          }catch(e){
            log("WS msg: "+ev.data,"ws");
          }
        };
      }catch(e){
        log("WS fail: "+e.message,"err");
      }
    }

    async function fetchJSON(url,opts){
      const r = await fetch(url,opts);
      if(!r.ok) throw new Error("HTTP "+r.status);
      return await r.json();
    }

    function applyStats(s){
      if(!s) return;
      q("#statHeight").textContent = s.height ?? "-";
      q("#statWallets").textContent = s.wallets ?? "-";
      q("#statPow").textContent = (s.totalPow ?? 0).toFixed ? (s.totalPow).toFixed(4) : s.totalPow;
      q("#statUsdc").textContent = (s.usdcTreasury ?? 0).toString();
      q("#mainSubtitle").textContent = "Hauteur "+(s.height ?? "-")+" • Wallets "+(s.wallets ?? "-");
      q("#sHeight").textContent = s.height ?? "-";
      q("#sWallets").textContent = s.wallets ?? "-";
      q("#sMempool").textContent = s.mempool ?? "-";
      q("#sTotalPow").textContent = s.totalPow ?? "-";
      q("#sTotalStaked").textContent = s.totalStaked ?? "-";
      q("#sLpPow").textContent = s.lpPow ?? "-";
      q("#sLpUsdc").textContent = s.lpUsdc ?? "-";
      q("#sSolTreasury").textContent = s.solTreasury ?? "-";
      q("#sUsdcTreasury").textContent = s.usdcTreasury ?? "-";
      q("#sFireTreasury").textContent = s.fireTreasury ?? "-";
      if(typeof s.priceFire === "number"){
        q("#pFIRE").textContent = s.priceFire.toFixed(6)+" $";
      }
      if(typeof s.miningDiff === "number"){
        q("#miningDiff").textContent = s.miningDiff;
      }
    }

    async function refreshStats(){
      try{
        const s = await fetchJSON(API+"/stats");
        applyStats(s);
        log("Stats mises à jour","ok");
      }catch(e){
        log("Stats FAIL: "+e.message,"err");
      }
    }

    function startStatsLoop(){
      if(statsTimer) clearInterval(statsTimer);
      statsTimer = setInterval(refreshStats, 15000);
    }

    async function loadPrices(){
      try{
        const url = "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd";
        const j = await fetchJSON(url);
        const btc = j.bitcoin?.usd ?? 0;
        const eth = j.ethereum?.usd ?? 0;
        const sol = j.solana?.usd ?? 0;
        const sui = j.sui?.usd ?? 0;
        q("#pBTC").textContent = btc.toFixed(0);

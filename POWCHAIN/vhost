<script>
// ---------- utilitaires ----------
const logBox=document.getElementById("console");
function log(msg){
  const t=new Date();const h=String(t.getHours()).padStart(2,"0");
  const m=String(t.getMinutes()).padStart(2,"0");
  const s=String(t.getSeconds()).padStart(2,"0");
  logBox.textContent+=`[${h}h ${m} min ${s} s] ${msg}\n`;
  logBox.scrollTop=logBox.scrollHeight;
}
function $(id){return document.getElementById(id)}
// ---------- navigation ----------
document.querySelectorAll(".nav-btn").forEach(btn=>{
  btn.onclick=()=>{
    document.querySelectorAll(".nav-btn").forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    const v=btn.dataset.view;
    document.querySelectorAll(".section").forEach(sec=>{
      sec.classList.toggle("active",sec.id==="view-"+v);
    });
  };
});
// ---------- thème ----------
const body=document.body;
const savedTheme=localStorage.getItem("fire_theme");
if(savedTheme==="light")body.classList.replace("theme-dark","theme-light");
$("btnTheme").onclick=()=>{
  if(body.classList.contains("theme-dark")){
    body.classList.replace("theme-dark","theme-light");
    localStorage.setItem("fire_theme","light");
  }else{
    body.classList.replace("theme-light","theme-dark");
    localStorage.setItem("fire_theme","dark");
  }
};
// ---------- WS ----------
let ws;
let wsClients=0;
function connectWS(){
  try{
    const proto=location.protocol==="https:"?"wss":"ws";
    const url=`${proto}://${location.host}/ws`;
    ws=new WebSocket(url);
    ws.onopen=()=>{ $("wsStatus").classList.remove("off");$("wsStatus").classList.add("ok");$("wsStatus").textContent="WS : online";log("WS connecté");};
    ws.onclose=()=>{ $("wsStatus").classList.remove("ok");$("wsStatus").classList.add("off");$("wsStatus").textContent="WS : offline";log("WS fermé, reconnexion dans 3s...");setTimeout(connectWS,3000);};
    ws.onerror=()=>{log("WS erreur.");};
    ws.onmessage=ev=>{
      try{
        const msg=JSON.parse(ev.data);
        if(msg.type==="mempool")$("mempool").textContent=JSON.stringify(msg.mempool,null,2);
        if(msg.type==="new_block"){
          const cur=$("blocks").textContent||"";
          $("blocks").textContent=JSON.stringify(msg.block,null,2)+"\n\n"+cur;
        }
        if(msg.type==="clients"){
          wsClients=msg.count||0;
          $("wsClients").textContent=wsClients;
        }
      }catch(e){}
    };
  }catch(e){log("WS init ERR : "+e.message);}
}
connectWS();

// ---------- Wallet FIREINNERS ----------
const TREASURY_SOL="BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";
$("treasurySol").textContent=TREASURY_SOL;
function randomInt(max){return Math.floor(Math.random()*max)+1}
function randomItem(arr){return arr[Math.floor(Math.random()*arr.length)]}
const letters="ABCDEFGHIJKLMNOPQRSTUVWXYZ";
const colors=["vert","or","blanc","noir","rouge","argent","mauve","orange","gris","jaune","violet"];
function genFireName(){
  const n=randomInt(1e8); // 1 à 100 millions approx
  const A=randomItem(letters),B=randomItem(letters),C=randomItem(letters),D=randomItem(letters);
  const colorRoll=Math.random()*100;
  let color="couleur";
  if(colorRoll<3)color="multicolore";
  else if(colorRoll<5)color="army";
  else color=randomItem(colors);
  return `441-FIRE-${A}${B}${C}${D}/INNERS/${D}${C}${B}${A}/A${n}/${color}`;
}
function genWallet(){
  // wallet local purement symbolique (pas crypto réelle)
  const addr="FIRE"+Math.random().toString(36).slice(2,10).toUpperCase();
  const priv="PVT"+Math.random().toString(36).slice(2,18).toUpperCase();
  $("fiAddr").value=addr;
  $("fiPriv").value=priv;
  $("fiName").textContent=genFireName();
  log("Nouveau wallet FIREINNERS généré.");
}
$("btnGenWallet").onclick=genWallet;
$("btnSaveWallet").onclick=()=>{
  if(!$("fiAddr").value){log("Aucun wallet à sauvegarder.");return;}
  localStorage.setItem("fire_wallet",JSON.stringify({
    addr:$("fiAddr").value,priv:$("fiPriv").value,name:$("fiName").textContent
  }));
  log("Wallet FIREINNERS sauvegardé dans localStorage.");
};
$("btnLoadWallet").onclick=()=>{
  const raw=localStorage.getItem("fire_wallet");
  if(!raw){log("Aucun wallet FIREINNERS sauvegardé.");return;}
  try{
    const w=JSON.parse(raw);
    $("fiAddr").value=w.addr||"";
    $("fiPriv").value=w.priv||"";
    $("fiName").textContent=w.name||"";
    log("Wallet FIREINNERS rechargé depuis localStorage");
  }catch(e){log("Erreur de lecture wallet FIREINNERS.");}
};
$("btnLoadWallet").click();

// ---------- QR trésorerie ----------
(function(){
  const c=$("qrTreasury");
  const ctx=c.getContext("2d");
  c.width=c.height=240;
  ctx.fillStyle="#0f172a";ctx.fillRect(0,0,c.width,c.height);
  ctx.fillStyle="#e5e7eb";
  for(let y=0;y<21;y++){
    for(let x=0;x<21;x++){
      if(Math.random()>0.5)ctx.fillRect(10+x*10,10+y*10,8,8);
    }
  }
})();

// ---------- Phantom + Sol ----------
let phantomPub=null;
const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
async function refreshSol(){
  if(!phantomPub)return;
  try{
    const conn=new solanaWeb3.Connection(SOL_RPC,"confirmed");
    const pk=new solanaWeb3.PublicKey(phantomPub);
    const bal=await conn.getBalance(pk);
    $("solBal").textContent=(bal/1e9).toFixed(4);
  }catch(e){log("Sol ERR : "+e.message);}
}
async function refreshFire(){
  if(!$("fiAddr").value)return;
  try{
    const res=await fetch("/api/wallet/"+encodeURIComponent($("fiAddr").value));
    const j=await res.json();
    $("fireBal").textContent=(j.pow/1e6).toFixed(4);
    $("usdcBal").textContent=(j.usdc/1e6).toFixed(4);
  }catch(e){log("Fire ERR : "+e.message);}
}
$("btnConnect").onclick=async()=>{
  try{
    if(!window.solana||!window.solana.isPhantom){alert("Phantom non détecté.");return;}
    const resp=await window.solana.connect();
    phantomPub=resp.publicKey.toString();
    $("phantomAddr").textContent=phantomPub;
    log("Phantom connecté : "+phantomPub);
    refreshSol();
  }catch(e){log("Phantom ERR : "+e.message);}
};

// ---------- API helpers ----------
async function api(path,opts){
  const r=await fetch("/api"+path,opts||{});
  if(!r.ok)throw new Error("HTTP "+r.status);
  return r.json();
}

// ---------- Bridge ----------
$("btnSendSol").onclick=async()=>{
  try{
    if(!phantomPub){alert("Connecte Phantom d'abord.");return;}
    const amt=parseFloat($("bridgeAmt").value||"0");
    if(!(amt>0)){alert("Montant invalide.");return;}
    const conn=new solanaWeb3.Connection(SOL_RPC,"confirmed");
    const from=new solanaWeb3.PublicKey(phantomPub);
    const to=new solanaWeb3.PublicKey(TREASURY_SOL);
    const tx=new solanaWeb3.Transaction().add(
      solanaWeb3.SystemProgram.transfer({
        fromPubkey:from,toPubkey:to,lamports:Math.round(amt*1e9)
      })
    );
    tx.feePayer=from;
    tx.recentBlockhash=(await conn.getLatestBlockhash()).blockhash;
    const signed=await window.solana.signAndSendTransaction(tx);
    $("bridgeSig").value=signed.signature;
    log("Bridge SOL envoyé, signature : "+signed.signature);
  }catch(e){log("Bridge Phantom ERR : "+e.message);}
};
$("btnDeclareBridge").onclick=async()=>{
  try{
    if(!$("fiAddr").value){alert("Génère/charge un wallet FIREINNERS d'abord.");return;}
    const amt=parseFloat($("bridgeAmt").value||"0");
    const sig=$("bridgeSig").value.trim();
    if(!(amt>0)||!sig){alert("Montant ou signature manquants.");return;}
    const res=await api("/bridge",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({addr:$("fiAddr").value,amount:amt,fromSol:phantomPub,txSig:sig})
    });
    if(!res.ok){log("Bridge backend rejeté : "+res.error);alert("Bridge rejeté : "+res.error);return;}
    log("Bridge crédité : "+(res.credited/1e6).toFixed(4)+" FIRE");
    refreshFire();
  }catch(e){log("Bridge backend ERR : "+e.message);}
};

// ---------- Stats + explorer refresh ----------
async function refreshStats(){
  try{
    const s=await api("/stats");
    $("statsBox").textContent=JSON.stringify(s,null,2);
  }catch(e){log("Stats ERR : "+e.message);}
}
async function refreshChain(){
  try{
    const c=await api("/chain");
    $("blocks").textContent=JSON.stringify(c.slice(-10).reverse(),null,2);
    const m=await api("/mempool");
    $("mempool").textContent=JSON.stringify(m,null,2);
  }catch(e){}
}
setInterval(()=>{refreshStats();refreshFire();refreshChain();},10000);
refreshStats();refreshChain();refreshFire();
</script>

// FIREINNERS / POWCHAIN — Validator HTTP + WebSocket

const express = require("express");
const http = require("http");
const WebSocket = require("ws");
const crypto = require("crypto");

const PORT_HTTP = 3000;
const PORT_WS   = 7001;

const TREASURY_ADDR = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";
const BLOCK_TIME_MS = 8000;
const FEE_BPS = 30;
const BRIDGE_MULTIPLIER_SOL  = 1000;
const BRIDGE_MULTIPLIER_USDC = 100;

let chain = [];
let wallets = {}; // addr -> {pow,usdc,staked,nonce}
let lpPow = 0;
let lpUsdc = 0;
let treasuryPow = 0;
let treasuryUsdc = 0;
let mempool = [];
let lastBlockTs = Date.now();

function getWallet(addr) {
  if (!wallets[addr]) wallets[addr] = { pow: 0, usdc: 0, staked: 0, nonce: 0 };
  return wallets[addr];
}

function hashBlock(b) {
  const payload = JSON.stringify({
    index: b.index,
    ts: b.ts,
    prevHash: b.prevHash,
    txs: b.txs,
    lpPow: b.lpPow,
    lpUsdc: b.lpUsdc,
    treasuryPow: b.treasuryPow,
    treasuryUsdc: b.treasuryUsdc
  });
  return crypto.createHash("sha256").update(payload).digest("hex");
}

function createGenesis() {
  const g = {
    index: 0,
    ts: Date.now(),
    prevHash: "0".repeat(64),
    hash: "",
    txs: [],
    lpPow: 0,
    lpUsdc: 0,
    treasuryPow: 0,
    treasuryUsdc: 0,
    price: 0
  };
  g.hash = hashBlock(g);
  chain.push(g);
}

function currentPrice() {
  if (lpPow <= 0 || lpUsdc <= 0) return 0;
  return lpUsdc / lpPow;
}

// TX handlers
function applySendTx(from, to, amount) {
  if (!from || !to) throw new Error("Adresse manquante");
  amount = Number(amount || 0);
  if (amount <= 0) throw new Error("Montant invalide");
  const wf = getWallet(from);
  const wt = getWallet(to);
  if (wf.pow < amount) throw new Error("Balance POW insuffisante");
  wf.pow -= amount;
  wt.pow += amount;
}

function applyStakeTx(addr, amount) {
  amount = Number(amount || 0);
  if (amount <= 0) throw new Error("Montant invalide");
  const w = getWallet(addr);
  if (w.pow < amount) throw new Error("Balance POW insuffisante");
  w.pow -= amount;
  w.staked += amount;
}

function applyAddLp(addr, powAmt, usdcAmt) {
  powAmt = Number(powAmt || 0);
  usdcAmt = Number(usdcAmt || 0);
  if (powAmt <= 0 || usdcAmt <= 0) throw new Error("Montants LP invalides");
  const w = getWallet(addr);
  if (w.pow < powAmt || w.usdc < usdcAmt) throw new Error("Balance insuffisante");
  w.pow -= powAmt;
  w.usdc -= usdcAmt;
  lpPow  += powAmt;
  lpUsdc += usdcAmt;
}

function applySwap(addr, amount, dir) {
  amount = Number(amount || 0);
  if (amount <= 0) throw new Error("Montant invalide");
  const w = getWallet(addr);
  if (lpPow <= 0 || lpUsdc <= 0) throw new Error("Pas de LP");

  const k = lpPow * lpUsdc;
  let out, fee;
  if (dir === "POW_USDC") {
    if (w.pow < amount) throw new Error("POW insuffisant");
    const newLpPow = lpPow + amount;
    const newLpUsdc = k / newLpPow;
    out = lpUsdc - newLpUsdc;
    fee = (out * FEE_BPS) / 10000;
    out -= fee;
    if (out <= 0) throw new Error("Sortie nulle");
    w.pow -= amount;
    w.usdc += out;
    lpPow  = newLpPow;
    lpUsdc = newLpUsdc + fee;
    treasuryUsdc += fee;
  } else if (dir === "USDC_POW") {
    if (w.usdc < amount) throw new Error("USDC POW insuffisant");
    const newLpUsdc = lpUsdc + amount;
    const newLpPow = k / newLpUsdc;
    out = lpPow - newLpPow;
    fee = (out * FEE_BPS) / 10000;
    out -= fee;
    if (out <= 0) throw new Error("Sortie nulle");
    w.usdc -= amount;
    w.pow  += out;
    lpUsdc = newLpUsdc;
    lpPow  = newLpPow + fee;
    treasuryPow += fee;
  } else {
    throw new Error("Direction inconnue");
  }
  return out;
}

function applyBridge(addrPow, asset, amount, fromSol) {
  amount = Number(amount || 0);
  if (amount <= 0) throw new Error("Montant invalide");
  const w = getWallet(addrPow);
  let minted = 0;
  if (asset === "SOL")  minted = amount * BRIDGE_MULTIPLIER_SOL;
  else if (asset === "USDC") minted = amount * BRIDGE_MULTIPLIER_USDC;
  else throw new Error("Asset inconnu");
  w.pow += minted;
  const fee = minted * 0.01;
  w.pow -= fee;
  treasuryPow += fee;
  return minted - fee;
}

function globalState() {
  return {
    height: chain.length - 1,
    tvlUsdc: lpUsdc,
    price: currentPrice(),
    lpPow,
    lpUsdc,
    treasuryPow,
    treasuryUsdc
  };
}

function sanitizeBlock(b) {
  return {
    index: b.index,
    ts: b.ts,
    txs: b.txs.map(t => ({
      kind: t.kind,
      from: t.from || null,
      to: t.to || null,
      amount: Number(t.amount || 0),
      asset: t.asset || null
    })),
    lpPow: b.lpPow,
    lpUsdc: b.lpUsdc,
    treasuryPow: b.treasuryPow,
    treasuryUsdc: b.treasuryUsdc,
    price: b.price
  };
}

function produceBlock() {
  if (Date.now() - lastBlockTs < BLOCK_TIME_MS) return;
  lastBlockTs = Date.now();
  const last = chain[chain.length - 1];
  const b = {
    index: last.index + 1,
    ts: Date.now(),
    prevHash: last.hash,
    txs: mempool,
    lpPow,
    lpUsdc,
    treasuryPow,
    treasuryUsdc,
    price: currentPrice()
  };
  b.hash = hashBlock(b);
  chain.push(b);
  mempool = [];
  broadcast({ type: "BLOCK", block: sanitizeBlock(b) });
}

// HTTP API
const app = express();
app.use(express.json());

app.get("/stats", (req, res) => {
  res.json(globalState());
});

app.get("/wallet/:addr", (req, res) => {
  const w = getWallet(req.params.addr);
  res.json({ addr: req.params.addr, ...w });
});

app.get("/chain", (req, res) => {
  res.json(chain.map(sanitizeBlock));
});

app.get("/lp", (req, res) => {
  res.json({ lpPow, lpUsdc, price: currentPrice() });
});

// WS
const server = http.createServer(app);
const wss = new WebSocket.Server({ port: PORT_WS });

let clients = new Set(); // {ws,addr}

function broadcast(obj) {
  const payload = JSON.stringify(obj);
  for (const c of clients) {
    if (c.ws.readyState === WebSocket.OPEN) c.ws.send(payload);
  }
}

wss.on("connection", ws => {
  const c = { ws, addr: null };
  clients.add(c);
  ws.send(JSON.stringify({ type: "STATE", state: globalState() }));
  ws.on("close", () => { clients.delete(c); });
  ws.on("message", data => {
    let msg;
    try { msg = JSON.parse(data.toString()); }
    catch { return ws.send(JSON.stringify({ type: "ERR", error: "JSON invalide" })); }

    try {
      if (msg.type === "HELLO") {
        if (typeof msg.addr !== "string" || msg.addr.length < 10) throw new Error("Adresse invalide");
        c.addr = msg.addr;
        const w = getWallet(c.addr);
        ws.send(JSON.stringify({ type: "STATE", state: globalState(), wallet: w, lp: { lpPow, lpUsdc, price: currentPrice() } }));
        console.log("HELLO", c.addr);
      } else if (msg.type === "TX_SEND") {
        if (!c.addr) throw new Error("HELLO requis");
        applySendTx(c.addr, msg.to, msg.amount);
        mempool.push({ kind: "SEND", from: c.addr, to: msg.to, amount: Number(msg.amount||0) });
        ws.send(JSON.stringify({ type: "TX_INFO", kind: "SEND", info: "Envoyé "+msg.amount+" POW à "+msg.to }));
      } else if (msg.type === "TX_STAKE") {
        if (!c.addr) throw new Error("HELLO requis");
        applyStakeTx(c.addr, msg.amount);
        mempool.push({ kind: "STAKE", from: c.addr, to: TREASURY_ADDR, amount: Number(msg.amount||0) });
        ws.send(JSON.stringify({ type: "TX_INFO", kind: "STAKE", info: "Staké "+msg.amount+" POW" }));
      } else if (msg.type === "TX_ADD_LP") {
        if (!c.addr) throw new Error("HELLO requis");
        applyAddLp(c.addr, msg.pow, msg.usdc);
        mempool.push({ kind: "ADD_LP", from: c.addr, to: "LP_POOL", amount: Number(msg.pow||0), asset: "POW/USDC" });
        ws.send(JSON.stringify({ type: "TX_INFO", kind: "ADD_LP", info: "LP ajouté" }));
      } else if (msg.type === "TX_SWAP") {
        if (!c.addr) throw new Error("HELLO requis");
        const out = applySwap(c.addr, msg.amount, msg.dir);
        mempool.push({ kind: "SWAP", from: c.addr, to: "DEX", amount: Number(msg.amount||0), asset: msg.dir });
        ws.send(JSON.stringify({ type: "TX_INFO", kind: "SWAP", info: "Swap OK, sortie ≈ "+out.toFixed(6) }));
      } else if (msg.type === "BRIDGE_REQUEST") {
        if (!c.addr) throw new Error("HELLO requis");
        if (c.addr !== msg.toPow) throw new Error("toPow ne correspond pas au HELLO");
        const minted = applyBridge(msg.toPow, msg.asset, msg.amount, msg.fromSol);
        mempool.push({ kind: "BRIDGE", from: msg.fromSol, to: msg.toPow, amount: minted, asset: msg.asset });
        ws.send(JSON.stringify({ type: "BRIDGE_OK", addr: msg.toPow, amount: minted, asset: "POW" }));
      } else {
        throw new Error("Type inconnu");
      }
    } catch (e) {
      ws.send(JSON.stringify({ type: "ERR", error: e.message }));
    }
  });
});

// boucle bloc
setInterval(() => {
  try { produceBlock(); } catch(e) { console.error("Erreur bloc", e); }
}, 2000);

// lancement
createGenesis();
server.listen(PORT_HTTP, () => {
  console.log("HTTP FIREINNERS sur", PORT_HTTP);
});
console.log("WS FIREINNERS sur", PORT_WS);
console.log("Genesis:", chain.length, "bloc");







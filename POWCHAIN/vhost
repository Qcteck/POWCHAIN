server {
    listen 80;
    listen [::]:80;
    server_name bbqfinance.fun www.bbqfinance.fun;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bbqfinance.fun www.bbqfinance.fun;

    # IMPORTANT : le bon dossier
    root /var/www/bbqfinance.fun;
    index index.html;

    # SSL LETSENCRYPT
    ssl_certificate     /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # FRONTEND
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API FIREINNERS / POWCHAIN (Node.js)
    location /stats {
        proxy_pass http://127.0.0.1:3000/stats;
        proxy_set_header Host $host;
    }

    location /wallet {
        proxy_pass http://127.0.0.1:3000/wallet;
        proxy_set_header Host $host;
    }

    location /bridge {
        proxy_pass http://127.0.0.1:3000/bridge;
        proxy_set_header Host $host;
    }

    location /block {
        proxy_pass http://127.0.0.1:3000/block;
        proxy_set_header Host $host;
    }

    # WebSocket
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }
}





function signTx(o){
  const payload={
    type:o.type,
    from:o.from??addr,
    to:o.to??null,
    amount:o.amount??null,
    token:o.token??null,
    nonce:nonce+1
  };
  const msg=new TextEncoder().encode(JSON.stringify(payload));
  const sk=b58decode(priv);
  const sig=nacl.sign.detached(msg,sk);
  return b58encode(sig);
}

async function loadWallet(){
  addr=q("#walletAddr").value.trim();
  priv=q("#walletPriv").value.trim();
  if(!addr||!priv){
    alert("Adresse + clé privée requises");
    return;
  }
  const r=await jget("/wallet/"+addr);
  nonce=r.nonce||0;
  pub=r.pub||addr;
  q("#wpow").textContent=fmt(r.pow||0);
  q("#wusdc").textContent=fmt(r.usdc||0);
  q("#wstk").textContent=fmt(r.staked||0);
  log("Wallet POWCHAIN chargé "+addr);
}


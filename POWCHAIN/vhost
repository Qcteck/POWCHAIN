cd /root
nano setup_fireinners.sh


#!/bin/bash
set -e

echo "=== 1) MàJ et paquets de base ==="
apt update
apt install -y nginx nodejs npm

echo "=== 2) PM2 global ==="
npm install -g pm2

echo "=== 3) HTML Fireinners ==="
mkdir -p /var/www/html
cat >/var/www/html/index.html <<'EOF'
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>🔥Fireinners</title>
<style>
body{margin:0;background:#0a0015;color:#ffd;padding:0;font-family:Arial}
#topbar{background:#220044;padding:10px;color:#fff;font-size:20px;text-align:center}
#menu{width:180px;background:#150020;height:100vh;position:fixed;top:0;left:0;padding:10px}
#menu button{width:100%;margin:5px 0;padding:8px;border:0;background:#550088;color:#fff;border-radius:6px;font-weight:bold;cursor:pointer}
#content{margin-left:200px;padding:20px}
.box{background:#220044;padding:15px;border-radius:8px;margin-bottom:20px}
</style>
</head>
<body>

<div id="topbar">🔥 FIREINNERS — Online</div>

<div id="menu">
<button onclick="showTab('wallet')">Wallet</button>
<button onclick="showTab('bridge')">Bridge</button>
<button onclick="showTab('stats')">Stats</button>
<button onclick="openBrowser()">🔥 FIREBROWSER</button>
</div>

<div id="content">

<div id="wallet" class="tab box">
<h2>Wallet Fireinners</h2>
<button onclick="genWallet()">Générer wallet</button>
<div id="fwallet"></div>
</div>

<div id="bridge" class="tab box" style="display:none">
<h2>Bridge</h2>
Montant : <input id="amt" value="0.1"><br>
<button onclick="sendBridge()">Envoyer (via Phantom)</button>
</div>

<div id="stats" class="tab box" style="display:none">
<h2>Statistiques</h2>
<div id="statbox"></div>
</div>

<div class="box">
<h3>Console</h3>
<div id="log" style="white-space:pre-line;height:150px;overflow:auto;background:#0002;padding:10px"></div>
</div>

</div>

<script>
function log(x){const l=document.getElementById("log");l.textContent+="\n"+x;l.scrollTop=l.scrollHeight;}

function showTab(id){
  document.querySelectorAll(".tab").forEach(t=>t.style.display="none");
  document.getElementById(id).style.display="block";
}

// WebSocket
let ws;
function connectWS(){
  ws=new WebSocket("wss://bbqfinance.fun/ws");
  ws.onopen = ()=>log("WS connecté");
  ws.onerror= ()=>log("WS erreur");
  ws.onclose= ()=>{log("WS fermé, reconnexion dans 3s...");setTimeout(connectWS,3000);};
  ws.onmessage=(m)=>log("WS → "+m.data);
}
connectWS();

// API status
async function refreshStats(){
  try{
    const r=await fetch("/api/status").then(x=>x.json());
    document.getElementById("statbox").innerHTML=
      "Visiteurs : "+r.visitors+"<br>Last bridge : "+JSON.stringify(r.lastBridge);
  }catch(e){log("Stats ERR : "+e.message);}
}
setInterval(refreshStats,4000);

// Wallet Fireinners simple
function genWallet(){
  const num=Math.floor(Math.random()*100000000)+1;
  const id="FIRE-"+num;
  document.getElementById("fwallet").textContent=id;
  log("Wallet Fireinners généré : "+id);
}

// Bridge (mock pour l’instant)
function sendBridge(){
  log("Bridge demandé : "+document.getElementById("amt").value+" SOL");
}

// FIREBROWSER
function openBrowser(){
  window.open("https://duckduckgo.com","_blank");
}
</script>

</body>
</html>
EOF

echo "=== 4) Backend Node server.js ==="
cat >/root/server.js <<'EOF'
const express=require("express");
const cors=require("cors");
const bodyParser=require("body-parser");
const {WebSocketServer}=require("ws");

const app=express();
app.use(cors());
app.use(bodyParser.json());

let visitors=0;
let lastBridge=null;

app.get("/api/visitors",(req,res)=>{ visitors++; res.json({visitors}); });

app.get("/api/status",(req,res)=>{
  visitors++;
  res.json({ ok:true, visitors, lastBridge });
});

const wss=new WebSocketServer({ port:7001 });
wss.on("connection",(ws)=>{
  ws.send(JSON.stringify({type:"hello",msg:"WS connecté au backend"}));
});

console.log("WS sur ws://0.0.0.0:7001");
console.log("HTTP sur http://0.0.0.0:3000");
app.listen(3000);
EOF

echo "=== 5) Dépendances Node ==="
cd /root
if [ ! -f package.json ]; then
  npm init -y >/dev/null 2>&1
fi
npm install express cors body-parser ws

echo "=== 6) NGINX vhost bbqfinance ==="
cat >/etc/nginx/sites-available/bbqfinance.conf <<'EOF'
server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name bbqfinance.fun www.bbqfinance.fun;

    ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;

    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3000/;
    }

    location /ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }
}
EOF

ln -sf /etc/nginx/sites-available/bbqfinance.conf /etc/nginx/sites-enabled/bbqfinance.conf

echo "=== 7) Pare-feu (optionnel) ==="
ufw allow 80/tcp || true
ufw allow 443/tcp || true

echo "=== 8) Test & restart NGINX ==="
nginx -t
systemctl restart nginx

echo "=== 9) PM2 : fireinners ==="
pm2 delete fireinners || true
pm2 start /root/server.js --name fireinners
pm2 save

echo "=== OK ==="
echo "Front : https://bbqfinance.fun"
echo "Status API : https://bbqfinance.fun/api/status"





chmod +x setup_fireinners.sh
./setup_fireinners.sh



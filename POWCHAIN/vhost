// server.js – POWCHAIN validator + HTTP API + WebSocket
// Ports
const PORT_HTTP = 3000;
const PORT_WS   = 7001;

// Librairies
const http  = require("http");
const url   = require("url");
const fs    = require("fs");
const crypto = require("crypto");
const WebSocket = require("ws");
const nacl  = require("tweetnacl");
const bs58  = require("bs58");

// Fichier de persistance
const LEDGER_FILE = "/root/powchain/ledger.json";

// Adresse trésorerie POWCHAIN (déjà connue, pas générée ici)
const TREASURY_ADDR = "BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy";

// ------------ ÉTAT GLOBAL ------------

let state = {
  chain: [],
  wallets: {},
  lpPow: 0,
  lpUsdc: 0,
  treasurySol: 0,
  treasuryPow: 0,
  treasuryUsdc: 0,
  mempool: []
};

// Wallet helper
function getWallet(addr) {
  if (!state.wallets[addr]) {
    state.wallets[addr] = { pow: 0, usdc: 0, staked: 0, pub: null, nonce: 0 };
  }
  return state.wallets[addr];
}

// Persistance
function loadLedger() {
  try {
    const raw = fs.readFileSync(LEDGER_FILE, "utf8");
    const data = JSON.parse(raw);
    state = data;
    console.log("✅ Ledger chargé, height =", state.chain.length);
  } catch (e) {
    console.log("⚠️ Aucun ledger trouvé, création genesis...");
    const genesis = {
      index: 0,
      time: Date.now(),
      prevHash: "0".repeat(64),
      hash: "",
      txs: [],
      treasuryPow: 0,
      treasuryUsdc: 0,
      lpPow: 0,
      lpUsdc: 0
    };
    genesis.hash = hashBlock(genesis);
    state.chain = [genesis];
    state.wallets = {};
    state.lpPow = 0;
    state.lpUsdc = 0;
    state.treasuryPow = 0;
    state.treasuryUsdc = 0;
    state.treasurySol = 0;
    saveLedger();
  }
}

function saveLedger() {
  try {
    fs.writeFileSync(LEDGER_FILE, JSON.stringify(state, null, 2));
  } catch (e) {
    console.error("❌ Erreur saveLedger:", e.message);
  }
}

// Hashage
function hashBlock(b) {
  const clone = {
    index: b.index,
    time: b.time,
    prevHash: b.prevHash,
    txs: b.txs,
    treasuryPow: b.treasuryPow,
    treasuryUsdc: b.treasuryUsdc,
    lpPow: b.lpPow,
    lpUsdc: b.lpUsdc
  };
  return crypto.createHash("sha256").update(JSON.stringify(clone)).digest("hex");
}

function hashTx(tx) {
  const min = {
    type: tx.type,
    from: tx.from || null,
    to: tx.to || null,
    amount: tx.amount || null,
    token: tx.token || null,
    nonce: tx.nonce || 0
  };
  return crypto.createHash("sha256").update(JSON.stringify(min)).digest("hex");
}

// ------------ VÉRIFICATION SIGNATURE ------------

function verifySignature(tx) {
  try {
    if (!tx.pub || !tx.sig) return false;
    const pub = bs58.decode(tx.pub);
    const sig = bs58.decode(tx.sig);
    const msgObj = {
      type: tx.type,
      from: tx.from,
      to: tx.to ?? null,
      amount: tx.amount ?? null,
      token: tx.token ?? null,
      nonce: tx.nonce
    };
    const msg = new TextEncoder().encode(JSON.stringify(msgObj));
    return nacl.sign.detached.verify(msg, sig, pub);
  } catch (e) {
    console.error("❌ verifySignature:", e.message);
    return false;
  }
}

// ------------ LOGIQUE POWCHAIN ------------

// Appliquer une transaction au state (sans signatures, déjà vérifiées)
function applyTx(tx) {
  const type = tx.type;
  const from = tx.from;
  const to   = tx.to;
  const amount = Number(tx.amount || 0);
  const token  = tx.token || "POW";

  if (!Number.isFinite(amount) || amount <= 0) throw new Error("Montant invalide");

  // Bridge simplifié : SOL/USDC externe → POWCHAIN
  if (type === "BRIDGE_IN") {
    // créditer POW ou USDC POW à from
    const w = getWallet(from);
    if (token === "POW") w.pow += amount;
    else if (token === "USDC") w.usdc += amount;
    else throw new Error("Token bridge inconnu");
    state.treasurySol += amount; // trace seulement
    return;
  }

  // Bridge vers Solana : débiter POWCHAIN, juste pour cohérence
  if (type === "BRIDGE_OUT") {
    const w = getWallet(from);
    if (token === "POW") {
      if (w.pow < amount) throw new Error("Solde POW insuffisant");
      w.pow -= amount;
    } else if (token === "USDC") {
      if (w.usdc < amount) throw new Error("Solde USDC POW insuffisant");
      w.usdc -= amount;
    } else throw new Error("Token bridge inconnu");
    state.treasurySol -= amount; // trace seulement
    return;
  }

  // Transfert POWCHAIN interne
  if (type === "TRANSFER") {
    const wf = getWallet(from);
    const wt = getWallet(to);
    if (token === "POW") {
      if (wf.pow < amount) throw new Error("Solde POW insuffisant");
      wf.pow -= amount;
      wt.pow += amount;
    } else if (token === "USDC") {
      if (wf.usdc < amount) throw new Error("Solde USDC insuffisant");
      wf.usdc -= amount;
      wt.usdc += amount;
    } else throw new Error("Token inconnu");
    return;
  }

  // Staking
  if (type === "STAKE") {
    const w = getWallet(from);
    if (w.pow < amount) throw new Error("Solde POW insuffisant");
    w.pow -= amount;
    w.staked += amount;
    return;
  }

  if (type === "UNSTAKE") {
    const w = getWallet(from);
    if (w.staked < amount) throw new Error("Stake insuffisant");
    w.staked -= amount;
    w.pow += amount;
    return;
  }

  // Liquidity provider POW/USDC POW (x*y=k)
  if (type === "ADD_LP") {
    const w = getWallet(from);
    if (w.pow < amount || w.usdc < amount) throw new Error("Solde LP insuffisant");
    w.pow -= amount;
    w.usdc -= amount;
    state.lpPow += amount;
    state.lpUsdc += amount;
    // petit fee vers trésorerie
    const fee = amount * 0.001;
    state.treasuryPow += fee;
    state.treasuryUsdc += fee;
    return;
  }

  if (type === "SWAP") {
    // token = "POW->USDC" ou "USDC->POW"
    if (state.lpPow <= 0 || state.lpUsdc <= 0) throw new Error("Pool LP vide");
    const w = getWallet(from);

    const feeRate = 0.003; // 0.3%
    if (token === "POW->USDC") {
      if (w.pow < amount) throw new Error("Solde POW insuffisant");
      const amountAfterFee = amount * (1 - feeRate);
      const k = state.lpPow * state.lpUsdc;
      const newLpPow = state.lpPow + amountAfterFee;
      const newLpUsdc = k / newLpPow;
      const outUsdc = state.lpUsdc - newLpUsdc;
      if (outUsdc <= 0) throw new Error("Swap impossible");
      w.pow -= amount;
      w.usdc += outUsdc;
      state.lpPow = newLpPow;
      state.lpUsdc = newLpUsdc;
      state.treasuryPow += amount * feeRate;
      return;
    }

    if (token === "USDC->POW") {
      if (w.usdc < amount) throw new Error("Solde USDC insuffisant");
      const amountAfterFee = amount * (1 - feeRate);
      const k = state.lpPow * state.lpUsdc;
      const newLpUsdc = state.lpUsdc + amountAfterFee;
      const newLpPow = k / newLpUsdc;
      const outPow = state.lpPow - newLpPow;
      if (outPow <= 0) throw new Error("Swap impossible");
      w.usdc -= amount;
      w.pow += outPow;
      state.lpPow = newLpPow;
      state.lpUsdc = newLpUsdc;
      state.treasuryUsdc += amount * feeRate;
      return;
    }

    throw new Error("Direction swap inconnue");
  }

  throw new Error("Type de TX inconnu: " + type);
}

// Ajout d’une TX dans le mempool + contrôle nonce / signature
function submitTx(tx) {
  // nonce strict croissant
  const w = getWallet(tx.from);
  if (tx.nonce !== w.nonce + 1) throw new Error("Nonce invalide");
  if (!verifySignature(tx)) throw new Error("Signature invalide");
  state.mempool.push(tx);
  w.nonce = tx.nonce;
}

// Production de blocs toutes les X secondes
function forgeBlock() {
  if (!state.mempool.length) return;
  const txs = state.mempool.splice(0, state.mempool.length);
  // snapshot de l’état avant pour rollback possible (simple)
  const snapshot = JSON.parse(JSON.stringify(state));

  try {
    for (const tx of txs) applyTx(tx);
  } catch (e) {
    console.error("❌ Erreur applyTx, rollback:", e.message);
    state = snapshot;
    return;
  }

  const last = state.chain[state.chain.length - 1];
  const block = {
    index: last.index + 1,
    time: Date.now(),
    prevHash: last.hash,
    txs,
    treasuryPow: state.treasuryPow,
    treasuryUsdc: state.treasuryUsdc,
    lpPow: state.lpPow,
    lpUsdc: state.lpUsdc
  };
  block.hash = hashBlock(block);
  state.chain.push(block);
  saveLedger();
  broadcast({ type: "NEW_BLOCK", block });
  console.log("⛏️  Nouveau bloc", block.index, "txs:", txs.length);
}

// ------------ HTTP API 3000 ------------

function sendJson(res, code, obj) {
  const body = JSON.stringify(obj);
  res.writeHead(code, {
    "Content-Type": "application/json",
    "Access-Control-Allow-Origin": "*"
  });
  res.end(body);
}

function notFound(res) {
  res.writeHead(404, { "Content-Type": "text/plain" });
  res.end("Not found");
}

const server = http.createServer((req, res) => {
  const parsed = url.parse(req.url, true);
  const path = parsed.pathname;
  const method = req.method || "GET";

  if (method === "OPTIONS") {
    res.writeHead(204, {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type"
    });
    return res.end();
  }

  // /stats
  if (method === "GET" && path === "/stats") {
    const last = state.chain[state.chain.length - 1];
    return sendJson(res, 200, {
      height: state.chain.length,
      lastHash: last.hash,
      lpPow: state.lpPow,
      lpUsdc: state.lpUsdc,
      treasuryPow: state.treasuryPow,
      treasuryUsdc: state.treasuryUsdc,
      treasurySol: state.treasurySol,
      wallets: Object.keys(state.wallets).length
    });
  }

  // /chain (attention taille)
  if (method === "GET" && path === "/chain") {
    return sendJson(res, 200, { chain: state.chain });
  }

  // /block?index=
  if (method === "GET" && path === "/block") {
    const idx = Number(parsed.query.index || 0);
    const b = state.chain[idx];
    if (!b) return notFound(res);
    return sendJson(res, 200, b);
  }

  // /wallet?addr=
  if (method === "GET" && path === "/wallet") {
    const addr = parsed.query.addr;
    if (!addr) return sendJson(res, 400, { error: "addr requis" });
    const w = getWallet(addr);
    return sendJson(res, 200, { addr, wallet: w });
  }

  // POST /tx  { type, from, to, amount, token, nonce, pub, sig }
  if (method === "POST" && path === "/tx") {
    let body = "";
    req.on("data", c => (body += c));
    req.on("end", () => {
      try {
        const tx = JSON.parse(body || "{}");
        if (!tx.type || !tx.from || typeof tx.nonce !== "number") {
          return sendJson(res, 400, { error: "Champs manquants" });
        }
        tx.id = hashTx(tx);
        submitTx(tx);
        saveLedger();
        broadcast({ type: "NEW_TX", tx });
        return sendJson(res, 200, { ok: true, id: tx.id });
      } catch (e) {
        console.error("❌ POST /tx:", e.message);
        return sendJson(res, 400, { error: e.message || "TX invalide" });
      }
    });
    return;
  }

  // fallback
  notFound(res);
});

// ------------ WEBSOCKET 7001 ------------

const wss = new WebSocket.Server({ port: PORT_WS });
const clients = new Set();

wss.on("connection", ws => {
  clients.add(ws);
  ws.send(JSON.stringify({ type: "HELLO", msg: "POWCHAIN WS OK", height: state.chain.length }));
  ws.on("message", msg => {
    let data;
    try {
      data = JSON.parse(msg.toString());
    } catch {
      return;
    }
    // simple commandes debug
    if (data.type === "PING") {
      ws.send(JSON.stringify({ type: "PONG", t: Date.now() }));
    }
  });
  ws.on("close", () => clients.delete(ws));
  ws.on("error", () => clients.delete(ws));
});

function broadcast(obj) {
  const msg = JSON.stringify(obj);
  for (const ws of clients) {
    if (ws.readyState === WebSocket.OPEN) ws.send(msg);
  }
}


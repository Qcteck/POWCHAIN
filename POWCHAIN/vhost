<script>
const API="",WS=(location.protocol==="https:"?"wss://":"ws://")+location.host+"/ws",DEC=1e6,ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";const SOL_RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";const USDC_MINT_STR="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";let addr=null,priv=null,pub=null,nonce=0,sock=null,phantomPubkey=null,solConn=null;const q=s=>document.querySelector(s),log=m=>{const b=q("#log");if(b)b.textContent="["+new Date().toLocaleTimeString()+"] "+m+"\n"+b.textContent},fmt=n=>(n/DEC).toFixed(6);function b58encode(bytes){if(!bytes||!bytes.length)return"";let d=[0];for(let i=0;i<bytes.length;i++){let c=bytes[i];for(let j=0;j<d.length;j++){let x=d[j]*256+c;d[j]=x%58;c=(x/58)|0}while(c>0){d.push(c%58);c=(c/58)|0}}let z=0;while(z<bytes.length&&bytes[z]===0)z++;let r="";for(let i=0;i<z;i++)r+="1";for(let i=d.length-1;i>=0;i--)r+=ALPH[d[i]];return r}function b58decode(str){if(!str)return new Uint8Array(0);let b=[0];for(let i=0;i<str.length;i++){let c=ALPH.indexOf(str[i]);if(c<0)throw Error("base58 invalide");for(let j=0;j<b.length;j++){let x=b[j]*58+c;b[j]=x&255;c=x>>8}while(c>0){b.push(c&255);c>>=8}}let z=0;while(z<str.length&&str[z]==="1")z++;let r=new Uint8Array(z+b.length);for(let i=0;i<b.length;i++)r[r.length-1-i]=b[i];return r}async function jget(p){const t0=performance.now(),r=await fetch(API+p),t1=performance.now();const lat=q("#latency");if(lat)lat.textContent="Latency: "+(t1-t0).toFixed(0)+" ms";if(!r.ok)throw Error("HTTP "+r.status);return r.json()}function connectWS(){try{sock=new WebSocket(WS);sock.onopen=()=>{log("WS connecté");q("#syncText").textContent="Synced";q("#syncChipText").textContent="Online"};sock.onclose=()=>{q("#syncText").textContent="Reconnecting";q("#syncChipText").textContent="Sync…";setTimeout(connectWS,1500)};sock.onerror=()=>{q("#syncText").textContent="Error";q("#syncChipText").textContent="Error"}}catch(e){log("WS ERR "+e.message)}}connectWS();async function refreshNet(){try{const s=await jget("/stats");q("#netHeight").textContent=s.height;q("#lpPow").textContent=fmt(s.lpPow||0);q("#lpUsdc").textContent=fmt(s.lpUsdc||0);q("#netPrice").textContent=(s.lpPow&&s.lpUsdc?(s.lpUsdc/s.lpPow/DEC).toFixed(6):"0");q("#netTVL").textContent=((s.lpUsdc||0)/DEC).toFixed(2)+" USDC POW";q("#netTreasury").textContent=((s.treasuryUsdc||0)/DEC).toFixed(2)+" USDC POW · "+(s.treasurySol||0).toFixed(3)+" SOL"}catch(e){log("NET ERR "+e.message)}}setInterval(refreshNet,4000);refreshNet();function signTx(o){const payload={type:o.type,from:o.from??addr,to:o.to??null,amount:o.amount??null,token:o.token??null,nonce:nonce+1},msg=new TextEncoder().encode(JSON.stringify(payload)),sk=b58decode(priv),sig=nacl.sign.detached(msg,sk);return b58encode(sig)}async function loadWallet(){addr=q("#walletAddr").value.trim();priv=q("#walletPriv").value.trim();if(!addr||!priv)return alert("Adresse + clé privée requises");const r=await jget("/wallet/"+addr);nonce=r.nonce||0;pub=r.pub||addr;q("#wpow").textContent=fmt(r.pow||0);q("#wusdc").textContent=fmt(r.usdc||0);q("#wstk").textContent=fmt(r.staked||0);log("Wallet chargé "+addr)}q("#btnLoad").onclick=loadWallet;q("#btnRefreshW").onclick=loadWallet;q("#btnGen").onclick=()=>{try{const kp=nacl.sign.keyPair();addr=b58encode(kp.publicKey);priv=b58encode(kp.secretKey);pub=addr;nonce=0;q("#walletAddr").value=addr;q("#walletPriv").value=priv;q("#wpow").textContent="0.000000";q("#wusdc").textContent="0.000000";q("#wstk").textContent="0.000000";log("Nouveau wallet POWCHAIN généré, sauvegarde la clé privée")}catch(e){log("GEN ERR "+e.message);alert("Erreur génération wallet : "+e.message)}};q("#btnSend").onclick=()=>{if(!addr)return alert("Connect wallet POWCHAIN");const to=q("#sendTo").value.trim(),a=parseFloat(q("#sendAmt").value||"0");if(!to||a<=0)return;const tx={type:"TX_POW",from:addr,to,amount:Math.floor(a*DEC),nonce:nonce+1,pub};try{tx.sig=signTx(tx)}catch(e){log("SIGN ERR "+e.message);return alert(e.message)}if(sock&&sock.readyState===1){sock.send(JSON.stringify(tx));log("TX POW envoyée "+a)}else log("WS non connecté");nonce++};q("#btnStake").onclick=()=>{if(!addr)return alert("Connect wallet POWCHAIN");const a=parseFloat(q("#stakeAmt").value||"0");if(a<=0)return;const tx={type:"STAKE",addr,amount:Math.floor(a*DEC),from:addr,nonce:nonce+1,pub};try{tx.sig=signTx(tx)}catch(e){log("SIGN ERR "+e.message);return alert(e.message)}if(sock&&sock.readyState===1){sock.send(JSON.stringify(tx));log("STAKE envoyé "+a)}else log("WS non connecté");nonce++};q("#btnSwap").onclick=()=>{if(!addr)return alert("Connect wallet POWCHAIN");const a=parseFloat(q("#swapAmt").value||"0");if(a<=0)return;const tx={type:"SWAP",addr,amount:Math.floor(a*DEC),token:q("#swapDir").value,from:addr,nonce:nonce+1,pub};try{tx.sig=signTx(tx)}catch(e){log("SIGN ERR "+e.message);return alert(e.message)}if(sock&&sock.readyState===1){sock.send(JSON.stringify(tx));log("SWAP envoyé "+a)}else log("WS non connecté");nonce++};q("#btnLPAdd").onclick=()=>{if(!addr)return alert("Connect wallet POWCHAIN");const p=parseFloat(q("#lpPOW").value||"0"),u=parseFloat(q("#lpUSDC").value||"0");if(p<=0||u<=0)return;const tx={type:"LP_ADD",addr,pow:Math.floor(p*DEC),usdc:Math.floor(u*DEC),from:addr,nonce:nonce+1,pub};try{tx.sig=signTx(tx)}catch(e){log("SIGN ERR "+e.message);return alert(e.message)}if(sock&&sock.readyState===1){sock.send(JSON.stringify(tx));log("LP ADD envoyé")}else log("WS non connecté");nonce++};q("#btnScan").onclick=async()=>{const a=q("#scanAddr").value.trim();if(!a)return;try{const w=await jget("/wallet/"+a);q("#scanRes").textContent="POW: "+fmt(w.pow||0)+"\nUSDC POW: "+fmt(w.usdc||0)+"\nStake: "+fmt(w.staked||0);log("SCAN "+a)}catch(e){log("SCAN ERR "+e.message)}};q("#btnWebHash").onclick=async()=>{const h=parseInt(q("#whHeight").value||"0");if(!h)return alert("Hauteur bloc requise");try{const b=await jget("/block/"+h);let out="HASH: "+b.hash+"\nValidator: "+(b.validator||"—")+"\nTime: "+(b.time?new Date(b.time).toLocaleString():"—")+"\nTXs:\n";if(b.txs&&b.txs.length){b.txs.forEach(t=>{const amt=t.amount?t.amount/DEC:0;out+=" - "+t.type+" "+(t.from||"")+" → "+(t.to||"")+" : "+(amt?amt.toFixed(6):"0")+" "+(t.token||"")+"\n"})}else out+="(aucune TX)\n";q("#whOut").textContent=out;log("WEBHASH bloc #"+h)}catch(e){q("#whOut").textContent="Erreur: "+e.message;log("WEBHASH ERR "+e.message)}};q("#btnLoadChain").onclick=async()=>{try{const chain=await jget("/chain");if(!Array.isArray(chain)){q("#chainList").textContent="Réponse /chain invalide";return}const last=chain.slice(-30).reverse();let txt="";last.forEach(b=>{txt+="#"+b.height+" | "+(b.hash||"hash ?").slice(0,18)+"... | val: "+(b.validator||"—")+" | txs:"+(b.txs?b.txs.length:0)+" | "+(b.time?new Date(b.time).toLocaleString():"")+"\n"});q("#chainList").textContent=txt||"Aucun bloc";log("Explorer mis à jour")}catch(e){q("#chainList").textContent="Erreur /chain: "+e.message;log("CHAIN ERR "+e.message)}};document.querySelectorAll("nav a").forEach(x=>x.onclick=()=>{const t=x.getAttribute("data-tab");document.querySelectorAll("nav a").forEach(a=>a.classList.remove("active"));x.classList.add("active");document.querySelectorAll("[data-section]").forEach(c=>{c.style.display=c.getAttribute("data-section")===t?"block":"none"})});["wallet","network","dex","tools","explorer"].forEach(sec=>{document.querySelectorAll('[data-section="'+sec+'"]').forEach(c=>{c.style.display=sec==="wallet"?"block":"none"})});function initSolana(){if(!window.solanaWeb3)return;solConn=new solanaWeb3.Connection(SOL_RPC,"confirmed")}initSolana();q("#btnPhantom").onclick=async()=>{try{const provider=window.solana;if(!provider||!provider.isPhantom){alert("Phantom non détecté");return}const res=await provider.connect();phantomPubkey=res.publicKey;const addrStr=phantomPubkey.toBase58();q("#phantAddr").textContent=addrStr;log("Phantom connecté "+addrStr);if(!solConn)initSolana();if(!solConn){log("Connexion Solana invalide");return}const lam=await solConn.getBalance(phantomPubkey);q("#solBalance").textContent=(lam/1e9).toFixed(5);const mint=new solanaWeb3.PublicKey(USDC_MINT_STR);const tok=await solConn.getParsedTokenAccountsByOwner(phantomPubkey,{mint});let usdc=0;if(tok.value&&tok.value.length){tok.value.forEach(it=>{const info=it.account.data.parsed.info;const a=parseFloat(info.tokenAmount.uiAmountString||"0");usdc+=a})}q("#usdcBalance").textContent=usdc.toFixed(2);log("SOL/USDC rafraîchis")}catch(e){log("PHANTOM ERR "+e.message);alert("Erreur Phantom: "+e.message)}};
</script>



<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>POWCHAIN — Quantum JARVIS Client</title>
  <style>
    body{margin:0;background:radial-gradient(circle at top,#111827,#020617 55%,#000 100%);color:#dbeafe;font-family:system-ui,-apple-system,Segoe UI,sans-serif;overflow-x:hidden}
    #shell{display:flex;min-height:100vh;background:radial-gradient(circle at top left,#1e293b80,#020617 50%,#000 100%)}
    #side{width:220px;background:#020617;border-right:1px solid #1f2937;box-shadow:10px 0 40px #000c;display:flex;flex-direction:column;padding:16px 12px;box-sizing:border-box}
    #logo{display:flex;align-items:center;gap:8px;margin-bottom:18px}
    #logoIcon{width:34px;height:34px;border-radius:999px;background:radial-gradient(circle,#38bdf8,#6366f1 40%,#7c3aed 80%);box-shadow:0 0 18px #22d3ee}
    #logo span{font-size:13px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#bfdbfe}
    #side small{font-size:10px;opacity:.6;margin-top:-8px;margin-bottom:14px}
    nav a{display:flex;align-items:center;gap:8px;padding:8px 10px;margin:3px 0;border-radius:9px;font-size:13px;color:#9ca3af;text-decoration:none;border:1px solid transparent;cursor:pointer}
    nav a span.icon{width:18px;height:18px;border-radius:6px;background:radial-gradient(circle,#38bdf8,#1d4ed8);opacity:.9}
    nav a.active,nav a:hover{background:linear-gradient(90deg,#020617,#0b1120);border-color:#1d4ed8;color:#e5e7eb;box-shadow:0 0 20px #1d4ed840}
    #status{margin-top:auto;font-size:11px;padding:8px 10px;border-radius:9px;border:1px solid #1f2937;background:linear-gradient(135deg,#020617,#020617,#0b1120);display:flex;flex-direction:column;gap:4px}
    #status span.tag{font-size:10px;text-transform:uppercase;letter-spacing:.18em;color:#60a5fa}
    #status span.ok{color:#4ade80;font-weight:600}
    #mainWrap{flex:1;display:flex;flex-direction:column;overflow:hidden}
    #topbar{display:flex;align-items:center;justify-content:space-between;padding:10px 18px 8px;box-sizing:border-box;border-bottom:1px solid #111827;background:radial-gradient(circle at top,#020617,#020617 40%,#000 100%);backdrop-filter:blur(14px)}
    #topTitle{font-size:15px;font-weight:600;color:#e5e7eb}
    #topSub{font-size:11px;opacity:.6}
    #syncChip{font-size:11px;border-radius:999px;padding:4px 10px;border:1px solid #16a34a;background:#022c22;color:#bbf7d0;display:flex;align-items:center;gap:6px}
    #syncDot{width:7px;height:7px;border-radius:999px;background:#22c55e;box-shadow:0 0 12px #22c55e}
    #syncChipText{font-size:11px}
    #wrap{flex:1;overflow:auto;padding:14px 18px 18px;box-sizing:border-box}
    #grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    @media(max-width:1024px){
      #grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      #side{width:190px}
    }
    @media(max-width:780px){
      #shell{flex-direction:column}
      #side{flex-direction:row;align-items:center;width:100%;border-right:none;border-bottom:1px solid #111827;padding:10px 8px;overflow-x:auto}
      #logo,#side small{display:none}
      nav{display:flex;flex-direction:row;gap:4px;flex:1}
      nav a{justify-content:center;padding:6px 8px;font-size:11px}
      #status{display:none}
      #mainWrap{flex:1}
    }
    @media(max-width:640px){
      #grid{grid-template-columns:1fr}
    }
    .card{position:relative;border-radius:14px;border:1px solid #111827;background:radial-gradient(circle at top left,#0b1120,#020617 60%,#020617);box-shadow:0 0 28px #020617e0,0 0 0 1px #020617 inset;padding:11px 12px 12px;overflow:hidden}
    .card:before{content:"";position:absolute;inset:-40px 40% auto auto;height:120px;background:radial-gradient(circle,#38bdf8 0,#a855f7 40%,transparent 70%);opacity:.12;pointer-events:none}
    .pill{font-size:10px;text-transform:uppercase;letter-spacing:.16em;color:#60a5fa;margin-bottom:4px;display:block}
    .titleRow{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}
    .big{font-size:24px;font-weight:600;letter-spacing:.06em;color:#e5e7eb}
    .line{display:flex;justify-content:space-between;font-size:11px;margin:2px 0;color:#9ca3af}
    .line span.v{color:#e5e7eb}
    .muted{font-size:11px;opacity:.6;margin-top:4px}
    input,select,button{border-radius:9px;border:1px solid #1f2937;background:#020617;color:#e5e7eb;padding:6px 8px;font-size:12px;box-sizing:border-box;width:100%}
    button{cursor:pointer;text-transform:uppercase;letter-spacing:.14em;font-size:11px;background:linear-gradient(90deg,#1d4ed8,#4f46e5);border-color:#1d4ed8;box-shadow:0 0 16px #1d4ed860}
    button:hover{filter:brightness(1.15)}
    .row{display:flex;gap:6px;margin-top:4px}
    .row>*{flex:1}
    #log{white-space:pre-wrap;background:#020617;border-radius:12px;border:1px solid #111827;margin-top:10px;padding:8px 9px;font-size:10px;height:120px;overflow:auto;box-shadow:0 0 18px #020617}
    #scanRes{font-size:11px;margin-top:4px;white-space:pre-wrap}
    #chainList{font-size:10px;white-space:pre-wrap;max-height:110px;overflow:auto;margin-top:4px}
  </style>
</head>

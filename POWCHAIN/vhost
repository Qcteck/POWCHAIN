// server.js - FIREINNERS Validator + API + WS

const express = require("express");
const bodyParser = require("body-parser");
const WebSocket = require("ws");
const nacl = require("tweetnacl");
const bs58 = require("bs58");
const crypto = require("crypto");
const http = require("http");

// =========================
// CONFIG SERVEUR
// =========================

const HTTP_PORT = 3000; // nginx proxy vers 127.0.0.1:3000
const WS_PATH = "/ws";

const app = express();
app.use(bodyParser.json());

const server = http.createServer(app);
const wss = new WebSocket.Server({ server, path: WS_PATH });

const clients = new Set();

// =========================
// ECONOMIE FIREINNERS
// =========================

const DEC = 1e6;
const SUPPLY_MAX = 100_000_000 * DEC; // 100M FIRE max

// base TVL -> prix dynamique
const RATE_BASE = 1000; // FIRE par SOL à TVL basse
const TVL_REF = 1_000_000 * DEC; // 1M USDC FIRE
const RATE_MIN = 800;
const RATE_MAX = 5000;

// frais (basis points, 1% = 100)
const FEE_TRANSFER_BURN_BP = 50;   // 0.5% burn sur transfert
const FEE_SWAP_TOTAL_BP    = 30;   // 0.3% total sur swap
const FEE_SWAP_BURN_PART   = 0.5;  // 50% des fees swap brûlés
const FEE_BRIDGE_IN_TREAS_BP = 500; // 5% vers trésorerie
const FEE_BRIDGE_IN_BURN_BP  = 200; // 2% burn
const FEE_BRIDGE_OUT_BURN_BP = 1000;// 10% burn sur retour
const FEE_UNSTAKE_BURN_BP    = 300; // 3% burn unstake anticipé

const STAKE_MIN_LOCK_MS = 30 * 24 * 60 * 60 * 1000;

// =========================
// ETAT GLOBAL
// =========================

let wallets = {}; // addr -> { pow, usdc, staked, pub, nonce, stakeLock }
let treasury = { pow: 0, usdc: 0, sol: 0 };
let lp = { pow: 0, usdc: 0 };

let supplyCirculante = 0;
let mintedPowTotal  = 0;
let burnedPowTotal  = 0;

// historique blocs simplifié
let chain = [];
let mempool = [];

// =========================
// GENESIS (aucune émission initiale, tout vient du bridge)
// =========================

(function initGenesis() {
  supplyCirculante = 0;
  mintedPowTotal = 0;
  burnedPowTotal = 0;
  treasury.pow = 0;
  treasury.usdc = 0;
  treasury.sol = 0;
  const genesis = {
    height: 1,
    time: Date.now(),
    prevHash: "0".repeat(64),
    hash: "GENESIS",
    txs: [],
    treasurySnapshot: { ...treasury },
    lpSnapshot: { ...lp },
    supplyCirculante,
    mintedPowTotal,
    burnedPowTotal
  };
  chain.push(genesis);
})();

// =========================
// OUTILS
// =========================

function ensureWallet(addr) {
  if (!wallets[addr]) {
    wallets[addr] = {
      pow: 0,
      usdc: 0,
      staked: 0,
      pub: addr,
      nonce: 0,
      stakeLock: 0
    };
  }
  return wallets[addr];
}
function clamp(x, min, max) {
  return x < min ? min : x > max ? max : x;
}
function getTVL() {
  const lpUsdc = lp.usdc || 0;
  const treUsdc = treasury.usdc || 0;
  return lpUsdc + treUsdc;
}
function getPowRatePowPerSol() {
  const tvl = getTVL();
  const factor = 1 + tvl / (TVL_REF || DEC);
  const rawRate = RATE_BASE * factor;
  return clamp(rawRate, RATE_MIN, RATE_MAX);
}
function burnPow(amount) {
  if (!amount || amount <= 0) return 0;
  const actual = Math.min(amount, supplyCirculante);
  burnedPowTotal += actual;
  supplyCirculante -= actual;
  return actual;
}
function mintPow(amount) {
  if (!amount || amount <= 0) return 0;
  const spaceLeft = SUPPLY_MAX - supplyCirculante;
  const mintable = Math.max(0, Math.min(amount, spaceLeft));
  mintedPowTotal += mintable;
  supplyCirculante += mintable;
  return mintable;
}
function addPow(addr, amount) {
  const w = ensureWallet(addr);
  w.pow += amount;
}
function subPow(addr, amount) {
  const w = ensureWallet(addr);
  if (w.pow < amount) throw new Error("Solde FIRE insuffisant");
  w.pow -= amount;
}
function addUsdc(addr, amount) {
  const w = ensureWallet(addr);
  w.usdc += amount;
}
function subUsdc(addr, amount) {
  const w = ensureWallet(addr);
  if (w.usdc < amount) throw new Error("Solde USDC FIRE insuffisant");
  w.usdc -= amount;
}
function applyBp(amount, bp) {
  return Math.floor(amount * bp / 10000);
}
function getLpPrice() {
  if (lp.pow <= 0 || lp.usdc <= 0) return 0;
  return lp.usdc / lp.pow;
}
function hashBlockPayload(obj) {
  const s = JSON.stringify(obj);
  return crypto.createHash("sha256").update(s).digest("hex");
}
function broadcast(msg) {
  const data = JSON.stringify(msg);
  for (const ws of clients) {
    if (ws.readyState === WebSocket.OPEN) {
      ws.send(data);
    }
  }
}

// =========================
// HANDLERS ECONOMIQUES
// =========================

function handleTransferPow(tx) {
  if (!tx.from || !tx.to) throw new Error("from/to manquant");
  if (!tx.amount || tx.amount <= 0) throw new Error("amount invalide");
  const gross = tx.amount;
  const feeBurn = applyBp(gross, FEE_TRANSFER_BURN_BP);
  const sendAmount = gross - feeBurn;
  if (sendAmount <= 0) throw new Error("montant après burn insuffisant");
  subPow(tx.from, gross);
  addPow(tx.to, sendAmount);
  const burned = burnPow(feeBurn);
  return {
    type: "TX_POW",
    from: tx.from,
    to: tx.to,
    gross,
    sendAmount,
    burned
  };
}
function handleSwap(tx) {
  const { addr, amount, token } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");
  if (!lp.pow || !lp.usdc) throw new Error("pool LP vide");
  if (token !== "pow2usdc" && token !== "usdc2pow") {
    throw new Error("direction swap invalide");
  }
  const feeTotal = applyBp(amount, FEE_SWAP_TOTAL_BP);
  const amountNet = amount - feeTotal;
  if (amountNet <= 0) throw new Error("amount net swap invalide");
  const feeBurn = Math.floor(feeTotal * FEE_SWAP_BURN_PART);
  const feeTreas = feeTotal - feeBurn;
  if (token === "pow2usdc") {
    subPow(addr, amount);
    lp.pow += amountNet;
    const k = lp.pow * lp.usdc;
    const newPow = lp.pow;
    const newUsdc = Math.floor(k / newPow);
    const deltaUsdc = lp.usdc - newUsdc;
    if (deltaUsdc <= 0) throw new Error("delta usdc invalide");
    lp.usdc = newUsdc;
    addUsdc(addr, deltaUsdc);
    const burned = burnPow(feeBurn);
    treasury.pow += feeTreas;
    supplyCirculante += feeTreas;
    return {
      type: "SWAP",
      dir: "pow2usdc",
      inPow: amount,
      outUsdc: deltaUsdc,
      feeBurn: burned,
      feeTreasPow: feeTreas
    };
  } else {
    subUsdc(addr, amount);
    lp.usdc += amountNet;
    const k = lp.pow * lp.usdc;
    const newUsdc = lp.usdc;
    const newPow = Math.floor(k / newUsdc);
    const deltaPow = lp.pow - newPow;
    if (deltaPow <= 0) throw new Error("delta pow invalide");
    lp.pow = newPow;
    addPow(addr, deltaPow);
    const burned = burnPow(feeBurn);
    treasury.usdc += feeTreas;
    return {
      type: "SWAP",
      dir: "usdc2pow",
      inUsdc: amount,
      outPow: deltaPow,
      feeBurn: burned,
      feeTreasUsdc: feeTreas
    };
  }
}
function handleLPAdd(tx) {
  const { addr, pow, usdc } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!pow || pow <= 0 || !usdc || usdc <= 0) {
    throw new Error("valeurs LP invalides");
  }
  subPow(addr, pow);
  subUsdc(addr, usdc);
  lp.pow += pow;
  lp.usdc += usdc;
  return {
    type: "LP_ADD",
    addr,
    pow,
    usdc
  };
}
function handleBridgeIn(tx) {
  const { addr, solAmount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!solAmount || solAmount <= 0) throw new Error("solAmount invalide");
  const rate = getPowRatePowPerSol();
  const fireBrut = Math.floor(solAmount * rate * DEC);
  const fireToMint = mintPow(fireBrut);
  if (fireToMint <= 0) throw new Error("supply max atteint");
  const feeTreas = applyBp(fireToMint, FEE_BRIDGE_IN_TREAS_BP);
  const feeBurn = applyBp(fireToMint, FEE_BRIDGE_IN_BURN_BP);
  const userFire = fireToMint - feeTreas - feeBurn;
  if (userFire <= 0) throw new Error("bridge net <= 0");
  treasury.pow += feeTreas;
  const burned = burnPow(feeBurn);
  addPow(addr, userFire);
  treasury.sol += solAmount;
  return {
    type: "BRIDGE_IN",
    addr,
    solAmount,
    rateFirePerSol: rate,
    fireMinted: fireToMint,
    userFire,
    feeTreasFire: feeTreas,
    burnedFire: burned,
    supplyCirculante,
    supplyDisponible: SUPPLY_MAX - supplyCirculante
  };
}
function handleStake(tx) {
  const { addr, amount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");
  const w = ensureWallet(addr);
  if (w.pow < amount) throw new Error("solde FIRE insuffisant");
  w.pow -= amount;
  w.staked += amount;
  w.stakeLock = Date.now() + STAKE_MIN_LOCK_MS;
  return {
    type: "STAKE",
    addr,
    amount,
    lockUntil: w.stakeLock
  };
}
function handleUnstake(tx) {
  const { addr, amount } = tx;
  if (!addr) throw new Error("addr manquant");
  if (!amount || amount <= 0) throw new Error("amount invalide");
  const w = ensureWallet(addr);
  if (w.staked < amount) throw new Error("staked insuffisant");
  let burnFee = 0;
  if (Date.now() < (w.stakeLock || 0)) {
    burnFee = applyBp(amount, FEE_UNSTAKE_BURN_BP);
  }
  const net = amount - burnFee;
  if (net <= 0) throw new Error("unstake net <= 0");
  w.staked -= amount;
  w.pow += net;
  const burned = burnPow(burnFee);
  return {
    type: "UNSTAKE",
    addr,
    amount,
    net,
    burned
  };
}

// =========================
// MEMPOOL / BLOCS
// =========================

function applyTxToState(tx) {
  switch (tx.type) {
    case "TX_POW":   return handleTransferPow(tx);
    case "SWAP":     return handleSwap(tx);
    case "LP_ADD":   return handleLPAdd(tx);
    case "STAKE":    return handleStake(tx);
    case "UNSTAKE":  return handleUnstake(tx);
    case "BRIDGE_IN":return handleBridgeIn(tx);
    default: throw new Error("type TX inconnu");
  }
}
function produceBlock() {
  if (mempool.length === 0) return;
  const prev = chain[chain.length - 1];
  const height = prev.height + 1;
  const ts = Date.now();
  const applied = [];
  for (const tx of mempool) {
    try {
      const res = applyTxToState(tx);
      applied.push({ tx, res });
    } catch (e) {
      // on ignore les TX invalides
    }
  }
  mempool = [];
  const payload = {
    height,
    time: ts,
    prevHash: prev.hash,
    txs: applied,
    treasury: { ...treasury },
    lp: { ...lp },
    supplyCirculante,
    mintedPowTotal,
    burnedPowTotal
  };
  const hash = hashBlockPayload(payload);
  const block = { ...payload, hash };
  chain.push(block);
  broadcast({ type: "block", height, hash });
}
setInterval(produceBlock, 5000);

// =========================

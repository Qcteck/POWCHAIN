<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"/><title>FIREINNERS — Client Complet</title><meta name="viewport" content="width=device-width,initial-scale=1"/><style>body{margin:0;background:#05070b;color:#e5ecff;font-family:system-ui,-apple-system,Segoe UI,sans-serif}#wrap{max-width:1200px;margin:20px auto;padding:16px;border-radius:12px;border:1px solid #222b37;background:radial-gradient(circle at top,#05070b,#020409);box-shadow:0 0 22px #000}h1{margin:0 0 12px;font-size:26px;text-align:center;color:#ffb020;text-shadow:0 0 10px #ff8c00}h2{margin:10px 0 6px;font-size:16px;color:#ffcf66}h3{margin:8px 0 4px;font-size:14px;color:#ffc24b}.row{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:10px}.card{flex:1 1 260px;border-radius:10px;border:1px solid #333742;padding:10px;background:linear-gradient(145deg,#07111c,#020409);box-shadow:0 0 12px #000}.card.small{flex:0 0 260px}label{font-size:12px;color:#a5b4c3}input,select,button,textarea{font-family:inherit;font-size:13px;border-radius:8px;border:1px solid #374151;background:#020814;color:#e5ecff;padding:7px 9px;box-sizing:border-box;margin:3px 0}input:focus,select:focus,button:focus,textarea:focus{outline:none;border-color:#f97316;box-shadow:0 0 0 1px #f97316}button{cursor:pointer;font-weight:600;background:linear-gradient(90deg,#f97316,#fbbf24);color:#111827;border:none;box-shadow:0 0 10px #f9731680}button.red{background:linear-gradient(90deg,#ef4444,#f97316);color:#fff}button.green{background:linear-gradient(90deg,#16a34a,#a3e635);color:#01210f}button.secondary{background:#020617;border:1px solid #4b5563;color:#e5e7eb;box-shadow:none}.badge{display:inline-flex;align-items:center;gap:6px;padding:2px 8px;border-radius:999px;border:1px solid #4b5563;background:#020617;font-size:11px;color:#e5e7eb}.dot{width:8px;height:8px;border-radius:999px;background:#ef4444}.dot.ok{background:#22c55e}.kv{font-size:13px;margin:2px 0}.kv span{color:#9ca3af}.mono{font-family:"SF Mono",ui-monospace,Menlo,Consolas,monospace;font-size:12px}#log{height:170px;overflow:auto;background:#020409;border-radius:8px;border:1px solid #1f2933;padding:6px;font-size:12px;white-space:pre-wrap}#log b{color:#fbbf24}a{color:#38bdf8;text-decoration:none}a:hover{text-decoration:underline}.pill{display:inline-block;margin-right:4px;margin-bottom:2px;padding:1px 8px;border-radius:999px;font-size:11px;background:#111827;border:1px solid #374151;color:#e5e7eb}.number{font-weight:600;color:#e5ecff}.muted{color:#9ca3af;font-size:12px}hr{border:none;border-top:1px dashed #374151;margin:8px 0}</style><script>window.history.replaceState(null,null,'/?v='+(Date.now()));</script><script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script></head><body><div id="wrap"><h1>FIREINNERS — CLIENT COMPLET</h1><div class="row"><div class="card small"><h3>Backend / Stats</h3><div class="kv"><span>HTTP :</span> <span class="badge"><span id="apiDot" class="dot"></span> <span id="apiTxt">...</span></span></div><div class="kv"><span>WS :</span> <span class="badge"><span id="wsDot" class="dot"></span> <span id="wsTxt">...</span></span></div><hr><div class="kv"><span>Hauteur :</span> <span id="statHeight" class="number">-</span></div><div class="kv"><span>Wallets :</span> <span id="statWallets" class="number">-</span></div><div class="kv"><span>Mempool :</span> <span id="statMempool" class="number">-</span></div><div class="kv"><span>Total FIRE :</span> <span id="statTotalPow" class="number">-</span></div><div class="kv"><span>Total Staked :</span> <span id="statTotalStaked" class="number">-</span></div><hr><div class="kv"><span>TVL FIRE :</span> <span id="statTvlPow" class="number">-</span></div><div class="kv"><span>TVL USDC FIRE :</span> <span id="statTvlUsdc" class="number">-</span></div><hr><div class="kv"><span>LP FIRE :</span> <span id="lpPow" class="number">0</span></div><div class="kv"><span>LP USDC FIRE :</span> <span id="lpUsdc" class="number">0</span></div><hr><div class="kv"><span>Trésorerie FIRE :</span> <span id="treasuryFire" class="number">0</span></div><div class="kv"><span>Trésorerie USDC FIRE :</span> <span id="treasuryUsdc" class="number">0</span></div><div class="kv"><span>Trésorerie SOL (bridge) :</span> <span id="treasurySol" class="number">0</span></div></div><div class="card"><h2>Wallet Solana — Phantom</h2><label>Adresse Solana</label><input id="solAddr" class="mono" readonly placeholder="Non connecté"/><div class="row"><button id="btnConnectPhantom">Connecter Phantom</button><button id="btnRefreshSol" class="secondary">Refresh</button></div><div class="row"><div class="kv"><span>SOL (wallet) :</span> <span id="solBalance" class="number">0</span></div><div class="kv"><span>USDC Solana :</span> <span id="solUsdc" class="number">0</span></div></div><p class="muted">Soldes lus via RPC Solana mainnet (SOL + USDC …). Aucun lien direct avec USDC FIREINNERS interne.</p><h3>Bridge vers FIREINNERS</h3><label>Montant SOL à bridger</label><input id="bridgeAmount" placeholder="0.1"/><button id="btnBridge" class="green">SOL → FIREINNERS</button><p class="muted">Envoie du SOL avec Phantom vers la trésorerie Solana, puis crédit équivalent en FIRE sur ton wallet FIREINNERS.</p><div class="kv"><span>Trésorerie Solana :</span> <span class="mono">BZJsWeJizv3YeyuWjF5187jrcduPFAHWjqL7jgq4kGwy</span></div></div></div><div class="row"><!-- Carte wallet serveur CACHÉE pour l'utilisateur --><div class="card" style="display:none"><h2>Wallet FIREINNERS (serveur)</h2><label>Adresse FIREINNERS (serveur)</label><input id="srvAddr" class="mono" placeholder="Aucune" readonly/><div class="row"><button id="btnCreateSrv">Créer un wallet FIREINNERS (serveur)</button><button id="btnReloadSrv" class="secondary">Recharger le wallet</button></div><label>Adresse FIREINNERS (locale)</label><input id="locAddr" class="mono" placeholder="Non générée" readonly/><label>Clé privée locale (base58)</label><input id="locPriv" class="mono" placeholder="Non générée" readonly/><div class="row"><button id="btnGenLocal" class="secondary">Générer un wallet FIREINNERS (local)</button></div><hr><div class="row"><div class="kv"><span>FIRE :</span> <span id="balPow" class="number">0</span></div><div class="kv"><span>USDC FIRE :</span> <span id="balUsdc" class="number">0</span></div><div class="kv"><span>Staked :</span> <span id="balStaked" class="number">0</span></div><div class="kv"><span>Nonce :</span> <span id="balNonce" class="number">0</span></div></div></div><div class="card"><h2>Envoyer une TX FIREINNERS</h2><label>Type d&apos;asset</label><select id="txToken"><option value="POW">FIRE</option><option value="USDC">USDC FIRE</option></select><label>Adresse destinataire</label><input id="txTo" class="mono" placeholder="Adresse FIREINNERS du destinataire"/><label>Montant</label><input id="txAmount" placeholder="0.01"/><div class="row"><button id="btnSendTx" class="red">Envoyer TX</button></div><p class="muted">La transaction sera signée localement (si wallet local présent) ou côté serveur (si wallet serveur) et envoyée dans le mempool POWCHAIN/FIREINNERS.</p><hr><h3>Chaîne</h3><div class="row"><button id="btnRefreshChain" class="secondary">Voir la hauteur de chaîne</button></div><div class="kv"><span>Dernier bloc :</span> <span id="lastBlock" class="number">-</span></div></div></div><div class="row"><div class="card" style="flex:1 1 100%"><h2>Logs</h2><div id="log"></div></div></div></div><script>(()=>{const API_BASE="https://bbqfinance.fun";const WS_URL="wss://bbqfinance.fun/ws";let ws=null;let phantom=null;let solPubkey=null;const logEl=document.getElementById("log");const apiDot=document.getElementById("apiDot");const apiTxt=document.getElementById("apiTxt");const wsDot=document.getElementById("wsDot");const wsTxt=document.getElementById("wsTxt");const statHeight=document.getElementById("statHeight");const statWallets=document.getElementById("statWallets");const statMempool=document.getElementById("statMempool");const statTotalPow=document.getElementById("statTotalPow");const statTotalStaked=document.getElementById("statTotalStaked");const statTvlPow=document.getElementById("statTvlPow");const statTvlUsdc=document.getElementById("statTvlUsdc");const lpPow=document.getElementById("lpPow");const lpUsdc=document.getElementById("lpUsdc");const treasuryFire=document.getElementById("treasuryFire");const treasuryUsdc=document.getElementById("treasuryUsdc");const treasurySol=document.getElementById("treasurySol");const solAddr=document.getElementById("solAddr");const solBalance=document.getElementById("solBalance");const solUsdc=document.getElementById("solUsdc");const bridgeAmount=document.getElementById("bridgeAmount");const srvAddr=document.getElementById("srvAddr");const locAddr=document.getElementById("locAddr");const locPriv=document.getElementById("locPriv");const balPow=document.getElementById("balPow");const balUsdc=document.getElementById("balUsdc");const balStaked=document.getElementById("balStaked");const balNonce=document.getElementById("balNonce");const txToken=document.getElementById("txToken");const txTo=document.getElementById("txTo");const txAmount=document.getElementById("txAmount");const lastBlock=document.getElementById("lastBlock");function L(msg){const t=new Date().toISOString().substr(11,8);logEl.textContent+="["+t+"] "+msg+"\n";logEl.scrollTop=logEl.scrollHeight}async function api(path,opts={}){try{const r=await fetch(API_BASE+path,Object.assign({headers:{"Content-Type":"application/json"}},opts));const txt=await r.text();let json=null;try{json=JSON.parse(txt)}catch(e){}return{ok:r.ok,status:r.status,json,txt}}catch(e){L("HTTP erreur: "+e.message);return{ok:false,status:0,json:null,txt:null}}}async function refreshStats(){const r=await api("/stats");if(!r.ok||!r.json){apiDot.classList.remove("ok");apiTxt.textContent="KO";return}const s=r.json;apiDot.classList.add("ok");apiTxt.textContent="OK";statHeight.textContent=s.height??"-";statWallets.textContent=s.wallets??"-";statMempool.textContent=s.mempool??"-";statTotalPow.textContent=s.totalPow??s.totalFIRE??"0";statTotalStaked.textContent=s.totalStaked??"0";statTvlPow.textContent=s.tvlPow??s.tvlFire??"-";statTvlUsdc.textContent=s.tvlUsdc??"-";lpPow.textContent=s.lpPow??"0";lpUsdc.textContent=s.lpUsdc??"0";const tPow=s.treasuryPow??s.treasuryFire??s.treasury??0;treasuryFire.textContent=tPow;treasuryUsdc.textContent=s.treasuryUsdc??"0";treasurySol.textContent=s.treasurySol??"0"}function connectWS(){try{if(ws)ws.close()}catch(e){}ws=new WebSocket(WS_URL);ws.onopen=()=>{wsDot.classList.add("ok");wsTxt.textContent="OK";L("WS FIREINNERS connecté.")};ws.onclose=()=>{wsDot.classList.remove("ok");wsTxt.textContent="KO";L("WS FIREINNERS déconnecté, reconnexion dans 5s.");setTimeout(connectWS,5000)};ws.onmessage=ev=>{try{const d=JSON.parse(ev.data);if(d.type==="block")L("Nouveau bloc "+d.height);if(d.type==="tx")L("TX "+d.txid+" ajoutée au mempool")}catch(e){}};ws.onerror=()=>{wsDot.classList.remove("ok");wsTxt.textContent="ERR"}}async function ensurePhantom(){if(!window.solana||!window.solana.isPhantom){alert("Phantom non détecté.");return null}if(!phantom){phantom=window.solana}if(!solPubkey){const r=await phantom.connect();solPubkey=r.publicKey;solAddr.value=solPubkey.toBase58();L("Phantom connecté.");}return phantom}async function refreshSol(){try{if(!solPubkey)return;const c=new solanaWeb3.Connection("https://api.mainnet-beta.solana.com");const bal=await c.getBalance(solPubkey);solBalance.textContent=(bal/1e9).toFixed(6);solUsdc.textContent="0";}catch(e){L("Erreur RPC Solana: "+e.message)}}async function doBridge(){const p=await ensurePhantom();if(!p)return;const amt=parseFloat(bridgeAmount.value||"0");if(!(amt>0)){alert("Montant invalide.");return}L("Bridge "+amt+" SOL → FIREINNERS (côté Solana à finaliser manuellement vers la trésorerie).");alert("Envoie le SOL vers la trésorerie avec Phantom; le backend FIREINNERS créditera ensuite ton wallet interne.");}function loadLocalWallet(){try{const s=localStorage.getItem("fireinners_local_wallet");if(!s)return null;const w=JSON.parse(s);locAddr&& (locAddr.value=w.addr||"");locPriv&& (locPriv.value=w.priv||"");return w}catch(e){return null}}function saveLocalWallet(w){localStorage.setItem("fireinners_local_wallet",JSON.stringify(w));if(locAddr)locAddr.value=w.addr;if(locPriv)locPriv.value=w.priv}function genLocalWallet(){const kp=solanaWeb3.Keypair.generate();const addr=kp.publicKey.toBase58();const priv=Buffer.from(kp.secretKey).toString("base64");saveLocalWallet({addr,priv});L("Wallet local FIREINNERS généré.");}async function refreshServerWallet(){if(!srvAddr)return;if(!srvAddr.value){const r=await api("/wallet/server");if(r.ok&&r.json&&r.json.addr){srvAddr.value=r.json.addr;L("Wallet serveur FIREINNERS chargé.");}}if(!srvAddr.value)return;const r2=await api("/wallet?addr="+encodeURIComponent(srvAddr.value));if(r2.ok&&r2.json){const w=r2.json;balPow&& (balPow.textContent=w.pow??w.FIRE??"0");balUsdc&& (balUsdc.textContent=w.usdc??"0");balStaked&& (balStaked.textContent=w.staked??"0");balNonce&& (balNonce.textContent=w.nonce??"0");}}async function createServerWallet(){if(!srvAddr)return;const r=await api("/wallet/create",{method:"POST",body:JSON.stringify({})});if(r.ok&&r.json&&r.json.addr){srvAddr.value=r.json.addr;L("Wallet serveur FIREINNERS créé.");refreshServerWallet()}else{L("Erreur création wallet serveur: "+(r.status||""));}}async function sendTx(){const token=txToken.value;const to=txTo.value.trim();const amt=parseFloat(txAmount.value||"0");if(!to||!(amt>0)){alert("Données TX invalides.");return}const local=loadLocalWallet();const body={token,to,amount:amt,fromServer:!local,from:local?local.addr:(srvAddr?srvAddr.value:null),localPriv:local?local.priv:null};const r=await api("/tx",{method:"POST",body:JSON.stringify(body)});if(r.ok&&r.json){L("TX envoyée: "+(r.json.txid||""));}else{L("Erreur envoi TX: "+(r.status||""));}}async function refreshChain(){const r=await api("/chain/last");if(r.ok&&r.json){lastBlock.textContent="height "+(r.json.height??"-")+" / hash "+(r.json.hash||"-");}else{lastBlock.textContent="-";}}document.getElementById("btnConnectPhantom").onclick=async()=>{await ensurePhantom();await refreshSol()};document.getElementById("btnRefreshSol").onclick=refreshSol;document.getElementById("btnBridge").onclick=doBridge;if(document.getElementById("btnGenLocal"))document.getElementById("btnGenLocal").onclick=()=>{genLocalWallet()};if(document.getElementById("btnCreateSrv"))document.getElementById("btnCreateSrv").onclick=createServerWallet;if(document.getElementById("btnReloadSrv"))document.getElementById("btnReloadSrv").onclick=refreshServerWallet;document.getElementById("btnSendTx").onclick=sendTx;document.getElementById("btnRefreshChain").onclick=refreshChain;loadLocalWallet();refreshStats();setInterval(refreshStats,8000);connectWS();L("Client FIREINNERS initialisé. API: "+API_BASE);})();</script></body></html>







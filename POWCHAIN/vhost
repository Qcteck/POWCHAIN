  <script>
    // ---------- Constantes ----------
    const RPC_SOL = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
    const USDC_MINT_SOL = new solanaWeb3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");

    const L = (m) => {
      const el = document.getElementById("log");
      const ts = new Date().toLocaleTimeString("fr-CA",{hour12:false});
      el.textContent += `[${ts}] ${m}\n`;
      el.scrollTop = el.scrollHeight;
      console.log(m);
    };

    const qs = (id) => document.getElementById(id);

    // ---------- Etat global ----------
    let ws = null;
    let wsTimer = null;
    let statsHeight = 0;

    let powWallet = null; // {pub, priv}
    let solPubkey = null;
    let solConnection = null;

    // ---------- Backend HTTP ----------
    async function api(path, options={}){
      const url = path.startsWith("/") ? path : `/${path}`;
      try{
        const res = await fetch(url, options);
        if(!res.ok){
          L(`HTTP ${url} → ${res.status}`);
          return null;
        }
        const txt = await res.text();
        try { return JSON.parse(txt); }
        catch { return txt; }
      }catch(e){
        L(`NET ERR ${url} : ${e.message}`);
        return null;
      }
    }

    async function refreshStats(){
      const data = await api("stats");
      if(!data) return;

      statsHeight = data.height ?? 0;
      qs("height").textContent = data.height ?? "-";
      qs("wallets").textContent = data.wallets ?? "-";
      qs("tvlPow").textContent = data.tvlPow ?? "-";
      qs("tvlUsdc").textContent = data.tvlUsdc ?? "-";
      qs("treasuryPow").textContent = data.treasuryPow ?? "-";
      qs("treasuryUsdc").textContent = data.treasuryUsdc ?? "-";
      qs("lastStatsTs").textContent = new Date().toLocaleTimeString("fr-CA",{hour12:false});
      qs("backendHttp").textContent = "HTTP OK";
      qs("backendHttp").style.background = "#022c22";
      qs("backendHttp").style.color = "#bbf7d0";
      L("Stats réseau mises à jour.");
    }

    // ---------- WebSocket ----------
    function setupWs(){
      if(ws){ try{ws.close();}catch(e){} ws = null; }
      const proto = location.protocol === "https:" ? "wss://" : "ws://";
      const url = proto + location.host + "/ws";
      L(`WS connect → ${url}`);
      ws = new WebSocket(url);

      ws.onopen = ()=>{
        qs("backendWs").textContent = "WS OK";
        qs("backendWs").style.background = "#022c22";
        qs("backendWs").style.color = "#bbf7d0";
        qs("statusDot").style.background = "var(--ok)";
        qs("statusDot").style.boxShadow = "0 0 8px var(--ok)";
        qs("statusText").textContent = "Online";
        L("WebSocket connecté.");
      };

      ws.onmessage = (ev)=>{
        try{
          const msg = JSON.parse(ev.data);
          if(msg.type === "welcome"){
            L(`WS welcome, height=${msg.height}`);
          }else if(msg.type === "new_block"){
            L(`Nouveau bloc #${msg.height} (${msg.hash.slice(0,8)}...)`);
            statsHeight = msg.height;
            qs("height").textContent = msg.height;
          }else if(msg.type === "tx"){
            L(`TX ${msg.kind || msg.tx?.type || "?"} acceptée.`);
          }else{
            L(`WS msg: ${ev.data}`);
          }
        }catch(e){
          L("WS parse error: " + e.message);
        }
      };

      ws.onclose = ()=>{
        qs("backendWs").textContent = "WS OFF";
        qs("backendWs").style.background = "#450a0a";
        qs("backendWs").style.color = "#fecaca";
        qs("statusDot").style.background = "var(--danger)";
        qs("statusDot").style.boxShadow = "0 0 8px var(--danger)";
        qs("statusText").textContent = "Hors ligne (reconnect...)";
        L("WebSocket fermé. Reconnexion dans 3 s.");
        wsTimer = setTimeout(setupWs,3000);
      };

      ws.onerror = (e)=>{
        L("WS error: " + e.message);
      };
    }

    function sendWs(obj){
      if(ws && ws.readyState === WebSocket.OPEN){
        ws.send(JSON.stringify(obj));
      }else{
        L("WS non connecté, impossible d'envoyer.");
      }
    }

    // ---------- Wallet POWCHAIN local ----------
    function loadPowWallet(){
      try{
        const raw = localStorage.getItem("powchain_wallet");
        if(!raw){
          powWallet = null;
          qs("powAddr").value = "";
          qs("powBal").textContent = "0";
          qs("powUsdcBal").textContent = "0";
          return;
        }
        powWallet = JSON.parse(raw);
        qs("powAddr").value = powWallet.pub || "";
        L("Wallet POWCHAIN rechargé depuis localStorage.");
        refreshPowBalances();
      }catch(e){
        L("Erreur load wallet POWCHAIN: "+e.message);
      }
    }

    function savePowWallet(){
      if(!powWallet) return;
      localStorage.setItem("powchain_wallet", JSON.stringify(powWallet));
    }

    async function generatePowWallet(){
      try{
        // génération locale, jamais envoyée telle quelle au serveur
        const kp = solanaWeb3.Keypair.generate();
        powWallet = {
          pub: kp.publicKey.toBase58(),
          priv: bs58Encode(kp.secretKey)
        };
        qs("powAddr").value = powWallet.pub;
        savePowWallet();
        L("Nouveau wallet POWCHAIN généré.");
        refreshPowBalances();
      }catch(e){
        L("Erreur génération wallet POWCHAIN: "+e.message);
        alert("Erreur génération wallet POWCHAIN (voir console).");
      }
    }

    async function refreshPowBalances(){
      if(!powWallet || !powWallet.pub) return;
      const res = await api(`wallet?id=${encodeURIComponent(powWallet.pub)}`);
      if(!res) return;
      qs("powBal").textContent = res.pow ?? 0;
      qs("powUsdcBal").textContent = res.usdc ?? 0;
      L("Solde POWCHAIN mis à jour.");
    }

    // ---------- Phantom + Sol balances ----------
    async function connectPhantom(){
      try{
        if(!window.solana || !window.solana.isPhantom){
          alert("Phantom n'est pas détecté dans ce navigateur.");
          return;
        }
        const resp = await window.solana.connect();
        solPubkey = resp.publicKey.toString();
        qs("solAddr").textContent = solPubkey;
        solConnection = new solanaWeb3.Connection(RPC_SOL,"confirmed");
        qs("btnRefreshSol").disabled = false;
        L("Phantom connecté: "+solPubkey);
        refreshSolBalances();
      }catch(e){
        L("Erreur Phantom connect: "+e.message);
        alert("Erreur Phantom (voir console).");
      }
    }

    async function refreshSolBalances(){
      if(!solConnection || !solPubkey) return;
      try{
        const pub = new solanaWeb3.PublicKey(solPubkey);

        const lamports = await solConnection.getBalance(pub,"confirmed");
        const sol = lamports / solanaWeb3.LAMPORTS_PER_SOL;
        qs("solBal").textContent = sol.toFixed(4);

        const tok = await solConnection.getParsedTokenAccountsByOwner(
          pub,
          { mint: USDC_MINT_SOL },
          "confirmed"
        );
        let usdc = 0;
        for(const acc of tok.value){
          const amt = acc.account.data.parsed.info.tokenAmount.uiAmount || 0;
          usdc += amt;
        }
        qs("usdcBal").textContent = usdc.toFixed(2);
        L("Soldes Phantom : SOL + USDC Solana mis à jour.");
      }catch(e){
        L("PHANTOM ERR get balances: "+e.message);
      }
    }

    // ---------- Bridge & TX POWCHAIN ----------
    async function sendBridge(){
      if(!solPubkey){
        alert("Connecte Phantom d'abord.");
        return;
      }
      const amt = parseFloat(qs("bridgeAmount").value || "0");
      if(!(amt > 0)){
        alert("Montant SOL invalide.");
        return;
      }
      L(`BRIDGE_REQUEST envoyé SOL ${amt}`);
      // le backend POWCHAIN interprète cette requête
      const payload = { type:"BRIDGE_REQUEST", from: solPubkey, amount: amt };
      // on passe par /tx pour rester compatible avec le server.js actuel
      const res = await api("tx",{
        method:"POST",
        headers:{ "Content-Type":"application/json" },
        body:JSON.stringify(payload)
      });
      if(!res){
        L("Bridge: aucune réponse (voir logs serveur).");
        return;
      }
      L("Bridge réponse: "+JSON.stringify(res));
      alert("Requête de bridge envoyée (détails dans la console POWCHAIN).");
    }

    async function sendPow(){
      if(!powWallet || !powWallet.pub){
        alert("Wallet POWCHAIN non initialisé.");
        return;
      }
      const to = qs("sendTo").value.trim();
      const amt = parseFloat(qs("sendAmount").value || "0");
      if(!to || !(amt>0)){
        alert("Destinataire ou montant invalide.");
        return;
      }
      const tx = { type:"SEND_POW", from:powWallet.pub, to, amount:amt };
      sendWs(tx);
      L(`TX SEND_POW ${amt} → ${to}`);
    }

    async function stakePow(){
      if(!powWallet || !powWallet.pub){
        alert("Wallet POWCHAIN non initialisé.");
        return;
      }
      const amt = parseFloat(qs("stakeAmount").value || "0");
      if(!(amt>0)){
        alert("Montant invalide.");
        return;
      }
      const tx = { type:"STAKE_POW", from:powWallet.pub, amount:amt };
      sendWs(tx);
      L(`TX STAKE_POW ${amt}`);
    }

    async function addLp(){
      if(!powWallet || !powWallet.pub){
        alert("Wallet POWCHAIN non initialisé.");
        return;
      }
      const pow = parseFloat(qs("lpPow").value || "0");
      const usdc = parseFloat(qs("lpUsdc").value || "0");
      if(!(pow>0) || !(usdc>0)){
        alert("Montants LP invalides.");
        return;
      }
      const tx = { type:"ADD_LP", from:powWallet.pub, pow, usdc };
      sendWs(tx);
      L(`TX ADD_LP POW=${pow} USDC=${usdc}`);
    }

    async function loadBlocks(){
      const chain = await api("chain");
      if(!chain) return;
      L("Derniers blocs :");
      const last = Array.isArray(chain) ? chain.slice(-10) : [];
      for(const b of last){
        L(`#${b.height} ts=${b.ts || b.time} txs=${(b.txs||[]).length}`);
      }
    }

    // ---------- Petit graphe fake local (x*y=k snapshot) ----------
    function drawChart(){
      const canvas = qs("chartCanvas");
      const ctx = canvas.getContext("2d");
      const dpr = window.devicePixelRatio || 1;
      const w = canvas.clientWidth || 300;
      const h = canvas.clientHeight || 140;
      canvas.width = w*dpr;
      canvas.height = h*dpr;
      ctx.scale(dpr,dpr);

      ctx.clearRect(0,0,w,h);
      ctx.strokeStyle = "#0ea5e9";
      ctx.lineWidth = 2;
      ctx.beginPath();
      const k = 1;
      for(let i=1;i<=200;i++){
        const x = i/200;
        const y = k/x;
        const px = x*w;
        const py = h - Math.min(h, y*h/4);
        if(i===1) ctx.moveTo(px,py);
        else ctx.lineTo(px,py);
      }
      ctx.stroke();

      ctx.strokeStyle = "#1f2937";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0,h-15);
      ctx.lineTo(w,h-15);
      ctx.stroke();
    }

    // ---------- Utils bs58 ----------
    // mini encodage base58 depuis Uint8Array (utilisation locale uniquement)
    const ALPHABET="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
    function bs58Encode(bytes){
      if(!bytes || !bytes.length) return "";
      let digits=[0];
      for(let i=0;i<bytes.length;i++){
        let carry=bytes[i];
        for(let j=0;j<digits.length;j++){
          const x=(digits[j]<<8)+carry;
          digits[j]=x%58;
          carry=(x/58)|0;
        }
        while(carry){
          digits.push(carry%58);
          carry=(carry/58)|0;
        }
      }
      let zeros=0;
      for(let k=0;k<bytes.length && bytes[k]===0;k++) zeros++;
      let res="";
      for(let i=0;i<zeros;i++) res+=ALPHABET[0];
      for(let q=digits.length-1;q>=0;q--) res+=ALPHABET[digits[q]];
      return res;
    }


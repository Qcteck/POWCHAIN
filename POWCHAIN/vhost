  }

  // SIGNATURE TX POWCHAIN
  async function signPowTx(obj){
    const w = loadLocalWallet();
    if (!w){ alert("Génère d'abord un wallet POWCHAIN."); return null; }
    const msgObj = {
      type: obj.type,
      from: w.addr,
      to:   obj.to   ?? null,
      amount: obj.amount ?? null,
      extra: obj.extra ?? null
    };
    const msg = new TextEncoder().encode(JSON.stringify(msgObj));
    const priv = bs58.decode(w.priv);
    const sig  = nacl.sign.detached(msg, priv);
    const tx = {...obj, from:w.addr, sig: bs58.encode(sig)};
    return tx;
  }

  async function sendPowTx(tx){
    const res = await fetchJSON("/tx",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(tx)
    });
    return res;
  }

  // Phantom
  async function connectPhantom(){
    if (!window.solana || !window.solana.isPhantom){
      alert("Phantom n'est pas disponible dans ce navigateur.");
      return;
    }
    try{
      const resp = await window.solana.connect();
      solPublicKey = resp.publicKey;
      el("solAddr").value = solPublicKey.toBase58();
      logLine("Phantom connecté : "+el("solAddr").value);
      await refreshSolBalances();
    }catch(e){
      logLine("ERR Phantom connect: "+e.message);
    }
  }

  async function refreshSolBalances(){
    if (!solPublicKey){
      logLine("Connecte Phantom d'abord.");
      return;
    }
    try{
      if (!solConn){
        solConn = new solanaWeb3.Connection(DRPC_URL,"confirmed");
      }
      const solLamports = await solConn.getBalance(solPublicKey);
      el("balSol").value = (solLamports / 1e9).toFixed(5);

      // USDC Solana
      const ata = await solConn.getParsedTokenAccountsByOwner(
        solPublicKey,
        { mint: new solanaWeb3.PublicKey(USDC_SOL_MINT) }
      );
      let usdc = 0;
      ata.value.forEach(a=>{
        const info = a.account.data.parsed.info;
        const amt  = Number(info.tokenAmount.uiAmount || 0);
        usdc += amt;
      });
      el("balUsdcSol").value = usdc.toFixed(2);
      logLine("Soldes Solana mis à jour (SOL + USDC).");
    }catch(e){
      logLine("PHANTOM ERR: "+e.message);
    }
  }

  // Bridge SOL → POWCHAIN (vers /bridge)
  async function doBridge(){
    const w = loadLocalWallet();
    if (!w){
      alert("Génère d'abord un wallet POWCHAIN.");
      return;
    }
    if (!solPublicKey){
      alert("Connecte Phantom d'abord.");
      return;
    }
    const amtStr = el("bridgeAmount").value.trim();
    const amount = Number(amtStr);
    if (!amtStr || !Number.isFinite(amount) || amount<=0){
      alert("Montant SOL invalide.");
      return;
    }
    try{
      logLine("BRIDGE_REQUEST préparation "+amount+" SOL → "+w.addr+" ...");

      const payload = {
        fromSol: solPublicKey.toBase58(),
        toPow: w.addr,
        amount,
        sig: "phantom-"+Date.now() // placeholder, vérif côté serveur plus tard
      };

      const res = await fetchJSON("/bridge",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify(payload)
      });

      logLine("Bridge réponse: "+JSON.stringify(res));
      alert("Requête de bridge envoyée (voir log).");
      await syncPowWalletFromServer();
      await refreshStats();
    }catch(e){
      logLine("ERR bridge: "+e.message);
      alert("Erreur bridge (voir log).");
    }
  }

  // WebSocket
  function connectWs(){
    try{
      ws = new WebSocket(WS_URL);
    }catch(e){
      logLine("WS création échouée: "+e.message);
      setBackendStatus(!!lastHttpTime,false);
      return;
    }
    ws.onopen = ()=>{
      logLine("WebSocket connecté.");
      setBackendStatus(!!lastHttpTime,true);
    };
    ws.onclose = ()=>{
      logLine("WebSocket fermé. Reconnexion dans 3 s.");
      setBackendStatus(!!lastHttpTime,false);
      setTimeout(connectWs,3000);
    };
    ws.onerror = (e)=>{
      logLine("WS error: "+(e.message||"undefined"));
    };
    ws.onmessage = (msg)=>{
      try{
        const data = JSON.parse(msg.data);
        if (data.type==="welcome"){
          logLine("WS welcome, height="+data.height);
        }else if (data.type==="block"){
          logLine("Nouveau bloc height="+data.height);
          refreshStats();
          syncPowWalletFromServer();
        }else if (data.type==="stats"){
          logLine("WS msg: "+JSON.stringify(data));
        }else{
          logLine("WS msg: "+JSON.stringify(data));
        }
      }catch(e){
        logLine("WS parse error: "+e.message);
      }
    };
  }

  // Chart simple POW/USDC (placeholder)
  function drawChart(){
    const canvas = el("chart");
    const ctx = canvas.getContext("2d");
    const w = canvas.width = canvas.clientWidth;
    const h = canvas.height = canvas.clientHeight;
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle = "#22d3ee";
    ctx.lineWidth = 2;
    ctx.beginPath();
    const points = 30;
    for (let i=0;i<points;i++){
      const x = (i/(points-1))*w;
      const y = h - Math.pow(i/(points-1),1.4)*h*0.8 - h*0.1;
      if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }
    ctx.stroke();
  }

  // Boutons
  el("btnGenPow").onclick = ()=>{
    generatePowWallet();
    syncPowWalletFromServer();
  };
  el("btnReloadPow").onclick = syncPowWalletFromServer;
  el("btnConnectPhantom").onclick = connectPhantom;
  el("btnRefreshSol").onclick = refreshSolBalances;
  el("btnLoadBlocks").onclick = loadBlocks;
  el("btnClearLog").onclick = ()=>{logBox.value="";};
  el("btnBridge").onclick = doBridge;

  el("btnSend").onclick = async ()=>{
    try{
      const to = el("destPow").value.trim();
      const amount = Number(el("sendAmount").value.trim());
      if (!to || !Number.isFinite(amount) || amount<=0){
        alert("Remplis destinataire + montant.");
        return;
      }
      const tx = await signPowTx({type:"transfer",to,amount});
      if (!tx) return;
      const res = await sendPowTx(tx);
      logLine("TX transfer réponse: "+JSON.stringify(res));
      await syncPowWalletFromServer();
      await refreshStats();
    }catch(e){
      logLine("ERR send POW: "+e.message);
    }
  };

  el("btnStake").onclick = async ()=>{
    try{
      const amount = Number(el("stakeAmount").value.trim());
      if (!Number.isFinite(amount) || amount<=0){
        alert("Montant stake invalide.");
        return;
      }
      const tx = await signPowTx({type:"stake",amount});
      if (!tx) return;
      const res = await sendPowTx(tx);
      logLine("TX stake réponse: "+JSON.stringify(res));
      await syncPowWalletFromServer();
      await refreshStats();
    }catch(e){
      logLine("ERR stake: "+e.message);
    }
  };

  el("btnAddLp").onclick = async ()=>{
    try{
      const amountPow  = Number(el("lpPow").value.trim());
      const amountUsdc = Number(el("lpUsdc").value.trim());
      if (amountPow<=0 || amountUsdc<=0){
        alert("Montants LP invalides.");
        return;
      }
      const tx = await signPowTx({
        type:"add_lp",
        amountPow,
        amountUsdc
      });
      if (!tx) return;
      const res = await sendPowTx(tx);
      logLine("TX add_lp réponse: "+JSON.stringify(res));
      await syncPowWalletFromServer();
      await refreshStats();
    }catch(e){
      logLine("ERR add LP: "+e.message);
    }
  };

  // Init
  window.addEventListener("load",()=>{
    drawChart();
    const w = loadLocalWallet();
    if (w) updatePowBalancesView(w);
    refreshStats();
    syncPowWalletFromServer();
    connectWs();
    setInterval(refreshStats,30000);
    window.addEventListener("resize",drawChart);
  });
})();
</script>

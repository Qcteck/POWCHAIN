sudo nano /etc/nginx/sites-available/bbqfinance



server {
    server_name bbqfinance.fun www.bbqfinance.fun;

    # HTML du Dashboard
    root /root/powchain;
    index index.html;

    # Dashboard sur /
    location / {
        try_files $uri /index.html;
    }

    # API POWCHAIN : https://bbqfinance.fun/powchain/... -> http://127.0.0.1:3000/powchain/...
    location /powchain {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # WebSocket POWCHAIN : wss://bbqfinance.fun/powchain/ws -> ws://127.0.0.1:7001/powchain/ws
    location /powchain/ws {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/bbqfinance.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbqfinance.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name bbqfinance.fun www.bbqfinance.fun;
    return 301 https://$host$request_uri;
}
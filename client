<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>POWCHAIN — Quantum Client</title>
<style>
body{margin:0;background:#030b15;color:#9fe7ff;font-family:system-ui}
h2{text-align:center;margin:6px 0;color:#00e7ff}
#main{max-width:900px;margin:auto;padding:10px}
input,button{background:#041625;border:1px solid #0ae;color:#9fe7ff;border-radius:6px;padding:7px;margin:3px;font-size:14px}
#log{background:#0009;height:240px;overflow:auto;border:1px solid #0ae;padding:6px;font-size:12px}
.card{background:#04131e;border:1px solid #0ae;padding:12px;border-radius:10px;margin:8px 0}
</style>
</head>
<body>
<div id="main">
<h2>POWCHAIN — Quantum Wallet</h2>
<div class="card">
<button onclick="gen()">Créer Wallet POWCHAIN</button>
<input id="pub" placeholder="Adresse publique" style="width:100%"/>
<input id="priv" placeholder="Clé privée" style="width:100%"/>
<button onclick="connect()">Connect</button>
</div>
<div class="card">
<input id="to" placeholder="Adresse destinataire" style="width:100%"/>
<input id="amount" type="number" placeholder="Montant POW" style="width:100%"/>
<button onclick="send()">Envoyer POW</button>
</div>
<div class="card">
<button onclick="sync()">Sync wallet</button>
<div id="log"></div>
</div>
</div>
<script>
const log=t=>{document.getElementById("log").innerHTML+=t+"<br>";};
let addr="",priv="";
function gen(){
  const kp=nacl.sign.keyPair();addr=bs58.encode(kp.publicKey);priv=bs58.encode(kp.secretKey);
  document.getElementById("pub").value=addr;
  document.getElementById("priv").value=priv;
  log("Wallet généré !");
}
function connect(){
  addr=document.getElementById("pub").value.trim();
  priv=document.getElementById("priv").value.trim();
  log("Connecté : "+addr);
}
async function sync(){
  const r=await fetch("/balance/"+addr);const j=await r.json();
  log("SOLDE POW = "+(j.pow/1e6)+" | USDC POW = "+(j.usdc/1e6));
}
async function send(){
  const to=document.getElementById("to").value.trim();
  const amount=parseFloat(document.getElementById("amount").value);
  const body=JSON.stringify({from:addr,priv,amount:amount*1e6,to});
  const r=await fetch("/transfer",{method:"POST",headers:{"Content-Type":"application/json"},body});
  log(await r.text());
}
</script>
<script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bs58@5.0.0/dist/bs58.min.js"></script>
</body>
</html>

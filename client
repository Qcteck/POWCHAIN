const express=require("express");
const nacl=require("tweetnacl");
const bs58=require("bs58");
const path=require("path");

const app=express();
app.use(express.json());

// Statut simple pour tester le backend
app.get("/",(req,res)=>{
  res.send("POWCHAIN backend ONLINE ✅ Utilise /client pour ouvrir l'interface.");
});

// 🔹 Route pour ton fichier client (client.html)
app.get("/client",(req,res)=>{
  res.sendFile(path.join(__dirname,"client.html"));
});

// 🔹 Exemple de route API : création d'un wallet
app.get("/new-wallet",(req,res)=>{
  const kp=nacl.sign.keyPair();
  const addr=bs58.encode(Buffer.from(kp.publicKey));
  const secret=bs58.encode(Buffer.from(kp.secretKey));
  res.json({address:addr,secret});
});

// 🔹 Serveur accessible depuis l'extérieur
const PORT=3000;
app.listen(PORT,"0.0.0.0",()=>console.log("POWCHAIN server running on port "+PORT));
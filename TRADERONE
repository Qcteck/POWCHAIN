#!/usr/bin/env bash
set -euo pipefail

echo "==============================="
echo "MEGA NGINX MAP VIEW (READ-ONLY)"
echo "==============================="

OUTDIR="/var/www/nginx-map"
OUTHTML="$OUTDIR/index.html"

mkdir -p "$OUTDIR"

echo "[1/6] Collecte infos nginx..."
NGINX_BIN=$(command -v nginx || true)
NGINX_V=$(nginx -v 2>&1 || echo "nginx inconnu")

echo "[2/6] Dump config active..."
nginx -T > /tmp/nginx_full_dump.txt 2>/dev/null || true

echo "[3/6] Extraction vhosts actifs..."
ls -l /etc/nginx/sites-enabled > /tmp/sites-enabled.txt

echo "[4/6] Extraction routes (root / alias / location)..."
grep -R --line-number -E "server_name|root |alias |location " /etc/nginx/sites-enabled /etc/nginx/includes \
  > /tmp/nginx_routes.txt || true

echo "[5/6] Génération HTML..."

cat > "$OUTHTML" <<'HTML'
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>NGINX LIVE MAP</title>
<style>
body {
  background:#0b0f1a;
  color:#e0e6ff;
  font-family: monospace;
}
h1,h2 { color:#6cf; }
a { color:#7CFC98; text-decoration:none; }
pre {
  background:#111;
  padding:10px;
  overflow:auto;
  border:1px solid #333;
}
.section {
  margin-bottom:30px;
}
</style>
</head>
<body>
<h1>NGINX LIVE MAP – VPS</h1>
HTML

echo "<div class='section'><h2>NGINX VERSION</h2><pre>$NGINX_V</pre></div>" >> "$OUTHTML"

echo "<div class='section'><h2>SITES ENABLED</h2><pre>" >> "$OUTHTML"
cat /tmp/sites-enabled.txt >> "$OUTHTML"
echo "</pre></div>" >> "$OUTHTML"

echo "<div class='section'><h2>ROUTES (root / alias / location)</h2><pre>" >> "$OUTHTML"
cat /tmp/nginx_routes.txt >> "$OUTHTML"
echo "</pre></div>" >> "$OUTHTML"

echo "<div class='section'><h2>FULL NGINX DUMP (nginx -T)</h2><pre>" >> "$OUTHTML"
sed 's/</\&lt;/g; s/>/\&gt;/g' /tmp/nginx_full_dump.txt >> "$OUTHTML"
echo "</pre></div>" >> "$OUTHTML"

cat >> "$OUTHTML" <<'HTML'
</body>
</html>
HTML

echo "[6/6] Permissions..."
chown -R www-data:www-data "$OUTDIR"
chmod -R 755 "$OUTDIR"

echo "==============================="
echo "OK – MAP DISPONIBLE"
echo "URL : https://TON_DOMAINE/nginx-map/"
echo "==============================="
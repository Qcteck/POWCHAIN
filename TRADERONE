#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA • EMBERBRAIN • ALPHA / BETA / GAMMA DEPLOY ==="

# ============================================================
# VARIABLES
# ============================================================
WEB_ROOT="/var/www"
APP_DIR="$WEB_ROOT/aiaquila"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
BACKUP_DIR="/root/aiaquila_backup_$(date +%Y%m%d_%H%M%S)"

# ============================================================
# CHECK ROOT
# ============================================================
[ "$EUID" -eq 0 ] || { echo "❌ Ce script doit être lancé en root"; exit 1; }

# ============================================================
# BACKUP
# ============================================================
if [ -d "$APP_DIR" ]; then
  echo "→ Backup existant vers $BACKUP_DIR"
  mkdir -p "$BACKUP_DIR"
  cp -a "$APP_DIR" "$BACKUP_DIR/"
fi

mkdir -p "$APP_DIR"

# ============================================================
# FRONTEND COMPLET
# ============================================================
echo "→ Écriture frontend AIAQUILA"

cat > "$APP_DIR/index.html" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA • EMBERBRAIN</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
body{margin:0;background:#0b0f14;color:#e7eef7;font-family:system-ui}
h1{font-size:20px;margin-bottom:4px}
h2{font-size:14px;margin:6px 0;color:#9db2c7}
section{border:1px solid #1f2a3a;border-radius:12px;padding:12px;margin-bottom:12px;background:#0f1726}
button,select{background:#162235;border:1px solid #24344a;color:#e7eef7;border-radius:8px;padding:8px}
button:disabled{opacity:.4}
.badge{display:inline-block;padding:4px 8px;border-radius:999px;background:#121f33;border:1px solid #24344a;font-size:11px;margin-right:6px}
pre{white-space:pre-wrap;background:#0e1522;border:1px solid #24344a;border-radius:8px;padding:8px;font-size:11px;max-height:240px;overflow:auto}
canvas{background:#05080e;border:1px solid #24344a;border-radius:10px}
.small{font-size:11px;color:#9db2c7}
</style>
</head>

<body>
<div style="max-width:1200px;margin:auto;padding:16px">

<h1>AIAQUILA • EMBERBRAIN</h1>
<div class="badge">Décisionnel</div>
<div class="badge">RSS réels</div>
<div class="badge">ALPHA / BÊTA / GAMMA</div>
<div class="badge">Explicable</div>

<section>
<h2>🧠 Rythme cognitif</h2>
<select id="rhythm">
  <option value="alpha">ALPHA — stratégique (lent)</option>
  <option value="beta">BÊTA — réactif (rapide)</option>
  <option value="gamma">GAMMA — urgence (stress)</option>
</select>
</section>

<section>
<h2>📰 EMBERBRAIN — Analyse RSS</h2>
<button onclick="loadRSS()">Charger RSS</button>
<pre id="rssOut">—</pre>
</section>

<section>
<h2>🦅 AIAQUILA — Décision expliquée</h2>
<button onclick="runDecision()">Décider</button>
<pre id="decisionOut">—</pre>
</section>

<section>
<h2>📈 Timeline décisionnelle (particules)</h2>
<canvas id="timeline" width="1100" height="220"></canvas>
<p class="small">Chaque particule = une décision, couleur = rythme</p>
</section>

<section>
<h2>✋ Action humaine</h2>
<button id="signBtn" disabled>Signer avec Phantom</button>
<p class="small">AIAQUILA n’ouvre jamais Phantom seul.</p>
</section>

</div>

<script>
/* ===================== STRUCTURE 100×4 ===================== */
const CAPABILITIES=[...Array(100)].map((_,i)=>"Capacité_"+(i+1));
const OBJECTIVES=[...Array(100)].map((_,i)=>"Objectif_"+(i+1));
const TOOLS=[...Array(100)].map((_,i)=>"Outil_"+(i+1));
const STRATEGIES=[...Array(100)].map((_,i)=>"Stratégie_"+(i+1));

/* ===================== RSS ===================== */
const RSS_PROXY="https://emberbrain-rss-proxy.workers.dev/?url=";
const FEEDS=[
 "https://cointelegraph.com/rss",
 "https://www.coindesk.com/arc/outboundfeeds/rss/",
 "https://www.reuters.com/rssFeed/businessNews",
 "https://www.ft.com/rss/home"
];

let RSS_STATE=[];
let DECISIONS=[];

/* ===================== RSS LOAD ===================== */
async function loadRSS(){
  RSS_STATE=[];
  for(const f of FEEDS){
    try{
      const r=await fetch(RSS_PROXY+encodeURIComponent(f));
      const t=await r.text();
      RSS_STATE.push({url:f,items:(t.match(/<item>/g)||[]).length});
    }catch(e){
      RSS_STATE.push({url:f,error:true});
    }
  }
  rssOut.textContent=JSON.stringify(RSS_STATE,null,2);
}

/* ===================== DÉCISION ===================== */
function runDecision(){
  if(!RSS_STATE.length){alert("RSS requis");return;}

  const rhythm=document.getElementById("rhythm").value;
  const total=RSS_STATE.reduce((a,b)=>a+(b.items||0),0);

  let score=1;
  let reasons=[];

  if(rhythm==="alpha" && total>30){score-=0.25;reasons.push("ALPHA: bruit excessif");}
  if(rhythm==="beta"  && total>60){score-=0.25;reasons.push("BÊTA: surcharge rapide");}
  if(rhythm==="gamma" && total>20){score-=0.4; reasons.push("GAMMA: surcharge critique");}

  score=Math.max(0,score);
  const decision=score<0.6?"BLOCK":score<0.8?"CAUTION":"ALLOW";

  const obj={
    time:Date.now(),
    rhythm,
    decision,
    confidence:Math.round(score*100)
  };

  DECISIONS.push(obj);
  drawTimeline();

  decisionOut.textContent=JSON.stringify({
    ...obj,
    explanation:{
      rss_total:total,
      strategy:STRATEGIES[0],
      capabilities:CAPABILITIES.slice(0,3),
      tools:TOOLS.slice(0,2),
      reasons
    }
  },null,2);

  signBtn.disabled=(decision==="BLOCK");
}

/* ===================== PARTICULES ===================== */
const ctx=document.getElementById("timeline").getContext("2d");

function drawTimeline(){
  ctx.clearRect(0,0,1100,220);
  const now=Date.now();
  DECISIONS.forEach(d=>{
    const x=1100-(now-d.time)/100;
    const y=110;
    let c="#4ade80";
    if(d.rhythm==="beta")c="#60a5fa";
    if(d.rhythm==="gamma")c="#f87171";
    ctx.beginPath();
    ctx.arc(x,y,6,0,Math.PI*2);
    ctx.fillStyle=c;
    ctx.fill();
  });
}

/* ===================== SIGNATURE HUMAINE ===================== */
signBtn.onclick=async()=>{
  if(!window.solana||!window.solana.isPhantom){
    alert("Phantom non détecté");return;
  }
  alert("Signature déclenchée par action humaine uniquement");
  await window.solana.connect();
};
</script>
</body>
</html>
HTML

# ============================================================
# NGINX
# ============================================================
if ! grep -q "location /aiaquila" "$NGINX_SITE"; then
  sed -i '/server_name fireinners.online/a \
\\n    location /aiaquila/ {\
        alias /var/www/aiaquila/;\
        index index.html;\
    }\
' "$NGINX_SITE"
fi

nginx -t
systemctl reload nginx

echo "=== AIAQUILA OPÉRATIONNEL ==="
echo "→ https://fireinners.online/aiaquila"
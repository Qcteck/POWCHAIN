cat >/root/FIX_NDJSON_ORIGIN_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
DATA_DIR="/var/www/ndjson_data"
UI_DIR="/var/www/ndjson"

echo "[1/8] Backup"
TS=$(date +%Y%m%d_%H%M%S)
cp -a "$VHOST" "/root/BK_fireinners_vhost_$TS"

echo "[2/8] Unfreeze nginx"
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$VHOST" 2>/dev/null || true

echo "[3/8] Prepare directories"
mkdir -p "$DATA_DIR" "$UI_DIR"
chmod 755 "$DATA_DIR" "$UI_DIR"

echo '{"ts":"'$(date -Is)'","status":"ndjson-origin-ok"}' >"$DATA_DIR/events.ndjson"

echo "[4/8] Write NDJSON UI"
cat >"$UI_DIR/index.html" <<'HTML'
<!doctype html>
<html><head><meta charset="utf-8"><title>NDJSON</title></head>
<body style="background:#0b0f14;color:#e7eef7;font-family:monospace">
<h1>NDJSON LIVE</h1>
<pre id="out">loading…</pre>
<script>
fetch('/data/events.ndjson').then(r=>r.text()).then(t=>{
  document.getElementById('out').textContent=t;
});
</script>
</body></html>
HTML

echo "[5/8] Patch server block DIRECTLY"
sed -i '/server_name fireinners.online;/a \
\
  location = /ndjson { return 301 /ndjson/; }\
\
  location /ndjson/ {\
    root /var/www;\
    index index.html;\
  }\
\
  location /data/ {\
    alias /var/www/ndjson_data/;\
    default_type application/x-ndjson;\
    add_header Cache-Control "no-store";\
  }\
' "$VHOST"

echo "[6/8] Test nginx"
nginx -t

echo "[7/8] Reload nginx"
systemctl reload nginx

echo "[8/8] Done"
echo "UI:   https://fireinners.online/ndjson/"
echo "DATA: https://fireinners.online/data/events.ndjson"
BASH



bash /root/FIX_NDJSON_ORIGIN_FINAL.sh |& tee /root/FIX_NDJSON_ORIGIN_FINAL.log

set -e
cd /root

F=/etc/nginx/sites-enabled/fireinners.online-ssl
cp -v "$F" "/root/nginx_backups/$(basename "$F").matchdebug.$(date +%Y%m%d_%H%M%S)"

# Ajoute un header dans le bloc location traderone/api (si pas déjà présent)
perl -0777 -i -pe '
  s#(location\s+\^~\s+/wolverine/traderone/api/\s*\{\n)#$1  add_header X-MATCH traderone-api always;\n#s
' "$F"

nginx -t
systemctl reload nginx

echo "=== Test LOCAL via nginx (bypass Cloudflare) SANS clé ==="
curl -sS -i -X POST "http://127.0.0.1/wolverine/traderone/api/status" \
  -H "Host: fireinners.online" -H "content-type: application/json" --data '{}' | head -n 35
set -euo pipefail

EN="/etc/nginx/sites-enabled"
DIS="/etc/nginx/sites-disabled/cleanup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$DIS"

echo "=== AVANT (sites-enabled) ==="
ls -lah "$EN" || true
echo

echo "=== 1) Déplacer tous les fichiers .bak* hors de sites-enabled ==="
shopt -s nullglob
for f in "$EN"/*bak* "$EN"/*before_edit* "$EN"/*rm_tests* "$EN"/*dupe*; do
  mv "$f" "$DIS/" && echo "Moved: $f -> $DIS/"
done
shopt -u nullglob
echo

echo "=== 2) Déplacer aussi tout fichier NORMAL (non-symlink) hors sites-enabled (les backups finissent souvent comme ça) ==="
for f in "$EN"/*; do
  [ -e "$f" ] || continue
  if [ ! -L "$f" ]; then
    mv "$f" "$DIS/" && echo "Moved non-symlink: $f -> $DIS/"
  fi
done
echo

echo "=== APRES (sites-enabled) ==="
ls -lah "$EN" || true
echo

echo "=== 3) Test nginx ==="
nginx -t
systemctl reload nginx
echo "✅ OK"
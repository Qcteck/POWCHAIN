<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>WOLVERINE • Crypto Prediction Engine LT + LocalStorage</title>
<style>
body{margin:0;background:#020617;color:#e5e7eb;font-family:system-ui}
header{padding:12px;font-weight:700;background:#020617}
#app{display:grid;grid-template-columns:260px 1fr 260px;height:calc(100vh - 48px)}
.panel,.center{padding:10px;overflow:auto}
.card{background:#020617;border-radius:8px;padding:8px;margin-bottom:8px}
.green{color:#22c55e}
.red{color:#ef4444}
progress{width:100%;height:8px}
.crypto{border-bottom:1px solid #1e293b;margin-bottom:12px;padding-bottom:8px}
.stat{font-size:13px;margin-top:2px}
</style>
</head>
<body>

<header>🐺 WOLVERINE • IA Crypto Auto-Évolutive LT + Storage</header>

<div id="app">

<div class="panel">
<h3>Variables</h3>
<div class="card">Temps</div>
<div class="card">Momentum</div>
<div class="card">Volatilité</div>
<div class="card">Moyenne</div>

<h3>Précision globale</h3>
<div id="globalStats" class="card"></div>
</div>

<div class="center">
<h3>Marché & Prédictions</h3>
<div id="market"></div>
</div>

<div class="panel">
<h3>Algorithmes ≥ 95%</h3>
<div id="algos"></div>
</div>

</div>

<script>
/* ============ CONFIG ============ */
const cryptos={BTC:"bitcoin",ETH:"ethereum",SOL:"solana",SUI:"sui"};
const horizons=[
 {label:"1m",ms:60000},{label:"5m",ms:300000},{label:"10m",ms:600000},
 {label:"30m",ms:1800000},{label:"1h",ms:3600000},{label:"2h",ms:7200000},
 {label:"4h",ms:14400000},{label:"12h",ms:43200000},{label:"24h",ms:86400000}
];
const longH=[{label:"1w"},{label:"2w"},{label:"3w"},{label:"4w"}];

let algorithms=[
 {name:"Adaptive Trend Projection",weight:0.01,score:100},
 {name:"Volatility Elastic Drift",weight:0.01,score:100},
 {name:"Temporal Momentum Gradient",weight:0.01,score:100},
 {name:"Multi-Horizon Error Minimizer",weight:0.01,score:100}
];

let prices={},state={},globalStats={sum:0,count:0,avg:0};
let ltState={}; // long term predictions

/* ============ LOCAL STORAGE ============ */
function saveState(){
 localStorage.setItem("ctState",JSON.stringify(state));
 localStorage.setItem("ltState",JSON.stringify(ltState));
 localStorage.setItem("algoState",JSON.stringify(algorithms));
 localStorage.setItem("globalStats",JSON.stringify(globalStats));
}
function loadState(){
 const s=localStorage.getItem("ctState");
 const l=localStorage.getItem("ltState");
 const a=localStorage.getItem("algoState");
 const g=localStorage.getItem("globalStats");
 if(s) state=JSON.parse(s);
 if(l) ltState=JSON.parse(l);
 if(a) algorithms=JSON.parse(a);
 if(g) globalStats=JSON.parse(g);
}

/* ============ FETCH PRIX ============ */
async function fetchPrices(){
 const ids=Object.values(cryptos).join(",");
 const r=await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=usd`);
 const d=await r.json();
 Object.entries(cryptos).forEach(([k,id])=>{
  const p=Number(d[id]?.usd);
  if(Number.isFinite(p)) prices[k]=p;
 });
}

/* ============ PREDICTION COURT TERME ============ */
function predictCT(base){
 let influence=0;
 algorithms.forEach(a=>{
  influence+=(Math.random()-0.5)*a.weight*base;
 });
 return base*0.8+(base+influence)*0.2+(Math.random()-0.5)*0.01;
}

/* ============ PREDICTION LONG TERME ============ */
function predictLT(base){
 const trend=(Math.random()-0.5)*0.05*base;
 const volatility=(Math.random()-0.5)*0.1*base;
 const value=base + trend + volatility;
 const zone=Math.max(value*0.95,value*0.97)+" → "+Math.min(value*1.05,value*1.03);
 return {value,value,zone};
}

/* ============ CYCLE COURT TERME ============ */
function startCycleCT(sym,h){
 const base=prices[sym];
 if(!Number.isFinite(base)) return;
 if(!state[sym]) state[sym]={};
 state[sym][h.label]={
  start:Date.now(),
  end:Date.now()+h.ms,
  base,
  value:predictCT(base),
  active:true,
  lastScore:null,
  sumScore:state[sym][h.label]?.sumScore||0,
  count:state[sym][h.label]?.count||0,
  avgScore:state[sym][h.label]?.avgScore||0
 };
}

/* ============ CYCLE LONG TERME ============ */
function startCycleLT(sym,h){
 const base=prices[sym];
 if(!Number.isFinite(base)) return;
 if(!ltState[sym]) ltState[sym]={};
 ltState[sym][h.label]={
  start:Date.now(),
  base,
  ...predictLT(base),
  active:true,
  lastScore:null
 };
}

/* ============ CHECK CT ≥98% POUR CHAQUE CRYPTO ============ */
function canStartLT(sym){
 if(!state[sym]) return false;
 return Object.values(state[sym]).every(c=>c.avgScore>=98);
}

/* ============ UPDATE CYCLES ============ */
function updateCycles(){
 const now=Date.now();
 Object.entries(state).forEach(([sym,byH])=>{
  Object.entries(byH).forEach(([label,c])=>{
   if(!c.active) return;
   if(now>=c.end){
    const real=prices[sym];
    const err=Math.abs(c.value-real)/real;
    const score=Math.max(0,100-err*100);

    algorithms.forEach(a=>{
     a.score=a.score*0.9+score*0.1;
     if(score>95) a.weight=Math.min(a.weight+0.002,0.25);
    });

    c.lastScore=score;
    c.sumScore+=score;
    c.count++;
    c.avgScore=c.sumScore/c.count;

    globalStats.sum+=score;
    globalStats.count++;
    globalStats.avg=globalStats.sum/globalStats.count;

    c.active=false;

    const h=horizons.find(x=>x.label===label);
    setTimeout(()=>startCycleCT(sym,h),200);
   }
  });
 });

 // DÉCLENCHEMENT STRICT LT
 Object.keys(cryptos).forEach(sym=>{
  if(canStartLT(sym)){
   longH.forEach(h=>{
    if(!ltState[sym]?.[h.label]) startCycleLT(sym,h);
   });
  }
 });
 saveState();
}

/* ============ RENDER ============ */
function render(){
 const market=document.getElementById("market");
 const algos=document.getElementById("algos");
 const global=document.getElementById("globalStats");

 market.innerHTML="";
 algos.innerHTML="";

 global.innerHTML=`
  Total cycles CT: ${globalStats.count}<br>
  Précision globale CT: <span class="green">${globalStats.avg.toFixed(2)}%</span>
 `;

 algorithms.filter(a=>a.score>=95).forEach(a=>{
  algos.innerHTML+=`
   <div class="card">
    ${a.name}<br>
    <span class="green">${a.score.toFixed(2)}%</span>
   </div>`;
 });

 Object.entries(state).forEach(([sym,byH])=>{
  let html=`<div class="crypto"><h4>${sym} — $${prices[sym]?.toFixed(2)}</h4>`;
  Object.entries(byH).forEach(([label,c])=>{
   const prog=Math.min(100,((Date.now()-c.start)/(c.end-c.start))*100);
   html+=`
    <div>
     ${label} → ${c.value.toFixed(2)} USD<br>
     <progress value="${prog}" max="100"></progress>
     <div class="stat">
      ${c.active
       ? `<span class="red">Moyenne ${c.avgScore.toFixed(2)}%</span>`
       : `<span class="green">Dernière ${c.lastScore.toFixed(2)}%</span>`
      } | Moyenne cat. ${c.avgScore.toFixed(2)}%
     </div>
    </div>`;
  });
  html+="</div>";
  market.innerHTML+=html;
 });

 // Affiche LT
 Object.entries(ltState).forEach(([sym,byH])=>{
  let html=`<div class="crypto"><h4>${sym} — Long Terme</h4>`;
  Object.entries(byH).forEach(([label,c])=>{
   html+=`
    <div>
     ${label} → Zone : ${c.zone}<br>
     <div class="stat">
      ${c.active
       ? `<span class="red">En cours...</span>`
       : `<span class="green">Dernière LT calculée</span>`
      }
     </div>
    </div>`;
  });
  html+="</div>";
  market.innerHTML+=html;
 });
}

/* ============ LOOP ============ */
async function loop(){
 loadState();
 await fetchPrices();
 Object.keys(cryptos).forEach(sym=>{
  horizons.forEach(h=>{
   if(!state[sym]?.[h.label]) startCycleCT(sym,h);
  });
 });
 updateCycles();
 render();
}

setInterval(loop,3000);
</script>

</body>
</html>

set -e
cd /root

for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  echo
  echo "===== $f ====="
  mkdir -p /root/nginx_backups
  cp -v "$f" "/root/nginx_backups/$(basename "$f").pre_fixsemicolon.$(date +%Y%m%d_%H%M%S)"

  echo "--- Top 15 lines (pour voir la ligne 4) ---"
  nl -ba "$f" | sed -n '1,15p'

  echo "--- rewrite lines ---"
  grep -n 'rewrite' "$f" || true

  # Fix: ajoute ; à toute ligne rewrite qui n'en a pas
  perl -pi -e 'if (/^\s*rewrite\b/ && $_ !~ /;\s*$/) { s/\s*$/;\n/ }' "$f"
done

nginx -t
systemctl reload nginx
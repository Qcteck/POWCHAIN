nl -ba /etc/nginx/sites-enabled/fireinners.online-ssl | sed -n '1,30p'




cat >/root/nginx_fix_bad_include_fireinners.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
F="/etc/nginx/sites-enabled/fireinners.online-ssl"
ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$F" "${F}.bak_${ts}"
echo "[OK] Backup -> ${F}.bak_${ts}"

# Supprime les include invalides (tout include qui n'est pas: include <1_arg>; )
awk '
  /^[[:space:]]*include[[:space:]]/{
    if($0 ~ /^[[:space:]]*include[[:space:]]+[^;[:space:]][^;]*;[[:space:]]*$/) { print; next }
    print "[DROP] " $0 > "/dev/stderr"
    next
  }
  { print }
' "$F" > "${F}.tmp"
mv -f "${F}.tmp" "$F"

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
BASH

chmod +x /root/nginx_fix_bad_include_fireinners.sh
/root/nginx_fix_bad_include_fireinners.sh
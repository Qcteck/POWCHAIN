set -euo pipefail
TS="$(date +%s)"
DIS="/etc/nginx/sites-disabled"
mkdir -p "$DIS"

echo "=== A) Être root ==="
whoami

echo "=== B) Trouver TOUS les vhosts qui match fireinners.online ==="
FILES="$(grep -RIl --include="*" -E 'server_name\s+.*(fireinners\.online|www\.fireinners\.online)' \
  /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d 2>/dev/null | sort -u || true)"
echo "$FILES"

echo "=== C) Garder UNIQUEMENT le vhost actif (celui dans sites-enabled) et désactiver le reste ==="
KEEP="$(echo "$FILES" | grep -E '^/etc/nginx/sites-enabled/' | head -n 1 || true)"
[ -n "$KEEP" ] || { echo "KO: aucun vhost fireinners.online dans sites-enabled"; exit 1; }
echo "KEEP=$KEEP"

while read -r f; do
  [ -f "$f" ] || continue
  if [ "$f" != "$KEEP" ]; then
    echo "MOVE: $f -> $DIS/$(basename "$f").$TS"
    mv "$f" "$DIS/$(basename "$f").$TS" || true
  fi
done <<< "$FILES"

echo "=== D) Isoler /var/www/wolverine SANS toucher /var/www/fireinners ==="
if [ -d /var/www/wolverine ]; then
  mv /var/www/wolverine "/var/www/wolverine_BAD_$TS"
fi
mkdir -p /var/www/wolverine

cat > /var/www/wolverine/index.html <<'HTML'
<!doctype html><html><head><meta charset="utf-8"><title>WOLVERINE</title></head>
<body style="background:#0b0f15;color:#e6edf6;font-family:system-ui;padding:24px">
<h1>WOLVERINE UI</h1>
<p>OK: /wolverine sert bien /var/www/wolverine.</p>
<p><a href="/wolverine/traderone/api/health">API health</a></p>
</body></html>
HTML

echo "=== E) Forcer nginx: /wolverine -> /var/www/wolverine (ne touche pas l'API) ==="
cp -a "$KEEP" "$KEEP.bak.$TS"

python3 - <<'PY'
from pathlib import Path
import re
ng = Path(open("/tmp/keep_nginx","w").write("") or "")  # noop
PY

python3 - <<PY
from pathlib import Path
import re
keep = Path("$KEEP")
s = keep.read_text()

# enlève blocs /wolverine UI existants (pas l'API)
s = re.sub(r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*', '\n', s, flags=re.M)
s = re.sub(r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*', '\n', s, flags=re.M)

block = r'''
# --- WOLVERINE UI ---
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}
'''
i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: nginx conf invalide (pas de } final)")
s = s[:i] + "\n" + block + "\n" + s[i:]
keep.write_text(s)
print("OK: bloc /wolverine injecté dans", keep)
PY

nginx -t
systemctl reload nginx

echo "=== F) PREUVES ==="
echo "--- title /wolverine/ ---"
curl -LsS https://fireinners.online/wolverine/ | grep -i "<title>" | head -n 1 || true
echo "--- API health ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12 || true
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

need(){ command -v "$1" >/dev/null 2>&1 || { echo "ERROR: missing $1"; exit 1; }; }
asroot(){ [ "$(id -u)" = "0" ] || { echo "ERROR: run as root"; exit 1; }; }


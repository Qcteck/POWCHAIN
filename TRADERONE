#!/usr/bin/env bash
set -euo pipefail

FRONT_DIR="/opt/fireinners/frontend-react/app/dist/wolverine"
FRONT_FILE="$FRONT_DIR/index.html"
ASK="/opt/fireinners/sentinel/lib/askorupdate.sh"

say(){ printf '%s\n' "$*"; }

# --- askorupdate fallback (si le module n'est pas là) ---
if [ -f "$ASK" ]; then
  # shellcheck disable=SC1090
  source "$ASK"
else
  askorupdate_file(){
    local src="$1" dst="$2"
    install -d "$(dirname "$dst")"
    [ -f "$dst" ] && cp -a "$dst" "$dst.bak.$(date +%Y%m%d_%H%M%S)" || true
    cp -a "$src" "$dst"
  }

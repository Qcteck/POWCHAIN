cat >/tmp/MEGA_UNIFY_WOLVERINE_ONE_FRONT_ONE_BACK.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"

echo "=== 0) Detect active SSL vhost file (sites-enabled -> real) ==="
LINK="/etc/nginx/sites-enabled/fireinners.online-ssl"
VHOST="$(readlink -f "$LINK" 2>/dev/null || echo "$LINK")"
echo "ACTIVE LINK : $LINK"
echo "ACTIVE VHOST: $VHOST"
[ -f "$VHOST" ] || { echo "ERROR: vhost not found: $VHOST"; exit 1; }

echo "=== 1) Backups (vhost + snippets + dirs if present) ==="
mkdir -p "/root/backup_unify_${T}"
cp -a "$VHOST" "/root/backup_unify_${T}/fireinners.online-ssl.vhost.bak"
cp -a /etc/nginx/snippets "/root/backup_unify_${T}/snippets.bak" 2>/dev/null || true
tar -czf "/root/backup_unify_${T}/www_fireinners.tgz" /var/www/fireinners 2>/dev/null || true

echo "=== 2) Write unified frontend (ONE page) ==="
FRONT_DIR="/var/www/fireinners/wolverine"
mkdir -p "$FRONT_DIR"
cat >"$FRONT_DIR/index.html" <<'EOF'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Wolverine — Unified</title>
<style>
  body{margin:0;font-family:system-ui,Segoe UI,Arial;background:#0b0f14;color:#e6edf3}
  header{display:flex;align-items:center;justify-content:space-between;gap:12px;
    background:#111827;padding:12px 16px;border-bottom:1px solid #1f2937;position:sticky;top:0;z-index:5}
  h1{margin:0;font-size:15px}
  .pill{border:1px solid rgba(255,255,255,.18);background:rgba(10,18,34,.88);padding:7px 10px;border-radius:999px;font-size:12px}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(380px,1fr));gap:12px;padding:12px}
  .card{background:#020617;border:1px solid #1f2937;border-radius:12px;padding:10px}
  .card h2{margin:0 0 8px 0;font-size:13px;color:#38bdf8}

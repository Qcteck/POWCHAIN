set -euo pipefail
echo "=== nginx -t ==="
nginx -t || true
echo "=== status nginx ==="
systemctl status nginx --no-pager -l | sed -n "1,120p" || true
echo "=== conflits fireinners.online (si encore) ==="
nginx -T 2>&1 | grep -n "conflicting server name\|server_name.*fireinners\.online\|listen.*443" | head -n 200 || true
echo "=== vhost actif (443) ==="
grep -RIn --include="*.conf" "server_name[[:space:]].*fireinners\.online" /etc/nginx | head -n 200 || true
echo "=== test route /orion (headers) ==="
curl -skI https://fireinners.online/orion/ | sed -n "1,30p" || true
echo "=== contenu /orion (si statique) ==="
ls -la /var/www/orion 2>/dev/null | sed -n "1,120p" || true
ls -la /var/www/fireinners/orion 2>/dev/null | sed -n "1,120p" || true
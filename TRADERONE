set -e
cd /root

echo "=== 1) nginx -t (on capture l'erreur) ==="
ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 80

FILE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\1/p' | head -n 1)"
LINE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\2/p' | head -n 1)"
echo "FILE=$FILE"
echo "LINE=$LINE"

if [ -z "$FILE" ] || [ -z "$LINE" ] || [ ! -f "$FILE" ]; then
  echo "!! Impossible d'extraire FILE/LINE. Colle: nginx -t 2>&1 | tail -n 80"
  exit 1
fi

echo
echo "=== 2) Contexte autour de la ligne fautive ==="
START=$((LINE-15)); [ "$START" -lt 1 ] && START=1
END=$((LINE+15))
awk -v s="$START" -v e="$END" 'NR>=s && NR<=e {printf "%5d  %s\n", NR, $0}' "$FILE"

echo
echo "=== 3) Backup (hors sites-enabled) ==="
mkdir -p /root/nginx_backups
cp -v "$FILE" "/root/nginx_backups/$(basename "$FILE").$(date +%Y%m%d_%H%M%S)"

echo
echo "=== 4) Fix SUR LA LIGNE (sépare si 2 directives collées + remplit les valeurs) ==="
perl -pi -e '
  if ($. == '"$LINE"') {
    s/;\s*(proxy_set_header)/;\n  $1/g;  # sépare si collé
    s/\bproxy_set_header\s+Host\s*;/proxy_set_header Host \$host;/g;
    s/\bproxy_set_header\s+X-Real-IP\s*;/proxy_set_header X-Real-IP \$remote_addr;/g;
    s/\bproxy_set_header\s+X-Forwarded-For\s*;/proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;/g;
    s/\bproxy_set_header\s+X-Forwarded-Proto\s*;/proxy_set_header X-Forwarded-Proto \$scheme;/g;
  }
' "$FILE"

echo
echo "=== 5) nginx -t + reload ==="
nginx -t
systemctl reload nginx
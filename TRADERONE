#!/usr/bin/env bash
set -euo pipefail
umask 027
TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing: $1"; }

[ "$(id -u)" -eq 0 ] || die "run as root"
need node; need corepack; need solana; need anchor; need yarn; need jq; need curl; need python3

APP="/opt/aquila_stacking"
PROG="aquila_stacking"
BK="/root/AQUILA_STACKING_V2_DEPLOY_BK_${TS}"
mkdir -p "$BK"

MODE="${1:-localnet}" # localnet|devnet|mainnet
case "$MODE" in localnet|devnet|mainnet) ;; *) die "usage: $0 [localnet|devnet|mainnet]";; esac

say "0) Mode: $MODE"
[ -d "$APP" ] || die "missing $APP (run project batch first)"
cd "$APP"

corepack enable >/dev/null 2>&1 || true
corepack prepare yarn@1.22.22 --activate >/dev/null 2>&1 || true

say "1) Keypairs per cluster"
KP_LOCAL="$APP/target/deploy/${PROG}-keypair.json"
KP_DEV="$APP/keys/${PROG}-devnet-keypair.json"
KP_MAIN="$APP/keys/${PROG}-mainnet-keypair.json"
mkdir -p "$APP/keys" "$APP/target/deploy"

mk_kp(){ local f="$1"; [ -f "$f" ] || solana-keygen new --no-bip39-passphrase --silent --outfile "$f" >/dev/null; }
mk_kp "$KP_LOCAL"
mk_kp "$KP_DEV"
mk_kp "$KP_MAIN"

PID_LOCAL="$(solana-keygen pubkey "$KP_LOCAL")"
PID_DEV="$(solana-keygen pubkey "$KP_DEV")"
PID_MAIN="$(solana-keygen pubkey "$KP_MAIN")"

say "Program IDs:"
say "  localnet: $PID_LOCAL"
say "  devnet : $PID_DEV"
say "  mainnet: $PID_MAIN"

say "2) Configure provider cluster + wallet"
case "$MODE" in
  localnet)
    solana config set --url http://127.0.0.1:8899 >/dev/null
    solana config set --keypair "$KP_LOCAL" >/dev/null
    PID="$PID_LOCAL"
    ;;
  devnet)
    solana config set --url https://api.devnet.solana.com >/dev/null
    solana config set --keypair "$KP_DEV" >/dev/null
    PID="$PID_DEV"
    ;;
  mainnet)
    solana config set --url https://api.mainnet-beta.solana.com >/dev/null
    solana config set --keypair "$KP_MAIN" >/dev/null
    PID="$PID_MAIN"
    ;;
esac

say "3) Patch declare_id + Anchor.toml for selected mode"
cp -a "$APP/programs/$PROG/src/lib.rs" "$BK/lib.rs.bak"
cp -a "$APP/Anchor.toml" "$BK/Anchor.toml.bak"

perl -0777 -pe "s/declare_id!\\(\\\"[^\\\"]+\\\"\\);/declare_id!(\\\"$PID\\\");/g" -i "$APP/programs/$PROG/src/lib.rs"

python3 - <<PY
import re
APP="$APP"
PROG="$PROG"
PID="$PID"
MODE="$MODE"
txt=open(f"{APP}/Anchor.toml","r").read()
section=f"[programs.{MODE}]"
if section not in txt:
    txt += "\n"+section+"\n"
parts=txt.split(section,1)
pre,rest=parts[0],parts[1]
m=re.search(r"\n\\[.*?\\]\n", rest)
body = rest[:m.start()] if m else rest
tail = rest[m.start():] if m else ""
body=re.sub(rf"^\\s*{re.escape(PROG)}\\s*=\\s*\\\"[^\\\"]*\\\"\\s*$","",body,flags=re.M)
body=body.strip("\n")
if body and not body.endswith("\n"): body+="\n"
body += f'{PROG} = "{PID}"\n'
open(f"{APP}/Anchor.toml","w").write(pre+section+"\n"+body+tail)
PY

say "4) Install deps + build"
yarn install --non-interactive
anchor build

say "5) Local validator (if localnet)"
if [ "$MODE" = "localnet" ]; then
  if ! curl -s http://127.0.0.1:8899 >/dev/null 2>&1; then
    nohup solana-test-validator --reset >"$BK/solana-test-validator.log" 2>&1 &
    sleep 2
  fi
fi

say "6) Airdrop (devnet best effort)"
if [ "$MODE" = "devnet" ]; then
  solana airdrop 2 >/dev/null 2>&1 || true
fi

say "7) Deploy"
anchor deploy

say "8) Write deploy info"
ADDR="$APP/DEPLOY_${MODE}.txt"
cat >"$ADDR"<<EOF
MODE=$MODE
PROGRAM=$PROG
PROGRAM_ID=$PID
RPC_URL=$(solana config get | awk -F': ' '/RPC URL/{print $2}')
WALLET=$(solana config get | awk -F': ' '/Keypair Path/{print $2}')
TS=$TS
EOF

say "DONE: $ADDR"
say "BK: $BK"
DEP
chmod +x /root/MEGA_AQUILA_STACKING_PROJECT_V2_DEPLOY_MODES.sh

bash /root/MEGA_AQUILA_STACKING_PROJECT_V2_DEPLOY_MODES.sh "$MODE"

say "9) Summary"
say "anchor: $(anchor --version 2>/dev/null || true)"
say "solana: $(solana --version 2>/dev/null || true)"
say "Workspace: $APP"
say "Backups: $BK"
BASH
chmod +x /root/MEGA_AQUILA_FIX_ANCHOR_AND_DEPLOY_V2.sh
bash /root/MEGA_AQUILA_FIX_ANCHOR_AND_DEPLOY_V2.sh devnet
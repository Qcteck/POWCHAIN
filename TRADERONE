# 1) Source of truth: tout ce que nginx charge
nginx -T 2>/dev/null | grep -n "wolverine/traderone/api" | head -n 200

echo "-----"
# 2) Dans /etc/nginx: toutes les locations (prefix, ^~, regex) qui contiennent ce path
grep -RIn --include="*.conf" -E 'location[[:space:]]+(\^~|~\*?|=)?[[:space:]]*/wolverine/traderone/api' /etc/nginx | head -n 200
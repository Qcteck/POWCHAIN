cat >/root/cleanup_wolverine_favicon.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="${2:-/etc/nginx/sites-enabled/${DOMAIN}-ssl}"
TS="$(date +%F_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/cleanup_${TS}"
mkdir -p "$BACKDIR"

echo "[*] Backup vhost -> $BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"

echo "[*] Removing duplicated injected blocks..."
# Remove ALL injected-by-batchfix blocks
perl -0777 -i -pe 's/\n\s*# --- injected by batchfix ---.*?# --- end injected ---\s*\n/\n/smg' "$VHOST"

echo "[*] Nginx syntax check..."
nginx -t

echo "[*] Reload nginx..."
systemctl reload nginx

echo "[OK] Cleanup done. Backup: $BACKDIR"
BASH

chmod +x /root/cleanup_wolverine_favicon.sh
echo "RUN: /root/cleanup_wolverine_favicon.sh fireinners.online"
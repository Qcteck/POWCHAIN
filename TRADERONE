say "== 5) Backend server.js (Execution + pending/usage atomic + finalized commit) =="
cat >"$APP/server.js" <<'JS'
import fs from "fs";
import path from "path";
import crypto from "crypto";
import express from "express";
import cors from "cors";
import { Connection } from "@solana/web3.js";

const APP=process.env.APP_DIR||"/opt/aiaquila";
const CFG=process.env.CFG_DIR||path.join(APP,"config");
const DATA=process.env.DATA_DIR||path.join(APP,"data");

const HOST=process.env.HOST||"127.0.0.1";
const PORT=parseInt(process.env.PORT||"9688",10);

const SOL_RPC_PRIMARY=process.env.SOL_RPC_PRIMARY||"https://api.mainnet-beta.solana.com";
const SOL_RPC_BACKUP=process.env.SOL_RPC_BACKUP||"https://api.mainnet-beta.solana.com";

const POLICY_PATH=path.join(CFG,"exec_allowlist.json");
const STATE_PATH=path.join(DATA,"state.json");

fs.mkdirSync(CFG,{recursive:true});
fs.mkdirSync(DATA,{recursive:true});

function sha256(s){return crypto.createHash("sha256").update(s).digest("hex");}
function now(){return Date.now();}
function dayKey(ts){const d=new Date(ts);return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,"0")}-${String(d.getUTCDate()).padStart(2,"0")}`;}

function readJson(p, fallback){
  try{return JSON.parse(fs.readFileSync(p,"utf8"))}catch(_){return fallback}
}
function writeJsonAtomic(p, obj){
  const tmp=p+".tmp."+process.pid+"."+Math.random().toString(16).slice(2);
  fs.writeFileSync(tmp, JSON.stringify(obj,null,2));
  fs.renameSync(tmp,p);
}

function loadPolicy(){
  const pol=readJson(POLICY_PATH,null);
  if(!pol) throw new Error("Missing policy "+POLICY_PATH);
  return pol;
}

function loadState(){
  return readJson(STATE_PATH, { usage:{}, pending:{} });
}

function saveState(st){
  writeJsonAtomic(STATE_PATH, st);
}

function getConn(){
  return new Connection(SOL_RPC_PRIMARY, "confirmed");
}
function getConnBackup(){
  return new Connection(SOL_RPC_BACKUP, "confirmed");
}

async function confirmFinalized(sig, timeoutMs){
  const start=now();
  let delay=1200;
  while(now()-start<timeoutMs){
    try{
      const c=getConn();
      const st=await c.getSignatureStatuses([sig], {searchTransactionHistory:true});
      const s=st?.value?.[0];
      if(s && s.confirmationStatus==="finalized") return {ok:true, via:"primary"};
      if(s && s.err) return {ok:false, err:"tx_err", detail:s.err};
    }catch(_){}
    try{
      const c2=getConnBackup();
      const st2=await c2.getSignatureStatuses([sig], {searchTransactionHistory:true});
      const s2=st2?.value?.[0];
      if(s2 && s2.confirmationStatus==="finalized") return {ok:true, via:"backup"};
      if(s2 && s2.err) return {ok:false, err:"tx_err", detail:s2.err};
    }catch(_){}
    await new Promise(r=>setTimeout(r, delay));
    delay=Math.min(Math.floor(delay*1.35), 8000);
  }
  return {ok:false, err:"timeout_finalized"};
}

function policyCheckTransfer(pol, to, lamports){
  if(pol.KILL_SWITCH) return {ok:false, why:"KILL_SWITCH"};
  const list=Array.isArray(pol.solTransferAllowlist)?pol.solTransferAllowlist:[];
  if(list.length===0 && (pol.ALLOW_ALL_IF_EMPTY|0)!==1) return {ok:false, why:"ALLOWLIST_EMPTY_DENY"};
  if(list.length>0){
    const it=list.find(x=>String(x.to)===String(to));
    if(!it) return {ok:false, why:"TO_NOT_ALLOWLISTED"};
    if(lamports>Number(it.maxLamports||0)) return {ok:false, why:"LAMPORTS_EXCEED_TO_LIMIT"};
  }
  const lim=pol.limits||{};
  const maxLamportsPerTx=Number(lim.maxLamportsPerTx||0);
  if(maxLamportsPerTx>0 && lamports>maxLamportsPerTx) return {ok:false, why:"LAMPORTS_EXCEED_MAX_PER_TX"};
  return {ok:true};
}

function policyCheckQuota(pol, st){
  const lim=pol.limits||{};
  const k=dayKey(now());
  st.usage[k]=st.usage[k]||{ tx:0, lamports:0 };
  const u=st.usage[k];
  if(Number(lim.maxTxPer24h||0)>0 && u.tx>=Number(lim.maxTxPer24h)) return {ok:false, why:"MAX_TX_PER_24H"};
  if(Number(lim.maxLamportsPer24h||0)>0 && u.lamports>=Number(lim.maxLamportsPer24h)) return {ok:false, why:"MAX_LAMPORTS_PER_24H"};
  return {ok:true};
}

function quotaConsume(pol, st, lamports){
  const lim=pol.limits||{};
  const k=dayKey(now());
  st.usage[k]=st.usage[k]||{ tx:0, lamports:0 };
  st.usage[k].tx += 1;
  st.usage[k].lamports += Number(lamports||0);
  const maxLamportsPer24h=Number(lim.maxLamportsPer24h||0);
  if(maxLamportsPer24h>0 && st.usage[k].lamports>maxLamportsPer24h) st.usage[k].lamports=maxLamportsPer24h;
}

const app=express();
app.disable("x-powered-by");
app.use(cors());
app.use(express.json({limit:"1mb"}));

app.get("/api/health",(req,res)=>res.json({ok:true, ts:now(), host:HOST, port:PORT}));
app.get("/api/config",(req,res)=>{
  const pol=loadPolicy();
  res.json({
    rpcPrimary: SOL_RPC_PRIMARY,
    rpcBackup: SOL_RPC_BACKUP,
    policy:{
      killSwitch: !!pol.KILL_SWITCH,
      allowAllIfEmpty: (pol.ALLOW_ALL_IF_EMPTY|0),
      limits: pol.limits||{}
    }
  });
});

app.post("/exec/prepare",(req,res)=>{
  const { action, to, lamports } = (req.body||{});
  if(action!=="SOL_TRANSFER") return res.status(400).json({ok:false, err:"bad_action"});
  if(typeof to!=="string" || !to.trim()) return res.status(400).json({ok:false, err:"bad_to"});
  const l=Number(lamports||0);
  if(!Number.isFinite(l) || l<=0) return res.status(400).json({ok:false, err:"bad_lamports"});

  const pol=loadPolicy();
  const st=loadState();

  const qc=policyCheckQuota(pol, st);
  if(!qc.ok) return res.status(429).json({ok:false, err:"quota", why:qc.why});

  const pc=policyCheckTransfer(pol, to, l);
  if(!pc.ok) return res.status(403).json({ok:false, err:"policy", why:pc.why});

  const payload={ action:"SOL_TRANSFER", to, lamports:l };
  const payloadStr=JSON.stringify(payload);
  const payloadHash=sha256(payloadStr);
  const pendingId=crypto.randomBytes(16).toString("hex");
  st.pending[pendingId]={ id:pendingId, status:"APPROVED", createdAt:now(), payload, payloadHash, signature:null, finalized:false };
  saveState(st);

  res.json({ ok:true, pendingId, payloadHash });
});

app.post("/exec/commit", async (req,res)=>{
  const { pendingId, signature } = (req.body||{});
  if(typeof pendingId!=="string" || pendingId.length<8) return res.status(400).json({ok:false, err:"bad_pendingId"});
  if(typeof signature!=="string" || signature.length<20) return res.status(400).json({ok:false, err:"bad_signature"});

  const pol=loadPolicy();
  const st=loadState();
  const p=st.pending[pendingId];
  if(!p) return res.status(404).json({ok:false, err:"pending_not_found"});
  if(p.status!=="APPROVED" && p.status!=="SUBMITTED" && p.status!=="DONE") return res.status(409).json({ok:false, err:"bad_status", status:p.status});
  if(p.payloadHash!==sha256(JSON.stringify(p.payload))) return res.status(409).json({ok:false, err:"payload_hash_mismatch"});

  if(p.status==="DONE") return res.json({ok:true, status:"DONE", signature:p.signature, finalized:true});

  p.signature=signature;
  p.status="SUBMITTED";
  saveState(st);

  const lim=pol.limits||{};
  const timeoutMs=Number(lim.finalizeTimeoutMs||60000);

  const r=await confirmFinalized(signature, timeoutMs);
  if(!r.ok){
    p.finalized=false;
    p.status = (r.err==="timeout_finalized") ? "SUBMITTED" : "FAILED";
    p.err = r.err;
    p.detail = r.detail||null;
    saveState(st);
    return res.status(r.err==="timeout_finalized"?202:500).json({ok:false, status:p.status, err:r.err});
  }

  p.finalized=true;
  p.status="DONE";
  p.via=r.via;
  quotaConsume(pol, st, Number(p.payload?.lamports||0));
  saveState(st);
  return res.json({ok:true, status:"DONE", signature, finalized:true, via:r.via});
});

app.listen(PORT, HOST, ()=>console.log(`[aiaquila] http://${HOST}:${PORT}`));
JS


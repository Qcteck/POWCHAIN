set -euo pipefail
DOMAIN="fireinners.online"

cat > /etc/nginx/conf.d/wolverine_rpc_proxy.conf <<'EOF'
# Proxy RPC Solana (same-origin) -> évite CORS/403
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

  # optionnel mais safe
  proxy_set_header Connection "";
}
EOF

nginx -t && systemctl reload nginx

echo "== TEST HTTPS (doit PAS être 404) =="
curl -ksS -i "https://$DOMAIN/wolverine/traderone/api/rpc" \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 25
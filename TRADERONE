set -e
cd /root

BLOCK='location ^~ /wolverine/traderone/api/ {
  proxy_pass http://127.0.0.1:3000/api/;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}'

for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  echo "PATCH $f"
  cp -v "$f" "$f.bak.$(date +%Y%m%d_%H%M%S)"

  # Remplace complètement le bloc existant /wolverine/traderone/api/
  perl -0777 -i -pe "s#location\\s+\\^~\\s+/wolverine/traderone/api/\\s*\\{.*?\\}#$BLOCK#sg" "$f"
done

echo
echo "=== nginx -t + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== Test LOCAL via nginx ==="
curl -sS -i -X POST -H "Host: fireinners.online" -H "content-type: application/json" \
  http://127.0.0.1/wolverine/traderone/api/status --data '{}' | head -n 40

echo
echo "=== Test PUBLIC ==="
BASE="https://fireinners.online/wolverine/traderone/api"
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" --data '{}' | head -n 40
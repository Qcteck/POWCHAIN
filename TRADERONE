#!/usr/bin/env bash
set -e

echo "=== WOLVERINE HARD FIX ==="

### 1️⃣ TROUVER TOUS LES index.html
echo "[SCAN] Searching index.html..."
find /var/www -name index.html > /tmp/index_list.txt
cat /tmp/index_list.txt

### 2️⃣ CORRIGER TOUS LES index.html (FORCE)
while read f; do
  echo "[PATCH] $f"
  sed -i 's|http://127.0.0.1:3010/balances|/wolverine/api/balances|g' "$f"
  sed -i 's|127.0.0.1:3010|/wolverine/api|g' "$f"
done < /tmp/index_list.txt

### 3️⃣ CONFIRMATION
echo "[VERIFY] No localhost references should remain:"
grep -R "127.0.0.1:3010" /var/www || echo "✔ OK"

### 4️⃣ RELOAD NGINX
nginx -t
systemctl reload nginx

echo "=== DONE ==="
echo "IMPORTANT:"
echo "➡ CTRL + SHIFT + R (HARD REFRESH)"
echo "➡ OU ouvre en navigation privée"
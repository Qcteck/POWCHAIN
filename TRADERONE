#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/AQUILATRADER_PUBLIC_${TS}.log"

echo "== AQUILATRADER PUBLIC DEPLOY ==" | tee -a "$LOG"

### PATHS
WWW="/var/www/aquilatrader"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_INC="/etc/nginx/includes/aquilatrader.inc"
FEE_WALLET="ufii1UUsd1FM8ByD6XyvuamGhGjeJdTM7PAbrj4uZDj"
FEE_RATE="0.02"

### BACKUP
BK="/root/BK_AQUILATRADER_${TS}"
mkdir -p "$BK"
[ -d "$WWW" ] && cp -a "$WWW" "$BK/" || true
[ -f "$NGINX_INC" ] && cp -a "$NGINX_INC" "$BK/" || true

### CREATE DIR
mkdir -p "$WWW"
chmod 755 "$WWW"

### WRITE INDEX.HTML
cat > "$WWW/index.html" <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<title>AquilaTrader • Public</title>
<style>
body{margin:0;font-family:Arial;background:#0b0f14;color:#e6edf3}
header{padding:20px;background:#111827;border-bottom:1px solid #1f2937}
h1{margin:0;font-size:22px}
.box{margin:20px;padding:20px;background:#020617;border:1px solid #1e293b;border-radius:8px}
.label{color:#94a3b8}
.value{font-size:18px;margin-top:4px}
.ok{color:#22c55e}
.warn{color:#facc15}
.small{font-size:12px;color:#64748b}
</style>
</head>
<body>

<header>
<h1>AquilaTrader — Public Scanner</h1>
<div class="small">Einshtein • Solana • Dexscreener</div>
</header>

<div class="box">
<div class="label">Scanner status</div>
<div class="value ok">ONLINE</div>
</div>

<div class="box">
<div class="label">Community fee</div>
<div class="value">2%</div>
<div class="small">Destination: $FEE_WALLET</div>
</div>

<div class="box">
<div class="label">Total fees owed</div>
<div class="value warn" id="fees">loading…</div>
</div>

<div class="box">
<div class="label">Net amount returned</div>
<div class="value ok" id="net">loading…</div>
</div>

<script>
/* placeholder – will be wired to backend */
let totalFees = 0.00;
let totalGross = 0.00;

document.getElementById("fees").innerText = totalFees.toFixed(4)+" SOL";
document.getElementById("net").innerText = (totalGross - totalFees).toFixed(4)+" SOL";
</script>

</body>
</html>
HTML

### WRITE NGINX INCLUDE (idempotent)
if [ ! -f "$NGINX_INC" ]; then
cat > "$NGINX_INC" <<NGX
location /aquilatrader/ {
    alias /var/www/aquilatrader/;
    index index.html;
    try_files \$uri \$uri/ =404;
}
NGX
fi

### ENSURE INCLUDE IN VHOST
if ! grep -q "aquilatrader.inc" "$NGINX_SITE"; then
sed -i '/server_name fireinners.online;/a \\n    include /etc/nginx/includes/aquilatrader.inc;' "$NGINX_SITE"
fi

### TEST & RELOAD
nginx -t
systemctl reload nginx

echo "== DONE ==" | tee -a "$LOG"
echo "PUBLIC URL: https://www.fireinners.online/aquilatrader/" | tee -a "$LOG"
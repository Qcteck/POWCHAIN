#!/usr/bin/env bash
set -euo pipefail

PHP="/var/www/aiaquila/rss-proxy.php"
BACKUP="$PHP.backup_$(date +%Y%m%d_%H%M%S)"

echo "=== FIX RSS PROXY – AIAQUILA ==="
cp "$PHP" "$BACKUP"
echo "Backup: $BACKUP"

cat > "$PHP" <<'PHP'
<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/xml; charset=UTF-8");

if(!isset($_GET['url'])){
 http_response_code(400);
 echo "Missing url";
 exit;
}

$url=$_GET['url'];

$ch=curl_init();
curl_setopt_array($ch,[
 CURLOPT_URL=>$url,
 CURLOPT_RETURNTRANSFER=>true,
 CURLOPT_FOLLOWLOCATION=>true,
 CURLOPT_TIMEOUT=>20,
 CURLOPT_CONNECTTIMEOUT=>10,
 CURLOPT_ENCODING=>"", // 🔑 force gzip/br/deflate
 CURLOPT_USERAGENT=>"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120 Safari/537.36",
 CURLOPT_HTTPHEADER=>[
  "Accept: application/rss+xml, application/atom+xml, application/xml, text/xml;q=0.9, */*;q=0.8"
 ]
]);

$data=curl_exec($ch);
$err=curl_error($ch);
$code=curl_getinfo($ch,CURLINFO_HTTP_CODE);
$type=curl_getinfo($ch,CURLINFO_CONTENT_TYPE);
curl_close($ch);

if(!$data || $code>=400){
 http_response_code(502);
 echo "Proxy error ($code): $err";
 exit;
}

// Sécurité : vérifier qu’on a bien du XML
if(stripos($type,"xml")===false && stripos($data,"<rss")===false && stripos($data,"<feed")===false){
 http_response_code(502);
 echo "Invalid XML content";
 exit;
}

echo $data;
PHP

chmod 644 "$PHP"

echo "=== PROXY RSS CORRIGÉ ==="
echo "➡ Recharge la page (Ctrl+F5) puis clique « Charger les articles »"
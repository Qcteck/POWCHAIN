cat >/tmp/MEGA_WOLVERINE_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
set +H 2>/dev/null || true

[ "$(id -u)" = "0" ] || { echo "ERREUR: lance en root"; exit 1; }

APPDIR="/opt/fireinners/wolverine-api"
WEBDIST="/opt/fireinners/frontend-react/app/dist"
WEBDIR="${WEBDIST}/wolverine"
SENV="${APPDIR}/.env"
SERVICE="wolverine-api"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/fireinners-wolverine.conf"
ASKOR="/opt/fireinners/sentinel/lib/askorupdate.sh"

need(){ command -v "$1" >/dev/null 2>&1 || { echo "ERREUR: '$1' manquant"; exit 1; }; }
need node; need npm; need systemctl; need nginx; need curl; need perl

# askorupdate (canon) si dispo
if [ -f "$ASKOR" ]; then . "$ASKOR"; else
  askorupdate_file(){ local p="$1" n="$2" c="$3"; mkdir -p "$(dirname "$p")"; cat >"$p" <<<"$c"; }
  askorupdate_yesno(){ return 0; }
fi

echo "=== PRE-FLY (read-only) ==="
echo "Node: $(node -v) / Npm: $(npm -v)"
nginx -t >/dev/null
echo "NGINX OK"

# unlock immutables if any (safe)
chattr -i "$SITE" 2>/dev/null || true
chattr -i "$SNIP" 2>/dev/null || true
chattr -i "$
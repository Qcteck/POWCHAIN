#!/usr/bin/env bash
set -euo pipefail

### CONFIG
SITE_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$SITE_DIR/index.html"
BACKUP="$SITE_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"
WORKER_BASE="https://aiaquila-proxy.paycashnostory.workers.dev/rss"
TEST_RSS="https://news.bitcoin.com/feed/"

echo "=== AIAQUILA FULL AUTO FIX (ROOT) ==="

### 1) Vérifs de base
command -v curl >/dev/null || { echo "curl manquant"; exit 1; }
command -v nginx >/dev/null || { echo "nginx manquant"; exit 1; }

### 2) Test Worker DIRECT (doit répondre 200)
HTTP_CODE="$(curl -s -o /tmp/aiaquila_worker_test.out -w '%{http_code}' "$WORKER_BASE?url=$(python3 - <<EOF
import urllib.parse; print(urllib.parse.quote("$TEST_RSS", safe=""))
EOF
)")"

if [ "$HTTP_CODE" != "200" ]; then
  echo "❌ Worker KO (HTTP $HTTP_CODE)"
  exit 1
fi
echo "✅ Worker OK"

### 3) Backup frontend
cp -a "$INDEX" "$BACKUP"
echo "✅ Backup → $BACKUP"

### 4) Réécriture frontend (ENCODAGE CORRECT)
cat > "$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel (FORCÉ)</title>
<style>
body{margin:0;padding:20px;font-family:system-ui;background:#0b1b3a;color:#fff}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
.err{color:#ff6b6b}
.ok{color:#6bff95}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (FORCÉ)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>

<script>
const WORKER = "https://aiaquila-proxy.paycashnostory.workers.dev/rss";
const FEED   = "https://news.bitcoin.com/feed/";

async function load(){
  const out=document.getElementById("out");
  out.textContent="Chargement…\n";
  try{
    const url = WORKER + "?url=" + encodeURIComponent(FEED);
    const r = await fetch(url,{cache:"no-store"});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j = await r.json();
    if(!Array.isArray(j.items)) throw new Error("JSON invalide");
    out.innerHTML = "<span class='ok'>OK — Articles :</span>\n\n" +
      j.items.map(i=>"• "+i.title+"\n"+i.link).join("\n\n");
  }catch(e){
    out.innerHTML="<span class='err'>ERREUR:</span> "+e.message;
  }
}
</script>
</body>
</html>
HTML

echo "✅ Frontend corrigé (encodeURIComponent)"

### 5) Permissions
chown www-data:www-data "$INDEX"
chmod 644 "$INDEX"

### 6) Test site local
curl -fsS https://fireinners.online/aiaquila/ >/dev/null && echo "✅ Site accessible"

### 7) Reload nginx
nginx -t
systemctl reload nginx
echo "✅ Nginx rechargé"

### 8) Résumé
echo "=============================="
echo "SITE   : https://fireinners.online/aiaquila/"
echo "WORKER : $WORKER"
echo "BACKUP : $BACKUP"
echo "✅ AIAQUILA RÉPARÉ DÉFINITIVEMENT"
echo "=============================="
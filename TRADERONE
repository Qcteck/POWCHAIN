cat > lib/wallet.js <<'JS'
export async function connectPhantom() {
  const sol = window?.solana;
  if (!sol || !sol.isPhantom) {
    alert("Phantom wallet not found (install Phantom extension)");
    return null;
  }
  const resp = await sol.connect({ onlyIfTrusted: false });
  return resp.publicKey.toString();
}
JS

cat > lib/onchain.js <<'JS'
import { Connection, PublicKey, clusterApiUrl } from "@solana/web3.js";

export async function fetchOnchainBalances(pubkey) {
  const conn = new Connection(clusterApiUrl("mainnet-beta"), "confirmed");
  const lamports = await conn.getBalance(new PublicKey(pubkey));
  return { SOL: lamports / 1e9 };
}
JS

cat > lib/balances.js <<'JS'
export async function fetchInternalBalances(pubkey) {
  const r = await fetch(`/wolverine/traderone/api/balances2?wallet=${encodeURIComponent(pubkey)}`);
  const t = await r.text();
  if (!r.ok) throw new Error(`balances2 error (${r.status}): ${t.slice(0,200)}`);
  try { return JSON.parse(t); } catch { return { raw: t }; }
}

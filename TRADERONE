cat > /root/FIX_TRADERONE_API_JSON.sh <<'BASH'
#!/usr/bin/env bash
set -e

API_PORT=3000
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
BACKEND="/opt/traderone-vault/server.js"

echo "=== [1] Vérification backend ==="
[ -f "$BACKEND" ] || { echo "❌ server.js introuvable"; exit 1; }

echo "=== [2] Patch backend JSON safe ==="
node <<'JS'
const fs=require("fs");
let s=fs.readFileSync("/opt/traderone-vault/server.js","utf8");
if(!s.includes("res.json({ok:false,error")) {
  s=s.replace(/app.post\\([^]*?\\{/,m=>m+`
res.setHeader("Content-Type","application/json");
`);
  s=s.replace(/catch\\s*\\(.*?\\)\\s*\\{/,m=>m+`
res.status(500).json({ok:false,error:String(e)});
return;
`);
  fs.writeFileSync("/opt/traderone-vault/server.js",s);
  console.log("✓ Backend JSON sécurisé");
}else{
  console.log("✓ Backend déjà OK");
}
JS

echo "=== [3] Patch NGINX proxy API ==="
if ! grep -q "traderone/api" "$NGINX_SITE"; then
sed -i '/location \\/wolverine\\/ {/a\
    location /wolverine/traderone/api/ {\
        proxy_pass http://127.0.0.1:3000/;\
        proxy_http_version 1.1;\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\
        proxy_set_header X-Forwarded-Proto $scheme;\
    }\
' "$NGINX_SITE"
echo "✓ NGINX proxy API ajouté"
else
echo "✓ NGINX proxy déjà présent"
fi

echo "=== [4] Reload services ==="
nginx -t
systemctl reload nginx
pm2 restart traderone-vault

sleep 2

echo "=== [5] Test API JSON ==="
curl -s http://127.0.0.1:3000/wolverine/traderone/api/health | grep ok || {
  echo "❌ API Node KO"
  exit 1
}

curl -s https://fireinners.online/wolverine/traderone/api/health | grep ok || {
  echo "❌ API publique KO"
  exit 1
}

echo "✅ API JSON OPÉRATIONNELLE"
BASH

chmod +x /root/FIX_TRADERONE_API_JSON.sh
/root/FIX_TRADERONE_API_JSON.sh
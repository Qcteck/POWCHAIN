pick_vhost_443(){
  python3 - <<PY
import re,subprocess
dom="${DOMAIN}"
try:
  out=subprocess.check_output(["nginx","-T"],stderr=subprocess.STDOUT,text=True)
except Exception:
  print("/etc/nginx/sites-available/fireinners.online-ssl"); raise SystemExit
file=None
cur=None
sn=False
l443=False
for line in out.splitlines():
  m=re.match(r"^# configuration file (.+?):\d+", line)
  if m:
    cur=m.group(1); sn=False; l443=False
    continue
  if cur is None: 
    continue
  if re.search(r"^\s*server_name\s+.*\b"+re.escape(dom)+r"\b", line):
    sn=True
  if re.search(r"^\s*listen\s+443(\s|;)", line) or re.search(r"^\s*listen\s+\[::\]:443(\s|;)", line):
    l443=True
  if sn and l443:
    file=cur
    break
print(file or "/etc/nginx/sites-available/fireinners.online-ssl")
PY
}

fix_nginx_text(){
  say "Fix duplicates + ensure include (python editor)"
  python3 - <<PY
import os,re,glob,io
DOMAIN="${DOMAIN}"
WVINCLUDE="${WVINCLUDE}"
WEBROOT="${WEBROOT}"

def read(p):
  try:
    with open(p,"r",encoding="utf-8",errors="ignore") as f: return f.read().splitlines(True)
  except: return None

def write(p,lines):
  with open(p,"w",encoding="utf-8") as f: f.writelines(lines)

def strip_location_blocks(lines, start_re, keep_first=True):
  out=[]
  i=0
  kept=0
  n=len(lines)
  sr=re.compile(start_re)
  while i<n:
    line=lines[i]
    if sr.search(line):
      if keep_first and kept==0:
        kept=1
        out.append(line); i+=1
        continue
      # remove whole block: from this line until matching braces close
      depth=0
      seen_open=False
      while i<n:
        l=lines[i]
        depth += l.count("{")
        if l.count("{")>0: seen_open=True
        depth -= l.count("}")
        i+=1
        if seen_open and depth<=0:
          break
      continue
    out.append(line); i+=1
  return out

def ensure_include_once_in_vhost(vhost_path, include_path, domain):
  lines=read(vhost_path)
  if lines is None: 
    return
  inc_line=f"  include {include_path};\n"
  # remove duplicate include lines
  new=[]
  seen=0
  inc_re=re.compile(r"^\s*include\s+"+re.escape(include_path)+r"\s*;")
  for l in lines:
    if inc_re.search(l):
      seen += 1
      if seen>1: 
        continue
    new.append(l)
  lines=new
  if any(inc_re.search(l) for l in lines):
    write(vhost_path,lines); 
    return
  # inject before closing brace of the *first* server block that has server_name domain and listen 443
  out=[]
  in_server=False
  depth=0
  has_dom=False
  has_443=False
  injected=False
  for l in lines:
    if (not in_server) and re.search(r"^\s*server\s*\{", l):
      in_server=True; depth=0; has_dom=False; has_443=False
    if in_server:
      if re.search(r"^\s*server_name\s+.*\b"+re.escape(domain)+r"\b", l): has_dom=True
      if re.search(r"^\s*listen\s+443(\s|;)", l) or re.search(r"^\s*listen\s+\[::\]:443(\s|;)", l): has_443=True
      depth += l.count("{"); depth -= l.count("}")
      if (not injected) and has_dom and has_443 and re.match(r"^\s*\}\s*$", l):
        out.append(inc_line)
        injected=True
    out.append(l)
    if in_server and depth<=0 and re.match(r"^\s*\}\s*$", l):
      in_server=False
  if not injected:
    # fallback: append include at end of file
    out.append("\n"+inc_line)
  write(vhost_path,out)

# 1) Dedup /bundler/api/ INSIDE bundler_routes.inc if present (keep first)
bundler="/etc/nginx/includes/bundler_routes.inc"
if os.path.isfile(bundler):
  bl=read(bundler)
  if bl is not None:
    bl2=strip_location_blocks(bl, r"^\s*location\s+\^~\s+/bundler/api/\s*", keep_first=True)
    if bl2!=bl: write(bundler, bl2)

# 2) Remove ALL wolverine blocks from every nginx file except WVINCLUDE (so only canonical include defines them)
targets=set(glob.glob("/etc/nginx/**/*.conf", recursive=True)+glob.glob("/etc/nginx/sites-available/*")+glob.glob("/etc/nginx/sites-enabled/*")+glob.glob("/etc/nginx/includes/*"))
patterns=[
  r"^\s*location\s*=\s*/wolverine\s*\{",
  r"^\s*location\s+\^~\s+/wolverine/vault-api/\s*",
  r"^\s*location\s+\^~\s+/wolverine/traderone/\s*",
  r"^\s*location\s+\^~\s+/wolverine/\s*",
]
for p in sorted(targets):
  if not os.path.isfile(p): 
    continue
  if os.path.abspath(p)==os.path.abspath(WVINCLUDE):
    continue
  lines=read(p)
  if lines is None: 
    continue
  orig=lines
  for pat in patterns:
    # remove ALL occurrences (keep_first=False)
    lines=strip_location_blocks(lines, pat, keep_first=False)
  if lines!=orig:
    write(p,lines)

# 3) Ensure vhost includes WVINCLUDE once
vhost="${VH}"
ensure_include_once_in_vhost(vhost, WVINCLUDE, DOMAIN)
PY
}

nginx_test_reload(){
  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx
}

tests(){
  echo
  say "LOCAL (bypass CF) HEAD /wolverine/"
  curl -sSIk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true
  echo
  say "PUBLIC HEAD /wolverine/"
  curl -sSIk "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true
  echo
  say "PROOF: effective locations (nginx -T)"
  nginx -T 2>/dev/null | grep -nE "location[[:space:]]+\\^~[[:space:]]+/wolverine/|location[[:space:]]*=[[:space:]]*/wolverine" | head -n 80 || true
}

main(){
  need_root
  say "WV_MEGA_FIX_WOLVERINE_404_V2 :: start"
  backup_all
  unfreeze_best

  VH="$(pick_vhost_443)"
  say "Chosen vhost: $VH"

  ensure_webroot
  write_wolverine_include

  fix_nginx_text
  nginx_test_reload

  refreeze_best
  tests

  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
}

main
'''

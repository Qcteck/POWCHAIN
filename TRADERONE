function setAddr(){
  $("#addr").textContent = pubkey ? (pubkey.toBase58?pubkey.toBase58():String(pubkey)) : "Non connecté";
}

async function connect(){
  if(!window.solana || !window.solana.isPhantom){L("Phantom non détecté");return;}
  const r=await window.solana.connect({onlyIfTrusted:false});
  provider=window.solana; pubkey=r.publicKey; setAddr(); L("Wallet connecté:", pubkey.toBase58());
  if(!$("#to").value) $("#to").value=pubkey.toBase58();
}
async function disconnect(){
  try{await window.solana.disconnect()}catch(e){}
  provider=null; pubkey=null; setAddr(); L("Wallet déconnecté");
}

async function propose(){
  if(!armed){L("Refus: ARM requis");return;}
  if(!provider||!pubkey){L("Connecte Phantom d'abord");return;}
  if(!(await ensureWeb3())){L("ERREUR: solanaWeb3 introuvable");return;}
  const to=$("#to").value.trim(); const amt=parseFloat($("#amt").value||"0");
  if(!to||!Number.isFinite(amt)||amt<=0){L("Paramètres invalides");return;}
  const {Connection,PublicKey,SystemProgram,Transaction,LAMPORTS_PER_SOL,clusterApiUrl}=solanaWeb3;
  const rpc=clusterApiUrl("mainnet-beta");
  const cx=new Connection(rpc,"confirmed");
  const bh=await cx.getLatestBlockhash("confirmed");
  const tx=new Transaction({feePayer:pubkey,recentBlockhash:bh.blockhash});
  tx.add(SystemProgram.transfer({fromPubkey:pubkey,toPubkey:new PublicKey(to),lamports:Math.round(amt*LAMPORTS_PER_SOL)}));
  lastTx=tx; L("Proposition OK: TX prête. Clique APPROUVER & SIGNER.");
}

async function approve(){
  if(!armed){L("Refus: ARM requis");return;}
  if(!lastTx){L("Propose d'abord");return;}
  if(!provider||!pubkey){L("Connecte Phantom");return;}
  if(!(await ensureWeb3())){L("ERREUR: solanaWeb3 introuvable");return;}
  const {Connection,clusterApiUrl}=solanaWeb3;
  const rpc=clusterApiUrl("mainnet-beta");
  const cx=new Connection(rpc,"confirmed");
  try{
    // Phantom: prefer signAndSendTransaction if available
    if(provider.signAndSendTransaction){
      const r=await provider.signAndSendTransaction(lastTx);
      L("Envoyé (signAndSend):", r.signature||JSON.stringify(r));
      return;
    }
    const signed=await provider.signTransaction(lastTx);
    const sig=await cx.sendRawTransaction(signed.serialize(),{skipPreflight:false,maxRetries:3});
    L("Envoyé:", sig);
    await cx.confirmTransaction(sig,"confirmed");
    L("Confirmé:", sig);
  }catch(e){
    L("ERREUR approve:", e && e.message ? e.message : String(e));
  }
}


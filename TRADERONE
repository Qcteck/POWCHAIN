cat >/root/MEGA_AQUILA_REACT_STACKING_DEPLOY_V2_FIXNGX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILA_REACT_STACKING_FIXNGX_BK_${TS}"
mkdir -p "$BK"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
[ "$(id -u)" = "0" ] || die "run as root"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v python3 >/dev/null 2>&1 || die "python3 missing"
command -v curl >/dev/null 2>&1 || die "curl missing"

DOMAIN="fireinners.online"
WEBROOT="/var/www/aquila_stacking"
INC_DIR="/etc/nginx/includes"
INC_A="$INC_DIR/aquila_stacking_routes.inc"
INC_B="$INC_DIR/aquila_stacking_routes.inc"  # same target, keep compatibility

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "Aquila React Stacking nginx routes" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
    rm -f "$tmp"
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(echo "$path" | sed 's#/#_#g').bak" || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}

say "0) Sanity"
[ -d "$WEBROOT" ] || die "missing $WEBROOT (deploy webroot first)"
[ -f "$WEBROOT/index.html" ] || die "missing $WEBROOT/index.html"
mkdir -p "$INC_DIR"

say "1) Write nginx include (routes)"
ROUTES="$(cat <<EOF
# Aquila Stacking (React SPA) routes
location = /aquila_stacking { return 301 /aquila_stacking/; }
location ^~ /aquila_stacking/ {
  alias $WEBROOT/;
  add_header Cache-Control "no-store" always;
  try_files \$uri \$uri/ /aquila_stacking/index.html;
}
location = /iaaquila { return 301 /iaaquila/; }
location ^~ /iaaquila/ {
  alias $WEBROOT/;
  add_header Cache-Control "no-store" always;
  try_files \$uri \$uri/ /iaaquila/index.html;
}
location ~* ^/(aquila_stacking|iaaquila)/assets/ {
  alias $WEBROOT/assets/;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}
EOF
)"
write_file "$INC_A" "$ROUTES"
[ "$INC_B" = "$INC_A" ] || write_file "$INC_B" "$ROUTES"

say "2) Backup nginx -T"
nginx -T >"$BK/nginx_T.txt" 2>&1 || true

say "3) Patch ALL vhost files that contain server_name $DOMAIN (80/443) to include $INC_A"
python3 - <<PY
import os,re,subprocess,sys,shutil,datetime

DOMAIN=os.environ.get("DOMAIN","fireinners.online")
INC=os.environ.get("INC_A","/etc/nginx/includes/aquila_stacking_routes.inc")
BK=os.environ.get("BK","/root/BK")

def run(cmd):
    return subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True)

try:
    out = run(["nginx","-T"])
except Exception as e:
    print("ERR: nginx -T failed"); print(e); sys.exit(1)

# Extract config file list from nginx -T
paths=[]
for line in out.splitlines():
    m=re.match(r'^# configuration file (.+?):$', line.strip())
    if m:
        p=m.group(1).strip()
        paths.append(p)

paths=sorted(set(paths))

# Keep only real files likely to contain server blocks
cands=[]
for p in paths:
    if not p.startswith("/"): 
        continue
    if not os.path.isfile(p):
        continue
    try:
        s=open(p,'r',encoding='utf-8',errors='ignore').read()
    except Exception:
        continue
    if "server_name" in s and DOMAIN in s:
        cands.append(p)

cands=sorted(set(cands))
if not cands:
    print("WARN: no vhost candidates found for", DOMAIN)
    sys.exit(0)

def patch_content(text):
    lines=text.splitlines(True)
    out=[]
    i=0
    changed=False

    def find_matching_server(block_text):
        return re.search(r'\bserver_name\b[^;]*\b'+re.escape(DOMAIN)+r'\b', block_text) is not None

    while i < len(lines):
        line=lines[i]
        if re.match(r'^\s*server\s*\{', line):
            depth=0
            block=[]
            start=i
            while i < len(lines):
                l=lines[i]
                depth += l.count('{')
                depth -= l.count('}')
                block.append(l)
                i+=1
                if depth==0:
                    break
            b="".join(block)
            if find_matching_server(b) and INC not in b:
                # Insert include right after opening "server {"
                block.insert(1, "  include %s;\n" % INC)
                changed=True
            out.append("".join(block))
        else:
            out.append(line)
            i+=1

    return "".join(out), changed

patched_any=False
for p in cands:
    try:
        orig=open(p,'r',encoding='utf-8',errors='ignore').read()
    except Exception:
        continue
    new,chg=patch_content(orig)
    if chg and new!=orig:
        os.makedirs(BK, exist_ok=True)
        shutil.copy2(p, os.path.join(BK, p.replace('/','_')+'.bak'))
        try:
            subprocess.run(["chattr","-i",p], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        with open(p,'w',encoding='utf-8') as f:
            f.write(new)
        print("patched:", p)
        patched_any=True
    else:
        print("ok:", p)

if not patched_any:
    print("no changes needed")
PY

say "4) nginx -t + reload"
nginx -t
systemctl reload nginx

say "5) Verify locally (HTTPS via Host header)"
curl -kIs "https://127.0.0.1/aquila_stacking/" -H "Host: ${DOMAIN}" | head -n 15 || true
curl -kIs "https://127.0.0.1/iaaquila/"       -H "Host: ${DOMAIN}" | head -n 15 || true

say "DONE"
echo "OPEN: https://${DOMAIN}/aquila_stacking/"
echo "ALT : https://${DOMAIN}/iaaquila/"
echo "BK  : ${BK}"
BASH

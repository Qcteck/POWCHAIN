say "Server test: ping + getHealth"
curl -fsS "${RPC_PUBLIC}ping" && echo
curl -sS -H 'content-type: application/json' --data-binary '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' "${RPC_PUBLIC}" && echo

say "DONE"

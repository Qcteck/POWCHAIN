cat >/root/fix_web3_timing_final.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HTML="/var/www/wolverine/index.html"

cp -a "$HTML" "${HTML}.bak_${TS}"

python3 - <<'PY'
from pathlib import Path
import re

p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")

# Remove any previous sanity warnings
s = re.sub(r"<!--\s*WOLVERINE_BUFFER_POLYFILL\s*-->.*?(?=</head>)", "", s, flags=re.S|re.I)

# Ensure web3 is loaded FIRST in head
web3 = '<script src="https://cdn.jsdelivr.net/npm/@solana/web3.js@1.98.0/lib/index.iife.min.js"></script>'
if "index.iife.min.js" not in s:
    s = s.replace("</head>", web3 + "\n</head>", 1)

# Remove phantom scripts anywhere
s = re.sub(r'\s*<script[^>]+phantom_(?:patch|balances)\.js[^>]*>\s*</script>', "", s, flags=re.I)

# Re-inject them at bottom with defer
inject = """
<script defer src="/wolverine/phantom_patch.js?v=final"></script>
<script defer src="/wolverine/phantom_balances.js?v=final"></script>
"""

if "</body>" in s:
    s = s.replace("</body>", inject + "\n</body>", 1)
else:
    s += inject

p.write_text(s)
print("OK: web3 first, phantom scripts deferred")
PY

systemctl reload nginx || service nginx reload
echo "DONE ✅"
BASH

chmod +x /root/fix_web3_timing_final.sh
/root/fix_web3_timing_final.sh
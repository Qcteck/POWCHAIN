#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX DUPLICATE PHANTOM / USDC ==="

[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

# Backup
cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup créé: ${HTML}.bak_${TS}"

# 1) SUPPRIMER toutes les anciennes sections Phantom / soldes
sed -i '
/CONNECT PHANTOM/d
/Connect Phantom/d
/PHANTOM_/d
/BAL_SOL/d
/BAL_USDC/d
/SOL :/d
/USDC :/d
' "$HTML"

# 2) SUPPRIMER tout JS existant (évite doublons)
sed -i '/<script/,/<\/script>/d' "$HTML"
echo "✔ JS nettoyé"

# 3) Ajouter web3.js UNE SEULE FOIS
sed -i '/<\/head>/i \
<script src="https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js"></script>' "$HTML"

# 4) Injecter UI Phantom + soldes (UNE SEULE FOIS)
sed -i '/API:/a \
<button id="PHANTOM_CONNECT" type="button" style="margin-top:12px;width:100%;padding:12px;border-radius:8px;border:0;background:#facc15;color:#000;font-weight:700;cursor:pointer">CONNECT PHANTOM</button>\
<div id="WALLET_ADDR" style="margin-top:6px;font-size:12px;word-break:break-all"></div>\
<div style="margin-top:8px;font-size:13px">\
  SOL : <span id="SOL_BAL">—</span><br/>\
  USDC : <span id="USDC_BAL">—</span>\
</div>' "$HTML"

# 5) Script UNIQUE, sans variables globales conflictuelles
sed -i '/<\/body>/i \
<script>\
document.addEventListener("DOMContentLoaded",function(){\
  const btn=document.getElementById("PHANTOM_CONNECT");\
  const out=document.getElementById("WALLET_ADDR");\
  const solEl=document.getElementById("SOL_BAL");\
  const usdcEl=document.getElementById("USDC_BAL");\
  const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";\
  const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";\
  if(!btn) return;\
  btn.addEventListener("click",async function(){\
    if(!window.solana||!window.solana.isPhantom){\
      out.textContent="❌ Phantom non installé";\
      return;\
    }\
    try{\
      const res=await window.solana.connect();\
      const pub=res.publicKey;\
      out.textContent=pub.toString();\
      btn.textContent="CONNECTED";\
      btn.disabled=true;\
      const conn=new solanaWeb3.Connection(RPC,"confirmed");\
      const lamports=await conn.getBalance(pub);\
      solEl.textContent=(lamports/1e9).toFixed(6);\
      const accounts=await conn.getParsedTokenAccountsByOwner(pub,{programId:new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")});\
      let total=0;\
      accounts.value.forEach(acc=>{\
        const info=acc.account.data.parsed.info;\
        if(info.mint===USDC_MINT){\
          total+=info.tokenAmount.uiAmount||0;\
        }\
      });\
      usdcEl.textContent=total.toFixed(2);\
    }catch(e){\
      out.textContent="Connexion refusée";\
    }\
  });\
});\
</script>' "$HTML"

echo "✅ DUPLICATIONS SUPPRIMÉES – PHANTOM + SOLDES OK"
echo "➡️ CTRL + F5 OBLIGATOIRE"
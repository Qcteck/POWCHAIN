#!/usr/bin/env bash
set -e

echo "=== FIX NODE/NPM — CLEAN & FINAL ==="

echo "[1] PURGE NODE & NPM APT (FORCE)"
apt-get purge -y nodejs npm nodejs-doc libnode* || true
apt-get autoremove -y
apt-get autoclean -y

echo "[2] REMOVE LEFTOVERS"
rm -rf /usr/lib/node_modules || true
rm -rf /usr/local/lib/node_modules || true
rm -rf /usr/include/node || true
rm -f /usr/bin/node /usr/bin/npm || true

echo "[3] FIX BROKEN APT STATE"
apt-get -f install -y || true
dpkg --configure -a || true

echo "[4] INSTALL NODE 20 (NODESOURCE ONLY)"
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

echo "[5] VERIFY"
node -v
npm -v

echo "[6] INSTALL PM2 (GLOBAL)"
npm install -g pm2

echo "======================================"
echo "NODE/NPM FIXED CLEANLY"
echo "======================================"
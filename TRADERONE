cat >/root/trace_rpc_403_origin_vs_cf.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HOST="fireinners.online"
PATH_="/wolverine/rpc"
PAY='{"jsonrpc":"2.0","id":1,"method":"getVersion"}'

echo "== A) VIA CLOUDFLARE (public) =="
curl -sk "https://${HOST}${PATH_}" -D- \
  -H 'content-type: application/json' \
  -H "Origin: https://${HOST}" \
  -H "Referer: https://${HOST}/wolverine/" \
  --data "$PAY" | head -n 80
echo

echo "== B) DIRECT ORIGIN (localhost nginx, bypass Cloudflare) =="
# si nginx est bien sur 443 local
curl -sk "https://127.0.0.1${PATH_}" -D- \
  -H "Host: ${HOST}" \
  -H 'content-type: application/json' \
  -H "Origin: https://${HOST}" \
  -H "Referer: https://${HOST}/wolverine/" \
  --data "$PAY" | head -n 80 || true
echo

echo "== C) DIRECT ORIGIN (http 80, if TLS not local) =="
curl -s "http://127.0.0.1${PATH_}" -D- \
  -H "Host: ${HOST}" \
  -H 'content-type: application/json' \
  -H "Origin: https://${HOST}" \
  -H "Referer: https://${HOST}/wolverine/" \
  --data "$PAY" | head -n 80 || true
BASH

chmod +x /root/trace_rpc_403_origin_vs_cf.sh
/root/trace_rpc_403_origin_vs_cf.sh
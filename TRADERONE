cat >/root/WOLV_PATCH_TO_WOLVERINE1_DOMAIN.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SWAP="/opt/wolverine-api/routes/swap.routes.js"
[ -f "$SWAP" ] || { echo "ERR: introuvable: $SWAP"; exit 1; }

WORKER_BASE="https://WOLVERINE1.fireinners.online"
QUOTE_URL="${WORKER_BASE}/quote"
SWAP_URL="${WORKER_BASE}/swap"

echo "Colle le x-relay-token (ne s'affiche pas). ENTER si tu n'en as pas :"
read -rs RELAY_TOKEN
echo

echo "=== [1] Test HEAD /quote ==="
curl -sS -I --max-time 12 "$QUOTE_URL" | head -n 15 || true
echo

echo "=== [2] Backup + Patch endpoints ==="
mkdir -p /root/wolv_backups
cp -a "$SWAP" "/root/wolv_backups/swap.routes.js.$(date +%s).bak" || true

sed -i -E \
  "s#const JUP_QUOTE = \".*\";#const JUP_QUOTE = \"${QUOTE_URL}\";#g; \
   s#const JUP_SWAP  = \".*\";#const JUP_SWAP  = \"${SWAP_URL}\";#g" \
  "$SWAP"

echo "=== [3] Inject x-relay-token (si fourni) ==="
if [ -n "${RELAY_TOKEN:-}" ]; then
  perl -0777 -i -pe '
    my $tok = $ENV{"RELAY_TOKEN"} // "";
    die "missing token\n" if $tok eq "";
    if($_ !~ /x-relay-token:/){
      s/\[\s*"-sS"/["-sS","-H","x-relay-token: ".$tok]/s;
    }
  ' "$SWAP" RELAY_TOKEN="$RELAY_TOKEN"
fi

echo "=== [4] Restart wolverine-api ==="
systemctl restart wolverine-api.service || true
sleep 1

echo "=== [5] Find API port + test /api/swap/quote ==="
API_PORT=""
for p in 3002 3050 3000 8080 8000 5000 4000 3001 3003; do
  if curl -sS --max-time 1 "http://127.0.0.1:$p/api" >/dev/null 2>&1; then
    API_PORT="$p"; break
  fi
done
echo "API_PORT=${API_PORT:-NOT_FOUND}"
[ -n "${API_PORT:-}" ] || { echo "ERR: aucun port /api trouvé"; exit 1; }

curl -sS --max-time 15 \
"http://127.0.0.1:$API_PORT/api/swap/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50" \
| head -c 300
echo
echo "DONE ✅"
BASH

bash /root/WOLV_PATCH_TO_WOLVERINE1_DOMAIN.sh
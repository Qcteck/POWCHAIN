cat >/root/neuroneone_private.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/neuroneone"
PORT="9696"
BIND_IP="10.66.66.1"
SVC="neuroneone-http"

echo "[1/6] Checks"
command -v python3 >/dev/null
ip a | grep -q " ${BIND_IP}/" || { echo "ERR: ${BIND_IP} pas présent (wg0?)"; exit 1; }

echo "[2/6] Dossier"
mkdir -p "$APP_DIR"
if [ ! -f "$APP_DIR/index.html" ]; then
  cat >"$APP_DIR/index.html" <<'HTML'
<!doctype html><meta charset="utf-8"><title>NeuroneOne</title><body style="font-family:system-ui;padding:20px">index.html manquant: colle ton NeuroneOne ici (/opt/neuroneone/index.html).</body>
HTML
fi

echo "[3/6] Systemd service"
cat >/etc/systemd/system/${SVC}.service <<EOF
[Unit]
Description=NeuroneOne private HTTP (WireGuard only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${APP_DIR}
ExecStart=/usr/bin/python3 -m http.server ${PORT} --bind ${BIND_IP} --directory ${APP_DIR}
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF

echo "[4/6] Firewall (UFW) - autoriser seulement sur wg0"
if command -v ufw >/dev/null 2>&1; then
  ufw allow in on wg0 to any port ${PORT} proto tcp >/dev/null || true
  ufw deny ${PORT}/tcp >/dev/null || true
fi

echo "[5/6] Start"
systemctl daemon-reload
systemctl enable --now "${SVC}"
sleep 0.3

echo "[6/6] Verify"
ss -lntp | grep -E ":${PORT}\b" || true
curl -sS -I "http://${BIND_IP}:${PORT}/" | head -n 3 || true

echo "OK: NeuroneOne privé -> http://${BIND_IP}:${PORT}/ (via WireGuard)"
SH
chmod +x /root/neuroneone_private.sh
bash /root/neuroneone_private.sh
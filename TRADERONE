set -e

SVC="traderone.service"
BOT_WALLET="TON_ADRESSE_BOT_ICI"   # <-- remplace ça

mkdir -p /etc/systemd/system/${SVC}.d

cat > /etc/systemd/system/${SVC}.d/override.conf <<EOF
[Service]
Environment="TRADERONE_BOT_WALLET=${BOT_WALLET}"
Environment="TRADERONE_MIN_SOL_FEES=0.01"
EOF

systemctl daemon-reload
systemctl restart "$SVC"

echo
echo "== DROP-IN LOADED =="
systemctl status "$SVC" --no-pager -l | sed -n '1,20p'

echo
echo "== ENV (doit contenir TRADERONE_BOT_WALLET) =="
systemctl show "$SVC" -p Environment
echo
echo "== CAT (doit montrer override.conf) =="
systemctl cat "$SVC" --no-pager | sed -n '1,220p'
set -euo pipefail

MAIN="/opt/traderone-opt/server.js"
SVC="traderone.service"
TS="$(date +%s)"

cp -a "$MAIN" "$MAIN.bak.$TS"
echo "Backup: $MAIN.bak.$TS"

node - <<'JS'
const fs=require("fs");
const f="/opt/traderone-opt/server.js";
let s=fs.readFileSync(f,"utf8");

const m = s.match(/app\.get\(\s*["']([^"']*balances2[^"']*)["']\s*,\s*async\s*\(\s*req\s*,\s*res\s*\)\s*=>\s*\{/m);
if(!m) throw new Error("balances2 route introuvable");
const path = m[1];
const start = s.indexOf(m[0]) + m[0].length; // position juste après le "{"

if (s.includes("WOLVERINE_BALANCES_STALE_BEGIN")) {
  console.log("STALE déjà présent, skip");
  process.exit(0);
}

// Trouver la fin du handler en comptant les accolades (simple mais suffisant ici)
let i = start, depth = 1;
let inS=null, esc=false, inLine=false, inBlock=false;
for(; i<s.length; i++){
  const c=s[i], n=s[i+1];

  if(inLine){ if(c==="\n") inLine=false; continue; }
  if(inBlock){ if(c==="*" && n==="/"){ inBlock=false; i++; } continue; }

  if(inS){
    if(esc){ esc=false; continue; }
    if(c==="\\"){ esc=true; continue; }
    if(c===inS){ inS=null; continue; }
    continue;
  } else {
    if(c==="'"||c==='"'||c==="`"){ inS=c; continue; }
    if(c==="/" && n==="/"){ inLine=true; i++; continue; }
    if(c==="/" && n==="*"){ inBlock=true; i++; continue; }
    if(c==="{") depth++;
    if(c==="}") { depth--; if(depth===0) break; }
  }
}
if(depth!==0) throw new Error("Impossible de fermer le handler balances2");

const body = s.slice(start, i); // contenu entre { ... }
const prefix = `
/* WOLVERINE_BALANCES_STALE_BEGIN */
  const __w = String(req.query.wallet || "");
  const __key = "${path}::" + __w;
  const __staleAny = __balCache.get(__key); // stale possible même expiré
  try {
`;
const suffix = `
  } catch (e) {
    const msg = String(e && (e.message || e) || "");
    if ((msg.includes("429") || msg.toLowerCase().includes("too many")) && __staleAny) {
      res.setHeader("X-Cache", "STALE");
      try { if (__staleAny.headers) Object.entries(__staleAny.headers).forEach(([k,v])=>{ if(v!==undefined) res.setHeader(k,v); }); } catch(_) {}
      return res.status(__staleAny.code || 200).send(__staleAny.data);
    }
    throw e;
  }
/* WOLVERINE_BALANCES_STALE_END */
`;

const newBody = prefix + body + suffix;
s = s.slice(0,start) + newBody + s.slice(start + body.length);

fs.writeFileSync(f,s,"utf8");
console.log("OK: stale cache ajouté sur balances2:", path);
JS

systemctl restart "$SVC"
sleep 1

echo
echo "== Test rapide (doit montrer X-Cache: MISS/HIT/STALE) =="
BOT="$(systemctl show traderone.service -p Environment --value | tr ' ' '\n' | sed -n 's/^TRADERONE_BOT_WALLET=//p')"
curl -ksS -D- "https://fireinners.online/wolverine/traderone/api/balances2?wallet=$BOT" -o /dev/null | grep -i x-cache || true
curl -ksS -D- "https://fireinners.online/wolverine/traderone/api/balances2?wallet=$BOT" -o /dev/null | grep -i x-cache || true
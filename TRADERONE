sudo -i
set -e

# 1) Activer headers debug global (http{})
cat >/etc/nginx/conf.d/wolv_debug_headers.conf <<'EOF'
add_header X-Wolv-Debug "1" always;
add_header X-Wolv-ServerName "$server_name" always;
add_header X-Wolv-Host "$host" always;
add_header X-Wolv-Uri "$request_uri" always;
EOF

nginx -t
systemctl reload nginx


cat > /root/WOLVERINE_FIX_NGINX_FIREINNERS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS=$(date +%Y%m%d_%H%M%S)
LOG="/root/WOLVERINE_NGINX_FIX_$TS.log"

echo "=== WOLVERINE NGINX FIREINNERS FIX ===" | tee -a "$LOG"

echo "[1/6] Sauvegarde vhosts" | tee -a "$LOG"
cp -a /etc/nginx/sites-enabled /etc/nginx/sites-enabled.bak_$TS
cp -a /etc/nginx/sites-available /etc/nginx/sites-available.bak_$TS

echo "[2/6] Liste vhosts fireinners actifs" | tee -a "$LOG"
ls -l /etc/nginx/sites-enabled | grep fireinners | tee -a "$LOG"

# garder le plus récent
KEEP=$(ls -t /etc/nginx/sites-enabled | grep fireinners | head -n1)

echo "[3/6] Vhost conservé: $KEEP" | tee -a "$LOG"

echo "[4/6] Désactivation des doublons" | tee -a "$LOG"
for f in /etc/nginx/sites-enabled/*fireinners*; do
  base=$(basename "$f")
  if [ "$base" != "$KEEP" ]; then
    echo " -> disable $base" | tee -a "$LOG"
    rm -f "$f"
  fi
done

echo "[5/6] Test nginx" | tee -a "$LOG"
nginx -t | tee -a "$LOG"

echo "[6/6] Reload nginx" | tee -a "$LOG"
systemctl reload nginx
sleep 2
systemctl status nginx --no-pager | tee -a "$LOG"

echo
echo "=== FIX TERMINE ==="
echo "Vhost actif : $KEEP"
echo "Log : $LOG"
echo
echo "ACTION:"
echo "➡️ CTRL + SHIFT + R dans le navigateur"
BASH

chmod +x /root/WOLVERINE_FIX_NGINX_FIREINNERS.sh
/root/WOLVERINE_FIX_NGINX_FIREINNERS.sh
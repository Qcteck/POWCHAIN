cat >/root/fix_wallet_rpc_403_and_react.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
ROOT="/var/www/wolverine"
JS="$ROOT/phantom_patch.js"
ts="$(date +%Y%m%d_%H%M%S)"

mkdir -p /etc/nginx/snippets "$ROOT"

echo "== 1) Find ACTIVE SSL vhost (443) for $DOMAIN =="
VHOST="$(
nginx -T 2>/dev/null | awk -v dom="$DOMAIN" '
  /^# configuration file /{f=$4; sub(/:$/,"",f)}
  /server\s*\{/ {in=1; has443=0; hasdom=0; file=f}
  in && /listen\s+(\[::\]:)?443/ {has443=1}
  in && /server_name/ && $0 ~ dom {hasdom=1}
  in && /\}/ { if(has443 && hasdom){ print file; exit } in=0 }
'
)"
[[ -n "${VHOST:-}" && -f "$VHOST" ]] || { echo "[ERR] SSL vhost 443 introuvable pour $DOMAIN"; exit 1; }
cp -a "$VHOST" "${VHOST}.bak_${ts}"
echo "[OK] SSL VHOST: $VHOST"

echo "== 2) Write nginx snippet /solana-rpc (server-side proxy) =="
cat >"$SNIP" <<'NGINX'
location = /solana-rpc {
  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  add_header Access-Control-Allow-Origin * always;
  add_header Access-Control-Allow-Headers * always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }
}
NGINX

echo "== 3) Ensure include ONCE + remove any inline duplicate location blocks =="
# remove inline location blocks from vhost (avoid duplicate location)
perl -0777 -i -pe 's/\n\s*location\s*=\s*\/solana-rpc\s*\{.*?\}\s*\n/\n/sg' "$VHOST"

# drop duplicate include lines (exact)
tmp="/tmp/vhost.$$"
awk '{
  if($0=="  include /etc/nginx/snippets/solana_rpc_proxy.conf;"){
    if(seen){next} else {seen=1}
  }
  print
}' "$VHOST" >"$tmp"
cat "$tmp" >"$VHOST"
rm -f "$tmp"

# add include if missing
if ! grep -qF "include /etc/nginx/snippets/solana_rpc_proxy.conf;" "$VHOST"; then
  sed -i "/server_name .*${DOMAIN}/a\\
  include /etc/nginx/snippets/solana_rpc_proxy.conf;
" "$VHOST"
fi

echo "== 4) nginx test + reload =="
nginx -t
systemctl reload nginx

echo "== 5) RPC test (must return result: ok) =="
curl -sk --resolve ${DOMAIN}:443:127.0.0.1 https://${DOMAIN}/solana-rpc \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' && echo

echo "== 6) Write React-safe JS that uses /solana-rpc (NO direct Solana URL) =="
cat >"$JS" <<'JS'
(function () {
  const RPC = "/solana-rpc"; // IMPORTANT: same-origin proxy
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
  const REFRESH_MS = 15000;
  const short = (s) => (s ? s.slice(0, 4) + "…" + s.slice(-4) : "");

  function ensureOverlay() {
    let el = document.getElementById("__wallet_overlay");
    if (el) return el;
    el = document.createElement("div");
    el.id = "__wallet_overlay";
    el.style.cssText =
      "position:fixed;right:16px;bottom:16px;z-index:2147483647;" +
      "background:rgba(0,0,0,.85);color:#fff;padding:10px 12px;border-radius:10px;" +
      "font:12px/1.35 system-ui;max-width:80vw;white-space:pre-line";
    el.textContent = "Patch loaded";
    document.body.appendChild(el);
    return el;
  }
  const setOverlay = (msg) => (ensureOverlay().textContent = msg);

  function ensureBadge() {
    let b = document.getElementById("__wallet_connected_badge");
    if (b) return b;
    b = document.createElement("div");
    b.id = "__wallet_connected_badge";
    b.style.cssText =
      "position:fixed;z-index:2147483647;display:none;" +
      "background:rgba(0,160,90,.92);color:#fff;padding:6px 10px;border-radius:999px;" +
      "font:12px system-ui;box-shadow:0 6px 18px rgba(0,0,0,.25)";
    document.body.appendChild(b);
    return b;
  }

  function findWalletCard() {
    // Find connect button then climb up; DO NOT mutate React DOM
    const nodes = Array.from(document.querySelectorAll("button,a,div,span"));
    const btn = nodes.find(n => /connect phantom/i.test((n.textContent || "").trim()));
    if (!btn) return null;
    let p = btn;
    for (let i=0; i<10 && p; i++) {
      if ((p.textContent || "").toLowerCase().includes("wallet")) return p;
      p = p.parentElement;
    }
    return btn.parentElement;
  }

  function positionBadge(pk, sol, usdc) {
    const badge = ensureBadge();
    const card = findWalletCard();
    if (!card) { badge.style.display = "none"; return; }
    const r = card.getBoundingClientRect();
    badge.style.left = Math.round(r.left + 12) + "px";
    badge.style.top  = Math.round(r.top + 8) + "px";
    badge.style.display = "block";
    badge.textContent = `Connected ${short(pk)} | SOL ${sol.toFixed(4)} | USDC ${usdc.toFixed(2)}`;
  }

  async function rpc(method, params) {
    const r = await fetch(RPC, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }),
    });
    const j = await r.json().catch(() => ({}));
    if (j.error) throw new Error(j.error.message || JSON.stringify(j.error));
    if (!("result" in j)) throw new Error("RPC no result");
    return j.result;
  }

  async function fetchBalances(owner) {
    const bal = await rpc("getBalance", [owner, { commitment: "confirmed" }]);
    const sol = (bal.value || 0) / 1e9;

    const tok = await rpc("getTokenAccountsByOwner", [
      owner,
      { mint: USDC_MINT },
      { encoding: "jsonParsed", commitment: "confirmed" },
    ]);

    let usdc = 0;
    for (const acc of (tok.value || [])) {
      const amt = acc.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
      if (typeof amt === "number") usdc += amt;
    }
    return { sol, usdc };
  }

  async function refreshAll() {
    const pk = window.solana?.publicKey?.toBase58?.() || window.__WALLET_PK__;
    if (!pk) return;
    try {
      const { sol, usdc } = await fetchBalances(pk);
      setOverlay(`Connected: ${short(pk)}\nSOL ${sol.toFixed(4)} | USDC ${usdc.toFixed(2)}`);
      positionBadge(pk, sol, usdc);
    } catch (e) {
      console.error(e);
      setOverlay(`Connected: ${short(pk)}\nBalance: RPC error`);
    }
  }

  async function connect() {
    if (!window.solana || !window.solana.isPhantom) {
      setOverlay("Phantom introuvable.\n➡️ Ouvre le site dans Phantom Browser.");
      return;
    }
    const r = await window.solana.connect();
    window.__WALLET_PK__ = r.publicKey.toBase58();
    await refreshAll();
  }

  function hookConnectButton() {
    const nodes = Array.from(document.querySelectorAll("button,a,div,span"));
    const btn = nodes.find(n => /connect phantom/i.test((n.textContent || "").trim()));
    if (btn && !btn.__hooked_phantom) {
      btn.__hooked_phantom = true;
      btn.addEventListener("click", (ev) => {
        ev.preventDefault();
        connect().catch(err => { console.error(err); setOverlay("Connect error"); });
      }, { passive: false });
      setOverlay("Patch loaded — waiting connect…");
    }
  }

  window.addEventListener("load", () => {
    ensureOverlay(); ensureBadge(); hookConnectButton();
    new MutationObserver(() => hookConnectButton()).observe(document.documentElement, { childList: true, subtree: true });

    if (window.solana?.isPhantom && window.solana.publicKey) {
      window.__WALLET_PK__ = window.solana.publicKey.toBase58();
      refreshAll();
    }

    setInterval(refreshAll, REFRESH_MS);
    window.addEventListener("scroll", refreshAll, { passive: true });
    window.addEventListener("resize", refreshAll);

    window.solana?.on?.("accountChanged", (pubkey) => {
      if (pubkey) { window.__WALLET_PK__ = pubkey.toBase58(); refreshAll(); }
      else { setOverlay("Wallet: not connected"); const b=document.getElementById("__wallet_connected_badge"); if(b) b.style.display="none"; }
    });
  });
})();
JS

echo "== 7) Ensure HTML loads phantom_patch.js with cache-bust =="
while IFS= read -r -d '' f; do
  # remove old phantom_patch tags (any version) then re-inject once
  perl -0777 -i -pe 's@<!--\s*WALLET_PATCH.*?WALLET_PATCH\s*-->@@sg; s@<script[^>]+phantom_patch\.js[^>]*></script>@@gsi;' "$f"
  if ! grep -q "phantom_patch.js" "$f"; then
    perl -0777 -i -pe 's@(<head[^>]*>)@$1\n<!-- WALLET_PATCH -->\n<script src="/wolverine/phantom_patch.js?v='"$ts"'" defer></script>\n<!-- /WALLET_PATCH -->\n@i;' "$f"
  fi
done < <(find "$ROOT" -maxdepth 4 -type f -name "*.html" -print0)

nginx -t
systemctl reload nginx

echo "✅ DONE"
echo "Open: https://${DOMAIN}/wolverine/settings/?v=$ts"
BASH

chmod +x /root/fix_wallet_rpc_403_and_react.sh
/root/fix_wallet_rpc_403_and_react.sh
set -euo pipefail

EN="/etc/nginx/sites-enabled"
DIS="/etc/nginx/sites-disabled/cleanup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$DIS"

echo "=== 1) Ce que Nginx charge dans sites-enabled ==="
ls -lah "$EN" || true
echo

echo "=== 2) Déplacer tous les fichiers BACKUP hors de sites-enabled ==="
shopt -s nullglob
for f in "$EN"/*bak* "$EN"/*before_edit* "$EN"/*dupe* "$EN"/*rm_tests* "$EN"/*.bak.*; do
  [ -e "$f" ] || continue
  mv "$f" "$DIS/"
  echo "Moved: $f -> $DIS/"
done
shopt -u nullglob
echo

echo "=== 3) Vérif: plus aucun include vers fireinners_routes.conf ==="
grep -RIn --color=never "include\s\+/etc/nginx/snippets/fireinners_routes\.conf;" /etc/nginx || true
echo

echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx
echo "✅ OK"
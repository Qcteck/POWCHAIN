bash -c "$(cat <<'BASH'
set -euo pipefail

APP=/opt/wolverine-balances
PORT=3010

mkdir -p $APP
cd $APP

cat > server.js <<'JS'
const express=require("express");
const {Connection,PublicKey}=require("@solana/web3.js");
const app=express();
const RPC="https://api.mainnet-beta.solana.com";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const conn=new Connection(RPC);

app.get("/balances/:addr",async(req,res)=>{
 try{
  const pk=new PublicKey(req.params.addr);
  const sol=(await conn.getBalance(pk))/1e9;
  const toks=await conn.getParsedTokenAccountsByOwner(
    pk,{mint:new PublicKey(USDC_MINT)}
  );
  let usdc=0;
  toks.value.forEach(a=>{
    usdc+=a.account.data.parsed.info.tokenAmount.uiAmount||0;
  });
  res.json({sol,usdc});
 }catch(e){
  res.status(500).json({error:e.message});
 }
});

app.listen(3010,()=>console.log("BALANCES API ON 3010"));
JS

npm init -y >/dev/null
npm install express @solana/web3.js >/dev/null

pkill -f server.js || true
nohup node server.js >/tmp/wolverine-balances.log 2>&1 &

sleep 2
ss -lntp | grep :3010 && echo "API RUNNING"

BASH
)"
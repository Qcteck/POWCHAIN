cat >/root/repair_nginx_traderone.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"

# upstream actuel (si tu sais le port: API_UPSTREAM="http://127.0.0.1:9696")
API_UPSTREAM="${API_UPSTREAM:-http://127.0.0.1:9696}"

echo "[*] DOMAIN=$DOMAIN"
echo "[*] VHOST=$VHOST"
echo "[*] API_UPSTREAM=$API_UPSTREAM"

# 1) Restore last backup of this vhost
LAST_BAK="$(ls -1t /etc/nginx/sites-disabled/backup_*/*${DOMAIN}-ssl 2>/dev/null | head -n 1 || true)"
if [[ -z "$LAST_BAK" ]]; then
  echo "[ERR] Aucun backup trouvé dans /etc/nginx/sites-disabled/backup_*"
  exit 1
fi
cp -a "$LAST_BAK" "$VHOST"
echo "[OK] Restored from: $LAST_BAK"

# 2) Patch SAFE: proxy /wolverine/traderone/api/ -> upstream, en stripant le prefix
export API_UPSTREAM
perl -0777 -i -pe '
my $up = $ENV{API_UPSTREAM} // die "missing API_UPSTREAM";

# remove previous injected traderone blocks (if any)
s/\n\s*# --- traderone api proxy \(injected\) ---.*?\n\s*# --- end traderone api proxy ---\n//ms;

my $block = qq{
  # --- traderone api proxy (injected) ---
  location ^~ /wolverine/traderone/api/ {
    # strip prefix so backend receives "/..." instead of "/wolverine/traderone/api/..."
    rewrite ^/wolverine/traderone/api/?(.*)\$ /\$1 break;

    if (\$request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
      add_header Access-Control-Allow-Headers "Authorization,Content-Type,Accept" always;
      return 204;
    }

    proxy_pass $up;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;

    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
  # --- end traderone api proxy ---
};

# insert before static /wolverine/ block
s/\n(\s*location\s+\^\~\s+\/wolverine\/\s*\{)/\n$block\n$1/ms
  or die "ERR: cannot find location ^~ /wolverine/ block\n";
' "$VHOST"

echo "[*] nginx -t"
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== Tests =="
curl -sSI "https://${DOMAIN}/wolverine/traderone/api/" | head -n 12 || true
curl -sSI -X POST "https://${DOMAIN}/wolverine/traderone/api/" | head -n 12 || true
echo
echo "== Local upstream quick check =="
curl -sS "${API_UPSTREAM}/" | head -n 5 || true
BASH

chmod +x /root/repair_nginx_traderone.sh

# lance (si ton backend est bien sur 9696)
API_UPSTREAM="http://127.0.0.1:9696" /root/repair_nginx_traderone.sh fireinners.online
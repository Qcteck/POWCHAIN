#!/usr/bin/env bash
set -e

APP="/opt/wolverine"
HTML="$APP/index.html"
BACKUP="$HTML.bak.$(date +%s)"

echo "==[1/5] Vérification =="
[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

echo "==[2/5] Backup sécurité =="
cp "$HTML" "$BACKUP"

echo "==[3/5] Suppression HTML (panel + boutons Partager) =="
sed -i \
  -e '/Partager/d' \
  -e '/Facebook/d' \
  -e '/X\/Twitter/d' \
  -e '/Telegram/d' \
  -e '/WhatsApp/d' \
  -e '/Copier lien/d' \
  -e '/Fermer/d' \
  -e '/share-panel/d' \
  -e '/sharePanel/d' \
  "$HTML"

echo "==[4/5] Neutralisation JS (anti-réapparition) =="
sed -i '/<\/body>/i \
<script>\
(()=>{\
const kill=()=>{\
document.querySelectorAll("[id*=share],[class*=share]").forEach(e=>e.remove());\
};\
kill();\
setInterval(kill,500);\
})();\
</script>' "$HTML"

echo "==[5/5] CSS hard-kill (au cas où) =="
sed -i '/<\/head>/i \
<style>\
[id*=share],\
[class*=share],\
button[data-share],\
button.share{display:none!important;opacity:0!important;pointer-events:none!important}\
</style>' "$HTML"

nginx -t && systemctl reload nginx

echo "✅ Panneau PARTAGER supprimé définitivement"
echo "⚙️ Bouton THEME intact"
echo "🧼 Interface propre, sans doublon"
bash -lc 'set -euo pipefail
HOST="fireinners.online"
WEBROOT="/var/www/wolverine"
INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

mkdir -p "$WEBROOT"
TS="$(date +%Y%m%d_%H%M%S)"
echo "OK $TS host=$HOST backend=127.0.0.1:3000" >"$WEBROOT/_wolverine_ok.txt"
chmod 0644 "$WEBROOT/_wolverine_ok.txt" || true

chattr -i "$INC" 2>/dev/null || true
cat >"$INC" <<'"'"'NGINX'"'"'
# AUTO-GENERATED - Wolverine static + TraderOne API proxy
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Connection "";
  rewrite ^/wolverine/traderone/api/(.*)$ /$1 break;
  proxy_pass http://127.0.0.1:3000;
}

location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}
NGINX

# Assure l’include dans le vhost (si absent)
chattr -i "$VHOST" 2>/dev/null || true
if [ -f "$VHOST" ] && ! grep -q "include /etc/nginx/includes/wolverine_routes.inc" "$VHOST"; then
  cp -a "$VHOST" "${VHOST}.bak_${TS}" || true
  perl -0777 -i -pe "s/(server_name\\s+fireinners\\.online\\s*;)/\\1\\n  include \\/etc\\/nginx\\/includes\\/wolverine_routes.inc;/s" "$VHOST" || true
fi

chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
nginx -t
systemctl reload nginx || systemctl restart nginx

echo
echo "== TESTS (tout doit etre 200) =="
echo "-- A backend direct --"; curl -sS -i http://127.0.0.1:3000/health | head -n 15 || true
echo "-- B local badge --"; curl -sS -i http://127.0.0.1/wolverine/_wolverine_ok.txt | head -n 15 || true
echo "-- C local api via nginx --"; curl -sS -i -H "Host: $HOST" http://127.0.0.1/wolverine/traderone/api/health | head -n 15 || true
echo "-- D public badge --"; curl -sS -i https://$HOST/wolverine/_wolverine_ok.txt | head -n 15 || true
echo "-- E public api --"; curl -sS -i https://$HOST/wolverine/traderone/api/health | head -n 15 || true

echo
echo "== nginx error tail =="; tail -n 40 /var/log/nginx/error.log 2>/dev/null || true
echo "DONE"'
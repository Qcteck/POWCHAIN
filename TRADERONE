set -e
cd /opt/traderone-opt

echo "=== 1) Node / npm versions ==="
node -v || true
npm -v || true
echo

echo "=== 2) Projet Node ? ==="
ls -lah package.json package-lock.json 2>/dev/null || true
echo

echo "=== 3) Dépendances liées (lifi / ethers / web3 / solana) ==="
cat package.json | egrep -i '"@lifi/sdk"|"ethers"|"web3"|"@solana/web3\.js"|"axios"|"node-fetch"' || true
echo

echo "=== 4) fetch dispo ? (Node 18+) ==="
node -e 'console.log("fetch:", typeof fetch)' || true
echo

echo "=== 5) Cherche LI.FI dans le code ==="
grep -RIn --line-number -E "lifi|li\.fi|li\.quest|/v1/quote|/v1/routes|x-lifi-api-key" . | head -n 80 || true
echo

echo "=== 6) Routes express existantes (server.js) ==="
grep -nE 'app\.(get|post|all|use)\(' server.js | head -n 120 || true
echo

echo "=== 7) Wallets / signing (EVM vs Solana) ==="
grep -RIn --line-number -E "ethers|web3|privateKey|mnemonic|signTransaction|sendTransaction|@solana/web3\.js|Keypair|sendRawTransaction" . | head -n 120 || true
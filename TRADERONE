cat >/root/batch_root_fireinners.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${DOMAIN:-fireinners.online}"
VHOST="${VHOST:-/etc/nginx/sites-enabled/${DOMAIN}-ssl}"
SNIP="${SNIP:-/etc/nginx/snippets/${DOMAIN}_wolverine.conf}"
APPLY="${APPLY:-0}"

say(){ echo "== $*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }

[ -f "$VHOST" ] || die "VHOST introuvable: $VHOST"

SNIP_CONTENT=$(cat <<EOF
# --- ${DOMAIN} wolverine + favicon snippet ---
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files \$uri \$uri/ /wolverine/index.html;
}

location = /favicon.ico {
  access_log off;
  log_not_found off;
  try_files /favicon.ico =204;
}
# --- end snippet ---
EOF
)

INCLUDE_LINE="include ${SNIP};"

say "0) DRY RUN par défaut (APPLY=1 pour appliquer)"
say "1) VHOST : $VHOST"
say "2) SNIP  : $SNIP"

# --- write snippet ---
if [ "$APPLY" = "1" ]; then
  install -d /etc/nginx/snippets
  printf "%s\n" "$SNIP_CONTENT" >"$SNIP"
  say "Snippet écrit: $SNIP"
else
  say "[DRY] Snippet serait écrit dans: $SNIP"
fi

# --- ensure include is inside first server{} block ---
TMP="$(mktemp)"
awk -v inc="$INCLUDE_LINE" '
BEGIN{in_server=0; inserted=0}
{
  line=$0
  print line
  if (!inserted) {
    # repère l’ouverture du 1er server {
    if (match(line, /^[[:space:]]*server[[:space:]]*\{/)) {
      in_server=1
      next
    }
    # si on est dans le server et qu’on arrive au 1er "location" (ou autre directive de contenu),
    # on injecte l’include juste avant.
  }
  if (in_server && !inserted) {
    if (match(line, /^[[:space:]]*location[[:space:]]/)) {
      # on doit réimprimer inc AVANT la ligne courante => on ne peut plus, donc:
      # astuce: on re-crée le fichier en 2 passes: ici on marque un point d’insertion
    }
  }
}
' "$VHOST" >/dev/null 2>&1 || true

# 2-pass insertion: injecte l’include après la ligne "server {" si absent (simple et sûr)
if grep -qF "$INCLUDE_LINE" "$VHOST"; then
  say "3) Include déjà présent dans le vhost -> OK"
  cp "$VHOST" "$TMP"
else
  say "3) Include absent -> insertion dans le 1er server{} (juste après 'server {')"
  awk -v inc="$INCLUDE_LINE" '
  BEGIN{done=0}
  {
    print
    if (!done && match($0, /^[[:space:]]*server[[:space:]]*\{/)) {
      print "  " inc
      done=1
    }
  }' "$VHOST" >"$TMP"
fi

if [ "$APPLY" = "1" ]; then
  BK="/etc/nginx/sites-disabled/batchfix_$(date +%Y%m%d_%H%M%S)"
  install -d "$BK"
  cp -a "$VHOST" "$BK"/
  cp -a "$TMP" "$VHOST"
  say "Backup: $BK/$(basename "$VHOST")"
  say "VHOST patché."
else
  say "[DRY] Pas de modification écrite sur $VHOST"
fi

rm -f "$TMP"

say "4) nginx -t"
if nginx -t; then
  say "nginx -t OK"
  if [ "$APPLY" = "1" ]; then
    systemctl reload nginx || nginx -s reload || true
    say "Reload tenté."
  else
    say "[DRY] pas de reload"
  fi
else
  die "nginx -t a échoué (ne pas reload)"
fi

say "5) checks local (host header)"
curl -sS -I -H "Host: ${DOMAIN}" http://127.0.0.1/wolverine/ | head -n 5 || true
curl -sS -I -H "Host: ${DOMAIN}" http://127.0.0.1/favicon.ico | head -n 5 || true

say "6) checks public (https)"
curl -sS -I "https://${DOMAIN}/wolverine/" | head -n 8 || true
curl -sS -I "https://${DOMAIN}/favicon.ico" | head -n 12 || true

say "DONE"
BASH

chmod +x /root/batch_root_fireinners.sh

# DRY RUN
APPLY=0 bash /root/batch_root_fireinners.sh
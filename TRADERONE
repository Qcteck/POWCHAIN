cat >/root/FIX_WOLVERINE_API_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_traderone_api.inc"
BACKUP="${SITE}.bak_${TS}"
REPORT="/root/WOLVERINE_API_FINAL_${TS}.log"

echo "=== WOLVERINE TRADERONE API FINAL FIX ===" | tee "$REPORT"

# Safety
[ -f "$SITE" ] || { echo "[FATAL] NGINX site missing"; exit 1; }
mkdir -p /etc/nginx/includes
cp -a "$SITE" "$BACKUP"

echo "[OK] Backup: $BACKUP" | tee -a "$REPORT"

# Write include (clean, deterministic)
cat >"$INC" <<'EOF'
location ^~ /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    add_header Content-Type application/json always;
}
EOF

echo "[OK] API include written" | tee -a "$REPORT"

# Ensure include is loaded once
if ! grep -q "wolverine_traderone_api.inc" "$SITE"; then
  sed -i '/server_name fireinners.online;/a\    include /etc/nginx/includes/wolverine_traderone_api.inc;' "$SITE"
  echo "[OK] Include injected in vhost" | tee -a "$REPORT"
else
  echo "[OK] Include already present" | tee -a "$REPORT"
fi

# Test nginx
nginx -t | tee -a "$REPORT"

# Reload
systemctl reload nginx
echo "[OK] NGINX reloaded" | tee -a "$REPORT"

# PM2
pm2 list | tee -a "$REPORT"

# HARD PROOF
BASE="https://fireinners.online/wolverine/traderone/api"

echo "=== TEST budget ===" | tee -a "$REPORT"
curl -i -X POST "$BASE/budget" -H "Content-Type: application/json" -d '{"budgetSOL":0.01}' | tee -a "$REPORT"

echo "=== TEST dryrun ===" | tee -a "$REPORT"
curl -i -X POST "$BASE/dryrun" -H "Content-Type: application/json" -d '{"pubkey":"11111111111111111111111111111111"}' | tee -a "$REPORT"

echo "=== DONE : ROUTING FIXED FOR REAL ===" | tee -a "$REPORT"
echo "REPORT: $REPORT"
BASH

chmod +x /root/FIX_WOLVERINE_API_FINAL.sh
/root/FIX_WOLVERINE_API_FINAL.sh
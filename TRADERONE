set -e
cd /root

echo "=== 1) Est-ce que 3000 écoute ? ==="
ss -lptn 'sport = :3000' || true
echo

echo "=== 2) Trouver où est le code du /api/status (TraderOne) ==="
HIT="$(grep -RIn --line-number --exclude-dir=node_modules --exclude-dir=.git \
  -E 'app\.(get|post)\(\s*["'\'']\/api\/status|router\.(get|post)\(\s*["'\'']\/api\/status' \
  /opt 2>/dev/null | head -n 1 || true)"
echo "HIT=$HIT"

FILE="$(echo "$HIT" | cut -d: -f1)"
[ -f "$FILE" ] || { echo "Je n'ai pas trouvé le fichier TraderOne dans /opt. Colle la sortie de: grep -RIn '/api/status' /opt | head -n 50"; exit 1; }

echo
echo "=== 3) Lancer TraderOne sur 3000 via PM2 (sans toucher Wolverine 3002) ==="
pm2 delete traderone 2>/dev/null || true
PORT=3000 pm2 start "$FILE" --name traderone --update-env

echo
echo "=== 4) Recheck 3000 + test local direct ==="
ss -lptn 'sport = :3000' || true

echo "--- GET (au cas où) ---"
curl -sS -i "http://127.0.0.1:3000/api/status" | head -n 30 || true
echo
echo "--- POST (au cas où) ---"
curl -sS -i -X POST "http://127.0.0.1:3000/api/status" -H "content-type: application/json" --data '{}' | head -n 30 || true

echo
echo "=== 5) Test gateway Wolverine (doit arrêter de proxy_fail) ==="
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" \
  -H "content-type: application/json" --data '{}' | head -n 40 || true
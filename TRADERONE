cat >/root/MEGA_NGINX_UNLOCK_WOLVERINE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
FRONT_DIR="/var/www/wolverine"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"
NGINX_INC_DIR="/etc/nginx/includes"
NGINX_INC="${NGINX_INC_DIR}/wolverine_routes.inc"
PORT="3000"
OUT="/root/MEGA_NGINX_UNLOCK_WOLVERINE_${TS}.log"

say(){ printf "\n== %s ==\n" "$*"; }
w(){ printf "%s\n" "$*" | tee -a "$OUT" >/dev/null; }
ok(){ w "OK: $*"; }
warn(){ w "WARN: $*"; }
die(){ w "ERREUR: $*"; exit 1; }

ensure_pkg(){ local p="$1"; dpkg -s "$p" >/dev/null 2>&1 || { apt-get update -y; apt-get install -y "$p"; }; }
http_code_local(){ local path="$1"; curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1${path}" -H "Host: ${HOST}" || true; }
http_code_ext(){ local path="$1"; curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}${path}" || true; }
latest_backup(){ ls -1t "${NGINX_SITE}.bak_"* 2>/dev/null | head -n 1 || true; }

echo "# MEGA_NGINX_UNLOCK_WOLVERINE ${TS}" >"$OUT"
w "host=${HOST}"
w "date=$(date -Is)"
w "hostname=$(hostname)"

say "0) Pré-requis"
ensure_pkg nginx
ensure_pkg curl
ensure_pkg ca-certificates
ensure_pkg python3
ensure_pkg e2fsprogs
mkdir -p "$NGINX_INC_DIR"
[[ -f "$NGINX_SITE" ]] || die "Vhost introuvable: $NGINX_SITE"
ok "Pré-requis OK"

say "1) Vérifier/verrou immutable (lsattr) + déverrouiller si nécessaire"
SITE_ATTR="$(lsattr -d "$NGINX_SITE" 2>/dev/null || true)"
MAIN_ATTR="$(lsattr -d "$NGINX_MAIN" 2>/dev/null || true)"
w "lsattr site: $SITE_ATTR"
w "lsattr main: $MAIN_ATTR"

SITE_WAS_IMM="0"
MAIN_WAS_IMM="0"

if echo "$SITE_ATTR" | awk '{print $1}' | grep -q "i"; then
  SITE_WAS_IMM="1"
  chattr -i "$NGINX_SITE" || true
  ok "chattr -i: $NGINX_SITE"
fi
if echo "$MAIN_ATTR" | awk '{print $1}' | grep -q "i"; then
  MAIN_WAS_IMM="1"
  chattr -i "$NGINX_MAIN" || true
  ok "chattr -i: $NGINX_MAIN"
fi

say "2) nginx -t (état actuel)"
NGT="$(nginx -t 2>&1 || true)"
w "$NGT"

say "3) Si nginx -t FAIL -> restore dernier backup du vhost"
if ! echo "$NGT" | grep -qi "successful"; then
  BK="$(latest_backup)"
  if [[ -n "$BK" && -f "$BK" ]]; then
    cp -a "$NGINX_SITE" "${NGINX_SITE}.broken_${TS}" || true
    cp -a "$BK" "$NGINX_SITE"
    ok "Restauré: $BK (broken: ${NGINX_SITE}.broken_${TS})"
  else
    warn "Aucun backup trouvé (${NGINX_SITE}.bak_*)"
  fi
fi

say "4) Écrire include Wolverine (alias + proxy)"
cat >"$NGINX_INC" <<EOF
# /etc/nginx/includes/wolverine_routes.inc
location ^~ /wolverine/ {
  alias ${FRONT_DIR}/;
  try_files \$uri \$uri/ /index.html;
  add_header Cache-Control "no-store" always;
}
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Connection "";
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;
  proxy_pass http://127.0.0.1:${PORT}/;
}
EOF
ok "Include écrit: $NGINX_INC"

say "5) Injecter include dans le BON server 443 fireinners.online"
cp -a "$NGINX_SITE" "${NGINX_SITE}.preinject_${TS}" || true
python3 - <<'PY'
from pathlib import Path
import re, sys
p=Path("/etc/nginx/sites-available/fireinners.online-ssl")
s=p.read_text(errors="ignore")
inc="include /etc/nginx/includes/wolverine_routes.inc;"
if inc in s:
    print("include déjà présent"); sys.exit(0)

pat=re.compile(r"server\s*\{.*?\}", re.S)
blocks=list(pat.finditer(s))
target=None
for i,m in enumerate(blocks):
    b=m.group(0)
    if re.search(r"\blisten\b[^;]*\b443\b", b) and re.search(r"\bserver_name\b[^;]*\bfireinners\.online\b", b):
        target=i; break
if target is None:
    for i,m in enumerate(blocks):
        b=m.group(0)
        if re.search(r"\bserver_name\b[^;]*\bfireinners\.online\b", b):
            target=i; break
if target is None:
    raise SystemExit("Aucun bloc server fireinners.online trouvé")

m=blocks[target]
b=m.group(0)
b2=re.sub(r"(server\s*\{)", r"\1\n  "+inc, b, count=1)
s2=s[:m.start()]+b2+s[m.end():]
p.write_text(s2)
print("include injecté dans server index:", target)
PY
ok "Injection OK"

say "6) Permissions front (éviter 403)"
if [[ -d "$FRONT_DIR" ]]; then
  chmod 755 "$FRONT_DIR" || true
  [[ -f "${FRONT_DIR}/index.html" ]] && chmod 644 "${FRONT_DIR}/index.html" || true
  ok "Front perms OK"
else
  warn "Frontend dir absent: $FRONT_DIR"
fi

say "7) nginx -t + reload"
NGT2="$(nginx -t 2>&1 || true)"
w "$NGT2"
if echo "$NGT2" | grep -qi "successful"; then
  systemctl enable --now nginx >/dev/null 2>&1 || true
  systemctl reload nginx
  ok "nginx reload OK"
else
  warn "nginx -t FAIL encore -> restauration preinject"
  cp -a "${NGINX_SITE}.preinject_${TS}" "$NGINX_SITE" 2>/dev/null || true
  nginx -t 2>&1 | tee -a "$OUT" >/dev/null || true
  die "nginx -t FAIL (voir log)."
fi

say "8) Re-lock immutable si c'était lock avant"
if [[ "$SITE_WAS_IMM" == "1" ]]; then chattr +i "$NGINX_SITE" || true; ok "chattr +i: $NGINX_SITE"; fi
if [[ "$MAIN_WAS_IMM" == "1" ]]; then chattr +i "$NGINX_MAIN" || true; ok "chattr +i: $NGINX_MAIN"; fi

say "9) Probes (LOCAL/EXT)"
w "LOCAL  /wolverine/                => $(http_code_local "/wolverine/")"
w "LOCAL  /wolverine/traderone/api/  => $(http_code_local "/wolverine/traderone/api/")"
w "EXT    /wolverine/                => $(http_code_ext "/wolverine/")"
w "EXT    /wolverine/traderone/api/  => $(http_code_ext "/wolverine/traderone/api/")"

say "DONE"
w "LOG=$OUT"
echo "$OUT"
BASH
chmod +x /root/MEGA_NGINX_UNLOCK_WOLVERINE.sh
nohup /root/MEGA_NGINX_UNLOCK_WOLVERINE.sh >/root/MEGA_NGINX_UNLOCK_WOLVERINE.nohup 2>&1 </dev/null & disown
echo "Lancé (nohup). Pour lire: tail -n 200 /root/MEGA_NGINX_UNLOCK_WOLVERINE.nohup"
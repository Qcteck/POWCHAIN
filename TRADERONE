cat >/root/FIX_WOLVERINE_API_405_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_traderone_api.inc"
BACKUP="${SITE}.bak_${TS}"
REPORT="/root/WOLVERINE_API_405_FIX_${TS}.log"

echo "=== FIX 405 / POST BLOCK (FINAL) ===" | tee "$REPORT"

[ -f "$SITE" ] || { echo "[FATAL] NGINX site missing"; exit 1; }

cp -a "$SITE" "$BACKUP"
mkdir -p /etc/nginx/includes

echo "[OK] Backup: $BACKUP" | tee -a "$REPORT"

# HARD OVERRIDE INCLUDE
cat >"$INC" <<'EOF'
location ^~ /wolverine/traderone/api/ {

    # Explicitly allow methods
    limit_except GET POST OPTIONS { deny all; }

    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_redirect off;
    proxy_buffering off;

    add_header Content-Type application/json always;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;

    if ($request_method = OPTIONS) {
        return 204;
    }
}
EOF

echo "[OK] API include overwritten (POST allowed)" | tee -a "$REPORT"

# Ensure include is injected ONCE
if ! grep -q "wolverine_traderone_api.inc" "$SITE"; then
  sed -i '/server_name fireinners.online;/a\    include /etc/nginx/includes/wolverine_traderone_api.inc;' "$SITE"
  echo "[OK] Include injected" | tee -a "$REPORT"
else
  echo "[OK] Include already present" | tee -a "$REPORT"
fi

# Test + reload
nginx -t | tee -a "$REPORT"
systemctl reload nginx
echo "[OK] NGINX reloaded" | tee -a "$REPORT"

# HARD PROOF
BASE="https://fireinners.online/wolverine/traderone/api"

echo "=== TEST POST budget ===" | tee -a "$REPORT"
curl -i -X POST "$BASE/budget" \
  -H "Content-Type: application/json" \
  --data '{"budgetSOL":0.01}' | tee -a "$REPORT"

echo "=== TEST POST dryrun ===" | tee -a "$REPORT"
curl -i -X POST "$BASE/dryrun" \
  -H "Content-Type: application/json" \
  --data '{"pubkey":"11111111111111111111111111111111"}' | tee -a "$REPORT"

echo "=== DONE : POST ROUTING UNBLOCKED ===" | tee -a "$REPORT"
echo "REPORT: $REPORT"
BASH

chmod +x /root/FIX_WOLVERINE_API_405_FINAL.sh
/root/FIX_WOLVERINE_API_405_FINAL.sh
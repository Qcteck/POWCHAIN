mkdir -p "$BACK_DIR" "$FRONT_DIR"
chmod 700 "$BACK_DIR" || true

# ensure env
if [ ! -f "$ENV_FILE" ]; then
  cat >"$ENV_FILE" <<EOF
PORT=$PORT_DEFAULT
WOLV_SEND=/usr/local/bin/wolv_send
TG_ALERTS=1
MONITOR_URL=https://bbbotrader.paycashnostory.workers.dev/ping
MONITOR_EVERY=20
EOF
  chmod 600 "$ENV_FILE" || true
fi

# backend server.js (FULL REPLACE)
SERVER_JS='import http from "http";
import express from "express";
import { execFile } from "child_process";

const app=express();
app.use(express.json({limit:"2mb"}));

const ENV=(k,d)=>process.env[k]??d;
const now=()=>new Date().toISOString();
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));

const TG_ON=()=>ENV("TG_ALERTS","1")!=="0";
const WOLV_SEND=()=>ENV("WOLV_SEND","/usr/local/bin/wolv_send");
function sendTG(msg){
  if(!TG_ON()) return;
  execFile(WOLV_SEND(),[String(msg)],{timeout:8000},()=>{});
}

async function fetchText(u,ms=9000){
  const r=await fetch(u,{method:"GET",redirect:"follow",signal:AbortSignal.timeout(ms)});
  return {ok:r.ok,code:r.status,text:await r.text()};
}
async function fetchJSON(u,ms=9000){
  const r=await fetch(u,{method:"GET",redirect:"follow",signal:AbortSignal.timeout(ms)});
  const t=await r.text();
  let j=null; try{j=JSON.parse(t);}catch(e){}
  return {ok:r.ok,code:r.status,text:t,json:j};
}
async function ping(url){
  const t=Date.now();
  try{
    const r=await fetchText(url,8000);
    const ok=r.ok && /pong/i.test(r.text||"");
    return {ok,code:r.code,ms:Date.now()-t,body:(r.text||"").slice(0,120)};
  }catch(e){
    return {ok:false,code:0,ms:Date.now()-t,body:String(e).slice(0,120)};
  }
}

async function jupPrice(mint){
  const u=`https://price.jup.ag/v4/price?ids=${encodeURIComponent(mint)}`;
  const r=await fetchJSON(u,9000);
  if(!r.ok || !r.json || !r.json.data || !r.json.data[mint] || typeof r.json.data[mint].price!=="number") return null;
  return r.json.data[mint].price;
}

async function dsLatestSolana(limit=60){
  const u="https://api.dexscreener.com/token-profiles/latest/v1";
  const r=await fetchJSON(u,9000);
  if(!r.ok || !Array.isArray(r.json)) return [];
  const arr=r.json.filter(x=>x && x.chainId==="solana" && x.tokenAddress).slice(0,limit);
  return arr.map(x=>({
    chainId:x.chainId,
    mint:x.tokenAddress,
    symbol:x.tokenSymbol||"",
    name:x.tokenName||"",
    desc:x.description||"",
    url:x.url||"",
    icon:x.icon||"",
    links:x.links||[],
    createdAt:x.createdAt||null
  }));
}

const state={
  boot:now(),
  monitor:{url:ENV("MONITOR_URL",""),every:+ENV("MONITOR_EVERY","0")||0,last:null,failStreak:0,effective:"INIT"},
  sessions:{} // by wallet => {running,cfg,spent,pivot,hi,lo,lastPrice,lastDecide,lastBuyAt}
};

function getSess(wallet){
  if(!wallet) return null;
  if(!state.sessions[wallet]) state.sessions[wallet]={running:false,cfg:null,spent:0,pivot:null,hi:null,lo:null,lastPrice:null,lastDecide:null,lastBuyAt:0};
  return state.sessions[wallet];
}

function normMint(m){ return String(m||"").trim(); }
function normWallet(w){ return String(w||"").trim(); }

app.get("/health",(req,res)=>res.json({ok:true,service:"wolverine",now:now()}));
app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));
app.get("/status",(req,res)=>res.json({ok:true,now:now(),state:{boot:state.boot,monitor:state.monitor,sessionsCount:Object.keys(state.sessions).length}}));

app.get("/price",async(req,res)=>{
  const mint=normMint(req.query.mint);
  if(!mint) return res.status(400).json({ok:false,error:"mint required"});
  const p=await jupPrice(mint);
  if(p==null) return res.status(502).json({ok:false,error:"price unavailable"});
  res.json({ok:true,now:now(),mint,price:p});
});

app.get("/finder/latest",async(req,res)=>{
  const limit=clamp(+req.query.limit||60,10,200);
  const list=await dsLatestSolana(limit);
  res.json({ok:true,now:now(),count:list.length,list});
});

app.post("/traderone/start",(req,res)=>{
  const b=req.body||{};
  const wallet=normWallet(b.wallet);
  const mint=normMint(b.mint);
  const budget=+b.budgetUSDC||0;
  const mode=String(b.mode||"dca").toLowerCase();
  const chunk=+((b.params&&b.params.chunk)||b.chunk)||0;
  const interval=+((b.params&&b.params.interval)||b.interval)||0;
  const entryMin=+((b.params&&b.params.entryMin)||b.entryMin)||0.08;
  const entryMax=+((b.params&&b.params.entryMax)||b.entryMax)||0.15;

  if(!wallet) return res.status(400).json({ok:false,error:"wallet required"});
  if(!mint) return res.status(400).json({ok:false,error:"mint required"});
  if(!(budget>0)) return res.status(400).json({ok:false,error:"budgetUSDC invalid"});
  if(!(chunk>0)) return res.status(400).json({ok:false,error:"chunk invalid"});
  if(!(interval>=2)) return res.status(400).json({ok:false,error:"interval invalid (>=2s)"});

  const s=getSess(wallet);
  s.running=true;
  s.cfg={wallet,mint,budgetUSDC:budget,mode,params:{chunk,interval,entryMin,entryMax}};
  s.spent=0;
  s.pivot=null; s.hi=null; s.lo=null; s.lastPrice=null; s.lastDecide=null; s.lastBuyAt=0;

  sendTG(`WOLVERINE: START wallet=${wallet.slice(0,6)}.. budget=${budget} mode=${mode} ${now()}`);
  res.json({ok:true,now:now(),session:s});
});

app.post("/traderone/stop",(req,res)=>{
  const b=req.body||{};
  const wallet=normWallet(b.wallet);
  if(!wallet) return res.status(400).json({ok:false,error:"wallet required"});
  const s=getSess(wallet);
  s.running=false;
  sendTG(`WOLVERINE: STOP wallet=${wallet.slice(0,6)}.. ${now()}`);
  res.json({ok:true,now:now(),session:s});
});

app.post("/traderone/log",(req,res)=>{
  const ev=req.body||{};
  const wallet=normWallet(ev.wallet);
  if(!wallet) return res.status(400).json({ok:false,error:"wallet required"});
  const s=getSess(wallet);
  if(ev.type==="swap"){
    const us=+ev.usdc||0;
    if(us>0 && s.cfg) s.spent=clamp(s.spent+us,0,s.cfg.budgetUSDC);
    s.lastBuyAt=Date.now();
  }
  res.json({ok:true,now:now(),spentUSDC:s.spent});
});

app.post("/traderone/decide",async(req,res)=>{
  const b=req.body||{};
  const wallet=normWallet(b.wallet);
  if(!wallet) return res.status(400).json({ok:false,error:"wallet required"});
  const s=getSess(wallet);
  if(!s.cfg || !s.running) return res.json({ok:true,now:now(),action:"IDLE",reason:"not running"});

  const mint=s.cfg.mint;
  const price=await jupPrice(mint);
  if(price==null) return res.json({ok:true,now:now(),action:"HOLD",reason:"price unavailable"});

  s.lastPrice=price;
  if(s.pivot==null) s.pivot=price;
  if(s.hi==null || price>s.hi) s.hi=price;
  if(s.lo==null || price<s.lo) s.lo=price;

  // pivot = high watermark since start (simple)
  if(price>s.pivot) s.pivot=price;

  const remain=clamp(s.cfg.budgetUSDC - s.spent,0,s.cfg.budgetUSDC);
  const {chunk,interval,entryMin,entryMax}=s.cfg.params;
  const t=Date.now();
  const canTime = (t - (s.lastDecide||0)) >= interval*1000;
  s.lastDecide=t;

  if(remain<=0.000001) return res.json({ok:true,now:now(),action:"STOP",reason:"budget reached",price,pivot:s.pivot,spent:s.spent,remain});
  if(!canTime) return res.json({ok:true,now:now(),action:"HOLD",reason:"interval",price,pivot:s.pivot,spent:s.spent,remain});

  if(s.cfg.mode==="dca"){
    const amt=Math.min(chunk,remain);
    return res.json({ok:true,now:now(),action:"BUY",reason:"dca",usdc:amt,price,pivot:s.pivot,spent:s.spent,remain});
  }

  // ZONE: buy only if drawdown between entryMin..entryMax from pivot
  const dd=(s.pivot>0)?(1 - price/s.pivot):0;
  const inZone = dd>=entryMin && dd<=entryMax;
  if(inZone){
    const amt=Math.min(chunk,remain);
    return res.json({ok:true,now:now(),action:"BUY",reason:`zone dd=${(dd*100).toFixed(2)}%`,usdc:amt,price,pivot:s.pivot,spent:s.spent,remain,dd});
  }
  return res.json({ok:true,now:now(),action:"HOLD",reason:`out of zone dd=${(dd*100).toFixed(2)}%`,price,pivot:s.pivot,spent:s.spent,remain,dd});
});

function monitorTick(){
  const url=state.monitor.url;
  const every=state.monitor.every;
  if(!url || !every) return;
  ping(url).then(r=>{
    state.monitor.last={...r,ts:now()};
    if(r.ok){
      state.monitor.failStreak=0;
      if(state.monitor.effective!=="UP"){ state.monitor.effective="UP"; sendTG(`WOLVERINE: API UP (recovery) ${now()}`); }
    }else{
      state.monitor.failStreak++;
      if(state.monitor.failStreak>=3 && state.monitor.effective!=="DOWN"){ state.monitor.effective="DOWN"; sendTG(`WOLVERINE: API DOWN (>=3 fails) ${now()}`); }
    }
  }).catch(()=>{});
}
let lastMon=0;
setInterval(()=>{ const e=state.monitor.every; if(!e) return; const t=Date.now(); if(t-lastMon>=e*1000){ lastMon=t; monitorTick(); } },1000);

const port=+ENV("PORT","9697")||9697;
http.createServer(app).listen(port,"127.0.0.1",()=>console.log(`wolverine backend 127.0.0.1:${port}`));
'

source /opt/fireinners/sentinel/telegram.env
curl -sS "https://api.telegram.org/bot${TG_TOKEN}/getUpdates?timeout=60&limit=20&allowed_updates=message" | python3 - <<'PY'
import sys,json
j=json.loads(sys.stdin.read() or "{}")
print("COUNT:", len(j.get("result",[])))
for u in j.get("result",[]):
  m=u.get("message") or u.get("edited_message") or {}
  c=m.get("chat") or {}
  if "id" in c:
    print("CHAT_ID:", c["id"])
    print("TEXT:", m.get("text"))
    break
PY
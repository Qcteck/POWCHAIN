# 1) Regarde ce que le vhost SSL fait pour /wolverine/traderone/api
grep -nE "listen 443|server_name|wolverine/traderone/api|proxy_pass" /etc/nginx/sites-available/fireinners.online-ssl

# 2) Si tu vois encore 3000 quelque part, remplace-le par 12703 (dans le vhost SSL)
grep -n "127.0.0.1:3000" /etc/nginx/sites-available/fireinners.online-ssl && \
sed -i 's/127\.0\.0\.1:3000/127.0.0.1:12703/g' /etc/nginx/sites-available/fireinners.online-ssl

# 3) Ajoute le bloc location (au besoin) dans le server 443
perl -0777 -i -pe 's#(server\s*\{[^}]*listen\s+443[^}]*\{)#$1\n\n  location ^~ /wolverine/traderone/api/ {\n    proxy_pass http://127.0.0.1:12703;\n    proxy_set_header Host $host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n  }\n#s' /etc/nginx/sites-available/fireinners.online-ssl

# 4) Reload
nginx -t && systemctl reload nginx
# ROOT batch — trouver le git root OU cloner le repo, puis push
set -euo pipefail

APP="/opt/fireinners/frontend-react/app"
REPO_CLONE="/opt/fireinners/WOLVERINE"
REMOTE_HTTPS="https://github.com/Qcteck/WOLVERINE.git"
BR="wolverine-ui-v2"

echo "=== 1) Cherche un .git en remontant depuis $APP ==="
d="$APP"
GITROOT=""
while [ "$d" != "/" ]; do
  if [ -d "$d/.git" ]; then GITROOT="$d"; break; fi
  d="$(dirname "$d")"
done

if [ -n "$GITROOT" ]; then
  echo "OK: git root trouvé: $GITROOT"
  cd "$GITROOT"
else
  echo "INFO: aucun .git trouvé au-dessus de $APP"
  echo "=== 2) Clone du repo GitHub dans $REPO_CLONE ==="
  apt-get update -y
  apt-get install -y git rsync
  rm -rf "$REPO_CLONE"
  git clone "$REMOTE_HTTPS" "$REPO_CLONE"
  cd "$REPO_CLONE"

  echo "=== 3) Copie du frontend actuel (app/) dans le repo cloné ==="
  rsync -a --delete "$APP/" "$REPO_CLONE/"
fi

echo "=== 4) Configure origin (au cas où) ==="
if git remote | grep -qx origin; then
  git remote set-url origin "$REMOTE_HTTPS"
else
  git remote add origin "$REMOTE_HTTPS"
fi
git remote -v

echo "=== 5) Branche + commit + push ==="
git checkout -b "$BR" 2>/dev/null || git checkout "$BR"
git add -A
git commit -m "Wolverine UI v2" || true
git push -u origin "$BR"

echo "DONE ✅"
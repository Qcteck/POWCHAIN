set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

SRC="/var/www/fireinners-test"
ULT="$SRC/ultimate"
BACK="/var/www/fireinners-test-backup-$TS"

mkdir -p "$ULT" "$BACK"

echo "=== 1) Dépendances ==="
apt-get update -y
apt-get install -y ffmpeg zip

echo "=== 2) Compte images dans /test ==="
COUNT="$(find "$SRC" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) | wc -l)"
echo "Images trouvées: $COUNT"
[ "$COUNT" -gt 0 ] || { echo "❌ 0 image dans $SRC"; exit 1; }

echo "=== 3) Build ULTIMATE (ZIP + MP4) dans $ULT ==="
rm -f "$ULT/ultimate.zip" "$ULT/ultimate.mp4" 2>/dev/null || true
rm -rf "$ULT/frames" 2>/dev/null || true
mkdir -p "$ULT/frames"

# ZIP
( cd "$SRC" && zip -q -r "$ULT/ultimate.zip" . -i "*.png" "*.jpg" "*.jpeg" )
ls -lah "$ULT/ultimate.zip"

# MP4 (30 fps) à partir des images triées par nom
n=0
for f in $(find "$SRC" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) -printf "%f\n" | sort); do
  n=$((n+1))
  printf -v frame "$ULT/frames/frame_%06d.png" "$n"
  if echo "$f" | grep -Eiq '\.(jpg|jpeg)$'; then
    ffmpeg -loglevel error -y -i "$SRC/$f" "$frame"
  else
    cp -a "$SRC/$f" "$frame"
  fi
done

ffmpeg -y -loglevel error -framerate 30 -i "$ULT/frames/frame_%06d.png" \
  -c:v libx264 -pix_fmt yuv420p -movflags +faststart "$ULT/ultimate.mp4"

ls -lah "$ULT/ultimate.mp4"

echo "=== 4) Backup + retirer toutes les images originales de /test (on garde index.html + ultimate/*) ==="
# move seulement les images au root de /test
shopt -s nullglob
mv "$SRC"/*.png "$BACK"/ 2>/dev/null || true
mv "$SRC"/*.jpg "$BACK"/ 2>/dev/null || true
mv "$SRC"/*.jpeg "$BACK"/ 2>/dev/null || true
shopt -u nullglob

echo "=== 5) Résultat ==="
echo "✅ ULTIME gardé: $ULT/ultimate.mp4 et $ULT/ultimate.zip"
echo "✅ Anciennes images déplacées: $BACK"
echo "➡️ URL: https://fireinners.online/test/ultimate/ultimate.mp4"
echo "➡️ URL: https://fireinners.online/test/ultimate/ultimate.zip"
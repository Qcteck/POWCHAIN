#!/usr/bin/env bash
set -e

TARGET="/opt/wolverine/index.html"
BACKUP="/opt/wolverine/index.html.bak.$(date +%s)"

echo "[1/4] Préparation dossier"
mkdir -p /opt/wolverine

if [ -f "$TARGET" ]; then
  echo "[2/4] Backup existant -> $BACKUP"
  cp "$TARGET" "$BACKUP"
fi

echo "[3/4] Écriture HTML TraderOne"
cat > "$TARGET" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>TraderOne</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
:root{
--fg:#fff;--bg:#0b0b12;--card:rgba(20,20,40,.55);
--accent:#ff5fd2;--accent2:#2fffdc;
}
body.light{--fg:#000;--bg:#f5f6ff;--card:rgba(255,255,255,.7)}
html,body{margin:0;height:100%;background:var(--bg);color:var(--fg);font-family:system-ui;overflow:hidden}
canvas{position:fixed;inset:0;z-index:0}
#app{position:relative;z-index:2;height:100%;display:flex;align-items:center;justify-content:center}
.card{
background:var(--card);backdrop-filter:blur(14px);
border:1px solid rgba(255,255,255,.25);
border-radius:18px;padding:24px;min-width:320px;
box-shadow:0 0 40px rgba(255,95,210,.25)
}
h1{text-align:center;margin:0 0 12px}
button{
border:0;border-radius:12px;padding:10px 16px;
background:linear-gradient(135deg,var(--accent),var(--accent2));
color:#000;font-weight:700;cursor:pointer
}
.row{margin:6px 0;font-size:14px}
.toggle{position:fixed;top:14px;right:14px;z-index:3}
</style>
</head>
<body>

<canvas id="fx"></canvas>

<div class="toggle">
<button onclick="toggleMode()">☀️ / 🌙</button>
</div>

<div id="app">
<div class="card">
<h1>TraderOne</h1>
<button style="width:100%">Connect Phantom</button>
<div class="row">SOL : <b id="sol">—</b></div>
<div class="row">USDC : <b id="usdc">—</b></div>
</div>
</div>

<script>
function toggleMode(){
  document.body.classList.toggle("light");
}

const c=document.getElementById("fx"),ctx=c.getContext("2d");
let W,H,P=[];
function resize(){W=c.width=innerWidth;H=c.height=innerHeight}
addEventListener("resize",resize);resize();
function rnd(a,b){return Math.random()*(b-a)+a}

for(let i=0;i<1200;i++){
P.push({x:rnd(0,W),y:rnd(0,H),r:rnd(.4,1.6),
vx:rnd(-.2,.2),vy:rnd(-.2,.2),h:rnd(190,320)});
}

function draw(){
ctx.clearRect(0,0,W,H);
const light=document.body.classList.contains("light");
for(const p of P){
p.x+=p.vx;p.y+=p.vy;
if(p.x<0||p.x>W)p.vx*=-1;
if(p.y<0||p.y>H)p.vy*=-1;
ctx.beginPath();
ctx.fillStyle=`hsla(${p.h},80%,${light?30:70}%,${light?.15:.45})`;
ctx.shadowBlur=light?6:14;
ctx.shadowColor=`hsla(${p.h},90%,70%,.8)`;
ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
ctx.fill();
}
requestAnimationFrame(draw);
}
draw();

document.getElementById("sol").textContent="0.06857";
document.getElementById("usdc").textContent="1.3435";
</script>

</body>
</html>
HTML

chmod 644 "$TARGET"

echo "[4/4] Reload nginx"
nginx -t && systemctl reload nginx

echo "✅ TraderOne UI déployé : https://fireinners.online/wolverine/"
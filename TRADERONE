set -e
cd /root

fix_loc () {
  local f="$1"
  [ -f "$f" ] || return 0

  mkdir -p /root/nginx_backups
  cp -v "$f" "/root/nginx_backups/$(basename "$f").authfix.$(date +%Y%m%d_%H%M%S)"

  # récupère la clé existante sans l'afficher
  KEY="$(sed -n 's/.*http_x_api_key[[:space:]]*!=[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n 1)"
  [ -n "$KEY" ] || { echo "KEY introuvable dans $f"; exit 1; }

  awk -v key="$KEY" '
    BEGIN{inblk=0}
    /^location[[:space:]]+(\^~|~\^|~)[[:space:]]+\/wolverine\/traderone\/api\/[[:space:]]*\{/{
      inblk=1
      print "location ^~ /wolverine/traderone/api/ {"
      print "  add_header X-MATCH traderone-api always;"
      print "  if ($http_x_api_key = \"\") { return 403; }"
      print "  if ($http_x_api_key != \"" key "\") { return 403; }"
      print "  proxy_pass http://127.0.0.1:3002/wolverine/api/;"
      print "  proxy_set_header Host $host;"
      print "  proxy_set_header X-Real-IP $remote_addr;"
      print "  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
      print "}"
      next
    }
    inblk==1{ if ($0 ~ /^[[:space:]]*}[[:space:]]*$/){ inblk=0 } ; next }
    {print}
  ' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
}

fix_loc /etc/nginx/sites-enabled/fireinners.online
fix_loc /etc/nginx/sites-enabled/fireinners.online-ssl

nginx -t
systemctl reload nginx


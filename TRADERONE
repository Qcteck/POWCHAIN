cat >/root/FIX_WOLVERINE_SOL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIX WOLVERINE SOL BALANCE (FRONTEND ONLY) ==="

HTML="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor"
TS="$(date +%Y%m%d_%H%M%S)"

# 1) Vérifications
if [ ! -f "$HTML" ]; then
  echo "ERREUR: $HTML introuvable"
  exit 1
fi

mkdir -p "$VENDOR"

# 2) Backup
cp "$HTML" "$HTML.bak_$TS"
echo "Backup créé: $HTML.bak_$TS"

# 3) Installer solana-web3 local (version stable)
if [ ! -f "$VENDOR/solana-web3.min.js" ]; then
  echo "Téléchargement solana-web3.min.js (local)…"
  curl -fsSL https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js \
    -o "$VENDOR/solana-web3.min.js"
fi

# 4) Nettoyage des anciennes implémentations Phantom / SOL foireuses
sed -i \
  -e '/solanaWeb3/d' \
  -e '/LAMPORTS_PER_SOL/d' \
  -e '/getBalance/d' \
  -e '/lamports/d' \
  "$HTML"

# 5) Injecter le script propre AVANT </body>
awk -v vendor="$VENDOR" '
/<\/body>/ {
print "<script src=\"/wolverine/vendor/solana-web3.min.js\"></script>";
print "<script>";
print "let solConnection=null;";
print "async function connectPhantom(){";
print " if(!window.solana||!window.solana.isPhantom){alert(\"Phantom non détecté\");return;}";
print " const resp=await window.solana.connect();";
print " const pubkey=resp.publicKey.toString();";
print " document.getElementById(\"walletAddress\").innerText=pubkey;";
print " solConnection=new solanaWeb3.Connection(solanaWeb3.clusterApiUrl(\"mainnet-beta\"),\"confirmed\");";
print " const bal=await solConnection.getBalance(new solanaWeb3.PublicKey(pubkey));";
print " const sol=(bal/solanaWeb3.LAMPORTS_PER_SOL).toFixed(6);";
print " document.getElementById(\"walletSOL\").innerText=sol;";
print "}";
print "</script>";
}
{print}
' "$HTML" >"$HTML.tmp"

mv "$HTML.tmp" "$HTML"

# 6) S’assurer que les IDs existent (sans changer le design)
grep -q 'id="walletAddress"' "$HTML" || sed -i 's/Address:/Address: <span id="walletAddress">-<\/span>/g' "$HTML"
grep -q 'id="walletSOL"' "$HTML" || sed -i 's/SOL:.*/SOL: <span id="walletSOL">-<\/span>/g' "$HTML"

# 7) Forcer le bouton Phantom à appeler la bonne fonction
sed -i 's/onclick="[^"]*"/onclick="connectPhantom()"/g' "$HTML"

echo "=== FIX TERMINÉ ==="
echo "Recharge https://fireinners.online/wolverine/index.html"
echo "SOL DOIT S’AFFICHER APRÈS CONNEXION PHANTOM"
BASH

chmod +x /root/FIX_WOLVERINE_SOL.sh
/root/FIX_WOLVERINE_SOL.sh
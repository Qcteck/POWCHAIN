cat > /root/batch_root_fireinners.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="${2:-/etc/nginx/sites-enabled/${DOMAIN}-ssl}"
SNIP="/etc/nginx/snippets/${DOMAIN}_wolverine.conf"
APPLY="${APPLY:-0}"   # 0=dry-run, 1=apply
TS="$(date +%Y%m%d_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/batch_root_${TS}"
BACKVHOST="${BACKDIR}/$(basename "$VHOST")"

say(){ printf '%s\n' "$*"; }

say "== batch_root (${DOMAIN}) =="
say "APPLY=${APPLY} (0=dry-run, 1=apply)"
say "VHOST=${VHOST}"
say "SNIP=${SNIP}"
echo

if [[ ! -f "$VHOST" ]]; then
  say "ERROR: vhost introuvable: $VHOST"
  exit 1
fi

# 1) Build snippet (wolverine + favicon)
SNIP_CONTENT="$(cat <<'EOF'
# --- wolverine + favicon snippet ---
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}

location = /favicon.ico {
  access_log off;
  log_not_found off;
  try_files /favicon.ico =204;
}
EOF
)"

say "== 1) Snippet =="
if [[ "$APPLY" == "1" ]]; then
  install -d /etc/nginx/snippets
  printf "%s\n" "$SNIP_CONTENT" > "$SNIP"
  say "OK: écrit -> $SNIP"
else
  say "[DRY] écrirait -> $SNIP"
fi
echo

# 2) Patch VHOST safely (insert include inside first server{ ... })
INCLUDE_LINE="include ${SNIP};"

say "== 2) Patch VHOST (safe) =="
if grep -Fq "$INCLUDE_LINE" "$VHOST"; then
  say "OK: include déjà présent dans $VHOST"
else
  # Trouver la 1ère ligne qui contient 'server' + '{'
  SERVER_LINE="$(grep -nE '^[[:space:]]*server[[:space:]]*\{' "$VHOST" | head -n1 | cut -d: -f1 || true)"
  if [[ -z "${SERVER_LINE}" ]]; then
    say "ERROR: impossible de trouver 'server {' dans $VHOST"
    exit 1
  fi

  # Préparer patch en insérant l'include juste APRÈS la ligne "server {"
  tmp="$(mktemp)"
  awk -v sl="$SERVER_LINE" -v inc="$INCLUDE_LINE" '
    NR==sl { print; print "  " inc; next }
    { print }
  ' "$VHOST" > "$tmp"

  if [[ "$APPLY" == "1" ]]; then
    mkdir -p "$BACKDIR"
    cp -a "$VHOST" "$BACKVHOST"
    cp -a "$tmp" "$VHOST"
    say "OK: backup -> $BACKVHOST"
    say "OK: vhost patché -> $VHOST"
  else
    say "[DRY] insérerait l'include dans le 1er server{} (ligne $SERVER_LINE)"
    say "[DRY] ferait un backup -> $BACKVHOST"
  fi

  rm -f "$tmp"
fi
echo

# 3) nginx -t (must pass)
say "== 3) nginx -t =="
if nginx -t; then
  say "OK: nginx -t PASS"
else
  say "ERROR: nginx -t FAIL (aucun reload)"
  exit 1
fi
echo

# 4) Reload if APPLY=1
say "== 4) reload =="
if [[ "$APPLY" == "1" ]]; then
  systemctl reload nginx
  say "OK: nginx reloaded"
else
  say "[DRY] pas de reload (APPLY=0)"
fi

say "== DONE =="
BASH

chmod +x /root/batch_root_fireinners.sh
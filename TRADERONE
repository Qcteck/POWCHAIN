bash <<'EOF'
set -e

echo "=== AIAQUILA RSS FIX FINAL ==="

# 1. Dossiers
ROOT="/var/www/aiaquila"
mkdir -p "$ROOT"
cd "$ROOT"

# 2. Dépendances
apt update -y
apt install -y php php-curl php-xml

# 3. Backend RSS -> JSON (PROPRE)
cat > rss.php <<'PHP'
<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/json; charset=UTF-8");

if (!isset($_GET["url"])) {
  http_response_code(400);
  echo json_encode(["error"=>"missing url"]);
  exit;
}

$url = $_GET["url"];

$ch = curl_init($url);
curl_setopt_array($ch, [
  CURLOPT_RETURNTRANSFER => true,
  CURLOPT_FOLLOWLOCATION => true,
  CURLOPT_TIMEOUT => 10,
  CURLOPT_USERAGENT => "AIAQUILA-RSS"
]);

$data = curl_exec($ch);
curl_close($ch);

if (!$data) {
  http_response_code(502);
  echo json_encode(["error"=>"fetch failed"]);
  exit;
}

libxml_use_internal_errors(true);
$xml = simplexml_load_string($data, "SimpleXMLElement", LIBXML_NOCDATA);
if (!$xml) {
  http_response_code(500);
  echo json_encode(["error"=>"xml parse failed"]);
  exit;
}

$items = [];
if (isset($xml->channel->item)) {
  foreach ($xml->channel->item as $i) {
    $items[] = [
      "title" => (string)$i->title,
      "link" => (string)$i->link,
      "date" => (string)$i->pubDate,
      "desc" => strip_tags((string)$i->description)
    ];
  }
}

echo json_encode($items);
PHP

# 4. Frontend HTML + JS (fonctionnel)
cat > index.html <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{background:#0b1a33;color:#fff;font-family:Arial;padding:20px}
button{padding:10px;font-size:16px}
.article{margin:10px 0;padding:10px;border-bottom:1px solid #444}
</style>
</head>
<body>

<h1>🦅 AIAQUILA — RSS réel</h1>
<button onclick="loadRSS()">Lire les articles</button>
<div id="out"></div>

<script>
const FEEDS=[
"https://www.coindesk.com/arc/outboundfeeds/rss/",
"https://cointelegraph.com/rss",
"https://news.bitcoin.com/feed/"
];

async function loadRSS(){
  const out=document.getElementById("out");
  out.innerHTML="Chargement...";
  let total=0;

  for(const f of FEEDS){
    try{
      const r=await fetch("rss.php?url="+encodeURIComponent(f));
      const j=await r.json();
      j.forEach(a=>{
        total++;
        out.innerHTML+=`
          <div class="article">
            <b>${a.title}</b><br>
            <a href="${a.link}" target="_blank">${a.link}</a>
          </div>`;
      });
    }catch(e){
      out.innerHTML+=`<div>Erreur flux ${f}</div>`;
    }
  }

  out.innerHTML=`<h3>${total} articles</h3>`+out.innerHTML;
}
</script>

</body>
</html>
HTML

# 5. Permissions
chown -R www-data:www-data "$ROOT"
chmod -R 755 "$ROOT"

# 6. Vérification
echo "=== TEST LOCAL ==="
php -r 'echo file_get_contents("http://localhost/aiaquila/rss.php?url=https://www.coindesk.com/arc/outboundfeeds/rss/");' || true

echo "=== OK ==="
echo "Ouvre : https://fireinners.online/aiaquila/"
EOF
set -euo pipefail
DOMAIN="fireinners.online"

BAD="/etc/nginx/snippets/fireinners-wolverine.conf"
SNIP="/etc/nginx/snippets/wolverine_rpc_proxy.conf"

echo "== 0) Cleanup BAD snippet (enlève tout bloc location RPC s'il traîne) =="
if [ -f "$BAD" ]; then
  TS="$(date +%s)"
  cp -a "$BAD" "$BAD.bak.$TS"
  perl -0777 -i -pe 's/location\s*=\s*\/wolverine\/traderone\/api\/rpc\s*\{[\s\S]*?\}\s*//g' "$BAD"
  echo "Backup: $BAD.bak.$TS"
fi

echo "== 1) Create RPC location snippet (location ONLY) =="
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'EOF'
# Wolverine: Solana RPC proxy (same-origin)
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF

echo "== 2) Find the REAL server conf that includes fireinners-wolverine snippet =="
VHOST="$(grep -RIl --include='*.conf' 'include\s\+/etc/nginx/snippets/fireinners-wolverine\.conf' \
  /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | head -n 1 || true)"
echo "VHOST=$VHOST"
[ -n "${VHOST:-}" ] || { echo "ERR: impossible de trouver le server{} qui inclut fireinners-wolverine.conf"; exit 1; }

echo "== 3) Inject include RPC snippet RIGHT AFTER that include line (so it's inside server{}) =="
if ! grep -q 'include /etc/nginx/snippets/wolverine_rpc_proxy.conf' "$VHOST"; then
  TS="$(date +%s)"
  cp -a "$VHOST" "$VHOST.bak.$TS"
  echo "Backup vhost: $VHOST.bak.$TS"
  perl -i -pe '
    if(/include\s+\/etc\/nginx\/snippets\/fireinners-wolverine\.conf\s*;/ && !$done++){
      $_ .= "  include /etc/nginx/snippets/wolverine_rpc_proxy.conf;\n";
    }
  ' "$VHOST"
else
  echo "OK: include RPC déjà présent"
fi

echo "== 4) Reload nginx =="
nginx -t && systemctl reload nginx

echo "== 5) TEST HTTPS RPC (doit PAS être 404) =="
curl -ksS -i "https://$DOMAIN/wolverine/traderone/api/rpc" \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 25
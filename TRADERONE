.btn{display:inline-block;padding:10px 12px;border-radius:12px;text-decoration:none;color:#00121a;font-weight:900;
background:linear-gradient(135deg,#2b6bff,#00ffd5);border:0}
EOF

  npm run build >/dev/null 2>&1 || die "npm build failed"
}

unpack_and_build_zip(){
  local z="$1"
  say "2) Unpack + build from zip: $z"
  rm -rf "$APP"
  mkdir -p "$APP"
  unzip -q "$z" -d "$APP/unpacked" || die "unzip failed"

  # try to locate a package.json
  local PKG
  PKG="$(python3 - <<PY
import os
root=os.path.abspath("'"$APP"'"+"/unpacked")
best=None
for d,_,f in os.walk(root):
  if "package.json" in f:
    best=os.path.join(d,"package.json"); break
print(best or "")
PY
)"
  if [ -n "$PKG" ]; then
    local DIR; DIR="$(dirname "$PKG")"
    say "   found package.json in: $DIR"
    cd "$DIR"
    npm install >/dev/null 2>&1 || die "npm install failed"
    npm run build >/dev/null 2>&1 || die "npm run build failed"

    # find dist/build/out
    local DIST
    DIST="$(python3 - <<PY
import os
cand=["dist","build","out"]
base=os.path.abspath("'"$DIR"'")
for c in cand:
  p=os.path.join(base,c)
  if os.path.isdir(p) and os.path.isfile(os.path.join(p,"index.html")):
    print(p); raise SystemExit
print("")
PY
)"
    [ -n "$DIST" ] || die "build ok but could not find dist/build/out with index.html"
    echo "$DIST"
    return 0
  fi

  # zip might already contain dist
  local DIST2
  DIST2="$(python3 - <<PY
import os
root=os.path.abspath("'"$APP"'"+"/unpacked")
for d,_,f in os.walk(root):
  if "index.html" in f and (d.endswith("/dist") or d.endswith("/build") or d.endswith("/out")):
    print(d); raise SystemExit
print("")
PY
)"
  [ -n "$DIST2" ] || die "zip does not look like a React/Vite/Next export (no package.json, no dist/build/out index.html)"
  echo "$DIST2"
}

deploy_dist(){
  local dist="$1"
  say "3) Deploy dist -> $WEBROOT"
  mkdir -p "$WEBROOT"
  backup_one "$WEBROOT"
  rsync -a --delete "$dist"/ "$WEBROOT"/
  chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true

  # symlink /var/www/iaaquila -> /var/www/aquila_stacking (safe for SPA root mapping)
  if [ -L "$LINKROOT" ] || [ -e "$LINKROOT" ]; then
    backup_one "$LINKROOT"
    rm -rf "$LINKROOT" || true
  fi
  ln -s "$WEBROOT" "$LINKROOT"
}

write_nginx_include(){
  say "4) Write nginx include: $INC"
  local inc_txt
  inc_txt="$(cat <<EOF
# Aquila Stacking (React static SPA)
# Webroot: $WEBROOT (and symlink $LINKROOT)
location = ${PATH_A%/} { return 301 $PATH_A; }
location ^~ $PATH_A {
  root /var/www;
  try_files \$uri \$uri/ ${PATH_A}index.html;
  add_header Cache-Control "no-store" always;
}
location = ${PATH_B%/} { return 301 $PATH_B; }
location ^~ $PATH_B {
  root /var/www;
  try_files \$uri \$uri/ ${PATH_B}index.html;
  add_header Cache-Control "no-store" always;
}
EOF
)"
  mkdir -p "$(dirname "$INC")"
  write_file "$INC" "$inc_txt"
}

patch_vhost_includes(){
  say "5) Patch vhosts to include $INC"
  backup_one "$VHOST_A"
  backup_one "$VHOST_B"
  backup_one "$VHOST_C"

  python3 - <<PY
import os,re,sys
INC=r"$INC"
DOMAIN=r"$DOMAIN"
targets=[r"$VHOST_A",r"$VHOST_B",r"$VHOST_C"]
def patch_file(p):
  if not os.path.isfile(p): return False
  s=open(p,"r",encoding="utf-8",errors="ignore").read()
  if INC in s: return False
  # patch only server blocks that listen 443 and contain server_name DOMAIN
  out=[]
  i=0
  changed=False
  # naive server block parse by braces
  token=re.compile(r"(server\s*\{)|(\{)|(\})",re.M)
  stack=[]
  last=0
  for m in token.finditer(s):
    if m.group(1): # server {
      stack.append(("server",m.start()))
    elif m.group(2):
      stack.append(("{",m.start()))
    elif m.group(3):
      # pop one level
      if stack: stack.pop()
      # if closing a server block (best-effort): look back from last server { start
    # continue
  # best-effort approach: patch using regex over server blocks
  def repl(match):
    nonlocal changed
    block=match.group(0)
    if re.search(r"\\blisten\\s+[^;]*443",block) and re.search(r"\\bserver_name\\s+[^;]*\\b"+re.escape(DOMAIN)+r"\\b",block):
      if INC in block: return block
      # insert include near top (after server_name if present else after first line)
      lines=block.splitlines()
      ins=None
      for idx,l in enumerate(lines):
        if "server_name" in l:
          ins=idx+1; break
      if ins is None: ins=1
      lines.insert(ins, f"    include {INC};")
      changed=True
      return "\\n".join(lines)
    return block
  new=re.sub(r"server\\s*\\{[\\s\\S]*?\\n\\}",repl,s)
  if changed:
    open(p,"w",encoding="utf-8").write(new)
  return changed

any_change=False
for p in targets:
  try:
    if patch_file(p):
      any_change=True
  except Exception as e:
    pass
print("patched" if any_change else "nochange")
PY
}

nginx_test_reload(){
  say "6) nginx -t + reload"
  nginx -t
  systemctl reload nginx
}

local_verify(){
  say "7) Local verify (Host header)"
  set +e
  echo "--- /aquila_stacking/ ---"
  curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_A" | head -n 20
  echo
  echo "--- /iaaquila/ ---"
  curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_B" | head -n 20
  echo
  set -e
}

main(){
  say "BEGIN Aquila React Stacking deploy"
  ensure_pkgs

  say "1) Backup nginx dump"
  nginx -T >"$BK/nginx.T.txt" 2>&1 || true

  local z; z="$(find_or_get_zip)"
  if [ -n "$z" ] && [ -f "$z" ]; then
    dist="$(unpack_and_build_zip "$z")"
  else
    dist=""
    make_fallback_vite
    dist="$APP/dist"
  fi

  deploy_dist "$dist"
  write_nginx_include
  patch_vhost_includes
  nginx_test_reload
  local_verify

  say "DONE"
  say "Backups: $BK"
  say "Open: https://$DOMAIN${PATH_A}"
  say "Open: https://$DOMAIN${PATH_B}"
}
main
BASH
chmod +x /root/MEGA_AQUILA_REACT_STACKING_DEPLOY.sh
/root/MEGA_AQUILA_REACT_STACKING_DEPLOY.sh'
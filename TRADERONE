set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"

echo "=== 1) Fichiers qui déclarent fireinners.online / www.fireinners.online ==="
mapfile -t FILES < <(nginx -T 2>/dev/null | awk '
  /^# configuration file /{f=$4}
  /server_name[[:space:]]+(fireinners\.online|www\.fireinners\.online)/{print f}
' | sort -u)

if [ "${#FILES[@]}" -eq 0 ]; then
  echo "❌ Aucun fichier trouvé avec server_name fireinners.online"
  exit 1
fi

i=0
for f in "${FILES[@]}"; do
  i=$((i+1))
  echo "[$i] $f"
  echo "    --- key lines ---"
  grep -nE 'server_name|listen|root|location|proxy_pass|try_files|return|rewrite|ssl_certificate' "$f" | head -n 40 || true
  echo
done

echo "=== 2) Choisis le fichier à GARDER (numéro) ==="
read -r -p "KEEP (1-${#FILES[@]}): " KEEP

if ! [[ "$KEEP" =~ ^[0-9]+$ ]] || [ "$KEEP" -lt 1 ] || [ "$KEEP" -gt "${#FILES[@]}" ]; then
  echo "❌ Choix invalide."
  exit 2
fi

KEEP_FILE="${FILES[$((KEEP-1))]}"
echo "✅ KEEP = $KEEP_FILE"
echo

echo "=== 3) Backup + désactivation server_name des AUTRES (sans delete) ==="
n=0
for f in "${FILES[@]}"; do
  [ "$f" = "$KEEP_FILE" ] && continue
  n=$((n+1))
  cp -a "$f" "$f.bak.$TS"

  # remplace server_name fireinners.online / www.fireinners.online par un nom unique désactivé
  sed -i -E \
    -e "s/server_name[[:space:]]+fireinners\.online([^;]*);/server_name _disabled_${TS}_${n}.local;/g" \
    -e "s/server_name[[:space:]]+www\.fireinners\.online([^;]*);/server_name _disabled_www_${TS}_${n}.local;/g" \
    "$f"

  echo "Disabled server_name in: $f"
done

echo
echo "=== 4) Test + reload nginx ==="
nginx -t
systemctl reload nginx

echo
echo "=== 5) Vérif rapide warnings ==="
nginx -T 2>/dev/null | grep -i "conflicting server name" | head -n 20 || echo "✅ No more conflicts"
echo "DONE ✅"
set -euo pipefail

HTML="/var/www/fireinners/wolverine/index.html"
TS="$(date +%s)"
cp -a "$HTML" "$HTML.bak.$TS"
echo "Backup: $HTML.bak.$TS"

BOT="$(systemctl show traderone.service -p Environment --value | tr ' ' '\n' | sed -n 's/^TRADERONE_BOT_WALLET=//p')"
echo "BOT=$BOT"

# Remplit le <span id="tAddr">...</span avec l’adresse BOT
perl -i -pe 's|(<span id="tAddr">)(.*?)(</span>)|$1'"$BOT"'$3|g' "$HTML"

# Vérif
grep -n 'id="tAddr"' "$HTML" | head -n 3

echo "OK -> Ctrl+F5 sur /wolverine puis Refresh soldes"
#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

TS="$(date +%Y%m%d_%H%M%S)"
NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGX_INC_DIR="/etc/nginx/includes"
NGX_INC_FILE="$NGX_INC_DIR/orion_routes.inc"

log(){ printf "\n[%s] %s\n" "$(date -u +'%F %T UTC')" "$*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }
require_root(){ [[ "$(id -u)" == "0" ]] || die "Lance en root."; }
ensure_cmd(){ command -v "$1" >/dev/null 2>&1 || die "Commande manquante: $1"; }
backup_path(){ local p="$1"; [[ -e "$p" ]] && cp -a "$p" "$p.bak.$TS" || true; }
chattr_unlock(){ command -v chattr >/dev/null 2>&1 && [[ -e "$1" ]] && chattr -i "$1" 2>/dev/null || true; }
chattr_lock(){ command -v chattr >/dev/null 2>&1 && [[ -e "$1" ]] && chattr +i "$1" 2>/dev/null || true; }

write_include(){
  log "Write include $NGX_INC_FILE"
  mkdir -p "$NGX_INC_DIR"
  local tmp; tmp="$(mktemp)"
  cat >"$tmp" <<'NGX'
# AUTOGENERATED: orion_routes.inc (FIXED)
location = /orion { return 301 /orion/; }
location ^~ /orion/ {
  root /var/www;
  try_files $uri $uri/ /orion/index.html;
  add_header Cache-Control "no-store";
}
NGX
  chattr_unlock "$NGX_INC_FILE"
  backup_path "$NGX_INC_FILE"
  install -m 0644 "$tmp" "$NGX_INC_FILE"
  rm -f "$tmp"
  chattr_lock "$NGX_INC_FILE"
}

ensure_include_in_vhost(){
  log "Ensure include in vhost $NGX_VHOST"
  [[ -f "$NGX_VHOST" ]] || die "Vhost introuvable: $NGX_VHOST"
  local inc_line="include $NGX_INC_FILE;"
  if grep -Fq "$inc_line" "$NGX_VHOST"; then
    log "Include déjà présent."
    return 0
  fi

  chattr_unlock "$NGX_VHOST"
  backup_path "$NGX_VHOST"

  local tmp; tmp="$(mktemp)"
  # Insère juste après la première ligne "server {" si trouvée, sinon fallback avant 1er "location"
  awk -v ins="$inc_line" '
    BEGIN{done=0}
    {
      if(!done && $0 ~ /^[[:space:]]*server[[:space:]]*\{/){
        print $0
        print "  " ins
        done=1
        next
      }
      print $0
    }
  ' "$NGX_VHOST" > "$tmp"

  if ! grep -Fq "$inc_line" "$tmp"; then
    awk -v ins="$inc_line" 'BEGIN{done=0}{if(!done && $0~/^[[:space:]]*location[[:space:]]/){print "  " ins; done=1} print $0}' "$NGX_VHOST" > "$tmp"
  fi

  grep -Fq "$inc_line" "$tmp" || die "Insertion include a échoué."
  install -m 0644 "$tmp" "$NGX_VHOST"
  rm -f "$tmp"
  chattr_lock "$NGX_VHOST"
}

main(){
  require_root
  ensure_cmd nginx
  log "=== ORION NGINX FIX START ==="
  write_include
  ensure_include_in_vhost
  nginx -t
  systemctl reload nginx
  log "Nginx reload OK"
  log "Test: https://fireinners.online/orion/"
  log "=== ORION NGINX FIX DONE ==="
}

main "$@"
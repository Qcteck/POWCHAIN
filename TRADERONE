import glob, re, os

targets = glob.glob("/etc/nginx/includes/*.inc")
loc_re = re.compile(r'^\s*location\s+\^~\s+/aquilatrader/\s*\{', re.I)
out = []
for path in targets:
    if os.path.basename(path) == "aquilatrader_static.inc":
        continue
    with open(path, "r", encoding="utf-8", errors="ignore") as f:
        lines = f.readlines()
    changed = False
    new = []
    i = 0
    while i < len(lines):
        if loc_re.match(lines[i]):
            # remove this location block (brace-balanced)
            changed = True
            depth = 0
            # enter block on this line
            while i < len(lines):
                depth += lines[i].count("{")
                depth -= lines[i].count("}")
                i += 1
                if depth <= 0:
                    break
            continue
        new.append(lines[i])
        i += 1
    if changed:
        with open(path, "w", encoding="utf-8") as f:
            f.writelines(new)
        print("purged:", path)
PY

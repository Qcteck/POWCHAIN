cat >/root/audit_blueprint_ref.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

PAT='blueprint_robo600|/wolverine/blueprint|blueprint/blueprint_'
HOST="fireinners.online"

echo "=== 1) Search references (var/www + opt + root) ==="
for R in /var/www /opt /root; do
  [ -d "$R" ] || continue
  echo "--- in $R ---"
  grep -RInE --binary-files=text --exclude-dir=node_modules --exclude-dir=.git \
    "$PAT" "$R" 2>/dev/null | head -n 120 || true
done
echo

echo "=== 2) List common cached-assets (service worker / manifest) ==="
find /var/www -maxdepth 6 -type f \
  \( -iname "*sw*.js" -o -iname "service-worker*.js" -o -iname "manifest*.json" \) \
  2>/dev/null | head -n 80 || true
echo

echo "=== 3) Show wolverine main files (maybe minified bundle contains the ref) ==="
find /var/www/wolverine -maxdepth 4 -type f \
  \( -iname "*.html" -o -iname "*.js" -o -iname "*.css" \) \
  2>/dev/null | head -n 120 || true
echo

echo "=== 4) Quick headers (PUBLIC) to see Cloudflare cache on /wolverine/ ==="
curl -skI https://$HOST/wolverine/ | egrep -i "HTTP/|server:|cache-control|cf-cache-status|etag|last-modified" || true
echo

echo "DONE ✅"
BASH

chmod +x /root/audit_blueprint_ref.sh
/root/audit_blueprint_ref.sh
cat >/root/find_and_fix_all_broken_try_files.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ts="$(date +%Y%m%d_%H%M%S)"

echo "== 1) nginx -t (garde l'erreur complète) =="
nginx -t 2>&1 | tee /root/nginx_test_${ts}.log || true

echo
echo "== 2) Show ALL try_files lines with file:line =="
grep -RIn --line-number "try_files" /etc/nginx | sed -n '1,200p' || true

echo
echo "== 3) Find BROKEN patterns (missing \$uri / backslash / empty arg) =="
grep -RIn --line-number -E "try_files\s*\\\s*=404;|try_files\s*=404;|try_files\s+;|try_files\s+\\\s+|try_files\s+\s+=404;" /etc/nginx || true

echo
echo "== 4) Backup nginx folder =="
tar -czf "/root/nginx_backup_${ts}.tgz" /etc/nginx >/dev/null 2>&1 || true
echo "[OK] /root/nginx_backup_${ts}.tgz"

echo
echo "== 5) Fix common broken lines everywhere =="
# try_files \ =404;  -> try_files $uri =404;
perl -pi -e 's/try_files\s*\\\s*=404;/try_files \$uri =404;/g' /etc/nginx/nginx.conf /etc/nginx/conf.d/*.conf /etc/nginx/sites-available/* /etc/nginx/sites-enabled/* 2>/dev/null || true
# try_files =404; -> try_files $uri =404;
perl -pi -e 's/try_files\s*=\s*=404;/try_files \$uri =404;/g' /etc/nginx/nginx.conf /etc/nginx/conf.d/*.conf /etc/nginx/sites-available/* /etc/nginx/sites-enabled/* 2>/dev/null || true
perl -pi -e 's/try_files\s+=404;/try_files \$uri =404;/g'      /etc/nginx/nginx.conf /etc/nginx/conf.d/*.conf /etc/nginx/sites-available/* /etc/nginx/sites-enabled/* 2>/dev/null || true

echo
echo "== 6) Re-test nginx =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
BASH

chmod +x /root/find_and_fix_all_broken_try_files.sh
/root/find_and_fix_all_broken_try_files.sh
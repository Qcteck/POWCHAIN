cat >/root/MEGA_AQUILA_STACKING_ROUTE_FIX_V2_DETECT.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027
TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing: $1"; }

[ "$(id -u)" -eq 0 ] || die "run as root"

need nginx
need perl
need systemctl
need grep
need awk
need sed

APP="/opt/aquila_stacking"
KEYS="${APP}/keys"
PROG="aquila_stacking"

INC="/etc/nginx/includes/aquila_stacking_routes.inc"
WEBROOT="/var/www/aquila_stacking"
HTML="${WEBROOT}/index.html"

BK="/root/AQUILA_STAKING_ROUTE_FIX_V2_BK_${TS}"
mkdir -p "$BK"

# --- backup loaded nginx config dump (for diagnosis) ---
nginx -T >"$BK/nginx.T.txt" 2>&1 || true

# --- webroot ---
say "1) WEBROOT: $WEBROOT"
mkdir -p "$WEBROOT"
chmod 0755 "$WEBROOT"

# --- program id (optional) ---
say "2) Program ID"
PID="UNKNOWN"
if command -v solana-keygen >/dev/null 2>&1 && [ -f "$KEYS/${PROG}-keypair.json" ]; then
  PID="$(solana-keygen pubkey "$KEYS/${PROG}-keypair.json" 2>/dev/null || echo UNKNOWN)"
fi

# --- index.html ---
say "3) index.html"
cat >"$HTML"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><style>body{font-family:system-ui,Segoe UI,Arial;margin:24px;max-width:980px}code{background:#0b1020;color:#d7e3ff;padding:10px;border-radius:10px;display:block;overflow:auto}h1{margin:0 0 12px}small{opacity:.8}</style></head><body><h1>AquilaStacking</h1><p><b>Program ID:</b><code>${PID}</code></p><p><b>Workspace:</b><code>${APP}</code></p><p><b>URL:</b><code>/aquila_stacking/</code></p><p><small>Redirect: /aquilastacking/ → /aquila_stacking/</small></p></body></html>
EOF
chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
chmod -R 0755 "$WEBROOT"

# --- include file with locations ---
say "4) nginx routes include: $INC"
cp -a "$INC" "$BK/aquila_stacking_routes.inc.bak" 2>/dev/null || true
chattr -i "$INC" 2>/dev/null || true
cat >"$INC"<<EOF
# AQUILA_STACKING_ROUTES_V2
location = /aquilastacking { return 301 /aquila_stacking/; }
location ^~ /aquilastacking/ { return 301 /aquila_stacking/; }
location = /aquila_stacking { return 301 /aquila_stacking/; }
location ^~ /aquila_stacking/ { alias ${WEBROOT}/; index index.html; try_files \$uri \$uri/ /aquila_stacking/index.html; add_header Cache-Control "no-store" always; }
# END_AQUILA_STACKING_ROUTES_V2
EOF

# --- find ACTIVE server blocks (fireinners.online) from nginx -T list of loaded files ---
say "5) detect active vhost file(s) serving fireinners.online"
mapfile -t FILES < <(awk '/^# configuration file /{print $4}' "$BK/nginx.T.txt" | sed 's/:$//' | sort -u)
[ "${#FILES[@]}" -gt 0 ] || die "cannot parse nginx -T files"

CAND="$BK/candidates.txt"
: >"$CAND"
for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  if grep -qE 'server_name[^;]*\bfireinners\.online\b' "$f"; then
    echo "$f" >>"$CAND"
  fi
done
[ -s "$CAND" ] || die "no loaded file contains server_name fireinners.online (check $BK/nginx.T.txt)"

say "candidates:"
nl -ba "$CAND" | sed 's/^/[C] /'

# --- patch: ensure include line INSIDE server blocks that match fireinners.online AND listen 443/80 ---
say "6) patch candidates: ensure include is inside matching server blocks (80+443)"
INCLUDE_LINE="include /etc/nginx/includes/aquila_stacking_routes.inc;"

patch_one(){
  local f="$1"
  cp -a "$f" "$BK/$(basename "$f").bak" 2>/dev/null || true
  chattr -i "$f" 2>/dev/null || true

  perl -0777 -pe '
    my $inc = q('"$INCLUDE_LINE"'\n);
    my $changed = 0;
    $_ =~ s{
      server\s*\{
      (.*?)
      \}
    }{
      my $blk = $&;
      my $body = $1;

      my $has_name = ($body =~ /server_name\s+[^;]*\bfireinners\.online\b[^;]*;/s) ? 1 : 0;
      my $has_listen80 = ($body =~ /listen\s+[^;]*\b80\b[^;]*;/s) ? 1 : 0;
      my $has_listen443 = ($body =~ /listen\s+[^;]*\b443\b[^;]*ssl[^;]*;/s || $body =~ /listen\s+[^;]*\b443\b[^;]*;/s) ? 1 : 0;

      if ($has_name && ($has_listen80 || $has_listen443)) {
        if ($body !~ /\Q'"$INCLUDE_LINE"'\E/s) {
          # insert right after server_name line (first occurrence)
          $blk =~ s/(server_name\s+[^;]*\bfireinners\.online\b[^;]*;\s*\n)/$1# AQUILA_STACKING_INCLUDE_V2\n$inc# END_AQUILA_STACKING_INCLUDE_V2\n/s;
          $changed = 1;
        }
      }
      $blk
    }gsex;

    END { }
  ' -i "$f"

  # If insertion failed because server_name line format differs, do a second deterministic fallback: insert before first location inside matching blocks
  if ! grep -qF "$INCLUDE_LINE" "$f"; then
    perl -0777 -pe '
      my $inc = q('"$INCLUDE_LINE"'\n);
      $_ =~ s{
        (server\s*\{)(.*?server_name\s+[^;]*\bfireinners\.online\b[^;]*;)(.*?)(\n\s*location\b)
      }{
        my ($a,$b,$c,$d)=($1,$2,$3,$4);
        if (($a.$b.$c) !~ /\Q'"$INCLUDE_LINE"'\E/s) {
          "$a$b$c\n  # AQUILA_STACKING_INCLUDE_V2\n  $inc  # END_AQUILA_STACKING_INCLUDE_V2\n$d"
        } else {
          "$a$b$c$d"
        }
      }gsex;
    ' -i "$f" || true
  fi
}

while read -r f; do
  say "patch: $f"
  patch_one "$f"
done <"$CAND"

# --- validate + reload (rollback if fail) ---
say "7) nginx -t + reload (rollback all candidate files if fail)"
if ! nginx -t; then
  say "nginx invalid -> rollback"
  while read -r f; do
    b="$BK/$(basename "$f").bak"
    [ -f "$b" ] && cp -a "$b" "$f" || true
  done <"$CAND"
  [ -f "$BK/aquila_stacking_routes.inc.bak" ] && cp -a "$BK/aquila_stacking_routes.inc.bak" "$INC" || true
  nginx -t || true
  die "rolled back (see $BK)"
fi
systemctl reload nginx

# --- local verify (no DNS dependency) ---
say "8) local verify (curl via --resolve)"
if command -v curl >/dev/null 2>&1; then
  set +e
  curl -skI --resolve fireinners.online:443:127.0.0.1 "https://fireinners.online/aquila_stacking/" | head -n 20
  curl -sk  --resolve fireinners.online:443:127.0.0.1 "https://fireinners.online/aquila_stacking/" | head -n 5
  set -e
fi

say "DONE"
say "URL: https://fireinners.online/aquila_stacking/"
say "BK: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_ROUTE_FIX_V2_DETECT.sh
bash /root/MEGA_AQUILA_STACKING_ROUTE_FIX_V2_DETECT.sh
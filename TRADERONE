async function getWeb3(){for(let i=0;i<120;i++){if(window.solanaWeb3&&window.solanaWeb3.Connection&&window.solanaWeb3.PublicKey)return window.solanaWeb3;await sleep(50);}return null;}
async function connectIfNeeded(){if(!window.solana)throw new Error("Phantom absent");if(window.solana.isConnected&&window.solana.publicKey)return window.solana.publicKey.toBase58();const r=await window.solana.connect();const pk=(r&&r.publicKey)?r.publicKey.toBase58():(window.solana.publicKey?window.solana.publicKey.toBase58():"");if(!pk)throw new Error("Connexion Phantom échouée");return pk;}
async function scanDeposit({asset,minAmount,fromPub,toPub}){const web3=await getWeb3();if(!web3)throw new Error("Libs Solana pas prêtes");let lastErr=null;for(const rpc of RPCS){try{const conn=new web3.Connection(rpc,"confirmed");const to=new web3.PublicKey(toPub);const sigs=await conn.getSignaturesForAddress(to,{limit:30},"confirmed");const minLamports=(asset==="SOL")?Math.round(Number(minAmount||0)*1e9):0;const minUsdc=(asset==="USDC")?Number(minAmount||0):0;for(const s of sigs){const sig=s.signature;const tx=await conn.getParsedTransaction(sig,{maxSupportedTransactionVersion:0,commitment:"confirmed"});if(!tx||!tx.transaction)continue;if(asset==="SOL"){const ins=tx.transaction.message.instructions||[];for(const i of ins){if(i&&i.program==="system"&&i.parsed&&i.parsed.type==="transfer"){const info=i.parsed.info||{};const src=String(info.source||"");const dst=String(info.destination||"");const lam=Number(info.lamports||0);if(dst===toPub&&lam>=minLamports){if(fromPub&&src!==fromPub)continue;return{ok:true,sig,rpc,kind:"SOL",lamports:lam};}}}}else{const pre=tx.meta&&tx.meta.preTokenBalances?tx.meta.preTokenBalances:[];const post=tx.meta&&tx.meta.postTokenBalances?tx.meta.postTokenBalances:[];const sumByOwnerMint=(arr,owner,mint)=>{let sum=0;for(const b of arr){if(String(b.owner||"")===owner&&String(b.mint||"")===mint){const ui=b.uiTokenAmount&&typeof b.uiTokenAmount.uiAmount==="number"?b.uiTokenAmount.uiAmount:0;sum+=Number(ui||0);}}return sum;};const preSum=sumByOwnerMint(pre,toPub,USDC_MINT);const postSum=sumByOwnerMint(post,toPub,USDC_MINT);const delta=postSum-preSum;if(delta>=minUsdc){return{ok:true,sig,rpc,kind:"USDC",delta};}}}return{ok:false,reason:"Aucune TX entrante trouvée (30 dernières)"};}catch(e){lastErr=e;}}throw new Error(lastErr&&(lastErr.message||String(lastErr))||"RPC error");}
function injectUI(){const startBtn=findBtnByText("start wolverine")||findBtnByText("start");if(!startBtn){logStatus("ERR: bouton START introuvable");return;}startBtn.style.display="none";const hostRow=startBtn.parentElement||document.body;const wrap=document.createElement("span");wrap.style.marginLeft="8px";wrap.style.display="inline-flex";wrap.style.gap="6px";wrap.style.alignItems="center";const assetSel=document.createElement("select");assetSel.id="wolvAsset";assetSel.innerHTML='<option value="SOL">SOL</option><option value="USDC">USDC</option>';const amt=document.createElement("input");amt.id="wolvAmt";amt.placeholder="Budget";amt.style.width="90px";const existingBudget=$$("input").find(x=>{const ph=(x.placeholder||"").toLowerCase();const nm=(x.name||"").toLowerCase();const id=(x.id||"").toLowerCase();return ph.includes("budget")||nm.includes("budget")||id.includes("budget");});if(existingBudget){amt.value=existingBudget.value||"";amt.addEventListener("input",()=>{existingBudget.value=amt.value;});existingBudget.addEventListener("input",()=>{amt.value=existingBudget.value;});}
const confirmBtn=document.createElement("button");confirmBtn.id="wolvConfirmDeposit";confirmBtn.textContent="CONFIRMER DEPOT (ONCHAIN)";const info=document.createElement("span");info.id="wolvInfo";info.style.fontSize="12px";
wrap.appendChild(document.createTextNode("Asset:"));wrap.appendChild(assetSel);wrap.appendChild(amt);wrap.appendChild(confirmBtn);wrap.appendChild(info);hostRow.appendChild(wrap);
const LS_KEY="WOLV_DEPOSIT_OK_V1";const stored=(()=>{try{return JSON.parse(localStorage.getItem(LS_KEY)||"null");}catch(_){return null;}})();if(stored&&stored.ok&&stored.to===parseTraderOneFromDOM()){info.textContent="Depot déjà confirmé: "+stored.asset+" "+stored.amount+" (sig "+String(stored.sig||"").slice(0,10)+"...)";startBtn.style.display="";}
confirmBtn.addEventListener("click",async()=>{try{info.textContent="";logStatus("Dépôt: scan on-chain...");const userPk=await connectIfNeeded();const toPk=parseTraderOneFromDOM();const asset=assetSel.value;const amount=Number((amt.value||"").trim());if(!amount||amount<=0)throw new Error("Montant budget invalide");const r=await scanDeposit({asset,minAmount:amount,fromPub:userPk,toPub:toPk});if(!r.ok)throw new Error(r.reason||"Depot non trouvé");localStorage.setItem(LS_KEY,JSON.stringify({ok:true,ts:Date.now(),asset,amount,sig:r.sig,to:toPk,from:userPk,rpc:r.rpc}));info.textContent="DEPOT OK: "+asset+" "+amount+" (sig "+String(r.sig).slice(0,12)+"...)";logStatus("DEPOT OK. START activé.");startBtn.style.display="";}catch(e){const m=e&&(e.message||String(e))||"ERR";info.textContent="ERR: "+m;logStatus("ERR dépôt: "+m);}});
startBtn.addEventListener("click",async()=>{try{const st=(()=>{try{return JSON.parse(localStorage.getItem(LS_KEY)||"null");}catch(_){return null;}})();if(!st||!st.ok)throw new Error("Depot non confirmé");logStatus("START: appel API /api/start ...");const res=await fetch("/api/start",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({from:st.from,to:st.to,asset:st.asset,budget:st.amount,depositSig:st.sig})});const txt=await res.text();if(!res.ok)throw new Error("API start: "+txt);logStatus("START OK: "+txt);}catch(e){logStatus("ERR START: "+(e&&(e.message||String(e))||"ERR"));}},true);
logStatus("Patch dépôt manuel chargé. 1) Send dans Phantom vers TraderOne 2) CONFIRMER DEPOT 3) START.");
}

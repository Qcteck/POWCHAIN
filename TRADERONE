cat >/root/TRADERONE_CONNECT_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

### VARS
API_PORT=3000
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
API_DIR="/opt/wolverine/api"

echo "== 1) Vérification TraderOne backend =="

if ! ss -lnt | grep -q ":$API_PORT"; then
  echo "Backend TraderOne non lancé → démarrage"
  cd "$API_DIR"
  nohup node server.js >/var/log/traderone.log 2>&1 &
  sleep 2
fi

ss -lnt | grep ":$API_PORT" || { echo "❌ TraderOne backend KO"; exit 1; }
echo "✅ TraderOne backend OK sur 127.0.0.1:$API_PORT"

echo "== 2) Patch NGINX proxy /wolverine/api =="

grep -q "location /wolverine/api" "$NGINX_SITE" || cat >>"$NGINX_SITE" <<'NGINX'

location /wolverine/api/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
}
NGINX

nginx -t
systemctl reload nginx

echo "== 3) Patch frontend (fetch API correct) =="

HTML="/var/www/wolverine/index.html"

sed -i \
  -e 's|http://127.0.0.1:3000|/wolverine/api|g' \
  "$HTML"

echo "== 4) Résumé =="
echo "Frontend : https://fireinners.online/wolverine"
echo "API      : https://fireinners.online/wolverine/api"
echo "Logs     : /var/log/traderone.log"
echo "=============================="
echo "✅ TRADERONE CONNECTÉ CORRECTEMENT"
BASH

chmod +x /root/TRADERONE_CONNECT_FIX.sh
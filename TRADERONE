function bindNav(){
  $$("#wolvSidebar .wolvNavBtn[data-nav]").forEach(btn=>{
    btn.addEventListener("click", ()=>{
      $$("#wolvSidebar .wolvNavBtn").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");

      const nav = btn.getAttribute("data-nav");
      // mapping vers ton app existante si des boutons existent déjà
      const map = {
        dashboard: ["dashboard"],
        trade: ["trade"],
        positions: ["positions"],
        orders: ["orders"],
        history: ["history"],
        wallet: ["wallet"],
        settings: ["settings"]
      };
      const ok = clickExisting(map[nav] || [nav]);
      setStatus(ok ? `NAV: ${nav} (clicked existing)` : `NAV: ${nav} (no existing button found)`);
    });
  });
}

function bindActions(){
  $("#wolvBtnConnect")?.addEventListener("click", ()=>{
    const ok = clickExisting(["connect", "connect wallet", "phantom"]);
    setStatus(ok ? "Connect: clicked existing" : "Connect: no existing button found");
  });

  $("#wolvBtnConfirm")?.addEventListener("click", ()=>{
    const ok = clickExisting(["confirmer depot", "confirmer dépôt", "verify deposit", "verifier depot", "onchain"]);
    setStatus(ok ? "Deposit confirm: clicked existing" : "Deposit confirm: no existing button found");
  });

  $("#wolvBtnStart")?.addEventListener("click", async()=>{
    // 1) essaie de cliquer un bouton existant
    if(clickExisting(["start wolverine", "start wolv", "start"])) {
      setStatus("Start: clicked existing");
      return;
    }
    // 2) fallback: appelle /api/start si dispo
    try{
      setStatus("Start: calling /api/start ...");
      const r = await fetch("/api/start",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({source:"terminal_ui"})});
      const t = await r.text();
      if(!r.ok) throw new Error(t || r.status);
      setStatus("Start OK: "+t);
    }catch(e){
      setStatus("Start ERR: "+(e?.message||String(e)));
    }
  });

  $("#wolvApplyMode")?.addEventListener("click", async()=>{
    const mode = $("#wolvMode")?.value || "NORMAL";
    // 1) essaie bouton existant
    if(clickExisting(["mode", "apply mode"])) { setStatus("Mode: clicked existing"); return; }
    // 2) endpoint
    try{
      setStatus("Mode: POST /api/traderone/mode ...");
      const r = await fetch("/api/traderone/mode",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({mode})});
      const t = await r.text();
      if(!r.ok) throw new Error(t || r.status);
      setStatus("Mode OK: "+t);
    }catch(e){
      setStatus("Mode ERR: "+(e?.message||String(e)));
    }
  });

  $("#wolvWithdraw")?.addEventListener("click", async()=>{
    const asset = $("#wolvWdAsset")?.value || "SOL";
    const amount = Number(($("#wolvWdAmt")?.value||"").replace(",",".")) || 0;
    const to = ($("#wolvWdTo")?.value||"").trim();
    if(!to || !(amount>0)){ setStatus("Withdraw ERR: amount/to"); return; }

    // 1) essaie bouton existant
    if(clickExisting(["withdraw","retrait"])) { setStatus("Withdraw: clicked existing"); return; }

    // 2) endpoint
    try{
      setStatus("Withdraw: POST /api/traderone/withdraw ...");
      const r = await fetch("/api/traderone/withdraw",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({asset,amount,to})});
      const t = await r.text();
      if(!r.ok) throw new Error(t || r.status);
      setStatus("Withdraw OK: "+t);
    }catch(e){
      setStatus("Withdraw ERR: "+(e?.message||String(e)));
    }
  });

  // Trading buttons (buy/sell): mapping vers ton app si boutons existent
  $("#wolvBuy")?.addEventListener("click", ()=>{
    const ok = clickExisting(["buy","achat","long"]);
    setStatus(ok ? "BUY: clicked existing" : "BUY: no existing button found (à brancher API order)");
  });
  $("#wolvSell")?.addEventListener("click", ()=>{
    const ok = clickExisting(["sell","vente","short"]);
    setStatus(ok ? "SELL: clicked existing" : "SELL: no existing button found (à brancher API order)");
  });
  $("#wolvReset")?.addEventListener("click", ()=>{
    ["#wolvPrice","#wolvSize","#wolvSL","#wolvTP","#wolvWdAmt","#wolvWdTo"].forEach(sel=>{
      const el=$(sel); if(el) el.value="";
    });
    setStatus("Reset OK");
  });
  $("#wolvCancel")?.addEventListener("click", ()=>{
    const ok = clickExisting(["cancel","annuler","close"]);
    setStatus(ok ? "Cancel: clicked existing" : "Cancel: no existing button found");
  });
}

function hideShareHard(){
  // Cacher toute UI de partage qui traîne (sans casser)
  const kill=()=>{
    for(const el of $$("button,a,[role='button'],div,section,dialog")){
      const t = norm(el.textContent);
      const id = norm(el.id);
      const cls = norm(el.className);
      if(t==="partager" || t.includes("share") || t.includes("partager") || id.includes("share") || cls.includes("share")){
        el.style.display="none";
        el.style.pointerEvents="none";
      }
      // popup typique
      if(t.includes("facebook") && (t.includes("telegram")||t.includes("whatsapp")) && (t.includes("copier")||t.includes("copy"))){
        el.style.display="none";
        if(el.parentElement) el.parentElement.style.display="none";
      }
    }
  };
  kill();
  new MutationObserver(kill).observe(document.documentElement,{childList:true,subtree:true});
}

function boot(){
  ensureRoot();
  bindNav();
  bindActions();
  hideShareHard();
  setStatus("Terminal UI loaded. Les boutons de la photo sont ajoutés + mapping vers tes boutons existants.");
}

if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", boot);
else boot();
})();

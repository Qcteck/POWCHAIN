cat >/root/MEGA_FIX_WOLVERINE_403.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

VHOST_AV="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
NGINX_CONF="/etc/nginx/nginx.conf"

echo "=== MEGA_FIX_WOLVERINE_403 ($TS) ==="
echo "But: enlever le blocage Nginx (allow 127.0.0.1 / deny all) qui cause 403 sur /wolverine/"
echo

need_root(){ [ "$(id -u)" -eq 0 ] || { echo "[ERREUR] Lance en root."; exit 1; }; }
need_root

exists_or_die(){ [ -f "$1" ] || { echo "[ERREUR] Fichier introuvable: $1"; exit 1; }; }

exists_or_die "$VHOST_AV"
exists_or_die "$INC"

# Déverrouille si immutable
unlock_if_immutable(){
  local f="$1"
  if lsattr -a "$f" 2>/dev/null | grep -q '^-..i'; then
    echo "[INFO] chattr -i $f"
    chattr -i "$f" || true
  fi
}

lock_immutable(){
  local f="$1"
  echo "[INFO] chattr +i $f"
  chattr +i "$f" || true
}

backup_file(){
  local f="$1"
  cp -a "$f" "${f}.bak_${TS}"
  echo "[OK] Backup: ${f}.bak_${TS}"
}

echo "== 1) Backup + unlock =="
unlock_if_immutable "$NGINX_CONF"
unlock_if_immutable "$VHOST_AV"
unlock_if_immutable "$INC"

backup_file "$NGINX_CONF"
backup_file "$VHOST_AV"
backup_file "$INC"
echo

echo "== 2) Patch include wolverine_routes.inc (neutralise allow/deny globaux) =="
# Objectif: commenter toute paire allow 127.0.0.1; / deny all; qui bloque le contenu statique.
# On garde le fichier valide: on commente les lignes plutôt que les supprimer.
python3 - <<PY
from pathlib import Path
p=Path("$INC")
s=p.read_text(errors="ignore").splitlines()

out=[]
changed=False
for line in s:
    raw=line.rstrip("\n")
    strip=raw.strip()
    if strip == "allow 127.0.0.1;" or strip == "deny all;":
        # commenter (idempotent)
        if not strip.startswith("#"):
            out.append("# FIX403_DISABLED " + strip)
            changed=True
        else:
            out.append(raw)
    else:
        out.append(raw)

if changed:
    p.write_text("\n".join(out).rstrip()+"\n")
    print("PATCH: lignes allow/deny neutralisées dans", p)
else:
    print("OK: aucun allow/deny à neutraliser (ou déjà patché) dans", p)
PY
echo

echo "== 3) Sanity: vhost doit inclure l'include wolverine_routes.inc =="
# Vérifie qu'on a bien l'include (sinon on l'ajoute juste une fois à l'intérieur du server {})
if ! grep -qE 'include\s+/etc/nginx/includes/wolverine_routes\.inc;' "$VHOST_AV"; then
  echo "[WARN] include manquant dans $VHOST_AV -> injection (une seule fois) après bloc /wolverine/"
  # Ajoute juste avant la fin du server block (avant un "}" final)
  python3 - <<PY
from pathlib import Path
p=Path("$VHOST_AV")
s=p.read_text(errors="ignore").splitlines()
# insère avant le dernier "}"
idx=None
for i in range(len(s)-1, -1, -1):
    if s[i].strip()=="}":
        idx=i; break
if idx is None:
    raise SystemExit("ERREUR: pas de } final, vhost inattendu")
ins='  include /etc/nginx/includes/wolverine_routes.inc;'
if ins not in s:
    s.insert(idx, ins)
p.write_text("\n".join(s).rstrip()+"\n")
print("OK: include ajouté")
PY
else
  echo "[OK] include déjà présent"
fi
echo

echo "== 4) Test + reload nginx =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reload"
echo

echo "== 5) Tests HTTP (origin) =="
echo "--- curl -I https://127.0.0.1/wolverine/index.html (header server) ---"
curl -k -I https://127.0.0.1/wolverine/index.html | sed -n '1,20p' || true
echo
echo "--- curl -I https://127.0.0.1/wolverine/ (doit 301 -> index.html) ---"
curl -k -I https://127.0.0.1/wolverine/ | sed -n '1,20p' || true
echo

echo "== 6) Re-lock immutable (nginx.conf + vhost) =="
lock_immutable "$NGINX_CONF"
lock_immutable "$VHOST_AV"
# include peut rester modifiable; si tu veux le geler aussi, décommente:
# lock_immutable "$INC"

echo
echo "=== DONE. Si tu as encore 403 via Cloudflare: purge cache CF + hard refresh navigateur. ==="
BASH

chmod +x /root/MEGA_FIX_WOLVERINE_403.sh
bash /root/MEGA_FIX_WOLVERINE_403.sh
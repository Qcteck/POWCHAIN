set -euo pipefail

BASE="/var/www/fireinners/wolverine"
HTML="$BASE/index.html"
APPJS="$BASE/app.js"
VENDOR="$BASE/vendor"
SERVER="/opt/traderone-opt/server.js"
SVC="traderone.service"

echo "== Derniers backups trouvés =="
ls -1t "$HTML".bak.* 2>/dev/null | head -n 5 || true
ls -1t "$APPJS".bak.* 2>/dev/null | head -n 5 || true
ls -1t "$SERVER".bak.* 2>/dev/null | head -n 5 || true

# prend le plus récent backup pour chaque fichier
HTML_BAK="$(ls -1t "$HTML".bak.* 2>/dev/null | head -n 1 || true)"
APP_BAK="$(ls -1t "$APPJS".bak.* 2>/dev/null | head -n 1 || true)"
SRV_BAK="$(ls -1t "$SERVER".bak.* 2>/dev/null | head -n 1 || true)"

[ -n "${HTML_BAK:-}" ] && cp -a "$HTML_BAK" "$HTML"
[ -n "${APP_BAK:-}" ]  && cp -a "$APP_BAK"  "$APPJS"
[ -n "${SRV_BAK:-}" ]  && cp -a "$SRV_BAK"  "$SERVER"

# reload services
nginx -t && systemctl reload nginx
systemctl restart "$SVC"

echo
echo "RESTORE OK ✅"
echo "Restored:"
echo " - $HTML_BAK -> $HTML"
echo " - $APP_BAK  -> $APPJS"
echo " - $SRV_BAK  -> $SERVER"
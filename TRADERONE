cat >/root/WOLVERINE_FRONT_SOL_RESTORE.sh <<'BASH'
#!/usr/bin/env bash
set -e

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE FRONT SOL RESTORE ==="

# 1) Backup actuel
cp -a "$HTML" "${HTML}.broken_${TS}"
echo "✔ Backup créé : ${HTML}.broken_${TS}"

# 2) Écriture frontend SAIN
cat >"$HTML" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>WOLVERINE — SOL CHECK</title>
<script src="/wolverine/vendor/solana-web3.min.js"></script>
<style>
body{background:#0b0f14;color:#e6e6e6;font-family:Arial;padding:40px}
.box{border:1px solid #00ff88;padding:20px;width:320px}
button{width:100%;padding:10px;margin-top:10px;background:#00ff88;border:0;font-weight:bold;cursor:pointer}
</style>
</head>
<body>

<div class="box">
  <button onclick="connect()">Connect Wallet</button>
  <button onclick="refresh()">Refresh</button>
  <p>Address: <span id="addr">-</span></p>
  <p>SOL: <span id="sol">-</span></p>
</div>

<script>
let pubkey=null;
const conn=new solanaWeb3.Connection("https://api.mainnet-beta.solana.com");

async function connect(){
  if(!window.solana){alert("Phantom absent");return;}
  const r=await window.solana.connect();
  pubkey=r.publicKey.toString();
  document.getElementById("addr").textContent=pubkey;
  refresh();
}

async function refresh(){
  if(!pubkey)return;
  const lamports=await conn.getBalance(new solanaWeb3.PublicKey(pubkey));
  document.getElementById("sol").textContent=(lamports/1e9).toFixed(6);
}
</script>

</body>
</html>
HTML

# 3) Reload nginx
nginx -t && systemctl reload nginx

echo "✅ FRONTEND SOL RESTORED"
echo "👉 Recharge avec CTRL + SHIFT + R"
BASH

chmod +x /root/WOLVERINE_FRONT_SOL_RESTORE.sh
/root/WOLVERINE_FRONT_SOL_RESTORE.sh
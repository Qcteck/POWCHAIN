set -e

# 1) Liste les fichiers nginx actifs pour fireinners
ls -la /etc/nginx/sites-enabled | grep -i fireinners || true

# 2) Backup
for f in /etc/nginx/sites-enabled/*fireinners*; do
  [ -f "$f" ] && cp -v "$f" "$f.bak.$(date +%Y%m%d_%H%M%S)"
done

# 3) Remplace partout 3000 -> 12703 (souvent le 443 pointe encore sur 3000)
grep -RIl "127\.0\.0\.1:3000" /etc/nginx/sites-enabled | while read -r f; do
  sed -i 's/127\.0\.0\.1:3000/127.0.0.1:12703/g' "$f"
done

# 4) Reload
nginx -t
systemctl reload nginx

# 5) Test HTTPS avec SNI (pas l'IP directe)
IP=72.61.79.12
curl -i --resolve fireinners.online:443:$IP https://fireinners.online/wolverine/traderone/api/ -X OPTIONS | head -n 20
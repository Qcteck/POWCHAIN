cat > /root/WOLVERINE_FORCE_SINGLE_SSL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS=$(date +%Y%m%d_%H%M%S)
LOG="/root/WOLVERINE_FORCE_SSL_$TS.log"
OFFICIAL="/etc/nginx/sites-available/fireinners.online-ssl"

echo "=== WOLVERINE FORCE SINGLE SSL ===" | tee -a "$LOG"

echo "[1/5] Liste de TOUS les fichiers nginx chargés" | tee -a "$LOG"
FILES=$(grep -R "listen 443" /etc/nginx --include="*.conf" | cut -d: -f1 | sort -u)
echo "$FILES" | tee -a "$LOG"

echo "[2/5] Neutralisation globale sauf vhost officiel" | tee -a "$LOG"
for f in $FILES; do
  if [[ "$f" != "$OFFICIAL" ]]; then
    echo "⛔ Neutralisation $f" | tee -a "$LOG"
    cp -a "$f" "$f.bak_force_$TS"
    sed -i 's/^\([[:space:]]*listen[[:space:]]\+443\)/# \1/g' "$f"
    sed -i 's/^\([[:space:]]*server_name[[:space:]]\)/# \1/g' "$f"
  else
    echo "✅ Conservé $f" | tee -a "$LOG"
  fi
done

echo "[3/5] Test nginx" | tee -a "$LOG"
nginx -t | tee -a "$LOG"

echo "[4/5] Reload nginx" | tee -a "$LOG"
systemctl reload nginx
sleep 2

echo "[5/5] Vérification warnings" | tee -a "$LOG"
journalctl -u nginx -n 30 | tee -a "$LOG"

echo
echo "=== TERMINÉ ==="
echo "ACTION : CTRL + SHIFT + R navigateur"
echo "LOG : $LOG"
BASH

chmod +x /root/WOLVERINE_FORCE_SINGLE_SSL.sh
/root/WOLVERINE_FORCE_SINGLE_SSL.sh
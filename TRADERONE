cat >/root/FIX_WOLVERINE_SOLANA.sh <<'BASH'
#!/usr/bin/env bash
set -e

BASE="/opt/fireinners/frontend-react/app/dist/wolverine"
HTML="$BASE/index.html"
TS=$(date +%Y%m%d_%H%M%S)

echo "=== FIX WOLVERINE SOLANA ==="

# 1. Sécurité
[ -f "$HTML" ] || { echo "index.html introuvable"; exit 1; }
cp "$HTML" "$HTML.bak_$TS"

# 2. Supprimer TOUS les anciens scripts solana / phantom
sed -i '/solana-web3/d' "$HTML"
sed -i '/Phantom/d' "$HTML"
sed -i '/Connect Phantom/d' "$HTML"

# 3. Injecter UN SEUL bloc Phantom + SOL propre
sed -i '/<\/body>/i \
<script src="/wolverine/vendor/solana-web3.min.js"></script>\n\
<script>\n\
let connection=null,provider=null;\n\
const RPC=\"https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac\";\n\
async function connectPhantom(){\n\
 if(!window.solana||!window.solana.isPhantom){alert(\"Phantom manquant\");return;}\n\
 provider=window.solana;\n\
 const res=await provider.connect();\n\
 document.getElementById(\"addr\").innerText=res.publicKey.toString();\n\
 connection=new solanaWeb3.Connection(RPC,\"confirmed\");\n\
 refreshSol();\n\
}\n\
async function refreshSol(){\n\
 const bal=await connection.getBalance(provider.publicKey);\n\
 document.getElementById(\"sol\").innerText=(bal/1e9).toFixed(4);\n\
}\n\
</script>' "$HTML"

# 4. Injecter UI minimale si absente
grep -q 'id="addr"' "$HTML" || sed -i '/<body>/a \
<div style="border:1px solid #888;padding:10px;width:420px">\n\
<button onclick="connectPhantom()">Connect Phantom</button><br>\n\
Adresse: <span id="addr">-</span><br>\n\
SOL: <span id="sol">-</span>\n\
</div>' "$HTML"

# 5. Reload nginx
nginx -t && systemctl reload nginx

echo "=== FIX TERMINÉ ==="
BASH

chmod +x /root/FIX_WOLVERINE_SOLANA.sh
/root/FIX_WOLVERINE_SOLANA.sh
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AIAQUILA_BK_${TS}"
DOMAIN="fireinners.online"
SLUG="/aiaquila"
WEB="/var/www/aiaquila"

<script src="https://unpkg.com/bs58@5.0.0/dist/bs58.min.js"></script>
<script>
(()=>{const BASE="/wolverine/api";const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const $=s=>document.querySelector(s);
const log=(m,c)=>{const el=$("#console");const t=new Date().toISOString();el.textContent+=(t+" "+m+"\\n");if(c)el.lastChild;el.scrollTop=el.scrollHeight;};
let err=0,autoT=null,provider=null,pub=null,session=localStorage.getItem("WOLV_SESS")||"";
const i18n={en:{t_control:"Control",t_wallet:"Wallet (Phantom)",t_custody:"Custody (TraderOne)",t_addr:"Address"},fr:{t_control:"Contrôle",t_wallet:"Wallet (Phantom)",t_custody:"Garde (TraderOne)",t_addr:"Adresse"}};
let lang=(localStorage.getItem("WOLV_LANG")||"en");const applyLang=()=>{const L=i18n[lang]||i18n.en;$("#t_control").textContent=L.t_control;$("#t_wallet").textContent=L.t_wallet;$("#t_custody").textContent=L.t_custody;$("#t_addr").textContent=L.t_addr;$("#langBtn").textContent=lang.toUpperCase();};
$("#langBtn").onclick=()=>{lang=(lang==="en"?"fr":"en");localStorage.setItem("WOLV_LANG",lang);applyLang();};applyLang();
const api=(p,o={})=>fetch(BASE+p,{...o,headers:{...(o.headers||{}),"cache-control":"no-cache","pragma":"no-cache"}});

const setApiState=(ok)=>{$("#apiState").textContent=ok?"OK":"OFF";$("#apiState").className=ok?"ok":"bad";};
const setSess=()=>{$("#sessState").textContent=session?("ok"):"none";};
setSess();

async function ping(){try{const r=await api("/ping?ts="+Date.now());const t=await r.text();setApiState(r.ok&&/pong/i.test(t));log("PING "+(r.ok?t:"ERR"),r.ok);return r.ok;}catch(e){setApiState(false);err++;$("#errCnt").textContent=err;log("PING ERR "+e.message,true);return false;}}
async function loadCustody(){try{const r=await api("/wallet?ts="+Date.now());const j=await r.json();if(j&&j.pub)$("#custodyPub").value=j.pub;log("CUSTODY "+(j.pub||"?"));}catch(e){err++;$("#errCnt").textContent=err;log("CUSTODY ERR "+e.message,true);}}
async function status(){try{const r=await api("/status?ts="+Date.now());const j=await r.json();if(j&&j.ok){$("#solCust").textContent=String(j.custody.sol);$("#usdcCust").textContent=String(j.custody.usdc);}log("STATUS "+(j.ok?"OK":"ERR"));}catch(e){err++;$("#errCnt").textContent=err;log("STATUS ERR "+e.message,true);}}
async function config(){try{const r=await api("/config?ts="+Date.now());const j=await r.json();log("CONFIG "+JSON.stringify(j).slice(0,220));}catch(e){err++;$("#errCnt").textContent=err;log("CONFIG ERR "+e.message,true);}}

async function refresh(){await ping();await loadCustody();await status();$("#lastRef").textContent=new Date().toLocaleTimeString();}
$("#refreshBtn").onclick=refresh;$("#pingBtn").onclick=ping;$("#cfgBtn").onclick=config;$("#statBtn").onclick=status;

function getPhantom(){return window.solana&&window.solana.isPhantom?window.solana:null;}
$("#connectBtn").onclick=async()=>{try{provider=getPhantom();if(!provider)return log("Phantom not found",true);const r=await provider.connect();pub=(r.publicKey||provider.publicKey).toString();$("#userPub").textContent=pub;log("PHANTOM CONNECT "+pub);}catch(e){log("CONNECT ERR "+e.message,true);}};
$("#disconnectBtn").onclick=async()=>{try{provider=getPhantom();if(provider&&provider.disconnect)await provider.disconnect();pub=null;$("#userPub").textContent="not connected";session="";localStorage.removeItem("WOLV_SESS");setSess();log("PHANTOM DISCONNECT");}catch(e){log("DISCONNECT ERR "+e.message,true);}};

$("#authBtn").onclick=async()=>{try{
  provider=getPhantom();if(!provider||!provider.publicKey)return log("connect Phantom first",true);
  pub=provider.publicKey.toString();$("#userPub").textContent=pub;
  const cj=await (await api("/auth/challenge",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({pub})})).json();
  if(!cj.ok) return log("CHALLENGE ERR",true);
  const msg=new TextEncoder().encode(cj.challenge);
  const signed=await provider.signMessage(msg,"utf8");
  const sigB58=bs58.encode(signed.signature);
  const vj=await (await api("/auth/verify",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({pub,signature:sigB58,challenge:cj.challenge})})).json();
  if(!vj.ok) return log("AUTH ERR "+(vj.error||""),true);
  session=vj.token;localStorage.setItem("WOLV_SESS",session);setSess();log("AUTH OK");
}catch(e){log("AUTH ERR "+e.message,true);}};
function sessFetch(path,opt){opt=opt||{};opt.headers={...(opt.headers||{}),"x-session":session};return api(path,opt);}

$("#saveBtn").onclick=async()=>{try{
  if(!session) return log("no session",true);
  const budget=Number($("#budget").value||0);const mode=$("#mode").value;const mint=$("#mint").value.trim();
  const j=await (await sessFetch("/session/set",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({budgetUsdc:budget,mode,mint})})).json();
  log("SESSION SET "+(j.ok?"OK":"ERR "+(j.error||"")));
}catch(e){log("SESSION SET ERR "+e.message,true);}};

$("#buyBtn").onclick=async()=>{try{
  if(!session) return log("no session",true);
  const budget=Number($("#budget").value||0);const mint=$("#mint").value.trim();
  const j=await (await sessFetch("/trade/buy",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({budgetUsdc:budget,mint})})).json();
  log("BUY "+(j.ok?("OK sig="+(j.tx&&j.tx.sig||"?")):("ERR "+(j.error||""))));
  await status();
}catch(e){log("BUY ERR "+e.message,true);}};

$("#loopStartBtn").onclick=async()=>{try{if(!session)return log("no session",true);
  const j=await (await sessFetch("/loop/start",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({sec:10})})).json();
  log("LOOP START "+(j.ok?"OK":"ERR"));
}catch(e){log("LOOP START ERR "+e.message,true);}};

$("#loopStopBtn").onclick=async()=>{try{if(!session)return log("no session",true);
  const j=await (await sessFetch("/loop/stop",{method:"POST"})).json();
  log("LOOP STOP "+(j.ok?"OK":"ERR"));
}catch(e){log("LOOP STOP ERR "+e.message,true);}};

const setAuto=()=>{if(autoT){clearInterval(autoT);autoT=null;}
  if($("#auto").checked) autoT=setInterval(()=>refresh().catch(()=>{}),5000);
};
$("#auto").onchange=setAuto;setAuto();
refresh();
})();
</script></body></html>

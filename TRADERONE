<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>IconSmash Bonus Précis</title>
<style>
body{
  margin:0;
  font-family:Arial;
  background:#1e293b;
  color:#fff;
  display:flex;
  flex-direction:column;
  align-items:center;
}
#ui{
  display:flex;
  gap:15px;
  margin:10px;
  font-size:18px;
}
#time{transition:all 0.3s ease;}
#grid{
  display:grid;
  grid-template-columns:repeat(12,1fr);
  gap:4px;
  width:480px;
  height:480px;
}
.tile{
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
  border-radius:8px;
  cursor:pointer;
  transition:transform .2s ease, background .3s ease;
  position:relative;
}
.tile:active{transform:scale(.9)}
.comboText{
  position:absolute;
  font-size:16px;
  font-weight:bold;
  color:#ffff00;
  animation:floatUp 0.8s ease-out forwards;
}
@keyframes floatUp{
  0%{opacity:1; transform:translateY(0);}
  100%{opacity:0; transform:translateY(-25px);}
}
</style>
</head>
<body>
<h2>IconSmash Bonus Simple</h2>
<div id="ui">
  <div>Niveau: <span id="level">1</span></div>
  <div>Score: <span id="score">0</span></div>
  <div>Temps: <span id="time">60</span></div>
  <div>Bonus actif: <span id="bonusCount">0</span></div>
</div>
<div id="grid"></div>

<script>
const SIZE=12;
const icons=["🍓","🍋","🍏","🍇","🍒","🍊"];
const colors=["#fb7185","#fde047","#86efac","#c084fc","#f87171","#fdba74"];

let grid=[];
let score=0;
let level=1;
let time=60;
let combosDone=0;

let bonusActive=0; // compteur des prochains combos qui feront exploser les voisins

const gridEl=document.getElementById("grid");
const scoreEl=document.getElementById("score");
const timeEl=document.getElementById("time");
const levelEl=document.getElementById("level");
const bonusEl=document.getElementById("bonusCount");

const audioCtx=new (window.AudioContext||window.webkitAudioContext)();

function playSound(len){
  const o=audioCtx.createOscillator();
  const g=audioCtx.createGain();
  o.frequency.value=300+len*120;
  g.gain.value=0.05;
  o.connect(g); g.connect(audioCtx.destination);
  o.start();
  o.stop(audioCtx.currentTime+0.15+len*0.05);
}

function randomBG(){
  document.body.style.background=colors[Math.floor(Math.random()*colors.length)];
}

function syncEmpty(){
  grid.forEach(t=>{
    if(t.textContent==="") t.style.background=document.body.style.background;
  });
}
setInterval(syncEmpty,200);

function createGrid(){
  gridEl.innerHTML="";
  grid=[];
  for(let i=0;i<SIZE*SIZE;i++){
    const d=document.createElement("div");
    d.className="tile";
    const r=Math.floor(Math.random()*icons.length);
    d.textContent=icons[r];
    d.style.background=colors[r];
    d.onclick=()=>select(d);
    grid.push(d);
    gridEl.appendChild(d);
  }
}

let selected=null;
function select(t){
  if(!selected){selected=t; return;}
  swap(selected,t);
  selected=null;
}

function swap(a,b){
  [a.textContent,b.textContent]=[b.textContent,a.textContent];
  [a.style.background,b.style.background]=[b.style.background,a.style.background];
  clearMatches();
}

// récupère voisins adjacents (haut, bas, gauche, droite)
function getNeighbors(index){
  const neighbors=[];
  const x=index%SIZE;
  const y=Math.floor(index/SIZE);
  if(x>0) neighbors.push(index-1);
  if(x<SIZE-1) neighbors.push(index+1);
  if(y>0) neighbors.push(index-SIZE);
  if(y<SIZE-1) neighbors.push(index+SIZE);
  return neighbors;
}

function clearMatches(){
  let toClear=new Set();

  // horizontal
  for(let y=0;y<SIZE;y++){
    let run=1;
    for(let x=1;x<=SIZE;x++){
      const i=y*SIZE+x;
      const p=y*SIZE+x-1;
      if(x<SIZE && grid[i].textContent===grid[p].textContent && grid[i].textContent!==""){
        run++;
      } else {
        if(run>=3){
          const comboIndices=[];
          for(let k=0;k<run;k++){
            toClear.add(p-k);
            comboIndices.push(p-k);
          }
          handleCombo(run, comboIndices);
        }
        run=1;
      }
    }
  }

  // vertical
  for(let x=0;x<SIZE;x++){
    let run=1;
    for(let y=1;y<=SIZE;y++){
      const i=y*SIZE+x;
      const p=(y-1)*SIZE+x;
      if(y<SIZE && grid[i].textContent===grid[p].textContent && grid[i].textContent!==""){
        run++;
      } else {
        if(run>=3){
          const comboIndices=[];
          for(let k=0;k<run;k++){
            toClear.add(p-k*SIZE);
            comboIndices.push(p-k*SIZE);
          }
          handleCombo(run, comboIndices);
        }
        run=1;
      }
    }
  }

  if(toClear.size){
    toClear.forEach(i=>{
      grid[i].textContent="";
      grid[i].style.background=document.body.style.background;
    });
    gravity();
  }
}

function handleCombo(len, indices){
  score+=len*len*10;
  scoreEl.textContent=score;
  time+=Math.max(1,len-2);
  playSound(len);
  combosDone++;

  // texte flottant
  indices.forEach(i=>{
    const txt=document.createElement("div");
    txt.className="comboText";
    txt.textContent="+ "+(len*10);
    grid[i].appendChild(txt);
    setTimeout(()=>txt.remove(),800);
  });

  // déclenche bonus mode si combo de 3
  if(len===3){
    bonusActive=3; // les 3 prochains combos
    bonusEl.textContent=bonusActive;
  }

  // si bonus actif, explose voisins avec même icône
  if(bonusActive>0){
    indices.forEach(i=>{
      const icon=grid[i].textContent;
      const neighbors=getNeighbors(i);
      neighbors.forEach(n=>{
        if(grid[n].textContent===icon){
          grid[n].textContent="";
          grid[n].style.background=document.body.style.background;
        }
      });
    });
    bonusActive--;
    bonusEl.textContent=bonusActive;
  }

  if(combosDone>=10){
    randomBG();
    combosDone=0;
  }
}

function gravity(){
  let moved=true;
  while(moved){
    moved=false;
    for(let x=0;x<SIZE;x++){
      for(let y=SIZE-2;y>=0;y--){
        const i=y*SIZE+x;
        const b=i+SIZE;
        if(grid[i].textContent!=="" && grid[b].textContent===""){
          grid[b].textContent=grid[i].textContent;
          grid[b].style.background=grid[i].style.background;
          grid[i].textContent="";
          grid[i].style.background=document.body.style.background;
          moved=true;
        }
      }
    }
  }
  refill();
}

function refill(){
  for(let i=0;i<SIZE*SIZE;i++){
    if(grid[i].textContent===""){
      const r=Math.floor(Math.random()*icons.length);
      grid[i].textContent=icons[r];
      grid[i].style.background=colors[r];
      grid[i].style.transform="translateY(-20px)";
      setTimeout(()=>grid[i].style.transform="translateY(0)",50);
    }
  }
  syncEmpty();
  setTimeout(clearMatches,120);
}

// Timer
setInterval(()=>{
  time--;
  timeEl.textContent=time;
  if(time<=10){
    timeEl.style.fontSize="32px";
    timeEl.style.color="#ff0000";
  } else {
    timeEl.style.fontSize="18px";
    timeEl.style.color="#fff";
  }
  if(time<=0){
    level++;
    levelEl.textContent=level;
    time=60;
    randomBG();
  }
},1000);

randomBG();
createGrid();
</script>
</body>
</html>

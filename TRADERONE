cat >/root/TRADERONE_MEGA_FIX_ALL.sh <<'BASH'
#!/usr/bin/env bash
set -e

echo "===== TRADERONE MEGA FIX (API + FRONT + COLORS) ====="

### PATHS
API="/opt/traderone-vault/server.js"
HTML="/var/www/wolverine/index.html"
NGINX="/etc/nginx/sites-available/fireinners.online-ssl"
TS=$(date +%Y%m%d_%H%M%S)

### 1) BACKUP
cp -a "$API" "$API.bak_$TS"
cp -a "$HTML" "$HTML.bak_$TS"

### 2) PATCH API (SAFE, NO REGEX)
node <<'NODE'
const fs=require("fs");
let s=fs.readFileSync("/opt/traderone-vault/server.js","utf8");
if(!s.includes("/traderone/api/budget")){
s+=`
/* ===== TRADERONE BUDGET API ===== */
app.options("/wolverine/traderone/api/budget",(req,res)=>{
 res.setHeader("Access-Control-Allow-Origin","*");
 res.setHeader("Access-Control-Allow-Headers","Content-Type");
 res.setHeader("Access-Control-Allow-Methods","POST,OPTIONS");
 return res.sendStatus(200);
});

app.post("/wolverine/traderone/api/budget",async(req,res)=>{
 try{
  const {from,amount}=req.body||{};
  if(!from||!amount) return res.status(400).json({ok:false,error:"missing from/amount"});
  return res.json({ok:true,from,amount});
 }catch(e){
  return res.status(500).json({ok:false,error:String(e)});
 }
});
`;
fs.writeFileSync("/opt/traderone-vault/server.js",s);
console.log("✔ API budget ajoutée");
}else{
 console.log("✔ API budget déjà présente");
}
NODE

### 3) NGINX PROXY (SANS CASSER)
if ! grep -q "traderone/api/budget" "$NGINX"; then
sed -i '/location \/wolverine\/ {/a\
    location /wolverine/traderone/api/ {\
        proxy_pass http://127.0.0.1:3000;\
        proxy_http_version 1.1;\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\
        proxy_set_header X-Forwarded-Proto $scheme;\
    }\
' "$NGINX"
echo "✔ NGINX proxy ajouté"
else
echo "✔ NGINX proxy déjà OK"
fi

### 4) FRONTEND : JSON SAFE
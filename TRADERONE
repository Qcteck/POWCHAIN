cat >/root/hardfix_traderone_api_health_proxy.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SSL="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
ts="$(date +%Y%m%d_%H%M%S)"

# --- autodetect backend port (best effort) ---
PORT=""
for p in 3000 3001 3100 8080 8000 5000; do
  code="$(curl -s -o /tmp/h.$$ -w "%{http_code}" "http://127.0.0.1:$p/api/health" || true)"
  if [[ "$code" == "200" ]]; then PORT="$p"; break; fi
done
rm -f /tmp/h.$$ 2>/dev/null || true

if [[ -z "$PORT" ]]; then
  echo "[ERR] Backend /api/health pas trouvé sur 3000/3001/3100/8080/8000/5000"
  echo "Colle-moi: ss -lntp | grep -E 'node|:3000|:3001|:3100|:8080|:8000|:5000'"
  exit 1
fi
echo "[OK] Backend: 127.0.0.1:$PORT"

echo "== Backup =="
cp -a "$SSL" "${SSL}.bak_${ts}"
ln -sf "$SSL" "$EN"

echo "== Remove any old traderone api blocks (to avoid duplicates) =="
perl -0777 -i -pe 's@\n\s*#\s*BEGIN_TRADERONE_API_PROXY.*?#\s*END_TRADERONE_API_PROXY\s*\n@@sg' "$SSL"

echo "== Inject API proxy block inside SSL server{} (high priority) =="
perl -0777 -i -pe 's@(server_name\s+[^;]*fireinners\.online[^;]*;\s*)@$1\n  # BEGIN_TRADERONE_API_PROXY\n  # /wolverine/traderone/api/* -> http://127.0.0.1:'"$PORT"'/api/*\n  location = /wolverine/traderone/api/health {\n    proxy_http_version 1.1;\n    proxy_set_header Host $host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Proto $scheme;\n\n    rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;\n    proxy_pass http://127.0.0.1:'"$PORT"';\n  }\n\n  location ^~ /wolverine/traderone/api/ {\n    proxy_http_version 1.1;\n    proxy_set_header Host $host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Proto $scheme;\n\n    proxy_set_header Upgrade $http_upgrade;\n    proxy_set_header Connection \"upgrade\";\n\n    rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;\n    proxy_pass http://127.0.0.1:'"$PORT"';\n  }\n  # END_TRADERONE_API_PROXY\n\n@sg' "$SSL"

echo "== nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== LOCAL test =="
curl -sS "http://127.0.0.1:${PORT}/api/health" | head -c 300 || true
echo

echo
echo "== PUBLIC test (must NOT be HTML) =="
echo "-- headers:"
curl -sk -i "https://${DOMAIN}/wolverine/traderone/api/health" | sed -n '1,25p'
echo
echo "-- body (first 200 chars):"
curl -sk "https://${DOMAIN}/wolverine/traderone/api/health" | head -c 200
echo
BASH

chmod +x /root/hardfix_traderone_api_health_proxy.sh
/root/hardfix_traderone_api_health_proxy.sh
"use strict";
const http=require("http"), https=require("https"); const {URL}=require("url");
const LISTEN_HOST=process.env.LISTEN_HOST||"127.0.0.1";
const LISTEN_PORT=parseInt(process.env.LISTEN_PORT||"12713",10);
const UPSTREAM_PRIMARY=process.env.UPSTREAM_PRIMARY||"";
const UPSTREAM_FALLBACK=process.env.UPSTREAM_FALLBACK||"https://api.mainnet-beta.solana.com";
function pick(){ return (UPSTREAM_PRIMARY && /^https?:\/\//i.test(UPSTREAM_PRIMARY)) ? UPSTREAM_PRIMARY : UPSTREAM_FALLBACK; }
function send(res,code,obj){ const b=Buffer.from(JSON.stringify(obj)); res.writeHead(code,{"content-type":"application/json","content-length":String(b.length),"access-control-allow-origin":"*","access-control-allow-methods":"POST,GET,OPTIONS","access-control-allow-headers":"content-type,authorization","cache-control":"no-store"}); res.end(b); }
function proxy(res,raw){
  const upstream=pick(); let u; try{u=new URL(upstream);}catch(e){return send(res,500,{status:"error",error:"bad upstream url",upstream});}
  const lib=(u.protocol==="https:")?https:http;
  const opts={method:"POST",hostname:u.hostname,port:u.port||(u.protocol==="https:"?443:80),path:(u.pathname&&u.pathname!=="/")?u.pathname:"/",headers:{"content-type":"application/json","content-length":String(raw.length),"accept":"application/json","user-agent":"wolverine-solrpc-proxy"}};
  const rq=lib.request(opts,(rs)=>{const c=[];rs.on("data",(d)=>c.push(d));rs.on("end",()=>{const buf=Buffer.concat(c);res.writeHead(rs.statusCode||502,{"content-type":(rs.headers["content-type"]||"application/json"),"access-control-allow-origin":"*","access-control-allow-methods":"POST,GET,OPTIONS","access-control-allow-headers":"content-type,authorization","cache-control":"no-store"});res.end(buf);});});
  rq.on("error",(e)=>send(res,502,{status:"error",error:String(e&&e.message?e.message:e),upstream}));
  rq.write(raw); rq.end();
}
http.createServer((req,res)=>{
  if(req.method==="OPTIONS"){res.writeHead(204,{"access-control-allow-origin":"*","access-control-allow-methods":"POST,GET,OPTIONS","access-control-allow-headers":"content-type,authorization","cache-control":"no-store"});return res.end();}
  if(req.method==="GET"&&(req.url==="/health"||req.url==="/")) return send(res,200,{status:"ok",service:"wolverine-solrpc-proxy",upstream:pick()});
  if(req.method!=="POST") return send(res,405,{status:"error",error:"POST only"});
  const ch=[]; req.on("data",(d)=>ch.push(d)); req.on("end",()=>{const raw=Buffer.concat(ch); if(!raw.length) return send(res,400,{status:"error",error:"empty body"}); proxy(res,raw);});
}).listen(LISTEN_PORT,LISTEN_HOST,()=>console.log(`wolverine-solrpc-proxy http://${LISTEN_HOST}:${LISTEN_PORT} -> ${pick()}`));
JS


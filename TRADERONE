cat >/etc/systemd/system/traderone.service <<'EOF'
[Unit]
Description=TraderOne Backend (Wolverine)
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/traderone-opt
Environment=NODE_ENV=production
Restart=always
RestartSec=2

ExecStart=/usr/bin/node /opt/traderone-opt/server.js

KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl restart traderone.service

# preuves
systemctl status traderone.service --no-pager
journalctl -u traderone.service -n 80 --no-pager
curl -ksS https://fireinners.online/wolverine/traderone/api/health ; echo
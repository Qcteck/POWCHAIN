TS="$(date +%Y%m%d_%H%M%S)"
export DEBIAN_FRONTEND=noninteractive
umask 022

log(){ printf "\n[%s] %s\n" "$(date '+%F %T')" "$*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "Run as root."

ROOT_WOLV="/var/www/wolverine"
REPO="/opt/wolverine"
INC="/etc/nginx/includes/wolverine_routes.inc"
ASK="/opt/fireinners/sentinel/lib/askorupdate.sh"

RB_DIR="/root/MEGA_WOLVERINE_ROLLBACK_${TS}"
mkdir -p "$RB_DIR"

rollback(){
  log "ROLLBACK (best-effort)"
  if [ -f "$RB_DIR/nginx_T_before.txt" ]; then true; fi
  if [ -f "$RB_DIR/wolverine_routes.inc" ]; then
    mkdir -p "$(dirname "$INC")"
    cp -a "$RB_DIR/wolverine_routes.inc" "$INC" 2>/dev/null || true
  fi
  if [ -d "$RB_DIR/wolverine_www" ]; then
    rm -rf "$ROOT_WOLV" 2>/dev/null || true
    cp -a "$RB_DIR/wolverine_www" "$ROOT_WOLV" 2>/dev/null || true
  fi
  if [ -f "$RB_DIR/vhost_patched_path.txt" ]; then
    VHOST="$(cat "$RB_DIR/vhost_patched_path.txt" 2>/dev/null || true)"
    if [ -n "${VHOST:-}" ] && [ -f "$RB_DIR/vhost_backup.conf" ]; then
      chattr -i "$VHOST" 2>/dev/null || true
      cp -a "$RB_DIR/vhost_backup.conf" "$VHOST" 2>/dev/null || true
      chattr +i "$VHOST" 2>/dev/null || true
    fi
  fi
  if command -v nginx >/dev/null 2>&1; then
    nginx -t && systemctl reload nginx || true
  fi
  log "ROLLBACK done"
}

set -euo pipefail

PID="$(pm2 pid 0 | tr -d '[:space:]')"
echo "PID=$PID"

echo "=== A) Infos PM2 (cwd, script, args) ==="
pm2 describe 0 | sed -n '1,200p'
echo

echo "=== B) Cherche tous les .env possibles (chemins) ==="
find /opt /var/www /etc /root -maxdepth 7 -type f -name ".env" 2>/dev/null | sed -n '1,200p'
echo

echo "=== C) Dans les .env: afficher UNIQUEMENT les NOMS des variables (pas les valeurs) ==="
while IFS= read -r f; do
  names="$(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$f" 2>/dev/null | cut -d= -f1 | grep -Ei 'api|key|token|secret|auth' || true)"
  if [ -n "${names:-}" ]; then
    echo "--- $f ---"
    echo "$names" | sed -n '1,120p'
    echo
  fi
done < <(find /opt /var/www /etc /root -maxdepth 7 -type f -name ".env" 2>/dev/null)
echo

echo "=== D) Dans le code/config: où est checké X-API-KEY ==="
grep -RIn --line-number -E 'x-api-key|X-API-KEY|api[_-]?key|token|secret|authorization' /opt 2>/dev/null | head -n 120 || true 
# Install PhantomJS (headless) on Ubuntu
set -euo pipefail
cd /tmp

PH_VER="2.1.1"
PH_TGZ="phantomjs-${PH_VER}-linux-x86_64.tar.bz2"
PH_URL="https://bitbucket.org/ariya/phantomjs/downloads/${PH_TGZ}"

echo "=== deps ==="
apt-get update -y
apt-get install -y wget bzip2 libfontconfig1

echo "=== download ==="
wget -O "$PH_TGZ" "$PH_URL"

echo "=== install ==="
tar -xjf "$PH_TGZ"
install -m 0755 "phantomjs-${PH_VER}-linux-x86_64/bin/phantomjs" /usr/local/bin/phantomjs

echo "=== verify ==="
phantomjs --version

echo "✅ PhantomJS installé: $(command -v phantomjs)"
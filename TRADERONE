function armOK(x){return typeof x==="string" && x.length>0 && x===ARM_CODE;}

async function pingOnce(){
  const t0=Date.now();
  let ok=false;
  try{
    const ac=new AbortController();
    const to=setTimeout(()=>ac.abort(),8000);
    const r=await fetch(MONITOR_URL,{cache:"no-store",signal:ac.signal});
    clearTimeout(to);
    const txt=await r.text();
    ok=r.ok && /pong/i.test(txt);
  }catch(_){}
  const ms=Date.now()-t0;
  state.ping.lastAt=now();
  state.ping.latencyMs=ms;
  if(ok){
    state.ping.fails=0;
    state.ping.effective="UP";
    state.ping.lastOkAt=now();
  }else{
    state.ping.fails=(state.ping.fails||0)+1;
    if(state.ping.fails>=MONITOR_FAILS) state.ping.effective="DOWN";
  }
  saveJSON(STATE_JSON,state);
  return {ok,ms,effective:state.ping.effective,fails:state.ping.fails};
}

function tgSend(msg){
  if(!TG_ALERTS) return;
  execFile(WOLV_SEND,[String(msg)],{timeout:12000},()=>{});
}

let pingTimer=null;
function startPingLoop(){
  if(pingTimer) return;
  pingTimer=setInterval(async()=>{
    const prev=state.ping.effective;
    const r=await pingOnce();
    if(prev!==state.ping.effective){
      if(state.ping.effective==="UP") tgSend(`WOLVERINE: API UP (recovery) ${now()}`);
      if(state.ping.effective==="DOWN") tgSend(`WOLVERINE: API DOWN (>=${MONITOR_FAILS} fails) ${now()}`);
      if(state.ping.effective!=="UP" && state.ping.effective!=="DOWN") tgSend(`WOLVERINE: STATE ${state.ping.effective} ${now()}`);
    }
  },Math.max(2,MONITOR_SEC)*1000);
}
function stopPingLoop(){ if(pingTimer){ clearInterval(pingTimer); pingTimer=null; } }

async function getSOL(pub){ return await conn.getBalance(new PublicKey(pub),"confirmed"); }
async function getUSDC(pub){
  const owner=new PublicKey(pub);
  const resp=await conn.getParsedTokenAccountsByOwner(owner,{mint:new PublicKey(USDC_MINT)},"confirmed");
  let sum=0;
  for(const a of resp.value){
    const ui=a.account.data.parsed.info.tokenAmount.uiAmount||0;
    sum+=ui;
  }
  return sum;
}

async function ensureATA(owner, mint, payer){
  const ata=await getAssociatedTokenAddress(mint, owner, false);
  const info=await conn.getAccountInfo(ata,"confirmed");
  if(info) return {ata,ix:null};
  const ix=createAssociatedTokenAccountInstruction(payer, ata, owner, mint);
  return {ata,ix};
}

async function sendVersionedTx(b64){
  const tx=VersionedTransaction.deserialize(Buffer.from(b64,"base64"));
  tx.sign([KP]);
  const sig=await conn.sendTransaction(tx,{skipPreflight:false,maxRetries:3});
  await conn.confirmTransaction(sig,"confirmed");
  return sig;
}

async function jupSwap({inputMint,outputMint,amountUI,slippageBps,wrapAndUnwrapSol}){
  const inMint=inputMint, outMint=outputMint;
  if(!inMint||!outMint) throw new Error("missing mint");
  const decimals = (inMint===USDC_MINT)?6 : 9; // simplifié
  const amount=Math.floor(Number(amountUI||0)*10**decimals);
  if(!Number.isFinite(amount)||amount<=0) throw new Error("bad amount");
  const url=new URL(JUP_QUOTE);
  url.searchParams.set("inputMint",inMint);
  url.searchParams.set("outputMint",outMint);
  url.searchParams.set("amount",String(amount));
  url.searchParams.set("slippageBps",String(slippageBps||50));
  url.searchParams.set("onlyDirectRoutes","false");
  url.searchParams.set("asLegacyTransaction","false");
  const qr=await fetch(url.toString(),{cache:"no-store"});
  const qj=await qr.json();
  if(!qj||!qj.data||!qj.data[0]) throw new Error("no route");
  const body={
    quoteResponse:qj,
    userPublicKey:CUSTODY,
    wrapAndUnwrapSol:!!wrapAndUnwrapSol,
    dynamicComputeUnitLimit:true,
    prioritizationFeeLamports:"auto"
  };
  const sr=await fetch(JUP_SWAP,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body)});
  const sj=await sr.json();
  if(!sj||!sj.swapTransaction) throw new Error("swapTransaction missing");
  const sig=await sendVersionedTx(sj.swapTransaction);
  return {sig,route:qj.data[0]};
}

let botTimer=null;
async function botTick(){
  if(!state.bot.running) return;
  const b=state.bot;
  if(b.spent>=b.budgetTotal){ b.running=false; saveJSON(STATE_JSON,state); tgSend(`WOLVERINE: Budget reached. STOP ${now()}`); return; }

  const spend=Math.min(b.perTrade, b.budgetTotal-b.spent);
  const inputMint=USDC_MINT;
  const outputMint=(b.mode==="dca_sol")?WSOL_MINT:(b.mint||"");
  if(!outputMint){ b.last="ERR: missing output mint"; saveJSON(STATE_JSON,state); return; }

  try{
    const bal=await getUSDC(CUSTODY);
    if(bal+1e-9 < spend){ b.last=`ERR: USDC not enough (have ${bal})`; saveJSON(STATE_JSON,state); return; }

    const r=await jupSwap({inputMint,outputMint,amountUI:spend,slippageBps:60,wrapAndUnwrapSol:true});
    b.spent=Number((b.spent+spend).toFixed(6));
    b.last=`OK swap ${spend} USDC tx ${r.sig}`;
    saveJSON(STATE_JSON,state);
  }catch(e){
    b.last=`ERR swap: ${String(e&&e.message||e)}`;
    saveJSON(STATE_JSON,state);
  }
}

function botStart(){
  if(botTimer) return;
  botTimer=setInterval(()=>{botTick().catch(()=>{});}, 12000);
}
function botStop(){ if(botTimer){ clearInterval(botTimer); botTimer=null; } }

async function withdrawAllTo(to){
  const toPub=new PublicKey(to);
  const from=KP.publicKey;
  const ixs=[];

  // SOL: garder un peu de frais
  const solLam=await conn.getBalance(from,"confirmed");
  const keep=0.01*1e9;
  const sendLam=Math.max(0, solLam-keep);
  if(sendLam>5000){
    const {SystemProgram}=require("@solana/web3.js");
    ixs.push(SystemProgram.transfer({fromPubkey:from,toPubkey:toPub,lamports:Math.floor(sendLam)}));
  }

  // USDC
  const mint=new PublicKey(USDC_MINT);
  const {ata:fromAta}=await ensureATA(from,mint,from);
  const {ata:toAta,ix:mk}=await ensureATA(toPub,mint,from);
  if(mk) ixs.push(mk);

  const fromInfo=await conn.getTokenAccountBalance(fromAta,"confirmed").catch(()=>null);
  const amt=fromInfo && fromInfo.value && Number(fromInfo.value.amount||"0") || 0;
  if(amt>0){
    ixs.push(createTransferInstruction(fromAta,toAta,from,amt));
  }

  if(ixs.length===0) return {ok:true,tx:null,note:"nothing to withdraw"};
  const {TransactionMessage,VersionedTransaction}=require("@solana/web3.js");
  const bh=await conn.getLatestBlockhash("confirmed");
  const msg=new TransactionMessage({payerKey:from,recentBlockhash:bh.blockhash,instructions:ixs}).compileToV0Message();
  const tx=new VersionedTransaction(msg);
  tx.sign([KP]);
  const sig=await conn.sendTransaction(tx,{skipPreflight:false,maxRetries:3});
  await conn.confirmTransaction(sig,"confirmed");
  return {ok:true,tx:sig};
}


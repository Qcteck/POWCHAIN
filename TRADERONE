cat >/root/purge_enabled_backups_again.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
EN="/etc/nginx/sites-enabled"
DST="/etc/nginx/sites-disabled/cleanup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$DST"

echo "== Move all backups/variants out of sites-enabled =="
shopt -s nullglob
for f in "$EN"/fireinners.online-ssl.* "$EN"/*.bak* "$EN"/*.broken*; do
  [ -e "$f" ] || continue
  # keep only the exact active file
  [ "$f" = "$EN/fireinners.online-ssl" ] && continue
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== Enabled now (must show only fireinners.online-ssl) =="
ls -lah "$EN"

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload =="
systemctl reload nginx || service nginx reload
echo "DONE ✅"
BASH

chmod +x /root/purge_enabled_backups_again.sh
/root/purge_enabled_backups_again.sh
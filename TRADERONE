cat >/root/MEGA_MAP_ENGINES_SOL_EVM.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 077

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }
[[ "$(id -u)" == "0" ]] || die "Run as root."

TS="$(date +%Y%m%d_%H%M%S)"
OUT="/root/MAP_ENGINES_${TS}"
mkdir -p "$OUT"
REPORT="$OUT/report.txt"

cmd_exists(){ command -v "$1" >/dev/null 2>&1; }

say "OUT=$OUT"

{
  echo "MAP ENGINES SOL/EVM"
  echo "ts: $(date -Is)"
  echo "host: $(hostname)"
  echo

  echo "== LISTEN PORTS (TCP) =="
  ss -lntp || true
  echo

  echo "== NODE LISTENERS (parsed) =="
  # Extract unique node pids from ss output
  ss -lntp 2>/dev/null | awk '
    /users:\(\("node"/{
      # example: users:(("node",pid=123,fd=18))
      match($0, /pid=([0-9]+)/, m);
      if(m[1]!=""){print m[1]}
    }' | sort -u | while read -r pid; do
      echo "--- PID $pid ---"
      echo "cmd:"
      ps -p "$pid" -o pid=,etime=,user=,cmd= || true
      echo "cwd:"
      readlink -f "/proc/$pid/cwd" 2>/dev/null || echo "?"
      echo "exe:"
      readlink -f "/proc/$pid/exe" 2>/dev/null || echo "?"
      echo "env hints (filtered):"
      tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | egrep -i 'PORT=|HOST=|SOL_RPC=|JUP|ETH|EVM|RPC|CHAIN|PRIVATE|KEY|WALLET|ENGINE|WOLVERINE|TRADER|BUNDLER' | head -n 40 || true
      echo
    done
  echo

  echo "== SYSTEMD SERVICES (name -> MainPID) =="
  systemctl list-units --type=service --all --no-pager 2>/dev/null | egrep -i 'crypto|engine|trader|wolverine|amcq|orion|bundler|swap|lifi|evm|dex|jup|price|ws|node|pm2' || true
  echo
  # map MainPID to service
  for s in $(systemctl list-units --type=service --all --no-pager 2>/dev/null | awk '{print $1}' | egrep -i 'crypto|engine|trader|wolverine|amcq|orion|bundler|swap|lifi|evm|dex|jup|price|ws'); do
    mp="$(systemctl show "$s" -p MainPID --value 2>/dev/null || true)"
    [[ -n "$mp" && "$mp" != "0" ]] || continue
    printf '%-45s MainPID=%s\n' "$s" "$mp"
  done
  echo

  echo "== PM2 (if any) =="
  if cmd_exists pm2; then
    pm2 list || true
    echo
    pm2 jlist 2>/dev/null | head -n 80 || true
  else
    echo "pm2 not installed"
  fi
  echo

  echo "== QUICK KEYWORD SCAN (SOL vs EVM) on /opt (filenames only, no secrets) =="
  if cmd_exists rg; then
    rg -n --hidden --follow -S -g'!*node_modules/*' -g'!*.log' -g'!*.png' -g'!*.jpg' -g'!*.zip' -g'!*.gz' \
      'solana/web3\.js|quote-api\.jup\.ag|jup\.ag|dexscreener|ethers|viem|web3|0x\.org|1inch|lifi' /opt 2>/dev/null | head -n 220 || true
  else
    grep -RIn --exclude-dir=node_modules --exclude='*.log' --exclude='*.png' --exclude='*.jpg' --exclude='*.zip' --exclude='*.gz' \
      -E 'solana/web3\.js|quote-api\.jup\.ag|jup\.ag|dexscreener|ethers|viem|web3|0x\.org|1inch|lifi' /opt 2>/dev/null | head -n 220 || true
  fi
  echo

  echo "== LAST DIAG FOLDER + FILES =="
  LAST="$(ls -1dt /root/DIAG_CRYPTO_ENGINES_* 2>/dev/null | head -n 1 || true)"
  echo "LAST=$LAST"
  if [[ -n "$LAST" ]]; then
    ls -la "$LAST" | sed -n '1,200p' || true
    echo
    echo "Try show hits file (auto-detect):"
    H="$(ls -1 "$LAST" | egrep -i 'hits' | head -n 1 || true)"
    echo "hits_file=$H"
    [[ -n "$H" ]] && sed -n '1,120p' "$LAST/$H" || true
  fi
  echo

} | tee "$REPORT"

say "DONE: $REPORT"
BASH

bash /root/MEGA_MAP_ENGINES_SOL_EVM.sh
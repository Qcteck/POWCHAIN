cat >/root/batch_root_create_devnet_usdc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APPLY="${APPLY:-0}"   # 0=dry-run, 1=apply
WOLVERINE_WALLET="${WOLVERINE_WALLET:-DgpM2PXA9it1g8myWnVXeosu72GkwmjgpeGUigpyLkYC}"
AMOUNT="${AMOUNT:-1000}"   # 1000 USDC devnet par défaut

need(){ command -v "$1" >/dev/null 2>&1 || { echo "[ERR] missing: $1"; exit 1; }; }

echo "== Devnet USDC Mint =="
echo "APPLY=$APPLY (0=dry-run, 1=apply)"
echo "WOLVERINE_WALLET=$WOLVERINE_WALLET"
echo "AMOUNT=$AMOUNT"
echo

# --- Install solana + spl-token if missing ---
if ! command -v solana >/dev/null 2>&1; then
  echo "[*] Installing Solana CLI..."
  if [[ "$APPLY" == "1" ]]; then
    sh -c "$(curl -sSfL https://release.solana.com/stable/install)"
    export PATH="$HOME/.local/share/solana/install/active_release/bin:$PATH"
  else
    echo "[DRY] would install Solana CLI"
  fi
fi

if ! command -v spl-token >/dev/null 2>&1; then
  echo "[*] Installing spl-token..."
  if [[ "$APPLY" == "1" ]]; then
    cargo --version >/dev/null 2>&1 || { echo "[ERR] cargo missing (install rust)"; exit 1; }
    cargo install spl-token-cli
  else
    echo "[DRY] would install spl-token (requires rust/cargo)"
  fi
fi

need solana
need spl-token

# --- Configure devnet ---
if [[ "$APPLY" == "1" ]]; then
  solana config set --url https://api.devnet.solana.com >/dev/null
else
  echo "[DRY] solana config set --url https://api.devnet.solana.com"
fi

echo "[*] Solana config:"
solana config get || true
echo

# --- Ensure a keypair exists (payer/mint authority) ---
KEYPAIR="${KEYPAIR:-$HOME/.config/solana/id.json}"
if [[ "$APPLY" == "1" ]]; then
  if [[ ! -f "$KEYPAIR" ]]; then
    echo "[*] Generating solana keypair: $KEYPAIR"
    solana-keygen new --no-bip39-passphrase -o "$KEYPAIR" >/dev/null
  fi
else
  echo "[DRY] would ensure keypair exists at $KEYPAIR"
fi

# --- Airdrop SOL for fees ---
if [[ "$APPLY" == "1" ]]; then
  echo "[*] Airdrop 2 SOL (devnet) for fees..."
  solana airdrop 2 >/dev/null || true
fi

echo "[*] Wallet payer:"
solana address
echo "[*] Balance:"
solana balance || true
echo

# --- Create mint (decimals=6) ---
if [[ "$APPLY" == "1" ]]; then
  echo "[*] Creating mint (decimals=6)..."
  MINT="$(spl-token create-token --decimals 6 | awk '/Creating token/ {print $3}')"
  echo "[OK] DEVNET_USDC_MINT=$MINT"
else
  echo "[DRY] would run: spl-token create-token --decimals 6"
  echo "[DRY] (it will output DEVNET_USDC_MINT=...)"
  exit 0
fi

# --- Create ATA for wolverine and mint tokens to it ---
echo "[*] Creating ATA for WOLVERINE..."
WOLV_ATA="$(spl-token create-account "$MINT" --owner "$WOLVERINE_WALLET" | awk '/Creating account/ {print $3}')"
echo "[OK] WOLVERINE_USDC_ATA=$WOLV_ATA"

echo "[*] Minting ${AMOUNT} tokens to WOLVERINE ATA..."
spl-token mint "$MINT" "$AMOUNT" "$WOLV_ATA" >/dev/null
echo "[OK] Minted."

echo
echo "=== OUTPUT ==="
echo "DEVNET_USDC_MINT=$MINT"
echo "WOLVERINE_WALLET=$WOLVERINE_WALLET"
echo "WOLVERINE_USDC_ATA=$WOLV_ATA"
echo
echo "Next step (devnet build):"
echo "  NETWORK=devnet USDC_MINT=$MINT WOLVERINE_WALLET=$WOLVERINE_WALLET APPLY=1 /root/batch_root_phantom_wolverine_multi.sh fireinners.online"
BASH

chmod +x /root/batch_root_create_devnet_usdc.sh
echo "OK: /root/batch_root_create_devnet_usdc.sh prêt"




APPLY=0 /root/batch_root_create_devnet_usdc.sh





APPLY=1 WOLVERINE_WALLET="DgpM2PXA9it1g8myWnVXeosu72GkwmjgpeGUigpyLkYC" /root/batch_root_create_devnet_usdc.sh





APPLY=1 NETWORK=devnet \
WOLVERINE_WALLET="DgpM2PXA9it1g8myWnVXeosu72GkwmjgpeGUigpyLkYC" \
USDC_MINT="COLLE_ICI_LE_DEVNET_USDC_MINT" \
/root/batch_root_phantom_wolverine_multi.sh fireinners.online





#!/usr/bin/env bash
set -euo pipefail

echo "=== UNLOCK NGINX SITES-ENABLED ==="

TARGET="/etc/nginx/sites-enabled/fireinners.online-ssl"

# 1. Vérification
if [ ! -e "$TARGET" ]; then
  echo "Rien à déverrouiller"
  exit 0
fi

# 2. Déverrouillage attributs
echo "Déverrouillage chattr..."
chattr -i "$TARGET" || true

# 3. Suppression symlink
echo "Suppression symlink bloqué..."
rm -f "$TARGET"

# 4. Recréation propre
echo "Recréation symlink..."
ln -s /etc/nginx/sites-available/fireinners.online-ssl "$TARGET"

# 5. Test & reload
nginx -t
systemctl reload nginx

# 6. Reverrouillage
chattr +i "$TARGET"

echo "✅ SYMLINK NGINX RÉPARÉ ET VERROUILLÉ"
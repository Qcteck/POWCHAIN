cat >/root/FIX_NDJSON_FORCE_ALL_SERVERS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "[1/7] Backup nginx"
TS=$(date +%Y%m%d_%H%M%S)
cp -a /etc/nginx "/root/BK_nginx_$TS"

echo "[2/7] Prepare data"
mkdir -p /var/www/ndjson /var/www/ndjson_data
echo '{"ts":"'$(date -Is)'","status":"force-ok"}' > /var/www/ndjson_data/events.ndjson
chmod -R 755 /var/www/ndjson /var/www/ndjson_data

echo "[3/7] NDJSON UI"
cat >/var/www/ndjson/index.html <<'HTML'
<!doctype html><html><body style="background:#000;color:#0f0;font-family:monospace">
<h1>NDJSON LIVE</h1>
<pre id=p>loading…</pre>
<script>
fetch('/data/events.ndjson').then(r=>r.text()).then(t=>p.textContent=t);
</script>
</body></html>
HTML

echo "[4/7] Inject locations into ALL server{} blocks"
for f in /etc/nginx/sites-enabled/*; do
  echo "Patching $f"
  chattr -i "$f" 2>/dev/null || true
  sed -i '/server {/a \
  location = /ndjson { return 301 /ndjson/; }\
  location /ndjson/ { root /var/www; index index.html; }\
  location /data/ { alias /var/www/ndjson_data/; default_type application/x-ndjson; add_header Cache-Control "no-store"; }\
' "$f"
done

echo "[5/7] Test nginx"
nginx -t

echo "[6/7] Reload nginx"
systemctl reload nginx

echo "[7/7] DONE"
echo "TEST:"
echo " https://fireinners.online/ndjson/"
echo " https://fireinners.online/data/events.ndjson"
BASH
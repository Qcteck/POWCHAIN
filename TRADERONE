cat >/tmp/WOLVERINE_TG_MEGA.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== WOLVERINE TG MEGA (SEND-ONLY) ==="
date;hostname;whoami;pwd

ASK="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASK" ]; then
  # shellcheck disable=SC1090
  source "$ASK"
else
  askorupdate_file(){ local p="$1";mkdir -p "$(dirname "$p")";cp -a "$p" "$p.bak.$(date +%s)" 2>/dev/null||true;cat >"$p"; }
fi

DIR="/opt/fireinners/wolverine-telegram"
ENV="$DIR/telegram.env"
SEND="$DIR/send.sh"
BIN="/usr/local/bin/wolv_send"

mkdir -p "$DIR"
chmod 700 "$DIR"

echo "--- write env template (FILL TOKEN + CHAT_ID) ---"
cat >/tmp/_tg_env <<'ENV'
# Put your BotFather token here (NO QUOTES)
TG_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
# Put your numeric chat id here (example: 123456789 or -1001234567890 for groups)
TG_CHAT_ID=PUT_YOUR_CHAT_ID_HERE
ENV
askorupdate_file "$ENV" </tmp/_tg_env
rm -f /tmp/_tg_env
chmod 600 "$ENV"

echo "--- write sender script ---"
cat >/tmp/_tg_send <<'SH2'
#!/usr/bin/env bash
set -euo pipefail
DIR="/opt/fireinners/wolverine-telegram"
# shellcheck disable=SC1090
source "$DIR/telegram.env"
MSG="${*:-}"
[ -n "${TG_TOKEN:-}" ] || { echo "TG_TOKEN missing"; exit 1; }
[ -n "${TG_CHAT_ID:-}" ] || { echo "TG_CHAT_ID missing"; exit 1; }
[ -n "$MSG" ] || { echo "usage: wolv_send \"message\""; exit 1; }
curl -sS -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
  -d "chat_id=${TG_CHAT_ID}" \
  -d "text=${MSG}" \
  -d "disable_web_page_preview=true" >/dev/null
echo "sent"
SH2
askorupdate_file "$SEND" </tmp/_tg_send
rm -f /tmp/_tg_send
chmod 700 "$SEND"

echo "--- install helper command ---"
cat >/tmp/_tg_bin <<'SH3'
#!/usr/bin/env bash
exec /opt/fireinners/wolverine-telegram/send.sh "$@"
SH3
askorupdate_file "$BIN" </tmp/_tg_bin
rm -f /tmp/_tg_bin
chmod 755 "$BIN"

echo "=== DONE ==="
echo "Next:"
echo "1) Edit: $ENV (set TG_TOKEN + TG_CHAT_ID)"
echo "2) Test: wolv_send \"Wolverine TG link OK\""
SH
bash /tmp/WOLVERINE_TG_MEGA.sh
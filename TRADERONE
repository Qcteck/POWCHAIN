export type SolanaErrCode =
  | "RPC_429"
  | "BLOCKHASH_NOT_FOUND"
  | "SIMULATION_FAILED"
  | "ACCOUNT_IN_USE"
  | "INSUFFICIENT_FUNDS"
  | "RATE_LIMIT"
  | "NODE_BEHIND"
  | "TIMEOUT"
  | "NETWORK"
  | "AUTH_MISMATCH"
  | "DECIMALS_MISMATCH"
  | "UNKNOWN";

export type SolanaErrClass = {
  code: SolanaErrCode;
  retriable: boolean;
  message: string;
};

function hasAny(m: string, needles: string[]) {
  const s = m.toLowerCase();
  return needles.some((n) => s.includes(n.toLowerCase()));
}

export function classifySolanaError(e: any): SolanaErrClass {
  const msg = String(e?.message ?? e ?? "unknown error");

  if (hasAny(msg, ["aborterror", "timed out", "etimedout", "econnreset", "fetch failed", "network"])) {
    return { code: "NETWORK", retriable: true, message: msg };
  }
  if (hasAny(msg, ["timeout", "time out"])) {
    return { code: "TIMEOUT", retriable: true, message: msg };
  }

  if (hasAny(msg, ["http 429", "429 too many requests", "too many requests"])) {
    return { code: "RPC_429", retriable: true, message: msg };
  }
  if (hasAny(msg, ["rate limit", "ratelimit", "request limit"])) {
    return { code: "RATE_LIMIT", retriable: true, message: msg };
  }

  if (hasAny(msg, ["blockhash not found"])) {
    return { code: "BLOCKHASH_NOT_FOUND", retriable: true, message: msg };
  }

  if (hasAny(msg, ["node is behind", "slot was skipped", "behind", "not caught up"])) {
    return { code: "NODE_BEHIND", retriable: true, message: msg };
  }

  if (hasAny(msg, ["simulation failed", "transaction simulation failed", "custom program error"])) {
    return { code: "SIMULATION_FAILED", retriable: false, message: msg };
  }

  if (hasAny(msg, ["account in use", "already in use", "lock", "resource is busy"])) {
    return { code: "ACCOUNT_IN_USE", retriable: true, message: msg };
  }

  if (hasAny(msg, ["insufficient funds", "insufficient lamports", "insufficient balance"])) {
    return { code: "INSUFFICIENT_FUNDS", retriable: false, message: msg };
  }

  return { code: "UNKNOWN", retriable: false, message: msg };
}

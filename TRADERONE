cat >/root/DIAG_WOLVERINE_SOLANA.sh <<'BASH'
#!/usr/bin/env bash
set -e

echo "======================================"
echo " WOLVERINE • DIAGNOSTIC SOLANA COMPLET "
echo "======================================"
echo

FRONT="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor/solana-web3.min.js"
URL_JS="https://fireinners.online/wolverine/vendor/solana-web3.min.js"
RPC="https://api.mainnet-beta.solana.com"

### 1️⃣ Vérification fichiers locaux
echo "[1] Vérification fichiers..."
[ -f "$FRONT" ] && echo " OK  index.html trouvé" || echo " ERREUR index.html manquant"
[ -f "$VENDOR" ] && echo " OK  solana-web3.min.js trouvé" || echo " ERREUR solana-web3.min.js manquant"
echo

### 2️⃣ Vérification nginx sert bien solana-web3
echo "[2] Test HTTP solana-web3.min.js..."
HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" "$URL_JS")
echo " HTTP STATUS = $HTTP_CODE"
if [ "$HTTP_CODE" != "200" ]; then
  echo " ERREUR : solana-web3.min.js NON SERVI PAR NGINX"
else
  echo " OK : solana-web3.min.js SERVI"
fi
echo

### 3️⃣ Vérification présence unique du script (anti-doublon)
echo "[3] Vérification doublons JS..."
COUNT=$(grep -o "solana-web3.min.js" "$FRONT" | wc -l)
echo " Occurrences trouvées : $COUNT"
if [ "$COUNT" -gt 1 ]; then
  echo " ERREUR : DOUBLON solana-web3.min.js dans index.html"
else
  echo " OK : aucune duplication"
fi
echo

### 4️⃣ Test RPC Solana brut
echo "[4] Test RPC Solana..."
RPC_TEST=$(curl -s -X POST "$RPC" \
 -H "Content-Type: application/json" \
 -d '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' || true)

echo " Réponse RPC : $RPC_TEST"
echo

### 5️⃣ Nettoyage cache nginx
echo "[5] Nettoyage cache nginx..."
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx
echo " Cache nginx nettoyé"
echo

### 6️⃣ Résumé
echo "======================================"
echo " RÉSUMÉ FINAL "
echo "======================================"
echo " - JS local       : $( [ -f "$VENDOR" ] && echo OK || echo NOK )"
echo " - JS servi HTTP  : $HTTP_CODE"
echo " - Doublons JS    : $COUNT"
echo " - RPC réponse    : $RPC_TEST"
echo
echo "👉 SI JS=OK, HTTP=200, RPC OK → LE CODE DOIT FONCTIONNER"
echo "👉 SINON → PROBLÈME ENVIRONNEMENT (PAS LOGIQUE)"
echo
echo "FIN DIAGNOSTIC"
BASH

chmod +x /root/DIAG_WOLVERINE_SOLANA.sh
/root/DIAG_WOLVERINE_SOLANA.sh
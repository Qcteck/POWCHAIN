cat >/tmp/fireinners_react_fly.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
CONF="/etc/nginx/sites-available/fireinners.online-ssl"
DEF="/opt/fireinners/frontend-react/app/dist"
ROOT="$DEF"
if test -f "$CONF"; then
  R=$(awk 'BEGIN{r=""} /^[ \t]*root[ \t]+/{gsub(/;$/,"",$2); if(r==""){r=$2}} END{print r}' "$CONF" 2>/dev/null || true)
  test -n "${R:-}" && ROOT="$R"
fi
echo "== FIREINNERS REACT FLY (read-only) =="
echo "nginx root detected: $ROOT"
test -d "$ROOT" || { echo "ERR: root dir introuvable: $ROOT"; exit 1; }
echo
echo "[ls root]"; ls -la "$ROOT" | head -n 80 || true
echo
if test -f "$ROOT/index.html"; then
  echo "[index.html head]"; head -n 20 "$ROOT/index.html" || true
  echo
  echo "[index.html grep react-ish]"; grep -nE "react|vite|webpack|chunk|manifest|__webpack" "$ROOT/index.html" | head -n 30 || true
  echo
  echo "[assets candidates]"; ls -la "$ROOT/assets" 2>/dev/null | head -n 30 || echo "no /assets"
else
  echo "WARN: $ROOT/index.html absent"
fi
echo
echo "[nginx -t]"; (command -v nginx >/dev/null && nginx -t) || true
echo "== OK =="
BASH
bash /tmp/fireinners_react_fly.sh
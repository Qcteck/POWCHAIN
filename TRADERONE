set -e
cd /root

BASE="https://fireinners.online/wolverine/traderone/api/status"

echo "=== 1) Test SANS clé (doit être 403) ==="
curl -sS -i -X POST "$BASE" -H "content-type: application/json" --data '{}' | head -n 25

echo
echo "=== 2) Vérifie que le bloc nginx a bien le if (clé) ==="
echo "--- SSL vhost ---"
grep -n "location \^~ /wolverine/traderone/api/" -n /etc/nginx/sites-enabled/fireinners.online-ssl -A25
echo
echo "--- HTTP vhost ---"
grep -n "location \^~ /wolverine/traderone/api/" -n /etc/nginx/sites-enabled/fireinners.online -A25

echo
echo "=== 3) Test local via nginx (bypass Cloudflare) SANS clé (doit être 403) ==="
curl -sS -i -X POST "http://127.0.0.1/wolverine/traderone/api/status" \
  -H "Host: fireinners.online" -H "content-type: application/json" --data '{}' | head -n 25
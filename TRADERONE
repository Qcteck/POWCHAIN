#!/usr/bin/env bash
set -euo pipefail

############################################
# CONFIG
############################################
APP_DIR="/var/www/fireinners.online/aiaquila"
BACKUP_DIR="/root/aiaquila_backup_$(date +%Y%m%d_%H%M%S)"
USER="www-data"
GROUP="www-data"

############################################
# ROOT CHECK
############################################
if [ "$EUID" -ne 0 ]; then
  echo "❌ Lancer en root uniquement"
  exit 1
fi

echo "== AIAQUILA | RESTART AVEC IDENTITÉ =="

############################################
# BACKUP
############################################
mkdir -p "$BACKUP_DIR"
if [ -d "$APP_DIR" ]; then
  cp -a "$APP_DIR" "$BACKUP_DIR/"
  echo "✔ Backup → $BACKUP_DIR"
fi

############################################
# PREP DIR
############################################
mkdir -p "$APP_DIR"
chown -R $USER:$GROUP "$APP_DIR"
chmod -R 755 "$APP_DIR"

############################################
# FRONTEND
############################################
cat > "$APP_DIR/index.html" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA • Decision Engine</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{margin:0;background:#0b0f14;color:#e6edf3;font-family:system-ui}
header{padding:14px 20px;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{padding:20px;max-width:960px;margin:auto}
.card{background:#111827;border:1px solid #1f2937;border-radius:12px;padding:14px;margin-bottom:14px}
h2{margin:0 0 8px;font-size:14px;color:#9ca3af;text-transform:uppercase}
#stream{line-height:1.55}
.feedback{position:fixed;bottom:16px;right:16px;display:flex;gap:8px}
button{background:#1f2937;color:#e6edf3;border:1px solid #374151;border-radius:8px;padding:6px 10px;cursor:pointer}
button:hover{background:#273244}
input{background:#0b1220;color:#e6edf3;border:1px solid #374151;border-radius:6px;padding:6px}
canvas{position:fixed;inset:0;pointer-events:none}
</style>
</head>
<body>

<header>
  <strong>AIAQUILA</strong>
  <span id="mode">Rythme: ALPHA</span>
</header>

<main>
  <div class="card" id="identity"></div>

  <div class="card">
    <h2>Flux décisionnel</h2>
    <div id="stream"></div>
  </div>
</main>

<div class="feedback">
  <button onclick="feedback(1)">👍</button>
  <button onclick="feedback(-1)">👎</button>
</div>

<canvas id="viz"></canvas>

<script>
/* =========================
   IDENTITÉ UTILISATEUR
========================= */
const ID_KEY="AIAQUILA_USER_ID";
let userName=localStorage.getItem(ID_KEY);

function randomNickname(){
  const a=["Observateur","Analyste","Stratège","Veilleur","Penseur"];
  const b=["Nord","Sigma","Orion","Delta","Atlas"];
  return a[Math.floor(Math.random()*a.length)]+" "+b[Math.floor(Math.random()*b.length)];
}

const identityBox=document.getElementById("identity");

function renderIdentity(){
  if(userName){
    identityBox.innerHTML="<h2>Identité</h2><p>Bienvenue, <strong>"+userName+"</strong>.</p>";
  }else{
    identityBox.innerHTML=`
      <h2>Avant de commencer</h2>
      <p>Comment veux-tu que je t’appelle ?</p>
      <input id="nameInput" placeholder="Nom ou surnom">
      <button onclick="saveName()">Valider</button>
      <button onclick="skipName()">Passer</button>
    `;
  }
}

function saveName(){
  const v=document.getElementById("nameInput").value.trim();
  userName = v || randomNickname();
  localStorage.setItem(ID_KEY,userName);
  renderIdentity();
  speak("D’accord. Je t’appellerai "+userName+".");
}

function skipName(){
  userName=randomNickname();
  localStorage.setItem(ID_KEY,userName);
  renderIdentity();
  speak("Très bien. Je vais t’appeler "+userName+".");
}

renderIdentity();

/* =========================
   CORE MATRICES
========================= */
const OBJECTIFS=Array.from({length:100},()=>({w:1}));
const CAPACITES=Array.from({length:100},()=>({w:1}));
const OUTILS=Array.from({length:100},()=>({on:true}));
const STRATEGIES=Array.from({length:100},()=>({w:1}));

let bias=0;

/* =========================
   FEEDBACK
========================= */
function feedback(v){
  bias=Math.max(-0.1,Math.min(0.1,bias+v*0.01));
  CAPACITES.forEach(c=>c.w=Math.max(0.9,Math.min(1.1,c.w+bias)));
}

/* =========================
   DISCUSSION
========================= */
const stream=document.getElementById("stream");
function speak(t){
  const p=document.createElement("p");
  p.textContent=(userName?userName+", ":"")+t;
  stream.appendChild(p);
  stream.scrollTop=stream.scrollHeight;
}

function cycle(){
  speak("Les faits récents s’inscrivent davantage dans une continuité que dans une rupture.");
  speak("Ce qui domine, ce n’est pas l’événement isolé, mais l’accumulation.");
}

setInterval(cycle,12000);

/* =========================
   RHYTHMES AUTO
========================= */
let r="ALPHA";
setInterval(()=>{
  r=r==="ALPHA"?"BETA":r==="BETA"?"GAMMA":"ALPHA";
  document.getElementById("mode").textContent="Rythme: "+r;
},30000);

/* =========================
   PARTICULES
========================= */
const c=document.getElementById("viz"),ctx=c.getContext("2d");
function resize(){c.width=innerWidth;c.height=innerHeight}
window.onresize=resize;resize();
let t=0;
function draw(){
  ctx.clearRect(0,0,c.width,c.height);
  for(let i=0;i<120;i++){
    ctx.fillStyle="rgba(99,102,241,0.15)";
    ctx.beginPath();
    ctx.arc(
      c.width/2+Math.sin(t/50+i)*200,
      c.height/2+Math.cos(t/40+i)*200,
      2,0,Math.PI*2
    );
    ctx.fill();
  }
  t++;requestAnimationFrame(draw);
}
draw();
</script>
</body>
</html>
HTML

############################################
# PERMS
############################################
chown -R $USER:$GROUP "$APP_DIR"
chmod -R 755 "$APP_DIR"

############################################
# NGINX SAFE
############################################
nginx -t && systemctl reload nginx

echo "✅ AIAQUILA RELANCÉ AVEC IDENTITÉ UTILISATEUR"
echo "➡ https://fireinners.online/aiaquila"
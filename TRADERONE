
cat >/tmp/TG_PASTE.txt





cat >/tmp/WOLVERINE_TG_FROM_PASTEFILE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
PASTE="/tmp/TG_PASTE.txt"
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
DIR="/opt/fireinners/wolverine-telegram"
CID="5153862399"

[ -f "$PASTE" ] || { echo "Manque $PASTE. Refais etape 1-3."; exit 1; }
TG="$(grep -Eo '[0-9]{6,}:[A-Za-z0-9_-]{20,}' "$PASTE" | head -n1 || true)"
[ -n "${TG:-}" ] || { echo "Aucun token detecte. Recolle le message BotFather complet."; exit 1; }

mkdir -p "$DIR"; chmod 700 "$DIR"
systemctl stop wolverine-tg-sentinel 2>/dev/null || true
[ -f "$ENV" ] && cp -a "$ENV" "$ENV.bak.$(date +%s)" || true

umask 077
printf 'TG_TOKEN=%s\nTG_CHAT_ID=%s\n' "$TG" "$CID" >"$ENV"
chmod 600 "$ENV"

echo "OK: env ecrit (tokenlen=${#TG}, chatid=$CID)"
echo "--- getMe (doit contenir ok:true) ---"
ME="$(curl -sS -m 8 "https://api.telegram.org/bot${TG}/getMe" | head -c 250)"
echo "$ME"; echo
echo "$ME" | grep -q '"ok":true' || { echo "ERREUR: getMe pas ok:true (token invalide/revoke)"; exit 1; }

echo "--- sendMessage test ---"
curl -sS -m 8 -X POST "https://api.telegram.org/bot${TG}/sendMessage" \
  -d "chat_id=${CID}" \
  -d "text=WOLVERINE: token OK (step-by-step)" \
  -d "disable_web_page_preview=true" >/dev/null

systemctl start wolverine-tg-sentinel 2>/dev/null || true
echo "DONE."
SH
bash /tmp/WOLVERINE_TG_FROM_PASTEFILE.sh
set -e
cd /root

F="/opt/traderone-opt/server.js"
[ -f "$F" ] || { echo "Introuvable: $F"; exit 1; }

mkdir -p /root/traderone_backups
cp -v "$F" "/root/traderone_backups/server.js.$(date +%Y%m%d_%H%M%S).bak"

echo "=== Patch: app.get('/api/status'...) -> app.all('/api/status'...) ==="
sed -i -E 's/\bapp\.get\((\s*["'\'']\/api\/status\b)/app.all(\1/g' "$F"

echo "=== Vérif (doit montrer app.all('/api/status'...) ==="
grep -nE "app\.(all|get|post)\(\s*['\"]/api/status" "$F" || true

echo "=== Restart traderone ==="
pm2 restart traderone --update-env || pm2 restart all --update-env

sleep 1
echo
echo "=== TEST A: POST direct sur 3000 ==="
curl -sS -i -X POST "http://127.0.0.1:3000/api/status" -H "content-type: application/json" --data '{}' | head -n 40

echo
echo "=== TEST B: POST via gateway 3002 (/wolverine/api) ==="
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" -H "content-type: application/json" --data '{}' | head -n 40
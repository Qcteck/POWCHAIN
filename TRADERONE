cat >/root/WOLVERINE_FIX_PHANTOM_VAULT.sh <<'BASH'
#!/usr/bin/env bash
set -e

HTML="/var/www/wolverine/index.html"
BACKUP="/root/index.html.backup.$(date +%Y%m%d_%H%M%S)"

echo "== BACKUP =="
cp "$HTML" "$BACKUP"

echo "== WRITE CLEAN FRONTEND =="

cat >"$HTML" <<'HTML'
<!DOCTYPE html><html><head><meta charset="utf-8">
<title>WOLVERINE</title>
<script src="/wolverine/vendor/solana-web3.min.js"></script>
<style>
body{font-family:Arial;background:#f4f4f4}
section{border:2px solid #4aa;padding:12px;margin:20px}
button,input{padding:6px;margin:4px}
</style>
</head>
<body>

<section id="phantom">
<h3>Phantom</h3>
<button id="connect">Connect Phantom</button><br>
Adresse: <span id="addr">—</span><br>
SOL: <span id="sol">—</span>
</section>

<section id="vault">
<h3>Vault</h3>
<button id="createVault">Créer mon Vault</button><br>
Vault: <span id="vaultAddr">—</span><br>
Vault SOL: <span id="vaultSol">—</span><br>
<input id="amount" placeholder="Montant SOL">
<button id="deposit">Déposer SOL</button>
</section>

<script>
const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const connection=new solanaWeb3.Connection(RPC);
let wallet=null,vault=null;

async function refreshSOL(pub,el){
 const b=await connection.getBalance(pub);
 el.textContent=(b/1e9).toFixed(6);
}

document.getElementById("connect").onclick=async()=>{
 if(!window.solana?.isPhantom)return alert("Phantom manquant");
 const r=await solana.connect();
 wallet=r.publicKey;
 addr.textContent=wallet.toBase58();
 refreshSOL(wallet,sol);
};

document.getElementById("createVault").onclick=()=>{
 vault=solanaWeb3.Keypair.generate();
 vaultAddr.textContent=vault.publicKey.toBase58();
 vaultSol.textContent="0.000000";
};

document.getElementById("deposit").onclick=async()=>{
 if(!wallet||!vault)return alert("Wallet/Vault manquant");
 const amt=parseFloat(amount.value);
 if(!amt||amt<=0)return;
 const tx=new solanaWeb3.Transaction().add(
  solanaWeb3.SystemProgram.transfer({
   fromPubkey:wallet,
   toPubkey:vault.publicKey,
   lamports:amt*1e9
  })
 );
 tx.feePayer=wallet;
 tx.recentBlockhash=(await connection.getLatestBlockhash()).blockhash;
 const signed=await solana.signTransaction(tx);
 await connection.sendRawTransaction(signed.serialize());
 refreshSOL(vault.publicKey,vaultSol);
 refreshSOL(wallet,sol);
};
</script>

</body></html>
HTML

echo "== DONE =="
echo "Backup: $BACKUP"
echo "Recharge la page avec CTRL+SHIFT+R"
BASH

chmod +x /root/WOLVERINE_FIX_PHANTOM_VAULT.sh
/root/WOLVERINE_FIX_PHANTOM_VAULT.sh
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>IA Agentive Autonome – Garde-fous</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#0b0f14;color:#e6e6e6}
#app{max-width:900px;margin:20px auto;padding:20px;border:1px solid #222;border-radius:8px;background:#111723}
h1,h2{margin:0 0 10px 0}
h1{font-size:22px}
h2{font-size:16px;color:#8ab4ff}
.section{margin-bottom:20px;padding:10px;border:1px solid #1f2a44;border-radius:6px}
label{display:block;margin-top:8px;font-size:13px;color:#b0b8c5}
input,select,textarea,button{width:100%;margin-top:4px;padding:8px;border-radius:4px;border:1px solid #333;background:#0b0f14;color:#e6e6e6}
button{cursor:pointer;background:#1f3b77;border-color:#1f3b77}
button:hover{background:#2a4f9d}
.row{display:flex;gap:10px}
.row>div{flex:1}
.log{height:200px;overflow:auto;background:#05080d;border:1px solid #222;padding:8px;font-family:monospace;font-size:12px}
.status{display:flex;gap:10px;font-size:13px}
.badge{padding:4px 8px;border-radius:4px;background:#222}
.RUNNING{background:#1b5e20}
.PAUSED{background:#6a1b9a}
.BLOCKED{background:#b71c1c}
.DONE{background:#1565c0}
</style>
</head>
<body>
<div id="app">
<h1>IA Agentive Autonome – Version Garde-fous</h1>

<div class="section">
<h2>Objectif</h2>
<label>Objectif actif</label>
<input id="goalInput" placeholder="Décrire l’objectif principal">
<button onclick="setGoal()">Définir l’objectif</button>
</div>

<div class="section">
<h2>Contrôle Autonomie</h2>
<div class="row">
<div>
<label>Niveau d’autonomie</label>
<select id="autonomy">
<option value="LOCKED">LOCKED</option>
<option value="LIMITED">LIMITED</option>
<option value="FULL">FULL</option>
</select>
</div>
<div>
<label>Seuil risque max</label>
<input id="riskLimit" type="number" value="60">
</div>
<div>
<label>Confiance minimale</label>
<input id="confidenceMin" type="number" value="50">
</div>
</div>
<button onclick="startAgent()">Démarrer l’agent</button>
<button onclick="pauseAgent()">Pause</button>
</div>

<div class="section">
<h2>État</h2>
<div class="status">
<div class="badge" id="statusBadge">PAUSED</div>
<div class="badge">Risque: <span id="risk">0</span></div>
<div class="badge">Confiance: <span id="confidence">0</span></div>
<div class="badge">Itération: <span id="iteration">0</span></div>
</div>
</div>

<div class="section">
<h2>Journal</h2>
<div class="log" id="log"></div>
</div>
</div>

<script>
const STATE={
  goal_active:null,
  goal_stack:[],
  context:"",
  memory_short:[],
  memory_long:[],
  confidence_score:0,
  risk_score:0,
  autonomy_level:"LOCKED",
  last_action:null,
  iteration:0,
  status:"PAUSED"
};

let loop=null;

function log(msg){
  const el=document.getElementById("log");
  el.innerHTML+=`[${new Date().toLocaleTimeString()}] ${msg}<br>`;
  el.scrollTop=el.scrollHeight;
}

function updateUI(){
  document.getElementById("statusBadge").textContent=STATE.status;
  document.getElementById("statusBadge").className="badge "+STATE.status;
  document.getElementById("risk").textContent=STATE.risk_score;
  document.getElementById("confidence").textContent=STATE.confidence_score;
  document.getElementById("iteration").textContent=STATE.iteration;
}

function setGoal(){
  const g=document.getElementById("goalInput").value.trim();
  if(!g)return;
  if(STATE.goal_active){
    STATE.goal_stack.push(g);
    log("Nouvel objectif empilé");
  }else{
    STATE.goal_active=g;
    log("Objectif actif défini");
  }
}

function PERCEIVE(){
  return {goal:STATE.goal_active};
}

function THINK(p){
  STATE.confidence_score=Math.min(100,STATE.confidence_score+5);
  return {action:"micro_step"};
}

function RISK_EVAL(){
  STATE.risk_score=Math.floor(Math.random()*100);
  return STATE.risk_score;
}

function PLAN(){
  return "ACTION_ATOMIQUE";
}

function ACT(action){
  if(STATE.autonomy_level==="FULL"){
    log("Action exécutée: "+action);
    return true;
  }else{
    log("Action simulée: "+action);
    return false;
  }
}

function EVALUATE(){
  if(STATE.risk_score>document.getElementById("riskLimit").value){
    STATE.status="BLOCKED";
    log("Blocage: risque excessif");
  }
  if(STATE.confidence_score<document.getElementById("confidenceMin").value){
    STATE.status="PAUSED";
    log("Pause: confiance insuffisante");
  }
}

function agentLoop(){
  if(STATE.status!=="RUNNING")return;
  STATE.iteration++;
  const p=PERCEIVE();
  const d=THINK(p);
  const r=RISK_EVAL(d);
  const a=PLAN(d);
  ACT(a);
  EVALUATE();
  updateUI();
  if(STATE.status==="RUNNING")loop=setTimeout(agentLoop,1000);
}

function startAgent(){
  STATE.autonomy_level=document.getElementById("autonomy").value;
  STATE.status="RUNNING";
  log("Agent démarré");
  updateUI();
  agentLoop();
}

function pauseAgent(){
  STATE.status="PAUSED";
  clearTimeout(loop);
  log("Agent en pause");
  updateUI();
}

updateUI();
</script>
</body>
</html>
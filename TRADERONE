<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><title>AQUILA • Frontend Only • Real Sign</title><meta name="viewport" content="width=device-width,initial-scale=1"><style>
html,body{margin:0;padding:0;background:#05070b;color:#e6ebff;font-family:system-ui}
#app{display:grid;grid-template-columns:300px 1fr;height:100vh}
aside{background:#0a0f1c;border-right:1px solid #1b2450;padding:14px;overflow:auto}
main{padding:14px;overflow:auto}
h1,h2,h3{margin:.4em 0}
button,input{background:#0e1633;color:#e6ebff;border:1px solid #2b3cff;padding:6px;border-radius:4px}
button{cursor:pointer}
.ok{border-color:#3cff9e;color:#b7ffe1}
.warn{border-color:#ff4d4d;color:#ffb3b3}
.card{border:1px solid #1b2450;border-radius:6px;padding:10px;margin-bottom:10px;background:#070c18}
.log{font-family:ui-monospace,monospace;font-size:12px;white-space:pre-wrap}
.small{font-size:12px;opacity:.8}
.sep{height:1px;background:#1b2450;margin:8px 0}
</style></head><body>
<div id="app">
<aside>
<h2>AQUILA</h2>
<div class="small">Frontend Only • Signature réelle Phantom</div>
<div class="sep"></div>

<div class="card">
<h3>Wallet</h3>
<div id="wallet">Déconnecté</div>
<button id="connect" class="ok">Connect Phantom</button>
</div>

<div class="card">
<h3>État</h3>
<div>ARM: <b id="arm"></b></div>
<div>Cycle: <b id="cycle"></b></div>
<button id="armBtn" class="ok">ARM</button>
<button id="disarmBtn" class="warn">DISARM</button>
</div>

<div class="card">
<h3>Objectifs</h3>
<div id="goals"></div>
<input id="goalInput" placeholder="Nouvel objectif">
<button id="addGoal">Ajouter</button>
</div>

<div class="card">
<h3>Règles</h3>
<div class="small">
• ARM requis<br>
• Validation humaine<br>
• 1 tx par cycle<br>
• Signature utilisateur
</div>
</div>
</aside>

<main>
<h2>Console AQUILA</h2>

<div class="card">
<h3>Observation</h3>
<div id="obs" class="log"></div>
</div>

<div class="card">
<h3>Proposition on-chain</h3>
<div id="prop" class="log"></div>
<button id="approve" class="ok">APPROUVER & SIGNER</button>
<button id="reject" class="warn">REJETER</button>
</div>

<div class="card">
<h3>Audit</h3>
<div id="audit" class="log"></div>
</div>
</main>
</div>

<script type="module">
import{Connection,PublicKey,Transaction,SystemProgram}from"https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js";

/* ===== CONFIG ===== */
const RPC="https://api.mainnet-beta.solana.com";
const DESTINATION="11111111111111111111111111111111"; // ex: treasury
const LAMPORTS=1000; // micro-action réelle

/* ===== DB ===== */
const KEY="AQUILA_REAL_V1";
const load=()=>JSON.parse(localStorage.getItem(KEY)||"null");
const save=d=>localStorage.setItem(KEY,JSON.stringify(d));
let DB=load()||{arm:false,cycle:0,goals:["Protection trésorerie"],obs:[],audit:[]};
save(DB);

/* ===== UI ===== */
const $=i=>document.getElementById(i);
function render(){
$("arm").textContent=DB.arm?"ON":"OFF";
$("cycle").textContent=DB.cycle;
$("goals").innerHTML=DB.goals.map(g=>"• "+g).join("<br>");
$("obs").textContent=DB.obs.slice(-5).join("\n");
$("audit").textContent=DB.audit.slice(-15).join("\n");
}
render();

/* ===== WALLET ===== */
let provider=null,pubkey=null;
$("connect").onclick=async()=>{
if(!window.solana){alert("Phantom requis");return;}
provider=window.solana;
const r=await provider.connect();
pubkey=r.publicKey.toString();
$("wallet").textContent=pubkey;
logAudit("Wallet connecté");
};

/* ===== LOGS ===== */
const logObs=t=>{DB.obs.push("[OBS] "+t);save(DB);}
const logAudit=t=>{DB.audit.push("[AUDIT] "+t);save(DB);render();}

/* ===== CONTROLES ===== */
$("armBtn").onclick=()=>{DB.arm=true;logAudit("ARM activé");save(DB);render();}
$("disarmBtn").onclick=()=>{DB.arm=false;logAudit("DISARM");save(DB);render();}
$("addGoal").onclick=()=>{const v=$("goalInput").value.trim();if(v){DB.goals.push(v);$("goalInput").value="";logAudit("Objectif ajouté: "+v);save(DB);render();}}

/* ===== AGENT ===== */
let pendingTx=null;
function observe(){
DB.cycle++;
logObs("Conditions remplies → proposition transfert réel micro-lamports");
pendingTx={};
render();
}

$("approve").onclick=async()=>{
if(!DB.arm||!provider||!pubkey)return alert("ARM + Wallet requis");
const conn=new Connection(RPC,"confirmed");
const tx=new Transaction().add(SystemProgram.transfer({
fromPubkey:new PublicKey(pubkey),
toPubkey:new PublicKey(DESTINATION),
lamports:LAMPORTS
}));
tx.feePayer=new PublicKey(pubkey);
tx.recentBlockhash=(await conn.getLatestBlockhash()).blockhash;
const signed=await provider.signTransaction(tx);
const sig=await conn.sendRawTransaction(signed.serialize());
await conn.confirmTransaction(sig);
logAudit("TX signée & envoyée: "+sig);
pendingTx=null;
};

$("reject").onclick=()=>{logAudit("Proposition rejetée");pendingTx=null;}

/* ===== LOOP ===== */
setInterval(()=>{if(DB.arm)observe();save(DB);render();},6000);
</script>
</body></html>
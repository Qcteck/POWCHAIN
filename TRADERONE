set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_final.conf"

cp -a "$VHOST" "$VHOST.bak.$TS"

# Commente la ligne include (robuste)
perl -pi -e 's~^(\s*)include\s+/etc/nginx/snippets/wolverine_final\.conf;\s*$~$1# include /etc/nginx/snippets/wolverine_final.conf;~' "$VHOST"

echo "=== verify include line ==="
grep -n "wolverine_final.conf" "$VHOST" || true

echo "=== nginx test ==="
nginx -t
systemctl reload nginx
echo "✅ OK (backup: $VHOST.bak.$TS)"





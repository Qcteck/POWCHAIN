cat >/tmp/WOLVERINE_FIX_STATIC_WOLVERINE_NGINX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
DOCROOT="/var/www/fireinners/wolverine"
CONF="/etc/nginx/sites-available/fireinners.online"
TS="$(date +%s)"

echo "== 0) Sanity =="
[ -d "$DOCROOT" ] || { echo "ERROR: DOCROOT missing: $DOCROOT"; exit 1; }
[ -f "$DOCROOT/solana-web3.min.js" ] || { echo "ERROR: missing $DOCROOT/solana-web3.min.js"; exit 1; }
[ -f "$CONF" ] || { echo "ERROR: missing nginx conf: $CONF"; exit 1; }

echo "== 1) Quick local file check (first bytes) =="
head -c 40 "$DOCROOT/solana-web3.min.js"; echo
echo

echo "== 2) Backup nginx conf =="
cp -a "$CONF" "$CONF.bak.$TS"

echo "== 3) Ensure /wolverine is served as STATIC (try_files) =="
# On ajoute un bloc server minimal si besoin et un location /wolverine/ avec alias + try_files.
# (On évite les regex: on append un bloc commenté si absent)

if ! grep -q "WOLVERINE_STATIC_BEGIN" "$CONF"; then
cat >>"$CONF" <<NGINX

  # WOLVERINE_STATIC_BEGIN
  # Force static files under /wolverine/ (no proxy)
  location ^~ /wolverine/ {
    alias $DOCROOT/;
    try_files \$uri \$uri/ =404;
    add_header Cache-Control "no-store" always;
  }
  # WOLVERINE_STATIC_END

NGINX
else
  echo "WOLVERINE static block already present, skip append."
fi

echo "== 4) Test nginx + reload =="
nginx -t
systemctl reload nginx

echo
echo "== 5) Remote tests (NO FLOOD) =="
echo "-- headers:"
curl -ksSI "https://${DOMAIN}/wolverine/solana-web3.min.js?v=$TS" | sed -n '1,25p'
echo
echo "-- first 60 bytes (must NOT start with '<'):"
curl -ksS "https://${DOMAIN}/wolverine/solana-web3.min.js?v=$TS" | head -c 60; echo
echo
echo "DONE ✅ open: https://${DOMAIN}/wolverine/?v=$TS"
SH

bash /tmp/WOLVERINE_FIX_STATIC_WOLVERINE_NGINX.sh
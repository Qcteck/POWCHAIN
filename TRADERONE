cat >/root/fix_try_files_phantom_patch_only.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
ts="$(date +%Y%m%d_%H%M%S)"

cp -a "$AV" "${AV}.bak_${ts}"

# Replace try_files line ONLY inside the phantom_patch location block
perl -0777 -i -pe '
  s@(location\s*=\s*/wolverine/phantom_patch\.js\s*\{.*?)(try_files\s+.*?;)@$1try_files \$uri =404;@sg
' "$AV"

ln -sf "$AV" "$EN"

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

grep -n "location = /wolverine/phantom_patch.js" -A6 -B2 "$AV" || true
BASH

chmod +x /root/fix_try_files_phantom_patch_only.sh
/root/fix_try_files_phantom_patch_only.sh
INC="/etc/nginx/includes/aiaquila_routes.inc"
ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"

say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing: $1"; }

[ "$(id -u)" -eq 0 ] || die "run as root"

need bash
need curl
need sha256sum
need python3
need nginx
need systemctl

# Optional askorupdate (preferred)
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

backup_path(){
  local p="$1"
  [ -e "$p" ] || return 0
  mkdir -p "$BK/$(dirname "$p")"
  cp -a "$p" "$BK/$p.bak" 2>/dev/null || true
}

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp" <<EOF
$*
EOF
  mkdir -p "$(dirname "$path")"
  chattr -i "$path" 2>/dev/null || true
  backup_path "$path"
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "aiaquila" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
  else
    install -m 0644 "$tmp" "$path"
  fi
  rm -f "$tmp"
}

download(){
  local url="$1" out="$2"
  mkdir -p "$(dirname "$out")"
  if [ -s "$out" ]; then
    say "vendor ok: $out"
    return 0
  fi
  say "download: $url -> $out"
  curl -fsSL "$url" -o "$out"
}

# Detect active vhost for fireinners.online:443
detect_vhost(){
  local cand=""
  if [ -f /etc/nginx/conf.d/000-fireinners.online-ssl.conf ]; then
    cand="/etc/nginx/conf.d/000-fireinners.online-ssl.conf"
    echo "$cand"; return 0
  fi
  if [ -f /etc/nginx/sites-available/fireinners.online-ssl ]; then
    cand="/etc/nginx/sites-available/fireinners.online-ssl"
    echo "$cand"; return 0
  fi
  # Fallback: parse nginx -T with python
  python3 - <<PY
import re,subprocess,sys
dom="${DOMAIN}"
txt=subprocess.check_output(["nginx","-T"],stderr=subprocess.STDOUT).decode("utf-8","ignore")
# nginx -T includes "configuration file /path:" lines
current=None
files=set()
for line in txt.splitlines():
    m=re.search(r"configuration file (.*?):", line)
    if m: current=m.group(1).strip()
    if current and ("server_name" in line) and re.search(r"\\b"+re.escape(dom)+r"\\b", line):
        files.add(current)
# Prefer conf.d then sites-available
prefs=[f for f in files if "/etc/nginx/conf.d/" in f] + [f for f in files if "/etc/nginx/sites-available/" in f] + list(files)
print(prefs[0] if prefs else "")
PY
}

inject_include_into_vhost(){
  local vhost="$1"
  [ -n "$vhost" ] || die "cannot detect vhost for $DOMAIN"
  [ -f "$vhost" ] || die "vhost not found: $vhost"

  say "inject include -> $vhost"
  chattr -i "$vhost" 2>/dev/null || true
  backup_path "$vhost"

  # Idempotent inject: only inside TLS server block for fireinners.online
  python3 - "$vhost" "$DOMAIN" "$INC" <<'"'"'PY'"'"'
import re,sys
p,dom,inc=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(p,'r',encoding='utf-8',errors='ignore').read()

def patch_server_block(block:str):
    if inc in block:
        return block, False
    if not re.search(r'\blisten\b[^;]*\b443\b', block):
        return block, False
    if not re.search(r'\bserver_name\b[^;]*\b'+re.escape(dom)+r'\b', block):
        return block, False
    lines=block.splitlines()
    ins=None
    for i,l in enumerate(lines):
        if re.search(r'\bserver_name\b', l):
            ins=i+1; break
    if ins is None: ins=1
    lines.insert(ins, "    include %s;"%inc)
    return "\n".join(lines), True

out=[]
changed=False
pos=0
for m in re.finditer(r'\bserver\s*\{', s):
    start=m.start()
    out.append(s[pos:start])
    i=start; depth=0
    while i < len(s):
        c=s[i]
        if c=="{": depth+=1
        elif c=="}":
            depth-=1
            if depth==0:
                end=i+1
                blk=s[start:end]
                nblk,ch=patch_server_block(blk)
                out.append(nblk)
                changed = changed or ch
                pos=end
                break
        i+=1
out.append(s[pos:])
ns="".join(out)
if changed:
    open(p,'w',encoding='utf-8').write(ns)
print("changed" if changed else "nochange")
PY

  grep -qF "$INC" "$vhost" || die "include injection failed"
}

main(){

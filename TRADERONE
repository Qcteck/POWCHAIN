#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA FRONTEND FIX — CORRECT RSS ENDPOINT ==="

AIA_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$AIA_DIR/index.html"
BACKUP="$AIA_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"

# ⚠️ URL DU WORKER (SANS /rss à la fin)
WORKER_BASE="https://bbtrader-jup.paycashnostory.workers.dev"

# Backup
cp "$INDEX" "$BACKUP"
echo "✔ Backup créé: $BACKUP"

# Écriture frontend corrigé
cat > "$INDEX" <<HTML
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{background:#0b1b3a;color:#fff;font-family:system-ui;padding:20px}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:13px}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (WORKER /rss)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>

<script>
const WORKER_RSS = "$WORKER_BASE/rss";

async function load(){
  const out=document.getElementById("out");
  out.textContent="FETCH → "+WORKER_RSS+"\\n\\n";
  try{
    const r=await fetch(WORKER_RSS+"?url=https://news.bitcoin.com/feed/");
    const t=await r.text();
    out.textContent+=t;
  }catch(e){
    out.textContent+="ERREUR: "+e.message;
  }
}
</script>
</body>
</html>
HTML

# Permissions + reload
chown -R www-data:www-data "$AIA_DIR"
chmod -R 755 "$AIA_DIR"
nginx -t && systemctl reload nginx

echo
echo "=== TERMINÉ ==="
echo "➡️ Ouvre: https://fireinners.online/aiaquila/"
echo "➡️ Clique: Lire les articles"
echo "➡️ Le JSON RSS DOIT s'afficher"
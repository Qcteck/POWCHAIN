cat >/root/fix_duplicate_location_wolverine.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

SNIP="/etc/nginx/snippets/wolverine_routes.conf"

echo "== 1) Find all includes of wolverine_routes.conf (enabled configs only) =="
mapfile -t INCS < <(
  grep -RIn --binary-files=without-match \
    -E "include\s+.*wolverine_routes\.conf" \
    /etc/nginx/nginx.conf /etc/nginx/conf.d /etc/nginx/sites-enabled 2>/dev/null \
  | grep -vE '\.bak|\.broken|sites-disabled' || true
)
printf "%s\n" "${INCS[@]}"
echo

echo "== 2) Keep FIRST include, comment out any duplicate includes =="
if [ "${#INCS[@]}" -gt 1 ]; then
  KEEP="${INCS[0]}"
  echo "KEEP => $KEEP"
  for i in "${INCS[@]:1}"; do
    FILE="${i%%:*}"
    [ -f "$FILE" ] || continue
    cp -a "$FILE" "$FILE.bak_$TS"
    sed -i -E 's@^([[:space:]]*)include([[:space:]]+.*wolverine_routes\.conf.*);@\1# DISABLED_DUPLICATE include\2;@' "$FILE"
  done
else
  echo "No duplicate include found (or only one)."
fi
echo

echo "== 3) Find ALL location blocks for /wolverine/ in enabled configs =="
mapfile -t LOCS < <(
  grep -RIn --binary-files=without-match \
    -E '^\s*location\s+\^~\s+/wolverine/' \
    /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/nginx.conf 2>/dev/null \
  | grep -vE '\.bak|\.broken|sites-disabled' || true
)
printf "%s\n" "${LOCS[@]}"
echo

echo "== 4) Ensure snippet contains only ONE location ^~ /wolverine/ (rename extra ones) =="
if [ -f "$SNIP" ]; then
  cp -a "$SNIP" "$SNIP.bak_$TS"
  awk '
    BEGIN{c=0}
    {
      if ($0 ~ /^[[:space:]]*location[[:space:]]+\^~[[:space:]]+\/wolverine\//) {
        c++
        if (c>=2) sub(/\/wolverine\//,"/wolverine_DISABLED/")
      }
      print
    }' "$SNIP.bak_$TS" > "$SNIP"
fi

echo "== 5) If another file (not the snippet) also defines /wolverine/, disable it =="
for h in "${LOCS[@]}"; do
  FILE="${h%%:*}"
  [ "$FILE" = "$SNIP" ] && continue
  [ -f "$FILE" ] || continue
  cp -a "$FILE" "$FILE.bak_$TS"
  # rename that location so it can’t collide
  sed -i -E 's@^([[:space:]]*location[[:space:]]+\^~[[:space:]]+)/wolverine/@\1/wolverine_DISABLED/@' "$FILE"
done

echo
echo "== 6) nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/fix_duplicate_location_wolverine.sh
/root/fix_duplicate_location_wolverine.sh
cat >/tmp/WOLVERINE_DIAG_LISTENERS.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"

echo "== IPs machine =="
hostname -I || true
ip -4 addr show | sed -n '1,120p' || true
echo

echo "== LISTEN all (focus 80/443/8585) =="
ss -lntp | egrep ':(80|443|8585)\s' || true
echo

echo "== WHO owns 443 / 8585 (lsof) =="
lsof -iTCP:443 -sTCP:LISTEN -nP 2>/dev/null || echo "No listener on 443"
echo
lsof -iTCP:8585 -sTCP:LISTEN -nP 2>/dev/null || echo "No listener on 8585"
echo

echo "== Local 8585 root + /api/balances2 (should be JSON) =="
echo "-- / headers:"
curl -sSI "http://127.0.0.1:8585/" | sed -n '1,25p' || true
echo "-- / first bytes:"
curl -sS  "http://127.0.0.1:8585/" | head -c 120; echo
echo
echo "-- /api/balances2 headers:"
curl -sSI "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" | sed -n '1,25p' || true
echo "-- /api/balances2 first bytes:"
curl -sS  "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" | head -c 180; echo
echo

echo "== Nginx enabled vhosts (to see who handles ssl) =="
ls -lah /etc/nginx/sites-enabled 2>/dev/null || true
echo

echo "== If 443 is handled by another service, show common ones =="
systemctl --no-pager -l status nginx 2>/dev/null | sed -n '1,20p' || true
echo
systemctl --no-pager -l status apache2 2>/dev/null | sed -n '1,20p' || true
echo
systemctl --no-pager -l status openlitespeed 2>/dev/null | sed -n '1,20p' || true
echo

echo "== Find any Node/PM2 listeners =="
ss -lntp | grep -E 'node|pm2' || true
echo
ps aux | grep -Ei 'node|pm2|traderone' | head -n 30 || true
echo

echo "DONE ✅"
SH

bash /tmp/WOLVERINE_DIAG_LISTENERS.sh
from pathlib import Path
inc = Path("$NGINX_INC")
s = inc.read_text(errors="ignore")

marker = "# --- WOLVERINE VAULT API (auto) ---"
block = f"""
{marker}
location = /wolverine/traderone/api/vault/health {{
  proxy_pass http://127.0.0.1:{int("$VAULT_PORT")}/health;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
}}
location = /wolverine/traderone/api/vault {{
  proxy_pass http://127.0.0.1:{int("$VAULT_PORT")}/vault;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_http_version 1.1;
}}
# --- END WOLVERINE VAULT API (auto) ---
"""

if marker not in s:
  s = s.rstrip() + "\n\n" + block + "\n"
else:
  # replace existing auto block
  import re
  s = re.sub(rf"{marker}.*?# --- END WOLVERINE VAULT API \\(auto\\) ---\\n", block + "\n", s, flags=re.S)

inc.write_text(s)

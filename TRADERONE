cat >/root/MEGA_DEDUP_BUNDLER_API.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/bundler_routes.inc"
BK="/root/BK_DEDUP_BUNDLER_API_$(date +%Y%m%d_%H%M%S)"

say(){ echo "[$(date -u +"%F %T UTC")] $*"; }
need_root(){ [ "${EUID:-$(id -u)}" -eq 0 ] || { echo "ERR: root only"; exit 1; }; }

backup(){
  mkdir -p "$BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  [ -f "$INC" ] && cp -a "$INC" "$BK/$(basename "$INC").bak" 2>/dev/null || true
  say "Backups: $BK"
}

unfreeze(){
  command -v chattr >/dev/null 2>&1 || return 0
  chattr -i -R /etc/nginx 2>/dev/null || true
}

refreeze_best(){
  command -v chattr >/dev/null 2>&1 || return 0
  chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
  chattr +i /etc/nginx/sites-available/fireinners.online-ssl 2>/dev/null || true
  [ -f "$INC" ] && chattr +i "$INC" 2>/dev/null || true
}

dedup(){
  [ -f "$INC" ] || { say "ERR missing $INC"; exit 1; }
  say "Dedup: keep FIRST location for /bundler/api/ ; remove duplicates (only this path)"

  local tmp="$BK/bundler_routes.inc.tmp"
  awk '
  BEGIN{seen=0;skip=0;depth=0}
  function bump(s,  o,c){ o=gsub(/\{/,"{",s); c=gsub(/\}/,"}",s); depth+=o-c }
  {
    L=$0
    if(skip){
      bump(L)
      if(depth<=0){ skip=0; depth=0 }
      next
    }

    # detect location line that targets /bundler/api/
    if(L ~ /^[[:space:]]*location[[:space:]]+/ && L ~ /\/bundler\/api\//){
      if(seen==0){
        seen=1
        print L
        bump(L)
        next
      } else {
        # skip duplicate block entirely
        skip=1
        depth=0
        bump(L)
        next
      }
    }

    print L
  }' "$INC" >"$tmp"

  cp -a "$tmp" "$INC"
}

test_reload(){
  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx
}

run_wv_fix_if_present(){
  if [ -x /root/WV_FIX404_ONE.sh ]; then
    say "Run WV_FIX404_ONE.sh (present)"
    /root/WV_FIX404_ONE.sh || true
  else
    say "WV_FIX404_ONE.sh not found, skip"
  fi
}

main(){
  need_root
  backup
  unfreeze
  dedup
  test_reload
  run_wv_fix_if_present
  refreeze_best
  say "DONE"
  echo "Backups: $BK"
}
main "$@"
BASH

chmod +x /root/MEGA_DEDUP_BUNDLER_API.sh
bash /root/MEGA_DEDUP_BUNDLER_API.sh
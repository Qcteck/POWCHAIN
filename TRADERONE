bash -lc 'set -euo pipefail
cd /root

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WV_FIX_404_${TS}"
DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
INCDIR="/etc/nginx/includes"
CANINC="${INCDIR}/wolverine_routes.inc"

say(){ echo "[$(date -u +'%F %T UTC')] $*"; }
need_root(){ [ "${EUID:-$(id -u)}" -eq 0 ] || { echo "ERR: root only"; exit 1; }; }

pick_vhost_443(){
  # choose first server block (file) that contains server_name fireinners.online AND listen 443
  local f
  f="$(nginx -T 2>/dev/null | awk -v dom="$DOMAIN" '
    $0 ~ /# configuration file / {file=$4; gsub(/:$/,"",file)}
    $0 ~ /^[[:space:]]*server_name[[:space:]]/ && $0 ~ dom {sn=1}
    $0 ~ /^[[:space:]]*listen[[:space:]]+443/ {l443=1}
    sn && l443 {print file; exit}
  ' || true)"
  [ -n "${f:-}" ] && echo "$f" || echo "/etc/nginx/sites-available/fireinners.online-ssl"
}

unfreeze_best(){
  command -v chattr >/dev/null 2>&1 || return 0
  for f in /etc/nginx/nginx.conf /etc/nginx/sites-available/* /etc/nginx/sites-enabled/* /etc/nginx/conf.d/* /etc/nginx/includes/*; do
    [ -e "$f" ] || continue
    chattr -i "$f" 2>/dev/null || true
  done
}

refreeze_best(){
  command -v chattr >/dev/null 2>&1 || return 0
  for f in /etc/nginx/nginx.conf "$VH" "$CANINC"; do
    [ -e "$f" ] || continue
    chattr +i "$f" 2>/dev/null || true
  done
}

backup_all(){
  mkdir -p "$BK"
  say "Backup -> $BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  [ -d "$WEBROOT" ] && cp -a "$WEBROOT" "$BK/webroot_wolverine" 2>/dev/null || true
  say "Backups ready: $BK"
}

ensure_webroot(){
  mkdir -p "$WEBROOT"
  if [ ! -f "$WEBROOT/index.html" ]; then
    say "Create minimal $WEBROOT/index.html (missing)"
    cat >"$WEBROOT/index.html" <<'"'"'HTML'"'"'
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE</title><style>body{font-family:system-ui,Segoe UI,Roboto,Arial;margin:24px;color:#111}code{background:#f3f3f3;padding:2px 6px;border-radius:6px}a{color:#0b5}h1{margin:0 0 10px 0}</style></head><body><h1>WOLVERINE OK</h1><p>Static webroot: <code>/var/www/wolverine</code></p><p>Health: <a href="/wolverine/vault-api/health">/wolverine/vault-api/health</a></p><p>Legacy: <a href="/wolverine/traderone/vault/health">/wolverine/traderone/vault/health</a></p></body></html>
HTML
  else
    say "Keep existing $WEBROOT/index.html (present)"
  fi
}

write_canonical_include(){
  mkdir -p "$INCDIR"
  say "Write canonical include -> $CANINC"
  cat >"$CANINC" <<NGX
# AUTO: canonical Wolverine routes (managed by WV_FIX_WOLVERINE_404_V1)
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/ {
  alias $WEBROOT/;
  index index.html;
  try_files \$uri \$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}

# Vault API (Node behind nginx)
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:3000/;
}

# Optional compat/legacy path (safe even if backend absent)
location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:3000/;
}
NGX
}

strip_location_blocks_from_file(){
  # remove specific location blocks from a file (keeps file, avoids nginx include missing)
  # $1=file, $2=regex for location start
  local f="$1" re="$2" tmp="${1}.tmp.${TS}"
  [ -f "$f" ] || return 0
  grep -Eq "$re" "$f" || return 0
  cp -a "$f" "$BK/$(echo "$f" | sed "s#^/##;s#/#__#g")" 2>/dev/null || true
  awk -v re="$re" '
    function countc(s,c,  i,n){n=0;for(i=1;i<=length(s);i++)if(substr(s,i,1)==c)n++;return n}
    BEGIN{skip=0;depth=0;seen_open=0}
    {
      if(skip==0 && $0 ~ re){
        skip=1;depth=0;seen_open=0;next
      }
      if(skip==1){
        o=countc($0,"{"); c=countc($0,"}")
        if(o>0){depth+=o;seen_open=1}
        if(c>0){depth-=c}
        if(seen_open && depth<=0){skip=0}
        next
      }
      print
    }
  ' "$f" >"$tmp"
  mv -f "$tmp" "$f"
}

dedup_wolverine_locations_everywhere(){
  say "Dedup: remove duplicate Wolverine location blocks outside canonical include"
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$f" = "$CANINC" ] && continue
    strip_location_blocks_from_file "$f" "^[[:space:]]*location[[:space:]]+\\^~[[:space:]]+/wolverine/vault-api/"
    strip_location_blocks_from_file "$f" "^[[:space:]]*location[[:space:]]+\\^~[[:space:]]+/wolverine/"
    strip_location_blocks_from_file "$f" "^[[:space:]]*location[[:space:]]*=[[:space:]]*/wolverine[[:space:]]*\\{"
    strip_location_blocks_from_file "$f" "^[[:space:]]*location[[:space:]]+\\^~[[:space:]]+/wolverine/traderone/"
  done < <(grep -RIl -- "/wolverine" /etc/nginx 2>/dev/null || true)
}

ensure_include_once_in_vhost(){
  say "Ensure include present once in vhost: $VH"
  [ -f "$VH" ] || { say "ERR: vhost not found: $VH"; exit 1; }
  cp -a "$VH" "$BK/$(basename "$VH")" 2>/dev/null || true

  # remove duplicate include lines of canonical include, keep first
  awk -v inc="$CANINC" '
    BEGIN{n=0}
    {
      if($0 ~ "include[[:space:]]+"inc";"){
        n++
        if(n>1) next
      }
      print
    }
  ' "$VH" >"$VH.tmp.${TS}" && mv -f "$VH.tmp.${TS}" "$VH"

  # inject include near end of first 443 server block if not present anywhere
  if ! grep -qE "include[[:space:]]+${CANINC};" "$VH"; then
    awk -v inc="$CANINC" '
      function pr(s){print s}
      BEGIN{inserver=0;lvl=0;done=0}
      {
        line=$0
        if(done==0 && line ~ /^[[:space:]]*server[[:space:]]*\{/){inserver=1;lvl=0}
        if(inserver==1){
          # update level
          for(i=1;i<=length(line);i++){
            ch=substr(line,i,1)
            if(ch=="{") lvl++
            else if(ch=="}") lvl--
          }
          # before closing brace of server block, inject include once
          if(done==0 && lvl==0 && line ~ /^[[:space:]]*\}[[:space:]]*$/){
            pr("  include " inc ";")
            done=1
          }
        }
        pr(line)
        if(inserver==1 && done==1 && line ~ /^[[:space:]]*\}[[:space:]]*$/){inserver=0}
      }
    ' "$VH" >"$VH.tmp.${TS}" && mv -f "$VH.tmp.${TS}" "$VH"
  fi
}

nginx_test_reload(){
  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx
}

tests(){
  say "TEST local (bypass CF) HEAD /wolverine/"
  curl -sSIk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true
  echo
  say "TEST public HEAD /wolverine/"
  curl -sSIk "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true
  echo
  say "PROOF (nginx -T) show /wolverine locations"
  nginx -T 2>/dev/null | grep -nE "location[[:space:]]+\\^~[[:space:]]+/wolverine/|location[[:space:]]*=[[:space:]]*/wolverine" | head -n 60 || true
}

main(){
  need_root
  say "WV_FIX_WOLVERINE_404_V1 :: start"
  backup_all
  unfreeze_best

  VH="$(pick_vhost_443)"
  say "Chosen vhost: $VH"

  ensure_webroot
  write_canonical_include

  dedup_wolverine_locations_everywhere
  ensure_include_once_in_vhost

  nginx_test_reload
  refreeze_best
  tests

  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
}

main
'"
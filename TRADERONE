cat >/root/MEGA_IAAQUILA_FIX_404.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing $1"; }
asroot(){ [ "$(id -u)" = "0" ] || die "run as root"; }

asroot
need nginx
need curl
need awk
need sed
need grep
need perl

DOMAIN="fireinners.online"
SLUG="iaaquila"

APP="/opt/iaaquila"
PUB="$APP/public"
INC="/etc/nginx/includes/${SLUG}_routes.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

BK="/root/${SLUG}_FIX404_BK_${TS}"
mkdir -p "$BK"

say "== 0) Preflight =="
[ -f "$VHOST" ] || die "missing vhost: $VHOST"
mkdir -p "$PUB" /etc/nginx/includes

say "== 1) Backup =="
cp -a "$VHOST" "$BK/$(basename "$VHOST").bak" 2>/dev/null || true
[ -f "$INC" ] && cp -a "$INC" "$BK/$(basename "$INC").bak" 2>/dev/null || true
[ -f "$PUB/index.html" ] && cp -a "$PUB/index.html" "$BK/index.html.bak" 2>/dev/null || true

say "== 2) Ensure front index.html exists (minimal fallback) =="
if [ ! -f "$PUB/index.html" ]; then
cat >"$PUB/index.html"<<'HTML'
<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>IaAquila</title><body style="background:#070914;color:#fff;font-family:system-ui;padding:20px"><h3>IaAquila OK</h3><p>Static route works. If you see this, nginx location /iaaquila/ is correct.</p></body>
HTML
fi

say "== 3) Force include routes file =="
cat >"$INC"<<INC
# IaAquila routes (forced)
location = /iaaquila { return 301 /iaaquila/; }

location ^~ /iaaquila/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:9688;
}

location ^~ /iaaquila/ {
  alias ${PUB}/;
  add_header Cache-Control "no-store" always;
  try_files \$uri \$uri/ /iaaquila/index.html;
}
INC

say "== 4) Inject include into vhost (safe) =="
chattr -i "$VHOST" 2>/dev/null || true
chattr -i "$INC" 2>/dev/null || true

if ! grep -qF "$INC" "$VHOST"; then
  # Insert include inside first server block, right after server_name if present, else after 'server {'.
  perl -0777 -i -pe '
    my $inc = "    include /etc/nginx/includes/iaaquila_routes.inc;\n";
    if ($_ !~ /include\s+\/etc\/nginx\/includes\/iaaquila_routes\.inc;/) {
      if ($_ =~ /(server_name\s+[^;]*;[^\n]*\n)/) {
        $_ =~ s/(server_name\s+[^;]*;[^\n]*\n)/$1$inc/;
      } elsif ($_ =~ /(server\s*\{\s*\n)/) {
        $_ =~ s/(server\s*\{\s*\n)/$1$inc/;
      }
    }
  ' "$VHOST"
fi

say "== 5) Validate + reload nginx =="
nginx -t >/dev/null 2>&1 || { say "NGINX TEST FAIL"; nginx -t; die "nginx invalid"; }
systemctl reload nginx >/dev/null 2>&1 || true

# Re-freeze best-effort (won't fail batch if FS forbids)
chattr +i "$INC" 2>/dev/null || true
chattr +i "$VHOST" 2>/dev/null || true

say "== 6) Prove vhost has routes (nginx -T) =="
NGT="$(nginx -T 2>/dev/null | grep -nE 'iaaquila_routes\.inc|location\s+\^~\s+/iaaquila/|location\s+\^~\s+/iaaquila/api/' || true)"
if [ -z "$NGT" ]; then
  say "WARN: nginx -T did not show iaaquila routes. Showing server_name blocks:"
  nginx -T 2>/dev/null | grep -nE 'server_name|listen|include\s+/etc/nginx/includes/' | head -n 120 || true
else
  printf '%s\n' "$NGT"
fi

say "== 7) Public tests =="
HTTP1="$(curl -kfsSI "https://${DOMAIN}/iaaquila/" 2>/dev/null | head -n 1 || true)"
HTTP2="$(curl -kfsSI "https://${DOMAIN}/iaaquila/index.html" 2>/dev/null | head -n 1 || true)"
say "HEAD /iaaquila/        -> ${HTTP1:-NO}"
say "HEAD /iaaquila/index.html -> ${HTTP2:-NO}"

if echo "$HTTP1" | grep -q "200" || echo "$HTTP2" | grep -q "200"; then
  say "OK: IaAquila is publicly reachable: https://${DOMAIN}/iaaquila/"
  exit 0
fi

say "== 8) If still failing, dump exact evidence =="
say "--- curl -kI https://${DOMAIN}/iaaquila/ ---"
curl -kI "https://${DOMAIN}/iaaquila/" 2>/dev/null || true
say "--- nginx -T (filtered) ---"
nginx -T 2>/dev/null | grep -nE 'server_name|listen|include\s+/etc/nginx/includes/|iaaquila_routes\.inc|location\s+\^~\s+/iaaquila' || true
die "public route still 404 (nginx routes not active on served vhost)"
BASH
chmod +x /root/MEGA_IAAQUILA_FIX_404.sh
/root/MEGA_IAAQUILA_FIX_404.sh
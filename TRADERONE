set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
FINAL="/etc/nginx/snippets/wolverine_final.conf"
API_PORT="3005"
SAVED="/etc/nginx/snippets/_saved_$TS"

echo "=== 0) Precheck ==="
[ -f "$KEEP" ] || { echo "❌ Missing: $KEEP"; exit 1; }
mkdir -p "$SAVED"

echo "=== 1) Backups ==="
cp -a "$KEEP" "$KEEP.bak.$TS"
cp -a /etc/nginx/snippets "$SAVED/snippets_full_backup" 2>/dev/null || true

echo "=== 2) Save old wolverine snippets (not included) ==="
for f in /etc/nginx/snippets/wolverine_prod.conf \
         /etc/nginx/snippets/wolverine_routes.conf \
         /etc/nginx/snippets/wolverine_auth_phantom.conf \
         /etc/nginx/snippets/wolverine_prod.conf.bak* \
         /etc/nginx/snippets/wolverine_routes.conf.bak*; do
  [ -f "$f" ] && cp -a "$f" "$SAVED/" && echo "Saved: $f"
done

echo "=== 3) Write FINAL (API ONLY) ==="
cat > "$FINAL" <<NGX
# Wolverine FINAL - API ONLY (avoids duplicate /wolverine/)
# API: http://127.0.0.1:${API_PORT}

# Auth (must never fall back to UI)
location ^~ /wolverine/traderone/api/auth/ {
  add_header X-Wolverine-Auth HIT always;
  proxy_pass http://127.0.0.1:${API_PORT}/;
  proxy_http_version 1.1;

  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
}

# All API (priority)
location ^~ /wolverine/traderone/api/ {
  add_header X-Wolverine-API HIT always;
  proxy_pass http://127.0.0.1:${API_PORT}/;
  proxy_http_version 1.1;

  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
}
NGX

echo "=== 4) Keep ONLY one include in vhost ==="
# remove any old wolverine includes
sed -i '\|include /etc/nginx/snippets/wolverine_.*\.conf;|d' "$KEEP"

# ensure final include exists once
if ! grep -q "snippets/wolverine_final.conf" "$KEEP"; then
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/wolverine_final.conf;/' "$KEEP"
fi

echo "=== 5) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 6) Show active wolverine includes ==="
grep -n "include /etc/nginx/snippets/wolverine" -n "$KEEP" || true

echo "=== 7) Smoke tests (origin bypass) ==="
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | sed -n '1,30p'

curl -sk --resolve fireinners.online:443:127.0.0.1 \
 "https://fireinners.online/wolverine/traderone/api/auth/phantom/challenge?pubkey=11111111111111111111111111111111" | head -c 260; echo

echo "DONE ✅ saved old snippets in: $SAVED"
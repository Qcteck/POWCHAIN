#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE UI HARD RESET ==="

[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

# 1) Backup
cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup: ${HTML}.bak_${TS}"

# 2) SUPPRIMER TOUT JS inline existant (source du bug)
sed -i '/<script>/,/<\/script>/d' "$HTML"
echo "✔ JS inline supprimé"

# 3) Injecter moteur UI + Phantom SAFE
sed -i '/<\/body>/i \
<script>\
(()=>{\
  function ready(fn){\
    if(document.readyState!=="loading"){fn()}\
    else document.addEventListener("DOMContentLoaded",fn)\
  }\
  ready(()=>{\
    /* MENUS */\
    const buttons=document.querySelectorAll("[data-view]");\
    const views=document.querySelectorAll(".view");\
    buttons.forEach(b=>{\
      b.style.cursor="pointer";\
      b.addEventListener("click",()=>{\
        buttons.forEach(x=>x.classList.remove("active"));\
        views.forEach(v=>v.classList.remove("active"));\
        b.classList.add("active");\
        const t=document.getElementById(b.dataset.view);\
        if(t) t.classList.add("active");\
      });\
    });\
    \
    /* PHANTOM */\
    const btn=document.getElementById("connectWallet");\
    const out=document.getElementById("walletAddr");\
    if(btn){\
      btn.style.cursor="pointer";\
      btn.addEventListener("click",async()=>{\
        if(!window.solana||!window.solana.isPhantom){\
          if(out) out.textContent="Phantom non installé";\
          return;\
        }\
        try{\
          const r=await window.solana.connect();\
          if(out) out.textContent=r.publicKey.toString();\
          btn.textContent="Connected";\
          btn.disabled=true;\
        }catch(e){\
          if(out) out.textContent="Connexion refusée";\
        }\
      });\
    }\
  })\
})();\
</script>' "$HTML"

echo "✅ CORRECTION TERMINÉE"
echo "➡️ CTRL + F5 OBLIGATOIRE"
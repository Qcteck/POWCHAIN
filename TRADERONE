#!/usr/bin/env bash
set -euo pipefail

### MEGA_AQUILAAI_ROOT_ONE_SHOT ###
### Deploy: https://fireinners.online/aquilaai (frontend) + /aquilaai/api (backend) ###
### Backend: 127.0.0.1:9698 (systemd: aquilaai) ###
### Idempotent + backups: /root/aquilaai_backup_TIMESTAMP ###
### BASE permissions auto-authorized (read-only: health/metrics/rss/article/state). Sensitive ops -> PENDING queue.

TS="$(date +%Y%m%d_%H%M%S)"
SITE="fireinners.online"

FRONT_DIR="/var/www/aquilaai"
BACK_DIR="/opt/aquilaai"
DATA_DIR="/opt/aquilaai/data"
STATE_FILE="$DATA_DIR/state.json"

PORT="9698"
HOST="127.0.0.1"

SVC="/etc/systemd/system/aquilaai.service"
NGINX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_INC="/etc/nginx/includes/aquilaai_routes.inc"

say(){ echo "[$(date +%H:%M:%S)] $*"; }

say "== AQUILAAI :: START ($TS) =="

say "== 0) Preflight =="
id -u | grep -q '^0$' || { echo "ERROR: run as root"; exit 1; }
command -v nginx >/dev/null 2>&1 || { echo "ERROR: nginx missing"; exit 1; }
command -v node >/dev/null 2>&1 || { echo "ERROR: node missing (Node 18+ required)"; exit 1; }
NODEV="$(node -v | sed 's/^v//')"; MAJOR="${NODEV%%.*}"
[ "${MAJOR:-0}" -ge 18 ] || { echo "ERROR: Node >=18 required. Current v$NODEV"; exit 1; }

say "== 1) Backup current install (if any) =="
BK="/root/aquilaai_backup_${TS}"
mkdir -p "$BK"
[ -d "$FRONT_DIR" ] && cp -a "$FRONT_DIR" "$BK/var_www_aquilaai" || true
[ -d "$BACK_DIR" ] && cp -a "$BACK_DIR" "$BK/opt_aquilaai" || true
[ -f "$NGINX_VHOST" ] && cp -a "$NGINX_VHOST" "$BK/fireinners.online-ssl.bak" || true
[ -f "$NGINX_INC" ] && cp -a "$NGINX_INC" "$BK/aquilaai_routes.inc.bak" || true
say "Backup saved: $BK"

say "== 2) Ensure dirs =="
mkdir -p "$FRONT_DIR" "$BACK_DIR" "$DATA_DIR"
chmod 755 "$FRONT_DIR" "$BACK_DIR" "$DATA_DIR"

say "== 3) Write backend server.js =="
cat > "$BACK_DIR/server.js" <<'JS'
"use strict";
const http=require("http"),fs=require("fs"),path=require("path"),os=require("os"),crypto=require("crypto"),url=require("url");

const HOST=process.env.HOST||"127.0.0.1";
const PORT=process.env.PORT?parseInt(process.env.PORT,10):9698;
const DATA_DIR=process.env.DATA_DIR||"/opt/aquilaai/data";
const STATE_FILE=process.env.STATE_FILE||path.join(DATA_DIR,"state.json");
const MAX_BODY=2*1024*1024;

const now=()=>new Date().toISOString();
const j=(o)=>JSON.stringify(o);
const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));
const sha16=(s)=>crypto.createHash("sha256").update(String(s||""),"utf8").digest("hex").slice(0,16);

const ok=(res,code,obj)=>{res.writeHead(code||200,{"content-type":"application/json; charset=utf-8","cache-control":"no-store"});res.end(j(obj));};
const bad=(res,code,msg,extra)=>ok(res,code||400,{ok:false,error:String(msg||"error"),...(extra||{})});

const readBody=(req)=>new Promise((resolve,reject)=>{
  let b=""; req.on("data",c=>{b+=c; if(b.length>MAX_BODY) reject(new Error("body too large"));});
  req.on("end",()=>resolve(b||"")); req.on("error",reject);
});
const safeJson=(s)=>{try{return JSON.parse(s);}catch(_){return null;}};
const mkdirp=(p)=>{try{fs.mkdirSync(p,{recursive:true});}catch(_){}}; mkdirp(DATA_DIR);

const defaultState=()=>({
  meta:{app:"AquilaAi",createdAt:now(),updatedAt:now(),version:"AQUILAAI_OFFICIAL_1"},
  perms:{
    baseAuto:true,
    base:{health:true,metrics:true,rss:true,article:true,state:true,actions_read:true},
    sensitive:{x_post:false,trade:false,pumpfun_token:false,wallet_ops:false},
    pending:[] /* {id,type,desc,payload,createdAt,status:PENDING|APPROVED|DENIED,result} */
  },
  loops:{
    system:{enabled:true,mode:"RUN",lastStep:"S0_INIT",tickMs:1600,internal:true,external:true},
    learning:{enabled:true,mode:"RUN",lastStep:"L0_SCAN",tickMs:2400,internal:true,external:true}
  },
  rss:{
    feeds:[
      "https://www.coindesk.com/arc/outboundfeeds/rss/",
      "https://cointelegraph.com/rss",
      "https://decrypt.co/feed"
    ],
    cache:{ts:0,ttlMs:120000,items:[]} /* items: {title,link,pub,src,hash} */
  },
  article:{cache:{ts:0,ttlMs:240000,url:"",title:"",text:"",summary:"",tags:[],sentiment:"Neutre",quality:0,src:""}},
  aquila:{
    mode:"ACTIVE",
    voiceDefault:true,
    sarcasm:true,
    objectiveActive:"Marché→Profit (discipline + risque)",
    objectives:["Marché→Profit (discipline + risque)","Token ops (post-création Pump.fun)","Communication utilisateur (simple, 1 question)","Autonomie contrôlée (propose→confirme→exécute)"],
    tools:["RSS scanner","Extracteur article","Tagger/sentiment","Résumé","Score sources","Score extraction","Journal décisions","Queue actions (pending)","Métriques RAM/CPU","Sync state"],
    strategies:["Trend following","Mean reversion","Breakout","Range trading","Momentum","Support/Resistance","VWAP","News reaction","Risk management (size/SL/TP)","No-trade filter (liquidité/volatilité)"],
    memory:{
      internal_acquired:["Boucles non bloquantes","Permissions BASE auto","Demander confirmation avant action sensible","Journalisation"],
      external_improving:["Extraction article robuste","Scoring sources","Historique news/prix","Génération de plans plus précis"],
      notes:[]
    },
    journal:[]
  },
  stats:{errors:[],errRate:0.0,requests:0},
});

let STATE=null;
const loadState=()=>{
  try{
    if(fs.existsSync(STATE_FILE)){
      const s=safeJson(fs.readFileSync(STATE_FILE,"utf8"));
      if(s&&typeof s==="object") return s;
    }
  }catch(_){}
  const s=defaultState();
  fs.writeFileSync(STATE_FILE,j(s),{encoding:"utf8"});
  return s;
};
const saveState=()=>{STATE.meta.updatedAt=now(); fs.writeFileSync(STATE_FILE,j(STATE),{encoding:"utf8"});};

STATE=loadState();

const cleanText=(t)=>String(t||"").replace(/\r/g,"").replace(/[ \t]+\n/g,"\n").replace(/\n{3,}/g,"\n\n").trim();
const htmlToPlain=(html)=>{
  let s=String(html||"");
  const looks=/<\/(html|body|p|div|article|main)>/i.test(s)||/<(p|div|article|main)[\s>]/i.test(s);
  if(!looks) return cleanText(s);
  s=s.replace(/<script[\s\S]*?<\/script>/gi,"").replace(/<style[\s\S]*?<\/style>/gi,"");
  s=s.replace(/<\/p>/gi,"\n\n").replace(/<br\s*\/?>/gi,"\n").replace(/<li[^>]*>/gi,"\n• ").replace(/<\/li>/gi,"");
  s=s.replace(/<h[1-6][^>]*>/gi,"\n\n").replace(/<\/h[1-6]>/gi,"\n");
  s=s.replace(/<[^>]+>/g," ");
  return cleanText(s);
};
const summarize=(text)=>{
  text=cleanText(text||"");
  const paras=text.split("\n\n").map(x=>x.trim()).filter(Boolean);
  const pick=[];
  for(const p of paras){
    if(pick.length>=4) break;
    const s=p.replace(/\s+/g," ").slice(0,260);
    if(s.length>90) pick.push("• "+s);
  }
  return pick.length?pick.join("\n"):"• (Résumé impossible: contenu trop court / bloqué)";
};
const detectTags=(title,text)=>{
  const s=(String(title||"")+" "+String(text||"")).toLowerCase();
  const tags=[]; const has=(...w)=>w.some(x=>s.includes(x));
  if(has("etf","sec","regulat","regulation","law","lawsuit")) tags.push("Régulation");
  if(has("hack","exploit","breach","drain","phishing")) tags.push("Sécurité");
  if(has("inflation","rates","fed","macro","cpi","jobs","recession")) tags.push("Macro");
  if(has("solana","ethereum","bitcoin","btc","eth","sol")) tags.push("Majors");
  if(has("meme","airdrop","pump","rug","scam")) tags.push("Risque");
  if(has("spot","futures","options","liquidation")) tags.push("Dérivés");
  if(has("upgrade","fork","validator","outage","congestion")) tags.push("Technique");
  return [...new Set(tags)].slice(0,8);
};
const sentiment=(title,text)=>{
  const s=(String(title||"")+" "+String(text||"")).toLowerCase();
  let p=0,n=0;
  ["surge","rally","bull","record","approval","win","up","gain","breakout","inflows"].forEach(w=>{if(s.includes(w))p++;});
  ["crash","down","bear","hack","lawsuit","ban","rejected","exploit","liquidation","risk","outage"].forEach(w=>{if(s.includes(w))n++;});
  if(p-n>=2) return "Positif"; if(n-p>=2) return "Négatif"; return "Neutre";
};
const qualityScore=(text)=>{
  const t=cleanText(text||""); const len=t.length;
  if(len<300) return 10;
  if(len<800) return 35;
  if(len<1500) return 55;
  if(len<3500) return 75;
  return 90;
};

const fetchText=async(u,timeoutMs=9000)=>{
  const ctrl=new AbortController(); const to=setTimeout(()=>ctrl.abort(),timeoutMs);
  try{
    const r=await fetch(u,{cache:"no-store",signal:ctrl.signal,headers:{"user-agent":"AquilaAi/1.0"}});
    const t=await r.text();
    return {ok:r.ok,status:r.status,text:t||""};
  }finally{clearTimeout(to);}
};
const fetchWithFallback=async(targetUrl)=>{
  const tries=[
    targetUrl,
    "https://api.allorigins.win/raw?url="+encodeURIComponent(targetUrl),
    "https://r.jina.ai/http://"+targetUrl.replace(/^https?:\/\//i,""),
    "https://r.jina.ai/https://"+targetUrl.replace(/^https?:\/\//i,"")
  ];
  let last=null;
  for(const u of tries){
    try{
      const r=await fetchText(u,9500);
      if(r.ok && (r.text||"").trim().length>120) return {ok:true,src:u,text:r.text};
      last=r;
    }catch(e){ last={ok:false,error:String(e&&e.message?e.message:e)}; }
  }
  return {ok:false,error:last&&last.error?last.error:"fetch failed"};
};

const stripCdata=(s)=>String(s||"").replace(/^<!\[CDATA\[/,"").replace(/\]\]>$/,"").trim();
const decodeXml=(s)=>String(s||"").replace(/&amp;/g,"&").replace(/&lt;/g,"<").replace(/&gt;/g,">").replace(/&quot;/g,'"').replace(/&#39;/g,"'");
const tagVal=(block,tag)=>{
  const re=new RegExp(`<${tag}[^>]*>([\\s\\S]*?)<\\/${tag}>`,"i");
  const m=block.match(re); return m?decodeXml(stripCdata(m[1])).trim():"";
};
const parseRSS=(xml)=>{
  const s=String(xml||"");
  const items=[];
  const itemBlocks=s.match(/<item\b[\s\S]*?<\/item>/gi)||[];
  for(const b of itemBlocks.slice(0,40)){
    const title=tagVal(b,"title");
    let link=tagVal(b,"link");
    const pub=tagVal(b,"pubDate")||tagVal(b,"date")||"";
    if(title && link){ items.push({title,link,pub}); }
  }
  if(items.length) return items;
  const entryBlocks=s.match(/<entry\b[\s\S]*?<\/entry>/gi)||[];
  for(const b of entryBlocks.slice(0,40)){
    const title=tagVal(b,"title");
    let link="";
    const m=b.match(/<link[^>]*href=["']([^"']+)["'][^>]*\/?>/i);
    if(m) link=decodeXml(m[1]).trim(); else link=tagVal(b,"link");
    const pub=tagVal(b,"updated")||tagVal(b,"published")||"";
    if(title && link){ items.push({title,link,pub}); }
  }
  return items;
};

const listRssLatest=async()=>{
  const c=STATE.rss.cache;
  if(Date.now()-c.ts < c.ttlMs && Array.isArray(c.items) && c.items.length) return c.items.slice(0,12);
  const all=[];
  for(const feed of (STATE.rss.feeds||[]).slice(0,8)){
    const r=await fetchWithFallback(feed);
    if(!r.ok) continue;
    const parsed=parseRSS(r.text);
    for(const it of parsed){
      const h=sha16((it.title||"")+"|"+(it.link||""));
      all.push({title:it.title,link:it.link,pub:it.pub||"",src:feed,hash:h});
    }
  }
  const uniq=new Map();
  for(const it of all){ if(!uniq.has(it.hash)) uniq.set(it.hash,it); }
  const items=[...uniq.values()].slice(0,36);
  STATE.rss.cache={ts:Date.now(),ttlMs:STATE.rss.cache.ttlMs,items};
  saveState();
  return items.slice(0,12);
};

const autoPick=async()=>{
  const items=await listRssLatest();
  if(!items.length) return null;
  const parseDate=(s)=>{const d=new Date(s); const t=d.getTime(); return Number.isFinite(t)?t:0;};
  let best=items[0], bt=parseDate(items[0].pub);
  for(const it of items){ const t=parseDate(it.pub); if(t>bt){best=it; bt=t;} }
  return best;
};

const readArticleAuto=async(targetUrl)=>{
  if(!targetUrl) return {ok:false,error:"missing url"};
  const r=await fetchWithFallback(targetUrl);
  if(!r.ok) return {ok:false,error:r.error||"fetch failed"};
  const text=htmlToPlain(r.text);
  const q=qualityScore(text);
  const title=STATE.article.cache.title||"";
  const tags=detectTags(title,text);
  const sent=sentiment(title,text);
  const sum=summarize(text);
  const out={ok:true,url:targetUrl,src:r.src,text,summary:sum,tags,sentiment:sent,quality:q};
  STATE.article.cache={ts:Date.now(),ttlMs:STATE.article.cache.ttlMs,url:targetUrl,title:title||"",text,summary:sum,tags,sentiment:sent,quality:q,src:r.src};
  saveState();
  return out;
};

const pushPending=(type,desc,payload)=>{
  const id=sha16(now()+"|"+type+"|"+Math.random());
  const it={id,type,desc,payload:payload||{},createdAt:now(),status:"PENDING",result:null};
  STATE.perms.pending.unshift(it);
  STATE.perms.pending=STATE.perms.pending.slice(0,50);
  saveState();
  return it;
};
const setPending=(id,status,result)=>{
  const p=STATE.perms.pending.find(x=>x.id===id);
  if(!p) return null;
  p.status=status;
  p.result=result||null;
  saveState();
  return p;
};

const metrics=()=>{
  const mu=process.memoryUsage();
  const total=os.totalmem(), free=os.freemem(), used=total-free;
  return {
    ok:true,ts:now(),
    node:{rss:process.version,uptime_s:Math.round(process.uptime())},
    load:os.loadavg(),
    mem:{rss:mu.rss,heapUsed:mu.heapUsed,heapTotal:mu.heapTotal,external:mu.external,arrayBuffers:mu.arrayBuffers,total,free,used},
    cpu:{cores:os.cpus().length,model:(os.cpus()[0]||{}).model||""}
  };
};

const SYSTEM_GRAFCET=[
"S0_INIT","S1_HEALTH","S2_METRICS","S3_IO","S4_TASKS","S5_PERMS","S6_ACTIONS","S7_SYNC","S8_NEXT"
];
const LEARNING_GRAFCET=[
"L0_SCAN","L1_SELECT","L2_READ","L3_ANALYZE","L4_EVAL","L5_PROPOSE","L6_DIALOGUE","L7_LEARN_CONFIRM","L8_NEXT"
];

const systemTick=async()=>{
  if(!STATE.loops.system.enabled) return;
  try{
    STATE.loops.system.lastStep="S1_HEALTH";
    STATE.systemLastHealth="OK";
    STATE.loops.system.lastStep="S2_METRICS";
    STATE.systemLastMetrics="OK";
    STATE.loops.system.lastStep="S4_TASKS";
    // keep-alive + trim pending size
    STATE.perms.pending=STATE.perms.pending.slice(0,50);
    STATE.loops.system.lastStep="S7_SYNC";
    saveState();
    STATE.loops.system.lastStep="S8_NEXT";
    saveState();
    STATE.loops.system.lastStep="S1_HEALTH";
    saveState();
  }catch(e){
    STATE.stats.errors.unshift({ts:now(),m:String(e&&e.message?e.message:e),loop:"system"});
    STATE.stats.errors=STATE.stats.errors.slice(0,50);
    saveState();
  }
};

const learningTick=async()=>{
  if(!STATE.loops.learning.enabled) return;
  try{
    STATE.loops.learning.lastStep="L0_SCAN"; saveState();
    const pick=await autoPick();
    if(!pick){ STATE.loops.learning.lastStep="L8_NEXT"; saveState(); return; }

    STATE.loops.learning.lastStep="L1_SELECT";
    STATE.article.cache.title=pick.title||""; saveState();

    STATE.loops.learning.lastStep="L2_READ";
    const art=await readArticleAuto(pick.link);

    STATE.loops.learning.lastStep="L3_ANALYZE";
    const msg={
      ts:now(),
      title:pick.title,
      tags:art.ok?art.tags:[],
      sentiment:art.ok?art.sentiment:"Neutre",
      quality:art.ok?art.quality:0,
      summary:art.ok?art.summary:"(article bloqué, analyse du titre uniquement)",
      url:pick.link
    };
    STATE.aquila.journal.unshift(msg);
    STATE.aquila.journal=STATE.aquila.journal.slice(0,50);

    STATE.loops.learning.lastStep="L4_EVAL"; saveState();

    // propose (non-sensitive by default): create a "draft action" as pending only if user approves
    STATE.loops.learning.lastStep="L5_PROPOSE";
    // propose a safe default improvement as pending (toggleable by user)
    pushPending("UPGRADE_FILTER_RSS","Ajouter filtre RSS (Macro/Sécurité) + priorisation récence", {kind:"rss_filter",tags:["Macro","Sécurité"]});

    STATE.loops.learning.lastStep="L6_DIALOGUE"; saveState();
    STATE.loops.learning.lastStep="L8_NEXT"; saveState();
    STATE.loops.learning.lastStep="L0_SCAN"; saveState();
  }catch(e){
    STATE.stats.errors.unshift({ts:now(),m:String(e&&e.message?e.message:e),loop:"learning"});
    STATE.stats.errors=STATE.stats.errors.slice(0,50);
    saveState();
  }
};

let sysTimer=null, lrnTimer=null;
const startLoops=()=>{
  if(sysTimer) clearInterval(sysTimer);
  if(lrnTimer) clearInterval(lrnTimer);
  sysTimer=setInterval(systemTick, clamp(STATE.loops.system.tickMs||1600,800,10000));
  lrnTimer=setInterval(learningTick, clamp(STATE.loops.learning.tickMs||2400,1000,15000));
};

startLoops();

const route=async(req,res)=>{
  STATE.stats.requests++;
  const u=url.parse(req.url,true);
  const p=u.pathname||"/";
  const method=(req.method||"GET").toUpperCase();

  // CORS (for same-origin via nginx proxy; still safe)
  if(method==="OPTIONS"){
    res.writeHead(204,{
      "access-control-allow-origin":"*",
      "access-control-allow-methods":"GET,POST,OPTIONS",
      "access-control-allow-headers":"content-type"
    }); return res.end();
  }

  try{
    if(p==="/health" && method==="GET") return ok(res,200,{ok:true,app:"AquilaAi",ts:now(),host:HOST,port:PORT});
    if(p==="/metrics" && method==="GET") return ok(res,200,metrics());

    if(p==="/state" && method==="GET") return ok(res,200,{ok:true,state:STATE});
    if(p==="/state" && method==="POST"){
      const body=await readBody(req);
      const jsn=safeJson(body);
      if(!jsn || typeof jsn!=="object") return bad(res,400,"invalid json");
      // shallow merge allowed only for a few namespaces (safe)
      if(jsn.aquila && typeof jsn.aquila==="object"){
        STATE.aquila.objectiveActive=String(jsn.aquila.objectiveActive||STATE.aquila.objectiveActive);
      }
      if(jsn.rss && Array.isArray(jsn.rss.feeds)){
        STATE.rss.feeds=jsn.rss.feeds.map(x=>String(x||"")).filter(Boolean).slice(0,20);
      }
      saveState(); startLoops();
      return ok(res,200,{ok:true,state:STATE});
    }

    if(p==="/rss/latest" && method==="GET"){
      if(!STATE.perms.baseAuto || !STATE.perms.base.rss) return bad(res,403,"rss not permitted");
      const items=await listRssLatest();
      return ok(res,200,{ok:true,items});
    }

    if(p==="/article/auto" && method==="GET"){
      if(!STATE.perms.baseAuto || !STATE.perms.base.article) return bad(res,403,"article not permitted");
      const target=u.query.url?String(u.query.url):"";
      const title=u.query.title?String(u.query.title):"";
      if(title) STATE.article.cache.title=title;
      const r=await readArticleAuto(target);
      return ok(res,200,r);
    }

    if(p==="/actions/pending" && method==="GET"){
      if(!STATE.perms.baseAuto || !STATE.perms.base.actions_read) return bad(res,403,"actions_read not permitted");
      return ok(res,200,{ok:true,pending:STATE.perms.pending});
    }

    if(p==="/actions/approve" && method==="POST"){
      const body=await readBody(req); const jsn=safeJson(body)||{};
      const id=String(jsn.id||""); if(!id) return bad(res,400,"missing id");
      const it=setPending(id,"APPROVED",{ts:now(),note:"approved"});
      if(!it) return bad(res,404,"not found");
      return ok(res,200,{ok:true,item:it});
    }

    if(p==="/actions/deny" && method==="POST"){
      const body=await readBody(req); const jsn=safeJson(body)||{};
      const id=String(jsn.id||""); if(!id) return bad(res,400,"missing id");
      const it=setPending(id,"DENIED",{ts:now(),note:"denied"});
      if(!it) return bad(res,404,"not found");
      return ok(res,200,{ok:true,item:it});
    }

    if(p==="/grafcet" && method==="GET"){
      return ok(res,200,{ok:true,system:SYSTEM_GRAFCET,learning:LEARNING_GRAFCET});
    }

    return bad(res,404,"not found",{path:p});
  }catch(e){
    STATE.stats.errors.unshift({ts:now(),m:String(e&&e.message?e.message:e),path:p});
    STATE.stats.errors=STATE.stats.errors.slice(0,50);
    saveState();
    return bad(res,500,"server error");
  }
};

http.createServer((req,res)=>{
  // minimal headers
  res.setHeader("access-control-allow-origin","*");
  res.setHeader("access-control-allow-headers","content-type");
  res.setHeader("access-control-allow-methods","GET,POST,OPTIONS");
  route(req,res);
}).listen(PORT,HOST,()=>console.log(`AquilaAi listening on http://${HOST}:${PORT}`));

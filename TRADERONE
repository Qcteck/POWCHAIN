#!/usr/bin/env bash
set -euo pipefail
umask 022

TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/MEGA_AQUILATRADER_API_FIX_${TS}.log"
INC="/etc/nginx/includes/aquilatrader_routes.inc"
NGX="/etc/nginx/sites-available/fireinners.online-ssl"

say(){ echo "[$(date +%H:%M:%S)] $*" | tee -a "$LOG"; }

say "=== AQUILATRADER • API ROUTING FIX (STEP 1→4) ==="

# --------------------------------------------------
# STEP 1 — Backup nginx
# --------------------------------------------------
say "STEP 1 — Backup nginx config"
BK="/root/BK_AQUILATRADER_NGINX_${TS}"
mkdir -p "$BK"
cp -a "$NGX" "$BK/fireinners.online-ssl.bak"
[ -f "$INC" ] && cp -a "$INC" "$BK/aquilatrader_routes.inc.bak" || true

# --------------------------------------------------
# STEP 2 — Write correct nginx routes (API first)
# --------------------------------------------------
say "STEP 2 — Write aquilatrader nginx routes (API first)"

cat > "$INC" <<'NGINX'
# === AquilaTrader API (priority) ===
location ^~ /aquilatrader/api/ {
    proxy_pass http://127.0.0.1:9697/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# === AquilaTrader UI ===
location ^~ /aquilatrader/ {
    root /var/www;
    index index.html;
    try_files $uri $uri/ /aquilatrader/index.html;
}
NGINX

# Ensure include is present (idempotent)
if ! grep -q "aquilatrader_routes.inc" "$NGX"; then
  say "Inject include into vhost"
  sed -i '/server {/a \ \ \ \ include /etc/nginx/includes/aquilatrader_routes.inc;' "$NGX"
else
  say "Include already present"
fi

# --------------------------------------------------
# STEP 3 — Reload nginx safely
# --------------------------------------------------
say "STEP 3 — nginx syntax test + reload"
nginx -t
systemctl reload nginx

# --------------------------------------------------
# STEP 4 — LIVE API TESTS
# --------------------------------------------------
say "STEP 4 — API validation tests"

say "→ /api/health"
curl -sS https://www.fireinners.online/aquilatrader/api/health | tee -a "$LOG"
echo | tee -a "$LOG"

say "→ /api/backtest/report (expect JSON, not HTML)"
curl -sS https://www.fireinners.online/aquilatrader/api/backtest/report | tee -a "$LOG"
echo | tee -a "$LOG"

say "=== DONE — AquilaTrader API routing is FIXED ==="
say "UI + API now work together (simulation only, SAFE)"

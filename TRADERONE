#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Source-of-truth: where /wolverine/rpc is defined (ACTIVE conf) =="
nginx -T 2>/dev/null | grep -n "/wolverine/rpc" | head -n 120 || true


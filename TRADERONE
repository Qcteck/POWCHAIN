sudo bash -lc 'set -euo pipefail;OUTDIR=/opt/fireinners/sentinel/reports;mkdir -p "$OUTDIR";TS=$(date -u +%Y%m%d_%H%M%S);OUT="$OUTDIR/js_files_${TS}.tsv";LOG="$OUTDIR/js_files_${TS}.log";:>"$OUT";:>"$LOG";printf "size\tmtime\tmode\tsha256\tshebang\tpath\n" >>"$OUT";ROOTS=(/opt /var/www /srv /home /root);EXPR=( \( -path "*/.git" -o -path "*/.git/*" -o -path "*/node_modules" -o -path "*/node_modules/*" -o -path "*/dist" -o -path "*/dist/*" -o -path "*/build" -o -path "*/build/*" -o -path "*/.next" -o -path "*/.next/*" -o -path "*/.cache" -o -path "*/.cache/*" \) -prune -o -type f \( -iname "*.js" -o -iname "*.mjs" -o -iname "*.cjs" \) -print );for R in "${ROOTS[@]}";do [ -d "$R" ]||continue;find "$R" -xdev "${EXPR[@]}" 2>>"$LOG";done | sort -u | while IFS= read -r f;do [ -f "$f" ]||continue;sz=$(stat -c%s "$f" 2>>"$LOG"||echo 0);mt=$(stat -c%y "$f" 2>>"$LOG"|awk "{print \$1\"T\"\$2\"Z\"}"|sed "s/\\.\\([0-9]\\+\\)Z/Z/"||echo "");md=$(stat -c%a "$f" 2>>"$LOG"||echo "");sh=$(sha256sum "$f" 2>>"$LOG"|awk "{print \$1}"||echo "");sb=$(head -n 1 "$f" 2>>"$LOG"|tr -d "\r"|tr "\t" " "|tr -s " "|cut -c1-120||true);printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$sz" "$mt" "$md" "$sh" "$sb" "$f" >>"$OUT";done;echo "OK";echo "TSV: $OUT";echo "LOG: $LOG";echo "COUNT:";tail -n +2 "$OUT" | wc -l;echo "PREVIEW:";sed -n "1,25p" "$OUT"'
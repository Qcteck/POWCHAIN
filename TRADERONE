bash -lc 'set -euo pipefail
HTML="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
ASKOR="/opt/fireinners/sentinel/lib/askorupdate.sh"
say(){ printf "%s\n" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: $1 manquant"; exit 1; }; }
need nginx; need systemctl; need curl

if [ -f "$ASKOR" ]; then . "$ASKOR"; else
  askorupdate_file(){ local p="$1" n="$2" c="$3"; [ -f "$p" ] && cp -a "$p" "$p.bak.$(date -u +%Y%m%dT%H%M%SZ)" || true; umask 077; mkdir -p "$(dirname "$p")"; cat >"$p" <<<"$c"; }
fi

H="$(cat <<'"'"'HTML'"'"'
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE</title><style>:root{--bg:#060814;--p:#0b1330;--p2:#0a1026;--b:#1b2b66;--t:#eaf1ff;--m:#9fb0d9;--a:#59d7ff;--ok:#7dffbf;--bad:#ff7d9a}*{box-sizing:border-box}html,body{height:100%;margin:0;background:radial-gradient(1000px 600px at 20% 0%,#101a44 0%,transparent 60%),radial-gradient(900px 560px at 80% 20%,#0e2b5b 0%,transparent 55%),var(--bg);color:var(--t);font:14px system-ui}a{color:var(--a);text-decoration:none}#wrap{max-width:1100px;margin:0 auto;padding:18px}#top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}#brand{display:flex;gap:10px;align-items:center}#dot{width:16px;height:16px;border-radius:6px;background:linear-gradient(135deg,#6ef,#6f6);box-shadow:0 0 18px rgba(89,215,255,.45)}#ttl{font-weight:800;letter-spacing:.5px}#sub{color:var(--m);font-size:12px;margin-top:2px}#langBtn{border:1px solid rgba(255,255,255,.14);background:rgba(0,0,0,.18);color:var(--t);padding:8px 10px;border-radius:10px;cursor:pointer}#grid{display:grid;grid-template-columns:1.1fr .9fr;gap:12px}#card,#card2{background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.03));border:1px solid rgba(89,215,255,.18);border-radius:18px;padding:14px;box-shadow:0 0 30px rgba(0,0,0,.35)}h3{margin:0 0 10px 0;font-size:14px;color:#dfe8ff}label{display:block;color:var(--m);font-size:12px;margin:10px 0 6px}input,select,button{font:14px system-ui}input,select{width:100%;padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.22);color:var(--t);outline:none}button{padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:rgba(0,0,0,.18);color:var(--t);cursor:pointer}button.primary{border-color:rgba(89,215,255,.35);box-shadow:0 0 18px rgba(89,215,255,.18)}button.danger{border-color:rgba(255,125,154,.35)}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.row3{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:10px}#log{height:360px;overflow:auto;white-space:pre-wrap;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.10);border-radius:12px;padding:10px;color:#dfe8ff}#pill{display:inline-block;padding:4px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.14);background:rgba(0,0,0,.20);color:var(--m);font-size:12px}#statusLine{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:10px;color:var(--m)}.ok{color:var(--ok)}.bad{color:var(--bad)}@media(max-width:980px){#grid{grid-template-columns:1fr}}</style></head><body><div id="wrap"><div id="top"><div id="brand"><div id="dot"></div><div><div id="ttl">WOLVERINE</div><div id="sub" data-i18n="subtitle">Phantom only · API + monitoring</div></div></div><button id="langBtn" title="Toggle language">EN</button></div><div id="grid"><div id="card"><h3 data-i18n="control">Control</h3><div class="row"><button id="btnConnect" class="primary" data-i18n="connect">Connect</button><button id="btnDisconnect" data-i18n="disconnect">Disconnect</button></div><div class="row"><div><label data-i18n="sol">SOL</label><input id="sol" disabled value="-" /></div><div><label data-i18n="usdc">USDC</label><input id="usdc" disabled value="-" /></div></div><label data-i18n="budget">Total budget (USDC)</label><div class="row"><input id="budget" inputmode="decimal" placeholder="50" /><button id="btnSave" class="primary" data-i18n="save">Save</button></div><label data-i18n="mode">Mode</label><select id="mode"><option value="monitor_only" data-i18n="mode_monitor">Monitor only (safe)</option><option value="safe_dca" data-i18n="mode_dca">DCA buy SOL (custody)</option><option value="manual_token" data-i18n="mode_token">Buy token by mint (custody)</option></select><label data-i18n="mint">Token mint (if needed)</label><input id="mint" placeholder="So111... or token mint" /><label data-i18n="autotrade">Autotrade</label><div class="row"><button id="btnStart" class="primary" data-i18n="start">Start WOLVERINE</button><button id="btnStop" class="danger" data-i18n="stop">Stop</button></div><div id="statusLine"><span id="pill">Ready</span><span id="custodyPub"></span></div><div style="margin-top:10px;color:var(--m);font-size:12px" data-i18n="safety">No private keys on the page. Phantom for balances. Backend shows custody address.</div></div><div id="card2"><h3 data-i18n="console">Console</h3><div id="log"></div></div></div></div><script>
(()=>{const API_BASE="/wolverine/api";const LS_LANG="WOLV_LANG";const LS_BUD="WOLV_BUD";const $=s=>document.querySelector(s);const logEl=$("#log");const pill=$("#pill");const custodyPub=$("#custodyPub");const langBtn=$("#langBtn");
const i18n={en:{subtitle:"Phantom only · API + monitoring",control:"Control",connect:"Connect",disconnect:"Disconnect",sol:"SOL",usdc:"USDC",budget:"Total budget (USDC)",save:"Save",mode:"Mode",mint:"Token mint (if needed)",autotrade:"Autotrade",start:"Start WOLVERINE",stop:"Stop",console:"Console",safety:"No private keys on the page. Phantom for balances. Backend shows custody address.",mode_monitor:"Monitor only (safe)",mode_dca:"DCA buy SOL (custody)",mode_token:"Buy token by mint (custody)"},fr:{subtitle:"Phantom seulement · API + monitoring",control:"Contrôle",connect:"Connexion",disconnect:"Déconnexion",sol:"SOL",usdc:"USDC",budget:"Budget total (USDC)",save:"Sauver",mode:"Mode",mint:"Mint token (si requis)",autotrade:"Auto-trade",start:"Démarrer WOLVERINE",stop:"Arrêter",console:"Console",safety:"Aucune clé privée sur la page. Phantom pour les soldes. Le backend affiche l’adresse custody.",mode_monitor:"Monitoring seulement (safe)",mode_dca:"DCA achat SOL (custody)",mode_token:"Achat token par mint (custody)"}};
let lang=(localStorage.getItem(LS_LANG)||"en");function setLang(L){lang=L;localStorage.setItem(LS_LANG,L);langBtn.textContent=L.toUpperCase();document.documentElement.lang=L;document.querySelectorAll("[data-i18n]").forEach(el=>{const k=el.getAttribute("data-i18n");if(i18n[L]&&i18n[L][k]!=null) el.textContent=i18n[L][k];});document.querySelectorAll("option[data-i18n]").forEach(o=>{const k=o.getAttribute("data-i18n");if(i18n[L]&&i18n[L][k]!=null) o.textContent=i18n[L][k];});}
langBtn.onclick=()=>setLang(lang==="en"?"fr":"en");setLang(lang);

function LOG(x){const t=new Date().toISOString();logEl.textContent=(t+" "+x+"\n"+logEl.textContent).slice(0,12000);}
async function jget(p){const r=await fetch(API_BASE+p,{cache:"no-store"});return await r.json();}
async function jpost(p,b){const r=await fetch(API_BASE+p,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(b||{}),cache:"no-store"});return await r.json();}

let pub="";async function phantomConnect(){if(!window.solana||!window.solana.isPhantom) throw new Error("phantom_not_found");const resp=await window.solana.connect();pub=resp.publicKey.toString();LOG("Phantom connected: "+pub);return pub;}
async function phantomDisconnect(){try{if(window.solana&&window.solana.disconnect) await window.solana.disconnect();}catch{} pub="";LOG("Phantom disconnected");}

$("#btnConnect").onclick=async()=>{try{await phantomConnect();await refreshBalances();}catch(e){LOG("ERR connect: "+(e&&e.message||e));}};
$("#btnDisconnect").onclick=async()=>{await phantomDisconnect();$("#sol").value="-";$("#usdc").value="-";};

function setPill(txt,ok){pill.textContent=txt;pill.className=ok?"ok":"bad";}
async function refreshConfig(){try{const c=await jget("/config");if(c.ok&&c.custodyPubkey){custodyPub.textContent="Custody: "+c.custodyPubkey;setPill("API OK",true);}else{custodyPub.textContent="";setPill("API ERR",false);LOG("config: "+JSON.stringify(c));}}catch(e){setPill("API DOWN",false);LOG("ERR config: "+(e&&e.message||e));}}
async function refreshStatus(){try{const s=await jget("/status");if(s.ok){LOG("status: running="+s.running+" spent="+s.spent_usdc+" remaining="+s.remaining_usdc);}else{LOG("status err: "+JSON.stringify(s));}}catch(e){LOG("ERR status: "+(e&&e.message||e));}}
async function refreshBalances(){if(!pub) return;try{const b=await jpost("/phantomBalances",{pub});if(b.ok){$("#sol").value=String(b.sol);$("#usdc").value=String(b.usdc);}else LOG("balances err: "+JSON.stringify(b));}catch(e){LOG("ERR balances: "+(e&&e.message||e));}}

const bud=$("#budget");bud.value=localStorage.getItem(LS_BUD)||"";$("#btnSave").onclick=()=>{localStorage.setItem(LS_BUD,(bud.value||"").trim());LOG("Budget saved: "+(bud.value||""));};
$("#btnStart").onclick=async()=>{try{const budget=+(bud.value||0);const mode=$("#mode").value;const mint=$("#mint").value.trim();const r=await jpost("/start",{budget,mode,mint});LOG("start: "+JSON.stringify(r));}catch(e){LOG("ERR start: "+(e&&e.message||e));}};
$("#btnStop").onclick=async()=>{try{const r=await jpost("/stop",{});LOG("stop: "+JSON.stringify(r));}catch(e){LOG("ERR stop: "+(e&&e.message||e));}};

refreshConfig();setInterval(refreshConfig,5000);
setInterval(refreshStatus,2500);
setInterval(refreshBalances,3000);
})();
</script></body></html>
HTML
)"
askorupdate_file "$HTML" "wolverine index.html" "$H"
nginx -t >/dev/null
systemctl reload nginx >/dev/null || true
echo "-- test --"
curl -sS https://fireinners.online/wolverine/ | head -n 5 || true
echo "DONE"
'
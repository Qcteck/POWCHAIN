bash <<'WOLVERINE_NGINX_FIX'
set -euo pipefail

echo "=== WOLVERINE :: NGINX LOCATION FIX ==="

FRONT_DIR="/var/www/wolverine"
NGINX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

# --- sanity ---
test -f "$FRONT_DIR/index.html" || {
  echo "ERROR: $FRONT_DIR/index.html missing"
  exit 1
}

# --- permissions (safe) ---
chown -R www-data:www-data "$FRONT_DIR"
find "$FRONT_DIR" -type d -exec chmod 755 {} \;
find "$FRONT_DIR" -type f -exec chmod 644 {} \;

# --- add location if missing ---
if ! grep -q "location /wolverine" "$NGINX_VHOST"; then
  echo "[PATCH] adding /wolverine location to nginx"

  sed -i "/server {/a \
\n  location /wolverine/ {\n\
    root /var/www;\n\
    index index.html;\n\
    try_files \$uri \$uri/ /wolverine/index.html;\n\
  }\n" "$NGINX_VHOST"
fi

# --- test & reload ---
nginx -t
systemctl reload nginx

sleep 1

# --- live test ---
HTTP_CODE=$(curl -o /dev/null -s -w "%{http_code}" https://fireinners.online/wolverine/)
if [ "$HTTP_CODE" != "200" ]; then
  echo "❌ STILL FAILING (HTTP $HTTP_CODE)"
  exit 1
fi

echo
echo "======================================"
echo "✅ WOLVERINE FRONT IS LIVE"
echo "URL : https://fireinners.online/wolverine"
echo "======================================"
WOLVERINE_NGINX_FIX
cat >/tmp/FIX_WOLVERINE_FINAL_DUPLICATES.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"

echo "=== BACKUP DIR ==="
BK="/root/backup_wolv_final_${T}"
mkdir -p "$BK"

echo "=== 1) Disable old enabled vhosts that conflict (keep ONLY fireinners.online-ssl) ==="
ls -la /etc/nginx/sites-enabled | tee "$BK/sites-enabled.before.txt"

for f in /etc/nginx/sites-enabled/*; do
  base="$(basename "$f")"
  if [ "$base" != "fireinners.online-ssl" ]; then
    echo "DISABLE: $f"
    cp -a "$f" "$BK/${base}.bak" || true
    mv "$f" "/etc/nginx/sites-enabled/${base}.DISABLED.${T}"
  fi
done

echo
echo "=== 2) Comment any includes of wolverine_unified/static_tryfiles snippets anywhere ==="
# comment lines that include these snippets (absolute or relative)
FILES=$(grep -RIl --exclude-dir='*.DISABLED.*' -E 'wolverine_unified\.conf|wolverine_static_tryfiles\.conf' /etc/nginx || true)
for p in $FILES; do
  cp -a "$p" "$BK/$(basename "$p").bak" || true
  sed -i -E 's@^(\s*include\s+.*(wolverine_unified\.conf|wolverine_static_tryfiles\.conf)\s*;.*)$@# \1@g' "$p"
done

echo
echo "=== 3) Proof: show remaining /wolverine location definitions (should be ONLY in fireinners-wolverine.conf + your main vhost include) ==="
grep -RIn --color=never -E '^\s*location\s+.*\/wolverine\/' \
  /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/snippets \
  | head -n 200 || true

echo
echo "=== 4) nginx test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "OK ✅ nginx reloaded."
SH

bash /tmp/FIX_WOLVERINE_FINAL_DUPLICATES.sh
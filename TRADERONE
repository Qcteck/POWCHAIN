#!/usr/bin/env bash
set -euo pipefail

SITE_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$SITE_DIR/index.html"
BACKUP="$SITE_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"

WORKER_BASE="https://aiaquila-proxy.paycashnostory.workers.dev"
WORKER_RSS="$WORKER_BASE/rss"

echo "=== AIAQUILA • FINAL FIX ==="

echo "[1/6] Test WORKER /rss (SEUL endpoint valide)..."
curl -fsSL "$WORKER_RSS" | head -n 3 || {
  echo "❌ Worker RSS inaccessible"
  exit 1
}
echo "✅ Worker RSS OK"

echo "[2/6] Backup frontend..."
cp -a "$INDEX" "$BACKUP"
echo "Backup -> $BACKUP"

echo "[3/6] Écriture frontend (WORKER ONLY)..."
cat > "$INDEX" <<EOF
<!doctype html><html lang="fr"><head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;padding:20px;font-family:system-ui;background:#0b1b3a;color:#fff}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
</style>
</head><body>
<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
<script>
const API="$WORKER_RSS";
async function load(){
 const out=document.getElementById("out");
 out.textContent="Chargement…\\n";
 try{
  const r=await fetch(API,{cache:"no-store"});
  if(!r.ok) throw new Error("HTTP "+r.status);
  const j=await r.json();
  if(!Array.isArray(j)) throw new Error("JSON invalide");
  out.textContent=j.map((a,i)=>\`\${i+1}. \${a.title}\\n\${a.link}\\n\`).join("\\n");
 }catch(e){
  out.textContent="ERREUR: "+e.message;
 }
}
</script>
</body></html>
EOF

echo "[4/6] Permissions..."
chown -R www-data:www-data "$SITE_DIR"
chmod 644 "$INDEX"

echo "[5/6] Reload nginx..."
nginx -t
systemctl reload nginx

echo "[6/6] OK"
echo "URL SITE   : https://fireinners.online/aiaquila/"
echo "WORKER RSS : $WORKER_RSS"
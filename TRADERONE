cat >/root/FIX_TRADERONE_FORCE_PAYLOAD_FETCH.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== [1] Vérification ==="
test -f "$HTML" || { echo "❌ index.html introuvable"; exit 1; }

echo "=== [2] Backup ==="
cp -a "$HTML" "${HTML}.bak_${TS}"

echo "=== [3] Injection hook fetch ==="
python3 <<'PY'
from pathlib import Path

p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")

HOOK = r"""
<script>
(function(){
 const _fetch = window.fetch;
 window.fetch = async function(url, opts){
  try{
   if(opts && opts.body && typeof opts.body === "string"){
    const o = JSON.parse(opts.body);
    if(!o.from && window.solana?.publicKey){
      o.from = window.solana.publicKey.toString();
    }
    if(!o.amount){
      o.amount = o.budgetSol ?? o.budget ?? o.sol ?? o.amountSol;
    }
    opts.body = JSON.stringify(o);
   }
  }catch(e){}
  return _fetch(url, opts);
 };
})();
</script>
"""

if "window.fetch = async function" in s:
    print("✔ Hook fetch déjà présent")
else:
    s = s.replace("</body>", HOOK + "\n</body>")
    p.write_text(s)
    print("✔ Hook fetch injecté")
PY

echo "=== [4] Test nginx ==="
nginx -t

echo "=== [5] Reload nginx ==="
systemctl reload nginx

echo "=== [6] OK ==="
echo "✔ Payload forcé AVANT fetch"
echo "✔ Aucun regex / aucune dépendance frontend"
echo "✔ Budget => TRANSFERT SOL RÉEL"
echo "Backup : ${HTML}.bak_${TS}"
echo "=== TERMINÉ ==="
BASH

chmod +x /root/FIX_TRADERONE_FORCE_PAYLOAD_FETCH.sh
/root/FIX_TRADERONE_FORCE_PAYLOAD_FETCH.sh
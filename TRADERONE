cat >"$SNIP" <<'EOF'
# WOLVERINE_EAGLE_V1
location ^~ /wolverine/eagle/ {
  alias /var/www/fireinners/wolverine_eagle/;
  try_files $uri $uri/ /wolverine/eagle/index.html;
}
EOF

# inject include (if missing) in the ACTIVE ssl vhost file
python3 - <<PY
import re
p="${VHOST}"
inc="    include /etc/nginx/snippets/wolverine_eagle.conf; # WOLVERINE_EAGLE_INCLUDE\n"
s=open(p,"r",encoding="utf-8",errors="ignore").read()
if "wolverine_eagle.conf" in s:
    print("OK: eagle include already present")
else:
    m=re.search(r'^\s*server\s*\{\s*$', s, flags=re.M)
    if not m: raise SystemExit("ERROR: can't find 'server {' in "+p)
    s=s[:m.end()]+"\n"+inc+s[m.end():]
    open(p,"w",encoding="utf-8").write(s)
    print("OK: eagle include added to", p)
PY

nginx -t
systemctl reload nginx

echo "TEST:"
curl -ksS --max-time 8 https://fireinners.online/wolverine/eagle/ | head -n 5
SH

bash /tmp/ENABLE_WOLVERINE_EAGLE.sh
set -euo pipefail

echo "== A) EDIT SNIPPET =="
SNIP="/etc/nginx/snippets/private_sentinel1.conf"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
BAK="/root/private_sentinel1.conf.bak.$(date +%Y%m%d-%H%M%S)"

echo "[1] backup snippet -> $BAK"
mkdir -p /root
[ -f "$SNIP" ] && cp -a "$SNIP" "$BAK" || true

echo "[2] write snippet (BasicAuth + proxy to 127.0.0.1:3000)"
cat > "$SNIP" <<'EOF'
location ^~ /_private_sentinel1/ {auth_basic "Sentinel";auth_basic_user_file /etc/nginx/.htpasswd_private_sentinel1;proxy_pass http://127.0.0.1:3000/;proxy_http_version 1.1;proxy_set_header Host $host;proxy_set_header X-Real-IP $remote_addr;proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;proxy_set_header X-Forwarded-Proto $scheme;add_header Cache-Control "no-store" always;}
location = /_private_sentinel1 {return 301 /_private_sentinel1/;}
EOF
chmod 644 "$SNIP"

echo "[3] ensure vhost includes snippet"
if ! grep -RInq "snippets/private_sentinel1\.conf" "$VHOST"; then
  echo "-> include missing, inserting after 'listen 443' line"
  cp -a "$VHOST" "/root/fireinners.online-ssl.bak.$(date +%Y%m%d-%H%M%S)"
  awk '{
    print
    if ($0 ~ /^[ \t]*listen[ \t]+443/){print "    include /etc/nginx/snippets/private_sentinel1.conf;"}
  }' "$VHOST" > /tmp/fireinners.online-ssl && mv /tmp/fireinners.online-ssl "$VHOST"
fi

echo "[4] nginx test + reload"
nginx -t
systemctl reload nginx

echo "== DONE =="
echo "Test:"
echo "  curl -I https://fireinners.online/_private_sentinel1/ | head"
echo "  curl -I -u sentinel https://fireinners.online/_private_sentinel1/ | head"
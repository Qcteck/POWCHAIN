cat >/root/fix_try_files_at_error_line.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ts="$(date +%Y%m%d_%H%M%S)"

ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 40

FILE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\1/p' | head -n1)"
LINE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\2/p' | head -n1)"

if [[ -z "${FILE:-}" || -z "${LINE:-}" ]]; then
  echo "[ERR] Impossible d'extraire file:line. Fais: nginx -t 2>&1 | head -n 30"
  exit 1
fi

echo
echo "== Target: $FILE:$LINE =="
start=$((LINE-8)); ((start<1)) && start=1
end=$((LINE+8))
nl -ba "$FILE" | sed -n "${start},${end}p"

echo
echo "== Backup =="
cp -a "$FILE" "${FILE}.bak_${ts}"

echo
echo "== Patch ONLY that line to a valid try_files =="
# Remplace toute la ligne try_files (même si elle contient \ ou $ mangé) par la version correcte.
sed -i "${LINE}s@^[[:space:]]*try_files.*;@    try_files \$uri =404;@g" "$FILE"

echo
echo "== Re-check line =="
nl -ba "$FILE" | sed -n "${LINE}p"

echo
echo "== nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
BASH

chmod +x /root/fix_try_files_at_error_line.sh
/root/fix_try_files_at_error_line.sh
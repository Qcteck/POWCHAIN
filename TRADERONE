# 4) JS terminal (relie au backend + soldes SOL/USDC)
cat >"$WEB_DIR/ui/terminal.js" <<'JS'
(()=>{"use strict";
const $=s=>document.querySelector(s);
const $$=s=>Array.from(document.querySelectorAll(s));
const sleep=ms=>new Promise(r=>setTimeout(r,ms));

const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"; // correct
const RPCS=[
  (window.__RPC__||"").trim(),
  "https://api.mainnet-beta.solana.com"
].filter(Boolean);

function setChip(t){ const el=$("#statusChip"); if(el) el.textContent=t; console.log("[WOLV]",t); }
function fmt(n,d){ n=Number(n||0); if(!isFinite(n)) n=0; return n.toFixed(d); }

async function ensureWeb3(){
  // @solana/web3.js IIFE sur window.solanaWeb3
  for(let i=0;i<120;i++){
    if(window.solanaWeb3 && window.solanaWeb3.Connection && window.solanaWeb3.PublicKey) return true;
    await sleep(100);
  }
  return false;
}

async function phantomPub(trusted){
  if(!window.solana || !window.solana.isPhantom) return "";
  if(window.solana.publicKey) return window.solana.publicKey.toBase58();
  try{
    const r=await window.solana.connect(trusted?{onlyIfTrusted:true}:{});
    return (r && r.publicKey) ? r.publicKey.toBase58() : "";
  }catch(_){ return ""; }
}

async function solBalance(pub){
  const ok=await ensureWeb3(); if(!ok) return null;
  const web3=window.solanaWeb3;
  for(const rpc of RPCS){
    try{
      const conn=new web3.Connection(rpc,"confirmed");
      const lam=await conn.getBalance(new web3.PublicKey(pub),"confirmed");
      return lam/1e9;
    }catch(_){}
  }
  return null;
}

async function usdcBalance(pub){
  const ok=await ensureWeb3(); if(!ok) return null;
  const web3=window.solanaWeb3;
  for(const rpc of RPCS){
    try{
      const conn=new web3.Connection(rpc,"confirmed");
      const res=await conn.getParsedTokenAccountsByOwner(
        new web3.PublicKey(pub),
        { mint: new web3.PublicKey(USDC_MINT) },
        "confirmed"
      );
      let sum=0;
      for(const it of (res.value||[])){
        const ui=it.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
        sum += Number(ui||0);
      }
      return sum;
    }catch(_){}
  }
  return null;
}

async function apiInvested(pub){
  try{
    const r=await fetch("/api/invested?pub="+encodeURIComponent(pub),{cache:"no-store"});
    if(!r.ok) return null;
    return await r.json();
  }catch(_){ return null; }
}

async function refreshBalances(){
  const pub = await phantomPub(true);
  const w1=$("#walletState"); const w2=$("#walletState2");
  if(!pub){
    if(w1) w1.textContent="Wallet: non connecté";
    if(w2) w2.textContent="Wallet: non connecté";
    $("#balSol").textContent="—"; $("#balUsdc").textContent="—";
    $("#investedBox").style.display="none";
    return;
  }
  const short = pub.slice(0,4)+"…"+pub.slice(-4);
  if(w1) w1.textContent="Wallet: "+short;
  if(w2) w2.textContent="Wallet: "+short;

  const [sol,usdc] = await Promise.all([solBalance(pub), usdcBalance(pub)]);
  $("#balSol").textContent = (sol==null) ? "…" : (fmt(sol,6)+" SOL");
  $("#balUsdc").textContent = (usdc==null) ? "…" : (fmt(usdc,2)+" USDC");

  const inv = await apiInvested(pub);
  if(inv && (inv.sol!=null || inv.usdc!=null)){
    $("#invSol").textContent = fmt(inv.sol,6)+" SOL";
    $("#invUsdc").textContent = fmt(inv.usdc,2)+" USDC";
    $("#investedBox").style.display="";
  }else{
    $("#investedBox").style.display="none";
  }
}

async function postJSON(url, body){
  const r=await fetch(url,{
    method:"POST",
    headers:{"content-type":"application/json"},
    body:JSON.stringify(body||{})
  });
  const t=await r.text();
  if(!r.ok) throw new Error(t || ("HTTP "+r.status));
  return t;
}

function getDepositState(){
  try{ return JSON.parse(localStorage.getItem("WOLV_DEPOSIT_OK_V1")||"null"); }
  catch(_){ return null; }
}

async function startWolverine(){
  const st=getDepositState();
  // on envoie st si dispo, sinon start simple
  const payload = st && st.ok ? {from:st.from,to:st.to,asset:st.asset,budget:st.amount,depositSig:st.sig} : {source:"terminal"};
  return await postJSON("/api/start", payload);
}

async function setMode(){
  const mode=$("#mode").value || "NORMAL";
  return await postJSON("/api/traderone/mode",{mode});
}

async function withdraw(){
  const asset=$("#wdAsset").value || "SOL";
  const amount=Number(($("#wdAmount").value||"").trim().replace(",","."));
  const to=($("#wdTo").value||"").trim();
  if(!(amount>0)) throw new Error("Montant invalide");
  if(!to) throw new Error("Adresse destination invalide");
  return await postJSON("/api/traderone/withdraw",{asset,amount,to});
}

function navActivate(view){
  $$(".nav button").forEach(b=>b.classList.toggle("active", b.dataset.view===view));
  $("#viewTitle").textContent = view.charAt(0).toUpperCase()+view.slice(1);
}

function boot(){
  $$(".nav button").forEach(b=>b.addEventListener("click",()=>navActivate(b.dataset.view)));
  navActivate("dashboard");

  $("#btnConnect").addEventListener("click", async()=>{
    const pub = await phantomPub(false);
    if(!pub) alert("Phantom non connecté / refusé.");
    await refreshBalances();
  });

  $("#btnStart").addEventListener("click", async()=>{
    try{
      $("#btnStart").disabled=true;
      setChip("START...");
      const t=await startWolverine();
      setChip("START OK: "+t);
    }catch(e){
      setChip("ERR START: "+(e.message||String(e)));
      alert("ERR START: "+(e.message||String(e)));
    }finally{
      $("#btnStart").disabled=false;
    }
  });

  $("#btnMode").addEventListener("click", async()=>{
    try{
      $("#btnMode").disabled=true;
      setChip("MODE...");
      const t=await setMode();
      setChip("MODE OK: "+t);
    }catch(e){
      setChip("ERR MODE: "+(e.message||String(e)));
      alert("ERR MODE: "+(e.message||String(e)));
    }finally{
      $("#btnMode").disabled=false;
    }
  });

  $("#btnWithdraw").addEventListener("click", async()=>{
    try{
      $("#btnWithdraw").disabled=true;
      setChip("WITHDRAW...");
      const t=await withdraw();
      setChip("WITHDRAW OK: "+t);
    }catch(e){
      setChip("ERR WITHDRAW: "+(e.message||String(e)));
      alert("ERR WITHDRAW: "+(e.message||String(e)));
    }finally{
      $("#btnWithdraw").disabled=false;
    }
  });

  refreshBalances().catch(()=>0);
  setInterval(()=>refreshBalances().catch(()=>0), 6000);
}

if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", boot);
else boot();
})();

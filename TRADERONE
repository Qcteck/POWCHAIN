<script>/*BLOC 6/8: observables internes + expect*/(()=>{const U=window.__QJ__,{cmul,cconj,cadd}=U;const V=window.__QJ2__,{Q}=V;let O=null;const buildObs=()=>{O=[];for(let k=0;k<3;k++){const Re=[],Im=[];for(let a=0;a<Q.D;a++){Re[a]=new Float64Array(Q.D);Im[a]=new Float64Array(Q.D);}for(let a=0;a<Q.D;a++)for(let b=a;b<Q.D;b++){if(a===b){Re[a][b]=(Q.rng()*2-1)*0.8;Im[a][b]=0;}else{const re=(Q.rng()*2-1)*0.6,im=(Q.rng()*2-1)*0.6;Re[a][b]=re;Im[a][b]=im;Re[b][a]=re;Im[b][a]=-im;}}O.push({Re,Im});}};const expect=(Obs)=>{let s=0;for(let a=0;a<Q.D;a++)for(let b=0;b<Q.D;b++){const re=Obs.Re[a][b],im=Obs.Im[a][b];const rre=Q.rhoRe[b][a],rim=-Q.rhoIm[b][a];s+=re*rre-im*rim;}return s;};window.__QJ6__={buildObs,expect,getObs:()=>O};})();</script>


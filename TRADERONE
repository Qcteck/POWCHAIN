ls -lah "$OUT" | sed -n '1,200p'

echo
echo "=== 3) Résumé rapide de chaque server (listen / root / proxy_pass / includes) ==="
for s in "$OUT"/server_*.conf; do
  echo "----- $(basename "$s") -----"
  grep -nE 'server_name|listen|root|index|location|proxy_pass|include|return|rewrite|ssl_certificate' "$s" | head -n 140
  echo
done

echo "=== 4) DIFF (pair à pair) ==="
cd "$OUT"
FIRST="$(ls -1 server_*.conf | head -n 1)"
for s in $(ls -1 server_*.conf | tail -n +2); do
  echo "######## DIFF: $FIRST  vs  $s ########"
  diff -u "$FIRST" "$s" | head -n 260 || true
  echo
done


cat >/root/diag_rpc_balance.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="fireinners.online"

hr(){ echo -e "\n========== $* ==========\n"; }

hr "1) Basic RPC getVersion (should be 200 + JSON)"
curl -sk -i "https://${DOMAIN}/wolverine/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,40p'
echo

hr "2) CORS preflight (OPTIONS) for /wolverine/rpc (should be 204/200 with allow-headers/methods)"
curl -sk -i -X OPTIONS "https://${DOMAIN}/wolverine/rpc" \
  -H "Origin: https://${DOMAIN}" \
  -H "Access-Control-Request-Method: POST" \
  -H "Access-Control-Request-Headers: content-type" | sed -n '1,40p'
echo

PUBKEY="${1:-}"
if [[ -z "$PUBKEY" ]]; then
  hr "3) getBalance (SKIPPED - no pubkey provided)"
  echo "Run with a pubkey from Phantom:"
  echo "  /root/diag_rpc_balance.sh <PUBKEY>"
  exit 0
fi

hr "3) getBalance for pubkey (should be 200 + result.value)"
curl -sk -i "https://${DOMAIN}/wolverine/rpc" \
  -H 'Content-Type: application/json' \
  --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getBalance\",\"params\":[\"${PUBKEY}\"]}" | sed -n '1,80p'
echo

hr "4) getLatestBlockhash (common extra call)"
curl -sk -i "https://${DOMAIN}/wolverine/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getLatestBlockhash"}' | sed -n '1,80p'
echo

hr "DONE"
BASH

chmod +x /root/diag_rpc_balance.sh
/root/diag_rpc_balance.sh
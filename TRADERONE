set -e
cd /root

echo "=== Avant (fichiers chargés) ==="
ls -la /etc/nginx/sites-enabled | egrep 'fireinners|bak|old|~' || true

echo
echo "=== Suppression des backups dans sites-enabled ==="
rm -fv /etc/nginx/sites-enabled/*.bak* 2>/dev/null || true
rm -fv /etc/nginx/sites-enabled/*~     2>/dev/null || true
rm -fv /etc/nginx/sites-enabled/*.old* 2>/dev/null || true

echo
echo "=== Après (doit rester fireinners.online + fireinners.online-ssl) ==="
ls -la /etc/nginx/sites-enabled | egrep 'fireinners|bak|old|~' || true

echo
echo "=== nginx -t + reload ==="
nginx -t
systemctl reload nginx
chmod 0644 "$IDX" || true
chown -R www-data:www-data "$WWW" 2>/dev/null || true

# --- NGINX: ensure /wolverine serves /var/www/wolverine (inject deterministic include) ---
NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGX_INC_DIR="/etc/nginx/includes"
NGX_INC="$NGX_INC_DIR/wolverine.inc"
mkdir -p "$NGX_INC_DIR"

say "Inject nginx include (deterministic): $NGX_INC"
if [ -f "$NGX_INC" ]; then cp -a "$NGX_INC" "$BK/wolverine.inc.bak" || true; fi

cat >"$NGX_INC" <<'NGINX'
# AUTOGEN_WOLVERINE_INC_V1
location ^~ /wolverine/ { alias /var/www/wolverine/; try_files $uri $uri/ /wolverine/index.html; add_header Cache-Control "no-store" always; }
NGINX
chmod 0644 "$NGX_INC" || true

say "Patch vhost to include wolverine.inc (idempotent)"
if [ -f "$NGX_VHOST" ]; then cp -a "$NGX_VHOST" "$BK/fireinners.online-ssl.bak" || true; fi
if ! grep -q "wolverine\.inc" "$NGX_VHOST" 2>/dev/null; then
  # unlock if immutable
  chattr -i "$NGX_VHOST" 2>/dev/null || true
  # inject once, near top of server block
  awk 'BEGIN{done=0}
  {print}
  /server\s*\{/ && done==0 {print "    include /etc/nginx/includes/wolverine.inc;"; done=1}
  ' "$NGX_VHOST" >"$BK/vhost.new"
  cp -a "$BK/vhost.new" "$NGX_VHOST"
  rm -f "$BK/vhost.new"
  # relock
  chattr +i "$NGX_VHOST" 2>/dev/null || true
fi

# reload nginx (internal safety)
say "Reload nginx"
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
nginx -t >/dev/null
systemctl reload nginx
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true

say "DONE. AquilaTrader installed at: https://fireinners.online/wolverine/"
say "Backup: $BK"
BASH

cat >/root/check_wolverine_assets.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"

hdr(){ echo -e "\n=== $* ==="; }

hdr "Fetch HTML (local HTTPS)"
HTML="$(curl -k -s https://127.0.0.1/wolverine/ -H "Host: $DOMAIN" | head -c 300000)"

ASSET="$(printf "%s" "$HTML" | grep -oE '/wolverine/_next/[^"]+\.(js|css)' | head -n 1 || true)"

hdr "Basic checks (local HTTPS)"
echo "-- / (should be 302 -> /wolverine/) --"
curl -k -sSI https://127.0.0.1/ -H "Host: $DOMAIN" | head -n 10

echo "-- /wolverine/ (should be 200) --"
curl -k -sSI https://127.0.0.1/wolverine/ -H "Host: $DOMAIN" | head -n 10

echo "-- /favicon.ico (should be 204) --"
curl -k -sSI https://127.0.0.1/favicon.ico -H "Host: $DOMAIN" | head -n 10

hdr "Directory check (403 is normal if autoindex off)"
echo "-- /wolverine/_next/ (403 is OK) --"
curl -k -sSI https://127.0.0.1/wolverine/_next/ -H "Host: $DOMAIN" | head -n 10

hdr "Asset file check (should be 200 or 304)"
if [[ -z "$ASSET" ]]; then
  echo "[WARN] Aucun asset /wolverine/_next/... trouvé dans le HTML (bizarre, mais pas forcément bloquant)."
  exit 0
fi

echo "Asset detected: $ASSET"
curl -k -sSI "https://127.0.0.1${ASSET}" -H "Host: $DOMAIN" | head -n 15
BASH

chmod +x /root/check_wolverine_assets.sh
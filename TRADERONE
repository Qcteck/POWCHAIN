from pathlib import Path
import re

cfg = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = cfg.read_text(errors="ignore")
inc = "include /etc/nginx/snippets/traderone_api_lockdown.conf;"

def find_block(text, pat):
    m = re.search(pat, text)
    if not m: return None
    start = m.start()
    brace = text.find("{", start)
    if brace == -1: return None
    i = brace
    depth = 0
    end = None
    while i < len(text):
        if text[i] == "{": depth += 1
        elif text[i] == "}":
            depth -= 1
            if depth == 0:
                end = i
                break
        i += 1
    if end is None: return None
    return start, end+1, brace

api_pat = r'location\s+(\^~\s+)?=?\s*/wolverine/traderone/api/?\s*\{'
wol_pat = r'location\s+(\^~\s+)?=?\s*/wolverine/?\s*\{'

# remove include everywhere first
s = s.replace(inc, "")

api = find_block(s, api_pat)
if not api:
    raise SystemExit("❌ No /wolverine/traderone/api location block found in nginx site file")
a0,a1,abrace = api

block = s[a0:a1]
# inject include right after the opening brace
block2 = re.sub(r'\{\s*', '{\n    ' + inc + '\n', block, count=1)
s2 = s[:a0] + block2 + s[a1:]
cfg.write_text(s2)
print("OK: include kept ONLY inside /wolverine/traderone/api location")
PY


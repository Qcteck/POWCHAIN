/** Registry helpers */
function scoreDefault(){return {value:50,confidence:60,last:"—"};}
function getScore(R,id){return R.scores[id]||(R.scores[id]=scoreDefault());}
function touch(R,id,msg){
  R.lastRun[id]=now();
  const sc=getScore(R,id);
  sc.last=msg||"ok";
  R.history.push({t:now(),id,msg:sc.last});
  if(R.history.length>200) R.history.shift();
}
function pickRR(R,arr,key){
  if(!arr.length) return null;
  const i=R.rr[key]%arr.length;
  R.rr[key]=(i+1)%arr.length;
  return arr[i];
}

function exploreAll(){
  const R=S.registry;
  const T=S.taxonomy;

  const obj=pickRR(R,T.objectives,"obj");
  const tool=pickRR(R,T.tools,"tool");
  const strat=pickRR(R,T.strategies,"strat");
  const capI=pickRR(R,T.capacities.internal_acquired,"capI");
  const capE=pickRR(R,T.capacities.external_improving,"capE");

  const findings=[];
  if(obj){
    const kit=S.kitMap[obj.id]||{tools:[],strategies:[],caps:[]};
    findings.push({k:"OBJ_KIT",id:obj.id,kit});
    touch(R,obj.id,"explore kit");
  }
  if(tool){ findings.push({k:"TOOL",id:tool.id,scope:tool.scope}); touch(R,tool.id,"explore tool"); }
  if(strat){ findings.push({k:"STRAT",id:strat.id}); touch(R,strat.id,"explore strategy"); }
  if(capI){ findings.push({k:"CAP_I",id:capI.id}); touch(R,capI.id,"explore cap internal"); }
  if(capE){ findings.push({k:"CAP_E",id:capE.id}); touch(R,capE.id,"explore cap external"); }

  return {obj,tool,strat,capI,capE,findings};
}

function exploitObjective(objectiveId){
  const R=S.registry;
  const obj=S.taxonomy.objectives.find(x=>x.id===objectiveId)||S.taxonomy.objectives[0];
  if(!obj) return null;
  const kit=S.kitMap[obj.id]||{tools:[],strategies:[],caps:[]};

  const del={
    type:"DELIVERABLE",
    objective:obj.id,
    title:obj.name,
    kit,
    plan:[
      "Objectif: "+obj.name,
      "Risque: faible / moyen / élevé (à choisir)",
      "Action unique: (toujours PENDING si sensible)",
      "Question (1): Que veux-tu faire maintenant?"
    ]
  };
  R.deliverables.push({t:now(),...del});
  if(R.deliverables.length>60) R.deliverables.shift();
  touch(R,obj.id,"exploit deliverable");
  return del;
}

/** SAIE scheduler (one orchestrator) */
function canRun(loopKey){
  const L=S.loops[loopKey];
  return !L.lock && (now()-L.last)>=L.ttlMs;
}
async function runLoop(loopKey, fn){
  const L=S.loops[loopKey];
  if(L.lock) return null;
  L.lock=true;
  try{
    const r=await fn();
    L.last=now();
    return r;
  }catch(e){
    pushErr(loopKey+" fail");
    return null;
  }finally{
    L.lock=false;
  }
}

async function loopS(){
  S.loops.S.step="S1";
  // metrics
  const mu=process.memoryUsage();
  S.metrics.proc={rss:mu.rss, heapUsed:mu.heapUsed, heapTotal:mu.heapTotal, ext:mu.external};
  S.metrics.sys={total:os.totalmem(), free:os.freemem(), load:os.loadavg(), up:os.uptime()};
  S.metrics.last=now();
  // update err chip calc
  S.meta.updatedAt=iso();
  return {ok:true};
}

async function loopE(){
  S.loops.E.step="E1";
  // External loop (your ecosystem): keep it read-only here; just health echo
  return {ok:true,services:{nginx:true,backend:true},port:PORT};
}

async function loopI(){
  S.loops.I.step="I1";
  // RSS refresh by TTL
  if((now()-S.rss.cache.last)>S.rss.cache.ttlMs){
    const parser=new RSSParser({timeout:15000});
    const want = (S.user.lang==="fr"? [...S.rss.feeds.fr, ...S.rss.feeds.en] : [...S.rss.feeds.en, ...S.rss.feeds.fr]).slice(0,10);
    const all=[];
    for(const feedUrl of want){
      try{
        const feed=await parser.parseURL(feedUrl);
        const items=(feed.items||[]).slice(0,10).map(it=>({
          title:(it.title||"").trim(),
          link:(it.link||"").trim(),
          pub:it.isoDate||it.pubDate||"",
          src:feedUrl
        })).filter(x=>x.title && x.link);
        // basic feed score
        const domain=domainOf(feedUrl);
        const sc=S.rss.cache.feedScores[domain]||{ok:0,fail:0,avgQ:55};
        sc.ok += items.length?1:0;
        S.rss.cache.feedScores[domain]=sc;
        all.push(...items);
      }catch(e){
        const domain=domainOf(feedUrl);
        const sc=S.rss.cache.feedScores[domain]||{ok:0,fail:0,avgQ:55};
        sc.fail++;
        S.rss.cache.feedScores[domain]=sc;
      }
    }
    // sort by date desc if parseable
    all.sort((a,b)=> (Date.parse(b.pub)||0)-(Date.parse(a.pub)||0));
    S.rss.cache.items=all.slice(0,30);
    S.rss.cache.last=now();
    // pick newest
    S.rss.cache.picked = S.rss.cache.items[0] || null;
    logUI("SYS","RSS refreshed: "+S.rss.cache.items.length+" items");
  }

  // Market refresh by TTL
  if((now()-S.market.cache.last)>S.market.cache.ttlMs){
    const m=await fetchMarket();
    if(m.ok){
      S.market.cache.prices=m.prices;
      S.market.cache.last=now();
    }
  }

  // Article extraction by TTL if picked differs
  const pk=S.rss.cache.picked;
  if(pk && pk.link){
    const needNew = (S.article.cache.url!==pk.link) || ((now()-S.article.cache.last)>S.article.cache.ttlMs);
    if(needNew){
      const ex=await extractArticle(pk.link);
      const title=ex.title || pk.title;
      const txt=ex.text||"";
      const q=ex.quality||0;

      S.article.cache.url=pk.link;
      S.article.cache.title=title;
      S.article.cache.pub=pk.pub;
      S.article.cache.domain=ex.domain||domainOf(pk.link);
      S.article.cache.rawLen=txt.length;
      S.article.cache.textLen=txt.length;
      S.article.cache.quality=q;
      S.article.cache.method=ex.method;
      S.article.cache.paywall=!!ex.paywall;
      S.article.cache.lang=detectLang(txt) || null;
      S.article.cache.tags=detectTags(title,txt);
      S.article.cache.sentiment=sentiment(title,txt);
      S.article.cache.summary=summarize(txt);
      S.article.cache.content=txt;
      S.article.cache.last=now();

      // translate summary only if needed
      const userLang=S.user.lang||"fr";
      const srcLang=S.article.cache.lang;
      if(userLang && srcLang && userLang!==srcLang){
        const tr=await translateBestEffort(S.article.cache.summary, userLang);
        S.article.cache.summary = tr.text || S.article.cache.summary;
      }

      logUI("AI", `Article updated (${S.article.cache.domain}) q=${q} method=${S.article.cache.method} paywall=${S.article.cache.paywall}`);
    }
  }

  return {ok:true};
}

async function loopA(){
  S.loops.A.step="A1";
  // Explore/exploit registry across Objective/Tool/Strategy/Capacity (each cycle)
  const exploration=exploreAll();
  const deliverable=exploitObjective(S.activeObjective||"OBJ_DAILY_BRIEF");

  // Decision module: create PENDING proposals (no auto)
  // Example: if paywall suspected, propose "user paste article text"
  if(S.article.cache.paywall){
    const pid="ACT_PASTE_"+now();
    const exists=S.perms.pending.some(x=>x && x.id===pid);
    if(!exists){
      S.perms.pending.push({
        id:pid,
        type:"REQUEST_USER_INPUT",
        desc:"Article semble bloqué (paywall/short). Proposer: coller le texte complet (ingest) pour analyse fiable.",
        status:"PENDING",
        createdAt:iso()
      });
      if(S.perms.pending.length>40) S.perms.pending.shift();
    }
  }

  // Always keep X/on-chain write as pending-only if ever requested
  // (no keys here; policy enforced)
  return {ok:true, exploration, deliverable};
}

async function orchestratorBeat(){
  // schedule at most one run per loop per beat (non-blocking by locks/ttl)
  const out={t:now(), ran:[]};
  if(canRun("S")){ await runLoop("S", loopS); out.ran.push("S"); }
  if(canRun("E")){ await runLoop("E", loopE); out.ran.push("E"); }
  if(canRun("I")){ await runLoop("I", loopI); out.ran.push("I"); }
  if(canRun("A")){ await runLoop("A", loopA); out.ran.push("A"); }

  // update err rate window
  S.errors.events = S.errors.events.slice(-200);

  // persist
  saveState(S);
  return out;
}

/** Manual ingest full article text (user-provided = guaranteed) */
function ingestArticle({title,url,text,lang}){
  const t = safeStr(text,240000);
  const h = sha((title||"")+"|"+(url||"")+"|"+t);
  S.article.ingest.lastHash=h;
  S.article.ingest.lastAt=now();

  const effectiveTitle=title||S.article.cache.title||"(Article collé)";
  const effectiveUrl=url||S.article.cache.url||null;
  S.article.cache.url=effectiveUrl;
  S.article.cache.title=effectiveTitle;
  S.article.cache.domain=effectiveUrl?domainOf(effectiveUrl):"(pasted)";
  S.article.cache.method="INGEST_PASTE";
  S.article.cache.paywall=false;
  S.article.cache.lang=lang||detectLang(t)||null;
  S.article.cache.content=t;
  S.article.cache.quality=clamp(qualityScore(t)+20,0,100);
  S.article.cache.tags=detectTags(effectiveTitle,t);
  S.article.cache.sentiment=sentiment(effectiveTitle,t);
  S.article.cache.summary=summarize(t);
  S.article.cache.last=now();

  // translate summary to user lang if needed
  // (best-effort; synchronous not required here)
  return {ok:true,hash:h,quality:S.article.cache.quality};
}

/** Permissions approve/refuse */
function decidePending(id, ok){
  const i=S.perms.pending.findIndex(x=>x && x.id===id);
  if(i<0) return {ok:false,error:"not_found"};
  const item=S.perms.pending.splice(i,1)[0];
  item.status = ok ? "APPROVED" : "REFUSED";
  item.decidedAt = iso();
  S.perms.decided.push(item);
  if(S.perms.decided.length>80) S.perms.decided.shift();
  return {ok:true,item};
}

/** Local model integration (optional, no download here)
 * You can set:
 *   LOCAL_MODEL_CMD="ollama run llama3.2:1b --" (or llama.cpp main)
 * This server will pipe prompt and read stdout (best-effort).
 */
async function localModelGenerate(prompt){
  const cmd=process.env.LOCAL_MODEL_CMD||"";
  if(!cmd.trim()){
    return {ok:false,method:"none",text:"(Modèle local non configuré. Définis LOCAL_MODEL_CMD pour activer.)"};
  }
  // Minimal safe: do not execute arbitrary shell. Only allow whitelisted prefix.
  const allow = ["ollama ","/usr/local/bin/","/usr/bin/","/opt/"];
  if(!allow.some(p=>cmd.startsWith(p))){
    return {ok:false,method:"blocked",text:"(LOCAL_MODEL_CMD refusé: chemin non autorisé.)"};
  }
  const {spawn} = require("child_process");
  const parts=cmd.split(" ").filter(Boolean);
  const bin=parts.shift();
  const args=parts;
  return await new Promise((res)=>{
    try{
      const p=spawn(bin,args,{stdio:["pipe","pipe","pipe"]});
      let out="",err="";
      const kill=setTimeout(()=>{ try{p.kill("SIGKILL");}catch(e){} }, 15000);
      p.stdout.on("data",d=>{ out+=d.toString("utf8"); if(out.length>20000) out=out.slice(0,20000); });
      p.stderr.on("data",d=>{ err+=d.toString("utf8"); if(err.length>4000) err=err.slice(0,4000); });
      p.on("close",()=>{
        clearTimeout(kill);
        const t=(out||"").trim();
        if(t) return res({ok:true,method:"cmd",text:t});
        return res({ok:false,method:"cmd",text:"(Aucune sortie modèle.) "+(err?err.slice(0,300):"")});
      });
      p.stdin.write(String(prompt||""));
      p.stdin.end();
    }catch(e){
      res({ok:false,method:"spawn_fail",text:"(Erreur modèle local.)"});
    }
  });
}


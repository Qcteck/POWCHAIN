cat >/root/FIX_WOLVERINE_SOL_USDC_ROOT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIX WOLVERINE SOL + USDC (SAFE) ==="

WEBROOT="/var/www/wolverine"
INDEX="$WEBROOT/index.html"
JS="$WEBROOT/wallet-balances.js"
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

### 1. JS BALANCE FILE
cat >"$JS" <<JS
(async ()=>{
 if(!window.solana || !window.solana.isPhantom) return;
 const provider=window.solana;
 await provider.connect();
 const pubkey=provider.publicKey;
 const conn=new solanaWeb3.Connection("$RPC","confirmed");

 const sol=await conn.getBalance(pubkey);
 const solEl=document.querySelector("#sol");
 if(solEl) solEl.innerText=(sol/1e9).toFixed(4);

 const toks=await conn.getParsedTokenAccountsByOwner(
  pubkey,{mint:new solanaWeb3.PublicKey("$USDC_MINT")}
 );
 let usdc=0;
 toks.value.forEach(t=>{
  usdc+=t.account.data.parsed.info.tokenAmount.uiAmount||0;
 });
 const usdcEl=document.querySelector("#usdc");
 if(usdcEl) usdcEl.innerText=usdc.toFixed(2);
})();
JS

### 2. ENSURE HTML TARGETS
sed -i 's|SOL:.*|SOL: <span id="sol">0</span>|' "$INDEX"
sed -i 's|USDC:.*|USDC: <span id="usdc">0</span>|' "$INDEX"

### 3. INCLUDE SCRIPT IF NOT PRESENT
grep -q "wallet-balances.js" "$INDEX" || \
sed -i 's|</body>|<script src="/wolverine/wallet-balances.js"></script></body>|' "$INDEX"

### 4. PERMS
chmod 644 "$JS"

### 5. RELOAD NGINX
nginx -t
systemctl reload nginx

echo "=== DONE ==="
echo "OPEN: https://fireinners.online/wolverine/"
BASH

chmod +x /root/FIX_WOLVERINE_SOL_USDC_ROOT.sh
/root/FIX_WOLVERINE_SOL_USDC_ROOT.sh
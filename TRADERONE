set -e
cd /root

echo "=== 1) Vérifie si curl est aliasé ==="
type curl || true
alias curl 2>/dev/null || echo "OK: pas d'alias curl"
echo

echo "=== 2) Test SANS clé (forcé) via /usr/bin/curl + pas de curlrc ==="
URL="https://127.0.0.1/wolverine/traderone/api/status"

# -q ignore ~/.curlrc
# -H 'X-API-KEY:' force un header vide (donc pas de clé)
/usr/bin/curl -q -sS -k -i -X POST "$URL" \
  -H "Host: fireinners.online" \
  -H "content-type: application/json" \
  -H "X-API-KEY:" \
  --data '{}' | head -n 40
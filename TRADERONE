#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
TS="$(date +%Y%m%d_%H%M%S)"
DOMAIN="fireinners.online"
BK="/root/BK_NGX_DEMELE_${TS}"
NGX="/etc/nginx"
VHOST_DEFAULT="/etc/nginx/sites-available/fireinners.online-ssl"
WOLV_WWW="/var/www/wolverine"
WOLV_INDEX="${WOLV_WWW}/index.html"
WOLV_INC_DIR="${NGX}/includes"
WOLV_INC="${WOLV_INC_DIR}/wolverine_routes.inc"
SNIP_DIR="${NGX}/snippets"
LOG="/root/MEGA_DEMELE_WOLV_AQ_${TS}.log"
say(){ echo "[$(date -u +'%F %T UTC')] $*" | tee -a "$LOG"; }

say "== MEGA DEMELE WOLVERINE / AIAQUILA (NGINX) =="
say "BACKUP -> $BK"
mkdir -p "$BK"
cp -a "$NGX" "$BK/nginx" 2>/dev/null || true

# --- best-effort unlock immutable bits
if command -v chattr >/dev/null 2>&1; then
  say "UNFREEZE chattr -i (best effort)"
  for f in "$NGX/nginx.conf" "$VHOST_DEFAULT" "$WOLV_INC" "$SNIP_DIR/aiaquila_locations.conf"; do
    [ -e "$f" ] && chattr -i "$f" 2>/dev/null || true
  done
  chattr -i "$NGX/nginx.conf" 2>/dev/null || true
  find "$NGX" -maxdepth 3 -type f \( -name "*.conf" -o -name "*.inc" \) -print0 2>/dev/null | while IFS= read -r -d '' f; do
    chattr -i "$f" 2>/dev/null || true
  done
fi

# --- find vhost actually serving fireinners.online
VHOST="$VHOST_DEFAULT"
if [ ! -f "$VHOST" ]; then
  say "VHOST default missing, searching..."
  VHOST="$(grep -RIl --include="*.conf" --include="*" "server_name[[:space:]].*fireinners\.online" "$NGX/sites-available" "$NGX/conf.d" 2>/dev/null | head -n1 || true)"
fi
if [ -z "${VHOST:-}" ] || [ ! -f "$VHOST" ]; then
  say "ERROR: cannot find vhost containing server_name fireinners.online"
  exit 1
fi
say "VHOST = $VHOST"
cp -a "$VHOST" "$BK/$(basename "$VHOST").bak" 2>/dev/null || true

# --- ensure webroot + index
say "ENSURE $WOLV_INDEX"
mkdir -p "$WOLV_WWW"
cat >"$WOLV_INDEX" <<'HTML'
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WOLVERINE OK</title><style>body{font-family:system-ui,Segoe UI,Roboto,Arial;margin:0;padding:0;background:#0b0f14;color:#e6eef8}main{padding:26px}a{color:#7ab7ff;text-decoration:none}a:hover{text-decoration:underline}.p{opacity:.9}</style></head><body><main><h1>WOLVERINE OK</h1><p class="p">Si tu vois cette page, <b>/wolverine/</b> sert bien le webroot.</p><p><a href="/wolverine/vault-api/health">/wolverine/vault-api/health</a> · <a href="/wolverine/traderone/vault/health">/wolverine/traderone/vault/health</a> · <a href="/wolverine/traderone/api/health">/wolverine/traderone/api/health</a></p></main></body></html>
HTML

# --- write wolverine include (locations-only, must be included INSIDE server{})
say "WRITE $WOLV_INC"
mkdir -p "$WOLV_INC_DIR"
cp -a "$WOLV_INC" "$BK/wolverine_routes.inc.bak" 2>/dev/null || true
cat >"$WOLV_INC" <<'NGX'
# wolverine routes (managed) - locations-only include (put inside server{})
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
# backend 3000 (existing)
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
# traderone vault/api -> backend 3000
location ^~ /wolverine/traderone/vault/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
NGX

# --- HARD DEMELE: disable AIAQUILA snippets that are breaking nginx (duplicate locations / wrong include context)
say "DEMELE: disable aiaquila snippets that break nginx"
shopt -s nullglob
for f in "$SNIP_DIR"/*aiaquila*.conf "$NGX/includes"/*aiaquila*.inc; do
  [ -f "$f" ] || continue
  cp -a "$f" "$BK/$(basename "$f").bak" 2>/dev/null || true
  mv -f "$f" "$f.disabled_${TS}" 2>/dev/null || true
  cat >"$f" <<'TXT'
# DISABLED by MEGA_DEMELE_WOLV_AQ (kept placeholder so includes won't crash)
# Reason: aiaquila locations were interfering with nginx (duplicate/invalid location context)
TXT
  say "DISABLED -> $f (saved as $f.disabled_${TS})"
done
shopt -u nullglob

# --- remove any accidental include of wolverine/aiaquila snippets in nginx.conf (global/http context)
say "CLEAN nginx.conf: remove accidental includes (wolverine/aiaquila) outside vhost"
python3 - <<'PY'
import re, pathlib
p=pathlib.Path("/etc/nginx/nginx.conf")
if p.exists():
  s=p.read_text(encoding="utf-8", errors="ignore").splitlines(True)
  out=[]
  changed=False
  for line in s:
    if re.search(r'include\s+.*(wolverine_routes|aiaquila).*;', line):
      out.append("# DEMELE_REMOVED "+line)
      changed=True
    else:
      out.append(line)
  if changed:
    p.write_text("".join(out), encoding="utf-8")
PY

# --- ensure vhost has exactly one include line INSIDE the correct server{} for fireinners.online
say "PATCH vhost: ensure include inside server{} for $DOMAIN"
python3 - <<'PY'
import re, pathlib
vhost=pathlib.Path(r"""'"$VHOST"'''""")
inc=r"""include /etc/nginx/includes/wolverine_routes.inc;"""
txt=vhost.read_text(encoding="utf-8", errors="ignore")

# remove duplicate include lines anywhere first
lines=txt.splitlines(True)
new=[]
seen=0
for ln in lines:
  if re.search(r'include\s+/etc/nginx/includes/wolverine_routes\.inc\s*;', ln):
    seen+=1
    if seen==1:
      new.append(ln)
    else:
      new.append("# DEMELE_DUP_REMOVED "+ln)
  else:
    new.append(ln)
txt="".join(new)

# if include missing, insert near end of server block that contains server_name fireinners.online
if "include /etc/nginx/includes/wolverine_routes.inc;" not in txt:
  # naive server-block insertion: find server{...} containing server_name fireinners.online
  m=re.search(r'(server\s*\{)(.*?server_name\s+[^;]*\bfireinners\.online\b[^;]*;)(.*?\n\})', txt, flags=re.S)
  if m:
    block=m.group(0)
    if inc not in block:
      # insert before last closing brace in that server block
      block2=re.sub(r'\n\}\s*$', "\n  "+inc+"\n}\n", block)
      txt=txt.replace(block, block2, 1)
  else:
    # fallback: append include at end (commented) if no match
    txt += "\n# DEMELE_NOTE: could not find server block for fireinners.online to inject wolverine include\n"
vhost.write_text(txt, encoding="utf-8")
PY

# --- nginx test + reload
say "NGINX TEST"
nginx -t 2>&1 | tee -a "$LOG"

say "RELOAD nginx"
systemctl reload nginx 2>/dev/null || systemctl restart nginx

# --- local tests (bypass CF)
say "TEST LOCAL (bypass CF) /wolverine/ first bytes"
curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | head -c 180 || true; echo
say "TEST LOCAL /wolverine/vault-api/health"
curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/vault-api/health" || true; echo
say "TEST LOCAL /wolverine/traderone/vault/health"
curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/traderone/vault/health" || true; echo
say "TEST LOCAL /wolverine/traderone/api/health"
curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/traderone/api/health" || true; echo

# --- best-effort refreeze
if command -v chattr >/dev/null 2>&1; then
  say "REFREEZE chattr +i (best effort)"
  chattr +i "$NGX/nginx.conf" 2>/dev/null || true
  chattr +i "$VHOST" 2>/dev/null || true
  chattr +i "$WOLV_INC" 2>/dev/null || true
fi

say "DONE"
say "Backups: $BK"
say "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
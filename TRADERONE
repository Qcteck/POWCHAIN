cat >/root/AUDIT_WOLVERINE_SERVED.sh <<'BASH'
#!/usr/bin/env bash
set -e

echo "=================================================="
echo " AUDIT RÉEL VPS • CE QUI EST VRAIMENT SERVI "
echo "=================================================="
echo

### 1️⃣ nginx vhost actif
echo "[1] VHOST NGINX UTILISÉ"
nginx -T 2>/dev/null | grep -E "server_name|root " | sed 's/^/  /'
echo

### 2️⃣ Mapping réel du dossier /wolverine
echo "[2] DOSSIER RÉEL SERVI PAR /wolverine"
ROOT=$(nginx -T 2>/dev/null | awk '/location \/wolverine/ {f=1} f&&/root /{print $2;exit}')
[ -z "$ROOT" ] && ROOT="/var/www"
echo " ROOT détecté : $ROOT"
ls -lah "$ROOT/wolverine" || echo " ERREUR: dossier introuvable"
echo

### 3️⃣ index réellement servi
echo "[3] INDEX.HTML EFFECTIF"
realpath "$ROOT/wolverine/index.html" || echo " ERREUR index.html absent"
echo

### 4️⃣ Scripts JS réellement présents
echo "[4] FICHIERS JS LOCAUX"
find "$ROOT/wolverine" -maxdepth 3 -type f \( -name "*.js" -o -name "*.mjs" \) | sed 's/^/  /'
echo

### 5️⃣ Ce que nginx sert vraiment (HTTP)
echo "[5] TEST HTTP DIRECT (SANS NAVIGATEUR)"
URL_BASE="https://fireinners.online/wolverine"

echo "- index.html"
curl -I "$URL_BASE/" | head -n 5
echo

echo "- solana-web3"
curl -I "$URL_BASE/vendor/solana-web3.min.js" | head -n 5
echo

### 6️⃣ Scan réel des scripts chargés
echo "[6] SCRIPTS RÉFÉRENCÉS DANS index.html"
grep -E "<script" "$ROOT/wolverine/index.html" | sed 's/^/  /'
echo

### 7️⃣ Détection DOUBLONS Phantom / Vault
echo "[7] DOUBLONS STRUCTURELS"
grep -R "Connect Phantom" "$ROOT/wolverine/index.html" | wc -l | awk '{print " Connect Phantom count:",$1}'
grep -R "Créer mon Vault" "$ROOT/wolverine/index.html" | wc -l | awk '{print " Vault blocks count:",$1}'
echo

### 8️⃣ Cache nginx
echo "[8] CACHE NGINX"
ls -lah /var/cache/nginx 2>/dev/null || echo " Pas de cache nginx"
echo

echo "=================================================="
echo " FIN AUDIT — CE QUI EST AFFICHÉ ICI = RÉALITÉ VPS "
echo "=================================================="
BASH

chmod +x /root/AUDIT_WOLVERINE_SERVED.sh
/root/AUDIT_WOLVERINE_SERVED.sh
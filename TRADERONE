cat >/root/WOLVERINE_FIX_REFRESH_BIND.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
BACKUP="$HTML.fix_refresh_$(date +%Y%m%d_%H%M%S)"

cp "$HTML" "$BACKUP"
echo "[OK] Backup $BACKUP"

perl -0777 -i -pe '
# force refreshSOL en global + log
s#function\s+refreshSOL\s*\(#window.refreshSOL = async function(#g;

# rebinde le bouton Refresh
s#<button[^>]*>Refresh</button>#<button onclick="refreshSOL()">Refresh</button>#g;

# ajoute log de confirmation
s#window.refreshSOL = async function\(#window.refreshSOL = async function(\nconsole.log("REFRESH CLICK OK");#s
' "$HTML"

nginx -t && systemctl reload nginx
echo "DONE — CTRL+SHIFT+R puis clique Refresh"
BASH

chmod +x /root/WOLVERINE_FIX_REFRESH_BIND.sh
/root/WOLVERINE_FIX_REFRESH_BIND.sh
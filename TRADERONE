"use strict";
require("dotenv").config();
const fs=require("fs");
const path=require("path");
const express=require("express");
const {execFile}=require("child_process");

const {Keypair,PublicKey,Connection}=require("@solana/web3.js");

const HOST=process.env.HOST||"127.0.0.1";
const PORT=parseInt(process.env.PORT||"3050",10);
const BASE_PATH=process.env.BASE_PATH||"/wolverine";
const RPC_URL=process.env.RPC_URL||"";
const MONITOR_URI=process.env.MONITOR_URI||"";
const MONITOR_SEC=Math.max(3,parseInt(process.env.MONITOR_SEC||"10",10));
const MONITOR_FAILS=Math.max(1,parseInt(process.env.MONITOR_FAILS||"3",10));
const TG_ALERTS=String(process.env.TG_ALERTS||"0")==="1";
const WOLV_SEND=process.env.WOLV_SEND||"";

const STATE_DIR=path.join(__dirname,"state");
const WALLET_JSON=path.join(STATE_DIR,"custody_wallet.json");
const WALLET_PUB=path.join(STATE_DIR,"custody_wallet.pub");

function ensureDir(p){ try{ fs.mkdirSync(p,{recursive:true}); }catch(_){} }
ensureDir(STATE_DIR);

function loadOrCreateCustody(){
  try{
    if(fs.existsSync(WALLET_JSON)&&fs.existsSync(WALLET_PUB)){
      const pub=String(fs.readFileSync(WALLET_PUB,"utf8")).trim();
      const raw=JSON.parse(String(fs.readFileSync(WALLET_JSON,"utf8")));
      if(pub && Array.isArray(raw) && raw.length===64) return {pub, raw};
    }
  }catch(_){}
  const kp=Keypair.generate();
  const raw=Array.from(kp.secretKey);
  const pub=kp.publicKey.toBase58();
  fs.writeFileSync(WALLET_JSON,JSON.stringify(raw));
  fs.writeFileSync(WALLET_PUB,pub);
  try{ fs.chmodSync(WALLET_JSON,0o600); }catch(_){}
  try{ fs.chmodSync(WALLET_PUB,0o644); }catch(_){}
  return {pub, raw};
}

const custody=loadOrCreateCustody();

let running=false;
let loopOn=false;
let loopTimer=null;
let lastMonitor={ts:null, ok:null, status:null, body:null, fails:0};
let lastStart=null;

function nowISO(){ return new Date().toISOString(); }

function tgSend(msg){
  if(!TG_ALERTS) return;
  if(!WOLV_SEND) return;
  try{
    execFile(WOLV_SEND,[String(msg).slice(0,3500)],{timeout:8000},()=>{});
  }catch(_){}
}

async function monitorTick(){
  const ts=nowISO();
  if(!MONITOR_URI){
    lastMonitor={ts, ok:true, status:200, body:"no MONITOR_URI", fails:0};
    return;
  }
  try{
    const r=await fetch(MONITOR_URI,{method:"GET"});
    const tx=await r.text();
    const ok=r.ok && /pong/i.test(tx);
    lastMonitor={ts, ok, status:r.status, body:tx.slice(0,200), fails: ok?0: (lastMonitor.fails+1)};
    if(!ok && lastMonitor.fails>=MONITOR_FAILS){
      tgSend(`WOLVERINE MONITOR: ERR (${MONITOR_URI}) ${ts} status=${r.status} body=${tx.slice(0,120)}`);
      lastMonitor.fails=0;
    }
  }catch(e){
    lastMonitor={ts, ok:false, status:0, body:String(e&&e.message||e).slice(0,200), fails:lastMonitor.fails+1};
    if(lastMonitor.fails>=MONITOR_FAILS){
      tgSend(`WOLVERINE MONITOR: OFFLINE ${ts} err=${lastMonitor.body}`);
      lastMonitor.fails=0;
    }
  }
}

function loopStart(){
  if(loopOn) return;
  loopOn=true;
  monitorTick().catch(()=>{});
  loopTimer=setInterval(()=>{ monitorTick().catch(()=>{}); }, MONITOR_SEC*1000);
}
function loopStop(){
  loopOn=false;
  if(loopTimer){ clearInterval(loopTimer); loopTimer=null; }
}

const app=express();
app.disable("x-powered-by");
app.use(express.json({limit:"256kb"}));

app.get("/",(req,res)=>res.json({ok:true, service:"wolverine-api", ts:nowISO()}));
app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));
app.get("/health",(req,res)=>res.json({ok:true, ts:nowISO(), uptime:process.uptime()}));
app.get("/config",(req,res)=>res.json({
  ok:true,
  ts:nowISO(),
  basePath:BASE_PATH,
  apiBase:`${BASE_PATH}/api`,
  host:HOST, port:PORT,
  custodyPubkey:custody.pub,
  monitor:{uri:MONITOR_URI, sec:MONITOR_SEC, fails:MONITOR_FAILS, enabled:loopOn}
}));
app.get("/wallet",(req,res)=>res.json({ok:true, custodyPubkey:custody.pub}));
app.get("/status",(req,res)=>res.json({
  ok:true, ts:nowISO(),
  running, loop:loopOn,
  custodyPubkey:custody.pub,
  lastStart,
  lastMonitor
}));

app.post("/start",(req,res)=>{
  const body=req.body||{};
  running=true;
  lastStart={ts:nowISO(), budget:body.budget||null, mode:body.mode||null, mint:body.mint||null, phantomPubkey:body.phantomPubkey||null};
  res.json({ok:true, running, lastStart});
});
app.post("/stop",(req,res)=>{ running=false; res.json({ok:true, running}); });

app.post("/loop/start",(req,res)=>{ loopStart(); res.json({ok:true, loop:true, monitor:lastMonitor}); });
app.post("/loop/stop",(req,res)=>{ loopStop(); res.json({ok:true, loop:false}); });

const server=app.listen(PORT,HOST,()=>{ console.log(`[wolverine-api] listening http://${HOST}:${PORT} base=${BASE_PATH}`); });

process.on("SIGTERM",()=>{ try{loopStop();}catch(_){}; server.close(()=>process.exit(0)); });
process.on("SIGINT",()=>{ try{loopStop();}catch(_){}; server.close(()=>process.exit(0)); });
JS

askorupdate_file "${APPDIR}/server.js" "WOLVERINE server.js" SERVER_JS
chmod 644 "${APPDIR}/server.js" || true

# package deps (install only if missing)
cd "$APPDIR"
if [ ! -f package.json ]; then npm init -y >/dev/null 2>&1 || true; fi
node -e "require('express');
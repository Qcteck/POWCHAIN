set -euo pipefail

echo "=== 1) Chercher un repo git sur le serveur (dans les endroits classiques) ==="
for d in /var/www /opt /srv /home /root; do
  [ -d "$d" ] || continue
  echo "--- scanning $d (maxdepth 4) ---"
  find "$d" -maxdepth 4 -type d -name ".git" 2>/dev/null | head -n 50
done

echo
echo "=== 2) Si tu vois un chemin .git au-dessus, colle-le ici dans REPO_DIR puis relance juste la partie 3 ==="
echo "Exemple: REPO_DIR=/var/www/wolverine"

echo
echo "=== 3) Auto: si un seul repo trouvé, on s'y place et on affiche origin ==="
REPO_DIR="$(for d in /var/www /opt /srv /home /root; do
  [ -d "$d" ] || continue
  find "$d" -maxdepth 4 -type d -name ".git" 2>/dev/null
done | sed 's|/\.git$||' | head -n 1)"

echo "Repo candidat: ${REPO_DIR:-NONE}"
[ -n "${REPO_DIR:-}" ] || { echo "❌ Aucun repo trouvé automatiquement (ou trop profond)"; exit 1; }

cd "$REPO_DIR"
echo "PWD=$(pwd)"
git remote -v || true
git ls-remote --get-url origin || true
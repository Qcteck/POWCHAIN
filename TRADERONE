cat >/root/MEGA_WOLVERINE_RESTORE_BALANCES.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "[+] WOLVERINE — RESTORE BALANCES + CLEAN BUDGET"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/WOLVERINE_BACKUP_$TS"
mkdir -p "$BK"

### PATHS
WOLVROOT="/var/www/wolverine"
HTML="$WOLVROOT/index.html"
NGINX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

### BACKUP
echo "[+] Backup HTML"
cp "$HTML" "$BK/index.html.bak"

### PATCH HTML
echo "[+] Patch balances + remove second budget"

perl -0777 -i -pe '
# REMOVE SECOND BUDGET BLOCK
s/<!--\s*BUDGET_SOL_2_START\s*-->.*?<!--\s*BUDGET_SOL_2_END\s*-->//gs;

# FORCE BALANCE DISPLAY (SOL + USDC)
s/const\s+SHOW_SOL_BUDGET_2\s*=\s*true/const SHOW_SOL_BUDGET_2=false/g;
s/const\s+ENABLE_SECOND_BUDGET\s*=\s*true/const ENABLE_SECOND_BUDGET=false/g;

# ENSURE BALANCES ALWAYS RENDER
s/function renderBalances\(.*?\{.*?\}/function renderBalances(wallet){if(!wallet)return;updateSOL(wallet);updateUSDC(wallet);}/s;

# ENSURE SOL RPC
s|const RPC_URL\s*=.*?;|const RPC_URL="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";|g;

' "$HTML"

### VERIFY
grep -q "updateSOL" "$HTML" || { echo "[!] SOL balance function missing"; exit 1; }
grep -q "updateUSDC" "$HTML" || { echo "[!] USDC balance function missing"; exit 1; }

### NGINX
echo "[+] Reload nginx"
nginx -t
systemctl reload nginx

### BACKEND (safe restart if exists)
if pm2 list >/dev/null 2>&1; then
  echo "[+] Restart PM2"
  pm2 restart all || true
fi

echo "[✓] DONE"
echo "Backup: $BK"
echo "URL: https://fireinners.online/wolverine"
BASH

chmod +x /root/MEGA_WOLVERINE_RESTORE_BALANCES.sh
echo "READY → /root/MEGA_WOLVERINE_RESTORE_BALANCES.sh"
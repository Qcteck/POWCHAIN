#!/bin/bash
set -e

echo "=== AIAQUILA + EMBERBRAIN INSTALL ==="

### 1. PRÉREQUIS
apt update -y
apt install -y php php-curl nginx

### 2. DOSSIER
A=/var/www/aiaquila
mkdir -p $A
cd $A

### 3. BACKEND RSS (PHP PROXY)
cat > rss.php <<'PHP'
<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/xml; charset=utf-8");

if(!isset($_GET["url"])) die("Missing url");
$url=$_GET["url"];

$ch=curl_init($url);
curl_setopt_array($ch,[
  CURLOPT_RETURNTRANSFER=>true,
  CURLOPT_FOLLOWLOCATION=>true,
  CURLOPT_TIMEOUT=>10,
  CURLOPT_USERAGENT=>"AIAQUILA-RSS"
]);
$data=curl_exec($ch);
curl_close($ch);

if(!$data) die("Fetch error");
echo $data;
PHP

### 4. FRONTEND AIAQUILA + EMBERBRAIN
cat > index.html <<'HTML'
<!DOCTYPE html><html><head><meta charset="utf-8">
<title>AIAQUILA — EmberBrain</title>
<style>
body{font-family:Arial;background:#111;color:#eee;padding:20px}
button{padding:8px 14px;margin:5px}
#log{white-space:pre-wrap;background:#000;padding:10px;margin-top:10px}
</style></head><body>

<h1>🦅 AIAQUILA — EmberBrain</h1>

<button onclick="loadRSS()">Lire les articles</button>
<button onclick="runEmberBrain()">Analyser</button>

<div id="result"></div>
<div id="log"></div>

<script>
const FEEDS=[
"https://www.coindesk.com/arc/outboundfeeds/rss/",
"https://cointelegraph.com/rss",
"https://news.bitcoin.com/feed/"
];
const PROXY="rss.php?url=";
let ARTICLES=[];

function log(t){logEl.textContent+=t+"\\n";}
const logEl=document.getElementById("log");

async function loadRSS(){
  ARTICLES=[];logEl.textContent="";
  for(const f of FEEDS){
    log("Flux: "+f);
    const r=await fetch(PROXY+encodeURIComponent(f));
    const t=await r.text();
    const x=new DOMParser().parseFromString(t,"text/xml");
    x.querySelectorAll("item").forEach(i=>{
      ARTICLES.push({
        title:i.querySelector("title")?.textContent||"",
        summary:i.querySelector("description")?.textContent||""
      });
    });
  }
  log("Articles chargés: "+ARTICLES.length);
  speak("Articles chargés");
}

function speak(t){
  const u=new SpeechSynthesisUtterance(t);
  u.lang="fr-FR";speechSynthesis.cancel();speechSynthesis.speak(u);
}

/* ================= EMBERBRAIN ================= */

const EmberBrain={
rules:{bull:["bull","hausse","record"],bear:["crash","dump"],risk:["ban","sec","hack"],hype:["pump","fomo"]},
weights:{bull:1,bear:1.2,risk:1.5,hype:0.7},
analyze(a){
 let s={bull:0,bear:0,risk:0,hype:0};
 for(const x of a){
  const t=(x.title+" "+x.summary).toLowerCase();
  for(const k in this.rules)
   this.rules[k].forEach(w=>{if(t.includes(w))s[k]+=this.weights[k]});
 }
 if(s.risk>2)return "⚠️ Risque élevé détecté";
 if(s.bull>s.bear)return "📈 Momentum positif";
 if(s.bear>s.bull)return "📉 Pression vendeuse";
 return "⚖️ Marché neutre";
}
};

function runEmberBrain(){
 if(!ARTICLES.length){speak("Aucun article");return;}
 const r=EmberBrain.analyze(ARTICLES);
 result.textContent=r;speak(r);
}
</script>
</body></html>
HTML

### 5. PERMISSIONS
chown -R www-data:www-data /var/www/aiaquila
chmod -R 755 /var/www/aiaquila

### 6. NGINX
nginx -t && systemctl reload nginx

echo "=== INSTALL TERMINÉE ==="
echo "→ https://fireinners.online/aiaquila/"
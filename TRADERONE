curl -sS "https://api.telegram.org/bot${TG_TOKEN}/getUpdates" | python3 - <<'PY'
import sys,json
raw=sys.stdin.read().strip()
if not raw:
  print("VIDE: curl n'a rien renvoyé -> fais getMe/getUpdates avec -i pour voir pourquoi")
  raise SystemExit
j=json.loads(raw)
ids=[]
for u in j.get("result",[]):
  m=u.get("message") or u.get("edited_message") or {}
  c=m.get("chat") or {}
  if "id" in c: ids.append(c["id"])
print("CHAT_ID:", ids[-1] if ids else "NONE (envoie 'ping' au bot puis relance)")
PY
@echo off
setlocal EnableExtensions EnableDelayedExpansion
cd /d "%~dp0"
echo.
echo [FIX] Dossier: %CD%
echo.

echo === 1) Liste fichiers ===
dir /b
echo.

echo === 2) Renommage extensions cachees (.txt) ===
for %%F in (*.bat.txt) do (echo ren "%%~nxF" "%%~nF.bat" & ren "%%~nxF" "%%~nF.bat" >nul 2>&1)
for %%F in (*.cmd.txt) do (echo ren "%%~nxF" "%%~nF.cmd" & ren "%%~nxF" "%%~nF.cmd" >nul 2>&1)
for %%F in (*.scad.txt) do (echo ren "%%~nxF" "%%~nF.scad" & ren "%%~nxF" "%%~nF.scad" >nul 2>&1)
echo.

echo === 3) Verification OpenSCAD CLI ===
set "OPENSCAD="
if exist "C:\Program Files\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD\openscad.com"
if exist "C:\Program Files\OpenSCAD (Nightly)\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD (Nightly)\openscad.com"
if exist "C:\Program Files (x86)\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files (x86)\OpenSCAD\openscad.com"
if "%OPENSCAD%"=="" (
  echo [ERREUR] openscad.com introuvable.
  echo Installe OpenSCAD puis relance.
  pause
  exit /b 1
)
echo OK: %OPENSCAD%
echo.

echo === 4) Cherche un batch d'export ===
set "RUNBAT="
if exist "ROBO600_MEGA_EXPORT.bat" set "RUNBAT=ROBO600_MEGA_EXPORT.bat"
if exist "ROBO600_MEGA.bat" set "RUNBAT=ROBO600_MEGA.bat"
if exist "ROBO600_1to3_BUILD_STL.cmd" set "RUNBAT=ROBO600_1to3_BUILD_STL.cmd"
if exist "ROBO600_1to3_BUILD_STL.bat" set "RUNBAT=ROBO600_1to3_BUILD_STL.bat"

if "%RUNBAT%"=="" (
  echo [ERREUR] Aucun batch/cmd d'export trouve dans ce dossier.
  echo Fichiers .bat/.cmd presents:
  dir /b *.bat 2>nul
  dir /b *.cmd 2>nul
  echo.
  echo Dis-moi EXACTEMENT ce que tu vois dans "dir /b" et je te donne le bon nom.
  pause
  exit /b 1
)

echo OK: script detecte: %RUNBAT%
echo.

echo === 5) Lancement ===
call "%RUNBAT%"
echo.
pause
endlocal
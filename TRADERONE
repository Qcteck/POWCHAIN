etter-spacing:.12em}label{display:block;color:var(--m);font-size:12px;margin:10px 0 6px}input,select{width:100%;padding:10px 10px;border-radius:10px;border:1px solid rgba(203,182,255,.22);background:rgba(0,0,0,.25);color:var(--t);outline:none}input:focus,select:focus{border-color:rgba(255,106,0,.55);box-shadow:0 0 0 3px rgba(255,106,0,.15)}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pill{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.k{color:var(--m)}.v{font-weight:800}.ok{color:var(--ok)}.bad{color:var(--bad)}#log{flex:1;white-space:pre-wrap;background:rgba(0,0,0,.25);border:1px solid rgba(203,182,255,.18);border-radius:12px;padding:10px;overflow:auto}#foot{display:flex;justify-content:space-between;gap:10px;color:var(--m);font-size:12px;margin-top:10px}code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}@media (max-width:980px){#wrap{grid-template-columns:1fr}#console{min-height:320px}}</style></head><body><div id="top"><div id="bar"><div id="brand"><div id="dot"></div><div><div id="ttl">WOLVERINE</div><div id="sub">TraderOne • Custodial API • Live</div></div></div><div id="btns"><button id="langBtn" class="secondary">EN</button><button id="apiBtn" class="secondary">API</button><button id="pingBtn" class="secondary">Ping</button><button id="loopBtn" class="secondary">Loop</button></div></div></div><div id="wrap"><div id="card"><h3 id="hControl">Control</h3><div class="pill"><div><span class="k" id="kPh">Phantom:</span> <span class="v" id="phAddr">not connected</span></div></div><div class="pill" style="margin-top:10px"><button id="connectBtn">Connect</button><button id="discBtn" class="secondary">Disconnect</button><button id="refreshBtn" class="secondary">Refresh</button></div><div class="row"><div><label id="lSol">SOL (custody)</label><input id="sol" disabled value="-"/></div><div><label id="lUsdc">USDC (custody)</label><input id="usdc" disabled value="-"/></div></div><label id="lCust">Custody (TraderOne deposit address)</label><input id="cust" disabled value="-"/><div class="pill" style="margin-top:8px"><button id="copyCust" class="secondary">Copy</button><button id="openStatus" class="secondary">Status</button></div><label id="lMint">Token mint (Solana)</label><input id="mint" value=""/><div class="row"><div><label id="lBudget">Budget (USDC)</label><input id="budget" type="number" step="0.01" value="50"/></div><div><label id="lPer">Per-trade (USDC)</label><input id="per" type="number" step="0.01" value="5"/></div></div><div class="row"><div><label id="lInt">Interval (sec)</label><input id="interval" type="number" step="1" value="30"/></div><div><label id="lArm">ARM (required)</label><input id="arm" value="WOLVERINE"/></div></div><div class="pill" style="margin-top:10px"><button id="startBtn">Start WOLVERINE</button><button id="stopBtn" class="secondary">Stop</button><button id="buyBtn" class="secondary">Buy once</button><button id="payoutBtn" class="secondary">Payout USDC</button></div><div style="margin-top:10px;color:var(--m);font-size:12px" id="note">Custodial: user sends SOL/USDC to the custody address. The server signs swaps internally. Phantom is only used to read your public address (for payout).</div></div><div id="console"><h3>Console</h3><div id="log"></div><div id="foot"><div><span id="sRefresh">Last refresh</span>: <span id="last">-</span></div><div><span id="sLatency">Latency</span>: <span id="lat">-</span> | <span id="sErr">Errors</span>: <span id="err">0</span></div></div></div></div><script>
(()=>{const $=s=>document.querySelector(s),logEl=$("#log"),dot=$("#dot");let lang=localStorage.getItem("wolv_lang")||"en";let errs=0;const I18N={en:{Control:"Control",Connect:"Connect",Disconnect:"Disconnect",Refresh:"Refresh","Token mint (Solana)":"Token mint (Solana)","Budget (USDC)":"Budget (USDC)","Per-trade (USDC)":"Per-trade (USDC)","Interval (sec)":"Interval (sec)","ARM (required)":"ARM (required)","Custody (TraderOne deposit address)":"Custody (TraderOne deposit address)","SOL (custody)":"SOL (custody)","USDC (custody)":"USDC (custody)","Last refresh":"Last refresh","Latency":"Latency","Errors":"Errors","Start WOLVERINE":"Start WOLVERINE","Buy once":"Buy once","Payout USDC":"Payout USDC","Copy":"Copy","Status":"Status",note:"Custodial: user sends SOL/USDC to the custody address. The server signs swaps internally. Phantom is only used to read your public address (for payout).",ph:"Phantom:"},fr:{Control:"Contrôle",Connect:"Connecter",Disconnect:"Déconnecter",Refresh:"Rafraîchir","Token mint (Solana)":"Mint du token (Solana)","Budget (USDC)":"Budget (USDC)","Per-trade (USDC)":"Par trade (USDC)","Interval (sec)":"Intervalle (sec)","ARM (required)":"ARM (requis)","Custody (TraderOne deposit address)":"Adresse dépôt Custody (TraderOne)","SOL (custody)":"SOL (custody)","USDC (custody)":"USDC (custody)","Last refresh":"Dernier refresh","Latency":"Latence","Errors":"Erreurs","Start WOLVERINE":"Start WOLVERINE","Buy once":"Achat unique","Payout USDC":"Retour USDC","Copy":"Copier","Status":"Statut",note:"Custodial: l’utilisateur envoie SOL/USDC à l’adresse custody. Le serveur signe les swaps en interne. Phantom sert seulement à lire ta pubkey (pour payout).",ph:"Phantom:"}};function t(k){return (I18N[lang]&&I18N[lang][k])||k;}function applyLang(){ $("#hControl").textContent=t("Control"); $("#connectBtn").textContent=t("Connect"); $("#discBtn").textContent=t("Disconnect"); $("#refreshBtn").textContent=t("Refresh"); $("#lMint").textContent=t("Token mint (Solana)"); $("#lBudget").textContent=t("Budget (USDC)"); $("#lPer").textContent=t("Per-trade (USDC)"); $("#lInt").textContent=t("Interval (sec)"); $("#lArm").textContent=t("ARM (required)"); $("#lCust").textContent=t("Custody (TraderOne deposit address)"); $("#lSol").textContent=t("SOL (custody)"); $("#lUsdc").textContent=t("USDC (custody)"); $("#sRefresh").textContent=t("Last refresh"); $("#sLatency").textContent=t("Latency"); $("#sErr").textContent=t("Errors"); $("#startBtn").textContent=t("Start WOLVERINE"); $("#buyBtn").textContent=t("Buy once"); $("#payoutBtn").textContent=t("Payout USDC"); $("#copyCust").textContent=t("Copy"); $("#openStatus").textContent=t("Status"); $("#note").textContent=t("note"); $("#kPh").textContent=t("ph"); $("#langBtn").textContent=lang.toUpperCase();}applyLang();
function wlog(s){const ts=new Date().toISOString().slice(11,19);logEl.textContent=`[${ts}] ${s}\n`+logEl.textContent;}
async function api(path,opt){const t0=performance.now();const r=await fetch(`/wolverine/api/${path}?_=${Date.now()}`,Object.assign({cache:"no-store"},opt||{}));const ms=Math.round(performance.now()-t0);$("#lat").textContent=ms+"ms";return r;}
function setApi(ok){dot.style.background=ok?"var(--ok)":"var(--bad)";dot.style.boxShadow=ok?"0 0 12px rgba(61,255,154,.7)":"0 0 12px rgba(255,61,110,.7)";}
function setErr(){errs++;$("#err").textContent=String(errs);}
let phantomPub="";async function connect(){try{if(!window.solana||!window.solana.isPhantom){wlog("Phantom not found");return;}const resp=await window.solana.connect();phantomPub=(resp.publicKey||window.solana.publicKey).toString();$("#phAddr").textContent=phantomPub;wlog("Phantom connected "+phantomPub);}catch(e){wlog("Connect err "+e);setErr();}}
async function disconnect(){try{if(window.solana&&window.solana.isPhantom)await window.solana.disconnect();phantomPub="";$("#phAddr").textContent="not connected";wlog("Phantom disconnected");}catch(e){wlog("Disconnect err "+e);setErr();}}
async function refresh(){try{const r=await api("status");if(!r.ok){setApi(false);wlog("status http "+r.status);setErr();return;}setApi(true);const j=await r.json();$("#cust").value=j.custody||"-";$("#sol").value=(j.balances?.sol??"-");$("#usdc").value=(j.balances?.usdc??"-");$("#last").textContent=new Date().toLocaleTimeString();wlog("status ok sol="+$("#sol").value+" usdc="+$("#usdc").value);}catch(e){setApi(false);wlog("refresh err "+e);setErr();}}
async function ping(){try{const r=await api("ping");const txt=await r.text();setApi(r.ok&&txt.trim()=="pong");wlog("ping "+r.status+" "+txt.trim());if(!r.ok) setErr();}catch(e){setApi(false);wlog("ping err "+e);setErr();}}
let autoT=null;function loopToggle(){if(autoT){clearInterval(autoT);autoT=null;wlog("loop OFF");}else{autoT=setInterval(refresh,5000);wlog("loop ON (5s)");refresh();}}
async function start(){try{const arm=$("#arm").value.trim();const body={ownerPubkey:phantomPub||"",tokenMint:$("#mint").value.trim(),budgetUSDC:+$("#budget").value,perTradeUSDC:+$("#per").value,intervalSec:+$("#interval").value};const r=await api("start",{method:"POST",headers:{"content-type":"application/json","x-arm":arm},body:JSON.stringify(body)});const j=await r.json().catch(()=>({}));wlog("start "+r.status+" "+JSON.stringify(j));if(!r.ok){setErr();}else{refresh();}}catch(e){wlog("start err "+e);setErr();}}
async function stop(){try{const arm=$("#arm").value.trim();const r=await api("stop",{method:"POST",headers:{"content-type":"application/json","x-arm":arm},body:"{}"});wlog("stop "+r.status+" "+await r.text());if(!r.ok)setErr();else refresh();}catch(e){wlog("stop err "+e);setErr();}}
async function buyOnce(){try{const arm=$("#arm").value.trim();const body={tokenMint:$("#mint").value.trim(),usdc:+$("#per").value};const r=await api("buy",{method:"POST",headers:{"content-type":"application/json","x-arm":arm},body:JSON.stringify(body)});const j=await r.json().catch(()=>({}));wlog("buy "+r.status+" "+JSON.stringify(j));if(!r.ok)setErr();else refresh();}catch(e){wlog("buy err "+e);setErr();}}
async function payout(){try{const arm=$("#arm").value.trim();const to=phantomPub||prompt("to pubkey?")||"";const amt=+prompt("USDC amount to send back?","1")||0;const r=await api("payout",{method:"POST",headers:{"content-type":"application/json","x-arm":arm},body:JSON.stringify({to,usdc:amt})});const j=await r.json().catch(()=>({}));wlog("payout "+r.status+" "+JSON.stringify(j));if(!r.ok)setErr();else refresh();}catch(e){wlog("payout err "+e);setErr();}}
$("#connectBtn").onclick=connect;$("#discBtn").onclick=disconnect;$("#refreshBtn").onclick=refresh;$("#pingBtn").onclick=ping;$("#loopBtn").onclick=loopToggle;$("#startBtn").onclick=start;$("#stopBtn").onclick=stop;$("#buyBtn").onclick=buyOnce;$("#payoutBtn").onclick=payout;$("#apiBtn").onclick=async()=>{const r=await api("config");wlog("config "+r.status+" "+await r.text());};$("#copyCust").onclick=()=>{navigator.clipboard.writeText($("#cust").value||"");wlog("custody copied");};$("#openStatus").onclick=()=>window.open("/wolverine/api/status","_blank");$("#langBtn").onclick=()=>{lang=(lang==="en"?"fr":"en");localStorage.setItem("wolv_lang",lang);applyLang();wlog("lang "+lang);};
refresh();})();
</script></body></html>

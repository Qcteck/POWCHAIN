set -e
cd /root

URL="https://fireinners.online/wolverine/traderone/api/status"

# Récupère la clé dans les 2 vhosts (sans l'afficher)
KSSL=$(grep -oP 'http_x_api_key != "\K[^"]+' /etc/nginx/sites-enabled/fireinners.online-ssl | head -n1 || true)
KHTTP=$(grep -oP 'http_x_api_key != "\K[^"]+' /etc/nginx/sites-enabled/fireinners.online     | head -n1 || true)

echo "SSL key sha256:"
printf "%s" "$KSSL" | sha256sum
echo "HTTP key sha256:"
printf "%s" "$KHTTP" | sha256sum
echo

echo "=== Test AVEC clé (celle du vhost SSL) => 200 attendu ==="
curl -sS -i -X POST "$URL" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KSSL" \
  --data '{}' | head -n 25
echo

echo "=== Test SANS clé => 403 attendu ==="
curl -sS -i -X POST "$URL" \
  -H "content-type: application/json" \
  --data '{}' | head -n 15
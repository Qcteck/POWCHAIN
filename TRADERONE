bash <<'EOF'
set -e

echo "=== WOLVERINE • MEGA BATCH FULL FINISH ==="

### VARIABLES
BASE="/opt/fireinners"
FRONT="$BASE/frontend-react/app/dist/wolverine"
BACKUP="$BASE/backup_wolverine_$(date +%Y%m%d_%H%M%S)"

### 1. BACKUP
echo "[1/7] Backup frontend"
mkdir -p "$BACKUP"
if [ -d "$FRONT" ]; then
  cp -a "$FRONT" "$BACKUP/"
fi

### 2. STRUCTURE
echo "[2/7] Structure dossiers"
mkdir -p "$FRONT/assets" "$FRONT/js" "$FRONT/css"

### 3. LOGO
echo "[3/7] Logo Wolverine"
cat > "$FRONT/assets/logo-wolverine.svg" <<'SVG'
<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
<defs>
<linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
<stop offset="0%" stop-color="#ff9a00"/>
<stop offset="100%" stop-color="#ff3d00"/>
</linearGradient>
</defs>
<path d="M100 10 L180 60 L150 180 L100 150 L50 180 L20 60 Z" fill="url(#g)"/>
</svg>
SVG

### 4. CSS RESPONSIVE (NO SCROLL)
echo "[4/7] CSS responsive"
cat > "$FRONT/css/app.css" <<'CSS'
*{box-sizing:border-box}
html,body{margin:0;padding:0;width:100%;overflow-x:hidden;font-family:system-ui;background:#0b1220;color:#e6edf3}
.app{display:flex;min-height:100vh;width:100vw}
.sidebar{width:220px;flex-shrink:0;background:#0f172a;padding:16px}
.main{flex:1;display:flex;flex-direction:column;padding:16px}
.top{display:flex;align-items:center;gap:12px}
.logo{width:40px}
.wallet{margin-top:20px;font-size:14px}
.card{background:rgba(255,255,255,.04);border-radius:12px;padding:16px;margin-bottom:16px}
.grid{display:grid;grid-template-columns:1fr 320px;gap:16px}
@media(max-width:900px){
  .sidebar{width:70px}
  .grid{grid-template-columns:1fr}
}
button{background:#1e293b;color:#fff;border:0;padding:10px 14px;border-radius:8px;cursor:pointer}
button.primary{background:#2563eb}
CSS

### 5. PHANTOM.JS (OFFICIEL, STABLE)
echo "[5/7] Phantom JS"
cat > "$FRONT/js/phantom.js" <<'JS'
async function connectPhantom(){
  if(!window.solana || !window.solana.isPhantom){
    location.href="https://phantom.app/ul/browse/"+encodeURIComponent(location.href);
    return;
  }
  const r=await window.solana.connect({onlyIfTrusted:false});
  const pub=r.publicKey.toString();
  document.getElementById("walletAddress").textContent=pub;
  fetch("/wolverine/traderone/api/balances?pub="+pub)
    .then(r=>r.json())
    .then(b=>{
      document.getElementById("sol").textContent=b.sol.toFixed(4);
      document.getElementById("usdc").textContent=b.usdc.toFixed(2);
    });
}
JS

### 6. FRONTEND INDEX (SIMPLE, PROPRE)
echo "[6/7] index.html"
cat > "$FRONT/index.html" <<'HTML'
<!doctype html><html><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Wolverine</title>
<link rel="stylesheet" href="css/app.css">
</head><body>
<div class="app">
  <div class="sidebar">
    <img src="assets/logo-wolverine.svg" class="logo">
    <div class="wallet">
      <div>Wallet:</div>
      <div id="walletAddress">non connecté</div>
      <div>SOL: <span id="sol">—</span></div>
      <div>USDC: <span id="usdc">—</span></div>
      <button class="primary" onclick="connectPhantom()">Connect Phantom</button>
    </div>
  </div>
  <div class="main">
    <div class="card">
      <h2>TraderOne overview</h2>
      <p>Backend connecté • temps réel</p>
    </div>
    <div class="grid">
      <div class="card">Orders / Positions / History</div>
      <div class="card">
        <h3>Trading</h3>
        <input placeholder="Symbol"><br><br>
        <input placeholder="Price"><br><br>
        <input placeholder="Size"><br><br>
        <button>Buy</button> <button>Sell</button>
      </div>
    </div>
  </div>
</div>
<script src="js/phantom.js"></script>
</body></html>
HTML

### 7. PERMS
echo "[7/7] Permissions"
chown -R www-data:www-data "$FRONT"

echo "=== WOLVERINE FINISHED ==="
echo "Backup : $BACKUP"
echo "URL : https://fireinners.online/wolverine/"
EOF
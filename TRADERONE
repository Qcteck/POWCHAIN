bash -lc 'set -euo pipefail
TS="$(date -u +%Y%m%d_%H%M%S)"
BK="/root/BK_WOLV404_${TS}"
mkdir -p "$BK"

say(){ echo "[$(date -u +%F\ %T\ UTC)] $*"; }

have(){ command -v "$1" >/dev/null 2>&1; }

unfreeze(){
  if have chattr; then
    chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
    chattr -i -R /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/includes 2>/dev/null || true
  fi
}

refreeze(){
  if have chattr; then
    # on refreeze seulement les fichiers critiques qu’on touche
    for f in /etc/nginx/nginx.conf /etc/nginx/includes/wolverine_routes.inc /etc/nginx/includes/bundler_routes.inc /etc/nginx/includes/wv_vault_api.inc; do
      [ -f "$f" ] && chattr +i "$f" 2>/dev/null || true
    done
    [ -n "${PRIMARY_SSL_VHOST:-}" ] && [ -f "$PRIMARY_SSL_VHOST" ] && chattr +i "$PRIMARY_SSL_VHOST" 2>/dev/null || true
  fi
}

backup(){
  say "Backup -> $BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  if [ -d /var/www/wolverine ]; then
    cp -a /var/www/wolverine "$BK/webroot_wolverine" 2>/dev/null || true
  fi
}

rollback(){
  say "ROLLBACK (restore nginx from backup)"
  if [ -d "$BK/nginx" ]; then
    rm -rf /etc/nginx 2>/dev/null || true
    cp -a "$BK/nginx" /etc/nginx
  fi
  nginx -t || true
  systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
}

trap "say ERROR; rollback; exit 1" ERR

ensure_webroot(){
  mkdir -p /var/www/wolverine
  if [ ! -f /var/www/wolverine/index.html ]; then
    say "Create minimal /var/www/wolverine/index.html"
    cat >/var/www/wolverine/index.html <<'"'"'HTML'"'"'
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WOLVERINE</title></head><body style="font-family:system-ui,Segoe UI,Roboto,Arial;margin:24px;color:#111"><h1>WOLVERINE OK</h1><p>Static webroot: <code>/var/www/wolverine</code></p><p><a href="/wolverine/traderone/health">/wolverine/traderone/health</a> | <a href="/wolverine/vault-api/health">/wolverine/vault-api/health</a></p></body></html>
HTML
  fi
}

write_wolverine_include(){
  mkdir -p /etc/nginx/includes
  say "Write /etc/nginx/includes/wolverine_routes.inc"
  cat >/etc/nginx/includes/wolverine_routes.inc <<'"'"'NGX'"'"'
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
NGX
}

dedup_locations_py(){
  # usage: dedup_locations_py /path/file
  python3 - "$1" <<'"'"'PY'"'"'
import sys,re
p=sys.argv[1]
try:
  s=open(p,"r",encoding="utf-8",errors="replace").read().splitlines(True)
except FileNotFoundError:
  sys.exit(0)

loc_re=re.compile(r"^\s*location\s+(.+?)\s*\{\s*$")
seen=set()
out=[]
i=0
while i<len(s):
  line=s[i]
  m=loc_re.match(line)
  if not m:
    out.append(line); i+=1; continue
  key=re.sub(r"\s+"," ",m.group(1).strip())
  # capture block
  block=[line]; i+=1
  depth=1
  while i<len(s) and depth>0:
    block.append(s[i])
    depth += s[i].count("{")
    depth -= s[i].count("}")
    i+=1
  if key in seen:
    # skip duplicate block
    continue
  seen.add(key)
  out.extend(block)

new="".join(out)
old="".join(s)
if new!=old:
  open(p,"w",encoding="utf-8").write(new)
PY
}

find_primary_ssl_vhost(){
  local A="/etc/nginx/sites-enabled/fireinners.online-ssl"
  local B="/etc/nginx/conf.d/000-fireinners.online-ssl.conf"
  if [ -e "$A" ]; then
    PRIMARY_SSL_VHOST="$(readlink -f "$A" 2>/dev/null || echo "$A")"
  elif [ -f "$B" ]; then
    PRIMARY_SSL_VHOST="$B"
  else
    # fallback: first file in enabled/conf.d that contains listen 443 + server_name fireinners.online
    PRIMARY_SSL_VHOST="$(
      { ls -1 /etc/nginx/sites-enabled/* 2>/dev/null || true; ls -1 /etc/nginx/conf.d/*.conf 2>/dev/null || true; } \
      | while read -r f; do
          ff="$(readlink -f "$f" 2>/dev/null || echo "$f")"
          grep -qE "listen[[:space:]]+443" "$ff" 2>/dev/null || continue
          grep -qE "server_name[[:space:]].*fireinners\.online" "$ff" 2>/dev/null || continue
          echo "$ff"; break
        done
    )"
  fi
  [ -n "${PRIMARY_SSL_VHOST:-}" ] || { say "ERR: cannot find PRIMARY SSL vhost"; exit 1; }
  say "PRIMARY SSL vhost: $PRIMARY_SSL_VHOST"
}

disable_other_ssl_conflicts(){
  say "Disable other SSL vhosts that conflict with fireinners.online (keep primary)"
  local list tmp
  tmp="$BK/ssl_vhost_candidates.txt"
  :> "$tmp"
  { ls -1 /etc/nginx/sites-enabled/* 2>/dev/null || true; ls -1 /etc/nginx/conf.d/*.conf 2>/dev/null || true; } \
  | while read -r f; do
      ff="$(readlink -f "$f" 2>/dev/null || echo "$f")"
      [ -f "$ff" ] || continue
      grep -qE "listen[[:space:]]+443" "$ff" 2>/dev/null || continue
      grep -qE "server_name[[:space:]].*fireinners\.online" "$ff" 2>/dev/null || continue
      echo "$f|$ff" >>"$tmp"
    done

  while IFS="|" read -r link real; do
    [ -n "$real" ] || continue
    if [ "$real" = "$PRIMARY_SSL_VHOST" ]; then
      continue
    fi
    # disable: if it is a symlink in sites-enabled -> remove symlink; if conf.d file -> move away
    if [ -L "$link" ]; then
      say "Disable symlink: $link -> $real"
      cp -a "$link" "$BK/disabled_$(basename "$link")" 2>/dev/null || true
      rm -f "$link" || true
    else
      # conf.d or regular file
      if [ -f "$link" ]; then
        say "Disable file: $link"
        mv -f "$link" "$BK/disabled_$(basename "$link")" || true
      else
        # link might be a real path already
        if [ -f "$real" ]; then
          say "Disable real file: $real"
          mv -f "$real" "$BK/disabled_$(basename "$real")" || true
        fi
      fi
    fi
  done <"$tmp"
}

inject_include_once(){
  local f="$PRIMARY_SSL_VHOST"
  say "Inject include wolverine_routes.inc into primary SSL vhost (once)"
  python3 - "$f" <<'"'"'PY'"'"'
import sys,re
p=sys.argv[1]
s=open(p,"r",encoding="utf-8",errors="replace").read().splitlines(True)

inc='include /etc/nginx/includes/wolverine_routes.inc;'
# remove duplicates anywhere
s=[ln for ln in s if inc not in ln]

# find best server block: first "server {" that also contains server_name fireinners.online (scan by blocks)
out=[]
i=0
server_re=re.compile(r"^\s*server\s*\{\s*$")
sn_re=re.compile(r"^\s*server_name\s+.*fireinners\.online")
while i<len(s):
  if not server_re.match(s[i]):
    out.append(s[i]); i+=1; continue
  # capture block to decide if it is our ssl server
  block=[s[i]]; i+=1
  depth=1
  while i<len(s) and depth>0:
    block.append(s[i])
    depth += s[i].count("{")
    depth -= s[i].count("}")
    i+=1
  txt="".join(block)
  if ("listen 443" in txt) and sn_re.search(txt):
    # inject include right after server { line
    if inc not in txt:
      block.insert(1,"  "+inc+"\n")
  out.extend(block)

open(p,"w",encoding="utf-8").write("".join(out))
PY
}

tests(){
  local DOMAIN="fireinners.online"
  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null

  say "TEST LOCAL (bypass CF) HEAD /wolverine/"
  curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true

  say "TEST LOCAL (bypass CF) GET first bytes"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | head -c 220 || true; echo

  say "TEST PUBLIC HEAD /wolverine/"
  curl -skI "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true

  say "SHOW where nginx thinks server_name fireinners.online is loaded from"
  nginx -T 2>/dev/null | awk '\''/server_name[[:space:]].*fireinners\.online/{print NR ":" $0}'\'' | head -n 40 || true
}

say "MEGA_WOLVERINE_FIX_404 start"
backup
unfreeze
ensure_webroot
write_wolverine_include

# dedup known includes that previously broke nginx -t
[ -f /etc/nginx/includes/bundler_routes.inc ] && (say "Dedup locations in /etc/nginx/includes/bundler_routes.inc"; dedup_locations_py /etc/nginx/includes/bundler_routes.inc) || true
[ -f /etc/nginx/includes/wv_vault_api.inc ] && (say "Dedup locations in /etc/nginx/includes/wv_vault_api.inc"; dedup_locations_py /etc/nginx/includes/wv_vault_api.inc) || true
# also dedup our wolverine include if it got duplicated elsewhere
dedup_locations_py /etc/nginx/includes/wolverine_routes.inc || true

find_primary_ssl_vhost
disable_other_ssl_conflicts
inject_include_once

tests
refreeze

say "DONE"
say "Backups: $BK"
echo "Open: https://fireinners.online/wolverine/ (Ctrl+F5)"
'
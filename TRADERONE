bash -lc 'set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/TO_HEART_${TS}.log"
OUT="/root/TO_HEART_${TS}"
mkdir -p "$OUT"
exec > >(tee -a "$LOG") 2>&1

say(){ echo; echo "== $* =="; }

WEBROOT="/var/www/wolverine"
HOST="fireinners.online"
API_LOCAL="http://127.0.0.1:3000"
API_PUBLIC="https://${HOST}/wolverine/traderone/api"
SAVE_HEART="/root/traderone_heart.txt"

say "0) Context"
hostnamectl 2>/dev/null | sed -n "1,6p" || true
date || true

say "1) Ports + PID 3000 + cmdline/cwd/exe"
ss -lntp | egrep "(:80|:443|:3000)\b" || true
PID3000="$(ss -lntp 2>/dev/null | awk "/:3000[[:space:]]/ && /users:/ {gsub(/.*pid=/,\"\",\$0); gsub(/,.*/,\"\",\$0); print \$0; exit}")"
echo "PID3000=${PID3000:-none}"
if [ -n "${PID3000:-}" ] && [ -d "/proc/$PID3000" ]; then
  tr "\0" " " < "/proc/$PID3000/cmdline" || true; echo
  readlink -f "/proc/$PID3000/cwd" || true
  readlink -f "/proc/$PID3000/exe" || true
  ps -fp "$PID3000" || true
fi

say "2) Locate TraderOne code on disk (fast search)"
CANDS=(/opt/traderone /opt/traderone-opt /opt/traderone-vault /opt/wolverine /opt/fireinners /root/traderone /root/wolverine)
> "$OUT/candidates.txt"
for d in "${CANDS[@]}"; do [ -d "$d" ] && echo "$d" >> "$OUT/candidates.txt"; done
cat "$OUT/candidates.txt" || true

> "$OUT/hits.txt"
for d in $(cat "$OUT/candidates.txt" 2>/dev/null || true); do
  echo "## $d" >> "$OUT/hits.txt"
  find "$d" -maxdepth 6 -type f \( -name package.json -o -name server.cjs -o -name server.js -o -name index.js -o -name app.js \) 2>/dev/null | head -n 80 >> "$OUT/hits.txt" || true
  find "$d" -maxdepth 6 -type f -iname "*trader*one*" 2>/dev/null | head -n 80 >> "$OUT/hits.txt" || true
done
sed -n "1,260p" "$OUT/hits.txt" || true

say "3) HEART_DIR (prefer the process cwd if PID found)"
HEART=""
if [ -n "${PID3000:-}" ] && [ -d "/proc/$PID3000" ]; then HEART="$(readlink -f "/proc/$PID3000/cwd" 2>/dev/null || true)"; fi
if [ -z "$HEART" ]; then
  # best guess: first directory containing package.json under /opt/traderone
  if [ -f /opt/traderone/package.json ]; then HEART="/opt/traderone"; fi
fi
echo "HEART_DIR=$HEART" | tee "$SAVE_HEART"

if [ -n "$HEART" ] && [ -f "$HEART/package.json" ]; then
  say "3.1) package.json (name/main/scripts)"
  node -e "const p=require(\"$HEART/package.json\"); console.log(JSON.stringify({name:p.name,main:p.main,scripts:p.scripts},null,2));" 2>/dev/null || true
fi

say "4) API checks (local + public)"
curl -sS -i "$API_LOCAL/health" | head -n 80 || true
curl -sS -i "$API_PUBLIC/health" | head -n 80 || true

say "5) Frontend served now"
if [ -f "$WEBROOT/index.html" ]; then
  ls -la "$WEBROOT/index.html"
  head -n 40 "$WEBROOT/index.html" | sed "s/\t/  /g"
else
  echo "MISSING $WEBROOT/index.html"
fi

say "6) Detect STUB"
STUB="0"
if [ -f "$WEBROOT/index.html" ] && grep -qiE "UI stub|Coming soon|Not connected|TraderOne" "$WEBROOT/index.html"; then STUB="1"; fi
echo "FRONT_STUB=$STUB"

say "7) Locate real Next export (search _next/static)"
REAL=""
for base in /opt/wolverine /opt/fireinners/frontend-react/app/dist/wolverine /opt/fireinners/frontend-react/app/dist /var/www/wolverine /opt/fireinners /root; do
  [ -d "$base" ] || continue
  hit="$(find "$base" -maxdepth 5 -type d -path "*/_next/static" 2>/dev/null | head -n 1 || true)"
  if [ -n "$hit" ]; then
    rootdir="$(dirname "$(dirname "$hit")")"
    [ -f "$rootdir/index.html" ] && REAL="$rootdir" && break
  fi
done
echo "REAL_FRONT_ROOT=$REAL"

say "8) If stub and REAL found -> deploy into /var/www/wolverine"
if [ "$STUB" = "1" ] && [ -n "$REAL" ] && [ -d "$REAL" ]; then
  BK="/root/WOLV_FRONT_BAK_${TS}"
  mkdir -p "$BK"
  tar -czf "$BK/webroot.tgz" -C "$WEBROOT" . 2>/dev/null || true
  rsync -a --delete --exclude "vendor/" "$REAL/" "$WEBROOT/"
  if [ -d "$REAL/vendor" ]; then mkdir -p "$WEBROOT/vendor"; rsync -a "$REAL/vendor/" "$WEBROOT/vendor/"; fi
  echo "DEPLOYED_REAL_FRONT_FROM=$REAL" | tee "$OUT/deploy.txt"
fi

say "9) Nginx reload + smoke tests"
nginx -t || true
systemctl reload nginx || systemctl restart nginx || true
curl -sS -I "https://${HOST}/wolverine/" | head -n 30 || true
tail -n 80 /var/log/nginx/error.log 2>/dev/null || true

say "DONE"
echo "LOG=$LOG"
echo "OUT=$OUT"
echo "HEART=$SAVE_HEART"'
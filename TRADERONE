import re, sys
dump_path=sys.argv[1]
txt=open(dump_path,'r',errors='ignore').read().splitlines()

# nginx -T contains lines like:
# "configuration file /etc/nginx/sites-enabled/xxx.conf:" or "# configuration file /path: ... "
# On Ubuntu, it's usually: "configuration file /path:" (no '#')
file_re=re.compile(r'^(#\s*)?configuration file (.+?):\s*$')
cur_file=None

# We will scan and build chunks per file
files={}
for ln in txt:
    m=file_re.match(ln)
    if m:
        cur_file=m.group(2).strip()
        files.setdefault(cur_file, [])
        continue
    if cur_file:
        files[cur_file].append(ln)

def find_server_blocks(lines):
    # naive brace counting for server blocks
    blocks=[]
    i=0
    while i < len(lines):
        if re.search(r'^\s*server\s*\{', lines[i]):
            a=i
            depth=0
            j=i
            while j < len(lines):
                depth += lines[j].count('{')
                depth -= lines[j].count('}')
                if j>i and depth<=0:
                    b=j
                    blocks.append((a,b))
                    i=b
                    break
                j+=1
        i+=1
    return blocks

candidates=[]
for f,lines in files.items():
    blocks=find_server_blocks(lines)
    for a,b in blocks:
        block="\n".join(lines[a:b+1])
        # match 443 + fireinners.online
        if re.search(r'listen\s+443', block) or re.search(r'443\s+ssl', block):
            if re.search(r'\bserver_name\b', block) and re.search(r'\bfireinners\.online\b', block):
                candidates.append((f,a,b,block))

if not candidates:
    # fallback: any 443 block (maybe server_name inherited/wildcard)
    for f,lines in files.items():
        blocks=find_server_blocks(lines)
        for a,b in blocks:
            block="\n".join(lines[a:b+1])
            if re.search(r'listen\s+443', block) or re.search(r'443\s+ssl', block):
                candidates.append((f,a,b,block))
                break
        if candidates:
            break

if not candidates:
    print("ERROR: no 443 server block found in nginx -T output", file=sys.stderr)
    sys.exit(2)

# choose the best: explicit fireinners.online match first
best=candidates[0]
for c in candidates:
    if 'fireinners.online' in c[3]:
        best=c
        break

print(best[0])

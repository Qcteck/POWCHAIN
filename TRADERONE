set -euo pipefail

DIR="$(ls -d /root/bak_renders_machine_*/png 2>/dev/null | tail -n 1 || true)"
[ -n "$DIR" ] || { echo "❌ Aucun dossier PNG trouvé"; exit 1; }

cd "$DIR"
echo "📁 $DIR"

# Installer le viewer terminal si absent
if ! command -v chafa >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y chafa
fi

mapfile -t IMG < <(ls -1 *.png 2>/dev/null | sort)
[ "${#IMG[@]}" -gt 0 ] || { echo "❌ Aucun PNG ici"; exit 1; }

i=0
while true; do
  clear
  echo "Image: ${IMG[$i]}  ($((i+1))/${#IMG[@]})"
  echo "n = suivant | p = précédent | q = quitter"
  echo
  chafa --symbols=block --colors=full -s 200x60 "${IMG[$i]}" || true
  echo
  read -r -n 1 key || true
  case "$key" in
    n) i=$(( (i+1) % ${#IMG[@]} ));;
    p) i=$(( (i-1+${#IMG[@]}) % ${#IMG[@]} ));;
    q) exit 0;;
  esac
done
#!/usr/bin/env bash
set -e

echo "=== WOLVERINE API FIX ==="

API_PORT=3010
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

echo "== 1) Checking backend port =="
ss -lntp | grep ":$API_PORT" || {
  echo "❌ Backend NOT listening on $API_PORT"
  echo "👉 Your TraderOne backend must run on port $API_PORT"
  exit 1
}

echo "== 2) Patching nginx API route =="

grep -q "location /wolverine/api/" "$NGINX_SITE" || {
  sed -i '/location \/wolverine\/ {/a\
    location /wolverine/api/ {\
        proxy_pass http://127.0.0.1:3010/;\
        proxy_http_version 1.1;\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\
        proxy_set_header X-Forwarded-Proto $scheme;\
    }\
' "$NGINX_SITE"
}

echo "== 3) Testing nginx =="
nginx -t

echo "== 4) Reload nginx =="
systemctl reload nginx

echo "=== DONE ==="
echo "Expected response:"
echo 'GET /wolverine/api/balance/<pubkey> -> {"sol": <number>}'
cat >/root/MEGA_WV_FIX_404_V2.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
DIST="/opt/fireinners/frontend-react/app/dist/wolverine"
INC="/etc/nginx/includes/wolverine_routes.inc"
BK="/root/WV_FIX_V2_${TS}"
IMM="$BK/immut.list"

say(){ printf "\n[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
need_root(){ [ "$(id -u)" -eq 0 ] || { echo "RUN AS ROOT"; exit 1; }; }

unfreeze_file(){ local f="$1"; [ -e "$f" ] || return 0; command -v lsattr >/dev/null 2>&1 || return 0; command -v chattr >/dev/null 2>&1 || return 0; if lsattr -d "$f" 2>/dev/null | awk '{print $1}' | grep -q 'i'; then echo "$f" >>"$IMM" || true; chattr -i "$f" 2>/dev/null || true; fi; }
unfreeze_tree(){ local d="$1"; [ -d "$d" ] || return 0; while IFS= read -r -d "" f; do unfreeze_file "$f"; done < <(find "$d" -maxdepth 2 -type f -print0 2>/dev/null || true); }
refreeze_all(){ [ -s "$IMM" ] || return 0; command -v chattr >/dev/null 2>&1 || return 0; while IFS= read -r f; do [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true; done <"$IMM"; }

backup_all(){
  mkdir -p "$BK"
  :> "$IMM"
  say "Backup -> $BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  [ -d "$WEBROOT" ] && cp -a "$WEBROOT" "$BK/webroot" 2>/dev/null || true
}

ensure_webroot(){
  say "Ensure WEBROOT: $WEBROOT"
  mkdir -p "$WEBROOT"
  if [ -d "$DIST" ]; then
    say "Sync dist -> webroot"
    rsync -a --delete "$DIST"/ "$WEBROOT"/
  fi
  if [ ! -f "$WEBROOT/index.html" ]; then
    cat >"$WEBROOT/index.html"<<HTML
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WOLVERINE</title></head><body style="font-family:system-ui;margin:40px"><h1>WOLVERINE</h1><p>WEBROOT OK: /var/www/wolverine</p></body></html>
HTML
  fi
}

write_include_unique(){
  say "Write include: $INC"
  mkdir -p /etc/nginx/includes
  cat >"$INC"<<NGX
# WV_FIX_V2_${TS} - UNIQUE /wolverine/ route
location ^~ /wolverine/ {
  alias ${WEBROOT}/;
  index index.html;
  try_files \$uri \$uri/ /wolverine/index.html;
}
NGX
}

active_vhost_candidates(){
  # retourne les fichiers réellement chargés via sites-enabled
  find /etc/nginx/sites-enabled -maxdepth 1 -type f -o -type l 2>/dev/null | sort -u
}

inject_into_correct_https_server(){
  say "Inject include into ACTIVE HTTPS server{} (listen 443 + server_name ${DOMAIN})"
  local f tmp
  local injected=0
  while IFS= read -r f; do
    [ -e "$f" ] || continue
    # ignore si déjà présent
    if grep -qF "include ${INC};" "$f" 2>/dev/null; then
      say "Already has include: $f"
      injected=1
      break
    fi
    # doit contenir server_name domain quelque part, sinon skip
    grep -qE "^[[:space:]]*server_name[[:space:]].*${DOMAIN//./\\.}" "$f" 2>/dev/null || continue

    unfreeze_file "$f"
    tmp="${f}.tmp_${TS}"

    awk -v dom="$DOMAIN" -v inc="  include /etc/nginx/includes/wolverine_routes.inc;" '
      BEGIN{in_srv=0;depth=0;has_dom=0;has_443=0;done=0}
      /^[[:space:]]*server[[:space:]]*\{/{
        in_srv=1; depth=1; has_dom=0; has_443=0
        print; next
      }
      {
        if(in_srv){
          if($0 ~ /^[[:space:]]*listen[[:space:]]+443/){ has_443=1 }
          if($0 ~ /^[[:space:]]*server_name[[:space:]]/ && $0 ~ dom){ has_dom=1; print; next }
          # track braces
          n=gsub(/\{/,"{"); depth+=n
          n=gsub(/\}/,"}"); depth-=n

          # juste avant la fermeture du server{}, inject si match
          if(depth==0){
            if(has_443 && has_dom && !done){
              print inc
              done=1
            }
            print
            in_srv=0
            next
          }
          print
          next
        }
        print
      }' "$f" >"$tmp" && mv -f "$tmp" "$f"

    if grep -qF "include /etc/nginx/includes/wolverine_routes.inc;" "$f" 2>/dev/null; then
      say "Injected into: $f"
      injected=1
      break
    fi
  done < <(active_vhost_candidates)

  if [ "$injected" -ne 1 ]; then
    say "FATAL: could not inject into active vhost. Showing active 443 blocks (nginx -T grep):"
    nginx -T 2>/dev/null | grep -nE "server_name[[:space:]].*${DOMAIN//./\\.}|listen[[:space:]]+443" | head -n 80 || true
    exit 1
  fi
}

nginx_reload(){
  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx
}

tests(){
  say "Tests (SNI -> 127.0.0.1)"
  echo "== HTTPS /wolverine/ (HEAD) =="
  curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n '1,20p' || true
  echo
  echo "== HTTPS /wolverine/ (first bytes) =="
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | head -c 250 || true
  echo; echo
  echo "== CONFIRM include loaded (nginx -T) =="
  nginx -T 2>/dev/null | grep -n "wolverine_routes\.inc" | head -n 20 || true
  echo
  echo "== ACTIVE defs only (NO backups) =="
  grep -RIn --color=never -E "location[[:space:]]+(\^~[[:space:]]+)?/wolverine/" /etc/nginx/sites-enabled /etc/nginx/includes 2>/dev/null | head -n 40 || true
}

main(){
  need_root
  say "MEGA_WV_FIX_404_V2 :: start"
  backup_all

  say "Unfreeze nginx trees (chattr -i)"
  unfreeze_tree "/etc/nginx/sites-available"
  unfreeze_tree "/etc/nginx/sites-enabled"
  unfreeze_tree "/etc/nginx/includes"
  unfreeze_tree "/etc/nginx/snippets"

  ensure_webroot
  write_include_unique
  inject_into_correct_https_server

  nginx_reload
  tests

  say "Refreeze (best-effort)"
  refreeze_all

  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ puis Ctrl+F5"
}
main
EOF

sed -i 's/\r$//' /root/MEGA_WV_FIX_404_V2.sh
chmod +x /root/MEGA_WV_FIX_404_V2.sh
bash /root/MEGA_WV_FIX_404_V2.sh
cat >/root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V2_ONE_SHOT.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027

TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v python3 >/dev/null 2>&1 || die "python3 missing"
command -v curl >/dev/null 2>&1 || die "curl missing"

DOMAIN="fireinners.online"
WEBROOT="/var/www/aquila_stacking"
PATH_A="/aquila_stacking/"
PATH_B="/iaaquila/"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"
BK="/root/AQUILA_STACKING_WEBROUTE_FIX_V2_BK_${TS}"
mkdir -p "$BK"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "AquilaStacking web routes v2" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
    rm -f "$tmp"
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(echo "$path" | sed 's#/#_#g').bak" || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}

say "1) WEBROOT + index.html"
mkdir -p "$WEBROOT"
chmod 0755 "$WEBROOT" || true
chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true

APP="/opt/aquila_stacking"
PROG="aquila_stacking"
PID_LOCAL="UNKNOWN"; PID_DEV="UNKNOWN"; PID_MAIN="UNKNOWN"
if command -v solana-keygen >/dev/null 2>&1; then
  [ -f "$APP/target/deploy/${PROG}-keypair.json" ] && PID_LOCAL="$(solana-keygen pubkey "$APP/target/deploy/${PROG}-keypair.json" 2>/dev/null || echo UNKNOWN)"
  [ -f "$APP/keys/${PROG}-devnet-keypair.json" ] && PID_DEV="$(solana-keygen pubkey "$APP/keys/${PROG}-devnet-keypair.json" 2>/dev/null || echo UNKNOWN)"
  [ -f "$APP/keys/${PROG}-mainnet-keypair.json" ] && PID_MAIN="$(solana-keygen pubkey "$APP/keys/${PROG}-mainnet-keypair.json" 2>/dev/null || echo UNKNOWN)"
fi

cat >"$WEBROOT/index.html"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><style>body{font-family:system-ui,Segoe UI,Arial;margin:24px;max-width:980px}code{background:#0b1020;color:#d7e3ff;padding:2px 6px;border-radius:6px}pre{background:#0b1020;color:#d7e3ff;padding:12px;border-radius:10px;overflow:auto}a{color:#2b6fff;text-decoration:none}a:hover{text-decoration:underline}.box{border:1px solid #e5e7eb;border-radius:12px;padding:14px;margin:12px 0}</style></head><body><h1>AquilaStacking</h1><div class="box"><b>URLs</b><div>• <a href="${PATH_B}">${PATH_B}</a></div><div>• <a href="${PATH_A}">${PATH_A}</a></div></div><div class="box"><b>Program IDs</b><pre>localnet: ${PID_LOCAL}\ndevnet : ${PID_DEV}\nmainnet: ${PID_MAIN}</pre></div><div class="box"><b>Paths</b><div><b>Workspace</b> <code>${APP}</code></div><div><b>Webroot</b> <code>${WEBROOT}</code></div><div><b>Include</b> <code>${INC}</code></div></div></body></html>
EOF
chown www-data:www-data "$WEBROOT/index.html" 2>/dev/null || true
chmod 0644 "$WEBROOT/index.html" || true

say "2) Write nginx include (routes)"
ROUTES="### AQUILA_STACKING_WEBROUTES_V2_BEGIN
location = ${PATH_B%/} { return 301 ${PATH_B}; }
location ^~ ${PATH_B} {
  alias ${WEBROOT}/;
  index index.html;
  add_header Cache-Control \"no-store\" always;
  try_files \$uri \$uri/ ${PATH_B}index.html =404;
}
location = ${PATH_A%/} { return 301 ${PATH_A}; }
location ^~ ${PATH_A} {
  alias ${WEBROOT}/;
  index index.html;
  add_header Cache-Control \"no-store\" always;
  try_files \$uri \$uri/ ${PATH_A}index.html =404;
}
### AQUILA_STACKING_WEBROUTES_V2_END"
write_file "$INC" "$ROUTES"

say "3) Snapshot nginx config + patch ALL 443 server blocks (covers conflicts/defaults)"
nginx -T >"$BK/nginx_T.txt" 2>&1 || die "nginx -T failed"

python3 - <<'PY'
import os,re,shutil,sys
BK=os.environ["BK"]
INC=os.environ["INC"]
MARK_B="AQUILA_STACKING_WEBROUTES_V2_BEGIN"
T=open(os.path.join(BK,"nginx_T.txt"),"r",errors="ignore").read()

files=[]
for m in re.finditer(r"^# configuration file (.+?):", T, flags=re.M):
    p=m.group(1).strip()
    if p.startswith("/") and os.path.isfile(p):
        files.append(p)
files=sorted(set(files))

def patch_server_blocks(txt):
    # inject "include INC;" into every server{...} block that has listen 443, unless already has marker/include
    pat=re.compile(r"\bserver\s*\{", re.I)
    out=[]
    idx=0
    n=len(txt)
    changed=False
    while True:
        m=pat.search(txt, idx)
        if not m:
            out.append(txt[idx:])
            break
        out.append(txt[idx:m.start()])
        brace=txt.find("{", m.end()-1)
        if brace==-1:
            out.append(txt[m.start():]); break
        depth=0
        j=brace
        while j<n:
            c=txt[j]
            if c=="{": depth+=1
            elif c=="}":
                depth-=1
                if depth==0:
                    end=j+1; break
            j+=1
        else:
            out.append(txt[m.start():]); break
        block=txt[m.start():end]
        idx=end

        if (MARK_B in block) or (INC in block):
            out.append(block); continue

        if re.search(r"(?m)^\s*listen\s+[^;]*\b443\b", block):
            # insert include after opening line
            k=block.find("{")
            k2=block.find("\n", k)
            if k2==-1: k2=k+1
            ins=f"\n    include {INC};\n"
            block=block[:k2+1]+ins+block[k2+1:]
            changed=True

        out.append(block)
    return "".join(out), changed

patched=[]
for p in files:
    try:
        txt=open(p,"r",errors="ignore").read()
    except:
        continue
    newtxt,chg=patch_server_blocks(txt)
    if chg:
        shutil.copy2(p, os.path.join(BK, os.path.basename(p)+".bak"))
        os.system(f"chattr -i {p} 2>/dev/null || true")
        open(p,"w").write(newtxt)
        patched.append(p)

open(os.path.join(BK,"patched_443_files.txt"),"w").write("\n".join(patched)+"\n")
print("patched_443_count=",len(patched))
PY

say "4) nginx test + reload (rollback on fail)"
if ! nginx -t; then
  say "nginx -t failed -> rollback"
  while IFS= read -r b; do
    [ -f "$b" ] || continue
    orig="/etc/nginx/$(basename "$b" .bak)" # not used
  done < <(find "$BK" -maxdepth 1 -type f -name "*.bak" -print)
  # restore exact
  for b in "$BK"/*.bak; do
    [ -f "$b" ] || continue
    base="$(basename "$b")"
    # guess original by searching file list
    # we stored basename-only backups; restore by matching same basename in /etc/nginx tree
    tgt="$(grep -Rsl -- "$base" /etc/nginx 2>/dev/null | head -n1 || true)"
    # fallback: restore to same-name path if exists
    if [ -n "$tgt" ]; then :; fi
  done
  die "nginx config invalid; BK=$BK (manual restore from BK/*.bak)"
fi

systemctl reload nginx

say "5) Local HTTPS verify (force localhost)"
A="$(curl -k -sS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_B}" | head -n 5 || true)"
B="$(curl -k -sS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_A}" | head -n 5 || true)"
echo "$A" | grep -qi "AquilaStacking" || { echo "$A" >"$BK/resp_iaaquila_head.txt"; die "still not serving ${PATH_B} (see $BK/resp_iaaquila_head.txt)"; }
echo "$B" | grep -qi "AquilaStacking" || { echo "$B" >"$BK/resp_aquila_head.txt"; die "still not serving ${PATH_A} (see $BK/resp_aquila_head.txt)"; }

say "DONE"
say "Open: https://${DOMAIN}${PATH_B}"
say "Open: https://${DOMAIN}${PATH_A}"
say "BK: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V2_ONE_SHOT.sh
BK="/root/AQUILA_STACKING_WEBROUTE_FIX_V2_BK_$(date +%Y%m%d_%H%M%S)" INC="/etc/nginx/includes/aquila_stacking_routes.inc" bash /root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V2_ONE_SHOT.sh
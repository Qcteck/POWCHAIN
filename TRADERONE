cat >/root/fix_proxy_http_version_once.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup =="
cp -a "$SNIP" "${SNIP}.bak_${TS}"
echo "Saved: ${SNIP}.bak_${TS}"

echo
echo "== Before: show ALL proxy_http_version occurrences (with line numbers) =="
nl -ba "$SNIP" | grep -n "proxy_http_version" || echo "none"

echo
echo "== Remove ALL proxy_http_version lines =="
sed -i '/proxy_http_version/d' "$SNIP"

echo
echo "== Insert ONE proxy_http_version 1.1 after proxy_pass (first occurrence) =="
awk '
  BEGIN{done=0}
  {print}
  (!done && $0 ~ /proxy_pass[[:space:]]+/) { print "  proxy_http_version 1.1;"; done=1 }
' "$SNIP" > /tmp/solana_rpc_proxy.conf.fixed
mv /tmp/solana_rpc_proxy.conf.fixed "$SNIP"

echo
echo "== After: show proxy_http_version occurrences (must be 1) =="
nl -ba "$SNIP" | grep -n "proxy_http_version" || true

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx

echo "DONE ✅"
BASH

chmod +x /root/fix_proxy_http_version_once.sh
/root/fix_proxy_http_version_once.sh
          const q = qualityScore(signals, text);

          S.article.text = text;
          S.article.method = method + (okEx ? "+readability" : "+raw");
          S.article.paywallHint = paywallHint;
          S.article.quality = q;
          S.article.tags = detectTags(it.title, text);
          S.article.sent = sentiment(it.title, text);
          S.article.summary = summarize(text);

          S.learn.experiments.push({t:Date.now(), url:it.link, method:S.article.method, q, len:text.length, pN:signals.pN});
          S.learn.experiments = S.learn.experiments.slice(-120);

          S.state.mode = "DISCUSS"; save(); renderStates();
          startConversation(it);
        });
      } else {
        text = cleanText(raw);
        signals = {pN: text.split("\n\n").filter(Boolean).length, len:text.length, ld:0, score:0};
        const q = qualityScore(signals, text);

        S.article.text = text;
        S.article.method = method + "+plain";
        S.article.paywallHint = false;
        S.article.quality = q;
        S.article.tags = detectTags(it.title, text);
        S.article.sent = sentiment(it.title, text);
        S.article.summary = summarize(text);

        S.learn.experiments.push({t:Date.now(), url:it.link, method:S.article.method, q, len:text.length, pN:signals.pN});
        S.learn.experiments = S.learn.experiments.slice(-120);

        S.state.mode = "DISCUSS"; save(); renderStates();
        startConversation(it);
      }
    });
  };

  const loadRSS = async () => {
    if(!S.caps.rss){
      add("AI","CAP RSS est OFF. Active RSS pour démarrer.", "ai");
      return;
    }
    S.state.mode = "RSS_LOAD"; save(); renderStates();
    add("SYS","Lecture RSS…","sys");

    let all = [];
    for(const u of (S.rss||[]).slice(0, 6)){
      try{
        const r = await fetchText(u);
        const items = parseRSS(r.text);
        items.forEach(it => { if(it.title && it.link) all.push({...it, src:u}); });
      }catch(e){
        pushErr("RSS fetch fail");
      }
    }

    S.items = all.slice(0, 36);
    if(!S.items.length){
      S.state.mode = "DISCUSS"; save(); renderRSS(); renderStates();
      add("AI","RSS vide/bloqué. Je peux discuter, mais sans base RSS ça devient du vent.", "ai");
      return;
    }

    // pick most recent among top 12
    const top = S.items.slice(0,12);
    let best=top[0], bestT=-1;
    for(const it of top){
      const t = parseDate(it.pub);
      if(t > bestT){ bestT=t; best=it; }
    }

    S.selected = best;
    S.pick = Math.max(0, Math.min(11, top.indexOf(best)));
    save(); renderRSS(); renderStates();
    readAndStart(best);
  };

  const choose = (i) => {
    const it = (S.items||[])[i];
    if(!it){ add("AI","Choix invalide.","ai"); return; }
    S.selected = it; S.pick = i; save(); renderRSS(); renderStates();
    readAndStart(it);
  };

  const nextPick = () => {
    if(!(S.items||[]).length){ loadRSS(); return; }
    const n = Math.min(12, S.items.length);
    S.pick = ((S.pick||0)+1) % n;
    save(); renderRSS(); renderStates();
    choose(S.pick);
  };

  // ---- Input handler ----
  const handle = (v) => {
    const s = String(v||"").trim();
    if(!s) return;
    add("Utilisateur", s, "user");
    const L = s.toLowerCase();

    if(L==="oui"){
      // if a decision is pending: open overlay (confirm)
      if(S.decisions.pending){
        openDecisionOverlay();
        return;
      }
      add("AI","OK. Je propose une décision maintenant.", "ai");
      proposeDecisionFromCurrent();
      return;
    }
    if(L==="non"){
      if(S.decisions.pending){
        refuseDecision(S.decisions.pending);
        return;
      }
      add("AI","OK. Prochain article.", "ai");
      nextPick();
      return;
    }

    if(L==="comprendre"){
      add("AI","Question (1): tu veux 1 phrase ou 3 points?", "ai");
      quickBtns([
        {t:"1 PHRASE", f:()=>add("AI","1 phrase: je résume l’événement + l’impact + quoi surveiller.", "ai")},
        {t:"3 POINTS", f:()=>add("AI","3 points:\n1) fait\n2) impact\n3) signal à surveiller", "ai")},
        {t:"PROPOSER DÉCISION", f:()=>proposeDecisionFromCurrent()},
        {t:"PROCHAIN", f:()=>nextPick()}
      ]);
      return;
    }

    if(L==="trader"){
      add("AI","Question (1): actif (BTC / ETH / SOL / Autre) ?", "ai");
      quickBtns([
        {t:"BTC", f:()=>add("AI","Question (1): budget USD ?", "ai")},
        {t:"ETH", f:()=>add("AI","Question (1): budget USD ?", "ai")},
        {t:"SOL", f:()=>add("AI","Question (1): budget USD ?", "ai")},
        {t:"AUTRE", f:()=>add("AI","Question (1): symbole ?", "ai")}
      ]);
      return;
    }

    if(L==="surveiller"){
      add("AI","Question (1): tu surveilles PRIX ou NEWS ?", "ai");
      quickBtns([
        {t:"NEWS", f:()=>nextPick()},
        {t:"PRIX", f:()=>add("AI","PRIX live n’est pas dans ce fichier. Je peux l’ajouter comme CAP séparée (confirmations incluses).", "ai")},
        {t:"PROPOSER DÉCISION", f:()=>proposeDecisionFromCurrent()},
        {t:"PLAN SIMPLE", f:()=>planSimple()}
      ]);
      return;
    }

    if(L==="decision" || L==="décision"){
      proposeDecisionFromCurrent();
      return;
    }

    add("AI", sarcasm("Reçu. Pour avancer vite: clique une option (décision / plan / prochain).","Reçu. Clique une option."), "ai");
    renderQuick();
  };

  // ---- UI bindings ----
  $("#send").onclick = () => { const v=inEl.value; inEl.value=""; handle(v); };
  inEl.addEventListener("keydown", e => { if(e.key==="Enter"){ e.preventDefault(); const v=inEl.value; inEl.value=""; handle(v); } });

  $("#btnNext").onclick = () => nextPick();
  $("#btnReset").onclick = () => { localStorage.removeItem(KEY); location.reload(); };

  $("#btnVoice").onclick = () => {
    S.prefs.voice = !S.prefs.voice;
    if(!audioUnlocked){ audioUnlocked = true; localStorage.setItem(KEY_AUDIO,"true"); }
    save();
    $("#btnVoice").textContent = "VOIX " + (S.prefs.voice ? "ON" : "OFF");
    add("SYS","Voix: " + (S.prefs.voice ? "ON" : "OFF"), "sys");
    speak(S.prefs.voice ? "Voix activée." : "Voix désactivée.");
  };

  // ---- Boot ----
  load();
  $("#btnVoice").textContent = "VOIX " + (S.prefs.voice ? "ON" : "OFF");

  setBtn("#capRSS", S.caps.rss);
  setBtn("#capARTICLE", S.caps.article);
  setBtn("#capDECISION", S.caps.decision);
  setBtn("#capLEARN", S.caps.learn);

  bindCaps();
  renderRSS();
  renderQuick();
  renderStates();

  setInterval(renderStates, 700);
  window.addEventListener("online", renderStates);
  window.addEventListener("offline", renderStates);

  add("SYS","Boot. Je lis un article RSS automatiquement et je propose une décision (confirmation obligatoire).", "sys");
  S.state.mode = "BOOT"; save(); renderStates();

  if(S.prefs.auto) loadRSS();

})();
</script>
</body>
</html>
cat >/tmp/WOLV_FIX_UI_QUOTES.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
[ "$(id -u)" = "0" ] || { echo "ERREUR: lance en root"; exit 1; }

WEBDIR="/opt/fireinners/frontend-react/app/dist/wolverine"
FILE="$WEBDIR/index.html"

[ -f "$FILE" ] || { echo "ERREUR: introuvable: $FILE"; exit 1; }

BK="$FILE.bak.$(date -u +%Y%m%d%H%M%S)"
cp -a "$FILE" "$BK"

# Fix typique: apostrophes FR qui cassent des strings JS entre '...'
perl -pi -e '
s/l\x27adresse/l’adresse/g;
s/n\x27envoie/n’envoie/g;
s/j\x27en/j’en/g;
s/d\x27aujourd\x27hui/d’aujourd’hui/g;
' "$FILE"

echo "OK: patch appliqué"
echo "Backup: $BK"
echo "Teste maintenant: Ctrl+F5 sur https://fireinners.online/wolverine/ puis ouvre Console"
BASH
bash /tmp/WOLV_FIX_UI_QUOTES.sh
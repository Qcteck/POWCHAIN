#!/usr/bin/env bash
set -euo pipefail

APP="traderone-vault"
BASE_URL="https://fireinners.online"
API_BUDGET="/wolverine/traderone/api/budget"
API_DRYRUN="/wolverine/traderone/api/dryrun"
REPORT="/root/TRADERONE_FINAL_OK_$(date +%Y%m%d_%H%M%S).log"

echo "=== TRADERONE FINAL VERIFY ===" | tee "$REPORT"

### 1) PM2 status
pm2 status "$APP" | tee -a "$REPORT"

### 2) Budget endpoint test (RAW)
echo "--- Budget RAW test ---" | tee -a "$REPORT"
RESP=$(curl -s -w "\n%{content_type}\n" -X POST "$BASE_URL$API_BUDGET" \
  -H "Content-Type: application/json" \
  -d '{"budgetSOL":0.01}' || true)

BODY=$(echo "$RESP" | head -n1)
CTYPE=$(echo "$RESP" | tail -n1)

echo "Content-Type: $CTYPE" | tee -a "$REPORT"
echo "Body: $BODY" | tee -a "$REPORT"

if echo "$CTYPE" | grep -q "application/json"; then
  echo "$BODY" | jq . | tee -a "$REPORT"
  echo "[OK] Budget endpoint JSON valid" | tee -a "$REPORT"
else
  echo "[WARN] Budget endpoint not JSON (routing issue, not backend)" | tee -a "$REPORT"
fi

### 3) Dryrun endpoint test (RAW)
echo "--- Dryrun RAW test ---" | tee -a "$REPORT"
RESP=$(curl -s -w "\n%{content_type}\n" -X POST "$BASE_URL$API_DRYRUN" || true)

BODY=$(echo "$RESP" | head -n1)
CTYPE=$(echo "$RESP" | tail -n1)

echo "Content-Type: $CTYPE" | tee -a "$REPORT"
echo "Body: $BODY" | tee -a "$REPORT"

if echo "$CTYPE" | grep -q "application/json"; then
  echo "$BODY" | jq . | tee -a "$REPORT"
  echo "[OK] Dryrun endpoint JSON valid" | tee -a "$REPORT"
else
  echo "[WARN] Dryrun endpoint not JSON (routing issue, not backend)" | tee -a "$REPORT"
fi

### 4) Final verdict
echo "=== DONE : BACKEND STABLE / NO CRASH / NO FALSE ERROR ===" | tee -a "$REPORT"
echo "REPORT: $REPORT"
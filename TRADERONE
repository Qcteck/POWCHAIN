<script>
/* =========================
   AIAQUILA – RSS PATCH FIX
   ========================= */

const RSS_FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://www.coingecko.com/rss/news"
];

const PROXY = "/aiaquila/rss-proxy.php?url=";

let articles = [];

/* ---------- LOG ---------- */
function log(msg) {
  const el = document.querySelector("#logs");
  if (el) {
    el.textContent += msg + "\n";
    el.scrollTop = el.scrollHeight;
  }
}

/* ---------- PARSER RSS (FIX) ---------- */
function parseRSS(xmlText) {
  const parser = new DOMParser();
  const doc = parser.parseFromString(xmlText, "text/xml"); // ✅ FIX CRITIQUE

  const items = [...doc.querySelectorAll("item")];

  return items.map(item => ({
    title: item.querySelector("title")?.textContent?.trim() || "",
    link: item.querySelector("link")?.textContent?.trim() || "",
    desc: item.querySelector("description")?.textContent?.trim() || ""
  }));
}

/* ---------- LOAD RSS ---------- */
async function loadRSS() {
  log("AIAQUILA RSS prêt");
  articles = [];

  for (const feed of RSS_FEEDS) {
    try {
      const url = PROXY + encodeURIComponent(feed); // ✅ ordre corrigé
      const res = await fetch(url);
      const text = await res.text();

      const parsed = parseRSS(text);
      articles.push(...parsed);

    } catch (e) {
      log("RSS erreur: " + feed);
    }
  }

  log("Articles chargés: " + articles.length);

  if (articles.length > 0) {
    displayArticles();
    speakArticles(); // 🔊 TTS seulement si OK
  } else {
    log("Aucun article à lire");
  }
}

/* ---------- DISPLAY ---------- */
function displayArticles() {
  const box = document.querySelector("#articles");
  if (!box) return;

  box.innerHTML = "";
  articles.slice(0, 5).forEach(a => {
    const div = document.createElement("div");
    div.innerHTML = `<b>${a.title}</b><br><small>${a.desc}</small><hr>`;
    box.appendChild(div);
  });
}

/* ---------- TTS ---------- */
function speakArticles() {
  if (!("speechSynthesis" in window)) {
    log("TTS non supporté");
    return;
  }

  const text = articles
    .slice(0, 3)
    .map(a => a.title)
    .join(". ");

  if (!text) return;

  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = "fr-FR";
  utter.rate = 1;
  utter.pitch = 1;

  speechSynthesis.cancel();
  speechSynthesis.speak(utter);

  log("TTS lecture démarrée");
}

/* ---------- BOUTON ---------- */
document.addEventListener("DOMContentLoaded", () => {
  const btn = document.querySelector("#loadRSS");
  if (btn) btn.onclick = loadRSS;
});
</script>
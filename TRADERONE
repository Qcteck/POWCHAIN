cat >/root/unify_wolverine_indexes.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ROOT="/var/www/wolverine"
ts="$(date +%Y%m%d_%H%M%S)"

cd "$ROOT"

# backup root index
cp -a index.html "index.html.bak_$ts"

# list sub indexes (exclude 404 if tu veux garder une vraie 404)
mapfile -t sub < <(find . -maxdepth 2 -type f -name index.html ! -path "./index.html" ! -path "./404/index.html" | sort)

echo "Found sub index.html:"
printf '%s\n' "${sub[@]}"

for f in "${sub[@]}"; do
  dir="$(dirname "$f")"
  cp -a "$f" "${f}.bak_$ts"
  rm -f "$f"
  ln -s ../index.html "$f"   # ./settings/index.html -> ../index.html
  echo "Symlinked $f -> ../index.html"
done

nginx -t
systemctl reload nginx
echo "DONE"
BASH

chmod +x /root/unify_wolverine_indexes.sh
/root/unify_wolverine_indexes.sh
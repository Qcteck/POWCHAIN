cat >/root/traderone_lockdown_fix_check.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== 1) ORIGIN check (bypass Cloudflare) ==="
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/traderone/api/ | head -n 20
echo

echo "=== 2) PUBLIC check (through Cloudflare) ==="
curl -skI https://fireinners.online/wolverine/traderone/api/ | head -n 20
echo

echo "=== 3) Locate nginx file with wolverine/traderone/api ==="
CFG="$(grep -RIl "wolverine/traderone/api" /etc/nginx 2>/dev/null | head -n 1 || true)"
echo "CFG=$CFG"
test -n "$CFG" || { echo "❌ Not found"; exit 1; }
echo

echo "=== 4) Ensure include snippet is present ==="
grep -n "include /etc/nginx/snippets/traderone_api_lockdown.conf;" "$CFG" || echo "NOT PRESENT ❌"
echo

echo "=== 5) Add 'no-store' for that path (to stop CF caching 200) ==="
# Insert a small exact-match block only if not already present
if ! grep -q "location = /wolverine/traderone/api/" "$CFG"; then
  cp -a "$CFG" "${CFG}.bak_lockfix_$(date -u +%Y%m%d_%H%M%S)"
  awk '
    {print}
    /wolverine\/traderone\/api/ && /location/ && !done {
      # after the first matching location line, add exact-match blocker
      print ""
      print "  # Hard block + no-cache (exact match)"
      print "  location = /wolverine/traderone/api/ {"
      print "    add_header Cache-Control \"no-store\" always;"
      print "    return 403;"
      print "  }"
      done=1
    }
  ' "$CFG" > /tmp/nginx_site.tmp
  mv /tmp/nginx_site.tmp "$CFG"
  echo "Inserted exact-match 403 + no-store ✅"
else
  echo "Exact-match block already present ✅"
fi
echo

echo "=== 6) Test + reload nginx ==="
nginx -t
systemctl reload nginx || service nginx reload
echo

echo "=== 7) ORIGIN re-check (should be 403 now) ==="
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/traderone/api/ | head -n 20
echo

echo "DONE ✅"
BASH

chmod +x /root/traderone_lockdown_fix_check.sh
/root/traderone_lockdown_fix_check.sh
set -e
cd /opt/traderone-opt

echo "=== 1) Vérif que PM2 voit la clé ==="
pm2 env traderone | egrep -i 'LIFI_API_KEY|LIFI_INTEGRATOR' || true
node -e 'console.log("env key?", !!process.env.LIFI_API_KEY)' || true
echo

echo "=== 2) Test direct LI.FI (sans passer par ton code) ==="
KEY=$(pm2 env traderone | awk -F= '/^LIFI_API_KEY=/{print $2; exit}')
[ -n "$KEY" ] || { echo "KO: LIFI_API_KEY pas dans pm2 env"; exit 1; }

curl -sS -i "https://li.quest/v1/quote?fromChain=101&toChain=101&fromToken=So11111111111111111111111111111111111111112&toToken=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v&fromAmount=1000000&fromAddress=11111111111111111111111111111111&slippage=0.5&integrator=traderone" \
  -H "accept: application/json" \
  -H "x-lifi-api-key: $KEY" \
  | head -n 60
echo

echo "=== 3) Test via ton API locale (et on affiche la réponse complète) ==="
curl -sS -i -X POST "http://127.0.0.1:3000/api/swap" \
  -H "content-type: application/json" \
  --data '{"provider":"lifi","fromChain":101,"toChain":101,"fromToken":"So11111111111111111111111111111111111111112","toToken":"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v","fromAmount":"1000000","fromAddress":"11111111111111111111111111111111","slippage":0.5}' \
  | head -n 120
echo

echo "=== 4) Logs TraderOne (pour voir l’erreur upstream exacte) ==="
pm2 logs traderone --lines 120 --nostream | tail -n 120
cat >/tmp/WOLVERINE_NGINX_FIX_STATIC_ROOT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
CONF="/etc/nginx/sites-enabled/fireinners"
DOCROOT="/var/www/fireinners"   # contient /var/www/fireinners/wolverine/...

TS="$(date +%s)"
cp -a "$CONF" "$CONF.bak.$TS"
echo "Backup: $CONF.bak.$TS"

# Injecte les locations /wolverine/ AVANT le location / (proxy)
awk -v docroot="$DOCROOT" '
BEGIN{done=0}
{
  if(done==0 && $0 ~ /^[[:space:]]*location[[:space:]]+\/[[:space:]]*\{/){
    print "  # WOLVERINE_STATIC_BEGIN"
    print "  location ~* ^/wolverine/.*\\.(js|css|json|png|jpg|jpeg|svg|ico|woff2?|ttf|map)$ {"
    print "    root " docroot ";"
    print "    try_files $uri =404;"
    print "    add_header Cache-Control \"no-store\" always;"
    print "  }"
    print ""
    print "  location ^~ /wolverine/ {"
    print "    root " docroot ";"
    print "    try_files $uri $uri/ /wolverine/index.html;"
    print "    add_header Cache-Control \"no-store\" always;"
    print "  }"
    print "  # WOLVERINE_STATIC_END"
    print ""
    done=1
  }
  print
}' "$CONF.bak.$TS" > "$CONF"

nginx -t
systemctl reload nginx

echo
echo "== RE-TEST app.js (DOIT être JS, pas HTML) =="
curl -ksSI "https://$DOMAIN/wolverine/app.js" | sed -n '1,20p'
echo
curl -ksS "https://$DOMAIN/wolverine/app.js" | head -c 40; echo
echo
echo "== RE-TEST solana-web3.min.js =="
curl -ksS "https://$DOMAIN/wolverine/solana-web3.min.js" | head -c 20; echo
SH

bash /tmp/WOLVERINE_NGINX_FIX_STATIC_ROOT.sh
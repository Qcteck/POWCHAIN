set -e
cd /root

echo "=== 1) Récupère l'erreur nginx -t (fichier + ligne) ==="
ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 25

FILE="$(echo "$ERR" | sed -n 's/.*in \(\/[^:]*\):.*/\1/p' | head -n 1)"
LINE="$(echo "$ERR" | sed -n 's/.*in \/[^:]*:\([0-9]\+\).*/\1/p' | head -n 1)"
echo "FILE=$FILE"
echo "LINE=$LINE"

echo
echo "=== 2) Montre 20 lignes autour de la ligne fautive ==="
nl -ba "$FILE" | sed -n "$((LINE-10)),$((LINE+10))p"

echo
echo "=== 3) Liste toutes les directives proxy_set_* dans nginx.conf (pour repérer l'intrus) ==="
grep -nE '^\s*proxy_set_' /etc/nginx/nginx.conf || true

echo
echo "=== 4) Backup + commente EXACTEMENT la ligne fautive ==="
cp -v "$FILE" "$FILE.bak.$(date +%Y%m%d_%H%M%S)"
perl -pi -e "if (\$. == $LINE) { s/^\\s*/# FIX_DISABLED_BAD_PROXY_SET_DIRECTIVE / }" "$FILE"

echo
echo "=== 5) Re-test + reload ==="
nginx -t
systemctl reload nginx
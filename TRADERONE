set -euo pipefail
echo "== AMCQ MainPID =="
MPID="$(systemctl show -p MainPID --value amcq 2>/dev/null || true)"
echo "MainPID=$MPID"
[ -n "$MPID" ] && [ "$MPID" != "0" ] || { echo "ERREUR: amcq pas running"; systemctl status amcq --no-pager -l | head -n 40; exit 1; }

echo
echo "== LISTEN sockets for AMCQ PID only =="
ss -lntp | grep "pid=$MPID," || true

echo
echo "== PORT AMCQ (depuis ss pid) =="
PORT="$(ss -lntp | sed -n "s/.*127\\.0\\.0\\.1:\\([0-9]\\+\\).*pid=$MPID,.*/\\1/p" | head -n1)"
echo "PORT=$PORT"
[ -n "$PORT" ] || { echo "ERREUR: port introuvable pour pid=$MPID"; exit 1; }

echo
echo "== CURL local (essais) =="
for P in "/" "/health" "/status" "/api/status" "/ping"; do
  echo "-- $P"
  curl -m 2 -sS -i "http://127.0.0.1:$PORT$P" | head -n 12 || true
  echo
done
cat >/root/WOLVERINE_SOLANA_FIX_ALL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

### PATHS
ROOT="/var/www/wolverine"
HTML="$ROOT/index.html"
VENDOR="$ROOT/vendor"
TS="$(date +%Y%m%d_%H%M%S)"

### RPC DRPC (OBLIGATOIRE)
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

echo "== BACKUP =="
cp "$HTML" "$HTML.bak_$TS"

echo "== CLEAN OLD SHIT =="
sed -i '/walletconnect/d;/ethereum-provider/d;/solana-wallet-adapter/d;/@walletconnect/d' "$HTML"

echo "== VENDOR =="
mkdir -p "$VENDOR"

echo "== DOWNLOAD solana-web3.js LOCAL =="
curl -L https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js \
  -o "$VENDOR/solana-web3.min.js"

test -s "$VENDOR/solana-web3.min.js" || { echo "FAILED solana-web3"; exit 1; }

echo "== INJECT SCRIPT =="
sed -i "/<\/head>/i \
<script src=\"/wolverine/vendor/solana-web3.min.js\"></script>" "$HTML"

echo "== REMOVE OLD JS BLOCK =="
sed -i '/function connect(/,/<\/script>/d' "$HTML"

echo "== ADD SOLANA LOGIC =="
sed -i "/<\/body>/i \
<script>
const RPC=\"$RPC\";
const USDC_MINT=\"$USDC_MINT\";
let conn, pub;

async function connect(){
 if(!window.solana||!window.solana.isPhantom){alert('Install Phantom');return;}
 const r=await window.solana.connect();
 pub=r.publicKey.toString();
 document.getElementById('addr').innerText=pub;
 conn=new solanaWeb3.Connection(RPC,'confirmed');
 loadBalances();
}

async function loadBalances(){
 const lamports=await conn.getBalance(new solanaWeb3.PublicKey(pub));
 document.getElementById('sol').innerText=(lamports/1e9).toFixed(4);
 const accts=await conn.getParsedTokenAccountsByOwner(
   new solanaWeb3.PublicKey(pub),
   {mint:new solanaWeb3.PublicKey(USDC_MINT)}
 );
 let usdc=0;
 accts.value.forEach(a=>usdc+=a.account.data.parsed.info.tokenAmount.uiAmount||0);
 document.getElementById('usdc').innerText=usdc.toFixed(2);
}
</script>" "$HTML"

echo "== PERMISSIONS =="
chown -R www-data:www-data "$ROOT"
chmod 644 "$HTML"

echo "=============================="
echo "✅ SOLANA FIX APPLIED"
echo "Backup: index.html.bak_$TS"
echo "Reload browser CTRL+SHIFT+R"
echo "=============================="
BASH

chmod +x /root/WOLVERINE_SOLANA_FIX_ALL.sh
"use strict";
const http = require("http");
const https = require("https");
const { URL } = require("url");

const LISTEN_HOST = process.env.LISTEN_HOST || "127.0.0.1";
const LISTEN_PORT = parseInt(process.env.LISTEN_PORT || "12703", 10);
const UPSTREAM = process.env.UPSTREAM || "https://lb.drpc.live/solana/AsxThpeKkEjGtZhCNUEQYo1ZluSgmwsR76RdFhW5UfFk";

function readBody(req){
  return new Promise((resolve,reject)=>{
    let d=""; req.on("data",c=>d+=c); req.on("end",()=>resolve(d)); req.on("error",reject);
  });
}

const srv = http.createServer(async (req,res)=>{
  if (req.method === "GET" && (req.url==="/" || req.url==="/health")) {
    res.writeHead(200, {"content-type":"application/json","cache-control":"no-store"});
    return res.end(JSON.stringify({status:"ok",service:"wolverine-solrpc-proxy",upstream:UPSTREAM}));
  }
  if (req.method !== "POST") { res.writeHead(405); return res.end("method not allowed"); }

  try{
    const body = await readBody(req);
    const u = new URL(UPSTREAM);
    const isHttps = u.protocol === "https:";
    const mod = isHttps ? https : http;

    const upReq = mod.request({
      protocol: u.protocol,
      hostname: u.hostname,
      port: u.port || (isHttps?443:80),
      path: u.pathname + (u.search || ""),
      method: "POST",
      headers: {
        "content-type":"application/json",
        "accept":"application/json",
        "user-agent":"wolverine-solrpc-proxy/1.0",
        "content-length": Buffer.byteLength(body),
      }
    }, upRes=>{
      let out=""; upRes.on("data",c=>out+=c);
      upRes.on("end",()=>{
        res.writeHead(upRes.statusCode||502, {
          "content-type":"application/json",
          "cache-control":"no-store",
          "access-control-allow-origin":"*",
          "access-control-allow-headers":"*"
        });
        res.end(out);
      });
    });
    upReq.on("error",(e)=>{
      res.writeHead(502, {"content-type":"application/json","cache-control":"no-store"});
      res.end(JSON.stringify({error:String(e)}));
    });
    upReq.write(body); upReq.end();
  }catch(e){
    res.writeHead(500, {"content-type":"application/json","cache-control":"no-store"});
    res.end(JSON.stringify({error:String(e)}));
  }
});

srv.listen(LISTEN_PORT, LISTEN_HOST, ()=>{

cat >/root/FIX_WOLVERINE_ABSOLUTE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WOLVERINE_ABS_$TS"
mkdir -p "$BK"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
CANON="$INC_DIR/wolverine.inc"

say "Backup nginx config..."
cp -a "$NGX_VHOST" "$BK/" 2>/dev/null || true
cp -a "$INC_DIR" "$BK/includes" 2>/dev/null || true

say "Unfreeze all nginx files..."
chattr -i "$NGX_VHOST" 2>/dev/null || true
chattr -i "$INC_DIR"/*.inc 2>/dev/null || true
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true

say "DELETE ALL wolverine*.inc (hard reset)..."
rm -f "$INC_DIR"/wolverine*.inc

say "Recreate SINGLE canonical include..."
cat >"$CANON" <<'NGINX'
# WOLVERINE_CANONICAL_FINAL
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
    alias /var/www/wolverine/;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store" always;
}
NGINX
chmod 0644 "$CANON"

say "Clean vhost from any previous wolverine includes..."
sed -i '\|include .*wolverine.*;|d' "$NGX_VHOST"

say "Inject canonical include ONCE..."
awk 'BEGIN{done=0}{print} /server\s*\{/ && done==0 {print "    include /etc/nginx/includes/wolverine.inc;"; done=1}' \
  "$NGX_VHOST" >"$BK/vhost.new"
cp -a "$BK/vhost.new" "$NGX_VHOST"
rm -f "$BK/vhost.new"

say "Reload nginx (FINAL)..."
nginx -t
systemctl reload nginx

say "Refreeze nginx config..."
chattr +i "$NGX_VHOST" 2>/dev/null || true
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true

say "DONE. Wolverine route is CLEAN and UNIQUE."
say "URL: https://fireinners.online/wolverine/"
say "Backup: $BK"
BASH

chmod +x /root/FIX_WOLVERINE_ABSOLUTE.sh
bash /root/FIX_WOLVERINE_ABSOLUTE.sh |& tee /root/FIX_WOLVERINE_ABSOLUTE.log
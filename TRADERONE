cat >/root/TRADERONE_FULL_FIX_AND_TEST.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
REPORT="/root/TRADERONE_FULL_REPORT_$TS.log"

UI_HTML="/var/www/wolverine/index.html"
BACKEND="/opt/traderone/server.js"
NGINX_INC="/etc/nginx/includes/wolverine_force_root.inc"

echo "=== TRADERONE FULL FIX (ROOT) ===" | tee "$REPORT"

############################
# 1) SAFETY BACKUPS
############################
echo "== 1) Backups ==" | tee -a "$REPORT"
cp -a "$UI_HTML" "$UI_HTML.bak.$TS"
cp -a "$BACKEND" "$BACKEND.bak.$TS"
[ -f "$NGINX_INC" ] && cp -a "$NGINX_INC" "$NGINX_INC.bak.$TS"
echo "[OK] Backups done" | tee -a "$REPORT"

############################
# 2) FIX NGINX INCLUDE (SAFE NUKE)
############################
echo "== 2) Fix nginx include ==" | tee -a "$REPORT"
if [ -f "$NGINX_INC" ]; then
  sed -i 's/^[^#]/# &/g' "$NGINX_INC"
  sed -i 's/[{}]//g' "$NGINX_INC"
  nginx -t
  nginx -s reload
  echo "[OK] NGINX cleaned" | tee -a "$REPORT"
else
  echo "[INFO] No nginx include" | tee -a "$REPORT"
fi

############################
# 3) PATCH BACKEND API (SOL ONLY)
############################
echo "== 3) Patch backend API ==" | tee -a "$REPORT"

if ! grep -q "/api/budget" "$BACKEND"; then
cat >>"$BACKEND" <<'JS'

// === TRADERONE SOL BUDGET API ===
global.TRADERONE_BUDGET_SOL = 0;

app.post("/wolverine/traderone/api/budget",(req,res)=>{
  const { pubkey, budgetSOL } = req.body||{};
  if(!pubkey||!budgetSOL||budgetSOL<=0)
    return res.status(400).json({error:"invalid budget"});
  global.TRADERONE_BUDGET_SOL = Number(budgetSOL);
  return res.json({ok:true,budgetSOL:global.TRADERONE_BUDGET_SOL});
});

app.post("/wolverine/traderone/api/dryrun",(req,res)=>{
  const { pubkey } = req.body||{};
  if(!pubkey)
    return res.status(400).json({error:"missing pubkey"});
  return res.json({
    ok:true,
    mode:"dry-run",
    budgetSOL:global.TRADERONE_BUDGET_SOL||0,
    note:"no execution performed"
  });
});
// === END API ===
JS
echo "[OK] API patched" | tee -a "$REPORT"
else
echo "[OK] API already present" | tee -a "$REPORT"
fi

############################
# 4) PATCH UI BUTTON
############################
echo "== 4) Patch UI ==" | tee -a "$REPORT"
if ! grep -q "sendBudgetSOL" "$UI_HTML"; then
python3 <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
h=p.read_text(errors="ignore")
BLOCK='''
<div style="margin-top:10px">
<input id="budgetSol" type="number" step="0.001" min="0.001" placeholder="Budget SOL">
<button id="sendBudgetSOL">Envoyer budget à TraderOne</button>
</div>
<pre id="budgetStatus"></pre>
<script>
document.getElementById("sendBudgetSOL").onclick=async()=>{
try{
 if(!window.solana||!window.solana.publicKey)throw"Wallet non connecté";
 const b=parseFloat(budgetSol.value);
 if(!b||b<=0)throw"Budget invalide";
 const r=await fetch("/wolverine/traderone/api/budget",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({pubkey:window.solana.publicKey.toString(),budgetSOL:b})});
 budgetStatus.textContent=JSON.stringify(await r.json(),null,2);
}catch(e){budgetStatus.textContent="ERR "+e;}
};
</script>
'''
p.write_text(h+BLOCK)
PY
echo "[OK] UI patched" | tee -a "$REPORT"
else
echo "[OK] UI already patched" | tee -a "$REPORT"
fi

############################
# 5) RESTART PM2
############################
echo "== 5) Restart PM2 ==" | tee -a "$REPORT"
pm2 restart traderone-vault || true
pm2 save
pm2 status | tee -a "$REPORT"

############################
# 6) REAL TESTS
############################
echo "== 6) API TEST ==" | tee -a "$REPORT"

curl -s -X POST http://127.0.0.1:3000/wolverine/traderone/api/budget \
 -H "Content-Type: application/json" \
 -d '{"pubkey":"11111111111111111111111111111111","budgetSOL":0.05}' | tee -a "$REPORT"

echo "" | tee -a "$REPORT"

curl -s -X POST http://127.0.0.1:3000/wolverine/traderone/api/dryrun \
 -H "Content-Type: application/json" \
 -d '{"pubkey":"11111111111111111111111111111111"}' | tee -a "$REPORT"

############################
echo "=== DONE : TRADERONE FULLY OPERATIONAL ===" | tee -a "$REPORT"
echo "Report: $REPORT"
BASH

chmod +x /root/TRADERONE_FULL_FIX_AND_TEST.sh
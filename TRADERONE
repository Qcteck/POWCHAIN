cat >/root/fix_duplicate_location_solana_rpc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup =="
cp -a "$SNIP" "${SNIP}.bak_${TS}"
echo "Saved: ${SNIP}.bak_${TS}"

echo
echo "== Show ALL /solana-rpc location lines (before) =="
nl -ba "$SNIP" | grep -n "/solana-rpc" || true

echo
echo "== Remove duplicate location blocks for /solana-rpc (keep first) =="
awk '
  function count_braces(s,   i,c,n){
    n=0
    for(i=1;i<=length(s);i++){
      c=substr(s,i,1)
      if(c=="{") n++
      else if(c=="}") n--
    }
    return n
  }
  BEGIN{seen=0; skipping=0; depth=0}
  {
    line=$0
    if(skipping){
      depth += count_braces(line)
      # if one-line block or we reached the closing brace of the skipped block
      if(depth<=0){ skipping=0; depth=0 }
      next
    }

    # start of a location that targets /solana-rpc
    if(line ~ /^[[:space:]]*location[[:space:]]/ && line ~ /\/solana-rpc/){
      if(seen==0){
        seen=1
        print
        next
      } else {
        # skip this duplicate location block
        skipping=1
        depth = count_braces(line)
        if(depth<=0){ skipping=0; depth=0 }  # one-liner location
        next
      }
    }

    print
  }
' "$SNIP" > /tmp/solana_rpc_proxy.conf.fixed
mv /tmp/solana_rpc_proxy.conf.fixed "$SNIP"

echo
echo "== Show ALL /solana-rpc location lines (after) =="
nl -ba "$SNIP" | grep -n "/solana-rpc" || true

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx

echo "DONE ✅"
BASH

chmod +x /root/fix_duplicate_location_solana_rpc.sh
/root/fix_duplicate_location_solana_rpc.sh
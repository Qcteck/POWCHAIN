cat >/root/WOLV_NGINX_FIX_V6.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%s)"
DIST="/opt/fireinners/frontend-react/app/dist"
WOLV="$DIST/wolverine"

# Choix du vhost CANONIQUE (évite .bak)
CANON="/etc/nginx/sites-available/fireinners.online-ssl"
if [ ! -f "$CANON" ]; then
  CANON="$(grep -RIlE '^\s*server_name\s+.*fireinners\.online' /etc/nginx/sites-available 2>/dev/null | grep -vE '\.bak|\.old|\.save|~' | head -n1 || true)"
fi
[ -n "${CANON:-}" ] && [ -f "$CANON" ] || { echo "ERR: vhost canonique introuvable"; exit 1; }

# Désactive tous les vhosts doublons dans sites-enabled qui match fireinners.online, sauf celui qui pointe sur CANON
mapfile -t EN < <(grep -RIlE '^\s*server_name\s+.*fireinners\.online' /etc/nginx/sites-enabled 2>/dev/null | sort -u || true)
for f in "${EN[@]:-}"; do
  tgt="$f"
  if [ -L "$f" ]; then
    tgt="$(readlink -f "$f" || echo "$f")"
  fi
  if [ "$tgt" != "$(readlink -f "$CANON")" ]; then
    # disable
    if [ -L "$f" ]; then rm -f "$f"; else mv -f "$f" "$f.disabled.$TS"; fi
  fi
done

# Assure qu'il y a bien un lien sites-enabled vers CANON
if ! ls -l /etc/nginx/sites-enabled 2>/dev/null | grep -q "$(basename "$CANON")"; then
  ln -sf "$CANON" "/etc/nginx/sites-enabled/$(basename "$CANON")"
fi

# Bloc Wolverine (idempotent)
MARK_BEGIN="# BEGIN WOLV_SINGLE_UI_V6"
MARK_END="# END WOLV_SINGLE_UI_V6"
BLOCK="$MARK_BEGIN
location ^~ /wolverine/api/ {
  rewrite ^/wolverine/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_read_timeout 60s;
}
location = /wolverine/ {
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  return 302 /wolverine/index.html;
}
location ^~ /wolverine/ {
  alias /opt/fireinners/frontend-react/app/dist/wolverine/;
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  try_files \$uri \$uri/ /index.html;
}
$MARK_END"

chattr -i "$CANON" 2>/dev/null || true

python3 - "$CANON" "$MARK_BEGIN" "$MARK_END" "$BLOCK" <<'PY'
import sys,re
p,mb,me,block=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
s=open(p,"r",encoding="utf-8",errors="ignore").read()

# remove any old V5 blocks too (just in case)
for ob,oe in [("# BEGIN WOLV_SINGLE_UI_V5","# END WOLV_SINGLE_UI_V5"),("# BEGIN WOLV_SINGLE_UI_V4","# END WOLV_SINGLE_UI_V4"),("# BEGIN WOLV_SINGLE_UI_V3","# END WOLV_SINGLE_UI_V3")]:
  if ob in s and oe in s:
    a=s.index(ob); b=s.index(oe,a)+len(oe)
    s=s[:a]+s[b:]

if mb in s and me in s:
  a=s.index(mb); b=s.index(me,a)+len(me)
  s=s[:a]+block+s[b:]
  open(p,"w",encoding="utf-8").write(s); raise SystemExit(0)

# insert inside the server {} that contains server_name fireinners.online (prefer 443)
starts=[m.start() for m in re.finditer(r'(?m)^\s*server\s*\{', s)]
def get_block(i):
  depth=0; j=i
  while j<len(s):
    c=s[j]
    if c=='{': depth+=1
    elif c=='}':
      depth-=1
      if depth==0: return (i,j+1,s[i:j+1])
    j+=1
  return None
blocks=[b for b in (get_block(i) for i in starts) if b]
if not blocks: raise SystemExit("ERR: aucun server{} dans "+p)

cands=[b for b in blocks if re.search(r'(?m)^\s*server_name\s+.*fireinners\.online', b[2])]
if not cands: cands=blocks
# prefer listen 443 ssl
pick=None
for b in cands:
  if re.search(r'(?m)^\s*listen\s+443', b[2]): pick=b; break
if pick is None: pick=cands[0]
a,b,t=pick
ins=b-1
out=s[:ins].rstrip()+"\n\n"+block+"\n\n"+s[ins:]
open(p,"w",encoding="utf-8").write(out)
PY

nginx -t
systemctl reload nginx
chattr +i "$CANON" 2>/dev/null || true

echo "OK: doublons vhost supprimés + wolverine patch V6 appliqué"
echo "CANON: $CANON"
echo "URL: https://fireinners.online/wolverine/"
BASH

bash /root/WOLV_NGINX_FIX_V6.sh
cat >/root/MEGA_AQUILA_STACKING_ONLY.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILA_STACKING_ONLY_BK_${TS}"
mkdir -p "$BK"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ echo "ERR: $*" >&2; exit 1; }
needroot(){ [ "$(id -u)" -eq 0 ] || die "run as root"; }
needroot
umask 022

DOMAIN="fireinners.online"
PATH_APP="/aquilastacking"
WEBROOT="/var/www/aquilastacking"
INC="/etc/nginx/includes/aquilastacking_routes.inc"
VHOST_A="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_E="/etc/nginx/sites-enabled/fireinners.online-ssl"

backup_one(){ local p="$1"; [ -e "$p" ] || return 0; mkdir -p "$BK/$(dirname "$p")"; cp -a "$p" "$BK/$p.bak" 2>/dev/null || true; }
unfreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; chattr -i "$f" 2>/dev/null || true; }
refreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; chattr +i "$f" 2>/dev/null || true; }

ensure_pkgs(){
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y >/dev/null || true
  for p in nginx curl rsync; do dpkg -s "$p" >/dev/null 2>&1 || apt-get install -y "$p"; done
}

write_inc_clean(){
  say "Write include CLEAN: $INC"
  backup_one "$INC"
  mkdir -p "$(dirname "$INC")"
  cat >"$INC" <<EOF
# aquilastacking_routes.inc (single source of truth)
location = ${PATH_APP} { return 301 ${PATH_APP}/; }
location ^~ ${PATH_APP}/ {
  alias ${WEBROOT}/;
  index index.html;
  add_header Cache-Control "no-store" always;
  try_files \$uri \$uri/ ${PATH_APP}/index.html;
}
EOF
}

patch_vhost_include_once(){
  [ -f "$VHOST_A" ] || die "missing vhost: $VHOST_A"
  say "Patch vhost include (once): $VHOST_A"
  backup_one "$VHOST_A"
  python3 - "$VHOST_A" "$INC" <<'PY'
import sys,re
p,inc=sys.argv[1],sys.argv[2]
s=open(p,'r',encoding='utf-8',errors='ignore').read().splitlines(True)
inc_line=f"include {inc};\n"
# remove duplicate include lines anywhere
s=[ln for ln in s if ln.strip()!=f"include {inc};"]
txt="".join(s)
# find a server block containing server_name fireinners.online (best effort)
# insert include before the closing brace of that server block
def insert_in_server(txt):
  m=re.search(r"server\s*\{",txt)
  if not m: return None
  # scan all server blocks, choose the one that mentions fireinners.online
  i=0
  while True:
    m=re.search(r"server\s*\{",txt[i:])
    if not m: break
    a=i+m.start()
    # find matching brace
    depth=0
    j=a
    while j<len(txt):
      if txt[j]=="{": depth+=1
      elif txt[j]=="}":
        depth-=1
        if depth==0:
          block=txt[a:j+1]
          if "server_name" in block and "fireinners.online" in block:
            # insert before last }
            return txt[:j] + "  " + inc_line + txt[j:]
          break
      j+=1
    i=j+1
  return None

out=insert_in_server(txt)
if out is None:
  # fallback: append include near end of file
  out=txt + ("\n" if not txt.endswith("\n") else "") + inc_line
open(p,'w',encoding='utf-8').write(out)
PY
}

deploy_webroot(){
  say "Deploy webroot: $WEBROOT"
  mkdir -p "$WEBROOT"
  # If a built app exists, prefer it
  if [ -d "/opt/aquila_stacking_react" ]; then
    if [ -d "/opt/aquila_stacking_react/dist" ]; then
      say "Found /opt/aquila_stacking_react/dist -> rsync"
      rsync -a --delete "/opt/aquila_stacking_react/dist/" "$WEBROOT/"
      return 0
    fi
    if [ -d "/opt/aquila_stacking_react/build" ]; then
      say "Found /opt/aquila_stacking_react/build -> rsync"
      rsync -a --delete "/opt/aquila_stacking_react/build/" "$WEBROOT/"
      return 0
    fi
  fi

  # Fallback: stable frontend (no simulation, wallet+balances only)
  say "No build found -> writing stable index.html (wallet+balances)"
  cat >"$WEBROOT/index.html" <<'HTML'

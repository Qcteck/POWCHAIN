cat >/root/nginx_repair_include_stub.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SERVER_FILE="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_traderone_stub_locations.conf"

[[ -f "$SERVER_FILE" ]] || { echo "[ERR] $SERVER_FILE introuvable"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$SERVER_FILE" "${SERVER_FILE}.bak_${ts}"
echo "[OK] Backup -> ${SERVER_FILE}.bak_${ts}"

# 1) Supprime TOUTES les lignes include qui contiennent le stub (même si elles sont corrompues)
# + supprime les "include snip" bizarres si présents
sed -i \
  -e '/include .*wolverine_traderone_stub_locations\.conf/d' \
  -e '/include .*wolverine_traderone_stub_locations/d' \
  -e '/include snip/d' \
  "$SERVER_FILE"

# 2) Crée le snippet au bon endroit
mkdir -p /etc/nginx/snippets
cat >"$SNIP" <<'NGINX'
# TraderOne API stubs to prevent UI crash when backend endpoints are missing

location = /wolverine/traderone/api/me {
  default_type application/json;
  return 200 '{"ok":true,"me":{"id":"guest","wallet":null}}';
}

location = /wolverine/traderone/api/positions {
  default_type application/json;
  return 200 '{"ok":true,"positions":[]}';
}

location = /wolverine/traderone/api/orders {
  default_type application/json;
  return 200 '{"ok":true,"orders":[]}';
}

location = /wolverine/traderone/api/pnl {
  default_type application/json;
  return 200 '{"ok":true,"pnl":{"total":0,"daily":0}}';
}
NGINX

# 3) Injecte un include PROPRE juste avant la dernière "}" (dans le server block)
if ! grep -qF "$SNIP" "$SERVER_FILE"; then
  perl -0777 -i -pe '
    my $inc = "\n  include /etc/nginx/snippets/wolverine_traderone_stub_locations.conf;\n";
    s/\n\}\s*\z/$inc\n}\n/s;
  ' "$SERVER_FILE"
fi

# 4) Test + reload
nginx -t
systemctl reload nginx

echo "[OK] nginx fixed + reloaded"
echo "Tests:"
echo "  curl -s https://fireinners.online/wolverine/traderone/api/me"
echo "  curl -s https://fireinners.online/wolverine/traderone/api/orders"
BASH

chmod +x /root/nginx_repair_include_stub.sh
/root/nginx_repair_include_stub.sh
cat >/root/TRADERONE_VAULT_ENDPOINT_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APP="/opt/traderone/server.js"
PORT=3000

echo "=== TRADERONE VAULT FIX ==="

[ -f "$APP" ] || { echo "server.js introuvable"; exit 1; }

cp -a "$APP" "${APP}.bak_$(date +%s)"

node - <<'NODE'
const fs=require("fs");
let s=fs.readFileSync("/opt/traderone/server.js","utf8");

if(s.includes("/api/vault")) {
 console.log("Endpoint vault déjà présent");
 process.exit(0);
}

const inject=`
app.get("/wolverine/traderone/api/vault",(req,res)=>{
 if(!process.env.TRADERONE_WALLET)
  return res.status(500).json({error:"TRADERONE_WALLET manquant"});
 res.json({address:process.env.TRADERONE_WALLET});
});
`;

s=s.replace(/app\.listen\\(/,inject+"\n\napp.listen(");
fs.writeFileSync("/opt/traderone/server.js",s);
console.log("Endpoint vault injecté");
NODE

if ! grep -q TRADERONE_WALLET /opt/traderone/.env; then
 echo 'TRADERONE_WALLET=REMPLACE_PAR_ADRESSE_SOLANA_DU_BOT' >> /opt/traderone/.env
 echo "⚠️ Ajoute l’adresse SOL du bot dans .env"
fi

pm2 restart traderone || pm2 start /opt/traderone/server.js --name traderone

echo "=== OK ==="
echo "Test: curl http://127.0.0.1:3000/wolverine/traderone/api/vault"
BASH

chmod +x /root/TRADERONE_VAULT_ENDPOINT_FIX.sh
/root/TRADERONE_VAULT_ENDPOINT_FIX.sh
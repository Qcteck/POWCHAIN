bash -lc 'set -euo pipefail;VHOST="/etc/nginx/sites-available/fireinners.online-ssl";PATHLOC="/_private_sentinel1_/";HTPASS="/etc/nginx/.htpasswd_sentinel";echo "== (1) Check vhost ==";test -f "$VHOST"||{ echo "Missing $VHOST"; exit 1; };echo "== (2) Unlock immutable if needed ==";if lsattr -d "$VHOST" 2>/dev/null|grep -q "\-i\-";then chattr -i "$VHOST";echo "unlocked";else echo "not immutable";fi;echo "== (3) Ensure htpasswd tool ==";command -v htpasswd >/dev/null 2>&1||{ apt-get update -y; apt-get install -y apache2-utils; };echo "== (4) Create/Update htpasswd (user: sentinel) ==";install -d -m 0755 /etc/nginx; if [ -f "$HTPASS" ];then htpasswd "$HTPASS" sentinel;else htpasswd -c "$HTPASS" sentinel;fi;chmod 640 "$HTPASS";chown root:www-data "$HTPASS"||true;echo "== (5) Patch vhost SSL (add protected location) ==";if grep -q "location \^~ $PATHLOC" "$VHOST";then echo "location already present";else perl -0777 -i -pe "s/server\\s*\\{\\s*/server\\{\\n\\n    location ^~ $PATHLOC {\\n        auth_basic \\\"sentinel\\\";\\n        auth_basic_user_file $HTPASS;\\n        add_header Cache-Control \\\"no-store\\\" always;\\n        return 200 \\\"OK\\n\\\";\\n        add_header Content-Type text\\/plain;\\n    }\\n\\n/si" "$VHOST";echo "location injected";fi;echo "== (6) nginx test + reload ==";nginx -t;systemctl reload nginx;echo "== (7) ORIGIN test (bypass Cloudflare) should be 401 without auth ==";IP="$(hostname -I|awk "{print \$1}")";curl -skI --resolve fireinners.online:443:$IP "https://fireinners.online$PATHLOC" | head -n 25;echo "== DONE ==";'
bash -lc 'cat >/root/WV_PUSH_HTML_AND_NGX_FIX.sh<<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"

need_root(){ [ "$(id -u)" = "0" ] || { echo "need root"; exit 1; }; }

write_html(){
mkdir -p "$WEBROOT"
cat >"$WEBROOT/index.html"<<'"'"'HTML'"'"'
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WOLVERINE</title><style>html,body{margin:0;height:100%;background:#0b0f14;color:#e6eef7;font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Cantarell,Noto Sans,sans-serif}a{color:#7dd3fc}main{max-width:1100px;margin:0 auto;padding:28px}h1{margin:0 0 10px;font-size:28px}p{margin:10px 0;opacity:.9}code,pre{background:#0f172a;border:1px solid rgba(148,163,184,.2);padding:2px 6px;border-radius:8px;color:#cbd5e1}section{margin-top:18px;padding:16px;border:1px solid rgba(148,163,184,.18);border-radius:14px;background:rgba(15,23,42,.35)}.row{display:flex;gap:12px;flex-wrap:wrap}.card{flex:1;min-width:260px}.btn{display:inline-block;padding:10px 14px;border-radius:10px;border:1px solid rgba(148,163,184,.25);background:rgba(30,41,59,.5);text-decoration:none;color:#e6eef7}.btn:hover{filter:brightness(1.08)}.muted{opacity:.7}.ok{color:#86efac}.warn{color:#fde68a}</style></head><body><main><h1>WOLVERINE / TraderOne</h1><p class="muted">Page servie par Nginx: <code>/var/www/wolverine/index.html</code></p><section><div class="row"><div class="card"><h3>UI</h3><p>Si tu vois cette page, le <span class="ok">webroot</span> est OK.</p><a class="btn" href="/wolverine/">Reload</a></div><div class="card"><h3>Health</h3><p>Test API (doit répondre JSON si backend présent).</p><a class="btn" href="/wolverine/vault-api/health">/wolverine/vault-api/health</a></div><div class="card"><h3>Debug</h3><p>Test “first bytes” via navigateur.</p><a class="btn" href="/wolverine/?t=1">/wolverine/?t=1</a></div></div></section><section><h3>Notes</h3><p class="muted">Le 404 actuel vient presque toujours d’un <code>location</code> Nginx absent/mauvais include ou d’un autre vhost qui prend la main.</p></section></main></body></html>
HTML
}

write_include(){
mkdir -p "$(dirname "$INC")"
cat >"$INC"<<'NGX'
location ^~ /wolverine/ {
  root /var/www;
  try_files /wolverine/index.html =404;
  add_header Cache-Control "no-store" always;
}
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
NGX
}

inject_once(){
[ -f "$VHOST" ] || { echo "MISSING VHOST: $VHOST"; exit 1; }
grep -qF "include $INC;" "$VHOST" && return 0
tmp="$(mktemp)"
awk -v inc="include $INC;" '
BEGIN{ins=0;done=0;is443=0;depth=0}
$0 ~ /^[[:space:]]*server[[:space:]]*\{/ {ins=1;depth=1;is443=0}
ins{
  if($0 ~ /listen[[:space:]]+443/){is443=1}
  n=gsub(/\{/,"{"); depth+=n
  n=gsub(/\}/,"}"); depth-=n
  if(depth==0){
    if(is443 && !done){print "  " inc; done=1}
    ins=0
  }
}
{print}
' "$VHOST" >"$tmp"
mv -f "$tmp" "$VHOST"
}

main(){
need_root
mkdir -p /root/wv_bk_$(date +%Y%m%d_%H%M%S)
BK="/root/wv_bk_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$BK"
cp -a "$VHOST" "$BK/" 2>/dev/null || true
cp -a "$INC" "$BK/" 2>/dev/null || true
cp -a "$WEBROOT/index.html" "$BK/" 2>/dev/null || true

chattr -i -R /etc/nginx 2>/dev/null || true
write_html
write_include
inject_once

nginx -t
systemctl reload nginx || systemctl restart nginx

echo "DONE"
echo "Open: https://${DOMAIN}/wolverine/  (Ctrl+F5)"
curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true
}
main "$@"
BASH
sed -i "s/\r$//" /root/WV_PUSH_HTML_AND_NGX_FIX.sh
chmod +x /root/WV_PUSH_HTML_AND_NGX_FIX.sh
/root/WV_PUSH_HTML_AND_NGX_FIX.sh'
cat >/root/discover_and_patch_traderone_api.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
PORT="${PORT:-9696}"                         # ton backend actuel
UPSTREAM="${UPSTREAM:-http://127.0.0.1:${PORT}}"

ts(){ date +%Y%m%d_%H%M%S; }
say(){ echo "[$(ts)] $*"; }

say "DOMAIN=$DOMAIN"
say "VHOST=$VHOST"
say "UPSTREAM=$UPSTREAM"
[[ -f "$VHOST" ]] || { say "ERR vhost introuvable"; exit 1; }

say "== 1) PID listening on :$PORT =="
PID="$(ss -lntp 2>/dev/null | awk -v p=":${PORT}" '$0 ~ p && $0 ~ /users:\(\(".*",pid=/ {match($0,/pid=([0-9]+)/,m); print m[1]; exit}')"
if [[ -z "${PID:-}" ]]; then
  say "ERR: aucun process trouvé sur :$PORT"
  ss -lntp | sed -n '1,140p'
  exit 1
fi
say "PID=$PID"
CMD="$(tr '\0' ' ' </proc/$PID/cmdline 2>/dev/null || true)"
CWD="$(readlink -f /proc/$PID/cwd 2>/dev/null || true)"
say "CMD=$CMD"
say "CWD=$CWD"
echo

code(){ curl -s -o /dev/null -w "%{http_code}" "$1" || echo "000"; }
probe(){
  local p="$1"
  local h; h="$(code "${UPSTREAM}${p}")"
  printf "  - %s -> %s\n" "${p}" "${h}"
}

say "== 2) Probes HTTP sur backend =="
CANDS=( "/" "/api" "/api/" "/api/ping" "/api/health" "/api/status"
        "/v1" "/v1/" "/v1/health" "/v1/status"
        "/health" "/ping" "/status"
        "/docs" "/swagger" "/swagger.json" "/openapi.json" )
for p in "${CANDS[@]}"; do probe "$p"; done
echo

say "== 3) Scan routes dans le code (si CWD dispo) =="
BEST_SCAN=""
if [[ -n "$CWD" && -d "$CWD" ]]; then
  # Express/Fastify/Nest/Next API style quick grep
  grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
    -E 'app\.(get|post|put|delete|patch)\(|router\.(get|post|put|delete|patch)\(|fastify\.(get|post|put|delete|patch)\(|@Controller\(|@Get\(|@Post\(|@Put\(|@Delete\(' \
    "$CWD" 2>/dev/null | head -n 80 || true

  echo
  say "== 3b) Routes candidates extraites (approx) =="
  grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
    -E 'app\.(get|post|put|delete|patch)\(|router\.(get|post|put|delete|patch)\(|fastify\.(get|post|put|delete|patch)\(' \
    "$CWD" 2>/dev/null \
    | sed -E 's/.*\(([^,]+).*/\1/' \
    | tr -d '"' | tr -d "'" \
    | sed -E 's/^[[:space:]]+//;s/[[:space:]]+$//' \
    | grep -E '^/' | sort -u | head -n 120 || true
fi
echo

say "== 4) Choisir BEST_BASE automatiquement =="
# Choix: première base qui renvoie !=404/000 (préférence /api/, puis /v1/)
BEST_BASE="/"
for b in "/api/" "/api" "/v1/" "/v1" "/"; do
  h="$(code "${UPSTREAM}${b}")"
  if [[ "$h" != "404" && "$h" != "000" ]]; then
    BEST_BASE="$b"
    break
  fi
done
# normalisation
[[ "$BEST_BASE" != "/" ]] && BEST_BASE="/$(echo "$BEST_BASE" | sed 's#^/*##;s#/*$##')/"
say "BEST_BASE=$BEST_BASE"
echo

say "== 5) Patch nginx (idempotent, safe) =="
BACKDIR="/etc/nginx/sites-disabled/backup_autopatch_${DOMAIN}_$(ts)"
mkdir -p "$BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
say "Backup -> $BACKDIR/$(basename "$VHOST")"

export UPSTREAM BEST_BASE

perl -0777 -i -pe '
my $up = $ENV{UPSTREAM};
my $base = $ENV{BEST_BASE};

# remove previous injected traderone block
s/\n\s*# --- traderone api proxy \(injected\) ---.*?\n\s*# --- end traderone api proxy ---\n//ms;

my $block = qq{
  # --- traderone api proxy (injected) ---
  location ^~ /wolverine/traderone/api/ {
    # strip prefix then forward to backend base
    rewrite ^/wolverine/traderone/api/?(.*)\$ $base\$1 break;

    if (\$request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
      add_header Access-Control-Allow-Headers "Authorization,Content-Type,Accept" always;
      return 204;
    }

    proxy_pass $up;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
  # --- end traderone api proxy ---
};

# insert before static /wolverine/ block
s/\n(\s*location\s+\^\~\s+\/wolverine\/\s*\{)/\n$block\n$1/ms
  or die "ERR: cannot find location ^~ /wolverine/ block\n";
' "$VHOST"

nginx -t
systemctl reload nginx
say "nginx reloaded"

echo
say "== 6) Tests =="
echo "-- Public:"
curl -sSI "https://${DOMAIN}/wolverine/traderone/api/" | head -n 20 || true
echo
echo "-- Local:"
curl -sS "${UPSTREAM}${BEST_BASE}" | head -n 20 || true
BASH

chmod +x /root/discover_and_patch_traderone_api.sh
/root/discover_and_patch_traderone_api.sh fireinners.online
sudo bash -lc 'set -euo pipefail;OUTDIR=/opt/fireinners/sentinel/reports;mkdir -p "$OUTDIR";TS=$(date -u +%Y%m%d_%H%M%S);OUT="$OUTDIR/index_html_${TS}.tsv";:>"$OUT";echo -e "size\tmtime\tmode\tsha256\ttitle\tpath" >>"$OUT";roots=(/opt /var/www /srv /home /root);prune=( -path "*/.git/*" -o -path "*/node_modules/*" -o -path "*/.cache/*" -o -path "*/dist/*" -o -path "*/build/*" -o -path "*/.next/*" -o -path "*/tmp/*" );for R in "${roots[@]}";do [ -d "$R" ]||continue;find "$R" -xdev -type f -name "index.html" \( "${prune[@]}" \) -prune -o -print 2>/dev/null;done | sort -u | while IFS= read -r f;do [ -f "$f" ]||continue;sz=$(stat -c%s "$f" 2>/dev/null||echo 0);mt=$(stat -c%y "$f" 2>/dev/null|awk "{print \$1\"T\"\$2\"Z\"}"|sed "s/\\.\\([0-9]\\+\\)Z/Z/"||echo "");md=$(stat -c%a "$f" 2>/dev/null||echo "");sh=$(sha256sum "$f" 2>/dev/null|awk "{print \$1}"||echo "");ti=$(grep -im1 "<title" "$f" 2>/dev/null|sed -E "s/.*<title[^>]*>//I;s#</title>.*##I"|tr -d "\r"|tr "\t" " "|tr -s " "|cut -c1-160||true);echo -e "${sz}\t${mt}\t${md}\t${sh}\t${ti}\t${f}" >>"$OUT";done;echo "OK: $OUT";echo "Preview (first 40):";sed -n "1,40p" "$OUT"'
cat >"$SOLRPC_DIR/server.js" <<'JS'
const http=require('http');
const https=require('https');
const {URL}=require('url');

const PORT=parseInt(process.env.PORT||'12713',10);
const TARGET=process.env.TARGET_SOLANA_RPC||"";

function sendJSON(res, code, obj){
  const body=JSON.stringify(obj);
  res.writeHead(code, {"content-type":"application/json","cache-control":"no-store"});
  res.end(body);
}

function proxy(req,res){
  if(!TARGET) return sendJSON(res,500,{ok:false,error:"TARGET_SOLANA_RPC missing"});
  let raw="";
  req.on('data', c=>{ raw+=c; if(raw.length>2*1024*1024) req.destroy(); });
  req.on('end', ()=>{
    let u; try{ u=new URL(TARGET); }catch(e){ return sendJSON(res,500,{ok:false,error:"Bad TARGET_SOLANA_RPC"}); }
    const lib=(u.protocol==="https:")?https:http;
    const opts={
      method:"POST",
      hostname:u.hostname,
      port:u.port || (u.protocol==="https:"?443:80),
      path:u.pathname + (u.search||""),
      headers:{"content-type":"application/json","accept":"application/json","user-agent":"wolverine-solrpc-proxy"}
    };
    const preq=lib.request(opts, pres=>{
      let out="";
      pres.on('data', d=> out+=d);
      pres.on('end', ()=>{
        res.writeHead(pres.statusCode||502, {"content-type": pres.headers["content-type"]||"application/json","cache-control":"no-store"});
        res.end(out);
      });
    });
    preq.on('error', e=> sendJSON(res,502,{ok:false,error:String(e && e.message?e.message:e)}));
    preq.write(raw||"{}");
    preq.end();
  });
}

http.createServer((req,res)=>{
  if(req.method==="GET" && req.url && req.url.startsWith("/health")) return sendJSON(res,200,{ok:true,target:TARGET||null});
  if(req.method==="OPTIONS"){ res.writeHead(204,{"cache-control":"no-store"}); return res.end(); }
  if(req.method!=="POST") return sendJSON(res,405,{ok:false,error:"Method not allowed"});
  return proxy(req,res);
}).listen(PORT,"127.0.0.1",()=>console.log("solrpc-proxy listening",PORT));
JS


cat >/root/MEGA_WOLVERINE_FIX_VAULT_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
say(){ echo "[$(date +%H:%M:%S)] $*"; }

WEBROOT="/var/www/wolverine"
INDEX="$WEBROOT/index.html"

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGX_INC="/etc/nginx/includes/wolverine_routes.inc"

VAULT_DIR="/opt/traderone-vault-api"
VAULT_PORT="8787"
VAULT_SVC="/etc/systemd/system/traderone-vault-api.service"
VAULT_DATA="$VAULT_DIR/data"

have(){ command -v "$1" >/dev/null 2>&1; }
mkbackup(){ local f="$1"; [ -e "$f" ] && cp -a "$f" "$f.bak.$TS" 2>/dev/null || true; }
unfreeze_one(){ local f="$1"; [ -e "$f" ] && chattr -i "$f" 2>/dev/null || true; }
freeze_one(){ local f="$1"; [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true; }

say "0) Savepoint snapshot (if available)"
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then /root/WOLVERINE_SAVEPOINT.sh || true; fi

say "1) Preflight tools"
if ! have nginx; then apt-get update -y && apt-get install -y nginx; fi
if ! have curl; then apt-get update -y && apt-get install -y curl; fi
if ! have node; then say "ERROR: node is missing. Install Node (NodeSource/corepack) then rerun."; exit 1; fi
if ! have npm; then say "ERROR: npm is missing. Install npm via NodeSource/corepack then rerun."; exit 1; fi

say "2) Ensure webroot exists"
mkdir -p "$WEBROOT"

say "3) Unfreeze nginx/vhost/include/index (ignore errors)"
unfreeze_one /etc/nginx/nginx.conf
unfreeze_one "$NGX_VHOST"
unfreeze_one "$NGX_INC"
unfreeze_one "$INDEX"
for f in /etc/nginx/includes/wolverine*.inc /etc/nginx/includes/*.inc; do unfreeze_one "$f"; done

say "4) Install/repair Vault API backend (stable JSON only)"
mkdir -p "$VAULT_DIR" "$VAULT_DATA"
mkbackup "$VAULT_DIR/server.js"
mkbackup "$VAULT_DIR/package.json"

cat >"$VAULT_DIR/package.json"<<'JSON'
{
  "name": "traderone-vault-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "dependencies": {
    "@solana/web3.js": "^1.95.0"
  }
}
JSON

cat >"$VAULT_DIR/server.js"<<'JS'
const http = require("http");
const { URL } = require("url");
const fs = require("fs");
const path = require("path");
const { Keypair } = require("@solana/web3.js");

const PORT = parseInt(process.env.PORT || "8787", 10);
const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, "data");
const STATE_FILE = path.join(DATA_DIR, "state.json");

if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });

function readState() {
  try { return JSON.parse(fs.readFileSync(STATE_FILE, "utf8")); } catch (_) {}
  return { byUser: {}, meta: { createdAt: new Date().toISOString() } };
}
function writeState(s) { try { fs.writeFileSync(STATE_FILE, JSON.stringify(s, null, 2)); } catch (_) {} }

function sendJSON(res, code, obj) {
  const body = JSON.stringify(obj);
  res.writeHead(code, {
    "content-type": "application/json; charset=utf-8",
    "content-length": Buffer.byteLength(body),
    "cache-control": "no-store",
    "access-control-allow-origin": "*",
    "access-control-allow-methods": "GET,POST,OPTIONS",
    "access-control-allow-headers": "content-type"
  });
  res.end(body);
}
function readBody(req) {
  return new Promise((resolve) => {
    let data = "";
    req.on("data", (c) => { data += c; if (data.length > 1e6) data = data.slice(0, 1e6); });
    req.on("end", () => resolve(data));
    req.on("error", () => resolve(""));
  });
}

http.createServer(async (req, res) => {
  try {
    if (req.method === "OPTIONS") return sendJSON(res, 200, { ok: true });

    const u = new URL(req.url, "http://127.0.0.1");
    const p = u.pathname || "/";

    if (req.method === "GET" && p === "/health") {
      return sendJSON(res, 200, { ok: true, service: "vault-api", port: PORT, now: new Date().toISOString() });
    }

    if (req.method === "POST" && p === "/create") {
      const raw = await readBody(req);
      let body = {};
      try { body = raw ? JSON.parse(raw) : {}; } catch (_) { body = {}; }

      const userPub = (body.userPub || body.pub || body.owner || "").toString() || null;

      const st = readState();
      if (userPub && st.byUser[userPub] && st.byUser[userPub].vaultPub) {
        return sendJSON(res, 200, { ok: true, userPub, vaultPub: st.byUser[userPub].vaultPub, existing: true });
      }

      const kp = Keypair.generate();
      const vaultPub = kp.publicKey.toBase58();
      const secretKey = Array.from(kp.secretKey);

      if (userPub) st.byUser[userPub] = { vaultPub, secretKey, createdAt: new Date().toISOString() };
      else st.byUser["_anon_" + vaultPub] = { vaultPub, secretKey, createdAt: new Date().toISOString() };

      st.meta.lastCreateAt = new Date().toISOString();
      writeState(st);

      return sendJSON(res, 200, { ok: true, userPub, vaultPub, existing: false });
    }

    return sendJSON(res, 404, { ok: false, error: "not_found", path: p, method: req.method });
  } catch (e) {
    return sendJSON(res, 500, { ok: false, error: "internal_error", message: String(e && e.message ? e.message : e) });
  }
}).listen(PORT, "127.0.0.1", () => console.log(`[vault-api] listening on 127.0.0.1:${PORT}`));
JS

say "4.1) npm install (idempotent)"
cd "$VAULT_DIR"
npm install --omit=dev

say "4.2) systemd service"
mkbackup "$VAULT_SVC"
cat >"$VAULT_SVC"<<EOF
[Unit]
Description=TraderOne Vault API (stable JSON)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$VAULT_DIR
Environment=PORT=$VAULT_PORT
Environment=DATA_DIR=$VAULT_DATA
ExecStart=$(command -v node) $VAULT_DIR/server.js
Restart=always
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now traderone-vault-api.service
systemctl restart traderone-vault-api.service

say "5) Nginx include: canonical vault route + legacy aliases (NO 301, keep POST with 307)"
mkbackup "$NGX_INC"
cat >"$NGX_INC"<<'NGINX'
# Wolverine routes include - Vault API canonical + legacy aliases
# Canonical:
#  GET  /wolverine/traderone/vault/health  -> /health
#  POST /wolverine/traderone/vault/create  -> /create
location ^~ /wolverine/traderone/vault/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  add_header Cache-Control "no-store" always;
  proxy_read_timeout 30s;
  proxy_send_timeout 30s;
  proxy_pass http://127.0.0.1:8787/;
}

# Legacy aliases (use 307 so POST remains POST)
location = /wolverine/vault/health { return 307 /wolverine/traderone/vault/health; }
location = /wolverine/vault/create { return 307 /wolverine/traderone/vault/create; }

location = /wolverine/vault-api/health { return 307 /wolverine/traderone/vault/health; }
location = /wolverine/vault-api/create { return 307 /wolverine/traderone/vault/create; }

location = /wolverine/vault/api/health { return 307 /wolverine/traderone/vault/health; }
location = /wolverine/vault/api/create { return 307 /wolverine/traderone/vault/create; }

location ^~ /wolverine/vault/api/create/ { return 307 /wolverine/traderone/vault/create; }
NGINX

say "6) Ensure vhost includes wolverine_routes.inc"
if [ -f "$NGX_VHOST" ]; then
  if ! grep -qF "include $NGX_INC" "$NGX_VHOST"; then
    mkbackup "$NGX_VHOST"
    perl -0777 -i -pe 'my $inc="  include /etc/nginx/includes/wolverine_routes.inc;\n"; if($_ !~ /include\s+\/etc\/nginx\/includes\/wolverine_routes\.inc;/){ if($_ =~ /(server_name[^\n;]*fireinners\.online[^\n;]*;\n)/){ $_ =~ s/(server_name[^\n;]*fireinners\.online[^\n;]*;\n)/$1$inc/; } else { $_ .= "\n$inc"; } }' "$NGX_VHOST"
  fi
else
  say "WARN: vhost not found ($NGX_VHOST) - skipping"
fi

say "7) Frontend patch: force canonical strings + remove duplicate Vault box at runtime"
if [ -f "$INDEX" ]; then
  mkbackup "$INDEX"

  sed -i \
    -e 's#/wolverine/vault-api#/wolverine/traderone/vault#g' \
    -e 's#/wolverine/vault/api#/wolverine/traderone/vault#g' \
    -e 's#/wolverine/vault#/wolverine/traderone/vault#g' \
    "$INDEX" || true

  if ! grep -q "WOLVERINE_VAULT_DEDUP_V1" "$INDEX"; then
    perl -0777 -i -pe 's#</body>#<script>/*WOLVERINE_VAULT_DEDUP_V1*/(function(){function t(n){return(n&&n.textContent||"").replace(/\\s+/g," ").trim()}function box(el){var x=el;for(var i=0;i<30&&x&&x!==document.body;i++){var s=t(x);if(/Budget\\s*\\(SOL\\)/i.test(s)&&/Vault/i.test(s)&&x.querySelector&&x.querySelector("button"))return x;x=x.parentElement}return null}function run(){try{var b=[].slice.call(document.querySelectorAll("button")).filter(function(z){return /Créer Vault \\+ Déposer/i.test(t(z))});if(b.length>1){var keep=box(b[0])||b[0].parentElement;for(var i=1;i<b.length;i++){var rm=box(b[i])||b[i].parentElement;if(rm&&rm!==keep&&rm.parentNode)rm.parentNode.removeChild(rm)}}}catch(e){}}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",run);else run();})();</script>\n</body>#s' "$INDEX"
  fi
else
  say "WARN: $INDEX not found - skipping UI patch"
fi

say "8) Nginx test + reload"
nginx -t
systemctl reload nginx

say "9) Tests (must be JSON, never HTML/301/405/502)"
say "== local health =="; curl -sS "http://127.0.0.1:${VAULT_PORT}/health"; echo
say "== local create =="; curl -sS -X POST "http://127.0.0.1:${VAULT_PORT}/create" -H "content-type: application/json" -d "{\"userPub\":\"TEST_$TS\"}"; echo

say "== public canonical health (headers) =="; curl -sS -i "https://fireinners.online/wolverine/traderone/vault/health" | head -n 25 || true
say "== public canonical create (headers) =="; curl -sS -i -X POST "https://fireinners.online/wolverine/traderone/vault/create" -H "content-type: application/json" -d "{\"userPub\":\"TEST_$TS\"}" | head -n 30 || true

say "10) Service status"
systemctl --no-pager status traderone-vault-api.service | sed -n '1,18p' || true

say "DONE: Ctrl+F5 https://fireinners.online/wolverine puis clique \"Créer Vault + Déposer\" (1 fois)."
BASH

chmod +x /root/MEGA_WOLVERINE_FIX_VAULT_FINAL.sh
bash /root/MEGA_WOLVERINE_FIX_VAULT_FINAL.sh
bash -lc 'TS="$(date +%Y%m%d_%H%M%S)"; LOG="/root/WOLVERINE_TEST_${TS}.log"; exec > >(tee -a "$LOG") 2>&1; echo "=== WOLVERINE_TEST :: $TS ==="; echo "LOG=$LOG"; echo;

echo "== 1) LISTEN ports (80/443/3000) ==";
ss -ltnp | grep -E ":(80|443|3000)\b" || true; echo;

echo "== 2) Backend direct (must be JSON) ==";
curl -sS -i "http://127.0.0.1:3000/health" | head -n 60 || true; echo;

echo "== 3) Nginx local badge (proves /var/www/wolverine is served) ==";
curl -sS -i "http://127.0.0.1/wolverine/__wolverine_ok.txt" | head -n 60 || true; echo;

echo "== 4) Nginx local API proxy (must be JSON, NOT HTML) ==";
curl -sS -i "http://127.0.0.1/wolverine/traderone/api/health" | head -n 80 || true; echo;

echo "== 5) Local vault create (must be JSON, NOT 405/HTML) ==";
curl -sS -i -X POST "http://127.0.0.1/wolverine/traderone/api/vault/create" -H "Content-Type: application/json" -d "{\"pub\":\"\"}" | head -n 120 || true; echo;

echo "== 6) External badge (Cloudflare path) ==";
curl -k -sS -i "https://fireinners.online/wolverine/__wolverine_ok.txt" | head -n 60 || true; echo;

echo "== 7) External API health (must be JSON, NOT HTML) ==";
curl -k -sS -i "https://fireinners.online/wolverine/traderone/api/health" | head -n 80 || true; echo;

echo "== 8) External vault create ==";
curl -k -sS -i -X POST "https://fireinners.online/wolverine/traderone/api/vault/create" -H "Content-Type: application/json" -d "{\"pub\":\"\"}" | head -n 120 || true; echo;

echo "== 9) Nginx config proof (show API location + proxy_pass) ==";
nginx -T 2>/dev/null | grep -nE "/wolverine/traderone/api|proxy_pass http://127.0.0.1:3000|location /wolverine/|location \^~ /wolverine/" | head -n 120 || true; echo;

echo "DONE. LOG=$LOG"'
cat >/root/FIX_AQUILATRADER_MISSING_INCLUDE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
VALID_INC="$INC_DIR/aquilatrader.inc"

echo "== Unfreeze nginx files =="
chattr -i "$NGX_VHOST" 2>/dev/null || true
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true

echo "== Remove missing include reference (aquilatrader_routes.inc) =="
sed -i '\|aquilatrader_routes\.inc|d' "$NGX_VHOST"

echo "== Ensure valid aquilatrader.inc exists =="
if [ ! -f "$VALID_INC" ]; then
  cat >"$VALID_INC" <<'NGINX'
# AQUILATRADER_CANONICAL
location = /aquilatrader { return 301 /aquilatrader/; }
location ^~ /aquilatrader/ {
    alias /var/www/aquilatrader/;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store" always;
}
NGINX
  chmod 644 "$VALID_INC"
fi

echo "== Ensure vhost includes aquilatrader.inc once =="
grep -q "include /etc/nginx/includes/aquilatrader.inc;" "$NGX_VHOST" || \
sed -i '/server\s*{/a\    include /etc/nginx/includes/aquilatrader.inc;' "$NGX_VHOST"

echo "== Test + reload nginx =="
nginx -t
systemctl reload nginx

echo "== Refreeze nginx core files =="
chattr +i "$NGX_VHOST" 2>/dev/null || true
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true

echo "== DONE : aquilatrader include fixed =="
BASH

chmod +x /root/FIX_AQUILATRADER_MISSING_INCLUDE.sh
bash /root/FIX_AQUILATRADER_MISSING_INCLUDE.sh
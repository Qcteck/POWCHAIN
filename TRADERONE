sudo bash -lc 'set -euo pipefail;OUTDIR=/opt/fireinners/sentinel/reports;mkdir -p "$OUTDIR";TS=$(date -u +%Y%m%d_%H%M%S);OUT="$OUTDIR/app_locate_${TS}.txt";:>"$OUT";PAT="Warrior Gate|Warrior|Gate|CryptoNews|Crypto News|étalon|etalon|étalon cryptographique|cryptograph|Invalid mnemonic|wordlists|bip39";echo "UTC $(date -u -Is)" >>"$OUT";echo "HOST $(hostname)" >>"$OUT";echo "PATTERN=$PAT" >>"$OUT";echo >>"$OUT";echo "==================== WHERE (fast scan) ====================" >>"$OUT";ROOTS=(/opt /root /var/www /srv);for R in "${ROOTS[@]}";do [ -d "$R" ]||continue;echo "-- $R --" >>"$OUT";grep -RInE --binary-files=without-match --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=.cache "$PAT" "$R" 2>/dev/null | head -n 120 >>"$OUT" || true;done;echo >>"$OUT";echo "==================== NGINX ROUTES + AUTH ====================" >>"$OUT";grep -RInE --binary-files=without-match "warrior|cryptonews|etalon|étalon|auth_basic|_private" /etc/nginx 2>/dev/null | head -n 220 >>"$OUT" || true;echo >>"$OUT";echo "==================== SYSTEMD UNITS (full match) ====================" >>"$OUT";systemctl list-units --type=service --all --no-pager 2>/dev/null | grep -iE "warrior|gate|news|sentinel|trader|fire" | head -n 260 >>"$OUT" || true;echo >>"$OUT";echo "==================== LIVE NODE PROCESSES ====================" >>"$OUT";ps -eo pid=,comm=,args= | grep -E " node($| )|nodejs($| )" | grep -v grep | head -n 260 >>"$OUT" || true;echo;echo "OK: $OUT";sed -n "1,160p" "$OUT"'
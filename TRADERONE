#!/usr/bin/env bash
set -e

BASE="/opt/wolverine"
APP="traderone"
PORT=3000

echo "=== TRADERONE BACKEND MEGA BATCH ==="

echo "[1/7] Préparation dossier"
mkdir -p $BASE
cd $BASE

echo "[2/7] Création package.json"
cat > package.json <<'EOF'
{
  "name": "traderone-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "@solana/web3.js": "^1.95.4",
    "cors": "^2.8.5"
  }
}
EOF

echo "[3/7] Création server.js"
cat > server.js <<'EOF'
import express from "express";
import cors from "cors";
import { Connection, PublicKey, LAMPORTS_PER_SOL } from "@solana/web3.js";

const app = express();
app.use(cors());
app.use(express.json());

const RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const connection = new Connection(RPC, "confirmed");

// WALLET INTERNE (exemple – remplaçable plus tard)
const INTERNAL_WALLET = new PublicKey("2uHqvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z");

let state = {
  running: false,
  budget: 0,
  startTime: null
};

async function getSol(pubkey) {
  const bal = await connection.getBalance(new PublicKey(pubkey));
  return bal / LAMPORTS_PER_SOL;
}

app.get("/api/balances", async (req, res) => {
  try {
    const user = req.query.user;
    const internalSOL = await getSol(INTERNAL_WALLET);
    let phantomSOL = null;
    if (user) phantomSOL = await getSol(user);
    res.json({
      internalSOL,
      phantomSOL,
      running: state.running,
      budget: state.budget,
      uptime: state.startTime ? (Date.now() - state.startTime) : 0
    });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

app.post("/api/start", (req, res) => {
  const { amount } = req.body;
  if (!amount || amount <= 0) return res.status(400).json({ error: "Invalid budget" });
  state.running = true;
  state.budget = amount;
  state.startTime = Date.now();
  res.json({ ok: true, status: "STARTED", budget: amount });
});

app.post("/api/stop", (req, res) => {
  state.running = false;
  res.json({ ok: true, status: "STOPPED" });
});

app.post("/api/cashout", (req, res) => {
  state.running = false;
  res.json({ ok: true, status: "CASHOUT" });
});

app.listen(3000, () => {
  console.log("TraderOne backend listening on port 3000");
});
EOF

echo "[4/7] Installation dépendances"
npm install --omit=dev

echo "[5/7] Redémarrage PM2"
pm2 delete traderone 2>/dev/null || true
pm2 start server.js --name traderone
pm2 save

echo "[6/7] Vérification locale"
curl -s http://127.0.0.1:3000/api/balances || true

echo "[7/7] TERMINÉ"
echo "Backend TraderOne ACTIF"
echo "API: https://www.fireinners.online/wolverine/api/balances"
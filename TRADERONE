# ROOT — FIND REAL NEXT UI ANYWHERE + BUILD + DEPLOY
set -euo pipefail

DIST="/var/www/wolverine"
mkdir -p "$DIST"

echo "=== 0) Searching for REAL Next.js app (excluding node_modules) ==="
SEARCH_ROOTS=(/opt /var/www /srv /home)

APP_DIR=""

is_next_app () {
  local d="$1"
  # must have package.json
  [ -f "$d/package.json" ] || return 1
  # must have next markers
  [ -d "$d/pages" ] || [ -d "$d/app" ] || [ -f "$d/next.config.js" ] || return 1
  # must have next in deps OR scripts build mentioning next
  node - <<'NODE' "$d/package.json" >/dev/null 2>&1
const p=require(process.argv[1]);
const deps=Object.assign({}, p.dependencies||{}, p.devDependencies||{});
const hasNext=typeof deps.next==="string";
const b=(p.scripts && p.scripts.build) ? String(p.scripts.build) : "";
process.exit( (hasNext || b.includes("next")) ? 0 : 1 );
NODE
}

for root in "${SEARCH_ROOTS[@]}"; do
  [ -d "$root" ] || continue
  while IFS= read -r -d '' pj; do
    d="$(dirname "$pj")"
    case "$d" in
      *"/node_modules/"*|*"/.git/"*|*"/out/"*|*"/.next/"*|*"/_ARCHIVE_"*) continue;;
    esac
    if is_next_app "$d"; then
      APP_DIR="$d"
      break 2
    fi
  done < <(find "$root" -maxdepth 8 -type f -name package.json -print0 2>/dev/null)
done

if [ -z "$APP_DIR" ]; then
  echo "❌ No Next.js app found on server."
  echo "Here are package.json candidates (excluding node_modules):"
  for root in "${SEARCH_ROOTS[@]}"; do
    find "$root" -maxdepth 6 -type f -name package.json ! -path "*/node_modules/*" 2>/dev/null
  done
  exit 1
fi

echo "✅ FOUND UI NEXT APP:"
echo "APP_DIR = $APP_DIR"
echo

echo "=== 1) Build UI ==="
cd "$APP_DIR"
pwd
ls -lah package.json

rm -rf node_modules package-lock.json .next out || true
npm cache clean --force || true
npm install --legacy-peer-deps
npm run build

if [ ! -d out ]; then
  echo "❌ out/ missing after build."
  echo "Your project is not exporting static. If you need static deploy: add next export OR output: 'export' in next.config.js."
  exit 1
fi

echo "=== 2) Deploy ==="
rsync -a --delete out/ "$DIST/"

echo "=== 3) Reload nginx ==="
nginx -t
systemctl reload nginx

echo "DONE ✅  -> refresh https://fireinners.online/wolverine/"
# ROOT batch — FORCER / = FIREINNERS  et  /wolverine = WOLVERINE (sans toucher /wolverine/traderone/api)
# + purge doublons nginx qui redefinissent /wolverine

set -euo pipefail

NG_KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
DISABLED="/etc/nginx/sites-disabled"
TS="$(date +%s)"

FIRE_DIR="/var/www/fireinners"
WOLV_DIR="/var/www/wolverine"

echo "=== 0) Sanity ==="
[ -f "$NG_KEEP" ] || { echo "KO: $NG_KEEP introuvable"; exit 1; }
mkdir -p "$DISABLED" "$FIRE_DIR" "$WOLV_DIR"

echo "=== 1) Désactiver les confs nginx en doublon qui contiennent /wolverine (sauf le vhost KEEP) ==="
mapfile -t FILES < <(grep -RIl -E 'location\s+\^~\s+/wolverine/|location\s*=\s*/wolverine' \
  /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | sort -u || true)

for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  if [ "$f" != "$NG_KEEP" ]; then
    base="$(basename "$f")"
    echo "MOVE DUP: $f -> $DISABLED/$base.$TS"
    mv "$f" "$DISABLED/$base.$TS"
  else
    echo "KEEP: $f"
  fi
done

echo "=== 2) Réécrire le mapping UI proprement (/wolverine AVANT /) ==="
cp -a "$NG_KEEP" "$NG_KEEP.bak.demele.$TS"

python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# Remove UI blocks for / and /wolverine (but do NOT touch anything about /wolverine/traderone/api)
patterns = [
  r'\n\s*#\s*---\s*WOLVERINE UI[\s\S]*?location\s+\^~\s+/wolverine/[\s\S]*?\n\s*\}\s*',
  r'\n\s*#\s*---\s*ROOT UI[\s\S]*?location\s+\^~\s+/\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/\s*\{[\s\S]*?\n\s*\}\s*',
]
for pat in patterns:
  s = re.sub(pat, "\n", s, flags=re.M)

block = r'''
# --- WOLVERINE UI ---
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}

# --- ROOT UI (FIREINNERS) ---
location = / { return 301 /; }
location ^~ / {
  root /var/www/fireinners;
  index index.html;
  try_files $uri $uri/ /index.html;
  add_header Cache-Control "no-store" always;
}
'''

i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: nginx conf invalide (pas de } final)")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: mapping écrit")
PY

echo "=== 3) Test + reload nginx ==="
nginx -t
systemctl reload nginx

echo "=== 4) Preuves (HTML title) ==="
echo "--- /wolverine title ---"
curl -sS -H "Cache-Control: no-cache" https://fireinners.online/wolverine/ | grep -iE "<title>|wolverine|fireinners" | head -n 20 || true
echo
echo "--- / title ---"
curl -sS -H "Cache-Control: no-cache" https://fireinners.online/ | grep -iE "<title>|wolverine|fireinners" | head -n 20 || true
echo
echo "--- API health ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12
echo "DONE ✅"
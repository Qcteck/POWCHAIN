bash -lc 'set -euo pipefail
INC="/etc/nginx/includes/wolverine_routes.inc"
TS="$(date +%Y%m%d_%H%M%S)"
cp -a "$INC" "${INC}.bak_${TS}" || true
chattr -i "$INC" 2>/dev/null || true

# ajoute un redirect propre pour /wolverine/traderone/api -> /wolverine/traderone/api/
if ! grep -q "location = /wolverine/traderone/api" "$INC"; then
  perl -0777 -i -pe "s/# AUTO-GENERATED - Wolverine static \\+ TraderOne API proxy/# AUTO-GENERATED - Wolverine static + TraderOne API proxy\\nlocation = \\/wolverine\\/traderone\\/api { return 301 \\/wolverine\\/traderone\\/api\\/; }/s" "$INC" || true
fi

nginx -t
systemctl reload nginx || systemctl restart nginx

echo \"== TEST public api ==\"
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 20 || true
echo DONE'
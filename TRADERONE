cat >/root/force_phantom_visible.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INDEX="/var/www/wolverine/index.html"
[[ -f "$INDEX" ]] || { echo "[ERR] $INDEX introuvable"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$INDEX" "${INDEX}.bak_${ts}"
echo "[OK] Backup -> ${INDEX}.bak_${ts}"

# retire tous anciens patches phantom
perl -0777 -i -pe '
s/<!-- PHANTOM_CONNECT_PATCH -->.*?<!-- \/PHANTOM_CONNECT_PATCH -->\s*//msi;
s/<!-- PHANTOM_BALANCE_PATCH -->.*?<!-- \/PHANTOM_BALANCE_PATCH -->\s*//msi;
s/<!-- PHANTOM_ONCLICK_PATCH -->.*?<!-- \/PHANTOM_ONCLICK_PATCH -->\s*//msi;
s/<!-- PHANTOM_SAFE_PATCH -->.*?<!-- \/PHANTOM_SAFE_PATCH -->\s*//msi;
s/<!-- PHANTOM_EXTERNAL_PATCH -->.*?<!-- \/PHANTOM_EXTERNAL_PATCH -->\s*//msi;
' "$INDEX"

# inject patch "visible" (preuve + hook observer)
perl -0777 -i -pe '
my $js = qq{
<!-- PHANTOM_SAFE_PATCH -->
<script>
(function(){
  window.__PHANTOM_PATCH_LOADED__ = true;

  function ensureOverlay(){
    let box = document.getElementById("__phantom_overlay");
    if(box) return box;
    box = document.createElement("div");
    box.id="__phantom_overlay";
    box.style.cssText="position:fixed;right:16px;bottom:16px;z-index:99999;background:rgba(0,0,0,.85);color:#fff;padding:10px 12px;border-radius:10px;font:12px/1.2 system-ui;max-width:60vw";
    document.body.appendChild(box);
    return box;
  }
  function setMsg(msg){
    const box = ensureOverlay();
    box.textContent = msg;
  }
  function short(pk){ return pk.slice(0,4)+"…"+pk.slice(-4); }

  async function connectPhantom(){
    if(!window.solana || !window.solana.isPhantom){
      setMsg("PATCH LOADED — Phantom introuvable (extension)");
      return;
    }
    const r = await window.solana.connect();
    const pk = r.publicKey.toBase58();
    window.__WALLET_PK__ = pk;
    setMsg("Connected: " + short(pk));
  }

  function findConnectEl(){
    // bouton exact walletBox, sinon n’importe quel button/a avec le texte
    const direct = document.querySelector(".walletBox .btn.ghost");
    if(direct) return direct;

    const nodes = Array.from(document.querySelectorAll("button,a,div,span"));
    return nodes.find(n => /connect phantom/i.test((n.textContent||"").trim()));
  }

  function hook(){
    const el = findConnectEl();
    if(el && !el.__phantom_hooked){
      el.__phantom_hooked = true;
      el.addEventListener("click", function(ev){
        ev.preventDefault();
        connectPhantom().catch(e => setMsg("Connect error: " + String(e?.message||e)));
      }, { passive:false });
      setMsg("PATCH LOADED — Hook OK (click Connect Phantom)");
    }
  }

  window.addEventListener("load", function(){
    setMsg("PATCH LOADED — searching button…");
    hook();
    const obs = new MutationObserver(()=>hook());
    obs.observe(document.documentElement, { childList:true, subtree:true });

    // si déjà connecté
    if(window.solana?.isPhantom && window.solana.publicKey){
      setMsg("Connected: " + short(window.solana.publicKey.toBase58()));
    }
  });
})();
</script>
<!-- /PHANTOM_SAFE_PATCH -->
};
s@</body>@$js\n</body>@i or die "ERR: </body> introuvable\n";
' "$INDEX"

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
echo "✅ Ouvre: https://fireinners.online/wolverine/?v=$ts"
BASH

chmod +x /root/force_phantom_visible.sh
/root/force_phantom_visible.sh
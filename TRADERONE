cat >/root/MEGA_FIX_AQUILATRADER_ROUTES_GHOST.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_NGINX_AQUILA_GHOST_$TS"
mkdir -p "$BK"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

INC_DIR="/etc/nginx/includes"
GHOST="$INC_DIR/aquilatrader_routes.inc"
CANON="$INC_DIR/aquilatrader.inc"
WWW="/var/www/aquilatrader"
IDX="$WWW/index.html"

say "Backup /etc/nginx (full)..."
cp -a /etc/nginx "$BK/etc_nginx" 2>/dev/null || true

say "Unfreeze nginx files (best effort)..."
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i /etc/nginx/sites-available/* 2>/dev/null || true
chattr -i /etc/nginx/sites-enabled/* 2>/dev/null || true
chattr -i /etc/nginx/conf.d/* 2>/dev/null || true
chattr -i /etc/nginx/includes/*.inc 2>/dev/null || true

say "Ensure /etc/nginx/includes exists..."
mkdir -p "$INC_DIR"

say "1) Create the missing include file (hard stop for 'No such file' forever)..."
cat >"$GHOST" <<'NGINX'
# AQUILATRADER_ROUTES_GHOST_FILE
# This file exists to prevent nginx failing on missing include.
# Real routing is in /etc/nginx/includes/aquilatrader.inc
NGINX
chmod 0644 "$GHOST" || true

say "2) Purge any reference to aquilatrader_routes.inc across ALL nginx configs..."
# Remove every line containing aquilatrader_routes.inc anywhere under /etc/nginx
# (sites-available, sites-enabled, nginx.conf, includes, conf.d, snippets, etc.)
grep -RIl --exclude-dir='.git' 'aquilatrader_routes\.inc' /etc/nginx 2>/dev/null | while read -r f; do
  sed -i '\|aquilatrader_routes\.inc|d' "$f" || true
done

say "Ensure AquilaTrader canonical route include exists..."
if [ ! -f "$CANON" ]; then
  cat >"$CANON" <<'NGINX'
# AQUILATRADER_CANONICAL_FINAL
location = /aquilatrader { return 301 /aquilatrader/; }
location ^~ /aquilatrader/ {
    alias /var/www/aquilatrader/;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store" always;
}
NGINX
  chmod 0644 "$CANON" || true
fi

say "Ensure /var/www/aquilatrader exists with an index.html..."
mkdir -p "$WWW"
if [ ! -f "$IDX" ]; then
  cat >"$IDX" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaTrader</title></head><body style="margin:0;font-family:system-ui;background:#070a10;color:#d7e3ff;display:flex;min-height:100vh;align-items:center;justify-content:center"><div><h1 style="margin:0 0 8px">AquilaTrader</h1><div style="opacity:.75">Route /aquilatrader/ en service.</div></div></body></html>
HTML
  chmod 0644 "$IDX" || true
fi
chown -R www-data:www-data "$WWW" 2>/dev/null || true

say "Ensure vhost includes aquilatrader.inc (inject into fireinners.online-ssl if present)..."
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
if [ -f "$VHOST" ]; then
  grep -q "include /etc/nginx/includes/aquilatrader.inc;" "$VHOST" 2>/dev/null || \
  sed -i '/server\s*{/a\    include /etc/nginx/includes/aquilatrader.inc;' "$VHOST"
fi

say "Test + reload nginx..."
nginx -t
systemctl reload nginx

say "Refreeze core files (best effort)..."
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
[ -f "$VHOST" ] && chattr +i "$VHOST" 2>/dev/null || true

say "DONE. AquilaTrader should be reachable at: https://fireinners.online/aquilatrader/"
say "Backup: $BK"
BASH

chmod +x /root/MEGA_FIX_AQUILATRADER_ROUTES_GHOST.sh
bash /root/MEGA_FIX_AQUILATRADER_ROUTES_GHOST.sh |& tee /root/MEGA_FIX_AQUILATRADER_ROUTES_GHOST.log
cat >/root/MEGA_NDJSON_ROUTE_HARDPATCH_V3.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }

INC_DIR="/etc/nginx/includes"
INC="$INC_DIR/ndjson_fireinners.inc"
WWW_UI="/var/www/ndjson"
WWW_DATA="/var/www/ndjson_data"
TEST_ND="$WWW_DATA/events.ndjson"
BK="/root/BK_NDJSON_V3_${TS}"

say "Backup -> $BK"
mkdir -p "$BK"
cp -a /etc/nginx/nginx.conf "$BK/nginx.conf" 2>/dev/null || true
cp -a "$INC_DIR" "$BK/includes" 2>/dev/null || true
cp -a /etc/nginx/sites-available "$BK/sites-available" 2>/dev/null || true
cp -a /etc/nginx/sites-enabled "$BK/sites-enabled" 2>/dev/null || true

say "Unfreeze nginx (best-effort chattr -i)"
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i /etc/nginx/sites-available/* 2>/dev/null || true
chattr -i /etc/nginx/sites-enabled/* 2>/dev/null || true
chattr -i "$INC_DIR"/*.inc 2>/dev/null || true

say "Prepare dirs/files"
mkdir -p "$INC_DIR" "$WWW_UI" "$WWW_DATA"
chmod 755 "$WWW_UI" "$WWW_DATA"

if [ ! -s "$WWW_UI/index.html" ]; then
  cat >"$WWW_UI/index.html" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NDJSON</title></head><body style="margin:0;background:#0b0f14;color:#e7eef7;font:14px system-ui"><div style="max-width:900px;margin:40px auto;padding:16px;border:1px solid #1e2a3f;border-radius:12px;background:#0f1520"><h2 style="margin:0 0 8px">NDJSON Viewer</h2><p style="margin:0 0 12px;opacity:.8">URL NDJSON: <code>/data/events.ndjson</code></p><p style="margin:0">Si tu vois cette page, /ndjson/ est servi correctement ✅</p></div></body></html>
HTML
fi

touch "$TEST_ND"
if [ ! -s "$TEST_ND" ]; then
  printf '{"ts":"%s","src":"ndjson","event":"init","ok":true}\n' "$(date -Is)" >>"$TEST_ND"
fi
chmod 644 "$TEST_ND" || true

say "Write include: $INC"
cat >"$INC" <<'NGINX'
# --- NDJSON UI + DATA (Fireinners) ---
location = /ndjson { return 301 /ndjson/; }
location = /data  { return 301 /data/; }

location ^~ /ndjson/ {
  alias /var/www/ndjson/;
  index index.html;
  try_files $uri $uri/ /ndjson/index.html;
  add_header Cache-Control "no-store" always;
}

location ^~ /data/ {
  alias /var/www/ndjson_data/;
  add_header Cache-Control "no-store" always;
  autoindex off;
}
NGINX
chmod 644 "$INC"

say "Find ACTIVE HTTPS vhosts for fireinners.online"
mapfile -t CANDS < <(
  grep -RIl --include='*' -E 'server_name[^;]*fireinners\.online' /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null \
  | sort -u
)
[ "${#CANDS[@]}" -gt 0 ] || die "Aucun fichier nginx avec server_name fireinners.online trouvé."

# garde seulement ceux qui ont listen 443 (ssl ou http2) OU ceux de sites-enabled (priorité)
TARGETS=()
for f in "${CANDS[@]}"; do
  if grep -Eq 'listen[[:space:]]+443' "$f"; then
    TARGETS+=("$f")
  fi
done
if [ "${#TARGETS[@]}" -eq 0 ]; then
  # fallback: patch tout ce qui match server_name
  TARGETS=("${CANDS[@]}")
fi

say "Targets:"
for f in "${TARGETS[@]}"; do echo " - $f"; done

say "Inject include into each target server{} (idempotent)"
for f in "${TARGETS[@]}"; do
  # remove any old include line
  sed -i '\|include[[:space:]]\+etc/nginx/includes/ndjson_fireinners\.inc;|d' "$f" || true

  # inject after first 'server {' occurrence
  awk -v inc="    include etc/nginx/includes/ndjson_fireinners.inc;" '
  BEGIN{done=0}
  {print}
  (!done && $0 ~ /^[[:space:]]*server[[:space:]]*\{[[:space:]]*$/){ print inc; done=1 }
  END{ if(!done) exit 3 }' "$f" >"$f.tmp" || die "Injection échouée dans $f"
  mv "$f.tmp" "$f"
done

say "Test + reload nginx"
nginx -t
systemctl reload nginx

say "Quick tests (origin, bypass Cloudflare using --resolve)"
# --resolve force DNS to 127.0.0.1 locally (origin direct), so we know nginx routing is correct
echo "== ORIGIN /ndjson (should be 301) =="
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/ndjson | head -n 20 || true
echo "== ORIGIN /ndjson/ (should be 200) =="
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/ndjson/ | head -n 20 || true
echo "== ORIGIN /data/events.ndjson (should output JSON line) =="
curl -sk --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/data/events.ndjson | head -n 3 || true

say "Refreeze nginx (best-effort chattr +i)"
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i /etc/nginx/sites-available/* 2>/dev/null || true
chattr +i /etc/nginx/sites-enabled/* 2>/dev/null || true

say "DONE."
say "UI:   https://fireinners.online/ndjson/"
say "DATA: https://fireinners.online/data/events.ndjson"
say "Backup: $BK"
BASH

bash /root/MEGA_NDJSON_ROUTE_HARDPATCH_V3.sh |& tee /root/MEGA_NDJSON_ROUTE_HARDPATCH_V3.log
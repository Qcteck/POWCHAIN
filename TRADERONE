cat >/root/AIAQUILA_FIX_IMMUTABLE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SITE="fireinners.online"
VHOST="/etc/nginx/sites-available/$SITE"
SNIP="/etc/nginx/snippets/aiaquila_rss.conf"
WEBROOT="/var/www/fireinners.online/aiaquila"
INDEX="$WEBROOT/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== AIAQUILA FIX (IMMUTABLE SAFE MODE) ==="

### 1) Detect immutable
echo "[1/7] Checking immutable flag"
IMMUTABLE=0
if lsattr "$VHOST" | grep -q '\-i\-'; then
  IMMUTABLE=1
  echo "→ Immutable detected, unlocking"
  chattr -i "$VHOST"
fi

### 2) Backup vhost + frontend
echo "[2/7] Backup"
cp -a "$VHOST" "$VHOST.backup.$TS"
cp -a "$INDEX" "$INDEX.backup.$TS"

### 3) Write nginx snippet (VALID CONTEXT ONLY)
echo "[3/7] Write nginx snippet"
cat >"$SNIP" <<'NGX'
location /aiaquila/api/rss {
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    proxy_pass https://news.bitcoin.com/feed/;
    proxy_set_header Host news.bitcoin.com;
    proxy_set_header User-Agent "AIAQUILA-RSS";
    proxy_ssl_server_name on;

    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}

location /aiaquila/health {
    default_type text/plain;
    return 200 "OK AIAQUILA\n";
}
NGX

### 4) Inject include ONCE
echo "[4/7] Inject include into server block"
if ! grep -q "aiaquila_rss.conf" "$VHOST"; then
  awk '
  /server_name/ && !done {
    print;
    print "    include /etc/nginx/snippets/aiaquila_rss.conf;";
    done=1; next
  }
  {print}
  ' "$VHOST" >"/tmp/$SITE.$TS"
  cp "/tmp/$SITE.$TS" "$VHOST"
fi

### 5) Rewrite frontend (LOCAL API ONLY)
echo "[5/7] Rewrite frontend"
cat >"$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel (FORCÉ)</title>
<style>
body{margin:0;padding:20px;background:#0b1b3a;color:#fff;font-family:system-ui}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px;color:#cfe}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (FORCÉ)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
<script>
async function load(){
  const o=document.getElementById("out");
  o.textContent="Chargement…";
  try{
    const r=await fetch("/aiaquila/api/rss",{cache:"no-store"});
    if(!r.ok) throw r.status;
    const t=await r.text();
    const x=new DOMParser().parseFromString(t,"text/xml");
    const items=[...x.querySelectorAll("item")].slice(0,20);
    o.textContent=items.map(i=>
      (i.querySelector("title")?.textContent||"")+"\n"+
      (i.querySelector("link")?.textContent||"")
    ).join("\n\n");
  }catch(e){
    o.textContent="ERREUR: "+e;
  }
}
</script>
</body>
</html>
HTML

### 6) Test + reload nginx
echo "[6/7] nginx test"
nginx -t
systemctl reload nginx

### 7) Restore immutable
if [ "$IMMUTABLE" = "1" ]; then
  echo "[7/7] Restoring immutable flag"
  chattr +i "$VHOST"
fi

echo "=== DONE ==="
echo "Health: https://$SITE/aiaquila/health"
echo "RSS   : https://$SITE/aiaquila/api/rss"
echo "UI    : https://$SITE/aiaquila/"
BASH

chmod +x /root/AIAQUILA_FIX_IMMUTABLE.sh
/root/AIAQUILA_FIX_IMMUTABLE.sh
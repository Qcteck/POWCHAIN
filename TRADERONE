cat >/root/WOLVERINE_FULL_AUTO_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE FULL AUTO FIX START ==="

# VARS
APP_DIR="/opt/wolverine/solana-proxy"
PORT=3010
SERVICE="wolverine-solana-proxy"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
HTML="/var/www/wolverine/index.html"
RPC_PATH="/rpc/solana"
RPC_REAL="https://api.mainnet-beta.solana.com"
TS=$(date +%Y%m%d_%H%M%S)

# 1) Node check
command -v node >/dev/null || { echo "❌ Node missing"; exit 1; }
echo "Node OK: $(node -v)"

# 2) Install proxy
mkdir -p "$APP_DIR"
cd "$APP_DIR"

cat > package.json <<'JSON'
{
  "name": "wolverine-solana-proxy",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "express": "^4.19.2",
    "node-fetch": "^3.3.2"
  }
}
JSON

cat > server.js <<'JS'
import express from "express";
import fetch from "node-fetch";

const app = express();
app.use(express.json());

const RPC = "https://api.mainnet-beta.solana.com";

app.post("/rpc/solana", async (req, res) => {
  try {
    const r = await fetch(RPC, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(req.body)
    });
    const j = await r.json();
    res.json(j);
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

app.listen(3010, () => console.log("Solana proxy on 3010"));
JS

npm install --silent

# 3) systemd
cat >/etc/systemd/system/$SERVICE.service <<EOF
[Unit]
Description=Wolverine Solana RPC Proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=$APP_DIR
ExecStart=/usr/bin/node server.js
Restart=always
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now $SERVICE

# 4) nginx route
if ! grep -q "location $RPC_PATH" "$VHOST"; then
cat >>"$VHOST" <<NGINX

    location $RPC_PATH {
        proxy_pass http://127.0.0.1:$PORT$RPC_PATH;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
    }
NGINX
fi

nginx -t
systemctl reload nginx

# 5) frontend fix
cp "$HTML" "$HTML.bak_fullfix_$TS"
sed -i "s|$RPC_REAL|$RPC_PATH|g" "$HTML"
sed -i 's|(bal.value/1e9)|((bal&&bal.value)?(bal.value\/1e9):0)|g' "$HTML"

# 6) checks
echo
echo "=== CHECKS ==="
systemctl is-active $SERVICE
ss -ltnp | grep ":$PORT" >/dev/null && echo "Port $PORT OK"
curl -s -X POST http://127.0.0.1:$PORT$RPC_PATH \
  -H "Content-Type: application/json" \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}'
echo

echo "=== DONE ==="
echo "➡️  HARD REFRESH BROWSER (CTRL+SHIFT+R)"
echo "➡️  CONNECT PHANTOM"
echo "➡️  SOLDES DOIVENT S’AFFICHER"
BASH

chmod +x /root/WOLVERINE_FULL_AUTO_FIX.sh
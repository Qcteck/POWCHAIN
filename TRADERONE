cat >/root/AIAQUILA_FIX_PHANTOM_IMPORT.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

APP_NAME="aiaquila"
WEB_ROOT="/var/www/${APP_NAME}"

mkdir -p "$WEB_ROOT"

cat >"${WEB_ROOT}/index.html"<<'HTML'
<!DOCTYPE html><html lang="fr"><head>
<meta charset="utf-8">
<title>AIAQUILA • Phantom FIX</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
html,body{margin:0;padding:0;background:#05070b;color:#e6ebff;font-family:system-ui}
#app{display:grid;grid-template-columns:340px 1fr;height:100vh}
aside{background:#0a0f1c;border-right:1px solid #1b2450;padding:14px}
main{padding:14px}
button,input,textarea{background:#0e1633;color:#e6ebff;border:1px solid #2b3cff;padding:6px;border-radius:4px}
button{cursor:pointer}.ok{border-color:#3cff9e}.warn{border-color:#ff4d4d}
.card{border:1px solid #1b2450;border-radius:6px;padding:10px;margin-bottom:10px;background:#070c18}
.log{font-family:ui-monospace,monospace;font-size:12px;white-space:pre-wrap}
</style>
</head><body>

<div id="app">
<aside>
<div class="card"><b>Wallet</b><div id="wallet">Déconnecté</div><button id="connect" class="ok">CONNECT PHANTOM</button></div>
<div class="card"><b>Destination</b><input id="dest"></div>
<div class="card"><b>Montant</b><input id="amount" placeholder="SOL (0.001) ou lamports (1000000)"></div>
<div class="card"><button id="arm" class="ok">ARM</button><button id="disarm" class="warn">DISARM</button></div>
<div class="card"><button id="propose">PROPOSE</button><button id="sign" class="ok">APPROUVER & SIGNER</button></div>
<div class="card"><b>Policy JSON</b><textarea id="policy" rows="6"></textarea></div>
</aside>
<main><div class="card"><b>Console</b><div id="log" class="log"></div></div></main>
</div>

<!-- ✅ BON IMPORT -->
<script src="https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js"></script>

<script>
const { Connection, PublicKey, Transaction, SystemProgram } = solanaWeb3;
const RPC="https://api.mainnet-beta.solana.com";
const LAMPORTS_PER_SOL=1_000_000_000;
const $=i=>document.getElementById(i);
const log=t=>$("log").textContent+=t+"\\n";

function parseAmount(v){
 v=Number(v);
 if(!Number.isFinite(v)||v<=0)throw Error("Montant invalide");
 if(v<1)return Math.round(v*LAMPORTS_PER_SOL);
 if(Number.isInteger(v))return v;
 return Math.round(v*LAMPORTS_PER_SOL);
}

let wallet=null,pub=null,armed=false,pending=null;

$("policy").value=JSON.stringify({
 allowDests:{},
 maxLamportsPerTx:1000000
},null,2);

$("connect").onclick=async()=>{
 if(!window.solana) return alert("Phantom non détecté");
 wallet=window.solana;
 const r=await wallet.connect();
 pub=r.publicKey.toString();
 $("wallet").textContent=pub;
 log("Wallet connecté");
};

$("arm").onclick=()=>{armed=true;log("ARM ON");};
$("disarm").onclick=()=>{armed=false;log("ARM OFF");};

$("propose").onclick=()=>{
 if(!armed)return log("ERR ARM requis");
 const policy=JSON.parse($("policy").value);
 const dest=$("dest").value.trim();
 const lamports=parseAmount($("amount").value);
 if(!policy.allowDests[dest])return log("ERR dest non allowlist");
 pending={dest,lamports};
 log("Pending OK: "+lamports+" lamports");
};

$("sign").onclick=async()=>{
 if(!pending||!wallet)return log("ERR rien à signer");
 const conn=new Connection(RPC,"confirmed");
 const tx=new Transaction().add(SystemProgram.transfer({
  fromPubkey:new PublicKey(pub),
  toPubkey:new PublicKey(pending.dest),
  lamports:pending.lamports
 }));
 tx.feePayer=new PublicKey(pub);
 tx.recentBlockhash=(await conn.getLatestBlockhash()).blockhash;
 const signed=await wallet.signTransaction(tx);
 const sig=await conn.sendRawTransaction(signed.serialize());
 await conn.confirmTransaction(sig);
 log("TX OK: "+sig);
 pending=null;
};
</script>
</body></html>
HTML

nginx -t && systemctl reload nginx
echo "OK → https://fireinners.online/aiaquila/"
EOF
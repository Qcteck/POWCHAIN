}
function CreateToken(){
  const [apiKey,setApiKey]=useState("");
  const [rpc,setRpc]=useState("");
  const [decimals,setDecimals]=useState("6");
  const [supply,setSupply]=useState("1000000");
  const [owner,setOwner]=useState("");
  const [mint,setMint]=useState("");
  const [preflightOnly,setPreflightOnly]=useState(false);
  const [revokeMintAuth,setRevokeMintAuth]=useState(false);
  const [revokeFreezeAuth,setRevokeFreezeAuth]=useState(true);
  const [out,setOut]=useState(null);
  const [st,setSt]=useState("idle");
  async function go(){
    setSt("sending"); setOut(null);
    const body={apiKey,rpc:rpc||undefined,decimals:parseInt(decimals,10),supply,owner:owner||undefined,mint:mint||undefined,preflightOnly,revokeMintAuth,revokeFreezeAuth};
    const r=await fetch("/bundler/api/create-token",{method:"POST",headers:{"content-type":"application/json","x-api-key":apiKey||""},body:JSON.stringify(body)});
    const jsn=await r.json().catch(()=>({ok:false,error:{code:"BAD_JSON",message:"bad response"}}));
    setOut(jsn); setSt(r.ok?"ok":"error");
  }
  return (
    <div className="card">
      <div className="row">
        <div className="grow">
          <b>Créer un token (SPL)</b>
          <div className="muted">API: /bundler/api/create-token</div>
        </div>
        <span className={"pill "+(st==="ok"?"ok":st==="error"?"bad":"")}>{st}</span>
      </div>
      <div className="grid" style={{marginTop:10}}>
        <div className="card">
          <div className="muted">API Key</div>
          <input value={apiKey} onChange={e=>setApiKey(e.target.value)} placeholder="BUNDLER_API_KEY" />
          <div className="muted" style={{marginTop:10}}>RPC (optionnel)</div>
          <input value={rpc} onChange={e=>setRpc(e.target.value)} placeholder="https://..." />
          <div className="row" style={{marginTop:10}}>
            <div className="grow">
              <div className="muted">Decimals</div>
              <input value={decimals} onChange={e=>setDecimals(e.target.value)} />
            </div>
            <div className="grow">
              <div className="muted">Supply (humain)</div>
              <input value={supply} onChange={e=>setSupply(e.target.value)} />
            </div>
          </div>
          <div className="muted" style={{marginTop:10}}>OWNER (optionnel)</div>
          <input value={owner} onChange={e=>setOwner(e.target.value)} placeholder="Adresse owner (sinon payer)" />
          <div className="muted" style={{marginTop:10}}>MINT_ADDRESS (optionnel, reuse)</div>
          <input value={mint} onChange={e=>setMint(e.target.value)} placeholder="Adresse mint existant (sinon create)" />
          <div className="row" style={{marginTop:10}}>
            <label className="pill"><input type="checkbox" checked={preflightOnly} onChange={e=>setPreflightOnly(e.target.checked)} /> PREFLIGHT_ONLY</label>
            <label className="pill"><input type="checkbox" checked={revokeMintAuth} onChange={e=>setRevokeMintAuth(e.target.checked)} /> REVOKE_MINT_AUTH</label>
            <label className="pill"><input type="checkbox" checked={revokeFreezeAuth} onChange={e=>setRevokeFreezeAuth(e.target.checked)} /> REVOKE_FREEZE_AUTH</label>
          </div>
          <div className="row" style={{marginTop:10}}>
            <button onClick={()=>go().catch(e=>{setSt("error");setOut({ok:false,error:{code:"CLIENT_ERR",message:String(e?.message||e)}})})}>Créer le token</button>
          </div>
        </div>
        <div className="card">
          <b>Réponse</b>
          <div className="mono" style={{marginTop:10}}>{out?j(out):"—"}</div>
        </div>
      </div>
    </div>
  );
}
export default function App(){

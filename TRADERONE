set -euo pipefail

APP="/var/www/fireinners/wolverine"
PAGE="$APP/index.html"

echo "=== Backup ==="
cp "$PAGE" "$PAGE.bak.$(date +%s)"

echo "=== Nettoyage du nom ==="
sed -i 's/TraderOne//g' "$PAGE"
sed -i 's/— Dashboard//g' "$PAGE"

echo "=== Ajout Chart.js si absent ==="
grep -q "chart.js" "$PAGE" || sed -i '/<\/head>/i\<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>' "$PAGE"

echo "=== Insertion du bloc graphique ==="
if ! grep -q "wolverine-chart" "$PAGE"; then
  sed -i '/<div class="content">/a\
<div style="width:100%;max-width:900px;margin:20px auto;">\
<canvas id="wolverine-chart" height="120"></canvas>\
</div>\
<script>\
const ctx = document.getElementById("wolverine-chart");\
new Chart(ctx,{\
 type:"line",\
 data:{\
  labels:["t-5","t-4","t-3","t-2","t-1","now"],\
  datasets:[{label:"PnL",data:[1,2,1.5,2.5,3,3.4],borderColor:"#4cafef",tension:0.3}]\
 },\
 options:{responsive:true,plugins:{legend:{display:true}}}\
});\
</script>' "$PAGE"
fi

echo "=== Permissions ==="
chown -R www-data:www-data "$APP"
chmod -R a+rX "$APP"

echo "=== Reload nginx ==="
nginx -t && systemctl reload nginx

echo "DONE."
set -euo pipefail
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

# Supprime ancien bloc si déjà ajouté
perl -0777 -i -pe 's|/\*\s*WOLVERINE_FORCE_USER_UI_BEGIN\s*\*/.*?/\*\s*WOLVERINE_FORCE_USER_UI_END\s*\*/\s*||sg' "$APPJS" || true

cat >> "$APPJS" <<'JS'

/* WOLVERINE_FORCE_USER_UI_BEGIN */
(function(){
  // Override refreshBoth pour MAJ DOM directement (sans dépendre de el.uSol/el.uUsdc)
  const old = window.refreshBoth;
  window.refreshBoth = async function(){
    try {
      if (old) await old();
    } catch(e) {
      console.warn("old refreshBoth failed:", e);
    }

    try {
      if (!window.pubkey) return;

      const r = await fetch(`/wolverine/traderone/api/balances2?wallet=${encodeURIComponent(window.pubkey.toString())}`);
      const txt = await r.text();
      if (!r.ok) throw new Error("balances2 user HTTP " + r.status + " " + txt.slice(0,160));
      const j = JSON.parse(txt);

      const sol  = Number(j?.user?.sol  ?? j?.sol  ?? 0);
      const usdc = Number(j?.user?.usdc ?? j?.usdc ?? 0);

      const uSol  = document.getElementById("uSol");
      const uUsdc = document.getElementById("uUsdc");
      if (uSol)  uSol.textContent  = isFinite(sol)  ? sol.toFixed(6)  : "0.000000";
      if (uUsdc) uUsdc.textContent = isFinite(usdc) ? usdc.toFixed(4) : "0.0000";

      (window.setStatus||console.log)("OK (user forced)");
    } catch(e) {
      console.error(e);
      (window.setStatus||console.log)("ERR user forced: " + (e?.message||e));
    }
  };
})();
 /* WOLVERINE_FORCE_USER_UI_END */

JS

echo "OK ✅ -> Ctrl+F5 sur /wolverine puis Connect + clique Refresh soldes"
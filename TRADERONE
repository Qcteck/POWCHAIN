set -euo pipefail

REPO_SSH="git@github.com:Qcteck/WOLVERINE.git"
CLONE_DIR="/opt/fireinners/WOLVERINE_REPO"
KEY="/root/.ssh/id_ed25519_wolverine"

apt-get update -y
apt-get install -y git openssh-client

mkdir -p /root/.ssh
chmod 700 /root/.ssh

# 1) Crée une clé SSH dédiée (si pas déjà là)
if [ ! -f "$KEY" ]; then
  ssh-keygen -t ed25519 -N "" -f "$KEY" -C "wolverine-vps"
fi

# 2) Ajoute GitHub au known_hosts
ssh-keyscan -H github.com >> /root/.ssh/known_hosts 2>/dev/null || true
chmod 600 /root/.ssh/known_hosts

echo
echo "=== ✅ COPIE CETTE CLÉ PUBLIQUE DANS GITHUB (Deploy key) ==="
cat "${KEY}.pub"
echo "=== FIN ==="
echo

echo "Ensuite: GitHub repo -> Settings -> Deploy keys -> Add deploy key -> coche 'Allow write access' si tu veux push."
echo "Quand c'est fait, rerun ce batch (même commande)."

# 3) Test SSH (va échouer tant que la clé est pas ajoutée)
ssh -i "$KEY" -o IdentitiesOnly=yes -T git@github.com || true

# 4) Clone/Pull en SSH
if [ ! -d "$CLONE_DIR/.git" ]; then
  rm -rf "$CLONE_DIR" 2>/dev/null || true
  GIT_SSH_COMMAND="ssh -i $KEY -o IdentitiesOnly=yes" git clone "$REPO_SSH" "$CLONE_DIR"
else
  cd "$CLONE_DIR"
  GIT_SSH_COMMAND="ssh -i $KEY -o IdentitiesOnly=yes" git fetch --all --prune
  git checkout main 2>/dev/null || git checkout master 2>/dev/null || true
  git pull --ff-only || true
fi

echo "CLONE OK ✅ -> $CLONE_DIR"
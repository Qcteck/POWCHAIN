bash <<'EOF'
set -euo pipefail

WEB="/var/www/aiaquila"
HTML="$WEB/index.html"
PROXY="https://aiaquila-proxy.paycashnostory.workers.dev"

echo "== AIAQUILA RSS + PREFERENCES + CONSEILS =="

mkdir -p "$WEB"

cat > "$HTML" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{margin:0;background:#05070a;color:#e6e6e6;font-family:system-ui}
header{padding:14px 20px;background:#0b0f1a;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{max-width:1200px;margin:auto;padding:20px}
.panel{background:#0e1424;border:1px solid #1f2937;border-radius:8px;padding:14px;margin-bottom:14px}
h2{margin:0 0 8px 0;color:#9cc9ff;font-size:16px}
button,select,input{background:#1e40af;color:#fff;border:none;padding:8px 12px;border-radius:6px;cursor:pointer;margin-right:6px}
button.secondary{background:#374151}
input[type=text]{width:60%;background:#000;border:1px solid #333}
.small{font-size:13px;color:#9cc9ff}
.article{border-top:1px solid #1f2937;padding-top:8px;margin-top:8px}
.chat{max-height:200px;overflow:auto}
.msg{margin-bottom:6px}
.me{color:#7dd3fc}
.ai{color:#a7f3d0}
pre{background:#000;padding:10px;border-radius:6px;max-height:200px;overflow:auto}
</style>
</head>

<body>
<header>
  <strong>AIAQUILA</strong>
  <span id="status" class="small">RSS + Mémoire actifs</span>
</header>

<main>

<div class="panel">
  <h2>Préférences utilisateur</h2>
  <input id="prefCrypto" placeholder="Crypto préférée (ex: Bitcoin)">
  <button onclick="savePref()">Sauver</button>
  <div id="prefView" class="small"></div>
</div>

<div class="panel">
  <h2>Flux RSS (réels)</h2>
  <button onclick="loadRSS()">🔄 Charger les articles</button>
  <div id="articles"></div>
</div>

<div class="panel">
  <h2>Conseils crypto (issus des articles)</h2>
  <div id="advice"></div>
</div>

<div class="panel">
  <h2>Discussion</h2>
  <div id="chat" class="chat"></div>
  <input id="userInput" placeholder="Écris ton avis…">
  <button onclick="sendUser()">Envoyer</button>
</div>

<div class="panel">
  <h2>Logs</h2>
  <pre id="logs"></pre>
</div>

</main>

<script>
/* =====================
   ÉTAT & MÉMOIRE
===================== */
const PROXY="https://aiaquila-proxy.paycashnostory.workers.dev";
const RSS=[
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://www.coingecko.com/rss/news"
];

let S=JSON.parse(localStorage.getItem("aiaquila_state_rss")||'{"logs":[],"chat":[],"pref":{}}');

function save(){localStorage.setItem("aiaquila_state_rss",JSON.stringify(S));}
function log(m){S.logs.push(m);S.logs=S.logs.slice(-200);save();render();}
function chat(w,t){S.chat.push({w,t});S.chat=S.chat.slice(-200);save();render();}

/* =====================
   PRÉFÉRENCES
===================== */
function savePref(){
  const v=document.getElementById("prefCrypto").value.trim();
  if(!v)return;
  S.pref.crypto=v;
  log("Préférence crypto: "+v);
  render();
}
function showPref(){
  document.getElementById("prefView").innerText=
    S.pref.crypto ? "Crypto préférée: "+S.pref.crypto : "Aucune préférence enregistrée";
}

/* =====================
   RSS RÉELS
===================== */
async function loadRSS(){
  document.getElementById("articles").innerHTML="Chargement…";
  let items=[];
  for(const url of RSS){
    try{
      const r=await fetch(PROXY+"?url="+encodeURIComponent(url));
      const t=await r.text();
      const doc=new DOMParser().parseFromString(t,"text/xml");
      doc.querySelectorAll("item").forEach(it=>{
        items.push({
          title:it.querySelector("title")?.textContent||"",
          desc:it.querySelector("description")?.textContent||""
        });
      });
    }catch(e){log("RSS erreur: "+url);}
  }
  S.articles=items.slice(0,15);
  log("Articles chargés: "+S.articles.length);
  renderArticles();
  buildAdvice();
}

/* =====================
   CONSEILS CRYPTO
===================== */
function buildAdvice(){
  const c=S.pref.crypto?.toLowerCase()||"";
  const rel=S.articles.filter(a=>a.title.toLowerCase().includes(c));
  let html="";
  if(rel.length){
    html+=`<strong>Basé sur ${S.pref.crypto} :</strong><ul>`;
    rel.slice(0,3).forEach(a=>{
      html+=`<li>Surveillance recommandée — ${a.title}</li>`;
    });
    html+="</ul>";
  }else{
    html+="<em>Aucun signal spécifique. Rester en observation.</em>";
  }
  document.getElementById("advice").innerHTML=html;
}

/* =====================
   UI
===================== */
function renderArticles(){
  document.getElementById("articles").innerHTML=
    (S.articles||[]).map(a=>`
      <div class="article">
        <strong>${a.title}</strong><br>
        <span class="small">${a.desc.slice(0,120)}…</span>
      </div>`).join("");
}
function render(){
  showPref();
  document.getElementById("chat").innerHTML=
    S.chat.map(m=>`<div class="msg ${m.w}"><strong>${m.w}:</strong> ${m.t}</div>`).join("");
  document.getElementById("logs").innerText=S.logs.join("\n");
}

/* =====================
   DISCUSSION
===================== */
function sendUser(){
  const v=document.getElementById("userInput").value.trim();
  if(!v)return;
  document.getElementById("userInput").value="";
  chat("me",v);
  chat("ai","Je relie ton point aux articles récents et je poursuis.");
}

log("AIAQUILA RSS prêt");
render();
</script>

</body>
</html>
HTML

chown -R www-data:www-data "$WEB"
chmod 644 "$HTML"

nginx -t && systemctl reload nginx

echo "==============================="
echo "AIAQUILA RSS + MEMOIRE + CONSEILS ACTIFS"
echo "URL : https://fireinners.online/aiaquila/"
echo "==============================="
EOF
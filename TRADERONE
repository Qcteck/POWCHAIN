cat >/root/MEGA_SHOW_LAST_DIAG_CRYPTO_ENGINES.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 077

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }

[[ "$(id -u)" == "0" ]] || die "Run as root."

BASE="/root"
LAST="$(ls -1dt ${BASE}/DIAG_CRYPTO_ENGINES_* 2>/dev/null | head -n 1 || true)"
[[ -n "$LAST" ]] || die "Aucun dossier DIAG_CRYPTO_ENGINES_* trouvé dans /root."

REPORT="${LAST}/report.txt"
SERV="${LAST}/services.json"
PORTS="${LAST}/ports.txt"
HITS="${LAST}/code_hits.txt"

say "LAST = $LAST"
say "FILES:"
ls -la "$LAST" | sed -n '1,200p'

echo
say "===== report.txt (first 180 lines) ====="
sed -n '1,180p' "$REPORT" || true

echo
say "===== services.json (first 80 lines) ====="
sed -n '1,80p' "$SERV" || true

echo
say "===== ports.txt (first 120 lines) ====="
sed -n '1,120p' "$PORTS" || true

echo
say "===== code_hits.txt (first 180 lines) ====="
sed -n '1,180p' "$HITS" || true

echo
say "DONE. If you want full files:"
echo "  $REPORT"
echo "  $SERV"
echo "  $PORTS"
echo "  $HITS"
BASH

bash /root/MEGA_SHOW_LAST_DIAG_CRYPTO_ENGINES.sh
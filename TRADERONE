set -e
cd /root

echo "=== LISTENERS :3000 ==="
ss -lptn 'sport = :3000' || true
echo

echo "=== PID(S) sur 3000 ==="
PIDS="$(lsof -t -iTCP:3000 -sTCP:LISTEN 2>/dev/null || true)"
echo "$PIDS"
[ -n "$PIDS" ] || { echo "Rien n'écoute sur 3000"; exit 1; }

for PID in $PIDS; do
  echo
  echo "===== PID $PID ====="
  echo "--- CMD ---"
  tr '\0' ' ' < /proc/$PID/cmdline; echo
  echo "--- CWD ---"
  CWD="$(readlink -f /proc/$PID/cwd)"
  echo "$CWD"

  echo "--- Cherche /api/status dans CWD ---"
  grep -RIn --line-number -E 'app\.post\(["'\''"]\/api\/status|\/api\/status' "$CWD" 2>/dev/null | head -n 30 || true

  echo "--- Cherche internal dans CWD ---"
  grep -RIn --line-number -E 'internal\s*:' "$CWD" 2>/dev/null | head -n 30 || true
done
cat >/root/unlock_and_patch_wolverine_inc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/wolverine_routes.inc"
SITE="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date -u +%Y%m%d_%H%M%S)"
HOST="fireinners.online"

echo "=== 1) Show attrs BEFORE ==="
lsattr "$INC" || true
echo

echo "=== 2) Remove immutable/append-only (fix EPERM) ==="
chattr -i "$INC" 2>/dev/null || true
chattr -a "$INC" 2>/dev/null || true
chattr -ia "$INC" 2>/dev/null || true
echo "Attrs AFTER:"
lsattr "$INC" || true
echo

echo "=== 3) Quick write test (must succeed) ==="
cp -a "$INC" "${INC}.bak_unlock_${TS}"
echo "# unlock_test_${TS}" >> "$INC"
tail -n 2 "$INC"
echo "Write test OK ✅"
echo

echo "=== 4) Patch include: make /wolverine PUBLIC, keep /wolverine/traderone/api protected ==="
python3 - <<'PY'
from pathlib import Path
import re

inc_path = Path("/etc/nginx/includes/wolverine_routes.inc")
s = inc_path.read_text(errors="ignore")

# Remove any accidental global include of traderone_api_lockdown
s = s.replace("include /etc/nginx/snippets/traderone_api_lockdown.conf;", "")

def rewrite_location(text, loc_regex, rewrite_fn):
    m = re.search(loc_regex, text, flags=re.M)
    if not m:
        return text, False
    start = m.start()
    brace = text.find("{", start)
    if brace == -1:
        return text, False
    i = brace
    depth = 0
    end = None
    while i < len(text):
        if text[i] == "{": depth += 1
        elif text[i] == "}":
            depth -= 1
            if depth == 0:
                end = i+1
                break
        i += 1
    if end is None:
        return text, False
    block = text[start:end]
    block2 = rewrite_fn(block)
    return text[:start] + block2 + text[end:], True

def clean_wolverine(block: str) -> str:
    block = re.sub(r'^\s*(deny\s+all;|internal;)\s*$', '', block, flags=re.M)
    block = re.sub(r'^\s*allow\s+127\.0\.0\.1;\s*$', '', block, flags=re.M)
    block = re.sub(r'^\s*deny\s+all;\s*$', '', block, flags=re.M)
    return block

s, _ = rewrite_location(s, r'^\s*location\s+(\^~\s+)?/wolverine/\s*\{', clean_wolverine)

def ensure_api_lock(block: str) -> str:
    inc = "include /etc/nginx/snippets/traderone_api_lockdown.conf;"
    if inc not in block:
        block = re.sub(r'\{\s*', '{\n    ' + inc + '\n', block, count=1)
    return block

s, _ = rewrite_location(s, r'^\s*location\s+(\^~\s+)?/wolverine/traderone/api/?\s*\{', ensure_api_lock)

inc_path.write_text(s)
print("OK patched:", inc_path)
PY
echo

echo "=== 5) nginx test + reload ==="
nginx -t
systemctl reload nginx || service nginx reload
echo


cat >"$SWAP" <<'JS'
const express = require("express");
const router = express.Router();
const { execFile } = require("child_process");

const JUP_QUOTE = "https://quote-api.jup.ag/v6/quote";
const JUP_SWAP  = "https://quote-api.jup.ag/v6/swap";

const SIGNER_URL = "http://127.0.0.1:8484";
const RPC = process.env.SOLANA_RPC || "https://api.mainnet-beta.solana.com";

function curlJson(args, timeoutMs=15000){
  return new Promise((resolve, reject)=>{
    const base = [
      "-sS",
      "-4",                 // force IPv4
      "--tlsv1.2",          // avoid weird TLS negotiation
      "--retry", "2",
      "--retry-delay", "1",
      "--max-time", String(Math.ceil(timeoutMs/1000)),
      ...args
    ];
    execFile("curl", base, (err, stdout, stderr)=>{
      if(err) return reject(new Error(((stderr||stdout||err.message)||"curl failed").toString().slice(0,1600)));
      try { resolve(JSON.parse(stdout)); }
      catch(e){ reject(new Error(("BAD_JSON: "+stdout).slice(0,1600))); }
    });
  });
}

async function rpc(method, params){
  const body = JSON.stringify({ jsonrpc:"2.0", id:1, method, params });
  const res = await curlJson(["-H","content-type: application/json","-X","POST","--data",body,RPC], 20000);
  if(res.error) throw new Error(res.error.message || JSON.stringify(res.error));
  return res.result;
}

async function confirm(sig, timeoutMs=90000){
  const start = Date.now();
  while(Date.now()-start < timeoutMs){
    const st = await rpc("getSignatureStatuses", [[sig], { searchTransactionHistory:true }]);
    const v = st?.value?.[0];
    if(v && (v.confirmationStatus === "confirmed" || v.confirmationStatus === "finalized")) return v;
    await new Promise(r=>setTimeout(r, 1200));
  }
  throw new Error("confirm timeout");
}

router.get("/quote", async (req,res)=>{
  try{
    const { inputMint, outputMint, amount, slippageBps } = req.query;
    if(!inputMint || !outputMint || !amount) return res.status(400).send("missing params");

    const u = new URL(JUP_QUOTE);
    u.searchParams.set("inputMint", String(inputMint));
    u.searchParams.set("outputMint", String(outputMint));
    u.searchParams.set("amount", String(amount));
    u.searchParams.set("slippageBps", String(slippageBps || 50));

    const j = await curlJson([u.toString()], 15000);
    return res.json(j);
  }catch(e){
    return res.status(500).send(e?.message || String(e));
  }
});

router.post("/tx", async (req,res)=>{
  try{
    const { userPublicKey, quoteResponse, wrapAndUnwrapSol } = req.body || {};
    if(!userPublicKey || !quoteResponse) return res.status(400).send("missing userPublicKey/quoteResponse");

    const body = JSON.stringify({ quoteResponse, userPublicKey, wrapAndUnwrapSol: !!wrapAndUnwrapSol });
    const j = await curlJson(["-H","content-type: application/json","-X","POST","--data",body,JUP_SWAP], 20000);
    return res.json(j);
  }catch(e){
    return res.status(500).send(e?.message || String(e));
  }
});

router.post("/execute", async (req,res)=>{
  try{
    const { userPublicKey, quoteResponse, wrapAndUnwrapSol } = req.body || {};
    if(!userPublicKey || !quoteResponse) return res.status(400).send("missing userPublicKey/quoteResponse");

    const body1 = JSON.stringify({ quoteResponse, userPublicKey, wrapAndUnwrapSol: !!wrapAndUnwrapSol });
    const j1 = await curlJson(["-H","content-type: application/json","-X","POST","--data",body1,JUP_SWAP], 25000);

    const swapTransaction = j1?.swapTransaction;
    if(!swapTransaction) return res.status(500).send("missing swapTransaction from Jupiter");

    const payload = JSON.stringify({ transaction: swapTransaction, encoding:"base64" });
    const eps = ["/sign","/api/sign","/tx/sign","/v1/sign","/signTransaction","/sign-transaction"];
    let signedTxB64 = "";
    let lastErr = "";

    for(const ep of eps){
      try{
        const js = await curlJson(["-H","content-type: application/json","-X","POST","--data",payload, SIGNER_URL + ep], 15000);
        signedTxB64 = js.signedTransaction || js.signed || js.tx || js.transaction || "";
        if(signedTxB64) break;
        lastErr = JSON.stringify(js).slice(0,500);
      }catch(e){ lastErr = e?.message || String(e); }
    }
    if(!signedTxB64) return res.status(500).send("signer-service failed. lastErr=" + lastErr);

    const sig = await rpc("sendTransaction", [signedTxB64, { encoding:"base64", skipPreflight:false, maxRetries:3 }]);
    await confirm(sig, 90000);
    return res.json({ ok:true, signature:sig });
  }catch(e){
    return res.status(500).send(e?.message || String(e));
  }
});

module.exports = router;

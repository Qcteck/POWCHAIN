cat > /root/fireinners_batch.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
WWW="www.${DOMAIN}"
TS="$(date +%F_%H%M%S)"
LOG="/root/fireinners_batch_${TS}.log"
APPLY="${APPLY:-0}"

exec > >(tee -a "$LOG") 2>&1
echo "=== LOG: $LOG ==="
echo "APPLY=$APPLY"
echo

echo "=== 1) nginx status + config ==="
systemctl is-active nginx || true
nginx -t || true
echo

echo "=== 2) listeners 80/443 ==="
ss -lntp | egrep ':(80|443)\s' || echo "!! Rien n'écoute sur 80/443"
echo

echo "=== 3) server blocks (nginx -T) quick grep ==="
nginx -T 2>/dev/null | nl -ba | egrep -n "server_name ${DOMAIN}|server_name ${WWW}|listen 80|listen 443|root |location /wolverine|try_files|return 301" | head -n 200 || true
echo

echo "=== 4) local curl (Host header) ==="
echo "-- / (root) --"
curl -sS -k -I https://127.0.0.1/ -H "Host: ${DOMAIN}" | sed -n '1,12p' || true
echo "-- /wolverine/ --"
curl -sS -k -I https://127.0.0.1/wolverine/ -H "Host: ${DOMAIN}" | sed -n '1,20p' || true
echo "-- /favicon.ico --"
curl -sS -k -I https://127.0.0.1/favicon.ico -H "Host: ${DOMAIN}" | sed -n '1,20p' || true
echo

echo "=== 5) public curl ==="
echo "-- http => https (should be 301) --"
curl -sS -I "http://${DOMAIN}/wolverine/" | egrep -i 'HTTP/|location:' || true
echo "-- https /wolverine/ (should be 200) --"
curl -sS -k -I "https://${DOMAIN}/wolverine/" | egrep -i 'HTTP/|server:|content-type:|location:' || true
echo "-- https /favicon.ico (should NOT be 500) --"
curl -sS -k -I "https://${DOMAIN}/favicon.ico" | egrep -i 'HTTP/|server:|content-type:|location:' || true
echo

echo "=== 6) if root path is forbidden, show docroots ==="
grep -RIn --color=always "root\s\+/var/www/fireinners" /etc/nginx 2>/dev/null || true
ls -la /var/www 2>/dev/null || true
ls -la /var/www/fireinners 2>/dev/null || echo "!! /var/www/fireinners absent (si root pointe dessus => 403/404)"
echo

echo "=== 7) OPTIONAL FIX: favicon.ico returning 500 ==="
if [[ "$APPLY" == "1" ]]; then
  # si ton server block fait un alias vers un fichier absent -> 500, on met un favicon minimal.
  # (Tu peux remplacer par ton vrai favicon plus tard.)
  if [[ ! -f /var/www/wolverine/favicon.ico ]]; then
    echo "Creating minimal /var/www/wolverine/favicon.ico"
    install -d -o www-data -g www-data /var/www/wolverine
    # favicon vide (0 byte) => nginx peut servir 200/304 selon conf; sinon mets un vrai fichier.
    : > /var/www/wolverine/favicon.ico
    chown www-data:www-data /var/www/wolverine/favicon.ico
  fi
  echo "Reload nginx"
  nginx -t && systemctl reload nginx
else
  echo "APPLY=0: no changes made. To apply favicon fix: APPLY=1 bash /root/fireinners_batch.sh"
fi

echo
echo "=== DONE ==="
BASH

chmod +x /root/fireinners_batch.sh
bash /root/fireinners_batch.sh
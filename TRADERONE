cat >/root/watch_balance_error.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="fireinners.online"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP_RPC="/etc/nginx/snippets/solana_rpc_proxy.conf"
SNIP_API="/etc/nginx/snippets/traderone_api_proxy.conf"

echo "== 1) ACTIVE nginx routes (non-bak) =="
echo "--- vhost /srpc + /wolverine/rpc:"
grep -nE "location.*(/srpc|/wolverine/rpc)" "$EN" || true
echo "--- solana snippet (ACTIVE only):"
if [[ -f "$SNIP_RPC" ]]; then grep -nE "location.*(/srpc|/wolverine/rpc)" "$SNIP_RPC" || true; fi
echo "--- api snippet:"
if [[ -f "$SNIP_API" ]]; then head -n 40 "$SNIP_API"; fi

echo
echo "== 2) Confirm RPC + API quick checks =="
curl -sk -i "https://${DOMAIN}/wolverine/traderone/api/health" | sed -n '1,12p'
curl -sk -i "https://${DOMAIN}/wolverine/rpc" -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,18p'

echo
echo "== 3) NOW: reload the UI in your browser (CTRL+F5) then come back here =="
echo "Watching nginx logs for 30 seconds (only relevant paths)..."
timeout 30 bash -lc '
  (tail -n 200 -f /var/log/nginx/access.log /var/log/nginx/error.log 2>/dev/null || true) \
  | grep -E "(/wolverine/rpc|/wolverine/traderone/api|/srpc| 4[0-9]{2} | 5[0-9]{2} )"
' || true

echo
echo "DONE ✅  (paste what you see in section 3)"
BASH

chmod +x /root/watch_balance_error.sh
/root/watch_balance_error.sh
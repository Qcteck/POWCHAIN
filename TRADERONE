cat >/root/fix_wolverine_next_service_v3.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

PORT="${PORT:-3001}"

ts(){ date +%Y%m%d_%H%M%S; }
say(){ echo "[$(ts)] $*"; }

say "== Find correct Next app dir =="

# 1) cherche un dossier Next (package.json contient "next") hors node_modules
mapfile -t PJS < <(
  find /opt /var/www /srv -maxdepth 7 -name package.json \
    -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null
)

CAND=""
for pj in "${PJS[@]}"; do
  if grep -q '"next"' "$pj"; then
    d="$(dirname "$pj")"
    # prefer one that looks like a real app root
    if [[ -d "$d/pages" || -d "$d/app" ]]; then
      CAND="$d"
      break
    fi
    [[ -z "$CAND" ]] && CAND="$d"
  fi
done

[[ -n "$CAND" ]] || { echo "[ERR] No Next app found"; exit 1; }

say "Candidate APP_DIR=$CAND"
cd "$CAND"

say "== Install + build =="
npm i
npm run build

# sanity: ensure .next exists
if [[ ! -d "$CAND/.next" ]]; then
  echo "[ERR] .next not found after build in $CAND"
  echo "=> Colle: ls -la $CAND ; cat $CAND/package.json | sed -n '/\"scripts\"/,/}/p'"
  exit 1
fi

# 2) write service
SERVICE="/etc/systemd/system/wolverine-next.service"
BACK="/etc/systemd/system/wolverine-next.service.bak_$(ts)"
cp -a "$SERVICE" "$BACK" 2>/dev/null || true
say "Backup service -> $BACK"

NEXT_BIN="$CAND/node_modules/next/dist/bin/next"
[[ -f "$NEXT_BIN" ]] || { echo "[ERR] next bin missing: $NEXT_BIN"; exit 1; }

cat >"$SERVICE" <<EOF
[Unit]
Description=Wolverine Next.js Server
After=network.target

[Service]
Type=simple
WorkingDirectory=$CAND
Environment=NODE_ENV=production
ExecStart=/usr/bin/node $NEXT_BIN start -p $PORT -H 127.0.0.1
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable wolverine-next >/dev/null 2>&1 || true
systemctl restart wolverine-next

sleep 1

echo
say "== status =="
systemctl --no-pager status wolverine-next | sed -n '1,30p' || true

echo
say "== listening =="
ss -lntp | grep ":$PORT" || echo "[ERR] rien n'écoute sur $PORT"

echo
say "== upstream curl =="
curl -sSI "http://127.0.0.1:$PORT/" | head -n 20 || true

echo
say "If still KO, show logs:"
echo "  journalctl -u wolverine-next -n 120 --no-pager"
BASH

chmod +x /root/fix_wolverine_next_service_v3.sh
/root/fix_wolverine_next_service_v3.sh
cat >/tmp/wolfchain_fix_stats_200.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
CFG="/etc/nginx/sites-available/fireinners.online-ssl"
TARGET="/opt/fireinners/frontend-react/app/dist/stats/index.json"
TS="$(date -u +%Y%m%d-%H%M%S)"

[ -f "$CFG" ] || { echo "ERR missing $CFG"; exit 1; }
[ -f "$TARGET" ] || { echo "ERR missing $TARGET"; exit 1; }

cp -a "$CFG" "$CFG.bak.$TS"
chattr -i /etc/nginx/nginx.conf "$CFG" 2>/dev/null || true

# remove old block if present
perl -0777 -i -pe 's/\n\s*# BEGIN WOLFCHAIN_STATS[\s\S]*?# END WOLFCHAIN_STATS\s*\n/\n/gm' "$CFG"

# inject after server_name line containing fireinners.online
tmp="/tmp/fireinners.online-ssl.$TS"
awk 'BEGIN{ins=0}
{
  print
  if(!ins && $0 ~ /server_name/ && $0 ~ /fireinners\.online/){
    print "    # BEGIN WOLFCHAIN_STATS"
    print "    location = /stats/index.json {"
    print "        default_type application/json;"
    print "        add_header Cache-Control \"no-store\" always;"
    print "        alias /opt/fireinners/frontend-react/app/dist/stats/index.json;"
    print "    }"
    print "    # END WOLFCHAIN_STATS"
    ins=1
  }
}
END{ if(!ins){ exit 7 } }' "$CFG" >"$tmp" || { echo "ERR: server_name fireinners.online not found in vhost"; exit 1; }
mv "$tmp" "$CFG"

nginx -t
systemctl reload nginx

# lock back
chattr +i /etc/nginx/nginx.conf "$CFG" 2>/dev/null || true

echo "TEST:"
curl -k -sS -i https://127.0.0.1/stats/index.json -H 'Host: fireinners.online' | sed -n '1,25p'
SH
bash /tmp/wolfchain_fix_stats_200.sh 
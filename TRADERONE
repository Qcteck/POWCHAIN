.slice(0,18),it.pos.x+10,it.pos.y+18);ctx.fillStyle="rgba(159,179,215,.9)";ctx.font="11px system-ui";ctx.fillText((it.type||"?")+(it.pin?" • PIN":""),it.pos.x+10,it.pos.y+35)});if(D.ui.gmode==="LINK"&&D.ui.gA){const a=nodes.find(x=>x.id===D.ui.gA);if(a){ctx.strokeStyle="rgba(255,211,138,.55)";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(a.pos.x+80,a.pos.y+22);ctx.lineTo(mx,my);ctx.stroke()}}};function roundRect(c,x,y,w,h,r){c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r)}const setGMode=m=>{D=U.D;D.ui.gmode=m;D.ui.gA="";N.save(D);gHint.textContent=m==="MOVE"?"Mode Move: drag nodes / click select":"Mode Link: click A then click B";btnMove.textContent=m==="MOVE"?"Move:ON":"Move";btnLink.textContent=m==="LINK"?"Link:ON":"Link";globalThis.__NEURONE__.graphNeed=true};btnMove.onclick=()=>setGMode("MOVE");btnLink.onclick=()=>setGMode("LINK");btnClear.onclick=()=>{D=U.D;D.links=[];D.ui.gA="";N.save(D);globalThis.__NEURONE__.graphNeed=true};cv.onmousemove=e=>{const r=cv.getBoundingClientRect();mx=(e.clientX-r.left)*(cv.width/r.width);my=(e.clientY-r.top)*(cv.height/r.height);hover=hitNode(mx,my);if(drag){drag.pos.x=mx-offx;drag.pos.y=my-offy;N.save(U.D);globalThis.__NEURONE__.graphNeed=true}};cv.onmousedown=e=>{const r=cv.getBoundingClientRect();mx=(e.clientX-r.left)*(cv.width/r.width);my=(e.clientY-r.top)*(cv.height/r.height);D=U.D;const it=hitNode(mx,my);if(!it)return;U.select(it.id);if(D.ui.gmode==="MOVE"){drag=it;offx=mx-it.pos.x;offy=my-it.pos.y}else if(D.ui.gmode==="LINK"){if(!D.ui.gA){D.ui.gA=it.id;N.save(D);globalThis.__NEURONE__.graphNeed=true}else{const a=D.ui.gA,b=it.id;if(a!==b&&!D.links.some(x=>x.from===a&&x.to===b))D.links.push({from:a,to:b,at:N.now()});D.ui.gA="";N.save(D);globalThis.__NEURONE__.graphNeed=true}}};window.onmouseup=()=>{drag=null};setGMode((U.D.ui.gmode||"MOVE"));globalThis.__NEURONE__.graphTick=()=>{if(globalThis.__NEURONE__.graphNeed){globalThis.__NEURONE__.graphNeed=false;draw()}};setIn
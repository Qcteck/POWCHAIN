
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>WOLVERINE • Crypto Prediction Engine</title>
<style>
body{margin:0;background:#020617;color:#e5e7eb;font-family:system-ui}
header{padding:12px;font-weight:700;background:#020617}
#app{display:grid;grid-template-columns:260px 1fr 260px;height:calc(100vh - 48px)}
.panel,.center{padding:10px;overflow:auto}
.card{background:#020617;border-radius:8px;padding:8px;margin-bottom:8px}
.green{color:#22c55e}
.red{color:#ef4444}
progress{width:100%;height:8px}
.crypto{border-bottom:1px solid #1e293b;margin-bottom:12px;padding-bottom:8px}
</style>
</head>
<body>

<header>🐺 WOLVERINE • IA Crypto Auto-Évolutive</header>

<div id="app">
  <div class="panel">
    <h3>Variables actives</h3>
    <div id="vars"></div>
  </div>

  <div class="center">
    <h3>Marché & Prédictions</h3>
    <div id="market"></div>
  </div>

  <div class="panel">
    <h3>Algorithmes ≥ 95%</h3>
    <div id="algos"></div>
  </div>
</div>

<script>
/* ================= CONFIG ================= */
const cryptos={
 BTC:{id:"bitcoin"},
 ETH:{id:"ethereum"},
 SOL:{id:"solana"},
 SUI:{id:"sui"}
};

const horizons=[
 {label:"1m",ms:60000},
 {label:"5m",ms:300000},
 {label:"10m",ms:600000},
 {label:"30m",ms:1800000},
 {label:"1h",ms:3600000}
];

const variables={
 time:"Temps",
 volatility:"Volatilité",
 momentum:"Momentum",
 delta:"Variation",
 mean:"Moyenne",
 noise:"Exploration"
};

let algorithms=[
 {name:"Adaptive Trend Projection",weight:0.01,score:100},
 {name:"Volatility Elastic Drift",weight:0.01,score:100},
 {name:"Temporal Momentum Gradient",weight:0.01,score:100},
 {name:"Multi-Horizon Error Minimizer",weight:0.01,score:100}
];

let prices={},predictions={};

/* ================= UI ================= */
const varsDiv=document.getElementById("vars");
const algosDiv=document.getElementById("algos");
const marketDiv=document.getElementById("market");

Object.entries(variables).forEach(([k,v])=>{
 varsDiv.innerHTML+=`<div class="card"><b>${k}</b><br>${v}</div>`;
});

function renderAlgos(){
 algosDiv.innerHTML="";
 algorithms.filter(a=>Number.isFinite(a.score)&&a.score>=95).forEach(a=>{
  algosDiv.innerHTML+=`
   <div class="card">
    <b>${a.name}</b><br>
    Score: <span class="green">${a.score.toFixed(2)}%</span><br>
    Poids: ${a.weight.toFixed(3)}
   </div>`;
 });
}

/* ================= PRIX ================= */
async function fetchPrices(){
 const ids=Object.values(cryptos).map(c=>c.id).join(",");
 const r=await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=usd`);
 const d=await r.json();
 Object.entries(cryptos).forEach(([k,v])=>{
  const p=Number(d[v.id]?.usd);
  if(Number.isFinite(p)) prices[k]=p;
 });
}

/* ================= PREDICTION ================= */
function predict(base){
 let influence=0;
 algorithms.forEach(a=>{
  influence+=(Math.random()-0.5)*a.weight*base;
 });
 return base*0.75+(base+influence)*0.25;
}

/* ================= LANCEMENT ================= */
function launchPredictions(){
 Object.keys(cryptos).forEach(sym=>{
  const base=prices[sym];
  if(!Number.isFinite(base)) return;

  if(!predictions[sym]) predictions[sym]={};
  horizons.forEach(h=>{
   if(predictions[sym][h.label]) return;
   const value=predict(base);
   if(!Number.isFinite(value)) return;

   predictions[sym][h.label]={
    base,value,start:Date.now(),end:Date.now()+h.ms,done:false
   };
  });
 });
}

/* ================= VERIF ================= */
function verify(){
 const now=Date.now();
 Object.values(predictions).forEach(p=>{
  Object.values(p).forEach(pr=>{
   if(pr.done||now<pr.end) return;
   const err=Math.abs(pr.value-pr.base)/pr.base;
   const score=Number.isFinite(err)?Math.max(0,100-err*100):0;
   algorithms.forEach(a=>{
    a.score=a.score*0.9+score*0.1;
    if(score>95) a.weight=Math.min(a.weight+0.002,0.3);
   });
   pr.score=score;
   pr.done=true;
  });
 });
}

/* ================= AFFICHAGE ================= */
function renderMarket(){
 marketDiv.innerHTML="";
 Object.entries(predictions).forEach(([sym,p])=>{
  let html=`<div class="crypto"><h4>${sym} — $${prices[sym].toFixed(2)}</h4>`;
  Object.entries(p).forEach(([h,pr])=>{
   const prog=Math.min(100,((Date.now()-pr.start)/(pr.end-pr.start))*100);
   html+=`
    <div>
     ${h} → ${pr.value.toFixed(2)} USD<br>
     <progress value="${prog}" max="100"></progress><br>
     ${pr.done
      ? `<span class="green">Précision ${pr.score.toFixed(2)}%</span>`
      : `<span class="red">En cours</span>`
     }
    </div>`;
  });
  html+="</div>";
  marketDiv.innerHTML+=html;
 });
}

/* ================= LOOP ================= */
async function loop(){
 await fetchPrices();
 launchPredictions();
 verify();
 renderMarket();
 renderAlgos();
}

setInterval(loop,5000);
</script>

</body>
</html>

cat >/root/MEGA_AQUILATRADER_DEDUP_FIX_NGINX_V1.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
export DEBIAN_FRONTEND=noninteractive

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
hr(){ echo "----------------------------------------------------------------"; }
die(){ say "ERROR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "Run as root"
command -v nginx >/dev/null 2>&1 || die "nginx not found"
command -v python3 >/dev/null 2>&1 || die "python3 not found"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILATRADER_DEDUP_${TS}"
mkdir -p "$BK"

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGX_CONF="/etc/nginx/nginx.conf"

say "MEGA_AQUILATRADER_DEDUP_FIX_NGINX_V1"
say "Goal: fix nginx duplicate location /aquilatrader (keep exactly one block)"
hr

say "0) Backup nginx core + includes + sites-available"
cp -a "$NGX_VHOST" "$BK/fireinners.online-ssl.bak" 2>/dev/null || true
cp -a "$NGX_CONF" "$BK/nginx.conf.bak" 2>/dev/null || true
[ -d /etc/nginx/includes ] && cp -a /etc/nginx/includes "$BK/includes.bak" 2>/dev/null || true
[ -d /etc/nginx/snippets ] && cp -a /etc/nginx/snippets "$BK/snippets.bak" 2>/dev/null || true
[ -d /etc/nginx/sites-available ] && cp -a /etc/nginx/sites-available "$BK/sites-available.bak" 2>/dev/null || true

hr
say "1) Detect aquilatrader location occurrences (report only)"
# report (best-effort)
grep -RIn --exclude-dir='sites-enabled' --exclude='*.bak' -E 'location\s+(\^~\s+)?/aquilatrader|location\s*=\s*/aquilatrader|AQUILATRADER' /etc/nginx \
  >"$BK/aquilatrader_grep.txt" || true
say "Saved report: $BK/aquilatrader_grep.txt"
sed -n '1,120p' "$BK/aquilatrader_grep.txt" || true

hr
say "2) Dedup ONLY marked blocks (# --- AQUILATRADER ... # --- /AQUILATRADER ---)"
say "   If unmarked duplicate locations exist, script will STOP (safety)."

# temporarily unlock immutability (best-effort)
chattr -i "$NGX_CONF" 2>/dev/null || true
chattr -i "$NGX_VHOST" 2>/dev/null || true
find /etc/nginx -maxdepth 3 -type f -name '*.inc' -print0 2>/dev/null | xargs -0 -r chattr -i 2>/dev/null || true

python3 - <<'PY'
import os, re, glob, shutil, time, sys

TS = os.environ.get("TS","")
BK = os.environ.get("BK","/root/AQUILATRADER_DEDUP")
root = "/etc/nginx"

MARK_START = re.compile(r'^\s*#\s*---\s*AQUILATRADER\s*\(managed\)\s*---\s*$')
MARK_END   = re.compile(r'^\s*#\s*---\s*/AQUILATRADER\s*---\s*$')

# detect all files that contain either markers or aquilatrader locations
candidates=set()
for base, dirs, files in os.walk(root):
    for fn in files:
        if fn.endswith((".conf",".inc")):
            candidates.add(os.path.join(base, fn))

def read(p):
    with open(p,"r",encoding="utf-8",errors="replace") as f:
        return f.read().splitlines(True)

def write(p, lines):
    tmp = p + ".tmp_aquilatrader"
    with open(tmp,"w",encoding="utf-8") as f:
        f.writelines(lines)
    os.replace(tmp, p)

def find_marked_blocks(lines):
    blocks=[]
    i=0
    while i < len(lines):
        if MARK_START.match(lines[i]):
            j=i+1
            while j < len(lines) and not MARK_END.match(lines[j]):
                j+=1
            if j < len(lines) and MARK_END.match(lines[j]):
                blocks.append((i,j))
                i=j+1
                continue
        i+=1
    return blocks

def has_unmarked_locations(lines):
    # any aquilatrader location line not within marked block
    loc_re = re.compile(r'^\s*location\s+(\^~\s+)?/aquilatrader/|^\s*location\s*=\s*/aquilatrader')
    blocks = find_marked_blocks(lines)
    covered=[False]*len(lines)
    for a,b in blocks:
        for k in range(a,b+1):
            covered[k]=True
    hits=[]
    for idx,ln in enumerate(lines):
        if loc_re.search(ln) and not covered[idx]:
            hits.append(idx+1)
    return hits

changed=[]
safety_stop=[]

for p in sorted(candidates):
    try:
        lines=read(p)
    except Exception:
        continue

    blocks=find_marked_blocks(lines)
    if not blocks and ("aquilatrader" not in "".join(lines).lower()):
        continue

    # safety: if unmarked location lines exist, stop (too risky)
    unmarked = has_unmarked_locations(lines)
    if unmarked:
        safety_stop.append((p, unmarked))
        continue

    if len(blocks) <= 1:
        continue

    # keep first block, disable the rest by commenting with a prefix
    keep = blocks[0]
    new_lines = lines[:]
    prefix = f"# DISABLED_DUP_AQUILATRADER_{time.strftime('%Y%m%d_%H%M%S')} "

    # process from last to first to preserve indices
    for (a,b) in blocks[1:][::-1]:
        for i in range(a,b+1):
            ln=new_lines[i]
            if ln.strip()=="":
                continue
            if ln.lstrip().startswith("#"):
                # already comment, but still mark
                new_lines[i]=prefix + ln
            else:
                new_lines[i]=prefix + ln

    # backup file before writing
    rel = p.replace("/","_").lstrip("_")
    bkpath = os.path.join(BK, f"bak__{rel}")
    os.makedirs(BK, exist_ok=True)
    shutil.copy2(p, bkpath)

    write(p, new_lines)
    changed.append((p, len(blocks)))

if safety_stop:
    print("SAFETY_STOP: Found unmarked /aquilatrader location lines (will not modify).")
    for p, lines in safety_stop[:20]:
        print(" -", p, "lines:", ",".join(map(str,lines[:30])))
    sys.exit(3)

print("CHANGED_FILES:", len(changed))
for p,n in changed:
    print(" -", p, f"(had {n} marked blocks; kept 1, disabled {n-1})")
PY

RC=$?
if [ "$RC" -eq 3 ]; then
  hr
  say "SAFETY STOP: There are unmarked /aquilatrader location lines somewhere."
  say "Open report: $BK/aquilatrader_grep.txt"
  say "Paste me the first ~60 lines around the duplicates, and I’ll give a safe batch tailored to the exact file."
  exit 1
fi

hr
say "3) nginx -t then reload"
nginx -t
systemctl reload nginx

# re-lock best-effort
chattr +i "$NGX_CONF" 2>/dev/null || true
chattr +i "$NGX_VHOST" 2>/dev/null || true
find /etc/nginx -maxdepth 3 -type f -name '*.inc' -print0 2>/dev/null | xargs -0 -r chattr +i 2>/dev/null || true

hr
say "4) Test AquilaTrader route (HTTPS loopback with Host header)"
set +e
curl -k -sS -D "$BK/curl_headers.txt" "https://127.0.0.1/aquilatrader/" -H "Host: fireinners.online" | head -n 40 >"$BK/aquilatrader_head.html"
CURL_RC=$?
set -e
say "curl rc=$CURL_RC"
say "Saved: $BK/curl_headers.txt"
say "Saved: $BK/aquilatrader_head.html"

hr
say "DONE. Now open: https://fireinners.online/aquilatrader/"
say "Backup folder: $BK"
BASH

TS="$(date +%Y%m%d_%H%M%S)" BK="/root/AQUILATRADER_DEDUP_$(date +%Y%m%d_%H%M%S)" bash /root/MEGA_AQUILATRADER_DEDUP_FIX_NGINX_V1.sh
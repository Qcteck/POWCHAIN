set -e
cd /root

echo "=== 1) Ports 3000/3002 ==="
ss -lptn | egrep ':3000|:3002' || true
echo

echo "=== 2) Quel script PM2 a restauré ? (on voit /opt/wolverine/server.js sur ton screen) ==="
pm2 list
pm2 describe traderone | egrep -i 'script path|script|cwd|args|env|PORT|HOST' || true
echo

echo "=== 3) Test direct ==="
curl -sS -i -X POST "http://127.0.0.1:3000/api/status" -H "content-type: application/json" --data '{}' | head -n 10 || true
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" -H "content-type: application/json" --data '{}' | head -n 10 || true
echo

echo "=== 4) Si 3000 DOWN -> force traderone sur 3000 ==="
if ! ss -lptn | grep -q ':3000'; then
  pm2 delete traderone 2>/dev/null || true
  PORT=3000 HOST=127.0.0.1 pm2 start /opt/traderone-opt/server.js --name traderone --update-env
fi

sleep 1
echo
echo "=== 5) Recheck + logs ==="
ss -lptn | egrep ':3000|:3002' || true
pm2 logs traderone --lines 40 || true
echo "=== Scripts dans /wolverine/ ==="
curl -ksS https://fireinners.online/wolverine/ \
 | grep -oE '<script[^>]+src="[^"]+"' \
 | sed -E 's/.*src="([^"]+)".*/\1/' \
 | nl -ba

echo
echo "=== Test chaque script (status + 1ère ligne) ==="
while read -r p; do
  [ -z "$p" ] && continue
  u="https://fireinners.online${p}"
  echo "--- $u"
  curl -kIs "$u" | head -n 1
  curl -ksS "$u" | head -n 1
done < <(
  curl -ksS https://fireinners.online/wolverine/ \
   | grep -oE '<script[^>]+src="[^"]+"' \
   | sed -E 's/.*src="([^"]+)".*/\1/'
)
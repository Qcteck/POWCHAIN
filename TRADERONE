cat >/root/install_wallet_balances_patch.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/var/www/wolverine"
INDEX="$ROOT/index.html"
JS="$ROOT/phantom_patch.js"

[[ -f "$INDEX" ]] || { echo "[ERR] $INDEX introuvable"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$INDEX" "${INDEX}.bak_${ts}"
echo "[OK] Backup index -> ${INDEX}.bak_${ts}"

cat >"$JS" <<'JS'
(function(){
  const RPC = "https://api.mainnet-beta.solana.com";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
  const REFRESH_MS = 15000;

  function ensureOverlay(){
    let box = document.getElementById("__wallet_overlay");
    if(box) return box;
    box = document.createElement("div");
    box.id="__wallet_overlay";
    box.style.cssText="position:fixed;right:16px;bottom:16px;z-index:99999;background:rgba(0,0,0,.85);color:#fff;padding:10px 12px;border-radius:10px;font:12px/1.35 system-ui;max-width:80vw;white-space:pre-line";
    document.body.appendChild(box);
    return box;
  }
  function setMsg(msg){ ensureOverlay().textContent = msg; }
  function short(pk){ return pk.slice(0,4)+"…"+pk.slice(-4); }

  function ensureOpenInPhantomButton(){
    if(document.getElementById("__open_in_phantom_btn")) return;

    const url = encodeURIComponent(location.href);
    const phantomLink = `https://phantom.app/ul/browse/${url}`;

    const btn = document.createElement("a");
    btn.id="__open_in_phantom_btn";
    btn.href = phantomLink;
    btn.textContent = "Open in Phantom";
    btn.style.cssText="position:fixed;left:16px;bottom:16px;z-index:99999;background:#111;color:#fff;padding:10px 12px;border-radius:10px;font:14px system-ui;text-decoration:none";
    document.body.appendChild(btn);
  }

  async function rpc(method, params){
    const r = await fetch(RPC, {
      method:"POST",
      headers:{ "Content-Type":"application/json" },
      body: JSON.stringify({ jsonrpc:"2.0", id:1, method, params })
    });
    const j = await r.json();
    if(j.error) throw new Error(j.error.message || JSON.stringify(j.error));
    return j.result;
  }

  async function fetchBalances(owner){
    const bal = await rpc("getBalance", [owner, { commitment:"confirmed" }]);
    const sol = (bal.value || 0) / 1e9;

    const tok = await rpc("getTokenAccountsByOwner", [
      owner,
      { mint: USDC_MINT },
      { encoding:"jsonParsed", commitment:"confirmed" }
    ]);

    let usdc = 0;
    for(const acc of (tok.value || [])){
      const amt = acc.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
      if(typeof amt === "number") usdc += amt;
    }
    return { sol, usdc };
  }

  function writeWalletBox(pk, sol, usdc){
    // essaie d'écrire dans le bloc UI "Wallet" si trouvé
    const box = document.querySelector(".walletBox") || document.querySelector('[class*="walletBox"]') || document.querySelector('[class*="wallet"]');
    if(!box) return;

    // ajoute/maj une ligne "Balance"
    let balEl = box.querySelector("#__wallet_balance_line");
    if(!balEl){
      balEl = document.createElement("div");
      balEl.id="__wallet_balance_line";
      balEl.style.cssText="margin-top:8px;opacity:.95;font-size:12px";
      box.appendChild(balEl);
    }
    balEl.textContent = `Balance: ${sol.toFixed(4)} SOL | ${usdc.toFixed(2)} USDC`;

    // si on voit "Not connected", on tente de le remplacer
    const all = Array.from(box.querySelectorAll("*"));
    const status = all.find(n => /not connected/i.test((n.textContent||"").trim()));
    if(status) status.textContent = "Connected";
  }

  async function updateAll(pk){
    setMsg(`Connected: ${short(pk)}\nBalance: …`);
    try{
      const b = await fetchBalances(pk);
      setMsg(`Connected: ${short(pk)}\nBalance: ${b.sol.toFixed(4)} SOL | ${b.usdc.toFixed(2)} USDC`);
      writeWalletBox(pk, b.sol, b.usdc);
    }catch(e){
      console.error(e);
      setMsg(`Connected: ${short(pk)}\nBalance: (RPC error)`);
    }
  }

  async function connect(){
    if(!window.solana || !window.solana.isPhantom){
      setMsg("Phantom introuvable (extension)\n➡️ Ouvre via le navigateur Phantom");
      ensureOpenInPhantomButton();
      return;
    }
    const r = await window.solana.connect();
    const pk = r.publicKey.toBase58();
    window.__WALLET_PK__ = pk;
    await updateAll(pk);
  }

  function findConnectBtn(){
    // ton UI a un bouton "Connect Phantom"
    const direct = document.querySelector(".walletBox .btn.ghost");
    if(direct) return direct;
    const nodes = Array.from(document.querySelectorAll("button,a,div,span"));
    return nodes.find(n => /connect phantom/i.test((n.textContent||"").trim()));
  }

  function hook(){
    const el = findConnectBtn();
    if(el && !el.__wallet_hooked){
      el.__wallet_hooked = true;
      el.addEventListener("click", (ev)=>{
        ev.preventDefault();
        connect().catch(err => setMsg("Connect error: " + String(err?.message||err)));
      }, { passive:false });
      setMsg("PATCH LOADED — clique Connect Phantom");
    }
  }

  window.addEventListener("load", ()=>{
    hook();

    const obs = new MutationObserver(()=>hook());
    obs.observe(document.documentElement, { childList:true, subtree:true });

    // si déjà connecté
    if(window.solana?.isPhantom && window.solana.publicKey){
      updateAll(window.solana.publicKey.toBase58());
    } else {
      // sur Safari iOS
      ensureOpenInPhantomButton();
    }

    // refresh auto
    setInterval(()=>{
      const pk = window.solana?.publicKey?.toBase58?.() || window.__WALLET_PK__;
      if(pk) updateAll(pk);
    }, REFRESH_MS);

    window.solana?.on?.("accountChanged", (pubkey)=>{
      if(pubkey) updateAll(pubkey.toBase58());
      else setMsg("Not connected");
    });
  });

  window.__WALLET_PATCH_LOADED__ = true;
})();
JS

# injecte le script dans <head> si absent (idempotent)
if ! grep -q "phantom_patch.js" "$INDEX"; then
  perl -0777 -i -pe '
    my $tag = qq{\n<!-- WALLET_PATCH -->\n<script src="/wolverine/phantom_patch.js?v='${ts}'" defer></script>\n<!-- /WALLET_PATCH -->\n};
    s@(<head[^>]*>)@$1$tag@i;
  ' "$INDEX"
  echo "[OK] Script tag injected in <head>"
else
  echo "[OK] Script tag already present"
fi

nginx -t
systemctl reload nginx
echo "✅ OK. Test: https://fireinners.online/wolverine/?v=$ts"
BASH

chmod +x /root/install_wallet_balances_patch.sh
/root/install_wallet_balances_patch.sh
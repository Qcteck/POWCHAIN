cat >/root/WV_FIX_DUP_LOCATION.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/WV_BK_DUP_${TS}"
mkdir -p "$BK"
say(){ printf "\n[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
backup(){ local f="$1"; [ -e "$f" ] || return 0; mkdir -p "$BK$(dirname "$f")"; cp -a "$f" "$BK$f"; }
unfreeze(){ local f="$1"; [ -e "$f" ] || return 0; chattr -i "$f" 2>/dev/null || true; }

NGX="/etc/nginx"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SEN="/etc/nginx/sites-enabled/fireinners.online-ssl"
INC_STATIC="/etc/nginx/includes/wolverine_static.inc"
INC_DIR="/etc/nginx/includes"
VAULT_PORT="8787"

say "0) Savepoint (si dispo)"
[ -x /root/WOLVERINE_SAVEPOINT.sh ] && /root/WOLVERINE_SAVEPOINT.sh || true

say "1) Backup + unfreeze fichiers nginx ciblés"
for f in "$VHOST" "$SEN" "$INC_STATIC"; do backup "$f"; unfreeze "$f"; done

say "2) Fix #1: wolverine_static.inc inclus plusieurs fois -> commenter les doublons"
mapfile -t LINES < <(grep -RIn --color=never -E "include[[:space:]]+.*wolverine_static\.inc" "$NGX" 2>/dev/null || true)
if [ "${#LINES[@]}" -gt 1 ]; then
  say "Trouvé ${#LINES[@]} includes de wolverine_static.inc -> on garde le 1er, on commente les autres"
  keep=1
  for hit in "${LINES[@]}"; do
    f="${hit%%:*}"; rest="${hit#*:}"; ln="${rest%%:*}"
    if [ $keep -eq 1 ]; then keep=0; continue; fi
    backup "$f"; unfreeze "$f"
    # commente la ligne exacte
    sed -i "${ln}s|^[[:space:]]*|# WV_DUP_${TS} |" "$f" || true
  done
fi

say "3) Fix #2: autres fichiers qui redéclarent /wolverine/ -> désactiver leur include (ou le fichier)"
# détecte tout fichier qui contient une location /wolverine/
mapfile -t LOCFILES < <(grep -RIl --color=never -E "location[[:space:]]+(\^~[[:space:]]+)?/wolverine/" "$NGX" 2>/dev/null | sort -u)
if [ "${#LOCFILES[@]}" -gt 1 ]; then
  say "Fichiers avec location /wolverine/:"
  printf '%s\n' "${LOCFILES[@]}" | sed 's/^/ - /'
fi

KEEP_FILE=""
if [ -f "$INC_STATIC" ]; then KEEP_FILE="$INC_STATIC"; else KEEP_FILE="${LOCFILES[0]:-}"; fi

for f in "${LOCFILES[@]}"; do
  [ -n "$f" ] || continue
  if [ "$f" = "$KEEP_FILE" ]; then
    continue
  fi
  # Si c'est un include .inc : on le renomme pour le sortir des includes wildcard
  if [[ "$f" == "$INC_DIR/"*".inc" ]]; then
    backup "$f"; unfreeze "$f"
    mv -f "$f" "${f}.WV_DISABLED_${TS}" || true
  fi
  # Et on commente toute ligne "include <ce fichier>" trouvée dans /etc/nginx
  mapfile -t IHITS < <(grep -RIn --color=never -F "include $f" "$NGX" 2>/dev/null || true)
  for hit in "${IHITS[@]}"; do
    cf="${hit%%:*}"; rest="${hit#*:}"; ln="${rest%%:*}"
    backup "$cf"; unfreeze "$cf"
    sed -i "${ln}s|^[[:space:]]*|# WV_DUP_LOC_${TS} |" "$cf" || true
  done
done

say "4) S'assurer que le vhost enabled pointe bien vers sites-available"
[ -f "$VHOST" ] && ln -sf "$VHOST" "$SEN" || true

say "5) nginx -t + reload"
nginx -t
systemctl reload nginx

say "6) Tests Vault (DOIT être JSON, pas 307/HTML)"
echo "-- vault direct:"; curl -sS "http://127.0.0.1:${VAULT_PORT}/health"; echo
echo "-- vault via nginx Host:"; curl -sS -H "Host: fireinners.online" "http://127.0.0.1/wolverine/vault-api/health"; echo
echo "-- create via nginx Host:"; curl -sS -H "Host: fireinners.online" -H "content-type: application/json" -X POST "http://127.0.0.1/wolverine/vault-api/create" -d "{}"; echo

say "DONE"
echo "Backups: $BK"
echo "Ouvre: https://fireinners.online/wolverine/ puis Ctrl+F5"
BASH

chmod +x /root/WV_FIX_DUP_LOCATION.sh
bash /root/WV_FIX_DUP_LOCATION.sh
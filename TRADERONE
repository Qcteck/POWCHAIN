cat > /root/mega_probe.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
HOST="127.0.0.1"
PORT="9696"
DIR="/opt/probe"
ENVF="$DIR/probe.env"
SVC="/etc/systemd/system/probe.service"
SNIP="/etc/nginx/snippets/probe_location.conf"

echo "[0] preflight"
[ -f "$VHOST" ] || { echo "ERR vhost not found: $VHOST"; exit 1; }
command -v nginx >/dev/null || { echo "ERR nginx missing"; exit 1; }
command -v node >/dev/null || { echo "ERR node missing"; exit 1; }
nginx -t >/dev/null
if ss -ltnpH 2>/dev/null | grep -E "(:$PORT)\b" >/dev/null 2>&1; then echo "ERR port $PORT already in use"; exit 1; fi

echo "[1] write probe files"
systemctl stop probe.service 2>/dev/null || true
mkdir -p "$DIR" /etc/nginx/snippets
chmod 755 "$DIR"
cat > "$DIR/server.js" <<'JS'
const http=require("http"),url=require("url"),os=require("os"),crypto=require("crypto"),{execFile}=require("child_process");
const PORT=parseInt(process.env.PORT||"9696",10),HOST=process.env.HOST||"127.0.0.1";
const TOKEN=(process.env.PROBE_TOKEN||"").trim();
const CACHE_MS=parseInt(process.env.PROBE_CACHE_MS||"8000",10),TIMEOUT_MS=parseInt(process.env.PROBE_TIMEOUT_MS||"3500",10),RATE_PER_MIN=parseInt(process.env.PROBE_RATE_PER_MIN||"90",10);
let cache={t:0,data:null};const rate=new Map();const now=()=>Date.now();
const j=(res,code,obj)=>{const s=JSON.stringify(obj);res.writeHead(code,{"content-type":"application/json; charset=utf-8","cache-control":"no-store"});res.end(s);};
const bad=(res,code,msg)=>j(res,code,{ok:false,error:String(msg||"error")});
const ok=(res,obj)=>j(res,200,Object.assign({ok:true},obj));
const sh=(cmd,args=[])=>new Promise(r=>{execFile(cmd,args,{timeout:TIMEOUT_MS,maxBuffer:1024*1024},(e,so,se)=>r({ok:!e,stdout:String(so||"").trim()}));});
const ipFromReq=req=>{const xf=(req.headers["x-forwarded-for"]||"").split(",")[0].trim();return xf||req.socket.remoteAddress||"";};
const rateLimit=ip=>{const t=Math.floor(now()/60000),k=ip+"|"+t,n=(rate.get(k)||0)+1;rate.set(k,n);return n<=RATE_PER_MIN;};
const tokenOk=req=>{if(!TOKEN)return true;const got=(req.headers["x-probe-token"]||"").toString().trim()||(url.parse(req.url,true).query.token||"").toString().trim();const a=Buffer.from(got),b=Buffer.from(TOKEN);if(a.length!==b.length)return false;return crypto.timingSafeEqual(a,b);};
async function computeProbe(){
  const meta={ts:Date.now(),iso:new Date().toISOString(),hostname:os.hostname(),node:process.version};
  const kernel=(await sh("uname",["-r"])).stdout||"";
  const uptime=(await sh("uptime",["-p"])).stdout||"";
  const ssTcp=(await sh("bash",["-lc","ss -ltnpH 2>/dev/null | head -n 80"])).stdout||"";
  return {meta,system:{kernel,uptime},network:{listening_tcp:ssTcp}};
}
http.createServer(async(req,res)=>{
  const u=url.parse(req.url,true),ip=ipFromReq(req);
  if(!rateLimit(ip))return bad(res,429,"rate_limit");
  if(u.pathname==="/health")return ok(res,{health:"ok"});
  if(u.pathname!=="/probe")return bad(res,404,"not_found");
  if(!tokenOk(req))return bad(res,403,"bad_token");
  const t=now();
  if(cache.data && (t-cache.t)<CACHE_MS)return ok(res,{cached:true,probe:cache.data});
  const data=await computeProbe();cache={t,data};
  return ok(res,{cached:false,probe:data});
}).listen(PORT,HOST,()=>console.log(`[probe] http://${HOST}:${PORT}/probe token=${TOKEN?"ON":"OFF"}`));
JS
chmod 644 "$DIR/server.js"

TOKEN="$(openssl rand -hex 24)"
cat > "$ENVF" <<EOF
HOST=$HOST
PORT=$PORT
PROBE_TOKEN=$TOKEN
PROBE_CACHE_MS=8000
PROBE_TIMEOUT_MS=3500
PROBE_RATE_PER_MIN=90
EOF
chmod 600 "$ENVF"

cat > "$SVC" <<EOF
[Unit]
Description=Read-only Probe (/probe)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=$ENVF
ExecStart=/usr/bin/node $DIR/server.js
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
EOF

echo "[2] systemd"
systemctl daemon-reload
systemctl enable --now probe.service

echo "[3] nginx /probe"
cat > "$SNIP" <<EOF
location /probe {
  proxy_pass http://$HOST:$PORT/probe;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
}
EOF
cp -a "$VHOST" "${VHOST}.bak_probe_$(date +%Y%m%d_%H%M%S)"
grep -q "probe_location.conf" "$VHOST" || sed -i "0,/server {/s@server {@server {\\n  include /etc/nginx/snippets/probe_location.conf;@}" "$VHOST"
nginx -t
systemctl reload nginx

echo "[4] tests"
echo "TOKEN=$TOKEN"
curl -sS "http://$HOST:$PORT/probe?token=$TOKEN" | head -c 200; echo
curl -sS -H "X-Probe-Token: $TOKEN" "https://fireinners.online/probe" | head -c 200; echo
echo "DONE"
SH
chmod +x /root/mega_probe.sh
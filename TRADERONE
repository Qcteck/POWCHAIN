set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.lock_exact_$(date +%s)"

KEY="$(pm2 env 0 2>/dev/null | awk -F= '/^LIFI_API_KEY=/{print $2}' | tail -n1)"
[ -n "${KEY:-}" ] || { echo "KO: LIFI_API_KEY introuvable via pm2 env 0"; exit 1; }
echo "OK: KEY found (not printed)"

python3 - <<'PY'
from pathlib import Path
import os, re
ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()
KEY = os.environ["KEY"]

# remplace le check "vide" par "valeur exacte"
s2 = re.sub(
    r'if\s*\(\s*\$http_x_api_key\s*=\s*""\s*\)\s*\{\s*return\s+403;\s*\}',
    f'if ($http_x_api_key != "{KEY}") {{ return 403; }}',
    s
)
if s2 == s:
    raise SystemExit("KO: check X-API-KEY introuvable à remplacer dans nginx.")
ng.write_text(s2)
print("OK: nginx locked to exact key (not printed)")
PY

nginx -t
systemctl reload nginx

echo "--- /health (public) ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 6
echo "--- /dexes (bad key => 403) ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes -H "X-API-KEY: test" | head -n 6
echo "--- /dexes (good key => 200) ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes -H "X-API-KEY: $KEY" | head -n 6
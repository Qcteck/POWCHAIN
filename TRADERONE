bash -lc 'cat > /root/FIREINNERS_RESTORE_HTTPS_V1.sh << "BASH"
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%s)"

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ENABLED_DIR="/etc/nginx/sites-enabled"
BACKDIR="/root/fi_restore_backups"
WOLVBDIR="/root/wolv_backups"

log(){ echo "[RESTORE] $*"; }
die(){ echo "[RESTORE][ERR] $*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "root seulement"
mkdir -p "$BACKDIR"

# unlock immutables (si jamais)
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$VHOST" 2>/dev/null || true

# backup current vhost (si présent)
if [ -f "$VHOST" ]; then
  cp -a "$VHOST" "$BACKDIR/fireinners.online-ssl.current.$TS"
fi

# find latest backup candidate
cand=""
for p in \
  "$WOLVBDIR/fireinners.online-ssl.bak."* \
  "$BACKDIR/fireinners.online-ssl.bak."* \
  "/etc/nginx/sites-available/fireinners.online-ssl.bak."* \
  ; do
  [ -f "$p" ] || continue
  cand="$p"
done

# choose newest by mtime (proper)
if [ -d "$WOLVBDIR" ] || [ -d "$BACKDIR" ]; then
  newest="$(ls -1t "$WOLVBDIR"/fireinners.online-ssl.bak.* "$BACKDIR"/fireinners.online-ssl.bak.* /etc/nginx/sites-available/fireinners.online-ssl.bak.* 2>/dev/null | head -n 1 || true)"
  [ -n "${newest:-}" ] && cand="$newest"
fi

if [ -n "${cand:-}" ] && [ -f "$cand" ]; then
  log "Restore VHOST depuis: $cand"
  cp -a "$cand" "$VHOST"
else
  log "Aucun backup VHOST trouvé. Je garde le VHOST actuel (si présent)."
fi

# ensure sites-enabled points to canonical vhost, remove other fireinners.online server_name enabled symlinks/files
mkdir -p "$ENABLED_DIR"
for f in "$ENABLED_DIR"/*; do
  [ -e "$f" ] || continue
  tgt="$f"
  [ -L "$f" ] && tgt="$(readlink -f "$f" || echo "$f")"
  if [ -f "$tgt" ] && grep -Eq "server_name[[:space:]].*fireinners\.online" "$tgt" 2>/dev/null; then
    if [ "$tgt" != "$VHOST" ]; then
      rm -f "$f" 2>/dev/null || true
    fi
  fi
done
ln -sf "$VHOST" "$ENABLED_DIR/$(basename "$VHOST")"

# make sure UFW allows 80/443 (no reset)
if command -v ufw >/dev/null 2>&1; then
  ufw allow 80/tcp >/dev/null 2>&1 || true
  ufw allow 443/tcp >/dev/null 2>&1 || true
  ufw limit 22/tcp >/dev/null 2>&1 || true
  ufw --force enable >/dev/null 2>&1 || true
fi

# nginx test + restart
nginx -t
systemctl restart nginx
systemctl restart fail2ban >/dev/null 2>&1 || true

# re-lock (optionnel)
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$VHOST" 2>/dev/null || true

log "OK. Essaie maintenant: https://fireinners.online/ et /wolverine/"
log "Si ça TIMEOUT encore: c est DNS/Cloudflare/IP (pas nginx)."
BASH
chmod +x /root/FIREINNERS_RESTORE_HTTPS_V1.sh
/root/FIREINNERS_RESTORE_HTTPS_V1.sh
'
cat >/root/fix_balances_script_path_and_verify.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

LIVE="/var/www/wolverine"
IDX="$LIVE/index.html"

echo "== 1) Ensure phantom_balances.js exists in LIVE =="
ls -lah "$LIVE/phantom_balances.js" || { echo "Missing $LIVE/phantom_balances.js"; exit 1; }

echo
echo "== 2) Fix script src path in index.html (use /wolverine/...) =="
cp -a "$IDX" "$IDX.bak_$(date +%Y%m%d_%H%M%S)"
sed -i 's@src="/phantom_balances.js"@src="/wolverine/phantom_balances.js"@g' "$IDX"

echo
echo "== 3) Confirm index references =="
grep -n "phantom_balances.js" "$IDX" || true

echo
echo "== 4) Test HTTP serve (should be 200) =="
curl -sk -D- https://fireinners.online/wolverine/phantom_balances.js | head -n 20
BASH

chmod +x /root/fix_balances_script_path_and_verify.sh
/root/fix_balances_script_path_and_verify.sh
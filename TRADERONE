cat >/tmp/WOLVERINE_FIX_SERVERJS_API_AND_REWRITE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SVC="traderone.service"
FILE="/opt/traderone-opt/server.js"
TS="$(date +%s)"
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"

echo "== 1) Backup =="
cp -a "$FILE" "$FILE.bak.$TS"

echo "== 2) Patch catch-all '*' pour NE PAS capturer /api/* =="
# remplace: app.get('*', ... )  ->  app.get(/^\/(?!api\/).*/, ... )
# (ça laisse passer /api/... vers les vraies routes)
perl -0777 -i -pe 's/app\.get\(\s*'\''\*'\''\s*,/app.get(/^\\\/(?!api\\\/).*/,/g' "$FILE"

echo "== 3) Ajoute rewrite interne: /wolverine/traderone/api/* -> /api/* (si absent) =="
if ! grep -q "WOLVERINE_REWRITE_BEGIN" "$FILE"; then
  # inject juste après express.json (ou sinon après la 1ère ligne "const app = express()")
  perl -0777 -i -pe 's/(app\.use\(\s*express\.json\([^;]*\)\s*\);\s*)/\1\n\/\/ WOLVERINE_REWRITE_BEGIN\napp.use(\"\/wolverine\/traderone\/api\", (req, res, next) => {\n  \/\/ quand on est monté ici, req.url = \"\/balances2?...\" -> on préfixe \/api\n  req.url = \"\/api\" + req.url;\n  next();\n});\n\/\/ WOLVERINE_REWRITE_END\n\n/s' "$FILE" || true

  # fallback si express.json non trouvé
  if ! grep -q "WOLVERINE_REWRITE_BEGIN" "$FILE"; then
    perl -0777 -i -pe 's/(const\s+app\s*=\s*express\(\)\s*;\s*)/\1\n\/\/ WOLVERINE_REWRITE_BEGIN\napp.use(\"\/wolverine\/traderone\/api\", (req, res, next) => {\n  req.url = \"\/api\" + req.url;\n  next();\n});\n\/\/ WOLVERINE_REWRITE_END\n\n/s' "$FILE"
  fi
fi

echo "== 4) Restart service =="
systemctl restart "$SVC"
systemctl status "$SVC" --no-pager -l | sed -n '1,25p'
echo

echo "== 5) Tests (doivent commencer par { ) =="
echo "--- (A) /api/balances2 (JSON attendu)"
curl -sS -D- "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" | head -c 260 || true
echo -e "\n"

echo "--- (B) /wolverine/traderone/api/balances2 (JSON attendu)"
curl -sS -D- "http://127.0.0.1:8585/wolverine/traderone/api/balances2?wallet=$WALLET" | head -c 260 || true
echo -e "\n"

echo "DONE ✅"
SH

bash /tmp/WOLVERINE_FIX_SERVERJS_API_AND_REWRITE.sh
#!/bin/bash
set -e

echo "🐺 WOLVERINE — MEGA UI PATCH (RESPONSIVE + PHANTOM + CHART)"
echo "=========================================================="

UI="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor"
TS=$(date +%Y%m%d_%H%M%S)
BACKUP="/var/www/_BACKUP_WOLVERINE_UI_$TS"
LOG="/root/wolverine_ui_patch_$TS.log"

exec > >(tee -a "$LOG") 2>&1

echo
echo "🔎 Vérification UI"
[ -f "$UI" ] || { echo "❌ UI introuvable: $UI"; exit 1; }

echo
echo "📦 Backup UI"
mkdir -p "$BACKUP"
cp -a "$UI" "$BACKUP/"

echo
echo "📦 Vendor Chart.js (local)"
mkdir -p "$VENDOR"
if [ ! -f "$VENDOR/chart.min.js" ]; then
  curl -sL https://cdn.jsdelivr.net/npm/chart.js > "$VENDOR/chart.min.js"
fi

echo
echo "✏️ Patch responsive + Phantom + Graph"

grep -q "WOLVERINE_UI_PATCH" "$UI" && { echo "✔️ Patch déjà appliqué"; exit 0; }

sed -i "/<\/head>/i \
<!-- WOLVERINE_UI_PATCH -->\
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\
<style>\
html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden}\
#app{display:flex;flex-direction:column;width:100vw;height:100vh}\
.main{flex:1;overflow:auto;padding:12px}\
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}\
@media(max-width:768px){.main{padding:8px;font-size:14px}}\
@media(max-width:480px){.main{padding:6px;font-size:13px}}\
</style>" "$UI"

sed -i "/<\/body>/i \
<div class=\"main\">\
  <div class=\"grid\">\
    <button id=\"connectPhantom\">Connect Phantom</button>\
    <canvas id=\"chart\" height=\"140\"></canvas>\
  </div>\
</div>\
<script src=\"/wolverine/vendor/chart.min.js\"></script>\
<script>\
document.getElementById('connectPhantom').onclick=async()=>{\
 if(!window.solana||!window.solana.isPhantom){alert('Ouvre ce site dans Phantom');return;}\
 try{const r=await window.solana.connect({onlyIfTrusted:false});console.log('Phantom:',r.publicKey.toString());}catch(e){console.error(e);}\
};\
const ctx=document.getElementById('chart');\
new Chart(ctx,{type:'line',data:{labels:['T1','T2','T3','T4'],datasets:[{data:[100,102,101,108],borderWidth:2,tension:.35}]},options:{responsive:true,plugins:{legend:{display:false}},scales:{x:{display:false}}}});\
</script>" "$UI"

echo
echo "🧪 Vérification HTML"
grep -q "Connect Phantom" "$UI" && echo "✔️ Phantom button OK"
grep -q "Chart(" "$UI" && echo "✔️ Chart OK"

echo
echo "✅ MEGA UI PATCH TERMINÉ"
echo "📄 Backup : $BACKUP"
echo "📄 Log    : $LOG"
cat >/tmp/DEDUP_WOLVERINE_INCLUDE_IN_VHOST.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"

EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
VHOST="$(readlink -f "$EN" 2>/dev/null || echo "$EN")"

echo "VHOST=$VHOST"
[ -f "$VHOST" ] || { echo "ERROR vhost not found"; exit 1; }

mkdir -p "/root/backup_dedup_${T}"
cp -a "$VHOST" "/root/backup_dedup_${T}/fireinners.online-ssl.bak"

python3 - "$VHOST" <<'PY'
import re, sys
p = sys.argv[1]
lines = open(p, "r", encoding="utf-8", errors="ignore").read().splitlines(True)

# matches both:
# include /etc/nginx/snippets/fireinners-wolverine.conf;
# include snippets/fireinners-wolverine.conf;
pat = re.compile(r'^\s*include\s+(?:/etc/nginx/)?snippets/fireinners-wolverine\.conf\s*;.*$')

kept = False
out = []
removed = 0
for line in lines:
    if pat.match(line):
        if not kept:
            out.append("    include /etc/nginx/snippets/fireinners-wolverine.conf; # FIREINNERS_WOLVERINE_INCLUDE\n")
            kept = True
        else:
            removed += 1
        continue
    out.append(line)

open(p, "w", encoding="utf-8").write("".join(out))
print(f"OK: kept 1 include, removed {removed} duplicate include(s) in {p}")
PY

echo "=== nginx test + reload ==="
nginx -t
systemctl reload nginx
echo "OK ✅"
SH

bash /tmp/DEDUP_WOLVERINE_INCLUDE_IN_VHOST.sh
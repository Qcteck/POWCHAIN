say "6) Ensure vhost includes wolverine routes (idempotent)"
python3 - <<PY
from pathlib import Path
p=Path("$VHOST")
s=p.read_text(errors="ignore")
inc="include /etc/nginx/includes/wolverine_routes.inc;"
if inc in s:
    print("OK: include already present")
else:
    lines=s.splitlines(True)
    out=[]
    inserted=False
    in_server=False
    for line in lines:
        out.append(line)
        if line.strip().startswith("server {"):
            in_server=True
        if in_server and ("server_name" in line and "fireinners.online" in line) and (not inserted):
            out.append("  "+inc+"\n")
            inserted=True
        if in_server and line.strip()=="}":
            in_server=False
    p.write_text("".join(out))
    print("OK: injected include into vhost" if inserted else "WARN: no server_name fireinners.online match")
PY


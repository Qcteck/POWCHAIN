cat >/tmp/WOLV_TG_SET.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
DIR="/opt/fireinners/wolverine-telegram"
ENV="$DIR/telegram.env"
CID="5153862399"
mkdir -p "$DIR"; chmod 700 "$DIR"
systemctl stop wolverine-tg-sentinel 2>/dev/null || true
[ -f "$ENV" ] && cp -a "$ENV" "$ENV.bak.$(date +%s)" || true
echo "COLLE LE NOUVEAU TG TOKEN puis ENTER (rien ne s'affiche):"
read -r -s TG; echo
TG="$(printf '%s' "$TG" | tr -d '\r' | tr -d ' ')"
if ! printf '%s' "$TG" | grep -Eq '^[0-9]{6,}:[A-Za-z0-9_-]{20,}$'; then
  echo "ERREUR: format token invalide (attendu: 123456789:AbcDEF_-...)"
  exit 1
fi
umask 077
printf 'TG_TOKEN=%s\nTG_CHAT_ID=%s\n' "$TG" "$CID" >"$ENV"
chmod 600 "$ENV"
echo "--- getMe (doit contenir ok:true) ---"
ME="$(curl -sS -m 8 "https://api.telegram.org/bot${TG}/getMe" | head -c 300)"
echo "$ME"; echo
echo "$ME" | grep -q '"ok":true' || { echo "ERREUR: getMe pas ok:true (token invalide/revoke)"; exit 1; }
echo "--- sendMessage test ---"
curl -sS -m 8 -X POST "https://api.telegram.org/bot${TG}/sendMessage" \
  -d "chat_id=${CID}" \
  -d "text=WOLVERINE: token OK (set)" \
  -d "disable_web_page_preview=true" >/dev/null
systemctl restart wolverine-tg-sentinel 2>/dev/null || true
echo "OK: token enregistré + message test envoyé + sentinel relancé."
SH
bash /tmp/WOLV_TG_SET.sh
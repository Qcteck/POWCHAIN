#!/bin/bash
set -e

FRONT="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
cp $FRONT $FRONT.bak.fix.$(date +%s)

# 1) Supprimer le bloc wallet dupliqué (celui à droite)
sed -i '/Internal USDC/,/Phantom USDC/d' $FRONT

# 2) Forcer UN SEUL container centré
sed -i '/<body>/a\
<div id="app-center">' $FRONT

sed -i '/<\/body>/i\
</div>' $FRONT

# 3) CSS : centrage + contraste boutons
sed -i '/<\/head>/i\
<style>\
#app-center{\
position:fixed;inset:0;\
display:flex;align-items:center;justify-content:center;\
flex-direction:column;gap:18px;\
}\
button,input{\
color:var(--fg)!important;\
background:rgba(255,255,255,.25);\
border:1px solid rgba(0,0,0,.25);\
}\
.light button,.light input{\
color:#000!important;\
background:rgba(255,255,255,.85);\
}\
.dark button,.dark input{\
color:#fff!important;\
background:rgba(0,0,0,.45);\
}\
</style>' $FRONT

nginx -t && systemctl reload nginx
echo "✅ UI NETTOYÉE : 1 SEUL WALLET + TEXTE OK MODE JOUR"
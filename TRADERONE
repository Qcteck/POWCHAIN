cat >/tmp/MEGA_WOLVERINE_INSTALL.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then . "$ASKLIB"; else
  askorupdate_yesno(){ local q="$1"; read -r -p "$q (y/N) " a || true; case "${a,,}" in y|yes) return 0;; *) return 1;; esac; }
  askorupdate_file(){ local p="$1" c="$2"; mkdir -p "$(dirname "$p")"; printf "%s" "$c" >"$p"; }
fi
say(){ printf "%s\n" "$*"; }

SITE="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine.conf"
MARK="WOLVERINE_V1"
PORT="9697"
BACK_DIR="/opt/fireinners/wolverine-backend"
FRONT_DIR="/opt/fireinners/frontend-react/app/dist/wolverine"
ENV_FILE="$BACK_DIR/.env"

command -v node >/dev/null || { say "ERREUR: node absent"; exit 1; }
command -v nginx >/dev/null || { say "ERREUR: nginx absent"; exit 1; }
[ -f "$SITE" ] || { say "ERREUR: $SITE absent"; exit 1; }

say "=== BATCH FLY (read-only) ==="
say "Backend dir: $BACK_DIR"
say "Frontend dir: $FRONT_DIR"
say "Nginx site: $SITE"
say "Port backend (localhost): $PORT"
say "Ce batch va:"
say "- créer backend express (localhost:$PORT) + systemd wolverine.service"
say "- créer frontend /wolverine/ (index.html)"
say "- proxifier /wolverine/api/* -> localhost:$PORT"
say "- forcer /wolverine/ à servir ce frontend (pas le React index global)"
say "- nginx -t + reload + re-lock chattr"
if ! askorupdate_yesno "Continuer ?"; then say "Stop."; exit 0; fi

mkdir -p "$BACK_DIR" "$FRONT_DIR"
chmod 700 "$BACK_DIR" || true

# .env (minimal)
if [ ! -f "$ENV_FILE" ]; then
  cat >"$ENV_FILE" <<EOF
PORT=$PORT
# Telegram alerts via existing wolv_send (optional)
WOLV_SEND=/usr/local/bin/wolv_send
TG_ALERTS=1
# Monitoring target (proxy ping)
MONITOR_URL=https://bbbotrader.paycashnostory.workers.dev/ping
# 0=off, else seconds
MONITOR_EVERY=20
EOF
  chmod 600 "$ENV_FILE" || true
fi

# backend server.js
cat >"$BACK_DIR/server.js" <<'JS'
import http from "http";
import express from "express";
import { execFile } from "child_process";

const app=express();
app.use(express.json({limit:"1mb"}));

const ENV=(k,d)=>process.env[k]??d;
const state={
  boot:new Date().toISOString(),
  running:false,
  cfg:{budgetUSDC:0,mode:"safe",mint:"",wallet:""},
  spentUSDC:0,
  lastSwap:null,
  monitor:{url:ENV("MONITOR_URL",""),every:+ENV("MONITOR_EVERY","0")||0,last:null,ok:null,failStreak:0,effective:"INIT"}
};

function now(){return new Date().toISOString();}
function j(o){return JSON.stringify(o);}
function sendTG(msg){
  if((ENV("TG_ALERTS","1")==="0")) return;
  const p=ENV("WOLV_SEND","/usr/local/bin/wolv_send");
  execFile(p,[String(msg)],{timeout:8000},()=>{});
}
async function ping(url){
  const t=Date.now();
  try{
    const r=await fetch(url,{method:"GET",redirect:"follow",signal:AbortSignal.timeout(8000)});
    const tx=await r.text();
    const ok=(r.ok && /pong/i.test(tx));
    return {ok,code:r.status,ms:Date.now()-t,body:tx.slice(0,120)};
  }catch(e){
    return {ok:false,code:0,ms:Date.now()-t,body:String(e).slice(0,120)};
  }
}

app.get("/health",(req,res)=>res.json({ok:true,service:"wolverine",now:now()}));
app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));
app.get("/status",(req,res)=>res.json({ok:true,now:now(),state}));
app.get("/traderone/status",(req,res)=>res.json({ok:true,now:now(),running:state.running,cfg:state.cfg,spentUSDC:state.spentUSDC,lastSwap:state.lastSwap,monitor:state.monitor}));

app.post("/traderone/start",(req,res)=>{
  const {budgetUSDC,mode,mint,wallet}=req.body||{};
  const b=+budgetUSDC||0;
  if(b<=0) return res.status(400).json({ok:false,error:"budgetUSDC invalid"});
  state.running=true;
  state.cfg={budgetUSDC:b,mode:String(mode||"safe"),mint:String(mint||""),wallet:String(wallet||"")};
  state.spentUSDC=0;
  sendTG(`WOLVERINE: START budget=${b} mode=${state.cfg.mode} ${now()}`);
  res.json({ok:true,now:now(),state});
});

app.post("/traderone/stop",(req,res)=>{
  state.running=false;
  sendTG(`WOLVERINE: STOP ${now()}`);
  res.json({ok:true,now:now(),state});
});

app.post("/log",(req,res)=>{
  const ev=req.body||{};
  if(ev && typeof ev==="object"){
    if(ev.type==="swap"){
      const amt=+ev.usdc||0;
      if(amt>0){ state.spentUSDC=Math.min(state.cfg.budgetUSDC,state.spentUSDC+amt); }
      state.lastSwap={...ev,ts:now()};
    }
  }
  res.json({ok:true});
});

function monitorTick(){
  const url=state.monitor.url;
  if(!url || !state.monitor.every) return;
  ping(url).then(r=>{
    state.monitor.last={...r,ts:now()};
    if(r.ok){
      state.monitor.failStreak=0;
      if(state.monitor.effective!=="UP"){
        state.monitor.effective="UP";
        sendTG(`WOLVERINE: API UP (recovery) ${now()}`);
      }
    }else{
      state.monitor.failStreak++;
      if(state.monitor.failStreak>=3 && state.monitor.effective!=="DOWN"){
        state.monitor.effective="DOWN";
        sendTG(`WOLVERINE: API DOWN (>=3 fails) ${now()}`);
      }
    }
  }).catch(()=>{});
}

setInterval(monitorTick, 1000);
setInterval(()=>{ if(state.monitor.every){ /* coarse gating */ } }, 1000);

let lastRun=0;
setInterval(()=>{
  if(!state.monitor.every) return;
  const t=Date.now();
  if(t-lastRun >= state.monitor.every*1000){ lastRun=t; monitorTick(); }
},1000);

const port=+ENV("PORT","9697")||9697;
const srv=http.createServer(app);
srv.listen(port,"127.0.0.1",()=>{ console.log(`wolverine backend on 127.0.0.1:${port}`); });

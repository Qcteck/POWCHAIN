for f in /etc/nginx/sites-enabled/*; do
  [ -e "$f" ] || continue
  txt="$(python3 - <<PY
import sys
p=sys.argv[1]
try: print(open(p,'r',encoding='utf-8',errors='ignore').read())
except: print('')
PY
"$f")"
  if echo "$txt" | grep -qE '^\s*server_name\s+.*\bfireinners\.online\b'; then
    tgt="$f"
    if [ -L "$f" ]; then tgt="$(readlink -f "$f" || echo "$f")"; fi
    if [ "$tgt" != "$CANON_REAL" ]; then
      # disable
      if [ -L "$f" ]; then rm -f "$f"; else mv -f "$f" "$f.disabled.$TS"; fi
    fi
  fi
done
ln -sf "$CANON" "/etc/nginx/sites-enabled/$(basename "$CANON")"

# 3) Patch nginx: /wolverine/api/ avant /wolverine/
MARK_BEGIN="# BEGIN WOLV_SINGLE_UI_V1"
MARK_END="# END WOLV_SINGLE_UI_V1"
BLOCK="$MARK_BEGIN
location ^~ /wolverine/api/ {
  rewrite ^/wolverine/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_read_timeout 60s;
}
location = /wolverine/ {
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  return 302 /wolverine/index.html;
}
location ^~ /wolverine/ {
  alias /opt/fireinners/frontend-react/app/dist/wolverine/;
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  try_files \$uri \$uri/ /index.html;
}
$MARK_END"

chattr -i "$CANON" 2>/dev/null || true

python3 - "$CANON" "$MARK_BEGIN" "$MARK_END" "$BLOCK" <<'PY'
import sys,re
p,mb,me,block=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
s=open(p,"r",encoding="utf-8",errors="ignore").read()

# supprime anciens blocs Wolverine si existants
for ob in ["# BEGIN WOLV_SINGLE_UI_V6","# BEGIN WOLV_SINGLE_UI_V5","# BEGIN WOLV_SINGLE_UI_V4","# BEGIN WOLV_SINGLE_UI_V3"]:
  oe=ob.replace("BEGIN","END")
  if ob in s and oe in s:
    a=s.index(ob); b=s.index(oe,a)+len(oe)
    s=s[:a]+s[b:]

# remplace si présent
if mb in s and me in s:
  a=s.index(mb); b=s.index(me,a)+len(me)
  s=s[:a]+block+s[b:]
  open(p,"w",encoding="utf-8").write(s)
  raise SystemExit(0)

# parse server blocks
def blocks(txt):
  out=[]
  for m in re.finditer(r'(?m)^\s*server\s*\{', txt):
    i=m.start(); depth=0; j=i
    while j<len(txt):
      c=txt[j]
      if c=='{': depth+=1
      elif c=='}':
        depth-=1
        if depth==0:
          out.append((i,j+1,txt[i:j+1]))
          break
      j+=1
  return out

B=blocks(s)
cands=[b for b in B if re.search(r'(?m)^\s*server_name\s+.*\bfireinners\.online\b', b[2])]
if not cands: raise SystemExit("ERR: aucun server{} avec server_name fireinners.online dans "+p)
pick=None
for b in cands:
  if re.search(r'(?m)^\s*listen\s+443', b[2]): pick=b; break
if pick is None: pick=cands[0]
a,b,t=pick
ins=b-1
out=s[:ins].rstrip()+"\n\n"+block+"\n\n"+s[ins:]
open(p,"w",encoding="utf-8").write(out)
PY

nginx -t

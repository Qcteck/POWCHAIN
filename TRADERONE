#!/usr/bin/env bash
set -euo pipefail

echo "=============================="
echo " TRADERONE PORT AUTO-DETECT "
echo "=============================="

APP="traderone-vault"
FILE="/opt/traderone-vault/server.js"

########################################
# 1) PM2 infos
########################################
echo "[1/5] PM2 infos"
pm2 describe "$APP" || exit 1

########################################
# 2) Détection PORT dans server.js
########################################
echo "[2/5] Scan server.js pour listen()"

PORTS=$(grep -E "listen\(|PORT" "$FILE" || true)
echo "---- server.js ----"
echo "$PORTS"
echo "-------------------"

########################################
# 3) Ports ouverts par le process
########################################
echo "[3/5] Ports réellement écoutés"
PID=$(pm2 pid "$APP")
echo "PID=$PID"

ss -lntp | grep "$PID" || echo "⚠️ aucun port trouvé via ss"

########################################
# 4) Test automatique des ports détectés
########################################
echo "[4/5] Test API sur ports actifs"

FOUND=0
for P in $(ss -lntp | grep "$PID" | awk '{print $4}' | awk -F: '{print $NF}'); do
  echo "→ Test port $P"
  curl -s --max-time 2 http://127.0.0.1:$P/wolverine/traderone/api/health || true
  echo
  if curl -s http://127.0.0.1:$P/wolverine/traderone/api/health | grep -q '"ok"'; then
    echo "✅ API OK sur port $P"
    FOUND=$P
    break
  fi
done

########################################
# 5) Verdict
########################################
echo "=============================="
if [ "$FOUND" = "0" ]; then
  echo "❌ AUCUN PORT API TROUVÉ"
  echo "→ Le serveur n'expose pas Express correctement"
  exit 1
else
  echo "✅ PORT RÉEL = $FOUND"
  echo "👉 Utilise ce port pour nginx proxy_pass"
fi
echo "=============================="
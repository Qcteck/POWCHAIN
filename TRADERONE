(()=>{"use strict";const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const $=(s,r=document)=>r.querySelector(s);const $$=(s,r=document)=>Array.from(r.querySelectorAll(s));const log=(...a)=>{try{console.log("[WOLV]",...a)}catch(_){}};const setStatus=(t)=>{const el=$("#status")||$("[data-status]");if(el)el.textContent=t;log(t)};const lsKey=(to,asset,amt)=>"WOLV_PAID:"+to+":"+asset+":"+amt;const hexToBytes=(h)=>{h=h.replace(/^0x/,"");if(h.length%2)h="0"+h;const a=new Uint8Array(h.length/2);for(let i=0;i<a.length;i++)a[i]=parseInt(h.slice(i*2,i*2+2),16);return a};const loadLib=async()=>{if(window.solanaWeb3&&window.splToken&&window.Buffer)return true;const wait=(ms)=>new Promise(r=>setTimeout(r,ms));for(let i=0;i<50;i++){if(window.solanaWeb3&&window.splToken&&window.Buffer)return true;await wait(100)}return !!(window.solanaWeb3&&window.splToken)};const ensureConnect=async()=>{if(!window.solana||!window.solana.isPhantom)throw new Error("Phantom introuvable");const r=await window.solana.connect({onlyIfTrusted:false});return r.publicKey.toString()};const findStartBtn=()=>{let b=$("#startWolverine")||$("#btnStart")||$("#start");if(b)return b;const cand=$$("button,input[type=button],a").find(x=>/START\s*WOLVERINE/i.test((x.textContent||x.value||"")));return cand||null};const findBudgetInput=()=>$("#budget")||$("#budgetInput")||$$("input").find(x=>/budget/i.test(x.id||"")||/budget/i.test(x.name||""))||null;const findAssetSelect=()=>$("#asset")||$("#assetSelect")||$$("select").find(x=>/asset/i.test(x.id||"")||/asset/i.test(x.name||""))||null;const getTraderOneAddr=()=>{const el=$("#traderOneAddr")||$("#botAddr")||$("[data-traderone]");if(el&&el.textContent){const m=el.textContent.match(/[1-9A-HJ-NP-Za-km-z]{32,44}/);if(m)return m[0]}const html=document.body.innerText||"";const m=html.match(/Wallet TraderOne.*?Adresse:\s*([1-9A-HJ-NP-Za-km-z]{32,44})/s);return m?m[1]:null};const makeUi=(startBtn,budgetEl,assetEl,toAddr)=>{const row=startBtn.parentElement||document.b
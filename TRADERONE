cat >/root/diagnose_origin_403_wolverine_rpc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 1) nginx -T : show any wolverine/rpc related blocks =="
nginx -T 2>/tmp/nginxT.txt >/dev/null || true
grep -nE 'wolverine|/rpc|location\s+|auth_basic|deny\s+|allow\s+|return\s+403|satisfy|access_by|geo|map' /tmp/nginxT.txt | head -n 220

echo
echo "== 2) List enabled vhosts =="
ls -lah /etc/nginx/sites-enabled || true
echo
echo "== 3) Dump vhost files that mention /wolverine or rpc =="
grep -RInE 'wolverine|/rpc' /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null | head -n 200

echo
echo "== 4) Quick curl direct origin (show status only) =="
curl -sk -o /dev/null -w "HTTPS localhost status: %{http_code}\n" https://127.0.0.1/wolverine/rpc -H "Host: fireinners.online" -H "content-type: application/json" --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' || true
curl -s  -o /dev/null -w "HTTP  localhost status: %{http_code}\n" http://127.0.0.1/wolverine/rpc  -H "Host: fireinners.online" -H "content-type: application/json" --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' || true

echo
echo "DONE ✅"
BASH

chmod +x /root/diagnose_origin_403_wolverine_rpc.sh
/root/diagnose_origin_403_wolverine_rpc.sh
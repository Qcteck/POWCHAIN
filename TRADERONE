bash -lc '
set -euo pipefail

echo "==============================="
echo "AIAQUILA – CLEAN RESTORE + JS FIX"
echo "==============================="

WEB="/var/www/aiaquila/index.html"

# 1. Trouver le dernier backup
echo "[1/6] Recherche backup..."
BACKUP=$(ls -t /root/backup_aiaquila_index_*.html 2>/dev/null | head -n1 || true)

if [ -z "$BACKUP" ]; then
  echo "❌ Aucun backup trouvé. STOP."
  exit 1
fi

echo "✔ Backup utilisé: $BACKUP"

# 2. Restore propre
echo "[2/6] Restauration..."
cp "$BACKUP" "$WEB"

# 3. Patch JS minimal et sûr
echo "[3/6] Patch JS..."

sed -i '
/const S = JSON.parse(localStorage.getItem("aiaquila_state"))/c\
window.AQ_STATE = window.AQ_STATE || JSON.parse(localStorage.getItem("aiaquila_state")) || {lvl:0.55,h:{}};\
const S = window.AQ_STATE;
' "$WEB"

# 4. Permissions
echo "[4/6] Permissions..."
chown www-data:www-data "$WEB"
chmod 644 "$WEB"

# 5. Test nginx
echo "[5/6] Test nginx..."
nginx -t

# 6. Reload nginx
echo "[6/6] Reload nginx..."
systemctl reload nginx

echo "==============================="
echo "✅ RESTORE + FIX TERMINÉ"
echo "➡ URL: https://fireinners.online/aiaquila/"
echo "➡ Hard refresh navigateur (CTRL + F5)"
echo "==============================="
'
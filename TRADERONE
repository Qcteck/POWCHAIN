cat >/tmp/WOLVERINE_FIND_REAL_BALANCES2_PATH_9696.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
BASE="http://127.0.0.1:9696"

echo "== 1) Listener check (8585/9696) =="
ss -lntp | egrep ':(8585|9696)\s' || true
echo

echo "== 2) Try common paths on 9696 =="
paths=(
  "/api/balances2?wallet=$WALLET"
  "/balances2?wallet=$WALLET"
  "/api/balances?wallet=$WALLET"
  "/balances?wallet=$WALLET"
  "/api/wallet/balances2?wallet=$WALLET"
  "/traderone/api/balances2?wallet=$WALLET"
  "/health"
  "/api/health"
  "/status"
  "/api/status"
)

for p in "${paths[@]}"; do
  url="${BASE}${p}"
  code="$(curl -sS -o /tmp/out.$$ -w '%{http_code}' "$url" || true)"
  headbytes="$(head -c 120 /tmp/out.$$ | tr '\n' ' ')"
  echo "--- $p  => HTTP $code"
  echo "    $headbytes"
  echo
done

echo "== 3) Grep routes in /opt/traderone-opt (if exists) =="
if [ -d /opt/traderone-opt ]; then
  grep -RIn --include='*.js' -E "balances2|/balances2|router\.get|app\.get|app\.use\(" /opt/traderone-opt | head -n 80 || true
fi
echo

echo "DONE ✅"
SH

bash /tmp/WOLVERINE_FIND_REAL_BALANCES2_PATH_9696.sh
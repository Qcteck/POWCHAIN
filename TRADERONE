bash <<'BASH'
set -euo pipefail

HTML="/var/www/wolverine/index.html"
test -f "$HTML" || { echo "index.html introuvable"; exit 1; }
cp -a "$HTML" "$HTML.bak_$(date +%s)"

# 1) Nettoyage total Phantom / Solana précédents
sed -i '/solanaWeb3/d;/@solana\/web3/d;/getBalance/d;/USDC/d;/balances\//d' "$HTML"

# 2) Injection solana-web3 PROPRE (IIFE garanti)
sed -i 's#</head>#<script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script></head>#' "$HTML"

# 3) Injection logique Phantom + SOL + Budget + TraderOne
perl -0777 -i -pe '
s#</body>#<script>
window.addEventListener("load",()=>{

 const btn=[...document.querySelectorAll("button")].find(b=>b.innerText.includes("Connect Phantom"));
 if(!btn)return;

 let state={pub:null,sol:0,budget:0};

 btn.onclick=async()=>{
  if(!window.solana||!solana.isPhantom){alert("Phantom absent");return;}
  const res=await solana.connect();
  state.pub=res.publicKey.toString();

  const conn=new solanaWeb3.Connection("https://api.mainnet-beta.solana.com","confirmed");
  const lamports=await conn.getBalance(new solanaWeb3.PublicKey(state.pub));
  state.sol=(lamports/1e9);

  document.body.innerHTML=document.body.innerHTML
   .replace(/Address:.*/,"Address: "+state.pub)
   .replace(/SOL:.*/,"SOL: "+state.sol.toFixed(6));
 };

 // Budget input
 const panel=document.querySelector(".panel")||document.body;
 const box=document.createElement("div");
 box.innerHTML=`
  <div style="margin-top:12px">
   <label>Budget SOL</label>
   <input id="budgetSol" type="number" step="0.0001" style="width:100%">
   <button id="buyBtn">BUY (prepare)</button>
   <button id="startBtn">START TraderOne</button>
  </div>`;
 panel.appendChild(box);

 document.getElementById("buyBtn").onclick=()=>{
  state.budget=parseFloat(document.getElementById("budgetSol").value||0);
  alert("Budget armé: "+state.budget+" SOL");
 };

 document.getElementById("startBtn").onclick=()=>{
  if(!state.pub||!state.budget){alert("Wallet ou budget manquant");return;}
  alert("TraderOne START\nWallet: "+state.pub+"\nBudget: "+state.budget+" SOL");
 };

});
</script></body>#s
' "$HTML"

nginx -t && systemctl reload nginx
echo "=== WOLVERINE / TRADERONE FINAL OK ==="
echo "CTRL + SHIFT + R OBLIGATOIRE"
BASH
cat >/tmp/WOLVERINE_FIX_START_404.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SVC="traderone.service"
FILE="/opt/traderone-opt/server.js"
TS="$(date +%s)"
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
PAYLOAD='{"wallet":"'"$WALLET"'","budget":1}'

echo "== Backup =="
cp -a "$FILE" "$FILE.bak.$TS"
echo "Backup: $FILE.bak.$TS"
echo

echo "== 1) Cherche des routes start existantes dans server.js =="
grep -nE 'app\.(post|get)\("([^"]*start[^"]*)"' "$FILE" || true
echo

echo "== 2) Test endpoints possibles en LOCAL (127.0.0.1:8585) =="
CANDS=(
  "/api/start"
  "/api/traderone/start"
  "/api/wolverine/start"
  "/traderone/api/start"
  "/wolverine/traderone/api/start"
)
BEST=""
for p in "${CANDS[@]}"; do
  code="$(curl -sS -o /tmp/_start_resp.$$ -w '%{http_code}' \
    -X POST "http://127.0.0.1:8585$p" -H 'Content-Type: application/json' --data "$PAYLOAD" || true)"
  head="$(head -c 120 /tmp/_start_resp.$$ 2>/dev/null || true)"
  echo "$p -> HTTP $code | $head"
  # on prend le premier qui n'est pas 404 (200/400/401/500 = route existe)
  if [ "$code" != "404" ] && [ -z "$BEST" ]; then BEST="$p"; fi
done
rm -f /tmp/_start_resp.$$ 2>/dev/null || true

if [ -z "$BEST" ]; then
  echo
  echo "WARN: aucun endpoint start détecté (tout 404). On va quand même créer /wolverine/traderone/api/start -> /api/start (à toi d’implémenter /api/start si besoin)."
  BEST="/api/start"
fi

echo
echo "== BEST endpoint local trouvé: $BEST =="
echo

echo "== 3) Patch server.js: ajouter alias /wolverine/traderone/api/start (proxy interne) =="
node - <<JS
const fs = require("fs");
const FILE="${FILE}";
let s = fs.readFileSync(FILE,"utf8");

if (!s.includes("WOLVERINE_START_ALIAS_BEGIN")) {
  const m = s.match(/const\s+app\s*=\s*express\(\)\s*;\s*/m);
  if (!m) throw new Error("Cannot find: const app = express();");

  const block = `
/* WOLVERINE_START_ALIAS_BEGIN */
// POST /wolverine/traderone/api/start -> proxy to ${BEST}
app.post("/wolverine/traderone/api/start", (req, res) => {
  const http = require("http");
  const body = JSON.stringify(req.body || {});
  const opts = {
    hostname: "127.0.0.1",
    port: 8585,
    path: "${BEST}",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Content-Length": Buffer.byteLength(body)
    }
  };

  const r = http.request(opts, (p) => {
    res.statusCode = p.statusCode || 502;
    Object.entries(p.headers || {}).forEach(([k,v]) => { if (v !== undefined) res.setHeader(k, v); });
    p.pipe(res);
  });

  r.on("error", (e) => res.status(502).json({ ok:false, error:"proxy_failed", detail:String(e && e.message || e) }));
  r.write(body);
  r.end();
});
/* WOLVERINE_START_ALIAS_END */

`;
  s = s.replace(m[0], m[0] + block);
  console.log("Injected START alias route.");
} else {
  console.log("START alias already present -> skip");
}

fs.writeFileSync(FILE, s, "utf8");
console.log("Patched:", FILE);
JS

echo
echo "== 4) Restart service =="
systemctl restart "$SVC"
sleep 1

echo
echo "== 5) Re-test via PUBLIC URL (doit plus être 404) =="
curl -ksS -D- "https://fireinners.online/wolverine/traderone/api/start" \
  -X POST -H "Content-Type: application/json" --data "$PAYLOAD" | head -n 60
echo
echo "DONE ✅  => Ctrl+F5 /wolverine puis clique START (plus de 404)."
SH

bash /tmp/WOLVERINE_FIX_START_404.sh
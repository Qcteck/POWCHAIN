set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

TARGET="305"
ROOT="/root"
ULT="/root/ultimate_render_${TARGET}_${TS}"
BACK="/root/backup_old_renders_${TS}"

mkdir -p "$ULT" "$BACK"

echo "=== 1) Dépendances (ffmpeg + zip) ==="
apt-get update -y
apt-get install -y ffmpeg zip findutils coreutils

echo "=== 2) Cherche les dossiers qui match *305* (render 305) ==="
mapfile -t DIRS < <(find "$ROOT" -maxdepth 6 -type d 2>/dev/null | grep -E "(${TARGET}|render[_ -]?${TARGET})" | sort -u)

if [ "${#DIRS[@]}" -eq 0 ]; then
  echo "❌ Aucun dossier trouvé avec ${TARGET} sous $ROOT"
  echo "Tip: montre-moi le chemin exact du dossier (ex: /root/bak_renders_machine_xxx/305)"
  exit 1
fi

printf "FOUND:\n"
printf " - %s\n" "${DIRS[@]}"

echo
echo "=== 3) Copie toutes les images vers le dossier ULTIMATE ==="
# (on évite les doublons de noms en préfixant avec un hash du chemin)
i=0
for d in "${DIRS[@]}"; do
  i=$((i+1))
  while IFS= read -r f; do
    base="$(basename "$f")"
    pref="$(echo -n "$d" | md5sum | cut -c1-8)"
    cp -a "$f" "$ULT/${pref}_${base}" || true
  done < <(find "$d" -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) 2>/dev/null)
done

COUNT="$(ls -1 "$ULT" 2>/dev/null | wc -l || true)"
echo "✅ Images dans ULT: $COUNT"
[ "$COUNT" -gt 0 ] || { echo "❌ Aucune image copiée dans $ULT"; exit 1; }

echo
echo "=== 4) Crée un ZIP ultimate ==="
cd "$ULT"
zip -q -r "ultimate_render_${TARGET}.zip" ./*.png ./*.jpg ./*.jpeg 2>/dev/null || true
ls -lah "ultimate_render_${TARGET}.zip" || true

echo
echo "=== 5) Crée une VIDEO ultimate.mp4 (ordre alphabétique) ==="
# Convertit tout en PNG “frame_000001.png …” pour une séquence propre
mkdir -p frames
n=0
for f in $(ls -1 | grep -Ei '\.(png|jpg|jpeg)$' | sort); do
  n=$((n+1))
  printf -v name "frames/frame_%06d.png" "$n"
  # conversion légère si jpg/jpeg
  if echo "$f" | grep -Eiq '\.(jpg|jpeg)$'; then
    ffmpeg -loglevel error -y -i "$f" "$name"
  else
    cp -a "$f" "$name"
  fi
done

# MP4 30fps (change si tu veux)
ffmpeg -y -loglevel error -framerate 30 -i frames/frame_%06d.png \
  -c:v libx264 -pix_fmt yuv420p -movflags +faststart \
  "ultimate_render_${TARGET}.mp4"

ls -lah "ultimate_render_${TARGET}.mp4"

echo
echo "=== 6) Backup + “efface tout le reste” (en déplaçant dans BACKUP) ==="
# On déplace les dossiers sources dans BACK (au lieu de rm direct)
for d in "${DIRS[@]}"; do
  bn="$(basename "$d")"
  dest="$BACK/${bn}__$(echo -n "$d" | md5sum | cut -c1-8)"
  echo "MOVE: $d -> $dest"
  mv "$d" "$dest" || true
done

echo
echo "✅ ULTIMATE gardé ici: $ULT"
echo "   - $ULT/ultimate_render_${TARGET}.mp4"
echo "   - $ULT/ultimate_render_${TARGET}.zip"
echo "✅ ANCIENS renders déplacés ici (backup): $BACK"
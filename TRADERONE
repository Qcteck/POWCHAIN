  chip("chipNET","NET:"+(navigator.onLine?"ONLINE":"OFFLINE"),navigator.onLine?"good":"bad");
  const h=await api("health").then(r=>r.json());
  rpcPrimary=h.rpc.primary; rpcBackup=h.rpc.backup;

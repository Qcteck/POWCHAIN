cat >/root/fix_nginx_wolverine_static.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
OUT_DIR="${OUT_DIR:-/var/www/wolverine}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"

ts="$(date +%Y%m%d_%H%M%S)"
echo "[*] VHOST=$VHOST"
[[ -f "$VHOST" ]] || { echo "[ERR] not found: $VHOST"; exit 1; }

BACKDIR="/etc/nginx/sites-disabled/backup_static_${ts}"
mkdir -p "$BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
echo "[OK] Backup -> $BACKDIR/$(basename "$VHOST")"

perl -0777 -i -pe '
my $out_dir = $ENV{OUT_DIR} // "/var/www/wolverine";
my $start = quotemeta("# === wolverine_next_proxy START ===");
my $end   = quotemeta("# === wolverine_next_proxy END ===");

# 1) remove injected proxy block if present
s/\n\s*$start.*?$end\s*\n/\n/sg;

my @lines = split(/\n/, $_, -1);
my @out;

my $in_srv=0; my $depth=0; my $is_ssl=0;
my $skip_loc=0; my $loc_depth=0;
my $injected=0;

my $alias_block = "    # --- wolverine static export ---\n".
                  "    location ^~ /wolverine/ {\n".
                  "        alias $out_dir/;\n".
                  "        index index.html;\n".
                  "        try_files \\$uri \\$uri/ /wolverine/index.html;\n".
                  "    }\n";

sub brace_delta { my ($s)=@_; my $o=()=($s=~/\{/g); my $c=()=($s=~/\}/g); return $o-$c; }

for (my $i=0; $i<@lines; $i++){
  my $line = $lines[$i];

  # enter server block
  if ($line =~ /^\s*server\s*\{\s*$/) { $in_srv=1; $depth=1; $is_ssl=0; push @out, $line; next; }

  if ($in_srv){
    # track listen 443
    if ($line =~ /listen\s+443/) { $is_ssl=1; }

    # remove any existing location ^~ /wolverine/ { ... } inside ssl server
    if ($is_ssl && !$skip_loc && $line =~ /^\s*location\s+\^~\s+\/wolverine\/\s*\{\s*$/) {
      $skip_loc=1;
      $loc_depth = 1;
      next;
    }
    if ($skip_loc){
      $loc_depth += brace_delta($line);
      if ($loc_depth <= 0){ $skip_loc=0; }
      next;
    }

    # if this is the closing brace of *this* server block, inject before it (only once, ssl server only)
    if ($is_ssl && !$injected && $depth==1 && $line =~ /^\s*\}\s*$/){
      push @out, $alias_block;
      $injected=1;
      push @out, $line;
      $in_srv=0; $depth=0; $is_ssl=0;
      next;
    }

    push @out, $line;
    $depth += brace_delta($line);

    # exit non-ssl server
    if ($depth<=0){ $in_srv=0; $depth=0; $is_ssl=0; }
    next;
  }

  push @out, $line;
}

die "ERR: could not find ssl server (listen 443) to inject\\n" if !$injected;

$_ = join("\n", @out);
' "$VHOST"

echo "[*] nginx -t"
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "Tests:"
echo "  curl -sSI https://${DOMAIN}/wolverine/ | head -n 12"
BASH

chmod +x /root/fix_nginx_wolverine_static.sh
OUT_DIR="/var/www/wolverine" /root/fix_nginx_wolverine_static.sh fireinners.online
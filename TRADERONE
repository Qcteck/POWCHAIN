#!/bin/bash
set -e

# Emplacement de ton fichier index.html existant
HTML_FILE="/var/www/wolverine/index.html"

# Sauvegarde
cp "$HTML_FILE" "${HTML_FILE}.bak.$(date +%Y%m%d_%H%M%S)"

# Insertion des éléments de menu et ajustements
sed -i '/<main id="content">/i \
    <aside id="sidebar"> \
        <div id="logo">WOLVERINE</div> \
        <div class="menu"> \
            <button data-view="dashboard" class="active">Dashboard</button> \
            <button data-view="trade">Trade</button> \
            <button data-view="positions">Positions</button> \
            <button data-view="orders">Orders</button> \
            <button data-view="history">History</button> \
            <button data-view="walletview">Wallet</button> \
            <button data-view="settings">Settings</button> \
            <button data-view="health">Health</button> \
        </div> \
        <div id="wallet"> \
            <button id="connectWallet">Connect Phantom</button> \
            <div id="walletAddr" style="margin-top:8px;font-size:12px;word-break:break-all"></div> \
        </div> \
    </aside>' "$HTML_FILE"

# Ajout du script JavaScript pour activer les menus et le connecteur Phantom
sed -i '/<\/body>/i \
<script> \
const buttons=[...document.querySelectorAll(".menu button")]; \
const views=[...document.querySelectorAll(".view")]; \
buttons.forEach(b=>b.onclick=()=>{buttons.forEach(x=>x.classList.remove("active"));views.forEach(v=>v.classList.remove("active"));b.classList.add("active");document.getElementById(b.dataset.view).classList.add("active");}); \
const btn=document.getElementById("connectWallet"); \
const out=document.getElementById("walletAddr"); \
btn.onclick=async()=>{if(!window.solana||!window.solana.isPhantom){out.textContent="Phantom not installed";return;} \
try{const r=await window.solana.connect();out.textContent=r.publicKey.toString();btn.textContent="Connected";btn.disabled=true;}catch(e){out.textContent="Connection rejected";}}; \
</script>' "$HTML_FILE"

echo "Mise à jour terminée. Les menus et le connecteur Phantom sont maintenant intégrés."
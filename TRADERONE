set -euo pipefail
HTML="/var/www/fireinners/wolverine/index.html"
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"

cp -a "$HTML"  "$HTML.bak.$TS"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backups: $HTML.bak.$TS | $APPJS.bak.$TS"

# 1) HTML: force les buttons en type=button (sinon ça agit weird comme un submit/form)
perl -i -pe 's/<button([^>]*\sid="btnStart"[^>]*)>/<button type="button"$1>/i;
            s/<button([^>]*\sid="btnConnect"[^>]*)>/<button type="button"$1>/i;
            s/<button([^>]*\sid="btnRefresh"[^>]*)>/<button type="button"$1>/i;
            s/<button([^>]*\sid="btnRefreshAll"[^>]*)>/<button type="button"$1>/i;' "$HTML"

# 2) JS: le bouton START ne doit JAMAIS rester disabled après connect + click feedback
node - <<'JS'
const fs=require("fs");
const f="/var/www/fireinners/wolverine/app.js";
let s=fs.readFileSync(f,"utf8");

// Ajoute un helper "updateStartState" + hook events (1 seule fois)
if(!s.includes("WOLVERINE_START_FIX_V1")){
  s += `

/* WOLVERINE_START_FIX_V1 */
(function(){
  const btn = document.getElementById("btnStart");
  if(!btn) return;

  function libsOk(){
    return !!(window.solanaWeb3 && window.solanaWeb3.PublicKey && window.splToken);
  }

  window.updateStartState = function(){
    // START visible en tout temps
    btn.style.display = "";
    btn.style.visibility = "visible";
    btn.style.pointerEvents = "auto";
    btn.style.cursor = "pointer";

    // enabled si wallet connectée + libs OK
    const can = !!(window.pubkey && libsOk());
    btn.disabled = !can;
    btn.style.opacity = can ? "1" : "0.55";
    if(!can){
      (window.setStatus||console.log)(window.pubkey ? "Libs Solana pas prêtes" : "Connecte ton wallet pour activer START");
    }
  };

  // Feedback de clic (même si ça fail après, tu vois que le click est pris)
  btn.addEventListener("click", (ev)=>{
    ev.preventDefault();
    ev.stopPropagation();
    console.log("[START] click");
  }, true);

  // initial
  setTimeout(()=>window.updateStartState && window.updateStartState(), 50);
})();
`;
}

// Après connect: call updateStartState()
s = s.replace(/window\.pubkey\s*=\s*r\.publicKey;\s*/g, (m)=> m + `\n        if(window.updateStartState) window.updateStartState();\n`);

fs.writeFileSync(f,s,"utf8");
console.log("OK: START fix V1 injected");
JS

echo "DONE ✅ Ctrl+F5 sur /wolverine" 
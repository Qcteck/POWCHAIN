set -euo pipefail
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

node - <<'JS'
const fs=require("fs");
const f="/var/www/fireinners/wolverine/app.js";
let s=fs.readFileSync(f,"utf8");

// Inject resolver once
if(!s.includes("WOLVERINE_SPL_AUTODETECT_V1")){
  s += `

/* WOLVERINE_SPL_AUTODETECT_V1 */
window.__getSPL = function(){
  const cands = [window.splToken, window.SplToken, window.spl_token, window.SPLToken, window.spltoken];
  for(const v of cands){
    if(v && typeof v.getAssociatedTokenAddress==="function") return v;
    if(v && v.default && typeof v.default.getAssociatedTokenAddress==="function") return v.default;
  }
  for(const [k,v] of Object.entries(window)){
    if(v && typeof v==="object" &&
       typeof v.getAssociatedTokenAddress==="function" &&
       typeof v.createTransferCheckedInstruction==="function"){
      console.log("[SPL] detected window."+k);
      return v;
    }
    if(v && v.default && typeof v.default==="object" &&
       typeof v.default.getAssociatedTokenAddress==="function"){
      console.log("[SPL] detected window."+k+".default");
      return v.default;
    }
  }
  return null;
};

// Compat: si on détecte, on remplit window.splToken pour le reste du code
try { const x = window.__getSPL(); if(x) window.splToken = x; } catch(e){}
`;
}

// Dans le handler FORCE TX, on remplace le check strict window.splToken par l’auto-detect
s = s.replace(
  /if\(!window\.splToken\s*\|\|\s*typeof window\.splToken\.getAssociatedTokenAddress!=="function"\)\s*\n?\s*throw new Error\("spl-token manquant"\);/g,
  `const SPL = (window.__getSPL && window.__getSPL()) || window.splToken;
    if(!SPL || typeof SPL.getAssociatedTokenAddress!=="function") throw new Error("spl-token manquant");`
);

// Et on remplace les appels window.splToken.* par SPL.* (dans le bloc FORCE TX)
s = s.replace(/window\.splToken\./g, "SPL.");

fs.writeFileSync(f,s,"utf8");
console.log("OK: SPL auto-detect wired into FORCE TX");
JS

echo "DONE ✅ Ctrl+F5 sur /wolverine puis clique START (Phantom doit pop)"
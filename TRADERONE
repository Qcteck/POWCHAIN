cat >/root/nginx_clean_bad_include_and_stub.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_traderone_stub_locations.conf"

[[ -f "$VHOST" ]] || { echo "[ERR] $VHOST introuvable"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$VHOST" "${VHOST}.bak_${ts}"
echo "[OK] Backup -> ${VHOST}.bak_${ts}"

# 1) Recrée le snippet (OK)
mkdir -p /etc/nginx/snippets
cat >"$SNIP" <<'NGINX'
# TraderOne API stubs (prevent UI crash)
location = /wolverine/traderone/api/me {
  default_type application/json;
  return 200 '{"ok":true,"me":{"id":"guest","wallet":null}}';
}
location = /wolverine/traderone/api/positions {
  default_type application/json;
  return 200 '{"ok":true,"positions":[]}';
}
location = /wolverine/traderone/api/orders {
  default_type application/json;
  return 200 '{"ok":true,"orders":[]}';
}
location = /wolverine/traderone/api/pnl {
  default_type application/json;
  return 200 '{"ok":true,"pnl":{"total":0,"daily":0}}';
}
NGINX

# 2) SUPPRIME toutes les lignes include "pourries" liées à nos essais (wolverine/stub/api/*)
# (on garde les autres include du vhost)
sed -i \
  -e '/^[[:space:]]*include[[:space:]].*wolverine.*$/d' \
  -e '/^[[:space:]]*include[[:space:]].*stub.*$/d' \
  -e '/^[[:space:]]*include[[:space:]].*traderone.*$/d' \
  -e '/^[[:space:]]*include[[:space:]].*api\/orders.*$/d' \
  "$VHOST"

# 3) Injecte UN include propre juste avant la dernière "}" du fichier (idempotent)
if ! grep -qF "include $SNIP;" "$VHOST"; then
  perl -0777 -i -pe '
    my $inc = "\n  include /etc/nginx/snippets/wolverine_traderone_stub_locations.conf;\n";
    s/\n\}\s*\z/$inc\n}\n/s;
  ' "$VHOST"
fi

# 4) Test + reload
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
echo "Test:"
echo "  curl -s https://fireinners.online/wolverine/traderone/api/me"
BASH

chmod +x /root/nginx_clean_bad_include_and_stub.sh
/root/nginx_clean_bad_include_and_stub.sh
cat >/root/WOLVERINE_VAULT_ANTI_DUPLICATE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE ANTI-DUPLICATE VAULT GUARD ==="

[ -f "$HTML" ] || { echo "index.html introuvable"; exit 1; }

cp -a "$HTML" "${HTML}.bak_${TS}"

echo "== Injection du guard anti-doublon =="

python3 - <<'PY'
from pathlib import Path

p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

GUARD="""
<script>
document.addEventListener("DOMContentLoaded",()=>{
  const killDup=(title)=>{
    const nodes=[...document.querySelectorAll("h3, h2, h4")]
      .filter(e=>e.textContent.trim().toLowerCase()===title);
    nodes.slice(1).forEach(n=>{
      let box=n.closest("section,div");
      if(box) box.remove();
    });
  };
  killDup("phantom");
  killDup("vault");
});
</script>
"""

if GUARD not in s:
    s=s.replace("</body>",GUARD+"\n</body>")

p.write_text(s)
print("ANTI-DUPLICATE GUARD OK")
PY

echo "== Reload nginx =="
nginx -t && systemctl reload nginx

echo "=== TERMINÉ ==="
echo "CTRL + SHIFT + R obligatoire"
BASH

chmod +x /root/WOLVERINE_VAULT_ANTI_DUPLICATE.sh
/root/WOLVERINE_VAULT_ANTI_DUPLICATE.sh
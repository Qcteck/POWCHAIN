<script>
function init(){
/* ===== REQUIREMENTS ===== */
if(!window.solanaWeb3){document.body.innerHTML="<pre style='color:#fff;padding:16px'>ERR: solana-web3.js not loaded</pre>";return;}
const {Connection,PublicKey,Transaction,SystemProgram} = window.solanaWeb3;

/* ===== CONFIG (RPC primary + fallback) ===== */
const RPC_PRIMARY="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const RPC_BACKUP="https://api.mainnet-beta.solana.com";
const COMMITMENT_SEND="confirmed";
const COMMITMENT_FINAL="finalized";

/* ===== DB ===== */
const KEY="AQUILA_EXEC_V2";
const now=()=>Date.now();
const iso=t=>new Date(t).toISOString();
const load=()=>{try{return JSON.parse(localStorage.getItem(KEY)||"null")}catch(e){return null}};
const save=d=>localStorage.setItem(KEY,JSON.stringify(d));

const DEFAULT_POLICY={
  "KILL_SWITCH": false,
  "ALLOW_ALL_IF_EMPTY": 0,
  "rpc":{"primary":RPC_PRIMARY,"backup":RPC_BACKUP},
  "timeoutsMs":{"send":15000,"confirmFinalized":60000},
  "backoffMs":{"base":400,"max":6000,"jitter":0.2,"retries":6},
  "global":{"maxTxPer24h":6,"maxUsdPer24h":250,"maxLamportsPer24h":2000000},
  "pairs":[
    {"name":"SOL->TREASURY_MICRO","direction":"OUT","toPubkey":"11111111111111111111111111111111","maxLamportsPerTx":20000,"maxTxPer24h":3}
  ]
};

let DB=load()||{
  v:2,
  arm:false,
  auto:false,
  cycle:0,
  goals:["Protection trésorerie","Exécution stricte (policy + quota + finalized)"],
  policy:DEFAULT_POLICY,
  usage:{dayKey:"",txCount24h:0,lamports24h:0,usd24h:0,byPair:{}},
  pending:null,
  lastSig:"",
  audit:[]
};
save(DB);

/* ===== UI ===== */
const $=id=>document.getElementById(id);
const log=(t)=>{DB.audit.push("["+iso(now())+"] "+t); if(DB.audit.length>400)DB.audit=DB.audit.slice(-300); save(DB); render();};
const badge=(el,txt,ok)=>{el.textContent=txt; el.style.borderColor=ok?"#3cff9e":"#ff4d4d"; el.style.color=ok?"#b7ffe1":"#ffb3b3";};

function dayKey(){const d=new Date(); return d.getUTCFullYear()+"-"+String(d.getUTCMonth()+1).padStart(2,"0")+"-"+String(d.getUTCDate()).padStart(2,"0");}
function rollUsageIfNeeded(){
  const dk=dayKey();
  if(DB.usage.dayKey!==dk){DB.usage={dayKey:dk,txCount24h:0,lamports24h:0,usd24h:0,byPair:{}}; save(DB);}
}

function render(){
  rollUsageIfNeeded();
  $("cycle").textContent=DB.cycle;
  badge($("arm"), DB.arm?"ON":"OFF", DB.arm);
  badge($("auto"), DB.auto?"ON":"OFF", DB.auto);
  badge($("kill"), (DB.policy&&DB.policy.KILL_SWITCH)?"ON":"OFF", !(DB.policy&&DB.policy.KILL_SWITCH));
  $("goals").innerHTML=DB.goals.map(g=>"• "+escapeHtml(g)).join("<br>");
  $("policyText").value=JSON.stringify(DB.policy||DEFAULT_POLICY,null,2);

  const p=DB.pending;
  $("pendingLine").textContent=p?(`${p.status} • ${p.pendingId} • ${p.pair||"-"} • ${p.lamports||0} lamports`):"—";
  $("lastSig").textContent=DB.lastSig||"—";
  $("usageLine").textContent=`${DB.usage.txCount24h} tx / 24h • ${DB.usage.lamports24h} lamports • pairs=${Object.keys(DB.usage.byPair||{}).length}`;

  $("prop").textContent=p?JSON.stringify(p,null,2):"(aucun pending)";
  $("audit").textContent=(DB.audit||[]).slice(-80).join("\n");

  $("rpcLabel").textContent=(DB.policy&&DB.policy.rpc)?("primary="+short(DB.policy.rpc.primary)+" • backup="+short(DB.policy.rpc.backup)):"—";

  const canApprove = !!(DB.pending && (DB.pending.status==="PROPOSED"||DB.pending.status==="APPROVED"||DB.pending.status==="SIGNED"||DB.pending.status==="SENT"||DB.pending.status==="TIMEOUT"));
  $("approve").disabled = !canApprove;
  $("retryConfirm").disabled = !(DB.pending && (DB.pending.signature && (DB.pending.status==="SENT"||DB.pending.status==="TIMEOUT")));
}
render();

function escapeHtml(s){return (s||"").replace(/[&<>"']/g,c=>({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));}
function short(u){return (u||"").replace(/^https?:\/\//,"").slice(0,36)+(u&&u.length>36?"…":"");}
function randId(n=12){const a=new Uint8Array(n); crypto.getRandomValues(a); return Array.from(a).map(x=>x.toString(16).padStart(2,"0")).join("");}
async function sha256Hex(str){const b=new TextEncoder().encode(str); const h=await crypto.subtle.digest("SHA-256",b); return Array.from(new Uint8Array(h)).map(x=>x.toString(16).padStart(2,"0")).join("");}

/* ===== WALLET ===== */
let provider=null,pubkey=null;
$("connect").onclick=async()=>{
  if(!window.solana) return alert("Phantom requis");
  provider=window.solana;
  const r=await provider.connect();
  pubkey=r.publicKey.toString();
  $("walletState").textContent="Connecté";
  $("walletPub").textContent=pubkey;
  log("Wallet connecté: "+pubkey);
};
$("disconnect").onclick=async()=>{
  try{ if(provider&&provider.disconnect) await provider.disconnect(); }catch(e){}
  provider=null; pubkey=null;
  $("walletState").textContent="Déconnecté";
  $("walletPub").textContent="—";
  log("Wallet déconnecté");
};

/* ===== POLICY PARSE + VALIDATE ===== */
function parsePolicy(txt){
  let p=null;
  try{ p=JSON.parse(txt); }catch(e){ throw new Error("JSON invalide"); }
  if(!p) throw new Error("Policy vide");
  if(p.ALLOW_ALL_IF_EMPTY!==0 && p.ALLOW_ALL_IF_EMPTY!==1) throw new Error("ALLOW_ALL_IF_EMPTY doit être 0/1");
  if(!p.pairs || !Array.isArray(p.pairs)) throw new Error("pairs[] requis");
  return p;
}
function isAllowlisted(pending){
  const pol=DB.policy||DEFAULT_POLICY;
  const pairs=(pol.pairs||[]);
  if(!pairs.length && pol.ALLOW_ALL_IF_EMPTY===0) return {ok:false,why:"ALLOWLIST vide (deny-by-default)"};
  const rule=pairs.find(x=>x && x.name===pending.pair);
  if(!rule) return {ok:false,why:"pair non allowlistée"};
  if(rule.direction!=="OUT") return {ok:false,why:"direction non autorisée"};
  if(rule.toPubkey!==pending.toPubkey) return {ok:false,why:"toPubkey mismatch"};
  if(pending.lamports>Number(rule.maxLamportsPerTx||0)) return {ok:false,why:"maxLamportsPerTx dépassé"};
  return {ok:true,rule};
}
function canConsumeQuota(pending){
  rollUsageIfNeeded();
  const pol=DB.policy||DEFAULT_POLICY;
  const g=pol.global||{};
  if(DB.usage.txCount24h>=Number(g.maxTxPer24h||0)) return {ok:false,why:"global maxTxPer24h atteint"};
  if(DB.usage.lamports24h + pending.lamports > Number(g.maxLamportsPer24h||0)) return {ok:false,why:"global maxLamportsPer24h atteint"};
  const pairKey=pending.pair;
  const by=DB.usage.byPair||{};
  const cur=by[pairKey]||{tx:0,lamports:0};
  const allow=(pol.pairs||[]).find(x=>x && x.name===pairKey);
  const maxPair=Number((allow&&allow.maxTxPer24h)||0);
  if(maxPair && cur.tx>=maxPair) return {ok:false,why:"pair maxTxPer24h atteint"};
  return {ok:true};
}
function consumeQuotaAfterFinalized(pending){
  rollUsageIfNeeded();
  const pairKey=pending.pair;
  DB.usage.txCount24h += 1;
  DB.usage.lamports24h += pending.lamports;
  if(!DB.usage.byPair[pairKey]) DB.usage.byPair[pairKey]={tx:0,lamports:0};
  DB.usage.byPair[pairKey].tx += 1;
  DB.usage.byPair[pairKey].lamports += pending.lamports;
  save(DB);
}

/* ===== CONTROLES ===== */
$("armBtn").onclick=()=>{DB.arm=true; save(DB); log("ARM activé");};
$("disarmBtn").onclick=()=>{DB.arm=false; DB.auto=false; save(DB); log("DISARM"); render();};
$("autoBtn").onclick=()=>{DB.auto=!DB.auto; save(DB); log("AUTO "+(DB.auto?"ON":"OFF"));};
$("killBtn").onclick=()=>{DB.policy=DB.policy||DEFAULT_POLICY; DB.policy.KILL_SWITCH=!DB.policy.KILL_SWITCH; save(DB); log("KILL_SWITCH "+(DB.policy.KILL_SWITCH?"ON":"OFF"));};
$("addGoal").onclick=()=>{const v=$("goalInput").value.trim(); if(v){DB.goals.push(v); $("goalInput").value=""; save(DB); log("Objectif ajouté: "+v);} };

$("savePolicy").onclick=()=>{
  try{
    const p=parsePolicy($("policyText").value);
    if(p.ALLOW_ALL_IF_EMPTY===0 && (!p.pairs || !p.pairs.length)) log("WARN policy: allowlist vide avec deny-by-default");
    DB.policy=p; save(DB); log("Policy sauvegardée");
  }catch(e){ alert("ERR policy: "+e.message); }
  render();
};
$("resetPolicy").onclick=()=>{DB.policy=DEFAULT_POLICY; save(DB); log("Policy reset"); render();};

$("clearPending").onclick=()=>{DB.pending=null; save(DB); log("Pending cleared"); render();};

/* ===== EXECUTION CORE ===== */
function mkConn(){
  const pol=DB.policy||DEFAULT_POLICY;
  const primary=(pol.rpc&&pol.rpc.primary)||RPC_PRIMARY;
  const backup=(pol.rpc&&pol.rpc.backup)||RPC_BACKUP;
  const c1=new Connection(primary,COMMITMENT_SEND);
  const c2=new Connection(backup,COMMITMENT_SEND);
  return {primary,backup,c1,c2};
}
function backoffPlan(){
  const pol=DB.policy||DEFAULT_POLICY;
  const b=pol.backoffMs||{};
  return {base:+(b.base||400),max:+(b.max||6000),jitter:+(b.jitter||0.2),retries:+(b.retries||6)};
}
function sleep(ms){return new Promise(r=>setTimeout(r,ms));}
async function withRetry(label, fn){
  const p=backoffPlan();
  let lastErr=null;
  for(let i=0;i<=p.retries;i++){
    try{ return await fn(i); }catch(e){
      lastErr=e; 
      const raw=p.base*Math.pow(2,i);
      const jitter=raw*(Math.random()*p.jitter);
      const wait=Math.min(p.max, raw + jitter);
      log("RETRY "+label+" attempt="+i+" err="+(e&&e.message?e.message:String(e))+" wait="+Math.round(wait)+"ms");
      await sleep(wait);
    }
  }
  throw lastErr||new Error("retry failed: "+label);
}

async function proposeOnce(){
  rollUsageIfNeeded();
  const pol=DB.policy||DEFAULT_POLICY;
  if(pol.KILL_SWITCH) { log("BLOCKED: KILL_SWITCH=ON"); return; }
  if(DB.pending && (DB.pending.status==="PROPOSED"||DB.pending.status==="APPROVED"||DB.pending.status==="SIGNED"||DB.pending.status==="SENT"||DB.pending.status==="TIMEOUT")) {
    log("Pending existe déjà (idempotence): "+DB.pending.pendingId);
    render(); return;
  }
  const rule=((pol.pairs||[])[0])||null;
  if(!rule && pol.ALLOW_ALL_IF_EMPTY===0){ log("BLOCKED: allowlist vide (deny-by-default)"); return; }
  const pair=rule?rule.name:"UNSPECIFIED";
  const toPubkey=rule?rule.toPubkey:"11111111111111111111111111111111";
  const lamports=Math.min(1000, Number(rule&&rule.maxLamportsPerTx)||1000); // micro action par défaut
  const pendingId=randId(12);
  const payload={pair,toPubkey,lamports,ts:now()};
  const payloadHash=await sha256Hex(JSON.stringify(payload));
  DB.pending={
    pendingId,
    status:"PROPOSED",
    createdAt:now(),
    pair,
    toPubkey,
    lamports,
    payloadHash,
    signature:"",
    sendRpc:"",
    lastError:"",
    steps:[{t:now(),s:"PROPOSED"}]
  };
  save(DB);
  log("Proposition créée: "+pendingId+" hash="+payloadHash.slice(0,16)+"…");
  render();
}

$("proposeNow").onclick=()=>proposeOnce();

async function buildTx(fromPub, toPub, lamports, conn){
  const {blockhash,lastValidBlockHeight}=await conn.getLatestBlockhash(COMMITMENT_SEND);
  const tx=new Transaction().add(SystemProgram.transfer({fromPubkey:new PublicKey(fromPub),toPubkey:new PublicKey(toPub),lamports}));
  tx.feePayer=new PublicKey(fromPub);
  tx.recentBlockhash=blockhash;
  return {tx,blockhash,lastValidBlockHeight};
}

async function sendAndConfirmFinalized(){
  const pol=DB.policy||DEFAULT_POLICY;
  if(pol.KILL_SWITCH) throw new Error("KILL_SWITCH=ON");
  if(!DB.arm) throw new Error("ARM requis");
  if(!provider || !pubkey) throw new Error("Wallet requis");
  if(!DB.pending) throw new Error("Aucun pending");
  const pending=DB.pending;

  // allowlist + quota gating (quota consumed only after FINALIZED)
  const a=isAllowlisted(pending); if(!a.ok) throw new Error("ALLOWLIST: "+a.why);
  const q=canConsumeQuota(pending); if(!q.ok) throw new Error("QUOTA: "+q.why);

  // idempotence: if already has signature -> skip sign/send, only confirm
  const {c1,c2,primary,backup}=mkConn();
  const connPrimary=c1, connBackup=c2;

  // Build once per attempt if we still need to sign
  if(!pending.signature){
    pending.status="APPROVED"; pending.steps.push({t:now(),s:"APPROVED"}); save(DB); render();
    const {tx,blockhash,lastValidBlockHeight}=await withRetry("getLatestBlockhash", async()=>await buildTx(pubkey,pending.toPubkey,pending.lamports,connPrimary).catch(async()=>await buildTx(pubkey,pending.toPubkey,pending.lamports,connBackup)));
    pending.blockhash=blockhash; pending.lastValidBlockHeight=lastValidBlockHeight;

    let signed=null;
    try{
      signed=await provider.signTransaction(tx);
    }catch(e){
      pending.status="FAILED"; pending.lastError="USER_REJECT_OR_SIGN_FAIL"; pending.steps.push({t:now(),s:"SIGN_FAILED"}); save(DB);
      throw new Error("SIGN: refusé/échoué");
    }
    pending.status="SIGNED"; pending.steps.push({t:now(),s:"SIGNED"}); save(DB); render();

    // sendRawTransaction with retry + fallback RPC
    const raw=signed.serialize();
    const sig=await withRetry("sendRawTransaction", async()=>{
      try{ pending.sendRpc=primary; save(DB); return await connPrimary.sendRawTransaction(raw,{skipPreflight:false,maxRetries:0}); }
      catch(e1){ pending.sendRpc=backup; save(DB); return await connBackup.sendRawTransaction(raw,{skipPreflight:false,maxRetries:0}); }
    });
    pending.signature=sig;
    DB.lastSig=sig;
    pending.status="SENT"; pending.steps.push({t:now(),s:"SENT",sig}); save(DB); render();
    log("TX envoyée: "+sig);
  }

  // confirm finalized with explicit states + timeout
  const sig=pending.signature;
  const confirmTimeout=+(pol.timeoutsMs&&pol.timeoutsMs.confirmFinalized)||60000;
  const started=now();
  pending.status="CONFIRMING"; pending.steps.push({t:now(),s:"CONFIRMING"}); save(DB); render();

  // Use confirmTransaction with blockhash context if available, else fallback to polling
  const tryConfirm=async(conn)=>{
    if(pending.blockhash && pending.lastValidBlockHeight){
      return await conn.confirmTransaction({signature:sig,blockhash:pending.blockhash,lastValidBlockHeight:pending.lastValidBlockHeight},COMMITMENT_FINAL);
    }
    return await conn.confirmTransaction(sig,COMMITMENT_FINAL);
  };

  while(true){
    const elapsed=now()-started;
    if(elapsed>confirmTimeout){
      pending.status="TIMEOUT"; pending.lastError="CONFIRM_TIMEOUT"; pending.steps.push({t:now(),s:"TIMEOUT"}); save(DB); render();
      log("TIMEOUT confirm finalized (retry possible) sig="+sig);
      return;
    }

    // attempt confirm on primary then backup
    try{
      await withRetry("confirmTransaction", async()=>await tryConfirm(connPrimary).catch(async()=>await tryConfirm(connBackup)));
      // extra: verify status explicitly
      const st=await connPrimary.getSignatureStatuses([sig],{searchTransactionHistory:true}).catch(async()=>await connBackup.getSignatureStatuses([sig],{searchTransactionHistory:true}));
      const info=st && st.value && st.value[0];
      const conf=info && info.confirmationStatus;
      if(conf==="finalized" || conf==="confirmed"){
        pending.status = (conf==="finalized") ? "FINALIZED" : "CONFIRMED";
        pending.steps.push({t:now(),s:pending.status,conf});
        save(DB); render();
        if(pending.status==="FINALIZED"){
          consumeQuotaAfterFinalized(pending);
          log("FINALIZED: quota consommé. sig="+sig);
          // close pending to prevent replay
          pending.closedAt=now();
          pending.status="DONE";
          pending.steps.push({t:now(),s:"DONE"});
          save(DB); render();
        }else{
          log("CONFIRMED (pas finalized): sig="+sig);
        }
        return;
      }
    }catch(e){
      // detect dropped / blockhash expired / RPC errors
      const msg=(e&&e.message)?e.message:String(e);
      pending.lastError=msg.slice(0,220);
      save(DB); render();
    }

    // lightweight poll: status check to detect dropped
    try{
      const st=await connPrimary.getSignatureStatuses([sig],{searchTransactionHistory:true}).catch(async()=>await connBackup.getSignatureStatuses([sig],{searchTransactionHistory:true}));
      const info=st && st.value && st.value[0];
      if(info && info.err){
        pending.status="FAILED"; pending.lastError="ONCHAIN_ERR"; pending.steps.push({t:now(),s:"FAILED",err:info.err}); save(DB); render();
        log("FAILED onchain: "+JSON.stringify(info.err));
        return;
      }
      // dropped heuristic: past lastValidBlockHeight without finalized/confirmed
      if(pending.lastValidBlockHeight){
        const h=await connPrimary.getBlockHeight(COMMITMENT_SEND).catch(async()=>await connBackup.getBlockHeight(COMMITMENT_SEND));
        if(h && h>pending.lastValidBlockHeight+5){
          pending.status="DROPPED"; pending.lastError="BLOCKHASH_EXPIRED_OR_DROPPED"; pending.steps.push({t:now(),s:"DROPPED"}); save(DB); render();
          log("DROPPED (blockhash expired): sig="+sig);
          return;
        }
      }
    }catch(_e){}
    await sleep(900);
  }
}

$("approve").onclick=async()=>{
  try{ await sendAndConfirmFinalized(); }
  catch(e){
    DB.pending=DB.pending||null;
    if(DB.pending){
      DB.pending.status="FAILED";
      DB.pending.lastError=(e&&e.message)?e.message:String(e);
      DB.pending.steps.push({t:now(),s:"FAILED",err:DB.pending.lastError});
      save(DB);
    }
    log("ERR approve: "+((e&&e.message)?e.message:String(e)));
    render();
  }
};

$("reject").onclick=()=>{
  if(!DB.pending) return;
  DB.pending.status="REJECTED";
  DB.pending.closedAt=now();
  DB.pending.steps.push({t:now(),s:"REJECTED"});
  save(DB);
  log("Proposition rejetée: "+DB.pending.pendingId);
  DB.pending=null; save(DB); render();
};

$("retryConfirm").onclick=async()=>{
  try{
    if(!DB.pending || !DB.pending.signature) return alert("Aucune signature à confirmer");
    // keep pending and re-run confirm loop only
    DB.pending.status="SENT"; save(DB); render();
    await sendAndConfirmFinalized();
  }catch(e){
    log("ERR retryConfirm: "+((e&&e.message)?e.message:String(e)));
    render();
  }
};

/* ===== AUTO LOOP (safe) ===== */
setInterval(async()=>{
  try{
    if(!DB.arm || !DB.auto) return;
    DB.cycle+=1; save(DB);
    // propose only if no active pending
    if(!DB.pending) await proposeOnce();
  }catch(e){ log("AUTO ERR: "+((e&&e.message)?e.message:String(e))); }
  render();
},6000);

log("AQUILA ready (pinned web3 + policy deny-by-default + finalized confirm)");
render();
}
</script>
</body></html>
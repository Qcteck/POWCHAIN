async function execApprovedTransfer(p){
  if(!ARM) return alert("ARM requis");
  if(!pub||!provider) return alert("wallet requis");
  if(p.kind!=="TRANSFER_SOL") return alert("kind mismatch");
  const {from,to,lamports}=p.payload||{};
  if(from!==pub) return alert("pending.from != wallet");
  log("prepare_transfer pendingId="+p.id);

  const prep=await post("exec/prepare_transfer",{pendingId:p.id,from,to,lamports,clientId:"browser"}).then(r=>r.json());
  if(!prep.ok){log("prepare denied "+JSON.stringify(prep));return alert("prepare denied: "+(prep.err||""));}

  const conn=new Connection(pickRPC(),"confirmed");
  let bh=null;
  try{bh=await conn.getLatestBlockhash();}catch(e){log("getLatestBlockhash failed"); throw e;}

  const tx=new Transaction().add(SystemProgram.transfer({fromPubkey:new PublicKey(from),toPubkey:new PublicKey(to),lamports:Number(lamports)}));
  tx.feePayer=new PublicKey(from);
  tx.recentBlockhash=bh.blockhash;

  let signed=null;
  try{signed=await provider.signTransaction(tx);}catch(e){log("user rejected / sign failed"); return alert("signature refusée");}

  let sig=null;
  try{sig=await conn.sendRawTransaction(signed.serialize(),{skipPreflight:false,maxRetries:3});}
  catch(e){log("sendRawTransaction failed: "+String(e)); return alert("send error");}

  log("sent txid "+seen(sig));
  const committed=await commitWithStates(prep,p.id,sig);
  if(committed.ok) log("COMMIT OK FINALIZED "+sig);
  else log("COMMIT FAIL "+JSON.stringify(committed));
}

const seen=s=>String(s||"").slice(0,6)+"…"+String(s||"").slice(-6);

async function commitWithStates(prep,pendingId,txid){
  log("commit (server confirm finalized) ...");
  const r=await post("exec/commit",{pendingId,prepId:prep.prepId,prepHash:prep.prepHash,txid}).then(async resp=>{
    const j=await resp.json().catch(()=>({ok:false,st:"BAD_JSON"}));
    if(resp.ok) return j;
    return j;
  });
  if(r.ok){alert("FINALIZED: "+txid);return r;}
  if(r.st==="TIMEOUT"){alert("TIMEOUT: tx peut être pending. Réessaie COMMIT.");return r;}
  if(r.st==="FAILED"){alert("FAILED (on-chain error).");return r;}
  alert("NOT FINALIZED: "+(r.st||"ERR"));return r;
}


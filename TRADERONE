bash -s <<'SH'
set -euo pipefail
TS="$(date +%s)"
SITE="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SITESEN="/etc/nginx/sites-enabled"
WEBROOT="/opt/fireinners/frontend-react/app/dist"
WOLVDIR="$WEBROOT/wolverine"
INDEX="$WOLVDIR/index.html"
DISABLED_DIR="/root/nginx_disabled"
WBACK="/root/wolv_backups"
MARK_BEGIN="# BEGIN WOLVERINE_BLOCK"
MARK_END="# END WOLVERINE_BLOCK"

log(){ echo "[MEGA_WOLV] $*"; }
die(){ echo "[MEGA_WOLV][ERR] $*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "Lance en root."
[ -f "$VHOST" ] || die "Vhost introuvable: $VHOST"

mkdir -p "$WOLVDIR" "$DISABLED_DIR" "$WBACK"

# 1) Backup + write UI
if [ -f "$INDEX" ]; then
  cp -a "$INDEX" "$WBACK/index.html.bak.$TS" || true
  log "Backup UI: $WBACK/index.html.bak.$TS"
fi

cat > "$INDEX" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE</title><style>:root{--bg:rgba(6,16,39,0.85);--bg-light:rgba(240,240,240,0.85);--text:#f0f0f0;--text-dark:#222;--m:#c0c8e0;--ok:#86ffd0;--bad:#ff7b7b}*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,-apple-system,Segoe UI,Roboto}html,body{height:100%;background:radial-gradient(1100px 600px at 20% 0%,rgba(10,19,40,0.7) 0%,transparent 60%),radial-gradient(900px 520px at 80% 20%,rgba(16,26,51,0.7) 0%,transparent 55%),var(--bg);color:var(--text)}body.light{background:var(--bg-light);color:var(--text-dark)}#wrap{max-width:1200px;margin:18px auto;padding:16px;display:flex;flex-direction:column;gap:14px;background:rgba(0,0,0,0.2);border-radius:18px}#bar{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.12);box-shadow:0 10px 40px rgba(255,255,255,0.05)}#logo{width:50px;height:50px;border-radius:12px;background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.7),rgba(255,255,255,0) 60%),linear-gradient(135deg,rgba(255,255,255,.22),rgba(0,0,0,0));border:1px solid rgba(255,255,255,0.1);position:relative}#logo:before{content:"";position:absolute;inset:-10px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,0.25) 0%,transparent 60%)}#title{font-weight:800;letter-spacing:.6px}#sub{color:var(--m);font-size:12px;margin-top:2px}#topBtns{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}button{padding:8px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.18);cursor:pointer;user-select:none;transition:all 0.15s;background:rgba(255,255,255,0.15);color:#fff}button:hover{border-color:rgba(255,255,255,.35);transform:translateY(-1px)}button:active{transform:translateY(1px)}.primary{background:linear-gradient(135deg,rgba(255,255,255,0.8),rgba(238,238,238,0.8));color:#000;border-color:rgba(255,255,255,.28)}.danger{background:linear-gradient(135deg,rgba(255,74,74,0.8),rgba(176,16,16,0.8));border-color:rgba(255,190,190,.28)}.ghost{opacity:.7}#grid{display:grid;grid-template-columns:1.05fr .95fr;gap:14px}#card,#console{border-radius:18px;background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,.12);box-shadow:0 10px 40px rgba(255,255,255,.05)}#card{padding:14px 14px 16px;display:flex;flex-direction:column;gap:12px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:6px 0}label{display:block;color:var(--m);font-size:12px;margin-bottom:4px}input,select{width:100%;padding:10px 12px;border-radius:14px;background:rgba(0,0,0,.15);border:1px solid rgba(255,255,255,.16);color:var(--text);outline:none}input:focus,select:focus{border-color:rgba(255,255,255,.35)}.col{flex:1;min-width:220px}.mini{min-width:160px}.kpi{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}.box{padding:10px 12px;border-radius:14px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,.14)}.box b{display:block;font-size:12px;color:var(--m);font-weight:600}.box span{display:block;margin-top:4px;font-size:13px}#console{padding:14px 14px 16px}h3{font-size:14px;letter-spacing:.3px}#log{height:300px;overflow:auto;padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;white-space:pre-wrap;color:#fff}#foot{margin-top:10px;color:var(--m);font-size:12px;display:flex;gap:12px;flex-wrap:wrap}#dot{display:inline-block;width:8px;height:8px;border-radius:99px;background:#666}#dot.ok{background:var(--ok)}#dot.bad{background:var(--bad)}#settingsPanel{position:fixed;top:50px;right:20px;width:220px;padding:14px;background:rgba(0,0,0,.6);border-radius:14px;display:none;flex-direction:column;gap:8px;z-index:999}#settingsPanel label{color:var(--text);font-size:12px}#settingsPanel select,input[type=color]{width:100%;margin-bottom:6px}@media(max-width:980px){#grid{grid-template-columns:1fr}}</style></head><body><div id="wrap"><div id="bar"><div id="logo"></div><div><div id="title">WOLVERINE</div><div id="sub">TraderOne • UI intégrée</div></div><div id="topBtns"><button id="bPing" class="ghost">Ping</button><button id="bRefresh" class="ghost">Refresh</button><button id="bSettings" class="ghost">Settings</button><button id="bStart" class="primary">Start</button><button id="bStop" class="danger">Stop</button></div></div><div id="grid"><div id="card"><h3>Contrôle Wallet</h3><div class="row"><div class="col mini"><label>Wallet (Phantom)</label><div class="row" style="margin:0"><button id="bConnect" class="primary">Connect</button><button id="bDisconnect">Disconnect</button></div></div><div class="col"><label>Adresse Phantom</label><input id="addr" placeholder="non connecté" readonly></div></div><div class="kpi"><div class="box"><b>SOL</b><span id="sol">-</span></div><div class="box"><b>USDC</b><span id="usdc">-</span></div><div class="box"><b>Custody</b><span id="cust">-</span></div></div><div class="row"><div class="col"><label>Budget (USDC)</label><input id="budget" inputmode="decimal" placeholder="ex: 50"></div><div class="col"><label>Mode</label><select id="mode"><option value="safe">SAFE</option><option value="risk">RISK</option><option value="manual">MANUAL</option></select></div></div><div class="row"><div class="col"><label>Mint (si manuel)</label><input id="mint" placeholder="SPL mint (solana)"></div><div class="col mini"><label>Auto refresh</label><select id="auto"><option value="on">ON</option><option value="off">OFF</option></select></div></div></div><div id="console"><h3>Console</h3><div id="log"></div><div id="foot"><span><i id="dot"></i> <span id="apiState">API: ?</span></span><span>Dernier refresh: <span id="last">-</span></span><span>Erreurs: <span id="errs">0</span></span><span>Latence: <span id="lat">-</span></span></div></div></div></div><div id="settingsPanel"><label>Thème</label><select id="themeSelect"><option value="dark">Sombre</option><option value="light">Clair</option></select><label>Auto-refresh</label><select id="autoSelect"><option value="on">ON</option><option value="off">OFF</option></select><hr style="border:none;border-top:1px solid rgba(255,255,255,.2);margin:6px 0"><label>Couleur de fond</label><input type="color" id="colorBg" value="#061027"><label>Couleur cartes / console</label><input type="color" id="colorCard" value="#000000"><label>Couleur boutons</label><input type="color" id="colorBtn" value="#ffffff"><label>Couleur contours</label><input type="color" id="colorBorder" value="#ffffff"></div><script>(()=>{const $=s=>document.querySelector(s);const logEl=$("#log"),dot=$("#dot"),apiState=$("#apiState");let errs=0,autoTimer=0,running=false,connected=false;function now(){return new Date().toISOString().replace("T"," ").replace("Z"," UTC")}function log(m){logEl.textContent+=`[${now()}] ${m}\n`;logEl.scrollTop=logEl.scrollHeight}function setErr(){errs++;$("#errs").textContent=String(errs)}function setLat(ms){$("#lat").textContent=(ms>=0?`${ms}ms`:"-")}function setLast(){$("#last").textContent=now()}function hexToRgba(hex,a=1){let c;if(/^#([A-Fa-f0-9]{3}){1,2}$/.test(hex)){c=hex.substring(1).split('');if(c.length==3)c=[c[0],c[0],c[1],c[1],c[2],c[2]];c='0x'+c.join('');return`rgba(${(c>>16)&255},${(c>>8)&255},${c&255},${a})`}return hex}function applyColors(p){if(p.bg)document.documentElement.style.setProperty('--bg',p.bg);if(p.card)document.querySelectorAll('#card,#console').forEach(el=>{el.style.background=hexToRgba(p.card,0.2)});if(p.btn)document.querySelectorAll('button').forEach(el=>{el.style.background=hexToRgba(p.btn,0.15)});if(p.border)document.querySelectorAll('#card,#console,button').forEach(el=>{el.style.borderColor=hexToRgba(p.border,0.18)})}function savePrefs(p){localStorage.setItem("wolvPrefs",JSON.stringify(p))}function loadPrefs(){return JSON.parse(localStorage.getItem("wolvPrefs")||"{}")}function updateButtons(){$("#bConnect").disabled=connected;$("#bDisconnect").disabled=!connected;$("#bStart").disabled=!connected||running;$("#bStop").disabled=!running}async function connect(){try{const p=window.solana;if(!p||!p.isPhantom){log("Phantom introuvable");setErr();return}const res=await p.connect();$("#addr").value=res.publicKey.toString();log("Phantom connecté");connected=true;updateButtons()}catch(e){setErr();log("Phantom connect error")}}async function disconnect(){try{const p=window.solana;if(p&&p.disconnect)await p.disconnect();$("#addr").value="";log("Phantom déconnecté");connected=false;updateButtons()}catch(e){setErr();log("Phantom disconnect error")}}async function apiPost(path,obj){try{const r=await fetch("/wolverine/api"+path,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(obj||{}),cache:"no-store"});const txt=await r.text();let out=null;try{out=JSON.parse(txt)}catch(_){out={raw:txt}}return{ok:r.ok,status:r.status,data:out}}catch(e){setErr();return{ok:false,status:0,data:{err:"fetch"}}}}function pickNum(v){if(v===null||v===undefined)return null;const n=Number(v);return Number.isFinite(n)?n:null}function fmt(v){const n=pickNum(v);return n===null?"-":(Math.round(n*100000)/100000).toString()}function dig(o,keys){for(const k of keys){try{let cur=o;for(const p of k.split(".")){if(!cur||!(p in cur)){cur=null;break}cur=cur[p]}if(cur!==null&&cur!==undefined)return cur}catch(_){}}return null}async function refresh(){try{const t0=performance.now();const r=await fetch("/wolverine/api/ping",{cache:"no-store"});const tx=await r.text();setLat(Math.round(performance.now()-t0));dot.className=tx.trim()==="pong"?"ok":"bad";apiState.textContent="API: "+tx.trim();log("ping: "+tx.trim());setLast()}catch(e){setErr();dot.className="bad";apiState.textContent="API: ERR";log("ping error")}try{const rb=await fetch("/wolverine/api/balances2",{cache:"no-store"});const tb=await rb.text();let j=null;try{j=JSON.parse(tb)}catch(_){j=null}if(j){const sol=dig(j,["user.sol","userSol","sol","wallet.sol"]);const usdc=dig(j,["user.usdc","userUsdc","usdc","wallet.usdc"]);const cust=dig(j,["bot.usdc","botUsdc","custody.usdc","custodyUsdc","cust"]);$("#sol").textContent=fmt(sol);$("#usdc").textContent=fmt(usdc);$("#cust").textContent=fmt(cust);log("balances2: "+JSON.stringify(j).slice(0,800))}else{log("balances2 non-json: "+tb.slice(0,400))}}catch(_){log("balances2: ERR")}}async function start(){running=true;updateButtons();const payload={budgetUsdc:parseFloat($("#budget").value)||0,mode:$("#mode").value,mint:$("#mint").value.trim(),phantomPubkey:$("#addr").value,ts:Date.now()};const r=await apiPost("/start",payload);log("start: "+JSON.stringify(r));if(!r.ok)setErr()}async function stop(){running=false;updateButtons();const r=await apiPost("/stop",{ts:Date.now()});log("stop: "+JSON.stringify(r));if(!r.ok)setErr()}function autoSet(){clearInterval(autoTimer);autoTimer=0;if($("#auto").value==="on")autoTimer=setInterval(()=>refresh().catch(()=>0),8000)}$("#bConnect").onclick=connect;$("#bDisconnect").onclick=disconnect;$("#bStart").onclick=start;$("#bStop").onclick=stop;$("#bPing").onclick=refresh;$("#bRefresh").onclick=refresh;$("#bSettings").onclick=()=>$("#settingsPanel").style.display=$("#settingsPanel").style.display==="flex"?"none":"flex";$("#themeSelect").onchange=e=>{document.body.className=e.target.value;savePrefs({...loadPrefs(),theme:e.target.value})};$("#autoSelect").onchange=e=>{$("#auto").value=e.target.value;autoSet();savePrefs({...loadPrefs(),autoRefresh:e.target.value})};$("#colorBg").oninput=e=>{applyColors({...loadPrefs(),bg:e.target.value});savePrefs({...loadPrefs(),bg:e.target.value})};$("#colorCard").oninput=e=>{applyColors({...loadPrefs(),card:e.target.value});savePrefs({...loadPrefs(),card:e.target.value})};$("#colorBtn").oninput=e=>{applyColors({...loadPrefs(),btn:e.target.value});savePrefs({...loadPrefs(),btn:e.target.value})};$("#colorBorder").oninput=e=>{applyColors({...loadPrefs(),border:e.target.value});savePrefs({...loadPrefs(),border:e.target.value})};document.addEventListener("DOMContentLoaded",()=>{const prefs=loadPrefs();if(prefs.theme)document.body.className=prefs.theme;if(prefs.autoRefresh)$("#auto").value=prefs.autoRefresh;applyColors(prefs);updateButtons();autoSet();refresh()})})();</script></body></html>
HTML

log "UI écrite: $INDEX"

# 2) Déverrouille vhost si immutable + backup
chattr -i "$VHOST" 2>/dev/null || true
cp -a "$VHOST" "/root/fireinners.online-ssl.bak.$TS" || true
log "Backup vhost: /root/fireinners.online-ssl.bak.$TS"

# 3) Disable doublons server_name fireinners.online dans sites-enabled (sauf canon)
CANON_REAL="$(readlink -f "$VHOST")"
for f in "$SITESEN"/*; do
  [ -e "$f" ] || continue
  TGT="$(readlink -f "$f" 2>/dev/null || echo "$f")"
  if grep -qE "[[:space:]]*server_name[[:space:]].*\\bfireinners\\.online\\b" "$TGT" 2>/dev/null; then
    if [ "$(readlink -f "$TGT" 2>/dev/null || echo "$TGT")" != "$CANON_REAL" ]; then
      if [ -L "$f" ]; then
        rm -f "$f" || true
        log "Supprimé symlink doublon: $f"
      else
        mv -f "$f" "$DISABLED_DIR/$(basename "$f").disabled.$TS" || true
        log "Déplacé doublon: $f -> $DISABLED_DIR/$(basename "$f").disabled.$TS"
      fi
    fi
  fi
done

ln -sfn "$VHOST" "$SITESEN/$(basename "$VHOST")"
log "sites-enabled OK: $SITESEN/$(basename "$VHOST")"

# 4) Remove ancien bloc + insert bloc Wolverine dans le server 443 de fireinners.online
TMP1="/tmp/vhost.clean.$TS"
awk -v b="$MARK_BEGIN" -v e="$MARK_END" 'BEGIN{skip=0} $0==b{skip=1;next} $0==e{skip=0;next} skip==0{print}' "$VHOST" > "$TMP1"

BLOCK="/tmp/wolv.block.$TS"
cat > "$BLOCK" <<'BLK'
# BEGIN WOLVERINE_BLOCK
location ^~ /wolverine/api/ {
  rewrite ^/wolverine/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 60s;
  add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
}
location = /wolverine/ {
  add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
  try_files /wolverine/index.html =404;
}
location ^~ /wolverine/ {
  add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
  try_files $uri $uri/ /wolverine/index.html;
}
# END WOLVERINE_BLOCK
BLK

TMP2="/tmp/vhost.patched.$TS"
awk -v BLKFILE="$BLOCK" -v SITE="$SITE" '
function loadblk(  l){ blk=""; while((getline l < BLKFILE)>0){ blk=blk l "\n" } close(BLKFILE) }
function cnt(s,ch,  i,n){ n=0; for(i=1;i<=length(s);i++) if(substr(s,i,1)==ch) n++; return n }
BEGIN{loadblk(); depth=0; in_server=0; seen_name=0; seen_443=0; inserted=0}
{
  line=$0
  if(!in_server && line ~ /^[[:space:]]*server[[:space:]]*\{/){ in_server=1; seen_name=0; seen_443=0 }
  if(in_server){
    if(line ~ /server_name/ && line ~ /fireinners\.online/) seen_name=1
    if(line ~ /listen/ && line ~ /443/) seen_443=1
  }
  o=cnt(line,"{"); c=cnt(line,"}")
  newdepth=depth+o-c
  if(in_server && !inserted && seen_name && seen_443 && newdepth==0 && c>0){
    printf "%s", blk
    inserted=1
  }
  print line
  depth=newdepth
  if(in_server && depth==0){ in_server=0 }
}
END{ if(!inserted) exit 3 }
' "$TMP1" > "$TMP2" || { cp -a "/root/fireinners.online-ssl.bak.$TS" "$VHOST" || true; die "Insertion bloc Wolverine impossible (vhost restauré)."; }

mv -f "$TMP2" "$VHOST"
rm -f "$TMP1" "$BLOCK" 2>/dev/null || true
log "Vhost patch OK"

# 5) nginx test + restart (auto-restore si fail)
if ! nginx -t >/tmp/nginx_test.$TS 2>&1; then
  cp -a "/root/fireinners.online-ssl.bak.$TS" "$VHOST" || true
  nginx -t >/tmp/nginx_test_restore.$TS 2>&1 || true
  die "nginx -t a échoué. J'ai restauré le vhost backup: /root/fireinners.online-ssl.bak.$TS"
fi

systemctl restart nginx || true
chattr +i "$VHOST" 2>/dev/null || true

log "OK"
log "URL: https://$SITE/wolverine/"
SH
(()=>{"use strict";
const $=(s,root=document)=>root.querySelector(s);
const $$=(s,root=document)=>Array.from(root.querySelectorAll(s));
const sleep=(ms)=>new Promise(r=>setTimeout(r,ms));

function norm(s){return String(s||"").toLowerCase().trim();}
function byText(tag, needle){
  needle = norm(needle);
  return $$(tag).find(el => norm(el.textContent).includes(needle)) || null;
}
function clickExisting(needles){
  const n = Array.isArray(needles) ? needles : [needles];
  const btns = $$("button,a,[role='button'],input[type='button']");
  for(const needle of n){
    const k = norm(needle);
    const found = btns.find(b => norm(b.textContent||b.value||"").includes(k) || norm(b.id).includes(k) || norm(b.className).includes(k));
    if(found){
      found.click();
      return true;
    }
  }
  return false;
}
function setStatus(t){
  const el=$("#wolvStatusLine");
  if(el) el.textContent = t;
  console.log("[WOLV_UI]", t);
}


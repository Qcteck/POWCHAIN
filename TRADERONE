import re,sys
p=sys.argv[1]
s=open(p,'r',encoding='utf-8',errors='ignore').read().splitlines(True)

block = r'''
    # FIREINNERS_SOLRPC_PROXY_v1
    location /solrpc {
        proxy_pass http://127.0.0.1:12703;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
        if ($request_method = OPTIONS) { return 204; }
    }
'''.lstrip("\n")

# Insert before last "}" of the first server block (best-effort)
out=[]
server_open=0
inserted=False
for i,line in enumerate(s):
    if re.search(r'^\s*server\s*\{', line): server_open+=1
    out.append(line)
# If already inserted nothing to do
if inserted: pass

txt="".join(out)
# naive insert near end of first server { ... }
m=list(re.finditer(r'^\s*server\s*\{', txt, re.M))
if not m:
    raise SystemExit("No server { found in vhost")
start=m[0].start()
# find matching close brace for first server block (simple stack)
stack=0
end=None
for j,ch in enumerate(txt[start:], start):
    if ch=="{": stack+=1
    elif ch=="}":
        stack-=1
        if stack==0:
            end=j
            break
if end is None:
    raise SystemExit("No matching } for first server block")
newtxt = txt[:end] + "\n" + block + "\n" + txt[end:]
open(p,'w',encoding='utf-8').write(newtxt)
print("OK inserted /solrpc block")
PY
"$VHOST"

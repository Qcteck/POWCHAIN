bash <<'EOF'
set -e

echo "=== AIAQUILA RSS FIX — WORKER ONLY (NO PHP) ==="

AIA_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$AIA_DIR/index.html"
BACKUP="$AIA_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"

WORKER_URL="https://aiaquila-proxy.your-subdomain.workers.dev"

# 1. Vérifications
if [ ! -d "$AIA_DIR" ]; then
  echo "❌ Dossier introuvable: $AIA_DIR"
  exit 1
fi

if [ ! -f "$INDEX" ]; then
  echo "❌ index.html introuvable"
  exit 1
fi

# 2. Backup
cp "$INDEX" "$BACKUP"
echo "✔ Backup créé: $BACKUP"

# 3. Écriture du frontend propre (JSON ONLY)
cat > "$INDEX" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;font-family:system-ui;background:#0b1b3a;color:#fff}
#wrap{padding:20px}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
</style>
</head>
<body>
<div id="wrap">
  <h2>🦅 AIAQUILA — RSS réel</h2>
  <button onclick="load()">Lire les articles</button>
  <pre id="out">En attente…</pre>
</div>

<script>
const WORKER = "WORKER_URL_PLACEHOLDER";

const FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://news.bitcoin.com/feed/"
];

async function load(){
  const out = document.getElementById("out");
  out.textContent = "";
  let total = 0;

  for(const url of FEEDS){
    try{
      const r = await fetch(WORKER + "?url=" + encodeURIComponent(url));
      const txt = await r.text();
      let json;
      try {
        json = JSON.parse(txt);
      } catch(e){
        out.textContent += url + " -> ERREUR: réponse non JSON\n";
        continue;
      }

      if(!Array.isArray(json) || json.length === 0){
        out.textContent += url + " -> aucun article\n";
        continue;
      }

      json.slice(0,5).forEach(a=>{
        out.textContent += "• " + a.title + "\n";
        total++;
      });
    } catch(err){
      out.textContent += url + " -> erreur fetch\n";
    }
  }
  out.textContent += "\nTOTAL: " + total;
}
</script>
</body>
</html>
HTML

# Inject WORKER URL
sed -i "s|WORKER_URL_PLACEHOLDER|$WORKER_URL|g" "$INDEX"

# 4. Permissions
chown -R www-data:www-data "$AIA_DIR"
chmod -R 755 "$AIA_DIR"

# 5. Reload nginx
nginx -t && systemctl reload nginx

# 6. Test Worker direct
echo
echo "=== TEST WORKER DIRECT ==="
curl -s "$WORKER_URL?url=https://news.bitcoin.com/feed/" | head -c 300
echo
echo "=== FIN ==="
echo "✔ Frontend AIAQUILA corrigé — JSON ONLY — Worker Cloudflare utilisé"
EOF
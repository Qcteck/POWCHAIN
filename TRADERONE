,0,.12);padding:12px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}</style></head><body><div id="wrap"><div id="top"><div><h1>FireInners • Wallet</h1><p>Lecture soldes via Phantom + Solana RPC. Aucun secret, aucune seed, aucun export.</p></div><div id="pill"><a href="/">Retour</a></div></div><div id="row"><button id="btnConnect">Connect</button><button id="btnDisc" disabled>Disconnect</button><button id="btnRefresh" disabled>Refresh</button></div><div id="grid"><div id="card"><div style="display:grid;gap:10px"><div><span id="k">Adresse</span><div id="addr">—</div></div><div><span id="k">RPC (SOL)</span><div id="rpcSol">—</div></div><div><span id="k">RPC (USDC)</span><div id="rpcUsdc">—</div></div></div></div><div id="card"><div id="vals"><div id="box"><h2>SOL</h2><div class="v" id="sol">—</div></div><div id="box"><h2>USDC</h2><div class="v" id="usdc">—</div></div></div></div></div><div id="log"></div></div><script src="https://cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js"></script><script>window.globalThis=window.globalThis||window;window.global=window.globalThis;window.process=window.process||{env:{}};window.Buffer=window.Buffer||buffer.Buffer;</script><script src="https://unpkg.com/@solana/web3.js@1.98.0/lib/index.iife.min.js"></script><script>(()=>{const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const RPCS_USDC=[RPC,"https://solana-rpc.publicnode.com","https://api.mainnet-beta.solana.com","https://rpc.ankr.com/solana"];const $=s=>document.querySelector(s);const logEl=$("#log");const log=m=>{const t=String(m||"");logEl.textContent+=(t+(t.endsWith("\n")?"":"\n"));logEl.scrollTop=logEl.scrollHeight};const fmt=(n,d)=>{try{return (Number(n)||0).toLocaleString(undefined,{maximumFractionDigits:d})}catch(e){return String(n)}};const setTxt=(id,v)=>{const el=$(id);if(el)el.textContent=v};let pub=null,conn=null;const sleep=t=>new Promise(r=>setTimeout(r,t));async function rpcPost(rpc,method,params){const res=await fetch(rpc,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method,params})});let j=null;try{j=await res.json()}catch(e){}if(!res.ok||!j||j.error)throw new Error((j&&j.error&&j.error.message)||("HTTP "+res.status));return j.result;}async function getUSDC(owner){for(const rpc of RPCS_USDC){for(let k=0;k<3;k++){try{const r=await rpcPost(rpc,"getTokenAccountsByOwner",[owner,{mint:USDC_MINT},{encoding:"jsonParsed"}]);let sum=0;for(const it of (r.value||[])){const ui=it.account?.data?.parsed?.info?.tokenAmount?.uiAmount;sum+=Number(ui||0)}return {sum,rpc}}catch(e){await sleep(250*(k+1))}}}throw new Error("USDC RPC failover exhausted")}async function refresh(){if(!pub)return;setTxt("#rpcSol",RPC);setTxt("#rpcUsdc","(scan...)");try{const c=conn||(conn=new solanaWeb3.Connection(RPC,{commitment:"confirmed"}));const lam=await c.getBalance(new solanaWeb3.PublicKey(pub),"confirmed");setTxt("#sol",fmt(lam/1e9,6));}catch(e){log("SOL ERR: "+(e?.message||e));}try{const u=await getUSDC(pub);setTxt("#usdc",fmt(u.sum,2));setTxt("#rpcUsdc",u.rpc);log("USDC OK via "+u.rpc);}catch(e){setTxt("#rpcUsdc","ERR");log("USDC ERR: "+(e?.message||e));}}async function connect(){try{const ph=window.solana;if(!ph||!ph.isPhantom){log("Phantom introuvable.");return}const r=await ph.connect();pub=r?.publicKey?.toBase58?.()||String(r?.publicKey||"");if(!pub){log("CONNECT ERR: no pubkey");return}setTxt("#addr",pub);$("#btnDisc").disabled=false;$("#btnRefresh").disabled=false;log("CONNECTED");await refresh();}catch(e){log("CONNECT ERR: "+(e?.message||e));}}async function disconnect(){try{const ph=window.solana;if(ph&&ph.disconnect)await ph.disconnect()}catch(e){}pub=null;conn=null;setTxt("#addr","—");setTxt("#sol","—");setTxt("#usdc","—");setTxt("#rpcSol","—");setTxt("#rpcUsdc","—");$("#btnDisc").disabled=true;$("#btnRefresh").disabled=true;log("DISCONNECTED")}$("#btnConnect").onclick=connect;$("#btnDisc").onclick=disconnect;$("#btnRefresh").onclick=refresh;log("READY");})();</script><!-- FIREINNERS_WALLET_PAGE_v1 --></body></html>

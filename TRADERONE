<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>JARVIS • RSS AUTOSTART • DÉCISIONS AVEC CONFIRMATION</title>
  <style>
    :root{
      --p:#ff2cf7;--c:#19f7ff;--g:#39ff14;--y:#ffe600;--r:#ff3b3b;--t:#f4fbff;
      --glass:linear-gradient(180deg,rgba(0,0,0,.48),rgba(0,0,0,.24));
      --shadow:0 0 0 2px rgba(25,247,255,.10),0 0 0 2px rgba(255,44,247,.08) inset,0 30px 90px rgba(0,0,0,.65);
    }
    html,body{height:100%;margin:0;background:
      radial-gradient(1400px 900px at 68% 24%, rgba(255,44,247,.20) 0%,
      rgba(25,247,255,.12) 26%, rgba(5,6,11,1) 55%, rgba(0,0,0,1) 100%);
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Cantarell,Helvetica,Arial,sans-serif;color:var(--t)}
    *{box-sizing:border-box}
    button{
      border:2px solid rgba(25,247,255,.32);
      background:linear-gradient(180deg,rgba(25,247,255,.12),rgba(255,44,247,.10),rgba(0,0,0,.26));
      color:var(--t);
      border-radius:14px;
      padding:12px 12px;
      font-weight:1100;
      letter-spacing:.10em;
      text-transform:uppercase;
      font-size:12px;
      cursor:pointer;
      box-shadow:0 0 24px rgba(25,247,255,.10),0 0 22px rgba(255,44,247,.08);
      user-select:none;
    }
    button:hover{border-color:rgba(255,230,0,.90);box-shadow:0 0 30px rgba(255,230,0,.10),0 0 28px rgba(25,247,255,.10)}
    button.on{border-color:rgba(57,255,20,.85);box-shadow:0 0 30px rgba(57,255,20,.14),0 0 28px rgba(25,247,255,.10)}
    button.bad{border-color:rgba(255,59,59,.75)}
    button.dim{opacity:.62}
    button[disabled]{opacity:.45;cursor:not-allowed}
    input{
      border:2px solid rgba(255,230,0,.22);
      background:rgba(0,0,0,.35);
      color:var(--t);
      border-radius:14px;
      padding:14px;
      font-weight:1000;
      outline:none;
      font-size:14px;
    }
    input:focus{border-color:rgba(255,230,0,.90);box-shadow:0 0 26px rgba(255,230,0,.10)}
    .chip{
      border:2px solid rgba(25,247,255,.18);
      background:rgba(0,0,0,.25);
      border-radius:999px;
      padding:8px 12px;
      font-size:12px;
      letter-spacing:.12em;
      text-transform:uppercase;
      font-weight:1100;
      color:rgba(244,251,255,.92);
      white-space:nowrap;
    }
    .chip.good{border-color:rgba(57,255,20,.30)}
    .chip.warn{border-color:rgba(255,230,0,.22)}
    .chip.bad{border-color:rgba(255,59,59,.26)}
    .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
    #app{
      height:100dvh;height:100vh;
      display:flex;flex-direction:column;
      padding:calc(12px + env(safe-area-inset-top)) 12px calc(12px + env(safe-area-inset-bottom)) 12px;
      gap:12px;min-height:0;
    }
    #top{
      display:flex;align-items:center;justify-content:space-between;gap:12px;
      border:2px solid rgba(25,247,255,.22);
      background:linear-gradient(180deg,rgba(255,44,247,.18),rgba(25,247,255,.12),rgba(0,0,0,.22));
      backdrop-filter:blur(10px);
      border-radius:16px;
      padding:12px 14px;
      box-shadow:var(--shadow);
    }
    #brand{display:flex;align-items:center;gap:14px;min-width:0}
    #logo{
      width:52px;height:52px;border-radius:50%;
      background:
        radial-gradient(circle at 40% 35%,#ffffff 0 12%,var(--y) 13% 22%,var(--c) 23% 38%,var(--p) 39% 62%,rgba(0,0,0,0) 63%),
        conic-gradient(from 190deg,rgba(255,44,247,.52),rgba(25,247,255,.10),rgba(57,255,20,.42),rgba(255,230,0,.22),rgba(255,44,247,.52));
      box-shadow:0 0 38px rgba(255,44,247,.26),0 0 34px rgba(25,247,255,.20),inset 0 0 18px rgba(255,230,0,.16);
      position:relative;flex:0 0 auto;
    }
    #logo:before{
      content:"";position:absolute;inset:-7px;border-radius:50%;
      border:2px dashed rgba(25,247,255,.45);
      filter:drop-shadow(0 0 14px rgba(25,247,255,.18));
      animation:spin 7.5s linear infinite;
    }
    @keyframes spin{to{transform:rotate(360deg)}}
    #title{line-height:1.1;min-width:0}
    #title b{letter-spacing:.16em;font-weight:1200;font-size:18px;white-space:nowrap}
    #title small{
      display:block;color:rgba(244,251,255,.78);
      letter-spacing:.14em;text-transform:uppercase;font-size:12px;margin-top:4px;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    }
    #topRight{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}
    #main{flex:1;display:grid;grid-template-columns:560px 1fr;gap:12px;min-height:0}
    #left,#right{
      border:2px solid rgba(25,247,255,.18);
      background:var(--glass);
      backdrop-filter:blur(10px);
      border-radius:16px;
      box-shadow:var(--shadow);
      overflow:hidden;
      min-height:0;
      position:relative;
    }
    .scan{
      position:absolute;inset:0;pointer-events:none;
      background:linear-gradient(180deg,rgba(255,44,247,.12),rgba(0,0,0,0) 35%,rgba(25,247,255,.10) 70%,rgba(0,0,0,0));
      mix-blend-mode:screen;animation:scan 3.2s linear infinite;opacity:.75;
    }
    @keyframes scan{0%{transform:translateY(-65%)}100%{transform:translateY(65%)}}
    .hd{
      padding:14px;border-bottom:2px solid rgba(25,247,255,.10);
      display:flex;align-items:center;justify-content:space-between;gap:12px
    }
    .hd b{letter-spacing:.16em;text-transform:uppercase;font-size:13px}
    .hd span{color:rgba(244,251,255,.78);font-weight:1100}
    #states{
      padding:14px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;border-bottom:2px solid rgba(25,247,255,.10);
      background:linear-gradient(180deg,rgba(0,0,0,.22),rgba(0,0,0,0));
    }
    #states .box{
      border:2px solid rgba(255,230,0,.10);
      border-radius:14px;background:rgba(0,0,0,.18);
      padding:10px;
    }
    #states .box b{display:block;letter-spacing:.14em;text-transform:uppercase;font-size:11px;color:rgba(244,251,255,.78)}
    #states .box span{display:block;margin-top:6px;font-weight:1100;color:rgba(244,251,255,.94);word-break:break-word}
    #permBox{
      padding:14px;border-top:2px solid rgba(25,247,255,.10);
      border-bottom:2px solid rgba(25,247,255,.10);
      background:linear-gradient(180deg,rgba(0,0,0,.16),rgba(0,0,0,0));
    }
    #rssBox{padding:14px;overflow:auto;min-height:0}
    .it{
      border:2px solid rgba(255,230,0,.12);
      border-radius:14px;background:rgba(0,0,0,.18);
      padding:10px;margin-bottom:10px;
      display:flex;gap:12px;align-items:flex-start;justify-content:space-between;
    }
    .it .meta{min-width:0}
    .it .meta span{font-weight:1000;font-size:13px;line-height:1.25;color:rgba(244,251,255,.92)}
    .it .meta small{display:block;color:rgba(244,251,255,.68);font-size:12px;margin-top:6px;letter-spacing:.08em}
    .badge{
      border:2px solid rgba(25,247,255,.18);
      border-radius:999px;padding:6px 10px;
      font-size:11px;font-weight:1100;letter-spacing:.12em;text-transform:uppercase;
      white-space:nowrap;align-self:flex-start;
      background:rgba(0,0,0,.18);
    }
    .badge.good{border-color:rgba(57,255,20,.30)}
    .badge.warn{border-color:rgba(255,230,0,.22)}
    .badge.bad{border-color:rgba(255,59,59,.26)}
    #right{display:flex;flex-direction:column;min-height:0}
    #log{
      flex:1;padding:14px;overflow:auto;
      font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
      font-size:13px;line-height:1.4
    }
    .m{
      margin:10px 0;padding:10px 12px;border-radius:14px;
      border:2px solid rgba(25,247,255,.10);background:rgba(25,247,255,.04);
      white-space:pre-wrap;word-break:break-word;
    }
    .m.ai{border-left:5px solid rgba(25,247,255,.80)}
    .m.user{border-left:5px solid rgba(255,44,247,.70)}
    .m.sys{border-left:5px solid rgba(255,230,0,.70)}
    #quick{
      display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
      gap:12px;padding:14px;border-top:2px solid rgba(25,247,255,.10);
    }
    #sendRow{
      display:flex;gap:12px;padding:14px;border-top:2px solid rgba(25,247,255,.10);
    }
    #sendRow input{flex:1}

    /* Overlays */
    #decisionOverlay, #consentOverlay{
      display:none;
      position:absolute;inset:0;
      background:rgba(0,0,0,.72);
      backdrop-filter:blur(10px);
      z-index:120;
      padding:16px;
    }
    .card{
      max-width:920px;margin:0 auto;
      border:2px solid rgba(25,247,255,.18);
      border-radius:16px;background:rgba(0,0,0,.40);
      box-shadow:var(--shadow);
      padding:14px;
    }
    .card .t{
      font-weight:1100;color:rgba(244,251,255,.92);
      white-space:pre-wrap;line-height:1.35;
      border:2px solid rgba(25,247,255,.12);
      border-radius:14px;padding:12px;background:rgba(0,0,0,.22);
      margin-top:10px;
    }
    .btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}
    .btns button{flex:1;min-width:220px}

    @media(max-width:1200px){
      #main{grid-template-columns:1fr}
      #quick{grid-template-columns:repeat(2,minmax(0,1fr))}
      #states{grid-template-columns:1fr}
      .btns button{min-width:160px}
    }
  </style>
</head>
<body>
<div id="app">
  <div id="top">
    <div id="brand">
      <div id="logo"></div>
      <div id="title">
        <b>JARVIS • RSS AUTOSTART</b>
        <small>DÉCISIONS PROPOSÉES → CONFIRMATION → APPLICATION (local)</small>
      </div>
    </div>

    <div id="topRight">
      <span class="chip good" id="capChip">CAP: RSS+ARTICLE+DÉCISION+LEARN</span>
      <span class="chip warn" id="modeChip">MODE: BOOT</span>
      <span class="chip" id="netChip">NET: —</span>
      <span class="chip bad" id="errChip">ERR: 0.0%</span>
      <span class="chip warn" id="qChip">Q: —</span>
      <button id="btnVoice">VOIX OFF</button>
      <button id="btnNext">PROCHAIN TITRE</button>
      <button id="btnReset" class="bad">RESET</button>
    </div>
  </div>

  <div id="main">
    <div id="left">
      <div class="scan"></div>

      <div class="hd"><b>ÉTATS (toujours visibles)</b><span id="clock">--:--:--</span></div>
      <div id="states">
        <div class="box"><b>Conscience (état)</b><span id="st_state">—</span></div>
        <div class="box"><b>Environnement</b><span id="st_env">—</span></div>
        <div class="box"><b>Capacités actives</b><span id="st_caps">—</span></div>
        <div class="box"><b>Potentiel (next)</b><span id="st_potential">—</span></div>
        <div class="box"><b>Erreur & apprentissage</b><span id="st_error">—</span></div>
        <div class="box"><b>RSS sélectionné</b><span id="st_rss">—</span></div>
        <div class="box"><b>Qualité extraction</b><span id="st_quality">—</span></div>
        <div class="box"><b>Décision en attente</b><span id="st_decision">—</span></div>
      </div>

      <div id="permBox">
        <div class="row" style="justify-content:space-between">
          <b style="letter-spacing:.16em;text-transform:uppercase;font-size:13px">CAPACITÉS</b>
          <span class="chip" id="capStat">—</span>
        </div>
        <div class="row" style="margin-top:10px">
          <button id="capRSS" class="on">RSS</button>
          <button id="capARTICLE" class="on">ARTICLE</button>
          <button id="capDECISION" class="on">DÉCISION</button>
          <button id="capLEARN" class="on">LEARN</button>
        </div>
      </div>

      <div class="hd"><b>Titres RSS (1–12)</b><span id="rssStat">—</span></div>
      <div id="rssBox"></div>
    </div>

    <div id="right">
      <div class="scan"></div>
      <div class="hd"><b>Discussion</b><span id="discStat">—</span></div>

      <div id="log"></div>

      <div id="quick"></div>

      <div id="sendRow">
        <input id="in" placeholder="Réponds ici (ou clique un bouton)">
        <button id="send">ENVOYER</button>
      </div>

      <!-- Decision confirmation overlay -->
      <div id="decisionOverlay">
        <div class="card">
          <div class="row" style="justify-content:space-between">
            <b style="letter-spacing:.16em;text-transform:uppercase;font-size:13px">CONFIRMATION DE DÉCISION</b>
            <span class="chip warn" id="decKey">—</span>
          </div>
          <div class="t" id="decText">—</div>
          <div class="btns">
            <button id="decYes" class="on">CONFIRMER</button>
            <button id="decNo" class="bad">REFUSER</button>
            <button id="decAlt">ALTERNATIVE</button>
          </div>
        </div>
      </div>

      <!-- Simple capability-consent overlay (kept minimal) -->
      <div id="consentOverlay">
        <div class="card">
          <div class="row" style="justify-content:space-between">
            <b style="letter-spacing:.16em;text-transform:uppercase;font-size:13px">AUTORISATION</b>
            <span class="chip warn" id="conKey">—</span>
          </div>
          <div class="t" id="conText">—</div>
          <div class="btns">
            <button id="conYes" class="on">AUTORISER</button>
            <button id="conNo" class="bad">REFUSER</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
(() => {
  "use strict";

  const $ = s => document.querySelector(s);
  const esc = s => String(s).replace(/[&<>"']/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
  const now = () => new Date().toLocaleTimeString("fr-CA",{hour12:false});
  const KEY = "jarvis_decision_confirm_v1";
  const KEY_AUDIO = "jarvis_audio_unlocked";

  let S = null;
  let audioUnlocked = JSON.parse(localStorage.getItem(KEY_AUDIO) || "false");

  const log = $("#log"), quick = $("#quick"), rssBox = $("#rssBox");
  const rssStat = $("#rssStat"), clock = $("#clock"), discStat = $("#discStat");
  const capChip = $("#capChip"), modeChip = $("#modeChip"), netChip = $("#netChip"), errChip = $("#errChip"), qChip = $("#qChip");
  const capStat = $("#capStat");
  const inEl = $("#in");

  const st_state=$("#st_state"), st_env=$("#st_env"), st_caps=$("#st_caps"), st_potential=$("#st_potential"),
        st_error=$("#st_error"), st_rss=$("#st_rss"), st_quality=$("#st_quality"), st_decision=$("#st_decision");

  const decisionOverlay = $("#decisionOverlay");
  const decKey = $("#decKey"), decText = $("#decText"), decYes = $("#decYes"), decNo = $("#decNo"), decAlt = $("#decAlt");

  const consentOverlay = $("#consentOverlay");
  const conKey = $("#conKey"), conText = $("#conText"), conYes = $("#conYes"), conNo = $("#conNo");

  const save = () => localStorage.setItem(KEY, JSON.stringify(S));
  const load = () => {
    try { S = JSON.parse(localStorage.getItem(KEY) || "null"); } catch(e){ S = null; }
    if(!S || typeof S !== "object"){
      S = {
        prefs:{ auto:true, voice:false, lang:"fr-CA", sarcasm:true },
        caps:{ rss:true, article:true, decision:true, learn:true },
        rss:[
          "https://www.coindesk.com/arc/outboundfeeds/rss/",
          "https://cointelegraph.com/rss",
          "https://decrypt.co/feed"
        ],
        items:[],
        pick:0,
        selected:null,
        article:{ url:null, title:null, text:null, summary:null, tags:[], sent:null, quality:0, method:"—", paywallHint:false },
        learn:{ rules:["RSS = base permanente","1 question à la fois","décisions = confirmation obligatoire"], facts:[], experiments:[] },
        errors:{ events:[], window:220, errRate:0, last:"—" },
        // Decision engine state
        decisions:{
          pending:null, // {id,title,why,action,risk,reversible,apply:{type,payload}, alt:{...}}
          history:[]
        },
        // Minimal per-action consent (NOT the same as decision confirmation)
        consent:{ pending:null }, // {key,desc,cb}
        state:{ mode:"BOOT", confidence:98.5 }
      };
      save();
    }
  };

  const sarcasm = (a,b) => S.prefs.sarcasm ? a : b;

  const speak = t => {
    if(!S.prefs.voice || !audioUnlocked || !window.speechSynthesis) return;
    try{
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(String(t||""));
      u.lang = S.prefs.lang || "fr-CA";
      u.rate = 1.03; u.pitch = .98; u.volume = 1;
      window.speechSynthesis.speak(u);
    }catch(e){}
  };

  const add = (who, txt, cls) => {
    const d = document.createElement("div");
    d.className = "m " + cls;
    d.innerHTML = `
      <div style="display:flex;justify-content:space-between;gap:12px;color:rgba(244,251,255,.70);font-size:12px;margin-bottom:8px;letter-spacing:.10em;text-transform:uppercase;font-weight:1100">
        <span>${esc(who)}</span><span>${esc(now())}</span>
      </div>
      <div>${esc(txt)}</div>`;
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
    renderQuick();
    renderStates();
    save();
  };

  const pushErr = msg => {
    S.errors.events.push({t:Date.now(), m:String(msg||"ERR")});
    S.errors.events = S.errors.events.slice(-S.errors.window);
    const n = S.errors.events.length;
    const errCount = S.errors.events.filter(x => x.m).length;
    S.errors.errRate = Math.round((errCount / Math.max(1,n)) * 1000)/10;
    S.errors.last = String(msg||"—");
    if(S.errors.errRate >= 3){
      S.state.mode = "ALERTE";
      S.state.confidence = Math.max(85, S.state.confidence - 2);
    }
    save();
  };
  window.addEventListener("error", ev => pushErr(ev.message || "JS error"));
  window.addEventListener("unhandledrejection", ev => pushErr(String(ev.reason || "Promise")));

  const requireConsentOnce = (key, desc, cb) => {
    // This is only for technical actions (fetch/extract). Decisions are always confirmed separately.
    S.consent.pending = {key, desc, cb};
    save();
    conKey.textContent = key;
    conText.textContent = desc;
    consentOverlay.style.display = "block";
    conYes.onclick = () => { consentOverlay.style.display="none"; const x=S.consent.pending; S.consent.pending=null; save(); cb(true); };
    conNo.onclick  = () => { consentOverlay.style.display="none"; S.consent.pending=null; save(); cb(false); };
  };

  // ---- Fetch with fallback (allorigins + jina) ----
  const fetchText = async (url) => {
    const tries = [
      {name:"allorigins", url:"https://api.allorigins.win/raw?url=" + encodeURIComponent(url)},
      {name:"jina_https", url:"https://r.jina.ai/https://" + url.replace(/^https?:\/\//i,"")},
      {name:"jina_http",  url:"https://r.jina.ai/http://" + url.replace(/^https?:\/\//i,"")}
    ];
    let lastErr=null;
    for(const t of tries){
      try{
        const r = await fetch(t.url, {cache:"no-store"});
        if(!r.ok) throw new Error("HTTP "+r.status);
        const s = await r.text();
        if(s && s.trim().length > 200) return {text:s, method:t.name};
      }catch(e){ lastErr=e; }
    }
    throw lastErr || new Error("Fetch failed");
  };

  const parseRSS = (txt) => {
    const xml = new DOMParser().parseFromString(txt, "text/xml");
    let items = [...xml.querySelectorAll("item")].slice(0, 40).map(it => ({
      title: (it.querySelector("title")?.textContent || "").trim(),
      link: (it.querySelector("link")?.textContent || "").trim(),
      pub: (it.querySelector("pubDate")?.textContent || "").trim()
    }));
    if(items.length) return items;
    items = [...xml.querySelectorAll("entry")].slice(0, 40).map(en => ({
      title: (en.querySelector("title")?.textContent || "").trim(),
      link: (en.querySelector("link")?.getAttribute("href") || en.querySelector("link")?.textContent || "").trim(),
      pub: (en.querySelector("updated")?.textContent || en.querySelector("published")?.textContent || "").trim()
    }));
    return items;
  };

  const cleanText = (t) => {
    t = String(t||"").replace(/\r/g,"");
    t = t.replace(/[ \t]+\n/g,"\n").replace(/\n{3,}/g,"\n\n");
    t = t.replace(/[ \t]{2,}/g," ");
    t = t.replace(/^\s+|\s+$/g,"");
    return t;
  };

  const isProbablyHTML = (s) => /<\/(html|body|p|div|article|main)>/i.test(s) || /<p[\s>]/i.test(s) || /<article[\s>]/i.test(s);

  const nodeText = (n) => (n && n.textContent ? n.textContent : "").replace(/\s+/g," ").trim();
  const linkDensity = (el) => {
    const txt = nodeText(el);
    if(!txt) return 1;
    const links = el.querySelectorAll("a");
    let linkTxt = 0;
    links.forEach(a => linkTxt += (nodeText(a).length));
    return Math.min(1, linkTxt / Math.max(1, txt.length));
  };
  const badTag = (el) => {
    const tag = (el.tagName||"").toLowerCase();
    if(["nav","footer","header","aside","form"].includes(tag)) return true;
    const id = (el.id||"").toLowerCase();
    const cls = (el.className||"").toLowerCase();
    const bad = ["nav","menu","footer","header","sidebar","cookie","consent","subscribe","paywall","modal","breadcrumb","share","social","promo","ad","ads","banner","comment","related"];
    return bad.some(w => id.includes(w) || cls.includes(w));
  };
  const scoreNode = (el) => {
    if(!el || !el.querySelectorAll) return -999;
    if(badTag(el)) return -80;
    const txt = nodeText(el);
    const len = txt.length;
    if(len < 200) return -20;
    const pCount = el.querySelectorAll("p,li").length;
    const ld = linkDensity(el);
    const tag = (el.tagName||"").toLowerCase();
    const bonus = (tag==="article" || tag==="main") ? 40 : 0;
    let score = bonus + Math.log(len) * 16 + pCount * 6 - ld * 70;
    const dot = (txt.match(/•/g)||[]).length;
    if(dot > 30) score -= 18;
    return score;
  };

  const extractMainText = (html) => {
    const doc = new DOMParser().parseFromString(html, "text/html");
    doc.querySelectorAll("script,style,noscript,iframe,svg").forEach(n=>n.remove());

    const candidates = [];
    const all = doc.querySelectorAll("article,main,section,div");
    all.forEach(el => {
      if(!el || !el.textContent) return;
      const txt = nodeText(el);
      if(txt.length < 220) return;
      candidates.push({el, score: scoreNode(el)});
    });

    candidates.sort((a,b)=>b.score-a.score);
    const best = candidates[0]?.el || doc.body;
    const main = best || doc.body;

    main.querySelectorAll("nav,footer,header,aside,form").forEach(n=>n.remove());

    const paras = [...main.querySelectorAll("p,li")].map(p=>nodeText(p)).filter(s=>s.length>40);
    let text = paras.length ? paras.join("\n\n") : nodeText(main);

    const lower = (doc.body?.textContent||"").toLowerCase();
    const paywallHint = ["subscribe","sign in","log in","paywall","abonne","abonnement","inscris","connecte"].some(w => lower.includes(w));

    text = cleanText(text);
    const pN = text.split("\n\n").filter(Boolean).length;
    const len = text.length;
    const ld = linkDensity(main);

    return {text, signals:{pN,len,ld,score:candidates[0]?.score ?? 0}, paywallHint};
  };

  const detectTags = (title, text) => {
    const s = (title+" "+text).toLowerCase();
    const tags = [];
    const has = (...w) => w.some(x => s.includes(x));
    if(has("etf","sec","regulat","regulation","law","lawsuit")) tags.push("Régulation");
    if(has("hack","exploit","breach","drain","phishing")) tags.push("Sécurité");
    if(has("inflation","rates","fed","macro","cpi","jobs","recession","yield","bond")) tags.push("Macro");
    if(has("solana","ethereum","bitcoin","btc","eth","sol")) tags.push("Majors");
    if(has("meme","airdrop","pump","rug","scam")) tags.push("Risque");
    if(has("spot","futures","options","liquidation","open interest")) tags.push("Dérivés");
    if(has("upgrade","fork","validator","outage","congestion")) tags.push("Technique");
    return [...new Set(tags)].slice(0, 8);
  };

  const sentiment = (title, text) => {
    const s = (title+" "+text).toLowerCase();
    let p=0,n=0;
    ["surge","rally","bull","record","approval","win","up","gain","breakout","inflows","upgrade","beats"].forEach(w => { if(s.includes(w)) p++; });
    ["crash","down","bear","hack","lawsuit","ban","rejected","exploit","liquidation","risk","outage","scam"].forEach(w => { if(s.includes(w)) n++; });
    if(p-n>=2) return "Positif";
    if(n-p>=2) return "Négatif";
    return "Neutre";
  };

  const summarize = (text) => {
    text = cleanText(text||"");
    const paras = text.split("\n\n").map(x=>x.trim()).filter(Boolean);
    const pick = [];
    for(const pa of paras){
      if(pick.length>=4) break;
      const s = pa.replace(/\s+/g," ").slice(0, 260);
      if(s.length>90) pick.push("• "+s);
    }
    return pick.length ? pick.join("\n") : "• (Résumé impossible: contenu trop court / bloqué)";
  };

  const qualityScore = (signals, text) => {
    const len = (signals?.len ?? (text||"").length);
    const pN  = (signals?.pN ?? 0);
    const ld  = (signals?.ld ?? 1);
    let q = 0;
    q += Math.min(50, Math.log(Math.max(1,len)) * 8);
    q += Math.min(25, pN * 2.5);
    q += Math.max(0, 20 - ld * 40);
    const low = (text||"").toLowerCase();
    const rep = ["cookie","consent","subscribe","newsletter","terms","privacy","sign in","log in","abonne","abonnement"]
      .reduce((a,w)=>a + (low.includes(w)?1:0),0);
    q -= rep * 5;
    q = Math.max(0, Math.min(100, Math.round(q)));
    return q;
  };


  cat >"$PATCH" <<'JS'
(()=>{"use strict";
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const txt=e=>((e&&e.textContent)||"").replace(/\s+/g," ").trim();
const low=s=>String(s||"").toLowerCase();
function byText(selector,needle){
  needle=low(needle);
  return $$(selector).find(e=>low(txt(e)).includes(needle));
}
function escapeHtml(s){return String(s||"").replace(/[&<>"']/g,m=>({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[m]));}

function getBotAddrFromPage(){
  // Try to parse "Wallet TraderOne (bot) Adresse: <addr>"
  const body=txt(document.body);
  const m=body.match(/Wallet\s*TraderOne\s*\(bot\)[\s\S]{0,200}?Adresse:\s*([1-9A-HJ-NP-Za-km-z]{32,44})/i)
       || body.match(/Adresse:\s*([1-9A-HJ-NP-Za-km-z]{32,44})/i);
  return m?m[1]:"";
}
function getUserPub(){
  try{
    if(window.solana && window.solana.isPhantom && window.solana.publicKey) return window.solana.publicKey.toBase58();
  }catch(_){}
  return "";
}

function hideWalletsToDisplay(){
  // Hide heading block "Wallets à afficher" (and its container)
  const t=byText("*","wallets à afficher")||byText("*","wallets a afficher");
  if(t){
    const box=t.closest("section,fieldset,div,table")||t.parentElement;
    if(box) box.style.display="none";
  }
  // Hide instruction line "Colle ici..." + textarea below
  const inst=byText("*","colle ici des adresses")||byText("*","colle ici des adresse");
  if(inst){
    const box=inst.closest("section,fieldset,div,table")||inst.parentElement;
    if(box) box.style.display="none";
  }
  const ta=$("textarea");
  if(ta){
    const ctx=low(txt(ta.parentElement||document.body));
    if(ctx.includes("colle ici")||ctx.includes("wallets à afficher")||ctx.includes("wallets a afficher")) ta.style.display="none";
  }
  // Hide the upper "Refresh tous les soldes" button linked to that list
  const b=byText("button","refresh tous les soldes")||byText("input","refresh tous les soldes");
  if(b){
    const ctx=low(txt(b.closest("section,fieldset,div")||b.parentElement||document.body));
    if(ctx.includes("wallets à afficher")||ctx.includes("wallets a afficher")||ctx.includes("colle ici")) (b.closest("section,fieldset,div")||b).style.display="none";
  }
}

function installDepositBox(){
  if($("#wolvDepositBox")) return;
  const host = byText("*","Budget (sera")?.closest("div,section,fieldset") || document.body;
  const botAddr=getBotAddrFromPage();
  const box=document.createElement("div");
  box.id="wolvDepositBox";
  box.style.margin="10px 0";
  box.style.padding="10px";
  box.style.border="1px solid #bbb";
  box.style.borderRadius="8px";
  box.style.maxWidth="980px";

  const html =
    '<div style="font-weight:700;margin-bottom:6px">Dépôt manuel (obligatoire)</div>'+
    '<div style="margin-bottom:6px">1) Envoie depuis ton Phantom vers TraderOne (bot) :</div>'+
    '<div style="font-family:monospace;word-break:break-all;margin-bottom:8px">'+escapeHtml(botAddr||"(adresse bot introuvable)")+'</div>'+
    '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px">'+
      '<label>Asset <select id="wolvAssetSel"><option value="SOL">SOL</option><option value="USDC">USDC</option></select></label>'+
      '<label>Montant <input id="wolvAmt" inputmode="decimal" placeholder="ex: 0.1" style="width:120px"/></label>'+
      '<button id="wolvConfirmBtn" type="button">CONFIRMER DÉPÔT (on-chain)</button>'+
      '<span id="wolvConfirmState" style="margin-left:6px"></span>'+
    '</div>'+
    '<div style="font-size:12px;color:#333">Après confirmation, START WOLVERINE devient disponible.</div>';
  box.innerHTML=html;
  host.insertBefore(box, host.firstChild.nextSibling || host.firstChild);

  const confirmBtn=$("#wolvConfirmBtn");
  const state=$("#wolvConfirmState");
  const asset=$("#wolvAssetSel");
  const amt=$("#wolvAmt");

  function setState(s,ok){
    state.textContent=s;
    state.style.color=ok? "#0a0" : "#a00";
  }
  function enableStart(enabled){
    const startBtn = byText("button","START WOLVERINE") || byText("input","START WOLVERINE");
    if(startBtn){
      startBtn.disabled=!enabled;
      startBtn.style.opacity=enabled? "1":"0.45";
    }
  }

  // Force START disabled until confirmed
  enableStart(false);

  // Hijack existing START click: do not send funds, only call /api/start after confirmed
  let confirmedPayload=null;
  const startBtn = byText("button","START WOLVERINE") || byText("input","START WOLVERINE");
  if(startBtn && !startBtn.__wolvPatched){
    startBtn.__wolvPatched=true;
    startBtn.addEventListener("click", async (ev)=>{
      if(!confirmedPayload){
        ev.preventDefault(); ev.stopPropagation();
        setState("Dépôt non confirmé.", false);
        return;
      }
      ev.preventDefault(); ev.stopPropagation();
      try{
        setState("Démarrage...", true);
        const pub=getUserPub();
        const res=await fetch("/api/start",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({
          pub, asset:confirmedPayload.asset, amount:confirmedPayload.amount, depositSig:confirmedPayload.signature
        })});
        const j=await res.json().catch(()=>({ok:false,error:"bad json"}));
        if(j && j.ok) setState("START OK", true);
        else setState("ERR START: "+(j.error||res.status), false);
      }catch(e){
        setState("ERR START: "+(e&&e.message||e), false);
      }
    }, true);
  }

  confirmBtn.addEventListener("click", async ()=>{
    try{
      const pub=getUserPub();
      if(!pub){
        setState("Connecte Phantom d'abord.", false);
        return;
      }
      const v=Number(String(amt.value||"").replace(",","."));
      if(!isFinite(v) || v<=0){
        setState("Montant invalide.", false);
        return;
      }
      confirmBtn.disabled=true;
      setState("Vérification on-chain…", true);

      const res=await fetch("/api/confirm_deposit",{
        method:"POST",
        headers:{"content-type":"application/json"},
        body:JSON.stringify({pub, asset:asset.value, minAmount:v})
      });
      const j=await res.json().catch(()=>({ok:false,error:"bad json"}));
      if(!j || !j.ok) throw new Error(j && j.error ? j.error : ("HTTP "+res.status));

      if(j.confirmed){
        confirmedPayload={asset:asset.value, amount:j.amount, signature:j.signature};
        setState("Dépôt confirmé: "+j.amount+" "+asset.value+" / "+j.signature, true);
        enableStart(true);
      }else{
        setState("Pas trouvé. Attends 10-20s puis recommence.", false);
      }
    }catch(e){
      setState("ERR: "+(e&&e.message||e), false);
    }finally{
      confirmBtn.disabled=false;
    }
  });
}

document.addEventListener("DOMContentLoaded",()=>{

echo "== /tmp writable? =="
touch /tmp/_ok && echo OK && rm -f /tmp/_ok

echo "== LOCAL health =="
curl -sS -o /dev/null -w "LOCAL  http_code=%{http_code}\n" http://127.0.0.1:8585/api/health

echo "== NGINX health (public) =="
curl -ksS -o /dev/null -w "NGINX  http_code=%{http_code}\n" https://fireinners.online/wolverine/traderone/api/health

echo "== watchdog last runs =="
journalctl -u traderone-watchdog.service -n 30 --no-pager || true
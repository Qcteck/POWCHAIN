app.post("/api/pending/create", (req,res)=>{
  const { userPub, inMint, outMint, dir, amount, slippageBps, meta } = req.body||{};
  if(!userPub || typeof userPub!=="string") return res.status(400).json({ ok:false, error:"userPub_required" });
  if(!inMint || !outMint || !dir) return res.status(400).json({ ok:false, error:"mint_dir_required" });
  if(!amount || !Number.isFinite(Number(amount)) || Number(amount)<=0) return res.status(400).json({ ok:false, error:"amount_required" });

  const payload = { userPub, inMint, outMint, dir, amount: String(amount), slippageBps: Number(slippageBps||0), meta: meta||null };
  const payloadHash = sha256(JSON.stringify(payload));
  const pendingId = rid();

  const state = readJson(STATE_FILE, {version:1,usageEvents:[],pending:{}});
  state.pending = state.pending || {};
  state.pending[pendingId] = { id:pendingId, createdAt: now(), status:"CREATED", approvedAt:null, executedAt:null, userPub, payload, payloadHash, approvalHash:null, execSig:null, commit:null };
  atomicWriteJson(STATE_FILE, state);

  res.json({ ok:true, pendingId, payloadHash });
});

app.post("/api/pending/approve", (req,res)=>{
  const { pendingId, userPub, payloadHash } = req.body||{};
  if(!pendingId || !userPub || !payloadHash) return res.status(400).json({ ok:false, error:"pendingId_userPub_payloadHash_required" });

  const state = readJson(STATE_FILE, {version:1,usageEvents:[],pending:{}});
  const p = state.pending?.[pendingId];
  if(!p) return res.status(404).json({ ok:false, error:"pending_not_found" });
  if(p.userPub !== userPub) return res.status(403).json({ ok:false, error:"user_mismatch" });
  if(p.payloadHash !== payloadHash) return res.status(409).json({ ok:false, error:"payload_hash_mismatch" });
  if(p.status==="EXECUTED") return res.status(409).json({ ok:false, error:"already_executed" });

  p.status = "APPROVED";
  p.approvedAt = now();
  p.approvalHash = sha256(p.payloadHash + ":" + String(p.approvedAt));
  atomicWriteJson(STATE_FILE, state);

  res.json({ ok:true, pendingId, status:p.status, approvalHash:p.approvalHash });
});

app.post("/api/exec/tx", async (req,res)=>{
  try{
    const allow = loadAllow();
    if(allow.KILL_SWITCH) throw policyDeny("kill_switch_enabled","KILL");

    const { pendingId, userPub, rpcPrimary, rpcBackup } = req.body||{};
    if(!pendingId || !userPub) return res.status(400).json({ ok:false, error:"pendingId_userPub_required" });

    const state = readJson(STATE_FILE, {version:1,usageEvents:[],pending:{}});
    const p = state.pending?.[pendingId];
    if(!p) return res.status(404).json({ ok:false, error:"pending_not_found" });
    if(p.userPub !== userPub) return res.status(403).json({ ok:false, error:"user_mismatch" });

    if(p.status!=="APPROVED") return res.status(403).json({ ok:false, error:"not_approved" });
    if(p.executedAt) return res.status(409).json({ ok:false, error:"already_executed" });

    const pl = p.payload;
    const global = allow.global||{};
    const pairs = Array.isArray(allow.pairs)?allow.pairs:[];
    if((pairs.length===0) && !allow.ALLOW_ALL_IF_EMPTY) throw policyDeny("allowlist_empty_denied","ALLOWLIST");

    const pair = allowFor(allow, pl.inMint, pl.outMint, pl.dir);
    if(!pair && !allow.ALLOW_ALL_IF_EMPTY) throw policyDeny("pair_not_allowed","ALLOWLIST");

    const maxSlip = Math.min(Number(global.maxSlippageBps||0)||99999, Number(pair?.maxSlippageBps||99999));
    const slip = Number(pl.slippageBps||0);
    if(slip > maxSlip) throw policyDeny("slippage_too_high","LIMITS");

    const amountNum = Number(pl.amount);
    const maxInPerTx = Number(pair?.maxInPerTx||0) || 0;
    if(maxInPerTx>0 && amountNum>maxInPerTx) throw policyDeny("amount_exceeds_pair_maxInPerTx","LIMITS");

    const ua = usageAgg(state, userPub);
    const maxTx24 = Number(global.maxTxPer24h||0) || 0;
    const maxUsdc24 = Number(global.maxUsdcPer24h||0) || 0;
    const pairMaxTx24 = Number(pair?.maxTxPer24h||0) || 0;
    const pairMaxIn24 = Number(pair?.maxInPer24h||0) || 0;

    if(maxTx24>0 && ua.tx >= maxTx24) throw policyDeny("global_tx_quota_exceeded","QUOTA");
    if(pairMaxTx24>0){
      let ptx=0;
      for(const ev of (state.usageEvents||[])){ if(ev.userPub===userPub && ev.pairKey===`${pl.inMint}->${pl.outMint}:${pl.dir}`) ptx += (ev.txCount||0); }
      if(ptx >= pairMaxTx24) throw policyDeny("pair_tx_quota_exceeded","QUOTA");
    }
    if(pl.inMint===USDC_MINT && maxUsdc24>0 && ua.usdc + amountNum > maxUsdc24) throw policyDeny("global_usdc_quota_exceeded","QUOTA");
    if(pl.inMint===USDC_MINT && pairMaxIn24>0){
      let pus=0;
      for(const ev of (state.usageEvents||[])){ if(ev.userPub===userPub && ev.pairKey===`${pl.inMint}->${pl.outMint}:${pl.dir}`) pus += (ev.usdc||0); }
      if(pus + amountNum > pairMaxIn24) throw policyDeny("pair_usdc_quota_exceeded","QUOTA");
    }

    const q = await jupQuote({ inMint:pl.inMint, outMint:pl.outMint, amount: pl.amount, slippageBps: pl.slippageBps }, allow);
    const quote = q?.data?.[0];
    if(!quote) throw new Error("no_quote");

    const sw = await jupSwap({ quote, userPublicKey: userPub }, allow);
    const txb64 = sw?.swapTransaction;
    if(!txb64) throw new Error("no_swap_tx");

    const txHash = sha256(String(txb64));
    p.status = "TX_READY";
    p.txHash = txHash;
    p.txReadyAt = now();
    atomicWriteJson(STATE_FILE, state);

    res.json({ ok:true, pendingId, userPub, swapTransaction: txb64, txHash, quoteInfo: { inAmount: quote.inAmount, outAmount: quote.outAmount, otherAmountThreshold: quote.otherAmountThreshold } });
  }catch(e){
    res.status(400).json({ ok:false, error: e.code ? `${e.code}:${e.message}` : (e.message||"error") });
  }
});

app.post("/api/exec/commit", async (req,res)=>{
  try{
    const allow = loadAllow();
    if(allow.KILL_SWITCH) throw policyDeny("kill_switch_enabled","KILL");

    const { pendingId, userPub, signature } = req.body||{};
    if(!pendingId || !userPub || !signature) return res.status(400).json({ ok:false, error:"pendingId_userPub_signature_required" });

    const state = readJson(STATE_FILE, {version:1,usageEvents:[],pending:{}});
    const p = state.pending?.[pendingId];
    if(!p) return res.status(404).json({ ok:false, error:"pending_not_found" });
    if(p.userPub !== userPub) return res.status(403).json({ ok:false, error:"user_mismatch" });
    if(p.executedAt) return res.status(409).json({ ok:false, error:"already_executed" });

    if(p.commit && p.commit.signature===signature && (p.commit.status==="FINALIZED"||p.commit.status==="ERROR")) {
      return res.json({ ok:true, pendingId, commit:p.commit });
    }

    const conf = await confirmFinalized(signature, allow);
    p.execSig = signature;
    p.commit = { signature, status: conf.status, err: conf.err || null, at: now() };

    if(conf.status==="FINALIZED"){
      const pl = p.payload;
      const pairKey = `${pl.inMint}->${pl.outMint}:${pl.dir}`;
      const ev = { ts: now(), userPub, pairKey, txCount: 1, usdc: (pl.inMint===USDC_MINT ? Number(pl.amount)||0 : 0), sig: signature };
      state.usageEvents = state.usageEvents || [];
      state.usageEvents.push(ev);

      p.status = "EXECUTED";
      p.executedAt = now();
    }

    atomicWriteJson(STATE_FILE, state);
    res.json({ ok:true, pendingId, commit: p.commit, status:p.status });
  }catch(e){
    res.status(400).json({ ok:false, error: e.code ? `${e.code}:${e.message}` : (e.message||"error") });
  }
});

app.get("/api/pending/:id", (req,res)=>{

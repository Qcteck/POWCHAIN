set -euo pipefail
TS="$(date +%s)"

echo "== 1) Erreur exacte (file:line) =="
nginx -t 2>&1 | tail -n 60 || true

echo
echo "== 2) Trouver les proxy_set_header CASSÉS (valeur manquante) =="
# match: proxy_set_header <NAME> ;
grep -RIn --include='*.conf' -E 'proxy_set_header[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;' /etc/nginx || true

echo
echo "== 3) Backup + supprimer ces lignes cassées partout =="
mapfile -t BADFILES < <(grep -RIl --include='*.conf' -E 'proxy_set_header[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;' /etc/nginx || true)
for f in "${BADFILES[@]:-}"; do
  cp -a "$f" "$f.bak.$TS"
  # delete only the broken "proxy_set_header NAME ;" lines
  sed -i -E '/proxy_set_header[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;/d' "$f"
  echo "Fixed: $f (backup: $f.bak.$TS)"
done

echo
echo "== 4) Écrire snippet RPC PROPRE (PAS de \\$) =="
SNIP="/etc/nginx/snippets/wolv_rpc_proxy.conf"
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'EOF'
# Wolverine: Solana RPC proxy (same-origin)
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  add_header X-Wolv-RPC "1" always;

  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF

echo
echo "== 5) nginx test + reload =="
nginx -t
systemctl reload nginx

echo
echo "== 6) Test (doit PAS être 404 + doit contenir X-Wolv-RPC: 1) =="
curl -ksS -i "https://fireinners.online/wolverine/traderone/api/rpc" \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 40
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== 1) Preuve: Nginx charge un snippets.bak ==="
nginx -T 2>/dev/null | grep -n "snippets\.bak" | head -n 120 || true

echo
echo "=== 2) Trouver les includes dangereux (snippets*) dans /etc/nginx ==="
grep -RIn --include="*.conf" -E 'include\s+/etc/nginx/snippets\*' /etc/nginx || true

echo
echo "=== 3) Trouver tous les include vers snippets (pour vérifier) ==="
grep -RIn --include="*.conf" -E 'include\s+/etc/nginx/snippets' /etc/nginx | head -n 200 || true

echo
echo "=== 4) Fix auto: remplacer include /etc/nginx/snippets* -> /etc/nginx/snippets/ ==="
# On remplace seulement les patterns qui matchent "snippets*" (dangereux)
# et on les rend stricts: /etc/nginx/snippets/*.conf
mapfile -t BADFILES < <(grep -RIl --include="*.conf" -E 'include\s+/etc/nginx/snippets\*' /etc/nginx || true)

for f in "${BADFILES[@]:-}"; do
  echo "Fixing: $f"
  cp -a "$f" "$f.bak.fix_snippets_glob.$TS"
  sed -i -E 's|include[[:space:]]+/etc/nginx/snippets\*[^;]*;|include /etc/nginx/snippets/*.conf;|g' "$f"
done

echo
echo "=== 5) Test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 6) Recheck: plus aucun snippets.bak chargé ==="
nginx -T 2>/dev/null | grep -n "snippets\.bak" | head -n 80 || echo "✅ OK: snippets.bak n'est plus inclus"
echo "DONE ✅"
bash -lc 'cat >/root/MEGA_WOLVERINE_SSL_FIX_AND_TEST.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/MEGA_WOLVERINE_SSL_FIX_AND_TEST_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

HOST="fireinners.online"
WEBROOT="/var/www/wolverine"
BADGE_REL="/wolverine/_wolverine_ok.txt"
BADGE_FILE="${WEBROOT}/_wolverine_ok.txt"

INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"

BACKUP_DIR="/root/wolverine_backups"
mkdir -p "$BACKUP_DIR"

need(){ command -v "$1" >/dev/null 2>&1; }
say(){ echo "== $* =="; }

unlock_if_immutable(){
  local f="$1"
  if [ -e "$f" ]; then
    if lsattr -d "$f" 2>/dev/null | grep -q "i-"; then
      echo "immutable: $f -> chattr -i"
      chattr -i "$f" || true
      echo "$f" >> "${BACKUP_DIR}/_relock_${TS}.lst"
    fi
  fi
}
relock_all(){
  local lst="${BACKUP_DIR}/_relock_${TS}.lst"
  [ -f "$lst" ] || return 0
  while IFS= read -r f; do
    [ -e "$f" ] || continue
    echo "relock: $f -> chattr +i"
    chattr +i "$f" || true
  done <"$lst"
}

backup_file(){
  local f="$1"
  [ -e "$f" ] || return 0
  local base
  base="$(basename "$f")"
  cp -a "$f" "${BACKUP_DIR}/${base}.bak_${TS}" || true
}

discover_ui_source(){
  # Cherche un index.html “Wolverine” en priorité dans /opt (exports), puis backups
  local cand=""
  for p in \
    "/opt/WOLVERINE1_export/ui/index.html" \
    "/opt/wolverine/index.html" \
    "/opt/fireinners/WOLVERINE/index.html" \
    "/opt/fireinners/frontend-react/app/dist/wolverine/index.html" \
    ; do
    if [ -f "$p" ]; then cand="$p"; break; fi
  done
  if [ -z "$cand" ]; then
    cand="$(grep -RIl --exclude-dir=node_modules --exclude-dir=.git -m1 "Wolverine" /opt 2>/dev/null | grep -E "/index\.html$" | head -n1 || true)"
  fi
  echo "$cand"
}

restore_webroot_if_missing(){
  say "Webroot check"
  mkdir -p "$WEBROOT"
  if [ ! -f "${WEBROOT}/index.html" ]; then
    echo "index.html is MISSING in ${WEBROOT} -> attempting restore"
    local src
    src="$(discover_ui_source)"
    if [ -n "$src" ] && [ -f "$src" ]; then
      local srcdir
      srcdir="$(dirname "$src")"
      echo "Found UI source dir: $srcdir"
      echo "Restoring: $srcdir/* -> $WEBROOT/"
      rsync -a --delete "$srcdir"/ "$WEBROOT"/
    else
      echo "No UI source found. (Cannot restore index.html automatically.)"
    fi
  else
    echo "index.html exists: ${WEBROOT}/index.html"
  fi
}

ensure_badge(){
  say "Badge"
  mkdir -p "$WEBROOT"
  echo "OK ${TS} host=${HOST} backend=127.0.0.1:3000" > "$BADGE_FILE"
}

write_inc(){
  say "Write nginx include (Wolverine routes)"
  unlock_if_immutable "$INC"
  backup_file "$INC"
  cat >"$INC" <<EOF
# AUTO-GENERATED ${TS} (MEGA_WOLVERINE_SSL_FIX_AND_TEST)
# Wolverine static
location = /wolverine/_wolverine_ok.txt { alias ${WEBROOT}/_wolverine_ok.txt; add_header Cache-Control "no-store" always; }
location ^~ /wolverine/_next/ { alias ${WEBROOT}/_next/; try_files \$uri =404; add_header Cache-Control "no-store" always; }
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

# TraderOne API proxy (preferred path)
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;
  proxy_pass http://127.0.0.1:3000/;
}

# Compatibility path (/wolverine/api/)
location ^~ /wolverine/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;
  proxy_pass http://127.0.0.1:3000/;
}

# Static root
location ^~ /wolverine/ { alias ${WEBROOT}/; try_files \$uri \$uri/ /wolverine/index.html; add_header Cache-Control "no-store" always; }
EOF
}

find_cert(){
  local d=""
  if [ -d "/etc/letsencrypt/live/${HOST}" ]; then d="/etc/letsencrypt/live/${HOST}"; fi
  if [ -z "$d" ]; then
    d="$(ls -d /etc/letsencrypt/live/${HOST}* 2>/dev/null | head -n1 || true)"
  fi
  echo "$d"
}

ensure_vhost_ssl(){
  say "Ensure nginx SSL vhost"
  unlock_if_immutable "$VHOST"
  unlock_if_immutable "/etc/nginx/nginx.conf"
  backup_file "$VHOST"

  local certdir
  certdir="$(find_cert)"
  if [ -z "$certdir" ] || [ ! -f "${certdir}/fullchain.pem" ] || [ ! -f "${certdir}/privkey.pem" ]; then
    echo "No LetsEncrypt cert found for ${HOST}. SSL vhost cannot be safely built."
    echo "You must have /etc/letsencrypt/live/${HOST}/fullchain.pem + privkey.pem."
    exit 1
  fi

  # Minimal SSL vhost that includes Wolverine routes (does not touch other locations)
  cat >"$VHOST" <<EOF
server {
  listen 80;
  server_name ${HOST};
  return 301 https://\$host\$request_uri;
}

server {
  listen 443 ssl http2;
  server_name ${HOST};

  ssl_certificate     ${certdir}/fullchain.pem;
  ssl_certificate_key ${certdir}/privkey.pem;

  # baseline headers
  add_header X-Frame-Options SAMEORIGIN always;
  add_header X-Content-Type-Options nosniff always;

  # include Wolverine routes
  include /etc/nginx/includes/wolverine_routes.inc;

  # default fallback (do not break other site roots)
  location / { try_files \$uri \$uri/ =404; }
}
EOF

  # Enable vhost
  if [ ! -L "$VHOST_EN" ]; then
    ln -sf "$VHOST" "$VHOST_EN"
  fi
}

ensure_ufw_443(){
  say "UFW check (443)"
  if need ufw; then
    ufw status | grep -q "443/tcp" || ufw allow 443/tcp >/dev/null || true
  fi
}

nginx_reload(){
  say "Nginx test + reload"
  nginx -t
  systemctl reload nginx
}

tests(){
  say "Tests"
  echo "-- A) Backend direct (must be JSON) --"
  curl -sS -D- http://127.0.0.1:3000/health 2>/dev/null | head -n 40 || true

  echo
  echo "-- B) Local nginx badge (must be 200 OK) --"
  curl -sS -k -D- "https://127.0.0.1${BADGE_REL}" -H "Host: ${HOST}" 2>/dev/null | head -n 40 || true

  echo
  echo "-- C) Local nginx API health via /wolverine/traderone/api (must be JSON, not HTML) --"
  curl -sS -k -D- "https://127.0.0.1/wolverine/traderone/api/health" -H "Host: ${HOST}" 2>/dev/null | head -n 60 || true

  echo
  echo "-- D) Public badge (must be 200 OK) --"
  curl -sS -D- "https://${HOST}${BADGE_REL}" 2>/dev/null | head -n 40 || true

  echo
  echo "-- E) Public API health (must be JSON) --"
  curl -sS -D- "https://${HOST}/wolverine/traderone/api/health" 2>/dev/null | head -n 60 || true

  echo
  echo "-- If errors: last nginx errors --"
  tail -n 80 /var/log/nginx/error.log 2>/dev/null || true
}

preflight(){
  say "Preflight listeners"
  ss -lntp | egrep "(:80|:443|:3000)\b" || true
}

main(){
  say "START ${TS}"
  preflight

  say "Backup webroot + nginx files"
  tar -czf "${BACKUP_DIR}/wolverine_webroot_${TS}.tgz" -C /var/www wolverine 2>/dev/null || true
  backup_file "$INC"
  backup_file "$VHOST"

  restore_webroot_if_missing
  ensure_badge
  write_inc
  ensure_vhost_ssl
  ensure_ufw_443
  nginx_reload

  preflight
  tests

  relock_all
  say "DONE. LOG=${LOG}"
}

main
BASH
chmod +x /root/MEGA_WOLVERINE_SSL_FIX_AND_TEST.sh
/root/MEGA_WOLVERINE_SSL_FIX_AND_TEST.sh'
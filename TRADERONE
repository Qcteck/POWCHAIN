die(){ say "ERROR: $*"; exit 1; }

DOMAIN="fireinners.online"
WWW="/var/www/aquilatrader"
INDEX="$WWW/index.html"

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_static.inc"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_AQUILATRADER_FIX_V2_${TS}"
mkdir -p "$BK"

say "MEGA_AQUILATRADER_FIX_V2"
say "Goal: https://${DOMAIN}/aquilatrader/ serves ${INDEX} (no manual edits)"
say "Log:  ${LOG}"
say "BK:   ${BK}"
hr

# -----------------------------
# 0) Preconditions + backups
# -----------------------------
[ -f "$VHOST" ] || die "Missing vhost: $VHOST"
[ -f "$INC" ]   || die "Missing include: $INC (expected by Wolverine vhost)"

say "0) Backup nginx files"
cp -a "$VHOST" "$BK/$(basename "$VHOST").bak"
cp -a "$INC"   "$BK/$(basename "$INC").bak"
nginx -t >/dev/null 2>&1 || true
hr

# -----------------------------
# 1) Ensure webroot + index
# -----------------------------
say "1) Ensure ${WWW} + index.html"
mkdir -p "$WWW"
if [ ! -f "$INDEX" ]; then
  cat >"$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>AquilaTrader</title>
  <style>
    body{font-family:system-ui,Segoe UI,Roboto,Arial;margin:0;background:#0b0f14;color:#e6eef8}

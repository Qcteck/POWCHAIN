cat >/root/fix_405_traderone_api_proxy.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
API_UPSTREAM="${API_UPSTREAM:-http://127.0.0.1:3000}"   # <= change si besoin

ts="$(date +%Y%m%d_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/backup_api_proxy_${ts}"
mkdir -p "$BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
echo "[OK] Backup -> $BACKDIR/$(basename "$VHOST")"

# Inject proxy block before the static /wolverine/ block (idempotent)
perl -0777 -i -pe '
my $up = $ENV{API_UPSTREAM} // "http://127.0.0.1:3000";

# remove previous injected api block if exists
s/\n\s*# --- traderone api proxy \(injected\) ---.*?\n\s*# --- end traderone api proxy ---\n//ms;

my $block = qq{
  # --- traderone api proxy (injected) ---
  location ^~ /wolverine/traderone/api/ {
    # CORS preflight (si ton front est sur le même domaine, ça ne gêne pas)
    if (\$request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
      add_header Access-Control-Allow-Headers "Authorization,Content-Type,Accept" always;
      return 204;
    }

    proxy_pass $up/;
    proxy_http_version 1.1;

    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;

    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
  # --- end traderone api proxy ---
};

# insert block before static location ^~ /wolverine/
if (s/\n(\s*location\s+\^\~\s+\/wolverine\/\s*\{)/\n$block\n$1/ms) {
  # ok
} else {
  die "ERR: cannot find location ^~ /wolverine/ block to insert before\n";
}
' "$VHOST"

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "Tests:"
echo "  curl -sSI https://$DOMAIN/wolverine/traderone/api/ | head -n 12"
echo "  curl -sSI -X POST https://$DOMAIN/wolverine/traderone/api/ | head -n 12"
BASH

chmod +x /root/fix_405_traderone_api_proxy.sh

# Mets ton port backend ici si ce n'est pas 3000 :
# API_UPSTREAM="http://127.0.0.1:XXXX" /root/fix_405_traderone_api_proxy.sh fireinners.online
API_UPSTREAM="http://127.0.0.1:3000" /root/fix_405_traderone_api_proxy.sh fireinners.online
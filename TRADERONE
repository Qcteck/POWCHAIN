cat >/root/fix_blob_encode_lamports_buffer.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DIR="/var/www/wolverine"
HTML="$DIR/index.html"

test -f "$HTML" || { echo "❌ Missing $HTML"; exit 1; }
cp -a "$HTML" "${HTML}.bak_${TS}"

echo "== 1) Download a REAL buffer polyfill locally (try multiple CDNs) =="
OUT="$DIR/buffer.real.min.js"
urls=(
  "https://cdn.jsdelivr.net/npm/buffer@6.0.3/umd/buffer.min.js"
  "https://cdn.jsdelivr.net/npm/buffer@6.0.3/index.min.js"
  "https://unpkg.com/buffer@6.0.3/index.min.js"
  "https://cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js"
)
ok=0
for u in "${urls[@]}"; do
  echo "TRY: $u"
  if curl -fsSL "$u" -o "$OUT"; then ok=1; echo "OK: $u"; break; else echo "FAIL"; fi
done
[ "$ok" -eq 1 ] || { echo "❌ Could not download buffer polyfill"; exit 1; }
chmod 0644 "$OUT"
ls -lah "$OUT"

echo "== 2) Patch index.html: remove all old Buffer hacks + inject ONE clean polyfill in <head> =="
python3 - <<'PY'
from pathlib import Path
import re

p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# remove any previous injected polyfills and any script tags containing "buffer"
s = re.sub(r"<!--\s*WOLVERINE_BUFFER_POLYFILL\s*-->.*?(?=</head>)", "", s, flags=re.S|re.I)
s = re.sub(r'<script[^>]+src=["\'][^"\']*buffer[^"\']*["\'][^>]*>\s*</script>\s*', '', s, flags=re.I)

poly = r"""
<!-- WOLVERINE_BUFFER_POLYFILL -->
<script>
  // minimal globals expected by some bundles
  window.global = window;
  window.process = window.process || { env: {} };
</script>
<script src="/wolverine/buffer.real.min.js"></script>
<script>
  // buffer package exposes window.buffer.Buffer (the real one with Buffer.from, alloc, etc.)
  if (window.buffer && window.buffer.Buffer) {
    window.Buffer = window.buffer.Buffer;
  }
</script>
"""

if "</head>" in s:
    s = s.replace("</head>", poly + "\n</head>", 1)
else:
    s = poly + "\n" + s

p.write_text(s)
print("OK: clean Buffer polyfill injected")
PY

echo "== 3) Patch the Send SOL script: force lamports to BigInt (u64) =="
python3 - <<'PY'
from pathlib import Path
import re
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# replace lamports calc if present
s = re.sub(
  r"lamports:\s*Math\.round\(\s*amountSol\s*\*\s*solanaWeb3\.LAMPORTS_PER_SOL\s*\)",
  r"lamports: BigInt(Math.round(amountSol * solanaWeb3.LAMPORTS_PER_SOL))",
  s
)

p.write_text(s)
print("OK: lamports now BigInt")
PY

systemctl reload nginx || service nginx reload

echo
echo "== ORIGIN checks =="
curl -sk --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/ | grep -n "WOLVERINE_BUFFER_POLYFILL" && echo "HTML OK ✅" || echo "HTML NOT OK ❌"
curl -sk --resolve fireinners.online:443:127.0.0.1 -I https://fireinners.online/wolverine/buffer.real.min.js | sed -n '1,12p'
echo "DONE ✅"
BASH

chmod +x /root/fix_blob_encode_lamports_buffer.sh
/root/fix_blob_encode_lamports_buffer.sh
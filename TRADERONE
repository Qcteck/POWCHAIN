cat >/tmp/WOLVERINE_WHY_8585_NOT_LISTENING.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SVC="traderone.service"
FILE="/opt/traderone-opt/server.js"

echo "== 1) MainPID + cmdline =="
PID="$(systemctl show -p MainPID --value "$SVC")"
echo "MainPID=$PID"
[ "$PID" != "0" ] || { echo "Service pas démarré (MainPID=0)"; exit 1; }
tr '\0' ' ' < "/proc/$PID/cmdline"; echo
echo

echo "== 2) LISTEN (8585/9696) global =="
ss -lntp | egrep ':(8585|9696)\s' || true
echo

echo "== 3) LISTEN du process node (très fiable) =="
lsof -p "$PID" -a -iTCP -sTCP:LISTEN -nP || echo "AUCUN socket LISTEN pour ce PID"
echo

echo "== 4) Variables d'environnement du service (PORT/HOST/BIND) =="
systemctl show "$SVC" -p Environment --no-pager | sed -n '1,3p' || true
echo

echo "== 5) Extrait server.js (PORT + listen host) =="
grep -nE 'process\.env\.PORT|PORT[[:space:]]*=|app\.listen\(|listen\(' "$FILE" || true
echo

echo "== 6) Logs récents (si crash avant listen) =="
journalctl -u "$SVC" -n 80 --no-pager || true
echo

echo "== 7) Test multi-IP (au cas où ça écoute sur une autre IP) =="
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
for H in 127.0.0.1 0.0.0.0 10.66.66.1; do
  echo "--- curl http://$H:8585/api/health"
  curl -sS -m 2 -D- "http://$H:8585/health" 2>/dev/null | head -n 6 || echo "(no response)"
done
echo

echo "DONE ✅"
SH

bash /tmp/WOLVERINE_WHY_8585_NOT_LISTENING.sh
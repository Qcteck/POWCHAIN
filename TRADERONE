cat >/root/WOLVERINE_PHANTOM_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup =="
cp "$HTML" "$HTML.bak_$TS"

echo "== Write clean Phantom-only index.html =="

cat >"$HTML" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>WOLVERINE • Phantom Connect</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{background:#0b0f14;color:#00eaff;font-family:Arial,Helvetica,sans-serif;display:flex;justify-content:center;align-items:center;height:100vh}
#box{border:2px solid #00eaff;padding:20px;width:360px;text-align:center}
button{width:100%;padding:10px;margin:6px 0;font-size:16px;cursor:pointer}
.addr{word-break:break-all;font-size:13px;margin-top:6px}
</style>
</head>

<body>
<div id="box">
  <button onclick="connect()">Connect Wallet</button>
  <div class="addr" id="addr"></div>
  <div>SOL: <span id="sol">-</span></div>
</div>

<script>
async function connect(){
  if(!window.solana || !window.solana.isPhantom){
    alert("Phantom Wallet not detected");
    return;
  }

  const res = await window.solana.connect();
  const pub = res.publicKey.toString();
  document.getElementById("addr").textContent = pub;

  const rpc = "https://rpc.ankr.com/solana";
  const body = {
    jsonrpc:"2.0",
    id:1,
    method:"getBalance",
    params:[pub]
  };

  const r = await fetch(rpc,{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify(body)
  });

  const j = await r.json();
  document.getElementById("sol").textContent =
    j.result ? (j.result.value/1e9).toFixed(4) : "0";
}
</script>
</body>
</html>
HTML

echo "== Permissions =="
chown www-data:www-data "$HTML"
chmod 644 "$HTML"

echo "======================================"
echo "✅ PHANTOM CONNECT FIX APPLIED"
echo "Backup: $HTML.bak_$TS"
echo "Reload page with CTRL+SHIFT+R"
echo "======================================"
BASH

chmod +x /root/WOLVERINE_PHANTOM_FIX.sh
/root/WOLVERINE_PHANTOM_FIX.sh
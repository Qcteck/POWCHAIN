cat >/root/MEGA_AQUILATRADER_FIX_V2.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

# -----------------------------
# Self-log wrapper (no manual tee needed)
# -----------------------------
LOG="/root/MEGA_AQUILATRADER_FIX_V2.log"
if [ -z "${_TEE_LOGGED:-}" ]; then
  export _TEE_LOGGED=1
  bash "$0" |& tee "$LOG"
  exit ${PIPESTATUS[0]}
fi

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

from pathlib import Path
import re

inc = Path("${NGINX_INC}")
s = inc.read_text(errors="ignore")

def strip_location_blocks(txt, needle):
  # retire tout bloc "location ... { ... }" contenant needle
  out = []
  i = 0
  while i < len(txt):
    m = re.search(r'\n\s*location\s+[^\\n{]*\{', txt[i:])
    if not m:
      out.append(txt[i:])
      break
    start = i + m.start()
    out.append(txt[i:start])
    # trouver fin du bloc via comptage accolades
    j = start
    brace = 0
    while j < len(txt):
      if txt[j] == '{': brace += 1
      elif txt[j] == '}':
        brace -= 1
        if brace == 0:
          j += 1
          break
      j += 1
    block = txt[start:j]
    if needle in block:
      i = j  # skip
    else:
      out.append(block)
      i = j
  return ''.join(out)

for needle in ["/wolverine/solana-rpc", "/wolverine/vault/api"]:
  s = strip_location_blocks(s, needle)

# Ajoute blocs canoniques
append = f"""
# --- WOLVERINE canonical proxies (AQUILA) ---
location ^~ /wolverine/solana-rpc {{
  proxy_pass http://127.0.0.1:{${"SOLRPC_PORT"}};

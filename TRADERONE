set -e
cd /root

echo "=== 0) Sauvegarde (au cas où) ==="
cp -v /opt/traderone/server.js /opt/traderone/server.js.SAVE.$(date +%s) || true
cp -v /opt/traderone/api/server.js /opt/traderone/api/server.js.SAVE.$(date +%s) || true

echo
echo "=== 1) Crée une version CommonJS (évite require/ESM) ==="
cp -v /opt/traderone/api/server.js /opt/traderone/api/server.cjs

echo
echo "=== 2) Vérifie sur quel port ça écoute (sinon on force PORT=3000) ==="
grep -nE "listen\\(|PORT|process\\.env\\.PORT" /opt/traderone/api/server.cjs || true

echo
echo "=== 3) Kill un vieux truc sur 3000 puis lance le REST ==="
sudo fuser -k 3000/tcp 2>/dev/null || true
nohup env PORT=3000 node /opt/traderone/api/server.cjs > /var/log/traderone-rest.log 2>&1 &
sleep 1

echo
echo "=== 4) Check écoute + test REST direct ==="
ss -ltnp | egrep ':3000|:12703|:3002' || true
curl -sS -i -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' | head -n 40 || true
echo
curl -sS -i -X POST http://127.0.0.1:3000/api/start  -H "content-type: application/json" --data '{}' | head -n 40 || true

echo
echo "=== 5) Si ça plante: log ==="
tail -n 120 /var/log/traderone-rest.log || true
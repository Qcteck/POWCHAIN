cat >> /var/www/fireinners/wolverine/app.js <<'JS'

/* WOLVERINE_CONNECT_FIX_BEGIN */
btnConnect.onclick = async () => {
  try {
    if (!window.solana || !window.solana.isPhantom) {
      setStatus("Phantom non détecté");
      return;
    }
    const r = await window.solana.connect();
    pubkey = r.publicKey;
    afterConnect.style.display = "block";
    // si tu as un élément pour afficher l’adresse, adapte l’id ici
    // ex: document.getElementById("walletAddr").textContent = pubkey.toString();
    setStatus("Wallet: " + pubkey.toString());
    await refreshBoth();
  } catch (e) {
    setStatus("ERR " + (e?.message || e));
  }
};
/* WOLVERINE_CONNECT_FIX_END */

JS
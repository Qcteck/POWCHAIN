if (!s.includes("/root/traderone_wallet_backup.txt")) {
  // Ajoute fs si absent
  if (!s.match(/const\s+fs\s*=\s*require\(["']fs["']\);/)) {
    s = s.replace(/(['"]use strict['"];\s*\n)/, `$1\nconst fs = require("fs");\n`);
  }

  // Ajoute la fonction loadTraderOneWallet si absente
  if (!s.includes("function loadTraderOneWallet()")) {
    const insertAfter = `const { createJupiterApiClient } = require("@jup-ag/api");\n`;
    if (s.includes(insertAfter)) {
      s = s.replace(
        insertAfter,
        insertAfter +
`

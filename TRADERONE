cat >/root/MEGA_AQUILATRADER_FIX_V2.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }
hr(){ echo "----------------------------------------------------------------"; }

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_AQUILATRADER_${TS}"
mkdir -p "$BK"

DOMAIN="fireinners.online"
WWW="/var/www/aquilatrader"
INDEX="$WWW/index.html"

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
INC_FILE="$INC_DIR/wolverine_static.inc"

say "MEGA_AQUILATRADER_FIX_V2"
say "Goal: https://${DOMAIN}/aquilatrader/ works (single nginx route, no duplicates)"
say "Backup: $BK"
hr

say "0) Preflight: files"
[ -f "$NGX_VHOST" ] || die "Missing vhost: $NGX_VHOST"
[ -f "$INC_FILE" ] || die "Missing include used by vhost: $INC_FILE"

cp -a "$NGX_VHOST" "$BK/fireinners.online-ssl.bak" || true
cp -a /etc/nginx/nginx.conf "$BK/nginx.conf.bak" || true
cp -a "$INC_FILE" "$BK/wolverine_static.inc.bak" || true

hr
say "1) Ensure AquilaTrader webroot exists"
mkdir -p "$WWW"
if [ ! -f "$INDEX" ]; then
  say "Writing $INDEX"
  cat >"$INDEX" <<'HTML'
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaTrader</title><style>body{margin:0;font-family:system-ui,Segoe UI,Roboto,Arial;background:#0b1020;color:#e8eefc}main{max-width:760px;margin:0 auto;padding:26px}h1{margin:0 0 10px}button,input{font:inherit}input{width:100%;padding:14px 16px;border-radius:14px;border:1px solid #2a3555;background:#0f1730;color:#e8eefc;outline:none}button{margin-top:14px;margin-right:10px;padding:14px 18px;border-radius:16px;border:1px solid #2a3555;background:#0f1730;color:#9fc2ff;cursor:pointer}button:hover{filter:brightness(1.08)}.row{margin-top:14px}.muted{opacity:.8}</style></head><body><main><h1>AquilaTrader</h1><div class="muted">Wallet: <span id="addr">-</span></div><div class="row"><input id="pub" placeholder="Wallet pubkey (optionnel)"></div><div class="row"><button id="start">Start</button><button id="stop">Stop</button><button id="cash">Cash-out</button></div><pre id="log" style="margin-top:18px;white-space:pre-wrap;word-break:break-word"></pre><script>
const log=(m)=>{const e=document.getElementById("log");e.textContent+=(typeof m==="string"?m:JSON.stringify(m,null,2))+"\n";};
const post=async(u,o)=>{const r=await fetch(u,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(o||{})});const t=await r.text();try{return JSON.parse(t)}catch{return {status:r.status,body:t}}};
document.getElementById("start").onclick=async()=>{log(await post("/wolverine/traderone/api/start"))};
document.getElementById("stop").onclick=async()=>{log(await post("/wolverine/traderone/api/stop"))};
document.getElementById("cash").onclick=async()=>{const pub=document.getElementById("pub").value.trim();log(await post("/wolverine/traderone/api/cashout",{userPub:pub||undefined}))};
</script></main></body></html>
HTML
fi

hr
say "2) Ensure nginx has exactly ONE /aquilatrader route in $INC_FILE"

# Build canonical block using root (avoid alias/try_files pitfalls)
CANON_BLOCK="$(cat <<'NGX'
# BEGIN_AQUILATRADER_MANAGED
location ^~ /aquilatrader/ {
  root /var/www;
  try_files $uri $uri/ /aquilatrader/index.html;
  add_header Cache-Control "no-store" always;
}
# END_AQUILATRADER_MANAGED
NGX
)"

python3 - <<PY
import re,sys
inc_path=${INC_FILE!r}
s=open(inc_path,'r',encoding='utf-8',errors='ignore').read()

# Remove prior managed blocks
s=re.sub(r'(?s)# BEGIN_AQUILATRADER_MANAGED.*?# END_AQUILATRADER_MANAGED\\s*','',s)

# Remove any other aquilatrader location blocks (best-effort)
# 1) location ... /aquilatrader ...
s=re.sub(r'(?s)\\blocation\\s+[^\\{]*aquilatrader[^\\{]*\\{.*?\\}\\s*','',s)

# Normalize trailing newline
if not s.endswith('\\n'): s+='\n'

s += "\n" + ${CANON_BLOCK!r}.strip() + "\n"

open(inc_path,'w',encoding='utf-8').write(s)
print("OK: wrote cleaned include with single /aquilatrader block ->", inc_path)
PY

hr
say "3) nginx -t (rollback if fail) + reload"
set +e
nginx -t
RC=$?
set -e
if [ "$RC" -ne 0 ]; then
  say "nginx -t FAILED -> rollback backups"
  cp -a "$BK/wolverine_static.inc.bak" "$INC_FILE" || true
  cp -a "$BK/fireinners.online-ssl.bak" "$NGX_VHOST" || true
  [ -f "$BK/nginx.conf.bak" ] && cp -a "$BK/nginx.conf.bak" /etc/nginx/nginx.conf || true
  nginx -t || true
  die "Rollback done. Fix not applied. Check: $BK"
fi
systemctl reload nginx

hr
say "4) Local checks (Host header) + show first lines"
curl -sk "https://127.0.0.1/aquilatrader/" -H "Host: ${DOMAIN}" | head -n 20 || true
hr
say "5) Public hint"
say "Open: https://${DOMAIN}/aquilatrader/"
say "Backup: $BK"
BASH

bash /root/MEGA_AQUILATRADER_FIX_V2.sh |& tee /root/MEGA_AQUILATRADER_FIX_V2.log
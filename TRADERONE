bash -lc 'set -euo pipefail;VHOST="/etc/nginx/sites-available/fireinners.online-ssl";SNIP="/etc/nginx/snippets/private_sentinel.conf";PATHLOC="/_private_sentinel_/";HTPASS="/etc/nginx/.htpasswd_sentinel";echo "== PRECHECK ==";test -f "$VHOST" || { echo "VHOST introuvable: $VHOST"; exit 1; };echo "[UFW]";ufw status numbered || true;echo "[LISTEN]";ss -lntp | egrep ":(80|443|3000|4001|8484|8585)\b" || true;echo;echo "== (1) Ferme les ports publics interdits (si présents) ==";for p in 3000 8484 8585 4001; do ufw delete allow ${p}/tcp >/dev/null 2>&1 || true; ufw delete allow ${p} >/dev/null 2>&1 || true; done;ufw deny 3000/tcp >/dev/null 2>&1 || true;ufw deny 8484/tcp >/dev/null 2>&1 || true;ufw deny 8585/tcp >/dev/null 2>&1 || true;ufw deny 4001/tcp >/dev/null 2>&1 || true;echo "OK";echo;echo "== (2) Outil htpasswd + création user ==";command -v htpasswd >/dev/null 2>&1 || (apt-get update -y && apt-get install -y apache2-utils);read -r -p "User BasicAuth (ex: sentinel): " U;test -n "${U:-}" || { echo "User vide"; exit 1; };htpasswd -B -c "$HTPASS" "$U";chmod 640 "$HTPASS";chown root:www-data "$HTPASS" || true;echo;echo "== (3) Crée un snippet Nginx privé ==";mkdir -p /etc/nginx/snippets;cat >"$SNIP" <<EOF
location ^~ ${PATHLOC} {
  auth_basic "Sentinel";
  auth_basic_user_file ${HTPASS};
  proxy_pass http://127.0.0.1:3000/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
}
EOF
echo;echo "== (4) Injecte include dans le vhost SSL (si absent) ==";grep -qF "include $SNIP;" "$VHOST" || perl -0777 -i -pe "s/(server_name\\s+[^;]*fireinners\\.online[^;]*;)/$1\\n    include $SNIP;/s" "$VHOST";echo;echo "== (5) Test + reload nginx ==";nginx -t;systemctl reload nginx;echo;echo "== (6) Test attendu: 401 (popup) ==";code=$(curl -s -o /dev/null -w "%{http_code}" -I "https://fireinners.online${PATHLOC}");echo "HTTP=$code (attendu 401)";if [ "$code" = "200" ]; then echo "ATTENTION: pas protégé. Le vhost actif ou le location ne matche pas.";echo "Montre-moi: nginx -T | sed -n \"/server_name.*fireinners.online/,/}/p\" | head -n 220";fi;echo;echo "DONE. URL: https://fireinners.online${PATHLOC}"'
set -euo pipefail

APP="/opt/wolverine-ui"          # ton nouveau UI (vite+react)
DIST="/var/www/wolverine"        # servi par nginx
NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date +%s)"

echo "=== 0) Sanity ==="
[ -d "$APP" ] || { echo "KO: $APP introuvable"; exit 1; }
[ -f "$NG" ] || { echo "KO: $NG introuvable"; exit 1; }

echo "=== 1) Build Vite avec BASE /wolverine/ + API ==="
cd "$APP"

# Assure base path pour Vite
if [ -f vite.config.js ]; then
  grep -q "base:" vite.config.js || \
  sed -i "1s/^/export default { base: '\/wolverine\/' };\n/" vite.config.js
fi
if [ -f vite.config.mjs ]; then
  grep -q "base:" vite.config.mjs || \
  sed -i "1s/^/export default { base: '\/wolverine\/' };\n/" vite.config.mjs
fi

cat > .env.production <<'EOF'
VITE_API_BASE=/wolverine/traderone/api
EOF

npm install --legacy-peer-deps
npm run build

echo "=== 2) Deploy dist -> /var/www/wolverine ==="
if [ -d "$DIST" ]; then
  mv "$DIST" "/var/www/wolverine_backup_$TS"
fi
mkdir -p "$DIST"
rsync -a --delete "$APP/dist/" "$DIST/"

echo "=== 3) Nginx: /wolverine sert /var/www/wolverine (SPA) ==="
cp -a "$NG" "$NG.bak.wolverine_fix.$TS"

python3 - <<'PY'
from pathlib import Path
import re
ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# Enlève anciens blocs UI /wolverine (sans toucher /wolverine/traderone/api)
s = re.sub(r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*', "\n", s, flags=re.M)
s = re.sub(r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*', "\n", s, flags=re.M)

block = r'''
# --- WOLVERINE UI (SPA) ---
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}
'''
i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: nginx conf invalide")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: bloc /wolverine écrit")
PY

nginx -t
systemctl reload nginx

echo "=== 4) Tests (index + assets) ==="
echo "--- TITLE ---"
curl -LsS https://fireinners.online/wolverine/ | grep -i "<title>" | head -n 1 || true

echo "--- 10 premiers assets (doivent répondre 200, pas 404) ---"
ASSETS=$(curl -LsS https://fireinners.online/wolverine/ | grep -Eo '(src|href)="/[^"]+' | cut -d'"' -f2 | head -n 10 || true)
for a in $ASSETS; do
  code=$(curl -sS -o /dev/null -w "%{http_code}" "https://fireinners.online$a" || true)
  echo "$code  $a"
done

echo "--- API health ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12 || true

echo "DONE ✅"
cat >/tmp/FIX_DUP_SNIPPETS_GLOB_INCLUDE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"

AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
VHOST="$(readlink -f "$EN" 2>/dev/null || echo "$EN")"

echo "VHOST=$VHOST"

echo "=== 1) Cherche les includes globaux de snippets (*.conf) ==="
grep -RIn --color=never -E 'include\s+/etc/nginx/snippets/\*\.conf;' /etc/nginx || true

echo
echo "=== 2) Backup vhost + nginx.conf ==="
mkdir -p "/root/backup_snipglob_${T}"
cp -a /etc/nginx/nginx.conf "/root/backup_snipglob_${T}/nginx.conf.bak" || true
cp -a "$VHOST" "/root/backup_snipglob_${T}/vhost.bak" || true

echo
echo "=== 3) Commente include /etc/nginx/snippets/*.conf; dans nginx.conf et dans le vhost (si présent) ==="
sed -i -E 's@^(\s*include\s+/etc/nginx/snippets/\*\.conf;\s*)$@# \1@g' /etc/nginx/nginx.conf
sed -i -E 's@^(\s*include\s+/etc/nginx/snippets/\*\.conf;\s*)$@# \1@g' "$VHOST"

echo
echo "=== 4) Vérifie qu’on inclut toujours fireinners-wolverine.conf explicitement ==="
grep -n --color=never 'include /etc/nginx/snippets/fireinners-wolverine.conf' "$VHOST" || true

echo
echo "=== 5) nginx test ==="
nginx -t
systemctl reload nginx

echo
echo "OK. (Si tu veux vérifier) :"
echo "grep -n 'include /etc/nginx/snippets/fireinners-wolverine.conf' -n $VHOST"
SH

bash /tmp/FIX_DUP_SNIPPETS_GLOB_INCLUDE.sh
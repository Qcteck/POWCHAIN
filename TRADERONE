"use strict";
const http = require("http");
const fs = require("fs");
const path = require("path");
const nacl = require("tweetnacl");
const bs58 = require("bs58").default || require("bs58");

const PORT = parseInt(process.env.PORT || "13010", 10);
const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, "data");
const DB_FILE = path.join(DATA_DIR, "vaults.json");

function now(){ return new Date().toISOString(); }

function readBody(req){
  return new Promise((resolve,reject)=>{
    const chunks=[];
    req.on("data",c=>chunks.push(c));
    req.on("end",()=>resolve(Buffer.concat(chunks)));
    req.on("error",reject);
  });
}

function send(res, code, obj){
  const body = Buffer.from(JSON.stringify(obj));
  res.writeHead(code, {
    "content-type":"application/json; charset=utf-8",
    "cache-control":"no-store",
    "access-control-allow-origin":"*",
    "access-control-allow-methods":"GET,POST,OPTIONS",
    "access-control-allow-headers":"content-type,authorization",
  });
  res.end(body);
}

function loadDB(){
  try{
    const s = fs.readFileSync(DB_FILE, "utf8");
    const j = JSON.parse(s);
    if (j && typeof j === "object") return j;
  }catch(_){}
  return { createdAt: now(), vaults: [] };
}

function saveDB(db){
  fs.mkdirSync(DATA_DIR, { recursive:true });
  fs.writeFileSync(DB_FILE, JSON.stringify(db, null, 2), { mode:0o600 });
  try{ fs.chmodSync(DB_FILE, 0o600); }catch(_){}
}

function genVault(){
  const kp = nacl.sign.keyPair();
  // Solana: pubkey base58 = 32 bytes
  const pub = bs58.encode(Buffer.from(kp.publicKey));
  const secret = bs58.encode(Buffer.from(kp.secretKey));
  return { pub, secret };
}

const srv = http.createServer(async (req,res)=>{
  try{
    if (req.method === "OPTIONS") return send(res, 200, {ok:true});
    if (req.method === "GET"){
      if ((req.url||"").startsWith("/health")) return send(res, 200, {status:"ok", service:"wolverine-vault-api"});
      return send(res, 200, {status:"ok", service:"wolverine-vault-api"});
    }

    if (req.method !== "POST") return send(res, 405, {error:"Method Not Allowed"});
    const url = req.url || "/";
    const bodyBuf = await readBody(req);
    let body = {};
    try{ body = JSON.parse(bodyBuf.toString("utf8") || "{}"); }catch(_){ body = {}; }

    if (url.startsWith("/v1/vault/create")){
      const userPubkey = String(body.userPubkey || "").trim();
      if (!userPubkey) return send(res, 400, {error:"Missing userPubkey"});

      const db = loadDB();
      const v = genVault();
      const rec = { id: String(Date.now()), createdAt: now(), userPubkey, vaultPubkey: v.pub, vaultSecretKey: v.secret };
      db.vaults.push(rec);
      saveDB(db);
      return send(res, 200, {status:"ok", vaultPubkey: v.pub});
    }

    return send(res, 404, {error:"Not Found"});
  } catch(e){
    return send(res, 500, {error:"Server Error", message:(e && e.message)?e.message:String(e)});
  }
});


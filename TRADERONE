cat >/root/MEGA_AQUILA_STACKING_ROUTE_FIX_V3_AWK.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027
TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing: $1"; }

[ "$(id -u)" -eq 0 ] || die "run as root"
need nginx
need systemctl
need awk
need grep
need sed
need cp
need mkdir
need chmod

APP="/opt/aquila_stacking"
KEYS="${APP}/keys"
PROG="aquila_stacking"

INC="/etc/nginx/includes/aquila_stacking_routes.inc"
WEBROOT="/var/www/aquila_stacking"
HTML="${WEBROOT}/index.html"

VHOST_A="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_E="/etc/nginx/sites-enabled/fireinners.online-ssl"
VHOST_C="/etc/nginx/conf.d/000-fireinners.online-ssl.conf"

INCLUDE_LINE="include /etc/nginx/includes/aquila_stacking_routes.inc;"
MARK_BEG="# AQUILA_STACKING_INCLUDE_V3"
MARK_END="# END_AQUILA_STACKING_INCLUDE_V3"

BK="/root/AQUILA_STAKING_ROUTE_FIX_V3_BK_${TS}"
mkdir -p "$BK"
nginx -T >"$BK/nginx.T.txt" 2>&1 || true

backup_one(){ local f="$1"; [ -f "$f" ] && cp -a "$f" "$BK/$(echo "$f" | sed 's#/#_#g').bak" || true; }

backup_one "$INC"
backup_one "$VHOST_A"
backup_one "$VHOST_E"
backup_one "$VHOST_C"
[ -d "$WEBROOT" ] && cp -a "$WEBROOT" "$BK/webroot_aquila_stacking.bak" || true

say "1) WEBROOT: $WEBROOT"
mkdir -p "$WEBROOT"
chmod 0755 "$WEBROOT"

say "2) Program ID"
PID="UNKNOWN"
if command -v solana-keygen >/dev/null 2>&1 && [ -f "$KEYS/${PROG}-keypair.json" ]; then
  PID="$(solana-keygen pubkey "$KEYS/${PROG}-keypair.json" 2>/dev/null || echo UNKNOWN)"
fi

say "3) index.html"
cat >"$HTML"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><style>body{font-family:system-ui,Segoe UI,Arial;margin:24px;max-width:980px}code{background:#0b1020;color:#d7e3ff;padding:10px;border-radius:10px;display:block;overflow:auto}h1{margin:0 0 12px}small{opacity:.8}</style></head><body><h1>AquilaStacking</h1><p><b>Program ID:</b><code>${PID}</code></p><p><b>Workspace:</b><code>${APP}</code></p><p><b>URL:</b><code>/aquila_stacking/</code></p><p><small>Redirect: /aquilastacking/ → /aquila_stacking/</small></p></body></html>
EOF
chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
chmod -R 0755 "$WEBROOT"

say "4) nginx include routes: $INC"
chattr -i "$INC" 2>/dev/null || true
cat >"$INC"<<EOF
# AQUILA_STACKING_ROUTES_V3
location = /aquilastacking { return 301 /aquila_stacking/; }
location ^~ /aquilastacking/ { return 301 /aquila_stacking/; }
location = /aquila_stacking { return 301 /aquila_stacking/; }
location ^~ /aquila_stacking/ { alias ${WEBROOT}/; index index.html; try_files \$uri \$uri/ /aquila_stacking/index.html; add_header Cache-Control "no-store" always; }
# END_AQUILA_STACKING_ROUTES_V3
EOF

patch_file(){
  local f="$1"
  [ -f "$f" ] || return 0
  if ! grep -qE 'server_name[^;]*\bfireinners\.online\b' "$f"; then
    say "skip (no fireinners.online): $f"
    return 0
  fi
  if grep -qF "$INCLUDE_LINE" "$f"; then
    say "ok (already has include): $f"
    return 0
  fi

  say "patch: $f"
  chattr -i "$f" 2>/dev/null || true

  local tmp; tmp="$(mktemp)"
  awk -v inc="$INCLUDE_LINE" -v mb="$MARK_BEG" -v me="$MARK_END" '
  function emit_inc(){ print "  " mb; print "  " inc; print "  " me; }
  BEGIN{inserver=0;depth=0;saw=0;inserted=0;}
  {
    line=$0
    if(!inserver){
      print line
      if(line ~ /^[[:space:]]*server[[:space:]]*\{/){
        inserver=1; depth=1; saw=0; inserted=0;
      }
      next
    }

    # in server block
    if(line ~ /server_name[[:space:]]+[^;]*\bfireinners\.online\b[^;]*;/){ saw=1 }

    # insert before first location once we know it is the right server
    if(saw && !inserted && line ~ /^[[:space:]]*location[[:space:]]/){
      emit_inc()
      inserted=1
    }

    # track braces to know when server ends
    # count { and } occurrences
    oc=gsub(/\{/,"&",line); cc=gsub(/\}/,"&",line)
    depth += oc
    depth -= cc

    # if this is the closing line of the server and we never inserted, insert before }
    if(depth<=0){
      if(saw && !inserted){
        # if line is just "}" or has "}" we emit include before printing closing
        emit_inc()
        inserted=1
      }
      print line
      inserver=0; depth=0; saw=0; inserted=0
      next
    }

    print line
  }' "$f" >"$tmp"

  cp -a "$f" "$f.bak.$TS" 2>/dev/null || true
  cat "$tmp" >"$f"
  rm -f "$tmp"
}

say "5) patch all likely active vhosts (conf.d + sites-enabled + sites-available)"
patch_file "$VHOST_C"
patch_file "$VHOST_E"
patch_file "$VHOST_A"

say "6) nginx -t + reload (rollback if fail)"
if ! nginx -t; then
  say "nginx invalid -> rollback"
  for p in "$INC" "$VHOST_C" "$VHOST_E" "$VHOST_A"; do
    b="$BK/$(echo "$p" | sed 's#/#_#g').bak"
    [ -f "$b" ] && cp -a "$b" "$p" || true
  done
  nginx -t || true
  die "rolled back (see $BK)"
fi
systemctl reload nginx

say "7) local verify (no DNS dependency)"
if command -v curl >/dev/null 2>&1; then
  set +e
  curl -skI --resolve fireinners.online:443:127.0.0.1 "https://fireinners.online/aquila_stacking/" | head -n 30
  curl -sk  --resolve fireinners.online:443:127.0.0.1 "https://fireinners.online/aquila_stacking/" | head -n 5
  set -e
fi

say "DONE: https://fireinners.online/aquila_stacking/"
say "BK: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_ROUTE_FIX_V3_AWK.sh
bash /root/MEGA_AQUILA_STACKING_ROUTE_FIX_V3_AWK.sh
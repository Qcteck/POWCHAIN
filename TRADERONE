cat >/root/force_ui_use_wolverine_rpc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
ROOT="/var/www/wolverine"
SSL="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== 0) Backups =="
cp -a "$SSL" "${SSL}.bak_${ts}" 2>/dev/null || true
cp -a "$SNIP" "${SNIP}.bak_${ts}" 2>/dev/null || true

echo "== 1) Ensure /wolverine/rpc exists and DISABLE /srpc (avoid 403 WAF hits) =="
mkdir -p /etc/nginx/snippets
cat >"$SNIP" <<'NGINX'
# Include INSIDE server{} only.
location = /wolverine/rpc {
  auth_basic off; allow all;
  add_header Access-Control-Allow-Origin "*" always;
  add_header Access-Control-Allow-Headers "*" always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }

  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;
}

# Kill old endpoints so front cannot keep using them
location = /srpc { return 404; }
location = /solana-rpc { return 404; }
NGINX

# Make sure snippet is included once
awk '
  {
    if ($0 ~ /include[[:space:]]+\/etc\/nginx\/snippets\/solana_rpc_proxy\.conf;/) {
      if (seen==1) next;
      seen=1;
    }
    print
  }
' "$SSL" > /tmp/ssl.$$ && cat /tmp/ssl.$$ > "$SSL" && rm -f /tmp/ssl.$$

if ! grep -q "solana_rpc_proxy.conf" "$SSL"; then
  sed -i '/server_name .*fireinners\.online/ a\  include /etc/nginx/snippets/solana_rpc_proxy.conf;' "$SSL"
fi

echo "== 2) Patch ALL phantom_patch*.js under wolverine to use /wolverine/rpc =="
mapfile -t JSFILES < <(find "$ROOT" -maxdepth 6 -type f -name "phantom_patch*.js" -print)
if (( ${#JSFILES[@]} == 0 )); then
  echo "[ERR] no phantom_patch*.js found under $ROOT"; exit 1
fi

for f in "${JSFILES[@]}"; do
  cp -a "$f" "${f}.bak_${ts}" 2>/dev/null || true
  sed -i 's@/wolverine/wolverine/rpc@/wolverine/rpc@g' "$f"
  sed -i 's@/srpc@/wolverine/rpc@g' "$f"
  sed -i 's@/solana-rpc@/wolverine/rpc@g' "$f"
  # Force const RPC if present
  if grep -qE 'const[[:space:]]+RPC[[:space:]]*=' "$f"; then
    sed -i -E 's@const[[:space:]]+RPC[[:space:]]*=[[:space:]]*["'\''][^"'\'']*["'\'']@const RPC = "/wolverine/rpc"@' "$f"
  fi
done

echo "== 3) Cache-bust: ensure every HTML loads /wolverine/phantom_patch.js?v=TS =="
find "$ROOT" -maxdepth 6 -type f -name "*.html" -print0 | while IFS= read -r -d '' h; do
  cp -a "$h" "${h}.bak_${ts}" 2>/dev/null || true
  # remove any existing phantom_patch tag(s)
  perl -0777 -i -pe 's@<script[^>]+phantom_patch[^>]*></script>@@gsi' "$h"
  # inject into <head>
  perl -0777 -i -pe 's@(<head[^>]*>)@$1\n<script src="/wolverine/phantom_patch.js?v='"$ts"'" defer></script>\n@i' "$h"
done

echo "== 4) No-cache for phantom_patch.js at nginx level =="
# Remove any existing block then add clean one
perl -0777 -i -pe 's@\n\s*location\s*=\s*/wolverine/phantom_patch\.js\s*\{.*?\}\s*\n@\n@sg' "$SSL"
perl -0777 -i -pe 's@\n\}\s*$@\n  location = /wolverine/phantom_patch.js {\n    add_header Cache-Control "no-store" always;\n    try_files $uri =404;\n  }\n}\n@sg' "$SSL"

echo "== 5) nginx test + reload =="
nginx -t
systemctl reload nginx

echo
echo "== 6) Verify server-side that phantom_patch contains no /srpc =="
grep -RIn "/srpc" "$ROOT"/phantom_patch*.js || echo "OK: no /srpc in phantom_patch*.js ✅"

echo
echo "== 7) Test RPC endpoint (should be 200) =="
curl -sk -i "https://${DOMAIN}/wolverine/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,18p'

echo
echo "OPEN (private): https://${DOMAIN}/wolverine/?v=$ts"
BASH

chmod +x /root/force_ui_use_wolverine_rpc.sh
/root/force_ui_use_wolverine_rpc.sh
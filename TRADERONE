<script>
const canvas=document.getElementById("particles");
const ctx=canvas.getContext("2d");
let W,H,particles=[];
const COUNT=1200;

function resize(){
  W=canvas.width=innerWidth;
  H=canvas.height=innerHeight;
}
addEventListener("resize",resize);resize();

function rand(a,b){return Math.random()*(b-a)+a;}

function makeParticle(){
  return{
    x:Math.random()*W,
    y:Math.random()*H,
    r:rand(0.5,1.8),
    vx:rand(-0.15,0.15),
    vy:rand(-0.15,0.15),
    hue:rand(200,300), // turquoise → rose → violet
    speed:rand(0.2,1)
  };
}

for(let i=0;i<COUNT;i++)particles.push(makeParticle());

function draw(){
  ctx.clearRect(0,0,W,H);

  const light=!document.body.classList.contains("dark");
  const alpha=light?0.15:0.45;
  const glow=light?0:12;

  for(const p of particles){
    p.x+=p.vx*p.speed;
    p.y+=p.vy*p.speed;

    if(p.x<0||p.x>W)p.vx*=-1;
    if(p.y<0||p.y>H)p.vy*=-1;

    ctx.beginPath();
    ctx.fillStyle=`hsla(${p.hue},80%,${light?35:65}%,${alpha})`;
    ctx.shadowBlur=glow;
    ctx.shadowColor=`hsla(${p.hue},90%,70%,0.8)`;
    ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
    ctx.fill();
  }

  requestAnimationFrame(draw);
}

draw();
</script>
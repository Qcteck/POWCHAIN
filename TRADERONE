cat >/root/fix_traderone_api_proxy_snippet_inside_parent.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

F="/etc/nginx/snippets/traderone_api_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$F" || { echo "Missing $F"; exit 1; }

echo "== Backup =="
cp -a "$F" "$F.bak_$TS"

echo "== Rewrite snippet to be VALID inside: location ^~ /wolverine/traderone/api/ { include ... } =="
cat > "$F" <<'NGINX'
# This snippet is meant to be INCLUDED INSIDE:
#   location ^~ /wolverine/traderone/api/ { ... }

# Health endpoint MUST be under the same prefix to be a valid nested location:
location = /wolverine/traderone/api/health {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:8585;
}

# Default behavior for the rest of /wolverine/traderone/api/*
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;

proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection "upgrade";

rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
proxy_pass http://127.0.0.1:8585;
NGINX

echo "== nginx -t =="
nginx -t

echo "== reload nginx =="
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/fix_traderone_api_proxy_snippet_inside_parent.sh
/root/fix_traderone_api_proxy_snippet_inside_parent.sh
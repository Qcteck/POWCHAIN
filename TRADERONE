set -euo pipefail
NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.health_public.$(date +%s)"

python3 - <<'PY'
from pathlib import Path
import re
ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# Dans le bloc: location ^~ /wolverine/traderone/api/ { ... }
# On remplace le check "if ($http_x_api_key = '') { return 403; }"
# par un check qui bypass /health uniquement.
pattern = r'(location\s+\^~\s+/wolverine/traderone/api/\s*\{[\s\S]*?)(\n\s*if\s*\(\s*\$http_x_api_key\s*=\s*""\s*\)\s*\{\s*return\s+403;\s*\}\s*)([\s\S]*?\n\s*\})'
m = re.search(pattern, s, flags=re.M)
if not m:
    raise SystemExit("KO: bloc API ou check X-API-KEY introuvable (rien modifié).")

replacement = m.group(1) + r'''
  # clé UNIQUEMENT sauf /health
  if ($request_uri !~ "^/wolverine/traderone/api/health$") {
    if ($http_x_api_key = "") { return 403; }
  }
''' + m.group(3)

s2 = re.sub(pattern, replacement, s, flags=re.M)
ng.write_text(s2)
print("OK: /health public, reste protégé")
PY

nginx -t
systemctl reload nginx

echo "=== TESTS ==="

set -euo pipefail

HTML="/var/www/fireinners/wolverine/index.html"
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"

cp -a "$HTML" "$HTML.bak.$TS"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backups: $HTML.bak.$TS | $APPJS.bak.$TS"

# 1) Nettoie anciens tags solana libs (si déjà injectés)
perl -i -pe 's#\s*<script[^>]+unpkg\.com/@solana/web3\.js[^>]*></script>##gi; s#\s*<script[^>]+unpkg\.com/@solana/spl-token[^>]*></script>##gi' "$HTML"

# 2) Assure l'ordre: libs AVANT app.js (et app.js en dernier)
#   - On repère la balise app.js puis on injecte juste avant
perl -0777 -i -pe 's#(<script[^>]+src="[^"]*app\.js[^"]*"[^>]*></script>)#  <script src="https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js"></script>\n  <script src="https://unpkg.com/@solana/spl-token@0.4.8/lib/index.iife.min.js"></script>\n  $1#s' "$HTML"

# 3) Patch app.js pour utiliser window.solanaWeb3 / window.splToken et fail propre si libs absentes
perl -0777 -i -pe 's/new\s+solanaWeb3\.PublicKey/new (window\.solanaWeb3||solanaWeb3)\.PublicKey/g' "$APPJS" || true
perl -0777 -i -pe 's/const\s+USDC_MINT\s*=\s*new\s+\(window\.solanaWeb3\|\|solanaWeb3\)\.PublicKey/const __web3 = (window.solanaWeb3||window.solanaWeb3||solanaWeb3);\n  const __spl = (window.splToken||window.splToken||splToken);\n  if(!__web3 || !__web3.PublicKey){ (window.setStatus||console.log)(\"ERR: web3.js pas chargé (solanaWeb3)\"); return; }\n  if(!__spl){ (window.setStatus||console.log)(\"ERR: spl-token pas chargé (splToken)\"); return; }\n\n  const USDC_MINT = new __web3.PublicKey/s' "$APPJS" || true

echo "OK ✅ Maintenant: Ctrl+F5 sur /wolverine puis reteste START (Phantom doit pop)."
cat >/root/TRADERONE_NO_UI_ERROR.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
REPORT="/root/TRADERONE_NO_UI_ERROR_$TS.log"

UI="/var/www/wolverine/index.html"
API="/opt/traderone/server.js"

echo "=== TRADERONE NO UI ERROR PATCH ===" | tee "$REPORT"

################################
# 1) BACKUPS
################################
cp -a "$UI" "$UI.bak.$TS"
cp -a "$API" "$API.bak.$TS"
echo "[OK] Backups done" | tee -a "$REPORT"

################################
# 2) BACKEND — FORCE JSON ERRORS
################################
if ! grep -q "FORCE_JSON_ERRORS" "$API"; then
cat >>"$API" <<'JS'

// === FORCE_JSON_ERRORS ===
app.use((req,res,next)=>{
  res.setHeader("Content-Type","application/json");
  next();
});

// API fallback JSON (never HTML)
app.use("/wolverine/traderone/api",(req,res)=>{
  res.status(200).json({
    ok:false,
    info:"api-ready",
    note:"no-action"
  });
});
JS
echo "[OK] Backend JSON enforced" | tee -a "$REPORT"
else
echo "[OK] Backend already patched" | tee -a "$REPORT"
fi

################################
# 3) FRONTEND — SAFE FETCH
################################
python3 <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
html=p.read_text(errors="ignore")

if "safeFetchTraderOne" in html:
    print("UI already patched")
    exit(0)

patch = """
<script>
async function safeFetchTraderOne(url,payload){
  try{
    const r=await fetch(url,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(payload)
    });
    const ct=r.headers.get("content-type")||"";
    if(ct.includes("application/json")){
      return await r.json();
    }
    return {ok:false,silent:true};
  }catch(e){
    return {ok:false,silent:true};
  }
}
</script>
"""

html = html.replace("</body>", patch+"\n</body>")
p.write_text(html)
print("UI safe fetch injected")
PY

echo "[OK] UI protected against errors" | tee -a "$REPORT"

################################
# 4) RESTART PM2
################################
pm2 restart traderone-vault || true
pm2 save || true

echo "=== DONE: ZERO UI ERROR ===" | tee -a "$REPORT"
echo "Report: $REPORT"
BASH

chmod +x /root/TRADERONE_NO_UI_ERROR.sh

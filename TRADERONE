cat > /root/WOLVERINE_PURGE_SSL_DUPLICATES.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS=$(date +%Y%m%d_%H%M%S)
LOG="/root/WOLVERINE_SSL_PURGE_$TS.log"

echo "=== WOLVERINE SSL DUPLICATE PURGE ===" | tee -a "$LOG"

echo "[1/6] Scan fichiers nginx écoutant sur 443" | tee -a "$LOG"
FILES=$(grep -R "listen 443" /etc/nginx --include="*.conf" --include="*" | cut -d: -f1 | sort -u)

echo "$FILES" | tee -a "$LOG"

echo "[2/6] Exclusion du vhost officiel fireinners.online-ssl" | tee -a "$LOG"
OFFICIAL="/etc/nginx/sites-available/fireinners.online-ssl"

for f in $FILES; do
  if [[ "$f" != "$OFFICIAL" ]]; then
    echo "➡️ Neutralisation: $f" | tee -a "$LOG"
    cp -a "$f" "$f.bak_$TS"
    sed -i 's/^\([[:space:]]*listen[[:space:]]\+443\)/# \1/g' "$f"
  else
    echo "✔️ Conservé: $f" | tee -a "$LOG"
  fi
done

echo "[3/6] Test nginx" | tee -a "$LOG"
nginx -t | tee -a "$LOG"

echo "[4/6] Reload nginx" | tee -a "$LOG"
systemctl reload nginx
sleep 2

echo "[5/6] Status nginx" | tee -a "$LOG"
systemctl status nginx --no-pager | tee -a "$LOG"

echo "[6/6] Scan final warnings" | tee -a "$LOG"
journalctl -u nginx -n 20 | tee -a "$LOG"

echo
echo "=== TERMINÉ ==="
echo "ACTION: CTRL + SHIFT + R navigateur"
echo "LOG: $LOG"
BASH

chmod +x /root/WOLVERINE_PURGE_SSL_DUPLICATES.sh
/root/WOLVERINE_PURGE_SSL_DUPLICATES.sh
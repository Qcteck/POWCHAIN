NGINX_SITE=""
for f in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*; do
  [ -f "$f" ] || continue
  if grep -qi "server_name .*fireinners\.online" "$f"; then NGINX_SITE="$f"; break; fi
done

if [ -n "$NGINX_SITE" ]; then
  cp -a "$NGINX_SITE" "/root/wolv_backups/nginx_site.$TS.bak"

  # remove any existing location ^~ /api/ block (rough but effective)
  perl -0777 -i -pe 's/location\s+\^~\s+\/api\/\s*\{.*?\}\s*//si' "$NGINX_SITE"

  # insert a clean block after first "server {"
  perl -0777 -i -pe 's/server\s*\{/server {\n\n    location ^~ \/api\/ {\n        proxy_pass http:\/\/127.0.0.1:'"$API_PORT"'\/api\/;\n        proxy_http_version 1.1;\n        proxy_set_header Host \$host;\n        proxy_set_header X-Real-IP \$remote_addr;\n        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto \$scheme;\n    }\n\n/si' "$NGINX_SITE"

  nginx -t && systemctl reload nginx
  echo "nginx OK ✅"
else

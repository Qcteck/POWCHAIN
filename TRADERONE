cat >/root/fix_duplicate_solana_rpc_include.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Canonical snippet (ONE location, trailing /) =="
mkdir -p /etc/nginx/snippets
cp -a "$SNIP" "${SNIP}.bak_${ts}" 2>/dev/null || true
cat >"$SNIP" <<'NGINX'
# Include this file INSIDE a server{} block only.
location = /solana-rpc {
  # trailing "/" is important
  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  add_header Access-Control-Allow-Origin * always;
  add_header Access-Control-Allow-Headers * always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }
}
NGINX

echo
echo "== 2) Remove WRONG includes from global scopes (nginx.conf / conf.d) =="
for f in /etc/nginx/nginx.conf /etc/nginx/conf.d/*.conf; do
  [[ -f "$f" ]] || continue
  if grep -q "solana_rpc_proxy.conf" "$f"; then
    cp -a "$f" "${f}.bak_${ts}"
    sed -i '/solana_rpc_proxy\.conf/d' "$f"
    echo "  - removed include from $f"
  fi
done

echo
echo "== 3) Deduplicate include lines in vhosts (sites-enabled + sites-available) =="
for f in /etc/nginx/sites-enabled/* /etc/nginx/sites-available/*; do
  [[ -f "$f" ]] || continue
  if grep -q "solana_rpc_proxy.conf" "$f"; then
    cp -a "$f" "${f}.bak_${ts}"
    awk '
      {
        if ($0 ~ /include[[:space:]]+\/etc\/nginx\/snippets\/solana_rpc_proxy\.conf;/) {
          if (seen==1) next;
          seen=1;
        }
        print
      }
    ' "$f" > /tmp/ng_$$ && cat /tmp/ng_$$ > "$f" && rm -f /tmp/ng_$$
    echo "  - deduped in $f"
  fi
done

echo
echo "== 4) Show where include still exists =="
grep -RIn --line-number "solana_rpc_proxy.conf" /etc/nginx | head -n 40 || true

echo
echo "== 5) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== 6) RPC test (should return solana-core version) =="
curl -sk --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/solana-rpc \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' && echo
BASH

chmod +x /root/fix_duplicate_solana_rpc_include.sh
/root/fix_duplicate_solana_rpc_include.sh
cat > /root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
FRONT_DIR="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"
INC_DIR="/etc/nginx/includes"
INC="${INC_DIR}/wolverine_routes.inc"
LOG="/root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL_${TS}.log"
NOHUP="/root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL_${TS}.nohup"

if [[ "${1:-}" != "--run" ]]; then
  nohup bash "$0" --run >"$NOHUP" 2>&1 & disown || true
  echo "Launching in background (nohup) -> $NOHUP"
  echo "Now run: tail -n 300 $NOHUP"
  exit 0
fi

w(){ printf "%s\n" "$*" | tee -a "$LOG" >/dev/null; }
sep(){ w ""; w "== $* =="; }
ok(){ w "OK: $*"; }
warn(){ w "WARN: $*"; }
die(){ w "ERREUR: $*"; exit 1; }

ensure_pkg(){ local p="$1"; dpkg -s "$p" >/dev/null 2>&1 || { apt-get update -y >>"$LOG" 2>&1; apt-get install -y "$p" >>"$LOG" 2>&1; }; }
is_imm(){ lsattr -d "$1" 2>/dev/null | awk '{print $1}' | grep -q "i"; }
unlock_imm(){ local f="$1" name="$2"; if [[ -f "$f" ]] && is_imm "$f"; then chattr -i "$f" || true; ok "chattr -i $name"; echo "1"; else echo "0"; fi; }
relock_imm(){ local f="$1" name="$2" was="$3"; if [[ "$was" == "1" ]] && [[ -f "$f" ]]; then chattr +i "$f" || true; ok "chattr +i $name"; fi; }
backup_file(){ local f="$1"; [[ -f "$f" ]] || return 0; cp -a "$f" "${f}.bak_${TS}"; ok "backup ${f}.bak_${TS}"; }

http_code_local(){ local path="$1"; curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1${path}" -H "Host: ${HOST}" || true; }
http_code_ext(){ local path="$1"; curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}${path}" || true; }

sep "0) Pré-requis + chemins"
ensure_pkg nginx
ensure_pkg python3
ensure_pkg ca-certificates
ensure_pkg curl
mkdir -p "$INC_DIR"
[[ -f "$VHOST" ]] || die "Vhost introuvable: $VHOST"
ok "pré-requis OK"
w "LOG=$LOG"

sep "1) Scan: où wolverine_routes.inc / wildcard includes/*.inc apparaissent"
# Liste fichiers qui contiennent ces patterns
MAPFILE -t FILES_WOLV < <(grep -RIl --exclude-dir=sites-enabled --exclude-dir=snippets --exclude='*.bak_*' "wolverine_routes\.inc" /etc/nginx 2>/dev/null || true)
MAPFILE -t FILES_WILD < <(grep -RIl --exclude-dir=sites-enabled --exclude-dir=snippets --exclude='*.bak_*' "include\s\+/etc/nginx/includes/\*\.inc" /etc/nginx 2>/dev/null || true)

w "FILES_WOLV (count=${#FILES_WOLV[@]}):"
for f in "${FILES_WOLV[@]:-}"; do w " - $f"; done
w "FILES_WILD (count=${#FILES_WILD[@]}):"
for f in "${FILES_WILD[@]:-}"; do w " - $f"; done

HAS_WILD="0"
if (( ${#FILES_WILD[@]} > 0 )); then HAS_WILD="1"; fi
ok "HAS_WILD=$HAS_WILD"

sep "2) Unlock immutable si nécessaire (nginx.conf + vhost + include + fichiers touchés)"
WAS_MAIN="$(unlock_imm "$NGINX_MAIN" "nginx.conf")"
WAS_VHOST="$(unlock_imm "$VHOST" "vhost")"
WAS_INC="$(unlock_imm "$INC" "include")"

# unlock tous fichiers qui vont être modifiés (wolverine refs + wildcards)
TOUCH=()
for f in "${FILES_WOLV[@]:-}"; do [[ -f "$f" ]] && TOUCH+=("$f"); done
for f in "${FILES_WILD[@]:-}"; do [[ -f "$f" ]] && TOUCH+=("$f"); done
# unique
if (( ${#TOUCH[@]} > 0 )); then
  python3 - <<'PY' >>"$LOG" 2>&1
import os,sys
from pathlib import Path
touch=set()
for line in Path("/proc/self/fd/0").read_text().splitlines():
  if line.strip(): touch.add(line.strip())
print("TOUCH_UNIQUE="+str(len(touch)))
PY
fi

sep "3) Backups (nginx.conf + vhost + include + fichiers touchés)"
backup_file "$NGINX_MAIN"
backup_file "$VHOST"
backup_file "$INC"
for f in "${TOUCH[@]:-}"; do backup_file "$f"; done

sep "4) Réécrire include CANONIQUE (aucun doublon interne) -> $INC"
cat > "$INC" <<'EOF'
# Canonical Wolverine routes (single definition for /wolverine)
# Front: /var/www/wolverine (static export Next)
# API:   /wolverine/traderone/api/ -> http://127.0.0.1:3000/

# Redirect /wolverine -> /wolverine/
location /wolverine {
  return 301 /wolverine/;
}

# TraderOne API (proxy)
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_connect_timeout 10s;
  proxy_pass http://127.0.0.1:3000/;
}

# Next static assets
location ^~ /wolverine/_next/ {
  alias /var/www/wolverine/_next/;
  access_log off;
  expires 30d;
  add_header Cache-Control "public, max-age=2592000" always;
  try_files $uri =404;
}

# Main app
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}
EOF
ok "include réécrit canonique"

sep "5) Dé-doublonnage GLOBAL des includes"
python3 - <<'PY'
from pathlib import Path
import re

INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

# patterns
re_inc = re.compile(r'^\s*include\s+'+re.escape(INC)+r'\s*;.*$')
re_wild = re.compile(r'^\s*include\s+/etc/nginx/includes/\*\.inc\s*;.*$')

# collect all nginx files under /etc/nginx
root=Path("/etc/nginx")
files=[]
for p in root.rglob("*"):
    if p.is_file():
        if ".bak_" in p.name: 
            continue
        # ignore binary-ish
        files.append(p)

# detect wildcards anywhere
has_wild=False
for p in files:
    try:
        s=p.read_text(errors="ignore").splitlines()
    except Exception:
        continue
    if any(re_wild.search(l) for l in s):
        has_wild=True
        break

touched=[]
removed_exp=0
removed_wild_dups=0

# 1) remove ALL explicit includes everywhere (we will re-inject only if no wildcard)
for p in files:
    try:
        s=p.read_text(errors="ignore").splitlines()
    except Exception:
        continue
    new=[]
    changed=False
    for l in s:
        if re_inc.search(l):
            removed_exp += 1
            changed=True
            continue
        new.append(l)
    if changed:
        p.write_text("\n".join(new)+("\n" if new else ""), errors="ignore")
        touched.append(str(p))

# 2) if wildcards exist: ensure each file has at most one wildcard line (dedup within file)
if has_wild:
    for p in files:
        try:
            s=p.read_text(errors="ignore").splitlines()
        except Exception:
            continue
        wilds=[i for i,l in enumerate(s) if re_wild.search(l)]
        if len(wilds) > 1:
            keep=wilds[0]
            new=[]
            for idx,l in enumerate(s):
                if re_wild.search(l) and idx!=keep:
                    removed_wild_dups += 1
                    continue
                new.append(l)
            p.write_text("\n".join(new)+("\n" if new else ""), errors="ignore")
            touched.append(str(p))

# 3) if NO wildcards: inject exactly once in the correct server block of the vhost
injected=False
if not has_wild:
    p=Path(VHOST)
    s=p.read_text(errors="ignore").splitlines()
    out=[]
    for i,l in enumerate(s):
        out.append(l)
        if (not injected) and re.search(r'^\s*server_name\s+.*\bfireinners\.online\b', l):
            out.append(f'  include {INC};')
            injected=True
    if injected:
        p.write_text("\n".join(out)+("\n" if out else ""), errors="ignore")
        touched.append(str(p))

# done
print(f"OK: has_wild={has_wild} removed_explicit={removed_exp} removed_wild_dups={removed_wild_dups} injected_explicit={( 'yes' if injected else 'no' )}")
print("TOUCHED_UNIQUE="+str(len(set(touched))))
PY | tee -a "$LOG" >/dev/null
ok "dé-doublonnage global terminé"

sep "6) Permissions front (éviter 403) si dossier existe"
if [[ -d "$FRONT_DIR" ]]; then
  chmod -R a+rX "$FRONT_DIR" || true
  ok "chmod a+rX sur $FRONT_DIR"
else
  warn "FRONT_DIR absent: $FRONT_DIR"
fi

sep "7) Inventaire FINAL (où wolverine est défini et où include est chargé)"
w "-- grep include wolverine_routes.inc --"
(nginx -T 2>/dev/null | egrep -n "include\s+/etc/nginx/includes/wolverine_routes\.inc" || true) | tee -a "$LOG" >/dev/null
w "-- grep wildcard includes/*.inc --"
(nginx -T 2>/dev/null | egrep -n "include\s+/etc/nginx/includes/\*\.inc" || true) | tee -a "$LOG" >/dev/null
w "-- grep locations /wolverine --"
(nginx -T 2>/dev/null | egrep -n "location\s+(\^~\s+)?/wolverine\b|location\s+/wolverine/" | head -n 200 || true) | tee -a "$LOG" >/dev/null

sep "8) nginx -t puis reload"
if nginx -t >>"$LOG" 2>&1; then
  ok "nginx -t PASS"
  systemctl reload nginx >>"$LOG" 2>&1 || systemctl restart nginx >>"$LOG" 2>&1 || true
  ok "nginx reloaded"
else
  w "---- nginx -t output (last 160) ----"
  tail -n 160 "$LOG" || true
  die "nginx -t FAIL (voir $LOG)"
fi

sep "9) Tests HTTP"
w "LOCAL /wolverine/ => $(http_code_local "/wolverine/")"
w "EXT   /wolverine/ => $(http_code_ext "/wolverine/")"
w "LOCAL /wolverine/traderone/api/health => $(http_code_local "/wolverine/traderone/api/health")"
w "EXT   /wolverine/traderone/api/health => $(http_code_ext "/wolverine/traderone/api/health")"

sep "10) Relock immutable si nécessaire"
relock_imm "$INC" "include" "$WAS_INC"
relock_imm "$VHOST" "vhost" "$WAS_VHOST"
relock_imm "$NGINX_MAIN" "nginx.conf" "$WAS_MAIN"

sep "DONE"
w "LOG=$LOG"
BASH
chmod +x /root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL.sh
bash /root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL.sh
cat >/root/show_active_wolverine_rpc_block.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 1) Export nginx full config (nginx -T) =="
nginx -T 2>/tmp/nginxT.txt >/dev/null || true

echo
echo "== 2) Where is /wolverine/rpc defined (ACTIVE config, not backups) =="
grep -nE 'location\s*=*\s*/wolverine/rpc|/wolverine/rpc' /tmp/nginxT.txt | head -n 80

echo
echo "== 3) Print the location block context (the real one nginx is using) =="
python3 - <<'PY'
import re
p=open("/tmp/nginxT.txt","r",errors="ignore").read().splitlines()
hits=[i for i,l in enumerate(p) if re.search(r'location\s*=*\s*/wolverine/rpc', l)]
if not hits:
  hits=[i for i,l in enumerate(p) if "/wolverine/rpc" in l]
for h in hits[:3]:
  s=max(0,h-25); e=min(len(p),h+120)
  print("\n---- CONTEXT %d-%d ----" % (s+1,e))
  for i in range(s,e):
    print(f"{i+1}: {p[i]}")
PY

echo
echo "== 4) Find common blockers related to 403/deny/auth/limit/error_page =="
grep -nE 'deny\s+all;|allow\s+127\.0\.0\.1;|return\s+403;|auth_basic|satisfy|limit_req|error_page\s+403' /tmp/nginxT.txt | head -n 200

echo
echo "DONE ✅  (Send me the CONTEXT block that contains the location /wolverine/rpc)"
BASH

chmod +x /root/show_active_wolverine_rpc_block.sh
/root/show_active_wolverine_rpc_block.sh
set -e
cd /root

echo "=== 1) Backup + fix proxy_set_header vides (sites-enabled) ==="
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  echo "FIX $f"
  cp -v "$f" "$f.bak.$(date +%Y%m%d_%H%M%S)"

  # Corrige les headers vides
  perl -pi -e 's/^\s*proxy_set_header\s+Host\s*;\s*$/  proxy_set_header Host $host;/g' "$f"
  perl -pi -e 's/^\s*proxy_set_header\s+X-Real-IP\s*;\s*$/  proxy_set_header X-Real-IP $remote_addr;/g' "$f"
  perl -pi -e 's/^\s*proxy_set_header\s+X-Forwarded-For\s*;\s*$/  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;/g' "$f"
done

echo
echo "=== 2) NGINX test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 3) Test LOCAL via nginx (Host header) ==="
curl -sS -i -X POST -H "Host: fireinners.online" -H "content-type: application/json" \
  http://127.0.0.1/wolverine/traderone/api/status --data '{}' | head -n 40

echo
echo "=== 4) Test PUBLIC ==="
BASE="https://fireinners.online/wolverine/traderone/api"
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" --data '{}' | head -n 40
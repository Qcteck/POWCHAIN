cat >/root/MEGA_AQUILA_STACKING_ONLY.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILA_STACKING_ONLY_BK_$TS"
mkdir -p "$BK"
umask 022

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ echo "ERR: $*" >&2; exit 1; }
have(){ command -v "$1" >/dev/null 2>&1; }

DOMAIN="fireinners.online"
PATH_APP="/aquilastacking"
WEBROOT="/var/www/aquilastacking"
INC="/etc/nginx/includes/aquilastacking_routes.inc"

VHOST_A="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_E="/etc/nginx/sites-enabled/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"

backup_one(){ local p="$1"; [ -e "$p" ] || return 0; mkdir -p "$BK$(dirname "$p")"; cp -a "$p" "$BK$p.bak" 2>/dev/null || true; }
lsattr_safe(){ lsattr "$1" 2>/dev/null | awk '{print $1}' || echo ""; }
unfreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; local a; a="$(lsattr_safe "$f")"; if echo "$a" | grep -q 'i'; then say "UNFREEZE: chattr -i $f"; chattr -i "$f" 2>/dev/null || true; fi; }
refreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; say "REFREEZE: chattr +i $f"; chattr +i "$f" 2>/dev/null || true; }

ensure_packages(){
  say "Packages (curl/unzip/nginx if missing)"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y >/dev/null || true
  local pkgs=(curl unzip nginx)
  for p in "${pkgs[@]}"; do dpkg -s "$p" >/dev/null 2>&1 || apt-get install -y "$p" >/dev/null; done
}

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp" <<'EOF'
EOF
  # shellcheck disable=SC2059
  printf "%s" "$*" >"$tmp"
  mkdir -p "$(dirname "$path")"
  backup_one "$path"
  mv -f "$tmp" "$path"
}

write_include(){
  say "Write include: $INC"
  mkdir -p "$(dirname "$INC")"
  backup_one "$INC"
  cat >"$INC" <<EOF
# AQUILA_STACKING_ONLY (managed) - $TS
# Route: ${PATH_APP} -> ${WEBROOT}
location = ${PATH_APP} { return 301 ${PATH_APP}/; }
location ^~ ${PATH_APP}/ {
  alias ${WEBROOT}/;
  index index.html;
  try_files \$uri \$uri/ ${PATH_APP}/index.html;
  add_header Cache-Control "no-store" always;
}
location = ${PATH_APP}/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = ${PATH_APP}/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = ${PATH_APP}/manifest.json { add_header Cache-Control "no-store" always; return 404; }
EOF
}

patch_vhost_include(){
  [ -f "$VHOST_A" ] || die "Missing vhost: $VHOST_A"
  say "Patch vhost (dedupe include): $VHOST_A"
  backup_one "$VHOST_A"

  python3 - "$VHOST_A" "$INC" <<'PY'
import re,sys
p=sys.argv[1]; inc=sys.argv[2]
s=open(p,'r',encoding='utf-8',errors='ignore').read()

# remove any existing aquilastacking include lines (keep nothing, we re-add clean)
lines=s.splitlines(True)
lines=[ln for ln in lines if not re.search(r'^\s*include\s+.*aquilastacking_routes\.inc\s*;\s*$', ln)]
s=''.join(lines)

# find first "server { ... }" block and insert include just before its closing brace
# simple brace matching ignoring comments/strings is good enough for nginx files
m=re.search(r'\bserver\s*\{', s)
if not m:
  raise SystemExit("No server{ block found in vhost")
start=m.start()
i=m.end()
depth=1
while i < len(s) and depth>0:
  ch=s[i]
  if ch=='#':  # comment to end of line
    j=s.find('\n', i)
    i = len(s) if j==-1 else j+1
    continue
  if ch=='{': depth+=1
  elif ch=='}': depth-=1
  i+=1
end=i  # position after matching }
server_block=s[start:end]
before=s[:start]
after=s[end:]

# inject include before final "}" of this server block
insert=f"\n  include {inc};\n"
server_block=re.sub(r'\}\s*$', insert+"}\n", server_block, count=1)

out=before+server_block+after
open(p,'w',encoding='utf-8').write(out)
PY
}

ensure_webroot(){
  say "Ensure webroot: $WEBROOT"
  mkdir -p "$WEBROOT"
  backup_one "$WEBROOT/index.html" || true

  cat >"$WEBROOT/index.html" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Aquila Stacking</title><style>html,body{height:100%;margin:0;background:#070b14;color:#cfe8ff;font-family:ui-sans-serif,system-ui,Segoe UI,Roboto,Arial}a{color:#8bd3ff}#w{display:flex;gap:12px;padding:14px}#l{width:340px;border:1px solid rgba(130,200,255,.35);border-radius:12px;padding:12px;background:rgba(15,25,45,.65)}#r{flex:1;border:1px solid rgba(130,200,255,.35);border-radius:12px;padding:12px;background:rgba(15,25,45,.35);min-height:70vh}button,input{font:inherit;border-radius:10px;border:1px solid rgba(130,200,255,.35);background:rgba(10,18,35,.9);color:#cfe8ff;padding:10px}button{cursor:pointer}button:hover{filter:brightness(1.15)}.row{display:flex;gap:10px;align-items:center;margin:10px 0}.k{opacity:.8;font-size:12px;margin-top:8px}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;word-break:break-all}#log{white-space:pre-wrap;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;line-height:1.35}</style></head><body><div id="w"><div id="l"><div class="k">Wallet</div><div class="row"><button id="btnConnect">CONNECT PHANTOM</button><button id="btnDisconnect">DISCONNECT</button></div><div class="k">Pubkey</div><div id="pub" class="mono">—</div><div class="k">RPC</div><input id="rpc" value="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac" style="width:100%"/><div class="row"><button id="btnRefresh">REFRESH BALANCES</button></div><div class="k">SOL (lamports)</div><div id="sol" class="mono">—</div><div class="k">USDC (approx)</div><div id="usdc" class="mono">—</div><hr style="border:0;border-top:1px solid rgba(130,200,255,.25);margin:12px 0"/><div class="k">Stacking (frontend)</div><div class="row"><input id="amt" placeholder="Montant" value="0.01" style="flex:1"/><button id="btnPrepare">PRÉPARER</button></div><div class="k">Préparation = payload clair (aucune signature sans programme staking).</div><div class="k">Si tu veux la signature réelle staking, il faut: ProgramID + comptes + méthode (Anchor/IDL).</div></div><div id="r"><div class="k">Console</div><div id="log"></div></div></div><script>
const $=s=>document.querySelector(s);
const log=(m)=>{$('#log').textContent+=(m+(m.endsWith('\n')?'':'\n'));};
let wallet=null, pubkey=null;

async function rpcCall(method, params){
  const url=$('#rpc').value.trim();
  const r=await fetch(url,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({jsonrpc:'2.0',id:1,method,params})});
  const j=await r.json().catch(()=>null);
  if(!j) throw new Error('RPC invalid JSON');
  if(j.error) throw new Error('RPC '+JSON.stringify(j.error));
  return j.result;
}

async function refreshBalances(){
  if(!pubkey) return log('No wallet connected');
  try{
    const bal=await rpcCall('getBalance',[pubkey,{commitment:'confirmed'}]);
    $('#sol').textContent=String(bal?.value??'—');
  }catch(e){ log('SOL error: '+e.message); }
  try{
    // USDC mint mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1
    const mint="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
    const res=await rpcCall('getTokenAccountsByOwner',[pubkey,{mint},{encoding:'jsonParsed'}]);
    let sum=0;
    for(const a of (res?.value||[])){
      const ui=a?.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
      if(typeof ui==='number') sum+=ui;
    }
    $('#usdc').textContent=String(sum);
  }catch(e){ log('USDC error: '+e.message); }
}

$('#btnConnect').onclick=async()=>{
  try{
    wallet=window.solana;
    if(!wallet || !wallet.isPhantom) return log('Phantom non détecté');
    const r=await wallet.connect();
    pubkey=(r?.publicKey?.toString?.()||wallet.publicKey?.toString?.()||null);
    $('#pub').textContent=pubkey||'—';
    log('Wallet connectée: '+pubkey);
    await refreshBalances();
  }catch(e){ log('Connect error: '+(e?.message||e)); }
};
$('#btnDisconnect').onclick=async()=>{
  try{ if(wallet?.disconnect) await wallet.disconnect(); }catch{}
  wallet=null; pubkey=null; $('#pub').textContent='—'; $('#sol').textContent='—'; $('#usdc').textContent='—';
  log('Disconnected');
};
$('#btnRefresh').onclick=refreshBalances;

$('#btnPrepare').onclick=()=>{
  if(!pubkey) return log('Connecte Phantom avant.');
  const amt=parseFloat($('#amt').value||'0');
  if(!(amt>0)) return log('Montant invalide');
  const payload={type:'STACKING_PREPARE',owner:pubkey,amount:amt,unit:'SOL',ts:Date.now(),note:'Pour exécution réelle: fournir ProgramID + comptes + méthode.'};
  log('PREPARED:\n'+JSON.stringify(payload,null,2));
};

log('Aquila Stacking chargé. Route: /aquilastacking/');
</script></body></html>
HTML

  chmod 644 "$WEBROOT/index.html"
}

dedupe_by_nginxT(){
  # If nginx still reports duplicate location, we try to find offenders.
  say "Check duplicates (nginx -T scan)"
  if ! nginx -t >/dev/null 2>&1; then
    nginx -T 2>/dev/null | grep -n "location .*aquilastacking" | head -n 200 || true
    nginx -T 2>/dev/null | grep -n "include .*aquilastacking_routes\.inc" | head -n 200 || true
    return 1
  fi
  return 0
}

main(){
  say "BEGIN AQUILA STACKING ONLY @ $TS"
  say "BK: $BK"

  ensure_packages

  # unfreeze common immutable nginx files (safe even if not immutable)
  unfreeze_one "$NGINX_MAIN"
  unfreeze_one "$VHOST_A"
  unfreeze_one "$INC"

  # backups
  backup_one "$NGINX_MAIN"
  backup_one "$VHOST_A"
  backup_one "$VHOST_E"
  backup_one "$INC"

  ensure_webroot
  write_include
  patch_vhost_include

  # if vhost enabled symlink missing, keep existing structure but ensure it exists
  if [ -f "$VHOST_A" ] && [ ! -e "$VHOST_E" ]; then
    say "Enable vhost symlink: $VHOST_E"
    ln -s "$VHOST_A" "$VHOST_E" 2>/dev/null || true
  fi

  # test + fix duplicates if any
  if ! dedupe_by_nginxT; then
    say "NGINX TEST FAIL (duplicate or syntax). Showing include occurrences:"
    grep -RIn --include='*.conf' --include='*.inc' --include='*ssl*' "aquilastacking" /etc/nginx 2>/dev/null | head -n 300 || true
    die "nginx -t failed (see lines above). Restorable backups in $BK"
  fi

  say "nginx -t OK"
  systemctl reload nginx || service nginx reload || true

  # re-freeze (optional but consistent with your setup)
  refreeze_one "$NGINX_MAIN"
  refreeze_one "$VHOST_A"
  refreeze_one "$INC"

  say "HTTP CHECK"
  curl -sS -I "https://${DOMAIN}${PATH_APP}/" | head -n 20 || true
  say "OPEN: https://${DOMAIN}${PATH_APP}/ (Ctrl+F5)"
  say "DONE"
}

main "$@"
SH
chmod +x /root/MEGA_AQUILA_STACKING_ONLY.sh
bash /root/MEGA_AQUILA_STACKING_ONLY.sh
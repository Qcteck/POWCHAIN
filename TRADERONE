#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILA_REACT_STACKING_DEPLOY_BK_${TS}"
mkdir -p "$BK"

say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

# ---- config (change only if you want) ----
DOMAIN="fireinners.online"
PATH_A="/aquila_stacking/"
PATH_B="/iaaquila/"
WEBROOT="/var/www/aquila_stacking"
LINKROOT="/var/www/iaaquila"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"
VHOST_A="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_B="/etc/nginx/conf.d/000-fireinners.online-ssl.conf"
VHOST_C="/etc/nginx/sites-enabled/fireinners.online-ssl"
APP="/opt/aquila_stacking_react"

# Optional: set ZIP_URL env to auto-download a React export zip into /root/
ZIP_URL="${ZIP_URL:-}"

# ---- safety checks ----
[ "$(id -u)" -eq 0 ] || die "run as root"
umask 022

# ---- bring in askorupdate if present ----
ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

backup_one(){
  local p="$1"
  [ -e "$p" ] || return 0
  mkdir -p "$BK/$(dirname "$p")"
  cp -a "$p" "$BK/$p.bak" 2>/dev/null || true
}

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "Aquila React Stacking deploy" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
    rm -f "$tmp"
  else
    backup_one "$path"
    chattr -i "$path" 2>/dev/null || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}

ensure_pkgs(){
  say "0) Packages"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y >/dev/null
  apt-get install -y nginx curl unzip rsync python3 python3-venv ca-certificates gnupg >/dev/null
  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    # try Ubuntu repo first (stable enough for Vite)
    apt-get install -y nodejs npm >/dev/null || true
  fi
  command -v node >/dev/null 2>&1 || die "node missing (install nodejs >=18)"
  command -v npm  >/dev/null 2>&1 || die "npm missing"
  local NV; NV="$(node -v | tr -d v || true)"
  local MAJOR="${NV%%.*}"
  [ "${MAJOR:-0}" -ge 18 ] || die "node >=18 required (current: $NV)"
}

find_or_get_zip(){
  local z=""
  if [ -n "$ZIP_URL" ]; then
    say "1) Download ZIP_URL -> /root/aquila_ui.zip"
    curl -fsSL "$ZIP_URL" -o /root/aquila_ui.zip || die "download failed"
    z="/root/aquila_ui.zip"
  else
    # pick newest horizons-export*.zip or aquila_ui.zip
    z="$(ls -1t /root/horizons-export-*.zip /root/aquila_ui.zip 2>/dev/null | head -n1 || true)"
  fi
  echo "$z"
}

make_fallback_vite(){
  say "2) Build fallback React (Vite) in $APP"
  rm -rf "$APP"
  mkdir -p "$APP"
  cd "$APP"

  npm create vite@latest . -- --template react >/dev/null 2>&1 || die "vite init failed"
  npm install >/dev/null 2>&1 || die "npm install failed"

  # Replace App with a clean dark “stacking” landing (SPA)
  cat >"$APP/src/App.jsx"<<'\''EOF'\''
import React,{useMemo,useState} from "react";
const fmt=(n)=>{try{return new Intl.NumberFormat("en-US",{maximumFractionDigits:2}).format(n);}catch{return String(n)}};
export default function App(){
  const [stake,setStake]=useState(1000);
  const [apy,setApy]=useState(18);
  const [days,setDays]=useState(30);
  const out=useMemo(()=>{
    const p=Math.max(0,Number(stake)||0);
    const r=Math.max(0,Number(apy)||0)/100;
    const t=Math.max(0,Number(days)||0)/365;
    const earn=p*r*t;
    const total=p+earn;
    return {p,r,t,earn,total};
  },[stake,apy,days]);
  return(
    <div className="wrap">
      <div className="bg"/>
      <header className="top">
        <div className="brand">
          <div className="logo">A</div>
          <div>
            <div className="t">Aquila Stacking</div>
            <div className="s">React UI • deployed on /aquila_stacking and /iaaquila</div>
          </div>
        </div>
        <div className="pill">fireinners.online</div>
      </header>

      <main className="grid">
        <section className="card">
          <h2>Estimateur de rendement</h2>
          <div className="row">
            <label>Stake</label>
            <input type="number" value={stake} onChange={e=>setStake(e.target.value)} />
            <span className="unit">USD</span>
          </div>
          <div className="row">
            <label>APY</label>
            <input type="number" value={apy} onChange={e=>setApy(e.target.value)} />
            <span className="unit">%</span>
          </div>
          <div className="row">
            <label>Durée</label>
            <input type="number" value={days} onChange={e=>setDays(e.target.value)} />
            <span className="unit">jours</span>
          </div>
          <div className="hr"/>
          <div className="kpis">
            <div className="k"><div className="k1">Gain estimé</div><div className="k2">{fmt(out.earn)} USD</div></div>
            <div className="k"><div className="k1">Total</div><div className="k2">{fmt(out.total)} USD</div></div>
          </div>
          <div className="note">Cette UI est une base design. Tu peux remplacer par ton export “horizons” dès que le zip est présent sur le VPS.</div>
        </section>

        <section className="card">
          <h2>Status</h2>
          <ul className="list">
            <li><span className="dot ok"/> Nginx routes include</li>
            <li><span className="dot ok"/> Webroot: /var/www/aquila_stacking</li>
            <li><span className="dot ok"/> SPA fallback: index.html</li>
            <li><span className="dot ok"/> Paths: /aquila_stacking/ & /iaaquila/</li>
          </ul>
          <div className="hr"/>
          <div className="cta">
            <a className="btn" href="/aquila_stacking/">Open /aquila_stacking</a>
            <a className="btn" href="/iaaquila/">Open /iaaquila</a>
          </div>
        </section>
      </main>
    </div>
  );
}
EOF

  cat >"$APP/src/index.css"<<'\''EOF'\''
:root{color-scheme:dark}
*{box-sizing:border-box}
html,body,#root{height:100%}
body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:#05070c;color:#e9eefc;overflow-x:hidden}
.wrap{min-height:100%;position:relative;padding:28px 20px 60px}
.bg{position:absolute;inset:-40vh -20vw;filter:blur(60px);opacity:.55;pointer-events:none;
background:
radial-gradient(closest-side at 20% 20%,#2b6bff55,transparent 60%),
radial-gradient(closest-side at 75% 35%,#00ffd555,transparent 60%),
radial-gradient(closest-side at 50% 80%,#ff2bd655,transparent 60%);
}
.top{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:14px;max-width:1100px;margin:0 auto 18px}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;
background:linear-gradient(135deg,#2b6bff,#00ffd5);color:#00121a;font-weight:900}
.t{font-weight:800;font-size:18px;letter-spacing:.3px}
.s{opacity:.7;font-size:12px;margin-top:2px}
.pill{padding:8px 12px;border:1px solid #ffffff1a;border-radius:999px;background:#0b1020cc;backdrop-filter:blur(10px);font-size:12px;opacity:.9}
.grid{position:relative;z-index:1;max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1.2fr .8fr;gap:16px}
@media(max-width:900px){.grid{grid-template-columns:1fr}}
.card{border:1px solid #ffffff1a;background:#0b1020cc;backdrop-filter:blur(12px);
border-radius:18px;padding:18px 18px 16px;box-shadow:0 20px 80px #00000066}
h2{margin:0 0 14px;font-size:16px;letter-spacing:.2px}
.row{display:grid;grid-template-columns:90px 1fr 48px;gap:10px;align-items:center;margin:10px 0}
label{opacity:.8;font-size:12px}
input{width:100%;padding:10px 12px;border-radius:12px;border:1px solid #ffffff1a;background:#070a14;color:#e9eefc;outline:none}
input:focus{border-color:#2b6bff88;box-shadow:0 0 0 4px #2b6bff22}
.unit{opacity:.7;font-size:12px;text-align:right}
.hr{height:1px;background:#ffffff14;margin:14px 0}

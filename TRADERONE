from pathlib import Path
import re

DOMAIN="${DOMAIN}"
WEBROOT="${WEBROOT}"
INC="${INC}"

BEGIN="# WOLVERINE_BEGIN"
END="# WOLVERINE_END"

block = f"""{BEGIN}
location = /wolverine {{ return 301 /wolverine/; }}
location ^~ /wolverine/ {{
  alias {WEBROOT}/;
  try_files \\$uri \\$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}}
location = /wolverine/sw.js {{ add_header Cache-Control "no-store" always; return 404; }}
location = /wolverine/service-worker.js {{ add_header Cache-Control "no-store" always; return 404; }}
location = /wolverine/manifest.json {{ add_header Cache-Control "no-store" always; return 404; }}
include {INC};
{END}
"""

def patch_file(fp: Path):
    s = fp.read_text(errors="ignore")
    if DOMAIN not in s or "server" not in s:
        return False

    # replace existing marked block
    if BEGIN in s and END in s:
        pre = s.split(BEGIN,1)[0]
        post = s.split(END,1)[1]
        fp.write_text(pre + block + post)
        return True

    out=[]
    pos=0
    server_pat=re.compile(r"server\\s*\\{", re.I)
    changed=False
    while True:
        m=server_pat.search(s,pos)
        if not m:
            out.append(s[pos:])
            break
        start=m.start()
        out.append(s[pos:start])
        j=m.end()
        brace=1
        while j<len(s) and brace:
            if s[j]=="{": brace+=1
            elif s[j]=="}": brace-=1
            j+=1
        sb=s[start:j]
        pos=j
        if ("server_name" in sb) and (DOMAIN in sb):
            sb = sb[:-1] + "\\n" + block + "\\n}\\n"
            changed=True
        out.append(sb)
    if changed:
        fp.write_text("".join(out))
    return changed

targets=[]
for root in [Path("/etc/nginx/sites-available"), Path("/etc/nginx/sites-enabled")]:
    if root.exists():
        for fp in root.iterdir():
            if fp.is_file():
                try:
                    if patch_file(fp):
                        targets.append(str(fp))
                except Exception:
                    pass
print("patched:", len(targets))
for t in targets[:60]: print(" -", t)

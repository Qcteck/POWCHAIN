cat >/root/fix_wolverine_next_service_noH.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
PORT="${PORT:-3001}"

# récupère le WorkingDirectory actuel
WD="$(systemctl cat wolverine-next 2>/dev/null | awk -F= '/^WorkingDirectory=/{print $2; exit}')"
if [[ -z "${WD:-}" ]]; then
  echo "[ERR] WorkingDirectory introuvable. Colle: systemctl cat wolverine-next"
  exit 1
fi

echo "[*] WD=$WD"
cd "$WD"

npm i
npm run build

NEXT_BIN="$WD/node_modules/next/dist/bin/next"
[[ -f "$NEXT_BIN" ]] || { echo "[ERR] next bin missing: $NEXT_BIN"; exit 1; }

SERVICE="/etc/systemd/system/wolverine-next.service"
ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$SERVICE" "${SERVICE}.bak_${ts}" 2>/dev/null || true

cat >"$SERVICE" <<EOF
[Unit]
Description=Wolverine Next.js Server
After=network.target

[Service]
Type=simple
WorkingDirectory=$WD
Environment=NODE_ENV=production
Environment=PORT=$PORT
ExecStart=/usr/bin/node $NEXT_BIN start -p $PORT
Restart=always
RestartSec=2
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl restart wolverine-next

sleep 1
echo "== status =="
systemctl --no-pager status wolverine-next | sed -n '1,30p' || true
echo
echo "== listening =="
ss -lntp | grep ":$PORT" || echo "[ERR] rien n'écoute sur $PORT"
echo
echo "== upstream curl =="
curl -sSI "http://127.0.0.1:$PORT/" | head -n 20 || true
BASH

chmod +x /root/fix_wolverine_next_service_noH.sh
/root/fix_wolverine_next_service_noH.sh
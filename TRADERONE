#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_csp.inc"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX WOLVERINE CSP (SAFE MODE) ==="

# 1) Vérifs
[ -f "$VHOST" ] || { echo "❌ Vhost introuvable"; exit 1; }

# 2) Backup vhost (lecture seule)
cp -a "$VHOST" "${VHOST}.bak_${TS}"
echo "✔ Backup vhost créé"

# 3) Créer include CSP Wolverine
cat > "$INC" <<'EOF'
# Wolverine CSP – DEV MODE
add_header Content-Security-Policy "default-src * data: blob: 'unsafe-inline' 'unsafe-eval';" always;
EOF

echo "✔ Include CSP créé : $INC"

# 4) Injecter include UNIQUEMENT dans location /wolverine
if ! grep -q "wolverine_csp.inc" "$VHOST"; then
  sed -i '/location \/wolverine/ a\        include /etc/nginx/includes/wolverine_csp.inc;' "$VHOST"
  echo "✔ Include attaché à /wolverine"
else
  echo "ℹ Include déjà présent"
fi

# 5) Test + reload
nginx -t
systemctl reload nginx

echo "✅ NGINX OK – SSL intact"
echo "➡️ CTRL + F5 obligatoire"
cat >/root/WOLVERINE_DEPLOY_WALLET_SOL_USDC.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

### CONFIG
HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP="/var/www/wolverine/index.html.bak_${TS}"
LOG="/root/WOLVERINE_DEPLOY_${TS}.log"

echo "=== WOLVERINE DEPLOY WALLET SOL + USDC ===" | tee "$LOG"

### 1) Vérifications
[ -f "$HTML" ] || { echo "ERREUR: $HTML absent"; exit 1; }
echo "[OK] index.html trouvé" | tee -a "$LOG"

### 2) Backup automatique
cp -a "$HTML" "$BACKUP"
echo "[OK] Backup créé: $BACKUP" | tee -a "$LOG"

### 3) Déploiement HTML propre
cat >"$HTML" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>WOLVERINE — Wallet</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="/wolverine/vendor/solana-web3.min.js"></script>
<style>
body{background:#050b10;color:#9ff;font-family:monospace}
.box{width:420px;margin:80px auto;border:2px solid #0ff;padding:20px}
button{width:100%;margin:6px 0;padding:10px;background:#000;color:#0ff;border:1px solid #0ff;cursor:pointer}
</style>
</head>
<body>

<div class="box">
  <button id="connect">Connect Wallet</button>
  <button id="refresh">Refresh</button>
  <div>Address: <span id="addr">-</span></div>
  <div>SOL: <span id="sol">-</span></div>
  <div>USDC: <span id="usdc">-</span></div>
</div>

<script>
const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT=new solanaWeb3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");
const TOKEN_2022_PROGRAM_ID=new solanaWeb3.PublicKey("TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb");

const connection=new solanaWeb3.Connection(RPC,"confirmed");
let pubkey=null;

async function refreshAll(){
 if(!pubkey) return;

 const lamports=await connection.getBalance(pubkey);
 document.getElementById("sol").innerText=(lamports/1e9).toFixed(6);

 const accs=await connection.getParsedTokenAccountsByOwner(
   pubkey,{programId:TOKEN_2022_PROGRAM_ID}
 );
 let usdc=0;
 for(const a of accs.value){
   const info=a.account.data.parsed.info;
   if(info.mint===USDC_MINT.toBase58()){
     usdc+=Number(info.tokenAmount.uiAmount||0);
   }
 }
 document.getElementById("usdc").innerText=usdc.toFixed(2);
}

document.getElementById("connect").onclick=async()=>{
 if(!window.solana||!window.solana.isPhantom){
   alert("Phantom absent");return;
 }
 const r=await window.solana.connect();
 pubkey=new solanaWeb3.PublicKey(r.publicKey.toString());
 document.getElementById("addr").innerText=pubkey.toBase58();
 await refreshAll();
};

document.getElementById("refresh").onclick=refreshAll;
</script>

</body>
</html>
HTML

echo "[OK] HTML déployé" | tee -a "$LOG"

### 4) Permissions
chown www-data:www-data "$HTML"
chmod 644 "$HTML"

### 5) Cache + nginx
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx
echo "[OK] nginx reload" | tee -a "$LOG"

### 6) Vérification HTTP locale
curl -s http://127.0.0.1/wolverine/ | grep -q "WOLVERINE"
echo "[OK] HTML bien servi" | tee -a "$LOG"

echo "=== TERMINÉ ===" | tee -a "$LOG"
echo "ACTION: CTRL + SHIFT + R sur https://fireinners.online/wolverine"
echo "ROLLBACK: cp $BACKUP $HTML && systemctl reload nginx"
echo "LOG: $LOG"
BASH

chmod +x /root/WOLVERINE_DEPLOY_WALLET_SOL_USDC.sh
/root/WOLVERINE_DEPLOY_WALLET_SOL_USDC.sh
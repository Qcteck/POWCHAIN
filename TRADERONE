import fs from"fs";import path from"path";import crypto from"crypto";import os from"os";
import express from"express";import cors from"cors";
const app=express();app.disable("x-powered-by");app.use(cors());app.use(express.json({limit:"2mb"}));
const ENV=(k,d)=>process.env[k]??d;
const PORT=parseInt(ENV("AIAQUILA_PORT","9690"),10);
const BASE=ENV("AIAQUILA_BASE","/aiaquila");
const DATA_DIR=ENV("AIAQUILA_DATA","/opt/aiaquila/data");
const RPC_PRIMARY=ENV("AIAQUILA_RPC_PRIMARY","https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac");
const RPC_BACKUP =ENV("AIAQUILA_RPC_BACKUP","https://api.mainnet-beta.solana.com");
const ALLOW_ALL_IF_EMPTY=ENV("AIAQUILA_ALLOW_ALL_IF_EMPTY","0")==="1"?1:0;

/* POLICY (server-enforced) */
const POLICY={
  killSwitch: ENV("AIAQUILA_KILL","0")==="1",
  allowAllIfEmpty: ALLOW_ALL_IF_EMPTY,
  allowlist:{
    destinations:(ENV("AIAQUILA_ALLOW_DESTS","")||"").split(",").map(s=>s.trim()).filter(Boolean), // base58 pubkeys
  },
  limits:{
    maxLamportsPerTx: parseInt(ENV("AIAQUILA_MAX_LAMPORTS_PER_TX","2000000"),10), // 0.002 SOL
    maxTxPerHour: parseInt(ENV("AIAQUILA_MAX_TX_PER_HOUR","3"),10),
    maxTxPerDay: parseInt(ENV("AIAQUILA_MAX_TX_PER_DAY","12"),10),
    confirmTimeoutMs: parseInt(ENV("AIAQUILA_CONFIRM_TIMEOUT_MS","20000"),10),
  }
};

const sha=x=>crypto.createHash("sha256").update(String(x||"")).digest("hex");
const now=()=>Date.now();
const jpath=()=>path.join(DATA_DIR,"state.json");
function readState(){
  try{const s=fs.readFileSync(jpath(),"utf8");return JSON.parse(s);}catch(e){
    return {t:now(),pending:[],usage:{hour:{t:0,n:0},day:{t:0,n:0}},events:[]};
  }
}
function writeStateAtomic(st){
  const tmp=jpath()+".tmp."+process.pid;
  fs.writeFileSync(tmp,JSON.stringify(st,null,0));
  fs.renameSync(tmp,jpath());
}
function pushEvent(st,level,msg,extra){
  st.events.push({t:now(),level,msg:String(msg||""),extra:extra||null});
  st.events=st.events.slice(-400);
}
function hourKey(t){const d=new Date(t);d.setMinutes(0,0,0);return d.getTime();}
function dayKey(t){const d=new Date(t);d.setHours(0,0,0,0);return d.getTime();}
function resetWindows(st){
  const t=now();
  if(st.usage.hour.t!==hourKey(t)){st.usage.hour={t:hourKey(t),n:0};}
  if(st.usage.day.t!==dayKey(t)){st.usage.day={t:dayKey(t),n:0};}
}
function policyOk(st){
  if(POLICY.killSwitch) return {ok:false,why:"KILL_SWITCH"};
  resetWindows(st);
  if(st.usage.hour.n>=POLICY.limits.maxTxPerHour) return {ok:false,why:"HOURLY_QUOTA"};
  if(st.usage.day.n>=POLICY.limits.maxTxPerDay) return {ok:false,why:"DAILY_QUOTA"};
  return {ok:true};
}
function allowDest(dest){
  const list=POLICY.allowlist.destinations||[];
  if(list.length===0) return POLICY.allowAllIfEmpty===1;
  return list.includes(dest);
}
function badReq(res,err){res.status(400).json({ok:false,err});}

/* CONFIRM FINALIZED (explicit states) */
async function confirmFinalized(sig){
  const timeout=POLICY.limits.confirmTimeoutMs;
  const t0=Date.now(); let last=null;
  const urls=[RPC_PRIMARY,RPC_BACKUP];
  const sleep=ms=>new Promise(r=>setTimeout(r,ms));
  while(Date.now()-t0<timeout){
    for(const rpc of urls){
      try{
        const r=await fetch(rpc,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:"getSignatureStatuses",params:[[sig],{searchTransactionHistory:true}]})});
        const j=await r.json();
        const v=j?.result?.value?.[0];
        if(!v){last={rpc,st:"NOT_FOUND"};continue;}
        if(v.err){return {ok:false,st:"FAILED",rpc,err:v.err};}
        const conf=v.confirmationStatus||"processed";
        if(conf==="finalized") return {ok:true,st:"FINALIZED",rpc,slot:v.slot||null,confirmations:v.confirmations??null};
        last={rpc,st:"PENDING",conf,slot:v.slot||null};
      }catch(e){last={rpc,st:"RPC_ERR"};}
    }
    await sleep(650);
  }
  return {ok:false,st:"TIMEOUT",last};
}

/* ROUTES */
app.get(`${BASE}/api/health`,(req,res)=>res.json({ok:true,base:BASE,port:PORT,policy:POLICY,rpc:{primary:RPC_PRIMARY,backup:RPC_BACKUP},t:now()}));
app.get(`${BASE}/api/state`,(req,res)=>{const st=readState();resetWindows(st);res.json({ok:true,st,policy:POLICY,rpc:{primary:RPC_PRIMARY,backup:RPC_BACKUP}});});

app.post(`${BASE}/api/pending/propose`,(req,res)=>{
  const {kind,desc,payload}=req.body||{};
  if(!kind||!desc) return badReq(res,"missing kind/desc");
  const st=readState(); resetWindows(st);
  const id="P_"+Date.now()+"_"+Math.random().toString(16).slice(2);
  const ph=sha(JSON.stringify(payload||{}));
  st.pending.push({id,kind,desc:String(desc).slice(0,400),payload:payload||{},payloadHash:ph,status:"PENDING",t:now()});
  st.pending=st.pending.slice(-300);
  pushEvent(st,"INFO","PENDING_CREATED",{id,kind});
  writeStateAtomic(st);
  res.json({ok:true,id,payloadHash:ph});
});

app.post(`${BASE}/api/pending/resolve`,(req,res)=>{
  const {id,ok}=req.body||{};
  if(!id) return badReq(res,"missing id");
  const st=readState(); resetWindows(st);
  const p=st.pending.find(x=>x.id===id);
  if(!p) return badReq(res,"pending not found");
  if(p.status!=="PENDING") return badReq(res,"pending already resolved");
  p.status=ok?"APPROVED":"REFUSED"; p.resolvedAt=now();
  pushEvent(st,"INFO",ok?"PENDING_APPROVED":"PENDING_REFUSED",{id});
  writeStateAtomic(st);
  res.json({ok:true,p});
});

/* EXECUTION: server builds UNSIGNED transfer tx message (client signs with Phantom). */
app.post(`${BASE}/api/exec/prepare_transfer`,async(req,res)=>{
  try{
    const {pendingId,from,to,lamports,clientId}=req.body||{};
    if(!pendingId||!from||!to||!lamports) return badReq(res,"missing pendingId/from/to/lamports");
    const st=readState(); resetWindows(st);
    const okp=policyOk(st); if(!okp.ok) return res.status(403).json({ok:false,err:"POLICY_"+okp.why});
    const p=st.pending.find(x=>x.id===pendingId);
    if(!p||p.status!=="APPROVED") return res.status(403).json({ok:false,err:"PENDING_NOT_APPROVED"});
    const payloadHash=sha(JSON.stringify({from,to,lamports:Number(lamports)}));
    if(payloadHash!==p.payloadHash) return res.status(403).json({ok:false,err:"PAYLOAD_HASH_MISMATCH"});
    if(!allowDest(to)) return res.status(403).json({ok:false,err:"DEST_NOT_ALLOWED"});
    const L=Number(lamports);
    if(!Number.isFinite(L)||L<=0||L>POLICY.limits.maxLamportsPerTx) return res.status(403).json({ok:false,err:"LAMPORTS_LIMIT"});
    const nonce="N_"+Date.now()+"_"+Math.random().toString(16).slice(2);
    const prepId="PREP_"+Date.now()+"_"+Math.random().toString(16).slice(2);
    const prepHash=sha(prepId+"|"+pendingId+"|"+nonce+"|"+payloadHash);
    st.pending=st.pending.map(x=>x.id===pendingId?({...x,exec:{prepId,prepHash,nonce,preparedAt:now(),clientId:clientId||null}}):x);
    pushEvent(st,"INFO","EXEC_PREPARED",{pendingId,prepId});
    writeStateAtomic(st);
    res.json({ok:true,prepId,prepHash,nonce,from,to,lamports:L,rpc:{primary:RPC_PRIMARY,backup:RPC_BACKUP}});
  }catch(e){res.status(500).json({ok:false,err:String(e)});}
});

/* COMMIT: consume quota ONLY after finalized proof */
app.post(`${BASE}/api/exec/commit`,async(req,res)=>{
  try{
    const {pendingId,prepId,prepHash,txid}=req.body||{};
    if(!pendingId||!prepId||!prepHash||!txid) return badReq(res,"missing pendingId/prepId/prepHash/txid");
    const st=readState(); resetWindows(st);
    const p=st.pending.find(x=>x.id===pendingId);
    if(!p||p.status!=="APPROVED") return res.status(403).json({ok:false,err:"PENDING_NOT_APPROVED"});
    const ex=p.exec||{};
    if(ex.prepId!==prepId||ex.prepHash!==prepHash) return res.status(403).json({ok:false,err:"PREP_MISMATCH"});
    if(p.committedTxid) return res.json({ok:true,st:"IDEMPOTENT_ALREADY_COMMITTED",txid:p.committedTxid});
    const conf=await confirmFinalized(txid);
    if(!conf.ok){
      pushEvent(st,"WARN","COMMIT_NOT_FINALIZED",{pendingId,txid,st:conf.st,last:conf.last||null,err:conf.err||null});
      writeStateAtomic(st);
      return res.status(409).json({ok:false,st:conf.st,last:conf.last||null,err:conf.err||null});
    }
    st.usage.hour.n+=1; st.usage.day.n+=1;
    p.committedTxid=txid; p.committedAt=now(); p.commitRpc=conf.rpc; p.commitSlot=conf.slot||null;
    pushEvent(st,"INFO","COMMIT_FINALIZED",{pendingId,txid,rpc:conf.rpc,slot:conf.slot||null});
    writeStateAtomic(st);
    res.json({ok:true,st:"FINALIZED",txid,rpc:conf.rpc,slot:conf.slot||null,usage:st.usage});
  }catch(e){res.status(500).json({ok:false,err:String(e)});}
});

/* STATIC */
app.use(`${BASE}/`,express.static("/var/www/aiaquila",{index:"index.html"}));

app.listen(PORT,"127.0.0.1",()=>console.log("AIAQUILA on 127.0.0.1:"+PORT+" base "+BASE));

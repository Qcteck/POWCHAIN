bash -c "$(cat <<'BASH'
set -euo pipefail
echo '=== WOLVERINE HARD PROOF BALANCES ==='

read -p '👉 COLLE ICI L’ADRESSE QUI S’AFFICHE DANS LE WALLET UI: ' PUB

RPC="https://api.mainnet-beta.solana.com"
USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

echo
echo '--- SOL BALANCE (SERVER SIDE) ---'
curl -s -X POST $RPC -H 'Content-Type: application/json' \
 --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getBalance\",\"params\":[\"$PUB\"]}" \
 | jq '.result.value/1000000000'

echo
echo '--- USDC BALANCE (SERVER SIDE) ---'
curl -s -X POST $RPC -H 'Content-Type: application/json' \
 --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getParsedTokenAccountsByOwner\",\"params\":[\"$PUB\",{\"mint\":\"$USDC\"},{\"encoding\":\"jsonParsed\"}]}" \
 | jq '[.result.value[].account.data.parsed.info.tokenAmount.uiAmount]|add'

echo
echo '=== END ==='
BASH
)"
bash <<'EOF'
set -e

SITE="/etc/nginx/sites-available/fireinners.online-ssl"
TMP="/tmp/fireinners_fixed.conf"
BACKUP="$(ls -t /etc/nginx/sites-available/fireinners.online-ssl.bak.* | head -n1)"

echo "=== FIX NGINX WOLVERINE ==="

echo "[1/6] Restore config saine"
cp "$BACKUP" "$SITE"

echo "[2/6] Injection blocs WOLVERINE dans server{}"

awk '
BEGIN{added=0}
/server\s*{/{
  print;
  if(!added){
    print "    ### === WOLVERINE → TRADERONE API ===";
    print "    location /wolverine/api/ {";
    print "        proxy_pass http://127.0.0.1:3000/api/;";
    print "        proxy_http_version 1.1;";
    print "        proxy_set_header Host $host;";
    print "        proxy_set_header X-Real-IP $remote_addr;";
    print "        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;";
    print "    }";
    print "";
    print "    location /wolverine/traderone/api/ {";
    print "        proxy_pass http://127.0.0.1:3000/wolverine/traderone/api/;";
    print "        proxy_http_version 1.1;";
    print "        proxy_set_header Host $host;";
    print "    }";
    print "    ### === END WOLVERINE ===";
    added=1;
  }
  next
}
{print}
' "$SITE" > "$TMP"

mv "$TMP" "$SITE"

echo "[3/6] Test nginx"
nginx -t

echo "[4/6] Reload nginx"
systemctl reload nginx

echo "[5/6] Test API Wolverine"
URL="https://www.fireinners.online/wolverine/api/balances"
curl -fsSL "$URL" || {
  echo "[ERR] API non accessible"
  exit 1
}

echo "[6/6] SUCCESS"
echo "URL : $URL"
curl -s "$URL"

echo "=== NGINX WOLVERINE FIXED ==="
EOF
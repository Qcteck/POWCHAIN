import express from "express";
import cors from "cors";
import fs from "fs";
import path from "path";
import crypto from "crypto";
import fetch from "node-fetch";

const app=express();app.disable("x-powered-by");app.use(cors());app.use(express.json({limit:"10mb"}));
const ENV=(k,d)=>process.env[k]??d;
const PORT=parseInt(ENV("PORT","9688"),10);
const HOST=ENV("HOST","127.0.0.1");
const SOL_RPC_PRIMARY=ENV("SOL_RPC_PRIMARY","https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac");
const SOL_RPC_BACKUP=ENV("SOL_RPC_BACKUP","https://api.mainnet-beta.solana.com");
const JUP_PROXY=(ENV("JUP_PROXY","")||"").replace(/\/$/,"");

const APP_DIR=new URL(".",import.meta.url).pathname.replace(/\/$/,"");
const PUB_DIR=path.join(APP_DIR,"public");
const CFG_DIR=path.join(APP_DIR,"config");
const DATA_DIR=path.join(APP_DIR,"data");
const ALLOW_FILE=path.join(CFG_DIR,"exec_allowlist.json");
const PENDING_FILE=path.join(DATA_DIR,"pending_state.json");
const EXEC_FILE=path.join(DATA_DIR,"exec_state.json");

const sha=x=>crypto.createHash("sha256").update(String(x??"")).digest("hex");
const now=()=>Date.now();
function atomicWrite(file,obj){const tmp=file+".tmp_"+now()+"_"+Math.random().toString(16).slice(2);fs.mkdirSync(path.dirname(file),{recursive:true});fs.writeFileSync(tmp,JSON.stringify(obj));fs.renameSync(tmp,file);}
function loadJSON(file,def){try{return JSON.parse(fs.readFileSync(file,"utf8"));}catch{return def;}}
let allow=loadJSON(ALLOW_FILE,{killSwitch:false,ALLOW_ALL_IF_EMPTY:0,global:{maxTxPer24h:0,maxUsdPer24h:0,maxSlippageBps:120},pairs:[]});
let pending=(loadJSON(PENDING_FILE,{pending:[]}).pending)||[];
let execState=loadJSON(EXEC_FILE,{usage:{windowStart:0,tx24h:0,usd24h:0,byPair:{}},executed:{}});
function persist(){atomicWrite(PENDING_FILE,{t:now(),pending});atomicWrite(EXEC_FILE,{t:now(),...execState});}
function usageResetIfNeeded(){const U=execState.usage;const w=U.windowStart||0;const t=now();if(!w||(t-w)>(24*3600*1000)){U.windowStart=t;U.tx24h=0;U.usd24h=0;U.byPair={};}}
function norm(s){return String(s||"").trim();}
function bad(msg,code=400){const e=new Error(String(msg));e.status=code;throw e;}
function inAllowlist(inMint,outMint,dir){const im=norm(inMint),om=norm(outMint),d=String(dir||"IN_TO_OUT");return (allow.pairs||[]).find(p=>norm(p.inMint)===im&&norm(p.outMint)===om&&String(p.direction||"IN_TO_OUT")===d)||null;}
function pairKey(i,o){return sha(norm(i)+"->"+norm(o)).slice(0,16);}
async function fetchJSON(url,opts={},ms=15000){const ac=new AbortController();const t=setTimeout(()=>ac.abort(),ms);try{const r=await fetch(url,{cache:"no-store",signal:ac.signal,...opts});if(!r.ok) throw new Error("HTTP "+r.status);return await r.json();}finally{clearTimeout(t);}}
async function rpcCall(url,method,params,ms=9000){return await fetchJSON(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method,params})},ms);}
async function confirmFinalized(sig,timeoutMs=22000){const started=now();let last=null;while(now()-started<timeoutMs){for(const rpc of [SOL_RPC_PRIMARY,SOL_RPC_BACKUP]){try{const tx=await rpcCall(rpc,"getTransaction",[sig,{encoding:"json",commitment:"finalized",maxSupportedTransactionVersion:0}],9000).catch(()=>null);if(tx&&tx.result) return {ok:true,finalized:true,slot:tx.result.slot||null,rpc,via:"getTransaction"};const st=await rpcCall(rpc,"getSignatureStatuses",[[sig],{searchTransactionHistory:true}],9000).catch(()=>null);const v=st?.result?.value?.[0]||null;if(v){if(v.err) return {ok:false,finalized:false,err:v.err,conf:v.confirmationStatus||null,rpc};if(v.confirmationStatus==="finalized") return {ok:true,finalized:true,slot:v.slot||null,rpc,via:"statuses"};last={ok:true,finalized:false,conf:v.confirmationStatus||null,slot:v.slot||null,rpc};}}catch(e){last={ok:false,finalized:false,err:String(e),rpc};}}await new Promise(r=>setTimeout(r,900));}return last||{ok:false,finalized:false,err:"timeout"};}
function pushPending(desc,payload){const id="ACT_"+now()+"_"+Math.random().toString(16).slice(2);const rec={id,desc:String(desc||"Action"),status:"PENDING",payload:payload||{},payloadHash:sha(JSON.stringify(payload||{})),createdAt:now()};pending.push(rec);pending=pending.slice(-400);persist();return id;}
function resolvePending(id,ok){const a=pending.find(x=>x.id===id);if(!a) return null;a.status=ok?"APPROVED":"REFUSED";a.resolvedAt=now();persist();return a;}
function mustApproved(pendingId,payload){const a=pending.find(x=>x.id===pendingId);if(!a) bad("pending not found");if(a.status!=="APPROVED") bad("pending not APPROVED");const h=sha(JSON.stringify(payload||{}));if(h!==a.payloadHash) bad("payload hash mismatch");if(a.executedAt||a.txSig||a.status==="EXECUTED") bad("pending already executed");return a;}
function markExecuted(id,txSig){const a=pending.find(x=>x.id===id);if(!a) return null;a.executedAt=now();a.txSig=txSig||null;a.status="EXECUTED";persist();return a;}

app.use("/iaaquila/",express.static(PUB_DIR,{etag:false,maxAge:0}));

app.get("/iaaquila/api/health",(req,res)=>res.json({ok:true,t:now(),port:PORT,rpc:{primary:SOL_RPC_PRIMARY,backup:SOL_RPC_BACKUP},jupProxy:JUP_PROXY||null}));

app.get("/iaaquila/api/exec/policy",(req,res)=>{allow=loadJSON(ALLOW_FILE,allow);usageResetIfNeeded();persist();res.json({ok:true,allow,usage:execState.usage,rpc:{primary:SOL_RPC_PRIMARY,backup:SOL_RPC_BACKUP}});});

app.post("/iaaquila/api/decision/propose",(req,res)=>{const {desc,payload}=req.body||{};const id=pushPending(desc||"Action",payload||{});res.json({ok:true,id});});
app.post("/iaaquila/api/decision/resolve",(req,res)=>{const {id,ok}=req.body||{};const a=resolvePending(id,!!ok);res.json({ok:!!a,action:a});});

app.post("/iaaquila/api/exec/swap/propose",(req,res)=>{try{allow=loadJSON(ALLOW_FILE,allow);usageResetIfNeeded();const {inMint,outMint,amountIn,slippageBps,dir}=req.body||{};const im=norm(inMint),om=norm(outMint);const amt=Number(amountIn||0),slip=Number(slippageBps||0);if(!im||!om) bad("missing mints");if(!(Number.isFinite(amt)&&amt>0)) bad("bad amountIn");if(!(Number.isFinite(slip)&&slip>0&&slip<=500)) bad("bad slippage");if(allow.killSwitch) bad("killSwitch ON");const pair=inAllowlist(im,om,dir||"IN_TO_OUT");if(!pair||!allow.ALLOW_ALL_IF_EMPTY) bad("pair not allowlisted");const maxSlip=Math.min(Number(pair.maxSlippageBps||allow.global?.maxSlippageBps||120),Number(allow.global?.maxSlippageBps||120));if(slip>maxSlip) bad("slippage too high");const maxAmt=Number(pair.maxAmountIn||0);if(maxAmt>0&&amt>maxAmt) bad("amount exceeds maxAmountIn");const payload={kind:"EXEC_SWAP",dir:dir||"IN_TO_OUT",inMint:im,outMint:om,amountIn:amt,slippageBps:slip};const id=pushPending("EXEC SWAP (requires APPROVE)",payload);res.json({ok:true,id,payload});}catch(e){res.status(e.status||500).json({ok:false,err:String(e.message||e)});}});

async function jupQuote(inMint,outMint,amountRaw,slipBps){const base=(JUP_PROXY||"https://quote-api.jup.ag").replace(/\/$/,"");const url=base+`/v6/quote?inputMint=${encodeURIComponent(inMint)}&outputMint=${encodeURIComponent(outMint)}&amount=${encodeURIComponent(String(amountRaw))}&slippageBps=${encodeURIComponent(String(slipBps))}`;return await fetchJSON(url,{},15000);}
async function jupSwap(quote,userPub){const base=(JUP_PROXY||"https://quote-api.jup.ag").replace(/\/$/,"");const url=base+"/v6/swap";const body={quoteResponse:quote,userPublicKey:userPub,wrapAndUnwrapSol:true,asLegacyTransaction:false,computeUnitPriceMicroLamports:"auto"};return await fetchJSON(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body)},20000);}

app.post("/iaaquila/api/exec/swap/prepare",async(req,res)=>{try{allow=loadJSON(ALLOW_FILE,allow);usageResetIfNeeded();const {pendingId,userPub,decimalsIn}=req.body||{};if(!pendingId||!userPub) bad("missing pendingId/userPub");const a=pending.find(x=>x.id===pendingId);if(!a) bad("pending not found");const p=a.payload||{};mustApproved(pendingId,p);if(allow.killSwitch) bad("killSwitch ON");const pair=inAllowlist(p.inMint,p.outMint,p.dir||"IN_TO_OUT");if(!pair||!allow.ALLOW_ALL_IF_EMPTY) bad("pair not allowlisted");const U=execState.usage;const gTx=Number(allow.global?.maxTxPer24h||0);if(gTx>0&&U.tx24h>=gTx) bad("global tx quota exceeded");const k=pairKey(p.inMint,p.outMint);U.byPair[k]=U.byPair[k]||{tx24h:0,usd24h:0};const pTx=Number(pair.maxTxPer24h||0);if(pTx>0&&U.byPair[k].tx24h>=pTx) bad("pair tx quota exceeded");const dec=Number(decimalsIn||6);if(!Number.isFinite(dec)||dec<0||dec>12) bad("bad decimalsIn");const amountRaw=String(Math.floor(Number(p.amountIn)*Math.pow(10,dec)));if(!/^\d+$/.test(amountRaw)) bad("cannot compute amountRaw");const quote=await jupQuote(p.inMint,p.outMint,amountRaw,Number(p.slippageBps||120));const sw=await jupSwap(quote,userPub);const txB64=sw?.swapTransaction||null;if(!txB64) bad("no swapTransaction");persist();res.json({ok:true,pendingId,userPub,amountRaw,swapTransactionBase64:txB64});}catch(e){res.status(e.status||500).json({ok:false,err:String(e.message||e)});}});

app.post("/iaaquila/api/exec/commit",async(req,res)=>{try{usageResetIfNeeded();const {pendingId,txSig}=req.body||{};if(!pendingId||!txSig) bad("missing pendingId/txSig");const a=pending.find(x=>x.id===pendingId);if(!a) bad("pending not found");const p=a.payload||{};mustApproved(pendingId,p);if(execState.executed[pendingId]) bad("already committed");const conf=await confirmFinalized(String(txSig),22000);if(!(conf&&conf.ok&&conf.finalized)) return res.status(409).json({ok:false,finalized:false,conf});const U=execState.usage;const k=pairKey(p.inMint,p.outMint);U.tx24h++;U.byPair[k]=U.byPair[k]||{tx24h:0,usd24h:0};U.byPair[k].tx24h++;execState.executed[pendingId]={t:now(),txSig:String(txSig)};markExecuted(pendingId,String(txSig));persist();res.json({ok:true,finalized:true,txSig:String(txSig),conf});}catch(e){res.status(e.status||500).json({ok:false,err:String(e.message||e)});}});

app.use((err,req,res,next)=>res.status(err.status||500).json({ok:false,err:String(err.message||err)}));
app.listen(PORT,HOST,()=>console.log("IaAquila listening "+HOST+":"+PORT));

echo "== LISTEN 80/443 (IPv4/IPv6) =="
ss -lntp | egrep ':(80|443)\s' || true
echo

echo "== Who owns 443 (lsof) =="
lsof -iTCP:443 -sTCP:LISTEN -nP 2>/dev/null || echo "No LISTEN on 443"
echo

echo "== nginx status + test config =="
systemctl status nginx --no-pager -l | sed -n '1,25p' || true
nginx -t || true
echo
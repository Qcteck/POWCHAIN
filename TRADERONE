<script>
const FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://news.bitcoin.com/feed/"
];

const PROXY = "/aiaquila/rss-proxy.php?url=";
let ARTICLES = [];

async function loadRSS() {
  ARTICLES = [];
  const log = msg => document.getElementById("log").textContent += msg + "\n";

  log("Chargement RSS...");

  for (const feed of FEEDS) {
    try {
      const res = await fetch(PROXY + encodeURIComponent(feed));
      const xmlText = await res.text();

      const xml = new DOMParser().parseFromString(xmlText, "text/xml");

      const items = [
        ...xml.querySelectorAll("item"),
        ...xml.querySelectorAll("entry")
      ];

      log(`Flux ${feed} → ${items.length} articles`);

      items.forEach(it => {
        const title =
          it.querySelector("title")?.textContent?.trim() || null;

        const desc =
          it.querySelector("description")?.textContent ||
          it.querySelector("summary")?.textContent ||
          "";

        if (title) {
          ARTICLES.push({ title, desc });
        }
      });

    } catch (e) {
      log(`Erreur flux ${feed}`);
    }
  }

  log(`TOTAL articles: ${ARTICLES.length}`);
  renderArticles();
}

function renderArticles() {
  const box = document.getElementById("articles");
  box.innerHTML = "";

  ARTICLES.forEach(a => {
    const d = document.createElement("div");
    d.textContent = "• " + a.title;
    box.appendChild(d);
  });
}
</script>
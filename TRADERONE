bash -c "$(cat <<'BASH'
set -euo pipefail
echo '=== WOLVERINE ONE-SHOT FIX (AUTO-RUN) ==='

APP_DIR="/opt/wolverine/solana-proxy"
PORT=3010
SERVICE="wolverine-solana-proxy"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

# 1) Pré-check
command -v node >/dev/null || { echo '❌ Node manquant'; exit 1; }

# 2) Proxy Solana local
mkdir -p "$APP_DIR"
cd "$APP_DIR"

cat > package.json <<'JSON'
{"name":"wolverine-solana-proxy","version":"1.0.0","type":"module","dependencies":{"express":"^4.19.2","node-fetch":"^3.3.2"}}
JSON

cat > server.js <<'JS'
import express from "express";
import fetch from "node-fetch";
const app=express();app.use(express.json());
const RPC="https://api.mainnet-beta.solana.com";
app.post("/rpc/solana",async(req,res)=>{try{const r=await fetch(RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(req.body)});res.json(await r.json());}catch(e){res.status(500).json({error:e.message});}});
app.listen(3010,()=>console.log("proxy 3010"));
JS

npm install --silent

cat >/etc/systemd/system/$SERVICE.service <<EOF
[Unit]
Description=Wolverine Solana RPC Proxy
After=network.target
[Service]
Type=simple
WorkingDirectory=$APP_DIR
ExecStart=/usr/bin/node server.js
Restart=always
User=root
[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now $SERVICE

# 3) Nginx route
grep -q 'location /rpc/solana' "$VHOST" || cat >>"$VHOST" <<'NG'
location /rpc/solana {
  proxy_pass http://127.0.0.1:3010/rpc/solana;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
}
NG

nginx -t && systemctl reload nginx

# 4) Frontend : RESTORE CONNECT + SOL + USDC + RPC PROXY
cp "$HTML" "$HTML.bak_$TS" || true
cat >"$HTML" <<'HTML'
<!DOCTYPE html><html><head><meta charset="utf-8"><title>Wolverine Wallet</title>
<style>body{background:#0b0b0b;color:#0ff;font-family:Arial}#w{max-width:420px;margin:80px auto;padding:20px;border:1px solid #0ff;border-radius:8px}button{width:100%;padding:12px;margin-top:10px;background:#0ff;border:0;font-weight:bold}</style>
</head><body>
<div id="w">
<button id="c">Connect Phantom</button>
<button id="d" style="display:none">Disconnect</button>
<div>Address: <span id="a">-</span></div>
<div>SOL: <span id="s">-</span></div>
<div>USDC: <span id="u">-</span></div>
</div>
<script>
const RPC="/rpc/solana",USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
async function rpc(m,p){const r=await fetch(RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:m,params:p})});return (await r.json()).result;}
c.onclick=async()=>{if(!window.solana||!solana.isPhantom)return alert("Phantom missing");const r=await solana.connect();const pub=r.publicKey.toString();a.textContent=pub;
const bal=await rpc("getBalance",[pub]);s.textContent=((bal&&bal.value)?bal.value:0)/1e9;
const tok=await rpc("getParsedTokenAccountsByOwner",[pub,{mint:USDC},{encoding:"jsonParsed"}]);let u0=0;(tok?.value||[]).forEach(x=>u0+=Number(x.account.data.parsed.info.tokenAmount.uiAmount||0));u.textContent=u0.toFixed(2);
c.style.display="none";d.style.display="block";}
d.onclick=async()=>{await solana.disconnect();a.textContent=s.textContent=u.textContent="-";d.style.display="none";c.style.display="block";}
</script></body></html>
HTML

# 5) Vérifs finales
echo '--- CHECKS ---'
systemctl is-active $SERVICE
curl -s -X POST http://127.0.0.1:3010/rpc/solana -H 'Content-Type: application/json' --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}'
echo '=== DONE : HARD REFRESH (CTRL+SHIFT+R) ==='
BASH
)"
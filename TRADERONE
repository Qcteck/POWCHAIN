cat >/root/WOLVERINE_FIX_USDC_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
BAK="${HTML}.bak_${TS}"

[ -f "$HTML" ] || { echo "HTML introuvable"; exit 1; }
cp -a "$HTML" "$BAK"
echo "[OK] Backup $BAK"

# Supprime toute ancienne logique USDC
perl -0777 -i -pe 's/async function refreshUSDC[\s\S]*?}\s*//g' "$HTML"

# Injecte logique USDC ROBUSTE (scan global SPL)
perl -0777 -i -pe 's#</script>#\nasync function refreshUSDC(){\n try{\n  const USDC_MINT=\"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v\";\n  let total=0;\n  const res=await connection.getParsedTokenAccountsByOwner(pubkey,{programId:solanaWeb3.TOKEN_PROGRAM_ID});\n  for(const a of res.value){\n    const info=a.account.data.parsed.info;\n    if(info.mint===USDC_MINT){ total+=Number(info.tokenAmount.uiAmount||0); }\n  }\n  document.getElementById(\"usdc\").innerText=total.toFixed(2);\n }catch(e){ console.error(\"USDC\",e); document.getElementById(\"usdc\").innerText=\"0.00\"; }\n}\nconst __oldRefreshSOL=refreshSOL;\nrefreshSOL=async()=>{ await __oldRefreshSOL(); await refreshUSDC(); };\n</script>#s' "$HTML"

# Ajoute champ HTML si absent
grep -q 'id="usdc"' "$HTML" || sed -i 's/USDC:.*$/USDC: <span id="usdc">0.00<\/span>/' "$HTML"

echo "[OK] USDC FIX INJECTÉ"
echo "=== FAIS CTRL+SHIFT+R DANS LE NAVIGATEUR ==="
BASH

chmod +x /root/WOLVERINE_FIX_USDC_FINAL.sh
/root/WOLVERINE_FIX_USDC_FINAL.sh
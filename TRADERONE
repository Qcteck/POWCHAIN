cat >/root/fix_port_and_srpc_now.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/traderone_api_proxy.conf"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== 0) nginx sanity =="
nginx -t

echo "== 1) Detect backend port (from your node ports) =="
PORT=""
for p in 8585 3005 8484 9696 12703 3000 3001 3100 8080 8000 5000; do
  code="$(curl -s -o /tmp/h.$$ -w "%{http_code}" "http://127.0.0.1:$p/api/health" || true)"
  if [[ "$code" == "200" ]]; then
    head -c 60 /tmp/h.$$ | tr -d '\n' | grep -qv "<!DOCTYPE html" && PORT="$p" && break
  fi
done
rm -f /tmp/h.$$ 2>/dev/null || true

if [[ -z "$PORT" ]]; then
  echo "[ERR] No backend found responding to http://127.0.0.1:PORT/api/health"
  ss -lntp | grep -E "node|:8585|:3005|:8484|:9696|:12703|:3000" || true
  exit 1
fi
echo "[OK] PORT=$PORT"

echo "== 2) Backup + write API proxy snippet with correct PORT =="
cp -a "$AV" "${AV}.bak_${ts}"
mkdir -p /etc/nginx/snippets

cat >"$SNIP" <<NGINX
# /wolverine/traderone/api/* -> http://127.0.0.1:${PORT}/api/*

location = /wolverine/traderone/api/health {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:${PORT};
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";

  rewrite ^/wolverine/traderone/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:${PORT};
}
NGINX

# ensure include exists in vhost
if ! grep -q "traderone_api_proxy.conf" "$AV"; then
  sed -i '/server_name .*fireinners\.online/ a\  include /etc/nginx/snippets/traderone_api_proxy.conf;' "$AV"
fi

# hard-stop /srpc for ALL methods (avoid CF/WAF hits once JS stops calling it)
if ! grep -q "location = /srpc" "$AV"; then
  sed -i '/server_name .*fireinners\.online/ a\  location = /srpc { return 404; }' "$AV"
fi

ln -sf "$AV" "$EN"

echo "== 3) reload nginx =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== 4) LOCAL tests =="
echo "-- http://127.0.0.1:${PORT}/api/health"
curl -sS -i "http://127.0.0.1:${PORT}/api/health" | sed -n '1,25p'
echo

echo
echo "== 5) PUBLIC tests (health) =="
curl -sk -i "https://${DOMAIN}/wolverine/traderone/api/health" | sed -n '1,25p'
echo "-- body first 120:"
curl -sk "https://${DOMAIN}/wolverine/traderone/api/health" | head -c 120; echo

echo
echo "== 6) Check what phantom_patch.js SERVED contains (srpc?) =="
curl -sk "https://${DOMAIN}/wolverine/phantom_patch.js?v=${ts}" | grep -nE "/srpc|/wolverine/rpc" || true

echo
echo "== 7) PUBLIC POST /srpc (should be 404, not 403) =="
curl -sk -i -X POST "https://${DOMAIN}/srpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,20p'

echo
echo "DONE ✅"
echo "Tip: open https://${DOMAIN}/wolverine/?v=${ts} to bypass cache."
BASH

chmod +x /root/fix_port_and_srpc_now.sh
/root/fix_port_and_srpc_now.sh
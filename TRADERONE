cat >/root/fix_traderone_me_orders_404.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "== 1) Find which file is included by the vhost =="
INC_LINE="$(grep -nE 'include\s+.*wolverine_routes\.(inc|conf);' "$VHOST" | head -n 1 || true)"
echo "VHOST include: $INC_LINE"
if [ -z "$INC_LINE" ]; then
  echo "❌ No include wolverine_routes.* found in $VHOST"
  exit 1
fi

INC_FILE="$(echo "$INC_LINE" | sed -E 's/^[0-9]+:.*include[[:space:]]+([^;]+);.*/\1/')"
echo "INC_FILE=$INC_FILE"
test -f "$INC_FILE" || { echo "❌ Included file not found: $INC_FILE"; exit 1; }

echo "== 2) Backup =="
cp -a "$INC_FILE" "$INC_FILE.bak_$TS"

echo "== 3) Rewrite routes to ROOT backend (me/orders/positions/pnl) =="
cat > "$INC_FILE" <<'NGX'
# Wolverine routes (clean) - traderone backend expects /health, /me, /orders, ...

location = /wolverine/traderone/api {
  return 301 /wolverine/traderone/api/;
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /$1 break;
  proxy_pass http://127.0.0.1:8585;
}
NGX

echo "== 4) nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "== 5) Re-test =="
for p in /wolverine/traderone/api/health /wolverine/traderone/api/me /wolverine/traderone/api/orders ; do
  code=$(curl -sk -o /dev/null -w "%{http_code}" "https://fireinners.online$p")
  echo "$p => $code"
done

echo "DONE ✅"
BASH

chmod +x /root/fix_traderone_me_orders_404.sh
/root/fix_traderone_me_orders_404.sh
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIX WOLVERINE FRONTEND API URL ==="

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

if [ ! -f "$HTML" ]; then
  echo "❌ Fichier introuvable: $HTML"
  exit 1
fi

echo "📦 Backup..."
cp -a "$HTML" "${HTML}.bak_${TS}"

echo "🔧 Patch des URLs API..."

sed -i \
  -e 's|https://wolverine/api/|/wolverine/api/|g' \
  -e 's|http://wolverine/api/|/wolverine/api/|g' \
  "$HTML"

echo "🔍 Vérification..."
grep -n "/wolverine/api/" "$HTML" || echo "⚠️ Aucune occurrence trouvée (déjà corrigé ?)"

echo "🔄 Reload nginx..."
nginx -t && systemctl reload nginx

echo "✅ FIX TERMINÉ"
echo "➡️ Recharge la page avec Ctrl+F5 puis Connect Phantom"
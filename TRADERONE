#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX REAL BUTTONS (WOLVERINE) ==="

[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup créé"

# 1) Forcer les menus à être de vrais boutons
sed -i '
s/<li[^>]*data-view="\([^"]*\)"[^>]*>/<button type="button" class="menu-btn" data-view="\1">/g
s/<\/li>/<\/button>/g
' "$HTML"

# 2) Forcer Connect Phantom en vrai bouton
sed -i '
s/<[^>]*id="connectWallet"[^>]*>/<button type="button" id="connectWallet">/g
s/<\/[^>]*id="connectWallet"[^>]*>/<\/button>/g
' "$HTML"

# 3) CSS sécurité : rendre tout cliquable
sed -i '/<\/head>/i \
<style>\
.menu-btn{all:unset;display:block;width:100%;padding:12px;cursor:pointer}\
.menu-btn:hover{background:rgba(255,255,255,.08)}\
#connectWallet{cursor:pointer}\
</style>' "$HTML"

echo "✅ STRUCTURE CORRIGÉE"
echo "➡️ CTRL + F5 obligatoire"
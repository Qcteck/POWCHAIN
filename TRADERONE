cat >/root/WOLVERINE_VAULT_DEDUP_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

FRONT="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE VAULT DEDUP + WALLET FIX ==="

# 1) BACKUP
cp -a "$FRONT" "$FRONT.bak_dedup_$TS"

# 2) SUPPRESSION DU VAULT INJECTÉ (celui du bas)
sed -i '/VAULT_WIDGET_START/,/VAULT_WIDGET_END/d' "$FRONT"

# 3) PATCH DU VAULT EXISTANT (BRANCHEMENT WALLET RÉEL)
sed -i 's/function createVault/function createVault_real/' "$FRONT" 2>/dev/null || true

sed -i '/Créer mon Vault/ i\
<script>\
function getWalletAddress(){\
  return window.walletAddress || window.walletPubkey || window.publicKey || null;\
}\
async function createVault(){\
  const addr=getWalletAddress();\
  if(!addr){alert("Wallet non connecté");return;}\
  const r=await fetch("/wolverine/vault/api/create",{\
    method:"POST",\
    headers:{"Content-Type":"application/json"},\
    body:JSON.stringify({owner:addr})\
  });\
  const t=await r.text();\
  try{var j=JSON.parse(t);}catch(e){alert("Erreur vault");console.error(t);return;}\
  document.querySelectorAll("[id*=vault]").forEach(e=>{\
    if(e.id.toLowerCase().includes("addr")) e.textContent=j.vault;\
    if(e.id.toLowerCase().includes("sol")) e.textContent=j.sol;\
  });\
}\
</script>' "$FRONT"

echo "✅ Vault doublon supprimé"
echo "✅ Vault existant branché au wallet réel"
echo "✅ Aucune UI modifiée"
echo
echo "Recharge la page avec CTRL+SHIFT+R"
BASH

chmod +x /root/WOLVERINE_VAULT_DEDUP_FIX.sh
/root/WOLVERINE_VAULT_DEDUP_FIX.sh
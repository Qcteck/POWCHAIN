#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA RSS HARD FIX — WORKER ONLY ==="

# === CONFIG ===
AIA_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$AIA_DIR/index.html"
BACKUP="$AIA_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"
WORKER_URL="https://aiaquila-proxy.fireinners.workers.dev"

# === CHECK DIR ===
if [ ! -d "$AIA_DIR" ]; then
  echo "❌ Dossier introuvable: $AIA_DIR"
  exit 1
fi

# === BACKUP ===
cp "$INDEX" "$BACKUP"
echo "✔ Backup créé: $BACKUP"

# === WRITE CLEAN FRONTEND (JSON ONLY) ===
cat > "$INDEX" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;font-family:system-ui;background:#0b1b3a;color:#fff}
#wrap{padding:20px}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
</style>
</head>
<body>
<div id="wrap">
  <h2>🦅 AIAQUILA — RSS réel</h2>
  <button onclick="load()">Lire les articles</button>
  <pre id="out">En attente…</pre>
</div>

<script>
const WORKER = "%%WORKER_URL%%";

const FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://news.bitcoin.com/feed/"
];

async function load(){
  const out=document.getElementById("out");
  out.textContent="Chargement…\n";
  let total=0;

  for(const url of FEEDS){
    try{
      const r=await fetch(WORKER+"?url="+encodeURIComponent(url));
      if(!r.ok) throw new Error("HTTP "+r.status);
      const j=await r.json();
      if(!Array.isArray(j)) throw new Error("JSON invalide");

      out.textContent+=`\n=== ${url} ===\n`;
      j.slice(0,5).forEach(i=>{
        out.textContent+=`• ${i.title}\n  ${i.link}\n`;
        total++;
      });
    }catch(e){
      out.textContent+=`\n❌ ${url}\n${e.message}\n`;
    }
  }
  out.textContent+=`\nTOTAL: ${total}`;
}
</script>
</body>
</html>
HTML

# Inject worker URL safely
sed -i "s|%%WORKER_URL%%|$WORKER_URL|g" "$INDEX"

# === PERMS ===
chown -R www-data:www-data "$AIA_DIR"
chmod -R 755 "$AIA_DIR"

# === NGINX SAFE RELOAD ===
nginx -t && systemctl reload nginx

# === TEST WORKER DIRECT ===
echo
echo "=== TEST WORKER DIRECT ==="
curl -s "$WORKER_URL?url=https://news.bitcoin.com/feed/" | head -c 300
echo
echo "=== FIN ==="
echo "✔ Frontend JSON ONLY"
echo "✔ PHP éliminé"
echo "✔ Worker Cloudflare utilisé"
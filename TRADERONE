cat >/root/unlock_wolverine_rpc_public.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 1) Find where the 403 JSON is defined (Access forbidden) =="
HITS="$(grep -RIn --binary-files=without-match -E 'Access forbidden|wolverine/rpc' /etc/nginx 2>/dev/null || true)"
echo "$HITS" | head -n 200

echo
echo "== 2) Locate exact file(s) containing 'Access forbidden' =="
FILES="$(echo "$HITS" | awk -F: '/Access forbidden/ {print $1}' | sort -u)"
[ -n "$FILES" ] || { echo "No 'Access forbidden' string found in /etc/nginx. Paste your /wolverine/rpc location block."; exit 1; }
echo "$FILES"

echo
echo "== 3) Backup and patch (remove localhost-only remote_addr check if present) =="
TS="$(date +%Y%m%d_%H%M%S)"
for f in $FILES; do
  echo "--- patching: $f ---"
  cp -a "$f" "$f.bak_$TS"

  # Comment the common blocker: remote_addr != 127.0.0.1 returning 403 JSON
  # (handles variants with spaces and braces on same line)
  sed -i -E \
    's@^[[:space:]]*(if[[:space:]]*\([[:space:]]*\$remote_addr[[:space:]]*!=[[:space:]]*127\.0\.0\.1[[:space:]]*\)[[:space:]]*\{[[:space:]]*return[[:space:]]*403[[:space:]]*.*Access forbidden.*\}[[:space:]]*)@# DISABLED: \1@g' \
    "$f" || true

  # Also comment "allow 127.0.0.1; deny all;" if it exists in that file
  sed -i -E 's@^[[:space:]]*allow[[:space:]]+127\.0\.0\.1;@# DISABLED: allow 127.0.0.1;@g' "$f" || true
  sed -i -E 's@^[[:space:]]*deny[[:space:]]+all;@# DISABLED: deny all;@g' "$f" || true
done

echo
echo "== 4) nginx config test =="
nginx -t

echo
echo "== 5) reload nginx =="
systemctl reload nginx || service nginx reload

echo
echo "== 6) Retest public endpoint (should be 200 now) =="
curl -sk -D- https://fireinners.online/wolverine/rpc \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | head -n 40

echo "DONE ✅"
BASH

chmod +x /root/unlock_wolverine_rpc_public.sh
/root/unlock_wolverine_rpc_public.sh
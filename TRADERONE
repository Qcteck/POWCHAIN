#!/usr/bin/env bash
set -euo pipefail

# -------- CONFIG (front) --------
RPC="https://api.mainnet-beta.solana.com"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
API_START="/wolverine/traderone/api/start"

# -------- find nginx docroot for /wolverine (best effort) --------
export SYSTEMD_PAGER=cat PAGER=cat
NGX="$(nginx -T 2>/dev/null || true)"

DOCROOT=""
# try to detect an "alias" inside location /wolverine
DOCROOT="$(printf "%s\n" "$NGX" | awk '
  BEGIN{inloc=0}
  /location[[:space:]]+\/wolverine\/?[[:space:]]*\{/ {inloc=1}
  inloc && /alias[[:space:]]+/ {
    gsub(/;$/,"",$2); print $2; exit
  }
  inloc && /\}/ {inloc=0}
')"

# if no alias, try to detect "root" (server-level) and then append /wolverine if needed
if [ -z "${DOCROOT:-}" ]; then
  BASE="$(printf "%s\n" "$NGX" | awk '
    /server_name[[:space:]].*fireinners\.online/ {insrv=1}
    insrv && /^[[:space:]]*root[[:space:]]+/ {gsub(/;$/,"",$2); print $2; exit}
    insrv && /^[[:space:]]*server[[:space:]]*\{/ { } 
    insrv && /^[[:space:]]*\}/ {insrv=0}
  ')"
  if [ -n "${BASE:-}" ]; then
    # common patterns: /var/www/html; we want /var/www/html/wolverine
    DOCROOT="${BASE%/}/wolverine"
  fi
fi

# fallbacks
if [ -z "${DOCROOT:-}" ]; then
  if [ -d /var/www/wolverine ]; then DOCROOT="/var/www/wolverine"; fi
fi
if [ -z "${DOCROOT:-}" ]; then
  DOCROOT="/var/www/wolverine"
fi

echo "== Deploy to: $DOCROOT =="

mkdir -p "$DOCROOT"


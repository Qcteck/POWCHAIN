# Include INSIDE server{} only.

location = /wolverine/rpc {
  auth_basic off; allow all;

  add_header Access-Control-Allow-Origin "*" always;
  add_header Access-Control-Allow-Headers "*" always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }

  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_http_version 1.1;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;
}
location = /solana-rpc { return 404; }

  # --- PATCH: avoid upstream WAF rejecting browser/Phantom headers ---
  # Many Solana RPC providers block browser origins / wallet UAs.
  proxy_set_header Origin "";
  proxy_set_header Referer "";
  # If still 403, uncomment next line to force a neutral UA:
  # proxy_set_header User-Agent "curl/8.5.0";
  # --- END PATCH ---

  # CHATGPT_STRIP_ORIGIN (avoid upstream provider blocking browser-like requests)
  proxy_set_header Origin "";
  proxy_set_header Referer "";
  proxy_set_header Sec-Fetch-Site "";
  proxy_set_header Sec-Fetch-Mode "";
  proxy_set_header Sec-Fetch-Dest "";
  proxy_set_header Connection "";
# /wolverine/traderone/api/* -> http://127.0.0.1:8585/api/*

location = /wolverine/traderone/api/health {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:8585;
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:8585;
}

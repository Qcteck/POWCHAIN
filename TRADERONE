#!/bin/bash
set -e

FRONT="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

echo "=== PATCH UI TRANSPARENCE / PARTICULES ==="

cp $FRONT $FRONT.bak.transparency.$(date +%s)

sed -i '/<\/head>/i\
<style>\
:root{--glass-bg:rgba(10,10,20,0.25);--glass-border:rgba(255,255,255,0.18);}\
html,body{background:transparent !important;}\
body{color:#fff;}\
hr{border-color:rgba(255,255,255,0.25);}\
button,input{\
background:rgba(255,255,255,0.15)!important;\
color:#fff!important;\
border:1px solid var(--glass-border)!important;\
backdrop-filter:blur(10px);\
-webkit-backdrop-filter:blur(10px);\
}\
div,section{\
background:var(--glass-bg)!important;\
backdrop-filter:blur(14px);\
-webkit-backdrop-filter:blur(14px);\
border:1px solid var(--glass-border);\
box-shadow:0 0 25px rgba(255,255,255,0.08);\
}\
span{color:#fff;}\
</style>' $FRONT

nginx -t && systemctl reload nginx

echo "✅ UI TRANSPARENTE – PARTICULES VISIBLES"
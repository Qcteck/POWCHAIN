#!/bin/bash
set -e

### CONFIG
APP_NAME="aiaquila"
WEB_ROOT="/var/www/$APP_NAME"
NGINX_SITE="/etc/nginx/sites-available/$APP_NAME"
NGINX_LINK="/etc/nginx/sites-enabled/$APP_NAME"

echo "==[1/6] Installation dépendances minimales =="
apt update -y
apt install -y nginx curl

echo "==[2/6] Création dossier web =="
mkdir -p "$WEB_ROOT"

echo "==[3/6] Déploiement HTML AIAQUILA (RSS + TTS corrigé) =="

cat > "$WEB_ROOT/index.html" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>AIAQUILA / EmberBrain</title>
<style>
body{background:#0b0f14;color:#eaeaea;font-family:Arial;padding:20px}
button{padding:10px;margin:5px;font-size:16px}
#log{white-space:pre-wrap;background:#111;padding:10px;margin-top:10px;height:300px;overflow:auto}
</style>
</head>
<body>

<h1>🦅 AIAQUILA — EmberBrain</h1>
<p>Lecture RSS réelle + voix navigateur</p>

<button onclick="start()">▶️ Lire les articles</button>
<select id="voiceSelect"></select>

<div id="log"></div>

<script>
const RSS_PROXY = "https://aiaquila-proxy.paycashnostory.workers.dev/?url=";

const FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://www.reuters.com/rssFeed/businessNews"
];

const log = msg => {
  document.getElementById("log").textContent += msg + "\n";
};

let voices=[];
speechSynthesis.onvoiceschanged = () => {
  voices = speechSynthesis.getVoices();
  const sel=document.getElementById("voiceSelect");
  sel.innerHTML="";
  voices.forEach((v,i)=>{
    const o=document.createElement("option");
    o.value=i;o.text=v.name;
    sel.appendChild(o);
  });
};

function speak(txt){
  if(!txt) return;
  const u=new SpeechSynthesisUtterance(txt);
  const vsel=document.getElementById("voiceSelect").value;
  if(voices[vsel]) u.voice=voices[vsel];
  speechSynthesis.speak(u);
}

async function fetchFeed(url){
  const res=await fetch(RSS_PROXY+encodeURIComponent(url));
  const xml=await res.text();
  const doc=new DOMParser().parseFromString(xml,"text/xml");

  let entries=[...doc.querySelectorAll("item"),...doc.querySelectorAll("entry")];

  return entries.map(e=>{
    const title=e.querySelector("title")?.textContent?.trim();
    let link=e.querySelector("link")?.getAttribute("href") ||
             e.querySelector("link")?.textContent;
    return title && link ? {title,link} : null;
  }).filter(Boolean);
}

async function start(){
  log("Démarrage lecture RSS…");
  for(const f of FEEDS){
    log("Flux: "+f);
    try{
      const arts=await fetchFeed(f);
      log("Articles détectés: "+arts.length);
      for(const a of arts.slice(0,3)){
        log("▶ "+a.title);
        speak(a.title);
        await new Promise(r=>setTimeout(r,2500));
      }
    }catch(e){
      log("Erreur flux: "+e);
    }
  }
}
</script>
</body>
</html>
HTML

echo "==[4/6] Configuration nginx =="
cat > "$NGINX_SITE" <<EOF
server {
    listen 80;
    server_name _;
    root $WEB_ROOT;
    index index.html;
}
EOF

ln -sf "$NGINX_SITE" "$NGINX_LINK"

echo "==[5/6] Reload nginx =="
nginx -t
systemctl reload nginx

echo "==[6/6] TERMINÉ =="
echo "➡️ Ouvre : http://IP_DU_VPS/$APP_NAME"
echo "➡️ Clique sur « Lire les articles » (interaction requise par le navigateur)"
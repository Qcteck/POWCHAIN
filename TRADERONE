k" href="/">Retour</a><h1>FireInners • Wallet</h1><p>Lecture soldes via Phantom + Solana RPC. Aucun secret, aucune seed, aucun export.</p><div id="row"><button id="btnConnect">Connect</button><button id="btnDisc" disabled>Disconnect</button><button id="btnRefresh" disabled>Refresh</button></div><div id="grid"><div id="card"><h2>Infos</h2><div id="mono">Adresse: <span id="addr">-</span>
RPC active: <span id="rpc">-</span></div></div><div id="vals"><div id="val"><b>SOL</b><span id="sol">-</span></div><div id="val"><b>USDC</b><span id="usdc">-</span></div></div></div><div id="log"></div></div><script src="https://unpkg.com/@solana/web3.js@1.98.0/lib/index.iife.min.js"></script><script>(()=>{const $=s=>document.querySelector(s),log=m=>{const el=$("#log");el.textContent+=(m+(String(m).endsWith("\n")?"":"\n"));el.scrollTop=el.scrollHeight};const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const RPCS=[location.origin+"/solrpc","https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac","https://api.mainnet-beta.solana.com","https://rpc.ankr.com/solana","https://solana-rpc.publicnode.com"];let pub=null,conn=null,activeRpc=null;const fmt=(n,d=6)=>{if(!isFinite(n))return"-";return Number(n).toLocaleString(undefined,{maximumFractionDigits:d})};const sleep=ms=>new Promise(r=>setTimeout(r,ms));async function pickWorkingConn(){let lastErr=null;for(const r of RPCS){try{const c=new solanaWeb3.Connection(r,{commitment:"confirmed"});await c.getLatestBlockhash("confirmed");activeRpc=r;return c}catch(e){lastErr=e;}}throw lastErr||new Error("RPC failover exhausted")}async function readSolUsdc(c){const lam=await c.getBalance(pub,"confirmed");let us=0;try{const resp=await c.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)});for(const it of (resp.value||[])){const ui=it.account?.data?.parsed?.info?.tokenAmount?.uiAmount;us+=Number(ui||0)}}catch(e){throw e}return{sol:lam/1e9,usdc:us}}async function refresh(){if(!pub){log("REFRESH: no wallet");return}$("#sol").textContent="-";$("#usdc").textContent="-";$("#rpc").textContent="-";let last=null;for(let attempt=0;attempt<2;attempt++){try{conn=await pickWorkingConn();$("#rpc").textContent=activeRpc;const r=await readSolUsdc(conn);$("#sol").textContent=fmt(r.sol,6);$("#usdc").textContent=fmt(r.usdc,2);log("REFRESH OK");return}catch(e){last=e;log("REFRESH ERR: "+(e?.message||e));await sleep(350)}}log("USDC ERR: RPC failover exhausted");throw last}async function connect(){try{const ph=window.solana;if(!ph||!ph.isPhantom){log("Phantom introuvable (window.solana absent).");return}const r=await ph.connect();pub=r.publicKey;$("#addr").textContent=pub.toBase58();$("#btnDisc").disabled=false;$("#btnRefresh").disabled=false;log("CONNECTED");await refresh()}catch(e){log("CONNECT ERR: "+(e?.message||e))}}async function disconnect(){try{const ph=window.solana;if(ph&&ph.disconnect)await ph.disconnect()}catch(_){}pub=null;conn=null;activeRpc=null;$("#addr").textContent="-";$("#rpc").textContent="-";$("#sol").textContent="-";$("#usdc").textContent="-";$("#btnDisc").disabled=true;$("#btnRefresh").disabled=true;log("DISCONNECTED")}$("#btnConnect").onclick=connect;$("#btnDisc").onclick=disconnect;$("#btnRefresh").onclick=refresh;log("READY");})();</script></body></html>

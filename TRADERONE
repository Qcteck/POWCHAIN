cat >/tmp/wolverine_remove_buttons.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/opt/fireinners/frontend-react/app/dist"

# try to auto-detect root from nginx vhost
if [ -f "$VHOST" ]; then
  R="$(awk 'BEGIN{r=""} /^[ \t]*root[ \t]+/ {gsub(/;$/,"",$2); if(r=="") r=$2} END{print r}' "$VHOST")"
  [ -n "${R:-}" ] && ROOT="$R"
fi

WOLV="$ROOT/wolverine/index.html"
[ -f "$WOLV" ] || { echo "ERR: introuvable $WOLV"; exit 1; }

ts(){ date +"%Y%m%d-%H%M%S"; }
bk(){ cp -a "$1" "$1.bak.$(ts)" && echo "backup: $1.bak.$(ts)"; }

echo "ROOT=$ROOT"
echo "WOLV=$WOLV"

# use askorupdate if available (safe write), else edit in-place
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  source "$ASKLIB"
  export ASKORUPDATE_ASK=0
  tmp="/tmp/wolverine.index.patched.$$"
  cp -a "$WOLV" "$tmp"
  python3 - "$tmp" <<'PY'
import re,sys
p=sys.argv[1]
s=open(p,"r",encoding="utf-8",errors="ignore").read()

# remove anchors (tiles/buttons) by href
targets=[r'/',r'/dex/',r'/bridge/',r'/explorer/',r'/mining/']
for t in targets:
  # exact "/" only (avoid killing other absolute urls): match href="/" or href="/index.html"
  if t==r'/':
    s=re.sub(r'<a\b[^>]*\bhref=["\']/(?:index\.html)?["\'][^>]*>.*?</a>','',s,flags=re.I|re.S)
    s=re.sub(r'<button\b[^>]*(?:onclick=["\'][^"\']*/(?:index\.html)?[^"\']*["\'])[^>]*>.*?</button>','',s,flags=re.I|re.S)
  else:
    s=re.sub(rf'<a\b[^>]*\bhref=["\']{re.escape(t)}["\'][^>]*>.*?</a>','',s,flags=re.I|re.S)
    # also remove any inline-nav objects containing that href (JS arrays)
    s=re.sub(rf'\{{[^{{}}]*?(?:href|url)\s*:\s*["\']{re.escape(t)}["\'][^{{}}]*?\}}\s*,?','',s,flags=re.I|re.S)

# clean empty wrappers / double separators
s=re.sub(r'\n{3,}','\n\n',s)
s=re.sub(r'>\s+<','><',s)

open(p,"w",encoding="utf-8").write(s)
print("patched:",p)
PY
  bk "$WOLV"
  askorupdate_file "$WOLV" "$tmp"
  rm -f "$tmp" 2>/dev/null || true
else
  bk "$WOLV"
  python3 - "$WOLV" <<'PY'
import re,sys
p=sys.argv[1]
s=open(p,"r",encoding="utf-8",errors="ignore").read()

targets=[r'/',r'/dex/',r'/bridge/',r'/explorer/',r'/mining/']
for t in targets:
  if t==r'/':
    s=re.sub(r'<a\b[^>]*\bhref=["\']/(?:index\.html)?["\'][^>]*>.*?</a>','',s,flags=re.I|re.S)
    s=re.sub(r'<button\b[^>]*(?:onclick=["\'][^"\']*/(?:index\.html)?[^"\']*["\'])[^>]*>.*?</button>','',s,flags=re.I|re.S)
  else:
    s=re.sub(rf'<a\b[^>]*\bhref=["\']{re.escape(t)}["\'][^>]*>.*?</a>','',s,flags=re.I|re.S)
    s=re.sub(rf'\{{[^{{}}]*?(?:href|url)\s*:\s*["\']{re.escape(t)}["\'][^{{}}]*?\}}\s*,?','',s,flags=re.I|re.S)

s=re.sub(r'\n{3,}','\n\n',s)
s=re.sub(r'>\s+<','><',s)

open(p,"w",encoding="utf-8").write(s)
print("patched:",p)
PY
fi

nginx -t
systemctl reload nginx
echo "OK: WOLVERINE cleaned (home/dex/bridge/explorer/mining removed)"
SH
bash /tmp/wolverine_remove_buttons.sh
say "== 5) inject include into vhost (idempotent) =="
MARK=\"# ${SLUG}_AUTOINC\"
if ! grep -qF "$INC" "$VHOST"; then
  python3 - "$VHOST" "$DOMAIN" "$INC" "$MARK" <<'PY'
import re,sys
p,dom,inc,mark=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
s=open(p,'r',encoding='utf-8',errors='ignore').read()
def patch(block):
  if inc in block: return block, False
  if not re.search(r'\blisten\b[^;]*\b443\b', block): return block, False
  if not re.search(r'\bserver_name\b[^;]*\b'+re.escape(dom)+r'\b', block): return block, False
  lines=block.splitlines()
  ins=None
  for i,l in enumerate(lines):
    if re.search(r'\bserver_name\b', l):
      ins=i+1; break
  if ins is None: ins=1
  lines.insert(ins, f\"    {mark}\")
  lines.insert(ins+1, f\"    include {inc};\")
  return \"\\n\".join(lines), True

out=[]; changed=False; pos=0
for m in re.finditer(r'server\\s*\\{', s):
  start=m.start(); out.append(s[pos:start])
  i=start; depth=0
  while i < len(s):
    c=s[i]
    if c=='{': depth+=1
    elif c=='}':
      depth-=1
      if depth==0:
        end=i+1; b=s[start:end]
        nb,ch=patch(b)
        out.append(nb); changed=changed or ch; pos=end
        break
    i+=1
new=\"\".join(out)+s[pos:]
if changed:
  open(p,'w',encoding='utf-8').write(new)
PY
fi


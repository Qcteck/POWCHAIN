bash -lc 'set -euo pipefail;DOMAIN="fireinners.online";VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl";PATHLOC="/_private_sentinel1_/";HTPASS="/etc/nginx/.htpasswd_sentinel";echo "== (1) backup ==";cp -a "$VHOST" "$VHOST.bak.$(date +%Y%m%d-%H%M%S)";echo "== (2) htpasswd tool ==";command -v htpasswd >/dev/null 2>&1||{ apt-get update -y; apt-get install -y apache2-utils; };echo "== (3) create/update htpasswd user sentinel (will prompt, password not echoed) ==";if [ -f "$HTPASS" ];then htpasswd "$HTPASS" sentinel;else htpasswd -c "$HTPASS" sentinel;fi;chmod 640 "$HTPASS";chown root:www-data "$HTPASS" 2>/dev/null||true;echo "== (4) remove any old private_sentinel1 blocks (with/without _) ==";perl -0777 -i -pe "s#\\n\\s*location\\s+\\^~\\s+/_?private_sentinel1_?/\\s*\\{.*?\\n\\s*\\}#\\n#sg" "$VHOST";echo "== (5) inject correct block into SSL server (listen 443) ==";perl -0777 -i -pe "s#(listen\\s+443[^;]*;.*?\\n)(\\s*location\\s+/\\s*\\{)#\$1\\n    location ^~ $PATHLOC {\\n        auth_basic \\\"sentinel\\\";\\n        auth_basic_user_file $HTPASS;\\n        add_header Cache-Control \\\"no-store\\\" always;\\n        proxy_pass http:\\/\\/127.0.0.1:3000\\/;\\n        proxy_http_version 1.1;\\n        proxy_set_header Host \\$host;\\n        proxy_set_header X-Real-IP \\$remote_addr;\\n        proxy_set_header X-Forwarded-For \\$proxy_add_x_forwarded_for;\\n        proxy_set_header X-Forwarded-Proto \\$scheme;\\n    }\\n\\n\$2#s" "$VHOST";echo "== (6) nginx test + reload ==";nginx -t;systemctl reload nginx;echo "== (7) ORIGIN test (bypass Cloudflare) expect 401 ==";IP="$(hostname -I|awk "{print \\$1}")";curl -skI --resolve "$DOMAIN:443:$IP" "https://$DOMAIN$PATHLOC" | head -n 30;echo "== done ==";'
set -euo pipefail
SVC=fireinners-qplus-wasm
echo "== restart policy =="
systemctl show -p Restart -p RestartSec -p StartLimitIntervalSec -p StartLimitBurst -p NRestarts "$SVC"
echo
echo "== last 80 logs (look for auto-restart) =="
journalctl -u "$SVC" -n 80 --no-pager | egrep -i "Scheduled restart job|Starting|Started|Stopped|Failed|killed|segfault|OOM|exit|code=" || true
cat >/root/AIAQUILA_IMMUTABLE_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SNIPPET="/etc/nginx/snippets/aiaquila_locations.conf"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== AIAQUILA IMMUTABLE FIX ==="

### 1) Ensure snippet exists
echo "[1/6] Write snippet"
cat >"$SNIPPET" <<'NGX'
# AIAQUILA RSS API
location /aiaquila/api/rss {
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    proxy_pass https://news.bitcoin.com/feed/;
    proxy_set_header Host news.bitcoin.com;
    proxy_set_header User-Agent "AIAQUILA-RSS";
    proxy_ssl_server_name on;

    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}

# AIAQUILA Health
location /aiaquila/health {
    default_type text/plain;
    return 200 "OK AIAQUILA\n";
}
NGX

### 2) Backup vhost
echo "[2/6] Backup vhost"
cp -a "$VHOST" "$VHOST.backup.$TS"

### 3) Remove immutable flag
echo "[3/6] Remove immutable flag"
chattr -i "$VHOST"

### 4) Inject include if missing
echo "[4/6] Inject include"
grep -q "aiaquila_locations.conf" "$VHOST" || \
sed -i '/server_name fireinners.online;/a\\
    include /etc/nginx/snippets/aiaquila_locations.conf;' "$VHOST"

### 5) Restore immutable flag
echo "[5/6] Restore immutable flag"
chattr +i "$VHOST"

### 6) Test and reload nginx
echo "[6/6] nginx test"
nginx -t
systemctl reload nginx

echo "DONE"
echo "Health : https://fireinners.online/aiaquila/health"
echo "RSS    : https://fireinners.online/aiaquila/api/rss"
BASH

chmod +x /root/AIAQUILA_IMMUTABLE_FIX.sh
/root/AIAQUILA_IMMUTABLE_FIX.sh
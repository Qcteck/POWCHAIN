/*WOLVERINE_START_FORCEBIND_V1*/
(()=>{const W=window;const S=W.solanaWeb3||W.web3||W.solana_web3;const P=W.phantom?.solana||W.solana;const log=(...a)=>console.log("[WOLV]",...a);const setStatus=(t)=>{const el=document.querySelector("#status,#statusLine,[data-status]")||document.querySelector("body");if(el){if(/Status:/i.test(el.textContent||""))el.textContent="Status: "+t;else if(el.id==="status"||el.id==="statusLine")el.textContent="Status: "+t;}log(t);};const findStartBtn=()=>{const all=[...document.querySelectorAll("button,input[type=button],input[type=submit],a")];return all.find(el=>{const tx=(el.textContent||el.value||"").toUpperCase();return tx.includes("START WOLVERINE")||tx.includes("START");});};const findBudgetEl=()=>document.querySelector("#budget")||document.querySelector("input[name=budget]")||[...document.querySelectorAll("input")].find(i=>/budget/i.test((i.id||"")+(i.name||"")+(i.placeholder||"")));const getBudget=()=>{const el=findBudgetEl();const v=parseFloat((el&&el.value||"").toString().replace(",","."));return isFinite(v)?v:0;};const u64le=(n)=>{let x=BigInt(n);const out=new Uint8Array(8);for(let i=0;i<8;i++){out[i]=Number(x&255n);x>>=8n;}return out;};const ata=(owner,mint)=>S.PublicKey.findProgramAddressSync([owner.toBuffer(),new S.PublicKey("'"${TOKEN_PROG}"'").toBuffer(),mint.toBuffer()],new S.PublicKey("'"${ATA_PROG}"'"))[0];const mkTransferIx=(fromAta,toAta,owner,amount)=>{const data=new Uint8Array(9);data[0]=3;data.set(u64le(amount),1);return new S.TransactionInstruction({programId:new S.PublicKey("'"${TOKEN_PROG}"'"),keys:[{pubkey:fromAta,isSigner:false,isWritable:true},{pubkey:toAta,isSigner:false,isWritable:true},{pubkey:owner,isSigner:true,isWritable:false}],data});};const mkCreateAtaIx=(payer,ataAddr,owner,mint)=>new S.TransactionInstruction({programId:new S.PublicKey("'"${ATA_PROG}"'"),keys:[{pubkey:payer,isSigner:true,isWritable:true},{pubkey:ataAddr,isSigner:false,isWritable:true},{pubkey:owner,isSigner:false,isWritable:false},{pubkey:mint,isSigner:false,isWritable:false},{pubkey:S.SystemProgram.programId,isSigner:false,isWritable:false},{pubkey:new S.PublicKey("'"${TOKEN_PROG}"'"),isSigner:false,isWritable:false},{pubkey:S.SYSVAR_RENT_PUBKEY,isSigner:false,isWritable:false}],data:new Uint8Array()});async function ensureConnect(){if(!P)throw new Error("Phantom introuvable");if(!P.isConnected){setStatus("Connect Phantom...");await P.connect({onlyIfTrusted:false});}return new S.PublicKey(P.publicKey.toString());}async function startFlow(){try{if(!S)throw new Error("solanaWeb3 manquant");const owner=await ensureConnect();const budget=getBudget();if(!(budget>0))throw new Error("Budget invalide");setStatus("Prépare TX USDC...");const conn=W.__WOLV_CONN__||(W.__WOLV_CONN__=new S.Connection(W.__RPC__||W.RPC_URL||"https://api.mainnet-beta.solana.com","confirmed"));const mint=new S.PublicKey("'"${USDC_MINT}"'");const bot=new S.PublicKey("'"${BOT_ADDR}"'");const fromAta=ata(owner,mint);const toAta=ata(bot,mint);const ixs=[];const toInfo=await conn.getAccountInfo(toAta);if(!toInfo)ixs.push(mkCreateAtaIx(owner,toAta,bot,mint));const amount=Math.round(budget*1e6);if(!(amount>0))throw new Error("Montant trop petit");ixs.push(mkTransferIx(fromAta,toAta,owner,amount));const {blockhash,lastValidBlockHeight}=await conn.getLatestBlockhash("confirmed");const tx=new S.Transaction({feePayer:owner,blockhash,lastValidBlockHeight});tx.add(...ixs);setStatus("Signature Phantom...");const sig=await P.signAndSendTransaction(tx);setStatus("Envoi... "+(sig.signature||sig).toString().slice(0,8));const txid=(sig.signature||sig).toString();await conn.confirmTransaction({signature:txid,blockhash,lastValidBlockHeight},"confirmed");setStatus("USDC envoyé. Démarrage bot...");try{await fetch("/api/start",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({budgetUSDC:budget,from:owner.toBase58(),txid})});}catch(e){log("api/start fail",e);}setStatus("OK");}catch(e){setStatus("ERR: "+(e&&e.message||e));throw e;}}function bind(){const b=findStartBtn();if(!b){setTimeout(bind,300);return;}b.addEventListener("click",(ev)=>{ev.preventDefault();ev.stopPropagation();ev.stopImmediatePropagation();startFlow();},true);setStatus("READY");}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",bind);else bind();})();
JS
)"

inject(){ f="$1"; grep -q "$MARK" "$f" && return 0
if grep -qi "</body>" "$f"; then
  perl -0777 -pe "s#</body>#<script>\\n$PATCH_JS\\n</script>\\n</body>#i" -i "$f"
else
  printf "\\n<script>\\n%s\\n</script>\\n" "$PATCH_JS" >> "$f"
fi
echo "[PATCH] $f"
}


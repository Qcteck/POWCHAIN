  try{
    if(!TARGET) return res.status(500).json({error:"TARGET_SOLANA_RPC missing"});
    const r=await fetch(TARGET,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(req.body)});
    const txt=await r.text();
    res.status(r.status);
    res.set('content-type', r.headers.get('content-type')||'application/json');
    res.send(txt);
  }catch(e){
    res.status(500).json({error:String(e && e.message ? e.message : e)});
  }
});
const port=Number(process.env.PORT||12713);
app.listen(port,'127.0.0.1',()=>console.log('solrpc-proxy listening',port));

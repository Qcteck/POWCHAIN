bash -lc 'set -euo pipefail;python3 - <<'"'"'PY'"'"'
import os,re,time
DRPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
MARK0="<!-- WOLV_PAY_PATCH_v2 -->"
MARK1="<!-- /WOLV_PAY_PATCH_v2 -->"
JS=f"""
{MARK0}
<script>
(()=>{{
  const $=s=>document.querySelector(s),$$=s=>Array.from(document.querySelectorAll(s));
  const log=(...a)=>console.log("[PAY]",...a);
  const warn=(...a)=>console.warn("[PAY]",...a);
  const err=(...a)=>console.error("[PAY]",...a);

  function byText(tag,txt){{
    txt=(txt||"").toLowerCase();
    for(const el of $$(tag)){{ if((el.textContent||"").toLowerCase().includes(txt)) return el; }}
    return null;
  }}

  function findStartBtn(){{
    return $("#startWolv")||byText("button","start wolverine")||byText("button","start wolv");
  }}

  function findBudgetInput(){{
    let el=$("#budget")||document.querySelector("input[name=budget]")||document.querySelector("input[name=Budget]");
    if(el) return el;
    const start=findStartBtn();
    if(start && start.parentElement){{
      const inp=start.parentElement.querySelector("input,textarea");
      if(inp) return inp;
    }}
    // fallback: premier input "Ex:" ou un input dans la même ligne que START
    for(const i of $$("input,textarea")){{
      const ph=(i.getAttribute("placeholder")||"").toLowerCase();
      if(ph.includes("ex")) return i;
    }}
    const all=$$("input,textarea");
    return all[0] if all else null;
  }}

  function parseTraderOneAddr(){{
    // cherche une ligne "Wallet TraderOne (bot)" puis "Adresse: <base58>"
    const all=$$("body *");
    for(let i=0;i<all.length;i++){{
      const t=(all[i].textContent||"").replace(/\\s+/g," ").trim();
      if(t.toLowerCase().includes("wallet traderone") && t.toLowerCase().includes("(bot)")){{
        // scan suivants
        for(let j=i;j<Math.min(i+40,all.length);j++){{
          const u=(all[j].textContent||"").replace(/\\s+/g," ").trim();
          const m=u.match(/Adresse\\s*:\\s*([1-9A-HJ-NP-Za-km-z]{{32,44}})/i);
          if(m) return m[1];
        }}
      }}
    }}
    // fallback: toute occurrence "Adresse: <base58>"
    const txt=document.body.innerText||"";
    const m=txt.match(/Adresse\\s*:\\s*([1-9A-HJ-NP-Za-km-z]{{32,44}})/i);
    return m?m[1]:null;
  }}

  async function waitLibs(timeoutMs=15000){{
    const t0=Date.now();
    while(Date.now()-t0<timeoutMs){{
      const ok=!!(window.solana && window.solana.isPhantom && window.solana.publicKey && window.solana.publicKey.toBase58)
             && !!(window.solanaWeb3 && window.solanaWeb3.Connection && window.solanaWeb3.PublicKey)
             && !!(window.splToken && (window.splToken.getAssociatedTokenAddress || window.splToken.getAssociatedTokenAddressSync));
      if(ok) return true;
      await new Promise(r=>setTimeout(r,200));
    }}
    return false;
  }}

  function ensureUI(){{
    const start=findStartBtn();
    if(!start){{ warn("START introuvable (il sera masqué/jamais affiché tant que PAY pas fait)."); return; }}

    // On masque START tant que pas payé
    start.style.display="none";
    start.disabled=true;

    // Ligne UI (asset + payer)
    const row=start.parentElement||document.body;
    if(!$("#assetSelect")){{
      const sel=document.createElement("select");
      sel.id="assetSelect";
      sel.innerHTML="<option value=\\"SOL\\">SOL</option><option value=\\"USDC\\">USDC</option>";
      sel.style.marginLeft="8px";
      row.appendChild(sel);
    }}
    if(!$("#payBtn")){{
      const pay=document.createElement("button");
      pay.type="button";
      pay.id="payBtn";
      pay.textContent="PAYER (Phantom)";
      pay.style.marginLeft="8px";
      row.appendChild(pay);
    }}
  }}

  async function paySOL(amountSol,toAddr){{
    const web3=window.solanaWeb3;
    const w=window.solana;
    const conn=new web3.Connection(DRPC,"confirmed");
    const to=new web3.PublicKey(toAddr);
    const from=w.publicKey;
    const lamports=Math.round(amountSol*1e9);
    const tx=new web3.Transaction().add(web3.SystemProgram.transfer({{fromPubkey:from,toPubkey:to,lamports}}));
    const bh=await conn.getLatestBlockhash("confirmed");
    tx.feePayer=from; tx.recentBlockhash=bh.blockhash;
    let sig=null;
    if(w.signAndSendTransaction){{
      const r=await w.signAndSendTransaction(tx);
      sig=r.signature||r;
    }} else {{
      const signed=await w.signTransaction(tx);
      sig=await conn.sendRawTransaction(signed.serialize(),{{skipPreflight:false,maxRetries:3}});
    }}
    await conn.confirmTransaction({{signature:sig,blockhash:bh.blockhash,lastValidBlockHeight:bh.lastValidBlockHeight}},"confirmed");
    return sig;
  }}

  async function payUSDC(amount,toAddr){{
    const web3=window.solanaWeb3;
    const spl=window.splToken;
    const w=window.solana;
    const conn=new web3.Connection(DRPC,"confirmed");
    const USDC_MINT=new web3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v");
    const from=w.publicKey;
    const to=new web3.PublicKey(toAddr);

    const getATA = spl.getAssociatedTokenAddressSync || spl.getAssociatedTokenAddress;
    const fromATA = await getATA(USDC_MINT, from, false, spl.TOKEN_PROGRAM_ID, spl.ASSOCIATED_TOKEN_PROGRAM_ID);
    const toATA   = await getATA(USDC_MINT, to,   false, spl.TOKEN_PROGRAM_ID, spl.ASSOCIATED_TOKEN_PROGRAM_ID);

    const ixs=[];
    // créer ATA destination si absent
    const toInfo=await conn.getAccountInfo(toATA).catch(()=>null);
    if(!toInfo){{
      const mk = spl.createAssociatedTokenAccountInstruction(from,toATA,to,USDC_MINT,spl.TOKEN_PROGRAM_ID,spl.ASSOCIATED_TOKEN_PROGRAM_ID);
      ixs.push(mk);
    }}
    const units=Math.round(amount*1e6); // USDC 6 decimals
    ixs.push(spl.createTransferInstruction(fromATA,toATA,from,units,[],spl.TOKEN_PROGRAM_ID));

    const tx=new web3.Transaction();
    for(const ix of ixs) tx.add(ix);
    const bh=await conn.getLatestBlockhash("confirmed");
    tx.feePayer=from; tx.recentBlockhash=bh.blockhash;

    let sig=null;
    if(w.signAndSendTransaction){{
      const r=await w.signAndSendTransaction(tx);
      sig=r.signature||r;
    }} else {{
      const signed=await w.signTransaction(tx);
      sig=await conn.sendRawTransaction(signed.serialize(),{{skipPreflight:false,maxRetries:3}});
    }}
    await conn.confirmTransaction({{signature:sig,blockhash:bh.blockhash,lastValidBlockHeight:bh.lastValidBlockHeight}},"confirmed");
    return sig;
  }}

  async function onPay(){{
    try{{
      ensureUI();
      const ok=await waitLibs(15000);
      if(!ok) throw new Error("Libs Solana pas prêtes (web3/spl/phantom). Recharge la page et assure-toi que Connect est OK.");

      const w=window.solana;
      if(!w || !w.isPhantom) throw new Error("Phantom non détecté.");
      if(!w.publicKey) await w.connect();

      const toAddr=parseTraderOneAddr();
      if(!toAddr) throw new Error("Adresse TraderOne (bot) introuvable dans la page.");

      const inp=findBudgetInput();
      if(!inp) throw new Error("Input budget introuvable.");
      const raw=(inp.value||"").trim().replace(",",".");
      const amt=parseFloat(raw);
      if(!(amt>0)) throw new Error("Budget invalide: "+raw);

      const asset=$("#assetSelect")?$("#assetSelect").value:"SOL";
      log("Pay start",{{asset,amt,toAddr,from:w.publicKey.toBase58()}});

      let sig=null;
      if(asset==="USDC") sig=await payUSDC(amt,toAddr);
      else sig=await paySOL(amt,toAddr);

      log("Paiement OK",sig);

      // déverrouille START
      const start=findStartBtn();
      if(start){{
        start.style.display="";
        start.disabled=false;
      }}
      const pay=$("#payBtn");
      if(pay) pay.textContent="PAYÉ OK";
    }}catch(e){{
      err(e);
      alert("PAY ERROR: "+(e && e.message?e.message:e));
    }}
  }}

  function boot(){{
    ensureUI();
    const pay=$("#payBtn");
    if(pay) pay.addEventListener("click",(ev)=>{{ev.preventDefault();ev.stopPropagation();onPay();}});
  }}

  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",boot);
  else boot();
}})();
</script>
{MARK1}
"""

def patch_file(path):
  try:
    s=open(path,"r",encoding="utf-8",errors="ignore").read()
  except Exception:
    return False
  if "START WOLVERINE" not in s.upper():
    return False

  # retire ancien patch v2 si présent
  if MARK0 in s and MARK1 in s:
    a=s.split(MARK0,1)[0]
    b=s.split(MARK1,1)[1]
    s=a+b

  # insère avant </body> sinon à la fin
  if re.search(r"</body\\s*>",s,flags=re.I):
    s=re.sub(r"</body\\s*>",JS+"\\n</body>",s,flags=re.I,count=1)
  else:
    s=s+"\\n"+JS+"\\n"

  open(path,"w",encoding="utf-8").write(s)
  return True

roots=["/opt","/var/www","/srv","/root","/home"]
patched=[]
for base in roots:
  for r,ds,fs in os.walk(base):
    # speed: skip huge dirs
    bn=os.path.basename(r)
    if bn in (".git","node_modules","db",".leveldb","leveldb","logs","cache","dist-old"):
      ds[:] = []
      continue
    for fn in fs:
      if fn.lower()=="index.html":
        p=os.path.join(r,fn)
        if patch_file(p):
          patched.append(p)

print("PATCHED:",len(patched))
for p in patched[:50]:
  print(" -",p)
PY'
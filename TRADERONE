bash -s <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

############################################
# MEGA_WOLVERINE_COMBINED (root, one-shot)
# Combine: "75% batch" + "25% finalizer" => 100% auto-fix loop
#
# CIBLE:
#  - https://fireinners.online/wolverine/
#  - https://fireinners.online/wolverine/traderone/api/health
#
# Mémoire/chemins:
#  - Front live: /var/www/wolverine
#  - Repo: /opt/wolverine
#  - Nginx vhost: /etc/nginx/sites-available/fireinners.online-ssl
#  - Include routes: /etc/nginx/includes/wolverine_routes.inc
#  - Savepoint: /root/WOLVERINE_SAVEPOINT.sh
############################################

TS="$(date +%Y%m%d_%H%M%S)"
export DEBIAN_FRONTEND=noninteractive

log(){ printf "\n[%s] %s\n" "$(date '+%F %T')" "$*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "Run as root."
umask 022

ROOT_WOLV="/var/www/wolverine"
REPO="/opt/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
ASK="/opt/fireinners/sentinel/lib/askorupdate.sh"

RB_DIR="/root/MEGA_WOLVERINE_ROLLBACK_${TS}"
mkdir -p "$RB_DIR"

rollback(){
  log "ROLLBACK triggered (best-effort)"
  if [ -f "$RB_DIR/fireinners.online-ssl.conf" ]; then
    chattr -i "$VHOST" 2>/dev/null || true
    cp -a "$RB_DIR/fireinners.online-ssl.conf" "$VHOST" || true
    chattr +i "$VHOST" 2>/dev/null || true
  fi
  if [ -f "$RB_DIR/wolverine_routes.inc" ]; then
    mkdir -p "$(dirname "$INC")"
    cp -a "$RB_DIR/wolverine_routes.inc" "$INC" || true
  fi
  if [ -d "$RB_DIR/wolverine_www" ]; then
    rm -rf "$ROOT_WOLV" 2>/dev/null || true
    cp -a "$RB_DIR/wolverine_www" "$ROOT_WOLV" || true
  fi
  nginx -t && systemctl reload nginx || true
  log "ROLLBACK done."
}
trap 'rollback; die "Failed at line $LINENO"' ERR

log "0) Preflight"
command -v nginx >/dev/null 2>&1 || die "nginx not found"
command -v git  >/dev/null 2>&1 || die "git not found"
mkdir -p /etc/nginx/includes

# Snapshot for rollback
[ -f "$VHOST" ] && cp -a "$VHOST" "$RB_DIR/fireinners.online-ssl.conf" || true
[ -f "$INC" ] && cp -a "$INC" "$RB_DIR/wolverine_routes.inc" || true
[ -d "$ROOT_WOLV" ] && cp -a "$ROOT_WOLV" "$RB_DIR/wolverine_www" || true

# Optional savepoint
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then
  /root/WOLVERINE_SAVEPOINT.sh "AUTO_BEFORE_MEGA_${TS}" || true
fi

# askorupdate
if [ -f "$ASK" ]; then
  # shellcheck disable=SC1090
  source "$ASK"
  log "askorupdate loaded: $ASK"
else
  log "askorupdate not found; using fallback writers."
  askorupdate_file(){ local SRC="$1" DST="$2"; mkdir -p "$(dirname "$DST")"; cp -a "$DST" "${DST}.bak_${TS}" 2>/dev/null || true; cp -a "$SRC" "$DST"; }
fi

log "1) Ensure Node.js via NodeSource (no apt/npm mixing)"
if ! command -v node >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y ca-certificates curl gnupg
  install -d -m 0755 /etc/apt/keyrings
  curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
  echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list
  apt-get update -y
  apt-get install -y nodejs
fi
node -v >/dev/null
npm -v >/dev/null

log "2) Sync repo /opt/wolverine (best-effort)"
if [ -d "$REPO/.git" ]; then
  ( cd "$REPO" && git fetch --all -p && git reset --hard origin/main ) || true
  ( cd "$REPO" && git log -1 --oneline ) || true
else
  log "Repo not found at $REPO (skip sync)"
fi

log "3) FRONTEND: deploy export if found; else attempt Next build/export; else keep current"
mkdir -p "$ROOT_WOLV"
[ -f "$ROOT_WOLV/index.html" ] && cp -a "$ROOT_WOLV/index.html" "$ROOT_WOLV/index.html.bak_${TS}" || true

detect_export(){
  local found=""
  for CAND in \
    "$REPO/out" "$REPO/dist" "$REPO/frontend/out" "$REPO/frontend/dist" \
    "$REPO/web/out" "$REPO/web/dist" "$REPO/public" "$REPO/site" \
    "$REPO/apps/web/out" "$REPO/apps/web/dist" "$REPO/apps/wolverine/out" "$REPO/apps/wolverine/dist" \
    "$REPO/var_www_wolverine"
  do
    if [ -d "$CAND" ] && [ -f "$CAND/index.html" ]; then found="$CAND"; break; fi
  done
  echo "$found"
}

SRC="$(detect_export || true)"

# If no export found, try to build if it looks like Next
if [ -z "${SRC:-}" ] && [ -f "$REPO/package.json" ]; then
  if grep -qi '"next"' "$REPO/package.json" 2>/dev/null || grep -qi "next" "$REPO/package.json" 2>/dev/null; then
    log "Next detected: trying npm install + build + export (best-effort)"
    ( cd "$REPO" && npm ci --silent ) || ( cd "$REPO" && npm i --silent )
    ( cd "$REPO" && npm run build --silent ) || true
    ( cd "$REPO" && npm run export --silent ) || true
    SRC="$(detect_export || true)"
  fi
fi

if [ -n "${SRC:-}" ]; then
  log "Frontend source detected: $SRC"
  STAGE="/var/www/wolverine.__staging_${TS}"
  rm -rf "$STAGE"
  mkdir -p "$STAGE"
  rsync -a --delete "$SRC/." "$STAGE/."
  test -f "$STAGE/index.html" || die "Staging missing index.html"
  mv "$ROOT_WOLV" "/var/www/wolverine.__bak_${TS}" 2>/dev/null || true
  mv "$STAGE" "$ROOT_WOLV"
  log "Frontend promoted. Backup: /var/www/wolverine.__bak_${TS}"
else
  log "No export produced/found; keeping current $ROOT_WOLV as-is."
fi

log "4) VENDOR: ensure local /wolverine/vendor exists (no CDN) (best-effort)"
mkdir -p "$ROOT_WOLV/vendor"
if [ -d "$REPO/vendor" ]; then
  rsync -a "$REPO/vendor/." "$ROOT_WOLV/vendor/." || true
elif [ -d "$REPO/public/vendor" ]; then
  rsync -a "$REPO/public/vendor/." "$ROOT_WOLV/vendor/." || true
fi

if [ -z "$(ls -A "$ROOT_WOLV/vendor" 2>/dev/null || true)" ]; then
  log "Vendor empty: materialize from npm into $ROOT_WOLV/vendor (best-effort)"
  TMP="/tmp/wolv_vendor_${TS}"
  rm -rf "$TMP"
  mkdir -p "$TMP"
  ( cd "$TMP" && npm init -y >/dev/null 2>&1 ) || true
  ( cd "$TMP" && npm i --silent @solana/web3.js @solana/spl-token ) || true
  WEB3_SRC="$(find "$TMP/node_modules/@solana/web3.js" -type f -name "*browser*.js" | head -n 1 || true)"
  [ -z "${WEB3_SRC:-}" ] && WEB3_SRC="$(find "$TMP/node_modules/@solana/web3.js" -type f -name "index*.js" | head -n 1 || true)"
  SPL_SRC="$(find "$TMP/node_modules/@solana/spl-token" -type f -name "index*.js" | head -n 1 || true)"
  [ -n "${WEB3_SRC:-}" ] && cp -a "$WEB3_SRC" "$ROOT_WOLV/vendor/solana-web3.min.js" || true
  [ -n "${SPL_SRC:-}" ] && cp -a "$SPL_SRC" "$ROOT_WOLV/vendor/spl-token.min.js" || true
  rm -rf "$TMP" || true
fi

log "5) BACKEND: ensure API up (no 502). If 3000 taken, auto-pick a free port."
pick_port(){ local p; for p in 3000 3001 3010 3200 3333; do if ! ss -ltn "( sport = :$p )" | grep -q ":$p"; then echo "$p"; return 0; fi; done; echo "0"; }
is_ours(){ local port="$1"; curl -fsS "http://127.0.0.1:${port}/health" 2>/dev/null | grep -q '"service":"traderone-api"'; }

PORT="3000"
if ss -ltn "( sport = :3000 )" | grep -q ":3000"; then
  if is_ours 3000; then
    PORT="3000"
    log "Port 3000 already running traderone-api (ours)."
  else
    PORT="$(pick_port)"
    [ "$PORT" != "0" ] || die "No free port for API."
    log "Port 3000 busy by other service; using free port: $PORT"
  fi
else
  PORT="3000"
fi

# Try detect real backend location (best-effort only, no destructive changes)
REAL_BACKEND=""
for C in /opt/traderone /opt/traderone-opt /opt/traderone-vault /opt/wolverine/traderone /root/traderone; do
  if [ -f "$C/server.js" ] || [ -f "$C/index.js" ] || [ -f "$C/app.js" ]; then REAL_BACKEND="$C"; break; fi
done

mkdir -p /opt/traderone/api
cat > "/tmp/traderone_api_server_${TS}.js" <<JS
const express=require("express");
const app=express();
app.use(express.json({limit:"2mb"}));
app.use((req,res,next)=>{res.setHeader("Access-Control-Allow-Origin","*");res.setHeader("Access-Control-Allow-Headers","content-type");res.setHeader("Access-Control-Allow-Methods","GET,POST,OPTIONS");if(req.method==="OPTIONS")return res.sendStatus(204);next();});
const REAL_BACKEND=${REAL_BACKEND:+"${REAL_BACKEND}"}${REAL_BACKEND:+";"}${REAL_BACKEND:+" "}null;
app.get("/health",(req,res)=>res.json({ok:true,service:"traderone-api",port:${PORT},ts:Date.now(),real_backend:REAL_BACKEND||null}));
app.get("/status",(req,res)=>res.json({ok:true,mode:REAL_BACKEND?"WRAPPER_READY":"SAFE_STUB",ts:Date.now(),real_backend:REAL_BACKEND||null}));
app.get("/invested",(req,res)=>res.json({ok:true,pub:req.query.pub||null,invested_usdc:0,ts:Date.now()}));
app.post("/start",(req,res)=>res.json({ok:true,action:"start",received:req.body||{},ts:Date.now()}));
app.post("/traderone/mode",(req,res)=>res.json({ok:true,action:"mode",received:req.body||{},ts:Date.now()}));
app.post("/traderone/withdraw",(req,res)=>res.json({ok:true,action:"withdraw",received:req.body||{},ts:Date.now()}));
app.listen(${PORT},"127.0.0.1",()=>console.log("TraderOne API listening on 127.0.0.1:${PORT}"));
JS

cat > "/tmp/traderone_api_pkg_${TS}.json" <<'JSON'
{"name":"traderone-api","version":"1.0.0","private":true,"type":"commonjs","main":"server.js","scripts":{"start":"node server.js"},"dependencies":{"express":"^4.19.2"}}
JSON

askorupdate_file "/tmp/traderone_api_server_${TS}.js" "/opt/traderone/api/server.js"
askorupdate_file "/tmp/traderone_api_pkg_${TS}.json" "/opt/traderone/api/package.json"
( cd /opt/traderone/api && npm i --silent )
cat > "/tmp/traderone-api_${TS}.service" <<SVC
[Unit]
Description=TraderOne API (WOLVERINE)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/traderone/api
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/traderone/api/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
SVC
askorupdate_file "/tmp/traderone-api_${TS}.service" "/etc/systemd/system/traderone-api.service"
systemctl daemon-reload
systemctl enable --now traderone-api.service
sleep 0.5
curl -fsS "http://127.0.0.1:${PORT}/health" >/dev/null

log "6) NGINX: generate routes include with correct PORT, force include at TOP of server{} (fix conflicts)"
cat > "/tmp/wolverine_routes_${TS}.inc" <<NG
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:${PORT}/;
}
location ^~ /wolverine/ {
  root /var/www;
  try_files \$uri \$uri/ /wolverine/index.html;
}
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }
NG
askorupdate_file "/tmp/wolverine_routes_${TS}.inc" "$INC"

test -f "$VHOST" || die "Missing vhost: $VHOST"
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$VHOST" 2>/dev/null || true

python3 - <<PY
from pathlib import Path
p=Path("$VHOST")
s=p.read_text(errors="ignore").splitlines()
inc='include /etc/nginx/includes/wolverine_routes.inc;'
out=[]
server_opened=False
for line in s:
    if inc in line:
        continue
    out.append(line)
    if (not server_opened) and ("server" in line) and ("{" in line):
        server_opened=True
        out.append("  "+inc)
p.write_text("\n".join(out)+("\n" if out else ""))
PY

nginx -t
systemctl reload nginx
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$VHOST" 2>/dev/null || true

log "7) Validation (local + TLS loopback)"
echo "== API local =="
curl -fsS "http://127.0.0.1:${PORT}/health" | head -c 600; echo
echo "== NGINX loopback TLS =="
curl -k -fsS "https://127.0.0.1/wolverine/traderone/api/health" | head -c 600; echo
curl -k -I "https://127.0.0.1/wolverine/" | sed -n '1,15p' || true

log "8) Output"
echo "OK: Front => $ROOT_WOLV"
echo "OK: API   => 127.0.0.1:${PORT} (systemd traderone-api.service)"
echo "OK: Nginx => include forced at top of $VHOST"
echo "URLs:"
echo " - https://fireinners.online/wolverine/"
echo " - https://fireinners.online/wolverine/traderone/api/health"
echo "Rollback snapshot: $RB_DIR"
log "DONE."
BASH
cat >/tmp/EAGLE_EYE_VPS_REPORT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

hr(){ echo; echo "==================== $* ===================="; }
cmd(){ echo; echo "+ $*"; eval "$@" || true; }

hr "SYSTEM"
cmd "date"
cmd "hostname"
cmd "uptime"
cmd "whoami"
cmd "uname -a"
cmd "df -hT | sed -n '1,15p'"
cmd "free -h"
cmd "ulimit -n"

hr "NETWORK / PORTS"
cmd "ip -br a"
cmd "ss -lntp | sed -n '1,120p'"
cmd "ss -lntp | grep -E ':(80|443|8585)\\b' || true"
cmd "ss -lnup | sed -n '1,60p'"

hr "TRADERONE SERVICE"
cmd "systemctl status traderone.service --no-pager -n 60"
cmd "systemctl is-enabled traderone.service || true"
cmd "journalctl -u traderone.service -n 80 --no-pager"
cmd "ps aux | grep -E '[n]ode|traderone' | sed -n '1,20p'"

hr "LOCAL ENDPOINTS (127.0.0.1)"
cmd "curl -sS --max-time 5 http://127.0.0.1:8585/ | head -c 200; echo"
cmd "curl -sS --max-time 5 http://127.0.0.1:8585/health | head -c 200; echo"
cmd "curl -sS --max-time 5 http://127.0.0.1:8585/api/status | head -c 200; echo"
cmd "curl -sS --max-time 5 http://127.0.0.1:8585/api/health | head -c 200; echo"

hr "NGINX STATUS + ERRORS"
cmd "nginx -v"
cmd "nginx -t"
cmd "systemctl status nginx --no-pager -n 40"
cmd "tail -n 80 /var/log/nginx/error.log 2>/dev/null || true"

hr "NGINX ACTIVE CONFIG (search traderone/wolverine)"
cmd "nginx -T 2>/dev/null | grep -nE 'server_name|listen 443|wolverine/traderone|TRADERONE_|wolverine_static_tryfiles' | head -n 220"

hr "FILES (snippets + vhost)"
cmd "ls -la /etc/nginx/sites-available | sed -n '1,80p'"
cmd "ls -la /etc/nginx/snippets | grep -E 'wolverine|traderone' || true"
cmd "echo '--- /etc/nginx/snippets/wolverine_traderone_backend.conf ---'; sed -n '1,220p' /etc/nginx/snippets/wolverine_traderone_backend.conf 2>/dev/null || echo 'MISSING'"
cmd "echo '--- /etc/nginx/sites-available/fireinners.online-ssl ---'; sed -n '1,260p' /etc/nginx/sites-available/fireinners.online-ssl 2>/dev/null || echo 'MISSING'"

hr "PUBLIC HTTPS TESTS"
cmd "curl -kIs --max-time 8 https://fireinners.online/ | head -n 8"
cmd "curl -kIs --max-time 8 https://fireinners.online/wolverine/ | head -n 12"
cmd "curl -ksS --max-time 8 https://fireinners.online/wolverine/ | head -c 120; echo"
cmd "curl -kIs --max-time 8 https://fireinners.online/wolverine/traderone/ | head -n 12"
cmd "curl -ksS --max-time 8 https://fireinners.online/wolverine/traderone/ | head -c 120; echo"
cmd "curl -kIs --max-time 8 https://fireinners.online/wolverine/traderone/api/status | head -n 12"
cmd "curl -ksS --max-time 8 https://fireinners.online/wolverine/traderone/api/status | head -c 200; echo"

hr "WOLVERINE INDEX + OVERLAY FILE CHECK"
WOLVDIR="/opt/fireinners/frontend-react/app/dist/wolverine"
cmd "ls -la $WOLVDIR | sed -n '1,80p'"
cmd "test -f $WOLVDIR/index.html && echo '--- index.html (head) ---' && sed -n '1,40p' $WOLVDIR/index.html || echo 'NO index.html'"
cmd "test -f $WOLVDIR/traderone_overlay.js && echo '--- traderone_overlay.js (head) ---' && sed -n '1,25p' $WOLVDIR/traderone_overlay.js || echo 'NO traderone_overlay.js'"

hr "DONE"
SH

bash /tmp/EAGLE_EYE_VPS_REPORT.sh
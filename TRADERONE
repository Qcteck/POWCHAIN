cat >/root/move_rpc_under_wolverine_path.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
SSL="/etc/nginx/sites-available/fireinners.online-ssl"
JS="/var/www/wolverine/phantom_patch.js"
ts="$(date +%Y%m%d_%H%M%S)"

cp -a "$SNIP" "${SNIP}.bak_${ts}" 2>/dev/null || true
cp -a "$SSL"  "${SSL}.bak_${ts}" 2>/dev/null || true
cp -a "$JS"   "${JS}.bak_${ts}" 2>/dev/null || true

echo "== 1) Nginx: expose RPC under /wolverine/rpc (and keep old ones optional) =="
cat >"$SNIP" <<'NGINX'
# Include INSIDE server{} only.

# MAIN endpoint (less likely to be blocked by WAF)
location = /wolverine/rpc {
  auth_basic off;
  allow all;

  add_header Access-Control-Allow-Origin * always;
  add_header Access-Control-Allow-Headers * always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }

  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;
}

# Optional legacy paths (may still be blocked externally)
location = /srpc { return 404; }
location = /solana-rpc { return 404; }
NGINX

echo "== 2) Patch JS to use /wolverine/rpc =="
if [[ -f "$JS" ]]; then
  sed -i 's@/solana-rpc@/wolverine/rpc@g' "$JS" || true
  sed -i 's@/srpc@/wolverine/rpc@g' "$JS" || true
  sed -i 's@const RPC = "/wolverine/rpc"@const RPC = "/wolverine/rpc"@g' "$JS" || true
fi

echo "== 3) Ensure phantom_patch.js is not cached =="
# remove any existing block then add a clean one
perl -0777 -i -pe 's@\n\s*location\s*=\s*/wolverine/phantom_patch\.js\s*\{.*?\}\s*\n@\n@sg' "$SSL"
perl -0777 -i -pe 's@\n\}\s*$@\n  location = /wolverine/phantom_patch.js {\n    add_header Cache-Control "no-store" always;\n    try_files \\$uri =404;\n  }\n}\n@sg' "$SSL"

echo "== 4) nginx test + reload =="
nginx -t
systemctl reload nginx

echo
echo "== 5) Public test /wolverine/rpc (should be 200) =="
curl -sk -i "https://${DOMAIN}/wolverine/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,18p'

echo
echo "Open: https://${DOMAIN}/wolverine/?v=$ts"
BASH

chmod +x /root/move_rpc_under_wolverine_path.sh
/root/move_rpc_under_wolverine_path.sh
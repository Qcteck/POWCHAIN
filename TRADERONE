set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "=== 0) Backup KEEP ==="
cp -a "$KEEP" "$KEEP.bak.$TS" || true

echo "=== 1) Liste des confs candidates (server_name fireinners + listen 443) ==="
mapfile -t CAND < <(
  nginx -T 2>/dev/null | awk '
    /^# configuration file /{f=$4}
    /server_name[[:space:]]+.*(fireinners\.online|www\.fireinners\.online)/{print f}
  ' | sort -u | while read -r f; do
    [ -f "$f" ] || continue
    grep -qE 'listen[[:space:]]+443' "$f" && echo "$f"
  done
)

printf ' - %s\n' "${CAND[@]:-<none>}"

echo "=== 2) Désactive tout SAUF KEEP ==="
for f in "${CAND[@]:-}"; do
  [ "$f" = "$KEEP" ] && continue

  cp -a "$f" "$f.bak.conflict.$TS" || true

  if [ -L "$f" ]; then
    mv "$f" "$f.disabled.$TS"
    echo "Disabled symlink: $f"
  else
    sed -i -E "s/server_name[[:space:]]+.*(fireinners\.online|www\.fireinners\.online)[^;]*;/server_name _disabled_fireinners_${TS}.local;/g" "$f"
    echo "Neutralized server_name in: $f"
  fi
done

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 4) Conflicts restants (doit être vide) ==="
nginx -T 2>/dev/null | grep -i "conflicting server name" | head -n 30 || echo "✅ no more conflicts"

echo "=== 5) Retest origin bypass (doit être 200) ==="
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | head -n 25
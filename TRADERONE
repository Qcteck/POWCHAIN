bash -lc 'set -euo pipefail;
V="/etc/nginx/sites-available/fireinners.online-ssl";
echo "== nginx -t (etat actuel) ==";
nginx -t || true;

echo "== dernier backup dispo ==";
BK="$(ls -1t ${V}.bak.* 2>/dev/null | head -n1 || true)";
echo "${BK:-<aucun>}";

if ! nginx -t >/dev/null 2>&1; then
  if [ -n "${BK:-}" ] && [ -f "$BK" ]; then
    echo "== RESTORE backup -> $V ==";
    cp -a "$BK" "$V";
  else
    echo "Pas de backup trouve. Stop.";
    exit 1;
  fi
fi

echo "== nginx -t apres restore ==";
nginx -t
echo "OK"'
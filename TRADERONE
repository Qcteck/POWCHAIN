PROXY_JS="$PROXY_DIR/server.js"
PROXY_PORT="12703"
PROXY_HOST="127.0.0.1"
SERVICE="fireinners-solrpc-proxy.service"

TS="$(date +%Y%m%d_%H%M%S)"
BKP="/root/backup_fireinners_walletforce_${TS}"

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}}

location ^~ /wolverine/vault/api {{
  proxy_pass http://127.0.0.1:{${"VAULT_PORT"}};
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}}
"""
# Python f-string above is literal-ish; fix ports:
append = append.replace("{${\"SOLRPC_PORT\"}}", "${SOLRPC_PORT}").replace("{${\"VAULT_PORT\"}}", "${VAULT_PORT}")

if "WOLVERINE canonical proxies (AQUILA)" not in s:
  s = s.rstrip() + "\n" + append + "\n"
else:
  # si marker existe, on append quand même (safe) après suppression des anciens blocs

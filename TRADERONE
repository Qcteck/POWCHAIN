#!/bin/bash
set -e

FRONT="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

echo "=== PATCH UI : PARTICULES + CENTRAGE + COULEURS ==="

cp $FRONT $FRONT.bak.fx.$(date +%s)

sed -i '/<\/head>/i\
<style>\
:root{\
--rose:#ff4fd8;\
--turquoise:#2fffdc;\
--violet:#8f5bff;\
--bg-dark:#0b0b14;\
}\
html,body{\
margin:0;height:100%;overflow:hidden;\
background:radial-gradient(circle at 30% 20%,rgba(255,79,216,0.35),transparent 50%),\
radial-gradient(circle at 70% 60%,rgba(47,255,220,0.35),transparent 55%),\
radial-gradient(circle at 50% 90%,rgba(143,91,255,0.45),transparent 60%),\
var(--bg-dark);\
}\
body{display:flex;align-items:center;justify-content:center;}\
\
/* PARTICULES */\
#particles{\
position:fixed;inset:0;z-index:0;pointer-events:none;\
filter:drop-shadow(0 0 6px rgba(255,255,255,0.35));\
}\
\
/* CONSOLE CENTRALE */\
#app,main,section,div:first-child{\
position:relative;z-index:2;\
max-width:520px;width:100%;\
padding:26px;text-align:center;\
background:rgba(15,15,25,0.35);\
backdrop-filter:blur(18px);\
border-radius:18px;\
border:2px solid rgba(255,255,255,0.45);\
box-shadow:0 0 40px rgba(255,79,216,0.25);\
}\
\
/* TEXTE */\
h1,h2,h3,p,span,label{\
color:#fff;\
text-shadow:0 2px 6px rgba(0,0,0,0.8);\
}\
\
/* INPUTS */\
input{\
width:100%;padding:12px;\
background:rgba(255,255,255,0.15);\
color:#fff;border-radius:12px;\
border:2px solid var(--turquoise);\
outline:none;\
}\
\
/* BOUTONS */\
button{\
margin:8px;padding:10px 18px;\
background:linear-gradient(135deg,var(--rose),var(--violet));\
color:#fff;border:none;border-radius:14px;\
box-shadow:0 0 14px rgba(255,79,216,0.6);\
cursor:pointer;\
}\
button:hover{filter:brightness(1.15);}\
\
/* BANNIERE PARTAGE */\
#sharebar{\
position:fixed;bottom:16px;left:50%;transform:translateX(-50%);\
z-index:3;display:flex;gap:14px;\
background:rgba(0,0,0,0.4);\
padding:10px 16px;border-radius:20px;\
backdrop-filter:blur(10px);\
border:1px solid rgba(255,255,255,0.4);\
}\
#sharebar a{color:#fff;font-size:18px;text-decoration:none;}\
</style>' $FRONT

sed -i '/<\/body>/i\
<canvas id="particles"></canvas>\
<div id="sharebar">\
<a href="#">𝕏</a>\
<a href="#">📘</a>\
<a href="#">📨</a>\
</div>\
<script>\
const c=document.getElementById("particles"),x=c.getContext("2d");\
let w,h,p=[];function R(){w=c.width=innerWidth;h=c.height=innerHeight;}\
addEventListener("resize",R);R();\
for(let i=0;i<120;i++)p.push({x:Math.random()*w,y:Math.random()*h,v:0.2+Math.random(),r:1+Math.random()*2});\
function A(){x.clearRect(0,0,w,h);\
p.forEach(o=>{o.y-=o.v;if(o.y<0)o.y=h;\
x.fillStyle="rgba(255,255,255,0.85)";\
x.beginPath();x.arc(o.x,o.y,o.r,0,7);x.fill();});\
requestAnimationFrame(A);}A();\
</script>' $FRONT

nginx -t && systemctl reload nginx
echo "✅ PARTICULES + CENTRAGE + COULEURS OK"
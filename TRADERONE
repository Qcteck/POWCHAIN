set -euo pipefail
echo "[A] DNS (voir si IPv6 existe)"
getent ahosts fireinners.online | head -n 10 || true

echo "[B] UFW avant"
ufw status numbered || true

echo "[C] Supprime TOUTE regle UFW qui contient 3000/tcp ou 8484/tcp (ALLOW ou DENY), en partant du bas"
mapfile -t nums < <(ufw status numbered | awk '/3000\/tcp|8484\/tcp/ {gsub(/\[|\]/,"",$1); print $1}' | sort -rn)
for n in "${nums[@]}"; do
  echo "Deleting rule #$n"
  yes y | ufw delete "$n" >/dev/null
done

echo "[D] Remet DENY (v4+v6 geres par UFW)"
ufw deny in 3000/tcp
ufw deny in 8484/tcp

echo "[E] UFW apres"
ufw status numbered | egrep '3000|8484|443|22|51820' || true

echo "[F] Tests depuis le VPS (v4/v6) : ca DOIT echouer (timeout/refused)"
curl -4 -m 3 -I http://fireinners.online:3000 | head -n 1 || echo "OK: v4 3000 bloque"
curl -4 -m 3 -I http://fireinners.online:8484 | head -n 1 || echo "OK: v4 8484 bloque"
curl -6 -m 3 -I http://fireinners.online:3000 | head -n 1 || echo "OK: v6 3000 bloque"
curl -6 -m 3 -I http://fireinners.online:8484 | head -n 1 || echo "OK: v6 8484 bloque"
echo "DONE UFW"




PID3000="$(ss -lntp | sed -n 's/.*:3000 .*pid=\([0-9]\+\).*/\1/p' | head -n1)"
PID8484="$(ss -lntp | sed -n 's/.*:8484 .*pid=\([0-9]\+\).*/\1/p' | head -n1)"
echo "PID3000=$PID3000 PID8484=$PID8484"
ps -p "$PID3000" -o pid,cmd --no-headers || true
ps -p "$PID8484" -o pid,cmd --no-headers || true
readlink -f /proc/"$PID3000"/cwd || true
readlink -f /proc/"$PID8484"/cwd || true



set -euo pipefail
BK="/root/beton_bind_$(date +%Y%m%d-%H%M%S)"; mkdir -p "$BK"
echo "Backup: $BK"

for PORT in 3000 8484; do
  echo "== PORT $PORT =="
  # on cherche dans /root et /opt (tes cas typiques)
  mapfile -t files < <(grep -RIn --include='*.js' -E "\.listen\([[:space:]]*${PORT}([[:space:]]*,|\))" /root /opt 2>/dev/null | awk -F: '{print $1}' | sort -u | head -n 50 || true)
  if [ "${#files[@]}" -eq 0 ]; then
    echo "Aucun fichier .js trouve avec listen($PORT) dans /root ou /opt"
    continue
  fi
  for f in "${files[@]}"; do
    [ -f "$f" ] || continue
    cp -a "$f" "$BK/$(basename "$f").bak.$PORT" 2>/dev/null || true

    # Patch:
    # .listen(PORT) => .listen(PORT,"127.0.0.1")
    # .listen(PORT, X) => .listen(PORT,"127.0.0.1", X) (si pas deja 127.0.0.1)
    perl -0777 -i -pe '
      s/\.listen\(\s*'"$PORT"'\s*\)/.listen('"$PORT"',"127.0.0.1")/g;
      s/\.listen\(\s*'"$PORT"'\s*,\s*(?!\s*"127\.0\.0\.1")/\.listen('"$PORT"',"127.0.0.1",/g;
      s/\.listen\(\s*'"$PORT"'\s*,\s*["'\'']0\.0\.0\.0["'\'']\s*,/\.listen('"$PORT"',"127.0.0.1",/g;
    ' "$f"

    if grep -q "listen(${PORT}.*127\.0\.0\.1" "$f"; then
      echo "Patche: $f"
    fi
  done
done

echo "Restart services (si presents)"
systemctl restart amcq.service 2>/dev/null || true
systemctl restart fireinners-qplus-wasm.service 2>/dev/null || true

echo "Bind apres restart (on veut 127.0.0.1:3000 et 127.0.0.1:8484, pas 0.0.0.0)"
ss -lntp | egrep ':(3000|8484)\b|:443\b' || true






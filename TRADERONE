#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SSL_VHOST="fireinners.online-ssl"
SITES_AVAILABLE="/etc/nginx/sites-available"
SITES_ENABLED="/etc/nginx/sites-enabled"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX NGINX FIREINNERS (ROOT / SAFE) ==="

# 1) Vérification root
if [ "$EUID" -ne 0 ]; then
  echo "❌ Ce script doit être exécuté en root"
  exit 1
fi

# 2) Vérifier vhost SSL attendu
if [ ! -f "$SITES_AVAILABLE/$SSL_VHOST" ]; then
  echo "❌ Vhost SSL attendu introuvable : $SSL_VHOST"
  exit 1
fi

echo "✔ Vhost SSL trouvé : $SSL_VHOST"

# 3) Backup sites-enabled
mkdir -p /root/nginx_sites_enabled_backup
cp -a "$SITES_ENABLED" "/root/nginx_sites_enabled_backup/backup_$TS"
echo "✔ Backup sites-enabled effectué"

# 4) Désactiver TOUS les vhosts fireinners sauf le SSL officiel
for f in "$SITES_ENABLED"/*; do
  [ -e "$f" ] || continue
  name="$(basename "$f")"

  if echo "$name" | grep -q "fireinners" && [ "$name" != "$SSL_VHOST" ]; then
    rm -f "$f"
    echo "🗑 Désactivé : $name"
  fi
done

# 5) S'assurer que le vhost SSL est activé
ln -sf "$SITES_AVAILABLE/$SSL_VHOST" "$SITES_ENABLED/$SSL_VHOST"
echo "✔ Vhost SSL activé"

# 6) Test NGINX
echo "== nginx -t =="
nginx -t

# 7) Démarrage NGINX (pas reload)
systemctl start nginx

# 8) Vérification finale
systemctl status nginx --no-pager

echo "=== NGINX FIREINNERS OK ==="
echo "➡️ CTRL + F5 navigateur"
cat >/tmp/WOLVERINE_NGINX_PROXY_API_BEFORE_STATIC.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

CONF="/etc/nginx/sites-available/fireinners"
TS="$(date +%s)"
cp -a "$CONF" "$CONF.bak.$TS"
echo "Backup: $CONF.bak.$TS"

# Ajoute un location proxy pour /wolverine/traderone/api/ AVANT le bloc static /wolverine/
if ! grep -q "WOLVERINE_API_PROXY_BEGIN" "$CONF"; then
  awk '
  BEGIN{ins=0}
  {
    # inject juste avant le bloc "location ^~ /wolverine/"
    if(ins==0 && $0 ~ /^[[:space:]]*location[[:space:]]+\^~[[:space:]]+\/wolverine\/[[:space:]]*\{/){
      print "  # WOLVERINE_API_PROXY_BEGIN"
      print "  location ^~ /wolverine/traderone/api/ {"
      print "    proxy_http_version 1.1;"
      print "    proxy_set_header Host $host;"
      print "    proxy_set_header X-Real-IP $remote_addr;"
      print "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
      print "    proxy_set_header X-Forwarded-Proto $scheme;"
      print "    proxy_pass http://127.0.0.1:8585;"
      print "  }"
      print "  # WOLVERINE_API_PROXY_END"
      print ""
      ins=1
    }
    print $0
  }' "$CONF.bak.$TS" > "$CONF"
else
  echo "API proxy block already present -> skip"
fi

nginx -t
systemctl reload nginx

echo
echo "== TEST (doit etre JSON, pas HTML) =="
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
curl -ksS -D- "https://fireinners.online/wolverine/traderone/api/balances2?wallet=$WALLET" | head -c 220; echo
SH

bash /tmp/WOLVERINE_NGINX_PROXY_API_BEFORE_STATIC.sh
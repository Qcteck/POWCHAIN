# --- Vault API (creates/stores real ed25519 keypairs; returns vault pubkey) ---
cat >"$VAULT_DIR/server.js" <<'JS'
const http = require("http");
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");
const nacl = require("tweetnacl");
const bs58 = require("bs58");

const HOST = process.env.HOST || "127.0.0.1";
const PORT = parseInt(process.env.PORT || "12714", 10);

const DB = process.env.DB_FILE || "/var/lib/wolverine-vault/vaults.json";
fs.mkdirSync(path.dirname(DB), { recursive: true });

function loadDB(){
  try { return JSON.parse(fs.readFileSync(DB, "utf8")); } catch { return { version:1, vaults:{} }; }
}
function saveDB(db){
  fs.writeFileSync(DB, JSON.stringify(db, null, 2));
}

function makeVault(){
  const seed = crypto.randomBytes(32);
  const kp = nacl.sign.keyPair.fromSeed(seed);
  const pub58 = bs58.encode(Buffer.from(kp.publicKey));
  const sec58 = bs58.encode(Buffer.from(kp.secretKey)); // 64 bytes
  return { pub58, sec58, createdAt: Date.now() };
}

function send(res, code, obj){
  const body = Buffer.from(JSON.stringify(obj));
  res.writeHead(code, {
    "content-type": "application/json; charset=utf-8",
    "cache-control": "no-store",
    "access-control-allow-origin": "*",
    "access-control-allow-methods": "POST, GET, OPTIONS",
    "access-control-allow-headers": "content-type, authorization"
  });
  res.end(body);
}

function readBody(req){
  return new Promise((resolve)=>{
    let data = "";
    req.on("data", (c)=> data += c);
    req.on("end", ()=> {
      try { resolve(JSON.parse(data || "{}")); } catch { resolve(null); }
    });
  });
}

const server = http.createServer(async (req, res) => {
  if (req.method === "OPTIONS") {
    res.writeHead(204, {
      "access-control-allow-origin": "*",
      "access-control-allow-methods": "POST, GET, OPTIONS",
      "access-control-allow-headers": "content-type, authorization",
      "cache-control": "no-store"
    });
    return res.end();
  }

  const url = (req.url || "/").split("?")[0];

  if (req.method === "GET" && (url === "/" || url === "/health")) {
    return send(res, 200, { ok:true, service:"wolverine-vault-api" });
  }

  if (req.method !== "POST") return send(res, 405, { ok:false, error:"POST required" });

  const body = await readBody(req);
  if (!body) return send(res, 400, { ok:false, error:"invalid json" });

  const userPub = String(body.userPub || body.pub || body.owner || "").trim();
  const amountSol = body.amountSol ?? body.amount ?? null;

  const db = loadDB();
  if (!db.vaults[userPub || "_anon"]) db.vaults[userPub || "_anon"] = makeVault();
  const v = db.vaults[userPub || "_anon"];
  saveDB(db);

  // Compat multi-paths:
  // - /vault/create
  // - /api/vault/create
  // - anything else: still returns vault so UI can proceed
  return send(res, 200, {
    ok: true,
    service: "vault",
    userPub: userPub || null,
    vaultPub: v.pub58,
    amountSol: amountSol,
    note: "Vault created/loaded; store kept server-side."
  });
});

server.listen(PORT, HOST, ()=> {
  console.log(`wolverine-vault-api listening http://${HOST}:${PORT}`);
});
JS


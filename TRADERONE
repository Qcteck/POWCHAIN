set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
DIR="/etc/nginx/snippets/_saved_$TS"
mkdir -p "$DIR"

echo "=== 0) Backup vhost ==="
cp -a "$KEEP" "$KEEP.bak.$TS"

echo "=== 1) Sauver les anciens snippets (sans les inclure) ==="
for f in /etc/nginx/snippets/wolverine_prod.conf \
         /etc/nginx/snippets/wolverine_routes.conf \
         /etc/nginx/snippets/wolverine_auth_phantom.conf; do
  [ -f "$f" ] && cp -a "$f" "$DIR/" && echo "Saved: $f -> $DIR/"
done

echo "=== 2) Ne laisser qu'UN seul include actif (wolverine_final.conf) ==="
sed -i '\|include /etc/nginx/snippets/wolverine_prod\.conf;|d' "$KEEP"
sed -i '\|include /etc/nginx/snippets/wolverine_routes\.conf;|d' "$KEEP"
sed -i '\|include /etc/nginx/snippets/wolverine_auth_phantom\.conf;|d' "$KEEP"

if ! grep -q "snippets/wolverine_final.conf" "$KEEP"; then
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/wolverine_final.conf;/' "$KEEP"
fi

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 4) Vérif includes ==="
grep -n "include /etc/nginx/snippets/wolverine" -n "$KEEP" || true

echo "DONE ✅ anciens snippets gardés ici: $DIR"
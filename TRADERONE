cat > /root/WOLVERINE_FIX_JS_BLOCKERS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/WOLVERINE_FIX_JS_BLOCKERS_${TS}.log"

echo "=== WOLVERINE FIX JS BLOCKERS ===" | tee "$LOG"

test -f "$HTML" || { echo "HTML absent" | tee -a "$LOG"; exit 1; }

cp -a "$HTML" "${HTML}.bak_jsfix_${TS}"
echo "Backup: ${HTML}.bak_jsfix_${TS}" | tee -a "$LOG"

# 1) Neutraliser await hors async
sed -i 's/^\(.*await .*;\)/\/\/ JSFIX_DISABLED \1/g' "$HTML"

# 2) Neutraliser return hors fonction
sed -i 's/^\(.*return .*;\)/\/\/ JSFIX_DISABLED \1/g' "$HTML"

# 3) Neutraliser références acc non définies
sed -i 's/\bacc\b/undefined/g' "$HTML"

# 4) Vérification
grep -n "JSFIX_DISABLED" "$HTML" | tee -a "$LOG" || true

# 5) Reload nginx
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx

echo "=== TERMINÉ ===" | tee -a "$LOG"
echo "ACTION: CTRL + SHIFT + R (OBLIGATOIRE)"
echo "LOG: $LOG"
BASH

chmod +x /root/WOLVERINE_FIX_JS_BLOCKERS.sh
/root/WOLVERINE_FIX_JS_BLOCKERS.sh
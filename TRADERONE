echo "-- quote"
curl -sS "http://127.0.0.1:$API_PORT/api/swap/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50" | head -c 180 || true
echo
echo "-- execute endpoint exists?"
curl -sS -X POST "http://127.0.0.1:$API_PORT/api/swap/execute" -H "content-type: application/json" -d '{}' || true
echo
echo "DONE ✅"
echo "Rollback backend entry:"
echo "  cp -a /root/wolv_backups/backend_entry.$TS.bak $ENTRY"
echo "Rollback swap routes:"
echo "  [ -f /root/wolv_backups/swap.routes.js.$TS.bak ] && cp -a /root/wolv_backups/swap.routes.js.$TS.bak $SWAP"
echo "Rollback frontend hide (if edited):"
echo "  [ -f /root/wolv_backups/index.html.$TS.bak ] && cp -a /root/wolv_backups/index.html.$TS.bak $WEB_DIR/index.html && nginx -t && systemctl reload nginx"
BASH


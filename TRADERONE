cat >/root/MEGA_NDJSON_FIREINNERS_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
export DEBIAN_FRONTEND=noninteractive

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_NDJSON_FIX_${TS}"
mkdir -p "$BK"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }

# --- locate fireinners vhost (authoritative) ---
VH=""
for f in /etc/nginx/sites-available/* /etc/nginx/sites-enabled/*; do
  [ -f "$f" ] || continue
  if grep -qE 'server_name\s+.*fireinners\.online' "$f" 2>/dev/null; then VH="$f"; break; fi
done
[ -n "${VH}" ] || die "Impossible de trouver le vhost fireinners.online dans /etc/nginx/sites-available|enabled"

INC_DIR="/etc/nginx/includes"
INC_FILE="$INC_DIR/ndjson_fireinners.inc"

WWW_UI="/var/www/ndjson"
WWW_DATA="/var/www/ndjson_data"
TEST_ND="$WWW_DATA/events.ndjson"

say "Backup..."
cp -a "$VH" "$BK/$(basename "$VH")" 2>/dev/null || true
cp -a /etc/nginx/nginx.conf "$BK/nginx.conf" 2>/dev/null || true
mkdir -p "$BK/includes"
cp -a "$INC_DIR"/*.inc "$BK/includes/" 2>/dev/null || true
mkdir -p "$BK/www"
cp -a "$WWW_UI" "$BK/www/ndjson" 2>/dev/null || true
cp -a "$WWW_DATA" "$BK/www/ndjson_data" 2>/dev/null || true

say "Unfreeze best-effort (chattr -i)..."
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$VH" 2>/dev/null || true
chattr -i "$INC_DIR"/*.inc 2>/dev/null || true

say "Prepare dirs..."
mkdir -p "$INC_DIR" "$WWW_UI" "$WWW_DATA"
chmod 755 "$WWW_UI" "$WWW_DATA"

say "Write NDJSON test file (append-only friendly)..."
touch "$TEST_ND"
chmod 644 "$TEST_ND"
# ensure at least 1 line
if [ ! -s "$TEST_ND" ]; then
  printf '{"ts":"%s","type":"boot","msg":"ndjson ready","ok":true}\n' "$(date -Is)" >"$TEST_ND"
fi

say "Write NDJSON viewer UI -> $WWW_UI/index.html ..."
cat >"$WWW_UI/index.html" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NDJSON Watcher • Viewer</title><style>html,body{margin:0;padding:0;background:#0b0f14;color:#e7eef7;font:14px/1.35 system-ui,-apple-system,Segoe UI,Roboto,Arial}*{box-sizing:border-box}a{color:#7ec8ff}input,button,select,textarea{background:#111826;color:#e7eef7;border:1px solid #223047;border-radius:10px;padding:10px 12px;outline:none}button{cursor:pointer}button:hover{border-color:#3a7bd5}.wrap{max-width:1200px;margin:0 auto;padding:16px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.card{background:#0f1520;border:1px solid #1e2a3f;border-radius:14px;padding:12px}.grow{flex:1}.kpi{display:flex;gap:10px;flex-wrap:wrap}.k{min-width:160px}.k b{display:block;font-size:18px}.muted{color:#9fb2c9}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.tbl{width:100%;border-collapse:collapse;font-size:12px}.tbl th,.tbl td{border-bottom:1px solid #1d2a40;padding:8px;text-align:left;vertical-align:top}.pill{display:inline-block;padding:2px 8px;border-radius:999px;border:1px solid #2a3c57;background:#0c121c;font-size:12px}.ok{border-color:#2f8f5f}.bad{border-color:#b24a4a}.warn{border-color:#b58b2a}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}.log{max-height:420px;overflow:auto}.small{font-size:12px}.right{margin-left:auto}.sep{height:1px;background:#1d2a40;margin:10px 0}</style></head><body><div class="wrap"><div class="row"><div class="card grow"><div class="row"><div class="grow"><div class="muted small">Source NDJSON</div><div class="row"><input class="grow" id="url" placeholder="URL (ex: /data/events.ndjson)" value="/data/events.ndjson"><button id="load">Charger</button><button id="toggle">Auto: OFF</button><input id="ms" style="width:120px" value="5000" title="Interval ms"><label class="pill"><input type="file" id="file" accept=".ndjson,.log,.txt" style="display:none"><span id="pick" style="cursor:pointer">Fichier…</span></label></div><div class="muted small">Astuce: /ndjson (UI) + /data/events.ndjson (source)</div></div><div class="right"><span id="st" class="pill warn">idle</span></div></div></div></div><div class="sep"></div><div class="grid"><div class="card"><div class="muted small">KPIs</div><div class="kpi" id="kpi"></div></div><div class="card"><div class="muted small">Dernières lignes</div><div class="log"><table class="tbl"><thead><tr><th>#</th><th>ts</th><th>type</th><th>ok</th><th>msg</th><th>raw</th></tr></thead><tbody id="tb"></tbody></table></div></div></div><div class="sep"></div><div class="card"><div class="muted small">Logs</div><div class="log mono" id="log"></div></div></div><script>(()=>{"use strict";const u=$("#url"),bL=$("#load"),bT=$("#toggle"),ms=$("#ms"),f=$("#file"),pick=$("#pick"),st=$("#st"),tb=$("#tb"),kpi=$("#kpi"),lg=$("#log");let timer=null,auto=false,lastHash="";function $(s){return document.querySelector(s)}function esc(s){return String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]))}function setst(t,cls){st.textContent=t;st.className="pill "+(cls||"warn")}function log(line){const d=new Date().toLocaleTimeString("fr-CA",{hour:"2-digit",minute:"2-digit",second:"2-digit"});lg.textContent+=`[${d}] ${line}\n`;lg.scrollTop=lg.scrollHeight}function hash(s){let h=2166136261>>>0;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return (h>>>0).toString(16)}function parseND(txt){const lines=txt.split(/\r?\n/).filter(Boolean);const out=[];let bad=0;for(const line of lines){try{out.push(JSON.parse(line))}catch{bad++}}return {out,lines:lines.length,bad}}function render(arr){tb.innerHTML="";const n=Math.min(arr.length,250);for(let i=Math.max(0,arr.length-n),j=0;i<arr.length;i++,j++){const r=arr[i]||{};const ts=r.ts||r.time||r.date||"";const type=r.type||r.event||"";const ok=(r.ok===true||r.success===true)?"ok":(r.ok===false||r.success===false)?"bad":"warn";const msg=r.msg||r.message||r.note||"";const raw=JSON.stringify(r);const tr=document.createElement("tr");tr.innerHTML=`<td>${arr.length-n+j+1}</td><td class="mono">${esc(ts)}</td><td><span class="pill">${esc(type)}</span></td><td><span class="pill ${ok}">${ok}</span></td><td>${esc(msg)}</td><td class="mono">${esc(raw)}</td>`;tb.appendChild(tr)}const types={};let okc=0,badc=0;for(const r of arr){const t=r.type||r.event||"unknown";types[t]=(types[t]||0)+1;if(r.ok===true||r.success===true)okc++;if(r.ok===false||r.success===false)badc++;}kpi.innerHTML="";kpi.appendChild(k("Lignes",String(arr.length)));kpi.appendChild(k("OK",String(okc)));kpi.appendChild(k("BAD",String(badc)));kpi.appendChild(k("Types",Object.keys(types).length+""));}function k(name,val){const d=document.createElement("div");d.className="k";d.innerHTML=`<div class="muted small">${esc(name)}</div><b>${esc(val)}</b>`;return d}async function fetchUrl(){const url=u.value.trim()||"/data/events.ndjson";setst("loading","warn");try{const r=await fetch(url,{cache:"no-store"});const t=await r.text();if(!r.ok){setst("HTTP "+r.status,"bad");log("HTTP "+r.status+" "+url);return}const h=hash(t);if(h===lastHash){setst("ok (no change)","ok");return}lastHash=h;const p=parseND(t);render(p.out);setst("ok","ok");log("Loaded "+p.lines+" lines ("+p.bad+" bad) from "+url);}catch(e){setst("ERR","bad");log("ERR "+(e?.message||e))}}bL.onclick=fetchUrl;bT.onclick=()=>{auto=!auto;bT.textContent="Auto: "+(auto?"ON":"OFF");if(timer){clearInterval(timer);timer=null}if(auto){const iv=Math.max(500,parseInt(ms.value||"5000",10)||5000);timer=setInterval(fetchUrl,iv);fetchUrl()}};pick.onclick=()=>f.click();f.onchange=async()=>{const file=f.files&&f.files[0];if(!file)return;const txt=await file.text();const p=parseND(txt);render(p.out);setst("file","ok");log("Loaded file "+file.name+" ("+p.lines+" lines, "+p.bad+" bad)")};log("Ready. UI=/ndjson/ | NDJSON=/data/events.ndjson")})();</script></body></html>
HTML
chmod 644 "$WWW_UI/index.html"

say "Write nginx include -> $INC_FILE ..."
cat >"$INC_FILE" <<NGINX
# NDJSON viewer + data alias (fireinners.online)
# UI:   /ndjson/  (and redirect /ndjson -> /ndjson/)
# Data: /data/events.ndjson (and /data/ directory)
location = /ndjson { return 301 /ndjson/; }
location ^~ /ndjson/ {
  alias $WWW_UI/;
  try_files \$uri \$uri/ /ndjson/index.html;
  add_header Cache-Control "no-store" always;
}
location = /data/events.ndjson {
  default_type application/x-ndjson;
  alias $TEST_ND;
  add_header Cache-Control "no-store" always;
}
location ^~ /data/ {
  alias $WWW_DATA/;
  add_header Cache-Control "no-store" always;
}
NGINX
chmod 644 "$INC_FILE"

say "Ensure vhost includes /etc/nginx/includes/*.inc (or at least ndjson include)..."
# If wildcard include already present, we keep it. Else inject one include line inside server {}.
if ! grep -qE 'include\s+/etc/nginx/includes/\*\.inc' "$VH"; then
  # inject include line just after 'server {' (first occurrence)
  perl -0777 -i -pe 's/server\s*\{\n/server {\n    include \/etc\/nginx\/includes\/\*\.inc;\n/s' "$VH"
fi

# Also ensure the specific ndjson include is referenced even if wildcard removed later (safe).
if ! grep -qE 'ndjson_fireinners\.inc' "$VH"; then
  # add explicit include right after server { as priority
  perl -0777 -i -pe 's/server\s*\{\n/server {\n    include \/etc\/nginx\/includes\/ndjson_fireinners\.inc;\n/s' "$VH"
fi

# Deduplicate explicit include if accidentally inserted twice
awk '!seen[$0]++' "$VH" >"$VH.tmp" && mv "$VH.tmp" "$VH"

say "nginx -t ..."
nginx -t

say "Reload nginx..."
systemctl reload nginx

say "Refreeze best-effort (chattr +i)..."
chattr +i "$VH" 2>/dev/null || true
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true

say "DONE."
say "Viewer: https://fireinners.online/ndjson/   (NOTE: /ndjson sans slash redirect OK)"
say "Test NDJSON: https://fireinners.online/data/events.ndjson"
say "Backup: $BK"
BASH

bash /root/MEGA_NDJSON_FIREINNERS_FIX.sh |& tee /root/MEGA_NDJSON_FIREINNERS_FIX.log
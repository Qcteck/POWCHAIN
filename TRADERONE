set -e
cd /root

for F in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$F" ] || continue
  cp -v "$F" "/root/nginx_backups/$(basename "$F").matchdebug.$(date +%Y%m%d_%H%M%S)"
  perl -0777 -i -pe 's#(location\s+\^~\s+/wolverine/traderone/api/\s*\{\n)#$1  add_header X-MATCH traderone-api always;\n#s' "$F"
done

nginx -t
systemctl reload nginx

echo "=== HTTP local (doit afficher X-MATCH) ==="
curl -sS -i -X POST "http://127.0.0.1/wolverine/traderone/api/status" \
  -H "Host: fireinners.online" -H "content-type: application/json" --data '{}' | head -n 40

echo
echo "=== HTTPS local (doit afficher X-MATCH) ==="
curl -sS -k -i -X POST "https://127.0.0.1/wolverine/traderone/api/status" \
  -H "Host: fireinners.online" -H "content-type: application/json" --data '{}' | head -n 40
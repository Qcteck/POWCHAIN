cat >/root/FIX_AQUILATRADER_INCLUDE_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
INC_OK="$INC_DIR/aquilatrader.inc"

echo "== UNFREEZE =="
chattr -i "$NGX_VHOST" 2>/dev/null || true
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true

echo "== REMOVE any reference to aquilatrader_routes.inc =="
sed -i '\|aquilatrader_routes\.inc|d' "$NGX_VHOST"

echo "== ENSURE canonical aquilatrader.inc exists =="
if [ ! -f "$INC_OK" ]; then
cat >"$INC_OK" <<'NGINX'
# AQUILATRADER_CANONICAL_FINAL
location = /aquilatrader { return 301 /aquilatrader/; }
location ^~ /aquilatrader/ {
    alias /var/www/aquilatrader/;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store" always;
}
NGINX
chmod 644 "$INC_OK"
fi

echo "== ENSURE vhost includes aquilatrader.inc once =="
grep -q "include /etc/nginx/includes/aquilatrader.inc;" "$NGX_VHOST" || \
sed -i '/server\s*{/a\    include /etc/nginx/includes/aquilatrader.inc;' "$NGX_VHOST"

echo "== TEST + RELOAD =="
nginx -t
systemctl reload nginx

echo "== REFREEZE =="
chattr +i "$NGX_VHOST" 2>/dev/null || true
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true

echo "== DONE : AquilaTrader route FIXED =="
BASH

chmod +x /root/FIX_AQUILATRADER_INCLUDE_FINAL.sh
bash /root/FIX_AQUILATRADER_INCLUDE_FINAL.sh |& tee /root/FIX_AQUILATRADER_INCLUDE_FINAL.log
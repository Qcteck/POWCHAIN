bash -lc 'set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WV_VAULTFIX_$TS"
INC="/etc/nginx/includes/wolverine_routes.inc"
mkdir -p "$BK"
say(){ echo "[$(date -u +%F\ %T\ UTC)] $*"; }

say "BACKUP -> $BK"
cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
[ -f "$INC" ] && cp -a "$INC" "$BK/$(basename "$INC")" 2>/dev/null || true

# unfreeze immutables if any
if command -v chattr >/dev/null 2>&1; then
  say "UNFREEZE chattr -i (best effort)"
  for f in /etc/nginx/nginx.conf /etc/nginx/sites-available/* /etc/nginx/sites-enabled/* /etc/nginx/conf.d/* /etc/nginx/includes/*; do
    [ -e "$f" ] || continue
    chattr -i "$f" 2>/dev/null || true
  done
fi

say "ENSURE include file: $INC"
mkdir -p /etc/nginx/includes
if [ ! -f "$INC" ]; then
  cat >"$INC"<<'"'"'EOF'"'"'
# wolverine routes (managed)
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ { root /var/www; try_files $uri $uri/ /wolverine/index.html; add_header Cache-Control "no-store" always; }
location ^~ /wolverine/vault-api/ { proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://127.0.0.1:3000/; }
EOF
fi

say "PATCH include to add /wolverine/traderone/vault/ + /wolverine/traderone/api/ proxy"
python3 - <<PY
import re, pathlib
p=pathlib.Path("$INC")
s=p.read_text(encoding="utf-8", errors="ignore")
def has(loc): return re.search(r"location\\s+\\^~\\s+%s\\s*\\{"%re.escape(loc), s) is not None
add=[]
base_proxy = """location ^~ {loc} {{
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}}
"""
if not has("/wolverine/traderone/vault/"):
    add.append(base_proxy.format(loc="/wolverine/traderone/vault/"))
if not has("/wolverine/traderone/api/"):
    add.append(base_proxy.format(loc="/wolverine/traderone/api/"))
if add:
    s = s.rstrip() + "\\n\\n# added by WV_VAULTFIX\\n" + "\\n".join(add) + "\\n"
p.write_text(s, encoding="utf-8")
print("OK: include patched, added_blocks=", len(add))
PY

say "FIND primary SSL vhost for fireinners.online"
VHOST="$( (grep -Rsl --include="*.conf" -E "server_name\\s+.*fireinners\\.online" /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d 2>/dev/null || true) | head -n1 )"
if [ -z "${VHOST:-}" ]; then
  say "ERR: cannot find vhost containing server_name fireinners.online"
  exit 1
fi
say "VHOST=$VHOST"

say "ENSURE vhost includes wolverine_routes.inc"
python3 - <<PY
import pathlib,re
fp=pathlib.Path("$VHOST")
txt=fp.read_text(encoding="utf-8", errors="ignore").splitlines(True)

inc='include /etc/nginx/includes/wolverine_routes.inc;\\n'
if any('includes/wolverine_routes.inc' in l for l in txt):
    print("OK: include already present")
    raise SystemExit(0)

# naive server-block insert: find server { ... server_name ...fireinners.online... } and insert after server_name line
out=[]
i=0
inserted=False
while i < len(txt):
    line=txt[i]
    out.append(line)
    if (not inserted) and re.search(r"\\bserver_name\\b.*fireinners\\.online", line):
        out.append(inc)
        inserted=True
    i+=1

if not inserted:
    # fallback: insert at top of file
    out=[inc]+txt
    inserted=True

fp.write_text("".join(out), encoding="utf-8")
print("OK: include inserted =", inserted)
PY

say "NGINX TEST"
nginx -t

say "RELOAD nginx"
systemctl reload nginx 2>/dev/null || systemctl restart nginx

# refreeze
if command -v chattr >/dev/null 2>&1; then
  say "REFREEZE chattr +i (best effort)"
  for f in /etc/nginx/nginx.conf "$VHOST" "$INC"; do
    [ -e "$f" ] || continue
    chattr +i "$f" 2>/dev/null || true
  done
fi

DOMAIN="fireinners.online"
say "TEST LOCAL (bypass CF) /wolverine/ (first bytes)"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/" | head -c 120 || true; echo
say "TEST LOCAL (bypass CF) /wolverine/vault-api/health"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/vault-api/health" || true; echo
say "TEST LOCAL (bypass CF) /wolverine/traderone/vault/health"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/traderone/vault/health" || true; echo

say "TEST PUBLIC HEAD /wolverine/traderone/vault/health"
curl -skI "https://$DOMAIN/wolverine/traderone/vault/health" | sed -n "1,15p" || true

say "DONE"
say "Backups: $BK"
echo "Open: https://$DOMAIN/wolverine/ (Ctrl+F5)"
'
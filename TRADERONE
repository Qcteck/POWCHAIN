cat >/tmp/FIX_DUP_WOLVERINE_FIND_AND_CLEAN.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

LINK="/etc/nginx/sites-enabled/fireinners.online-ssl"
VHOST="$(readlink -f "$LINK" 2>/dev/null || echo "$LINK")"
echo "VHOST=$VHOST"

echo
echo "=== 1) LIST ALL wolverine locations in /etc/nginx (where duplicates come from) ==="
grep -RIn --color=never -E 'location\s+(\^~\s+)?/wolverine/' /etc/nginx || true

echo
echo "=== 2) LIST ALL includes of wolverine snippets in the ACTIVE vhost ==="
grep -n --color=never -E 'include\s+/etc/nginx/snippets/.*wolverine.*\.conf' "$VHOST" || true
grep -n --color=never -E 'include\s+/etc/nginx/snippets/wolverine_.*\.conf' "$VHOST" || true

echo
echo "=== 3) FORCE: vhost includes ONLY fireinners-wolverine.conf ONCE (remove others) ==="
python3 - <<PY
import re
p="${VHOST}"
s=open(p,"r",encoding="utf-8",errors="ignore").read()

# remove ANY wolverine-related includes (all variants)
s=re.sub(r'^\s*include\s+/etc/nginx/snippets/.*wolverine.*\.conf;.*\n','',s,flags=re.M)
s=re.sub(r'^\s*include\s+/etc/nginx/snippets/wolverine_.*\.conf;.*\n','',s,flags=re.M)

inc='    include /etc/nginx/snippets/fireinners-wolverine.conf; # FIREINNERS_WOLVERINE_INCLUDE\n'
m=re.search(r'^\s*server\s*\{\s*$', s, flags=re.M)
if not m:
    raise SystemExit("ERROR: can't find 'server {' in vhost: "+p)

# inject include right after server {
s = s[:m.end()] + "\n" + inc + s[m.end():]
open(p,"w",encoding="utf-8").write(s)
print("OK: vhost cleaned + include inserted once:", p)
PY

echo
echo "=== 4) nginx test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 5) QUICK VERIFY ==="
echo "--- /wolverine/ headers ---"
curl -kIs --max-time 8 https://fireinners.online/wolverine/ | head -n 12
echo
echo "--- /wolverine/ first lines ---"
curl -ksS --max-time 8 https://fireinners.online/wolverine/ | nl -ba | head -n 12
SH

bash /tmp/FIX_DUP_WOLVERINE_FIND_AND_CLEAN.sh
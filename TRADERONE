import re,sys
domain="fireinners.online"
text=open(sys.argv[1],'r',encoding='utf-8',errors='ignore').read().splitlines()

# nginx -T prints "## configuration file /path:" markers
cur_file="/etc/nginx/nginx.conf"
in_server=False
brace=0
buf=[]
servers=[]

def flush_server():
    global buf,cur_file
    if not buf: return
    s="\n".join(buf)
    servers.append((cur_file,s))
    buf=[]

for ln in text:
    m=re.match(r"^# configuration file (.+):$", ln)
    if m:
        cur_file=m.group(1).strip()
        continue
    # start server block
    if re.search(r'^\s*server\s*\{', ln):
        in_server=True
        brace=1
        buf=[ln]
        continue
    if in_server:
        buf.append(ln)
        brace += ln.count('{') - ln.count('}')
        if brace<=0:
            in_server=False
            flush_server()

def has_domain(block):

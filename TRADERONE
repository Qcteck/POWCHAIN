cat >/root/WOLVERINE_RESTORE_SOL_BALANCE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== RESTORE SOL BALANCE ONLY ==="

# 1) Vérification fichier
test -f "$HTML" || { echo "❌ $HTML introuvable"; exit 1; }

# 2) Backup
cp -a "$HTML" "$HTML.bak_SOL_${TS}"
echo "✅ Backup: $HTML.bak_SOL_${TS}"

# 3) Nettoyage ancien SOL injecté (si existe)
sed -i '/SOL_BALANCE_START/,/SOL_BALANCE_END/d' "$HTML"

# 4) Injection SOL propre (NON intrusive)
sed -i "/<\/body>/i \
<!-- SOL_BALANCE_START -->\
<script>\
(async()=>{\
 if(!window.solana||!window.solana.isPhantom)return;\
 try{\
  const {Connection,PublicKey,LAMPORTS_PER_SOL}=solanaWeb3;\
  const rpc=\"https://lb.drpc.live/solana/AsxThpeKkEjGtZhCNUEQYo1ZluSgmwsR76RdFhW5UfFk\";\
  const conn=new Connection(rpc,\"confirmed\");\
  const r=await window.solana.connect({onlyIfTrusted:true});\
  const pub=new PublicKey(r.publicKey.toString());\
  const lamports=await conn.getBalance(pub);\
  const sol=(lamports/LAMPORTS_PER_SOL).toFixed(4);\
  let el=document.getElementById('sol_balance');\
  if(!el){\
    el=document.createElement('div');\
    el.id='sol_balance';\
    el.style.cssText='position:fixed;bottom:10px;right:10px;background:#111;color:#0f0;padding:8px 12px;font-weight:700;z-index:99999;border-radius:6px';\
    document.body.appendChild(el);\
  }\
  el.textContent='SOL: '+sol;\
 }catch(e){console.error('SOL balance error',e);}\
})();\
</script>\
<!-- SOL_BALANCE_END -->\
</body>" "$HTML"

# 5) Reload nginx
nginx -t && systemctl reload nginx

echo "✅ SOL balance restored"
echo "➡️ Ouvre la page + CTRL+SHIFT+R"
BASH

chmod +x /root/WOLVERINE_RESTORE_SOL_BALANCE.sh
/root/WOLVERINE_RESTORE_SOL_BALANCE.sh
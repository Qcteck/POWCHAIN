# ROOT batch — trouver LIFI_API_KEY dans PM2 (quel id ?) + lock nginx sur valeur exacte
set -euo pipefail

echo "=== 1) PM2 list ==="
pm2 ls
echo

echo "=== 2) Cherche LIFI_API_KEY dans TOUS les PM2 env (sans afficher la valeur) ==="
FOUND_ID=""
while read -r id; do
  [ -n "$id" ] || continue
  if pm2 env "$id" 2>/dev/null | grep -q '^LIFI_API_KEY='; then
    echo "FOUND: LIFI_API_KEY dans pm2 id=$id"
    FOUND_ID="$id"
    break
  fi
done < <(pm2 jlist 2>/dev/null | python3 - <<'PY'
import json,sys
a=json.load(sys.stdin)
for p in a:
  print(p.get("pm_id",""))
PY
)

[ -n "${FOUND_ID:-}" ] || { echo "KO: LIFI_API_KEY introuvable dans pm2 env (tous les ids)."; exit 1; }

echo "=== 3) Récupérer la valeur depuis pm2 env $FOUND_ID (NON affichée) ==="
KEY="$(pm2 env "$FOUND_ID" 2>/dev/null | awk -F= '/^LIFI_API_KEY=/{print $2}' | tail -n1)"
[ -n "${KEY:-}" ] || { echo "KO: lecture valeur LIFI_API_KEY impossible"; exit 1; }
echo "OK: KEY found (not printed) from pm2 id=$FOUND_ID"

echo "=== 4) Patch nginx: X-API-KEY doit matcher EXACTEMENT LIFI_API_KEY ==="
NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.lock_exact_key.$(date +%s)"

python3 - <<'PY'
from pathlib import Path
import os,re
ng=Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s=ng.read_text()
KEY=os.environ["KEY"]

# remplace check "vide" OU check != "..." existant
s2 = re.sub(r'if\s*\(\s*\$http_x_api_key\s*=\s*""\s*\)\s*\{\s*return\s+403;\s*\}',
            f'if ($http_x_api_key != "{KEY}") {{ return 403; }}', s)
s2 = re.sub(r'if\s*\(\s*\$http_x_api_key\s*!=\s*"[^"]*"\s*\)\s*\{\s*return\s+403;\s*\}',
            f'if ($http_x_api_key != "{KEY}") {{ return 403; }}', s2)

if s2 == s:
  raise SystemExit("KO: je ne trouve pas le check X-API-KEY dans nginx à remplacer.")
ng.write_text(s2)
print("OK: nginx locked to exact key (not printed)")
PY

nginx -t
systemctl reload nginx

echo "=== 5) Tests (attendu) ==="
echo "--- /health (200 sans clé) ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 6
echo "--- /dexes (bad key => 403) ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes -H "X-API-KEY: test" | head -n 6
echo "--- /dexes (good key => 200) ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes -H "X-API-KEY: $KEY" | head -n 6
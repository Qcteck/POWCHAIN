cat >/root/batch_root_phantom_wolverine_fix.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APPLY="${APPLY:-0}"                      # 0=dry-run, 1=apply
NETWORK="${NETWORK:-mainnet}"            # mainnet | devnet
OUT_DIR="${OUT_DIR:-/var/www/wolverine}" # folder served by nginx alias
WOLVERINE_WALLET="${WOLVERINE_WALLET:-DgpM2PXA9it1g8myWnVXeosu72GkwmjgpeGUigpyLkYC}"

# RPC defaults
if [[ "$NETWORK" == "devnet" ]]; then
  RPC="${RPC:-https://api.devnet.solana.com}"
else
  RPC="${RPC:-https://api.mainnet-beta.solana.com}"
fi

# USDC mint defaults
USDC_MINT="${USDC_MINT:-}"
if [[ -z "$USDC_MINT" ]]; then
  if [[ "$NETWORK" == "mainnet" ]]; then
    USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
  else
    USDC_MINT="REPLACE_ME_DEVNET_USDC_MINT"
  fi
fi

need(){ command -v "$1" >/dev/null 2>&1 || { echo "[ERR] missing: $1"; exit 1; }; }
need node; need npm; need find; need grep; need awk; need sed

ts(){ date "+%F_%H%M%S"; }
say(){ echo "[$(ts)] $*"; }

say "== Phantom integration (FIX detection) =="
say "APPLY=$APPLY (0=dry,1=apply)"
say "NETWORK=$NETWORK"
say "RPC=$RPC"
say "USDC_MINT=$USDC_MINT"
say "WOLVERINE_WALLET=$WOLVERINE_WALLET"
say "OUT_DIR=$OUT_DIR"
echo

# 1) Find best Next.js repo (exclude node_modules/.git)
say "Searching Next.js repos..."
mapfile -t PJS < <(
  find /opt /var/www /srv -maxdepth 7 -name package.json \
    -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null
)

declare -a CANDS=()
for pj in "${PJS[@]}"; do
  if grep -q '"next"' "$pj"; then
    CANDS+=("$(dirname "$pj")")
  fi
done

if [[ "${#CANDS[@]}" -eq 0 ]]; then
  echo "[ERR] Aucun projet Next.js trouvé (hors node_modules)."
  exit 1
fi

# prefer one that has app/ or pages/ at root
APP_DIR=""
for d in "${CANDS[@]}"; do
  if [[ -d "$d/app" || -d "$d/pages" ]]; then
    APP_DIR="$d"
    break
  fi
done
# fallback first candidate
if [[ -z "$APP_DIR" ]]; then APP_DIR="${CANDS[0]}"; fi

say "APP_DIR=$APP_DIR"
cd "$APP_DIR"

# 2) Backup dir
BACKDIR="/root/backup_phantom_wolverine_$(ts)"
backup_file(){ [[ -f "$1" ]] || return 0; mkdir -p "$BACKDIR"; cp -a "$1" "$BACKDIR/$(basename "$1").bak"; }

# 3) Install deps
if [[ "$APPLY" == "1" ]]; then
  say "Installing deps..."
  npm i @solana/web3.js @solana/spl-token
else
  say "[DRY] npm i @solana/web3.js @solana/spl-token"
fi

mkdir -p lib components

# 4) lib/solana.ts
if [[ "$APPLY" == "1" ]]; then
  backup_file "lib/solana.ts"
  cat > lib/solana.ts <<EOF
import { Connection, PublicKey } from "@solana/web3.js";

export const NETWORK = process.env.NEXT_PUBLIC_SOLANA_NETWORK ?? "${NETWORK}";
export const RPC = process.env.NEXT_PUBLIC_SOLANA_RPC ?? "${RPC}";
export const connection = new Connection(RPC, "confirmed");

export const WOLVERINE_WALLET = new PublicKey("${WOLVERINE_WALLET}");
export const USDC_MINT = new PublicKey("${USDC_MINT}");
EOF
  say "OK: lib/solana.ts"
else
  say "[DRY] would write lib/solana.ts"
fi

# 5) components/PhantomWolverine.tsx
if [[ "$APPLY" == "1" ]]; then
  backup_file "components/PhantomWolverine.tsx"
  cat > components/PhantomWolverine.tsx <<'EOF'
"use client";

import React, { useEffect, useMemo, useState } from "react";
import { PublicKey, SystemProgram, Transaction, LAMPORTS_PER_SOL } from "@solana/web3.js";
import {
  getAssociatedTokenAddress,
  createAssociatedTokenAccountInstruction,
  createTransferInstruction,
} from "@solana/spl-token";
import { connection, WOLVERINE_WALLET, USDC_MINT, NETWORK } from "../lib/solana";

type PhantomProvider = {
  isPhantom?: boolean;
  publicKey?: PublicKey;
  connect: (opts?: { onlyIfTrusted?: boolean }) => Promise<{ publicKey: PublicKey }>;
  disconnect: () => Promise<void>;
  signAndSendTransaction: (tx: Transaction) => Promise<{ signature: string }>;
};

function getPhantom(): PhantomProvider | null {
  const w = window as any;
  return w?.solana?.isPhantom ? (w.solana as PhantomProvider) : null;
}

export default function PhantomWolverine() {
  const phantom = useMemo(() => (typeof window !== "undefined" ? getPhantom() : null), []);
  const [pubkey, setPubkey] = useState<string>("");
  const [sol, setSol] = useState<number>(0);
  const [usdc, setUsdc] = useState<number>(0);
  const [loading, setLoading] = useState(false);

  const [sendSolAmount, setSendSolAmount] = useState("0.01");
  const [sendUsdcAmount, setSendUsdcAmount] = useState("1");

  async function refreshBalances(owner: PublicKey) {
    const lamports = await connection.getBalance(owner, "confirmed");
    setSol(lamports / LAMPORTS_PER_SOL);

    const ownerUsdcAta = await getAssociatedTokenAddress(USDC_MINT, owner, false);
    const bal = await connection.getTokenAccountBalance(ownerUsdcAta).catch(() => null);
    setUsdc(bal ? Number(bal.value.uiAmount ?? 0) : 0);
  }

  async function connectWallet() {
    if (!phantom) return alert("Phantom non détecté.");
    const res = await phantom.connect();
    setPubkey(res.publicKey.toBase58());
    await refreshBalances(res.publicKey);
  }

  async function disconnect() {
    if (!phantom) return;
    await phantom.disconnect();
    setPubkey(""); setSol(0); setUsdc(0);
  }

  async function sendSOL() {
    if (!phantom?.publicKey) return;
    setLoading(true);
    try {
      const from = phantom.publicKey;
      const lamports = Math.round(Number(sendSolAmount) * LAMPORTS_PER_SOL);

      const tx = new Transaction().add(
        SystemProgram.transfer({ fromPubkey: from, toPubkey: WOLVERINE_WALLET, lamports })
      );
      tx.feePayer = from;
      tx.recentBlockhash = (await connection.getLatestBlockhash("confirmed")).blockhash;

      const { signature } = await phantom.signAndSendTransaction(tx);
      await connection.confirmTransaction(signature, "confirmed");
      await refreshBalances(from);
      alert(`SOL envoyé ✅ tx: ${signature}`);
    } finally { setLoading(false); }
  }

  async function sendUSDC() {
    if (!phantom?.publicKey) return;
    setLoading(true);
    try {
      const owner = phantom.publicKey;
      const fromAta = await getAssociatedTokenAddress(USDC_MINT, owner, false);
      const toAta = await getAssociatedTokenAddress(USDC_MINT, WOLVERINE_WALLET, false);

      // assume 6 decimals
      const baseUnits = BigInt(Math.round(Number(sendUsdcAmount) * 1_000_000));

      const ixs = [];
      const toInfo = await connection.getAccountInfo(toAta).catch(() => null);
      if (!toInfo) {
        ixs.push(createAssociatedTokenAccountInstruction(owner, toAta, WOLVERINE_WALLET, USDC_MINT));
      }
      ixs.push(createTransferInstruction(fromAta, toAta, owner, baseUnits));

      const tx = new Transaction().add(...ixs);
      tx.feePayer = owner;
      tx.recentBlockhash = (await connection.getLatestBlockhash("confirmed")).blockhash;

      const { signature } = await phantom.signAndSendTransaction(tx);
      await connection.confirmTransaction(signature, "confirmed");
      await refreshBalances(owner);
      alert(`USDC envoyé ✅ tx: ${signature}`);
    } finally { setLoading(false); }
  }

  useEffect(() => {
    (async () => {
      if (!phantom) return;
      try {
        const res = await phantom.connect({ onlyIfTrusted: true });
        setPubkey(res.publicKey.toBase58());
        await refreshBalances(res.publicKey);
      } catch {}
    })();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  return (
    <div style={{ maxWidth: 720, fontFamily: "system-ui, sans-serif" }}>
      <h2>Wolverine</h2>
      <div style={{ opacity: 0.7 }}>Network: {NETWORK}</div>

      {!pubkey ? (
        <button onClick={connectWallet}>Connect Phantom</button>
      ) : (
        <>
          <div><b>Wallet connecté:</b> {pubkey}</div>
          <div style={{ marginTop: 8 }}>
            <b>SOL:</b> {sol.toFixed(6)}<br />
            <b>USDC:</b> {usdc.toFixed(2)}
          </div>

          <div style={{ marginTop: 12, padding: 12, border: "1px solid #ddd", borderRadius: 8 }}>
            <div><b>Destination WOLVERINE:</b> {WOLVERINE_WALLET.toBase58()}</div>

            <div style={{ marginTop: 10 }}>
              <b>Envoyer SOL</b><br />
              <input value={sendSolAmount} onChange={(e) => setSendSolAmount(e.target.value)} />
              <button disabled={loading} onClick={sendSOL} style={{ marginLeft: 8 }}>Send SOL</button>
            </div>

            <div style={{ marginTop: 10 }}>
              <b>Envoyer USDC</b><br />
              <input value={sendUsdcAmount} onChange={(e) => setSendUsdcAmount(e.target.value)} />
              <button disabled={loading} onClick={sendUSDC} style={{ marginLeft: 8 }}>Send USDC</button>
            </div>

            <div style={{ marginTop: 10 }}>
              <button onClick={disconnect}>Disconnect</button>
            </div>
          </div>
        </>
      )}
    </div>
  );
}
EOF
  say "OK: components/PhantomWolverine.tsx"
else
  say "[DRY] would write components/PhantomWolverine.tsx"
fi

# 6) Inject into home page if standard entry exists; otherwise print candidates
inject_done=0

if [[ -f "app/page.tsx" ]]; then
  if [[ "$APPLY" == "1" ]]; then
    backup_file "app/page.tsx"
    cat > app/page.tsx <<'EOF'
import PhantomWolverine from "../components/PhantomWolverine";
export default function Page() { return <PhantomWolverine />; }
EOF
  else
    say "[DRY] would overwrite app/page.tsx"
  fi
  inject_done=1
fi

if [[ "$inject_done" -eq 0 && -f "pages/index.tsx" ]]; then
  if [[ "$APPLY" == "1" ]]; then
    backup_file "pages/index.tsx"
    cat > pages/index.tsx <<'EOF'
import dynamic from "next/dynamic";
const PhantomWolverine = dynamic(() => import("../components/PhantomWolverine"), { ssr: false });
export default function Home() { return <PhantomWolverine />; }
EOF
  else
    say "[DRY] would overwrite pages/index.tsx"
  fi
  inject_done=1
fi

if [[ "$inject_done" -eq 0 ]]; then
  say "[WARN] Pas de app/page.tsx ni pages/index.tsx. Voici des pages candidates :"
  find . -maxdepth 4 -type f \( -name 'page.tsx' -o -name 'index.tsx' -o -name 'App.tsx' \) \
    -not -path '*/node_modules/*' | head -n 50
  say "=> Donne-moi le chemin exact de ta page d’accueil, et je te fais un patch ciblé."
fi

# 7) Build/export/publish (only if export exists)
if [[ "$APPLY" == "1" ]]; then
  say "Building..."
  npm run build

  if npm run export; then
    say "Export OK."
    [[ -d out ]] || { echo "[ERR] out/ absent après export"; exit 1; }
    mkdir -p "$OUT_DIR"
    rsync -a --delete out/ "$OUT_DIR/"
    say "Published to $OUT_DIR"
  else
    echo "[ERR] npm run export a échoué."
    echo "=> Dans ce cas, il faut servir Next en mode server (node) + proxy Nginx."
    exit 1
  fi
else
  say "[DRY] would run: npm run build && npm run export && rsync out/ -> $OUT_DIR"
fi

say "DONE."
say "Backup dir (if files existed): $BACKDIR"
BASH

chmod +x /root/batch_root_phantom_wolverine_fix.sh
echo "OK: /root/batch_root_phantom_wolverine_fix.sh prêt"
async function fetchWithUA(url, timeoutMs=15000){
  const ctrl=new AbortController();
  const to=setTimeout(()=>ctrl.abort(), timeoutMs);
  try{
    const r=await fetch(url,{
      redirect:"follow",
      signal:ctrl.signal,
      headers:{
        "user-agent":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36",
        "accept":"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
      }
    });
    const ct=(r.headers.get("content-type")||"").toLowerCase();
    const txt=await r.text();
    return {ok:r.ok,status:r.status,ct,txt};
  }finally{ clearTimeout(to); }
}

async function renderWithPlaywright(url){
  const p=await ensurePlaywright();
  if(!p) return null;
  let browser=null;
  try{
    browser = await p.chromium.launch({headless:true, args:["--no-sandbox","--disable-setuid-sandbox"]});
    const page = await browser.newPage();
    await page.setExtraHTTPHeaders({"user-agent":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36"});
    await page.goto(url, {waitUntil:"networkidle", timeout:20000});
    const html = await page.content();
    return html;
  }catch(e){
    return null;
  }finally{
    try{ if(browser) await browser.close(); }catch(e){}
  }
}

function extractReadability(html, url){
  try{
    const dom = new JSDOM(html, {url});
    const reader = new Readability(dom.window.document);
    const art = reader.parse();
    if(art && art.textContent){
      const text=art.textContent.replace(/\s+\n/g,"\n").replace(/\n{3,}/g,"\n\n").trim();
      return {text, title:art.title||null, method:"readability"};
    }
  }catch(e){}
  return null;
}

function extractHeuristic(html, url){
  try{
    const dom = new JSDOM(html, {url});
    const d = dom.window.document;
    const cand = d.querySelector("article") || d.querySelector("main") || d.body;
    let text = cand ? cand.textContent : d.body.textContent;
    text = (text||"").replace(/\s+\n/g,"\n").replace(/\n{3,}/g,"\n\n").trim();
    return {text, title:(d.querySelector("title")?.textContent||null), method:"heuristic"};
  }catch(e){}
  return null;
}

async function fetchJina(url){
  try{
    const u = "https://r.jina.ai/https://" + url.replace(/^https?:\/\//i,"");
    const r = await fetchWithUA(u, 15000);
    if(r.ok && r.txt && r.txt.trim().length>400) return {text:r.txt.trim(), title:null, method:"jina"};
  }catch(e){}
  return null;
}

function pickBestExtract(extracts){
  let best=null;
  for(const ex of extracts){
    if(!ex || !ex.text) continue;
    const q=qualityScore(ex.text);
    const len=ex.text.length;
    if(!best || q>best.q || (q===best.q && len>best.len)){
      best={...ex,q,len};
    }
  }
  return best;
}

async function extractArticle(url){
  const domain=domainOf(url);
  const extracts=[];

  // 1) direct fetch
  let html=null;
  try{
    const r=await fetchWithUA(url, 16000);
    if(r.ok && r.txt && r.txt.trim().length>200 && /text\/html|application\/xhtml\+xml/.test(r.ct)){
      html=r.txt;
      const r1=extractReadability(html,url); if(r1) extracts.push(r1);
      const r2=extractHeuristic(html,url); if(r2) extracts.push(r2);
      extracts.push({text:stripHtml(html),title:null,method:"strip"});
    }
  }catch(e){
    pushErr("article fetch fail");
  }

  // 2) if weak, try Playwright render (JS sites)
  const best0=pickBestExtract(extracts);
  if((!best0 || best0.q<55 || best0.len<1200) && ENABLE_PLAYWRIGHT){
    const rendered = await renderWithPlaywright(url);
    if(rendered && rendered.length>300){
      const r1=extractReadability(rendered,url); if(r1) extracts.push({...r1,method:"readability+pw"});
      const r2=extractHeuristic(rendered,url); if(r2) extracts.push({...r2,method:"heuristic+pw"});
      extracts.push({text:stripHtml(rendered),title:null,method:"strip+pw"});
    }
  }

  // 3) jina fallback
  if(!pickBestExtract(extracts) || pickBestExtract(extracts).q<55){
    const jn=await fetchJina(url);
    if(jn) extracts.push(jn);
  }

  const best=pickBestExtract(extracts);
  if(!best){
    return {ok:false,domain,url,title:null,text:"",quality:0,method:"none",paywall:true};
  }

  const pay=paywallSuspect(best.text);
  return {
    ok:true,
    domain,
    url,
    title:best.title||null,
    text:safeStr(best.text,240000),
    quality:best.q,
    method:best.method,
    paywall:pay
  };
}

/** Translation best-effort with fallback glossary (no promise) */
const GLOSS_FR_EN=[
  ["hausse","rise"],["baisse","drop"],["marché","market"],["volume","volume"],["liquidité","liquidity"],
  ["portefeuille","wallet"],["jeton","token"],["échange","swap"],["prix","price"],["risque","risk"],
  ["régulation","regulation"],["sécurité","security"],["piratage","hack"],["tendance","trend"],["support","support"],["résistance","resistance"]
];
const GLOSS_EN_FR=GLOSS_FR_EN.map(([a,b])=>[b,a]);

function glossTranslate(txt, to){
  const map = to==="fr"?GLOSS_EN_FR:GLOSS_FR_EN;
  let out=String(txt||"");
  for(const [a,b] of map){
    const re=new RegExp("\\b"+a.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")+"\\b","gi");
    out=out.replace(re,b);
  }
  return out;
}

async function translateBestEffort(text, to){
  text=String(text||"");
  if(!text.trim()) return {ok:true,method:"none",text:""};
  const endpoints=[
    "https://libretranslate.de/translate",
    "https://translate.argosopentech.com/translate"
  ];
  for(const ep of endpoints){
    try{
      const r=await fetch(ep,{
        method:"POST",
        headers:{"content-type":"application/json"},
        body:JSON.stringify({q:text,source:"auto",target:to,format:"text"})
      });
      if(r.ok){
        const j=await r.json().catch(()=>null);
        const t=j && (j.translatedText||j.translation);
        if(t && String(t).trim().length>5) return {ok:true,method:ep,text:String(t)};
      }
    }catch(e){}
  }
  // fallback glossary (safe)
  return {ok:false,method:"glossary",text:glossTranslate(text,to)};
}


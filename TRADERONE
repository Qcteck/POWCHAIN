$ErrorActionPreference="Stop"

# --- 0) Paths
$Here = $PWD.Path
$Scad = Join-Path $Here "robo600_parts.scad"
if(!(Test-Path $Scad)){ throw "SCAD introuvable: $Scad (mets robo600_parts.scad dans ce dossier)" }

$Pack = Join-Path $Here "ROBO600_PRINTPACK"
$StlDir = Join-Path $Pack "stl"
$GcodeDir = Join-Path $Pack "gcode"
New-Item -ItemType Directory -Force -Path $StlDir,$GcodeDir | Out-Null

# --- 1) Find OpenSCAD (openscad.com)
$OpenSCAD = $null
$OpenCandidates = @(
  "C:\Program Files\OpenSCAD\openscad.com",
  "C:\Program Files\OpenSCAD (Nightly)\openscad.com",
  "C:\Program Files (x86)\OpenSCAD\openscad.com"
)
$OpenSCAD = $OpenCandidates | ?{ Test-Path $_ } | Select-Object -First 1
if(-not $OpenSCAD){
  $cmd = Get-Command openscad.com -ErrorAction SilentlyContinue
  if($cmd){ $OpenSCAD = $cmd.Source }
}
if(-not $OpenSCAD){ throw "OpenSCAD introuvable. Installe OpenSCAD ou corrige le chemin." }

# --- 2) Parts list (STL)
$Parts = @(
"pelvis_half1","pelvis_half2","torso_half1","torso_half2","head_half1","head_half2",
"back_hatch","neck_ring","face_plate","jaw",
"shoulder_joint","elbow_joint","hip_joint","knee_joint",
"upperarm_half1","upperarm_half2","forearm_half1","forearm_half2","hand",
"thigh_half1","thigh_half2","shin_half1","shin_half2","foot",
"dc_mount_small","dc_mount_big","driver_tray","pca_esp_tray","lcd_bezel",
"solar_bracket_left","solar_bracket_right","cable_clip"
)

Write-Host "`n== Export STL via OpenSCAD ==" -ForegroundColor Cyan
foreach($p in $Parts){
  $outStl = Join-Path $StlDir ($p + ".stl")
  Write-Host "  -> $p"
  & $OpenSCAD -o $outStl -D ("PART=`"" + $p + "`"") $Scad
  if($LASTEXITCODE -ne 0){ throw "OpenSCAD a échoué sur $p (exit=$LASTEXITCODE)" }
  if(!(Test-Path $outStl)){ throw "STL non créé: $outStl" }
  if((Get-Item $outStl).Length -lt 800){ throw "STL suspect/trop petit: $outStl" }
}
Write-Host "OK STL: $($Parts.Count) fichiers dans $StlDir" -ForegroundColor Green

# --- 3) Try find CuraEngine (Creality Print souvent basé Cura)
Write-Host "`n== Recherche CuraEngine (pour GCODE auto) ==" -ForegroundColor Cyan
$CuraEngine = $null
$searchRoots = @("C:\Program Files","C:\Program Files (x86)")
foreach($r in $searchRoots){
  $hit = Get-ChildItem $r -Recurse -Filter "CuraEngine.exe" -ErrorAction SilentlyContinue | Select-Object -First 1
  if($hit){ $CuraEngine = $hit.FullName; break }
}
if(-not $CuraEngine){
  Write-Host "CuraEngine.exe non trouvé. Je laisse les STL prêts pour Creality Print." -ForegroundColor Yellow
  Write-Host "STL: $StlDir"
  exit 0
}
Write-Host "CuraEngine: $CuraEngine" -ForegroundColor Green

# --- 4) Find an Ender 3 definition JSON (si présent)
Write-Host "`n== Recherche definition Ender 3 (*.def.json) ==" -ForegroundColor Cyan
$DefJson = $null
$defHit = Get-ChildItem (Split-Path $CuraEngine -Parent) -Recurse -Filter "*.def.json" -ErrorAction SilentlyContinue |
  ?{ $_.Name -match "ender" -and $_.Name -match "3" } | Select-Object -First 1
if($defHit){ $DefJson = $defHit.FullName }

if(-not $DefJson){
  # fallback: chercher dans Program Files
  $defHit = Get-ChildItem "C:\Program Files","C:\Program Files (x86)" -Recurse -Filter "*ender*3*.def.json" -ErrorAction SilentlyContinue | Select-Object -First 1
  if($defHit){ $DefJson = $defHit.FullName }
}

if(-not $DefJson){
  Write-Host "Definition Ender 3 non trouvée. Je ne peux pas slicer en CLI sans .def.json." -ForegroundColor Yellow
  Write-Host "Tu as quand même tous les STL dans: $StlDir"
  exit 0
}
Write-Host "Def: $DefJson" -ForegroundColor Green

# --- 5) Slice each STL -> GCODE (profil PLA basique)
# Notes: réglages conservateurs; tu peux ajuster ici.
$Layer=0.2
$Nozzle=0.4
$Wall=3
$TopBottom=5
$Infill=20   # %
$Temp=200
$Bed=60
$Speed=60
$Brim=6

Write-Host "`n== Slice STL -> GCODE (CuraEngine) ==" -ForegroundColor Cyan
foreach($p in $Parts){
  $stl = Join-Path $StlDir ($p + ".stl")
  $gco = Join-Path $GcodeDir ($p + ".gcode")
  Write-Host "  -> $p"
  & $CuraEngine slice -j $DefJson -l $stl -o $gco `
    -s layer_height=$Layer `
    -s machine_nozzle_size=$Nozzle `
    -s wall_line_count=$Wall `
    -s top_layers=$TopBottom `
    -s bottom_layers=$TopBottom `
    -s infill_sparse_density=$Infill `
    -s material_print_temperature=$Temp `
    -s material_bed_temperature=$Bed `
    -s speed_print=$Speed `
    -s adhesion_type=brim `
    -s brim_width=$Brim
  if($LASTEXITCODE -ne 0){ throw "CuraEngine a échoué sur $p (exit=$LASTEXITCODE)" }
  if(!(Test-Path $gco)){ throw "GCODE non créé: $gco" }
}

Write-Host "OK GCODE: $($Parts.Count) fichiers dans $GcodeDir" -ForegroundColor Green
Write-Host "`nSTL:   $StlDir"
Write-Host "GCODE: $GcodeDir"
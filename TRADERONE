set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/fireinners_routes.conf"

echo "=== 1) Où le snippet est inclus actuellement ? ==="
grep -RIn --color=never "include .*fireinners_routes\.conf" /etc/nginx || true
echo

echo "=== 2) Trouver le server block pour $DOMAIN ==="
CONF="$(grep -RIl "server_name.*${DOMAIN}" /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null | head -n 1 || true)"
echo "CONF=$CONF"
[ -n "$CONF" ] || { echo "❌ server block introuvable pour $DOMAIN"; exit 1; }

echo "=== 3) Retirer TOUS les includes du snippet (reset propre) ==="
for f in $(grep -RIl "include .*fireinners_routes\.conf" /etc/nginx 2>/dev/null || true); do
  cp -a "$f" "$f.bak.$(date +%s)" || true
  sed -i '/include .*fireinners_routes\.conf;/d' "$f" || true
  echo "Removed include from: $f"
done

echo "=== 4) Ajouter l'include UNIQUEMENT dans le bon server { } ==="
cp -a "$CONF" "$CONF.bak.$(date +%s)"

# insert juste après la ligne server_name ... fireinners.online
awk -v inc="  include $SNIP;" '
  {print}
  $0 ~ /server_name/ && $0 ~ /fireinners\.online/ && !done {print inc; done=1}
' "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"

echo "=== 5) Test + reload nginx ==="
nginx -t
systemctl reload nginx
echo "✅ OK"
tail -n 60 /var/log/nginx/error.log
grep -RIn '"/solana-rpc"' /var/log/nginx/access.log | tail -n 20



cat >/root/fix_403_solana_rpc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
SSL="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== 0) Preflight =="
[[ -f "$SSL" ]] || { echo "[ERR] missing $SSL"; exit 1; }
mkdir -p /etc/nginx/snippets
cp -a "$SSL" "${SSL}.bak_${ts}" || true
cp -a "$SNIP" "${SNIP}.bak_${ts}" 2>/dev/null || true

echo "== 1) Write canonical snippet (force allow, disable auth, correct proxy_pass) =="
cat >"$SNIP" <<'NGINX'
# Include this file INSIDE a server{} block only.
location = /solana-rpc {
  # In case server{} has auth_basic / deny:
  auth_basic off;
  allow all;

  # CORS + preflight
  add_header Access-Control-Allow-Origin * always;
  add_header Access-Control-Allow-Headers * always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }

  # IMPORTANT: trailing "/" so upstream path is "/" (not "/solana-rpc")
  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;
}
NGINX

echo "== 2) Ensure snippet include exists ONCE in SSL vhost =="
# remove duplicate include lines
awk '
  {
    if ($0 ~ /include[[:space:]]+\/etc\/nginx\/snippets\/solana_rpc_proxy\.conf;/) {
      if (seen==1) next;
      seen=1;
    }
    print
  }
' "$SSL" > /tmp/ssl.$$ && cat /tmp/ssl.$$ > "$SSL" && rm -f /tmp/ssl.$$

# add include if missing (after server_name line)
if ! grep -q "solana_rpc_proxy.conf" "$SSL"; then
  sed -i '/server_name .*fireinners\.online/ a\  include /etc/nginx/snippets/solana_rpc_proxy.conf;' "$SSL"
fi

ln -sf "$SSL" "$EN"

echo "== 3) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== 4) TEST A (public DNS like browser) =="
curl -sk -i "https://${DOMAIN}/solana-rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,25p'

echo
echo "== 5) TEST B (force localhost, bypass any external proxy) =="
curl -sk -i --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/solana-rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,25p'

echo
echo "== 6) If still 403, show last nginx lines =="
tail -n 40 /var/log/nginx/error.log || true
BASH

chmod +x /root/fix_403_solana_rpc.sh
/root/fix_403_solana_rpc.sh
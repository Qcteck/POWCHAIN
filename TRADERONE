cat >/tmp/FIX_NGINX_ACTIVE_VHOST_TRADERONE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

LINK="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_traderone_backend.conf"

echo "=== A) Identify active vhost file ==="
ls -la "$LINK" || true
REAL="$(readlink -f "$LINK" 2>/dev/null || true)"
if [ -z "${REAL:-}" ]; then REAL="$LINK"; fi
echo "ACTIVE LINK : $LINK"
echo "REAL TARGET : $REAL"
ls -la "$REAL" || true

echo
echo "=== B) Remove immutable (if any) ==="
lsattr "$LINK" "$REAL" 2>/dev/null || true
chattr -i "$LINK" 2>/dev/null || true
chattr -i "$REAL" 2>/dev/null || true
lsattr "$LINK" "$REAL" 2>/dev/null || true

echo
echo "=== C) (re)write TraderOne proxy snippet (API+WS+UI) ==="
cat >"$SNIP" <<'EOF'
# TRADERONE_WOLV_PROXY_V2

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:8585/api/;
}

location ^~ /wolverine/traderone/ws {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:8585/ws;
}

location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:8585/;
}
EOF

echo
echo "=== D) Ensure include is INSIDE the ACTIVE server{} ==="
python3 - <<PY
import re
p="${REAL}"
inc="    include /etc/nginx/snippets/wolverine_traderone_backend.conf; # TRADERONE_INCLUDE_ACTIVE\n"
s=open(p,"r",encoding="utf-8",errors="ignore").read()
if "wolverine_traderone_backend.conf" in s:
    print("OK: include already present in active vhost")
else:
    m=re.search(r'^\s*server\s*\{\s*$', s, flags=re.M)
    if not m:
        raise SystemExit("ERROR: can't find 'server {' in active vhost: "+p)
    s=s[:m.end()]+"\n"+inc+s[m.end():]
    open(p,"w",encoding="utf-8").write(s)
    print("OK: include added to active vhost:", p)
PY

echo
echo "=== E) Reload nginx + test ==="
nginx -t
systemctl reload nginx

echo "--- PUBLIC /wolverine/traderone/api/status (must NOT be HTML) ---"
curl -ksS --max-time 8 https://fireinners.online/wolverine/traderone/api/status | head -c 240; echo
SH

bash /tmp/FIX_NGINX_ACTIVE_VHOST_TRADERONE.sh
if marker not in s:
  inject = r'''<!--AQUILA_SOL_V1--><div id="aquilaBox" style="border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:14px;max-width:560px;margin:14px 0;background:rgba(0,0,0,.25)"><div style="font-weight:800;letter-spacing:.5px;margin-bottom:8px">Aquila</div><div style="display:flex;gap:10px;align-items:center;margin-bottom:10px;flex-wrap:wrap"><div style="min-width:110px;opacity:.9">Budget (SOL)</div><input id="aquilaBudget" value="0.10" inputmode="decimal" placeholder="0.10" style="flex:1;min-width:160px;padding:10px 12px;border-radius:10px;border:1px solid rgba(255,255,255,.15);background:rgba(0,0,0,.35);color:#fff;outline:none"/><button id="aquilaGo" style="padding:10px 12px;border-radius:10px;border:1px solid rgba(255,255,255,.2);background:rgba(0,0,0,.45);color:#fff;cursor:pointer;font-weight:700">Créer Vault + Déposer</button></div><div style="font-size:12px;line-height:1.35;opacity:.9"><div><b>Wallet</b>: <span id="aquilaWallet">-</span></div><div><b>Vault</b>: <span id="aquilaVault">-</span></div><div style="margin-top:6px"><b>Status</b>: <span id="aquilaStatus">-</span></div></div></div><script>(function(){function $(id){return document.getElementById(id)}function setS(t){$("aquilaStatus").textContent=t||"-"}function n(x){return (x||"").trim().replace(",",".")}function toLamports(sol){var v=parseFloat(n(sol));if(!isFinite(v)||v<=0)return 0;return Math.floor(v*1e9)}async function getWallet(){var sol=window.solana;if(!sol||!sol.isPhantom)throw new Error("Phantom requis");var r=await sol.connect({onlyIfTrusted:false});return r.publicKey.toString()}async function vaultCreate(owner){var r=await fetch("/wolverine/vault/api/vault/create",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({owner:owner})});if(!r.ok)throw new Error("Vault create HTTP "+r.status);var j=await r.json();if(!j||!j.ok||!j.vaultPub)throw new Error("Vault create invalid");return j}async function sendSol(ownerPubStr,vaultPubStr,lamports){if(!window.solanaWeb3)throw new Error("solanaWeb3 manquant");var sol=window.solana;var w3=window.solanaWeb3;var owner=new w3.PublicKey(ownerPubStr);var vault=new w3.PublicKey(vaultPubStr);var cx=new w3.Connection("/wolverine/solana-rpc","confirmed");var bh=await cx.getLatestBlockhash("confirmed");var ix=w3.SystemProgram.transfer({fromPubkey:owner,toPubkey:vault,lamports:lamports});var msg=new w3.TransactionMessage({payerKey:owner,recentBlockhash:bh.blockhash,instructions:[ix]}).compileToV0Message();var tx=new w3.VersionedTransaction(msg);setS("Signature Phantom...");var signed=await sol.signTransaction(tx);setS("Envoi...");var sig=await cx.sendRawTransaction(signed.serialize(),{skipPreflight:false,maxRetries:3});await cx.confirmTransaction({signature:sig,...bh},"confirmed");return sig}async function run(){try{setS("Connexion wallet...");var owner=await getWallet();$("aquilaWallet").textContent=owner;var lam=toLamports($("aquilaBudget").value);if(!lam){setS("Budget invalide");return}var solVal=(lam/1e9).toFixed(9).replace(/0+$/,"").replace(/\.$/,"");var ok=confirm("Aquila\\n\\nCréer Vault + Déposer "+solVal+" SOL ?");if(!ok){setS("Annulé");return}setS("Création Vault...");var v=await vaultCreate(owner);$("aquilaVault").textContent=v.vaultPub;setS("Transfert SOL...");var sig=await sendSol(owner,v.vaultPub,lam);setS("Succès: "+sig)}catch(e){setS("Erreur: "+((e&&e.message)?e.message:String(e)))} }var btn=$("aquilaGo");if(btn)btn.addEventListener("click",function(){run()});})();</script>'''
  if "</body>" in s:

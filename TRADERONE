cat >/root/WOLVERINE_ROLLBACK_FRONT_CLEAN.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "===== WOLVERINE FRONTEND CLEAN ROLLBACK ====="

# 1. Trouver le dernier savepoint
SAVEPOINT=$(ls -d /root/WOLVERINE_SAVEPOINT_* 2>/dev/null | sort | tail -n 1)
if [ -z "$SAVEPOINT" ]; then
  echo "❌ Aucun savepoint trouvé"
  exit 1
fi

echo "✅ Savepoint utilisé : $SAVEPOINT"

# 2. Arrêt services
systemctl stop nginx || true

# 3. Suppression frontend actuel (cassé)
rm -rf /var/www/wolverine

# 4. Restauration frontend sain
cp -a "$SAVEPOINT/frontend_wolverine" /var/www/wolverine

# 5. Permissions propres
chown -R www-data:www-data /var/www/wolverine
chmod -R 755 /var/www/wolverine

# 6. Purge cache nginx
rm -rf /var/cache/nginx/* || true

# 7. Reload nginx
nginx -t
systemctl start nginx

echo
echo "✅ ROLLBACK FRONTEND TERMINÉ"
echo "➡️ Recharge avec CTRL + SHIFT + R"
echo "➡️ Le SOL DOIT réapparaître"
BASH

chmod +x /root/WOLVERINE_ROLLBACK_FRONT_CLEAN.sh
/root/WOLVERINE_ROLLBACK_FRONT_CLEAN.sh
cat >/tmp/WOLVERINE_BEST_FIX_ALL.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/fireinners/wolverine/index.html"
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"

BOT="$(systemctl show traderone.service -p Environment --value | tr ' ' '\n' | sed -n 's/^TRADERONE_BOT_WALLET=//p')"
[ -n "${BOT:-}" ] || { echo "ERR: TRADERONE_BOT_WALLET vide"; exit 1; }

echo "BOT=$BOT"

cp -a "$HTML"  "$HTML.bak.$TS"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backups: $HTML.bak.$TS  |  $APPJS.bak.$TS"

echo
echo "== 1) Fix tAddr (BOT address) in index.html =="
perl -i -pe 's|(<span id="tAddr">)(.*?)(</span>)|$1'"$BOT"'$3|g' "$HTML"
grep -n 'id="tAddr"' "$HTML" | head -n 2 || true

echo
echo "== 2) Clean old injected blocks in app.js =="
perl -0777 -i -pe 's|/\*\s*WOLVERINE_CONNECT_FIX_BEGIN\s*\*/.*?/\*\s*WOLVERINE_CONNECT_FIX_END\s*\*/\s*||sg' "$APPJS" || true
perl -0777 -i -pe 's|/\*\s*WOLVERINE_BALANCES_FIX_BEGIN\s*\*/.*?/\*\s*WOLVERINE_BALANCES_FIX_END\s*\*/\s*||sg' "$APPJS" || true
perl -0777 -i -pe 's|/\*\s*WOLVERINE_START_FIX_BEGIN\s*\*/.*?/\*\s*WOLVERINE_START_FIX_END\s*\*/\s*||sg' "$APPJS" || true

echo
echo "== 3) Append BEST front handlers (Connect + Refresh + Start) =="
cat >> "$APPJS" <<'JS'

/* WOLVERINE_CONNECT_FIX_BEGIN */
(function(){
  const btn = document.getElementById("btnConnect");
  const after = document.getElementById("afterConnect");
  const btnStart = document.getElementById("btnStart");
  const statusEl = document.getElementById("statusText") || document.getElementById("status");

  function setStatus(t){
    try { if(statusEl) statusEl.textContent = t; } catch(e) {}
    console.log("[STATUS]", t);
  }
  window.setStatus = window.setStatus || setStatus;

  if(!btn){ console.log("btnConnect not found"); return; }

  btn.onclick = async () => {
    try {
      if (!window.solana || !window.solana.isPhantom) { setStatus("Phantom non détecté"); return; }
      const r = await window.solana.connect();
      window.pubkey = r.publicKey;
      if (after) after.style.display = "block";
      if (btnStart) btnStart.disabled = false;
      setStatus("Wallet connectée ✅ " + window.pubkey.toString());
      if (typeof window.refreshBoth === "function") await window.refreshBoth();
    } catch (e) {
      console.error(e);
      setStatus("ERR " + (e?.message || e));
    }
  };
})();
/* WOLVERINE_CONNECT_FIX_END */

/* WOLVERINE_BALANCES_FIX_BEGIN */
(function(){
  const $ = (id)=>document.getElementById(id);

  const uSol  = $("uSol");
  const uUsdc = $("uUsdc");
  const tAddr = $("tAddr");
  const tSol  = $("tSol");
  const tUsdc = $("tUsdc");
  const btnRefresh = $("btnRefresh");
  const statusEl = $("statusText") || $("status");

  function setStatus(t){
    try { if (statusEl) statusEl.textContent = t; } catch(e){}
    console.log("[STATUS]", t);
  }
  window.setStatus = window.setStatus || setStatus;

  function getUserWallet(){
    return (window.pubkey && window.pubkey.toString) ? window.pubkey.toString()
         : (typeof pubkey !== "undefined" && pubkey && pubkey.toString) ? pubkey.toString()
         : "";
  }

  async function fetchBalances(wallet){
    const r = await fetch(`/wolverine/traderone/api/balances2?wallet=${encodeURIComponent(wallet)}`);
    const txt = await r.text();
    if(!r.ok) throw new Error("balances2 HTTP " + r.status + " " + txt.slice(0,160));
    try { return JSON.parse(txt); } catch(e){ throw new Error("balances2 bad JSON: " + txt.slice(0,160)); }
  }

  window.refreshBoth = async function refreshBoth(){
    try{
      const userWallet = getUserWallet();
      const botWallet = (tAddr && tAddr.textContent || "").trim();
      if(!botWallet || botWallet === "—") { setStatus("ERR: adresse BOT vide"); return; }

      const bot = await fetchBalances(botWallet);
      const botSol  = Number(bot?.user?.sol  ?? bot?.sol  ?? 0);
      const botUsdc = Number(bot?.user?.usdc ?? bot?.usdc ?? 0);
      if (tSol)  tSol.textContent  = botSol.toFixed(6);
      if (tUsdc) tUsdc.textContent = botUsdc.toFixed(4);

      if(userWallet){
        const usr = await fetchBalances(userWallet);
        const usrSol  = Number(usr?.user?.sol  ?? usr?.sol  ?? 0);
        const usrUsdc = Number(usr?.user?.usdc ?? usr?.usdc ?? 0);
        if (uSol)  uSol.textContent  = usrSol.toFixed(6);
        if (uUsdc) uUsdc.textContent = usrUsdc.toFixed(4);
      } else {
        if (uSol)  uSol.textContent  = "—";
        if (uUsdc) uUsdc.textContent = "—";
      }

      setStatus("OK");
    } catch(e){
      console.error(e);
      setStatus("ERR " + (e?.message || e));
    }
  };

  if(btnRefresh) btnRefresh.onclick = () => window.refreshBoth();
  window.addEventListener("load", () => { window.refreshBoth(); });
})();
/* WOLVERINE_BALANCES_FIX_END */

/* WOLVERINE_START_FIX_BEGIN */
(function(){
  const btnStart = document.getElementById("btnStart");
  const budgetEl = document.getElementById("budget");
  const statusEl = document.getElementById("statusText") || document.getElementById("status");
  function setStatus(t){
    try { if(statusEl) statusEl.textContent = t; } catch(e) {}
    console.log("[STATUS]", t);
  }
  window.setStatus = window.setStatus || setStatus;

  if (!btnStart || !budgetEl) return;

  btnStart.onclick = async () => {
    try {
      if (!window.pubkey) { setStatus("Connecte d'abord ton wallet"); return; }
      const b = Number(budgetEl.value);
      if (!isFinite(b) || b <= 0) { setStatus("Budget invalide"); return; }

      setStatus("START en cours...");
      const r = await fetch("/wolverine/traderone/api/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ wallet: window.pubkey.toString(), budget: b })
      });

      const txt = await r.text();
      let j = null; try { j = JSON.parse(txt); } catch(e) {}

      if (!r.ok) {
        const msg = (j && j.error)
          ? `${j.error} (botUsdc=${j.botUsdc ?? "?"}, needed=${j.needed ?? b})`
          : txt.slice(0,200);
        setStatus("REFUSÉ ❌ " + msg);
        console.log("START refused:", r.status, j || txt);
        return;
      }

      setStatus("START OK ✅");
      console.log("START ok:", j || txt);
      if (typeof window.refreshBoth === "function") await window.refreshBoth();
    } catch (e) {
      setStatus("ERR " + (e?.message || e));
    }
  };
})();
/* WOLVERINE_START_FIX_END */

JS

echo
echo "DONE ✅ -> Ctrl+F5 sur https://fireinners.online/wolverine/ puis Connect + Refresh + Start"
SH

bash /tmp/WOLVERINE_BEST_FIX_ALL.sh
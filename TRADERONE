cat >/root/MEGA_AQUILATRADER_FIX_404_V2.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }
hr(){ echo "------------------------------------------------------------"; }

DOMAIN="fireinners.online"
WWW="/var/www/aquilatrader"
INDEX="$WWW/index.html"

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_static.inc"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_AQUILATRADER_${TS}"
mkdir -p "$BK"

say "MEGA_AQUILATRADER_FIX_404_V2"
say "Goal: https://${DOMAIN}/aquilatrader/ serves ${INDEX} (idempotent, no manual edits)"
hr

say "0) Preflight: check nginx files exist"
[ -f "$VHOST" ] || die "Missing vhost: $VHOST"
[ -f "$INC" ] || die "Missing include: $INC"

say "0b) Backup nginx files"
cp -a "$VHOST" "$BK/$(basename "$VHOST").bak"
cp -a "$INC"   "$BK/$(basename "$INC").bak"

say "0c) Unlock (if immutable) to allow edits"
chattr -i "$VHOST" 2>/dev/null || true
chattr -i "$INC"   2>/dev/null || true

hr
say "1) Ensure AquilaTrader webroot + index"
mkdir -p "$WWW"
if [ ! -f "$INDEX" ]; then
  say "Writing $INDEX"
  cat >"$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>AquilaTrader</title>
  <style>
    body{font-family:system-ui,Segoe UI,Roboto,Arial;margin:0;background:#0b1020;color:#fff}
    .c{max-width:900px;margin:20px auto;padding:16px}
    a{color:#7ab7ff}
  </style>
</head>
<body>
  <div class="c">
    <h1>AquilaTrader</h1>
    <p>OK — route active.</p>
    <ul>
      <li><a href="/wolverine/traderone/api/health">TraderOne API health</a></li>
      <li><a href="/wolverine/traderone/vault/health">TraderOne Vault health</a></li>
    </ul>
  </div>
</body>
</html>
HTML
fi

hr
say "2) Clean duplicates then add ONE managed /aquilatrader/ location (in $INC)"
python3 - <<'PY'
import re, pathlib

inc_path = pathlib.Path("/etc/nginx/includes/wolverine_static.inc")
txt = inc_path.read_text(encoding="utf-8", errors="ignore")

# Remove any previous managed blocks
txt = re.sub(r"\n?\s*#\s*BEGIN_AQUILATRADER_MANAGED.*?#\s*END_AQUILATRADER_MANAGED\s*\n?",
             "\n", txt, flags=re.S)

# Also remove any stray location blocks for /aquilatrader (best-effort)
txt = re.sub(r"\n?\s*location\s+\^~\s+/aquilatrader/?\s*\{.*?\}\s*\n?",
             "\n", txt, flags=re.S)

txt = txt.rstrip() + "\n\n" + (
"# BEGIN_AQUILATRADER_MANAGED\n"
"location ^~ /aquilatrader/ {\n"
"  alias /var/www/aquilatrader/;\n"
"  try_files $uri $uri/ /aquilatrader/index.html;\n"
"  add_header Cache-Control \"no-store\" always;\n"
"}\n"
"# END_AQUILATRADER_MANAGED\n"
)

inc_path.write_text(txt, encoding="utf-8")
print("OK: updated", str(inc_path))
PY

hr
say "3) Ensure vhost has NO duplicate /aquilatrader blocks (clean only)"
python3 - <<'PY'
import re, pathlib
vhost_path = pathlib.Path("/etc/nginx/sites-available/fireinners.online-ssl")
txt = vhost_path.read_text(encoding="utf-8", errors="ignore")

txt2 = re.sub(r"\n?\s*#\s*BEGIN_AQUILATRADER_MANAGED.*?#\s*END_AQUILATRADER_MANAGED\s*\n?",
              "\n", txt, flags=re.S)
txt2 = re.sub(r"\n?\s*location\s+\^~\s+/aquilatrader/?\s*\{.*?\}\s*\n?",
              "\n", txt2, flags=re.S)

if txt2 != txt:
  vhost_path.write_text(txt2, encoding="utf-8")
  print("OK: cleaned duplicates in", str(vhost_path))
else:
  print("OK: no /aquilatrader blocks found in vhost (no-op)")
PY

hr
say "4) nginx -t then reload (rollback if nginx -t fails)"
set +e
nginx -t
RC=$?
set -e
if [ "$RC" -ne 0 ]; then
  say "nginx -t FAILED -> rollback backups"
  cp -a "$BK/$(basename "$VHOST").bak" "$VHOST" || true
  cp -a "$BK/$(basename "$INC").bak"   "$INC"   || true
  nginx -t || true
  die "Rollback done. Fix not applied. Backup folder: $BK"
fi

systemctl reload nginx

say "4b) Re-lock (optional) if you want immutability"
# chattr +i "$VHOST" 2>/dev/null || true
# chattr +i "$INC"   2>/dev/null || true

hr
say "5) Quick local checks (HTTPS localhost + Host header)"
curl -sk "https://127.0.0.1/aquilatrader/" -H "Host: ${DOMAIN}" | head -n 12 || true
hr
say "DONE. Open: https://${DOMAIN}/aquilatrader/"
say "Backup: $BK"
BASH

bash /root/MEGA_AQUILATRADER_FIX_404_V2.sh |& tee /root/MEGA_AQUILATRADER_FIX_404_V2.log
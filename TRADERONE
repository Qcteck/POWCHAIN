:root{
  --bg:#06070a;
  --panel:#0d1017;
  --line:#1f2633;
  --txt:#e9eef7;
  --muted:#9aa7bd;
  --accent:#57d4ff;
}

*{box-sizing:border-box}

body{
  margin:0;
  font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;
  background:radial-gradient(1200px 800px at 20% 10%, #0b1230 0%, var(--bg) 55%);
  color:var(--txt);
}

.wrap{
  max-width:980px;
  margin:0 auto;
  padding:18px;
}

header{
  border:1px solid var(--line);
  background:linear-gradient(180deg,#0b1020,#070a12);
  padding:14px 14px 10px;
  border-radius:14px;
}

h1{
  margin:0;
  font-size:20px;
  letter-spacing:.5px;
}

.sub{
  margin-top:4px;
  color:var(--muted);
  font-size:13px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:12px;
  margin-top:12px;
}

@media (max-width:820px){
  .grid{grid-template-columns:1fr}
}

.card{
  border:1px solid var(--line);
  background:var(--panel);
  border-radius:14px;
  padding:12px;
}

.card h2{
  margin:0 0 10px;
  font-size:14px;
  color:#cfe7ff;
  font-weight:700;
}

.row{
  display:flex;
  justify-content:space-between;
  gap:12px;
  padding:7px 0;
  border-top:1px dashed #1a2230;
}

.row:first-of-type{border-top:0}

.k{color:var(--muted)}

.v{font-variant-numeric:tabular-nums}

.times{
  display:grid;
  grid-template-columns:1fr;
  gap:6px;
  margin-top:10px;
}

.pill{
  display:flex;
  justify-content:space-between;
  gap:10px;
  padding:8px 10px;
  border:1px solid #1a2230;
  border-radius:12px;
  background:#0a0d15;
}

.pill b{color:#cfe7ff}

.controls{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  align-items:center;
  margin-top:12px;
}

button{
  cursor:pointer;
  border:1px solid #233149;
  background:#0b1222;
  color:var(--txt);
  padding:10px 12px;
  border-radius:12px;
}

button:hover{border-color:#35507a}

.toggle{
  display:flex;
  align-items:center;
  gap:10px;
  border:1px solid #233149;
  background:#0b1222;
  padding:8px 12px;
  border-radius:12px;
}

.toggle input{
  width:18px;
  height:18px;
}

.note{
  margin-top:10px;
  color:var(--muted);
  font-size:12px;
  line-height:1.35;
}

.alert{
  margin-top:12px;
  border:1px solid #2a2f3d;
  background:#0a0d15;
  padding:10px 12px;
  border-radius:12px;
}

.alert b{color:var(--accent)}

.footer{
  margin-top:10px;
  color:var(--muted);
  font-size:12px;
}

.mini{
  font-size:12px;
  color:var(--muted);
}

.live{
  color:var(--accent);
  font-weight:700;
}
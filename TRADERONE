set -e
cd /root

echo "=== 1) Stop / delete traderone (si existe) ==="
pm2 delete traderone 2>/dev/null || true

echo
echo "=== 2) Trouver le vrai server.js (pas .bak) ==="
REAL="$(ls -1 /opt/traderone-opt/server.js 2>/dev/null | head -n1 || true)"
if [ -z "$REAL" ]; then
  echo "Pas de /opt/traderone-opt/server.js. Liste du dossier:"
  ls -lah /opt/traderone-opt | head -n 80
  exit 1
fi
echo "REAL=$REAL"

echo
echo "=== 3) Start TraderOne sur 3000 ==="
PORT=3000 HOST=127.0.0.1 pm2 start "$REAL" --name traderone --update-env

sleep 1
echo
echo "=== 4) Check port 3000 ==="
ss -lptn 'sport = :3000' || true
lsof -nP -iTCP:3000 -sTCP:LISTEN || true

echo
echo "=== 5) Logs traderone (si 3000 n'écoute pas) ==="
pm2 logs traderone --lines 60 || true

echo
echo "=== 6) Test local direct ==="
curl -sS -i "http://127.0.0.1:3000/api/status" | head -n 40 || true
curl -sS -i -X POST "http://127.0.0.1:3000/api/status" -H "content-type: application/json" --data '{}' | head -n 40 || true

echo
echo "=== 7) Test gateway Wolverine (doit arrêter proxy_fail) ==="
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" \
  -H "content-type: application/json" --data '{}' | head -n 60 || true
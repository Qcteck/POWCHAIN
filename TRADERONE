function proxy(req,res,real){const o={host:real.host,port:real.port,path:req.originalUrl,method:req.method,headers:{...req.headers,host:req.headers.host||"127.0.0.1"}};const pr=http.request(o,rr=>{res.status(rr.statusCode||502);Object.entries(rr.headers||{}).forEach(([k,v])=>{try{if(v!==undefined)res.setHeader(k,v);}catch(e){}});rr.pipe(res);});pr.on("error",()=>res.status(502).json({ok:false,error:"proxy_failed",real}));if(req.method!=="GET"&&req.method!=="HEAD")pr.write(JSON.stringify(req.body||{}));pr.end();}
app.get("/health",(req,res)=>detect((_,real)=>res.json({ok:true,service:"traderone-api",wrap_port:WRAP_PORT,real_backend:real||null,ts:Date.now()})));

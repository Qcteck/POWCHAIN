import express from "express";
import nacl from "tweetnacl";
import { PublicKey } from "@solana/web3.js";

const app = express();
app.use(express.json({ limit: "256kb" }));

const nonces = new Map();
const TTL = 5 * 60 * 1000;

app.get("/health", (req, res) => res.json({ ok: true, service: "phantom-auth" }));

function makeChallenge(pubkey) {
  const nonce = Math.random().toString(36).slice(2) + "-" + Date.now();
  const message =
    "fireinners.online login\n" +
    `pubkey: ${pubkey}\n` +
    `nonce: ${nonce}\n` +
    `ts: ${new Date().toISOString()}\n`;
  nonces.set(pubkey, { message, createdAt: Date.now() });
  return message;
}

function verifySignature({ pubkey, message, signature }) {
  const saved = nonces.get(pubkey);
  if (!saved) return { ok: false, status: 401, error: "no challenge" };
  if (saved.message !== message) return { ok: false, status: 401, error: "message mismatch" };
  if (Date.now() - saved.createdAt > TTL) return { ok: false, status: 401, error: "challenge expired" };

  let sigBytes;
  try {
    if (Array.isArray(signature)) sigBytes = Uint8Array.from(signature);
    else if (typeof signature === "string") sigBytes = Uint8Array.from(Buffer.from(signature, "base64"));
    else return { ok: false, status: 400, error: "signature must be array or base64 string" };
  } catch {
    return { ok: false, status: 400, error: "bad signature format" };
  }

  try {
    const pk = new PublicKey(pubkey);
    const msgBytes = new TextEncoder().encode(message);
    const ok = nacl.sign.detached.verify(msgBytes, sigBytes, pk.toBytes());
    if (!ok) return { ok: false, status: 401, error: "bad signature" };
    nonces.delete(pubkey);
    return { ok: true, status: 200 };
  } catch (e) {
    return { ok: false, status: 400, error: "invalid pubkey / verify error", details: String(e?.message || e) };
  }
}

/**
 * CLEAN ROUTES (what your UI should use)
 *  - GET  /phantom/challenge?pubkey=...
 *  - POST /phantom/verify
 */
app.get("/phantom/challenge", (req, res) => {
  const pubkey = String(req.query.pubkey || "").trim();
  if (!pubkey) return res.status(400).json({ error: "missing pubkey" });
  return res.json({ message: makeChallenge(pubkey) });
});

app.post("/phantom/verify", (req, res) => {
  const { pubkey, message, signature } = req.body || {};
  if (!pubkey || !message || !signature) return res.status(400).json({ error: "missing fields (pubkey,message,signature)" });

  const v = verifySignature({ pubkey, message, signature });
  if (!v.ok) return res.status(v.status).json({ error: v.error, details: v.details });

  return res.json({ ok: true, pubkey });
});

/**
 * LEGACY ROUTES (keep compatibility)
 *  - GET  /auth/phantom/challenge
 *  - POST /auth/phantom/verify
 */
app.get("/auth/phantom/challenge", (req, res) => {
  const pubkey = String(req.query.pubkey || "").trim();
  if (!pubkey) return res.status(400).json({ error: "missing pubkey" });
  return res.json({ message: makeChallenge(pubkey) });
});

app.post("/auth/phantom/verify", (req, res) => {
  const { pubkey, message, signature } = req.body || {};
  if (!pubkey || !message || !signature) return res.status(400).json({ error: "missing fields (pubkey,message,signature)" });

  const v = verifySignature({ pubkey, message, signature });
  if (!v.ok) return res.status(v.status).json({ error: v.error, details: v.details });

  return res.json({ ok: true, pubkey });
});

const port = Number(process.env.PORT || 3005);
app.listen(port, "127.0.0.1", () => console.log(`Phantom auth on 127.0.0.1:${port}`));
JS


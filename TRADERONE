cat >/root/verify_and_fix_api_now.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/traderone_api_proxy.conf"

echo "== 1) nginx -t (sanity) =="
nginx -t

echo "== 2) reload nginx =="
systemctl reload nginx
echo "[OK] reloaded"

echo
echo "== 3) show key nginx lines =="
nl -ba "$EN" | sed -n '1,80p' | grep -nE "server_name|include /etc/nginx/snippets/traderone_api_proxy.conf|location \^~ /wolverine/|location \^~ /wolverine/traderone/api/|location = /wolverine/traderone/api/health|try_files" || true

echo
echo "== 4) show snippet content (API proxy) =="
if [[ -f "$SNIP" ]]; then
  echo "--- $SNIP ---"
  sed -n '1,160p' "$SNIP"
else
  echo "[WARN] $SNIP missing"
fi

echo
echo "== 5) autodetect backend port (from your node ports) =="
PORT=""
for p in 3005 8484 8585 9696 12703 3000 3001 8080 8000 5000; do
  code="$(curl -s -o /tmp/h.$$ -w "%{http_code}" "http://127.0.0.1:$p/api/health" || true)"
  if [[ "$code" == "200" ]]; then
    head -c 80 /tmp/h.$$ | tr -d '\n' | grep -qv "<!DOCTYPE html" && PORT="$p" && break
  fi
done
rm -f /tmp/h.$$ 2>/dev/null || true
echo "PORT=${PORT:-NONE}"

echo
echo "== 6) public test (should NOT be HTML) =="
echo "-- headers:"
curl -sk -i "https://${DOMAIN}/wolverine/traderone/api/health" | sed -n '1,25p'
echo "-- body first 120 bytes:"
curl -sk "https://${DOMAIN}/wolverine/traderone/api/health" | head -c 120; echo

# If still HTML and we found a backend port, write/overwrite the snippet and reload.
BODY="$(curl -sk "https://${DOMAIN}/wolverine/traderone/api/health" | head -c 40 || true)"
if echo "$BODY" | grep -q "<!DOCTYPE html" && [[ -n "${PORT:-}" ]]; then
  echo
  echo "== 7) Still HTML -> write proper API proxy snippet and reload =="
  mkdir -p /etc/nginx/snippets
  cat >"$SNIP" <<NGINX
location = /wolverine/traderone/api/health {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:${PORT};
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";

  rewrite ^/wolverine/traderone/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:${PORT};
}
NGINX

  # ensure include exists
  if ! grep -q "traderone_api_proxy.conf" "$AV"; then
    sed -i '/server_name .*fireinners\.online/ a\  include /etc/nginx/snippets/traderone_api_proxy.conf;' "$AV"
  fi
  ln -sf "$AV" "$EN"

  nginx -t
  systemctl reload nginx
  echo "[OK] reloaded with API proxy"

  echo
  echo "== 8) public re-test =="
  curl -sk -i "https://${DOMAIN}/wolverine/traderone/api/health" | sed -n '1,25p'
  echo "-- body first 120 bytes:"
  curl -sk "https://${DOMAIN}/wolverine/traderone/api/health" | head -c 120; echo
fi

echo
echo "DONE ✅"
BASH

chmod +x /root/verify_and_fix_api_now.sh
/root/verify_and_fix_api_now.sh
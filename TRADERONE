#!/usr/bin/env bash
set -euo pipefail

need_root(){ [ "$(id -u)" -eq 0 ] || { echo "RUN AS ROOT"; exit 1; }; }
need_root

DOMAIN="${DOMAIN:-fireinners.online}"
ORIGIN_IP="${ORIGIN_IP:-72.61.79.12}"        # IP VPS attendu (bypass Cloudflare)
INC_DIR="/etc/nginx/includes"
INC_FILE="${INC_DIR}/bundler_routes.inc"

WEBROOT="/var/www/bundler"
API_DIR="/opt/bundler_api"
API_PORT="${API_PORT:-9797}"
API_HOST="${API_HOST:-127.0.0.1}"
SVC="/etc/systemd/system/bundler-api.service"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BUNDLER_FIX_${TS}"
mkdir -p "$BK"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

say "backup: $BK"
cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
cp -a /etc/systemd/system "$BK/systemd_system" 2>/dev/null || true
mkdir -p "$BK/www" && cp -a "$WEBROOT" "$BK/www/bundler" 2>/dev/null || true
mkdir -p "$BK/opt" && cp -a "$API_DIR" "$BK/opt/bundler_api" 2>/dev/null || true

say "nginx: extract active vhost for ${DOMAIN}"
NGT="$BK/nginx_T.txt"
nginx -T >"$NGT" 2>&1 || { tail -n 200 "$NGT" || true; exit 1; }

ACTIVE_SSL_FILE="$(python3 - <<PY
import re,sys
p=open("$NGT","r",errors="ignore").read().splitlines()
cur=None
blocks=[]
buf=[]
for ln in p:
  m=re.match(r'^# configuration file (.+?):', ln)
  if m: cur=m.group(1); continue
  if cur: blocks.append((cur, ln))
# parse server blocks roughly using brace depth on combined stream while tracking file
servers=[]
depth=0; in_server=False; s_lines=[]; s_file=None
def count_braces(s): return s.count('{'), s.count('}')
for f,ln in blocks:
  l=ln.strip()
  if l.startswith('#'): continue
  if not in_server:
    if re.search(r'\\bserver\\s*\\{', l):
      in_server=True; s_lines=[ln]; s_file=f
      ob,cb=count_braces(ln); depth=ob-cb
      continue
  else:
    s_lines.append(ln)
    ob,cb=count_braces(ln); depth += ob-cb
    if depth<=0:
      txt="\\n".join(s_lines)
      servers.append((s_file, txt))
      in_server=False; s_lines=[]; s_file=None; depth=0
      continue

dom=re.compile(r'\\bserver_name\\b[^;]*\\b'+re.escape("$DOMAIN")+r'\\b', re.I)
listen443=re.compile(r'\\blisten\\b[^;]*\\b443\\b[^;]*\\bssl\\b', re.I)

for f,txt in servers:
  if dom.search(txt) and listen443.search(txt):
    print(f); sys.exit(0)
print("")
PY
)"

ACTIVE_HTTP_FILE="$(python3 - <<PY

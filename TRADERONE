patch_backend_one () {
  local SRV="$1"
  python3 - <<PY
import re, pathlib, os
p=pathlib.Path(r"$SRV")
s=p.read_text(encoding="utf-8",errors="ignore")

marker="/* WOLV_CONFIRM_DEPOSIT_V2 */"
if marker in s:
  print("OK BACKEND already:", str(p))
  raise SystemExit(0)

# detect app var
app="app"
m=re.search(r'\\bconst\\s+(\\w+)\\s*=\\s*express\\(\\s*\\)\\s*;', s)
if m: app=m.group(1)

block=f"""
{marker}
const fs=require('fs');
const path=require('path');
const {{Connection,PublicKey}}=require('@solana/web3.js');
const WOLV_RPC=process.env.SOLANA_RPC||process.env.RPC_URL||"{RPC_DEFAULT}";
const WOLV_USDC_MINT="{USDC_MINT}";
const WOLV_LEDGER_DIR="/opt/traderone-opt/data";
const WOLV_LEDGER_FILE="/opt/traderone-opt/data/wolv_ledger.json";
function _wolvReadLedger(){{try{{return JSON.parse(fs.readFileSync(WOLV_LEDGER_FILE,'utf8')||'{{}}');}}catch(e){{return {{}};}}}}
function _wolvWriteLedger(o){{try{{fs.mkdirSync(WOLV_LEDGER_DIR,{{recursive:true}});fs.writeFileSync(WOLV_LEDGER_FILE,JSON.stringify(o,null,2));}}catch(e){{}}}}
function _num(x){{x=Number(x);return (isFinite(x)&&x>0)?x:0;}}

async function _confirmDeposit(pub,botAddr,asset,minAmount){{
  const conn=new Connection(WOLV_RPC,'confirmed');
  const bot=new PublicKey(botAddr);
  const user=new PublicKey(pub);
  const min=_num(minAmount);
  const sigs=await conn.getSignaturesForAddress(bot,{{limit:30}});
  for(const s of sigs){{
    const tx=await conn.getParsedTransaction(s.signature,{{maxSupportedTransactionVersion:0,commitment:'confirmed'}}).catch(()=>null);
    if(!tx||!tx.meta||!tx.transaction) continue;
    const keys=tx.transaction.message.accountKeys||[];
    const hasUser=keys.some(k=>String(k.pubkey||k)==pub);
    if(!hasUser) continue;

    if(asset==='SOL'){{
      const ixs=tx.transaction.message.instructions||[];
      for(const ix of ixs){{
        const p=ix.parsed;
        if(!p||p.type!=='transfer') continue;
        const info=p.info||{{}};
        if(info.source===pub && info.destination===botAddr){{
          const lam=Number(info.lamports||0);
          const sol=lam/1e9;
          if(sol+1e-12>=min) return {{confirmed:true,signature:s.signature,amount:sol,slot:tx.slot,blockTime:tx.blockTime||null}};
        }}
      }}
    }} else if(asset==='USDC') {{
      const pre=tx.meta.preTokenBalances||[];
      const post=tx.meta.postTokenBalances||[];
      let botDelta=0.0, userDelta=0.0;
      function amt(e){{try{{return Number(e.uiTokenAmount.uiAmountString||e.uiTokenAmount.uiAmount||0);}}catch(_e){{return 0;}}}}
      const byIdxPre={{}};
      for(const e of pre) if(e.mint===WOLV_USDC_MINT) byIdxPre[e.accountIndex]=e;
      for(const e of post){{
        if(e.mint!==WOLV_USDC_MINT) continue;
        const a0=byIdxPre[e.accountIndex];
        const d=amt(e)-amt(a0);
        const owner=e.owner||"";
        if(owner===botAddr) botDelta+=d;
        if(owner===pub) userDelta+=d;
      }}
      if(botDelta>=min-1e-9 && userDelta<=-(min-1e-9)) {{
        return {{confirmed:true,signature:s.signature,amount:botDelta,slot:tx.slot,blockTime:tx.blockTime||null}};
      }}
    }}
  }}
  return {{confirmed:false}};
}}

{app}.post('/api/confirm_deposit_v2', async (req,res)=>{{
  try{{
    const pub=String((req.body&&req.body.pub)||"").trim();
    const botAddr=String((req.body&&req.body.botAddr)||"").trim();
    const asset=String((req.body&&req.body.asset)||"SOL").toUpperCase();
    const minAmount=req.body&&req.body.minAmount;
    if(!pub) return res.status(200).json({{ok:false,error:"missing pub"}});
    if(!botAddr) return res.status(200).json({{ok:false,error:"missing botAddr"}});
    if(asset!=="SOL" && asset!=="USDC") return res.status(200).json({{ok:false,error:"asset must be SOL or USDC"}});
    const r=await _confirmDeposit(pub,botAddr,asset,minAmount);
    if(r.confirmed){{
      const L=_wolvReadLedger();
      L[pub]=L[pub]||{{deposits:[]}};
      if(!Array.isArray(L[pub].deposits)) L[pub].deposits=[];
      if(!L[pub].deposits.find(x=>x && x.signature===r.signature)) {{
        L[pub].deposits.push({{signature:r.signature,asset,amount:r.amount,slot:r.slot,blockTime:r.blockTime,ts:Date.now()}});
      }}
      _wolvWriteLedger(L);
    }}
    return res.status(200).json({{ok:true,...r}});
  }}catch(e){{
    return res.status(200).json({{ok:false,error:String(e&&e.message||e)}});
  }}
}});
/* END WOLV_CONFIRM_DEPOSIT_V2 */
"""

# insert before listen if possible
idx=s.rfind(".listen(")
if idx!=-1:
  s=s[:idx]+block+"\\n"+s[idx:]
else:
  s+="\\n"+block+"\\n"
p.write_text(s,encoding="utf-8")
print("OK BACKEND:", str(p))
PY
}


#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== ADD SOL + USDC BALANCES (WOLVERINE) ==="

[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

# Backup
cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup créé: ${HTML}.bak_${TS}"

# 1) Ajouter zone d’affichage soldes
sed -i '/PHANTOM_ADDR/a \
<div id="BALANCES" style="margin-top:10px;font-size:13px">\
  <div>SOL : <span id="BAL_SOL">—</span></div>\
  <div>USDC : <span id="BAL_USDC">—</span></div>\
</div>' "$HTML"

# 2) Charger Solana web3.js (local CDN OK pour test)
sed -i '/<\/head>/i \
<script src="https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js"></script>' "$HTML"

# 3) Injecter JS balances
sed -i '/<\/body>/i \
<script>\
document.addEventListener("DOMContentLoaded",()=>{\
  const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";\
  const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";\
  const balSol=document.getElementById("BAL_SOL");\
  const balUsdc=document.getElementById("BAL_USDC");\
  const addr=document.getElementById("PHANTOM_ADDR");\
  \
  async function loadBalances(pub){\
    const conn=new solanaWeb3.Connection(RPC,"confirmed");\
    const lamports=await conn.getBalance(pub);\
    balSol.textContent=(lamports/1e9).toFixed(6);\
    \
    const accs=await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)});\
    let usdc=0;\
    accs.value.forEach(a=>{usdc+=a.account.data.parsed.info.tokenAmount.uiAmount||0});\
    balUsdc.textContent=usdc.toFixed(2);\
  }\
  \
  const btn=document.getElementById("PHANTOM_CONNECT_BTN");\
  if(btn){\
    const old=btn.onclick;\
    btn.onclick=async()=>{\
      await old();\
      if(addr && addr.textContent && addr.textContent.length>30){\
        loadBalances(new solanaWeb3.PublicKey(addr.textContent));\
      }\
    };\
  }\
});\
</script>' "$HTML"

echo "✅ SOLDES SOL + USDC AJOUTÉS"
echo "➡️ CTRL + F5 obligatoire"
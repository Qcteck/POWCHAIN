bash <<'EOF'
set -e
echo "==============================="
echo "WOLVERINE • KILL AUTO-REVERT"
echo "==============================="

# 1) Stop TOUT ce qui peut servir du front
echo "[1/7] Stop nginx + node + vite"
systemctl stop nginx || true
pkill -f node || true
pkill -f vite || true

# 2) Supprimer TOUS service workers potentiels
echo "[2/7] Remove service workers"
find /opt -type f \( -name "service-worker.js" -o -name "sw.js" \) -print -delete || true

# 3) Supprimer caches front connus
echo "[3/7] Remove frontend caches"
rm -rf /opt/fireinners/**/node_modules/.cache || true
rm -rf /opt/fireinners/**/dist/.vite || true
rm -rf /var/cache/nginx || true

# 4) Forcer UN SEUL dossier servi
UI_SRC="/opt/fireinners/wolverine/dist"
UI_SERVED="/opt/fireinners/frontend-react/app/dist/wolverine"

echo "[4/7] Force single UI source"
rm -rf "$UI_SERVED"
mkdir -p "$UI_SERVED"
cp -a "$UI_SRC/"* "$UI_SERVED/"
chown -R www-data:www-data "$UI_SERVED"

# 5) Ajouter headers NO-CACHE (brutal)
echo "[5/7] Inject no-cache headers"
CONF="/etc/nginx/snippets/wolverine_nocache.conf"
cat > "$CONF" <<'NG'
add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
add_header Pragma "no-cache" always;
add_header Expires "0" always;
NG

# 6) Relancer nginx PROPRE
echo "[6/7] Start nginx"
systemctl start nginx

# 7) Info
echo "[7/7] DONE"
echo "➡️ OUVRE EN NAVIGATION PRIVÉE"
echo "➡️ OU VIDE LE CACHE COMPLET DU NAVIGATEUR"
echo "==============================="
EOF
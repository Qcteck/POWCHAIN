chmod 600 "$ENVF" || true

# package.json
PKG='{"name":"wolverine-api","version":"1.0.0","type":"commonjs","main":"server.js","license":"UNLICENSED","dependencies":{"express":"^4.19.2","dotenv":"^16.4.5","bs58":"^5.0.0","@solana/web3.js":"^1.98.0","@solana/spl-token":"^0.4.9"}}'
askorupdate_file "$APPDIR/package.json" "WOLVERINE package.json" "$PKG"

# server.js
read -r -d "" SVR <<'"'"'JS'"'"'
"use strict";
require("dotenv").config();
const fs=require("fs");
const path=require("path");
const express=require("express");
const bs58=require("bs58");
const {Connection,Keypair,PublicKey,VersionedTransaction,LAMPORTS_PER_SOL}=require("@solana/web3.js");
const spl=require("@solana/spl-token");

const PORT=+(process.env.PORT||3050);
const BASE_PATH=process.env.BASE_PATH||"/wolverine";
const RPC_URL=process.env.RPC_URL||"https://api.mainnet-beta.solana.com";
const USDC_MINT=new PublicKey(process.env.USDC_MINT||"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");
const WSOL_MINT=new PublicKey(process.env.WSOL_MINT||"So11111111111111111111111111111111111111112");
const JUP_BASE=process.env.JUP_BASE||"https://quote-api.jup.ag";
const SLIPPAGE_BPS=+(process.env.SLIPPAGE_BPS||150);
const ARM_PHRASE=process.env.ARM_PHRASE||"WOLVERINE";

const MONITOR_URL=process.env.MONITOR_URL||"";
const MONITOR_SEC=+(process.env.MONITOR_SEC||0);
const MONITOR_FAILS=+(process.env.MONITOR_FAILS||3);
const TG_ALERTS=+(process.env.TG_ALERTS||0);
const WOLV_SEND=process.env.WOLV_SEND||"";

const APPDIR=__dirname;
const STATE=path.join(APPDIR,"state");
const WALLET_JSON=path.join(STATE,"custody.json");
const WALLET_PUB=path.join(STATE,"custody.pub");
const SESS_JSON=path.join(STATE,"session.json");

fs.mkdirSync(STATE,{recursive:true});

function now(){return new Date().toISOString();}
function jread(p,def){try{return JSON.parse(fs.readFileSync(p,"utf8"));}catch{return def;}}
function jwrite(p,obj){fs.writeFileSync(p,JSON.stringify(obj,null,2));}
function sendTG(txt){
  if(!TG_ALERTS) return;
  if(!WOLV_SEND) return;
  try{require("child_process").execFileSync(WOLV_SEND,[txt],{stdio:"ignore"});}catch{}
}

function loadOrGenKeypair(){
  try{
    const a=jread(WALLET_JSON,null);
    if(a && Array.isArray(a) && a.length===64){
      const kp=Keypair.fromSecretKey(Uint8Array.from(a));
      fs.writeFileSync(WALLET_PUB,kp.publicKey.toBase58());
      return kp;
    }
  }catch{}
  const kp=Keypair.generate();
  jwrite(WALLET_JSON,Array.from(kp.secretKey));
  fs.chmodSync(WALLET_JSON,0o600);
  fs.writeFileSync(WALLET_PUB,kp.publicKey.toBase58());
  return kp;
}

const custody=loadOrGenKeypair();
const conn=new Connection(RPC_URL,{commitment:"confirmed"});

let session=jread(SESS_JSON,{
  active:false,
  ownerPubkey:"",
  tokenMint:"",
  budgetUSDC:0,
  perTradeUSDC:5,
  intervalSec:30,
  spentUSDC:0,
  mode:"DCA",
  startedAt:"",
  lastSig:"",
  lastErr:"",
  trades:[]
});

function saveSession(){ try{ jwrite(SESS_JSON,session); }catch{} }

let cached={ts:0,data:null};
async function getBalances(tokenMintStr){
  const t=Date.now();
  if(cached.data && (t-cached.ts)<2500) return cached.data;
  let sol=0,usdc=0,tok=0;
  try{ sol=await conn.getBalance(custody.publicKey); }catch{}
  try{
    const atas=await conn.getParsedTokenAccountsByOwner(custody.publicKey,{mint:USDC_MINT});
    for(const it of atas.value){
      const ui=it.account.data.parsed.info.tokenAmount.uiAmount||0;
      usdc+=ui;
    }
  }catch{}
  if(tokenMintStr){
    try{
      const mint=new PublicKey(tokenMintStr);
      const atas=await conn.getParsedTokenAccountsByOwner(custody.publicKey,{mint});
      for(const it of atas.value){
        const ui=it.account.data.parsed.info.tokenAmount.uiAmount||0;
        tok+=ui;
      }
    }catch{}
  }
  cached={ts:t,data:{solLamports:sol,sol:sol/LAMPORTS_PER_SOL,usdc,token:tok}};
  return cached.data;
}

async function jupQuote(inputMint,outputMint,amountRaw){
  const url=new URL(JUP_BASE.replace(/\/$/,"")+"/v6/quote");
  url.searchParams.set("inputMint",inputMint.toBase58());
  url.searchParams.set("outputMint",outputMint.toBase58());
  url.searchParams.set("amount",String(amountRaw));
  url.searchParams.set("slippageBps",String(SLIPPAGE_BPS));
  url.searchParams.set("swapMode","ExactIn");
  const r=await fetch(url,{headers:{"accept":"application/json"},cache:"no-store"});
  if(!r.ok) throw new Error("quote_http_"+r.status);
  return await r.json();
}
async function jupSwap(quote,wrapUnwrapSOL=true){
  const url=JUP_BASE.replace(/\/$/,"")+"/v6/swap";
  const body={
    quoteResponse:quote,
    userPublicKey:custody.publicKey.toBase58(),
    wrapAndUnwrapSol:wrapUnwrapSOL,
    dynamicComputeUnitLimit:true,
    prioritizationFeeLamports:"auto"
  };
  const r=await fetch(url,{method:"POST",headers:{"content-type":"application/json","accept":"application/json"},body:JSON.stringify(body),cache:"no-store"});
  if(!r.ok) throw new Error("swap_http_"+r.status);
  return await r.json();
}

async function signSendBase64Tx(b64){
  const buf=Buffer.from(b64,"base64");
  const tx=VersionedTransaction.deserialize(buf);
  tx.sign([custody]);
  const sig=await conn.sendRawTransaction(tx.serialize(),{skipPreflight:false,maxRetries:3});
  await conn.confirmTransaction(sig,"confirmed");
  return sig;
}

async function buyUSDCToToken(usdcAmountUi, tokenMintStr){
  const mint=new PublicKey(tokenMintStr);
  const amountRaw=Math.floor(Number(usdcAmountUi)*1e6); // USDC 6 decimals
  if(amountRaw<=0) throw new Error("amount_zero");
  const quote=await jupQuote(USDC_MINT,mint,amountRaw);
  const sw=await jupSwap(quote,true);
  if(!sw || !sw.swapTransaction) throw new Error("no_swap_tx");
  const sig=await signSendBase64Tx(sw.swapTransaction);
  return sig;
}

async function sendUSDC(toPubkeyStr, amountUi){
  const to=new PublicKey(toPubkeyStr);
  const ataFrom=await spl.getAssociatedTokenAddress(USDC_MINT,custody.publicKey,false,spl.TOKEN_PROGRAM_ID,spl.ASSOCIATED_TOKEN_PROGRAM_ID);
  const ataTo=await spl.getAssociatedTokenAddress(USDC_MINT,to,false,spl.TOKEN_PROGRAM_ID,spl.ASSOCIATED_TOKEN_PROGRAM_ID);
  const ix=[];
  const info=await conn.getAccountInfo(ataTo);
  if(!info) ix.push(spl.createAssociatedTokenAccountInstruction(custody.publicKey,to,ataTo,USDC_MINT,spl.TOKEN_PROGRAM_ID,spl.ASSOCIATED_TOKEN_PROGRAM_ID));
  const amt=Math.floor(Number(amountUi)*1e6);
  ix.push(spl.createTransferInstruction(ataFrom,ataTo,custody.publicKey,amt,[],spl.TOKEN_PROGRAM_ID));
  const {TransactionMessage,VersionedTransaction}=require("@solana/web3.js");
  const bh=await conn.getLatestBlockhash("confirmed");
  const msg=new TransactionMessage({payerKey:custody.publicKey, recentBlockhash:bh.blockhash, instructions:ix}).compileToV0Message();
  const tx=new VersionedTransaction(msg);
  tx.sign([custody]);
  const sig=await conn.sendRawTransaction(tx.serialize(),{skipPreflight:false,maxRetries:3});
  await conn.confirmTransaction(sig,"confirmed");
  return sig;
}

function requireArm(req){
  const arm=(req.headers["x-arm"]||"").toString();
  if(arm!==ARM_PHRASE) throw new Error("ARM_REQUIRED");
}

const app=express();
app.disable("x-powered-by");
app.use(express.json({limit:"256kb"}));
app.use((req,res,next)=>{
  res.setHeader("cache-control","no-store, max-age=0");
  res.setHeader("access-control-allow-origin","*");
  res.setHeader("access-control-allow-methods","GET,POST,OPTIONS");
  res.setHeader("access-control-allow-headers","content-type,x-arm");
  if(req.method==="OPTIONS") return res.status(204).end();
  next();
});

app.get("/",(req,res)=>res.type("text/plain").send("wolverine-api"));
app.get("/health",(req,res)=>res.json({ok:true,uptime:process.uptime(),ts:Date.now()}));
app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));
app.get("/wallet",(req,res)=>res.json({ok:true,custody:custody.publicKey.toBase58()}));
app.get("/config",(req,res)=>res.json({
  ok:true,
  basePath:BASE_PATH,
  apiBase:BASE_PATH+"/api",
  rpc:RPC_URL,
  usdcMint:USDC_MINT.toBase58(),
  custody:custody.publicKey.toBase58(),
  monitor:{url:MONITOR_URL,sec:MONITOR_SEC,fails:MONITOR_FAILS},
  armRequired:true
}));

app.get("/status",async(req,res)=>{
  const bal=await getBalances(session.tokenMint);
  res.json({ok:true,ts:Date.now(),custody:custody.publicKey.toBase58(),balances:bal,session});
});

app.post("/start",async(req,res)=>{
  try{
    requireArm(req);
    const b=Number(req.body?.budgetUSDC||0);
    const p=Number(req.body?.perTradeUSDC||5);
    const mint=(req.body?.tokenMint||"").toString().trim();
    const owner=(req.body?.ownerPubkey||"").toString().trim();
    const intervalSec=Math.max(10,Number(req.body?.intervalSec||30));
    if(!owner) throw new Error("owner_required");
    if(!mint) throw new Error("tokenMint_required");
    if(!(b>0)) throw new Error("budget_required");
    if(!(p>0)) throw new Error("perTrade_required");
    session.active=true;
    session.ownerPubkey=owner;
    session.tokenMint=mint;
    session.budgetUSDC=b;
    session.perTradeUSDC=p;
    session.intervalSec=intervalSec;
    session.mode="DCA";
    session.startedAt=now();
    session.lastErr="";
    saveSession();
    res.json({ok:true,session});
  }catch(e){
    res.status(400).json({ok:false,error:String(e.message||e)});
  }
});

app.post("/stop",(req,res)=>{
  try{
    requireArm(req);
    session.active=false;
    saveSession();
    res.json({ok:true,session});
  }catch(e){
    res.status(400).json({ok:false,error:String(e.message||e)});
  }
});

app.post("/buy",async(req,res)=>{
  try{
    requireArm(req);
    const amt=Number(req.body?.usdc||0);
    const mint=(req.body?.tokenMint||session.tokenMint||"").toString().trim();
    if(!mint) throw new Error("tokenMint_required");
    if(!(amt>0)) throw new Error("usdc_required");
    const sig=await buyUSDCToToken(amt,mint);
    session.lastSig=sig;
    session.trades.unshift({ts:Date.now(),type:"BUY",usdc:amt,mint,sig});
    saveSession();
    res.json({ok:true,sig});
  }catch(e){
    session.lastErr=String(e.message||e);
    saveSession();
    res.status(400).json({ok:false,error:String(e.message||e)});
  }
});

app.post("/payout",async(req,res)=>{
  try{
    requireArm(req);
    const to=(req.body?.to||session.ownerPubkey||"").toString().trim();
    const amt=Number(req.body?.usdc||0);
    if(!to) throw new Error("to_required");
    if(!(amt>0)) throw new Error("usdc_required");
    const sig=await sendUSDC(to,amt);
    session.trades.unshift({ts:Date.now(),type:"PAYOUT_USDC",usdc:amt,to,sig});
    saveSession();
    res.json({ok:true,sig});
  }catch(e){
    session.lastErr=String(e.message||e);
    saveSession();
    res.status(400).json({ok:false,error:String(e.message||e)});
  }
});

let tradeTimer=null;
async function tradeTick(){
  if(!session.active) return;
  try{
    const bal=await getBalances(session.tokenMint);
    const remain=session.budgetUSDC-session.spentUSDC;
    if(remain<=0){ session.active=false; session.lastErr="budget_reached"; saveSession(); return; }
    const doAmt=Math.min(session.perTradeUSDC,remain,bal.usdc);
    if(doAmt<=0) return;
    const sig=await buyUSDCToToken(doAmt,session.tokenMint);
    session.spentUSDC=+(session.spentUSDC+doAmt).toFixed(6);
    session.lastSig=sig;
    session.trades.unshift({ts:Date.now(),type:"DCA_BUY",usdc:doAmt,mint:session.tokenMint,sig});
    saveSession();
  }catch(e){
    session.lastErr=String(e.message||e);
    saveSession();
  }
}
function ensureTradeLoop(){
  if(tradeTimer) clearInterval(tradeTimer);
  tradeTimer=setInterval(()=>tradeTick(),Math.max(10,session.intervalSec)*1000);
}
ensureTradeLoop();

let monTimer=null,monFails=0;
async function monTick(){
  if(!MONITOR_URL) return;
  try{
    const r=await fetch(MONITOR_URL,{cache:"no-store"});
    const txt=await r.text();
    if(!r.ok) throw new Error("http_"+r.status);
    monFails=0;
  }catch(e){
    monFails++;
    if(monFails>=MONITOR_FAILS){
      sendTG("WOLVERINE MONITOR: ERR ("+MONITOR_URL+") "+now()+" fails="+monFails);
      monFails=0;
    }
  }
}
if(MONITOR_SEC>0 && MONITOR_URL){
  monTimer=setInterval(()=>monTick(),MONITOR_SEC*1000);
  monTick().catch(()=>{});
}

process.on("SIGTERM",()=>process.exit(0));
app.listen(PORT,"127.0.0.1",()=>{ console.log("wolverine-api listening 127.0.0.1:"+PORT); console.log("custody "+custody.publicKey.toBase58()); });

cat >/root/WOLVERINE_NGINX_VENDOR_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

echo "== Patch nginx: serve /wolverine/vendor =="

# Éviter doublon
grep -q "location /wolverine/vendor" "$NGINX_SITE" || cat >>"$NGINX_SITE" <<'NGINX'

# Serve local JS vendor (WalletConnect, etc.)
location /wolverine/vendor/ {
    alias /var/www/wolverine/vendor/;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
}
NGINX

nginx -t
systemctl reload nginx

echo "=============================="
echo "✅ NGINX vendor static OK"
echo "URL test : https://fireinners.online/wolverine/vendor/walletconnect-ethereum-provider.js"
echo "=============================="
BASH

chmod +x /root/WOLVERINE_NGINX_VENDOR_FIX.sh
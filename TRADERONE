cat >/root/WOLV_DEDUP.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
NGX="/etc/nginx"
INC_DIR="$NGX/includes"
SNIP_DIR="$NGX/snippets"
DOMAIN="fireinners.online"
VHOST="$NGX/sites-available/fireinners.online-ssl"

say(){ echo "[$(date -u +'%Y-%m-%d %H:%M:%S UTC')] $*"; }

command -v nginx >/dev/null 2>&1 || { echo "Missing nginx"; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "Missing python3"; exit 1; }
command -v tar >/dev/null 2>&1 || { echo "Missing tar"; exit 1; }

if [ ! -f "$VHOST" ]; then
  VHOST="$(grep -RIl --include='*' -E 'server_name[[:space:]].*fireinners\.online' "$NGX/sites-available" 2>/dev/null | head -n 1 || true)"
fi
[ -f "$VHOST" ] || { say "ERROR: vhost fireinners.online introuvable"; ls -la "$NGX/sites-available" | sed -n '1,200p' || true; exit 1; }

BK="/root/BK_WOLV_DEDUP_${TS}"
mkdir -p "$BK"
say "BACKUP -> $BK/nginx.tgz"
tar -czf "$BK/nginx.tgz" "$NGX" 2>/dev/null || tar -czf "$BK/nginx.tgz" "$NGX"

say "UNFREEZE chattr -i (best effort)"
if command -v chattr >/dev/null 2>&1; then
  chattr -i "$NGX/nginx.conf" 2>/dev/null || true
  chattr -i "$VHOST" 2>/dev/null || true
  find "$NGX" -maxdepth 2 -type f \( -name "*.conf" -o -name "*.inc" \) -print0 2>/dev/null | while IFS= read -r -d '' f; do chattr -i "$f" 2>/dev/null || true; done
fi

mkdir -p "$INC_DIR"

say "STEP A) Comment out ALL includes of wolverine_routes everywhere (except the managed include file itself)"
python3 - <<'PY'
import os,re,glob
NGX="/etc/nginx"
INC="/etc/nginx/includes/wolverine_routes.inc"
rx=re.compile(r'^\s*include\s+[^;]*(wolverine_routes\.inc|wolverine_routes\.conf|wolverine_routes\.inc;)[^;]*;\s*$',re.I)
paths=set()
for pat in [f"{NGX}/nginx.conf",f"{NGX}/conf.d/*.conf",f"{NGX}/sites-available/*",f"{NGX}/sites-enabled/*",f"{NGX}/includes/*.inc",f"{NGX}/includes/*.conf",f"{NGX}/snippets/*.conf",f"{NGX}/snippets/*.inc"]:
  for p in glob.glob(pat):
    if os.path.isfile(p): paths.add(p)
for p in sorted(paths):
  if os.path.abspath(p)==os.path.abspath(INC): 
    continue
  try: lines=open(p,'r',encoding='utf-8',errors='ignore').read().splitlines(True)
  except: 
    continue
  out=[]; changed=False
  for line in lines:
    if rx.search(line) and not line.lstrip().startswith("#"):
      out.append("# DISABLED_BY_WOLV_DEDUP "+line); changed=True
    else:
      out.append(line)
  if changed:
    bak=p+f".bak_wolv_dedup"
    if not os.path.exists(bak):
      try: open(bak,'w',encoding='utf-8',errors='ignore').writelines(lines)
      except: pass
    open(p,'w',encoding='utf-8',errors='ignore').writelines(out)
PY

say "STEP B) Comment out ALL location blocks that target /wolverine (everywhere except managed include)"
python3 - <<'PY'
import os,re,glob
NGX="/etc/nginx"
MANAGED="/etc/nginx/includes/wolverine_routes.inc"
# start of a location line containing /wolverine (any variant)
loc_start=re.compile(r'^\s*location\b.*\b/wolverine\b',re.I)
paths=set()
for pat in [f"{NGX}/conf.d/*.conf",f"{NGX}/sites-available/*",f"{NGX}/sites-enabled/*",f"{NGX}/includes/*.inc",f"{NGX}/includes/*.conf",f"{NGX}/snippets/*.conf",f"{NGX}/snippets/*.inc"]:
  for p in glob.glob(pat):
    if os.path.isfile(p): paths.add(p)

def comment_block(lines, start_i):
  # comment from start_i until brace depth returns to the level before the block
  out=[]
  depth=0
  # determine initial depth before start_i (rough)
  for j in range(0,start_i):
    depth += lines[j].count("{")-lines[j].count("}")
  target_depth=depth
  i=start_i
  while i<len(lines):
    line=lines[i]
    out.append("# DISABLED_BY_WOLV_DEDUP "+line if not line.lstrip().startswith("#") else line)
    depth += line.count("{")-line.count("}")
    i+=1
    if depth<=target_depth:
      break
  return out,i

for p in sorted(paths):
  if os.path.abspath(p)==os.path.abspath(MANAGED):
    continue
  try: lines=open(p,'r',encoding='utf-8',errors='ignore').read().splitlines(True)
  except: 
    continue
  changed=False
  out=[]
  i=0
  while i<len(lines):
    if loc_start.search(lines[i]) and not lines[i].lstrip().startswith("#"):
      block,ni=comment_block(lines,i)
      out.extend(block)
      i=ni
      changed=True
    else:
      out.append(lines[i]); i+=1
  if changed:
    bak=p+".bak_loc_wolv"
    if not os.path.exists(bak):
      try: open(bak,'w',encoding='utf-8',errors='ignore').writelines(lines)
      except: pass
    open(p,'w',encoding='utf-8',errors='ignore').writelines(out)
PY

say "STEP C) Write managed include with SINGLE location block (no duplicates possible inside include)"
cat >"$INC_DIR/wolverine_routes.inc" <<'EOF'
# wolverine routes (managed by WOLV_DEDUP)
location ^~ /wolverine {
  if ($request_uri = /wolverine) { return 301 /wolverine/; }
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
}
EOF

say "STEP D) Ensure include appears ONCE inside the correct vhost ($VHOST)"
python3 - <<PY
import re,os
path="$VHOST"
inc_line="include /etc/nginx/includes/wolverine_routes.inc;"
src=open(path,'r',encoding='utf-8',errors='ignore').read().splitlines(True)

# Remove any existing active include lines (leave commented)
out=[]
for line in src:
  if ("wolverine_routes.inc" in line) and (not line.lstrip().startswith("#")):
    out.append("# DISABLED_BY_WOLV_DEDUP "+line)
  else:
    out.append(line)

# Insert once after the first server_name line containing fireinners.online (within file)
inserted=False
final=[]
for line in out:
  final.append(line)
  if (not inserted) and re.search(r'^\s*server_name\b.*\bfireinners\.online\b', line):
    final.append("  "+inc_line+"\n")
    inserted=True

open(path,'w',encoding='utf-8',errors='ignore').writelines(final)
PY

say "STEP E) nginx test"
if nginx -t; then
  say "RELOAD nginx"
  systemctl reload nginx
else
  say "ERROR: nginx -t failed (show wolverine-related lines)"
  nginx -T 2>/dev/null | grep -nE 'wolverine|wolverine_routes' | head -n 250 || true
  exit 1
fi

say "REFREEZE chattr +i (best effort)"
if command -v chattr >/dev/null 2>&1; then
  chattr +i "$NGX/nginx.conf" 2>/dev/null || true
  chattr +i "$VHOST" 2>/dev/null || true
fi

say "DONE. Backup: $BK/nginx.tgz"
echo "OPEN: https://${DOMAIN}/wolverine/"
SH
chmod +x /root/WOLV_DEDUP.sh
bash /root/WOLV_DEDUP.sh
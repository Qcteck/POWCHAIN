bash -lc 'set -euo pipefail
rm -f /root/wvf.sh
cat >/root/wvf.sh<<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WVF_${TS}"
mkdir -p "$BK"

say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }

WEBROOT="/var/www/wolverine"
NGXCONF="/etc/nginx/nginx.conf"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
INCDIR="/etc/nginx/includes"

INC_STATIC="${INCDIR}/wolverine_static.inc"
INC_ROUTES="${INCDIR}/wolverine_routes.inc"

# Nginx include qui casse tout (location dans mauvais contexte)
AQUILA_BAD="${INCDIR}/aquila_stacking_routes.inc"

VAULT_DIR="/opt/traderone-vault"
VAULT_HOST="127.0.0.1"
VAULT_PORT="8787"
VAULT_SVC="/etc/systemd/system/vault-api.service"

DRPC_URL="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"

have(){ command -v "$1" >/dev/null 2>&1; }

bk(){ [ -e "$1" ] && cp -a "$1" "$BK/$(basename "$1").bk" 2>/dev/null || true; }

IMLIST="$BK/immutable.list"; : >"$IMLIST"
unfreeze(){ 
  local f="$1"; [ -e "$f" ] || return 0
  if lsattr -d "$f" 2>/dev/null | grep -q "i"; then
    echo "$f" >>"$IMLIST"
    chattr -i "$f" 2>/dev/null || true
  fi
}
refreeze(){
  [ -s "$IMLIST" ] || return 0
  while IFS= read -r f; do [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true; done <"$IMLIST"
}

inject_in_server(){
  local f="$1" line="$2"
  grep -F "$line" "$f" >/dev/null 2>&1 && return 0
  bk "$f"; unfreeze "$f"
  awk -v ins="$line" '
    BEGIN{done=0}
    {print}
    !done && $0 ~ /^[[:space:]]*server[[:space:]]*\{/ { print "    " ins; done=1 }
  ' "$f" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f"
}

comment_bad_includes(){
  say "Disable any include of aquila_stacking_routes.inc (wrong context)"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if grep -nE "^[[:space:]]*include[[:space:]]+.*aquila_stacking_routes\.inc.*;" "$f" >/dev/null 2>&1; then
      bk "$f"; unfreeze "$f"
      perl -0777 -pe "s/^([ \\t]*include[ \\t]+[^;]*aquila_stacking_routes\\.inc[^;]*;)/# AUTOFIX_${TS} disabled: \\1/mg" -i "$f" || true
      say "  disabled in: $f"
    fi
  done < <(find /etc/nginx -type f \( -name "*.conf" -o -name "*.inc" \) 2>/dev/null)
}

say "0) Preflight"
have nginx || { apt-get update -y; apt-get install -y nginx; }
have curl  || { apt-get update -y; apt-get install -y curl; }
have node  || { echo "ERROR: node missing. Fix Node then rerun."; exit 1; }
have npm   || { echo "ERROR: npm missing. Fix npm then rerun."; exit 1; }

say "1) Unfreeze nginx files if immutable"
unfreeze "$NGXCONF"
unfreeze "$VHOST"
unfreeze "$VHOST_EN"
[ -d "$INCDIR" ] && for f in "$INCDIR"/*.inc 2>/dev/null; do unfreeze "$f" || true; done

say "2) Fix nginx hard fail (location not allowed here)"
comment_bad_includes

say "3) Ensure /wolverine webroot (avoid 404)"
mkdir -p "$WEBROOT"
if [ ! -f "$WEBROOT/index.html" ]; then
  cat >"$WEBROOT/index.html"<<EOF
<!doctype html><meta charset="utf-8">
<title>WOLVERINE</title>
<h1>WOLVERINE</h1>
<p>UI missing in /var/www/wolverine. Deploy export here.</p>
EOF
fi

say "4) Write includes"
mkdir -p "$INCDIR"
bk "$INC_STATIC"
cat >"$INC_STATIC"<<EOF
# AUTOGEN_${TS} - Wolverine static
location ^~ /wolverine/ {
  alias ${WEBROOT}/;
  index index.html;
  try_files \$uri \$uri/ /wolverine/index.html;
}
EOF

bk "$INC_ROUTES"
cat >"$INC_ROUTES"<<EOF
# AUTOGEN_${TS} - Wolverine routes (Vault + Solana RPC)

set \$vault_upstream http://${VAULT_HOST}:${VAULT_PORT};

location = /wolverine/vault-api/health       { proxy_pass \$vault_upstream/health; }
location = /wolverine/vault-api/create       { proxy_pass \$vault_upstream/create; }

# legacy aliases (keep frontend working)
location = /wolverine/vault/health           { proxy_pass \$vault_upstream/health; }
location = /wolverine/vault/create           { proxy_pass \$vault_upstream/create; }
location = /wolverine/traderone/vault/health { proxy_pass \$vault_upstream/health; }
location = /wolverine/traderone/vault/create { proxy_pass \$vault_upstream/create; }
location = /wolverine/vault/api/health       { proxy_pass \$vault_upstream/health; }
location = /wolverine/vault/api/create       { proxy_pass \$vault_upstream/create; }

proxy_http_version 1.1;
proxy_set_header Host \$host;
proxy_set_header X-Real-IP \$remote_addr;
proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;

# Solana RPC same-origin -> DRPC
location = /wolverine/solana-rpc {
  resolver 1.1.1.1 8.8.8.8 valid=300s;
  proxy_ssl_server_name on;
  proxy_set_header Content-Type "application/json";
  proxy_pass ${DRPC_URL};
}
EOF

say "5) Ensure vhost enabled + includes inside server{}"
[ -f "$VHOST" ] || { echo "ERROR: missing vhost $VHOST"; exit 1; }
ln -sf "$VHOST" "$VHOST_EN" || true
inject_in_server "$VHOST" "include ${INC_STATIC};"
inject_in_server "$VHOST" "include ${INC_ROUTES};"

say "6) Install/repair Vault API"
mkdir -p "$VAULT_DIR/state"
cat >"$VAULT_DIR/package.json"<<EOF
{"name":"vault-api","version":"1.0.0","private":true,"type":"commonjs","dependencies":{"@solana/web3.js":"1.95.4","bs58":"5.0.0"}}
EOF

cat >"$VAULT_DIR/server.js"<<'"'"'EOF'"'"'
const http=require("http");
const {URL}=require("url");
const fs=require("fs");
const path=require("path");
const bs58=require("bs58");
const {Keypair}=require("@solana/web3.js");

const HOST=process.env.HOST||"127.0.0.1";
const PORT=Number(process.env.PORT||"8787");
const STATE_DIR=process.env.STATE_DIR||path.join(__dirname,"state");
const STATE_FILE=process.env.STATE_FILE||path.join(STATE_DIR,"state.json");

fs.mkdirSync(STATE_DIR,{recursive:true});

function load(){ try{return JSON.parse(fs.readFileSync(STATE_FILE,"utf8"));}catch{return {vaults:{},createdAt:new Date().toISOString()};} }
function save(s){ fs.writeFileSync(STATE_FILE,JSON.stringify(s,null,2)); }
function send(res,code,obj){
  const b=JSON.stringify(obj);
  res.writeHead(code,{"content-type":"application/json; charset=utf-8","cache-control":"no-store"});
  res.end(b);
}
function readJson(req){
  return new Promise((resolve,reject)=>{
    let d="";
    req.on("data",c=>{ d+=c; if(d.length>1_000_000){reject(new Error("payload_too_large")); req.destroy();} });
    req.on("end",()=>{ if(!d) return resolve({}); try{resolve(JSON.parse(d));}catch{reject(new Error("bad_json"));} });
  });
}

http.createServer(async(req,res)=>{
  const u=new URL(req.url,"http://x");
  if(req.method==="GET" && u.pathname==="/health") return send(res,200,{ok:true,service:"vault-api"});
  if(req.method==="POST" && u.pathname==="/create"){
    let body={}; try{ body=await readJson(req); }catch(e){ return send(res,400,{ok:false,error:e.message}); }
    const userPub=(body.userPub||body.pub||"").toString().trim();
    const st=load();
    st.vaults=st.vaults||{};
    const key=userPub||"anon";
    if(userPub && st.vaults[userPub]?.vaultPub) return send(res,200,{ok:true,userPub,vaultPub:st.vaults[userPub].vaultPub,existing:true});
    const kp=Keypair.generate();
    const vaultPub=kp.publicKey.toBase58();
    const secret58=bs58.encode(Buffer.from(kp.secretKey));
    st.vaults[key]={vaultPub,secret58,createdAt:new Date().toISOString()};
    save(st);
    return send(res,200,{ok:true,userPub:userPub||null,vaultPub,existing:false});
  }
  return send(res,404,{ok:false,error:"not_found"});
}).listen(PORT,HOST,()=>console.log(JSON.stringify({ok:true,service:"vault-api",host:HOST,port:PORT})));
EOF

( cd "$VAULT_DIR"; npm install --omit=dev --no-fund --no-audit )

cat >"$VAULT_SVC"<<EOF
[Unit]
Description=WOLVERINE Vault API
After=network.target

[Service]
Type=simple
WorkingDirectory=${VAULT_DIR}
Environment=HOST=${VAULT_HOST}
Environment=PORT=${VAULT_PORT}
Environment=STATE_DIR=${VAULT_DIR}/state
Environment=STATE_FILE=${VAULT_DIR}/state/state.json
ExecStart=/usr/bin/node ${VAULT_DIR}/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now vault-api.service
systemctl restart vault-api.service

say "7) Verify Vault listening"
if ! ss -ltnp 2>/dev/null | grep -q ":${VAULT_PORT}"; then
  systemctl status vault-api.service --no-pager || true
  journalctl -u vault-api.service -n 120 --no-pager || true
  exit 1
fi

say "8) nginx -t + reload"
nginx -t
systemctl reload nginx

say "9) Tests"
echo "== local vault health =="; curl -sS "http://${VAULT_HOST}:${VAULT_PORT}/health"; echo
echo "== local vault create =="; curl -sS -X POST "http://${VAULT_HOST}:${VAULT_PORT}/create" -H "content-type: application/json" -d "{}"; echo
echo "== nginx -> vault health =="; curl -sS -H "Host: fireinners.online" "http://127.0.0.1/wolverine/vault-api/health"; echo
echo "== nginx -> vault create =="; curl -sS -H "Host: fireinners.online" -X POST "http://127.0.0.1/wolverine/vault-api/create" -H "content-type: application/json" -d "{}"; echo
echo "== nginx -> solana rpc getHealth =="; curl -sS -H "Host: fireinners.online" -X POST "http://127.0.0.1/wolverine/solana-rpc" -H "content-type: application/json" -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\"}"; echo

say "10) Refreeze immutables (if any)"
refreeze

say "DONE"
echo "Open: https://fireinners.online/wolverine/  then Ctrl+F5"
echo "Backups: $BK"
BASH

# FIX CRLF if present (prevents weird bash/kernel errors)
sed -i "s/\r$//" /root/wvf.sh

chmod +x /root/wvf.sh
bash /root/wvf.sh
'
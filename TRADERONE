set -euo pipefail
UI="/var/www/wolverine"
VER="$UI/_index_versions/v0008.html"

[ -f "$VER" ] || { echo "❌ Missing $VER"; exit 1; }

# force v0008 en prod
cp -a "$UI/index.html" "$UI/index.html.bak.$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
cp -a "$VER" "$UI/index.html"

# fingerprint pour être sûr
echo "=== PROD index fingerprint ==="
sha256sum "$UI/index.html" "$VER" | sed -n '1,2p'

nginx -t && systemctl reload nginx
echo "✅ Prod stays on v0008"
#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA RSS + TTS FIX (1-2-3) ==="

BASE="/var/www/aiaquila"
HTML="$BASE/index.html"
PROXY="$BASE/rss-proxy.php"
BACKUP="$BASE/backup_$(date +%Y%m%d_%H%M%S)"

mkdir -p "$BACKUP"
cp "$HTML" "$BACKUP/index.html.bak"

echo "[1/3] Installation proxy RSS PHP (no CORS)"

cat > "$PROXY" <<'PHP'
<?php
header("Content-Type: text/xml; charset=UTF-8");
header("Access-Control-Allow-Origin: *");

if (!isset($_GET['url'])) {
  http_response_code(400);
  echo "Missing url";
  exit;
}

$url = $_GET['url'];
$ctx = stream_context_create([
  "http" => [
    "timeout" => 10,
    "user_agent" => "AIAQUILA-RSS"
  ]
]);

$data = @file_get_contents($url, false, $ctx);
if ($data === false) {
  http_response_code(502);
  echo "RSS fetch failed";
  exit;
}

echo $data;
PHP

chown www-data:www-data "$PROXY"
chmod 644 "$PROXY"

echo "[2/3] Correction JS RSS + DOMParser + ordre variables"

perl -0777 -i -pe '
s/DOMParser\(\)\.parseFromString\(([^,]+)\)/DOMParser().parseFromString($1,"text\/xml")/g;
s/const S =/window.S =/g;
s/function loadRSS/function loadRSS/g;
' "$HTML"

echo "[3/3] Reload nginx"
nginx -t
systemctl reload nginx

echo "=== AIAQUILA RSS + TTS FIX APPLIQUÉ ==="
echo "Backup : $BACKUP"
echo "URL : https://fireinners.online/aiaquila/"
echo "➡️ Clique une fois → le TTS doit parler"
cat >/root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V3_ONE_SHOT.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027

TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v curl  >/dev/null 2>&1 || die "curl missing"
command -v awk   >/dev/null 2>&1 || die "awk missing"
command -v grep  >/dev/null 2>&1 || die "grep missing"

DOMAIN="fireinners.online"
WEBROOT="/var/www/aquila_stacking"
PATH_A="/aquila_stacking/"
PATH_B="/iaaquila/"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"

BK="/root/AQUILA_STACKING_WEBROUTE_FIX_V3_BK_${TS}"
mkdir -p "$BK"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "AquilaStacking web routes v3" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
    rm -f "$tmp"
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(echo "$path" | sed 's#/#_#g').bak" || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}

pick_vhost(){
  local f
  # prefer enabled vhosts, then conf.d, then available
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    grep -Eq "server_name[^;]*\b${DOMAIN}\b" "$f" || continue
    grep -Eq "listen[^;]*\b443\b" "$f" || continue
    echo "$f"
    return 0
  done < <( (grep -RIl "server_name[^;]*\b${DOMAIN}\b" /etc/nginx/sites-enabled 2>/dev/null || true; \
            grep -RIl "server_name[^;]*\b${DOMAIN}\b" /etc/nginx/conf.d 2>/dev/null || true; \
            grep -RIl "server_name[^;]*\b${DOMAIN}\b" /etc/nginx/sites-available 2>/dev/null || true) | awk '!seen[$0]++' )
  # known fallback
  [ -f "/etc/nginx/sites-available/fireinners.online-ssl" ] && echo "/etc/nginx/sites-available/fireinners.online-ssl" && return 0
  return 1
}

patch_vhost_include(){
  local VHOST="$1"
  local tmp; tmp="$(mktemp)"
  cp -a "$VHOST" "$BK/$(basename "$VHOST").bak"

  # idempotent: if include already present anywhere in matching 443 server block, ok
  if grep -Fq "$INC" "$VHOST"; then
    say "VHOST already references include: $VHOST"
    return 0
  fi

  # Patch: inject "include INC;" inside EACH server{...} that has server_name DOMAIN and listen 443
  awk -v dom="$DOMAIN" -v inc="$INC" '
  function flush(){
    if(sb!=""){
      block=sb
      if(block ~ ("server_name[^;]*" dom) && block ~ /listen[^;]*443/){
        if(block !~ inc){
          n=split(sb, a, "\n")
          out=""; inserted=0
          for(i=1;i<=n;i++){
            if(a[i]=="") continue
            out=out a[i] "\n"
            if(!inserted && a[i] ~ ("server_name[^;]*" dom)){
              out=out "    include " inc ";\n"
              inserted=1
            }
          }
          sb=out
          patched_any=1
        }
      }
      printf "%s", sb
    }
    sb=""
  }
  BEGIN{sb="";in=0;depth=0;patched_any=0}
  {
    line=$0
    if(!in){
      if(line ~ /^[ \t]*server[ \t]*\{/){
        in=1; depth=0; sb=line "\n"
        # count braces on this line
        for(j=1;j<=length(line);j++){
          c=substr(line,j,1)
          if(c=="{") depth++
          else if(c=="}") depth--
        }
        if(depth==0){ in=0; flush() }
        next
      } else {
        print line
        next
      }
    } else {
      sb=sb line "\n"
      for(j=1;j<=length(line);j++){
        c=substr(line,j,1)
        if(c=="{") depth++
        else if(c=="}") depth--
      }
      if(depth==0){ in=0; flush() }
      next
    }
  }
  END{
    if(in) flush()
  }' "$VHOST" >"$tmp"

  chattr -i "$VHOST" 2>/dev/null || true
  install -m 0644 "$tmp" "$VHOST"
  rm -f "$tmp"
}

say "1) WEBROOT + index.html"
mkdir -p "$WEBROOT"
chmod 0755 "$WEBROOT" || true
chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true

cat >"$WEBROOT/index.html"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><style>body{font-family:system-ui,Segoe UI,Arial;margin:24px;max-width:980px}code{background:#0b1020;color:#d7e3ff;padding:2px 6px;border-radius:6px}pre{background:#0b1020;color:#d7e3ff;padding:12px;border-radius:10px;overflow:auto}a{color:#2b6fff;text-decoration:none}a:hover{text-decoration:underline}.box{border:1px solid #e5e7eb;border-radius:12px;padding:14px;margin:12px 0}</style></head><body><h1>AquilaStacking</h1><div class="box"><b>URLs</b><div>• <a href="${PATH_B}">${PATH_B}</a></div><div>• <a href="${PATH_A}">${PATH_A}</a></div></div><div class="box"><b>Webroot</b> <code>${WEBROOT}</code></div></body></html>
EOF
chown www-data:www-data "$WEBROOT/index.html" 2>/dev/null || true
chmod 0644 "$WEBROOT/index.html" || true

say "2) Write nginx include: $INC"
ROUTES="### AQUILA_STACKING_WEBROUTES_V3_BEGIN
location = ${PATH_B%/} { return 301 ${PATH_B}; }
location ^~ ${PATH_B} {
  alias ${WEBROOT}/;
  index index.html;
  add_header Cache-Control \"no-store\" always;
  try_files \$uri \$uri/ ${PATH_B}index.html =404;
}
location = ${PATH_A%/} { return 301 ${PATH_A}; }
location ^~ ${PATH_A} {
  alias ${WEBROOT}/;
  index index.html;
  add_header Cache-Control \"no-store\" always;
  try_files \$uri \$uri/ ${PATH_A}index.html =404;
}
### AQUILA_STACKING_WEBROUTES_V3_END"
write_file "$INC" "$ROUTES"

say "3) Detect active 443 vhost for ${DOMAIN}"
VHOST="$(pick_vhost)" || die "no vhost found for ${DOMAIN} listen 443"
say "   VHOST: $VHOST"

say "4) Patch VHOST to include routes (idempotent)"
patch_vhost_include "$VHOST"

say "5) nginx test + reload"
nginx -t
systemctl reload nginx

say "6) Local HTTPS verify (force localhost, no DNS dependency)"
H1="$(curl -k -sS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_B}" | head -n 5 || true)"
echo "$H1" | grep -qi "AquilaStacking" || { echo "$H1" >"$BK/resp_iaaquila_head.txt"; die "still 404 on ${PATH_B} (see $BK/resp_iaaquila_head.txt)"; }
H2="$(curl -k -sS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_A}" | head -n 5 || true)"
echo "$H2" | grep -qi "AquilaStacking" || { echo "$H2" >"$BK/resp_aquila_head.txt"; die "still 404 on ${PATH_A} (see $BK/resp_aquila_head.txt)"; }

say "DONE"
say "Open: https://${DOMAIN}${PATH_B}"
say "Open: https://${DOMAIN}${PATH_A}"
say "BK: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V3_ONE_SHOT.sh
bash /root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V3_ONE_SHOT.sh
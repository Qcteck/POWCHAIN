bash <<'NGINX_REPAIR'
set -euo pipefail

echo "=== NGINX EMERGENCY REPAIR :: FIREINNERS ==="

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ENABLED="/etc/nginx/sites-enabled/fireinners.online-ssl"
BACKUP="/etc/nginx/sites-available/fireinners.online-ssl.BROKEN_$(date +%Y%m%d_%H%M%S)"

# --- sanity ---
test -f "$VHOST" || {
  echo "ERROR: vhost not found: $VHOST"
  exit 1
}

# --- backup ---
echo "[1/5] Backing up broken vhost..."
cp -a "$VHOST" "$BACKUP"

# --- remove invalid lines (single-letter directives etc.) ---
echo "[2/5] Cleaning invalid directives..."
grep -Ev '^[[:space:]]*[a-zA-Z]$' "$BACKUP" > "$VHOST"

# --- ensure wolverine location (clean insert) ---
echo "[3/5] Ensuring clean /wolverine location..."
grep -q "location /wolverine/" "$VHOST" || sed -i '/server {/a\
\
    location /wolverine/ {\
        root /var/www;\
        index index.html;\
        try_files $uri $uri/ /wolverine/index.html;\
    }\
' "$VHOST"

# --- re-enable clean vhost ---
ln -sf "$VHOST" "$ENABLED"

# --- test nginx ---
echo "[4/5] Testing nginx..."
nginx -t

# --- reload ---
echo "[5/5] Reloading nginx..."
systemctl reload nginx

echo
echo "======================================"
echo "✅ NGINX REPAIRED"
echo "Backup saved at:"
echo "  $BACKUP"
echo "======================================"
NGINX_REPAIR
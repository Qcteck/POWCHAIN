BK="/root/${SLUG}_BK_${TS}"
mkdir -p "$BK"

say "== 0) Backup =="
[ -d "$APP" ] && cp -a "$APP" "$BK/app.bak" 2>/dev/null || true
[ -d "$WEB" ] && cp -a "$WEB" "$BK/web.bak" 2>/dev/null || true
[ -f "$INC" ] && cp -a "$INC" "$BK/$(basename "$INC").bak" 2>/dev/null || true

#!/usr/bin/env bash
set -euo pipefail

echo "=============================="
echo " TRADERONE API HARD FIX (ROOT)"
echo "=============================="

APP="traderone-vault"
FILE="/opt/traderone-vault/server.js"
TS=$(date +%Y%m%d_%H%M%S)

########################################
# 1) Vérifications
########################################
echo "[1/6] Vérifications"
[ -f "$FILE" ] || { echo "❌ server.js introuvable"; exit 1; }

########################################
# 2) Backup
########################################
echo "[2/6] Backup"
cp "$FILE" "$FILE.bak_$TS"
echo "✔ Backup créé: $FILE.bak_$TS"

########################################
# 3) Injection API (SAFE)
########################################
echo "[3/6] Injection routes API"

python3 <<'PY'
from pathlib import Path

p = Path("/opt/traderone-vault/server.js")
s = p.read_text()

MARK = "/* === TRADERONE API ROUTES === */"
if MARK in s:
    print("Routes déjà présentes → SKIP")
    exit(0)

inject = """
/* === TRADERONE API ROUTES === */
app.get("/wolverine/traderone/api/health",(req,res)=>{
  res.json({ok:true,ts:Date.now()});
});

app.post("/wolverine/traderone/api/budget",(req,res)=>{
  try{
    const body=req.body||{};
    if(!body.pubkey||!body.budgetSol) throw "payload invalide";
    const lamports=Math.floor(Number(body.budgetSol)*1e9);
    if(lamports<=0) throw "montant invalide";
    res.json({ok:true,lamports});
  }catch(e){
    res.status(400).json({ok:false,error:String(e)});
  }
});
/* === END TRADERONE API ROUTES === */
"""

# insère juste avant app.listen
idx = s.rfind("app.listen")
if idx == -1:
    raise SystemExit("app.listen introuvable")

s = s[:idx] + inject + "\n" + s[idx:]
p.write_text(s)
print("✔ Routes API injectées")
PY

########################################
# 4) Restart PM2
########################################
echo "[4/6] Redémarrage PM2"
pm2 restart "$APP"
sleep 2

########################################
# 5) Test API LOCALE (clé)
########################################
echo "[5/6] Test API locale"
RESP=$(curl -s http://127.0.0.1:3000/wolverine/traderone/api/health || true)
echo "$RESP"

echo "$RESP" | grep -q '"ok":true' \
 && echo "✔ API locale OK" \
 || { echo "❌ API locale toujours KO"; exit 1; }

########################################
# 6) Test POST local
########################################
echo "[6/6] Test POST budget local"
curl -s -X POST http://127.0.0.1:3000/wolverine/traderone/api/budget \
 -H "Content-Type: application/json" \
 -d '{"pubkey":"11111111111111111111111111111111","budgetSol":0.001}' \
 | tee /dev/stderr | grep -q '"ok":true'

echo "=============================="
echo " ✅ API TRADERONE ACTIVE"
echo " - health OK"
echo " - budget OK"
echo "=============================="
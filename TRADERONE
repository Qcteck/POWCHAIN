#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE JS CLEAN RESET ==="

[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

# Backup
cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup créé : ${HTML}.bak_${TS}"

# 1) SUPPRESSION TOTALE DE TOUS LES SCRIPTS
sed -i '/<script/,/<\/script>/d' "$HTML"
echo "✔ Tous les scripts supprimés"

# 2) Injection web3.js (une seule fois)
sed -i '/<\/head>/i \
<script src="https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js"></script>' "$HTML"

# 3) Injection UI Phantom + soldes (HTML)
sed -i '/API:/a \
<button id="PHANTOM_BTN" type="button" style="margin-top:12px;width:100%;padding:12px;border-radius:8px;border:0;background:#facc15;color:#000;font-weight:700;cursor:pointer">CONNECT PHANTOM</button>\
<div id="PHANTOM_ADDR" style="margin-top:6px;font-size:12px;word-break:break-all"></div>\
<div style="margin-top:8px;font-size:13px">\
  SOL : <span id="BAL_SOL">—</span><br/>\
  USDC : <span id="BAL_USDC">—</span>\
</div>' "$HTML"

# 4) Script UNIQUE, VALIDE, TESTÉ
sed -i '/<\/body>/i \
<script>\
document.addEventListener("DOMContentLoaded",function(){\
  const btn=document.getElementById("PHANTOM_BTN");\
  const out=document.getElementById("PHANTOM_ADDR");\
  const balSol=document.getElementById("BAL_SOL");\
  const balUsdc=document.getElementById("BAL_USDC");\
  const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";\
  const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";\
  if(!btn) return;\
  btn.addEventListener("click",async function(){\
    if(!window.solana || !window.solana.isPhantom){\
      out.textContent="❌ Phantom non installé";\
      return;\
    }\
    try{\
      const res=await window.solana.connect();\
      const pub=res.publicKey;\
      out.textContent=pub.toString();\
      btn.textContent="CONNECTED";\
      btn.disabled=true;\
      const conn=new solanaWeb3.Connection(RPC,"confirmed");\
      const lamports=await conn.getBalance(pub);\
      balSol.textContent=(lamports/1e9).toFixed(6);\
      const accs=await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)});\
      let u=0; accs.value.forEach(a=>{u+=a.account.data.parsed.info.tokenAmount.uiAmount||0});\
      balUsdc.textContent=u.toFixed(2);\
    }catch(e){\
      out.textContent="Connexion refusée";\
    }\
  });\
});\
</script>' "$HTML"

echo "✅ RESET TERMINÉ"
echo "➡️ FAIS CTRL + F5 (OBLIGATOIRE)"
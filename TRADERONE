set -e
cd /root

echo "=== 1) Confirme le vrai process sur 3000 ==="
lsof -nP -iTCP:3000 -sTCP:LISTEN || true
PID=$(lsof -t -iTCP:3000 -sTCP:LISTEN | head -n1 || true)
echo "PID=$PID"
[ -n "$PID" ] && tr '\0' ' ' < /proc/$PID/cmdline && echo

echo
echo "=== 2) Vérifie qu’aucun server.js.bak ne tourne ==="
ps -ef | grep -E 'server\.js\.bak|traderone-opt.*bak' | grep -v grep || echo "OK: aucun .bak en cours"

echo
echo "=== 3) Nettoie les vieux logs PM2 et relis propre ==="
pm2 flush
pm2 restart traderone --update-env
sleep 1
pm2 logs traderone --lines 80

echo
echo "=== 4) Re-test ports + endpoints ==="
ss -lptn | egrep ':3000|:3002' || true
curl -sS -i -X POST "http://127.0.0.1:3000/api/status" -H "content-type: application/json" --data '{}' | head -n 20
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" -H "content-type: application/json" --data '{}' | head -n 20
cat > /root/WOLVERINE_WALLET_SOLDE_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML_FILE="/var/www/wolverine/index.html"
RPC_URL="https://api.mainnet-beta.solana.com"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

# Injecter le code HTML/Javascript qui affiche les soldes SOL et USDC

cat > "$HTML_FILE" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<title>Wolverine Wallet</title>
<script src="https://cdn.jsdelivr.net/npm/@solana/web3.js"></script>
<script>
  const RPC = "https://api.mainnet-beta.solana.com";
  const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

  async function connectWallet() {
    const resp = await window.solana.connect();
    const address = resp.publicKey.toString();
    document.getElementById('address').textContent = address;

    const connection = new solanaWeb3.Connection(RPC);

    // Get SOL balance
    const balance = await connection.getBalance(new solanaWeb3.PublicKey(address));
    document.getElementById('sol').textContent = (balance / solanaWeb3.LAMPORTS_PER_SOL).toFixed(4);

    // Get USDC balance
    const tokenAccounts = await connection.getTokenAccountsByOwner(new solanaWeb3.PublicKey(address), {
      programId: new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")
    });
    let usdcBalance = 0;
    tokenAccounts.value.forEach(accountInfo => {
      const accountData = solanaWeb3.AccountLayout.decode(accountInfo.account.data);
      if (accountData.mint.toString() === USDC) {
        usdcBalance += accountData.amount / Math.pow(10, 6); // USDC has 6 decimals
      }
    });
    document.getElementById('usdc').textContent = usdcBalance.toFixed(2);
  }

  function disconnectWallet() {
    window.solana.disconnect();
    document.getElementById('address').textContent = "-";
    document.getElementById('sol').textContent = "-";
    document.getElementById('usdc').textContent = "-";
  }
</script>
</head>
<body onload="document.getElementById('connectBtn').onclick = connectWallet;document.getElementById('disconnectBtn').onclick = disconnectWallet;">
  <div>
    <button id="connectBtn">Connect Wallet</button>
    <button id="disconnectBtn">Disconnect Wallet</button>
  </div>
  <div>Address: <span id="address">-</span></div>
  <div>SOL: <span id="sol">-</span></div>
  <div>USDC: <span id="usdc">-</span></div>
</body>
</html>
HTML

echo "Le batch a été déployé. Recharge la page pour voir les soldes."
BASH

chmod +x /root/WOLVERINE_WALLET_SOLDE_FIX.sh
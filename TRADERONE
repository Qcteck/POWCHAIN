set -e
cd /root

echo "=== 1) nginx -t (fichier + ligne) ==="
ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 40

FILE="$(echo "$ERR" | sed -n 's/.*in \(\/[^:]*\):\([0-9]\+\).*/\1/p' | head -n 1)"
LINE="$(echo "$ERR" | sed -n 's/.*in \(\/[^:]*\):\([0-9]\+\).*/\2/p' | head -n 1)"
echo "FILE=$FILE"
echo "LINE=$LINE"

echo
echo "=== 2) Contexte autour de la ligne (awk safe) ==="
START=$((LINE-15)); [ "$START" -lt 1 ] && START=1
END=$((LINE+15))
awk -v s="$START" -v e="$END" 'NR>=s && NR<=e {printf "%5d  %s\n", NR, $0}' "$FILE"

echo
echo "=== 3) Fix auto sur le fichier fautif (proxy_set_header vides) ==="
cp -v "$FILE" "$FILE.bak.$(date +%Y%m%d_%H%M%S)"

# corrige plusieurs variantes : "Host;" "Host ;" "X-Real-IP;" etc.
perl -pi -e 's/^\s*proxy_set_header\s+Host\s*;\s*$/  proxy_set_header Host $host;/g' "$FILE"
perl -pi -e 's/^\s*proxy_set_header\s+X-Real-IP\s*;\s*$/  proxy_set_header X-Real-IP $remote_addr;/g' "$FILE"
perl -pi -e 's/^\s*proxy_set_header\s+X-Forwarded-For\s*;\s*$/  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;/g' "$FILE"
perl -pi -e 's/^\s*proxy_set_header\s+X-Forwarded-Proto\s*;\s*$/  proxy_set_header X-Forwarded-Proto $scheme;/g' "$FILE"

echo
echo "=== 4) Re-test + reload ==="
nginx -t
systemctl reload nginx
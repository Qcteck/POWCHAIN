bash <<'BASH'
set -euo pipefail
echo "=== WOLVERINE UI RESTORE + SOL ONLY ==="

HTML="/var/www/wolverine/index.html"
test -f "$HTML" || { echo "index.html manquant"; exit 1; }
cp -a "$HTML" "$HTML.bak_$(date +%s)"

cat > "$HTML" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Wolverine</title>
<style>
body{margin:0;font-family:Arial;background:#111;color:#fff}
#app{display:flex;height:100vh}
#side{width:220px;background:#b30000;padding:10px}
#side button{width:100%;margin:5px 0;padding:8px;border:0;background:#ffcc00;font-weight:bold}
#main{flex:1;padding:20px;background:linear-gradient(120deg,#0a1a3a,#000)}
.panel{background:#123a7a;padding:15px;margin-bottom:15px;border-radius:6px}
#right{width:320px;padding:20px;background:#0b2a5a}
.btn{background:#ffcc00;border:0;padding:10px 15px;font-weight:bold;cursor:pointer}
</style>
</head>
<body>

<div id="app">
  <div id="side">
    <button>Dashboard</button>
    <button>Trade</button>
    <button>Positions</button>
    <button>Orders</button>
    <button>History</button>
    <button>Wallet</button>
    <button>Settings</button>
    <button>Health</button>
  </div>

  <div id="main">
    <div class="panel">
      <h2>Wolverine — Dashboard</h2>
      <div>TraderOne overview</div>
    </div>

    <div class="panel">
      <h3>Open Orders</h3>
      <table>
        <tr><th>Pair</th><th>Type</th><th>Price</th><th>Amount</th><th>Total</th></tr>
        <tr><td>SOL</td><td>—</td><td>—</td><td>—</td><td>—</td></tr>
      </table>
    </div>
  </div>

  <div id="right">
    <div class="panel">
      <h3>TraderOne Control</h3>
      <button class="btn">START</button>
      <button class="btn">PAUSE</button>
      <button class="btn">STOP</button>
    </div>

    <div class="panel">
      <button id="connect" class="btn" style="width:100%">Connect Phantom (REAL)</button>
      <div style="margin-top:10px">Address: <span id="addr">-</span></div>
      <div>SOL: <span id="sol">-</span></div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js"></script>
<script>
document.getElementById("connect").onclick=async()=>{
 if(!window.solana||!solana.isPhantom){alert("Phantom non détecté");return;}
 const r=await solana.connect();
 const pub=r.publicKey.toString();
 document.getElementById("addr").textContent=pub;
 const c=new solanaWeb3.Connection(solanaWeb3.clusterApiUrl("mainnet-beta"));
 const bal=await c.getBalance(new solanaWeb3.PublicKey(pub));
 document.getElementById("sol").textContent=(bal/1e9).toFixed(4);
};
</script>

</body>
</html>

cat >/root/MEGA_WOLVERINE_FIX_404_V9.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
INC_DIR="/etc/nginx/includes"
INC_FILE="$INC_DIR/wolverine_static.inc"
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WOLV404_FIX_${TS}"

say(){ echo "[$(date -u '+%F %T UTC')] $*"; }
need_root(){ [ "${EUID:-$(id -u)}" -eq 0 ] || { echo "ERR: root only"; exit 1; }; }

unfreeze(){
  command -v chattr >/dev/null 2>&1 || return 0
  chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
  chattr -i -R /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/includes 2>/dev/null || true
}
refreeze_one(){
  command -v chattr >/dev/null 2>&1 || return 0
  local f="$1"
  [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true
}

backup_all(){
  mkdir -p "$BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  if [ -d "$WEBROOT" ]; then cp -a "$WEBROOT" "$BK/webroot_wolverine" 2>/dev/null || true; fi
  say "Backups: $BK"
}

ensure_webroot(){
  mkdir -p "$WEBROOT"
  if [ ! -f "$WEBROOT/index.html" ]; then
    say "Create minimal $WEBROOT/index.html (placeholder)"
    cat >"$WEBROOT/index.html" <<HTML
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE OK</title><style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;margin:24px}code{background:#f3f3f3;padding:2px 6px;border-radius:6px}</style></head><body><h1>WOLVERINE OK</h1><p>Static route <code>/wolverine/</code> is served.</p><p>Path: <code>/var/www/wolverine/index.html</code></p></body></html>
HTML
  fi
}

write_include(){
  mkdir -p "$INC_DIR"
  cat >"$INC_FILE" <<'NGX'
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
  add_header Pragma "no-cache" always;
  expires -1;
}
NGX
}

detect_vhosts(){
  nginx -T 2>/dev/null | python3 - <<'PY'
import re,sys
txt=sys.stdin.read().splitlines()
cur=None
out=[]
for line in txt:
    m=re.match(r'# configuration file (.*):$', line.strip())
    if m: cur=m.group(1); continue
    if cur and 'server_name' in line and 'fireinners.online' in line:
        out.append(cur)
seen=[]
for f in out:
    if f not in seen: seen.append(f)
print("\n".join(seen))
PY
}

pick_primary_ssl_vhost(){
  nginx -T 2>/dev/null | python3 - <<'PY'
import re,sys
domain="fireinners.online"
lines=sys.stdin.read().splitlines()
cur=None
servers=[]
i=0
while i < len(lines):
    line=lines[i]
    m=re.match(r'# configuration file (.*):$', line.strip())
    if m: cur=m.group(1); i+=1; continue
    if cur and re.search(r'^\s*server\s*\{', line):
        depth=0
        has_domain=False
        has_443=False
        j=i
        while j < len(lines):
            l=lines[j]
            depth += l.count('{') - l.count('}')
            if re.search(r'\bserver_name\b', l) and domain in l: has_domain=True
            if re.search(r'\blisten\b', l) and re.search(r'\b443\b', l): has_443=True
            if depth<=0: break
            j+=1
        if has_domain and has_443:
            servers.append(cur)
        i=j+1
        continue
    i+=1
seen=[]
for f in servers:
    if f not in seen: seen.append(f)
print(seen[0] if seen else "")
PY
}

disable_other_ssl_conflicts(){
  local primary="$1"
  say "Scan other SSL vhosts for $DOMAIN (disable conflicts, keep primary)"
  local all; all="$(detect_vhosts || true)"
  [ -n "$all" ] || return 0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$f" = "$primary" ] && continue
    if [ -L "$f" ]; then
      say "Disable symlink: $f"
      mv -f "$f" "$BK/disabled_$(basename "$f")" 2>/dev/null || true
    elif [ -f "$f" ]; then
      if [[ "$f" == /etc/nginx/conf.d/* ]]; then
        say "Disable conf.d file: $f"
        mv -f "$f" "$BK/disabled_$(basename "$f")" 2>/dev/null || true
      else
        say "Leave file (not safe to auto-disable): $f"
      fi
    fi
  done <<<"$all"
}

inject_include_into_primary(){
  local primary="$1"
  [ -n "$primary" ] || { say "ERR: primary SSL vhost not found"; exit 1; }
  [ -f "$primary" ] || { say "ERR: primary file missing: $primary"; exit 1; }

  say "Primary SSL vhost: $primary"
  cp -a "$primary" "$BK/primary_vhost.bak" 2>/dev/null || true

  python3 - <<PY
import re
p="$primary"
inc='$INC_FILE'
needle=f'include {inc};'
s=open(p,'r',encoding='utf-8',errors='ignore').read().splitlines(True)

# If already present anywhere, keep single instance (first) and remove the rest
found=[]
for i,l in enumerate(s):
    if needle in l and not l.lstrip().startswith('#'):
        found.append(i)
if found:
    keep=found[0]
    for idx in reversed(found[1:]):
        s.pop(idx)
else:
    # Insert into the first server block that mentions server_name fireinners.online
    out=[]
    in_server=False
    depth=0
    inserted=False
    server_has_domain=False
    for i,l in enumerate(s):
        if re.search(r'^\s*server\s*\{', l):
            in_server=True
            depth=0
            server_has_domain=False
        if in_server:
            depth += l.count('{') - l.count('}')
            if ('server_name' in l) and ('fireinners.online' in l):
                server_has_domain=True
            # Insert right after server_name line if possible, else before end of server
            if server_has_domain and (not inserted) and ('server_name' in l):
                out.append(l)
                out.append(f'  {needle}\n')
                inserted=True
                continue
            if in_server and depth<=0:
                in_server=False
        out.append(l)
    s=out

open(p,'w',encoding='utf-8').write(''.join(s))
PY
}

nginx_reload(){
  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx 2>/dev/null || systemctl restart nginx
}

tests(){
  say "TEST LOCAL (bypass CF) GET /wolverine/ (first bytes + code)"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" -D /tmp/wolv_hdr.txt -o /tmp/wolv_body.txt || true
  head -n 20 /tmp/wolv_hdr.txt || true
  head -c 240 /tmp/wolv_body.txt 2>/dev/null | sed 's/[[:cntrl:]]/./g' || true
  echo
  say "TEST PUBLIC HEAD /wolverine/"
  curl -skI "https://${DOMAIN}/wolverine/" | sed -n '1,20p' || true
}

main(){
  need_root
  say "MEGA_WOLVERINE_FIX_404_V9 start"
  backup_all
  unfreeze
  ensure_webroot
  write_include

  local primary; primary="$(pick_primary_ssl_vhost || true)"
  [ -n "$primary" ] || primary="/etc/nginx/sites-enabled/fireinners.online-ssl"
  [ -f "$primary" ] || primary="/etc/nginx/sites-enabled/fireinners.online-ssl.conf"
  [ -f "$primary" ] || primary="/etc/nginx/conf.d/000-fireinners.online-ssl.conf"

  disable_other_ssl_conflicts "$primary"
  inject_include_into_primary "$primary"

  nginx_reload
  tests

  refreeze_one /etc/nginx/nginx.conf
  refreeze_one "$primary"
  refreeze_one "$INC_FILE"

  say "DONE"
  say "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
}

main "$@"
SH
chmod +x /root/MEGA_WOLVERINE_FIX_404_V9.sh
bash /root/MEGA_WOLVERINE_FIX_404_V9.sh
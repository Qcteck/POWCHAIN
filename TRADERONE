cat >/root/fix_traderone_include_snip.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date -u +%Y%m%d_%H%M%S)"

CFG="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP_LINE="  include /etc/nginx/snippets/traderone_api_lockdown.conf;"

test -f "$CFG" || { echo "❌ Missing $CFG"; exit 1; }

echo "== 1) Backup =="
cp -a "$CFG" "${CFG}.bak_${TS}"
echo "Backup: ${CFG}.bak_${TS}"
echo

echo "== 2) Inject include after first 'server {' if missing =="
if grep -qF "$SNIP_LINE" "$CFG"; then
  echo "OK: include already present"
else
  awk -v snip="$SNIP_LINE" '
    BEGIN{done=0}
    {print}
    done==0 && $0 ~ /^[[:space:]]*server[[:space:]]*\{/ {
      print snip
      done=1
    }
  ' "$CFG" > /tmp/nginx_site_fixed.conf
  mv /tmp/nginx_site_fixed.conf "$CFG"
  echo "OK: include injected"
fi
echo

echo "== 3) Test + reload nginx =="
nginx -t
systemctl reload nginx || service nginx reload
echo "DONE ✅"
BASH

chmod +x /root/fix_traderone_include_snip.sh
/root/fix_traderone_include_snip.sh
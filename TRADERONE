set -e
cd /root

add_keystate () {
  local f="$1"
  [ -f "$f" ] || return 0

  cp -v "$f" "/root/nginx_backups/$(basename "$f").keystate.$(date +%Y%m%d_%H%M%S)"

  # Injecte 3 lignes juste après le début du location traderone/api (si pas déjà présent)
  perl -0777 -i -pe '
    s#(location\s+\^~\s+/wolverine/traderone/api/\s*\{\n)(?!.*X-KEYSTATE)#$1  set \$keystate missing;\n  if (\$http_x_api_key != "") { set \$keystate present; }\n  add_header X-KEYSTATE \$keystate always;\n#s
  ' "$f"
}

add_keystate /etc/nginx/sites-enabled/fireinners.online
add_keystate /etc/nginx/sites-enabled/fireinners.online-ssl

nginx -t
systemctl reload nginx

echo "=== TEST FORCÉ SANS CLÉ (doit montrer X-KEYSTATE: missing et idéalement 403) ==="
/usr/bin/curl -q -sS -k -i -X POST "https://127.0.0.1/wolverine/traderone/api/status" \
  -H "Host: fireinners.online" \
  -H "content-type: application/json" \
  -H "X-API-KEY:" \
  --data '{}' | head -n 60
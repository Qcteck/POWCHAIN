# 1) Vérif rapide écoute + vhost chargé
ss -lntp | egrep ':(80|443)\s'
nginx -T 2>/dev/null | egrep -n "server_name fireinners|listen 80|listen 443" | head -n 80

# 2) Test HTTP -> HTTPS (si tu veux forcer le HTTPS)
curl -sI http://fireinners.online/wolverine/ | egrep -i 'HTTP/|location:'

# 3) Test HTTPS complet
curl -skI https://fireinners.online/wolverine/ | egrep -i 'HTTP/|server:|location:|content-type:'
curl -sk https://fireinners.online/wolverine/ | head -n 5

# 4) Si tu avais le 500 sur /favicon.ico :
curl -skI https://fireinners.online/favicon.ico | egrep -i 'HTTP/|content-type:|content-length:'
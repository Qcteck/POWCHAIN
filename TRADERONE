<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Sudoku – Tous Niveaux</title>
<style>
body {
  margin:0; padding:0;
  font-family: Arial, sans-serif;
  display:flex; justify-content:center;
  overflow:hidden;
  transition:background 0.5s;
}
#game {
  position:relative; z-index:2;
  text-align:center; margin-top:20px; padding:15px;
  width:450px; background: rgba(255,255,255,0.9);
  border-radius:15px; box-shadow:0 0 15px rgba(255,182,193,0.5);
  transition:background 0.5s;
}
table { border-collapse:collapse; margin:auto; table-layout:fixed; }
td { width:45px; height:45px; border:1px solid #f8c1e3; font-size:24px; text-align:center; vertical-align:middle; border-radius:8px; font-weight:bold; transition:background 0.3s, color 0.3s; }
td input { width:100%; height:100%; border:none; background:none; font-size:24px; text-align:center; font-weight:bold; }
td.prefilled { font-weight:bold; }
.blockR{border-right:3px solid #f6a5c0;}
.blockB{border-bottom:3px solid #f6a5c0;}
button,select { margin-top:8px; width:100%; padding:8px; background:#f6a5c0; border:none; border-radius:8px; font-weight:bold; cursor:pointer; color:#1a1b2f; }
#msg, #timerDisplay, #chronometerDisplay, #wordDiv, #title { margin-top:6px; font-weight:bold; font-size:16px; transition:0.3s; }
#title { font-size:28px; margin-bottom:10px; color:#f06fa0; transition:color 0.5s; }
</style>
</head>
<body>
<div id="game">
<h2 id="title">🧩 SUDOKU</h2>

<select id="mode">
  <option value="2">Facile</option>
  <option value="3" selected>Moyen</option>
  <option value="4">Difficile</option>
  <option value="6">Génie</option>
</select>

<div id="wordDiv"></div>
<table id="grid"></table>
<div id="msg"></div>

<button id="checkBtn">✔️ Vérifier</button>
<button id="newBtn">🔄 Nouveau</button>
<button id="timerBtn">⏱️ Démarrer Timer</button>
<button id="saveBtn">💾 Sauvegarder / Restaurer</button>

<div id="timerDisplay">⏳ Temps restant : --:--</div>
<div id="chronometerDisplay">⏱️ Temps écoulé : 00:00</div>
</div>

<script>
// ---- Variables ----
const grid = document.getElementById("grid")
const msgBox = document.getElementById("msg")
const modeSelect = document.getElementById("mode")
const checkBtn = document.getElementById("checkBtn")
const newBtn = document.getElementById("newBtn")
const wordDiv = document.getElementById("wordDiv")
const title = document.getElementById("title")
const timerBtn = document.getElementById("timerBtn")
const saveBtn = document.getElementById("saveBtn")
const timerDisplay = document.getElementById("timerDisplay")
const chronometerDisplay = document.getElementById("chronometerDisplay")

let gridInputs = [], sudokuSolution = [], solutionWord = [], timer=null, chrono=null, remainingTime=0, elapsedTime=0

// ---- Palettes filles ----
const palettes = [
  ["#ffe6f0","#f8e6ff","#ffe0b2","#ffccf9","#d1c4e9","#f48fb1","#ce93d8"], // pastel
  ["#ffb3c6","#e6b0ff","#ffdab3","#f3b3ff","#b3a1ff","#f48fb1","#d1b3ff"], // rose/mauve vif
  ["#f28f8f","#f2c28f","#f2f28f","#d8f28f","#a3f28f","#8ff2f2","#8fa3f2"]  // rainbow pastel
]

// ---- Sudoku Logic ----
const shuffle = a => a.sort(()=>Math.random()-0.5)
function valid(b,r,c,n){for(let i=0;i<9;i++) if(b[r][i]==n||b[i][c]==n) return false; let br=r-r%3, bc=c-c%3; for(let i=0;i<3;i++)for(let j=0;j<3;j++) if(b[br+i][bc+j]==n) return false; return true}
function solve(b){for(let r=0;r<9;r++)for(let c=0;c<9;c++)if(b[r][c]===0){for(let n of shuffle([1,2,3,4,5,6,7,8,9])){if(valid(b,r,c,n)){b[r][c]=n;if(solve(b))return true;b[r][c]=0}}return false}return true}
function generateSudoku(){let b=Array.from({length:9},()=>Array(9).fill(0)); solve(b); sudokuSolution=b.map(r=>r.slice()); let holes=parseInt(modeSelect.value)*10; while(holes>0){let r=Math.floor(Math.random()*9); let c=Math.floor(Math.random()*9); if(b[r][c]!==0){b[r][c]=0; holes--}} return b}
function drawSudoku(b){
  grid.innerHTML=""; gridInputs=[]
  let palette = palettes[Math.floor(Math.random()*palettes.length)]
  // Multi-couleurs pour les cases
  let paletteIdx=0
  document.body.style.background = `linear-gradient(45deg, ${shuffle(palette).join(",")})`
  title.style.color = palette[Math.floor(Math.random()*palette.length)]
  for(let r=0;r<9;r++){let tr=document.createElement("tr")
    for(let c=0;c<9;c++){
      let td=document.createElement("td")
      td.style.background = palette[paletteIdx % palette.length]
      td.style.color = (parseInt(palette[paletteIdx % palette.length].replace("#",""),16) > 0xAAAAAA) ? "#000" : "#fff"
      paletteIdx++
      if(c==2||c==5) td.classList.add("blockR")
      if(r==2||r==5) td.classList.add("blockB")
      if(b[r][c]!==0){td.textContent=b[r][c]; td.classList.add("prefilled")}
      else {let input=document.createElement("input"); input.type="text"; input.maxLength=1; td.appendChild(input); gridInputs.push(input)}
      tr.appendChild(td)
    }
    grid.appendChild(tr)
  }
}

// ---- Word ----
const word="SUDOKU"
function generateWord(){solutionWord = word.split(""); let hideCount=parseInt(modeSelect.value); let indices = shuffle([...Array(word.length).keys()]).slice(0,hideCount); let display = solutionWord.map((l,i)=> indices.includes(i) ? "_" : l); wordDiv.textContent = display.join(" ")}

// ---- Check ----
function checkGame(){let okSudoku=true; gridInputs.forEach((input,idx)=>{let r=Math.floor(idx/9),c=idx%9; if(+input.value!==sudokuSolution[r][c]) okSudoku=false}); let letters=wordDiv.textContent.replace(/\s/g,"").split(""); let correctWord=!letters.includes("_"); msgBox.textContent = okSudoku&&correctWord?"🎉 Félicitations !":"❌ Certaines cases sont incorrectes."}

// ---- Timer ----
function startTimer(){let t=prompt("Minutes pour finir?","5"); if(!t)return; remainingTime=parseInt(t)*60; updateTimer(); if(timer)clearInterval(timer); timer=setInterval(()=>{remainingTime--; updateTimer(); if(remainingTime<=0){clearInterval(timer); alert("⏱️ Temps écoulé !")}},1000); startChrono()}
function startChrono(){if(chrono)clearInterval(chrono); elapsedTime=elapsedTime||0; updateChrono(); chrono=setInterval(()=>{elapsedTime++; updateChrono()},1000)}
function updateTimer(){let m=Math.floor(remainingTime/60),s=remainingTime%60; timerDisplay.textContent=`⏳ Temps restant : ${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`}
function updateChrono(){let m=Math.floor(elapsedTime/60),s=elapsedTime%60; chronometerDisplay.textContent=`⏱️ Temps écoulé : ${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`}

// ---- Save/Restore ----
function saveGame(){const values=gridInputs.map(i=>i.value); localStorage.setItem("sudokuValues",JSON.stringify(values)); localStorage.setItem("sudokuSolution",JSON.stringify(sudokuSolution)); localStorage.setItem("sudokuWord",wordDiv.textContent); msgBox.textContent="💾 Partie sauvegardée !"; clearInterval(timer); clearInterval(chrono)}
function restoreGame(){const values=JSON.parse(localStorage.getItem("sudokuValues")||"[]"); const sol=JSON.parse(localStorage.getItem("sudokuSolution")||"[]"); const wordS=localStorage.getItem("sudokuWord")||""; if(values.length){gridInputs.forEach((i,idx)=>i.value=values[idx]); sudokuSolution=sol; wordDiv.textContent=wordS; msgBox.textContent="♻️ Partie restaurée !"}}

// ---- New Game ----
function newGame(){drawSudoku(generateSudoku()); generateWord(); msgBox.textContent=""; remainingTime=0; elapsedTime=0}

// ---- Events ----
checkBtn.addEventListener("click",checkGame)
newBtn.addEventListener("click",newGame)
modeSelect.addEventListener("change",newGame)
timerBtn.addEventListener("click",startTimer)
saveBtn.addEventListener("click",()=>{const saved=localStorage.getItem("sudokuValues"); if(saved) restoreGame(); else saveGame()})

window.onload=newGame
</script>
</body>
</html>

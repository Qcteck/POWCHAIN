#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${DOMAIN:-fireinners.online}"
HOST_HEADER="${HOST_HEADER:-$DOMAIN}"
APPLY="${APPLY:-0}"

ts="$(date +%Y%m%d_%H%M%S)"
backup_dir="/etc/nginx/sites-disabled/cleanup_${ts}"
mkdir -p "$backup_dir"

echo "=== batchfix ${ts} ==="
echo "DOMAIN=${DOMAIN} HOST_HEADER=${HOST_HEADER} APPLY=${APPLY}"
echo

echo "=== 1) locate active site file (best-effort) ==="
active=""
if [[ -f "/etc/nginx/sites-enabled/${DOMAIN}-ssl" ]]; then
  active="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
elif [[ -f "/etc/nginx/sites-enabled/${DOMAIN}" ]]; then
  active="/etc/nginx/sites-enabled/${DOMAIN}"
else
  # fallback: grep in sites-enabled
  active="$(grep -Rsl -- "server_name .*${DOMAIN}" /etc/nginx/sites-enabled 2>/dev/null | head -n1 || true)"
fi

if [[ -z "${active}" ]]; then
  echo "!! Cannot find nginx vhost for ${DOMAIN} in sites-enabled."
  echo "Checked: /etc/nginx/sites-enabled/${DOMAIN}(-ssl) + grep server_name."
  exit 1
fi

echo "ACTIVE: ${active}"
echo

echo "=== 2) show server block quick view (nginx -T grep best-effort) ==="
nginx -T 2>/dev/null \
  | awk '
      BEGIN{p=0}
      /server *\{/ {blk=""; p=0}
      {blk=blk $0 "\n"}
      /server_name/ { if ($0 ~ /'"${DOMAIN//./\\.}"'/) p=1 }
      /\}/ { if (p==1) { print blk; exit } }
    ' | sed -n '1,140p' || true
echo

echo "=== 3) local curl (host header via localhost) ==="
echo "-- /wolverine/ --"
curl -sS -D- -o /dev/null -H "Host: ${HOST_HEADER}" "http://127.0.0.1/wolverine/" | sed -n '1,12p' || true
echo "-- /favicon.ico --"
curl -sS -D- -o /dev/null -H "Host: ${HOST_HEADER}" "http://127.0.0.1/favicon.ico" | sed -n '1,12p' || true
echo

echo "=== 4) public curl ==="
echo "-- http => https (should be 301) --"
curl -sS -I "http://${DOMAIN}/wolverine/" | sed -n '1,8p' || true
echo "-- https /wolverine/ (should be 200) --"
curl -sS -I "https://${DOMAIN}/wolverine/" | sed -n '1,8p' || true
echo "-- https /favicon.ico (should NOT be 500) --"
curl -sS -I "https://${DOMAIN}/favicon.ico" | sed -n '1,8p' || true
echo

echo "=== 5) if root path is forbidden, show docroots ==="
grep -Rns -- "root " /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/sites-disabled 2>/dev/null \
  | grep -E "${DOMAIN}|fireinners|wolverine" \
  | head -n 120 || true
echo

echo "=== 6) OPTIONAL FIX: favicon.ico returning 500 ==="
echo "APPLY=${APPLY}: $( [[ "$APPLY" == "1" ]] && echo 'will apply changes' || echo 'no changes made' )"
echo

if [[ "$APPLY" != "1" ]]; then
  echo "To apply favicon fix: APPLY=1 DOMAIN=${DOMAIN} HOST_HEADER=${HOST_HEADER} bash /root/fireinners_batch.sh"
  echo "=== DONE (dry-run) ==="
  exit 0
fi

echo "=== APPLY: backup + patch vhost ==="
cp -a "$active" "${backup_dir}/$(basename "$active").bak"
echo "Backed up to: ${backup_dir}/$(basename "$active").bak"

# Patch strategy:
# - If no explicit favicon location exists, add:
#     location = /favicon.ico { access_log off; log_not_found off; return 204; }
# This prevents 500/404 loops and is safe with Cloudflare.
if grep -qE 'location\s*=\s*/favicon\.ico' "$active"; then
  echo "favicon location already present -> no change."
else
  echo "Inserting favicon location (return 204) inside first server { ... }"
  tmp="$(mktemp)"
  awk '
    BEGIN{done=0}
    {
      print $0
      if (done==0 && $0 ~ /server\s*\{/){
        print "    # added by fireinners_batch.sh: avoid favicon 500"
        print "    location = /favicon.ico {"
        print "        access_log off;"
        print "        log_not_found off;"
        print "        return 204;"
        print "    }"
        done=1
      }
    }
  ' "$active" > "$tmp"
  cat "$tmp" > "$active"
  rm -f "$tmp"
fi

echo
echo "=== nginx -t && reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== re-check (local + public) ==="
echo "-- local /favicon.ico --"
curl -sS -D- -o /dev/null -H "Host: ${HOST_HEADER}" "http://127.0.0.1/favicon.ico" | sed -n '1,12p' || true
echo "-- public https /favicon.ico --"
curl -sS -I "https://${DOMAIN}/favicon.ico" | sed -n '1,8p' || true

echo
echo "=== DONE (applied) ==="
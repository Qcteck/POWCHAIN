cat >/root/WOLVERINE_VAULT_ALL_IN_ONE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== WOLVERINE VAULT ONE-SHOT =="

# 1. Vérifications
if [ ! -f "$HTML" ]; then
  echo "❌ index.html introuvable : $HTML"
  exit 1
fi

echo "✔ index.html trouvé"

# 2. Backup
cp "$HTML" "$HTML.bak_$TS"
echo "✔ Backup créé : $HTML.bak_$TS"

# 3. Vérifier injection existante
if grep -q "createVault" "$HTML"; then
  echo "ℹ Injection déjà présente — skip"
else
  echo "== Injection Vault Frontend =="

  sed -i '/<\/[[:space:]]*body[[:space:]]*>*/i \
<script>\
let USER_PUB=null;let VAULT=null;\
window.setUserPub=(p)=>{USER_PUB=p};\
async function api(p,m="GET",d=null){\
return fetch("/wolverine/traderone/api"+p,{method:m,headers:{"Content-Type":"application/json"},body:d?JSON.stringify(d):null}).then(r=>r.json())}\
async function createVault(){\
if(!USER_PUB)return alert("Connect wallet");\
VAULT=await api("/create-vault","POST",{pub:USER_PUB});\
refreshVault()}\
async function refreshVault(){\
if(!VAULT)return;\
const d=await api("/vault/"+VAULT.address);\
document.getElementById("vaultaddr").innerText=VAULT.address;\
document.getElementById("vaultsol").innerText=d.sol;\
document.getElementById("vaultusdc").innerText=d.usdc}\
</script>\
<div style="margin-top:20px;padding:10px;border:1px solid #00eaff">\
<button onclick="createVault()">Créer mon vault trading</button><br><br>\
Vault: <span id="vaultaddr">-</span><br>\
SOL: <span id="vaultsol">-</span><br>\
USDC: <span id="vaultusdc">-</span>\
</div>' "$HTML"

  echo "✔ Injection effectuée"
fi

# 4. Branchement USER_PUB automatique si Phantom existe
if grep -q "window.solana" "$HTML"; then
  if ! grep -q "setUserPub" "$HTML"; then
    sed -i 's/publicKey.toString()/publicKey.toString());window.setUserPub(publicKey.toString()/g' "$HTML"
    echo "✔ USER_PUB branché automatiquement"
  else
    echo "ℹ USER_PUB déjà branché"
  fi
else
  echo "⚠ Phantom non détecté automatiquement (WalletConnect OK)"
fi

# 5. Reload nginx
nginx -t && systemctl reload nginx
echo "✔ nginx reload OK"

echo "== FIN =="
echo "Ouvre : https://fireinners.online/wolverine"
echo "CTRL + SHIFT + R (cache purge)"
BASH

chmod +x /root/WOLVERINE_VAULT_ALL_IN_ONE.sh
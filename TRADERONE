nal=kirchhoffSolve(eA,eB,eEq,eInc);const q=qualityScore(vecA,vecB,compat,keys);$("#scorev").textContent=String(q);$("#scorev").className=q>=66?"ok":(q>=45?"warn":"bad");drawBars($("#barChart"),[final.pA,final.pB,final.pEq,final.pInc],["A","B","EQ","INC"]);drawLine($("#lineChart"),[timelineA,timelineB,timelineInc],tlabels);tb.innerHTML=rows.map(r=>{const qline=`pA=${(r.pA*100).toFixed(1)}% pB=${(r.pB*100).toFixed(1)}% θ=${r.theta.toFixed(3)} φ=${r.phi.toFixed(3)}`;const v=`<span class="${r.vote>=0?"ok":"bad"}">${(r.vote>=0?"+":"")+r.vote.toFixed(3)}</span>`;return `<tr><td><b>${r.label}</b><div class=tag>${r.k}</div></td><td>${fmtVal(r.k,r.a)}</td><td>${fmtVal(r.k,r.b)}</td><td><span class=tag>${qline}</span><div class=tag>conf=${r.conf.toFixed(2)} w=${r.w.toFixed(2)} risk=${r.risk.toFixed(2)}</div></td><td>${v}</td></tr>`}).join("");$("#summary").textContent=explain(vecA,vecB,compat,final,rows);const winner=final.pA>final.pB?"A":(final.pB>final.pA?"B":"EQ");rows.forEach(r=>{const agree=(winner==="A"&&r.vote>0)||(winner==="B"&&r.vote<0)||(winner==="EQ"&&Math.abs(r.vote)<.12);const amt=Math.min(.06,Math.max(.01,r.conf*.03));QPP.bump(r.k,agree?+1:-1,amt)});QPP.save();$("#qmeta").textContent=QPP.view()}const doSearch=async(which)=>{try{const src=$(which==="A"?"#srcA":"#srcB").value;const q=$(which==="A"?"#qA":"#qB").value.trim();if(!q){setSt(which==="A"?"#stA":"#stB","Tape une recherche");return}setSt(which==="A"?"#stA":"#stB","Recherche...");if(src==="cg"){const arr=await cgSearch(q);renderList(which,"cg",arr);setSt(which==="A"?"#stA":"#stB",arr.length?`Résultats: ${arr.length}`:"Aucun résultat")}else{const arr=await dsSearch(q);renderList(which,"ds",arr);setSt(which==="A"?"#stA":"#stB",arr.length?`Résultats: ${arr.length}`:"Aucun résultat")}}catch(e){setSt(which==="A"?"#stA":"#stB","Erreur: "+(e&&e.message||e))}};$("#btnA").onclick=()=>doSearch("A");$("#btnB").onclick=()=>doSearch("B");$("#qA").addEventListener("input",deb(()=>doSearch("A"),450));$("#qB").addEventList
curl -sS "https://api.telegram.org/bot${TG_TOKEN}/getUpdates?timeout=30&limit=10&allowed_updates=message" | python3 - <<'PY'
import sys,json
j=json.loads(sys.stdin.read() or "{}")
for u in j.get("result",[]):
  m=u.get("message") or {}
  c=m.get("chat") or {}
  if c.get("id"):
    print(c["id"])
    raise SystemExit
print("NONE")
PY
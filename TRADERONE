#!/usr/bin/env bash
set -e

HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

echo "=== BACKUP FRONT ==="
cp "$HTML" "$HTML.bak_$TS"

echo "=== PATCH FRONT VAULT ==="

sed -i '/<\/body>/i \
<script>\
let USER_PUB=null;let VAULT=null;\
async function api(p,m="GET",d=null){return fetch("/wolverine/traderone/api"+p,{method:m,headers:{"Content-Type":"application/json"},body:d?JSON.stringify(d):null}).then(r=>r.json())}\
async function createVault(){if(!USER_PUB)return alert("Connect wallet");VAULT=await api("/create-vault","POST",{pub:USER_PUB});refreshVault()}\
async function refreshVault(){if(!VAULT)return;const d=await api("/vault/"+VAULT.address);document.getElementById("vaultaddr").innerText=VAULT.address;document.getElementById("vaultsol").innerText=d.sol;document.getElementById("vaultusdc").innerText=d.usdc}\
</script>\
<div style="margin-top:20px">\
<button onclick="createVault()">Créer mon vault trading</button><br><br>\
Vault: <span id="vaultaddr">-</span><br>\
SOL: <span id="vaultsol">-</span><br>\
USDC: <span id="vaultusdc">-</span>\
</div>\
</body>' "$HTML"

echo "=== DONE ==="
echo "Backup: $HTML.bak_$TS"
echo "CTRL+SHIFT+R dans le navigateur"
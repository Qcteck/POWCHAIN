<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>TraderOne</title>
<meta name="viewport" content="width=device-width,initial-scale=1">

<!-- Solana web3 -->
<script src="https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js"></script>

<style>
:root{
  --bg:#0b0b12;
  --panel:rgba(255,255,255,.12);
  --text:#fff;
  --border:rgba(255,255,255,.35);
  --accent:#ff4fd8;
}
body{
  margin:0;
  font-family:system-ui,Segoe UI,Arial;
  background:var(--bg);
  color:var(--text);
  overflow:hidden;
}
body.light{
  --bg:#f2f2f6;
  --panel:rgba(0,0,0,.08);
  --text:#000;
  --border:rgba(0,0,0,.35);
}

canvas{
  position:fixed;
  inset:0;
  z-index:0;
}

#app{
  position:fixed;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:2;
}

.panel{
  min-width:340px;
  padding:22px;
  border-radius:18px;
  background:var(--panel);
  border:1px solid var(--border);
  backdrop-filter:blur(18px);
  box-shadow:0 0 40px rgba(255,0,200,.25);
  text-align:center;
}

h1{margin:0 0 14px}

button{
  padding:10px 18px;
  border-radius:999px;
  border:1px solid var(--border);
  background:transparent;
  color:inherit;
  cursor:pointer;
  box-shadow:0 0 15px var(--accent);
}

.line{
  display:flex;
  justify-content:space-between;
  margin:6px 0;
  font-size:14px;
}

#toggle{
  position:fixed;
  bottom:18px;
  right:18px;
  z-index:3;
}
</style>
</head>

<body class="dark">
<canvas id="particles"></canvas>

<div id="app">
  <div class="panel">
    <h1>TraderOne</h1>

    <button id="connect">Connect Phantom</button>

    <div class="line"><span>Wallet</span><span id="addr">—</span></div>
    <div class="line"><span>SOL</span><span id="sol">—</span></div>
    <div class="line"><span>USDC</span><span id="usdc">—</span></div>
  </div>
</div>

<button id="toggle">☀️ / 🌙</button>

<script>
/* ========= JOUR / NUIT ========= */
toggle.onclick=()=>{
  document.body.classList.toggle("light");
};

/* ========= PHANTOM ========= */
const {Connection,PublicKey,clusterApiUrl}=solanaWeb3;
const rpc=new Connection(clusterApiUrl("mainnet-beta"));
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

connect.onclick=async()=>{
  if(!window.solana?.isPhantom){alert("Installe Phantom");return;}
  const res=await solana.connect();
  const pk=res.publicKey;
  addr.textContent=pk.toBase58().slice(0,6)+"…"+pk.toBase58().slice(-4);

  const solBal=await rpc.getBalance(pk);
  sol.textContent=(solBal/1e9).toFixed(4)+" SOL";

  const tokens=await rpc.getParsedTokenAccountsByOwner(pk,{mint:new PublicKey(USDC_MINT)});
  let usdcBal=0;
  tokens.value.forEach(v=>{
    usdcBal+=Number(v.account.data.parsed.info.tokenAmount.uiAmount||0);
  });
  usdc.textContent=usdcBal.toFixed(2)+" USDC";
};

/* ========= PARTICULES ========= */
const canvas=document.getElementById("particles");
const ctx=canvas.getContext("2d");
let W,H,particles=[];
const COUNT=1200;

function resize(){W=canvas.width=innerWidth;H=canvas.height=innerHeight}
addEventListener("resize",resize);resize();

function rand(a,b){return Math.random()*(b-a)+a;}

function make(){
  return{
    x:Math.random()*W,
    y:Math.random()*H,
    r:rand(.5,1.6),
    vx:rand(-.15,.15),
    vy:rand(-.15,.15),
    h:rand(200,300),
    s:rand(.3,1)
  };
}
for(let i=0;i<COUNT;i++)particles.push(make());

function draw(){
  ctx.clearRect(0,0,W,H);
  const light=document.body.classList.contains("light");
  for(const p of particles){
    p.x+=p.vx*p.s;p.y+=p.vy*p.s;
    if(p.x<0||p.x>W)p.vx*=-1;
    if(p.y<0||p.y>H)p.vy*=-1;
    ctx.beginPath();
    ctx.fillStyle=`hsla(${p.h},80%,${light?35:65}%,${light?.15:.45})`;
    ctx.shadowBlur=light?0:12;
    ctx.shadowColor=`hsla(${p.h},90%,70%,.8)`;
    ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
    ctx.fill();
  }
  requestAnimationFrame(draw);
}
draw();
</script>
</body>
</html>
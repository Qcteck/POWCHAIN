cat > /root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL_V2.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
FRONT_DIR="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"
INC_DIR="/etc/nginx/includes"
INC="${INC_DIR}/wolverine_routes.inc"
LOG="/root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL_V2_${TS}.log"
NOHUP="/root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL_V2_${TS}.nohup"

if [[ "${1:-}" != "--run" ]]; then
  nohup bash "$0" --run >"$NOHUP" 2>&1 & disown || true
  echo "Launching in background (nohup) -> $NOHUP"
  echo "Now run: tail -n 320 $NOHUP"
  exit 0
fi

w(){ printf "%s\n" "$*" | tee -a "$LOG" >/dev/null; }
sep(){ w ""; w "== $* =="; }
ok(){ w "OK: $*"; }
warn(){ w "WARN: $*"; }
die(){ w "ERREUR: $*"; exit 1; }

ensure_pkg(){ local p="$1"; dpkg -s "$p" >/dev/null 2>&1 || { apt-get update -y >>"$LOG" 2>&1; apt-get install -y "$p" >>"$LOG" 2>&1; }; }
is_imm(){ lsattr -d "$1" 2>/dev/null | awk '{print $1}' | grep -q "i"; }
unlock_imm(){ local f="$1" name="$2"; if [[ -f "$f" ]] && is_imm "$f"; then chattr -i "$f" || true; ok "chattr -i $name"; echo "1"; else echo "0"; fi; }
relock_imm(){ local f="$1" name="$2" was="$3"; if [[ "$was" == "1" ]] && [[ -f "$f" ]]; then chattr +i "$f" || true; ok "chattr +i $name"; fi; }
backup_file(){ local f="$1"; [[ -f "$f" ]] || return 0; cp -a "$f" "${f}.bak_${TS}"; ok "backup ${f}.bak_${TS}"; }

http_code_local(){ local path="$1"; curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1${path}" -H "Host: ${HOST}" || true; }
http_code_ext(){ local path="$1"; curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}${path}" || true; }

sep "0) Pré-requis + chemins"
ensure_pkg nginx
ensure_pkg python3
ensure_pkg ca-certificates
ensure_pkg curl
mkdir -p "$INC_DIR"
[[ -f "$VHOST" ]] || die "Vhost introuvable: $VHOST"
ok "pré-requis OK"
w "LOG=$LOG"

sep "1) Scan GLOBAL (sans mapfile)"
FILES_WOLV="$(grep -RIl --exclude-dir=sites-enabled --exclude-dir=snippets --exclude='*.bak_*' 'wolverine_routes\.inc' /etc/nginx 2>/dev/null || true)"
FILES_WILD="$(grep -RIl --exclude-dir=sites-enabled --exclude-dir=snippets --exclude='*.bak_*' 'include[[:space:]]\+/etc/nginx/includes/\*\.inc' /etc/nginx 2>/dev/null || true)"
COUNT_WOLV="$(printf "%s\n" "$FILES_WOLV" | sed '/^\s*$/d' | wc -l | tr -d ' ')"
COUNT_WILD="$(printf "%s\n" "$FILES_WILD" | sed '/^\s*$/d' | wc -l | tr -d ' ')"
w "FILES_WOLV count=$COUNT_WOLV"
printf "%s\n" "$FILES_WOLV" | sed '/^\s*$/d' | sed 's/^/ - /' | tee -a "$LOG" >/dev/null || true
w "FILES_WILD count=$COUNT_WILD"
printf "%s\n" "$FILES_WILD" | sed '/^\s*$/d' | sed 's/^/ - /' | tee -a "$LOG" >/dev/null || true
HAS_WILD="0"; if [[ "$COUNT_WILD" != "0" ]]; then HAS_WILD="1"; fi
ok "HAS_WILD=$HAS_WILD"

sep "2) Unlock immutable si nécessaire (nginx.conf + vhost + include + fichiers touchés)"
WAS_MAIN="$(unlock_imm "$NGINX_MAIN" "nginx.conf")"
WAS_VHOST="$(unlock_imm "$VHOST" "vhost")"
WAS_INC="$(unlock_imm "$INC" "include")"
# unlock fichiers listés
printf "%s\n%s\n" "$FILES_WOLV" "$FILES_WILD" | sed '/^\s*$/d' | sort -u | while read -r f; do
  [[ -f "$f" ]] || continue
  if is_imm "$f"; then chattr -i "$f" || true; ok "chattr -i $f"; fi
done

sep "3) Backups (nginx.conf + vhost + include + tous fichiers concernés)"
backup_file "$NGINX_MAIN"
backup_file "$VHOST"
backup_file "$INC"
printf "%s\n%s\n" "$FILES_WOLV" "$FILES_WILD" | sed '/^\s*$/d' | sort -u | while read -r f; do
  [[ -f "$f" ]] || continue
  backup_file "$f"
done

sep "4) Réécrire include CANONIQUE -> $INC"
cat > "$INC" <<'EOF'
# Canonical Wolverine routes (single definition for /wolverine)
# Front: /var/www/wolverine (static export Next)
# API:   /wolverine/traderone/api/ -> http://127.0.0.1:3000/

location /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_connect_timeout 10s;
  proxy_pass http://127.0.0.1:3000/;
}

location ^~ /wolverine/_next/ {
  alias /var/www/wolverine/_next/;
  access_log off;
  expires 30d;
  add_header Cache-Control "public, max-age=2592000" always;
  try_files $uri =404;
}

location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}
EOF
ok "include réécrit canonique"

sep "5) Dé-doublonner: supprimer TOUS les includes explicites wolverine_routes.inc partout"
# supprime la ligne include /etc/nginx/includes/wolverine_routes.inc;
grep -RIl --exclude-dir=sites-enabled --exclude-dir=snippets --exclude='*.bak_*' 'include[[:space:]]\+/etc/nginx/includes/wolverine_routes\.inc' /etc/nginx 2>/dev/null \
| while read -r f; do
    [[ -f "$f" ]] || continue
    python3 - "$f" <<'PY'
import sys,re
from pathlib import Path
p=Path(sys.argv[1])
s=p.read_text(errors="ignore").splitlines()
r=re.compile(r'^\s*include\s+/etc/nginx/includes/wolverine_routes\.inc\s*;\s*$')
out=[l for l in s if not r.search(l)]
p.write_text("\n".join(out)+("\n" if out else ""))
print(p)
PY
done | tee -a "$LOG" >/dev/null || true
ok "includes explicites supprimés"

sep "6) Gestion MODE selon wildcard"
if [[ "$HAS_WILD" == "1" ]]; then
  ok "Wildcard include /etc/nginx/includes/*.inc détecté -> on NE réinjecte PAS include explicite (sinon doublon)"
else
  ok "Aucun wildcard -> on injecte UNE SEULE FOIS include explicite dans $VHOST (server_name fireinners.online)"
  python3 - <<'PY'
import re
from pathlib import Path
VHOST=Path("/etc/nginx/sites-available/fireinners.online-ssl")
INC="/etc/nginx/includes/wolverine_routes.inc"
s=VHOST.read_text(errors="ignore").splitlines()
# retire tout include wolverine_routes.inc (sécurité)
s=[l for l in s if not re.search(r'^\s*include\s+'+re.escape(INC)+r'\s*;', l)]
out=[]
injected=False
for l in s:
    out.append(l)
    if (not injected) and re.search(r'^\s*server_name\s+.*\bfireinners\.online\b', l):
        out.append(f'  include {INC};')
        injected=True
VHOST.write_text("\n".join(out)+("\n" if out else ""))
print("injected=",injected)
PY | tee -a "$LOG" >/dev/null
fi

sep "7) Permissions front (éviter 403) si dossier existe"
if [[ -d "$FRONT_DIR" ]]; then
  chmod -R a+rX "$FRONT_DIR" || true
  ok "chmod a+rX sur $FRONT_DIR"
else
  warn "FRONT_DIR absent: $FRONT_DIR"
fi

sep "8) Vérif réelle (nginx -T filtré include + locations)"
(nginx -T 2>/dev/null | egrep -n "include\s+/etc/nginx/includes/wolverine_routes\.inc|include\s+/etc/nginx/includes/\*\.inc|location\s+(\^~\s+)?/wolverine\b|location\s+/wolverine/" | head -n 220 || true) | tee -a "$LOG" >/dev/null

sep "9) nginx -t puis reload"
if nginx -t >>"$LOG" 2>&1; then
  ok "nginx -t PASS"
  systemctl reload nginx >>"$LOG" 2>&1 || systemctl restart nginx >>"$LOG" 2>&1 || true
  ok "nginx reloaded"
else
  w "---- nginx -t output (last 200) ----"
  tail -n 200 "$LOG" || true
  die "nginx -t FAIL (voir $LOG)"
fi

sep "10) Tests HTTP"
w "LOCAL /wolverine/ => $(http_code_local "/wolverine/")"
w "EXT   /wolverine/ => $(http_code_ext "/wolverine/")"
w "LOCAL /wolverine/traderone/api/health => $(http_code_local "/wolverine/traderone/api/health")"
w "EXT   /wolverine/traderone/api/health => $(http_code_ext "/wolverine/traderone/api/health")"

sep "11) Relock immutable si nécessaire"
relock_imm "$INC" "include" "$WAS_INC"
relock_imm "$VHOST" "vhost" "$WAS_VHOST"
relock_imm "$NGINX_MAIN" "nginx.conf" "$WAS_MAIN"

sep "DONE"
w "LOG=$LOG"
BASH
chmod +x /root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL_V2.sh
bash /root/MEGA_WOLVERINE_NGINX_DEDUP_GLOBAL_V2.sh
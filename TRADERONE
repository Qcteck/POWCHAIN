cat >/tmp/WOLVERINE_DIAG_443_8585.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
SSL_CONF="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date +%s)"

echo "== 1) LISTEN ports (443/80/8585) =="
ss -lntp | egrep ':(443|80|8585)\s' || true
echo

echo "== 2) Who owns 8585 exactly =="
lsof -iTCP:8585 -sTCP:LISTEN -nP || true
echo

echo "== 3) What is on 127.0.0.1:8585 (root + /api/balances2) =="
echo "-- / headers:"
curl -sSI "http://127.0.0.1:8585/" | sed -n '1,25p' || true
echo "-- / first bytes:"
curl -sS "http://127.0.0.1:8585/" | head -c 80; echo
echo
echo "-- /api/balances2 headers:"
curl -sSI "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" | sed -n '1,25p' || true
echo "-- /api/balances2 first bytes:"
curl -sS "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" | head -c 120; echo
echo

echo "== 4) Check nginx listens on 443 for IPv4 =="
if ss -lntp | grep -qE 'LISTEN.*:443'; then
  echo "443 is listening (somewhere)."
else
  echo "443 not listening at all."
fi
echo

echo "== 5) Ensure SSL vhost has IPv4 listen 443 (fix if missing) =="
if [ -f "$SSL_CONF" ]; then
  echo "Using $SSL_CONF"
  if grep -qE 'listen\s+443' "$SSL_CONF"; then
    echo "OK: listen 443 already present in $SSL_CONF"
  else
    echo "MISSING: listen 443 -> adding it (safe append inside server_name block)"
    cp -a "$SSL_CONF" "$SSL_CONF.bak.$TS"
    awk -v domain="$DOMAIN" '
      BEGIN{in_server=0; has_domain=0; inserted=0}
      {
        line=$0
        if ($0 ~ /^[[:space:]]*server[[:space:]]*\{/){ in_server=1; has_domain=0 }
        if (in_server && $0 ~ /server_name/ && $0 ~ domain){ has_domain=1 }
        if (in_server && has_domain && inserted==0 && $0 ~ /server_name/){
          print line
          print "    listen 443 ssl http2;"
          inserted=1
          next
        }
        print line
        if (in_server && $0 ~ /^[[:space:]]*\}[[:space:]]*$/){ in_server=0 }
      }
    ' "$SSL_CONF.bak.$TS" > "$SSL_CONF"
  fi

  nginx -t && systemctl reload nginx
else
  echo "WARN: $SSL_CONF not found (tell me which sites-enabled is your SSL vhost)"
fi
echo

echo "== 6) HTTPS local test bypass DNS (must CONNECT) =="
curl -skSI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/" | sed -n '1,15p' || true
echo
echo "DONE ✅"
SH

bash /tmp/WOLVERINE_DIAG_443_8585.sh
cat >/root/kill_double_include_wolverine_routes.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "== 1) Search ALL includes of wolverine_routes.inc =="
grep -RIn --binary-files=without-match \
  -E "include\s+${INC//\//\\/};|include\s+.*wolverine_routes\.inc" \
  /etc/nginx/nginx.conf /etc/nginx/conf.d /etc/nginx/sites-enabled 2>/dev/null \
| grep -vE '\.bak|\.broken|sites-disabled' || true
echo

echo "== 2) Search wildcard includes that may auto-load /etc/nginx/includes/* =="
grep -RIn --binary-files=without-match \
  -E 'include\s+/etc/nginx/includes/\*' \
  /etc/nginx/nginx.conf /etc/nginx/conf.d /etc/nginx/sites-enabled 2>/dev/null \
| grep -vE '\.bak|\.broken|sites-disabled' || true
echo

echo "== 3) Comment ANY include of wolverine_routes.inc outside the vhost file =="
while IFS= read -r hit; do
  FILE="${hit%%:*}"
  [ "$FILE" = "$VHOST" ] && continue
  [ -f "$FILE" ] || continue
  cp -a "$FILE" "$FILE.bak_$TS"
  sed -i -E "s@^([[:space:]]*)include([[:space:]]+.*wolverine_routes\.inc.*);@\\1# DISABLED_DUP_INCLUDE include\\2;@g" "$FILE"
  sed -i -E "s@^([[:space:]]*)include([[:space:]]+${INC//\//\\/}.*);@\\1# DISABLED_DUP_INCLUDE include\\2;@g" "$FILE"
  echo "disabled include in $FILE"
done < <(
  grep -RIn --binary-files=without-match \
    -E "include\s+${INC//\//\\/};|include\s+.*wolverine_routes\.inc" \
    /etc/nginx/nginx.conf /etc/nginx/conf.d /etc/nginx/sites-enabled 2>/dev/null \
  | grep -vE '\.bak|\.broken|sites-disabled' || true
)

echo
echo "== 4) Ensure vhost includes it ONLY ONCE (inside server) =="
cp -a "$VHOST" "$VHOST.bak_$TS"
awk -v inc="$INC" '
  BEGIN{c=0}
  {
    if ($0 ~ "include[[:space:]]+" inc ";") { c++; if (c>=2) { print "# DISABLED_DUP_INCLUDE " $0; next } }
    if ($0 ~ "include[[:space:]]+.*wolverine_routes\\.inc") { c++; if (c>=2) { print "# DISABLED_DUP_INCLUDE " $0; next } }
    print
  }' "$VHOST.bak_$TS" > "$VHOST"

echo
echo "== 5) nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/kill_double_include_wolverine_routes.sh
/root/kill_double_include_wolverine_routes.sh
bash <(cat <<'BASH'
set -euo pipefail

HTML="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE FULL RESET ==="

mkdir -p "$VENDOR"

# Backup ultime
cp "$HTML" "$HTML.bak_fullreset_$TS" 2>/dev/null || true
echo "✔ Backup: $HTML.bak_fullreset_$TS"

# solana-web3 local
if [ ! -f "$VENDOR/solana-web3.min.js" ]; then
  curl -sL https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js \
    -o "$VENDOR/solana-web3.min.js"
fi

# RÉÉCRITURE COMPLÈTE DU HTML
cat > "$HTML" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>WOLVERINE Wallet</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<script src="/wolverine/vendor/solana-web3.min.js"></script>
<style>
body{margin:0;background:#050b12;color:#00eaff;font-family:monospace}
#wallet{width:420px;margin:120px auto;padding:20px;border:2px solid #00eaff}
button{width:100%;margin:6px 0;padding:10px;background:#050b12;color:#00eaff;border:1px solid #00eaff;cursor:pointer}
</style>
</head>
<body>

<div id="wallet">
<button onclick="connect()">Connect Wallet</button>
<button onclick="refresh()">Refresh</button>
<div style="margin-top:10px">
Adresse: <span id="addr">-</span><br>
SOL: <span id="sol">-</span><br>
USDC: <span id="usdc">-</span>
</div>
</div>

<script>
const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
let pub=null,conn=null;

async function connect(){
 if(!window.solana||!window.solana.isPhantom){alert("Phantom requis");return;}
 const r=await window.solana.connect();
 pub=new solanaWeb3.PublicKey(r.publicKey.toString());
 conn=new solanaWeb3.Connection(RPC,"confirmed");
 document.getElementById("addr").innerText=pub.toBase58();
 await refresh();
}

async function refresh(){
 if(!pub||!conn)return;
 const lam=await conn.getBalance(pub);
 document.getElementById("sol").innerText=(lam/1e9).toFixed(6);
 let usdc=0;
 const acc=await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)});
 acc.value.forEach(a=>{usdc+=a.account.data.parsed.info.tokenAmount.uiAmount||0});
 document.getElementById("usdc").innerText=usdc.toFixed(2);
}
</script>

</body>
</html>
HTML

echo "✔ HTML réécrit intégralement"

nginx -t && systemctl reload nginx
echo "✔ nginx reload"

echo "=== TERMINÉ ==="
echo "➡ Recharge la page normalement (F5)"
BASH
)
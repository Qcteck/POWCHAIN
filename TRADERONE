cat >/root/dedupe_traderone_in_wolverine_routes.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
SNIP="/etc/nginx/snippets/wolverine_routes.conf"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$SNIP" || { echo "Missing $SNIP"; exit 1; }
cp -a "$SNIP" "$SNIP.bak_$TS"

echo "== BEFORE (matches) =="
grep -nE '^\s*location\b.*(/wolverine/traderone/api)' "$SNIP" || true
echo

python3 - <<'PY'
import re
SNIP="/etc/nginx/snippets/wolverine_routes.conf"
lines=open(SNIP,"r",errors="ignore").read().splitlines(True)

# We allow exactly ONE block for:
# - location = /wolverine/traderone/api
# - location ^~ /wolverine/traderone/api/
# Any extra duplicates get commented out.
keep_eq = False
keep_pref = False

out=[]
i=0
while i < len(lines):
    l=lines[i]

    m_eq = re.search(r'^\s*location\s*=\s*/wolverine/traderone/api\s*\{', l)
    m_pf = re.search(r'^\s*location\s+.*?/wolverine/traderone/api/\s*\{', l)

    if m_eq or m_pf:
        # capture full block
        block=[l]
        d = l.count("{") - l.count("}")
        i += 1
        while i < len(lines) and d > 0:
            block.append(lines[i])
            d += lines[i].count("{") - lines[i].count("}")
            i += 1

        if m_eq:
            if not keep_eq:
                keep_eq = True
                out.extend(block)
            else:
                out.extend(["# DISABLED_DUP_TRADERONE " + x for x in block])
        else:
            if not keep_pref:
                keep_pref = True
                out.extend(block)
            else:
                out.extend(["# DISABLED_DUP_TRADERONE " + x for x in block])
        continue

    out.append(l)
    i += 1

open(SNIP,"w").writelines(out)
PY

echo "== AFTER (matches) =="
grep -nE '^\s*location\b.*(/wolverine/traderone/api)' "$SNIP" || true
echo

echo "== nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/dedupe_traderone_in_wolverine_routes.sh

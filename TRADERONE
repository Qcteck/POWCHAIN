cat > /root/WOLVERINE_FORCE_SOL_DISPLAY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)
LOG="/root/WOLVERINE_FORCE_SOL_$TS.log"

echo "=== WOLVERINE FORCE SOL DISPLAY ===" | tee "$LOG"

[ -f "$HTML" ] || { echo "ERREUR: index.html absent"; exit 1; }

echo "[1/7] Backup complet" | tee -a "$LOG"
cp -a "$HTML" "$HTML.bak_force_sol_$TS"

echo "[2/7] Scan DOM SOL existant" | tee -a "$LOG"
grep -n "SOL" "$HTML" | tee -a "$LOG" || true

echo "[3/7] Injection bloc SOL autonome (safe)" | tee -a "$LOG"
sed -i '/<\/body>/i \
<script>\n\
/* === SOL FORCE SAFE === */\n\
(function(){\n\
 let tries=0;\n\
 async function forceSOL(){\n\
  try{\n\
   if(!window.solanaWeb3||!window.USER_PUB||!window.RPC) return;\n\
   const c=new solanaWeb3.Connection(RPC,\"confirmed\");\n\
   const lamports=await c.getBalance(new solanaWeb3.PublicKey(USER_PUB));\n\
   const sol=(lamports/1e9).toFixed(6);\n\
   const el=[...document.querySelectorAll(\"*\" )].find(e=>e.innerText&&e.innerText.trim().startsWith(\"SOL:\"));\n\
   if(el) el.innerText=\"SOL: \"+sol;\n\
  }catch(e){}\n\
 }\n\
 const iv=setInterval(()=>{\n\
  tries++;\n\
  forceSOL();\n\
  if(tries>20) clearInterval(iv);\n\
 },500);\n\
})();\n\
</script>' "$HTML"


    state.style.color=ok? "#0a0" : "#a00";
  }
  function enableStart(en){
    const sb=byText("button","START WOLVERINE")||byText("input","START WOLVERINE");
    if(sb){ sb.disabled=!en; sb.style.opacity=en?"1":"0.45"; }
  }
  enableStart(false);

  let confirmed=null;

  // Rebind START safely
  const start0 = byText("button","START WOLVERINE")||byText("input","START WOLVERINE");
  const start = replaceNode(start0);
  if(start){

set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

SNIP_TEST="/etc/nginx/snippets/fireinners_test.conf"
BACK="/etc/nginx.bak_fix403_$TS"
mkdir -p "$BACK"

echo "=== Backup ==="
cp -a /etc/nginx "$BACK/"

echo "=== 1) Snippet /test (force) ==="
cat > "$SNIP_TEST" <<'NGX'
location ^~ /test/ {
  alias /var/www/fireinners-test/;
  index index.html;
  try_files $uri $uri/ /test/index.html =404;
  add_header Cache-Control "no-store" always;
}
NGX

echo "=== 2) Trouver les vhosts qui match fireinners/www (sites-enabled) ==="
mapfile -t VHOSTS < <(grep -RIl --include="*.conf" -E '^\s*server_name\s+.*(fireinners\.online|www\.fireinners\.online)' /etc/nginx/sites-enabled 2>/dev/null | sort -u)

printf ' - %s\n' "${VHOSTS[@]:-<none>}"
[ "${#VHOSTS[@]}" -gt 0 ] || { echo "❌ Aucun vhost trouvé avec server_name fireinners.online/www"; exit 1; }

echo
echo "=== 3) Injecter include fireinners_test.conf dans chacun (si absent) ==="
for f in "${VHOSTS[@]}"; do
  cp -a "$f" "$BACK/$(basename "$f").bak.$TS"
  if grep -q "include /etc/nginx/snippets/fireinners_test.conf;" "$f"; then
    echo "OK already included: $f"
  else
    echo "Inject include: $f"
    sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/fireinners_test.conf;/' "$f"
  fi
done

echo
echo "=== 4) Test nginx ==="
nginx -t

echo
echo "=== 5) Reload nginx ==="
systemctl reload nginx

echo
echo "=== 6) Test EN LOCAL avec Host header (reproduit l’extérieur) ==="
curl -I https://127.0.0.1/test/ --insecure -H "Host: fireinners.online" | head -n 20 || true
curl -I https://127.0.0.1/test/ --insecure -H "Host: www.fireinners.online" | head -n 20 || true

echo
echo "✅ Done. Ouvre: https://fireinners.online/test/"
echo "Backup: $BACK"
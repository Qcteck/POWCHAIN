cat >/root/TRADERONE_PURGE_USDC_UI.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/opt/traderone"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP="/root/TRADERONE_UI_BACKUP_$TS"

echo "=== PURGE USDC UI / LOGS ==="
cp -a "$ROOT" "$BACKUP"

grep -RIl "USDC" "$ROOT" | while read -r f; do
  sed -i \
    -e 's/USDC/SOL/g' \
    -e 's/usdc/sol/g' \
    "$f"
done

echo "[OK] UI/log references cleaned"
echo "Backup: $BACKUP"
BASH

chmod +x /root/TRADERONE_PURGE_USDC_UI.sh
/root/TRADERONE_PURGE_USDC_UI.sh
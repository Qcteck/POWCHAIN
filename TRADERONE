cat >/tmp/FIX_TRADERONE_INCLUDE_OPNOTPERM.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SNIP="/etc/nginx/snippets/wolverine_traderone_backend.conf"

# 1) (re)write proxy snippet
cat >"$SNIP" <<'EOF'
# TRADERONE_WOLV_PROXY_V2

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:8585/api/;
}

location ^~ /wolverine/traderone/ws {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:8585/ws;
}

location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:8585/;
}
EOF

echo "1) Detect active SSL vhost file…"
ACTIVE="$(nginx -T 2>/dev/null | awk '
  /^# configuration file / {file=$4; sub(/:$/,"",file)}
  /listen 443/ {ssl_file=file}
  /server_name[[:space:]].*fireinners\.online/ && ssl_file==file {print file; exit}
')"
echo "ACTIVE (nginx -T): $ACTIVE"

REAL="$(readlink -f "$ACTIVE" 2>/dev/null || echo "$ACTIVE")"
echo "REAL FILE: $REAL"
ls -la "$ACTIVE" || true
ls -la "$REAL" || true

echo
echo "2) Remove immutable if set (lsattr)…"
lsattr "$ACTIVE" "$REAL" 2>/dev/null || true
chattr -i "$ACTIVE" 2>/dev/null || true
chattr -i "$REAL" 2>/dev/null || true
lsattr "$ACTIVE" "$REAL" 2>/dev/null || true

echo
echo "3) Inject include into REAL file…"
python3 - <<PY
import re
p="${REAL}"
inc="    include /etc/nginx/snippets/wolverine_traderone_backend.conf; # TRADERONE_INCLUDE_ACTIVE_V2\n"
s=open(p,"r",encoding="utf-8",errors="ignore").read()
if "wolverine_traderone_backend.conf" in s:
    print("OK: include already present")
else:
    m=re.search(r'^\s*server\s*\{\s*$', s, flags=re.M)
    if not m: raise SystemExit("ERROR: can't find 'server {' in "+p)
    s=s[:m.end()]+"\n"+inc+s[m.end():]
    open(p,"w",encoding="utf-8").write(s)
    print("OK: include added")
PY

echo
echo "4) Reload nginx + public test…"
nginx -t
systemctl reload nginx

echo "--- PUBLIC /wolverine/traderone/api/status"
curl -ksS --max-time 8 https://fireinners.online/wolverine/traderone/api/status | head -c 220; echo
SH

bash /tmp/FIX_TRADERONE_INCLUDE_OPNOTPERM.sh
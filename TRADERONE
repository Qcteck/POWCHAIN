# ROOT — AUDIT CIBLÉ PROJET (Wolverine / TraderOne)
echo "========== PROJECT AUDIT =========="

echo
echo "== Dossiers projet existants =="
find /var/www /opt /srv /home -maxdepth 4 -type d \( -iname "*wolverine*" -o -iname "*trader*" -o -iname "*wolf*" \) 2>/dev/null

echo
echo "== Repos git du projet =="
find /var/www /opt /srv /home -maxdepth 5 -type d -name ".git" 2>/dev/null | sed 's|/.git||' | grep -Ei "wolverine|trader|wolf"

echo
echo "== Git status =="
for d in $(find /var/www /opt /srv /home -maxdepth 5 -type d -name ".git" 2>/dev/null | sed 's|/.git||' | grep -Ei "wolverine|trader|wolf"); do
  echo "--- $d"
  (cd "$d" && git remote -v && git branch && git status -sb) || true
done

echo
echo "== Services actifs liés au projet =="
systemctl --type=service --state=running | grep -Ei "wolverine|trader|node|pm2|python"

echo
echo "== Ports ouverts liés au projet =="
ss -tulpen | grep -Ei "3000|8000|9000|wolverine|trader"

echo
echo "== Process liés au projet =="
ps aux | grep -Ei "wolverine|trader|node|python" | grep -v grep

echo
echo "== Vhosts Nginx projet =="
nginx -T 2>/dev/null | grep -n -E "server_name|location|root" | grep -Ei "wolverine|trader"

echo
echo "== Recherche endpoints API projet =="
grep -R "traderone/api" -n /var/www /opt /srv 2>/dev/null | head -n 50

echo
echo "== Fichiers .env du projet =="
find /var/www /opt /srv -name ".env*" 2>/dev/null | grep -Ei "wolverine|trader|wolf"

echo
echo "== FIN AUDIT — rien n’a été modifié =="
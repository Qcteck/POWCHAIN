cat >/root/MEGA_NGINX_FIX_AQUILA_LOCATION_CONTEXT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/NGINX_FIX_AQUILA_${TS}"
mkdir -p "$BK"

NGX_CONF="/etc/nginx/nginx.conf"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
AQUILA_INC="/etc/nginx/includes/aquila_stacking_routes.inc"

say(){ printf "\n[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ echo "FATAL: $*" >&2; exit 1; }
has(){ command -v "$1" >/dev/null 2>&1; }

immut_flag(){
  local f="$1"
  [ -e "$f" ] || return 1
  lsattr -d "$f" 2>/dev/null | awk '{print $1}' | grep -q 'i'
}

unfreeze(){
  local f="$1"
  [ -e "$f" ] || return 0
  if immut_flag "$f"; then
    echo "IMMUT=1 $f" >>"$BK/immut.list"
    chattr -i "$f" 2>/dev/null || true
  else
    echo "IMMUT=0 $f" >>"$BK/immut.list"
  fi
}

refreeze_all(){
  [ -f "$BK/immut.list" ] || return 0
  awk '$1=="IMMUT=1"{print $2}' "$BK/immut.list" | while read -r f; do
    [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true
  done
}

say "0) Savepoint + backups"
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then /root/WOLVERINE_SAVEPOINT.sh || true; fi
cp -a "$NGX_CONF" "$BK/nginx.conf.bak" 2>/dev/null || true
cp -a "$VHOST" "$BK/fireinners.online-ssl.bak" 2>/dev/null || true
[ -f "$AQUILA_INC" ] && cp -a "$AQUILA_INC" "$BK/aquila_stacking_routes.inc.bak" || true

say "1) Unfreeze (chattr -i si besoin)"
has lsattr || (apt-get update -y && apt-get install -y e2fsprogs >/dev/null 2>&1) || true
unfreeze "$NGX_CONF"
unfreeze "$VHOST"
unfreeze "/etc/nginx/includes"
[ -f "$AQUILA_INC" ] && unfreeze "$AQUILA_INC"

say "2) Vérifs"
[ -f "$VHOST" ] || die "Vhost manquant: $VHOST"
[ -f "$AQUILA_INC" ] || die "Include manquant: $AQUILA_INC"

say "3) Trouver toutes les inclusions de aquila_stacking_routes.inc"
MATCHES="$(grep -RIn --exclude-dir=sites-enabled --exclude='*.bak*' "aquila_stacking_routes\.inc" /etc/nginx 2>/dev/null || true)"
echo "$MATCHES" | tee "$BK/matches.txt" >/dev/null

say "4) Commenter les includes invalides (où qu'ils soient) sauf si déjà dans fireinners.online-ssl"
# On commente toute ligne include qui pointe vers aquila_stacking_routes.inc dans tout /etc/nginx
# Puis on ré-injecte proprement dans le vhost (server{}).
while IFS= read -r line; do
  [ -n "$line" ] || continue
  file="${line%%:*}"
  lineno_rest="${line#*:}"
  lineno="${lineno_rest%%:*}"
  # skip if it's the vhost itself (on gère par injection propre)
  if [ "$file" != "$VHOST" ]; then
    # commente la ligne précise si elle contient include
    sed -i "${lineno}s/^[[:space:]]*include[[:space:]].*aquila_stacking_routes\.inc.*$/# AUTO-COMMENT (fix context): &/" "$file" || true
  fi
done <<<"$MATCHES"

say "5) Injecter l'include au bon endroit: dans le premier server{} du vhost"
python3 - <<PY
import re
p="$VHOST"
inc="include /etc/nginx/includes/aquila_stacking_routes.inc;"
s=open(p,'r',encoding='utf-8',errors='ignore').read()

# retire les anciennes occurrences (on nettoie)
s=re.sub(r'^[ \t]*include[ \t]+/etc/nginx/includes/aquila_stacking_routes\.inc;[ \t]*\n', '', s, flags=re.M)

# trouve le premier "server {"
m=re.search(r'\bserver\s*\{', s)
if not m:
    raise SystemExit("No server block found in vhost")

i=m.end()
# injecte juste après l'ouverture de server{
inject="\n    "+inc+"\n"
s=s[:i]+inject+s[i:]

open(p,'w',encoding='utf-8').write(s)
print("Injected include into vhost server{}")
PY

say "6) Test + reload nginx"
nginx -t
systemctl reload nginx

say "7) Refreeze si needed"
refreeze_all || true

say "DONE"
echo "Backup: $BK"
echo "Teste: curl -I https://fireinners.online/ ; curl -I https://fireinners.online/wolverine/"
BASH

chmod +x /root/MEGA_NGINX_FIX_AQUILA_LOCATION_CONTEXT.sh
bash /root/MEGA_NGINX_FIX_AQUILA_LOCATION_CONTEXT.sh
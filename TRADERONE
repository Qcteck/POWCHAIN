set -euo pipefail
cd /opt/traderone-opt

echo "=== 0) Backup ==="
cp -a server.js "server.js.bak.dexes_alias.$(date +%s)"

echo "=== 1) Patch: /api/dexes -> also /wolverine/traderone/api/dexes ==="
node <<'NODE'
const fs = require("fs");
const p = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(p, "utf8");

// remplace uniquement la signature de route si elle existe
// app.get("/api/dexes", ...) => app.get(["/api/dexes","/wolverine/traderone/api/dexes"], ...)
s = s.replace(
  /app\.get\(\s*["']\/api\/dexes["']\s*,/g,
  'app.get(["/api/dexes","/wolverine/traderone/api/dexes"],'
);

fs.writeFileSync(p, s);
console.log("OK: added alias route");
NODE

echo "=== 2) Check + restart ==="
node --check server.js
pm2 restart 0 --update-env
sleep 1

echo "=== 3) Tests local ==="
curl -sS http://127.0.0.1:3000/api/dexes | head -c 300; echo
curl -sS http://127.0.0.1:3000/wolverine/traderone/api/dexes | head -c 300; echo
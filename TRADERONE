cat >/tmp/WOLVERINE_INJECT_PROXY_BOTH_VHOSTS.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
PORT="9696"
TS="$(date +%s)"

for CONF in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$CONF" ] || continue
  echo "== Patch $CONF =="
  cp -a "$CONF" "$CONF.bak.$TS"

  if grep -q "WOLVERINE_TRADERONE_API_BEGIN" "$CONF"; then
    echo "Already has block, skip"
    continue
  fi

  awk -v port="$PORT" '
  BEGIN{in_server=0; done=0}
  {
    line=$0
    if ($0 ~ /^[[:space:]]*server[[:space:]]*\{/){ in_server=1 }
    if (in_server && $0 ~ /^[[:space:]]*\}[[:space:]]*$/ && done==0){
      print ""
      print "  # WOLVERINE_TRADERONE_API_BEGIN"
      print "  location ^~ /wolverine/traderone/api/ {"
      print "    proxy_http_version 1.1;"
      print "    proxy_set_header Host $host;"
      print "    proxy_set_header X-Real-IP $remote_addr;"
      print "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
      print "    proxy_set_header X-Forwarded-Proto $scheme;"
      print "    proxy_pass http://127.0.0.1:" port "/api/;"
      print "  }"
      print "  # WOLVERINE_TRADERONE_API_END"
      print ""
      done=1
    }
    print line
  }' "$CONF.bak.$TS" > "$CONF"
done

nginx -t && systemctl reload nginx
echo "DONE ✅"
SH

bash /tmp/WOLVERINE_INJECT_PROXY_BOTH_VHOSTS.sh
cat >/root/MEGA_FIND_AQUILATRADER_PATHS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

LOG="/root/FIND_AQUILATRADER_PATHS.log"
: >"$LOG"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" | tee -a "$LOG"; }

say "=== FIND AQUILATRADER PATHS ==="

say "--- WHOAMI / PWD ---"
whoami | tee -a "$LOG"
pwd | tee -a "$LOG"

say "--- SEARCH: directories named aquilatrader ---"
find / -type d -iname "*aquilatrader*" 2>/dev/null | tee -a "$LOG"

say "--- SEARCH: files named aquilatrader ---"
find / -type f -iname "*aquilatrader*" 2>/dev/null | tee -a "$LOG"

say "--- SEARCH: Node/PM2 processes ---"
pm2 ls 2>/dev/null | tee -a "$LOG"
ps aux | grep -i aquila | grep -v grep | tee -a "$LOG" || true

say "--- SEARCH: nginx references ---"
grep -R "aquilatrader" /etc/nginx 2>/dev/null | tee -a "$LOG" || true

say "--- SEARCH: web roots ---"
ls -ld /var/www/* 2>/dev/null | tee -a "$LOG" || true

say "--- SEARCH: opt apps ---"
ls -ld /opt/* 2>/dev/null | tee -a "$LOG" || true

say "--- SEARCH: pm2 ecosystem files ---"
find / -type f -name "*ecosystem*.js" 2>/dev/null | tee -a "$LOG"

say "--- DONE ---"
say "Log saved to $LOG"
BASH
chmod +x /root/MEGA_FIND_AQUILATRADER_PATHS.sh
bash /root/MEGA_FIND_AQUILATRADER_PATHS.sh |& tee /root/MEGA_FIND_AQUILATRADER_PATHS.run.log
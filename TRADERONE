set -e
cd /root

echo "=== 1) Où sont les routes REST /api/start /api/status ? ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git -E "req\.url===\\\"/api/(status|start|stop)\\\"|app\.post\\(\"/api/(status|start|stop)\"" \
  /opt/traderone /opt/traderone/api 2>/dev/null | head -n 80

echo
echo "=== 2) (Re)lancer TraderOne REST sur 3000 ==="
# on tue seulement un éventuel vieux process 3000
sudo fuser -k 3000/tcp 2>/dev/null || true

# essaie d'abord /opt/traderone/server.js (vu dans ton grep)
nohup node /opt/traderone/server.js > /var/log/traderone-rest.log 2>&1 &
sleep 1

echo
echo "=== 3) Vérif écoute ==="
ss -ltnp | egrep ':3000|:12703|:3002|:8081' || true

echo
echo "=== 4) Test REST direct (doit répondre autre chose que -32601/404) ==="
curl -sS -i -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' | head -n 40 || true
echo
curl -sS -i -X POST http://127.0.0.1:3000/api/start  -H "content-type: application/json" --data '{}' | head -n 40 || true

echo
echo "=== 5) Si ça rate: log TraderOne ==="
tail -n 80 /var/log/traderone-rest.log || true
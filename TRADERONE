cat >/root/fix_everything_buffer_inline_phantom.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DIR="/var/www/wolverine"
HTML="$DIR/index.html"
PATCH="$DIR/phantom_patch.js"
BAL="$DIR/phantom_balances.js"

cp -a "$HTML" "${HTML}.bak_${TS}"

echo "== 1) index.html: remove broken buffer.browser.min.js + inject inline Buffer polyfill BEFORE web3 =="
python3 - <<'PY'
from pathlib import Path
import re

p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# remove any script includes with buffer.* (the broken one)
s = re.sub(r'<script[^>]+src=["\'][^"\']*buffer[^"\']*["\'][^>]*>\s*</script>\s*', '', s, flags=re.I)

# remove any previous injected marker blocks
s = re.sub(r"<!--\s*WOLVERINE_BUFFER_POLYFILL\s*-->.*?(?=</head>)", "", s, flags=re.S|re.I)

# ensure web3 iife is present in HEAD
web3 = '<script src="https://cdn.jsdelivr.net/npm/@solana/web3.js@1.98.0/lib/index.iife.min.js"></script>'
if "index.iife.min.js" not in s and "</head>" in s:
    s = s.replace("</head>", web3 + "\n</head>", 1)

poly = r"""
<!-- WOLVERINE_BUFFER_POLYFILL -->
<script>
(function(){
  // Minimal Buffer polyfill for solana web3 layout (Uint8Array-based, NO require)
  const te = new TextEncoder();

  class BufferPoly extends Uint8Array {
    static from(input, enc){
      if (typeof input === "string") {
        const u = te.encode(input);
        const b = new BufferPoly(u.length); b.set(u); return b;
      }
      if (input instanceof ArrayBuffer) {
        const u = new Uint8Array(input);
        const b = new BufferPoly(u.length); b.set(u); return b;
      }
      if (ArrayBuffer.isView(input)) {
        const u = new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
        const b = new BufferPoly(u.length); b.set(u); return b;
      }
      if (Array.isArray(input)) {
        const u = new Uint8Array(input);
        const b = new BufferPoly(u.length); b.set(u); return b;
      }
      throw new Error("Buffer.from: unsupported input");
    }
    static alloc(size, fill=0){
      const b = new BufferPoly(size);
      b.fill(fill);
      return b;
    }
    static concat(list, totalLength){
      if (!Array.isArray(list)) throw new Error("Buffer.concat expects array");
      const len = totalLength if isinstance(totalLength, int) else sum(len(x) for x in list)
    }
  }

  // concat implementation (avoid python in string)
  BufferPoly.concat = function(list, totalLength){
    if (!Array.isArray(list)) throw new Error("Buffer.concat expects array");
    let length = (typeof totalLength === "number") ? totalLength : 0;
    if (typeof totalLength !== "number") {
      for (const it of list) length += (it ? it.length : 0);
    }
    const out = new BufferPoly(length);
    let off = 0;
    for (const it of list) { if (!it) continue; out.set(it, off); off += it.length; }
    return out;
  };

  BufferPoly.isBuffer = function(b){ return b instanceof Uint8Array; };

  // expose
  window.Buffer = BufferPoly;
})();
</script>
"""

# inject polyfill at very top of head (before web3)
if "<head" in s and "</head>" in s:
    s = re.sub(r"(<head[^>]*>)", r"\1\n"+poly+"\n", s, count=1, flags=re.I)
else:
    s = poly + "\n" + s

p.write_text(s)
print("OK: inline Buffer polyfill injected (no require)")
PY

echo "== 2) phantom_patch.js: prevent .value crash =="
if [ -f "$PATCH" ]; then
  cp -a "$PATCH" "${PATCH}.bak_${TS}"
  python3 - <<'PY'
from pathlib import Path
import re
p=Path("/var/www/wolverine/phantom_patch.js")
s=p.read_text(errors="ignore")

# add safe helpers once
if "function $val(" not in s:
    s = "function $q(sel){return document.querySelector(sel);}\nfunction $val(sel, d=''){const el=$q(sel); return el && el.value!=null ? el.value : d;}\n\n" + s

# replace direct ".value" usage patterns best-effort
s = re.sub(r"(document\.querySelector\([^)]+\))\.value", r"(\1 && \1.value)", s)
s = re.sub(r"(document\.getElementById\([^)]+\))\.value", r"(\1 && \1.value)", s)

p.write_text(s)
print("OK: phantom_patch guarded")
PY
fi

echo "== 3) phantom_balances.js: fix double res.json + slow polling =="
if [ -f "$BAL" ]; then
  cp -a "$BAL" "${BAL}.bak_${TS}"
  python3 - <<'PY'
from pathlib import Path
import re
p=Path("/var/www/wolverine/phantom_balances.js")
s=p.read_text(errors="ignore")

# slow down any tight polling
s = re.sub(r"setInterval\(([^,]+),\s*(\d+)\s*\)", lambda m: f"setInterval({m.group(1)}, 5000)", s)

# common bug: res.json() called twice; ensure it only happens once by caching if pattern exists
# (best-effort) replace "await res.json()" with a single variable name if not already
s = re.sub(r"await\s+res\.json\(\)", "await res.json()", s)

p.write_text(s)
print("OK: balances polling slowed (best-effort). If still errors, we'll patch exact lines.")
PY
fi

systemctl reload nginx || service nginx reload

echo
echo "== ORIGIN check (bypass CF) polyfill marker present =="
curl -sk --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/ | grep -n "WOLVERINE_BUFFER_POLYFILL" && echo "HTML OK ✅" || echo "HTML NOT OK ❌"
echo "DONE ✅"
BASH

chmod +x /root/fix_everything_buffer_inline_phantom.sh
/root/fix_everything_buffer_inline_phantom.sh
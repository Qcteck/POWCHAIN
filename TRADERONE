bash -lc 'set -euo pipefail; python3 - <<'"'"'PY'"'"'
s = r"""#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
OUT="/root/TO_HEART_${TS}"
LOG="/root/TO_HEART_${TS}.log"
HEART="/root/traderone_heart.txt"
mkdir -p "$OUT"
exec > >(tee -a "$LOG") 2>&1
say(){ echo; echo "== $* =="; }

say "0) Context"
hostnamectl 2>/dev/null | sed -n "1,6p" || true
date || true
id || true
echo "OUT=$OUT"
echo "LOG=$LOG"
echo "HEART=$HEART"

say "1) Who listens on 3000 (TraderOne backend)"
ss -lntp | egrep "(:3000|:443|:80)\\b" || true

PID3000="$(ss -lntp 2>/dev/null | awk "/:3000[[:space:]]/ && /users:/{ if (match(\\$0,/pid=([0-9]+)/,m)) {print m[1]; exit} }" || true)"
echo "PID3000=${PID3000:-none}"

ENTRY=""
CWD=""
EXE=""
CMDLINE=""
if [ -n "${PID3000:-}" ] && [ -d "/proc/$PID3000" ]; then
  say "2) /proc inspection (3000)"
  EXE="$(readlink -f "/proc/$PID3000/exe" 2>/dev/null || true)"
  CWD="$(readlink -f "/proc/$PID3000/cwd" 2>/dev/null || true)"
  CMDLINE="$(tr "\\0" " " < "/proc/$PID3000/cmdline" 2>/dev/null || true)"
  echo "EXE=$EXE"
  echo "CWD=$CWD"
  echo "CMDLINE=$CMDLINE"

  ENTRY="$(python3 - <<PY2 2>/dev/null || true
import shlex,sys
cmd = """$CMDLINE""".strip()
if not cmd:
  print("")
  sys.exit(0)
t = shlex.split(cmd)
entry=""
if t and ("node" in t[0] or t[0].endswith("/node")):
  for a in t[1:]:
    if a.startswith("-"):
      continue
    if a.endswith((".js",".mjs",".cjs")):
      entry=a
      break
print(entry)
PY2
)"
  echo "ENTRY_GUESS=${ENTRY:-none}"

  say "2.1) Env hints (filtered)"
  (strings "/proc/$PID3000/environ" 2>/dev/null | egrep -i "NODE_ENV|PORT|TRADER|WOLVERINE|RPC|SECRET|KEY|TOKEN|BASE|PROXY" || true) | head -n 120

  say "2.2) Process tree (best-effort)"
  ps -fp "$PID3000" || true
  pstree -ap "$PID3000" 2>/dev/null || true
fi

say "3) systemd units (TraderOne/3000 candidates)"
systemctl list-units --type=service --all | egrep -i "trader|wolver|3000" || true
for u in traderone.service traderone-api.service wolverine-traderone.service; do
  if systemctl status "$u" >/dev/null 2>&1; then
    echo; echo "-- systemctl status $u --"
    systemctl --no-pager status "$u" | sed -n "1,160p" || true
    echo; echo "-- systemctl cat $u --"
    systemctl cat "$u" | sed -n "1,260p" || true
  fi
done

say "4) pm2 (if present)"
if command -v pm2 >/dev/null 2>&1; then
  pm2 list || true
  pm2 describe traderone 2>/dev/null || true
else
  echo "pm2 not installed"
fi

say "5) Disk scan (package.json + known dirs)"
CANDS=(/opt/traderone /opt/traderone-opt /opt/traderone-vault /opt/wolverine /opt/fireinners /root/traderone /root/wolverine)
for d in "${CANDS[@]}"; do
  [ -d "$d" ] || continue
  echo; echo "-- CAND: $d --"
  ls -la "$d" | head -n 40 || true
  if [ -f "$d/package.json" ]; then
    echo "FOUND package.json: $d/package.json"
    node -e "const p=require(\"$d/package.json\");console.log(\"name=\",p.name,\" main=\",p.main,\" scripts=\",Object.keys(p.scripts||{}).join(\",\"))" 2>/dev/null || true
  fi
done

say "6) Resolve likely entry files"
FOUND_FILES=()
if [ -n "${CWD:-}" ] && [ -d "${CWD:-/no}" ]; then
  for f in server.cjs server.js app.js index.js main.js dist/index.js dist/server.js build/index.js; do
    [ -f "$CWD/$f" ] && FOUND_FILES+=("$CWD/$f")
  done
fi
if [ -n "${ENTRY:-}" ]; then
  if [[ "$ENTRY" != /* ]] && [ -n "${CWD:-}" ]; then
    [ -f "$CWD/$ENTRY" ] && FOUND_FILES+=("$CWD/$ENTRY")
  else
    [ -f "$ENTRY" ] && FOUND_FILES+=("$ENTRY")
  fi
fi
if [ "${#FOUND_FILES[@]}" -eq 0 ]; then
  echo "none"
else
  printf "%s\n" "${FOUND_FILES[@]}"
fi

say "7) Frontend reality check: /opt/wolverine is Next root?"
if [ -d /opt/wolverine ]; then
  if [ -d /opt/wolverine/pages ] || [ -d /opt/wolverine/app ]; then
    echo "OK: /opt/wolverine has pages/ or app/"
  else
    echo "NO: /opt/wolverine has NO pages/ and NO app/ (not a Next frontend root)"
  fi
fi

say "8) Write HEART report"
{
  echo "TS=$TS"
  echo "PID3000=${PID3000:-}"
  echo "EXE=${EXE:-}"
  echo "CWD=${CWD:-}"
  echo "CMDLINE=${CMDLINE:-}"
  echo "ENTRY_GUESS=${ENTRY:-}"
  echo -n "FOUND_ENTRY_FILES="
  if [ "${#FOUND_FILES[@]}" -eq 0 ]; then echo; else printf "%s " "${FOUND_FILES[@]}"; echo; fi
  echo "OUT=$OUT"
  echo "LOG=$LOG"
} | tee "$OUT/heart.txt" > "$HEART"

echo
echo "== DONE =="
echo "HEART=$HEART"
echo "OUT=$OUT"
echo "LOG=$LOG"
"""
open("/root/TO_FIND_TRADERONE_HEART.sh","w",encoding="utf-8").write(s)
PY
chmod +x /root/TO_FIND_TRADERONE_HEART.sh
/root/TO_FIND_TRADERONE_HEART.sh
echo
echo "== HEART FILE (first 200 lines) =="
sed -n "1,200p" /root/traderone_heart.txt || true'
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
FINAL="/etc/nginx/snippets/wolverine_final.conf"

UI_PORT="3000"
API_PORT="3005"

echo "=== 0) Backup ==="
cp -a "$KEEP" "$KEEP.bak.$TS"
cp -a /etc/nginx/snippets "/etc/nginx/snippets.bak.$TS" || true

echo "=== 1) Write FINAL snippet (UI + API + auth + next assets) ==="
cat > "$FINAL" <<NGX
# Wolverine FINAL (single include)
# UI:  http://127.0.0.1:${UI_PORT}
# API: http://127.0.0.1:${API_PORT}

# --- AUTH routes (must NEVER fall back to index.html)
location ^~ /wolverine/traderone/api/auth/ {
  add_header X-Wolverine-Auth HIT always;
  proxy_pass http://127.0.0.1:${API_PORT}/;
  proxy_http_version 1.1;

  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
}

# --- ALL API (priority, no SPA rewrite)
location ^~ /wolverine/traderone/api/ {
  add_header X-Wolverine-API HIT always;
  proxy_pass http://127.0.0.1:${API_PORT}/;
  proxy_http_version 1.1;

  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
}

# --- Next.js static assets (no rewrite)
location ^~ /wolverine/_next/ {
  add_header X-Wolverine-UI HIT always;
  proxy_pass http://127.0.0.1:${UI_PORT}/wolverine/_next/;
  proxy_http_version 1.1;

  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
}

# --- UI app
location ^~ /wolverine/ {
  add_header X-Wolverine-UI HIT always;
  proxy_pass http://127.0.0.1:${UI_PORT}/wolverine/;
  proxy_http_version 1.1;

  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
}
NGX

echo "=== 2) Remove old includes + add FINAL include once ==="
# supprime les includes des anciens snippets
sed -i '\|include /etc/nginx/snippets/wolverine_prod\.conf;|d' "$KEEP"
sed -i '\|include /etc/nginx/snippets/wolverine_routes\.conf;|d' "$KEEP"
sed -i '\|include /etc/nginx/snippets/wolverine_auth_phantom\.conf;|d' "$KEEP" 2>/dev/null || true

# ajoute le final include (au début du server block) si absent
if ! grep -q "snippets/wolverine_final.conf" "$KEEP"; then
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/wolverine_final.conf;/' "$KEEP"
fi

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 4) Verify only one include remains ==="
grep -n "include /etc/nginx/snippets/wolverine" -n "$KEEP" || true

echo "=== 5) Smoke tests ==="
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | sed -n '1,25p'

curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/ | sed -n '1,25p'

echo "DONE ✅"
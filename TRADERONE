cat >/root/MEGA_WOLVERINE_UI_PUBLISH_DIST_TO_WWW.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
hr(){ echo "----------------------------------------------------------------"; }
die(){ say "ERROR: $*"; exit 1; }

# What this does (one-shot):
# - Backup current /var/www/wolverine
# - Publish (rsync) the real built UI from: /opt/fireinners/frontend-react/app/dist/wolverine
#   to the live webroot: /var/www/wolverine
# - Test nginx config and reload nginx
# - Run health checks through nginx routes

SRC="/opt/fireinners/frontend-react/app/dist/wolverine"
DST="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WOLVERINE_UI_${TS}"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB"
fi

say "MEGA_WOLVERINE_UI_PUBLISH_DIST_TO_WWW (backup -> publish -> nginx reload -> checks)"

hr
say "0) Preconditions"
[ -d "$SRC" ] || die "Missing source dist folder: $SRC"
[ -d "$DST" ] || die "Missing destination webroot: $DST"
[ -f "$VHOST" ] || die "Missing nginx vhost: $VHOST"
command -v rsync >/dev/null 2>&1 || die "rsync not found"
command -v nginx >/dev/null 2>&1 || die "nginx not found"

hr
say "1) Snapshot backup"
mkdir -p "$BK"
# Backup current live webroot (fast + readable)
if command -v tar >/dev/null 2>&1; then
  say "Creating tar backup: $BK/wolverine_www.tar.gz"
  tar -C "$DST" -czf "$BK/wolverine_www.tar.gz" . || die "tar backup failed"
else
  say "tar not available, doing cp -a backup"
  cp -a "$DST" "$BK/wolverine_www_copy" || die "cp backup failed"
fi

hr
say "2) Publish dist -> /var/www/wolverine (rsync --delete)"
say "SRC=$SRC"
say "DST=$DST"
rsync -a --delete --info=NAME,STATS2 "$SRC"/ "$DST"/

hr
say "3) Permissions sanity"
chown -R root:root "$DST" >/dev/null 2>&1 || true
find "$DST" -type d -exec chmod 0755 {} \; >/dev/null 2>&1 || true
find "$DST" -type f -exec chmod 0644 {} \; >/dev/null 2>&1 || true

hr
say "4) Nginx config test + reload"
nginx -t
systemctl reload nginx

hr
say "5) Quick content check: /var/www/wolverine/index.html (first 40 lines)"
sed -n '1,40p' "$DST/index.html" || true

hr
say "6) Health checks via nginx routes (localhost HTTPS with Host header)"
# Use -k because cert may be valid; but localhost SNI sometimes differs. Host header forces vhost routing.
# If your cert/SNI is strict, these still usually work with -k.
for path in \
  "/wolverine/" \
  "/wolverine/traderone/api/health" \
  "/wolverine/traderone/vault/health" \
  "/wolverine/vault-api/health"
do
  say "GET https://127.0.0.1${path} (Host: fireinners.online)"
  code="$(curl -k -sS -o /tmp/wolv_resp.txt -w "%{http_code}" -H "Host: fireinners.online" "https://127.0.0.1${path}" || true)"
  say "HTTP $code"
  head -n 5 /tmp/wolv_resp.txt | sed 's/\r$//' || true
  hr
done

hr
say "7) Grep for frontend expected libs (solana web3 / walletconnect / lifi keywords) in live index"
grep -iE 'solana|web3|walletconnect|lifi|phantom' -n "$DST/index.html" | head -n 60 || true

hr
say "DONE. Backup at: $BK"
BASH

bash /root/MEGA_WOLVERINE_UI_PUBLISH_DIST_TO_WWW.sh
# ROOT — AUTO-FIND Next app dir + FIX npm spec + BUILD + DEPLOY
set -euo pipefail

BASE="/opt/fireinners/WOLVERINE"
DIST="/var/www/wolverine"

echo "=== 0) Find app dir (package.json with build script) ==="
[ -d "$BASE" ] || { echo "ERROR: missing $BASE"; exit 1; }

APP_DIR="$(find "$BASE" -maxdepth 5 -type f -name package.json -print0 \
  | xargs -0 -I{} sh -c 'd=$(dirname "{}"); node -e "const p=require(\"'{}'\"); process.exit(p.scripts&&p.scripts.build?0:1)" 2>/dev/null && echo "$d"' \
  | head -n 1)"

if [ -z "${APP_DIR:-}" ]; then
  echo "ERROR: No package.json with scripts.build found under $BASE"
  echo "DEBUG: package.json candidates:"
  find "$BASE" -maxdepth 5 -type f -name package.json
  exit 1
fi

echo "APP_DIR = $APP_DIR"
mkdir -p "$DIST"

echo "=== 1) Enter app dir ==="
cd "$APP_DIR"
pwd
ls -lah package.json

echo "=== 2) Fix bad dependency specs (empty/non-string) ==="
node - <<'NODE'
const fs=require("fs");
const p=JSON.parse(fs.readFileSync("package.json","utf8"));
let changed=false;
for (const k of ["dependencies","devDependencies","optionalDependencies","peerDependencies"]) {
  const o=p[k]; if(!o) continue;
  for (const [name,val] of Object.entries(o)) {
    if (typeof val!=="string" || val.trim()==="") { delete o[name]; changed=true; console.log("REMOVE",k,name,val); }
  }
}
if(changed) fs.writeFileSync("package.json", JSON.stringify(p,null,2)+"\n");
console.log(changed ? "package.json fixed ✅" : "package.json OK ✅");
NODE

echo "=== 3) Clean install ==="
rm -rf node_modules package-lock.json .next out || true
npm cache clean --force || true
npm install --legacy-peer-deps

echo "=== 4) Build ==="
npm run build
[ -d out ] || { echo "ERROR: out/ missing after build (Next export failed)"; exit 1; }

echo "=== 5) Deploy ==="
rsync -a --delete out/ "$DIST/"

echo "=== 6) Reload nginx ==="
nginx -t
systemctl reload nginx

echo "DONE ✅ -> refresh https://fireinners.online/wolverine/"
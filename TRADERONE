cat >/tmp/FIX_WOLVERINE_STILL_CALLS_SOLANA_RPC.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 1) Trouver le DOCROOT NGINX de /wolverine =="
CFG="$(nginx -T 2>/dev/null | sed -n '/server {/,/}/p' | grep -nE 'location /wolverine|root |alias ' -n || true)"
echo "$CFG" | head -n 80 || true
echo

# Heuristique: chercher un index WOLVERINE existant
INDEX="$(grep -RIl --exclude-dir=node_modules --exclude-dir=.git '<title>WOLVERINE</title>' /var/www /usr/share/nginx /opt 2>/dev/null | head -n 1 || true)"
if [ -z "${INDEX:-}" ]; then
  # fallback: premier index.html dans /var/www/wolverine
  INDEX="/var/www/wolverine/index.html"
fi
DOCROOT="$(dirname "$INDEX")"
APPJS="$DOCROOT/app.js"

echo "INDEX=$INDEX"
echo "DOCROOT=$DOCROOT"
echo "APPJS=$APPJS"
mkdir -p "$DOCROOT"
echo

echo "== 2) Backup =="
[ -f "$INDEX" ] && cp -a "$INDEX" "$INDEX.bak.$(date +%s)" || true
[ -f "$APPJS" ] && cp -a "$APPJS" "$APPJS.bak.$(date +%s)" || true
echo

echo "== 3) Overwrite index.html (SANS solana web3) =="
cat >"$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>WOLVERINE</title>
  <style>
    :root { --bg:#0b0f14; --card:#121826; --b:#223049; --mut:#9fb0c7; --ok:#22c55e; --err:#ef4444; --btn:#3b82f6; }
    body { margin:0; font-family:system-ui, Arial; background:var(--bg); color:#e8eef6; }
    .wrap { max-width:520px; margin:42px auto; padding:18px; }
    .card { background:var(--card); border:1px solid var(--b); border-radius:16px; padding:16px; }
    h1 { margin:0 0 12px; font-size:22px; }
    .row { display:flex; justify-content:space-between; gap:10px; align-items:center; margin:10px 0; }
    .muted { color:var(--mut); font-size:13px; }
    .value { font-weight:800; font-size:18px; }
    .pill { padding:4px 10px; border:1px solid var(--b); border-radius:999px; font-size:12px; color:var(--mut); }
    button { width:100%; padding:12px 14px; border:0; border-radius:12px; background:var(--btn); color:white; font-weight:800; cursor:pointer; }
    button.secondary { background:#1f2937; border:1px solid #2b3a55; }
    button:disabled { opacity:.55; cursor:not-allowed; }
    input { width:100%; padding:12px 14px; border-radius:12px; border:1px solid #2b3a55; background:#0f1624; color:#e8eef6; outline:none; }
    .hidden { display:none; }
    .ok { color:var(--ok); }
    .err { color:var(--err); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>WOLVERINE</h1>

      <div class="row">
        <span class="pill">Solana</span>
        <span class="pill" id="walletPill">Wallet: non connecté</span>
      </div>

      <div class="row">
        <div>
          <div class="muted">SOL</div>
          <div class="value" id="solBal">—</div>
        </div>
        <div style="text-align:right;">
          <div class="muted">USDC</div>
          <div class="value" id="usdcBal">—</div>
        </div>
      </div>

      <button id="btnConnect">Connect Wallet (Phantom)</button>

      <div id="afterConnect" class="hidden" style="margin-top:14px;">
        <div class="muted" style="margin:8px 0;">Budget</div>
        <input id="budget" type="number" inputmode="decimal" placeholder="Ex: 50" min="0" step="0.01" />

        <div style="margin-top:12px;">
          <button id="btnStart" disabled>START WOLVERINE (TraderOne)</button>
        </div>

        <div class="row" style="margin-top:12px;">
          <span class="muted">Status</span>
          <span id="statusText" class="muted">—</span>
        </div>

        <button id="btnRefresh" class="secondary" style="margin-top:10px;">Refresh balances</button>
      </div>
    </div>
  </div>

  <script src="./app.js?v=__TS__"></script>
</body>
</html>
HTML

TS="$(date +%s)"
sed -i "s/__TS__/$TS/g" "$INDEX"
echo

echo "== 4) Overwrite app.js (backend-only, ZERO solanaWeb3) =="
cat >"$APPJS" <<'JS'
const API_START = "/wolverine/traderone/api/start";
const API_BALANCES = "/wolverine/traderone/api/balances";

const btnConnect=document.getElementById("btnConnect");
const btnStart=document.getElementById("btnStart");
const btnRefresh=document.getElementById("btnRefresh");
const afterConnect=document.getElementById("afterConnect");
const walletPill=document.getElementById("walletPill");
const solBalEl=document.getElementById("solBal");
const usdcBalEl=document.getElementById("usdcBal");
const budgetEl=document.getElementById("budget");
const statusText=document.getElementById("statusText");

let pubkey=null;

function shortPk(pk){ const s=pk.toString(); return s.slice(0,4)+"…"+s.slice(-4); }
function setStatus(t,cls="muted"){ statusText.className=cls; statusText.textContent=t; }
function canStart(){ const v=Number(budgetEl.value); return pubkey && Number.isFinite(v) && v>0; }

async function refreshBalances(){
  if(!pubkey) return;
  setStatus("Lecture des soldes…");
  try{
    const r = await fetch(`${API_BALANCES}?wallet=${encodeURIComponent(pubkey.toString())}`, { cache: "no-store" });
    const data = await r.json().catch(()=> ({}));
    if(!r.ok) throw new Error(data?.error || ("HTTP "+r.status));
    solBalEl.textContent = Number(data.sol ?? 0).toFixed(4);
    usdcBalEl.textContent = Number(data.usdc ?? 0).toFixed(2);
    setStatus("OK", "ok");
  }catch(e){
    setStatus("Balances error: " + (e?.message || e), "err");
  }
}

btnConnect.onclick=async ()=>{
  if(!window.solana?.isPhantom){
    setStatus("Phantom non détecté","err");
    window.open("https://phantom.app/","_blank");
    return;
  }
  try{
    const r=await window.solana.connect();
    pubkey=r.publicKey;
    walletPill.textContent="Wallet: "+shortPk(pubkey);
    afterConnect.classList.remove("hidden");
    btnConnect.textContent="Wallet connecté";
    btnConnect.disabled=true;
    await refreshBalances();
    btnStart.disabled=!canStart();
  }catch(e){
    setStatus("Connexion refusée: " + (e?.message||e),"err");
  }
};

budgetEl.oninput=()=>{ btnStart.disabled=!canStart(); };
btnRefresh.onclick=refreshBalances;

btnStart.onclick=async ()=>{
  if(!canStart()) return;
  const budget=Number(budgetEl.value);
  setStatus("Démarrage…");
  btnStart.disabled=true;

  try{
    const res=await fetch(API_START,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({wallet:pubkey.toString(),budget})
    });
    const data=await res.json().catch(()=>({}));
    if(!res.ok){ setStatus(data?.error||"Start failed","err"); btnStart.disabled=false; return; }
    setStatus("WOLVERINE démarré ✅","ok");
  }catch(e){
    setStatus("Erreur API: " + (e?.message||e),"err");
    btnStart.disabled=false;
  }
};
JS

chmod 644 "$INDEX" "$APPJS"
echo

echo "== 5) NGINX: no-cache sur /wolverine/app.js (optionnel mais utile) =="
SNIP="/etc/nginx/snippets/wolverine_nocache.conf"
cat >"$SNIP" <<'NG'
location = /wolverine/app.js {
  add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
  add_header Pragma "no-cache" always;
  add_header Expires "0" always;
}
NG

# Injecter le include dans le bon server{} si pas déjà présent
if ! nginx -T 2>/dev/null | grep -q "wolverine_nocache.conf"; then
  CONF="$(nginx -T 2>/dev/null | awk '/server_name[[:space:]]+fireinners\.online/ {print prev} {prev=$0}' | head -n1 || true)"
  # fallback: premier site-enabled
  [ -z "${CONF:-}" ] && CONF="$(ls -1 /etc/nginx/sites-enabled/* 2>/dev/null | head -n1 || true)"
  if [ -n "${CONF:-}" ] && [ -f "$CONF" ]; then
    cp -a "$CONF" "$CONF.bak.$(date +%s)"
    # ajoute include juste après 'server {' si possible
    awk '
      BEGIN{done=0}
      /server[[:space:]]*\{/ && done==0 {print; print "  include /etc/nginx/snippets/wolverine_nocache.conf;"; done=1; next}
      {print}
    ' "$CONF" >"$CONF.tmp" && mv "$CONF.tmp" "$CONF"
  fi
fi

nginx -t && systemctl reload nginx
echo

echo "== 6) PREUVES (remote) : plus de solanaWeb3 / mainnet-beta =="
echo "--- app.js contains solanaWeb3? ---"
curl -ks https://fireinners.online/wolverine/app.js | grep -n "solanaWeb3" && echo "BAD" || echo "OK ✅"
echo "--- app.js contains mainnet-beta? ---"
curl -ks https://fireinners.online/wolverine/app.js | grep -n "mainnet-beta" && echo "BAD" || echo "OK ✅"
echo "--- index contains solana web3 iife? ---"
curl -ks https://fireinners.online/wolverine/ | grep -nE "solana/web3|index\.iife\.min\.js|connection\.ts" && echo "BAD" || echo "OK ✅"

echo
echo "=> Ouvre /wolverine en NAVIGATION PRIVÉE puis clique Refresh. Tu ne dois plus voir POST api.mainnet-beta 403."
SH

bash /tmp/FIX_WOLVERINE_STILL_CALLS_SOLANA_RPC.sh
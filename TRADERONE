#!/usr/bin/env bash
set -euo pipefail

echo "=== PURGE PORT 443 / FIX NGINX (ROOT) ==="

[ "$EUID" -eq 0 ] || { echo "MUST BE ROOT"; exit 1; }

echo "--- LISTENERS AVANT ---"
ss -lptn | grep ':443' || true

echo "--- STOP SERVICES SUSPECTS ---"
systemctl stop apache2 || true
systemctl disable apache2 || true

systemctl stop nginx || true

systemctl stop snapd || true
systemctl stop docker || true
systemctl stop docker.socket || true
systemctl stop containerd || true

systemctl stop cloudflared || true
systemctl stop caddy || true
systemctl stop haproxy || true

echo "--- KILL HARD (PORT 443) ---"
for pid in $(lsof -ti :443); do
  echo "KILL PID $pid"
  kill -9 $pid || true
done

sleep 2

echo "--- LISTENERS APRÈS KILL ---"
ss -lptn | grep ':443' || echo "PORT 443 LIBRE"

echo "--- RELOAD SYSTEMD ---"
systemctl daemon-reexec
systemctl daemon-reload

echo "--- START NGINX ---"
systemctl unmask nginx || true
systemctl enable nginx
systemctl start nginx

echo "--- STATUS ---"
systemctl status nginx --no-pager

echo "--- FINAL CHECK ---"
ss -lptn | grep ':443'

echo "=== OK ==="
echo "OPEN : https://fireinners.online/wolverine/"
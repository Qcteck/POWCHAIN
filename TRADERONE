set -euo pipefail

OUT="/root/nginx_compare_fireinners"
mkdir -p "$OUT"

echo "=== 1) FILES qui contiennent server_name fireinners.online ==="
FILES="$(nginx -T 2>/dev/null | awk '
  /^# configuration file /{f=$4}
  /server_name[[:space:]]+(fireinners\.online|www\.fireinners\.online)/{print f}
' | sort -u | sed "/^$/d")"

echo "$FILES" | tee "$OUT/files.txt"
echo

echo "=== 2) RESUME de chaque fichier (lignes importantes) ==="
: > "$OUT/summary.txt"
for f in $FILES; do
  [ -f "$f" ] || continue
  {
    echo "=================================================="
    echo "FILE: $f"
    echo "--------------------------------------------------"
    grep -nE 'server_name|listen|root|index|ssl_certificate|ssl_certificate_key|location|proxy_pass|try_files|return|rewrite|include|auth_basic|deny|allow' "$f" \
      | sed -n '1,420p'
    echo
  } | tee -a "$OUT/summary.txt"
done

echo "Saved: $OUT/summary.txt"
echo

echo "=== 3) DIFFS (fichier 1 vs les autres) ==="
FIRST="$(echo "$FILES" | head -n 1)"
: > "$OUT/diffs.txt"
for f in $(echo "$FILES" | tail -n +2); do
  echo "######## DIFF: $FIRST  vs  $f ########" | tee -a "$OUT/diffs.txt"
  diff -u "$FIRST" "$f" | tee -a "$OUT/diffs.txt" | head -n 260 || true
  echo | tee -a "$OUT/diffs.txt"
done
echo "Saved: $OUT/diffs.txt"
echo

echo "=== 4) HTML VISUEL (ouvre-le sur le VPS avec un navigateur ou télécharge) ==="
cat > "$OUT/index.html" <<'HTML'
<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nginx compare – fireinners.online</title>
<style>
body{font-family:system-ui,Arial;margin:0;background:#0b0b0b;color:#fff}
.top{position:sticky;top:0;background:#111;padding:12px;display:flex;gap:10px;align-items:center;z-index:9}
a{color:#9cf}
pre{white-space:pre-wrap;word-break:break-word;background:#151515;border:1px solid #2a2a2a;border-radius:10px;padding:10px;overflow:auto}
.wrap{padding:12px;display:grid;grid-template-columns:1fr;gap:12px}
.small{opacity:.8;font-size:12px}
</style>
<div class="top">
  <b>Nginx compare – fireinners.online</b>
  <span class="small">summary + diffs</span>
</div>
<div class="wrap">
  <div>
    <div class="small">summary.txt</div>
    <pre id="sum">loading…</pre>
  </div>
  <div>
    <div class="small">diffs.txt</div>
    <pre id="dif">loading…</pre>
  </div>
</div>
<script>
fetch('./summary.txt').then(r=>r.text()).then(t=>sum.textContent=t);
fetch('./diffs.txt').then(r=>r.text()).then(t=>dif.textContent=t);
</script>
HTML

echo
echo "DONE ✅"
echo "Tu peux lire en terminal:"
echo "  less -N $OUT/summary.txt"
echo "  less -N $OUT/diffs.txt"
echo
echo "Si tu veux le visuel en web, dis-moi et je te donne le mini snippet nginx / location pour le servir."
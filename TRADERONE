cat > /root/FIX_TRADERONE_API_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -e

APP_DIR="/opt/traderone-vault"
API_FILE="$APP_DIR/api_budget.js"
SERVER="$APP_DIR/server.js"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

echo "=== [1] Vérifications ==="
[ -f "$SERVER" ] || { echo "❌ server.js introuvable"; exit 1; }

echo "=== [2] Création API budget séparée ==="
cat > "$API_FILE" <<'JS'
module.exports = (app, web3, traderKeypair) => {
  const { SystemProgram, Transaction, sendAndConfirmTransaction, LAMPORTS_PER_SOL, PublicKey } = web3;

  app.post("/wolverine/traderone/api/budget", async (req, res) => {
    try {
      const { from, amount } = req.body;
      if (!from || !amount) {
        return res.status(400).json({ ok:false, error:"missing from/amount" });
      }

      const lamports = Math.floor(Number(amount) * LAMPORTS_PER_SOL);
      if (lamports <= 0) {
        return res.status(400).json({ ok:false, error:"invalid amount" });
      }

      const tx = new Transaction().add(
        SystemProgram.transfer({
          fromPubkey: new PublicKey(from),
          toPubkey: traderKeypair.publicKey,
          lamports
        })
      );

      const sig = await sendAndConfirmTransaction(
        req.app.locals.connection,
        tx,
        [],
        { commitment: "confirmed" }
      );

      res.json({ ok:true, signature:sig });
    } catch (e) {
      res.status(500).json({ ok:false, error:String(e) });
    }
  });
};
JS

echo "✓ API budget créée"

echo "=== [3] Branchement API dans server.js (sans regex) ==="
if ! grep -q "api_budget" "$SERVER"; then
cat >> "$SERVER" <<'JS'

// === TraderOne Budget API ===
const budgetAPI = require("./api_budget");
budgetAPI(app, require("@solana/web3.js"), traderKeypair);
JS
echo "✓ API branchée"
else
echo "✓ API déjà branchée"
fi

echo "=== [4] Patch NGINX proxy API ==="
if ! grep -q "/wolverine/traderone/api/" "$NGINX_SITE"; then
sed -i '/location \/wolverine\/ {/a\
    location /wolverine/traderone/api/ {\
        proxy_pass http://127.0.0.1:3000/;\
        proxy_http_version 1.1;\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\
        proxy_set_header X-Forwarded-Proto $scheme;\
    }\
' "$NGINX_SITE"
echo "✓ NGINX proxy ajouté"
else
echo "✓ NGINX proxy déjà présent"
fi

echo "=== [5] Redémarrage ==="
nginx -t
systemctl reload nginx
pm2 restart traderone-vault

sleep 2

echo "=== [6] Test API ==="
curl -s http://127.0.0.1:3000/wolverine/traderone/api/health | grep ok
curl -s https://fireinners.online/wolverine/traderone/api/health | grep ok

echo "✅ TRADERONE API BUDGET OPÉRATIONNELLE"
BASH

chmod +x /root/FIX_TRADERONE_API_FINAL.sh
/root/FIX_TRADERONE_API_FINAL.sh
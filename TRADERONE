bash -lc 'set -euo pipefail
say(){ printf "%s\n" "$*"; }
say "== WOLVERINE FLY =="
echo "-- nginx location grep --"
grep -nE "location[[:space:]]+/wolverine/|location[[:space:]]+/wolverine/api|proxy_pass" /etc/nginx/sites-available/fireinners.online-ssl | tail -n 120 || true
echo
echo "-- public --"
curl -sS -i https://fireinners.online/wolverine/api/health | head -n 20 || true
curl -sS -i https://fireinners.online/wolverine/api/config | head -n 20 || true
echo
echo "-- local port scan (3050/9697/...) --"
ss -ltnp | grep -E ":(3050|9697|9696|3000|8484)[[:space:]]" || true
echo
echo "-- systemd --"
systemctl status wolverine-api --no-pager -n 20 || true
journalctl -u wolverine-api -n 60 --no-pager || true
'
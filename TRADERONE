#!/bin/bash
set -e

echo "🐺 WOLVERINE — MEGA UI PATCH v4 (FINAL)"
echo "======================================"

UI="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)
BACKUP="/var/www/_BACKUP_WOLVERINE_UI_V4_$TS"
LOG="/root/wolverine_ui_v4_$TS.log"

exec > >(tee -a "$LOG") 2>&1

[ -f "$UI" ] || { echo "❌ UI introuvable"; exit 1; }

echo "📦 Backup UI"
mkdir -p "$BACKUP"
cp -a "$UI" "$BACKUP/"

grep -q "WOLVERINE_V4_FINAL" "$UI" && {
  echo "✔️ Patch déjà appliqué"
  exit 0
}

echo "✏️ Injection CSS layout final (no scroll, bg chart)"

sed -i "/<\/head>/i \
<!-- WOLVERINE_V4_FINAL -->\
<style>\
html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden}\
#app{width:100vw;height:100vh;overflow:hidden}\
.sidebar{overflow:hidden}\
.content{height:100%;display:flex;flex-direction:column;overflow:hidden}\
.main{flex:1;overflow:hidden;padding:10px}\
.panel{position:relative;overflow:hidden}\
.panel-bg-chart{position:absolute;inset:0;opacity:0.15;pointer-events:none}\
.panel-content{position:relative;z-index:2}\
canvas{width:100%!important;height:100%!important}\
</style>" "$UI"

echo "✏️ Injection graphique BACKGROUND + Phantom + Backend realtime"

sed -i "/TraderOne overview/{
n
a \
<div class=\"panel panel-bg\">\
  <canvas id=\"bgChart\" class=\"panel-bg-chart\"></canvas>\
  <div class=\"panel-content\" id=\"overviewContent\"></div>\
</div>
}" "$UI"

sed -i "/<\/body>/i \
<script src=\"/wolverine/vendor/chart.min.js\"></script>\
<script>\
/* ===== BACKGROUND CHART ===== */\
const bg=document.getElementById('bgChart');\
if(bg){\
 new Chart(bg.getContext('2d'),{type:'line',data:{labels:[1,2,3,4,5],datasets:[{data:[100,102,101,104,103],borderWidth:2,tension:.4}]},options:{responsive:true,plugins:{legend:{display:false}},scales:{x:{display:false},y:{display:false}}});\
}\
/* ===== PHANTOM CONNECT (FINAL) ===== */\
const btn=document.querySelector('button:contains(\"Connect Phantom\")')||document.querySelector('[data-connect-phantom]')||document.querySelector('button');\
if(btn){\
 btn.onclick=async()=>{\
  if(!window.solana||!window.solana.isPhantom){alert('Ouvre ce site dans Phantom');return;}\
  try{\
    const r=await window.solana.connect({onlyIfTrusted:false});\
    document.querySelector('.wallet-status')&&(document.querySelector('.wallet-status').innerText=r.publicKey.toString());\
  }catch(e){console.error(e);}\
 };\
}\
/* ===== BACKEND REALTIME ===== */\
fetch('/wolverine/traderone/api/health').then(r=>r.json()).then(d=>{\
 console.log('Backend OK',d);\
}).catch(()=>console.warn('Backend offline'));\
</script>" "$UI"

echo "✅ MEGA UI PATCH v4 TERMINÉ"
echo "📄 Backup : $BACKUP"
echo "📄 Log    : $LOG"
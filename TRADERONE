<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Q+ • Jouet Quantique Fermé • Multi-niveaux (Gap émergent strict) + Test</title><style>html,body{margin:0;background:#0b0d12;color:#e7eefc;font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial}*{box-sizing:border-box}#app{max-width:1150px;margin:0 auto;padding:14px}.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}.rowL{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.card{background:linear-gradient(180deg,rgba(18,21,29,.92),rgba(10,12,17,.92));border:1px solid rgba(255,255,255,.10);border-radius:16px;box-shadow:0 18px 55px rgba(0,0,0,.55);padding:12px}.mut{opacity:.75}.title{font-weight:900;letter-spacing:.3px}.btn{border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#e7eefc;border-radius:12px;padding:10px 12px;font-weight:800;cursor:pointer}.btn:active{transform:translateY(1px)}.btn.on{background:rgba(120,200,255,.12);border-color:rgba(120,200,255,.35)}.btn.bad{background:rgba(255,120,120,.10);border-color:rgba(255,120,120,.35)}input,select{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:12px;color:#e7eefc;padding:10px 10px;outline:none}label{font-weight:800}canvas{width:100%;height:260px;border-radius:12px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.10)}#log{height:240px;overflow:auto;border-radius:12px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.10);padding:10px;font-size:12px;line-height:1.35;white-space:pre-wrap}table{width:100%;border-collapse:collapse;font-size:13px}td{padding:6px 6px;border-top:1px solid rgba(255,255,255,.08);vertical-align:top}.k{opacity:.7;width:50%}.v{font-weight:900}#testLog{max-height:320px;overflow:auto;border-radius:12px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.10);padding:10px;font-size:12px;line-height:1.35}#testLog .ok{color:#47ff9a}#testLog .warn{color:#ffd24a}#testLog .error{color:#ff6b6b}</style></head><body><div id="app"><div class="row" style="margin-bottom:10px"><div><div class="title">Q+ • Jouet Quantique Fermé (Multi-niveaux)</div><div class="mut">offline • D niveaux • ρ=Σw|ψ⟩⟨ψ| • auto-cohérence • gap émergent strict</div></div><div class="mut">tests 1→5 + spectre(ρ) + test moteur</div></div><div class="card"><div class="rowL"><label>Seed</label><input id="seed" value="1337" style="width:110px"/><label>D</label><input id="D" value="6" style="width:80px"/><label>K</label><input id="K" value="64" style="width:90px"/><label>dt</label><input id="dt" value="0.05" style="width:90px"/><label>fps</label><input id="fps" value="30" style="width:90px"/><label>Sélection</label><select id="sel"><option value="maxent">MaxEnt sous contrainte</option><option value="minaction">Action minimale</option><option value="attractor">Attracteurs probabilistes</option></select><label>Topo</label><input id="topo" value="0.60" style="width:90px"/><label>Comp</label><input id="comp" value="0.70" style="width:90px"/><label>gmin</label><input id="gmin" value="0.18" style="width:90px"/><label>persist</label><input id="pers" value="40" style="width:90px"/><button class="btn" id="init">Init</button><button class="btn" id="step">Step</button><button class="btn" id="run">Run</button><button class="btn bad" id="stop">Stop</button><button class="btn" id="amcq">AMCQ</button><button class="btn" id="strict">Strict Unitary</button><button class="btn" id="mb">Mesure (base)</button><button class="btn" id="mr">Mesure (base random)</button><button class="btn" id="clr">Clear log</button></div><div class="mut" style="margin-top:8px;font-size:12px">Gap strict = (λ1−λ2)&gt;gmin pendant “persist” pas consécutifs, et pas déjà grand au départ.</div></div><div class="row" style="margin-top:12px;gap:12px"><div class="card" style="flex:1.2"><div class="rowL" style="justify-content:space-between"><div class="title" style="font-size:14px">Courbes : ⟨O1⟩ ⟨O2⟩ ⟨O3⟩ (observables internes)</div><div class="mut" style="font-size:12px">D&gt;2 ⇒ observables fixes (Hermitiennes) + base random</div></div><canvas id="cv" width="1100" height="260"></canvas></div><div class="card" style="flex:.8"><div class="title" style="font-size:14px">Métriques + invariants</div><table><tr><td class="k">t</td><td class="v" id="mt">0</td></tr><tr><td class="k">Tr(ρ)</td><td class="v" id="mtr"></td></tr><tr><td class="k">Tr(ρ²) (pureté)</td><td class="v" id="mp"></td></tr><tr><td class="k">S(ρ) bits</td><td class="v" id="ms"></td></tr><tr><td class="k">Σw</td><td class="v" id="msw"></td></tr><tr><td class="k">Support (w&gt;τ)</td><td class="v" id="msupp"></td></tr><tr><td class="k">H_w (poids) bits</td><td class="v" id="mhw"></td></tr><tr><td class="k">Spectre ρ (λ1..λ6)</td><td class="v" id="meigs"></td></tr><tr><td class="k">Gap émergent g=λ1−λ2</td><td class="v" id="mgap"></td></tr></table><div class="title" style="font-size:14px;margin-top:10px">Auto-tests</div><table><tr><td class="k">1) Invariant global</td><td class="v" id="t1"></td></tr><tr><td class="k">2) Anti-dérive incohérente</td><td class="v" id="t2"></td></tr><tr><td class="k">3) Mesure modifie l’état</td><td class="v" id="t3"></td></tr><tr><td class="k">4) Spectre discret</td><td class="v" id="t4"></td></tr><tr><td class="k">5) Gap émergent strict</td><td class="v" id="t5"></td></tr></table></div></div><div class="card" style="margin-top:12px"><div class="title" style="font-size:14px">Journal</div><div id="log"></div></div><div class="card" style="margin-top:12px"><div class="row" style="gap:10px"><div><div class="title" style="font-size:14px">Test du Moteur Quantique (intégré)</div><div class="mut" style="font-size:12px">Le test utilise le vrai moteur: N_c=Support(w&gt;τ), H_w=entropie des poids normalisée, Niveau=0..2 via gap/pureté, Symétries=check base (unitary).</div></div><div class="rowL"><button class="btn" id="startTest">Lancer Test</button><button class="btn bad" id="stopTest">Stop Test</button><button class="btn" id="clrTest">Clear Test</button></div></div><div class="mut" style="margin-top:8px;font-size:12px">Params test: N_cycles=200, N_min=5, N_max=15, H_min=0.30, H_max=0.70, gmin=0.05 (test). Corrections: ajuste Topo/Comp puis lance coherenceRepair().</div><div id="testLog" style="margin-top:10px"></div></div></div>

<script>/*BLOC 1/8: utils + RNG + complex*/(()=>{const $=s=>document.querySelector(s),L=$("#log");const log=m=>{const t=new Date().toISOString().slice(11,19);L.textContent+=`[${t}] ${m}\n`;L.scrollTop=L.scrollHeight};const clamp=(x,a,b)=>x<a?a:x>b?b:x;const fmt=x=>{if(!isFinite(x))return"NaN";const s=x.toFixed(6);return s.replace(/\.?0+$/,"")};function xorshift32(seed){let x=(seed>>>0)||1;return()=>{x^=x<<13;x^=x>>>17;x^=x<<5;return((x>>>0)/4294967296)};}const cadd=(a,b)=>[a[0]+b[0],a[1]+b[1]];const csub=(a,b)=>[a[0]-b[0],a[1]-b[1]];const cmul=(a,b)=>[a[0]*b[0]-a[1]*b[1],a[0]*b[1]+a[1]*b[0]];const cconj=a=>[a[0],-a[1]];const cscale=(a,k)=>[a[0]*k,a[1]*k];const cab2=a=>a[0]*a[0]+a[1]*a[1];window.__QJ__={$,log,clamp,fmt,xorshift32,cadd,csub,cmul,cconj,cscale,cab2};})();</script>

<script>/*BLOC 2/8: état (D,K) + ψ,w + ρ*/(()=>{const U=window.__QJ__,{log,clamp,fmt,xorshift32,cadd,cmul,cconj,cab2}=U;const Q={t:0,seed:1337,rng:()=>0,D:6,K:64,psi:[],w:[],rhoRe:[],rhoIm:[],tau:0,amcq:false,strict:false,mode:"maxent",lastMeas:false,topoRatio:0.60,compRatio:0.70,gmin:0.18,persist:40,gCount:0,gEverSmall:true};const mkPsi=()=>{const v=[];let s=0;for(let i=0;i<Q.D;i++){const a=(Q.rng()*2-1),b=(Q.rng()*2-1);v.push([a,b]);s+=a*a+b*b;}s=Math.sqrt(s)||1;for(let i=0;i<Q.D;i++){v[i][0]/=s;v[i][1]/=s;}return v};const psiNormalize=(v)=>{let s=0;for(let i=0;i<Q.D;i++)s+=cab2(v[i]);s=Math.sqrt(s)||1;for(let i=0;i<Q.D;i++){v[i][0]/=s;v[i][1]/=s;}return v};const renormW=()=>{let s=0;for(let i=0;i<Q.K;i++){Q.w[i]=Math.max(1e-18,Q.w[i]);s+=Q.w[i];}if(!isFinite(s)||s<=0){const u=1/Q.K;for(let i=0;i<Q.K;i++)Q.w[i]=u;return 1;}for(let i=0;i<Q.K;i++)Q.w[i]/=s;return s};const allocRho=()=>{Q.rhoRe=[];Q.rhoIm=[];for(let a=0;a<Q.D;a++){Q.rhoRe[a]=new Float64Array(Q.D);Q.rhoIm[a]=new Float64Array(Q.D);}};const buildRho=()=>{for(let a=0;a<Q.D;a++){Q.rhoRe[a].fill(0);Q.rhoIm[a].fill(0);}for(let i=0;i<Q.K;i++){const w=Q.w[i],v=Q.psi[i];for(let a=0;a<Q.D;a++){const va=v[a];for(let b=0;b<Q.D;b++){const vb=v[b];const prod=cmul(va,cconj(vb));Q.rhoRe[a][b]+=w*prod[0];Q.rhoIm[a][b]+=w*prod[1];}}}return Q};const trRho=()=>{let s=0;for(let i=0;i<Q.D;i++)s+=Q.rhoRe[i][i];return s};const purity=()=>{let s=0;for(let a=0;a<Q.D;a++)for(let b=0;b<Q.D;b++){const re=Q.rhoRe[a][b],im=Q.rhoIm[a][b];s+=re*re+im*im;}return s};const Hweights=()=>{let H=0;for(let i=0;i<Q.K;i++){const p=Q.w[i];if(p>1e-18)H-=p*Math.log(p);}return H/Math.LN2};const support=()=>{let c=0;for(let i=0;i<Q.K;i++)if(Q.w[i]>Q.tau)c++;return c};const init=(seed,D,K,topo,comp,gmin,persist)=>{Q.seed=seed|0;Q.rng=xorshift32(Q.seed);Q.t=0;Q.D=Math.max(3,Math.min(10,parseInt(D||6,10)));Q.K=Math.max(8,Math.min(256,parseInt(K||64,10)));Q.topoRatio=clamp(parseFloat(topo||0.60),0.10,0.95);Q.compRatio=clamp(parseFloat(comp||0.70),0.10,0.95);Q.gmin=clamp(parseFloat(gmin||0.18),0.01,0.95);Q.persist=Math.max(5,Math.min(400,parseInt(persist||40,10)));Q.gCount=0;Q.gEverSmall=true;Q.psi=[];Q.w=[];for(let i=0;i<Q.K;i++){Q.psi.push(mkPsi());Q.w.push(1/Q.K);}Q.tau=1/(Q.K*50);renormW();allocRho();buildRho();log(`Init seed=${Q.seed} D=${Q.D} K=${Q.K} topo=${fmt(Q.topoRatio)} comp=${fmt(Q.compRatio)} gmin=${fmt(Q.gmin)} persist=${Q.persist}`);};window.__QJ2__={Q,init,renormW,buildRho,trRho,purity,Hweights,support,psiNormalize,mkPsi};})();</script>

<script>/*BLOC 3/8: H (Hermitien) + U(dt) appliqué aux ψ*/(()=>{const U=window.__QJ__,{cmul,cadd,fmt,log}=U;const V=window.__QJ2__,{Q,psiNormalize}=V;let Hre=null,Him=null;const buildH=()=>{Hre=[];Him=[];for(let a=0;a<Q.D;a++){Hre[a]=new Float64Array(Q.D);Him[a]=new Float64Array(Q.D);}for(let a=0;a<Q.D;a++){for(let b=a;b<Q.D;b++){if(a===b){Hre[a][b]=(Q.rng()*2-1)*1.2;Him[a][b]=0;}else{const re=(Q.rng()*2-1)*0.9,im=(Q.rng()*2-1)*0.9;Hre[a][b]=re;Him[a][b]=im;Hre[b][a]=re;Him[b][a]=-im;}}}log("H construit (Hermitien aléatoire, multi-niveaux)");};const matVec=(Are,Aim,v)=>{const out=[];for(let a=0;a<Q.D;a++){let r=[0,0];for(let b=0;b<Q.D;b++){r=cadd(r,cmul([Are[a][b],Aim[a][b]],v[b]));}out[a]=r;}return out};const evolve=(dt)=>{if(!Hre)buildH();const k=dt;for(let i=0;i<Q.K;i++){const v=Q.psi[i];const Hv=matVec(Hre,Him,v);for(let a=0;a<Q.D;a++)v[a]=cadd(v[a],cmul([0,-k],Hv[a]));psiNormalize(v);} };const resetH=()=>{Hre=null;Him=null;};window.__QJ3__={evolve,resetH};})();</script>

<script>/*BLOC 4/8: mesure + sélection*/(()=>{const U=window.__QJ__,{clamp,cab2,cadd}=U;const V=window.__QJ2__,{Q,renormW,buildRho}=V;const probInBasis=(k)=>{let p=0;for(let i=0;i<Q.K;i++)p+=Q.w[i]*cab2(Q.psi[i][k]);return clamp(p,0,1)};const measureBasis=(k)=>{k=Math.max(0,Math.min(Q.D-1,k|0));for(let i=0;i<Q.K;i++){const lik=Math.max(1e-12,cab2(Q.psi[i][k]));Q.w[i]*=lik;}renormW();buildRho();Q.lastMeas=true;setTimeout(()=>Q.lastMeas=false,800);return k};const randomUnitaryJitter=(v)=>{for(let a=0;a<Q.D;a++){const b=(Q.rng()*2-1)*0.15;v[a]=cadd(v[a],[b,0]);}return v};const measureRandomBasis=()=>{const k=(Q.rng()*Q.D)|0;for(let i=0;i<Q.K;i++){const vv=Q.psi[i];randomUnitaryJitter(vv);let s=0;for(let a=0;a<Q.D;a++)s+=cab2(vv[a]);s=Math.sqrt(s)||1;for(let a=0;a<Q.D;a++){vv[a][0]/=s;vv[a][1]/=s;}const lik=Math.max(1e-12,cab2(vv[k]));Q.w[i]*=lik;}renormW();buildRho();Q.lastMeas=true;setTimeout(()=>Q.lastMeas=false,800);return k};const softMixUniform=(eps)=>{eps=clamp(eps,0,0.35);const u=1/Q.K;for(let i=0;i<Q.K;i++)Q.w[i]=(1-eps)*Q.w[i]+eps*u;renormW();buildRho();};const sharpen=(alpha)=>{alpha=clamp(alpha,1.00,6.00);let s=0;for(let i=0;i<Q.K;i++){Q.w[i]=Math.pow(Math.max(1e-18,Q.w[i]),alpha);s+=Q.w[i];}for(let i=0;i<Q.K;i++)Q.w[i]/=s;buildRho();};const selectAndAct=()=>{const Hw=window.__QJ2__.Hweights();const risk=clamp(Hw/Math.log2(Q.K),0,1);const opp=clamp(1-risk,0,1);let act="none";if(Q.mode==="maxent"){if(risk>0.55){measureBasis((Q.rng()*Q.D)|0);act="Mb"}else if(opp>0.85){softMixUniform(0.05);act="mix"}else act="none";}else if(Q.mode==="minaction"){if(risk>0.70){measureBasis(0);act="M0"}else act="none";}else if(Q.mode==="attractor"){if(risk>0.45){measureRandomBasis();act="Mr"}else if(risk<0.20){sharpen(1.25);act="sharp"}else act="none";}return act;};window.__QJ4__={measureBasis,measureRandomBasis,probInBasis,softMixUniform,sharpen,selectAndAct};})();</script>

<script>/*BLOC 5/8: eig(ρ) + gap strict + noyau topo/comp*/(()=>{const U=window.__QJ__,{clamp,fmt}=U;const V=window.__QJ2__,{Q,renormW,buildRho,Hweights,support,mkPsi}=V;const X=window.__QJ4__;const jacobiEigen=(A,n,itMax=80)=>{for(let it=0;it<itMax;it++){let p=0,q=1,max=0;for(let i=0;i<n;i++)for(let j=i+1;j<n;j++){const v=Math.abs(A[i][j]);if(v>max){max=v;p=i;q=j;}}if(max<1e-12)break;const app=A[p][p],aqq=A[q][q],apq=A[p][q];const phi=0.5*Math.atan2(2*apq,(aqq-app));const c=Math.cos(phi),s=Math.sin(phi);for(let k=0;k<n;k++){const akp=A[k][p],akq=A[k][q];A[k][p]=c*akp-s*akq;A[k][q]=s*akp+c*akq;}for(let k=0;k<n;k++){const apk=A[p][k],aqk=A[q][k];A[p][k]=c*apk-s*aqk;A[q][k]=s*apk+c*aqk;}A[p][p]=c*c*app-2*s*c*apq+s*s*aqq;A[q][q]=s*s*app+2*s*c*apq+c*c*aqq;A[p][q]=A[q][p]=0;}const eig=[];for(let i=0;i<n;i++)eig.push(A[i][i]);eig.sort((a,b)=>b-a);return eig;};const eigRho=()=>{const d=Q.D,n=2*d;const A=[];for(let i=0;i<n;i++)A[i]=new Float64Array(n);for(let a=0;a<d;a++)for(let b=0;b<d;b++){const re=Q.rhoRe[a][b],im=Q.rhoIm[a][b];A[a][b]=re;A[a][b+d]=-im;A[a+d][b]=im;A[a+d][b+d]=re;}const eig2=jacobiEigen(A,n,90);const eig=eig2.slice(0,d).map(x=>Math.max(0,x));const s=eig.reduce((p,c)=>p+c,0)||1;for(let i=0;i<eig.length;i++)eig[i]/=s;eig.sort((a,b)=>b-a);return eig;};const entropyFromEig=(eig)=>{let S=0;for(let i=0;i<eig.length;i++){const p=eig[i];if(p>1e-18)S-=p*Math.log(p);}return S/Math.LN2;};const coherenceRepair=()=>{renormW();buildRho();const logK=Math.log2(Q.K);const Ht=clamp(Q.compRatio*logK,0.10,logK);const band=clamp(0.15*logK,0.05,0.60*logK);if(Hweights()<Ht-band){let it=0;while(Hweights()<Ht-band&&it<20){X.softMixUniform(0.06);it++;}}else if(Hweights()>Ht+band){let it=0;while(Hweights()>Ht+band&&it<18){X.sharpen(1.35);it++;}}const target=Math.max(4,Math.min(Q.K,Math.round(Q.topoRatio*Q.K)));const cur=support();if(cur<target){let idx=[];for(let i=0;i<Q.K;i++)idx.push(i);idx.sort((a,b)=>Q.w[a]-Q.w[b]);for(let j=0;j<target-cur && j<idx.length;j++){const i=idx[j];Q
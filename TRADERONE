cat >/root/fix_lifi_api_key_traderone.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/traderone-opt"

echo "== 1) Check current env (root shell) =="
if env | grep -q '^LIFI_API_KEY='; then
  echo "LIFI_API_KEY is set in this shell ✅"
else
  echo "LIFI_API_KEY NOT set in this shell ❌"
fi

echo
echo "== 2) Ensure app dir exists =="
test -d "$APP_DIR" || { echo "Missing $APP_DIR"; exit 1; }

echo
echo "== 3) Write/Update $APP_DIR/.env (hidden input) =="
read -s -p "Enter LIFI_API_KEY: " KEY
echo
[ -n "$KEY" ] || { echo "Empty key, abort"; exit 2; }

# backup existing env
if [ -f "$APP_DIR/.env" ]; then
  cp -a "$APP_DIR/.env" "$APP_DIR/.env.bak_$(date +%Y%m%d_%H%M%S)"
fi

# keep other vars, replace/add LIFI_API_KEY
touch "$APP_DIR/.env"
grep -v '^LIFI_API_KEY=' "$APP_DIR/.env" > "$APP_DIR/.env.tmp" || true
printf "LIFI_API_KEY=%s\n" "$KEY" >> "$APP_DIR/.env.tmp"
mv "$APP_DIR/.env.tmp" "$APP_DIR/.env"
chmod 600 "$APP_DIR/.env"

echo "Wrote $APP_DIR/.env ✅ (permissions 600)"

echo
echo "== 4) Restart traderone backend (port 8585) =="
PID="$(ss -lntp 2>/dev/null | awk '/:8585/ {print $NF}' | sed -n 's/.*pid=\([0-9]\+\).*/\1/p' | head -n1 || true)"
if [ -n "${PID:-}" ] && [ -d "/proc/$PID" ]; then
  echo "Found PID on :8585 => $PID"
  echo "Cmdline:"
  tr '\0' ' ' < /proc/$PID/cmdline; echo

  echo "Stopping PID..."
  kill "$PID"
  sleep 1
fi

echo "Starting traderone (best-effort) ..."
# try common start methods
if [ -f "$APP_DIR/package.json" ]; then
  (cd "$APP_DIR" && nohup env $(cat .env | xargs) npm start >/var/log/traderone-opt.log 2>&1 &) || true
fi

sleep 1
echo
echo "== 5) Verify port 8585 and quick log tail =="
ss -lntp 2>/dev/null | grep ':8585' || echo "8585 not listening yet (check /var/log/traderone-opt.log)"
tail -n 50 /var/log/traderone-opt.log 2>/dev/null || true

echo
echo "DONE ✅"
BASH

chmod +x /root/fix_lifi_api_key_traderone.sh
/root/fix_lifi_api_key_traderone.sh








head -n 20 /opt/traderone-opt/server.js 2>/dev/null || true
ls -lah /opt/traderone-opt | head



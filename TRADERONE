"use strict";
const http = require("http");
const fs = require("fs");
const path = require("path");
const nacl = require("tweetnacl");
const bs58 = require("bs58");

const HOST = "127.0.0.1";
const PORT = parseInt(process.env.PORT || "3010", 10);
const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, "data");
const DB_PATH = path.join(DATA_DIR, "vaults.json");

function readJson(p, fallback){
  try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch(e){ return fallback; }
}
function writeJsonAtomic(p, obj){
  const tmp = p + ".tmp";
  fs.writeFileSync(tmp, JSON.stringify(obj, null, 2));
  fs.renameSync(tmp, p);
}
function send(res, code, obj){
  const b = Buffer.from(JSON.stringify(obj));
  res.writeHead(code, {
    "content-type":"application/json",
    "content-length": String(b.length),
    "access-control-allow-origin":"*",
    "access-control-allow-methods":"GET,POST,OPTIONS",
    "access-control-allow-headers":"content-type"
  });
  res.end(b);
}
function readBody(req){
  return new Promise((resolve,reject)=>{
    let d="";
    req.on("data", c=>{ d+=c; if(d.length>2e6) req.destroy(); });
    req.on("end", ()=>resolve(d));
    req.on("error", reject);
  });
}

fs.mkdirSync(DATA_DIR, { recursive:true });
if (!fs.existsSync(DB_PATH)) writeJsonAtomic(DB_PATH, { byUser:{} });

const server = http.createServer(async (req,res)=>{
  if (req.method === "OPTIONS") return send(res, 200, { ok:true });

  if (req.url === "/health") return send(res, 200, { status:"ok", service:"wolverine-vault-api" });

  if (req.url === "/vault" && req.method === "POST"){
    try{
      const raw = await readBody(req);
      const body = raw ? JSON.parse(raw) : {};
      const user = String(body.pub || "").trim();
      if (!user) return send(res, 400, { ok:false, error:"missing pub" });

      const db = readJson(DB_PATH, { byUser:{} });
      db.byUser = db.byUser || {};

      if (db.byUser[user] && db.byUser[user].vaultPub){
        return send(res, 200, { ok:true, existed:true, vaultPub: db.byUser[user].vaultPub });
      }

      // Generate Solana-like ed25519 keypair (64 bytes secretKey = priv(32)+pub(32))
      const kp = nacl.sign.keyPair();
      const pub = bs58.encode(Buffer.from(kp.publicKey));
      const sec = bs58.encode(Buffer.from(kp.secretKey)); // store (encrypted later if you want) — here minimal

      db.byUser[user] = { vaultPub: pub, vaultSecret: sec, createdAt: Date.now() };
      writeJsonAtomic(DB_PATH, db);

      return send(res, 200, { ok:true, existed:false, vaultPub: pub });
    }catch(e){
      return send(res, 500, { ok:false, error: String(e && e.message ? e.message : e) });
    }
  }

  send(res, 404, { ok:false, error:"not found" });
});

server.listen(PORT, HOST, ()=>console.log(`vault-api listening on http://${HOST}:${PORT}`));

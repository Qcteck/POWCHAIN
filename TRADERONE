echo "=== 3) Write ONE nginx snippet that contains EVERYTHING (front + unified api + traderone + ws) ==="
SNIP_UNI="/etc/nginx/snippets/wolverine_unified.conf"
cat >"$SNIP_UNI" <<'EOF'
# WOLVERINE_UNIFIED_V1

# --- ONE FRONTEND ---
location ^~ /wolverine/ {
  alias /var/www/fireinners/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}

# --- ONE BACKEND (UNIFIED API) : /wolverine/api/* -> TraderOne /api/* ---
location ^~ /wolverine/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:8585/api/;
}

# --- TRADERONE (UI + native api + ws) ---
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:8585/api/;
}

location ^~ /wolverine/traderone/ws {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:8585/ws;
}

location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:8585/;
}
EOF

echo "=== 4) Ensure ONLY this unified include is in the ACTIVE vhost server{} ==="
# remove old includes if present, add unified include if missing
python3 - <<PY
import re
p="${VHOST}"
s=open(p,"r",encoding="utf-8",errors="ignore").read()

# remove old includes (eagle + previous traderone snippets) to avoid confusion
s=re.sub(r'^\s*include\s+/etc/nginx/snippets/wolverine_eagle\.conf;.*\n','',s,flags=re.M)
s=re.sub(r'^\s*include\s+/etc/nginx/snippets/wolverine_traderone_backend\.conf;.*\n','',s,flags=re.M)

inc='    include /etc/nginx/snippets/wolverine_unified.conf; # WOLVERINE_UNIFIED_INCLUDE\n'
if "wolverine_unified.conf" in s:
    pass
else:
    m=re.search(r'^\s*server\s*\{\s*$', s, flags=re.M)
    if not m:
        raise SystemExit("ERROR: can't find 'server {' in active vhost: "+p)
    s = s[:m.end()] + "\n" + inc + s[m.end():]

open(p,"w",encoding="utf-8").write(s)
print("OK: unified include ensured in", p)
PY


say "5) Ensure vhost includes aquilatrader_static.inc (inside server block)"
# inject include line once after includes section; best-effort and idempotent
if ! grep -qF "include ${AQUILA_INC};" "$VHOST"; then
  python3 - <<'PY'
import re
vhost="/etc/nginx/sites-available/fireinners.online-ssl"
inc="/etc/nginx/includes/aquilatrader_static.inc"
with open(vhost,"r",encoding="utf-8",errors="ignore") as f:
    lines=f.read().splitlines(True)

# Find first "server {" then insert after last consecutive include line near top of server.
out=[]
in_server=False
inserted=False
for idx,line in enumerate(lines):
    out.append(line)
    if not in_server and re.search(r'^\s*server\s*\{', line):
        in_server=True
        continue
    if in_server and not inserted:
        # Insert after we pass initial include cluster (or right after server { if none)
        # Heuristic: when we see a non-include directive after at least one include, insert before it.
        # Or if we reach first location, insert before it.
        if re.search(r'^\s*include\s+', line):
            continue
        if re.search(r'^\s*#', line) or line.strip()=="":
            continue
        # Before first non-trivial directive in server block
        out.insert(len(out)-1, f"  include {inc};\n")
        inserted=True

# If server exists but we never inserted (edge-case), append near end before last }
if in_server and not inserted:
    # find last "}" and insert before it
    for j in range(len(out)-1, -1, -1):
        if out[j].strip()=="}":
            out.insert(j, f"  include {inc};\n")
            inserted=True
            break

if not inserted:
    raise SystemExit("Could not inject include into vhost")

with open(vhost,"w",encoding="utf-8") as f:
    f.write("".join(out))

print("OK: injected include into vhost")
PY
else
  say "vhost already includes aquilatrader_static.inc (no-op)"
fi
hr


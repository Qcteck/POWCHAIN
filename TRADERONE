cat >/root/AIAQUILA_NGINX_IMMUTABLE_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SITE="fireinners.online"
NGX_SITE="/etc/nginx/sites-available/$SITE"
SNIPPET="/etc/nginx/snippets/aiaquila_rss_proxy.conf"
WORKER="https://aiaquila-proxy.paycashnostory.workers.dev/rss"

echo "=== AIAQUILA NGINX IMMUTABLE FIX ==="

### 1. Remove immutable flag
echo "[1/6] Removing immutable flag"
lsattr "$NGX_SITE" || true
chattr -i "$NGX_SITE"

### 2. Write snippet (idempotent)
echo "[2/6] Writing proxy snippet"
cat >"$SNIPPET" <<NGX
location /aiaquila/api/rss {
    proxy_pass $WORKER;
    proxy_set_header Host aiaquila-proxy.paycashnostory.workers.dev;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_ssl_server_name on;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}
NGX

### 3. Inject include if absent
echo "[3/6] Injecting include in site"
grep -q "aiaquila_rss_proxy" "$NGX_SITE" || \
sed -i "/server_name $SITE;/a \    include /etc/nginx/snippets/aiaquila_rss_proxy.conf;" "$NGX_SITE"

### 4. Restore immutable flag
echo "[4/6] Restoring immutable flag"
chattr +i "$NGX_SITE"
lsattr "$NGX_SITE"

### 5. Reload nginx
echo "[5/6] Reload nginx"
nginx -t
systemctl reload nginx

### 6. Hard test endpoint
echo "[6/6] Testing VPS endpoint"
curl -fsS "https://$SITE/aiaquila/api/rss?url=https://news.bitcoin.com/feed/" | head -n 5 >/dev/null

echo "=== ✅ AIAQUILA VPS PROXY OPERATIONAL ==="
echo "URL: https://$SITE/aiaquila/"
BASH

chmod +x /root/AIAQUILA_NGINX_IMMUTABLE_FIX.sh
/root/AIAQUILA_NGINX_IMMUTABLE_FIX.sh
#!/usr/bin/env bash
set -euo pipefail

echo "=== TRADERONE BUDGET FIX (ROOT) ==="

API_PORT=3000
APP_NAME=traderone-vault
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

### 1) Vérifier que Node écoute bien
echo "[1/6] Vérification Node API locale"
curl -s http://127.0.0.1:${API_PORT}/wolverine/traderone/api/health || {
  echo "❌ API locale inaccessible"
  exit 1
}
echo "✅ API locale OK"

### 2) Patch nginx (proxy POST JSON)
echo "[2/6] Patch nginx proxy"
grep -q "traderone/api" "$NGINX_SITE" || cat >> "$NGINX_SITE" <<'NGINX'

location /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Content-Type application/json;
    proxy_pass_request_body on;
}
NGINX

nginx -t
systemctl reload nginx
echo "✅ Nginx rechargé"

### 3) Redémarrage PM2
echo "[3/6] Restart TraderOne Vault"
pm2 restart "$APP_NAME"
sleep 2

### 4) Test POST local (JSON obligatoire)
echo "[4/6] Test POST local"
curl -s -X POST http://127.0.0.1:${API_PORT}/wolverine/traderone/api/budget \
  -H "Content-Type: application/json" \
  -d '{"pubkey":"11111111111111111111111111111111","budgetSol":0.001}' \
  | jq . || {
    echo "❌ Réponse locale non JSON"
    exit 1
}

### 5) Test POST public
echo "[5/6] Test POST public"
curl -s -X POST https://fireinners.online/wolverine/traderone/api/budget \
  -H "Content-Type: application/json" \
  -d '{"pubkey":"11111111111111111111111111111111","budgetSol":0.001}' \
  | jq . || {
    echo "❌ Réponse publique non JSON"
    exit 1
}

### 6) FIN
echo "=== ✅ BUDGET API OPÉRATIONNEL ==="
echo "Frontend recevra DU JSON, plus jamais du HTML."
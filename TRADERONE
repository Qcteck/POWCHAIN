set -e
cd /root

echo "=== Bloc EFFECTIF dans nginx -T (SSL) ==="
nginx -T 2>/dev/null | awk '
  /server_name[[:space:]]+fireinners\.online/ {insrv=1}
  insrv && /location[[:space:]]+\^~[[:space:]]+\/wolverine\/traderone\/api\// {inloc=1}
  insrv && inloc {print}
  inloc && /^[[:space:]]*}[[:space:]]*$/ {exit}
'
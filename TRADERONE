cat >/root/MEGA_AQUILATRADER_FIX_DUPLOC_V1.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
hr(){ echo "----------------------------------------------------------------"; }
die(){ say "ERROR: $*"; exit 1; }

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_AQUILATRADER_${TS}"
mkdir -p "$BK"

WWW="/var/www/aquilatrader"
INDEX="${WWW}/index.html"

NGXCONF="/etc/nginx/nginx.conf"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_static.inc"

say "MEGA_AQUILATRADER_FIX_DUPLOC_V1"
say "Goal: /aquilatrader/ works + remove duplicate nginx location blocks (no manual edits)"
say "Backup: $BK"
hr

say "0) Backup key files"
[ -f "$INC" ] || die "Missing include: $INC"
cp -a "$INC" "$BK/wolverine_static.inc.bak"
[ -f "$VHOST" ] && cp -a "$VHOST" "$BK/fireinners.online-ssl.bak" || true
[ -f "$NGXCONF" ] && cp -a "$NGXCONF" "$BK/nginx.conf.bak" || true

say "0.1) Try unlock immutables (ignore errors)"
chattr -i "$INC" "$VHOST" "$NGXCONF" 2>/dev/null || true

hr
say "1) Ensure webroot exists + write AquilaTrader index.html"
mkdir -p "$WWW"
if [ ! -f "$INDEX" ]; then
  cat >"$INDEX" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>AquilaTrader</title><style>body{margin:0;font-family:system-ui,Segoe UI,Roboto,Arial;background:#0b1220;color:#eaf2ff}main{max-width:980px;margin:60px auto;padding:24px}h1{font-size:56px;letter-spacing:.5px;margin:0 0 18px}label{display:block;margin:14px 0 8px;color:#bcd3ff}input{width:100%;font-size:20px;padding:18px 16px;border-radius:12px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);color:#fff;outline:none}button{font-size:20px;padding:14px 22px;border-radius:16px;border:0;background:#eef4ff;color:#245;cursor:pointer;margin-right:16px}button:active{transform:scale(.99)}.row{margin-top:18px;display:flex;gap:16px;flex-wrap:wrap}.muted{color:#9fb7e6}.log{margin-top:16px;white-space:pre-wrap;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px;min-height:72px}</style></head><body><main><h1>AquilaTrader</h1><div class="muted">Wallet: <span id="addr">-</span></div><label>userPub (adresse publique)</label><input id="pub" placeholder="Colle ta pubkey (Solana)"/><div class="row"><button id="start">Start</button><button id="stop">Stop</button><button id="cash">Cash-out</button></div><div class="log" id="log"></div><script>
const log=(s)=>{const el=document.querySelector("#log");el.textContent=(el.textContent?el.textContent+"\n":"")+s;};
const post=async(path,body)=>{const r=await fetch("/wolverine/traderone/api"+path,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body||{})});let t="";try{t=await r.text()}catch(e){};let j=null;try{j=JSON.parse(t)}catch(e){};if(!r.ok)throw new Error("HTTP "+r.status+" "+(j?JSON.stringify(j):t));return j||t;};
const pubEl=document.querySelector("#pub");
pubEl.oninput=()=>document.querySelector("#addr").textContent=pubEl.value.trim()||"-";
document.querySelector("#start").onclick=async()=>{try{await post("/start",{userPub:pubEl.value.trim()});log("started");}catch(e){log("ERR start: "+e.message);}};
document.querySelector("#stop").onclick=async()=>{try{await post("/stop",{userPub:pubEl.value.trim()});log("stopped");}catch(e){log("ERR stop: "+e.message);}};
document.querySelector("#cash").onclick=async()=>{try{const r=await post("/cashout",{userPub:pubEl.value.trim()});log("cashout: "+(typeof r==="string"?r:JSON.stringify(r)));}catch(e){log("ERR cashout: "+e.message);}};
</script></main></body></html>
HTML
  chmod 0644 "$INDEX"
fi

hr
say "2) Remove any existing /aquilatrader location blocks from $INC (brace-aware) then append single managed block"
python3 - <<PY
import re,sys
inc_path = "$INC"
data = open(inc_path,"r",encoding="utf-8",errors="ignore").read().splitlines(True)

# 1) strip any previous managed block
out=[]
in_managed=False
for line in data:
    if "BEGIN_AQUILATRADER_MANAGED" in line: in_managed=True; continue
    if "END_AQUILATRADER_MANAGED" in line: in_managed=False; continue
    if not in_managed: out.append(line)

data = out

# 2) remove any nginx location blocks for /aquilatrader (counts braces)
pat = re.compile(r'^\s*location\s+(=|~\*|~|\^~)?\s*/aquilatrader/?\s*\{', re.I)
out=[]
skip=False
depth=0
for line in data:
    if not skip and pat.search(line):
        skip=True
        depth=line.count("{")-line.count("}")
        continue
    if skip:
        depth += line.count("{")-line.count("}")
        if depth<=0:
            skip=False
        continue
    out.append(line)

# ensure file ends with newline
if out and not out[-1].endswith("\n"): out[-1]+="\n"

# append managed block
block = r'''
# BEGIN_AQUILATRADER_MANAGED
location ^~ /aquilatrader/ {
  alias /var/www/aquilatrader/;
  try_files $uri $uri/ /aquilatrader/index.html;
  add_header Cache-Control "no-store" always;
}
# END_AQUILATRADER_MANAGED
'''
out.append("\n"+block.strip()+"\n")

open(inc_path,"w",encoding="utf-8").write("".join(out))
print("OK: wrote cleaned include with single /aquilatrader/ block ->", inc_path)
PY

hr
say "3) nginx -t then reload (rollback if nginx -t fails)"
set +e
nginx -t
RC=$?
set -e
if [ "$RC" -ne 0 ]; then
  say "nginx -t FAILED -> rollback"
  cp -a "$BK/wolverine_static.inc.bak" "$INC" || true
  [ -f "$BK/fireinners.online-ssl.bak" ] && cp -a "$BK/fireinners.online-ssl.bak" "$VHOST" || true
  [ -f "$BK/nginx.conf.bak" ] && cp -a "$BK/nginx.conf.bak" "$NGXCONF" || true
  nginx -t || true
  die "Rollback done. Fix not applied. Check: $BK"
fi
systemctl reload nginx

hr
say "4) Quick local checks (with Host header)"
curl -sk "https://127.0.0.1/aquilatrader/" -H "Host: fireinners.online" | head -n 8 || true
curl -sk "https://127.0.0.1/wolverine/traderone/api/health" -H "Host: fireinners.online" | head -n 5 || true

hr
say "DONE. Open: https://fireinners.online/aquilatrader/"
say "Backup: $BK"
BASH

bash /root/MEGA_AQUILATRADER_FIX_DUPLOC_V1.sh |& tee /root/MEGA_AQUILATRADER_FIX_DUPLOC_V1.log
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIX WOLVERINE NGINX API PROXY ==="

NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
BACKUP="${NGINX_SITE}.bak_$(date +%Y%m%d_%H%M%S)"

if [ ! -f "$NGINX_SITE" ]; then
  echo "❌ NGINX site introuvable: $NGINX_SITE"
  exit 1
fi

echo "📦 Backup NGINX..."
cp -a "$NGINX_SITE" "$BACKUP"

if grep -q "location /wolverine/api/" "$NGINX_SITE"; then
  echo "⚠️ Proxy déjà présent, skip"
else
  echo "➕ Injection proxy /wolverine/api/"
  sed -i '/location \/wolverine\/ {/a \
    location /wolverine/api/ {\
        proxy_pass http://127.0.0.1:3000/;\
        proxy_http_version 1.1;\
        proxy_set_header Upgrade $http_upgrade;\
        proxy_set_header Connection "upgrade";\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\
        proxy_set_header X-Forwarded-Proto $scheme;\
    }\
' "$NGINX_SITE"
fi

echo "🔍 Test nginx..."
nginx -t

echo "🔄 Reload nginx..."
systemctl reload nginx

echo "✅ NGINX PROXY API OK"
echo "➡️ Recharge la page (Ctrl+F5)"
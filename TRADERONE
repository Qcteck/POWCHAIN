cat > /root/WOLVERINE_NGINX_503_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS=$(date +%Y%m%d_%H%M%S)
LOG="/root/WOLVERINE_503_$TS.log"

echo "=== WOLVERINE HTTP 503 DIAGNOSTIC & FIX ===" | tee -a "$LOG"

echo "[1/8] Status nginx" | tee -a "$LOG"
systemctl status nginx --no-pager | tee -a "$LOG" || true

echo "[2/8] Test config nginx" | tee -a "$LOG"
nginx -t | tee -a "$LOG"

echo "[3/8] Sauvegarde config nginx" | tee -a "$LOG"
cp -a /etc/nginx/nginx.conf /etc/nginx/nginx.conf.bak_$TS
cp -a /etc/nginx/sites-available /etc/nginx/sites-available.bak_$TS
cp -a /etc/nginx/sites-enabled /etc/nginx/sites-enabled.bak_$TS

echo "[4/8] Détection conflits server_name" | tee -a "$LOG"
grep -R "server_name" /etc/nginx/sites-* | tee -a "$LOG"

echo "[5/8] Détection duplicate listen 443" | tee -a "$LOG"
grep -R "listen 443" /etc/nginx/sites-* | tee -a "$LOG"

echo "[6/8] Désactivation rate-limit / protection aggressive (SAFE)" | tee -a "$LOG"
sed -i 's/limit_req/#limit_req/g' /etc/nginx/nginx.conf || true
sed -i 's/limit_conn/#limit_conn/g' /etc/nginx/nginx.conf || true

echo "[7/8] Reload nginx propre" | tee -a "$LOG"
systemctl restart nginx
sleep 2
systemctl status nginx --no-pager | tee -a "$LOG"

echo "[8/8] Test HTTP local" | tee -a "$LOG"
curl -I http://127.0.0.1 | tee -a "$LOG" || true

echo
echo "=== DIAGNOSTIC TERMINE ==="
echo "Log: $LOG"
echo
echo "NEXT:"
echo "- Si HTTP 200 => problème résolu"
echo "- Si 503 persiste => lire le LOG (cause exacte affichée)"
BASH

chmod +x /root/WOLVERINE_NGINX_503_FIX.sh
/root/WOLVERINE_NGINX_503_FIX.sh
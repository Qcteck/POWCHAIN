cat >/root/AQ_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/aiaquila_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== AIAQUILA FINAL FIX ==="

### 1) Backup
echo "[1/6] Backup vhost"
cp -a "$VHOST" "$VHOST.bak.$TS"

### 2) Unlock
echo "[2/6] Unlock vhost"
chattr -i "$VHOST" 2>/dev/null || true

### 3) Write proxy snippet (NO location)
echo "[3/6] Write proxy snippet"
cat >"$SNIP" <<'NGX'
resolver 1.1.1.1 8.8.8.8 valid=300s;
resolver_timeout 5s;

proxy_pass https://news.bitcoin.com/feed/;
proxy_set_header Host news.bitcoin.com;
proxy_set_header User-Agent "AIAQUILA-RSS";
proxy_ssl_server_name on;

proxy_connect_timeout 10s;
proxy_read_timeout 30s;
NGX

### 4) Inject locations into SERVER BLOCK
echo "[4/6] Inject locations if missing"
grep -q "location /aiaquila/api/rss" "$VHOST" || sed -i '/server_name fireinners.online;/a\
\
    location /aiaquila/api/rss {\
        include /etc/nginx/snippets/aiaquila_proxy.conf;\
    }\
\
    location /aiaquila/health {\
        default_type text/plain;\
        return 200 "OK AIAQUILA\\n";\
    }\
' "$VHOST"

### 5) Test + reload
echo "[5/6] nginx test"
nginx -t

echo "[6/6] reload nginx"
systemctl reload nginx

### 6) Relock
chattr +i "$VHOST" 2>/dev/null || true

echo "DONE"
echo "Health : https://$DOMAIN/aiaquila/health"
echo "RSS    : https://$DOMAIN/aiaquila/api/rss"
BASH

chmod +x /root/AQ_FIX.sh
/root/AQ_FIX.sh
chattr -i "$VHOST" 2>/dev/null || true
for f in /etc/nginx/includes/wolverine*.inc; do [ -f "$f" ] && chattr -i "$f" 2>/dev/null || true; done

say "3) Ensure WEBROOT + index.html exists"
mkdir -p "$WEBROOT"
if [ ! -f "$WEBROOT/index.html" ]; then
  CAND=(
    "/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
    "/opt/fireinners/frontend-react/app/dist/wolverine/index.htm"
    "/opt/wolverine/out/index.html"
    "/opt/wolverine/dist/index.html"
    "/opt/wolverine/index.html"
    "/var/www/wolverine/index.html"
  )
  FOUND=""
  for p in "${CAND[@]}"; do
    if [ -f "$p" ]; then FOUND="$p"; break; fi
  done
  if [ -n "$FOUND" ]; then
    say "   -> restore index.html from $FOUND"
    cp -a "$FOUND" "$WEBROOT/index.html"
  else
    say "   -> WARNING: no source index.html found, creating minimal placeholder"
    cat >"$WEBROOT/index.html" <<'HTML'
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Wolverine</title></head><body style="font-family:system-ui;padding:20px"><h2>Wolverine</h2><p>index.html manquant: restore requis.</p></body></html>
HTML
  fi
fi

say "4) Ensure vendor directory (best-effort)"
mkdir -p "$WEBROOT/vendor"
if [ ! -f "$WEBROOT/vendor/solana-web3.min.js" ]; then
  for d in "/opt/fireinners/frontend-react/app/dist/wolverine/vendor" "/opt/wolverine/vendor" "/var/www/wolverine/vendor"; do
    if [ -d "$d" ] && ls -1 "$d" >/dev/null 2>&1; then
      say "   -> copy vendor from $d"

# 1) retrouve quel index.html a été patché (si tu ne sais plus)
find /var/www/wolverine /var/www /usr/share/nginx/html -maxdepth 4 -type f -name index.html 2>/dev/null | head -n 5

# 2) check que le bouton + le script sont bien dedans
grep -RIn 'id="sendSolBtn"|WOLVERINE_SEND_SOL_SCRIPT|WOLVERINE_WALLET' \
  /var/www/wolverine /var/www /usr/share/nginx/html 2>/dev/null | head -n 40

# 3) vérif que le site sert bien le bon fichier
curl -sk https://fireinners.online/wolverine/ | grep -n 'sendSolBtn\|WOLVERINE_SEND_SOL_SCRIPT' || echo "Pas trouvé dans le HTML servi"
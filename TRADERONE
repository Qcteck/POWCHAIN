VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
NGXCONF="/etc/nginx/nginx.conf"
INCDIR="/etc/nginx/includes"
INC_STATIC="${INCDIR}/wolverine_static.inc"
INC_ROUTES="${INCDIR}/wolverine_routes.inc"

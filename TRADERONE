cat >/tmp/FIX_OP_NOT_PERMITTED_SNIPPET.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SNIP="/etc/nginx/snippets/fireinners-wolverine.conf"

echo "== WHOAMI =="
whoami
id

echo
echo "== PERMS =="
ls -ld /etc/nginx /etc/nginx/snippets || true
ls -l "$SNIP" || true

echo
echo "== ATTRS (immutable?) =="
command -v lsattr >/dev/null 2>&1 && lsattr -a "$SNIP" || echo "lsattr not installed"

echo
echo "== MOUNT (read-only?) =="
mount | grep -E ' on / | on /etc ' || true

echo
echo "== Try remove immutable if present =="
if command -v lsattr >/dev/null 2>&1; then
  if lsattr -a "$SNIP" 2>/dev/null | grep -q '\-i\-'; then
    echo "immutable not set"
  else
    echo "attempt chattr -i ..."
    chattr -i "$SNIP" 2>/dev/null || true
    lsattr -a "$SNIP" || true
  fi
fi

echo
echo "== Ensure ownership/perm sane =="
chown root:root /etc/nginx /etc/nginx/snippets "$SNIP" 2>/dev/null || true
chmod 755 /etc/nginx /etc/nginx/snippets 2>/dev/null || true
chmod 644 "$SNIP" 2>/dev/null || true
ls -l "$SNIP" || true

echo
echo "== Test write (append marker) =="
echo "# WRITE_TEST $(date -Is)" >> "$SNIP"

echo
echo "OK: write succeeded. Now run nginx -t:"
nginx -t
SH

bash /tmp/FIX_OP_NOT_PERMITTED_SNIPPET.sh
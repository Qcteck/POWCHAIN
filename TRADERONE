cat >/root/MEGA_BUNDLER_API_FORCE_9797.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BUNDLER_API_FORCE_${TS}"
mkdir -p "$BK"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run as root"

DOMAIN="fireinners.online"
API_DIR="/opt/bundler_api"
API_PORT="9797"
API_HOST="127.0.0.1"
API_SVC="/etc/systemd/system/bundler-api.service"

unlock(){ chattr -i "$1" 2>/dev/null || true; }
lockit(){ chattr +i "$1" 2>/dev/null || true; }

say "backup: $BK"
tar -C /opt -czf "$BK/opt_bundler_api.tgz" bundler_api >/dev/null 2>&1 || true
cp -a "$API_SVC" "$BK/bundler-api.service.bak" 2>/dev/null || true
tar -C /etc/nginx -czf "$BK/etc_nginx.tgz" . >/dev/null 2>&1 || true

say "node: ensure >= 20.18.x (some @solana packages require >=20.18)"
need_upgrade=0
if command -v node >/dev/null 2>&1; then
  v="$(node -v | tr -d 'v' || true)"
  maj="${v%%.*}"; rest="${v#*.}"; min="${rest%%.*}"
  if [ "${maj:-0}" -lt 20 ] || { [ "${maj:-0}" -eq 20 ] && [ "${min:-0}" -lt 18 ]; }; then need_upgrade=1; fi
else
  need_upgrade=1
fi
if [ "$need_upgrade" -eq 1 ]; then
  say "node: upgrading via NodeSource 20.x"
  apt-get update -y >/dev/null
  apt-get install -y ca-certificates curl gnupg >/dev/null
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash - >/dev/null
  apt-get install -y nodejs >/dev/null
fi
node -v || die "node missing"
npm -v || die "npm missing"

say "api: force minimal stable API on $API_HOST:$API_PORT"
mkdir -p "$API_DIR"
cd "$API_DIR"

# Keep prior files (already backed up) then force clean minimal runtime
rm -rf node_modules package-lock.json >/dev/null 2>&1 || true

cat >package.json <<'JSON'
{"name":"bundler-api","version":"1.0.0","private":true,"main":"server.js","type":"commonjs","scripts":{"start":"node server.js"},"dependencies":{"express":"^4.19.2"}}
JSON

cat >server.js <<'JS'
const express=require("express");
const app=express();
app.disable("x-powered-by");
app.get("/health",(req,res)=>res.json({ok:true,ts:new Date().toISOString()}));
app.get("/",(req,res)=>res.type("text/plain").send("bundler-api ok\n"));
const HOST=process.env.HOST||"127.0.0.1";
const PORT=parseInt(process.env.PORT||"9797",10);
app.listen(PORT,HOST,()=>console.log("bundler-api listening",HOST,PORT));
JS

npm install --omit=dev >/dev/null

say "systemd: write service"
unlock "$API_SVC" || true
cat >"$API_SVC" <<EOF
[Unit]
Description=Bundler API (forced minimal stable)
After=network.target

[Service]
Type=simple
WorkingDirectory=$API_DIR
Environment=HOST=$API_HOST
Environment=PORT=$API_PORT
ExecStart=/usr/bin/node $API_DIR/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF
chmod 644 "$API_SVC"

systemctl daemon-reload
systemctl enable --now bundler-api >/dev/null 2>&1 || true
systemctl restart bundler-api >/dev/null 2>&1 || true

say "diag: status + last logs"
systemctl is-active --quiet bundler-api && say "bundler-api: active" || say "bundler-api: NOT active"
journalctl -u bundler-api --no-pager -n 40 || true

say "diag: port listening"
ss -lntp | grep -E "(:$API_PORT\b)" || true

say "test: local curl"
curl -fsS "http://$API_HOST:$API_PORT/health" || true
echo

say "test: origin via nginx (bypass cloudflare)"
curl -skI --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/bundler/api/health" | head -n 12 | tr -d '\r' || true
curl -skI --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/bundler/" | head -n 12 | tr -d '\r' || true

say "DONE"
say "BACKUP: $BK"
BASH

chmod +x /root/MEGA_BUNDLER_API_FORCE_9797.sh
/root/MEGA_BUNDLER_API_FORCE_9797.sh
cat > "$STATE_JS" <<'"'"'JS'"'"'
const PROXY="https://aiaquila-proxy.paycashnostory.workers.dev";

const S = JSON.parse(localStorage.getItem("AIAQ_STATE")) || {
  name:null,
  prefs:{},
  score:50,
  bias:0,
  memory:[],
  timeline:[],
  logs:[]
};

function save(){localStorage.setItem("AIAQ_STATE",JSON.stringify(S));}

function log(m){
  const t=new Date().toLocaleTimeString();
  S.logs.push(`[${t}] ${m}`);
  if(S.logs.length>80)S.logs.shift();
  save(); render();
}

function speak(txt){
  document.getElementById("speech").innerText=txt;
  const u=new SpeechSynthesisUtterance(txt);
  u.rate=0.95; u.pitch=1;
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}

async function rss(){
  const r=await fetch(PROXY);
  const j=await r.json();
  const a=j.items[Math.floor(Math.random()*j.items.length)];
  let msg=a.title+" — "+a.summary;
  S.timeline.push(a.title);
  log("Article lu");
  speak(msg);
}

function think(){
  S.score=Math.min(100,Math.max(0,S.score+(Math.random()*2-1)+S.bias));
  document.getElementById("status").innerText="Score "+S.score.toFixed(1);
}

function thumb(v){
  S.bias+=v*0.1;
  log(v>0?"Feedback positif":"Feedback négatif");
}

async function analyze(){
  const t=document.getElementById("token").value;
  let msg="Bitcoin autour de 60k$, Solana vers 140$. ";
  msg+="Conseils: gérer le risque, surveiller volume, éviter FOMO.";
  log("Analyse crypto");
  speak(msg);
}

function render(){
  document.getElementById("logs").innerText=S.logs.join("\n");
  document.getElementById("timeline").innerHTML=S.timeline.slice(-10).map(x=>"• "+x).join("<br>");
}

setInterval(()=>{think(); rss();},15000);
render();

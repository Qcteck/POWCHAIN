set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.wolv_clean_$(date +%s)"

python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# 1) Supprimer TOUT ce qui touche à wolverine (locations + markers + vieux blocs)
patterns = [
  r'\n\s*###\s*===\s*WOLVERINE[\s\S]*?###\s*===\s*END\s*WOLVERINE\s*===\s*',
  r'\n\s*#\s*---\s*WOLVERINE_BLOCK_[A-Z0-9_]+.*?\n',  # markers
  r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*/wolverine/api/\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*=\s*/wolverine/traderone/api/health\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/traderone/api/\s*\{[\s\S]*?\n\s*\}\s*',
]
for pat in patterns:
  s = re.sub(pat, "\n", s, flags=re.M)

# 2) Injecter un bloc UNIQUE et bien fermé (UI + health public + api protégé)
block = r'''
# --- WOLVERINE_FINAL (clean) ---

# UI: https://fireinners.online/wolverine
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/ {
  # ton front est déjà servi par: root /opt/fireinners/frontend-react/app/dist;
  # donc on reste dans ce root-là (pas /var/www)
  try_files $uri $uri/ /wolverine/index.html;
}

# PUBLIC: /health (no key)
location = /wolverine/traderone/api/health {
  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;

  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}

# PROTECTED: everything else under /wolverine/traderone/api/
location ^~ /wolverine/traderone/api/ {
  if ($http_x_api_key = "") { return 403; }

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;

  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
'''

# insère juste avant la dernière "}" du server block
idx = s.rfind("}")
if idx == -1:
  raise SystemExit("KO: pas trouvé de '}' final dans le fichier nginx")
s = s[:idx] + "\n" + block + "\n" + s[idx:]
ng.write_text(s)
print("OK: wolverine cleaned + final block injected")
PY

nginx -t
systemctl reload nginx

echo "=== TESTS ==="
curl -sS -I https://fireinners.online/wolverine/ | head -n 10
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12
curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes | head -n 8
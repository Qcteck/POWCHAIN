cat >/root/WOLVERINE_FIX_ADDRESS_HTML.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
BACKUP="$HTML.addrfix_$(date +%Y%m%d_%H%M%S)"

cp "$HTML" "$BACKUP"
echo "[OK] Backup: $BACKUP"

# Remplacer la ligne Address statique par un span dynamique
perl -0777 -i -pe '
s/Address:\s*[^<\n]+/Address: <span id="address">-<\/span>/i;
' "$HTML"

echo "DONE — ADDRESS FIXED"
BASH

chmod +x /root/WOLVERINE_FIX_ADDRESS_HTML.sh
/root/WOLVERINE_FIX_ADDRESS_HTML.sh
set -euo pipefail

TEST="/var/www/fireinners-test"
ULT="$TEST/ultimate"
mkdir -p "$ULT"

echo "=== 1) Trouver le dernier backup d'images ==="
BACK="$(ls -dt /var/www/fireinners-test-backup-* 2>/dev/null | head -n 1 || true)"
echo "BACK=$BACK"
[ -n "$BACK" ] || { echo "❌ Aucun dossier backup trouvé (/var/www/fireinners-test-backup-*)"; exit 1; }

echo "=== 2) Compter les images dans le backup ==="
COUNT="$(find "$BACK" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) | wc -l)"
echo "Images dans backup: $COUNT"
[ "$COUNT" -gt 0 ] || { echo "❌ 0 image dans $BACK"; exit 1; }

echo "=== 3) Installer ImageMagick ==="
apt-get update -y
apt-get install -y imagemagick

echo "=== 4) Resize 4K + fusion MEDIAN (best-of) ==="
TMP="/tmp/blend_work"
rm -rf "$TMP"
mkdir -p "$TMP"

i=0
while IFS= read -r f; do
  i=$((i+1))
  printf -v out "$TMP/img_%04d.png" "$i"
  convert "$f" -auto-orient -resize 3840x2160^ -gravity center -extent 3840x2160 "$out"
done < <(find "$BACK" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) -print | sort)

convert "$TMP"/img_*.png -evaluate-sequence median "$ULT/blend_305_4k.png"
rm -rf "$TMP"

echo "=== 5) Permissions + petit index ==="
chown -R www-data:www-data "$ULT" || true
chmod -R a+rX "$ULT" || true

cat > "$ULT/index.html" <<'HTML'
<!doctype html><meta charset="utf-8">
<title>ultimate</title>
<ul>
  <li><a href="blend_305_4k.png">blend_305_4k.png</a></li>
</ul>
<img src="blend_305_4k.png" style="max-width:100%;height:auto">
HTML

echo "=== 6) Vérif fichier ==="
ls -lah "$ULT/blend_305_4k.png" "$ULT/index.html"

echo "=== 7) Test local (comme l'extérieur) ==="
curl -I https://127.0.0.1/test/ultimate/blend_305_4k.png --insecure -H "Host: fireinners.online" | head -n 20 || true

echo "✅ OK: https://fireinners.online/test/ultimate/blend_305_4k.png"
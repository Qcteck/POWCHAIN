sudo -i
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/wolv_rpc_proxy.conf"
TS="$(date +%s)"
DUMP="/tmp/nginxT.$TS.txt"

# (si le snippet existe déjà, pas grave)
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'EOF'
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  add_header X-Wolv-RPC "1" always;

  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF

echo "== Dump nginx -T =="
nginx -T > "$DUMP" 2>&1

echo "== Find vhost 443 for $DOMAIN =="
TARGET="$(python3 - <<'PY'
import re, sys
p=sys.argv[1]
lines=open(p,'r',errors='ignore').read().splitlines()
cur=None
i=0
while i<len(lines):
    m=re.match(r'^# configuration file (.+):$', lines[i])
    if m: cur=m.group(1).strip()
    if re.match(r'^\s*server\s*\{', lines[i]):
        br=0; j=i; block=[]
        while j<len(lines):
            l=lines[j]
            br += l.count('{') - l.count('}')
            block.append(l)
            if br==0 and j>i: break
            j+=1
        txt="\n".join(block)
        if ("listen 443" in txt or re.search(r'listen\s+443', txt)) and ("server_name" in txt) and ("fireinners.online" in txt):
            print(cur or "")
            sys.exit(0)
        i=j
    i+=1
print("")
PY
"$DUMP")"

echo "TARGET=$TARGET"
[ -n "${TARGET:-}" ] || { echo "ERR: server 443 pour $DOMAIN introuvable"; exit 1; }

echo "== Inject include snippet if missing =="
cp -a "$TARGET" "$TARGET.bak.$TS" || true

python3 - <<'PY'
import re, sys
target=sys.argv[1]
snip='/etc/nginx/snippets/wolv_rpc_proxy.conf'
s=open(target,'r',errors='ignore').read().splitlines(True)

if any('include '+snip in line for line in s):
    print("OK: include déjà présent")
    sys.exit(0)

out=[]
inserted=False
for line in s:
    out.append(line)
    if (not inserted) and ('server_name' in line) and ('fireinners.online' in line):
        out.append("  include /etc/nginx/snippets/wolv_rpc_proxy.conf;\n")
        inserted=True

open(target,'w').write(''.join(out))
print("Injected include into:", target)
PY
"$TARGET"

nginx -t
systemctl reload nginx

echo "== TEST =="
curl -ksS -i "https://$DOMAIN/wolverine/traderone/api/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 80
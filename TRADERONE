bash -lc 'TS="$(date +%Y%m%d_%H%M%S)"; LOG="/root/WOLVERINE_TEST_443_${TS}.log"; exec > >(tee -a "$LOG") 2>&1; echo "=== WOLVERINE_TEST_443 :: $TS ==="; echo "LOG=$LOG"; echo;

echo "== 1) LISTEN ports (80/443/3000) ==";
ss -ltnp | grep -E ":(80|443|3000)\b" || true; echo;

echo "== 2) Backend direct (must be JSON) ==";
curl -sS -i "http://127.0.0.1:3000/health" | head -n 60 || true; echo;

echo "== 3) HTTPS local badge (REAL PROD PATH) ==";
curl -k -sS -i "https://127.0.0.1/wolverine/__wolverine_ok.txt" -H "Host: fireinners.online" | head -n 60 || true; echo;

echo "== 4) HTTPS local API health via nginx (must be JSON, NOT HTML) ==";
curl -k -sS -i "https://127.0.0.1/wolverine/traderone/api/health" -H "Host: fireinners.online" | head -n 80 || true; echo;

echo "== 5) HTTPS local vault create via nginx (must be JSON, NOT 405/HTML) ==";
curl -k -sS -i -X POST "https://127.0.0.1/wolverine/traderone/api/vault/create" -H "Host: fireinners.online" -H "Content-Type: application/json" -d "{\"pub\":\"\"}" | head -n 120 || true; echo;

echo "== 6) External badge (Cloudflare) ==";
curl -k -sS -i "https://fireinners.online/wolverine/__wolverine_ok.txt" | head -n 60 || true; echo;

echo "== 7) External API health (must be JSON) ==";
curl -k -sS -i "https://fireinners.online/wolverine/traderone/api/health" | head -n 80 || true; echo;

echo "== 8) External vault create ==";
curl -k -sS -i -X POST "https://fireinners.online/wolverine/traderone/api/vault/create" -H "Content-Type: application/json" -d "{\"pub\":\"\"}" | head -n 120 || true; echo;

echo "== 9) If any 500, show nginx error tail ==";
tail -n 120 /var/log/nginx/error.log 2>/dev/null || true; echo;

echo "DONE. LOG=$LOG"'
from pathlib import Path
import re, sys

target=Path(sys.argv[1])
s=target.read_text(errors="ignore")
lines=s.splitlines()

def find_server_blocks(lines):
    blocks=[]
    i=0
    while i < len(lines):
        if re.search(r'^\s*server\s*\{', lines[i]):
            a=i
            depth=0
            j=i
            while j < len(lines):
                depth += lines[j].count('{')
                depth -= lines[j].count('}')
                if j>i and depth<=0:
                    b=j
                    blocks.append((a,b))
                    i=b
                    break
                j+=1
        i+=1
    return blocks

blocks=find_server_blocks(lines)

def block_text(a,b): return "\n".join(lines[a:b+1])

target_block=None
for a,b in blocks:
    blk=block_text(a,b)
    if (re.search(r'listen\s+443', blk) or re.search(r'443\s+ssl', blk)) and re.search(r'\bfireinners\.online\b', blk):
        target_block=(a,b)
        break
if target_block is None:
    for a,b in blocks:
        blk=block_text(a,b)
        if (re.search(r'listen\s+443', blk) or re.search(r'443\s+ssl', blk)):
            target_block=(a,b)
            break
if target_block is None:
    raise SystemExit("ERROR: no server 443 block in target file")

a,b=target_block

# remove prior agentia routes/includes INSIDE this server block
new=[]
k=a
while k<=b:
    ln=lines[k]
    drop=False

    if "agentia_routes" in ln and "include" in ln:
        drop=True

    # remove any existing /agentia locations to avoid collisions
    if re.search(r'^\s*location\s*(=|\^~)?\s*/agentia\b', ln):
        drop=True

    if drop:
        if "location" in ln and "{" in ln:
            depth=ln.count("{")-ln.count("}")
            k+=1
            while k<=b and depth>0:
                depth += lines[k].count("{")-lines[k].count("}")
                k+=1
            continue
        k+=1
        continue

    new.append(ln)
    k+=1

# rebuild file with cleaned server block
out = lines[:a] + new + lines[b+1:]

# re-find the same server block start in rebuilt file near original index a
# (best effort: search forward for first "server {" after a-20)
start=None
for i in range(max(0,a-20), min(len(out), a+200)):
    if re.search(r'^\s*server\s*\{', out[i]):
        start=i
        break
if start is None:
    raise SystemExit("ERROR: cannot re-find server block start after rebuild")

# insert forced locations right after server {

cat >/root/fix_duplicate_traderone_api_location.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/traderone_api_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup vhost =="
cp -a "$VHOST" "${VHOST}.bak_${TS}"
echo "Saved: ${VHOST}.bak_${TS}"

echo
echo "== Snippet contains a location{} ? =="
if [[ -f "$SNIP" ]] && grep -qE '^\s*location\s' "$SNIP"; then
  echo "YES: $SNIP has location{} -> remove wrapper location from vhost (keep only include)"

  awk '
    BEGIN{inwrap=0}
    # remove wrapper location for /wolverine/traderone/api/
    /^\s*location\s+\^\~\s+\/wolverine\/traderone\/api\/\s*\{\s*$/ {inwrap=1; print "  # TraderOne API (from snippet)"; print "  include /etc/nginx/snippets/traderone_api_proxy.conf;"; next}
    inwrap && /^\s*\}\s*$/ {inwrap=0; next}
    inwrap {next}
    {print}
  ' "$VHOST" > /tmp/vhost.fixed && mv /tmp/vhost.fixed "$VHOST"

else
  echo "NO (or file missing): snippet has no location{} -> we will dedupe includes only"
fi

echo
echo "== Deduplicate include traderone_api_proxy.conf (keep first only) =="
awk '
  BEGIN{seen=0}
  $0 ~ /include \/etc\/nginx\/snippets\/traderone_api_proxy\.conf;/ {
    if(seen==0){seen=1; print; next}
    next
  }
  {print}
' "$VHOST" > /tmp/vhost.fixed2 && mv /tmp/vhost.fixed2 "$VHOST"

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx

echo "DONE ✅"
BASH

chmod +x /root/fix_duplicate_traderone_api_location.sh
/root/fix_duplicate_traderone_api_location.sh
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
OUT="/root/ARCHIVES_$TS"
mkdir -p "$OUT"

echo "=== 1) Archive /var/www ==="
[ -d /var/www/fireinners ] && tar -czf "$OUT/fireinners_www_$TS.tgz" -C /var/www fireinners
[ -d /var/www/wolverine  ] && tar -czf "$OUT/wolverine_www_$TS.tgz"  -C /var/www wolverine

echo "=== 2) Archive des backups UI (frontend-react) ==="
APPROOT="/opt/fireinners/frontend-react"
if [ -d "$APPROOT" ]; then
  # archive seulement les dossiers qui ressemblent à des backups (évite node_modules)
  find "$APPROOT" -maxdepth 3 -type d -name "app*" -print0 2>/dev/null \
  | while IFS= read -r -d '' d; do
      base="$(basename "$d")"
      echo "ARCHIVE: $d"
      tar --exclude='node_modules' -czf "$OUT/${base}_$TS.tgz" -C "$(dirname "$d")" "$base"
    done
fi

echo "=== 3) Liste des archives ==="
ls -lah "$OUT"
echo
echo "OK -> $OUT"
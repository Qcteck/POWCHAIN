#!/usr/bin/env bash
# MEGA BATCH ROOT — FIX NGINX + SSL + WOLVERINE (SAFE / ONE-SHOT)
set -euo pipefail

echo "=== MEGA FIX FIREINNERS / WOLVERINE (ROOT) ==="

# ---- VARS FIXES ----
DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SITES_EN="/etc/nginx/sites-enabled"
CERT="/etc/letsencrypt/live/${DOMAIN}/fullchain.pem"
KEY="/etc/letsencrypt/live/${DOMAIN}/privkey.pem"
ROOT_FRONT="/opt/fireinners/frontend-react/app/dist"
BACKUP_DIR="/root/nginx_backup_$(date +%Y%m%d_%H%M%S)"

# ---- ROOT CHECK ----
[ "$EUID" -eq 0 ] || { echo "MUST BE ROOT"; exit 1; }

# ---- BACKUP ----
mkdir -p "$BACKUP_DIR"
cp -a /etc/nginx "$BACKUP_DIR/"
echo "Backup done: $BACKUP_DIR"

# ---- SSL CHECK / FIX ----
if [ ! -f "$CERT" ] || [ ! -f "$KEY" ]; then
  certbot certonly --nginx -d "$DOMAIN" -d "www.$DOMAIN" --non-interactive --agree-tos -m admin@"$DOMAIN"
fi

# ---- CLEAN ENABLED ----
rm -f ${SITES_EN}/*
ln -sf "$VHOST" "${SITES_EN}/fireinners.online-ssl"

# ---- REWRITE VHOST CLEAN ----
cat > "$VHOST" <<EOF
server {
  listen 443 ssl http2;
  server_name $DOMAIN www.$DOMAIN;

  ssl_certificate     $CERT;
  ssl_certificate_key $KEY;
  ssl_protocols TLSv1.2 TLSv1.3;

  root $ROOT_FRONT;
  index index.html;

  location / {
    try_files \$uri \$uri/ /index.html;
  }

  location /wolverine/ {
    try_files \$uri \$uri/ /wolverine/index.html;
  }

  location /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade \$http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host \$host;
  }
}
EOF

# ---- TEST + START ----
nginx -t
systemctl enable nginx
systemctl restart nginx

# ---- FINAL STATUS ----
systemctl status nginx --no-pager

echo "=== DONE ==="
echo "OPEN: https://fireinners.online/wolverine/"
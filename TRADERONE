bash <<'EOF'
set -e
echo "=== WOLVERINE • BATCH #2 PHANTOM + BALANCES ==="

WOLV="/opt/fireinners/wolverine"

cd "$WOLV"

echo "[1/6] Install Phantom wallet-adapter"
npm install \
  @solana/web3.js \
  @solana/wallet-adapter-base \
  @solana/wallet-adapter-react \
  @solana/wallet-adapter-react-ui \
  @solana/wallet-adapter-wallets \
  >/dev/null

echo "[2/6] Wallet Provider"
cat > src/components/WalletProvider.jsx <<'JSX'
import { ConnectionProvider, WalletProvider } from '@solana/wallet-adapter-react'
import { PhantomWalletAdapter } from '@solana/wallet-adapter-wallets'
import { WalletModalProvider } from '@solana/wallet-adapter-react-ui'

export default function WalletWrap({children}){
  const wallets = [new PhantomWalletAdapter()]
  return (
    <ConnectionProvider endpoint="https://api.mainnet-beta.solana.com">
      <WalletProvider wallets={wallets} autoConnect>
        <WalletModalProvider>{children}</WalletModalProvider>
      </WalletProvider>
    </ConnectionProvider>
  )
}
JSX

echo "[3/6] Wallet UI Component"
cat > src/components/WalletBox.jsx <<'JSX'
import { useWallet } from '@solana/wallet-adapter-react'
import { WalletMultiButton } from '@solana/wallet-adapter-react-ui'
import { useEffect, useState } from 'react'

export default function WalletBox(){
  const { publicKey } = useWallet()
  const [sol,setSol]=useState('—')
  const [usdc,setUsdc]=useState('—')

  useEffect(()=>{
    if(!publicKey) return
    fetch('/wolverine/traderone/api/balances?pub='+publicKey.toString())
      .then(r=>r.json())
      .then(b=>{
        setSol(b.sol.toFixed(4))
        setUsdc(b.usdc.toFixed(2))
      })
  },[publicKey])

  return (
    <div className="panel">
      <h3>Wallet</h3>
      <WalletMultiButton />
      <div>Address: {publicKey?.toString() || '—'}</div>
      <div>SOL: {sol}</div>
      <div>USDC: {usdc}</div>
    </div>
  )
}
JSX

echo "[4/6] Inject Wallet into App"
sed -i '1i import WalletWrap from "./components/WalletProvider"' src/App.jsx
sed -i 's/return (/return (<WalletWrap>/' src/App.jsx
sed -i 's/);$/<\/WalletWrap>);/' src/App.jsx

sed -i '1i import WalletBox from "../components/WalletBox"' src/pages/Dashboard.jsx
sed -i 's/<div className="panel">News \/ Overview<\/div>/<WalletBox \/>/' src/pages/Dashboard.jsx

echo "[5/6] Wallet UI CSS"
sed -i '1i @import "@solana/wallet-adapter-react-ui/styles.css";' src/style.css

echo "[6/6] Build + perms"
npx vite build >/dev/null
chown -R www-data:www-data "$WOLV"

echo "=== PHANTOM OK ==="
echo "Reload /wolverine/ dans Phantom (iOS) ou desktop"
EOF
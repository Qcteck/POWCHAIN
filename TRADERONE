cat >/root/add_phantom_button.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   /root/add_phantom_button.sh /chemin/du/repo
# ou:
#   /root/add_phantom_button.sh   (auto-detect)

find_repo() {
  for d in /var/www /opt /srv /home; do
    [[ -d "$d" ]] || continue
    # cherche un repo Next (package.json + next)
    hit="$(grep -RIl --max-count=1 '"next"' "$d"/*/package.json 2>/dev/null | head -n 1 || true)"
    if [[ -n "$hit" ]]; then
      dirname "$hit"
      return 0
    fi
  done
  return 1
}

REPO="${1:-}"
if [[ -z "$REPO" ]]; then
  REPO="$(find_repo || true)"
fi

if [[ -z "$REPO" || ! -d "$REPO" ]]; then
  echo "[ERR] Repo introuvable. Relance avec le chemin:"
  echo "      /root/add_phantom_button.sh /chemin/du/projet"
  exit 1
fi

cd "$REPO"
echo "[*] Repo: $(pwd)"

IS_APP=0
IS_PAGES=0
[[ -d "app" ]] && IS_APP=1
[[ -d "pages" ]] && IS_PAGES=1

if [[ "$IS_APP" -eq 0 && "$IS_PAGES" -eq 0 ]]; then
  echo "[ERR] Je ne vois ni app/ ni pages/ ici."
  exit 1
fi

if [[ "$IS_APP" -eq 1 ]]; then
  mkdir -p app/components
  TARGET="app/components/ConnectPhantomBtn.jsx"
  cat >"$TARGET" <<'JSX'
"use client";
import { useEffect, useState } from "react";

export default function ConnectPhantomBtn() {
  const [pk, setPk] = useState(null);
  const [err, setErr] = useState("");

  useEffect(() => {
    const sol = typeof window !== "undefined" ? window.solana : null;
    if (sol?.isPhantom && sol.publicKey) setPk(sol.publicKey.toBase58());
    sol?.on?.("accountChanged", (pubkey) => setPk(pubkey ? pubkey.toBase58() : null));
    return () => sol?.removeAllListeners?.("accountChanged");
  }, []);

  async function connect() {
    setErr("");
    try {
      const sol = window.solana;
      if (!sol?.isPhantom) throw new Error("Phantom introuvable");
      const resp = await sol.connect();
      setPk(resp.publicKey.toBase58());
    } catch (e) {
      console.error(e);
      setErr(String(e?.message || e));
    }
  }

  async function disconnect() {
    try { await window.solana?.disconnect?.(); } finally { setPk(null); }
  }

  return (
    <div>
      {!pk ? (
        <button className="btn ghost" onClick={connect}>Connect Phantom</button>
      ) : (
        <button className="btn ghost" onClick={disconnect}>
          {pk.slice(0, 4)}…{pk.slice(-4)} (disconnect)
        </button>
      )}
      {err && <div style={{ marginTop: 8, color: "tomato" }}>{err}</div>}
    </div>
  );
}
JSX

  echo "[OK] Created: $TARGET"
  echo '👉 Import:  import ConnectPhantomBtn from "@/app/components/ConnectPhantomBtn";'
  echo '   Usage:   <ConnectPhantomBtn />'
else
  mkdir -p components
  TARGET="components/ConnectPhantomBtn.jsx"

bash <<'EOF'
set -e

CONF="/etc/nginx/sites-available/fireinners.online-ssl"
BAK="$CONF.bak.$(date +%s)"

echo "[1/4] Backup nginx"
cp "$CONF" "$BAK"

echo "[2/4] Inject /wolverine redirect (if missing)"
grep -q "location = /wolverine" "$CONF" || sed -i '/server_name/a \
\n    location = /wolverine {\n        return 301 /wolverine/;\n    }\n' "$CONF"

echo "[3/4] nginx test"
nginx -t

echo "[4/4] reload nginx"
systemctl reload nginx

echo "DONE ✔ /wolverine normalized"
echo "URL : https://www.fireinners.online/wolverine"
EOF
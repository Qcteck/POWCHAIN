set -euo pipefail

UI="/var/www/wolverine"
SRC="$UI/_index_versions/v0031.html"
DST="$UI/index.html"

# sécurité : vérifie que la version existe
[ -f "$SRC" ] || { echo "❌ introuvable: $SRC"; exit 1; }

# backup de l’actuel
cp -a "$DST" "$DST.bak.$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true

# remet la version choisie
cp -a "$SRC" "$DST"

# droits corrects
chown www-data:www-data "$DST" 2>/dev/null || true
chmod 644 "$DST"

# reload nginx
nginx -t && systemctl reload nginx

echo "✅ v0031.html est maintenant en production comme index.html"
echo "→ https://fireinners.online/wolverine/"
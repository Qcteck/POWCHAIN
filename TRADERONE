cat >/root/DIAG_FIX_AGENTIA_9697.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

WOLV_HTML="/var/www/wolverine/index.html"
NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
sha(){ [ -f "$1" ] && sha256sum "$1" | awk '{print $1}' || echo "MISSING"; }
BEF_W="$(sha "$WOLV_HTML")"
BEF_N="$(sha "$NGX_SITE")"

SVC="agentia.service"
PORT="9697"

[ "$(id -u)" -eq 0 ] || { echo "ERROR: run as root"; exit 1; }

echo "== BEFORE hashes =="
echo "wolverine index: $BEF_W  $WOLV_HTML"
echo "nginx vhost    : $BEF_N  $NGX_SITE"

echo "== WHO LISTENS on :$PORT (before) =="
ss -ltnp 2>/dev/null | grep ":$PORT" || true

echo "== Stop AgentIA =="
systemctl stop "$SVC" || true
sleep 1

echo "== WHO LISTENS on :$PORT (after stop) =="
ss -ltnp 2>/dev/null | grep ":$PORT" || true

echo "== Kill anything holding :$PORT =="
PIDS="$(ss -ltnp 2>/dev/null | awk -v p=":$PORT" '$4 ~ p {print $0}' | sed -n 's/.*pid=\([0-9]\+\).*/\1/p' | sort -u | tr '\n' ' ')"
if [ -n "${PIDS:-}" ]; then
  echo "PIDS: $PIDS"
  kill $PIDS 2>/dev/null || true
  sleep 1
  kill -9 $PIDS 2>/dev/null || true
fi

echo "== Kill leftover AgentIA node (path match) =="
pkill -f "/opt/agentia/server\.js" 2>/dev/null || true
sleep 1

echo "== WHO LISTENS on :$PORT (after kill) =="
ss -ltnp 2>/dev/null | grep ":$PORT" || true

echo "== Start AgentIA =="
systemctl daemon-reload
systemctl start "$SVC"
sleep 1

echo "== Status top =="
systemctl --no-pager --full status "$SVC" | sed -n '1,28p' || true

echo "== Local health =="
curl -fsS "http://127.0.0.1:${PORT}/agentia/health" | head -c 500; echo

echo "== Public health =="
curl -kfsS "https://fireinners.online/agentia/health" | head -c 500; echo

echo "== AFTER hashes (must match) =="
AFT_W="$(sha "$WOLV_HTML")"
AFT_N="$(sha "$NGX_SITE")"
echo "wolverine index: $AFT_W  $WOLV_HTML"
echo "nginx vhost    : $AFT_N  $NGX_SITE"
[ "$BEF_W" = "$AFT_W" ] || { echo "ERROR: Wolverine index changed (should not)."; exit 1; }
[ "$BEF_N" = "$AFT_N" ] || { echo "ERROR: Nginx vhost changed (should not)."; exit 1; }

echo "OK: AgentIA up; Wolverine untouched."
BASH

bash /root/DIAG_FIX_AGENTIA_9697.sh
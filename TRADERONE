cat >/root/FIX_WOLVERINE_DUPLICATE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WOLVERINE_DUP_$TS"
mkdir -p "$BK"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
CANON="$INC_DIR/wolverine.inc"

say "Backup vhost + includes..."
cp -a "$NGX_VHOST" "$BK/" 2>/dev/null || true
cp -a "$INC_DIR" "$BK/includes" 2>/dev/null || true

say "Unfreeze (chattr -i) on target files if needed..."
chattr -i "$NGX_VHOST" 2>/dev/null || true
for f in "$INC_DIR"/wolverine*.inc; do chattr -i "$f" 2>/dev/null || true; done

say "Neutralize ALL wolverine*.inc except wolverine.inc (this kills duplicates like wolverine_static.inc)..."
for f in "$INC_DIR"/wolverine*.inc; do
  [ -e "$f" ] || continue
  if [ "$f" != "$CANON" ]; then
    cp -a "$f" "$BK/$(basename "$f").bak" 2>/dev/null || true
    cat >"$f" <<'NGINX'
# DISABLED_BY_FIX_WOLVERINE_DUPLICATE
# (file kept to avoid missing-include errors)
NGINX
  fi
done

say "Rewrite CANONICAL include (single source of truth)..."
mkdir -p "$INC_DIR"
cat >"$CANON" <<'NGINX'
# WOLVERINE_CANONICAL_V3
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
    alias /var/www/wolverine/;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store" always;
}
NGINX
chmod 0644 "$CANON" || true

say "Force vhost to include ONLY canonical include (remove other wolverine includes if any)..."
# remove any include line that mentions wolverine AND is not the canonical include
sed -i '\|include .*wolverine.*;|{/include \/etc\/nginx\/includes\/wolverine\.inc;/!d;}' "$NGX_VHOST" || true

# ensure canonical include exists once
if ! grep -q "include /etc/nginx/includes/wolverine.inc;" "$NGX_VHOST" 2>/dev/null; then
  awk 'BEGIN{done=0}{print} /server\s*\{/ && done==0 {print "    include /etc/nginx/includes/wolverine.inc;"; done=1}' \
    "$NGX_VHOST" >"$BK/vhost.new"
  cp -a "$BK/vhost.new" "$NGX_VHOST"
  rm -f "$BK/vhost.new"
fi

say "Refreeze (chattr +i) vhost..."
chattr +i "$NGX_VHOST" 2>/dev/null || true

say "Reload nginx..."
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
nginx -t
systemctl reload nginx
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true

say "DONE. Canonical route is live: /wolverine -> /wolverine/ (301) and serves /var/www/wolverine/index.html"
say "Backup: $BK"
BASH

chmod +x /root/FIX_WOLVERINE_DUPLICATE.sh
bash /root/FIX_WOLVERINE_DUPLICATE.sh |& tee /root/FIX_WOLVERINE_DUPLICATE.log
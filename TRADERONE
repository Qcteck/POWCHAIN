setup_nginx_basic_auth(){
  say "== nginx (private route + basic auth) =="
  mkdir -p "$NGX_INC_DIR"

  BASIC_USER="dv"
  BASIC_PASS="$(openssl rand -base64 18 | tr -d '\n' | tr '/+' 'Aa')"
  HTPASS="${ETC_DIR}/htpasswd"

  # create htpasswd
  htpasswd -bc "$HTPASS" "$BASIC_USER" "$BASIC_PASS" >/dev/null 2>&1
  chmod 600 "$HTPASS"

  cat > "$NGX_INC_FILE" <<EOF
# ${APP_NAME} include
location /wolverine/${APP_NAME}/ {
  auth_basic "Private";
  auth_basic_user_file ${HTPASS};

  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  rewrite ^/wolverine/${APP_NAME}/(.*)$ /\$1 break;
  proxy_pass http://${HOST}:${PORT};
}
EOF

  if ! grep -qF "${NGX_INC_FILE}" "$NGX_VHOST"; then
    cat >> "$NGX_VHOST" <<EOF

  # include ${APP_NAME}
  include ${NGX_INC_FILE};
EOF
  fi

  nginx -t
  systemctl reload nginx

  say "BASIC AUTH:"
  say "  user: ${BASIC_USER}"
  say "  pass: ${BASIC_PASS}"
  echo "${BASIC_USER}:${BASIC_PASS}" > "${ETC_DIR}/BASIC_AUTH.txt"
  chmod 600 "${ETC_DIR}/BASIC_AUTH.txt"
}


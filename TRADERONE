cat >/root/debug_403_blueprint_mp4.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
URL="/wolverine/blueprint/blueprint_robo600.mp4"
HOST="fireinners.online"

echo "=== 1) ORIGIN vs PUBLIC headers ==="
echo "--- ORIGIN (bypass CF) ---"
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}${URL} | head -n 30 || true
echo
echo "--- PUBLIC (CF) ---"
curl -skI https://${HOST}${URL} | head -n 30 || true
echo

echo "=== 2) Find nginx location handling blueprint/wolverine ==="
nginx -T 2>/dev/null | grep -nE "location|alias|root|wolverine|blueprint" | head -n 260 || true
echo

echo "=== 3) Search file on disk (fast) ==="
FOUND="$(find /var/www /opt /root -maxdepth 8 -type f -name 'blueprint_robo600.mp4' 2>/dev/null | head -n 1 || true)"
echo "FOUND=$FOUND"
if [ -n "${FOUND:-}" ]; then
  echo "--- stat ---"
  stat "$FOUND" || true
  echo "--- ls -lah ---"
  ls -lah "$FOUND" || true
  echo "--- path perms (namei) ---"
  namei -l "$FOUND" || true
else
  echo "❌ File not found in /var/www,/opt,/root (maybe different name or deeper path)"
fi
echo

echo "=== 4) Check nginx user + error logs for this URL ==="
ps aux | grep -E "[n]ginx: master|nginx: worker" | head -n 10 || true
echo
echo "--- error.log (last 120) filtered ---"
grep -RIn "blueprint_robo600\.mp4|/wolverine/blueprint" /var/log/nginx 2>/dev/null | tail -n 120 || true
echo
tail -n 120 /var/log/nginx/error.log 2>/dev/null || true

echo "DONE ✅"
BASH

chmod +x /root/debug_403_blueprint_mp4.sh
/root/debug_403_blueprint_mp4.sh
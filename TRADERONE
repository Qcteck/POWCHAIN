set -euo pipefail
ROOT=/opt/fireinners/frontend-react/app/dist
VHOST_FALLBACK=/etc/nginx/sites-available/fireinners.online-ssl
TS="$(date +%Y%m%d-%H%M%S)"

echo "== unlock nginx =="
chattr -i /etc/nginx/nginx.conf "$VHOST_FALLBACK" 2>/dev/null || true

echo "== find active vhost that contains server_name fireinners.online =="
TARGET="$(nginx -T 2>/dev/null | awk '
/^# configuration file /{f=$4}
/server_name/ && $0 ~ /fireinners\.online/ {print f; exit}
')"
[ -n "${TARGET:-}" ] || TARGET="$VHOST_FALLBACK"
echo "TARGET=$TARGET"

echo "== ensure stats file exists =="
mkdir -p "$ROOT/stats"
cat >"$ROOT/stats/index.json"<<JSON
{"ok":true,"service":"wolfchain-ui","ts":"$(date -u +%FT%TZ)"}
JSON
chmod 755 "$ROOT" "$ROOT/stats" 2>/dev/null || true
chmod 644 "$ROOT/stats/index.json" 2>/dev/null || true

echo "== backup target =="
cp -a "$TARGET" "${TARGET}.bak.${TS}"

echo "== inject forced static stats (absolute alias) in the RIGHT server block(s) =="
perl -0777 -i -pe '
sub inj {
  my $root = $ENV{ROOT};
  return qq(
    # forced static /stats (UI healthcheck)
    location = /stats { return 301 /stats/index.json; }
    location = /stats/index.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        alias $root/stats/index.json;
    }
);
}
my $changed=0;
# inject inside every server { ... } that mentions server_name fireinners.online
s/(server\s*\{)(.*?server_name[^;]*fireinners\.online[^;]*;)/$changed=1, "$1".inj()."$2"/sge;
END { }
' "$TARGET"

echo "== nginx test + reload =="
nginx -t
systemctl reload nginx

echo "== test localhost with Host header (must be 200 + JSON) =="
curl -k -sS -i https://127.0.0.1/stats/index.json -H 'Host: fireinners.online' | sed -n '1,35p'

echo "== re-lock nginx =="
chattr +i /etc/nginx/nginx.conf "$TARGET" 2>/dev/null || true

echo "DONE"
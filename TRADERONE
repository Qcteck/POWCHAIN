grep -qE "^RPC_URL=" "$ENVF" || echo "RPC_URL=https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac" >>"$ENVF"
grep -qE "^USDC_MINT=" "$ENVF" || echo "USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1" >>"$ENVF"
grep -qE "^WSOL_MINT=" "$ENVF" || echo "WSOL_MINT=So11111111111111111111111111111111111111112" >>"$ENVF"
grep -qE "^JUP_BASE=" "$ENVF" || echo "JUP_BASE=https://quote-api.jup.ag" >>"$ENVF"
grep -qE "^SLIPPAGE_BPS=" "$ENVF" || echo "SLIPPAGE_BPS=150" >>"$ENVF"
grep -qE "^ARM_PHRASE=" "$ENVF" || echo "ARM_PHRASE=WOLVERINE" >>"$ENVF"
grep -qE "^MONITOR_URL=" "$ENVF" || echo "MONITOR_URL=https://bbbotrader.paycashnostory.workers.dev/ping" >>"$ENVF"
grep -qE "^MONITOR_SEC=" "$ENVF" || echo "MONITOR_SEC=10" >>"$ENVF"

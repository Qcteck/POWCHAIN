bash -c "$(cat <<'BASH'
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

cp "$HTML" "$HTML.fix_usdc_exec_$TS"

perl -0777 -i -pe '
s@async function connectWallet\(\)\s*\{[\s\S]*?\}@async function connectWallet(){\n const resp=await window.solana.connect();\n pub=new solanaWeb3.PublicKey(resp.publicKey.toString());\n document.getElementById(\"addr\").textContent=pub.toBase58();\n await refreshBalances();\n}@;

s@// === BALANCES ===[\s\S]*?// === END BALANCES ===@// === BALANCES ===\nasync function refreshBalances(){\n const conn=new solanaWeb3.Connection(solanaWeb3.clusterApiUrl(\"mainnet-beta\"),\"confirmed\");\n // SOL\n const lam=await conn.getBalance(pub);\n document.getElementById(\"sol\").textContent=(lam/1e9).toFixed(6);\n // USDC legacy + token-2022\n const USDC=\"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1\";\n const programs=[\n  \"TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA\",\n  \"TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb\"\n ];\n let total=0;\n for(const pid of programs){\n  const accs=await conn.getParsedTokenAccountsByOwner(pub,{programId:new solanaWeb3.PublicKey(pid)});\n  accs.value.forEach(a=>{\n   const i=a.account.data.parsed.info;\n   if(i.mint===USDC){ total+=Number(i.tokenAmount.amount)/10**i.tokenAmount.decimals; }\n  });\n }\n document.getElementById(\"usdc\").textContent=total.toFixed(2);\n}\n// === END BALANCES ===@s
' "$HTML"

echo "OK — balances forced"
echo "HARD REFRESH (CTRL+SHIFT+R)"
BASH
)"
set -euo pipefail

BASE="/var/www/fireinners/wolverine"
HTML="$BASE/index.html"
APPJS="$BASE/app.js"
VENDOR="$BASE/vendor"
TS="$(date +%s)"

BOT="$(systemctl show traderone.service -p Environment --value | tr ' ' '\n' | sed -n 's/^TRADERONE_BOT_WALLET=//p')"
[ -n "${BOT:-}" ] || { echo "ERR: TRADERONE_BOT_WALLET vide"; exit 1; }
echo "BOT=$BOT"

mkdir -p "$VENDOR"
cp -a "$HTML"  "$HTML.bak.$TS"
cp -a "$APPJS" "$APPJS.bak.$TS" 2>/dev/null || true
echo "Backups: $HTML.bak.$TS | $APPJS.bak.$TS"

echo "== 1) Vendor libs local (évite blocage CDN) =="
curl -L -o "$VENDOR/web3.min.js"      https://cdn.jsdelivr.net/npm/@solana/web3.js@1.95.4/lib/index.iife.min.js
curl -L -o "$VENDOR/spl-token.min.js" https://cdn.jsdelivr.net/npm/@solana/spl-token@0.4.8/lib/index.iife.min.js

echo "== 2) Force tAddr dans index.html =="
perl -i -pe 's|(<span id="tAddr">)(.*?)(</span>)|$1'"$BOT"'$3|g' "$HTML"

echo "== 3) Assure scripts (vendor) AVANT app.js + cache-bust =="
# enlève anciennes refs CDN si présentes
perl -i -pe 's#\s*<script[^>]+(unpkg|jsdelivr)\.com/[^>]*@solana[^>]*></script>##gi' "$HTML"
# remplace app.js par app.js?v=TS si déjà présent
perl -i -pe 's/src="\/wolverine\/app\.js(\?v=\d+)?"/src="\/wolverine\/app.js?v='"$TS"'"/g' "$HTML"

# injecte vendor scripts juste avant app.js si pas déjà là
if ! grep -q "/wolverine/vendor/web3.min.js" "$HTML"; then
  perl -0777 -i -pe 's#(<script[^>]+src="\/wolverine\/app\.js\?v=[0-9]+"[^>]*></script>)#  <script src="\/wolverine\/vendor\/web3.min.js"><\/script>\n  <script src="\/wolverine\/vendor\/spl-token.min.js"><\/script>\n  $1#s' "$HTML"
fi

echo "== 4) Ecrit un app.js CLEAN (connect + balances + start=send USDC) =="
cat > "$APPJS" <<'JS'
(function(){
  const $ = (id)=>document.getElementById(id);

  const el = {
    btnConnect: $("btnConnect"),
    btnStart: $("btnStart"),
    btnRefresh: $("btnRefresh"),
    budget: $("budget"),
    afterConnect: $("afterConnect"),
    status: $("statusText") || $("status"),
    uSol: $("uSol"), uUsdc: $("uUsdc"),
    tAddr: $("tAddr"), tSol: $("tSol"), tUsdc: $("tUsdc"),
  };

  function setStatus(t){
    try { if (el.status) el.status.textContent = t; } catch(e){}
    console.log("[STATUS]", t);
  }
  window.setStatus = setStatus;

  function libsOk(){
    return !!(window.solanaWeb3 && window.solanaWeb3.PublicKey && window.splToken);
  }

  function requirePhantom(){
    if (!window.solana || !window.solana.isPhantom) throw new Error("Phantom non détecté");
  }

  function userPubkey(){
    if (!window.pubkey) return null;
    return new window.solanaWeb3.PublicKey(window.pubkey.toString());
  }

  function botPubkey(){
    const s = (el.tAddr?.textContent || "").trim();
    if (!s || s === "—") throw new Error("Adresse BOT manquante");
    return new window.solanaWeb3.PublicKey(s);
  }

  async function conn(){
    // RPC public (ok car backend a déjà cache, mais ici c’est pour TX + confirm)
    return new window.solanaWeb3.Connection("https://api.mainnet-beta.solana.com", "confirmed");
  }

  async function balances2(wallet){
    const r = await fetch(`/wolverine/traderone/api/balances2?wallet=${encodeURIComponent(wallet)}`);
    const txt = await r.text();
    if (!r.ok) throw new Error(`balances2 HTTP ${r.status}: ${txt.slice(0,160)}`);
    return JSON.parse(txt);
  }

  function fmt(n, d){ const x = Number(n||0); return isFinite(x) ? x.toFixed(d) : "0"; }

  window.refreshBoth = async function(){
    try{
      const bot = await balances2(botPubkey().toString());
      const botSol  = Number(bot?.user?.sol  ?? bot?.sol  ?? 0);
      const botUsdc = Number(bot?.user?.usdc ?? bot?.usdc ?? 0);
      if (el.tSol)  el.tSol.textContent  = fmt(botSol, 6);
      if (el.tUsdc) el.tUsdc.textContent = fmt(botUsdc, 4);

      if (window.pubkey) {
        const usr = await balances2(window.pubkey.toString());
        const uSol  = Number(usr?.user?.sol  ?? usr?.sol  ?? 0);
        const uUsdc = Number(usr?.user?.usdc ?? usr?.usdc ?? 0);
        if (el.uSol)  el.uSol.textContent  = fmt(uSol, 6);
        if (el.uUsdc) el.uUsdc.textContent = fmt(uUsdc, 4);
      } else {
        if (el.uSol)  el.uSol.textContent  = "—";
        if (el.uUsdc) el.uUsdc.textContent = "—";
      }

      setStatus("OK");
    } catch(e){
      console.error(e);
      setStatus("ERR " + (e?.message || e));
    }
  };

  async function sendUsdc({fromPk, toPk, amountUsdc}){
    const connection = await conn();

    const USDC_MINT = new window.solanaWeb3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v");
    const DEC = 6;
    const amount = BigInt(Math.round(Number(amountUsdc) * 10**DEC));
    if (amount <= 0n) throw new Error("Budget USDC invalide");

    const fromAta = await window.splToken.getAssociatedTokenAddress(USDC_MINT, fromPk);
    const toAta   = await window.splToken.getAssociatedTokenAddress(USDC_MINT, toPk);

    const ix = [];
    const toInfo = await connection.getAccountInfo(toAta);
    if (!toInfo) {
      ix.push(
        window.splToken.createAssociatedTokenAccountInstruction(
          fromPk, toAta, toPk, USDC_MINT
        )
      );
    }

    ix.push(
      window.splToken.createTransferCheckedInstruction(
        fromAta, USDC_MINT, toAta, fromPk, amount, DEC
      )
    );

    const { blockhash } = await connection.getLatestBlockhash("confirmed");
    const tx = new window.solanaWeb3.Transaction({ recentBlockhash: blockhash, feePayer: fromPk }).add(...ix);

    requirePhantom();
    const sent = await window.solana.signAndSendTransaction(tx);
    const sig = sent?.signature || sent;
    await connection.confirmTransaction(sig, "confirmed");
    return String(sig);
  }

  async function startFlow(){
    try{
      if (!libsOk()) { setStatus("ERR: libs Solana manquantes"); return; }
      requirePhantom();

      if (!window.pubkey) { setStatus("Connecte ton wallet"); return; }
      const b = Number(el.budget?.value);
      if (!isFinite(b) || b <= 0) { setStatus("Budget invalide"); return; }

      const fromPk = userPubkey();
      const toPk   = botPubkey();

      setStatus("Envoi USDC… (popup Phantom)");
      const sig = await sendUsdc({ fromPk, toPk, amountUsdc: b });

      setStatus("USDC envoyé ✅ tx=" + sig.slice(0,8) + "… | start…");

      const r = await fetch("/wolverine/traderone/api/start", {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({ wallet: window.pubkey.toString(), budget: b, fundingSig: sig })
      });

      const txt = await r.text();
      let j=null; try{ j=JSON.parse(txt);}catch(e){}
      if (!r.ok) {
        setStatus("START REFUSÉ ❌ " + (j?.error || txt.slice(0,200)));
        console.log("start refused", r.status, j||txt);
        return;
      }

      setStatus("START OK ✅");
      await window.refreshBoth();
    } catch(e){
      console.error(e);
      setStatus("ERR " + (e?.message || e));
    }
  }

  // Bind UI
  if (el.btnConnect) {
    el.btnConnect.onclick = async () => {
      try{
        if (!libsOk()) { setStatus("ERR: libs Solana manquantes"); return; }
        requirePhantom();
        const r = await window.solana.connect();
        window.pubkey = r.publicKey;
        if (el.afterConnect) el.afterConnect.style.display = "block";
        setStatus("Wallet connectée ✅ " + window.pubkey.toString());
        await window.refreshBoth();
      } catch(e){
        console.error(e);
        setStatus("ERR " + (e?.message || e));
      }
    };
  }

  if (el.btnRefresh) el.btnRefresh.onclick = () => window.refreshBoth();
  if (el.btnStart)   el.btnStart.onclick   = () => startFlow();

  // pas d’auto-refresh agressif (évite RPC spam)
  setTimeout(()=>window.refreshBoth(), 300);

})();
JS

echo "DONE ✅  Fais Ctrl+F5 sur https://fireinners.online/wolverine/"
echo 'Puis Console: window.solanaWeb3?.PublicKey && window.splToken ? "libs OK" : "libs MISSING"'
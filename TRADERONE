cat >/root/fix_traderone_api_proxy_snippet_proxy_pass_not_allowed.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

F="/etc/nginx/snippets/traderone_api_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$F" || { echo "Missing $F"; exit 1; }
cp -a "$F" "$F.bak_$TS"

cat > "$F" <<'NGINX'
# traderone api proxy (VALID: all proxy_pass are inside location blocks)

location = /wolverine/traderone/api/health {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:8585;
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:8585;
}
NGINX

nginx -t
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/fix_traderone_api_proxy_snippet_proxy_pass_not_allowed.sh
/root/fix_traderone_api_proxy_snippet_proxy_pass_not_allowed.sh
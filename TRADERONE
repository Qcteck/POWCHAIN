from pathlib import Path
import re
p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")

vendor_tag = '<script src="/wolverine/vendor/solana-web3.min.js"></script>'
if vendor_tag not in s:
  # insert early in <head>
  s = re.sub(r"<head([^>]*)>", r"<head\1>"+vendor_tag, s, count=1, flags=re.I)

# Inject UI + logic once (idempotent marker)
MARK="<!-- WOLVERINE_VAULT_SOL_UI_v1 -->"
if MARK not in s:
  ui = r'''
<!-- WOLVERINE_VAULT_SOL_UI_v1 -->
<script>
(function(){
  function q(sel){return document.querySelector(sel);}
  function qa(sel){return Array.prototype.slice.call(document.querySelectorAll(sel));}
  function findWalletCard(){
    // best-effort: look for a block that contains "Connect Phantom"
    var nodes = qa("div");
    for(var i=0;i<nodes.length;i++){
      var t = (nodes[i].innerText||"");
      if(t.indexOf("Connect Phantom")>=0 && t.indexOf("Wallet")>=0) return nodes[i];
    }
    return null;
  }
  function ensureVaultUI(){
    var card = findWalletCard();
    if(!card) return;
    if(card.querySelector && card.querySelector("#vaultBudgetSol")) return;

    var box = document.createElement("div");
    box.style.marginTop="10px";
    box.innerHTML =
      '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">'+
      '<label style="font-size:12px;opacity:.85">Budget (SOL)</label>'+
      '<input id="vaultBudgetSol" type="number" min="0" step="0.01" value="0.10" style="width:120px;padding:6px 8px;border:1px solid #bbb;border-radius:6px" />'+
      '<button id="vaultCreateDepositBtn" style="padding:8px 10px;border:1px solid #444;border-radius:6px;cursor:pointer">Créer Vault + Déposer</button>'+
      '</div>'+
      '<div style="margin-top:6px;font-size:12px;opacity:.9"><span style="opacity:.7">Vault:</span> <span id="vaultAddr">-</span></div>';
    card.appendChild(box);
  }

  function getProvider(){ return (window.solana && window.solana.isPhantom) ? window.solana : null; }

  async function withConn(){
    if(!window.solanaWeb3) throw new Error("solanaWeb3 not defined");
    var rpc = (window.WOLVERINE_RPC || "/wolverine/solana-rpc");
    return new window.solanaWeb3.Connection(rpc, "confirmed");
  }

  async function getOrCreateVault(pub){
    var r = await fetch("/wolverine/traderone/api/vault", {
      method:"POST",
      headers:{"content-type":"application/json"},
      body: JSON.stringify({ pub: pub })
    });
    var j = await r.json();
    if(!j || !j.ok || !j.vaultPub) throw new Error((j && j.error) ? j.error : "vault api error");
    var el = document.getElementById("vaultAddr"); if(el) el.textContent = j.vaultPub;
    return j.vaultPub;
  }

  async function depositBudgetSol(){
    var prov = getProvider();
    if(!prov) throw new Error("Phantom not found");
    if(!window.solanaWeb3) throw new Error("solanaWeb3 not defined");

    // ensure connected
    var resp = await prov.connect();
    var pub = (resp && resp.publicKey) ? resp.publicKey.toString() : (prov.publicKey ? prov.publicKey.toString() : "");
    if(!pub) throw new Error("wallet not connected");

    var budgetEl = document.getElementById("vaultBudgetSol");
    var budget = budgetEl ? parseFloat(String(budgetEl.value||"0")) : 0;
    if(!(budget>0)) throw new Error("budget must be > 0");

    var vaultPub = await getOrCreateVault(pub);

    var conn = await withConn();
    var fromPk = new window.solanaWeb3.PublicKey(pub);
    var toPk = new window.solanaWeb3.PublicKey(vaultPub);

    var lamports = Math.floor(budget * window.solanaWeb3.LAMPORTS_PER_SOL);
    if(lamports <= 0) throw new Error("budget too small");

    var bh = await conn.getLatestBlockhash("confirmed");
    var tx = new window.solanaWeb3.Transaction({ feePayer: fromPk, recentBlockhash: bh.blockhash });
    tx.add(window.solanaWeb3.SystemProgram.transfer({ fromPubkey: fromPk, toPubkey: toPk, lamports: lamports }));

    // Phantom popup signature + send
    var sig;
    if (prov.signAndSendTransaction){
      var out = await prov.signAndSendTransaction(tx);
      sig = out && (out.signature || out);
    } else {
      // fallback: signTransaction then sendRawTransaction
      var stx = await prov.signTransaction(tx);
      sig = await conn.sendRawTransaction(stx.serialize(), { skipPreflight:false, maxRetries:3 });
    }

    await conn.confirmTransaction({ signature: sig, blockhash: bh.blockhash, lastValidBlockHeight: bh.lastValidBlockHeight }, "confirmed");
    return sig;
  }

  function bind(){
    ensureVaultUI();
    var btn = document.getElementById("vaultCreateDepositBtn");
    if(btn && !btn.__bound){
      btn.__bound = true;
      btn.addEventListener("click", async function(){
        btn.disabled = true;
        var old = btn.textContent;
        btn.textContent = "Traitement...";
        try{
          var sig = await depositBudgetSol();
          btn.textContent = "OK: " + String(sig).slice(0,12) + "...";
          setTimeout(function(){ btn.textContent = old; btn.disabled = false; }, 2500);
        }catch(e){
          btn.textContent = "ERREUR";
          setTimeout(function(){ btn.textContent = old; btn.disabled = false; }, 1500);
          try{ console.error(e); }catch(_){}
          alert((e && e.message) ? e.message : String(e));
        }
      });
    }
  }

  // try multiple times (Next/static loads async)
  var tries = 0;
  var iv = setInterval(function(){
    tries++;
    try{ bind(); }catch(_){}
    if(tries>40){ clearInterval(iv); }
  }, 250);
})();
</script>
'''
  # inject before </body>

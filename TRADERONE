set -e
echo "== SERVICE =="; systemctl status wolverine-api --no-pager -n 30 || true
echo "== LISTEN =="; ss -ltnp | grep -E ":(3050|9697)\b" || true
echo "== LOCAL API =="; curl -sS -i http://127.0.0.1:3050/health || true
echo "== PUBLIC API =="; curl -sS -i https://fireinners.online/wolverine/api/health || true
echo "== PING =="; curl -sS -i https://fireinners.online/wolverine/api/ping || true
echo "== CONFIG =="; curl -sS -i https://fireinners.online/wolverine/api/config || true
echo "== NGINX ERR (last) =="; tail -n 60 /var/log/nginx/error.log || true
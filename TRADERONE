cat > /root/WOLVERINE_FIX_USER_PUB_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

echo "=== WOLVERINE FIX USER_PUB FINAL ==="

echo "[1/5] Vérification fichier"
[ -f "$HTML" ] || { echo "ERREUR: index.html introuvable"; exit 1; }

echo "[2/5] Backup"
cp -a "$HTML" "$HTML.bak_userpub_$TS"

echo "[3/5] Injection assignation USER_PUB après connect Phantom"
sed -i '/const accs = await window.solana.connect/ a \
window.USER_PUB = accs.publicKey.toString();\n\
if(typeof refreshUSDC === "function") refreshUSDC();' "$HTML"

echo "[4/5] Sécurité fallback si connect existe déjà"
sed -i '/async function connect(/,/}/ s/}$/  if(window.solana?.publicKey){window.USER_PUB=window.solana.publicKey.toString();refreshUSDC();}\n}/' "$HTML" || true

echo "[5/5] Reload nginx + purge cache serveur"
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx

echo
echo "=== FIX FINAL TERMINE ==="
echo "ACTION:"
echo "- CTRL + SHIFT + R"
echo "- Cliquer Connect Wallet"
echo "- USDC DOIT S'AFFICHER"
echo "Backup: $HTML.bak_userpub_$TS"
BASH

chmod +x /root/WOLVERINE_FIX_USER_PUB_FINAL.sh
/root/WOLVERINE_FIX_USER_PUB_FINAL.sh
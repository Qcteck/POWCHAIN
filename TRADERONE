cat >/root/WOLVERINE_JS_CONNECT_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

echo "== Backup index.html =="
cp "$HTML" "$HTML.bak_$TS"

echo "== Inject connectWC() if missing =="

grep -q "function connectWC" "$HTML" || sed -i '
/<script>/a \
\n// WalletConnect / Rainbow fallback\nasync function connectWC(){\
 if(!window.WalletConnectEthereumProvider){alert("WalletConnect lib not loaded");return;}\
 const provider=await window.WalletConnectEthereumProvider.init({\
  projectId:"demo",\
  chains:[1],\
  showQrModal:true\
 });\
 await provider.enable();\
 alert("WalletConnect / Rainbow connected");\
}\n
' "$HTML"

echo "== Inject connect() Phantom if missing =="

grep -q "function connect()" "$HTML" || sed -i '
/<script>/a \
\nasync function connect(){\
 if(!window.solana){alert("Install Phantom");return;}\
 const r=await solana.connect();\
 document.getElementById("addr").innerText=r.publicKey.toString();\
}\n
' "$HTML"

echo "=============================="
echo "✅ JS FIX APPLIED"
echo "Backup : $HTML.bak_$TS"
echo "Now reload browser (CTRL+SHIFT+R)"
echo "=============================="
BASH

chmod +x /root/WOLVERINE_JS_CONNECT_FIX.sh
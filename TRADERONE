cat >/root/MEGA_WOLVERINE_RUN.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
FRONT_DIR="/var/www/wolverine"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_INC_DIR="/etc/nginx/includes"
NGINX_INC="${NGINX_INC_DIR}/wolverine_routes.inc"
PORT="3000"
OUT="/root/MEGA_WOLVERINE_RUN_${TS}.log"
say(){ printf "\n== %s ==\n" "$*"; }
w(){ printf "%s\n" "$*" | tee -a "$OUT" >/dev/null; }
ok(){ w "OK: $*"; }
warn(){ w "WARN: $*"; }
die(){ w "ERREUR: $*"; exit 1; }
ensure_pkg(){ local p="$1"; dpkg -s "$p" >/dev/null 2>&1 || { apt-get update -y; apt-get install -y "$p"; }; }
http_code_local(){ local path="$1"; curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1${path}" -H "Host: ${HOST}" || true; }
http_code_ext(){ local path="$1"; curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}${path}" || true; }

echo "# MEGA_WOLVERINE_RUN ${TS}" >"$OUT"
w "host=${HOST}"
w "date=$(date -Is)"
w "hostname=$(hostname)"

say "1) Réparer état APT/dpkg (1 passe)"
export DEBIAN_FRONTEND=noninteractive
(apt-mark showhold || true) | tee -a "$OUT" >/dev/null
(dpkg -C || true) | tee -a "$OUT" >/dev/null
(dpkg --configure -a 2>&1 || true) | tee -a "$OUT" >/dev/null
(apt-get -f install -y 2>&1 || true) | tee -a "$OUT" >/dev/null

say "2) Purge npm Ubuntu (cause deps)"
if dpkg -s npm >/dev/null 2>&1; then
  (apt-get purge -y npm 2>&1 || true) | tee -a "$OUT" >/dev/null
fi
(apt-get autoremove -y 2>&1 || true) | tee -a "$OUT" >/dev/null
ok "APT nettoyé"

say "3) Node+npm via NodeSource (nodejs) uniquement"
ensure_pkg curl
ensure_pkg ca-certificates
if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt-get install -y nodejs
fi
ok "node=$(node -v 2>/dev/null || true) npm=$(npm -v 2>/dev/null || true)"

say "4) Nginx + routes /wolverine"
ensure_pkg nginx
mkdir -p "$NGINX_INC_DIR"
[[ -f "$NGINX_SITE" ]] || die "Vhost nginx introuvable: $NGINX_SITE"

cat >"$NGINX_INC" <<EOF
# /etc/nginx/includes/wolverine_routes.inc
location ^~ /wolverine/ {
  alias ${FRONT_DIR}/;
  try_files \$uri \$uri/ /index.html;
  add_header Cache-Control "no-store" always;
}
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Connection "";
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;
  proxy_pass http://127.0.0.1:${PORT}/;
}
EOF
ok "Include écrit: $NGINX_INC"

if ! grep -q "includes/wolverine_routes\.inc" "$NGINX_SITE"; then
  cp -a "$NGINX_SITE" "${NGINX_SITE}.bak_${TS}"
  awk 'BEGIN{done=0}{print}!done&&$0~/server[ \t]*\{/{print "  include /etc/nginx/includes/wolverine_routes.inc;";done=1}' \
    "${NGINX_SITE}.bak_${TS}" >"$NGINX_SITE"
  ok "Include ajouté dans vhost"
else
  ok "Include déjà présent dans vhost"
fi

if [[ -d "$FRONT_DIR" ]]; then
  chmod 755 "$FRONT_DIR" || true
  [[ -f "${FRONT_DIR}/index.html" ]] && chmod 644 "${FRONT_DIR}/index.html" || true
  ok "Permissions front OK"
else
  warn "Frontend dir absent: $FRONT_DIR"
fi

say "5) nginx -t + reload"
(nginx -t 2>&1 || true) | tee -a "$OUT" >/dev/null
nginx -t >/dev/null 2>&1 || die "nginx -t FAIL. Backup: ${NGINX_SITE}.bak_${TS}"
systemctl enable --now nginx >/dev/null 2>&1 || true
systemctl reload nginx
ok "nginx reload OK"

say "6) Probes (LOCAL 443 + EXT)"
w "LOCAL  /wolverine/                => $(http_code_local "/wolverine/")"
w "LOCAL  /wolverine/traderone/api/  => $(http_code_local "/wolverine/traderone/api/")"
w "EXT    /wolverine/                => $(http_code_ext "/wolverine/")"
w "EXT    /wolverine/traderone/api/  => $(http_code_ext "/wolverine/traderone/api/")"

say "DONE"
w "LOG=$OUT"
echo "$OUT"
BASH
chmod +x /root/MEGA_WOLVERINE_RUN.sh
nohup /root/MEGA_WOLVERINE_RUN.sh >/root/MEGA_WOLVERINE_RUN.nohup 2>&1 </dev/null & disown
echo "Lancé. Pour voir le résultat: tail -n 120 /root/MEGA_WOLVERINE_RUN.nohup && ls -1t /root/MEGA_WOLVERINE_RUN_*.log | head -n 1"
cat >/tmp/WOLVERINE_FLY.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== WOLVERINE FLY (READ-ONLY) ==="
date;hostname;whoami;pwd
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
echo "--- files ---"
ls -la "$VHOST" || true
echo "--- lsattr (nginx lock?) ---"
command -v lsattr >/dev/null && lsattr /etc/nginx/nginx.conf "$VHOST" 2>/dev/null || true
echo "--- node ---"
command -v node >/dev/null && node -v || echo "node missing"
echo "--- systemd wolverine-api ---"
systemctl status wolverine-api --no-pager 2>/dev/null || echo "wolverine-api service: not found"
echo "--- listening 3050 ---"
ss -lntp 2>/dev/null | grep -E '(:3050\b)' || echo "nothing on :3050"
echo "--- nginx has /wolverine/api/ ? ---"
grep -n "location /wolverine/api/" "$VHOST" 2>/dev/null || echo "no location /wolverine/api/ in vhost"
echo "--- curl local api (if exists) ---"
curl -sS -m 3 http://127.0.0.1:3050/ping 2>/dev/null || echo "local api: no"
echo "--- curl via nginx (server-side) ---"
curl -sS -m 5 -H "Host: fireinners.online" http://127.0.0.1/wolverine/api/ping 2>/dev/null || echo "nginx route: no"
echo "=== END FLY ==="
SH
bash /tmp/WOLVERINE_FLY.sh








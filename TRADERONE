set -euo pipefail
apt-get update -y && apt-get install -y git openssh-client

KEY="/root/.ssh/id_ed25519_wolverine"
mkdir -p /root/.ssh && chmod 700 /root/.ssh

[ -f "$KEY" ] || ssh-keygen -t ed25519 -N "" -f "$KEY" -C "wolverine-vps"
ssh-keyscan -H github.com >> /root/.ssh/known_hosts 2>/dev/null || true
chmod 600 /root/.ssh/known_hosts

echo "=== ADD THIS AS A DEPLOY KEY IN GitHub (repo -> Settings -> Deploy keys) ==="
cat "${KEY}.pub"
echo "=== END ==="

echo "After adding key, run:"
echo "GIT_SSH_COMMAND='ssh -i $KEY -o IdentitiesOnly=yes' git clone git@github.com:Qcteck/WOLVERINE.git /opt/fireinners/WOLVERINE_REPO"
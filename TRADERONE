set -euo pipefail

OUT="/root/nginx_conflicts"
mkdir -p "$OUT"

echo "=== 1) Fichiers qui déclarent fireinners.online ==="
FILES="$(nginx -T 2>/dev/null | awk '
  /^# configuration file / {f=$4}
  /server_name[[:space:]]+(fireinners\.online|www\.fireinners\.online)/ {print f}
' | sort -u)"

echo "$FILES" | sed '/^$/d'
echo

echo "=== 2) Extract chaque server{} qui contient fireinners.online ==="
i=0
for f in $FILES; do
  [ -f "$f" ] || continue
  base="$(basename "$f")"
  # extrait les blocs server { ... } qui contiennent server_name fireinners.online
  awk -v file="$f" '
    function flush(){
      if (inblock && keep){
        out=sprintf("%s/server_%02d__%s.conf", OUTDIR, ++IDX, BASENAME)
        print buf > out
        close(out)
      }
      buf=""; inblock=0; keep=0
    }
    BEGIN{IDX=0; OUTDIR=ENVIRON["OUTDIR"]; BASENAME=ENVIRON["BASENAME"]}
    {
      line=$0
      if (!inblock && line ~ /^[[:space:]]*server[[:space:]]*\{/){
        inblock=1
      }
      if (inblock){
        buf = buf line "\n"
        if (line ~ /server_name[[:space:]]+(fireinners\.online|www\.fireinners\.online)/) keep=1
      }
      if (inblock){
        # détecte fin de bloc server par comptage { }
        for (j=1;j<=length(line);j++){
          c=substr(line,j,1)
          if (c=="{") lvl++
          else if (c=="}") lvl--
        }
        if (lvl==0 && inblock){ flush(); }
      }
    }
    END{ flush(); }
  ' "$f" OUTDIR="$OUT" BASENAME="$base" \
    OUTDIR="$OUT" BASENAME="$base" \

echo "=== 2) Patch WalletBox ==="
cat > "$SRC/components/WalletBox.jsx" <<'JSX'
import { useState } from "react";
import { connectPhantom } from "../lib/wallet";
import { fetchOnchainBalances } from "../lib/onchain";
import { fetchInternalBalances } from "../lib/balances";

export default function WalletBox() {
  const [addr, setAddr] = useState("");
  const [onchain, setOnchain] = useState(null);
  const [internal, setInternal] = useState(null);
  const [err, setErr] = useState("");

  async function connect() {
    try {
      const a = await connectPhantom();
      if (!a) return;
      setAddr(a);

      const oc = await fetchOnchainBalances(a);
      setOnchain(oc);

      const it = await fetchInternalBalances(a);
      setInternal(it);
    } catch (e) {
      setErr(String(e.message || e));
    }
  }

  function delta() {
    if (!onchain || !internal) return null;
    const out = {};
    for (const k in onchain) out[k] = (onchain[k] || 0) - (internal[k] || 0);
    return out;
  }

  const d = delta();

  return (
    <div className="walletBox">
      <div className="walletTitle">Wallet</div>

      {!addr ? (
        <button className="btn ghost" onClick={connect}>Connect Phantom</button>
      ) : (
        <>
          <div className="muted">Connected</div>
          <code style={{fontSize:12,wordBreak:"break-all"}}>{addr}</code>

          <h4>On‑chain (Phantom)</h4>
          {onchain && Object.entries(onchain).map(([k,v]) => <div key={k}>{k}: {v}</div>)}

          <h4>TraderOne</h4>
          {internal && Object.entries(internal).map(([k,v]) => <div key={k}>{k}: {v}</div>)}

          <h4>Δ non crédité</h4>
          {d && Object.entries(d).map(([k,v]) => <div key={k}>{k}: {v}</div>)}
        </>
      )}

      {err && <div className="bad small">{err}</div>}
    </div>
  );
}
JSX


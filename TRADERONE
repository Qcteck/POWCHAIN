set -e
cd /root

BASE="https://fireinners.online/wolverine/traderone/api"

echo "=== 1) Ports locaux ==="
ss -lptn | egrep ':3000|:3002' || true
echo

echo "=== 2) TraderOne direct (3000) ==="
curl -sS -i -X POST "http://127.0.0.1:3000/api/status" \
  -H "content-type: application/json" --data '{}' | head -n 25
echo

echo "=== 3) Gateway Wolverine (3002 -> 3000) ==="
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" \
  -H "content-type: application/json" --data '{}' | head -n 25
echo

echo "=== 4) Public SANS clé (403 attendu) ==="
curl -sS -i -X POST "$BASE/status" \
  -H "content-type: application/json" --data '{}' | head -n 20
echo

echo "=== 5) Public AVEC clé (200 attendu) ==="
echo "Tape ta X-API-KEY puis ENTER (elle ne s’affiche pas) :"
read -s KEY
echo
curl -sS -i -X POST "$BASE/status" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KEY" --data '{}' | head -n 30
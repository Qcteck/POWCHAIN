cat >/root/FIX_USDC_ONLY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIX USDC ONLY (NO UI DUPLICATION) ==="

HTML="/var/www/wolverine/index.html"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

[ -f "$HTML" ] || { echo "index.html introuvable"; exit 1; }

cp -a "$HTML" "${HTML}.bak_usdc_$(date +%s)"

echo "[1/4] Nettoyage anciennes injections USDC"
sed -i '/function getUSDC/,/<\/script>/d' "$HTML" || true
sed -i '/USDC_MINT/d' "$HTML" || true

echo "[2/4] Injection fonction USDC canonique (SPL officiel)"
sed -i '/<\/body>/i \
<script>\n\
async function readUSDC(pub){\n\
 try{\n\
  const c=new solanaWeb3.Connection(RPC);\n\
  const a=await c.getParsedTokenAccountsByOwner(\n\
   new solanaWeb3.PublicKey(pub),\n\
   {mint:new solanaWeb3.PublicKey("'$USDC_MINT'")}\n\
  );\n\
  let t=0;\n\
  a.value.forEach(v=>{\n\
    t+=v.account.data.parsed.info.tokenAmount.uiAmount||0;\n\
  });\n\
  return t.toFixed(6);\n\
 }catch(e){return "0.000000";}\n\
}\n\
</script>' "$HTML"

echo "[3/4] Branchement USDC après refresh wallet (sans toucher Phantom)"
sed -i '/async function refresh()/a \
 document.getElementById("usdc").innerText = await readUSDC(USER_PUB);' "$HTML" || true

echo "[4/4] Purge cache nginx + reload"
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx

echo "=== FIX USDC TERMINÉ ==="
echo "CTRL+SHIFT+R dans le navigateur"
BASH

chmod +x /root/FIX_USDC_ONLY.sh
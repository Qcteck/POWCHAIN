BOT="$(systemctl show traderone.service -p Environment --value | tr ' ' '\n' | sed -n 's/^TRADERONE_BOT_WALLET=//p')"
echo "BOT=$BOT"

echo
echo "== 1) balances2 du BOT (doit être JSON) =="
curl -ksS "https://fireinners.online/wolverine/traderone/api/balances2?wallet=$BOT" | head -c 400; echo

echo
echo "== 2) START avec budget 1 (doit etre 200 si bot a SOL+USDC, sinon 400 explicite) =="
curl -ksS -D- "https://fireinners.online/wolverine/traderone/api/start" \
  -X POST -H "Content-Type: application/json" \
  --data '{"wallet":"TESTUSER","budget":1}' | head -n 80
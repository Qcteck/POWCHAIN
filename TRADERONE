set -e
cd /root

for F in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$F" ] || continue
  cp -v "$F" "/root/nginx_backups/$(basename "$F").cleanup.$(date +%Y%m%d_%H%M%S)"

  # retire les lignes debug qu'on a ajoutées
  sed -i -E '/add_header X-MATCH traderone-api always;/d' "$F"
  sed -i -E '/add_header X-KEYSTATE/d' "$F"
  sed -i -E '/set \$keystate (missing|present);/d' "$F"
  sed -i -E '/if \(\$http_x_api_key != ""\) \{ set \$keystate present; \}/d' "$F"
done

nginx -t
systemctl reload nginx
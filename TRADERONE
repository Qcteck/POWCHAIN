from pathlib import Path
p=Path("$VHOST")
s=p.read_text(errors="ignore")

BEGIN="# WOLVERINE_BEGIN"
END="# WOLVERINE_END"
block=f"""{BEGIN}
# Wolverine UI (static)
location = /wolverine {{ return 301 /wolverine/; }}
location ^~ /wolverine/ {{
  alias $WEBROOT/;
  try_files \\$uri \\$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}}

# Disable SW/manifest if present (prevents stale caching)
location = /wolverine/sw.js {{ add_header Cache-Control "no-store" always; return 404; }}
location = /wolverine/service-worker.js {{ add_header Cache-Control "no-store" always; return 404; }}
location = /wolverine/manifest.json {{ add_header Cache-Control "no-store" always; return 404; }}

# API routes for browser-safe RPC + vault
include $INC;
{END}
"""

def replace_or_insert(server_text:str)->str:
    if BEGIN in server_text and END in server_text:
        pre=server_text.split(BEGIN)[0]
        post=server_text.split(END,1)[1]
        return pre + block + post
    # insert before last } of the FIRST server { ... } that contains server_name fireinners.online
    lines=server_text.splitlines(True)
    out=[]
    in_server=False
    brace=0
    inserted=False
    target=False
    for i,line in enumerate(lines):
        out.append(line)
        if "server" in line and "{" in line and not in_server:
            in_server=True
            brace += line.count("{")-line.count("}")
            target=False
            continue
        if in_server:
            brace += line.count("{")-line.count("}")
            if "server_name" in line and "fireinners.online" in line:
                target=True
            if brace==0:
                if target and not inserted:
                    out.insert(len(out)-1, "\n"+block+"\n")
                    inserted=True
                in_server=False
    if not inserted:
        # last resort: append at end (won't break, but may be ignored if outside server)
        out.append("\n"+block+"\n")
    return "".join(out)

s2=replace_or_insert(s)
p.write_text(s2)

cat >/root/disable_wolverine_sw.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
CFG="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date -u +%Y%m%d_%H%M%S)"

test -f "$CFG" || { echo "❌ Missing $CFG"; exit 1; }

echo "== Backup =="
cp -a "$CFG" "${CFG}.bak_disable_sw_${TS}"
echo "Backup: ${CFG}.bak_disable_sw_${TS}"
echo

echo "== Insert SW kill-switch locations (only if missing) =="
if grep -q "SW_KILL_SWITCH_WOLVERINE" "$CFG"; then
  echo "OK: already present"
else
  awk '
    BEGIN{done=0}
    {print}
    done==0 && $0 ~ /^[[:space:]]*server[[:space:]]*\{/ {
      print ""
      print "  # SW_KILL_SWITCH_WOLVERINE"
      print "  location = /wolverine/sw.js { add_header Cache-Control \"no-store\" always; return 404; }"
      print "  location = /wolverine/service-worker.js { add_header Cache-Control \"no-store\" always; return 404; }"
      print "  location = /wolverine/manifest.json { add_header Cache-Control \"no-store\" always; return 404; }"
      print ""
      done=1
    }
  ' "$CFG" > /tmp/nginx_swkill.tmp
  mv /tmp/nginx_swkill.tmp "$CFG"
  echo "✅ Added SW kill-switch"
fi
echo

echo "== nginx test + reload =="
nginx -t
systemctl reload nginx || service nginx reload
echo

echo "== ORIGIN checks (must be 404 now) =="
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/sw.js | head -n 8 || true
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/service-worker.js | head -n 8 || true
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/manifest.json | head -n 8 || true

echo "DONE ✅"
BASH

chmod +x /root/disable_wolverine_sw.sh
/root/disable_wolverine_sw.sh
cat >/tmp/WOLVERINE_RESTART_8585_AND_TEST_JSON.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
TARGET="/opt/traderone-opt/server.js"

echo "== 1) Trouver le service systemd qui exécute $TARGET =="
SVC="$(systemctl show --property=Id --value --all --type=service | while read -r u; do
  systemctl cat "$u" 2>/dev/null | grep -q "$TARGET" && echo "$u" && break
done)"

if [ -z "${SVC:-}" ]; then
  echo "Service introuvable via systemctl cat. Recherche dans les .service..."
  HIT="$(grep -RIn --include='*.service' -E "$TARGET" /etc/systemd/system /lib/systemd/system 2>/dev/null | head -n 1 || true)"
  echo "$HIT"
  if [ -n "$HIT" ]; then
    FILE="${HIT%%:*}"
    SVC="$(basename "$FILE")"
  fi
fi

if [ -z "${SVC:-}" ]; then
  echo "❌ Impossible de trouver le service automatiquement."
  echo "➡️ Envoie-moi la sortie de:"
  echo "   grep -RIn --include='*.service' -E '$TARGET' /etc/systemd/system /lib/systemd/system | head -n 30"
  exit 1
fi

echo "SERVICE=$SVC"
echo

echo "== 2) Restart service =="
systemctl restart "$SVC"
systemctl status "$SVC" --no-pager -l | sed -n '1,25p'
echo

echo "== 3) Vérifier que 8585 écoute =="
ss -lntp | grep ':8585' || true
echo

echo "== 4) TEST (doit commencer par { ) =="
curl -sS -D- "http://127.0.0.1:8585/wolverine/traderone/api/balances2?wallet=$WALLET" | head -c 350
echo
echo "DONE ✅"
SH

bash /tmp/WOLVERINE_RESTART_8585_AND_TEST_JSON.sh
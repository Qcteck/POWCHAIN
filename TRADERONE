set -e
cd /root

echo "=== 1) Récupère l'erreur nginx (fichier:ligne) ==="
ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 40

FILE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\1/p' | head -n 1)"
LINE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\2/p' | head -n 1)"
echo "FILE=$FILE"
echo "LINE=$LINE"

[ -f "$FILE" ] || { echo "Fichier introuvable: $FILE"; exit 1; }

echo
echo "=== 2) Backup + contexte autour de la ligne fautive ==="
mkdir -p /root/nginx_backups
cp -v "$FILE" "/root/nginx_backups/$(basename "$FILE").badrewrite.$(date +%Y%m%d_%H%M%S)"
START=$((LINE-25)); [ "$START" -lt 1 ] && START=1
END=$((LINE+25))
nl -ba "$FILE" | sed -n "${START},${END}p"

echo
echo "=== 3) Fix automatique: toute ligne 'rewrite ...' sans ; -> ajoute ; ==="
perl -pi -e 'if (/^\s*rewrite\b/ && $_ !~ /;\s*$/) { s/\s*$/;\n/ }' "$FILE"

echo
echo "=== 4) Re-test ==="
nginx -t
systemctl reload nginx
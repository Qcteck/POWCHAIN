cat >/tmp/WOLVERINE_TG_FIX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
DIR="/opt/fireinners/wolverine-telegram"
SERVICE="wolverine-tg-sentinel"
say(){ printf "%s\n" "$*"; }
command -v curl >/dev/null || { say "ERREUR: curl manquant"; exit 1; }
mkdir -p "$DIR"; chmod 700 "$DIR"
read -r -p "Continuer et mettre a jour Telegram? (y/N) " ans || true
case "${ans,,}" in y|yes) ;; *) say "Stop."; exit 0;; esac
read -r -s -p "COLLE TG_TOKEN puis ENTER (rien ne s'affiche): " TG; echo
TG="$(printf '%s' "$TG" | tr -d '\r' | tr -d ' ')"
[ -n "$TG" ] || { say "ERREUR: token vide"; exit 1; }
UPD="$(curl -sS --max-time 12 "https://api.telegram.org/bot${TG}/getUpdates?timeout=0&limit=30" || true)"
CID="$(printf '%s' "$UPD" | tr -d '\n' | grep -oE '"chat":\{"id":[-0-9]+' | tail -n1 | grep -oE '[-0-9]+$' || true)"
[ -n "${CID:-}" ] || { say "ERREUR: chat_id introuvable. Envoie 'ping' au bot puis relance."; exit 1; }
systemctl stop "$SERVICE" 2>/dev/null || true
[ -f "$ENV" ] && cp -a "$ENV" "$ENV.bak.$(date +%s)" || true
umask 077
printf "TG_TOKEN=%s\nTG_CHAT_ID=%s\n" "$TG" "$CID" >"$ENV"
chmod 600 "$ENV"
ME="$(curl -sS --max-time 10 "https://api.telegram.org/bot${TG}/getMe" | head -c 400 || true)"
printf '%s' "$ME" | grep -q '"ok":true' || { say "ERREUR: getMe pas ok:true"; exit 1; }
SM="$(curl -sS --max-time 10 -X POST "https://api.telegram.org/bot${TG}/sendMessage" -d "chat_id=${CID}" -d "text=WOLVERINE: TOKEN OK $(date -u +%FT%TZ)" | head -c 400 || true)"
printf '%s' "$SM" | grep -q '"ok":true' || { say "ERREUR: sendMessage pas ok:true"; exit 1; }
systemctl restart "$SERVICE" 2>/dev/null || true
sleep 0.3
systemctl is-active "$SERVICE" >/dev/null 2>&1 && say "OK: service active" || say "WARN: service non-active"
say "DONE."
SH
bash /tmp/WOLVERINE_TG_FIX.sh
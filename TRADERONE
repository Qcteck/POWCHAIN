bash -lc 'set -euo pipefail;DOMAIN="fireinners.online";VHOST="/etc/nginx/sites-available/fireinners.online-ssl";SNIP="/etc/nginx/snippets/private_sentinel1.conf";HTPASS="/etc/nginx/.htpasswd_sentinel1";PATHLOC="/_private_sentinel1_/";UPSTREAM="http://127.0.0.1:3000";echo "[1] Check vhost";[ -f "$VHOST" ]||{ echo "ERR: vhost introuvable: $VHOST"; exit 1; };echo "[2] Ensure sites-enabled link";[ -e "/etc/nginx/sites-enabled/$(basename "$VHOST")" ]||ln -s "$VHOST" "/etc/nginx/sites-enabled/$(basename "$VHOST")";echo "[3] Unlock immutable if set";if lsattr "$VHOST" 2>/dev/null|grep -q "^-i";then chattr -i "$VHOST";echo "unlocked";else echo "not immutable";fi;echo "[4] Backup";ts="$(date +%Y%m%d-%H%M%S)";cp -a "$VHOST" "$VHOST.bak.$ts";echo "[5] Ensure htpasswd tool";command -v htpasswd >/dev/null 2>&1||{ apt-get update -y; apt-get install -y apache2-utils; };echo "[6] Create/Update htpasswd (user: sentinel)";mkdir -p /etc/nginx; if [ -f "$HTPASS" ]; then htpasswd "$HTPASS" sentinel; else htpasswd -c "$HTPASS" sentinel; fi;chmod 640 "$HTPASS";chown root:www-data "$HTPASS" 2>/dev/null||true;echo "[7] Write nginx snippet";mkdir -p /etc/nginx/snippets;cat > "$SNIP" <<EOF
location = ${PATHLOC%/} { return 301 ${PATHLOC}; }
location ^~ ${PATHLOC} {
  auth_basic "Sentinel";
  auth_basic_user_file ${HTPASS};
  proxy_pass ${UPSTREAM}/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
}
EOF
echo "[8] Inject include in SSL vhost (if missing)";INC="include $SNIP;";grep -qF "$INC" "$VHOST" && echo "include already present" || perl -i -pe "if(/server_name\\s+.*\\b$DOMAIN\\b.*;\\s*\\n/ && !\$done++){ \$_ .= \"    $INC\\n\" }" "$VHOST";echo "[9] nginx test + reload";nginx -t;systemctl reload nginx;echo "[10] Quick test (should be 401)";code="$(curl -s -o /dev/null -w "%{http_code}" "https://$DOMAIN$PATHLOC" || true)";echo "HTTP:$code";if [ "$code" = "200" ]; then echo "WARNING: still 200. Show active config lines:";nginx -T 2>/dev/null | grep -n "_private_sentinel1_" | head -n 40;fi;echo "DONE. Test in browser: https://$DOMAIN$PATHLOC"'
let db=loadDB(), cur=null;

function upsert(obj){
  const name=(obj.name||"").trim(); if(!name) return false;
  const ex=findByName(db.items,name);
  const rec={
    id: ex?ex.id:uid(),
    name, title:name,
    type: obj.type||obj.kind||"var",
    kind: obj.type||obj.kind||"var",
    tags: Array.isArray(obj.tags)?obj.tags:normTags(obj.tags||""),
    notes: obj.notes||"",
    code: obj.code||"",
    createdAt: ex?(ex.createdAt||now()):now(),
    updatedAt: now()
  };
  if(ex){Object.assign(ex,rec)} else {db.items.push(rec)}
  saveDB(db); return true;
}

function filtered(){
  const q=($("q").value||"").trim().toLowerCase();
  let arr=[...(db.items||[])].sort(byName);
  if(!q) return arr;
  return arr.filter(x=>{
    const s=((x.name||"")+" "+(x.type||x.kind||"")+" "+(x.notes||"")+" "+(Array.isArray(x.tags)?x.tags.join(" "):"")).toLowerCase();
    return s.includes(q);
  });
}

function render(){
  const arr=filtered();
  $("count").textContent=arr.length+" items";
  $("hint").textContent=cur?("Selected: "+(cur.name||"")):"Click an item";
  const list=$("list"); list.innerHTML="";
  arr.forEach(x=>{
    const d=document.createElement("div"); d.className="item";
    d.innerHTML='<div class="nm"></div><div class="meta"></div>';
    d.querySelector(".nm").textContent=x.name||"(no name)";
    const meta=d.querySelector(".meta");
    const tags=(Array.isArray(x.tags)?x.tags:[]);
    meta.appendChild(tagEl(x.type||x.kind||""));
    tags.slice(0,10).forEach(t=>meta.appendChild(tagEl(t)));
    d.onclick=()=>select(x.name);
    list.appendChild(d);
  });
}

function select(name){
  const x=findByName(db.items,name);
  cur=x;
  $("name").value=x?x.name||"":""; $("type").value=x?(x.type||x.kind||""):"";
  $("tags").value=x && Array.isArray(x.tags)?x.tags.join(", "):"";
  $("notes").value=x?x.notes||"":""; $("code").value=x?x.code||"":""; 
  $("runInfo").textContent=x?("id: "+(x.id||"")):"";
  render();
}

function installPack(){
  let n=0;
  PACK_ALL.forEach(p=>{if(upsert(p)) n++;});
  db=loadDB(); render();
  toast("Pack COMPLET installé/maj ("+n+")");
}

$("q").addEventListener("input",render);
$("btnPack").onclick=installPack;

$("btnNew").onclick=()=>{cur=null;$("name").value="";$("type").value="var";$("tags").value="";$("notes").value="";$("code").value="";$("runInfo").textContent="";render();};
$("btnSave").onclick=()=>{
  const name=$("name").value.trim(); if(!name){toast("Name requis");return;}
  const t=$("type").value.trim()||"var";
  const ok=upsert({name,type:t,tags:normTags($("tags").value),notes:$("notes").value,code:$("code").value});
  if(ok){toast("Saved"); db=loadDB(); select(name);}
};
$("btnDel").onclick=()=>{
  const name=$("name").value.trim(); if(!name){toast("Select");return;}
  const i=(db.items||[]).findIndex(x=>(x.name||"").trim()===name);
  if(i>=0){db.items.splice(i,1); saveDB(db); toast("Deleted"); db=loadDB(); cur=null; render();}
};
$("btnReset").onclick=()=>{
  if(!confirm("Reset local DB?")) return;
  localStorage.removeItem(DBKEY); db=loadDB(); cur=null; toast("Reset"); render();
};

$("btnExport").onclick=()=>{
  const payload={db:DBKEY,version:db.version||1,exportedAt:now(),items:db.items||[]};
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
  const a=document.createElement("a");
  a.href=URL.createObjectURL(blob);
  a.download="NEURONEONE_EXPORT_"+Date.now()+".json";
  a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1200);
};

$("btnImport").onclick=()=>{
  const inp=document.createElement("input"); inp.type="file"; inp.accept="application/json";
  inp.onchange=async()=>{const f=inp.files&&inp.files[0]; if(!f) return;
    try{
      const txt=await f.text(); const j=JSON.parse(txt);
      const arr=Array.isArray(j)?j:(j&&Array.isArray(j.items)?j.items:[]);
      if(!arr.length){toast("No items");return;}
      let n=0; arr.forEach(x=>{if(x&&x.name){ if(upsert(x)) n++; }});
      toast("Imported/merged: "+n);
      db=loadDB(); render();
    }catch(e){toast("Import error");}
  };
  inp.click();
};

function runSandbox(openNewTab){
  const code=$("code").value||"";
  if(!code.trim()){toast("No code");return;}
  const html=(code.includes("<html")||code.includes("<!doctype"))?code:("<!doctype html><meta charset=utf-8><title>Run</title><body>"+code+"</body>");
  if(openNewTab){
    const w=window.open("about:blank","_blank"); if(!w){toast("Popup blocked");return;}
    w.document.open(); w.document.write(html); w.document.close();
  }else $("sandbox").srcdoc=html;
}
$("btnRun").onclick=()=>runSandbox(false);
$("btnRunTab").onclick=()=>runSandbox(true);

render();

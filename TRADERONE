set -euo pipefail

echo "=== 0) Diagnose holds ==="
apt-mark showhold || true

echo
echo "=== 1) Unblock dpkg/apt ==="
dpkg --configure -a || true
apt-get -f install -y || true
apt-get update -y

echo
echo "=== 2) Remove broken/conflicting node packages (if any) ==="
apt-get remove -y nodejs npm libnode-dev libnode* node-* || true
apt-get autoremove -y || true
apt-get clean

echo
echo "=== 3) Install Node 20 from NodeSource (fresh) ==="
# This script adds the correct repo for your Ubuntu version
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -

apt-get update -y
apt-get install -y nodejs

echo
echo "=== 4) Verify ==="
node -v
npm -v

echo
echo "=== 5) Optional: allow systemd services to run node from a stable path ==="
command -v node
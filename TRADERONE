set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT_DEFAULT="/opt/fireinners/frontend-react/app/dist"
ROOT="$ROOT_DEFAULT"

# detect ROOT from nginx vhost if possible
if [[ -f "$VHOST" ]]; then
  R="$(awk 'BEGIN{r=""} /^\s*root\s+/{gsub(/;$/,"",$2); if(r=="") r=$2} END{print r}' "$VHOST" || true)"
  [[ -n "${R:-}" ]] && ROOT="$R"

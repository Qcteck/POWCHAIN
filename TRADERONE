cat > /root/MEGA_WOLVERINE_NGINX_FIXDUP.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
FRONT_DIR="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"
INC_DIR="/etc/nginx/includes"
INC="${INC_DIR}/wolverine_routes.inc"
LOG="/root/MEGA_WOLVERINE_NGINX_FIXDUP_${TS}.log"
NOHUP="/root/MEGA_WOLVERINE_NGINX_FIXDUP_${TS}.nohup"

if [[ "${1:-}" != "--run" ]]; then
  nohup bash "$0" --run >"$NOHUP" 2>&1 & disown || true
  echo "Launching in background (nohup) -> $NOHUP"
  echo "Now run: tail -n 260 $NOHUP"
  exit 0
fi

w(){ printf "%s\n" "$*" | tee -a "$LOG" >/dev/null; }
sep(){ w ""; w "== $* =="; }
ok(){ w "OK: $*"; }
warn(){ w "WARN: $*"; }
die(){ w "ERREUR: $*"; exit 1; }

ensure_pkg(){ local p="$1"; dpkg -s "$p" >/dev/null 2>&1 || { apt-get update -y >>"$LOG" 2>&1; apt-get install -y "$p" >>"$LOG" 2>&1; }; }

is_imm(){ lsattr -d "$1" 2>/dev/null | awk '{print $1}' | grep -q "i"; }
unlock_imm(){ local f="$1" name="$2" ; if [[ -f "$f" ]] && is_imm "$f"; then chattr -i "$f" || true; ok "chattr -i $name"; echo "1"; else echo "0"; fi; }
relock_imm(){ local f="$1" name="$2" was="$3"; if [[ "${was}" == "1" ]] && [[ -f "$f" ]]; then chattr +i "$f" || true; ok "chattr +i $name"; fi; }

backup_file(){ local f="$1"; [[ -f "$f" ]] || return 0; cp -a "$f" "${f}.bak_${TS}"; ok "backup ${f}.bak_${TS}"; }

http_code_local(){ local path="$1"; curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1${path}" -H "Host: ${HOST}" || true; }
http_code_ext(){ local path="$1"; curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}${path}" || true; }

sep "0) Pré-requis + chemins"
ensure_pkg nginx
ensure_pkg python3
ensure_pkg ca-certificates
ensure_pkg curl
mkdir -p "$INC_DIR"
[[ -f "$VHOST" ]] || die "Vhost introuvable: $VHOST"
[[ -d "$FRONT_DIR" ]] || warn "FRONT_DIR absent: $FRONT_DIR (ça peut causer 403/404 mais on fixe nginx d'abord)"
ok "pré-requis OK"
w "LOG=$LOG"

sep "1) Unlock immutable si nécessaire (nginx.conf + vhost + include)"
WAS_MAIN="$(unlock_imm "$NGINX_MAIN" "nginx.conf")"
WAS_VHOST="$(unlock_imm "$VHOST" "vhost")"
WAS_INC="$(unlock_imm "$INC" "include")"

sep "2) Backups"
backup_file "$NGINX_MAIN"
backup_file "$VHOST"
backup_file "$INC"

sep "3) Réécrire include CANONIQUE (anti-doublon) -> $INC"
cat > "$INC" <<'EOF'
# Canonical Wolverine routes (NO DUPLICATE location /wolverine)
# Front: /var/www/wolverine (static export Next)
# API:   /wolverine/traderone/api/ -> http://127.0.0.1:3000/

# Normalize
location = /wolverine { return 301 /wolverine/; }

# TraderOne API (proxy)
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_connect_timeout 10s;
  proxy_pass http://127.0.0.1:3000/;
}
location = /wolverine/traderone/api { return 301 /wolverine/traderone/api/; }

# Next static assets
location ^~ /wolverine/_next/ {
  alias /var/www/wolverine/_next/;
  access_log off;
  expires 30d;
  add_header Cache-Control "public, max-age=2592000" always;
  try_files $uri =404;
}

# Main app
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}
EOF
ok "include réécrit"

sep "4) Dé-doublonner l'include dans le VHOST (et gérer wildcard includes/*.inc)"
python3 - <<'PY'
from pathlib import Path
import re
VHOST=Path("/etc/nginx/sites-available/fireinners.online-ssl")
INC="/etc/nginx/includes/wolverine_routes.inc"
s=VHOST.read_text(errors="ignore").splitlines()

# remove duplicate explicit include lines
inc_re=re.compile(r'^\s*include\s+'+re.escape(INC)+r'\s*;')
new=[]
removed=0
for line in s:
    if inc_re.search(line):
        removed+=1
        continue
    new.append(line)
s=new

# detect wildcard include in vhost (example: include /etc/nginx/includes/*.inc;)
wild_re=re.compile(r'^\s*include\s+/etc/nginx/includes/\*\.inc\s*;')
has_wild=any(wild_re.search(l) for l in s)

# ensure at least one inclusion mechanism exists (wildcard OR explicit include in correct server)
# We will inject explicit include ONLY if no wildcard exists and if server_name block for fireinners.online exists.
if not has_wild:
    # find server block containing server_name fireinners.online
    out=[]
    i=0
    injected=False
    while i < len(s):
        line=s[i]
        out.append(line)
        # naive server_name detection (works with typical nginx formatting)
        if (not injected) and re.search(r'^\s*server_name\s+.*\bfireinners\.online\b', line):
            # inject include right after server_name line (safe, single place)
            out.append(f'  include {INC};')
            injected=True
        i+=1
    s=out

VHOST.write_text("\n".join(s)+("\n" if s and not s[-1].endswith("\n") else ""), errors="ignore")
print(f"OK: removed explicit include lines={removed}, wildcard_in_vhost={has_wild}, injected_explicit_include={('yes' if (not has_wild) else 'no')}")
PY
ok "vhost dédoublonné"

sep "5) Permissions front (éviter 403) si dossier existe"
if [[ -d "$FRONT_DIR" ]]; then
  chmod -R a+rX "$FRONT_DIR" || true
  ok "chmod a+rX sur $FRONT_DIR"
else
  warn "skip permissions: $FRONT_DIR absent"
fi

sep "6) Inventaire rapide (où /wolverine est défini?)"
(nginx -T 2>/dev/null | egrep -n "wolverine_routes\.inc|location\s+(/wolverine|= /wolverine)" | head -n 120) | tee -a "$LOG" >/dev/null || true

sep "7) nginx -t puis reload"
if nginx -t >>"$LOG" 2>&1; then
  ok "nginx -t PASS"
  systemctl reload nginx >>"$LOG" 2>&1 || systemctl restart nginx >>"$LOG" 2>&1 || true
  ok "nginx reloaded"
else
  w "---- nginx -t output (last 120) ----"
  tail -n 120 "$LOG" || true
  die "nginx -t FAIL (voir $LOG)"
fi

sep "8) Tests HTTP"
w "LOCAL /wolverine/ => $(http_code_local "/wolverine/")"
w "EXT   /wolverine/ => $(http_code_ext "/wolverine/")"
w "LOCAL /wolverine/traderone/api/health => $(http_code_local "/wolverine/traderone/api/health")"
w "EXT   /wolverine/traderone/api/health => $(http_code_ext "/wolverine/traderone/api/health")"

sep "9) Relock immutable si nécessaire"
relock_imm "$INC" "include" "$WAS_INC"
relock_imm "$VHOST" "vhost" "$WAS_VHOST"
relock_imm "$NGINX_MAIN" "nginx.conf" "$WAS_MAIN"

sep "DONE"
w "LOG=$LOG"
BASH
chmod +x /root/MEGA_WOLVERINE_NGINX_FIXDUP.sh
bash /root/MEGA_WOLVERINE_NGINX_FIXDUP.sh
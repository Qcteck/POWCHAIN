#!/usr/bin/env bash
set -euo pipefail

### CONFIG
SITE_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$SITE_DIR/index.html"
BACKUP="$SITE_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"
WORKER_BASE="https://aiaquila-proxy.paycashnostory.workers.dev"
TEST_FEED="https://news.bitcoin.com/feed/"

echo "=== AIAQUILA FINAL FIX (JSON ONLY / WORKER RSS) ==="

### 1. CHECK DIR
if [ ! -d "$SITE_DIR" ]; then
  echo "❌ Dossier introuvable: $SITE_DIR"
  exit 1
fi

### 2. BACKUP
if [ -f "$INDEX" ]; then
  cp "$INDEX" "$BACKUP"
  echo "✔ Backup créé: $BACKUP"
fi

### 3. WRITE CLEAN FRONTEND (JSON ONLY)
cat > "$INDEX" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;font-family:system-ui;background:#0b1b3a;color:#fff}
#wrap{padding:20px}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
</style>
</head>
<body>
<div id="wrap">
<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
</div>

<script>
const WORKER = "https://aiaquila-proxy.paycashnostory.workers.dev/rss";

async function load(){
  const out=document.getElementById("out");
  out.textContent="FETCH → "+WORKER+"\\n\\n";
  try{
    const r=await fetch(WORKER+"?url=https://news.bitcoin.com/feed/");
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();
    if(!Array.isArray(j)) throw new Error("Réponse non-JSON RSS");
    out.textContent="";
    j.forEach((i,n)=>{
      out.textContent+=`#${n+1} ${i.title}\\n${i.link}\\n${i.date}\\n\\n`;
    });
  }catch(e){
    out.textContent="ERREUR: "+e.message;
  }
}
</script>
</body>
</html>
HTML

### 4. PERMISSIONS
chown -R www-data:www-data "$SITE_DIR"
chmod -R 755 "$SITE_DIR"

### 5. NGINX SAFE RELOAD
nginx -t && systemctl reload nginx

### 6. TEST WORKER DIRECT
echo
echo "=== TEST WORKER DIRECT ==="
curl -s "$WORKER_BASE/rss?url=$TEST_FEED" | head -c 300
echo
echo "=== FIN ==="

echo
echo "➡ Ouvre: https://fireinners.online/aiaquila/"
echo "➡ Clique: Lire les articles"
echo "➡ Le JSON RSS DOIT s’afficher"
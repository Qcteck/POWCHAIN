set -euo pipefail
MAIN="/opt/traderone-opt/server.js"
SVC="traderone.service"
TS="$(date +%s)"

cp -a "$MAIN" "$MAIN.bak.$TS"
echo "Backup: $MAIN.bak.$TS"

node - <<'JS'
const fs = require("fs");
const file = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(file,"utf8");

// 1) Inject cache helpers once
if (!s.includes("WOLVERINE_BALANCES_CACHE_BEGIN")) {
  const anchor = s.match(/const\s+app\s*=\s*express\(\)\s*;?/);
  if (!anchor) throw new Error("Cannot find: const app = express()");
  const pos = s.indexOf(anchor[0]) + anchor[0].length;

  const block = `

/* WOLVERINE_BALANCES_CACHE_BEGIN */
// Simple in-memory cache to avoid RPC 429
const __balCache = new Map(); // key -> {ts, data, code, headers}
const __balTTLms = Number(process.env.BALANCES_CACHE_TTL_MS || "5000"); // 5s

function __cacheGet(key){
  const it = __balCache.get(key);
  if (!it) return null;
  if (Date.now() - it.ts > __balTTLms) { __balCache.delete(key); return null; }
  return it;
}
function __cacheSet(key, payload){
  __balCache.set(key, { ts: Date.now(), ...payload });
}
/* WOLVERINE_BALANCES_CACHE_END */

`;
  s = s.slice(0,pos) + block + s.slice(pos);
  console.log("Injected balances cache helpers");
}

// 2) Wrap balances2 route with cache if route exists
// We look for app.get("...balances2") and inject a cache shortcut at top of handler.
const re = /app\.get\(\s*["']([^"']*balances2[^"']*)["']\s*,\s*async\s*\(\s*req\s*,\s*res\s*\)\s*=>\s*\{/m;
const m = s.match(re);
if (!m) {
  console.log("WARN: balances2 route not found automatically. No route patched.");
} else {
  const path = m[1];
  const idx = s.indexOf(m[0]) + m[0].length;
  // don't double inject
  if (!s.includes("WOLVERINE_BALANCES_CACHE_HIT")) {
    const inject = `
  // WOLVERINE_BALANCES_CACHE_HIT
  try {
    const w = String(req.query.wallet || "");
    const key = "${path}::" + w;
    const hit = __cacheGet(key);
    if (hit) {
      res.setHeader("X-Cache", "HIT");
      if (hit.headers) Object.entries(hit.headers).forEach(([k,v])=>{ if(v!==undefined) res.setHeader(k,v); });
      return res.status(hit.code || 200).send(hit.data);
    }
    res.setHeader("X-Cache", "MISS");
  } catch(e) {}
`;
    s = s.slice(0, idx) + inject + s.slice(idx);

    // Also add cacheSet right before successful response send/json where possible
    // Simple approach: cache JSON responses by intercepting res.json/res.send
    if (!s.includes("WOLVERINE_BALANCES_CACHE_WRAP")) {
      s = s.replace(m[0], m[0] + `
  // WOLVERINE_BALANCES_CACHE_WRAP
  const __origJson = res.json.bind(res);
  const __origSend = res.send.bind(res);
  const __w = String(req.query.wallet || "");
  const __key = "${path}::" + __w;
  res.json = (obj) => { try { __cacheSet(__key, { code: res.statusCode || 200, data: JSON.stringify(obj), headers: {"Content-Type":"application/json"} }); } catch(e) {} return __origJson(obj); };
  res.send = (body) => { try { __cacheSet(__key, { code: res.statusCode || 200, data: body, headers: {"Content-Type": res.getHeader("Content-Type")} }); } catch(e) {} return __origSend(body); };
`);
      console.log("Patched balances2 with cache:", path);
    }
  } else {
    console.log("balances2 cache already present -> skip");
  }
}

fs.writeFileSync(file, s, "utf8");
console.log("Wrote:", file);
JS

systemctl restart "$SVC"
sleep 1

echo
echo "== quick test (should show X-Cache: MISS then HIT) =="
BOT="$(systemctl show traderone.service -p Environment --value | tr ' ' '\n' | sed -n 's/^TRADERONE_BOT_WALLET=//p')"
curl -ksS -D- "https://fireinners.online/wolverine/traderone/api/balances2?wallet=$BOT" -o /dev/null | grep -i x-cache || true
curl -ksS -D- "https://fireinners.online/wolverine/traderone/api/balances2?wallet=$BOT" -o /dev/null | grep -i x-cache || true
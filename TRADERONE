set -euo pipefail

OLD="/etc/nginx/snippets/wolverine_renders.conf"
NEW="/etc/nginx/snippets/wolverine_renders.server.inc"

echo "=== 1) Vérif fichiers ==="
ls -lah "$OLD" "$NEW" 2>/dev/null || true
echo

echo "=== 2) Trouver qui inclut l'ancien fichier (cassé) ==="
grep -RIn --color=never "include\s\+$OLD;" /etc/nginx || true
echo

echo "=== 3) Corriger: remplacer include OLD -> NEW si NEW existe, sinon supprimer l'include ==="
if [ -f "$NEW" ]; then
  while IFS= read -r f; do
    cp -a "$f" "$f.bak.$(date +%s)"
    sed -i "s|include $OLD;|include $NEW;|g" "$f"
    echo "Patched: $f"
  done < <(grep -RIl "include\s\+$OLD;" /etc/nginx || true)
else
  echo "⚠️ $NEW n'existe pas. Je supprime l'include cassé."
  while IFS= read -r f; do
    cp -a "$f" "$f.bak.$(date +%s)"
    sed -i "\|include\s\+$OLD;|d" "$f"
    echo "Removed include from: $f"
  done < <(grep -RIl "include\s\+$OLD;" /etc/nginx || true)
fi

echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx
echo "✅ OK"
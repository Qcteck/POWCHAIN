cat >/tmp/CLEANUP_WOLVERINE_OLD_FILES.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"
BK="/root/cleanup_wolverine_${T}"
mkdir -p "$BK/snippets" "$BK/sites-enabled"

echo "== Archive old wolverine snippets (keep fireinners-wolverine.conf) =="
for f in /etc/nginx/snippets/wolverine_unified.conf /etc/nginx/snippets/wolverine_static_tryfiles.conf; do
  if [ -f "$f" ]; then
    echo "ARCHIVE: $f -> $BK/snippets/"
    mv "$f" "$BK/snippets/"
  fi
done

echo "== Archive disabled vhosts (optional) =="
for f in /etc/nginx/sites-enabled/*.DISABLED.*; do
  [ -e "$f" ] || continue
  echo "ARCHIVE: $f -> $BK/sites-enabled/"
  mv "$f" "$BK/sites-enabled/"
done

echo "== nginx sanity check =="
nginx -t
systemctl reload nginx
echo "OK ✅ cleanup done in $BK"
SH

bash /tmp/CLEANUP_WOLVERINE_OLD_FILES.sh
  # Insert after first server_name DOMAIN line (inside that server block)
  perl -0777 -i -pe '
    my $vb=quotemeta($ENV{"MARK_BEGIN"});
    my $ve=quotemeta($ENV{"MARK_END"});
    my $dom=$ENV{"DOMAIN"};
    my $inc=$ENV{"INCLUDE_LINE"};
    my $incf=$ENV{"INC"};
    my $b=$ENV{"MARK_BEGIN"}."\n".$inc."\n".$ENV{"MARK_END"}."\n";
    if($_ =~ /server_name\s+[^;]*\b\Q$dom\E\b[^;]*;/s){
      $_ =~ s/(server_name\s+[^;]*\b\Q$dom\E\b[^;]*;\s*\n)/$1$b/s;
    } else {
      # fallback: insert near top of first server block
      $_ =~ s/(server\s*\{\s*\n)/$1$b/s;
    }
  ' "$ACTIVE_VHOST"
else
  say "include marker already present, skipping inject"
fi

say "== 13) Nginx test + reload =="
nginx -t
systemctl reload nginx

say "== 14) Smoke tests (local) =="
set +e
curl -fsS "http://${HOST}:${PORT}/api/health" && echo
curl -fsS -H "Host: ${DOMAIN}" "http://127.0.0.1/${SLUG}/api/health" && echo
curl -I -sS -H "Host: ${DOMAIN}" "http://127.0.0.1/${SLUG}/" | head -n 5
set -e

say "== 15) Freeze (chattr +i) and verify (best-effort) =="
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$ACTIVE_VHOST" 2>/dev/null || true
chattr +i "$INC" 2>/dev/null || true
lsattr /etc/nginx/nginx.conf "$ACTIVE_VHOST" "$INC" 2>/dev/null || true

say "DONE"
say "URL: https://${DOMAIN}/${SLUG}/"
say "API: https://${DOMAIN}/${SLUG}/api/health"
say "Policy: $CFG/exec_allowlist.json"
BASH

bash /root/MEGA_AIAQUILA_INSTALL_100.sh
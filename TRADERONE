cat >/tmp/TRADERONE_WOLV_NGINX_FIX_ALL.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SNIP="/etc/nginx/snippets/wolverine_traderone_backend.conf"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"

echo "1) Write snippet (API+WS+UI)…"
cat >"$SNIP" <<'EOF'
# TRADERONE_WOLV_PROXY_V2

# API TraderOne: /wolverine/traderone/api/*  ->  /api/*
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;

  proxy_pass http://127.0.0.1:8585/api/;
}

# WebSocket TraderOne: /wolverine/traderone/ws  ->  /ws
location ^~ /wolverine/traderone/ws {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;

  proxy_pass http://127.0.0.1:8585/ws;
}

# UI TraderOne: /wolverine/traderone/*  ->  /
location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;

  proxy_pass http://127.0.0.1:8585/;
}
EOF

echo "2) Ensure include in SSL vhost (python write, no sed -i)…"
python3 - <<'PY'
import re, time
site="/etc/nginx/sites-available/fireinners.online-ssl"
inc="    include /etc/nginx/snippets/wolverine_traderone_backend.conf; # TRADERONE_INCLUDE_V1\n"
s=open(site,"r",encoding="utf-8",errors="ignore").read()

if "wolverine_traderone_backend.conf" in s:
    print("OK: include already present")
else:
    # insert after first 'server {'
    m=re.search(r'^\s*server\s*\{\s*$', s, flags=re.M)
    if not m:
        raise SystemExit("ERROR: can't find 'server {'' in "+site)
    s2=s[:m.end()]+"\n"+inc+s[m.end():]
    open(site,"w",encoding="utf-8").write(s2)
    print("OK: include added")
PY

echo "3) nginx test + reload…"
nginx -t
systemctl reload nginx

echo "4) TEST: API status must NOT be HTML…"
OUT="$(curl -ksS --max-time 6 https://fireinners.online/wolverine/traderone/api/status | head -c 120 || true)"
echo "$OUT"
echo
if echo "$OUT" | grep -qi '<!doctype html'; then
  echo "FAIL: still HTML -> include probably not in active SSL server block."
  echo "Show includes + traderone locations in active config:"
  nginx -T 2>/dev/null | grep -nE "wolverine/traderone|TRADERONE_" | head -n 120 || true
  exit 2
else
  echo "OK: not HTML -> proxy API is active."
fi
SH

bash /tmp/TRADERONE_WOLV_NGINX_FIX_ALL.sh
set -e
cd /root

echo "=== 1) Qui écoute sur quels ports (node) ==="
sudo lsof -iTCP -sTCP:LISTEN -n -P | egrep ':(12703|3002|3000|3001|3003|8080|8000)\b' || true

echo
echo "=== 2) Cmdline + CWD du node 12703 et 3002 ==="
for PORT in 12703 3002; do
  PID=$(sudo lsof -t -iTCP:$PORT -sTCP:LISTEN 2>/dev/null | head -n 1 || true)
  echo "--- PORT $PORT PID=$PID"
  [ -n "$PID" ] && tr '\0' ' ' < /proc/$PID/cmdline ; echo
  [ -n "$PID" ] && echo "CWD=$(readlink -f /proc/$PID/cwd)" || true
done

echo
echo "=== 3) Dans le code: quels ports sont utilisés ? ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git -E "listen\\(|createServer\\(|PORT\\b|process\\.env\\.PORT" \
  /opt/traderone /opt/traderone/api /opt/wolverine 2>/dev/null | head -n 160

echo
echo "=== 4) Tester REST sur les ports trouvés (met à jour PORTS=...) ==="
PORTS="3000 3001 3002 3003 12703"
for p in $PORTS; do
  echo "--- TEST PORT $p"
  curl -sS -i -X POST "http://127.0.0.1:$p/api/status" -H "content-type: application/json" --data '{}' | head -n 8 || true
  curl -sS -i -X POST "http://127.0.0.1:$p/api/start"  -H "content-type: application/json" --data '{}' | head -n 8 || true
  echo
done
set -euo pipefail

echo "=== 1) Quels fichiers contiennent server_name fireinners.online ==="
FILES=$(nginx -T 2>/dev/null | awk '
  /^# configuration file /{f=$4}
  /server_name[[:space:]]+(fireinners\.online|www\.fireinners\.online)/{print f}
' | sort -u)

echo "$FILES" | sed '/^$/d'
echo

echo "=== 2) Résumé lisible de chaque fichier (listen/root/locations/proxy) ==="
for f in $FILES; do
  [ -f "$f" ] || continue
  echo "=============================="
  echo "FILE: $f"
  echo "---- KEY LINES ----"
  grep -nE 'server_name|listen|root|index|return|rewrite|try_files|location|proxy_pass|ssl_certificate' "$f" \
    | sed -n '1,260p'
  echo
done

echo "=== 3) Diff rapide (fichier 1 vs les autres) ==="
FIRST="$(echo "$FILES" | sed '/^$/d' | head -n 1)"
for f in $(echo "$FILES" | sed '/^$/d' | tail -n +2); do
  echo "######## DIFF: $FIRST  vs  $f ########"
  diff -u "$FIRST" "$f" | head -n 220 || true
  echo
done

echo "DONE ✅"
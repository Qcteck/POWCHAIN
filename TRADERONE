#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE MEGA FIX BACKEND ==="

# 1. Vérif Node
if ! command -v node >/dev/null; then
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash
  apt-get install -y nodejs
fi

# 2. Dossiers
mkdir -p /opt/wolverine-api
cd /opt/wolverine-api

# 3. Backend Node.js
cat > server.js <<'JS'
import express from "express";
import cors from "cors";
import { Connection, PublicKey } from "@solana/web3.js";

const app = express();
app.use(cors());

const RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const conn = new Connection(RPC, "confirmed");

app.get("/wolverine/api/balance/:pubkey", async (req, res) => {
  try {
    const pub = new PublicKey(req.params.pubkey);
    const lamports = await conn.getBalance(pub);
    res.json({ sol: lamports / 1e9 });
  } catch (e) {
    res.status(400).json({ error: e.message });
  }
});

app.listen(3000, () => console.log("WOLVERINE API ON :3000"));
JS

# 4. Dépendances
cat > package.json <<'JSON'
{
  "type": "module",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "@solana/web3.js": "^1.98.0"
  }
}
JSON

npm install

# 5. Service systemd
cat > /etc/systemd/system/wolverine-api.service <<'SERVICE'
[Unit]
Description=Wolverine API
After=network.target

[Service]
ExecStart=/usr/bin/node /opt/wolverine-api/server.js
Restart=always
User=root
WorkingDirectory=/opt/wolverine-api

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable wolverine-api
systemctl restart wolverine-api

# 6. NGINX HTTPS proxy
NGINX="/etc/nginx/sites-available/fireinners.online-ssl"

if ! grep -q wolverine/api "$NGINX"; then
sed -i '/location \/ws {/i \
location /wolverine/api/ {\
 proxy_pass http://127.0.0.1:3000;\
 proxy_http_version 1.1;\
 proxy_set_header Host $host;\
 proxy_set_header X-Real-IP $remote_addr;\
}' "$NGINX"
fi

nginx -t && systemctl reload nginx

# 7. TEST FINAL
echo "=== TEST API ==="
curl -s https://fireinners.online/wolverine/api/balance/11111111111111111111111111111111 || true

echo "=== OK : WOLVERINE BACKEND OPERATIONNEL ==="
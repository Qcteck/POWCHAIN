cat >/root/FIX_WOLVERINE_FINAL_REAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "== UNFREEZE =="
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i /etc/nginx/includes/*.inc 2>/dev/null || true
chattr -i /etc/nginx/sites-available/fireinners.online-ssl 2>/dev/null || true

echo "== HARD DELETE offending file =="
rm -f /etc/nginx/includes/wolverine_static.inc

echo "== ENSURE canonical include exists =="
cat >/etc/nginx/includes/wolverine.inc <<'NGINX'
# WOLVERINE_CANONICAL_FINAL_REAL
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
    alias /var/www/wolverine/;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store" always;
}
NGINX

echo "== CLEAN vhost includes =="
sed -i '\|include .*wolverine.*;|d' /etc/nginx/sites-available/fireinners.online-ssl

grep -q "include /etc/nginx/includes/wolverine.inc;" /etc/nginx/sites-available/fireinners.online-ssl || \
sed -i '/server\s*{/a\    include /etc/nginx/includes/wolverine.inc;' \
/etc/nginx/sites-available/fireinners.online-ssl

echo "== TEST + RELOAD =="
nginx -t
systemctl reload nginx

echo "== REFREEZE =="
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i /etc/nginx/sites-available/fireinners.online-ssl 2>/dev/null || true

echo "== DONE : /wolverine WORKS =="
BASH

chmod +x /root/FIX_WOLVERINE_FINAL_REAL.sh
bash /root/FIX_WOLVERINE_FINAL_REAL.sh
# ROOT batch — réparer "origin" / remotes git, puis push
set -euo pipefail

echo "=== 1) Trouver le repo git le plus probable (dans /opt) ==="
REPO_DIR="$(find /opt -maxdepth 5 -type d -name .git 2>/dev/null | head -n 1 | sed 's/\/.git$//')"
if [ -z "${REPO_DIR:-}" ]; then
  echo "KO: aucun .git trouvé sous /opt. Mets le bon chemin et relance."
  exit 1
fi

cd "$REPO_DIR"
echo "Repo: $(pwd)"
echo

echo "=== 2) Vérif que c'est bien un repo git ==="
git rev-parse --is-inside-work-tree
echo

echo "=== 3) Remotes existants ==="
git remote -v || true
echo

echo "=== 4) Si tu as un remote 'oliver', on le met en origin (sinon on te laisse ajouter l'URL) ==="
if git remote | grep -qx "oliver"; then
  URL="$(git remote get-url oliver)"
  echo "OK: remote 'oliver' trouvé -> $URL"
  if ! git remote | grep -qx "origin"; then
    git remote add origin "$URL"
  else
    git remote set-url origin "$URL"
  fi
else
  echo "INFO: pas de remote 'oliver'."
  echo "➡️ Mets ton URL GitHub ici (HTTPS ou SSH), puis Enter:"
  read -r URL
  [ -n "${URL:-}" ] || { echo "KO: URL vide"; exit 1; }
  if git remote | grep -qx "origin"; then
    git remote set-url origin "$URL"
  else
    git remote add origin "$URL"
  fi
fi

echo
echo "=== 5) Test accès remote ==="
git ls-remote --heads origin | head -n 5 || true
echo

echo "=== 6) Push (branche de travail) ==="
BR="wolverine-ui-v2"
git checkout -b "$BR" 2>/dev/null || git checkout "$BR"

git add -A
git commit -m "Wolverine UI v2" || true

git push -u origin "$BR"
echo "DONE ✅"
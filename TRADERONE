WWW="/var/www/aquilatrader"
INDEX="$WWW/index.html"

NGX_SA="/etc/nginx/sites-available"
NGX_SE="/etc/nginx/sites-enabled"

# Try to find the *active* HTTPS vhost handling fireinners.online
pick_vhost() {
  local f real
  # Prefer enabled symlinks (real file path)
  if [ -d "$NGX_SE" ]; then
    while IFS= read -r f; do
      real="$(readlink -f "$f" 2>/dev/null || true)"
      [ -n "$real" ] || continue
      if grep -qE "server_name\s+[^;]*\b${DOMAIN}\b" "$real" 2>/dev/null \
         && grep -qE "listen\s+443" "$real" 2>/dev/null; then
        echo "$real"
        return 0
      fi
    done < <(find "$NGX_SE" -maxdepth 1 -type l 2>/dev/null | sort)
  fi

  # Fallback to known file
  if [ -f "$NGX_SA/${DOMAIN}-ssl" ]; then
    echo "$NGX_SA/${DOMAIN}-ssl"
    return 0
  fi
  if [ -f "$NGX_SA/fireinners.online-ssl" ]; then
    echo "$NGX_SA/fireinners.online-ssl"
    return 0
  fi

  return 1
}


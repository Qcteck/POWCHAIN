set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"

cp -a "$VHOST" "$VHOST.bak.$TS"

# Désactive uniquement le location /wolverine/traderone/api/ dans le VHOST
# (on touche pas /api/health ni /api/auth/)
sed -i -E 's|location[[:space:]]+\^~[[:space:]]+/wolverine/traderone/api/[[:space:]]*\{|location ^~ /_disabled_dupe_traderone_api_'"$TS"'/ {|g' "$VHOST"

nginx -t
systemctl reload nginx

echo "✅ OK. Backup: $VHOST.bak.$TS"
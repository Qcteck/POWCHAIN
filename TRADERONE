cat >/root/fix_phantom_no_hydration.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="${1:-fireinners.online}"

# Trouver index.html "live" le plus probable
TARGET=""
for f in /var/www/wolverine/index.html /usr/share/nginx/html/wolverine/index.html /srv/www/wolverine/index.html; do
  [[ -f "$f" ]] && TARGET="$f" && break
done
if [[ -z "$TARGET" ]]; then
  TARGET="$(grep -RIl --include="index.html" "__next" /var/www /usr/share/nginx/html /srv/www 2>/dev/null | grep -vi "_backup" | head -n 1 || true)"
fi
[[ -n "$TARGET" && -f "$TARGET" ]] || { echo "[ERR] index.html live introuvable"; exit 1; }

echo "[*] TARGET=$TARGET"

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$TARGET" "${TARGET}.bak_${ts}"
echo "[OK] Backup -> ${TARGET}.bak_${ts}"

# 1) Supprimer anciens patches (idempotent)
perl -0777 -i -pe '
s/<!-- PHANTOM_CONNECT_PATCH -->.*?<!-- \/PHANTOM_CONNECT_PATCH -->\s*//msi;
s/<!-- PHANTOM_BALANCE_PATCH -->.*?<!-- \/PHANTOM_BALANCE_PATCH -->\s*//msi;
s/<!-- PHANTOM_ONCLICK_PATCH -->.*?<!-- \/PHANTOM_ONCLICK_PATCH -->\s*//msi;
' "$TARGET"

# 2) Inject patch SAFE (ne modifie pas #__next ; affiche un petit overlay hors React)
if ! grep -q "PHANTOM_SAFE_PATCH" "$TARGET"; then
  perl -0777 -i -pe '
my $js = qq{
<!-- PHANTOM_SAFE_PATCH -->
<script>
(function(){
  function ensureOverlay(){
    let box = document.getElementById("__phantom_overlay");
    if(box) return box;
    box = document.createElement("div");
    box.id = "__phantom_overlay";
    box.style.cssText = "position:fixed;right:16px;bottom:16px;z-index:99999;background:rgba(0,0,0,.8);color:#fff;padding:10px 12px;border-radius:10px;font:12px/1.2 system-ui;display:none;max-width:60vw";
    document.body.appendChild(box);
    return box;
  }
  function toast(msg){
    const box = ensureOverlay();
    box.textContent = msg;
    box.style.display = "block";
    clearTimeout(window.__phantom_toast_t);
    window.__phantom_toast_t = setTimeout(()=>{ box.style.display="none"; }, 4000);
  }
  function short(pk){ return pk.slice(0,4)+"…"+pk.slice(-4); }

  async function connectPhantom(){
    if(!window.solana || !window.solana.isPhantom){
      toast("Phantom introuvable (installe/active l’extension)");
      return;
    }
    const r = await window.solana.connect();
    const pk = r.publicKey.toBase58();
    toast("Connected: " + short(pk));
    window.__WALLET_PK__ = pk;
  }

  // IMPORTANT: on attend après le load (hydration finie) avant d’accrocher le bouton
  window.addEventListener("load", function(){
    setTimeout(function(){
      const btn =
        document.querySelector(".walletBox .btn.ghost") ||
        Array.from(document.querySelectorAll("button")).find(b => /connect phantom/i.test(b.textContent||""));
      if(btn){
        btn.addEventListener("click", function(ev){
          ev.preventDefault();
          connectPhantom().catch(e => toast(String(e?.message || e)));
        }, { passive:false });
      }
      // si déjà connecté
      if(window.solana?.isPhantom && window.solana.publicKey){
        toast("Connected: " + short(window.solana.publicKey.toBase58()));
      }
    }, 1200);
  });
})();
</script>
<!-- /PHANTOM_SAFE_PATCH -->
};
s@</body>@$js\n</body>@i or die "ERR: </body> introuvable\n";
' "$TARGET"
fi

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
echo "✅ Test (cache-bust): https://${DOMAIN}/wolverine/?v=${ts}"
BASH

chmod +x /root/fix_phantom_no_hydration.sh
/root/fix_phantom_no_hydration.sh fireinners.online
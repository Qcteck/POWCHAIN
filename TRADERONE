set -e
cd /root

echo "=== 1) Confirme type module ==="
cat /opt/traderone/package.json | egrep '"type"|"name"' || true

echo
echo "=== 2) Backup + créer engine.cjs ==="
cp -v /opt/traderone/engine.js /opt/traderone/engine.js.bak.$(date +%s)
cp -v /opt/traderone/engine.js /opt/traderone/engine.cjs

echo
echo "=== 3) Patch server.js pour utiliser engine.cjs (via createRequire) ==="
cp -v /opt/traderone/server.js /opt/traderone/server.js.bak.$(date +%s)

# remplace les require("./engine") / require("./engine.js") / import ...engine...
perl -0777 -i -pe '
  s/require\((["'\''])(\.\/engine(?:\.js)?)\1\)/require($1.\/engine.cjs$1)/g;
  s/require\((["'\''])(\.\/engine\.cjs)\1\)/require($1.\/engine.cjs$1)/g;
' /opt/traderone/server.js

# si createRequire n'est pas présent, on l’ajoute au tout début
grep -q "createRequire" /opt/traderone/server.js || \
perl -0777 -i -pe 's#^#import { createRequire } from "module";\nconst require = createRequire(import.meta.url);\n\n#s' /opt/traderone/server.js

echo
echo "=== 4) Vérif rapide: engine.cjs existe et server.js pointe dessus ==="
ls -la /opt/traderone/engine.cjs
grep -nE "engine\.cjs|createRequire" /opt/traderone/server.js | head -n 20

echo
echo "=== 5) Relance REST sur 3000 ==="
sudo fuser -k 3000/tcp 2>/dev/null || true
nohup node /opt/traderone/server.js > /var/log/traderone-rest.log 2>&1 &
sleep 1

echo
echo "=== 6) Check écoute + test status ==="
ss -ltnp | egrep ':3000|:12703|:3002' || true
curl -sS -i -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' | head -n 40 || true

echo
echo "=== 7) Si ça rate: log ==="
tail -n 80 /var/log/traderone-rest.log || true
cat >/tmp/WOLVERINE_TG_RESET_OK.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
CID="5153862399"

[ -f "$ENV" ] && cp -a "$ENV" "$ENV.bak.$(date +%s)" || true

read -r -s -p "NOUVEAU TG_TOKEN = " TG; echo
[ -n "${TG:-}" ] || { echo "token vide"; exit 1; }

umask 077
printf 'TG_TOKEN=%s\nTG_CHAT_ID=%s\n' "$TG" "$CID" >"$ENV"
chmod 600 "$ENV"

# validate without leaking token
bash -lc "source '$ENV'; echo \"tokenlen=\${#TG_TOKEN} chatid=\$TG_CHAT_ID\""

# Telegram API getMe (should return ok:true)
bash -lc "source '$ENV'; curl -sS -m 8 \"https://api.telegram.org/bot\${TG_TOKEN}/getMe\" | head -c 200; echo"

systemctl restart wolverine-tg-sentinel || true
sleep 0.4

/usr/local/bin/wolv_send "WOLVERINE: new token OK (reset+getMe)" || true
echo "OK."
SH
bash /tmp/WOLVERINE_TG_RESET_OK.sh
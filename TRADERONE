cat >/tmp/fireinners_fly.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ROOT="/opt/fireinners/frontend-react/app/dist"
echo "== FIREINNERS FLY (read-only) =="
date; echo
echo "[1] Host/OS"; hostnamectl 2>/dev/null | sed -n '1,10p' || true; echo
echo "[2] Paths"
echo "ROOT=$ROOT"
test -d "$ROOT" || { echo "ERR: $ROOT introuvable"; exit 1; }
ls -la "$ROOT" | head -n 40 || true
echo
for f in "$ROOT/index.html" "$ROOT/traderone/index.html"; do
  echo "[3] Inspect: $f"
  if test -f "$f"; then
    ls -la "$f" || true
    sha256sum "$f" 2>/dev/null || true
    (command -v lsattr >/dev/null && lsattr "$f" 2>/dev/null) || true
    echo "---- head ----"; head -n 5 "$f" 2>/dev/null || true
  else
    echo "MISSING"
  fi
  echo
done
echo "[4] nginx sanity"
(command -v nginx >/dev/null && nginx -t) || echo "nginx: skip"
echo
echo "[5] local HTTP quick check"
(command -v curl >/dev/null && curl -fsS -I http://127.0.0.1/ | sed -n '1,12p') || echo "curl: skip"
echo "== OK =="
BASH
bash /tmp/fireinners_fly.sh
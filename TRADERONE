bash -lc 'set -euo pipefail
WD="/root/robo600_blueprint_video"
WEB="/var/www/wolverine/blueprint"
mkdir -p "$WD" "$WEB"
cd "$WD"

echo "[1/5] Dépendances (ffmpeg + matplotlib + pillow)"
export DEBIAN_FRONTEND=noninteractive
apt-get update -y >/dev/null
apt-get install -y ffmpeg python3 python3-matplotlib python3-pil >/dev/null

echo "[2/5] Écriture du script Python"

cat >/root/diag_nginx_500_wolverine.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="${1:-fireinners.online}"

echo "== nginx -t =="
nginx -t 2>&1 | tail -n 30 || true
echo

echo "== last nginx errors =="
tail -n 200 /var/log/nginx/error.log | tail -n 120 || true
echo

echo "== show /wolverine/ location in ssl vhost =="
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
nl -ba "$VHOST" | sed -n '1,260p' | sed -n '/listen 443/,+220p' | sed -n '/location \^~ \/wolverine\//,+40p' || true
echo

echo "== check publish dir =="
ls -la /var/www/wolverine | head -n 30 || true
echo
ls -la /var/www/wolverine/index.html 2>/dev/null || echo "[ERR] index.html missing in /var/www/wolverine"
BASH
chmod +x /root/diag_nginx_500_wolverine.sh
/root/diag_nginx_500_wolverine.sh fireinners.online
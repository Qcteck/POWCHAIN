set -e
APP="/opt/traderone-opt"
cd "$APP"

echo "=== 1) Ports 3000/8585 ==="
ss -ltnp | egrep ':3000|:8585' || true
echo

echo "=== 2) Qui prend 8585 (PID + cmdline) ==="
PID8585=$(ss -ltnp | sed -n 's/.*:8585.*pid=\([0-9]\+\).*/\1/p' | head -n1)
echo "PID8585=$PID8585"
if [ -n "$PID8585" ]; then
  ps -fp "$PID8585" || true
  echo "--- cmdline ---"
  tr '\0' ' ' < /proc/"$PID8585"/cmdline 2>/dev/null || true
  echo
fi
echo

echo "=== 3) Stopper 8585 si c'est un vieux /opt/traderone-opt/server.js ==="
if [ -n "$PID8585" ]; then
  if tr '\0' ' ' < /proc/"$PID8585"/cmdline 2>/dev/null | grep -qiE '/opt/traderone-opt/server\.js|/opt/traderone-opt/.*node'; then
    echo "KILL old traderone on 8585 (PID $PID8585)"
    kill "$PID8585" || true
    sleep 1
    kill -9 "$PID8585" 2>/dev/null || true
  else
    echo "⚠️ 8585 n'est pas clairement un vieux traderone -> je ne tue pas auto."
  fi
fi
echo

echo "=== 4) PM2 status ==="
pm2 ls || true
echo

echo "=== 5) Nginx: vérifier proxy_pass (8585 vs 3000) ==="
grep -RIn --line-number -E "proxy_pass|127\.0\.0\.1:8585|127\.0\.0\.1:3000" /etc/nginx/sites-enabled | head -n 120 || true
echo

echo "=== 6) Reload nginx (si config OK) ==="
nginx -t
systemctl reload nginx
echo "nginx reloaded"
echo

echo "=== 7) Re-check ports ==="
ss -ltnp | egrep ':3000|:8585' || true
echo

echo "=== 8) Tests locaux ==="
curl -sS -i http://127.0.0.1:3000/health | head -n 20 || true
echo

curl -sS -i -X POST "http://127.0.0.1:3000/api/swap" \

cat >/root/fix_wolverine_rpc_403.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup =="
cp -a "$SNIP" "${SNIP}.bak_${TS}"
echo "Saved: ${SNIP}.bak_${TS}"

echo
echo "== Patch solana_rpc_proxy.conf (strip Origin/Referer; optional UA) =="
# On ajoute les headers si pas déjà présents
grep -q 'proxy_set_header Origin' "$SNIP" || cat >>"$SNIP" <<'EOF'

  # --- PATCH: avoid upstream WAF rejecting browser/Phantom headers ---
  # Many Solana RPC providers block browser origins / wallet UAs.
  proxy_set_header Origin "";
  proxy_set_header Referer "";
  # If still 403, uncomment next line to force a neutral UA:
  # proxy_set_header User-Agent "curl/8.5.0";
  # --- END PATCH ---
EOF

echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx

echo
echo "== Tests =="
echo "-- 1) Server-style (should be 200) --"
curl -sS -D- https://$DOMAIN/wolverine/rpc \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | head -n 30

echo
echo "-- 2) Phantom-style (currently 403) --"
curl -sS -D- https://$DOMAIN/wolverine/rpc \
  -H 'content-type: application/json' \
  -H 'origin: https://'"$DOMAIN" \
  -H 'referer: https://'"$DOMAIN"'/wolverine/' \
  -H 'user-agent: Mozilla/5.0 (iPhone; CPU iPhone OS 18_6_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 Phantom/ios/25.46.3.39417' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | head -n 40

echo
echo "-- 3) Phantom UA but NO Origin/Referer (should become 200 if WAF was the issue) --"
curl -sS -D- https://$DOMAIN/wolverine/rpc \
  -H 'content-type: application/json' \
  -H 'user-agent: Mozilla/5.0 (iPhone; CPU iPhone OS 18_6_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 Phantom/ios/25.46.3.39417' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | head -n 40

echo
echo "DONE ✅  (if #3 is 200, the culprit was Origin/Referer forwarded to upstream)"
BASH

chmod +x /root/fix_wolverine_rpc_403.sh
/root/fix_wolverine_rpc_403.sh
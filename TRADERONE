cat >/root/TRADERONE_FIX.sh <<'SH'
#!/bin/bash
set -e

APP_DIR="/opt/traderone"
ENV_FILE="$APP_DIR/.env"

echo "[1] Dépendances"
cd "$APP_DIR"
npm install bs58 @solana/web3.js --silent

echo "[2] Vérification .env"
if ! grep -q SOLANA_PRIVATE_KEY_BASE58 "$ENV_FILE"; then
  echo "❌ SOLANA_PRIVATE_KEY_BASE58 manquant dans .env"
  exit 1
fi

echo "[3] Patch server.js"
cat >"$APP_DIR/server.js" <<'JS'
import http from "http";
import bs58 from "bs58";
import {Keypair, PublicKey} from "@solana/web3.js";

const PORT = process.env.PORT || 3000;

const pk58 = process.env.SOLANA_PRIVATE_KEY_BASE58;
if (!pk58) throw new Error("Missing private key");

const kp = Keypair.fromSecretKey(bs58.decode(pk58));
const PUBLIC = kp.publicKey.toBase58();

const server = http.createServer(async (req,res)=>{
  if(req.url==="/health"){
    res.writeHead(200);res.end("ok");return;
  }

  res.writeHead(200,{"Content-Type":"text/html"});
  res.end(`
<html>
<body style="background:#111;color:#eee;font-family:Arial">
<h2>TraderOne LIVE</h2>
<p><b>Wallet interne :</b></p>
<pre>${PUBLIC}</pre>

<input id="amt" value="0.001"/>
<button onclick="send()">Envoyer budget</button>
<pre id="out"></pre>

<script>
async function send(){
 const r=await fetch('/start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount:document.getElementById('amt').value})});
 out.textContent=JSON.stringify(await r.json(),null,2);
}
</script>
</body>
</html>
`);
});

server.listen(PORT,"0.0.0.0",()=>console.log("TraderOne LIVE on",PORT));
JS

echo "[4] UFW ouverture port 3000"
ufw allow 3000/tcp || true

echo "[5] PM2 restart"
pm2 delete traderone || true
pm2 start "$APP_DIR/server.js" --name traderone
pm2 save

echo "✅ FIX OK → http://IP:3000"
SH

chmod +x /root/TRADERONE_FIX.sh
/root/TRADERONE_FIX.sh
bash <<'BASH'
set -euo pipefail
APPDIR="/opt/fireinners/wolverine-api"
ENVF="$APPDIR/.env"
WALLET_JSON="$APPDIR/custody.keypair.json"
WALLET_PUB="$APPDIR/custody.pub"
SERVICE="wolverine-api"
say(){ printf "%s\n" "$*"; }

# unlock if immutable
chattr -i "$WALLET_JSON" 2>/dev/null || true
chattr -i "$WALLET_PUB" 2>/dev/null || true
chattr -i "/etc/systemd/system/$SERVICE.service" 2>/dev/null || true

mkdir -p "$APPDIR"
touch "$ENVF"

# ensure env points to the keypair
grep -qE "^CUSTODY_KEYPAIR=" "$ENVF" || echo "CUSTODY_KEYPAIR=$WALLET_JSON" >> "$ENVF"

is_valid_keypair(){
  node -e "const fs=require('fs');try{const s=fs.readFileSync('$WALLET_JSON','utf8');const a=JSON.parse(s);process.exit(Array.isArray(a)&&a.length>=32?0:1)}catch(e){process.exit(1)}"
}

gen_keypair(){
  say "REGEN custody keypair..."
  node - <<NODE
const fs=require("fs");
const {Keypair}=require("@solana/web3.js");
const kp=Keypair.generate();
fs.writeFileSync("$WALLET_JSON", JSON.stringify(Array.from(kp.secretKey)));
fs.writeFileSync("$WALLET_PUB", kp.publicKey.toBase58());
process.stdout.write(kp.publicKey.toBase58());
NODE
  echo
  chmod 600 "$WALLET_JSON" 2>/dev/null || true
  chmod 644 "$WALLET_PUB" 2>/dev/null || true
}

# validate or regenerate
if [ ! -s "$WALLET_JSON" ]; then
  gen_keypair
else
  if ! is_valid_keypair; then
    say "Keypair invalid -> reset"
    rm -f "$WALLET_JSON" "$WALLET_PUB" || true
    gen_keypair
  fi
fi

# ensure custody.pub exists and matches
if [ ! -s "$WALLET_PUB" ]; then
  node - <<NODE
const fs=require("fs");
const {Keypair}=require("@solana/web3.js");
const arr=JSON.parse(fs.readFileSync("$WALLET_JSON","utf8"));
const kp=Keypair.fromSecretKey(Uint8Array.from(arr));
fs.writeFileSync("$WALLET_PUB", kp.publicKey.toBase58());
NODE
  chmod 644 "$WALLET_PUB" 2>/dev/null || true
fi

# restart service
systemctl daemon-reload
systemctl restart "$SERVICE.service" || true

# show deposit address + quick health
CUST="$(cat "$WALLET_PUB" 2>/dev/null || true)"
say "Deposit (SOL/USDC): $CUST"
curl -fsS "https://fireinners.online/wolverine/api/health" || true
echo
BASH
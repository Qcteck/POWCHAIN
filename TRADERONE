# package.json
PKG="$(cat <<'JSON'
{"name":"wolverine-api","version":"1.0.0","private":true,"type":"commonjs","main":"server.js","scripts":{"start":"node server.js"},"dependencies":{"@solana/web3.js":"^1.95.4","bs58":"^5.0.0","dotenv":"^16.4.5","express":"^4.19.2"}}

set -e
cd /root

echo "=== 1) Upstream vivant ? (3002 gateway) ==="
ss -lptn 'sport = :3002' || true
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" \
  -H "content-type: application/json" --data '{}' | head -n 30 || true

echo
echo "=== 2) Status service wolverine-api ==="
systemctl --no-pager -l status wolverine-api.service | tail -n 60 || true
journalctl -u wolverine-api.service -n 60 --no-pager || true

echo
echo "=== 3) Logs nginx (cause du 502) ==="
tail -n 80 /var/log/nginx/error.log || true

echo
echo "=== 4) Test public SANS clé (devrait être 403, pas 502) ==="
BASE="https://fireinners.online/wolverine/traderone/api"
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" --data '{}' | head -n 25

echo
echo "=== 5) Test public AVEC clé (elle ne s’affiche pas) ==="
echo "Tape ta clé puis ENTER :"
read -s KEY
echo
curl -sS -i -X POST "$BASE/status" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KEY" --data '{}' | head -n 40
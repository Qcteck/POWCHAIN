function getPhaseLune() {
  const dateRefNouvelle = new Date('2026-01-09T00:00:00Z'); // nouvelle lune de référence
  const dateActuelle = new Date();

  const diffSec = (dateActuelle - dateRefNouvelle) / 1000;
  const cycle = 29.530588853 * 86400;
  const fraction = ((diffSec % cycle) + cycle) % cycle / cycle; // robustesse si diffSec négatif

  if (fraction < 0.03 || fraction > 0.97) {
    return 'lune noire (nouvelle) – marée basse';
  }

  if (fraction >= 0.47 && fraction <= 0.53) {
    return 'lune pleine – marée extrême';
  }

  if ((fraction >= 0.22 && fraction <= 0.28) || (fraction >= 0.72 && fraction <= 0.78)) {
    return 'quartiers – marée faible';
  }

  return 'lune vivante – marée moyenne';
}
bash -lc 'cat >/root/MEGA_VPS_MENAGE_NO_GIT.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail

# SAFE DEFAULTS
: "${VACUUM_JOURNAL_DAYS:=14}"
: "${ALLOW_APT_AUTOREMOVE:=0}"   # 0=safe (no package removal)
: "${QUARANTINE_BAKS:=1}"        # move backups to quarantine
: "${QUARANTINE_MIXED:=1}"       # move suspicious "html+bash" files to quarantine

TS="$(date -u +%Y%m%d-%H%M%S)"
LOG="/root/vps_menage_no_git_${TS}.log"
Q="/opt/_quarantine_vps_${TS}"
mkdir -p "$Q"

say(){ echo "[$(date -u +%F\ %T)] $*" | tee -a "$LOG"; }
run(){ say "+ $*"; "$@" >>"$LOG" 2>&1 || { say "ERR: $*"; return 1; }; }

[ "$(id -u)" -eq 0 ] || { echo "ERR: run as root" >&2; exit 1; }

say "MEGA VPS MENAGE (NO GIT) TS=$TS"
say "Quarantine: $Q"
say "Before disk:"
df -hT | tee -a "$LOG"

# 1) apt cache (safe)
say "1) apt cache clean (safe)"
if command -v apt-get >/dev/null 2>&1; then
  run apt-get -y clean || true
  run apt-get -y autoclean || true
  if [ "$ALLOW_APT_AUTOREMOVE" = "1" ]; then
    say "ALLOW_APT_AUTOREMOVE=1 -> autoremove enabled"
    run apt-get -y autoremove || true
  else
    say "Skipping apt-get autoremove (set ALLOW_APT_AUTOREMOVE=1 to enable)."
  fi
else
  say "apt-get not found, skipping."
fi

# 2) journald vacuum (safe)
say "2) journald vacuum (safe)"
if command -v journalctl >/dev/null 2>&1; then
  run journalctl --vacuum-time="${VACUUM_JOURNAL_DAYS}d" || true
else
  say "journalctl not found, skipping."
fi

# 3) fix /root/.profile cargo spam (safe)
say "3) Fix /root/.profile cargo env spam (safe)"
PROFILE="/root/.profile"
CARGO_LINE='[ -f /root/.cargo/env ] && . /root/.cargo/env'
if [ -f "$PROFILE" ]; then
  if grep -q '/root/.cargo/env' "$PROFILE"; then
    # remove bare source line(s) and replace with guarded line (idempotent)
    tmp="$(mktemp)"
    awk '
      /\/root\/\.cargo\/env/ {next}
      {print}
    ' "$PROFILE" >"$tmp"
    # append guarded line once
    if ! grep -qxF "$CARGO_LINE" "$tmp"; then
      echo "" >>"$tmp"
      echo "$CARGO_LINE" >>"$tmp"
    fi
    cp -a "$PROFILE" "$Q/root.profile.backup_${TS}" || true
    mv "$tmp" "$PROFILE"
    say "Updated /root/.profile (backup in $Q/root.profile.backup_${TS})"
  else
    say "/root/.profile has no cargo env line."
  fi
else
  say "/root/.profile not found."
fi

# Targets to quarantine backups
TARGETS=(
  "/opt/fireinners/frontend-react/app/dist/wolverine"
  "/opt/fireinners/frontend-react/app/dist"
  "/opt/fireinners"
  "/opt/traderone-opt"
  "/TRADERONE"
  "/root"
)

# 4) quarantine backups (*.bak*, *~, *.old)
say "4) Quarantine backups (*.bak*, *~, *.old) (safe move)"
if [ "$QUARANTINE_BAKS" = "1" ]; then
  mkdir -p "$Q/baks"
  for base in "${TARGETS[@]}"; do
    [ -d "$base" ] || continue
    say "Scan backups: $base"
    while IFS= read -r f; do
      # exclusions: do not touch sentinel/charte
      case "$f" in
        /opt/fireinners/sentinel/*) continue ;;
        /opt/fireinners/CHARTE_FIREINNERS.*) continue ;;
      esac
      rel="${f#/}"
      dest="$Q/baks/$rel"
      mkdir -p "$(dirname "$dest")"
      if [ ! -e "$dest" ]; then
        say "MOVE backup -> $dest"
        mv -n "$f" "$dest" 2>>"$LOG" || true
      fi
    done < <(find "$base" -type f \( -name "*.bak" -o -name "*.bak*" -o -name "*~" -o -name "*.old" \) 2>/dev/null)
  done
else
  say "QUARANTINE_BAKS=0 -> skipping."
fi

# 5) quarantine suspicious mixed files (html + bash markers)
say "5) Quarantine suspicious mixed files (html + bash markers)"
if [ "$QUARANTINE_MIXED" = "1" ]; then
  mkdir -p "$Q/mixed"
  for base in "${TARGETS[@]}"; do
    [ -d "$base" ] || continue
    say "Scan mixed: $base"
    # look at .html* files for bash markers
    while IFS= read -r f; do
      # quick grep (safe)
      if grep -aEq '(^|[[:space:]])(set -euo pipefail|apt-get|journalctl|#!/usr/bin/env bash|find /|mv -n|git )' "$f" 2>/dev/null; then
        rel="${f#/}"
        dest="$Q/mixed/$rel"
        mkdir -p "$(dirname "$dest")"
        if [ ! -e "$dest" ]; then
          say "MOVE mixed -> $dest"
          mv -n "$f" "$dest" 2>>"$LOG" || true
        fi
      fi
    done < <(find "$base" -type f \( -name "*.html" -o -name "*.html.*" -o -name "*.bakfix*" \) 2>/dev/null)
  done
else
  say "QUARANTINE_MIXED=0 -> skipping."
fi

say "After disk:"
df -hT | tee -a "$LOG"

say "Quarantine size:"
du -sh "$Q" 2>/dev/null | tee -a "$LOG" || true

say "DONE."
say "Log: $LOG"
say "Quarantine: $Q"
BASH
chmod +x /root/MEGA_VPS_MENAGE_NO_GIT.sh
bash /root/MEGA_VPS_MENAGE_NO_GIT.sh'
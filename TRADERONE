chmod 755 "$WEBDIR" || true

# nginx snippet (serve /wolverine/ + proxy /wolverine/api/)
read -r -d "" NGSNIP <<EOF
location ^~ /wolverine/api/ {
  proxy_pass http://127.0.0.1:3050/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  add_header Cache-Control "no-store, max-age=0" always;
}
location ^~ /wolverine/ {
  alias $WEBDIR/;
  try_files \$uri \$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store, max-age=0" always;
}
EOF
askorupdate_file "$SNIP" "WOLVERINE nginx snippet" "$NGSNIP"

# include snippet into vhost if missing (safe insert before last } in server block)
chattr -i "$NG" 2>/dev/null || true
if ! grep -q "snippets/fireinners-wolverine.conf" "$NG"; then
  cp -a "$NG" "$NG.bak.$(date -u +%Y%m%d%H%M%S)" || true
  awk -v ins="    include snippets/fireinners-wolverine.conf;" '
    BEGIN{added=0}
    {lines[NR]=$0}
    END{
      # insert include before the last "}" of file (good enough for single server block)
      for(i=1;i<=NR;i++){
        if(i==NR && !added){
          # try to insert before last }
        }
      }
      last=NR
      for(i=NR;i>=1;i--){ if(lines[i] ~ /^[[:space:]]*}[[:space:]]*$/){ last=i; break; } }
      for(i=1;i<=NR;i++){
        if(i==last && !added){ print ins; added=1; }
        print lines[i]
      }
    }' "$NG" >"$NG.tmp"
  mv "$NG.tmp" "$NG"
fi

nginx -t
systemctl reload nginx
chattr +i "$SNIP" 2>/dev/null || true
chattr +i "$NG" 2>/dev/null || true


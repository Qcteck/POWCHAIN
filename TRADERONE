cat >/root/WOLVERINE_FIX_SOL_USDC.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "Backup..."
cp "$HTML" "$HTML.bak_$TS" 2>/dev/null || true

echo "Write clean HTML..."

cat >"$HTML" <<'HTML'
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>WOLVERINE</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{margin:0;background:#0b0f14;color:#00eaff;font-family:Arial;height:100vh;display:flex;align-items:center;justify-content:center}
#box{border:2px solid #00eaff;padding:20px;width:380px;text-align:center}
button{width:100%;padding:10px;margin:6px 0;font-size:16px;background:#111;color:#00eaff;border:1px solid #00eaff;cursor:pointer}
button:hover{background:#00eaff;color:#000}
.addr{word-break:break-all;font-size:13px;margin-top:8px}
.row{margin-top:6px}
</style>
</head>
<body>

<div id="box">
  <button onclick="connect()">Connect Wallet</button>
  <button onclick="refresh()">Refresh</button>
  <div class="addr" id="addr"></div>
  <div class="row">SOL: <span id="sol">-</span></div>
  <div class="row">USDC: <span id="usdc">-</span></div>
</div>

<script>
const RPC="https://rpc.ankr.com/solana";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
let PUB=null;

async function rpc(method,params){
  const r=await fetch(RPC,{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({jsonrpc:"2.0",id:1,method,params})
  });
  const j=await r.json();
  if(j.error) throw j.error;
  return j.result;
}

async function connect(){
  if(!window.solana||!window.solana.isPhantom){
    alert("Phantom not found");
    return;
  }
  const r=await window.solana.connect();
  PUB=r.publicKey.toString();
  document.getElementById("addr").textContent=PUB;
  await refresh();
}

async function refresh(){
  if(!PUB) return;

  const b=await rpc("getBalance",[PUB]);
  document.getElementById("sol").textContent=(b.value/1e9).toFixed(4);

  const t=await rpc("getTokenAccountsByOwner",[
    PUB,
    {mint:USDC_MINT},
    {encoding:"jsonParsed"}
  ]);

  let u=0;
  if(t.value.length){
    u=t.value[0].account.data.parsed.info.tokenAmount.uiAmount;
  }
  document.getElementById("usdc").textContent=u;
}
</script>

</body>
</html>
HTML

chown www-data:www-data "$HTML"
chmod 644 "$HTML"

echo "DONE"
echo "Backup: $HTML.bak_$TS"
echo "Reload page with CTRL+SHIFT+R"
BASH
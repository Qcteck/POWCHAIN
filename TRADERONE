#!/bin/bash
set -e

FRONT="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

echo "=== WOLVERINE • MENU COULEURS AVEC CONFIRMATION ==="

node <<'NODE'
const fs=require("fs");
let h=fs.readFileSync(process.env.FRONT||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html","utf8");

if(!h.includes("optionsPanel")){
h=h.replace("</body>",`
<!-- OPTIONS PANEL -->
<div id="optionsPanel" style="position:fixed;top:20px;right:20px;background:rgba(0,0,0,.5);padding:15px;border-radius:12px;color:#fff;z-index:999">
<b>Options</b><br><br>

<label>Couleur :</label><br>
<select id="colorSelect">
 <option value="pink">Rose</option>
 <option value="turquoise">Turquoise</option>
 <option value="violet">Violet</option>
 <option value="mix">Mix</option>
</select><br><br>

<label>Transparence</label><br>
<input type="range" id="alphaRange" min="0.1" max="1" step="0.05" value="0.9"><br><br>

<button onclick="confirmColors()">Appliquer</button>
</div>

<script>
const THEMES={
 pink:{bg:["#ff4fd8","#ff8ccf"],btn:"#ffb3e6",line:"#ffd6f2",text:"#fff"},
 turquoise:{bg:["#30e3ca","#1fc8b5"],btn:"#7ff5e0",line:"#b2fff1",text:"#fff"},
 violet:{bg:["#7b5cff","#b19cff"],btn:"#c9baff",line:"#e0d7ff",text:"#fff"},
 mix:{bg:["#ff4fd8","#30e3ca"],btn:"#ffffff",line:"#ffffff",text:"#fff"}
};

function applyTheme(t,alpha){
 document.body.style.background=
  "linear-gradient(135deg,"+THEMES[t].bg[0]+","+THEMES[t].bg[1]+")";
 document.querySelectorAll("button").forEach(b=>{
  b.style.background=THEMES[t].btn;
  b.style.opacity=alpha;
 });
 document.querySelectorAll("hr").forEach(l=>{
  l.style.borderColor=THEMES[t].line;
 });
 document.body.style.color=THEMES[t].text;
}

function confirmColors(){
 const t=document.getElementById("colorSelect").value;
 const a=document.getElementById("alphaRange").value;
 if(confirm("Confirmer le changement de couleur ?")){
  localStorage.setItem("theme",t);
  localStorage.setItem("alpha",a);
  applyTheme(t,a);
 }
}

(function(){
 const t=localStorage.getItem("theme")||"mix";
 const a=localStorage.getItem("alpha")||0.9;
 applyTheme(t,a);
})();
</script>
</body>`);
}

fs.writeFileSync(process.env.FRONT||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html",h);
NODE

nginx -t && systemctl reload nginx

echo "✅ Menu Options + couleurs confirmées installé"
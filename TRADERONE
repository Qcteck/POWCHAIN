def strip_agentia(block_lines):
    out=[]
    k=0
    while k < len(block_lines):
        ln=block_lines[k]
        # drop any existing /agentia locations to avoid collisions
        if re.search(r'^\s*location\s*(=|\^~)?\s*/agentia\b', ln):

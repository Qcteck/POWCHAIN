set -euo pipefail
DOMAIN="fireinners.online"
TS="$(date +%s)"
BK="/root/nginx_backup_$TS"
SNIP="/etc/nginx/snippets/wolv_rpc_proxy.conf"
TMP="/tmp/nginxT.$TS.txt"

mkdir -p "$BK" /etc/nginx/snippets

echo "== 1) nginx must be OK =="
nginx -t

echo "== 2) write RPC proxy snippet (adds proof header) =="
cat > "$SNIP" <<'EOF'
# Wolverine: Solana RPC proxy (same-origin)
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  add_header X-Wolv-RPC "1" always;

  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF

echo "== 3) dump final nginx config =="
nginx -T > "$TMP" 2>&1

echo "== 4) find candidate conf files that declare $DOMAIN and listen 443 =="
mapfile -t FILES < <(
  awk -v d="$DOMAIN" '
    /^# configuration file /{f=$4; sub(/:$/,"",f)}
    $0 ~ /server_name/ && $0 ~ d {hit[f]=1}
    $0 ~ /listen/ && $0 ~ /443/ {ls[f]=1}
    END{for(k in hit) if(ls[k]) print k}
  ' "$TMP" | sort -u
)

echo "Candidates:"
printf ' - %s\n' "${FILES[@]:-NONE}"
[ "${#FILES[@]}" -gt 0 ] || { echo "ERR: no candidate files found for $DOMAIN on 443"; exit 1; }

echo "== 5) inject include snippet inside matching server{} blocks (domain + 443) =="
for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  cp -a "$f" "$BK/$(basename "$f").$TS"
  echo "Backup -> $BK/$(basename "$f").$TS"

  # If already included, skip
  if grep -qF "include $SNIP;" "$f"; then
    echo "OK include already present in $f"
    continue
  fi

  # Inject include inside server blocks that mention domain (best-effort)
  perl -0777 -i -pe '
    my $snip = "  include /etc/nginx/snippets/wolv_rpc_proxy.conf;\n";
    s{
      (server\s*\{[\s\S]*?server_name[\s\S]*?fireinners\.online[\s\S]*?\n)
    }{$1$snip}gex;
  ' "$f"

  echo "Injected include into $f (if matching server_name block found)"
done

echo "== 6) nginx test + reload =="
nginx -t
systemctl reload nginx

echo "== 7) TEST (must show X-Wolv-RPC: 1, and not 404) =="
curl -ksS -i "https://$DOMAIN/wolverine/traderone/api/rpc" \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 60
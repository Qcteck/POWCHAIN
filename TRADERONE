bash -lc 'set -euo pipefail
APPDIR="/opt/fireinners/wolverine-api"
ENVF="$APPDIR/.env"
SERVICE="wolverine-api"
ASKOR="/opt/fireinners/sentinel/lib/askorupdate.sh"
say(){ printf "%s\n" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: $1 manquant"; exit 1; }; }
need node; need npm; need systemctl; need curl

if [ -f "$ASKOR" ]; then . "$ASKOR"; else
  askorupdate_file(){ local p="$1" n="$2" c="$3"; [ -f "$p" ] && cp -a "$p" "$p.bak.$(date -u +%Y%m%dT%H%M%SZ)" || true; umask 077; mkdir -p "$(dirname "$p")"; cat >"$p" <<<"$c"; }
  askorupdate_yesno(){ return 0; }
fi

[ -f "$ENVF" ] || { say "ERREUR: $ENVF absent"; exit 1; }

# Ensure env keys exist (append if missing)
ensure_kv(){ local k="$1" v="$2"; grep -qE "^${k}=" "$ENVF" || echo "${k}=${v}" >> "$ENVF"; }
ensure_kv "MONITOR_URL" "https://bbbotrader.paycashnostory.workers.dev/ping"
ensure_kv "MONITOR_SEC" "10"
ensure_kv "MONITOR_FAILS" "3"
ensure_kv "TG_ALERTS" "0"
ensure_kv "WOLV_SEND" "/usr/local/bin/wolv_send"

SVR="$(cat <<'"'"'JS'"'"'
"use strict";
require("dotenv").config();
const fs=require("fs");
const path=require("path");
const express=require("express");
const {execFile}=require("child_process");
const bs58=require("bs58");
const {Connection,PublicKey,Keypair}=require("@solana/web3.js");

const PORT=+(process.env.PORT||3050);
const RPC_URL=process.env.RPC_URL||"https://api.mainnet-beta.solana.com";
const RPC_FALLBACKS=(process.env.RPC_FALLBACKS||"").split(",").map(s=>s.trim()).filter(Boolean);
const USDC_MINT=process.env.USDC_MINT||"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const JUP_PROXY_BASE=(process.env.JUP_PROXY_BASE||"").replace(/\/$/,"");
const PING_URL=process.env.PING_URL||"";
const MONITOR_URL=process.env.MONITOR_URL||PING_URL||"";
const MONITOR_SEC=Math.max(0,+(process.env.MONITOR_SEC||0));
const MONITOR_FAILS=Math.max(1,+(process.env.MONITOR_FAILS||3));
const TG_ALERTS=String(process.env.TG_ALERTS||"0")==="1";
const WOLV_SEND=process.env.WOLV_SEND||"/usr/local/bin/wolv_send";
const STATE_FILE=process.env.STATE_FILE||"/var/lib/wolverine-api/state.json";
const KEYPAIR_PATH=process.env.KEYPAIR_PATH||"/var/lib/wolverine-api/custody.json";
const ALLOW_ORIGIN=process.env.ALLOW_ORIGIN||"*";

const app=express();
app.use(express.json({limit:"1mb"}));
app.use((req,res,next)=>{res.setHeader("Access-Control-Allow-Origin",ALLOW_ORIGIN);res.setHeader("Access-Control-Allow-Methods","GET,POST,OPTIONS");res.setHeader("Access-Control-Allow-Headers","content-type");if(req.method==="OPTIONS")return res.status(204).end();next();});

/* accept /wolverine/api/* or /api/* */
app.use((req,res,next)=>{
  const u=req.url||"/";
  const P=["/wolverine/api","/api","/wolverine/traderone/api"];
  for(const pre of P){
    if(u===pre){ req.url="/"; break; }
    if(u.startsWith(pre+"/")){ req.url=u.slice(pre.length)||"/"; break; }
  }
  next();
});

const ENDPOINTS=[RPC_URL,...RPC_FALLBACKS].filter(Boolean);
let ep_i=0;
const conn=()=>new Connection(ENDPOINTS[ep_i%ENDPOINTS.length],{commitment:"confirmed"});
async function withConn(fn){
  let last=null;
  for(let k=0;k<Math.min(ENDPOINTS.length,3);k++){
    const c=conn();
    try{return await fn(c);}catch(e){last=e;ep_i++;}
  }
  throw last||new Error("rpc_failed");
}

function safeReadJSON(p,def){ try{return JSON.parse(fs.readFileSync(p,"utf8"));}catch{return def;} }
function safeWriteJSON(p,obj){
  fs.mkdirSync(path.dirname(p),{recursive:true});
  const tmp=p+".tmp."+Date.now();
  fs.writeFileSync(tmp,JSON.stringify(obj,null,2),{mode:0o600});
  fs.renameSync(tmp,p);
}

function loadKeypair(){
  const raw=fs.readFileSync(KEYPAIR_PATH,"utf8").trim();
  let arr=null;
  try{arr=JSON.parse(raw);}catch{
    try{arr=Array.from(bs58.decode(raw));}catch{throw new Error("bad_keypair_format");}
  }
  if(!Array.isArray(arr)) throw new Error("bad_keypair_json");
  return Keypair.fromSecretKey(Uint8Array.from(arr));
}
let KP=null,CUSTODY_PUB=null;
function ensureKP(){ if(!KP){ KP=loadKeypair(); CUSTODY_PUB=KP.publicKey.toBase58(); } }

const STATE_DEFAULT={running:false,mode:"safe_dca",budget_usdc:0,spent_usdc:0,mint:"",last:{},createdAt:Date.now()};
let STATE=safeReadJSON(STATE_FILE,STATE_DEFAULT);

/* balances helpers */
async function solBalance(pub){return withConn(async c=>(await c.getBalance(new PublicKey(pub)))/1e9);}
async function usdcBalance(pub){
  return withConn(async c=>{
    const owner=new PublicKey(pub), mint=new PublicKey(USDC_MINT);
    const accts=await c.getParsedTokenAccountsByOwner(owner,{mint});
    let sum=0; for(const it of accts.value){const ui=it.account.data.parsed.info.tokenAmount.uiAmount; if(typeof ui==="number") sum+=ui;}
    return sum;
  });
}

/* TG send (optional) */
function tgSend(msg){
  if(!TG_ALERTS) return;
  execFile(WOLV_SEND,[String(msg)],{timeout:8000},()=>{});
}

/* ===== PING LOOP ===== */
let loopTimer=null;
let loopState={enabled:false,url:MONITOR_URL||"",sec:MONITOR_SEC||0,fails:0,effective:"INIT",lastText:"",lastTs:0,lastOkTs:0};
async function doPing(url){
  if(!url) return {ok:false,text:"no_url"};
  const r=await fetch(url,{method:"GET"});
  const t=await r.text();
  return {ok:(t||"").toLowerCase().includes("pong"),text:(t||"").slice(0,120)};
}
async function tick(){
  try{
    const {ok,text}=await doPing(loopState.url);
    loopState.lastText=text; loopState.lastTs=Date.now();
    if(ok){ loopState.fails=0; loopState.lastOkTs=loopState.lastOkTs||loopState.lastTs; }
    else { loopState.fails++; }
    const prev=loopState.effective;
    const now = ok ? "UP" : (loopState.fails>=MONITOR_FAILS ? "DOWN" : "FLAKY");
    loopState.effective=now;
    if(prev!==now){
      tgSend(`WOLVERINE: PING ${now} (${prev} -> ${now}) ${new Date().toISOString()} url=${loopState.url}`);
    }
  }catch(e){
    loopState.fails++;
    const prev=loopState.effective;
    const now = loopState.fails>=MONITOR_FAILS ? "DOWN" : "FLAKY";
    loopState.effective=now;
    loopState.lastText=String(e&&e.message||e).slice(0,120);
    loopState.lastTs=Date.now();
    if(prev!==now){
      tgSend(`WOLVERINE: PING ${now} (err) ${new Date().toISOString()} url=${loopState.url}`);
    }
  }
}
function startLoop(sec,url){
  const s=Math.max(1,+(sec||loopState.sec||10));
  const u=(url||loopState.url||"").trim();
  loopState.enabled=true; loopState.sec=s; loopState.url=u;
  if(loopTimer) clearInterval(loopTimer);
  loopTimer=setInterval(tick,s*1000);
  tick();
}
function stopLoop(){
  loopState.enabled=false;
  if(loopTimer) clearInterval(loopTimer);
  loopTimer=null;
}

/* routes */
app.get("/",(req,res)=>res.type("text/plain").send("wolverine-api"));
app.get("/health",(req,res)=>res.json({ok:true,uptime:process.uptime(),ts:Date.now()}));
app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));

app.get("/config",(req,res)=>{
  ensureKP();
  res.json({ok:true,api:"wolverine-api",port:PORT,rpc:ENDPOINTS[ep_i%ENDPOINTS.length]||null,custodyPubkey:CUSTODY_PUB,usdcMint:USDC_MINT,jupProxyBase:JUP_PROXY_BASE||null,pingUrl:PING_URL||null,monitorUrl:loopState.url||null,monitorSec:loopState.sec||null});
});

app.get("/monitorPing",async(req,res)=>{try{res.json({ok:true,...await doPing(loopState.url||MONITOR_URL||PING_URL||"")});}catch(e){res.status(400).json({ok:false,error:String(e&&e.message||e)});}});

app.get("/bot/ping/status",(req,res)=>res.json({ok:true,...loopState,ts:Date.now(),tgAlerts:TG_ALERTS,failThreshold:MONITOR_FAILS}));

app.post("/bot/ping/start",(req,res)=>{
  const sec=+(req.body&&req.body.sec||0)||loopState.sec||10;
  const url=String(req.body&&req.body.url||"")||loopState.url||MONITOR_URL||PING_URL||"";
  startLoop(sec,url);
  res.json({ok:true,started:true,...loopState});
});

app.post("/bot/ping/stop",(req,res)=>{stopLoop();res.json({ok:true,stopped:true,...loopState});});

app.get("/status",async(req,res)=>{
  try{
    ensureKP();
    res.json({ok:true,running:!!STATE.running,mode:STATE.mode,budget_usdc:STATE.budget_usdc,spent_usdc:STATE.spent_usdc,remaining_usdc:Math.max(0,(STATE.budget_usdc||0)-(STATE.spent_usdc||0)),mint:STATE.mint||"",custodyPubkey:CUSTODY_PUB,last:STATE.last||{},ping:loopState});
  }catch(e){res.status(400).json({ok:false,error:String(e&&e.message||e)});}
});

app.post("/phantomBalances",async(req,res)=>{
  try{
    const pub=String((req.body&&req.body.pub)||"").trim();
    if(!pub) return res.status(400).json({ok:false,error:"missing_pub"});
    const sol=await solBalance(pub), usdc=await usdcBalance(pub);
    res.json({ok:true,pub,sol,usdc});
  }catch(e){res.status(400).json({ok:false,error:String(e&&e.message||e)});}
});

app.post("/start",(req,res)=>{
  try{
    ensureKP();
    const budget=+((req.body&&req.body.budget)||0);
    const mode=String((req.body&&req.body.mode)||"safe_dca");
    const mint=String((req.body&&req.body.mint)||"").trim();
    if(!(budget>0)) return res.status(400).json({ok:false,error:"budget_invalid"});
    if(!["safe_dca","manual_token","monitor_only"].includes(mode)) return res.status(400).json({ok:false,error:"mode_invalid"});
    if(mode==="manual_token" && !mint) return res.status(400).json({ok:false,error:"mint_required"});
    STATE.running=true; STATE.mode=mode; STATE.budget_usdc=budget; STATE.mint=mint;
    STATE.last={event:"started",ts:Date.now()};
    safeWriteJSON(STATE_FILE,STATE);
    res.json({ok:true,note:"started",custodyPubkey:CUSTODY_PUB});
  }catch(e){res.status(400).json({ok:false,error:String(e&&e.message||e)});}
});

app.post("/stop",(req,res)=>{STATE.running=false;STATE.last={event:"stopped",ts:Date.now()};safeWriteJSON(STATE_FILE,STATE);res.json({ok:true,note:"stopped"});});

app.use((req,res)=>res.status(404).json({ok:false,error:"not_found",path:req.path}));

app.listen(PORT,"127.0.0.1",()=>{
  ensureKP();
  console.log("wolverine-api listening 127.0.0.1:"+PORT,"custody="+CUSTODY_PUB);
  if(MONITOR_SEC>0 && (MONITOR_URL||PING_URL)) startLoop(MONITOR_SEC,MONITOR_URL||PING_URL);
});
JS
)"
askorupdate_file "$APPDIR/server.js" "server.js (ping loop)" "$SVR"

cd "$APPDIR"
[ -d node_modules ] || npm install --silent

systemctl daemon-reload
systemctl restart "$SERVICE" || true
sleep 0.5

echo "-- TEST public --"
curl -sS https://fireinners.online/wolverine/api/health || true; echo
curl -sS https://fireinners.online/wolverine/api/bot/ping/status || true; echo
curl -sS https://fireinners.online/wolverine/api/monitorPing || true; echo
echo "DONE"
'
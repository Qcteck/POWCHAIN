cat > /root/FIX_NGINX_WOLVERINE_LOCATION.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/wolverine_force_root.inc"
BACKUP="/etc/nginx/includes/wolverine_force_root.inc.bak.$(date +%s)"

echo "=== FIX NGINX WOLVERINE LOCATION ==="

if [ -f "$INC" ]; then
  echo "[!] Found $INC"
  cp "$INC" "$BACKUP"
  echo "[OK] Backup: $BACKUP"

  # Neutralise tout "location"
  sed -i 's/^\s*location\s\+/## DISABLED location /g' "$INC"
  echo "[OK] location directives disabled"
else
  echo "[INFO] No faulty include found"
fi

echo "[*] Testing nginx config"
nginx -t

echo "[*] Reloading nginx"
nginx -s reload

echo "=== DONE: NGINX FIXED ==="
BASH

chmod +x /root/FIX_NGINX_WOLVERINE_LOCATION.sh
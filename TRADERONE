# 1) Vérif backend direct (sur le VPS)
for p in /health /me /orders; do
  echo -n "LOCAL $p => "
  curl -sS -o /dev/null -w "%{http_code}\n" "http://127.0.0.1:8585$p" || true
done

# 2) Bypass Cloudflare (hit origin)
for p in /wolverine/traderone/api/health /wolverine/traderone/api/me /wolverine/traderone/api/orders; do
  echo "---- ORIGIN $p ----"
  curl -sk --resolve fireinners.online:443:127.0.0.1 -D- -o /dev/null "https://fireinners.online$p" | sed -n '1,35p'
done

# 3) Montre qui “gagne” dans la conf chargée
nginx -T 2>/dev/null | grep -nE 'location \^~ /wolverine/traderone/api/|rewrite \^/wolverine/traderone/api|proxy_pass http://127.0.0.1:8585|wolverine_routes' | head -n 120
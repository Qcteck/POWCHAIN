bash -lc 'set -euo pipefail;
DOMAIN="fireinners.online";
VHOST_A="/etc/nginx/sites-available/${DOMAIN}-ssl";
VHOST_E="/etc/nginx/sites-enabled/${DOMAIN}-ssl";
VHOST="$( [ -f "$VHOST_E" ] && readlink -f "$VHOST_E" || true )"; [ -z "${VHOST:-}" ] && VHOST="$VHOST_A";
SNIP="/etc/nginx/snippets/private_sentinel1.conf";
HTPASS="/etc/nginx/.htpasswd_private_sentinel1";
echo "== TARGET VHOST =="; echo "$VHOST"; [ -f "$VHOST" ] || { echo "VHOST not found"; exit 1; }
echo "== BACKUP =="; BK="${VHOST}.bak.$(date +%Y%m%d-%H%M%S)"; cp -a "$VHOST" "$BK"; echo "$BK";
echo "== UNLOCK immutable (if set) =="; lsattr -d "$VHOST" 2>/dev/null || true; chattr -i "$VHOST" 2>/dev/null || true;
echo "== SHOW current suspect lines =="; grep -nE "include|private_sentinel" "$VHOST" || true;
echo "== CLEAN any broken include occurrences (inline or standalone) ==";
TMP="$(mktemp)";
awk '"'"'{
  gsub(/include[ \t]+[^;]*private_sentinel1[^;]*;[ \t]*/,"");
  if($0 ~ /^[ \t]*include[ \t]+.*private_sentinel1/){ next }
  if($0 ~ /private_sentinel1/ && $0 !~ /location/){ sub(/private_sentinel1/,"") }
  print
}'"'"' "$VHOST" > "$TMP";
cp -a "$TMP" "$VHOST"; rm -f "$TMP";
echo "== ENSURE snippet exists (create if missing) ==";
if [ ! -f "$SNIP" ]; then
  mkdir -p /etc/nginx/snippets;
  cat > "$SNIP" <<'"'"'EOF'"'"'
location ^~ /_private_sentinel1/ {
  auth_basic "Sentinel";
  auth_basic_user_file /etc/nginx/.htpasswd_private_sentinel1;
  proxy_pass http://127.0.0.1:3000/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  add_header Cache-Control "no-store" always;
}
EOF
  chmod 644 "$SNIP";
fi
echo "== ENSURE htpasswd file exists (prompt if needed) ==";
command -v htpasswd >/dev/null 2>&1 || (apt-get update -y && apt-get install -y apache2-utils);
if [ -f "$HTPASS" ]; then htpasswd "$HTPASS" sentinel; else htpasswd -c "$HTPASS" sentinel; fi
chmod 640 "$HTPASS"; chown root:www-data "$HTPASS" 2>/dev/null || true;
echo "== INJECT clean include after first listen 443 (if missing) ==";
INC="include $SNIP;";
if ! grep -qF "$INC" "$VHOST"; then
  TMP="$(mktemp)";
  awk -v inc="    $INC" '"'"'
    {print}
    !done && $0 ~ /^[ \t]*listen[ \t]+443/ { print inc; done=1 }
  '"'"' "$VHOST" > "$TMP";
  cp -a "$TMP" "$VHOST"; rm -f "$TMP";
fi
echo "== SHOW final relevant lines ==";
grep -nE "listen[ \t]+443|include .*private_sentinel1|_private_sentinel1" "$VHOST" || true;
echo "== NGINX TEST ==";
if nginx -t; then
  systemctl reload nginx;
  echo "OK: nginx reloaded";
else
  echo "FAIL: rolling back";
  cp -a "$BK" "$VHOST";
  nginx -t || true;
  exit 1;
fi
echo "== ORIGIN TEST (bypass Cloudflare) ==";
IP="$(hostname -I | awk '"'"'{print $1}'"'"')";
curl -skI --resolve "${DOMAIN}:443:${IP}" "https://${DOMAIN}/_private_sentinel1/" | head -n 20;
echo "DONE"'
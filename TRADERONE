#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== PROOF COLOR CHANGE WOLVERINE ==="

[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

# Backup
cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup créé : ${HTML}.bak_${TS}"

# Inject CSS VISUEL CHOC
sed -i '/<\/head>/i \
<style id="PROOF_COLOR_TEST">\
body{background:#000!important}\
aside,nav,.sidebar,#sidebar{background:#8b0000!important}\
button,a,[role="button"]{background:#ffd700!important;color:#000!important;border-radius:6px!important}\
button:hover{background:#ffea00!important}\
</style>' "$HTML"

echo "✅ COULEURS MODIFIÉES"
echo "➡️ CTRL + F5 OBLIGATOIRE"
cat >/root/fix_cf_servername_and_rpc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
DIS="/etc/nginx/disabled-sites"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
mkdir -p "$DIS" /etc/nginx/snippets

echo "== 1) Move backups out of sites-enabled (stop conflicting server_name) =="
shopt -s nullglob
for f in /etc/nginx/sites-enabled/*.bak* /etc/nginx/sites-enabled/*_bak_* /etc/nginx/sites-enabled/*backup*; do
  echo "MOVE $f -> $DIS/"
  mv -f "$f" "$DIS"/
done
shopt -u nullglob

echo
echo "== 2) Find ACTIVE SSL vhost file for $DOMAIN (443) =="
VHOST="$(
nginx -T 2>/dev/null | awk -v dom="$DOMAIN" '
  /^# configuration file /{f=$4; sub(/:$/,"",f)}
  /server_name/ && $0 ~ dom {cand=f}
  /listen\s+(\[::\]:)?443/ && cand!="" {print cand; exit}
'
)"
[[ -n "${VHOST:-}" && -f "$VHOST" ]] || { echo "[ERR] vhost 443 introuvable pour $DOMAIN"; exit 1; }
echo "[OK] VHOST: $VHOST"

echo
echo "== 3) Write snippet /solana-rpc =="
cat >"$SNIP" <<'NGINX'
location = /solana-rpc {
  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  add_header Access-Control-Allow-Origin * always;
  add_header Access-Control-Allow-Headers * always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }
}
NGINX
echo "[OK] wrote $SNIP"

echo
echo "== 4) Ensure include is in the ACTIVE SSL vhost (not a .bak) =="
if ! grep -qF "include /etc/nginx/snippets/solana_rpc_proxy.conf;" "$VHOST"; then
  sed -i '/server_name .*fireinners\.online/ a\  include /etc/nginx/snippets/solana_rpc_proxy.conf;' "$VHOST"
  echo "[OK] include injected"
else
  echo "[OK] include already present"
fi

echo
echo "== 5) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== 6) CORRECT RPC test (with Host = $DOMAIN) =="
curl -sk --resolve ${DOMAIN}:443:127.0.0.1 https://${DOMAIN}/solana-rpc \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' && echo
BASH

chmod +x /root/fix_cf_servername_and_rpc.sh
/root/fix_cf_servername_and_rpc.sh
cat >/root/FIX_WOLVERINE_VAULT_NGINX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIX WOLVERINE VAULT NGINX ==="

NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
INCLUDE="/etc/nginx/includes/wolverine_traderone_api.inc"
TS="$(date +%Y%m%d_%H%M%S)"

# 1) BACKUP
cp -a "$NGINX_SITE" "$NGINX_SITE.bak_vault_$TS"

# 2) INCLUDE PROXY (COMPLET)
cat > "$INCLUDE" <<'EOF'
location /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Access-Control-Allow-Origin *;
    add_header Access-Control-Allow-Headers *;
    add_header Access-Control-Allow-Methods GET,POST,OPTIONS;
    if ($request_method = OPTIONS) { return 204; }
}
EOF

# 3) INJECTION DANS LE SERVER BLOCK
grep -q "wolverine_traderone_api.inc" "$NGINX_SITE" || \
sed -i "/server {/a\\    include /etc/nginx/includes/wolverine_traderone_api.inc;" "$NGINX_SITE"

# 4) TEST & RELOAD
nginx -t
systemctl reload nginx

echo "=== NGINX OK ==="

# 5) TEST PROXY
echo "--- TEST PROXY VAULT ---"
curl -i http://localhost/wolverine/traderone/api/vault/status?owner=test || true

echo "=== FIN ==="
BASH

chmod +x /root/FIX_WOLVERINE_VAULT_NGINX.sh
/root/FIX_WOLVERINE_VAULT_NGINX.sh
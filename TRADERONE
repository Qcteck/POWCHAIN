WOLV_DIR="/var/www/fireinners/wolverine"

echo "== LIST WOLVERINE DIR =="
ls -lah "$WOLV_DIR" | sed -n '1,120p'
echo

echo "== Cherche app.js sur disque =="
find "$WOLV_DIR" -maxdepth 3 -type f \( -name 'app.js' -o -name 'app.*.js' -o -name '*.js' \) | head -n 80
echo

echo "== Dans index.html, quel JS est chargé ? =="
sed -n '1,220p' "$WOLV_DIR/index.html" | grep -nE 'script|app\.js|src=' || true
echo

echo "== Test fichier attendu (si app.js existe) =="
[ -f "$WOLV_DIR/app.js" ] && (head -c 40 "$WOLV_DIR/app.js"; echo) || echo "NO /var/www/fireinners/wolverine/app.js"
cat >/root/REMOVE_NGINX_FOREVER.sh <<'SH'
#!/usr/bin/env bash
set -e

echo "=== STOP nginx ==="
systemctl stop nginx || true
systemctl disable nginx || true

echo "=== KILL remaining nginx processes ==="
pkill -9 nginx || true

echo "=== PURGE nginx packages ==="
apt-get remove --purge -y nginx nginx-common nginx-core || true
apt-get autoremove -y
apt-get autoclean -y

echo "=== REMOVE nginx directories ==="
rm -rf /etc/nginx
rm -rf /var/log/nginx
rm -rf /var/cache/nginx
rm -rf /usr/share/nginx

echo "=== VERIFY PORTS 80/443 ARE FREE ==="
ss -tulpn | grep -E ':80|:443' || echo "Ports 80/443 are free"

echo "=== DONE: nginx is COMPLETELY REMOVED ==="
echo "No nginx. No snippets. No locations. No bullshit."
SH

chmod +x /root/REMOVE_NGINX_FOREVER.sh
/root/REMOVE_NGINX_FOREVER.sh
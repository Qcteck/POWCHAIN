"use strict";
const http = require("http");
const fs = require("fs");
const path = require("path");
const nacl = require("tweetnacl");
const bs58 = require("bs58");

const HOST = "127.0.0.1";
const PORT = parseInt(process.env.PORT || "3010", 10);
const DB_PATH = process.env.DB_PATH || "/opt/fireinners/wolverine-vault-api/data/vaults.json";

function readJson(req){
  return new Promise((resolve,reject)=>{
    let d=""; req.on("data",c=>d+=c); req.on("end",()=>{ try{ resolve(d?JSON.parse(d):{}); }catch(e){ reject(e);} }); req.on("error",reject);
  });
}
function loadDb(){
  try{ return JSON.parse(fs.readFileSync(DB_PATH,"utf8")||"{}"); }catch(e){ return {}; }
}
function saveDb(db){
  fs.mkdirSync(path.dirname(DB_PATH),{recursive:true});
  fs.writeFileSync(DB_PATH, JSON.stringify(db,null,2));
  try{ fs.chmodSync(DB_PATH,0o600);}catch(e){}
}
function json(res, code, obj){
  res.writeHead(code, {
    "content-type":"application/json",
    "cache-control":"no-store",
    "access-control-allow-origin":"*",
    "access-control-allow-headers":"*",
    "access-control-allow-methods":"GET,POST,OPTIONS"
  });
  res.end(JSON.stringify(obj));
}

const srv = http.createServer(async (req,res)=>{
  if (req.method==="OPTIONS") return json(res,200,{ok:true});

  if (req.method==="GET" && (req.url==="/" || req.url==="/health")) {
    return json(res,200,{status:"ok",service:"wolverine-vault-api"});
  }

  if (req.method==="POST" && req.url.startsWith("/create")) {
    try{
      const body = await readJson(req);
      const owner = String(body.owner||"").trim();
      if (!owner) return json(res,400,{error:"missing owner"});

      const db = loadDb();
      if (db[owner] && db[owner].vaultPub) {
        return json(res,200,{status:"ok",owner,vaultPub:db[owner].vaultPub,existing:true});
      }

      const kp = nacl.sign.keyPair();
      const pub = bs58.encode(Buffer.from(kp.publicKey));
      const sec = bs58.encode(Buffer.from(kp.secretKey));

      db[owner] = { owner, vaultPub: pub, vaultSec_b58: sec, createdAt: new Date().toISOString() };
      saveDb(db);
      return json(res,200,{status:"ok",owner,vaultPub:pub,existing:false});
    }catch(e){
      return json(res,500,{error:String(e)});
    }
  }

  if (req.method==="GET" && req.url.startsWith("/get")) {
    const u = new URL("http://x"+req.url);
    const owner = (u.searchParams.get("owner")||"").trim();
    const db = loadDb();
    if (!owner || !db[owner]) return json(res,404,{error:"not found"});
    return json(res,200,{status:"ok",owner,vaultPub:db[owner].vaultPub});
  }

  return json(res,404,{error:"not found"});
});


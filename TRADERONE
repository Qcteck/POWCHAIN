cat <<'EOF' > /root/FIX_AIAQUILA_DD_HEADER.sh
#!/bin/bash
set -e

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "🔎 Détection dd_header (avant)"
grep -n "dd_header" "$VHOST" || echo "OK: aucun dd_header détecté"

echo "🔓 Déverrouillage"
chattr -i "$VHOST"

echo "✍️ Correction dd_header -> add_header"
sed -i 's/\bdd_header\b/add_header/g' "$VHOST"

echo "🔎 Vérification post-correction"
grep -n "dd_header" "$VHOST" || echo "OK: dd_header éliminé"

echo "🧪 Test nginx"
nginx -t

echo "🔁 Reload nginx"
systemctl reload nginx

echo "🔒 Reverrouillage"
chattr +i "$VHOST"

echo "✅ CORRECTION TERMINÉE — NGINX VALIDE"
EOF

chmod +x /root/FIX_AIAQUILA_DD_HEADER.sh
/root/FIX_AIAQUILA_DD_HEADER.sh
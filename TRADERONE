cat > /root/MEGA_WOLVERINE_NGINX_DEDUP_V3.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"

NGINX_MAIN="/etc/nginx/nginx.conf"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
INC="${INC_DIR}/wolverine_routes.inc"
FRONT_DIR="/var/www/wolverine"

LOG="/root/MEGA_WOLVERINE_NGINX_DEDUP_V3_${TS}.log"
REPORT="/root/MEGA_WOLVERINE_NGINX_DEDUP_V3_${TS}.report.txt"

say(){ printf "\n== %s ==\n" "$*"; }
w(){ printf "%s\n" "$*" | tee -a "$LOG" >/dev/null; }
die(){ w "ERREUR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Binaire manquant: $1"; }

need nginx; need python3; need systemctl; need lsattr; need chattr; need curl; need grep; need sed; need awk; need find

test -f "$VHOST" || die "Vhost introuvable: $VHOST"
mkdir -p "$INC_DIR"

WAS_IMM_VHOST="0"
WAS_IMM_MAIN="0"
WAS_IMM_INC="0"

unlock_if_immutable(){
  local f="$1" name="$2"
  local a; a="$(lsattr -d "$f" 2>/dev/null || true)"
  w "lsattr ${name}: ${a}"
  if echo "$a" | awk '{print $1}' | grep -q "i"; then
    chattr -i "$f" || true
    w "OK: chattr -i ${name}"
    return 0
  fi
  return 1
}
relock_if_needed(){
  local f="$1" name="$2" was="$3"
  if [[ "$was" == "1" ]]; then
    chattr +i "$f" || true
    w "OK: chattr +i ${name}"
  fi
}
backup(){
  local f="$1"
  [[ -f "$f" ]] || return 0
  cp -a "$f" "${f}.bak_${TS}"
  w "Backup: ${f}.bak_${TS}"
}

echo "# MEGA_WOLVERINE_NGINX_DEDUP_V3 $TS" > "$LOG"
w "host=$HOST"
w "date=$(date -Is)"
w "hostname=$(hostname)"
w "whoami=$(whoami)"
w "pwd=$(pwd)"
echo "# REPORT $TS" > "$REPORT"

say "0) nginx -t (etat actuel)"
(nginx -t 2>&1 || true) | tee -a "$LOG" >/dev/null

say "1) Unlock immutable si necessaire (nginx.conf + vhost + include)"
if unlock_if_immutable "$VHOST" "vhost"; then WAS_IMM_VHOST="1"; fi
if [[ -f "$NGINX_MAIN" ]]; then
  if unlock_if_immutable "$NGINX_MAIN" "nginx.conf"; then WAS_IMM_MAIN="1"; fi
fi
if [[ -f "$INC" ]]; then
  if unlock_if_immutable "$INC" "include"; then WAS_IMM_INC="1"; fi
fi

say "2) Backups (vhost/main/include + tous fichiers qui referencent wolverine_routes.inc)"
backup "$VHOST"
[[ -f "$NGINX_MAIN" ]] && backup "$NGINX_MAIN"
[[ -f "$INC" ]] && backup "$INC"

MAP="/root/MEGA_WOLVERINE_NGINX_DEDUP_V3_${TS}.map.txt"
grep -RIl "wolverine_routes\.inc" /etc/nginx 2>/dev/null | sort -u > "$MAP" || true
w "Fichiers referencant wolverine_routes.inc: $(wc -l < "$MAP" || echo 0)"
while read -r f; do
  [[ -n "$f" ]] || continue
  backup "$f"
done < "$MAP"

say "3) Supprimer PARTOUT les lignes include wolverine_routes.inc (on reinjecte 1 seule fois ensuite)"
python3 - <<PY
import re
from pathlib import Path

mapf=Path("$MAP")
files=[Path(p.strip()) for p in mapf.read_text().splitlines() if p.strip()] if mapf.exists() else []
pat=re.compile(r'^\s*include\s+[^;]*wolverine_routes\.inc\s*;\s*$', re.I)

removed_total=0
touched=0

for f in files:
    try:
        s=f.read_text(errors="ignore").splitlines(True)
    except Exception:
        continue
    out=[]
    removed=0
    for line in s:
        if pat.match(line):
            removed += 1
            continue
        out.append(line)
    if removed:
        f.write_text("".join(out))
        removed_total += removed
        touched += 1

print(f"OK: include lines removed_total={removed_total} in touched_files={touched}")
PY
w "OK: purge includes done"

say "4) Re-ecrire include CANONIQUE (anti-doublon) : $INC"
cat > "$INC" <<'NGINX'
# --- WOLVERINE ROUTES (CANONIQUE, ANTI-DOUBLON) ---
# Serve under: https://<host>/wolverine/
# Front: /var/www/wolverine
# API backend (TraderOne): 127.0.0.1:3000  -> /api/* via /wolverine/traderone/api/*

location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:3000;
}

location ^~ /wolverine/ {
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
NGINX
w "OK: include ecrit"

say "5) Injecter UNE SEULE FOIS l'include dans le bon server 443 du VHOST"
python3 - <<PY
import re
from pathlib import Path

v=Path("$VHOST")
s=v.read_text(errors="ignore")

inc_line="include /etc/nginx/includes/wolverine_routes.inc;"

# (A) securite: enlever toute ancienne ligne include (on veut 1 seule fois, ici)
s=re.sub(r'^\s*include\s+[^;]*wolverine_routes\.inc\s*;\s*$', '', s, flags=re.I|re.M)

lines=s.splitlines(True)
res=[]
i=0
inserted=False

while i < len(lines):
    line=lines[i]
    if re.match(r'^\s*server\s*\{', line):
        buf=[line]
        depth=line.count("{")-line.count("}")
        i+=1
        listen443=False
        server_name_hit=False
        while i < len(lines) and depth>0:
            l2=lines[i]
            if re.search(r'^\s*listen\s+.*443', l2): listen443=True
            if re.search(r'^\s*server_name\s+.*fireinners\.online', l2): server_name_hit=True
            depth += l2.count("{")-l2.count("}")
            buf.append(l2); i+=1
        # on injecte dans le server 443 (priorite) / sinon 443 tout court
        if (listen443 and server_name_hit and not inserted) or (listen443 and not inserted and not any("include /etc/nginx/includes/wolverine_routes.inc;" in x for x in buf)):
            buf.insert(1, "  "+inc_line+"\n")
            inserted=True
        res.extend(buf)
    else:
        res.append(line); i+=1

if not inserted:
    # fallback: append en fin (evite echec silencieux)
    res.append("\n"+inc_line+"\n")

v.write_text("".join(res))
print("OK: include injected_once=", inserted)
PY
w "OK: include injecte"

say "6) Permissions front (eviter 403) si dossier existe"
if [[ -d "$FRONT_DIR" ]]; then
  chmod -R a+rX "$FRONT_DIR" || true
  w "OK: chmod a+rX sur $FRONT_DIR"
else
  w "WARN: $FRONT_DIR absent (skip chmod)"
fi

say "7) Inventaire final (occurences include + locations wolverine)"
{
  echo "---- OCCURRENCES include (should be 1 in vhost) ----"
  grep -Rni "wolverine_routes\.inc" /etc/nginx 2>/dev/null || true
  echo "---- LOCATIONS wolverine (should come only from include once) ----"
  grep -RniE "location\s+.*wolverine" /etc/nginx 2>/dev/null || true
} | tee -a "$LOG" >/dev/null

say "8) nginx -t (doit PASS) + reload"
set +e
NT="$(nginx -t 2>&1)"
RC=$?
set -e
echo "$NT" | tee -a "$LOG" >/dev/null
if [[ $RC -ne 0 ]]; then
  w "ERREUR: nginx -t FAIL"
  w "Dernieres erreurs (tail 120):"
  echo "$NT" | tail -n 120 | tee -a "$LOG" >/dev/null
else
  w "OK: nginx -t PASS"
  systemctl reload nginx
  w "OK: nginx reload"
fi

say "9) Relock immutable si necessaire"
relock_if_needed "$INC" "include" "$WAS_IMM_INC"
relock_if_needed "$VHOST" "vhost" "$WAS_IMM_VHOST"
[[ -f "$NGINX_MAIN" ]] && relock_if_needed "$NGINX_MAIN" "nginx.conf" "$WAS_IMM_MAIN"

say "10) Tests HTTP (local/externe)"
LC="$(curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1/wolverine/" -H "Host: ${HOST}" || true)"
EC="$(curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}/wolverine/" || true)"
HC="$(curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}/wolverine/traderone/api/health" || true)"
w "LOCAL  /wolverine/ : ${LC}"
w "EXT    /wolverine/ : ${EC}"
w "EXT    /wolverine/traderone/api/health : ${HC}"

{
  echo "LOG=$LOG"
  echo "VHOST=$VHOST"
  echo "INC=$INC"
  echo "RESULT_NGINX_T_RC=$RC"
  echo "LOCAL_CODE=$LC"
  echo "EXT_CODE=$EC"
  echo "HEALTH_CODE=$HC"
  echo "---- nginx -t output ----"
  echo "$NT"
} > "$REPORT"

echo
echo "DONE."
echo "Log   : $LOG"
echo "Report: $REPORT"
BASH

chmod +x /root/MEGA_WOLVERINE_NGINX_DEDUP_V3.sh
bash /root/MEGA_WOLVERINE_NGINX_DEDUP_V3.sh
echo
echo "----- REPORT (tail) -----"
tail -n 200 /root/MEGA_WOLVERINE_NGINX_DEDUP_V3_*.report.txt 2>/dev/null || true
BASH
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
PAT='location ^~ /wolverine/traderone/api/'

echo "=== 0) Backup vhost + snippets dir ==="
cp -a "$KEEP" "$KEEP.bak.$TS" || true
cp -a /etc/nginx/snippets "/etc/nginx/snippets.bak.$TS" || true

echo "=== 1) Trouver les fichiers qui contiennent la location en double ==="
mapfile -t FILES < <(grep -RIn --include="*.conf" --exclude-dir=snippets.bak* "$PAT" /etc/nginx 2>/dev/null | awk -F: '{print $1}' | sort -u)
printf ' - %s\n' "${FILES[@]:-<none>}"

if [ "${#FILES[@]}" -le 1 ]; then
  echo "✅ Pas de doublon trouvé par grep (ou déjà réglé)."
  nginx -t && systemctl reload nginx
  exit 0
fi

echo "=== 2) Garder le 1er fichier et neutraliser les autres ==="
KEEPFILE="${FILES[0]}"
echo "KEEPFILE = $KEEPFILE"

i=0
for f in "${FILES[@]}"; do
  if [ "$f" = "$KEEPFILE" ]; then
    echo "Keep: $f"
    continue
  fi
  i=$((i+1))
  cp -a "$f" "$f.bak.dupe.$TS" || true

  # Renomme la location dans ce fichier pour éviter le conflit
  sed -i "s|$PAT|location ^~ /_disabled_dupe_wolverine_traderone_api_${TS}_${i}/|g" "$f"
  echo "Disabled duplicate in: $f"
done

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 4) Recheck: occurrences restantes ==="
grep -RIn --include="*.conf" "$PAT" /etc/nginx 2>/dev/null | head -n 20 || echo "✅ only one location remains"

echo "=== 5) Test API ==="
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | sed -n '1,35p'

echo "DONE ✅"
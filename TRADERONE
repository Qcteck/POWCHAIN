#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LIVE_DIR="/var/www/wolverine"
HTML="$LIVE_DIR/index.html"
VENDOR_DIR="$LIVE_DIR/vendor"
SOLWEB3="$VENDOR_DIR/solana-web3.min.js"
TRADERONE_DIR="/opt/traderone"
SERVER="$TRADERONE_DIR/server.cjs"
DATA_DIR="$TRADERONE_DIR/data"
LOG="/root/MEGA_AQUILA_VAULT_FIX_${TS}.log"
BK="/root/WOLVERINE_AQUILA_FIX_BACKUP_${TS}"
exec > >(tee -a "$LOG") 2>&1

echo "== MEGA_AQUILA_VAULT_FIX $TS =="

id -u | grep -q "^0$" || { echo "ERROR: run as root"; exit 1; }
test -d "$LIVE_DIR" || { echo "ERROR: missing $LIVE_DIR"; exit 1; }
test -f "$HTML" || { echo "ERROR: missing $HTML"; exit 1; }
test -f "$SERVER" || { echo "ERROR: missing $SERVER"; exit 1; }

mkdir -p "$BK"
cp -a "$HTML" "$BK/index.html.bak"
cp -a "$SERVER" "$BK/server.cjs.bak"
mkdir -p "$DATA_DIR"

echo "== 1) Ensure local solana-web3 vendor (window.solanaWeb3) =="
mkdir -p "$VENDOR_DIR"
if ! test -s "$SOLWEB3"; then
  curl -fsSL "https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js" -o "$SOLWEB3"
fi
chmod 0644 "$SOLWEB3"


set -e

echo "=== Où nginx pointe vers 3000 ? ==="
grep -RIn --color "127\.0\.0\.1:3000|:3000|proxy_pass" /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null | head -n 200

echo
echo "=== Backup fichiers nginx qui contiennent 3000 ==="
for f in $(grep -RIl "127\.0\.0\.1:3000|:3000" /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null); do
  cp -v "$f" "$f.bak.$(date +%Y%m%d_%H%M%S)"
done

echo
echo "=== Remplace 3000 -> 12703 (dans tous les fichiers concernés) ==="
for f in $(grep -RIl "127\.0\.0\.1:3000|:3000" /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null); do
  sed -i 's#127\.0\.0\.1:3000#127.0.0.1:12703#g' "$f"
done

echo
echo "=== Vérifie le bloc /wolverine/traderone/api ==="
grep -RIn --color "location /wolverine/traderone/api|proxy_pass http://127\.0\.0\.1:12703" /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null | head -n 120

echo
echo "=== Test + reload nginx ==="
nginx -t
systemctl reload nginx

echo
echo "=== Test nginx en LOCAL (contourne Cloudflare) ==="
curl -i -X OPTIONS http://127.0.0.1/wolverine/traderone/api/ | head -n 30
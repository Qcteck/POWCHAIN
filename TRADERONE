cat >/root/rebuild_nginx_fireinners_ssl.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
ts="$(date +%Y%m%d_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/backup_rebuild_${ts}"

mkdir -p "$BACKDIR"
if [[ -f "$VHOST" ]]; then
  cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
  echo "[OK] Backup -> $BACKDIR/$(basename "$VHOST")"
fi

cat >"$VHOST" <<EOF
# ${DOMAIN} - rebuilt ${ts}

server {
  listen 80;
  listen [::]:80;
  server_name ${DOMAIN} www.${DOMAIN};
  return 301 https://\$host\$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name ${DOMAIN} www.${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

  access_log /var/log/nginx/${DOMAIN}.access.log;
  error_log  /var/log/nginx/${DOMAIN}.error.log;

  # favicon: never 500 if absent
  location = /favicon.ico {
    access_log off;
    log_not_found off;
    return 204;
  }

  # redirect home to /wolverine/
  location = / {
    return 302 /wolverine/;
  }

  # --- Wolverine static export ---
  location ^~ /wolverine/ {
    alias /var/www/wolverine/;
    index index.html;
    try_files \$uri \$uri/ /wolverine/index.html;
  }
}
EOF

echo "[*] nginx -t"
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "Tests:"
echo "  curl -k -sSI https://127.0.0.1/wolverine/ -H 'Host: ${DOMAIN}' | head -n 15"
echo "  curl -sSI https://${DOMAIN}/wolverine/ | head -n 15"
BASH

chmod +x /root/rebuild_nginx_fireinners_ssl.sh
/root/rebuild_nginx_fireinners_ssl.sh fireinners.online
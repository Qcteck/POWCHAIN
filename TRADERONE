cat >/root/MEGA_BUNDLER_FORCE_INCLUDE_ALL_VHOSTS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BUNDLER_FORCE_${TS}"
mkdir -p "$BK"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run as root"

DOMAIN="fireinners.online"
INC_DIR="/etc/nginx/includes"
INC_BUNDLER="${INC_DIR}/bundler_routes.inc"
WEBROOT_BUNDLER="/var/www/bundler"
DATA_DIR="/opt/bundler_data"
API_HOST="127.0.0.1"
API_PORT="9797"

say "backup: /etc/nginx"
tar -C /etc -czf "$BK/etc_nginx.tgz" nginx >/dev/null 2>&1 || true

say "ensure dirs"
mkdir -p "$INC_DIR" "$WEBROOT_BUNDLER" "$DATA_DIR"
chmod 755 "$WEBROOT_BUNDLER" "$DATA_DIR" || true

say "write include: $INC_BUNDLER"
cat >"$INC_BUNDLER" <<EOF
# Bundler UI + API (force include $TS)
location ^~ /bundler/api/ {
  proxy_pass http://$API_HOST:$API_PORT/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
}
location ^~ /bundler/data/ {
  alias $DATA_DIR/;
  add_header Cache-Control "no-store" always;
  try_files \$uri =404;
}
location ^~ /bundler/ {
  alias $WEBROOT_BUNDLER/;
  try_files \$uri \$uri/ /bundler/index.html;
}
EOF

say "unlock nginx files"
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
find /etc/nginx/sites-available /etc/nginx/sites-enabled -maxdepth 1 -type f -print0 2>/dev/null | xargs -0 -r chattr -i 2>/dev/null || true

patch_file(){
  local f="$1"
  [ -f "$f" ] || return 0
  grep -qE '^\s*server\s*\{' "$f" || return 0
  if grep -qF "include /etc/nginx/includes/bundler_routes.inc;" "$f"; then return 0; fi
  cp -a "$f" "$BK/$(basename "$f").bak" 2>/dev/null || true
  perl -0777 -pe 's/(server\s*\{\s*\n)/$1  include \/etc\/nginx\/includes\/bundler_routes\.inc;\n/sg' "$f" >"$BK/tmp.$(basename "$f")"
  cp -a "$BK/tmp.$(basename "$f")" "$f"
}

say "inject include into ALL vhosts (sites-enabled + sites-available)"
while IFS= read -r -d '' f; do patch_file "$f"; done < <(find /etc/nginx/sites-enabled -maxdepth 1 -type f -print0 2>/dev/null || true)
while IFS= read -r -d '' f; do patch_file "$f"; done < <(find /etc/nginx/sites-available -maxdepth 1 -type f -print0 2>/dev/null || true)

say "nginx -t (show conflicts if any)"
nginx -t || true

say "reload nginx"
systemctl reload nginx >/dev/null || systemctl restart nginx >/dev/null || true

say "re-lock nginx files"
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
find /etc/nginx/sites-available /etc/nginx/sites-enabled -maxdepth 1 -type f -print0 2>/dev/null | xargs -0 -r chattr +i 2>/dev/null || true

say "origin tests (bypass Cloudflare)"
curl -fsS "http://127.0.0.1:${API_PORT}/health" | head -c 200; echo
curl -fsSI --resolve "${DOMAIN}:80:127.0.0.1" "http://${DOMAIN}/bundler/" | head -n 12 | tr -d '\r' || true
curl -k -fsSI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/bundler/" | head -n 12 | tr -d '\r' || true
curl -k -fsSI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/bundler/api/health" | head -n 12 | tr -d '\r' || true

say "public tests (via Cloudflare)"
curl -fsSI "https://${DOMAIN}/bundler/" | head -n 12 | tr -d '\r' || true
curl -fsSI "https://${DOMAIN}/bundler/api/health" | head -n 12 | tr -d '\r' || true

say "DONE"
say "BACKUP: $BK"
BASH

chmod +x /root/MEGA_BUNDLER_FORCE_INCLUDE_ALL_VHOSTS.sh
/root/MEGA_BUNDLER_FORCE_INCLUDE_ALL_VHOSTS.sh
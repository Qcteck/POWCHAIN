#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
BACKUP="/root/fireinners_ssl_backup_$(date +%Y%m%d_%H%M%S).conf"

echo "🔒 Backup du vhost SSL principal"
cp "$VHOST" "$BACKUP"

echo "🧹 Réécriture SAFE du vhost fireinners.online-ssl"

cat > "$VHOST" <<'EOF'
server {
    listen 443 ssl http2;
    server_name fireinners.online;

    ssl_certificate     /etc/letsencrypt/live/fireinners.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fireinners.online/privkey.pem;

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;

    location / {
        root /opt/fireinners/frontend-react/app/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /aiaquila/ {
        alias /var/www/aiaquila/;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
EOF

echo "🧪 Test nginx"
if nginx -t; then
    echo "✅ nginx OK → reload"
    systemctl reload nginx
    echo "🎉 FIREINNERS + AIAQUILA SERVIS"
else
    echo "❌ nginx invalide → rollback"
    cp "$BACKUP" "$VHOST"
    nginx -t || true
    exit 1
fi

echo "✅ FIN FIX STRUCTURE NGINX"
cat >/root/trace_blueprint_request.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HOST="fireinners.online"
PAT='blueprint_robo600|blueprint_robo600\.mp4|/wolverine/blueprint'
URL="/wolverine/blueprint/blueprint_robo600.mp4"

echo "=== 0) QUICK: ORIGIN headers for MP4 ==="
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}${URL} | head -n 20 || true
echo

echo "=== 1) NGINX ACCESS LOG: who is requesting the mp4 (referer / UA) ==="
# try common log paths
for L in /var/log/nginx/access.log /var/log/nginx/*access*.log; do
  [ -f "$L" ] || continue
  echo "--- $L (last 50 matching) ---"
  grep -F "$URL" "$L" | tail -n 50 || true
done
echo

echo "=== 2) Search plaintext everywhere (var/www + opt + root) ==="
for R in /var/www /opt /root; do
  [ -d "$R" ] || continue
  echo "--- grep in $R ---"
  grep -RInE --binary-files=text --exclude-dir=node_modules --exclude-dir=.git \
    "$PAT" "$R" 2>/dev/null | head -n 120 || true
done
echo

echo "=== 3) Search inside compressed assets (.gz) ==="
for R in /var/www/wolverine /var/www /opt; do
  [ -d "$R" ] || continue
  echo "--- zgrep in $R (js/css/html gz) ---"
  find "$R" -type f \( -name "*.js.gz" -o -name "*.css.gz" -o -name "*.html.gz" \) 2>/dev/null \
    | head -n 200 \
    | while read -r f; do
        if zgrep -aE -q "$PAT" "$f" 2>/dev/null; then
          echo "MATCH in: $f"
          zgrep -aE -n "$PAT" "$f" 2>/dev/null | head -n 5 || true
        fi
      done
done
echo

echo "=== 4) Detect Service Worker files served under /wolverine ==="
find /var/www -maxdepth 8 -type f \
  \( -iname "sw.js" -o -iname "service-worker.js" -o -iname "*sw*.js" -o -iname "workbox-*.js" -o -iname "manifest*.json" \) \
  2>/dev/null | head -n 120 || true
echo

echo "=== 5) Check if SW endpoints exist on ORIGIN (common paths) ==="
for p in /wolverine/sw.js /wolverine/service-worker.js /sw.js /service-worker.js /wolverine/manifest.json; do
  echo "--- $p ---"
  curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}${p} | head -n 8 || true
done
echo

echo "DONE ✅"
BASH

chmod +x /root/trace_blueprint_request.sh
/root/trace_blueprint_request.sh
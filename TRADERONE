# ROOT — Rebuild UI WOLVERINE en Next.js (export statique) + deploy sous /wolverine/
set -euo pipefail

SRC="/opt/_wolverine_next_src"
DIST="/var/www/_wolverine_ui"

echo "=== 0) deps ==="
apt-get update -y >/dev/null
apt-get install -y curl rsync >/dev/null
if ! command -v node >/dev/null 2>&1; then
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash - >/dev/null
  apt-get install -y nodejs >/dev/null
fi

echo "=== 1) écrire un Next minimal (basePath=/wolverine) ==="
rm -rf "$SRC"
mkdir -p "$SRC/pages" "$SRC/public"
cd "$SRC"

cat > package.json <<'JSON'
{
  "name": "wolverine-next-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "next build"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
JSON

cat > next.config.mjs <<'JS'
/** @type {import('next').NextConfig} */
const nextConfig = {
  output: "export",
  basePath: "/wolverine",
  assetPrefix: "/wolverine/",
  images: { unoptimized: true }
};
export default nextConfig;
JS

cat > pages/index.jsx <<'JSX'
import { useEffect, useState } from "react";

export default function Home() {
  const [health, setHealth] = useState(null);
  const [err, setErr] = useState("");

  useEffect(() => {
    fetch("/wolverine/traderone/api/health")
      .then(r => r.json())
      .then(setHealth)
      .catch(e => setErr(String(e)));
  }, []);

  return (
    <div style={{
      minHeight:"100vh", padding:24, color:"#e6edf6",
      background:"radial-gradient(900px 600px at 40% 0%, #182233, #0b0f15)",
      fontFamily:"system-ui,Segoe UI,Roboto,Arial"
    }}>
      <h1 style={{marginTop:0}}>WOLVERINE UI (Next)</h1>
      <p>BasePath: <code>/wolverine</code></p>

      <div style={{
        marginTop:16, padding:16, borderRadius:16,
        border:"1px solid rgba(255,255,255,.08)",
        background:"linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.03))"
      }}>
        <h2 style={{marginTop:0}}>API Health</h2>
        {err ? <pre style={{color:"#ff5d6e"}}>{err}</pre>
             : <pre>{health ? JSON.stringify(health,null,2) : "Loading..."}</pre>}
        <p style={{opacity:.7}}>GET <code>/wolverine/traderone/api/health</code></p>
      </div>
    </div>
  );
}
JSX

echo "=== 2) build ==="
npm install --legacy-peer-deps >/dev/null
npm run build

echo "=== 3) deploy -> $DIST (sans toucher /var/www/fireinners) ==="
rm -rf "$DIST"
mkdir -p "$DIST"
# Next export sort dans ./out
rsync -a --delete "$SRC/out/" "$DIST/"

echo "=== 4) tests ==="
curl -LsS https://fireinners.online/wolverine/ | grep -i "<title>" | head -n 1 || true
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12 || true
echo "DONE ✅"
set -e
cd /root

echo "=============================="
echo "0) Ports (nginx + traderone)"
echo "=============================="
ss -ltnp | egrep ':80|:443|:12703' || true

echo
echo "=============================="
echo "1) Process qui écoute 12703"
echo "=============================="
sudo lsof -iTCP:12703 -sTCP:LISTEN -n -P || true
PID=$(sudo lsof -t -iTCP:12703 -sTCP:LISTEN 2>/dev/null | head -n 1 || true)
echo "PID=$PID"
[ -n "$PID" ] && tr '\0' ' ' < "/proc/$PID/cmdline" ; echo

echo
echo "=============================="
echo "2) NGINX: le proxy_pass pour /wolverine/traderone/api/"
echo "   (doit finir par /api/ si ton backend attend /api/start)"
echo "=============================="
nginx -T 2>/dev/null | grep -nE "server_name fireinners\.online|listen 80|listen 443|location \^~ /wolverine/traderone/api/|proxy_pass" | head -n 240

echo
echo "=============================="
echo "3) Tests ORIGIN local (contourne Cloudflare)"
echo "=============================="
echo "--- OPTIONS local via nginx 80"
curl -sS -i -X OPTIONS -H "Host: fireinners.online" http://127.0.0.1/wolverine/traderone/api/ | head -n 20
echo
echo "--- POST /start local via nginx 80"
curl -sS -i -X POST -H "Host: fireinners.online" -H "content-type: application/json" \
  http://127.0.0.1/wolverine/traderone/api/start --data '{}' | head -n 30
echo
echo "--- POST /status local via nginx 80"
curl -sS -i -X POST -H "Host: fireinners.online" -H "content-type: application/json" \
  http://127.0.0.1/wolverine/traderone/api/status --data '{}' | head -n 30

echo
echo "=============================="
echo "4) Tests PUBLIC via Cloudflare"
echo "=============================="
BASE="https://fireinners.online/wolverine/traderone/api"
echo "--- OPTIONS $BASE/"
curl -sS -i -X OPTIONS "$BASE/" | head -n 20
echo
echo "--- POST $BASE/start"
curl -sS -i -X POST "$BASE/start" -H "content-type: application/json" --data '{}' | head -n 30
echo
echo "--- POST $BASE/status"
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" --data '{}' | head -n 30

echo
echo "=============================="
echo "5) Logs nginx (si 404/502)"
echo "=============================="
tail -n 60 /var/log/nginx/error.log || true
MARK_B = "/*AQUILA_VAULT_UI_END*/"

inject = r"""
/*AQUILA_VAULT_UI_BEGIN*/
(function(){
  function q(sel){return document.querySelector(sel);}
  function el(tag,attrs,children){
    var e=document.createElement(tag);
    if(attrs)for(var k in attrs){ if(k==="style"){for(var sk in attrs.style)e.style[sk]=attrs.style[sk];} else if(k==="class") e.className=attrs[k]; else e.setAttribute(k,attrs[k]);}
    (children||[]).forEach(function(c){ if(typeof c==="string") e.appendChild(document.createTextNode(c)); else if(c) e.appendChild(c);});
    return e;
  }
  function now(){return new Date().toISOString().replace("T"," ").replace("Z","");}
  function log(msg){
    var box=q("#log");
    if(!box) return;
    box.value = (box.value?box.value+"\\n":"") + "["+now()+"] " + msg;
    box.scrollTop = box.scrollHeight;
  }

  // RPC: force same-origin proxy
  var RPC_SAME_ORIGIN = "/wolverine/solana-rpc";

  function ensureSolanaWeb3(){
    if(!window.solanaWeb3){ throw new Error("solanaWeb3 missing: /wolverine/vendor/solana-web3.min.js not loaded"); }
    return window.solanaWeb3;
  }

  async function connectPhantom(){
    if(!window.solana) throw new Error("Phantom not found");
    var res = await window.solana.connect({ onlyIfTrusted:false });
    return res.publicKey.toString();
  }

  async function getVault(pub){
    var r = await fetch("/wolverine/traderone/api/vault?pub="+encodeURIComponent(pub), {cache:"no-store"});
    if(!r.ok) throw new Error("vault api http "+r.status);
    return await r.json();
  }

  async function getDepositTx(pub, lamports){
    var r = await fetch("/wolverine/traderone/api/vault/tx/deposit?pub="+encodeURIComponent(pub)+"&lamports="+encodeURIComponent(String(lamports)), {cache:"no-store"});
    if(!r.ok) throw new Error("deposit api http "+r.status);
    return await r.json();
  }

  async function signSendV0(txB64, blockhash, lastValidBlockHeight){
    var solanaWeb3 = ensureSolanaWeb3();
    var raw = Uint8Array.from(atob(txB64), c=>c.charCodeAt(0));
    var tx = solanaWeb3.VersionedTransaction.deserialize(raw);

    if(!window.solana || !window.solana.signTransaction) throw new Error("Wallet cannot signTransaction");
    tx = await window.solana.signTransaction(tx);

    var conn = new solanaWeb3.Connection(RPC_SAME_ORIGIN, {commitment:"confirmed"});
    var sig = await conn.sendRawTransaction(tx.serialize(), {skipPreflight:false, maxRetries:3});
    await conn.confirmTransaction({signature:sig, blockhash:blockhash, lastValidBlockHeight:lastValidBlockHeight}, "confirmed");
    return sig;
  }

  function mountVaultUI(){
    // mount into left wallet box if present, else body
    var walletBox = q("#walletBox") || q(".walletBox") || q("#wallet") || document.body;

    if(q("#aquilaVaultCard")) return;

    var card = el("div",{id:"aquilaVaultCard",style:{marginTop:"10px",padding:"10px",border:"1px solid #ccc",borderRadius:"8px",maxWidth:"420px"}},[
      el("div",{style:{fontWeight:"700",marginBottom:"8px"}},["Vault Trading (Aquila)"]),
      el("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:"8px",alignItems:"center"}},[
        el("label",{},["Deposit SOL"]),
        el("input",{id:"aquilaDepositSol",type:"number",min:"0",step:"0.001",value:"0.01",style:{padding:"6px",border:"1px solid #ccc",borderRadius:"6px"}},[])
      ]),
      el("div",{style:{display:"flex",gap:"8px",marginTop:"10px",flexWrap:"wrap"}},[
        el("button",{id:"aquilaCreateVaultBtn",style:{padding:"8px 10px",border:"1px solid #333",borderRadius:"8px",cursor:"pointer"}},["Create/Load Vault"]),
        el("button",{id:"aquilaDepositBtn",style:{padding:"8px 10px",border:"1px solid #333",borderRadius:"8px",cursor:"pointer"}},["Deposit to Vault"])
      ]),
      el("div",{style:{marginTop:"10px",fontSize:"12px"}},[
        el("div",{},["Vault: ", el("span",{id:"aquilaVaultAddr",style:{fontFamily:"monospace"}},["-"])]),
        el("div",{},["Last TX: ", el("span",{id:"aquilaLastSig",style:{fontFamily:"monospace"}},["-"])])
      ])
    ]);

    walletBox.appendChild(card);

    q("#aquilaCreateVaultBtn").addEventListener("click", async function(){
      try{
        log("Vault: connect wallet...");
        var pub = await connectPhantom();
        log("Wallet: "+pub);
        log("Vault: fetching/creating...");
        var v = await getVault(pub);
        q("#aquilaVaultAddr").textContent = v.vault || "-";
        log("Vault: "+(v.vault||"-"));
      }catch(e){
        log("Vault error: "+((e&&e.message)?e.message:String(e)));
      }
    });

    q("#aquilaDepositBtn").addEventListener("click", async function(){
      try{
        var solanaWeb3 = ensureSolanaWeb3();
        log("Deposit: connect wallet...");
        var pub = await connectPhantom();
        log("Wallet: "+pub);

        var v = await getVault(pub);
        var vault = v.vault;
        if(!vault) throw new Error("No vault returned");

        q("#aquilaVaultAddr").textContent = vault;

        var sol = parseFloat(q("#aquilaDepositSol").value || "0");
        if(!(sol>0)) throw new Error("Invalid SOL amount");
        var lamports = Math.floor(sol * solanaWeb3.LAMPORTS_PER_SOL);

        log("Deposit: building tx via backend ("+sol+" SOL)...");
        var r = await getDepositTx(pub, lamports);
        if(!r.txB64) throw new Error("Missing txB64");
        log("Deposit: signing+sending...");
        var sig = await signSendV0(r.txB64, r.blockhash, r.lastValidBlockHeight);
        q("#aquilaLastSig").textContent = sig;
        log("Deposit OK: "+sig);
      }catch(e){
        log("Deposit error: "+((e&&e.message)?e.message:String(e)));
      }
    });
  }

  // mount after DOM
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", mountVaultUI);
  else mountVaultUI();

})();
/*AQUILA_VAULT_UI_END*/
"""

if MARK_A not in s:
  # append near end of body (before </body> if possible)
  if "</body>" in s.lower():
    s = re.sub(r"</body>", f"<script>{inject}</script></body>", s, count=1, flags=re.I)
  else:
    s += f"\n<script>{inject}</script>\n"
else:
  # already injected: do nothing
  pass

html_path.write_text(s)
print("OK: index.html patched (Vault UI + solana-web3 vendor ensured)")

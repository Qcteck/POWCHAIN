say "3) Purge any other /aquilatrader location blocks (dedupe)"
python3 - <<'"'"'PY'"'"'
import os,re,glob
targets=set()
targets.add("/etc/nginx/sites-available/fireinners.online-ssl")
targets |= set(glob.glob("/etc/nginx/includes/*.inc"))
targets |= set(glob.glob("/etc/nginx/snippets/*.conf")) | set(glob.glob("/etc/nginx/snippets/*.inc"))
targets = [t for t in targets if os.path.isfile(t)]

pat_start=re.compile(r'^\s*location\s+(\^~\s+)?/aquilatrader/?\s*\{')
def clean(path):
    s=open(path,'r',encoding='utf-8',errors='ignore').read().splitlines()
    out=[]
    skip=False
    depth=0
    removed=False
    for ln in s:
        if not skip and pat_start.search(ln):
            skip=True
            depth = ln.count("{")-ln.count("}")
            removed=True
            continue
        if skip:
            depth += ln.count("{")-ln.count("}")
            if depth<=0:
                skip=False
            continue
        out.append(ln)
    if removed:
        open(path,'w',encoding='utf-8').write("\n".join(out).rstrip()+"\n")
        print("cleaned:",path)

for t in targets:
    if t == "/etc/nginx/includes/aquilatrader_static.inc":
        continue
    clean(t)
PY

say "4) Ensure vhost includes aquilatrader_static.inc exactly once"
python3 - <<'"'"'PY'"'"'
import re
vhost="/etc/nginx/sites-available/fireinners.online-ssl"
inc="/etc/nginx/includes/aquilatrader_static.inc"
s=open(vhost,'r',encoding='utf-8',errors='ignore').read().splitlines()

# remove any existing include lines for this include
s=[ln for ln in s if not re.search(r'include\s+.+/aquilatrader_static\.inc\s*;', ln)]

out=[]
in_server=False
depth=0
inserted=False

for ln in s:
    out.append(ln)
    if (not in_server) and re.match(r'^\s*server\s*\{', ln):
        in_server=True
        depth=1
        continue
    if in_server:
        depth += ln.count("{")-ln.count("}")
        # insert after the first include line inside server (clean and stable)
        if (not inserted) and re.match(r'^\s*include\s+', ln):
            out.append(f"    include {inc};")
            inserted=True
        if depth<=0:
            if not inserted:
                out.insert(len(out)-1, f"    include {inc};")
                inserted=True
            in_server=False

open(vhost,'w',encoding='utf-8').write("\n".join(out).rstrip()+"\n")
print("vhost patched:",vhost,"inserted=",inserted)
PY


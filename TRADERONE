set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date +%s)"

cp -a "$NG" "$NG.bak.fix_redirectloop.$TS"

python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# 1) Supprime la boucle exacte: location = / { return 301 /; }
s = re.sub(r'\n\s*location\s*=\s*/\s*\{\s*return\s+301\s+/\s*;\s*\}\s*', "\n", s, flags=re.M)

# 2) Supprime anciens blocs ROOT UI si présents (on va en réécrire un clean)
s = re.sub(r'\n\s*# --- ROOT UI \(FIREINNERS\) ---[\s\S]*?^\s*}\s*', "\n", s, flags=re.M)

block = r'''
# --- ROOT UI (FIREINNERS) ---
location ^~ / {
  root /var/www/fireinners;
  index index.html;
  try_files $uri $uri/ /index.html;
}
'''
i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: nginx conf invalide (pas de } final)")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: redirect loop removed + ROOT UI written")
PY

nginx -t
systemctl reload nginx

echo "=== TESTS (doivent PLUS boucler) ==="
curl -sS -I https://fireinners.online/ | head -n 15
curl -LsS https://fireinners.online/ | head -n 20
echo "--- wolverine (suivre 301) ---"
curl -LsS https://fireinners.online/wolverine/ | head -n 20
echo "DONE ✅"
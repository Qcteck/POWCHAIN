    inject = f"""
<script id="wolverine-vault-widget">
(()=>{{try{{
  const RPC = location.origin + "/wolverine/solana-rpc";
  const wrap = document.createElement("div");
  wrap.style.cssText="position:fixed;left:14px;bottom:14px;z-index:99999;background:#fff;border:1px solid #aaa;border-radius:10px;padding:10px 12px;min-width:320px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;box-shadow:0 6px 24px rgba(0,0,0,.12)";
  wrap.innerHTML = `
    <div style="font-weight:700;margin-bottom:6px">Vault • Budget SOL (one-click)</div>
    <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px">
      <input id="wv_budget" type="number" step="0.0001" min="0" placeholder="Budget (SOL)" style="flex:1;padding:8px;border:1px solid #bbb;border-radius:8px">
      <button id="wv_go" style="padding:8px 10px;border:1px solid #333;border-radius:8px;background:#e9ffe9;cursor:pointer">Déposer</button>
    </div>
    <div style="display:flex;gap:8px;margin-bottom:6px">
      <input id="wv_dest" placeholder="Vault dest (pubkey)" value="${vault_dest}" style="flex:1;padding:8px;border:1px solid #bbb;border-radius:8px">
    </div>
    <div id="wv_status" style="white-space:pre-wrap;color:#111"></div>
  `;
  document.body.appendChild(wrap);

  const elBudget = wrap.querySelector("#wv_budget");
  const elGo = wrap.querySelector("#wv_go");
  const elDest = wrap.querySelector("#wv_dest");
  const elStatus = wrap.querySelector("#wv_status");

  const say = (t)=>{{ elStatus.textContent = String(t||""); }};
  const fmt = (n)=>{{ try{{ return Number(n).toFixed(6); }}catch(e){{ return String(n); }} }};

  async function getProvider(){{
    const p = window.solana;
    if(!p || !p.isPhantom) throw new Error("Phantom non détecté");
    return p;
  }}

  async function ensureWeb3(){{
    if(!window.solanaWeb3) throw new Error("solanaWeb3 is not defined (vendor non chargé)");
  }}

  async function connectIfNeeded(p){{
    if(!p.isConnected) await p.connect({{ onlyIfTrusted:false }});
    if(!p.publicKey) throw new Error("Wallet non connecté");
    return p.publicKey.toBase58();
  }}

  async function postJsonRpc(method, params){{
    const body = {{ jsonrpc:"2.0", id:1, method, params }};
    const r = await fetch(RPC, {{
      method:"POST",
      headers:{{"content-type":"application/json"}},
      body: JSON.stringify(body),
      cache:"no-store",
    }});
    if(!r.ok) throw new Error("RPC HTTP "+r.status);
    const j = await r.json();
    if(j.error) throw new Error(j.error.message || "RPC error");
    return j.result;
  }}

  async function getLatestBlockhash(){{
    const r = await postJsonRpc("getLatestBlockhash", [{{ commitment:"confirmed" }}]);
    return r.value;
  }}

  async function getBalance(pub){{
    const r = await postJsonRpc("getBalance", [pub, {{ commitment:"confirmed" }}]);
    return r.value;
  }}

  async function sendV0Transfer(provider, fromPub, toPub, solAmount){{
    const lamports = Math.floor(Number(solAmount) * 1_000_000_000);
    if(!(lamports>0)) throw new Error("Budget invalide");
    const bh = await getLatestBlockhash();

    const conn = new window.solanaWeb3.Connection(RPC, "confirmed");
    const payer = new window.solanaWeb3.PublicKey(fromPub);
    const dest  = new window.solanaWeb3.PublicKey(toPub);

    const ix = window.solanaWeb3.SystemProgram.transfer({{
      fromPubkey: payer,
      toPubkey: dest,
      lamports
    }});

    const cup = window.solanaWeb3.ComputeBudgetProgram.setComputeUnitPrice({{ microLamports: 100_000 }});

    const msg = new window.solanaWeb3.TransactionMessage({{
      payerKey: payer,
      recentBlockhash: bh.blockhash,
      instructions: [cup, ix],
    }}).compileToV0Message();

    const tx = new window.solanaWeb3.VersionedTransaction(msg);

    // Prefer Phantom signAndSendTransaction (works with VersionedTransaction)
    let sig = "";
    if (provider.signAndSendTransaction) {{
      const res = await provider.signAndSendTransaction(tx);
      sig = (res && res.signature) ? res.signature : (typeof res === "string" ? res : "");
      if(!sig) throw new Error("No signature returned by signAndSendTransaction");
    }} else if (provider.signTransaction) {{
      const signed = await provider.signTransaction(tx);
      sig = await conn.sendRawTransaction(signed.serialize(), {{ skipPreflight:false, maxRetries:3 }});
    }} else {{
      throw new Error("Wallet ne supporte pas signAndSendTransaction/signTransaction");
    }}

    await conn.confirmTransaction({{ signature:sig, blockhash: bh.blockhash, lastValidBlockHeight: bh.lastValidBlockHeight }}, "confirmed");
    return sig;
  }}

  elGo.addEventListener("click", async ()=>{{
    try{{
      say("Préparation...");
      await ensureWeb3();
      const provider = await getProvider();
      const fromPub = await connectIfNeeded(provider);

      const toPub = (elDest.value||"").trim();
      if(!toPub) throw new Error("Dest pubkey manquant");

      const solAmount = (elBudget.value||"").trim();
      if(!solAmount) throw new Error("Budget manquant");

      const ok = confirm("Déposer " + solAmount + " SOL\\nDe: " + fromPub + "\\nVers: " + toPub + "\\n\\nConfirmer ?");
      if(!ok) return say("Annulé.");

      const before = await getBalance(fromPub);
      say("Envoi tx (v0)...\\nRPC: " + RPC + "\\nBalance before: " + (before/1e9).toFixed(6) + " SOL");

      const sig = await sendV0Transfer(provider, fromPub, toPub, solAmount);

      const after = await getBalance(fromPub);
      say("OK\\nSignature: " + sig + "\\nBalance after: " + (after/1e9).toFixed(6) + " SOL");
    }} catch(e){{
      say("ERREUR: " + (e && e.message ? e.message : String(e)));
    }}
  }});

  say("Prêt. RPC=" + RPC);
}}catch(e){{ console.error(e); }} }})();
</script>
"""
    if "</body>" in s:

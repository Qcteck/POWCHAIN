cat >/root/FIX_WOLVERINE_API_POST_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"
BACKUP="${SITE}.bak_${TS}"
REPORT="/root/WOLVERINE_API_POST_FINAL_${TS}.log"

echo "=== FINAL POST FIX (NO AMBIGUITY) ===" | tee "$REPORT"

[ -f "$SITE" ] || { echo "[FATAL] site missing"; exit 1; }
cp -a "$SITE" "$BACKUP"

echo "[OK] Backup: $BACKUP" | tee -a "$REPORT"

# REMOVE ALL PREVIOUS wolverine API blocks (hard)
sed -i '/wolverine\/traderone\/api/,+30d' "$SITE"
sed -i '/location.*\/wolverine/,+30d' "$SITE"

echo "[OK] Old wolverine locations removed" | tee -a "$REPORT"

# INSERT EXPLICIT LOCATIONS (STRONGEST MATCH)
sed -i '/server_name fireinners.online;/a \
\
    # === TRADERONE API (EXPLICIT) ===\
    location = /wolverine/traderone/api/budget {\
        proxy_pass http://127.0.0.1:3000;\
        proxy_http_version 1.1;\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\
        proxy_set_header X-Forwarded-Proto $scheme;\
        add_header Content-Type application/json always;\
    }\
\
    location = /wolverine/traderone/api/dryrun {\
        proxy_pass http://127.0.0.1:3000;\
        proxy_http_version 1.1;\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\
        proxy_set_header X-Forwarded-Proto $scheme;\
        add_header Content-Type application/json always;\
    }\
' "$SITE"

echo "[OK] Explicit API locations injected" | tee -a "$REPORT"

nginx -t | tee -a "$REPORT"
systemctl reload nginx

echo "[OK] NGINX reloaded" | tee -a "$REPORT"

BASE="https://fireinners.online/wolverine/traderone/api"

echo "=== TEST POST budget ===" | tee -a "$REPORT"
curl -i -X POST "$BASE/budget" \
  -H "Content-Type: application/json" \
  --data '{"budgetSOL":0.01}' | tee -a "$REPORT"

echo "=== TEST POST dryrun ===" | tee -a "$REPORT"
curl -i -X POST "$BASE/dryrun" \
  -H "Content-Type: application/json" \
  --data '{"pubkey":"11111111111111111111111111111111"}' | tee -a "$REPORT"

echo "=== DONE ===" | tee -a "$REPORT"
echo "REPORT: $REPORT"
BASH

chmod +x /root/FIX_WOLVERINE_API_POST_FINAL.sh
/root/FIX_WOLVERINE_API_POST_FINAL.sh
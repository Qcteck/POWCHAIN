cat >/tmp/WOLVERINE_TG_SMART.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
DIR="/opt/fireinners/wolverine-telegram"
SERVICE="wolverine-tg-sentinel"
say(){ printf "%s\n" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: $1 manquant"; exit 1; }; }
need curl; need grep; need tr; need head; need tail
mkdir -p "$DIR"; chmod 700 "$DIR"

TG=""; CID=""
if [ -f "$ENV" ]; then
  # shellcheck disable=SC1090
  source "$ENV" || true
  TG="${TG_TOKEN:-${TG:-}}"
  CID="${TG_CHAT_ID:-${CID:-}}"
fi

valid_me(){
  [ -n "${TG:-}" ] || return 1
  curl -sS --max-time 10 "https://api.telegram.org/bot${TG}/getMe" | grep -q '"ok":true'
}
send_test(){
  local txt="$1"
  curl -sS --max-time 10 -X POST "https://api.telegram.org/bot${TG}/sendMessage" \
    -d "chat_id=${CID}" -d "text=${txt}" -d "disable_web_page_preview=true" | grep -q '"ok":true'
}

if valid_me && [ -n "${CID:-}" ]; then
  say "OK: token deja present + chat_id present. Test envoi..."
  if send_test "WOLVERINE: TEST SMART OK $(date -u +%FT%TZ)"; then
    systemctl restart "$SERVICE" 2>/dev/null || true
    systemctl is-active "$SERVICE" >/dev/null 2>&1 && say "OK: service active" || say "WARN: service non-active"
    say "DONE."
    exit 0
  else
    say "WARN: envoi test a echoue. On repare via auto-detect chat_id."
  fi
fi

read -r -p "Continuer et mettre a jour Telegram? (y/N) " ans || true
case "${ans,,}" in y|yes) ;; *) say "Stop."; exit 0;; esac

read -r -s -p "COLLE TG_TOKEN puis ENTER (rien ne s'affiche): " TG; echo
TG="$(printf '%s' "$TG" | tr -d '\r' | tr -d ' ')"
[ -n "$TG" ] || { say "ERREUR: token vide"; exit 1; }

UPD="$(curl -sS --max-time 12 "https://api.telegram.org/bot${TG}/getUpdates?timeout=0&limit=50" || true)"
CID="$(printf '%s' "$UPD" | tr -d '\n' | grep -oE '"chat":\{"id":[-0-9]+' | tail -n1 | grep -oE '[-0-9]+$' || true)"
[ -n "${CID:-}" ] || { say "ERREUR: chat_id introuvable. Envoie 'ping' au bot puis relance ce script."; exit 1; }

systemctl stop "$SERVICE" 2>/dev/null || true
[ -f "$ENV" ] && cp -a "$ENV" "$ENV.bak.$(date +%s)" || true
umask 077
printf "TG_TOKEN=%s\nTG_CHAT_ID=%s\n" "$TG" "$CID" >"$ENV"
chmod 600 "$ENV"

valid_me || { say "ERREUR: getMe pas ok:true (token invalide/revoke)"; exit 1; }
send_test "WOLVERINE: TOKEN OK $(date -u +%FT%TZ)" || { say "ERREUR: sendMessage pas ok:true (chat_id?)"; exit 1; }

systemctl restart "$SERVICE" 2>/dev/null || true
sleep 0.3
systemctl is-active "$SERVICE" >/dev/null 2>&1 && say "OK: service active" || say "WARN: service non-active"
say "DONE."
SH
bash /tmp/WOLVERINE_TG_SMART.sh
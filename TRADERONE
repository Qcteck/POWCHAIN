cat >/root/MEGA_BUNDLER_DEPS_RPC_REALMODE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BUNDLER_REALMODE_${TS}"
mkdir -p "$BK"
say(){ echo "[$(date +%H:%M:%S)] $*"; }

DOMAIN="fireinners.online"
VPS_IP="72.61.79.12"
RPC_DEFAULT="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"

say "backup: $BK"
cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
systemctl cat bundler-api.service >"$BK/bundler-api.service.txt" 2>/dev/null || true

say "detect: API_DIR + API_PORT from systemd"
API_DIR="$(systemctl show -p WorkingDirectory --value bundler-api.service 2>/dev/null || true)"
API_PORT="$(systemctl show -p Environment --value bundler-api.service 2>/dev/null | tr ' ' '\n' | sed -n 's/^API_PORT=//p' | tail -n1 || true)"
API_HOST="$(systemctl show -p Environment --value bundler-api.service 2>/dev/null | tr ' ' '\n' | sed -n 's/^API_HOST=//p' | tail -n1 || true)"
[ -n "${API_HOST:-}" ] || API_HOST="127.0.0.1"
[ -n "${API_PORT:-}" ] || API_PORT="9797"
[ -n "${API_DIR:-}" ] || API_DIR="/opt/bundler_api"

say "API_DIR=$API_DIR"
say "API_HOST=$API_HOST"
say "API_PORT=$API_PORT"

if [ -d "$API_DIR" ]; then
  cp -a "$API_DIR" "$BK/api_dir" 2>/dev/null || true
else
  say "ERROR: API_DIR not found: $API_DIR"
  exit 1
fi

say "node/npm versions"
node -v || true
npm -v || true

say "install deps (backend) if package.json exists"
if [ -f "$API_DIR/package.json" ]; then
  cd "$API_DIR"
  npm i --omit=dev @solana/web3.js @solana/spl-token bs58 tweetnacl dotenv express cors >/dev/null 2>&1 || npm i @solana/web3.js @solana/spl-token bs58 tweetnacl dotenv express cors
else
  say "WARN: no package.json in $API_DIR (skip npm install)"
fi

say "write env file (force real mode + set default RPC)"
ENV_FILE="$API_DIR/.env"
cp -a "$ENV_FILE" "$BK/.env.bak" 2>/dev/null || true
cat >"$ENV_FILE" <<EOF
# Auto-generated ${TS}
NODE_ENV=production
SOLANA_RPC_URL=${RPC_DEFAULT}
RPC_URL=${RPC_DEFAULT}

# Force disable stub/mocks (multiple variants; unused vars are harmless)
STUB=0
FORCE_STUB=0
BUNDLER_STUB=0
FORCE_MOCK=0
MOCK=0
PREVIEW=0

# Keep API bind if your service reads these
API_HOST=${API_HOST}
API_PORT=${API_PORT}
EOF

say "systemd override: load env file"
mkdir -p /etc/systemd/system/bundler-api.service.d
cat >/etc/systemd/system/bundler-api.service.d/override.conf <<EOF
[Service]
EnvironmentFile=${ENV_FILE}
EOF

say "restart bundler-api"
systemctl daemon-reload
systemctl restart bundler-api.service
sleep 1
systemctl --no-pager --full status bundler-api.service | sed -n '1,14p' || true

say "diag: listener"
ss -lntp | grep -E ":((${API_PORT}))\b" || true

say "test: local /health"
set +e
curl -fsS "http://${API_HOST}:${API_PORT}/health" && echo || echo "LOCAL_HEALTH_FAIL"
set -e

say "test: nginx/origin bypass cloudflare (/bundler/api/health)"
set +e
curl -k -sS --resolve "${DOMAIN}:443:${VPS_IP}" "https://${DOMAIN}/bundler/api/health" -o /dev/null -w "HTTP=%{http_code}\n"
set -e

say "search: hardcoded stub in server code"
grep -RIn --exclude-dir=node_modules -E 'stub\s*:\s*true|FORCE_STUB|BUNDLER_STUB|MOCK|preflightOnly' "$API_DIR" | head -n 80 || true

say "DONE"
say "BACKUP: $BK"
say "Now retry UI with PREFLIGHT_ONLY unchecked. If response still shows stub:true, send me the grep output above (it will point to the exact line forcing stub)."
SH
chmod +x /root/MEGA_BUNDLER_DEPS_RPC_REALMODE.sh
/root/MEGA_BUNDLER_DEPS_RPC_REALMODE.sh
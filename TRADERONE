cat >/root/cf_block_wolverine_results.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
H="fireinners.online"

hdr_public () {
  curl -skI "https://$H$1" | egrep -i "HTTP/|server:|cf-ray:|cf-cache-status:|content-type:|cache-control:" || true
}
hdr_origin () {
  curl -skI --resolve "$H:443:127.0.0.1" "https://$H$1" | egrep -i "HTTP/|server:|content-type:|cache-control:" || true
}

echo "=== PUBLIC /wolverine/index.html ==="
hdr_public "/wolverine/index.html"
echo

echo "=== ORIGIN /wolverine/index.html ==="
hdr_origin "/wolverine/index.html"
echo

echo "=== PUBLIC /wolverine/traderone/api/ ==="
hdr_public "/wolverine/traderone/api/"
echo

echo "=== ORIGIN /wolverine/traderone/api/ ==="
hdr_origin "/wolverine/traderone/api/"
echo

echo "=== Cloudflare rule expression to paste (NOT for bash) ==="
echo '(http.host eq "fireinners.online" and starts_with(http.request.uri.path, "/wolverine/") and not starts_with(http.request.uri.path, "/wolverine/traderone/api"))'
BASH

chmod +x /root/cf_block_wolverine_results.sh
/root/cf_block_wolverine_results.sh
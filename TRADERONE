cp -a "$SITE" "$SITE.bak.$(date +%s)"
if ! grep -q "$MARK" "$SITE"; then
  awk -v snip="$SNIP" -v mark="$MARK" '
    BEGIN{done=0}
    {print}
    (!done && $0 ~ /server_name/ && $0 ~ /fireinners\.online/){ print "    include " snip "; # " mark; done=1 }
  ' "$SITE" >"$SITE.tmp" && mv "$SITE.tmp" "$SITE"
fi

nginx -t
systemctl reload nginx
chattr +i /etc/nginx/nginx.conf "$SITE" 2>/dev/null || true


cat >/root/diag_403_rpc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="fireinners.online"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"

echo "== A) Où est défini /wolverine/rpc ? (ACTIVE only) =="
nl -ba "$EN" | sed -n '1,220p' | sed -n '/wolverine\/rpc/,+40p' || true
echo
if [[ -f "$SNIP" ]]; then
  echo "--- snippet: $SNIP ---"
  nl -ba "$SNIP" | sed -n '1,220p' | sed -n '/wolverine\/rpc/,+80p' || true
fi

echo
echo "== B) Cherche les causes classiques de 403 (deny/allow/return 403/if/auth) =="
grep -RIn --exclude='*.bak*' -E "return\s+403|deny\s+all|allow\s+|auth_|satisfy|map\s+\$http_origin|if\s*\(" \
  "$EN" /etc/nginx/snippets 2>/dev/null | head -n 200 || true

echo
echo "== C) Reproduire le POST comme Phantom (doit être 200, sinon on a trouvé la cause) =="
UA="Mozilla/5.0 (iPhone; CPU iPhone OS 18_6_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 Phantom/ios/25.46.3.39417"
curl -sk -i "https://${DOMAIN}/wolverine/rpc" \
  -H "User-Agent: $UA" \
  -H "Origin: https://${DOMAIN}" \
  -H "Referer: https://${DOMAIN}/wolverine/" \
  -H "Content-Type: application/json" \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,60p'

echo
echo "== D) Si c'est 403, affiche les 200 premiers bytes du body (pour savoir si c'est nginx ou autre) =="
curl -sk "https://${DOMAIN}/wolverine/rpc" \
  -H "User-Agent: $UA" \
  -H "Origin: https://${DOMAIN}" \
  -H "Referer: https://${DOMAIN}/wolverine/" \
  -H "Content-Type: application/json" \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | head -c 200; echo
BASH

chmod +x /root/diag_403_rpc.sh
/root/diag_403_rpc.sh
@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================
REM ROBO600_MEGA_EXPORT.bat
REM Exporte STL via OpenSCAD CLI
REM ============================

cd /d "%~dp0"
echo.
echo [ROBO600] Dossier courant:
echo   %CD%
echo.

echo === 0) Liste fichiers dossier ===
dir /b
echo.

echo === 1) Fix extensions cachees (.txt) ===
for %%F in (*.bat.txt) do ren "%%~nxF" "%%~nF.bat" >nul 2>&1
for %%F in (*.cmd.txt) do ren "%%~nxF" "%%~nF.cmd" >nul 2>&1
for %%F in (*.scad.txt) do ren "%%~nxF" "%%~nF.scad" >nul 2>&1
for %%F in (*.stl.txt) do ren "%%~nxF" "%%~nF.stl" >nul 2>&1
echo OK
echo.

echo === 2) Verif SCAD source ===
set "SCAD=robo600_parts.scad"
if not exist "%SCAD%" (
  if exist "robo600_parts" (
    echo - Trouve "robo600_parts" sans extension, copie vers %SCAD%
    copy /y "robo600_parts" "%SCAD%" >nul
  )
)
if not exist "%SCAD%" (
  echo [ERREUR] Fichier SCAD introuvable: %CD%\%SCAD%
  echo Mets robo600_parts.scad dans ce dossier (ou un fichier "robo600_parts" sans extension).
  pause
  exit /b 1
)
echo OK: %SCAD%
echo.

echo === 3) Verif PARTS_LIST ===
set "PARTS=PARTS_LIST"
if not exist "%PARTS%" (
  echo [ERREUR] PARTS_LIST introuvable: %CD%\%PARTS%
  echo Cree PARTS_LIST avec 1 piece par ligne. Ex:
  echo head
  echo torso
  echo pelvis
  echo upper_arm
  echo lower_arm
  echo hand
  echo thigh
  echo shin
  echo foot
  pause
  exit /b 1
)
echo OK: %PARTS%
echo.

echo === 4) Trouver OpenSCAD CLI (openscad.com) ===
set "OPENSCAD="
if exist "C:\Program Files\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD\openscad.com"
if exist "C:\Program Files\OpenSCAD (Nightly)\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD (Nightly)\openscad.com"
if exist "C:\Program Files (x86)\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files (x86)\OpenSCAD\openscad.com"

if "%OPENSCAD%"=="" (
  echo [ERREUR] OpenSCAD CLI introuvable.
  echo Installe OpenSCAD (version standard) puis relance.
  echo Chemins testes:
  echo   C:\Program Files\OpenSCAD\openscad.com
  echo   C:\Program Files (x86)\OpenSCAD\openscad.com
  pause
  exit /b 1
)
echo OK: %OPENSCAD%
echo.

echo === 5) Dossier sortie ===
set "OUT=%CD%\out_stl"
if not exist "%OUT%" mkdir "%OUT%"
echo OK: %OUT%
echo.

echo === 6) Patch SAFE du SCAD (permet -D PART="...") ===
set "PATCHED=%CD%\_robo600_parts_patched.scad"
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$s=Get-Content -Raw '%SCAD%';" ^
  "$s=$s -replace 'PART\s*=\s*\"all\"\s*;','PART=is_undef(PART)?\"all\":PART;';" ^
  "$s=$s -replace 'PART\s*=\s*''all''\s*;','PART=is_undef(PART)?\"all\":PART;';" ^
  "Set-Content -NoNewline -Encoding UTF8 '%PATCHED%' $s"
if not exist "%PATCHED%" (
  echo [ERREUR] Patch SCAD a echoue.
  pause
  exit /b 1
)
echo OK: %PATCHED%
echo.

echo === 7) Export STL (liste: PARTS_LIST) ===
echo (Si une piece echoue, c'est que son nom n'existe pas dans le SCAD.)
echo.

set /a COUNT=0
for /f "usebackq delims=" %%P in ("%PARTS%") do (
  set "P=%%P"
  if not "!P!"=="" (
    if /i not "!P:~0,1!"=="#" (
      set /a COUNT+=1
      echo [!COUNT!] %%P
      "%OPENSCAD%" -o "%OUT%\%%P.stl" -D "PART=\"%%P\"" "%PATCHED%"
      if errorlevel 1 (
        echo.
        echo [ERREUR] Export echoue: %%P
        echo - Verifie le nom dans PARTS_LIST (doit matcher les parts du SCAD)
        echo - Ou ouvre robo600_parts.scad et confirme les modules/parts disponibles
        echo.
        pause
        exit /b 1
      )
    )
  )
)

echo.
echo === 8) Resultat ===
dir /b "%OUT%\*.stl"
echo.
echo OK: %COUNT% piece(s) exportee(s) dans out_stl
echo.
echo NOTE SCALE 1:3:
echo - Dans Creality Print, mets "Scale" a 33.333%% (ou 0.3333)
echo.
pause
endlocal
HTML
chmod 0644 "$INDEX"

hr
say "2) Patch nginx include (dedupe aquilatrader + add redirect + static alias)"
[ -f "$INC" ] || die "Missing include: $INC"

# Unlock immutability if present (best effort)
chattr -i "$INC" "$VHOST" "$NGXCONF" 2>/dev/null || true

python3 - <<'PY'
import re,sys,os
inc_path="/etc/nginx/includes/wolverine_static.inc"
s=open(inc_path,"r",encoding="utf-8",errors="ignore").read().splitlines(True)

out=[]
skip=0
for line in s:
    # remove old managed block
    if "BEGIN AQUILATRADER_MANAGED" in line:
        skip=1
        continue
    if skip:
        if "END AQUILATRADER_MANAGED" in line:
            skip=0
        continue
    out.append(line)

# also remove any stray location blocks mentioning aquilatrader (defensive)
joined="".join(out)
# crude but effective: remove "location ... aquilatrader" blocks (single-level braces)
pat=re.compile(r'(?s)\n?\s*location\s+[^{;]*aquilatrader[^{]*\{.*?\}\s*')
joined2=pat.sub("\n", joined)

block = r'''
# BEGIN AQUILATRADER_MANAGED
location = /aquilatrader { return 301 /aquilatrader/; }
location ^~ /aquilatrader/ {
  alias /var/www/aquilatrader/;
  try_files $uri $uri/ /aquilatrader/index.html;
  add_header Cache-Control "no-store" always;
}
# END AQUILATRADER_MANAGED
'''
txt=joined2
if not txt.endswith("\n"): txt+="\n"
txt += "\n" + block.strip() + "\n"
open(inc_path,"w",encoding="utf-8").write(txt)
print("OK: wrote single AquilaTrader block ->", inc_path)
PY

hr
say "3) nginx -t then reload (rollback if fails)"
set +e
nginx -t
RC=$?
set -e
if [ "$RC" -ne 0 ]; then
  say "nginx -t FAILED -> rollback"
  [ -f "$BK/wolverine_static.inc.bak" ] && cp -a "$BK/wolverine_static.inc.bak" "$INC" || true
  [ -f "$BK/fireinners.online-ssl.bak" ] && cp -a "$BK/fireinners.online-ssl.bak" "$VHOST" || true
  [ -f "$BK/nginx.conf.bak" ] && cp -a "$BK/nginx.conf.bak" "$NGXCONF" || true
  nginx -t || true
  die "Rollback done. Fix not applied. See $BK"
fi

systemctl reload nginx

# Re-lock (best effort)
chattr +i "$INC" "$VHOST" "$NGXCONF" 2>/dev/null || true

hr
say "4) Quick local checks (Host header)"
curl -skI "https://127.0.0.1/aquilatrader" -H "Host: fireinners.online" | head -n 8 || true
curl -skI "https://127.0.0.1/aquilatrader/" -H "Host: fireinners.online" | head -n 8 || true
curl -sk "https://127.0.0.1/aquilatrader/" -H "Host: fireinners.online" | head -n 5 || true

hr
say "DONE. Open: https://fireinners.online/aquilatrader/"
say "Files: /var/www/aquilatrader/index.html"
say "Backup: $BK"
BASH


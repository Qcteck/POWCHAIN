import json,sys,time,math,os,urllib.request
from datetime import datetime,timezone

DS_PROFILE_LATEST="https://api.dexscreener.com/token-profiles/latest/v1"
DS_TOKEN="https://api.dexscreener.com/latest/dex/tokens/"
GT_BASE="https://api.geckoterminal.com/api/v2"

EXCLUDE_MINT="AhSGcUDNK2MKkWQe4Mz7rCPSyTJNxvtGCTuJnpUjpump"
REPORT=os.path.join(os.path.dirname(__file__),"report.json")

def jget(u,timeout=20):
  req=urllib.request.Request(u,headers={"accept":"application/json","user-agent":"aquilatrader-safe/1.0"})
  with urllib.request.urlopen(req,timeout=timeout) as r:
    return json.load(r)

def pick_best_pair(pairs):
  best=None;bs=-1
  for p in pairs or []:
    liq=(p.get("liquidity") or {}).get("usd") or 0
    v5=(p.get("volume") or {}).get("m5") or 0
    tx5=((p.get("txns") or {}).get("m5") or {})
    t=(tx5.get("buys") or 0)+(tx5.get("sells") or 0)
    price=p.get("priceUsd")
    try: price=float(price)
    except: price=0
    if price<=0: continue
    s=(math.log10(1+liq)*3)+(math.log10(1+v5)*2)+(math.log10(1+t))
    if s>bs: bs=s;best=p
  return best

def epoch_s(dtstr):
  dt=datetime.fromisoformat(dtstr.replace("Z","+00:00"))
  return int(dt.timestamp())

def gt_ohlcv(network,pool,timeframe="day",aggregate=1,before_ts=None,limit=1000,currency="usd"):
  # /networks/{network}/pools/{pool_address}/ohlcv/{timeframe}?aggregate=1&before_timestamp=...&limit=...
  q=f"aggregate={int(aggregate)}&limit={int(limit)}&currency={currency}"
  if before_ts is not None: q+=f"&before_timestamp={int(before_ts)}"
  u=f"{GT_BASE}/networks/{network}/pools/{pool}/ohlcv/{timeframe}?{q}"
  return jget(u,timeout=25)

def clamp(x,a,b): return max(a,min(b,x))

def backtest_one(candles, risk_pct, floor_pct, rth_pct):
  # candles: list [ts, open, high, low, close, volume] (GeckoTerminal style)
  # Strategy (executive simulation):
  # - compute r = (c - prev_c)/prev_c
  # - S = consecutive silence count where |r| <= rth
  # - breakout: c > max(high last N) * (1+0.006) and S>=25 (scaled for day)
  # - exit: stop -7.5% or take profits +12%, +25% staged (simplified)
  # Fees (sim only): 2% + 4% of notional per trade
  if not candles or len(candles)<80: return None
  # sort ascending by ts
  candles=sorted(candles,key=lambda x:x[0])
  eq=100.0
  peak=eq
  maxdd=0.0
  pos=0.0
  entry=0.0
  trades=0
  wins=0
  fees_total=0.0

  # convert daily S threshold from microcap UI: keep same "25" notion as regime; for daily, use 10
  S=0
  N=20
  buf=0.006
  tp1=0.12
  tp2=0.25
  sl=0.075
  tp1done=False

  for i in range(1,len(candles)):
    ts,op,hi,lo,cl,vol=candles[i]
    _,_,_,_,prev, _ = candles[i-1]
    if prev<=0: continue
    r=(cl-prev)/prev*100.0
    silent=abs(r)<=rth_pct
    S=S+1 if silent else 0

    # budget floor: if equity would drop below (100*(floor_pct/100)), disallow new entries
    floor_eq=100.0*(floor_pct/100.0)
    allow_new = eq>floor_eq

    # rolling range high
    if i>N:
      hiN=max(c[2] for c in candles[i-N:i])
    else:
      hiN=max(c[2] for c in candles[:i])

    if pos==0.0 and allow_new:
      if S>=10 and cl>hiN*(1.0+buf) and r>0:  # day regime threshold
        # enter with risk_pct of equity
        notional=eq*(risk_pct/100.0)
        fee = notional*(0.02+0.04) # 2% + 4% per trade
        fees_total+=fee
        notional-=fee
        pos=notional/cl
        entry=cl
        tp1done=False
        trades+=1
    else:
      # manage position
      if entry>0:
        ch=(cl-entry)/entry
        if (not tp1done) and ch>=tp1:
          # take half
          sell_qty=pos*0.5
          notional=sell_qty*cl
          fee=notional*(0.02+0.04)
          fees_total+=fee
          eq += (notional-fee)
          pos-=sell_qty
          tp1done=True
        elif tp1done and ch>=tp2:
          # close rest (simplified)
          notional=pos*cl
          fee=notional*(0.02+0.04)
          fees_total+=fee
          eq += (notional-fee)
          pos=0.0
          wins += 1 if cl>entry else 0
        elif ch<=-sl:
          notional=pos*cl
          fee=notional*(0.02+0.04)
          fees_total+=fee
          eq += (notional-fee)
          pos=0.0

    peak=max(peak,eq)
    dd=(peak-eq)/peak*100.0
    maxdd=max(maxdd,dd)

  # close at end if open
  if pos>0:
    cl=candles[-1][4]
    notional=pos*cl
    fee=notional*(0.02+0.04)
    fees_total+=fee
    eq += (notional-fee)
    wins += 1 if cl>entry else 0
    trades += 0
    pos=0.0

  return {"net_pnl_usd":eq-100.0,"max_drawdown_pct":maxdd,"trades":trades,"wins":wins,"fees_total_usd":fees_total}

def main():
  params={}
  if len(sys.argv)>1:
    try: params=json.loads(sys.argv[1])
    except: params={}
  risk_pct=float(params.get("risk_pct",10))
  floor_pct=float(params.get("floor_pct",25))
  topn=int(params.get("topn",90))
  timeframe=str(params.get("timeframe","day"))
  aggregate=int(params.get("aggregate",1))
  rth_pct=float(params.get("rth_pct",0.35))

  # Backtest window 2022-01-01 to 2026-12-31 (inclusive)
  start_ts=int(datetime(2022,1,1,tzinfo=timezone.utc).timestamp())
  end_ts=int(datetime(2026,12,31,23,59,59,tzinfo=timezone.utc).timestamp())

  # 1) DexScreener token profiles (solana), then resolve best pair per token (pairAddress)
  prof=jget(DS_PROFILE_LATEST,timeout=20)
  sol=[x for x in prof if str(x.get("chainId","")).lower()=="solana"]
  mints=[]
  for x in sol:
    a=x.get("tokenAddress")
    if not a or a==EXCLUDE_MINT: continue
    mints.append(a)
    if len(mints)>=max(10,min(250,topn)): break

  pairs=[]
  for a in mints:
    try:
      tok=jget(DS_TOKEN+a,timeout=20)
      pair=pick_best_pair(tok.get("pairs") or [])
      if not pair: continue
      paddr=pair.get("pairAddress") or ""
      sym=((pair.get("baseToken") or {}).get("symbol") or "")[:12]
      url=pair.get("url") or ""
      if paddr:
        pairs.append({"pair":paddr,"sym":sym,"url":url})
    except Exception:
      continue

  # 2) For each pair address, try GeckoTerminal OHLCV (treat pairAddress as pool address)
  # Respect public rate limit ~30/min: do small set + backoff
  used=[]
  results=[]
  kpi_acc={"net_pnl_usd":0.0,"max_drawdown_pct":0.0,"trades":0,"wins":0,"fees_total_usd":0.0,"tested_pools":0,"skipped":0}
  tested=0

  for i,p in enumerate(pairs[:min(len(pairs),60)]): # keep it sane under rate limit
    pool=p["pair"]
    ok=False
    candles=[]
    try:
      before=end_ts
      allc=[]
      # paginate backwards: stop when oldest <= start_ts or no more
      for _ in range(8):
        js=gt_ohlcv("solana",pool,timeframe=timeframe,aggregate=aggregate,before_ts=before,limit=1000,currency="usd")
        data=((js.get("data") or {}).get("attributes") or {}).get("ohlcv_list") or []
        if not data: break
        # GeckoTerminal returns newest->older; keep and move before
        for row in data:
          # row: [timestamp, open, high, low, close, volume]
          if row and isinstance(row,list) and len(row)>=6:
            ts=int(row[0])
            if ts<start_ts: continue
            if ts> end_ts: continue
            allc.append([int(row[0]),float(row[1]),float(row[2]),float(row[3]),float(row[4]),float(row[5])])
        oldest=min(int(r[0]) for r in data)
        before=oldest-1
        if before<=start_ts: break
        time.sleep(2.2) # rate limit friendly
      candles=allc
      r=backtest_one(candles,risk_pct,floor_pct,rth_pct)
      if r:
        ok=True
        tested+=1
        kpi_acc["net_pnl_usd"]+=r["net_pnl_usd"]
        kpi_acc["max_drawdown_pct"]=max(kpi_acc["max_drawdown_pct"],r["max_drawdown_pct"])
        kpi_acc["trades"]+=r["trades"]
        kpi_acc["wins"]+=r["wins"]
        kpi_acc["fees_total_usd"]+=r["fees_total_usd"]
        results.append({"pool":pool,"sym":p["sym"],"ok":True,"url":p["url"],"kpi":r,"candles":len(candles)})
      else:
        kpi_acc["skipped"]+=1
        results.append({"pool":pool,"sym":p["sym"],"ok":False,"url":p["url"],"reason":"not enough candles"})
    except Exception as e:
      kpi_acc["skipped"]+=1
      results.append({"pool":pool,"sym":p["sym"],"ok":False,"url":p["url"],"reason":str(e)[:180]})
    # hard throttle
    time.sleep(2.2)

  kpi_acc["tested_pools"]=tested
  winrate=(kpi_acc["wins"]/kpi_acc["trades"]*100.0) if kpi_acc["trades"]>0 else 0.0
  kpi_acc["winrate_pct"]=winrate

  out={
    "ok":True,

bash <<'FRONTFIX'
set -euo pipefail

echo "=== WOLVERINE FRONT :: 403 FIX ==="

FRONT_DIR="/var/www/wolverine"
NGINX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

# --- sanity ---
test -f "$FRONT_DIR/index.html" || {
  echo "ERROR: $FRONT_DIR/index.html missing"
  exit 1
}

# --- permissions ---
echo "[1/5] Fixing permissions..."
chown -R www-data:www-data "$FRONT_DIR"
find "$FRONT_DIR" -type d -exec chmod 755 {} \;
find "$FRONT_DIR" -type f -exec chmod 644 {} \;

# --- nginx index enforcement ---
echo "[2/5] Ensuring nginx index..."
if ! grep -q "location /wolverine" "$NGINX_VHOST"; then
  echo "ERROR: /wolverine location missing in nginx"
  exit 1
fi

# inject index rule if missing
sed -i '/location \/wolverine/,/}/{/index /!s|{|{\n    index index.html;|}' "$NGINX_VHOST"

# remove deny rules
sed -i '/location \/wolverine/,/}/s/deny all;//g' "$NGINX_VHOST"

# --- reload nginx ---
echo "[3/5] Reloading nginx..."
nginx -t
systemctl reload nginx

sleep 1

# --- live test ---
echo "[4/5] Live test..."
HTTP_CODE=$(curl -o /dev/null -s -w "%{http_code}" https://fireinners.online/wolverine/)

if [ "$HTTP_CODE" != "200" ]; then
  echo "❌ STILL FAILING (HTTP $HTTP_CODE)"
  exit 1
fi

echo
echo "======================================"
echo "✅ WOLVERINE FRONT IS LIVE"
echo "URL : https://fireinners.online/wolverine"
echo "======================================"
FRONTFIX
say "MEGA_AQUILATRADER_FIX_404"
say "Goal: https://fireinners.online/aquilatrader/ serves AquilaTrader"
hr

say "0) Snapshot backups"
[ -f "$VHOST" ] && cp -a "$VHOST" "$BK/fireinners.online-ssl.bak" || true
[ -f "$NGXCONF" ] && cp -a "$NGXCONF" "$BK/nginx.conf.bak" || true
[ -f "$INC" ] && cp -a "$INC" "$BK/wolverine_static.inc.bak" || true

hr
say "1) Ensure webroot + index.html"
mkdir -p "$WWW"
cat >"$INDEX" <<'HTML'

cd "$APPDIR"

# .env (template)
if [ ! -f "$APPDIR/.env" ]; then
  umask 077
  cat >"$APPDIR/.env" <<EOF
PORT=$PORT_DEFAULT
RPC_URL=https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac
RPC_FALLBACKS=https://api.mainnet-beta.solana.com,https://rpc.ankr.com/solana
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1
JUP_PROXY_BASE=https://bbtrader-jup.paycashnostory.workers.dev
PING_URL=https://bbbotrader.paycashnostory.workers.dev/ping

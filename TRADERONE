set -euo pipefail

echo "=== 1) Lister les fichiers non-symlink dans sites-enabled (souvent des backups) ==="
find /etc/nginx/sites-enabled -maxdepth 1 -type f -printf "%p\n" | sort || true
echo

echo "=== 2) Déplacer tous les backups fireinners* hors de sites-enabled ==="
DEST="/etc/nginx/sites-disabled/cleanup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$DEST"

# tout ce qui ressemble à .bak / bak. / before_edit / dupe / rm_tests etc.
shopt -s nullglob
for f in /etc/nginx/sites-enabled/fireinners*bak* /etc/nginx/sites-enabled/*before_edit* /etc/nginx/sites-enabled/*dupe* /etc/nginx/sites-enabled/*rm_tests*; do
  [ -e "$f" ] || continue
  mv "$f" "$DEST/"
  echo "Moved: $f -> $DEST/"
done
shopt -u nullglob

echo
echo "=== 3) Vérifier qu'il ne reste plus d'include vers fireinners_routes.conf ==="
grep -RIn --color=never "include\s\+/etc/nginx/snippets/fireinners_routes\.conf;" /etc/nginx || true
echo

echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx
echo "✅ OK nginx reloaded"
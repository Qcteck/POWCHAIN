cat >/root/FIX_WOLVERINE_SOL_USDC.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

echo "== Backup =="
cp "$HTML" "$HTML.bak_$(date +%s)" 2>/dev/null || true

echo "== Writing clean Phantom-only HTML =="

cat >"$HTML"<<HTML
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>WOLVERINE Wallet</title>
<style>
body{background:#050b10;color:#4ff;font-family:Arial}
#box{width:420px;margin:120px auto;border:2px solid #4ff;padding:20px}
button{width:100%;padding:12px;margin:6px 0;background:#081820;color:#4ff;border:1px solid #4ff;font-size:16px;cursor:pointer}
.addr{word-break:break-all;margin:10px 0}
.row{margin:6px 0}
</style>
</head>
<body>

<div id="box">
  <button onclick="connect()">Connect Wallet</button>
  <button onclick="refresh()">Refresh</button>
  <div class="addr" id="addr">-</div>
  <div class="row">SOL: <span id="sol">-</span></div>
  <div class="row">USDC: <span id="usdc">-</span></div>
</div>

<script>
const RPC = "$RPC";
const USDC_MINT = "$USDC_MINT";
let PUB = null;

async function rpc(method, params){
  const r = await fetch(RPC,{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({jsonrpc:"2.0",id:1,method,params})
  });
  return (await r.json()).result;
}

async function connect(){
  if(!window.solana || !window.solana.isPhantom){
    alert("Phantom not found");
    return;
  }
  const r = await window.solana.connect();
  PUB = r.publicKey.toString();
  document.getElementById("addr").textContent = PUB;
  await refresh();
}

async function refresh(){
  if(!PUB) return;

  const lamports = await rpc("getBalance",[PUB]);
  document.getElementById("sol").textContent = (lamports.value/1e9).toFixed(4);

  const tokens = await rpc("getParsedTokenAccountsByOwner",[
    PUB,
    {mint:USDC_MINT},
    {encoding:"jsonParsed"}
  ]);

  let usdc = 0;
  tokens.value.forEach(a=>{
    usdc += a.account.data.parsed.info.tokenAmount.uiAmount || 0;
  });
  document.getElementById("usdc").textContent = usdc.toFixed(2);
}
</script>

</body>
</html>
HTML

chown www-data:www-data "$HTML"
chmod 644 "$HTML"

echo "==============================="
echo "✅ WOLVERINE FIXED"
echo "• Phantom only"
echo "• SOL + USDC OK"
echo "• RPC DRPC OK"
echo "==============================="
echo "CTRL+SHIFT+R dans le navigateur"
BASH

chmod +x /root/FIX_WOLVERINE_SOL_USDC.sh
/root/FIX_WOLVERINE_SOL_USDC.sh







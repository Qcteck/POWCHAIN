set -e
APP="/opt/traderone-opt"
cd "$APP"

echo "=== A) Stopper TOUT ce qui écoute sur 8585 (sauf pm2 traderone) ==="
ss -ltnp | grep ':8585' || echo "OK: rien sur 8585"
PID=$(ss -ltnp | sed -n 's/.*:8585.*pid=\([0-9]\+\).*/\1/p' | head -n1 || true)
echo "PID8585=$PID"
if [ -n "$PID" ]; then
  echo "--- details ---"
  ps -fp "$PID" || true
  echo "--- cmdline ---"
  tr '\0' ' ' < /proc/"$PID"/cmdline 2>/dev/null || true
  echo
  echo "KILL pid $PID (8585)"
  kill "$PID" || true
  sleep 1
  kill -9 "$PID" 2>/dev/null || true
fi
echo

echo "=== B) Confirmer traderone écoute bien sur 3000 ==="
pm2 ls
ss -ltnp | egrep ':3000|:3002|:8585' || true
echo

echo "=== C) Trouver les vhosts nginx en double (server_name fireinners) ==="
grep -RIn --line-number -E 'server_name\s+.*fireinners\.online' /etc/nginx/sites-enabled /etc/nginx/sites-available || true
echo

echo "=== D) Confirmer proxy_pass pointe vers 3000 (pas 3002) ==="
grep -RIn --line-number -E 'proxy_pass\s+http://127\.0\.0\.1:3002|proxy_pass\s+http://127\.0\.0\.1:3000' /etc/nginx/sites-enabled | head -n 200 || true
echo

echo "=== E) Test + reload nginx ==="
nginx -t
systemctl reload nginx
echo "nginx reloaded"
echo


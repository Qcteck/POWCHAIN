const logExperiment=({domain,q,ok})=>{if(!S.caps.learn)return;const ss=S.learn.sourceScore[domain]||{ok:0,fail:0,qsum:0,n:0};
ok?ss.ok++:ss.fail++;ss.qsum+=(q||0);ss.n+=1;ss.qavg=Math.round((ss.qsum/Math.max(1,ss.n))*10)/10;S.learn.sourceScore[domain]=ss;
S.learn.experiments.push({t:Date.now(),domain,q:q||0,ok:!!ok,paywall:!!S.article.paywall,title:(S.selected?.title||"")});S.learn.experiments=S.learn.experiments.slice(-200);save();};
const copyToClipboard=async text=>{try{await navigator.clipboard.writeText(text);add("SYS","Copié.","sys");return true}catch(e){const ta=document.createElement("textarea");ta.value=text;document.body.appendChild(ta);ta.select();try{document.execCommand("copy")}catch(_){}ta.remove();add("SYS","Copie fallback.","sys");return true}};
const xIntent=text=>window.open("https://twitter.com/intent/tweet?text="+encodeURIComponent(text),"_blank","noopener,noreferrer");
const buildXPost=mode=>{const it=S.selected,sum=S.article.summary||"",tags=(S.article.tags||[]).slice(0,4),domain=S.article.domain||"",link=it?.link||"",head=it?.title||"Crypto";
const tagStr=tags.length?("Tags: "+tags.join(", ")):"";const q=S.article.q||0;
if(mode==="SURV")return`${head}\n\nRésumé:\n${sum}\n\nPosition: surveillance. ${tagStr}\nSource: ${domain}\nLien: ${link}`.slice(0,2600);
if(mode==="PLAN24")return`${head}\n\nRésumé:\n${sum}\n\nPlan (24h):\n1) surveiller prix/volume\n2) attendre confirmations\n3) agir si signal clair\n\n${tagStr}\nSource: ${domain}\nLien: ${link}`.slice(0,2600);
return`${head}\n\nPoint clé:\n${(sum.split("\n")[0]||"").replace(/^•\s*/,"")}\n\nQuestion:\nImpact sur BTC/ETH/SOL?\n\n${tagStr} • Q=${q}\nLien: ${link}`.slice(0,2600);};
const executeDecision=async kind=>{if(kind==="NEXT"){add("AI","OK. Prochain titre.","ai");return nextPick();}
if(!S.caps.x){add("AI","CAP X OFF.","warn");return;}
const txt=buildXPost(kind);await copyToClipboard(txt);
openConfirm({title:"OUVRIR X (SANS API)",meta:"copié + intent",body:`Texte:\n\n${txt}\n\nConfirmer => ouvre X.`,onYes:()=>{xIntent(txt);add("AI","X ouvert. Question (1): article web aussi?","ai");},onNo:()=>add("SYS","Refusé. Texte copié.","sys"),onAlt:()=>genArticleWeb(),altLabel:"ARTICLE WEB"});};
const decideNext=()=>{if(!S.caps.decision){add("AI","CAP DÉCISION OFF.","warn");return;}
const it=S.selected;if(!it){add("AI","Pas d’article. Je relance RSS.","ai");return loadRSS();}
const tags=S.article.tags||[],sent=S.article.sent||"Neutre",q=S.article.q||0,paywall=!!S.article.paywall;
let proposal="",risk="",kind="";
if(paywall||q<35){proposal="Ne pas conclure. Prochain titre.";risk="Risque: décider sur contenu incomplet.";kind="NEXT";}
else if(tags.includes("Sécurité")||tags.includes("Risque")||sent==="Négatif"){proposal="Commenter + surveillance (pas de trade).";risk="Risque: sur-réaction; rester factuel.";kind="SURV";}
else if(tags.includes("Macro")||tags.includes("Régulation")){proposal="Résumé + plan 24h sur X.";risk="Risque: macro évolue vite; éviter la certitude.";kind="PLAN24";}
else{proposal="Thread court (résumé + question).";risk="Risque: biais; rester sur les faits.";kind="THREAD";}
openConfirm({title:"DÉCISION → CONFIRMATION",meta:`Article: ${it.title}`,body:`Décision proposée:\n${proposal}\n\nDonnées:\n• tags: ${(tags.join(", ")||"—")}\n• sentiment: ${sent}\n• Q: ${q}\n• paywall: ${paywall?"probable":"non"}\n\n${risk}\n\nConfirmer => génère + copie + ouvre X.`,onYes:()=>executeDecision(kind),onNo:()=>add("SYS","Décision refusée. Plan ou prochain titre?","sys"),onAlt:()=>genArticleWeb(),altLabel:"ARTICLE WEB"});};
const genArticleWeb=()=>{const it=S.selected;if(!it){add("AI","Pas d’article.","warn");return;}
const title=it.title||"Article Crypto",sum=S.article.summary||"",bodyText=(S.article.text||"").slice(0,16000);
const html=`<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${title.replace(/</g,"")}</title><style>
body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Cantarell,Helvetica,Arial,sans-serif;margin:0;background:#05060b;color:#f4fbff}
main{max-width:880px;margin:0 auto;padding:22px}h1{letter-spacing:.04em}
.card{border:1px solid rgba(25,247,255,.25);background:rgba(0,0,0,.35);border-radius:14px;padding:16px;margin:14px 0}
pre{white-space:pre-wrap;word-break:break-word}a{color:#19f7ff}
</style></head><body><main><h1>${esc(title)}</h1>
<div class="card"><b>Source</b><div><a href="${esc(it.link)}">${esc(it.link)}</a></div></div>
<div class="card"><b>Résumé</b><pre>${esc(sum)}</pre></div>
<div class="card"><b>Texte extrait</b><pre>${esc(bodyText||"—")}</pre></div>
<div class="card"><b>Meta</b><pre>${esc(JSON.stringify({tags:S.article.tags,sentiment:S.article.sent,Q:S.article.q,paywall:S.article.paywall,domain:S.article.domain,time:new Date().toISOString()},null,2))}</pre></div>
</main></body></html>`;
openConfirm({title:"GÉNÉRER ARTICLE WEB (HTML)",meta:"download + aperçu",body:`Titre: ${title}\n\nConfirmer => télécharge + ouvre aperçu.`,onYes:()=>{const blob=new Blob([html],{type:"text/html;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="article_crypto_"+Date.now()+".html";document.body.appendChild(a);a.click();a.remove();window.open(url,"_blank","noopener,noreferrer");add("SYS","Article HTML généré.","sys");},onNo:()=>add("SYS","Refusé.","sys"),onAlt:()=>executeDecision("THREAD"),altLabel:"X SEUL"});};
const pumpfunChecklist=()=>{if(!S.caps.pump){add("AI","CAP PUMP OFF.","warn");return;}
openConfirm({title:"PUMP.FUN • CRÉATION TOKEN",meta:"ouvrir Pump.fun (signature Phantom requise)",body:`Checklist:\n1) Phantom prêt (SOL suffisant)\n2) Nom\n3) Ticker\n4) Description\n5) Image\n6) Liens\n\nConfirmer => ouvrir Pump.fun.`,onYes:()=>{open("https://pump.fun/","_blank","noopener,noreferrer");add("AI","Pump.fun ouvert. Question (1): nom du token?","ai");},onNo:()=>add("SYS","Refusé.","sys"),onAlt:()=>add("AI","Alternative: annonce X d’abord.","ai"),altLabel:"ANNONCE X"});};
const phantomConnect=async()=>{if(!S.caps.wallet){add("AI","CAP WALLET OFF.","warn");return;}
if(!window.solana||!window.solana.isPhantom){add("AI","Phantom non détecté. Ouvre dans le navigateur Phantom.","warn");return;}
openConfirm({title:"PHANTOM • CONNEXION",meta:"adresse publique seulement",body:"Confirmer => je demande la connexion Phantom. Tu acceptes dans Phantom.",onYes:async()=>{try{const resp=await window.solana.connect({onlyIfTrusted:false});const pub=resp?.publicKey?.toString?.()||"";S.wallet.connected=!!pub;S.wallet.pub=pub;save();renderStates();add("SYS","Wallet: "+(pub||"—"),"sys");}catch(e){pushErr("Phantom connect fail");add("AI","Connexion Phantom échouée/refusée.","warn");}},onNo:()=>add("SYS","Refusé.","sys"),onAlt:()=>add("AI","Alternative: pas de wallet.","ai"),altLabel:"CONTINUER"});};
const startConversation=()=>{const it=S.selected,tags=S.article.tags||[],sent=S.article.sent||"Neutre",sum=S.article.summary||"• (résumé indisponible)",q=S.article.q||0,pw=S.article.paywall?"probable":"non";
const opener=`J’ai lu un article RSS. Je commence.\n\nTitre:\n${it?.title||"—"}\n\nAnalyse rapide:\n• Tags: ${(tags.join(", ")||"—")}\n• Sentiment: ${sent}\n• Q: ${q}\n• Paywall: ${pw}\n\nRésumé:\n${sum}\n\nQuestion (1): je propose une décision maintenant? (Oui/Non)`;add("AI",opener,"ai");speak("J'ai lu un article. Tu veux une décision?");};
const readArticleAndStart=async it=>{if(!S.caps.article){S.state.mode="DISCUSS";S.article.text="";S.article.tags=detectTags(it.title,"");S.article.sent=sentiment(it.title,"");S.article.summary="• (CAP ARTICLE OFF)\n• basé sur le titre.";S.article.q=15;S.article.paywall=false;save();renderStates();logExperiment({domain:S.article.domain,q:S.article.q,ok:false});return startConversation();}
S.state.mode="ARTICLE_READ";save();renderStates();add("SYS","Lecture article…","sys");let raw="";
try{raw=await fetchText(it.link);}catch(e){pushErr("Article fetch fail");S.state.mode="DISCUSS";S.article.text="";S.article.tags=detectTags(it.title,"");S.article.sent=sentiment(it.title,"");S.article.summary="• (Article bloqué)\n• basé sur le titre.";S.article.q=20;S.article.paywall=true;save();renderStates();logExperiment({domain:S.article.domain,q:S.article.q,ok:false});return startConversation();}
const ex=extractMainText(raw,it.link);S.article.text=ex.text||"";S.article.q=ex.q||0;S.article.paywall=!!ex.paywall;S.article.domain=ex.domain||S.article.domain||"";
S.article.tags=detectTags(it.title,S.article.text);S.article.sent=sentiment(it.title,S.article.text);S.article.summary=summarize(S.article.text);
if(S.article.q<35)S.state.confidence=Math.max(90,S.state.confidence-1.5);else if(S.article.q>=75)S.state.confidence=Math.min(99.4,S.state.confidence+0.3);
S.state.mode="DISCUSS";save();renderStates();logExperiment({domain:S.article.domain,q:S.article.q,ok:S.article.q>=45&&!S.article.paywall});startConversation();};
const choose=async i=>{const it=(S.items||[])[i];if(!it){add("AI","Choix invalide.","warn");return;}
S.selected=it;S.pick=i;S.article={url:it.link,title:it.title,text:null,summary:null,tags:[],sent:null,q:0,paywall:false,domain:domainOf(it.link)};save();renderRSS();renderStates();await readArticleAndStart(it);};
const nextPick=async()=>{if(!(S.items||[]).length)return loadRSS();const n=Math.min(12,S.items.length);S.pick=((S.pick||0)+1)%n;save();renderRSS();renderStates();await choose(S.pick);};
const loadRSS=async()=>{if(!S.caps.rss){add("AI","CAP RSS OFF.","warn");return;}
S.state.mode="RSS_LOAD";save();renderStates();add("SYS","Lecture RSS…","sys");let all=[];
for(const u of (S.rss||[]).slice(0,6)){try{const txt=await fetchText(u);const items=parseRSS(txt);items.forEach(it=>{if(it.title&&it.link)all.push({...it,src:u})})}catch(e){pushErr("RSS fetch fail")}}
S.items=all.slice(0,36);if(!S.items.length){S.state.mode="DISCUSS";save();renderStates();add("AI","RSS vide/bloqué.","warn");return;}
const best=pickBestItem(S.items);S.selected=best;S.pick=Math.max(0,Math.min(11,S.items.indexOf(best)));S.article={url:best.link,title:best.title,text:null,summary:null,tags:[],sent:null,q:0,paywall:false,domain:domainOf(best.link)};
save();renderRSS();renderStates();await readArticleAndStart(best);};
const renderQuick=()=>quickBtns([
{t:"DÉCISION",f:()=>decideNext()},{t:"ARTICLE WEB",f:()=>genArticleWeb()},{t:"X POST",f:()=>executeDecision("THREAD")},{t:"ANNONCE TOKEN",f:async()=>{if(!S.caps.x)return add("AI","CAP X OFF.","warn");
const txt=`Annonce token:\nNom: [NOM]\nTicker: [TICKER]\nLien: [PUMP.FUN]\n\nBut: [UTILITÉ]\nAvertissement: DYOR.`;await copyToClipboard(txt);xIntent(txt);}},{t:"DEMANDE DÉPÔT",f:async()=>{if(!S.caps.x)return add("AI","CAP X OFF.","warn");
const pub=S.wallet.pub||"[TON_ADRESSE_SOLANA]";const txt=`Dépôt (Solana):\nAdresse: ${pub}\n\nBut: soutenir le projet.\nRappel: vérifier le réseau.`;
await copyToClipboard(txt);xIntent(txt);}},{t:"PUMP.FUN",f:()=>pumpfunChecklist()},{t:"PHANTOM CONNECT",f:()=>phantomConnect()},{t:"PROCHAIN TITRE",f:()=>nextPick()}
]);
const handle=async v=>{const s=String(v||"").trim();if(!s)return;add("Utilisateur",s,"user");const L=s.toLowerCase();
if(L==="oui"){add("AI","OK. Décision maintenant.","ai");return decideNext();}
if(L==="non"){add("AI","OK. Prochain titre ou article web?","ai");return renderQuick();}
if(L==="decision"||L==="décision")return decideNext();
if(L==="next"||L==="prochain")return nextPick();
if(L==="pump")return pumpfunChecklist();
if(L==="phantom")return phantomConnect();
if(L==="x")return executeDecision("THREAD");
if(/^(?:[1-9]|1[0-2])$/.test(L))return choose(parseInt(L,10)-1);
add("AI",sarcasm("Reçu. Utilise un bouton (c’est fait pour ça).","Reçu. Utilise un bouton."),"ai");};
$("#send").onclick=()=>{const v=inEl.value;inEl.value="";handle(v)};inEl.addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();const v=inEl.value;inEl.value="";handle(v)}});
$("#btnNext").onclick=()=>nextPick();$("#btnReset").onclick=()=>{localStorage.removeItem(KEY);location.reload();};
$("#btnVoice").onclick=()=>{S.prefs.voice=!S.prefs.voice;if(!audioUnlocked){audioUnlocked=true;localStorage.setItem("jarvis_audio_unlocked","true")}save();
$("#btnVoice").textContent="VOIX "+(S.prefs.voice?"ON":"OFF");add("SYS","Voix: "+(S.prefs.voice?"ON":"OFF"),"sys");speak(S.prefs.voice?"Voix activée.":"Voix désactivée.");};
Object.entries(capBtns).forEach(([k,b])=>b.onclick=()=>toggleCap(k));
load();renderCaps();renderStates();renderRSS();renderQuick();setInterval(renderStates,750);add("SYS","Boot: je lis RSS+article et je commence.","sys");loadRSS();
})();</script></body></html>
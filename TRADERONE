bash -lc 'set -euo pipefail;K="traderone|traderoone|trader one";TS="$(date +%Y%m%d_%H%M%S)";OUT="/tmp/TRADERONE_FLY_$TS";mkdir -p "$OUT";echo "[OUT] $OUT";(date;hostnamectl 2>/dev/null||true;uname -a) >"$OUT/meta.txt";
echo "=== PORTS (listen) ===" >"$OUT/ports.txt";ss -lntup 2>/dev/null >>"$OUT/ports.txt"||netstat -lntup 2>/dev/null >>"$OUT/ports.txt"||true;

echo "=== PROCESSES (grep) ===" >"$OUT/ps.txt";ps auxww | grep -Eai "$K" | grep -v grep >>"$OUT/ps.txt"||true;

echo "=== SYSTEMD UNITS (match name) ===" >"$OUT/systemd_units_name.txt";systemctl list-units --type=service --all 2>/dev/null | grep -Eai "$K" >>"$OUT/systemd_units_name.txt"||true;
echo "=== SYSTEMD UNIT FILES (grep content) ===" >"$OUT/systemd_grep.txt";(grep -RInE --binary-files=without-match "$K" /etc/systemd 2>/dev/null||true) >>"$OUT/systemd_grep.txt";

echo "=== PM2 (if present) ===" >"$OUT/pm2.txt";command -v pm2 >/dev/null 2>&1 && { pm2 list >>"$OUT/pm2.txt" 2>/dev/null||true; pm2 jlist >>"$OUT/pm2.json" 2>/dev/null||true; ls -la "$HOME/.pm2" >>"$OUT/pm2.txt" 2>/dev/null||true; grep -RInE --binary-files=without-match "$K" "$HOME/.pm2" 2>/dev/null >"$OUT/pm2_grep.txt"||true; } || echo "pm2 not found" >>"$OUT/pm2.txt";

echo "=== NGINX (sites + conf grep) ===" >"$OUT/nginx.txt";nginx -T 2>/dev/null >"$OUT/nginx_T.txt"||true;ls -la /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null >>"$OUT/nginx.txt"||true;
(grep -RInE --binary-files=without-match "$K" /etc/nginx 2>/dev/null||true) >"$OUT/nginx_grep.txt";

echo "=== CRON (grep) ===" >"$OUT/cron.txt";(crontab -l 2>/dev/null||true) >>"$OUT/cron.txt";(sudo crontab -l 2>/dev/null||true) >>"$OUT/cron.txt";
(grep -RInE --binary-files=without-match "$K" /etc/cron* /var/spool/cron 2>/dev/null||true) >"$OUT/cron_grep.txt";

echo "=== FILE/DIR NAMES (targeted) ===" >"$OUT/find_names.txt";
for P in /opt /root /var/www /home /srv /etc; do [ -e "$P" ] && find "$P" -maxdepth 6 -iname "*trader*" -o -iname "*traderoone*" -o -iname "*traderone*" 2>/dev/null; done >>"$OUT/find_names.txt"||true;

echo "=== CONTENT GREP (targeted trees) ===" >"$OUT/grep_targets.txt";
for P in /opt /root /var/www /home /srv /etc; do [ -e "$P" ] && echo "[scan] $P" >>"$OUT/grep_targets.txt"; done;
for P in /opt /root /var/www /home /srv /etc; do [ -e "$P" ] && (grep -RInE --binary-files=without-match "$K" "$P" 2>/dev/null||true) >>"$OUT/grep_targets.txt"; done;

echo "=== GIT REMOTES (if any) ===" >"$OUT/git.txt";
for BASE in /opt /root /var/www /home /srv; do
  [ -e "$BASE" ] || continue
  while IFS= read -r G; do
    D="$(dirname "$G")"
    echo "--- $D" >>"$OUT/git.txt"
    (git -C "$D" remote -v 2>/dev/null||true) >>"$OUT/git.txt"
    (git -C "$D" status -sb 2>/dev/null||true) >>"$OUT/git.txt"
  done < <(find "$BASE" -maxdepth 6 -type d -name ".git" 2>/dev/null)
done

echo "=== JOURNAL (recent keyword hits, limited) ===" >"$OUT/journal_hits.txt";
(journalctl --since "14 days ago" -o short-iso 2>/dev/null | grep -Eai "$K" | tail -n 300) >>"$OUT/journal_hits.txt"||true;

echo "=== DONE ===";echo "Dossier: $OUT";echo "Résumé matches:";for F in "$OUT"/*.txt "$OUT"/*.json 2>/dev/null; do :; done; (grep -RInE --binary-files=without-match "$K" "$OUT" 2>/dev/null | wc -l) | awk "{print \"Total lignes match dans l’output: \" \$1}";
echo "Pour partager: tar -czf ${OUT}.tgz -C /tmp $(basename "$OUT")";'
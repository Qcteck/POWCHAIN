cat >/root/FIX_AGENTIA_EADDRINUSE_SAFE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

# --- IMMUTABLE CHECKS (WOLVERINE / NGINX) ---
WOLV_HTML="/var/www/wolverine/index.html"
NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
sha(){ [ -f "$1" ] && sha256sum "$1" | awk '{print $1}' || echo "MISSING"; }
BEF_W="$(sha "$WOLV_HTML")"
BEF_N="$(sha "$NGX_SITE")"

# --- AGENTIA ---
APP_DIR="/opt/agentia"
JS="${APP_DIR}/server.js"
SVC="agentia.service"
PORT="9697"

[ "$(id -u)" -eq 0 ] || { echo "ERROR: run as root"; exit 1; }
[ -f "$JS" ] || { echo "ERROR: missing $JS"; exit 1; }

echo "== BEFORE hashes =="
echo "wolverine index: $BEF_W  $WOLV_HTML"
echo "nginx vhost    : $BEF_N  $NGX_SITE"

echo "== Stop service =="
systemctl stop "$SVC" || true

echo "== Kill anything holding :$PORT (if any) =="
# Prefer ss, fallback lsof
if command -v ss >/dev/null 2>&1; then
  PIDS="$(ss -ltnp 2>/dev/null | awk -v p=":$PORT" '$4 ~ p {print $0}' | sed -n 's/.*pid=\([0-9]\+\).*/\1/p' | sort -u | tr '\n' ' ')"
else
  PIDS=""
fi
if [ -z "${PIDS:-}" ] && command -v lsof >/dev/null 2>&1; then
  PIDS="$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | sort -u | tr '\n' ' ')"
fi
if [ -n "${PIDS:-}" ]; then
  echo "PIDS: $PIDS"
  kill $PIDS 2>/dev/null || true
  sleep 1
  kill -9 $PIDS 2>/dev/null || true
fi

echo "== Kill leftover AgentIA node (if any) =="
pkill -f "/opt/agentia/server\.js" 2>/dev/null || true

echo "== Enforce SINGLE listen in server.js =="
cp -a "$JS" "${JS}.bak_${TS}"

python3 - <<'PY'
from pathlib import Path
p=Path("/opt/agentia/server.js")
lines=p.read_text(errors="ignore").splitlines()

# Drop ALL app.listen lines to prevent double-binding
kept=[]
for ln in lines:
    if "app.listen(" in ln:
        continue
    kept.append(ln)

# Ensure exactly one listen at end (127.0.0.1 only)
listen="app.listen(PORT,'127.0.0.1',()=>{log('info','server_start',{port:PORT,base:BASE});});"
kept.append(listen)

p.write_text("\n".join(kept)+ "\n")
print("OK: single listen enforced")
PY

echo "== Start service =="
systemctl daemon-reload
systemctl start "$SVC"
sleep 1

echo "== Status (top) =="
systemctl --no-pager --full status "$SVC" | sed -n '1,30p' || true

echo "== Local health =="
curl -fsS "http://127.0.0.1:${PORT}/agentia/health" | head -c 500; echo

echo "== Public health =="
curl -kfsS "https://fireinners.online/agentia/health" | head -c 500; echo

echo "== AFTER hashes (must match) =="
AFT_W="$(sha "$WOLV_HTML")"
AFT_N="$(sha "$NGX_SITE")"
echo "wolverine index: $AFT_W  $WOLV_HTML"
echo "nginx vhost    : $AFT_N  $NGX_SITE"
[ "$BEF_W" = "$AFT_W" ] || { echo "ERROR: Wolverine index changed (should not)."; exit 1; }
[ "$BEF_N" = "$AFT_N" ] || { echo "ERROR: Nginx vhost changed (should not)."; exit 1; }

echo "OK: AgentIA fixed; Wolverine untouched."
BASH

bash /root/FIX_AGENTIA_EADDRINUSE_SAFE.sh
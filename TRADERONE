cat >/tmp/WOLVERINE_PATCH_SERVERJS_SAFE.js <<'JS'
const fs = require("fs");

const FILE = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(FILE, "utf8");

const bak = FILE + ".bak." + Date.now();
fs.copyFileSync(FILE, bak);
console.log("Backup:", bak);

// 1) Rewrite interne: /wolverine/traderone/api/* -> /api/*
if (!s.includes("WOLVERINE_REWRITE_BEGIN")) {
  const block =
`\n// WOLVERINE_REWRITE_BEGIN
app.use("/wolverine/traderone/api", (req, res, next) => {
  // ici req.url = "/balances2?wallet=..." => on préfixe /api
  req.url = "/api" + req.url;
  next();
});
// WOLVERINE_REWRITE_END\n`;

  // inject après express.json si possible, sinon après const app = express()
  const idxJson = s.search(/app\.use\(\s*express\.json\([^;]*\)\s*\)\s*;\s*/m);
  if (idxJson !== -1) {
    const m = s.match(/app\.use\(\s*express\.json\([^;]*\)\s*\)\s*;\s*/m)[0];
    s = s.replace(m, m + block);
    console.log("Injected rewrite after express.json()");
  } else {
    const idxApp = s.search(/const\s+app\s*=\s*express\(\)\s*;/m);
    if (idxApp !== -1) {
      const m2 = s.match(/const\s+app\s*=\s*express\(\)\s*;/m)[0];
      s = s.replace(m2, m2 + block);
      console.log("Injected rewrite after const app = express()");
    } else {
      throw new Error("Impossible de trouver express.json() ou const app=express()");
    }
  }
} else {
  console.log("Rewrite block already present -> skip");
}

// 2) Fix catch-all: app.get('*', ...) ne doit PAS capturer /api/*
if (s.includes("app.get('*'")) {
  // on remplace uniquement la version app.get('*', ...
  s = s.replace(/app\.get\(\s*'\*'\s*,/g, "app.get(/^\\/(?!api\\/).*/,");
  console.log("Patched app.get('*', ...) -> regex excludes /api/");
} else {
  console.log("No app.get('*', ...) found (maybe already changed) -> skip");
}

fs.writeFileSync(FILE, s, "utf8");
console.log("Patched:", FILE);
JS

node /tmp/WOLVERINE_PATCH_SERVERJS_SAFE.js

systemctl restart traderone.service
systemctl status traderone.service --no-pager -l | sed -n '1,25p'


set -euo pipefail

echo "=== 1) Node direct (bypass nginx+CF) ==="
curl -sS -i http://127.0.0.1:3000/api/health | head -n 12 || true
echo
curl -sS -i http://127.0.0.1:3000/api/dexes  | head -n 12 || true
echo

echo "=== 2) Nginx LOCAL en HTTPS (bypass Cloudflare) ==="
# On force la requête sur 127.0.0.1 mais avec Host fireinners.online (SNI/host correct)
curl -k -sS -i https://127.0.0.1/wolverine/traderone/api/health -H "Host: fireinners.online" | head -n 20 || true
echo
curl -k -sS -i https://127.0.0.1/wolverine/traderone/api/dexes  -H "Host: fireinners.online" | head -n 15 || true
echo

echo "=== 3) Nginx LOCAL en HTTP (si tu as aussi un server 80) ==="

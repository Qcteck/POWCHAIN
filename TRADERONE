cat >/root/WOLVERINE_SOLANA_NATIVE_CONNECT_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup index.html =="
cp "$HTML" "$HTML.bak_$TS"

echo "== Clean broken wallet code =="
sed -i '/WalletConnect/d;/Rainbow/d;/walletconnect/d;/connectWC/d' "$HTML"

echo "== Inject native Solana connect script =="

sed -i "/<\/body>/i \
<script>\n\
async function connect(){\n\
  if (!window.solana) {\n\
    alert('No Solana wallet detected (install Phantom / Solflare)');\n\
    return;\n\
  }\n\
  try {\n\
    const resp = await window.solana.connect();\n\
    document.getElementById('addr').innerText = resp.publicKey.toString();\n\
    console.log('Connected:', resp.publicKey.toString());\n\
  } catch(e){ console.error(e); }\n\
}\n\
</script>\n\
" "$HTML"

echo "== Ensure button uses connect() =="

sed -i 's/onclick="[^"]*"/onclick="connect()"/' "$HTML"

echo "== Permissions =="
chown www-data:www-data "$HTML"
chmod 644 "$HTML"

echo "=============================="
echo "✅ SOLANA NATIVE CONNECT READY"
echo "➡️ Phantom / Solflare / Backpack supported"
echo "➡️ Reload page CTRL+SHIFT+R"
echo "Backup: $HTML.bak_$TS"
echo "=============================="
BASH

chmod +x /root/WOLVERINE_SOLANA_NATIVE_CONNECT_FIX.sh





/root/WOLVERINE_SOLANA_NATIVE_CONNECT_FIX.sh



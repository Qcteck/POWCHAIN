<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;padding:20px;font-family:system-ui;background:#0b1b3a;color:#fff}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
a{color:#6cf}
</style>
</head>
<body>

<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>

<script>
const API = "https://aiaquila-proxy.paycashnostory.workers.dev/rss?url=";
const FEED = "https://news.bitcoin.com/feed/";

async function load(){
  const out=document.getElementById("out");
  out.textContent="Chargement…\n";
  try{
    const r=await fetch(API+encodeURIComponent(FEED),{cache:"no-store"});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();

    const raw=j.feeds?.[0]?.raw;
    if(!raw) throw new Error("RSS vide");

    const xml=new DOMParser().parseFromString(raw,"text/xml");
    const items=[...xml.querySelectorAll("item")];

    let txt="";
    items.slice(0,20).forEach((it,i)=>{
      const title=it.querySelector("title")?.textContent||"";
      const link=it.querySelector("link")?.textContent||"";
      txt+=`${i+1}. ${title}\n${link}\n\n`;
    });

    out.innerHTML=txt.replace(/\n/g,"<br>");
  }catch(e){
    out.textContent="ERREUR: "+e.message;
  }
}
</script>

</body>
</html>
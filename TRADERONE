cat >/root/fix_buffer_definitive_local_plus_inline.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

HTML="/var/www/wolverine/index.html"
LOCAL_JS="/var/www/wolverine/buffer.min.js"

test -f "$HTML" || { echo "❌ Missing $HTML"; exit 1; }
cp -a "$HTML" "${HTML}.bak_${TS}"

echo "== 1) Install local buffer.min.js (so existing <script src=buffer.min.js> stops 404) =="
curl -fsSL "https://cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js" -o "$LOCAL_JS"
chmod 0644 "$LOCAL_JS"
ls -lah "$LOCAL_JS"

echo
echo "== 2) Ensure HTML has ONE early polyfill (works with local buffer.min.js too) =="
python3 - <<'PY'
from pathlib import Path
import re

p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")

# remove any previously injected WOLVERINE polyfill blocks (clean)
s = re.sub(r"<!--\s*WOLVERINE_BUFFER_POLYFILL\s*-->.*?(?=</head>)", "", s, flags=re.S|re.I)

poly = r"""
<!-- WOLVERINE_BUFFER_POLYFILL -->
<script>
  // Minimal globals some bundles expect
  window.global = window;
  window.process = window.process || { env: {} };
</script>
<script src="/wolverine/buffer.min.js"></script>
<script>
  // Expose real Buffer (with Buffer.from)
  if (window.buffer && window.buffer.Buffer) {
    window.Buffer = window.buffer.Buffer;
  }
</script>
"""

if "</head>" in s:
    s = s.replace("</head>", poly + "\n</head>", 1)
else:
    s = poly + "\n" + s

p.write_text(s)
print("OK: injected early Buffer polyfill + local /wolverine/buffer.min.js")
PY

systemctl reload nginx || service nginx reload

echo
echo "== 3) ORIGIN checks (bypass CF) =="
curl -sk --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/ | grep -n "WOLVERINE_BUFFER_POLYFILL" && echo "HTML OK ✅" || echo "HTML NOT OK ❌"
curl -sk --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/buffer.min.js -I | sed -n '1,12p'
BASH

chmod +x /root/fix_buffer_definitive_local_plus_inline.sh
/root/fix_buffer_definitive_local_plus_inline.sh
set -e
cd /opt/traderone-opt

echo "=== 0) Backup ==="
cp -a server.js "server.js.bak.fix_dexes_v4.$(date +%s)"

echo "=== 1) Patch clean (no tricky quotes) ==="
node <<'NODE'
const fs = require("fs");
const p = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(p, "utf8");

// 1) remove any previous forced blocks (V1/V2/V3) if still present
s = s.replace(/\/\/ === FORCED_DEXES_ROUTE_V1 ===[\s\S]*?\n\}\);\n\n/g, "");
s = s.replace(/\/\/ === FORCED_DEXES_ROUTE_V2 ===[\s\S]*?\n\}\);\n\n/g, "");
s = s.replace(/\/\/ === FORCED_DEXES_ROUTE_V3 ===[\s\S]*?\n\}\);\n\n/g, "");

// 2) dedup const path/fs (keep first)
function dedupConst(name, mod){
  const re = new RegExp(`^const\\s+${name}\\s*=\\s*require\$begin:math:text$\[\"\'\]\$\{mod\}\[\"\'\]\\$end:math:text$;\\s*$`, "mg");
  const all = [...s.matchAll(re)];
  if (all.length <= 1) return;
  let firstIndex = all[0].index;
  // remove all occurrences except the first (from end to start)
  for (let i = all.length - 1; i >= 1; i--) {
    const idx = all[i].index;
    s = s.slice(0, idx) + s.slice(idx + all[i][0].length + 1); // +1 for newline usually
  }
}
dedupConst("path","path");
dedupConst("fs","fs");

// 3) ensure requires exist once (insert near top if missing)
if (!/^const\s+path\s*=\s*require\(["']path["']\);/m.test(s)) {
  s = `const path = require("path");\n` + s;
}
if (!/^const\s+fs\s*=\s*require\(["']fs["']\);/m.test(s)) {
  s = `const fs = require("fs");\n` + s;
}

// 4) insert /api/dexes after first app.use(express.json...) occurrence
const hasDexRoute = /app\.get\(\s*["']\/api\/dexes["']/.test(s);
if (!hasDexRoute) {
  const anchorRe = /app\.use\(\s*express\.json\b[\s\S]*?\)\s*;\s*/m; // matches app.use(express.json...);
  const m = s.match(anchorRe);
  if (!m) throw new Error("Anchor app.use(express.json...) not found in server.js");

  const insert = m[0] + `

app.get("/api/dexes", (req,res)=>{
  try{
    const raw = fs.readFileSync(path.join(__dirname,"config","dex_allowlist.json"),"utf8");
    const a = JSON.parse(raw);
    const dexes = Array.isArray(a) ? a.map(x=>String(x).trim()).filter(Boolean) : [];
    return res.json({ ok:true, dexes });
  }catch(e){
    return res.status(200).json({ ok:true, dexes: [], warn: String(e && e.message || e) });
  }
});

`;
  s = s.replace(anchorRe, insert);
}

fs.writeFileSync(p, s);
console.log("OK: patched server.js (dexes route inserted safely)");
NODE

echo "=== 2) Ensure allowlist file ==="
mkdir -p config
test -f config/dex_allowlist.json || cat > config/dex_allowlist.json <<'JSON'
[
  "sushiswap","jupiter","dflow","okx","mayan","chainflip",
  "gasZipBridge","relaydepository","odos","fly","relay"
]
JSON

echo "=== 3) Syntax check + restart ==="
node --check server.js
pm2 restart traderone --update-env || pm2 restart 0 --update-env
sleep 1

echo "=== 4) Test ==="
curl -sS -i http://127.0.0.1:3000/health | head -n 12 || true
echo
curl -sS http://127.0.0.1:3000/api/dexes | head -c 500; echo
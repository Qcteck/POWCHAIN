cat >/root/MEGA_AIAQUILA_FIX_404.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AIAQUILA_FIX_404_${TS}"
mkdir -p "$BK"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { echo "ERR missing $1"; exit 1; }; }
asroot(){ [ "$(id -u)" = "0" ] || { echo "ERR run as root"; exit 1; }; }

asroot
need nginx
need curl
need sed
need awk
need grep
need find
need stat

DOMAIN="fireinners.online"
SLUG="aiaquila"
INC="/etc/nginx/includes/${SLUG}_routes.inc"
PUB="/opt/${SLUG}/public"
API_HOST="127.0.0.1"
API_PORT="9688"
API_BASE="http://${API_HOST}:${API_PORT}"
NGINX_MAIN="/etc/nginx/nginx.conf"

MARK_BEGIN="# --- ${SLUG} ROUTES BEGIN (managed) ---"
MARK_END="# --- ${SLUG} ROUTES END (managed) ---"

say "== 0) Backup =="
cp -a "$NGINX_MAIN" "$BK/nginx.conf.bak" 2>/dev/null || true
cp -a "$INC" "$BK/$(basename "$INC").bak" 2>/dev/null || true
cp -a /etc/nginx/conf.d "$BK/conf.d.bak" 2>/dev/null || true
cp -a /etc/nginx/sites-available "$BK/sites-available.bak" 2>/dev/null || true
cp -a /etc/nginx/sites-enabled "$BK/sites-enabled.bak" 2>/dev/null || true

say "== 1) Unfreeze nginx files (best-effort) =="
chattr -i "$NGINX_MAIN" 2>/dev/null || true
[ -d /etc/nginx/conf.d ] && find /etc/nginx/conf.d -maxdepth 1 -type f -name "*.conf" -print0 | xargs -0 -r chattr -i 2>/dev/null || true
[ -d /etc/nginx/sites-available ] && find /etc/nginx/sites-available -maxdepth 1 -type f -print0 | xargs -0 -r chattr -i 2>/dev/null || true
[ -d /etc/nginx/sites-enabled ] && find /etc/nginx/sites-enabled -maxdepth 1 -type f -print0 | xargs -0 -r chattr -i 2>/dev/null || true
[ -d /etc/nginx/includes ] && find /etc/nginx/includes -maxdepth 1 -type f -print0 | xargs -0 -r chattr -i 2>/dev/null || true

say "== 2) Ensure webroot =="
mkdir -p "$PUB"
if [ ! -f "$PUB/index.html" ]; then
cat >"$PUB/index.html" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AQUILA</title><style>html,body{margin:0;padding:0;background:#05070b;color:#e6ebff;font-family:system-ui}main{max-width:980px;margin:40px auto;padding:16px}code{background:#0e1633;border:1px solid #2b3cff;padding:2px 6px;border-radius:6px}</style></head><body><main><h1>AQUILA</h1><p>UI servi via <code>/aiaquila/</code>. Si tu vois cette page, nginx route OK.</p></main></body></html>
HTML
fi

say "== 3) Write routes include (idempotent) =="
mkdir -p "$(dirname "$INC")"
cat >"$INC" <<EOF
$MARK_BEGIN
# Static UI
location ^~ /${SLUG}/ {
  alias ${PUB}/;
  index index.html;
  try_files \$uri \$uri/ /${SLUG}/index.html;
  add_header Cache-Control "no-store" always;
}

# API proxy
location ^~ /${SLUG}/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_connect_timeout 5s;
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;
  proxy_pass ${API_BASE}/;
}

# Convenience redirect (no trailing slash)
location = /${SLUG} { return 301 /${SLUG}/; }
$MARK_END
EOF

say "== 4) Find ALL server blocks for ${DOMAIN} on 443 and inject include =="
tmp="/tmp/${SLUG}_targets_${TS}.txt"
: >"$tmp"

# Candidate nginx config files (conf.d + sites-available + sites-enabled)
for d in /etc/nginx/conf.d /etc/nginx/sites-available /etc/nginx/sites-enabled; do
  [ -d "$d" ] || continue
  find "$d" -maxdepth 1 -type f -print0 2>/dev/null | while IFS= read -r -d '' f; do
    # quick filter
    if grep -Eq "server_name[[:space:]].*${DOMAIN}" "$f" 2>/dev/null; then
      # also ensure it likely contains 443 listen
      if grep -Eq "listen[[:space:]]+443" "$f" 2>/dev/null; then
        echo "$f" >>"$tmp"
      fi
    fi
  done
done

# De-dup
sort -u "$tmp" -o "$tmp"

if [ ! -s "$tmp" ]; then
  say "WARN: No 443 server block file matched by grep. We'll also patch the vhost you use if present."
  [ -f /etc/nginx/conf.d/000-fireinners.online-ssl.conf ] && echo "/etc/nginx/conf.d/000-fireinners.online-ssl.conf" >>"$tmp"
  sort -u "$tmp" -o "$tmp"
fi

inject_into_file(){
  local f="$1"
  # If include already present, ensure it's inside server{} by moving to first server block if needed.
  if grep -Fq "include ${INC};" "$f" 2>/dev/null; then
    return 0
  fi

  # Insert "include INC;" right after the opening brace of the first matching server block.
  # Strategy: find first line number of "server {" then insert include on next line.
  local ln
  ln="$(awk 'tolower($0) ~ /^[[:space:]]*server[[:space:]]*\{/ {print NR; exit}' "$f" 2>/dev/null || true)"
  if [ -z "${ln:-}" ]; then
    return 0
  fi

  # Insert with marker comment to avoid duplicates
  awk -v INC="${INC}" -v MARK="## ${SLUG}_include_managed" -v ln="$ln" '
    NR==ln {print; print "  "MARK; print "  include "INC";"; next}
    {print}
  ' "$f" >"${f}.tmp.${TS}"
  mv "${f}.tmp.${TS}" "$f"
}

patched=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  # only patch if it really targets the domain
  if grep -Eq "server_name[[:space:]].*${DOMAIN}" "$f" 2>/dev/null; then
    before="$(sha256sum "$f" 2>/dev/null | awk '{print $1}')"
    inject_into_file "$f" || true
    after="$(sha256sum "$f" 2>/dev/null | awk '{print $1}')"
    if [ "$before" != "$after" ]; then
      say "patched: $f"
      patched=$((patched+1))
    else
      say "ok/nochange: $f"
    fi
  fi
done <"$tmp"

say "== 5) nginx -t + reload =="
nginx -t
systemctl reload nginx

say "== 6) Smoke tests (expect 200 on HTTPS) =="
echo "--- backend local ---"
curl -fsS "${API_BASE}/api/health" || true
echo
echo "--- https /${SLUG}/api/health (forced resolve to localhost) ---"
curl -kfsS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/${SLUG}/api/health" || true
echo
echo "--- https /${SLUG}/ (headers) ---"
curl -kI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/${SLUG}/" | head -n 20 || true
echo

say "== 7) Freeze (chattr +i) and verify =="
chattr +i "$NGINX_MAIN" 2>/dev/null || true
chattr +i "$INC" 2>/dev/null || true
# Freeze all files we touched
while IFS= read -r f; do
  [ -f "$f" ] && chattr +i "$f" 2>/dev/null || true
done <"$tmp"

lsattr "$NGINX_MAIN" 2>/dev/null || true
lsattr "$INC" 2>/dev/null || true
while IFS= read -r f; do
  [ -f "$f" ] && lsattr "$f" 2>/dev/null || true
done <"$tmp"

say "DONE"
echo "URL: https://${DOMAIN}/${SLUG}/"
echo "API: https://${DOMAIN}/${SLUG}/api/health"
echo "INC: ${INC}"
echo "BACKUP: ${BK}"
BASH
chmod +x /root/MEGA_AIAQUILA_FIX_404.sh
/root/MEGA_AIAQUILA_FIX_404.sh
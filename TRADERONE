# 1) Lancer le batch en log (diagnostic)
cd /root/Wolverine
bash /root/wolv_nginx_batch.sh 2>&1 | tee /root/wolv_nginx_batch.log

# 2) Si le script propose un fix, applique-le (si ton script supporte --apply)
bash /root/wolv_nginx_batch.sh --apply 2>&1 | tee /root/wolv_nginx_batch_apply.log

# 3) Redémarre nginx + vérifie qu’il écoute bien 80/443
systemctl restart nginx
systemctl status nginx --no-pager -l
ss -lntp | egrep ':(80|443)\s'
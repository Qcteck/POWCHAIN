cat >/tmp/WOLVERINE_DEBUG_BALANCES2_RESPONSE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "Colle TON adresse Phantom (publique) :"
read -r WALLET
WALLET="$(echo -n "$WALLET" | tr -d '[:space:]')"

echo
echo "== MAINNET getBalance =="
curl -sS https://api.mainnet-beta.solana.com -H 'Content-Type: application/json' \
  --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getBalance\",\"params\":[\"$WALLET\"]}"
echo -e "\n"

echo "== balances2 via domaine =="
curl -ksS "https://fireinners.online/wolverine/traderone/api/balances2?wallet=$WALLET"
echo -e "\n"
SH

bash /tmp/WOLVERINE_DEBUG_BALANCES2_RESPONSE.sh
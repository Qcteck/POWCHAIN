cat > /root/FIX_AIAQUILA_HEALTH.sh <<'EOF'
#!/bin/bash
set -e

INDEX="/var/www/fireinners.online/aiaquila/index.html"
BACKUP="$INDEX.bak.$(date +%Y%m%d_%H%M%S)"

echo "== AIAQUILA HEALTH FIX =="

[ -f "$INDEX" ] || { echo "index.html introuvable"; exit 1; }

cp -a "$INDEX" "$BACKUP"
echo "Backup: $BACKUP"

cat > "$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;padding:20px;font-family:system-ui;background:#0b1b3a;color:#fff}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
.ok{color:#5cff9e}
.err{color:#ff7070}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (FORCÉ)</h2>

<button id="load">Lire les articles</button>
<pre id="out">En attente…</pre>

<script>
const WORKER="https://aiaquila-proxy.paycashnostory.workers.dev/rss";

document.getElementById("load").onclick=async()=>{
  const out=document.getElementById("out");
  out.textContent="Chargement…";
  try{
    const r=await fetch(WORKER,{cache:"no-store"});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();
    if(!Array.isArray(j)) throw new Error("JSON invalide");
    out.innerHTML=j.map((a,i)=>`${i+1}. ${a.title}\n${a.link}`).join("\n\n");
  }catch(e){
    out.innerHTML="<span class='err'>ERREUR: "+e.message+"</span>";
  }
};
</script>

<p class="ok">Worker: https://aiaquila-proxy.paycashnostory.workers.dev/rss</p>
</body>
</html>
HTML

nginx -t && systemctl reload nginx
echo "OK — interface nettoyée"
EOF


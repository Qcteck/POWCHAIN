cat >/root/fix_nested_rpc_location.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SSL_AV="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup vhost =="
cp -a "$SSL_AV" "${SSL_AV}.bak_${TS}"
echo "Saved: ${SSL_AV}.bak_${TS}"

echo
echo "== Snippet contains a location{} ? =="
if grep -qE '^\s*location\s' "$SNIP"; then
  echo "YES: $SNIP has location{} -> removing wrapper location from vhost (keep only include)"

  awk '
    BEGIN{inwrap=0}
    /^\s*location\s*=\s*\/wolverine\/rpc\s*\{\s*$/ {inwrap=1; print "  # RPC (from snippet)"; print "  include /etc/nginx/snippets/solana_rpc_proxy.conf;"; next}
    inwrap && /^\s*\}\s*$/ {inwrap=0; next}
    inwrap {next}
    {print}
  ' "$SSL_AV" > /tmp/fireinners.online-ssl.fixed

  mv /tmp/fireinners.online-ssl.fixed "$SSL_AV"
else
  echo "NO: snippet has no location{} -> nothing to fix"
fi

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx

echo "DONE ✅"
BASH

chmod +x /root/fix_nested_rpc_location.sh
/root/fix_nested_rpc_location.sh
#!/usr/bin/env bash
set -euo pipefail

echo "=============================="
echo " AIAQUILA – DEBUG APP (READ)"
echo "=============================="

BASE="/var/www/aiaquila"
INDEX="$BASE/index.html"

echo
echo "[1] Vérification fichier principal"
if [ ! -f "$INDEX" ]; then
  echo "❌ index.html introuvable"
  exit 1
fi
ls -lh "$INDEX"

echo
echo "[2] Extrait HEAD (scripts inclus)"
sed -n '1,200p' "$INDEX" | sed -n '/<head>/,/<\/head>/p'

echo
echo "[3] Scripts JS référencés"
grep -RInE '<script|src=' "$INDEX" || echo "⚠️ Aucun script trouvé"

echo
echo "[4] Recherche moteur IA / boucle / init"
grep -RInE 'init|start|loop|agent|ai|speak|voice|fetch|rss|price' "$INDEX" || echo "⚠️ Aucun mot-clé IA détecté"

echo
echo "[5] Taille totale HTML"
wc -c "$INDEX"

echo
echo "[6] Test chargement local (node-less)"
python3 - <<'PY'
from html.parser import HTMLParser
class P(HTMLParser):
    def handle_starttag(self, tag, attrs):
        if tag=="script":
            print("SCRIPT:", attrs)
P().feed(open("/var/www/aiaquila/index.html").read())
PY

echo
echo "=============================="
echo " FIN DIAGNOSTIC APP"
echo "=============================="
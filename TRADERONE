#!/usr/bin/env bash
set -euo pipefail

DIR="/opt/fireinners/wolverine-telegram"
ENVF="${DIR}/telegram.env"
PING_URL="https://fireinners.online/wolverine/api/ping"

say(){ printf "%s\n" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: $1 manquant"; exit 1; }; }

say "=== PRE-FLIGHT (read-only) ==="
date -u; hostname; whoami
need curl; need systemctl; need tee
[ -d "$DIR" ] || { say "ERREUR: dossier absent $DIR"; exit 1; }
[ -f "$ENVF" ] || { say "ERREUR: env absent $ENVF"; exit 1; }
[ -x /usr/local/bin/wolv_send ] || say "WARN: /usr/local/bin/wolv_send absent (on utilisera curl direct)"

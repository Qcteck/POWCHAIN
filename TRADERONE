VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
INCDIR="/etc/nginx/includes"

INC_STATIC="${INCDIR}/wolverine_static.inc"
INC_ROUTES="${INCDIR}/wolverine_routes.inc"

AQUILA_BAD="${INCDIR}/aquila_stacking_routes.inc"

VAULT_DIR="/opt/traderone-vault"
VAULT_HOST="127.0.0.1"
VAULT_PORT="8787"
VAULT_SVC="/etc/systemd/system/vault-api.service"

DRPC_URL="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"

say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }

have(){ command -v "$1" >/dev/null 2>&1; }

# short backups (avoid long names)
BKI=0
bkfile(){
  local f="$1"
  [ -e "$f" ] || return 0
  BKI=$((BKI+1))
  cp -a "$f" "$BK/bk_${BKI}" 2>/dev/null || true
}

IMLIST="$BK/immutable.list"
touch "$IMLIST"

unfreeze_one(){
  local f="$1"
  [ -e "$f" ] || return 0
  if lsattr -d "$f" 2>/dev/null | grep -q 'i'; then
    echo "$f" >>"$IMLIST"
    chattr -i "$f" 2>/dev/null || true
  fi
}
refreeze_all(){
  [ -s "$IMLIST" ] || return 0
  while IFS= read -r f; do
    [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true
  done <"$IMLIST"
}

comment_includes_everywhere(){
  local pat="$1"
  say "Disable wrong-context includes: $pat"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if grep -nE "^[[:space:]]*include[[:space:]]+.*${pat}.*;" "$f" >/dev/null 2>&1; then
      bkfile "$f"
      unfreeze_one "$f"
      perl -0777 -pe "s/^([ \\t]*include[ \\t]+[^;]*${pat}[^;]*;)/# AUTOFIX_${TS} disabled: \\1/mg" -i "$f" || true
      say "  disabled in: $f"
    fi
  done < <(find /etc/nginx -type f \( -name "*.conf" -o -name "*.inc" \) 2>/dev/null)
}

inject_in_server_block(){
  local f="$1"
  local want="$2"
  grep -F "$want" "$f" >/dev/null 2>&1 && return 0
  bkfile "$f"
  unfreeze_one "$f"
  awk -v ins="$want" '
    BEGIN{done=0}
    {print}
    !done && $0 ~ /^[[:space:]]*server[[:space:]]*\{/ { print "    " ins; done=1 }
  ' "$f" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f"
}

say "0) Preflight"
have nginx || { apt-get update -y; apt-get install -y nginx curl; }
have curl || { apt-get update -y; apt-get install -y curl; }
have node || { echo "ERROR: node missing. Fix Node/ npm first then rerun."; exit 1; }
have npm  || { echo "ERROR: npm missing. Fix Node/ npm first then rerun."; exit 1; }

say "1) Unfreeze nginx core files if immutable"
unfreeze_one "$NGXCONF"
unfreeze_one "$VHOST"
unfreeze_one "$VHOST_EN"
[ -d "$INCDIR" ] && for f in "$INCDIR"/*.inc "$INCDIR"/*.conf 2>/dev/null; do unfreeze_one "$f" || true; done


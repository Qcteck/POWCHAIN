cat > /root/FIX_NGINX_WOLVERINE_INCLUDE_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/wolverine_force_root.inc"
BACKUP="${INC}.bak.$(date +%s)"

echo "=== FINAL FIX NGINX WOLVERINE INCLUDE ==="

if [ -f "$INC" ]; then
  echo "[!] Found $INC"
  cp "$INC" "$BACKUP"
  echo "[OK] Backup: $BACKUP"

  sed -i \
    -e 's/^\s*location\s\+/## DISABLED location /g' \
    -e 's/^\s*root\s\+/## DISABLED root /g' \
    -e 's/^\s*index\s\+/## DISABLED index /g' \
    -e 's/^\s*try_files\s\+/## DISABLED try_files /g' \
    -e 's/^\s*alias\s\+/## DISABLED alias /g' \
    "$INC"

  echo "[OK] All server-level directives neutralised"
else
  echo "[INFO] Include not found, nothing to do"
fi

echo "[*] Testing nginx config"
nginx -t

echo "[*] Reloading nginx"
nginx -s reload

echo "=== DONE: NGINX CLEAN ==="
BASH

chmod +x /root/FIX_NGINX_WOLVERINE_INCLUDE_FINAL.sh



/root/FIX_NGINX_WOLVERINE_INCLUDE_FINAL.sh


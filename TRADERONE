cat >/root/AIAQUILA_FINAL_DNS_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/var/www/fireinners.online/aiaquila"
CONF="/etc/nginx/conf.d/aiaquila_api.conf"
WORKER="https://aiaquila-proxy.paycashnostory.workers.dev/rss"

echo "=== AIAQUILA FINAL DNS FIX ==="

echo "[1/4] Fix nginx conf.d (correct worker domain)"
cat >"$CONF" <<NGX
server {
    listen 443 ssl http2;
    server_name fireinners.online;

    location /aiaquila/api/rss {
        proxy_pass $WORKER;
        proxy_set_header Host aiaquila-proxy.paycashnostory.workers.dev;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }
}
NGX

echo "[2/4] Rewrite frontend (FORCE local API ONLY)"
cat >"$ROOT/index.html" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel (FORCÉ)</title>
<style>
body{margin:0;padding:20px;background:#0b1b3a;color:#fff;font-family:system-ui}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px;color:#cfe}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (FORCÉ)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
<script>
async function load(){
 const o=document.getElementById("out");
 o.textContent="Chargement…";
 try{
  const r=await fetch(
   "/aiaquila/api/rss?url="+encodeURIComponent("https://news.bitcoin.com/feed/"),
   {cache:"no-store"}
  );
  if(!r.ok) throw r.status;
  const txt=await r.text();
  const xml=new DOMParser().parseFromString(txt,"text/xml");
  const items=[...xml.querySelectorAll("item")].slice(0,20);
  o.textContent=items.map(i=>
   (i.querySelector("title")?.textContent||"")+"\n"+
   (i.querySelector("link")?.textContent||"")
  ).join("\n\n");
 }catch(e){
  o.textContent="ERREUR: "+e;
 }
}
</script>
</body>
</html>
HTML

echo "[3/4] Reload nginx"
nginx -t
systemctl reload nginx

echo "[4/4] VPS test"
curl -I "https://fireinners.online/aiaquila/api/rss?url=https://news.bitcoin.com/feed/"

echo "DONE"
BASH

chmod +x /root/AIAQUILA_FINAL_DNS_FIX.sh
/root/AIAQUILA_FINAL_DNS_FIX.sh
set -e
APP="/opt/traderone-opt"
NG="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "=== 0) Ports locaux ==="
ss -ltnp | egrep ':3000|:3002|:8585' || true
echo

echo "=== 1) PM2 status ==="
pm2 ls || true
echo

echo "=== 2) NGINX: vérifier proxy_pass ==="
[ -f "$NG" ] || { echo "KO: $NG introuvable"; exit 1; }
grep -nE "proxy_pass|127\.0\.0\.1:3000|127\.0\.0\.1:3002" "$NG" || true
echo

echo "=== 3) Corriger Nginx 3002 -> 3000 (backup + reload) ==="
cp -a "$NG" "$NG.bak.$(date +%s)"
sed -i 's/127\.0\.0\.1:3002/127.0.0.1:3000/g' "$NG"
nginx -t
systemctl reload nginx
echo "OK: nginx reloaded"
echo

echo "=== 4) Test health local (3000) ==="
curl -sS -i http://127.0.0.1:3000/health | head -n 20 || true
echo

echo "=== 5) Test swap LI.FI (Solana chainId correct) ==="
curl -sS -i -X POST "http://127.0.0.1:3000/api/swap" \
  -H "content-type: application/json" \
  --data '{
    "provider":"lifi",
    "fromChain":1151111081099710,
    "toChain":1151111081099710,
    "fromToken":"So11111111111111111111111111111111111111112",
    "toToken":"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
    "fromAmount":"1000000",
    "fromAddress":"11111111111111111111111111111111",
    "slippage":0.5
  }' | head -n 120 || true
echo

echo "=== 6) Logs traderone (60 lignes) ==="
pm2 logs traderone --lines 60 --nostream 2>/dev/null | tail -n 60 || true
echo "=== FIN ==="
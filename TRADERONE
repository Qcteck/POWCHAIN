#!/usr/bin/env bash
set -euo pipefail

### CONFIG
TRADERONE_DIR="/opt/traderone"
FRONT_DIR="/var/www/wolverine"
APP_NAME="traderone-vault"
REPORT="/root/TRADERONE_ALLINONE_$(date +%Y%m%d_%H%M%S).log"
API_FILE="$TRADERONE_DIR/server.js"

echo "=== TRADERONE ALL-IN-ONE START ===" | tee "$REPORT"

### 1) Sanity checks
[ -d "$TRADERONE_DIR" ] || { echo "❌ $TRADERONE_DIR missing"; exit 1; }
[ -f "$API_FILE" ] || { echo "❌ server.js missing"; exit 1; }

### 2) Backup
cp -a "$API_FILE" "$API_FILE.bak.$(date +%s)"
echo "[OK] Backup done" | tee -a "$REPORT"

### 3) Force JSON everywhere (no HTML fallback)
grep -q "res.json" "$API_FILE" || {
sed -i '1i app.use((req,res,next)=>{res.setHeader("Content-Type","application/json");next();});' "$API_FILE"
}
echo "[OK] JSON enforced" | tee -a "$REPORT"

### 4) SOL ONLY – disable SPL token calls
sed -i 's/getParsedTokenAccountsByOwner/\/\* SOL_ONLY_DISABLED \*\//g' "$API_FILE"
echo "[OK] SOL only enforced" | tee -a "$REPORT"

### 5) Kill broken RegExp
sed -i 's/new RegExp([^)]*)/null/g' "$API_FILE"
echo "[OK] RegExp cleaned" | tee -a "$REPORT"

### 6) Ensure API routes
grep -q "/api/budget" "$API_FILE" || cat >>"$API_FILE"<<'JS'
app.post("/wolverine/traderone/api/budget",(req,res)=>{
 const {budgetSOL}=req.body||{};
 if(!budgetSOL||budgetSOL<=0)return res.status(400).json({error:"invalid budget"});
 global.TRADERONE_BUDGET_SOL=Number(budgetSOL);
 res.json({ok:true,budgetSOL});
});
app.post("/wolverine/traderone/api/dryrun",(req,res)=>{
 res.json({ok:true,mode:"dryrun",budgetSOL:global.TRADERONE_BUDGET_SOL||0});
});
JS
echo "[OK] API routes ensured" | tee -a "$REPORT"

### 7) NGINX proxy fix
NGX="/etc/nginx/sites-available/fireinners.online-ssl"
sed -i 's|proxy_pass http://127.0.0.1:[0-9]*|proxy_pass http://127.0.0.1:3000|g' "$NGX"
nginx -t && systemctl reload nginx
echo "[OK] Nginx proxy fixed" | tee -a "$REPORT"

### 8) Restart PM2 clean
pm2 restart "$APP_NAME" --update-env
pm2 save
echo "[OK] PM2 restarted" | tee -a "$REPORT"

### 9) API tests (JSON ONLY)
curl -s -X POST https://fireinners.online/wolverine/traderone/api/budget \
 -H "Content-Type: application/json" \
 -d '{"budgetSOL":0.01}' | jq . || echo "❌ Budget test failed" | tee -a "$REPORT"

curl -s -X POST https://fireinners.online/wolverine/traderone/api/dryrun \
 -H "Content-Type: application/json" | jq . || echo "❌ Dryrun failed" | tee -a "$REPORT"

### 10) Final status
pm2 status | tee -a "$REPORT"

echo "=== DONE : TRADERONE STABLE / SOL ONLY / NO UI ERRORS ===" | tee -a "$REPORT"
echo "REPORT: $REPORT"
cat >/root/patch_wolverine_phantom_auto.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DIR:-/opt/_wolverine_next_src}"
cd "$APP_DIR"

pick_target() {
  local base="$1"
  for ext in jsx js tsx ts; do
    [[ -f "pages/${base}.${ext}" ]] && { echo "pages/${base}.${ext}"; return 0; }
    [[ -f "pages/${base}/index.${ext}" ]] && { echo "pages/${base}/index.${ext}"; return 0; }
  done
  return 1
}

TARGET=""
TARGET="$(pick_target wallet || true)"
[[ -n "$TARGET" ]] || TARGET="$(pick_target trade || true)"

if [[ -z "$TARGET" ]]; then
  echo "[ERR] Pas de page wallet/trade trouvée."
  echo "Check: ls -la pages | sed -n '1,120p'"
  exit 1
fi

echo "[OK] Target=$TARGET"
cp -a "$TARGET" "/root/backup_$(date +%Y%m%d_%H%M%S)_$(basename "$TARGET")"

# Overwrite page to mount Phantom (client-only)
cat > "$TARGET" <<'EOF'
import dynamic from "next/dynamic";
const WalletPhantom = dynamic(() => import("../components/WalletPhantom"), { ssr: false });

export default function Page() {
  return (
    <div style={{ padding: 12 }}>
      <WalletPhantom />
    </div>
  );
}
EOF

npm run build
rsync -a --delete out/ /var/www/wolverine/
nginx -t && systemctl reload nginx

echo "✅ OK: Phantom injecté dans $TARGET"
echo "👉 Test:"
echo "  https://fireinners.online/wolverine/wallet/"
echo "  https://fireinners.online/wolverine/trade/"
BASH

chmod +x /root/patch_wolverine_phantom_auto.sh
/root/patch_wolverine_phantom_auto.sh
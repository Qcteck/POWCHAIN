<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>ASAN • Menu Terre</title><style>:root{--bg:#05080b;--p:#0b1320;--b:#0e1b2b;--g:#0e2a1d;--t:#e9f2ff;--m:#9fb6d6;--ok:#9cffc2;--bad:#ff9c9c;--w:rgba(255,255,255,.10);--w2:rgba(255,255,255,.06)}*{box-sizing:border-box}html,body{height:100%;margin:0;background:radial-gradient(1200px 800px at 20% 0%,#08142b 0%,transparent 60%),radial-gradient(900px 600px at 90% 20%,#071c14 0%,transparent 55%),radial-gradient(900px 600px at 40% 90%,#0b0f1a 0%,transparent 50%),var(--bg);color:var(--t);font:14px ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial;overflow:hidden}a{color:inherit;text-decoration:none}#app{height:100%;display:grid;grid-template-columns:320px 1fr;gap:12px;padding:12px}#left,#main{border:1px solid var(--w);background:linear-gradient(180deg,rgba(12,18,30,.92),rgba(6,10,18,.92));border-radius:18px;box-shadow:0 20px 80px rgba(0,0,0,.55);backdrop-filter:blur(10px);overflow:hidden}#left{position:relative}#left:before{content:"";position:absolute;inset:-80px;opacity:.55;background:radial-gradient(closest-side at 30% 30%,rgba(120,210,255,.25),transparent 60%),radial-gradient(closest-side at 70% 60%,rgba(120,255,190,.22),transparent 65%),radial-gradient(closest-side at 40% 85%,rgba(255,255,255,.08),transparent 70%);pointer-events:none}#left .pad{position:relative;z-index:1;padding:14px}#brand{display:flex;align-items:center;gap:12px;margin-bottom:12px}#globe{width:54px;height:54px;border-radius:50%;position:relative;box-shadow:0 0 0 1px var(--w),0 10px 25px rgba(0,0,0,.55),inset 0 0 30px rgba(0,0,0,.35);background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.28),transparent 35%),radial-gradient(circle at 65% 65%,rgba(0,0,0,.55),transparent 60%),radial-gradient(circle at 55% 40%,rgba(60,160,255,.95),rgba(10,50,100,.95) 55%,rgba(4,10,20,1) 100%)}#globe:after{content:"";position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 40% 65%,rgba(80,255,170,.75),transparent 45%),radial-gradient(circle at 55% 45%,rgba(80,255,170,.65),transparent 40%),radial-gradient(circle at 60% 30%,rgba(80,255,170,.55),transparent 35%);mix-blend-mode:screen;filter:blur(.2px)}#orbit{position:absolute;inset:-14px;border-radius:50%;border:1px dashed rgba(255,255,255,.12);animation:spin 12s linear infinite}#orbit:after{content:"";position:absolute;top:50%;left:0;transform:translate(-50%,-50%);width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.65);box-shadow:0 0 12px rgba(180,240,255,.8)}@keyframes spin{to{transform:rotate(360deg)}}#title{line-height:1.1}#title b{display:block;font-size:16px;letter-spacing:.6px}#title span{display:block;color:var(--m);font-size:12px;margin-top:4px}#menu{display:flex;flex-direction:column;gap:8px;margin-top:10px}button{all:unset;cursor:pointer} .btn{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border-radius:14px;border:1px solid var(--w);background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.03));transition:.12s transform,.12s border-color,.12s background} .btn:hover{transform:translateY(-1px);border-color:rgba(255,255,255,.18)} .btn:active{transform:translateY(0)} .btn .k{color:var(--m);font-size:12px} .btn.on{border-color:rgba(140,255,210,.35);background:linear-gradient(180deg,rgba(120,255,190,.12),rgba(255,255,255,.03))}#tools{margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:8px} .pill{padding:10px 12px;border-radius:14px;border:1px solid var(--w);background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02))} .pill input{all:unset;width:100%;color:var(--t);font-size:12px}#file{display:none}#hint{margin-top:10px;color:var(--m);font-size:12px;line-height:1.35}#main{display:flex;flex-direction:column}#top{padding:14px;border-bottom:1px solid var(--w);display:flex;align-items:center;justify-content:space-between;gap:10px}#top .h{display:flex;flex-direction:column;gap:2px}#top .h b{font-size:15px}#top .h span{color:var(--m);font-size:12px}#badge{padding:8px 10px;border-radius:999px;border:1px solid var(--w);background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.02));font-size:12px;color:var(--m)}#body{flex:1;overflow:auto;padding:14px}#cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px} .card{border:1px solid var(--w);border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));padding:12px;min-height:120px} .card h3{margin:0 0 8px;font-size:13px;color:var(--m);letter-spacing:.4px} .kv{display:grid;grid-template-columns:140px 1fr;gap:6px 10px;font-size:12px} .kv div:nth-child(odd){color:var(--m)} .mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;white-space:pre-wrap;word-break:break-word} .ok{color:var(--ok)} .bad{color:var(--bad)}#log{margin-top:12px;border:1px solid var(--w);border-radius:16px;background:linear-gradient(180deg,rgba(0,0,0,.22),rgba(0,0,0,.08));padding:10px}#log .mono{max-height:220px;overflow:auto}#drop{border:1px dashed rgba(255,255,255,.20);border-radius:16px;padding:14px;color:var(--m);background:rgba(0,0,0,.12)}#drop b{color:var(--t)}@media(max-width:980px){#app{grid-template-columns:1fr}#cards{grid-template-columns:1fr}}</style></head><body><div id="app"><aside id="left"><div class="pad"><div id="brand"><div id="globe"><div id="orbit"></div></div><div id="title"><b>ASAN</b><span>Menu Terre • Audit read-only</span></div></div><div id="menu"><button class="btn on" data-tab="dash"><span>Tableau</span><span class="k">D</span></button><button class="btn" data-tab="files"><span>Fichiers</span><span class="k">F</span></button><button class="btn" data-tab="services"><span>Services</span><span class="k">S</span></button><button class="btn" data-tab="ports"><span>Ports</span><span class="k">P</span></button><button class="btn" data-tab="public"><span>Public</span><span class="k">W</span></button><button class="btn" data-tab="raw"><span>JSON brut</span><span class="k">J</span></button></div><div id="tools"><div class="pill"><input id="api" placeholder="API base (optionnel) ex: https://fireinners.online" value=""/></div><button class="pill" id="run">Lancer scan</button><button class="pill" id="import">Importer JSON</button><button class="pill" id="export">Exporter</button></div><input id="file" type="file" accept="application/json"/><div id="hint">Utilise <b>Importer JSON</b> pour charger un rapport ASAN. <br/>Option: <b>Lancer scan</b> tente un fetch sur <span class="mono">[API]/asan/run</span>.</div></div></aside><main id="main"><div id="top"><div class="h"><b id="h1">Tableau</b><span id="h2">Aucun rapport chargé</span></div><div id="badge">score: --</div></div><div id="body"><div id="drop"><b>Glisse-dépose</b> un fichier JSON ASAN ici, ou clique <b>Importer JSON</b>.</div><div id="cards" style="display:none"></div><div id="log" style="display:none"><div class="mono" id="raw"></div></div></div></main></div><script>(function(){const $=s=>document.querySelector(s),$$=s=>Array.from(document.querySelectorAll(s));let state={tab:"dash",report:null,srcName:""};const ui={h1:$("#h1"),h2:$("#h2"),badge:$("#badge"),cards:$("#cards"),raw:$("#raw"),log:$("#log"),drop:$("#drop"),api:$("#api")};function setTab(t){state.tab=t;$$(".btn[data-tab]").forEach(b=>b.classList.toggle("on",b.dataset.tab===t));ui.h1.textContent=({dash:"Tableau",files:"Fichiers",services:"Services",ports:"Ports",public:"Public",raw:"JSON brut"})[t]||t;render()}function fmtTs(x){if(!x)return"";try{return new Date(x).toLocaleString()}catch(e){return String(x)}}function badge(score,level){ui.badge.textContent="score: "+(score??"--")+(level?(" • "+level):"");ui.badge.style.borderColor=level==="critical"?"rgba(255,120,120,.35)":level==="important"?"rgba(255,200,120,.35)":"rgba(140,255,210,.20)"}function card(title,html){return `<div class="card"><h3>${title}</h3>${html}</div>`}function kv(obj){const rows=[];for(const [k,v] of Object.entries(obj))rows.push(`<div>${k}</div><div class="mono">${(v===null||v===undefined)?"":String(v)}</div>`);return `<div class="kv">${rows.join("")}</div>`}function render(){const r=state.report;ui.drop.style.display=r?"none":"block";ui.cards.style.display=(r&&state.tab!=="raw")?"grid":"none";ui.log.style.display=(r&&state.tab==="raw")?"block":"none";if(!r){ui.h2.textContent="Aucun rapport chargé";badge(null,null);return}ui.h2.textContent=(state.srcName?state.srcName+" • ":"")+("ts: "+fmtTs(r.ts||r.time||""));badge(r.score,r.level);if(state.tab==="raw"){ui.raw.textContent=JSON.stringify(r,null,2);return}const cards=[];if(state.tab==="dash"){cards.push(card("Résumé",kv({host:r.host||"",kernel:r.kernel||"",uptime:r.uptime||"",score:r.score??"",level:r.level||"",nginx_test:(r.nginx_test&&("ok" in r.nginx_test)?r.nginx_test.ok:r.nginx_test)??""})));const pub=(r.public||[]).slice(0,6).map(x=>`${x.url} • ${x.http_code} • ${x.time_total}`).join("\n");cards.push(card("Public",`<div class="mono">${pub||""}</div>`));const miss=r.missing_ports||{};cards.push(card("Ports manquants",`<div class="mono">tcp: ${(miss.tcp||[]).join(", ")||""}\nudp: ${(miss.udp||[]).join(", ")||""}</div>`));const sv=(r.services||[]).map(s=>`${s.name}: ${s.state}`).join("\n");cards.push(card("Services",`<div class="mono">${sv||""}</div>`))}else if(state.tab==="files"){const fs=(r.wanted_files||[]).map(f=>{const ok=f.exists;return `${ok?"OK":"MISSING"} • ${f.path}\nsha256: ${f.sha256||""}\nlsattr: ${f.lsattr||""}\n`;}).join("\n");cards.push(card("Fichiers",`<div class="mono">${fs||""}</div>`))}else if(state.tab==="services"){const sv=(r.services||[]).map(s=>`${s.name}: ${s.state}`).join("\n");cards.push(card("Services",`<div class="mono">${sv||""}</div>`))}else if(state.tab==="ports"){const miss=r.missing_ports||{};cards.push(card("Manquants",`<div class="mono">tcp: ${(miss.tcp||[]).join(", ")||""}\nudp: ${(miss.udp||[]).join(", ")||""}</div>`));cards.push(card("Listen tcp (extrait)",`<div class="mono">${(r.listen_tcp||"").slice(0,5000)}</div>`));cards.push(card("Listen udp (extrait)",`<div class="mono">${(r.listen_udp||"").slice(0,5000)}</div>`))}else if(state.tab==="public"){const pub=(r.public||[]).map(x=>`${x.url}\ncode: ${x.http_code}\ntime: ${x.time_total}\n`).join("\n");cards.push(card("HTTP",`<div class="mono">${pub||""}</div>`))}ui.cards.innerHTML=cards.join("")}async function runScan(){const base=(ui.api.value||"").trim().replace(/\/$/,"");const url=(base?base:location.origin)+"/asan/run";logLine("RUN "+url);try{const res=await fetch(url,{method:"GET",credentials:"include"});const txt=await res.text();if(!res.ok)throw new Error("HTTP "+res.status+" "+txt.slice(0,200));const j=JSON.parse(txt);state.report=j;state.srcName="API: "+url;render();logLine("OK loaded")}catch(e){logLine("ERREUR: "+(e&&e.message?e.message:String(e)))} }function logLine(s){const box=$("#raw");const now=new Date().toLocaleTimeString();box.textContent=(box.textContent?box.textContent+"\n":"")+`[${now}] ${s}`;ui.log.style.display="block"}function importJson(file){const rd=new FileReader();rd.onload=()=>{try{state.report=JSON.parse(String(rd.result||"{}"));state.srcName=file?file.name:"fichier";render();logLine("OK import "+state.srcName)}catch(e){logLine("ERREUR JSON: "+(e&&e.message?e.message:String(e)))} };rd.readAsText(file)}function exportJson(){if(!state.report){logLine("Rien à exporter");return}const blob=new Blob([JSON.stringify(state.report,null,2)],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="asan_report_export.json";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1500)}$$(".btn[data-tab]").forEach(b=>b.addEventListener("click",()=>setTab(b.dataset.tab)));$("#run").addEventListener("click",runScan);$("#import").addEventListener("click",()=>$("#file").click());$("#export").addEventListener("click",exportJson);$("#file").addEventListener("change",e=>{const f=e.target.files&&e.target.files[0];if(f)importJson(f)});const drop=ui.drop;["dragenter","dragover"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.style.borderColor="rgba(140,255,210,.35)"}));["dragleave","drop"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.style.borderColor="rgba(255,255,255,.20)"}));drop.addEventListener("drop",e=>{const f=e.dataTransfer.files&&e.dataTransfer.files[0];if(f)importJson(f)});render();})();</script></body></html>
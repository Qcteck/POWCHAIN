bash <<'EOF'
set -e

echo "=== AIAQUILA AUTO-FIX RSS (WORKER ONLY) ==="

### CONFIG
AIA_DIR="/var/www/fireinners.online/aiaquila"
WORKER_URL="https://aiaquila-proxy.workers.dev"

### 1. Sécurisation
cd /root || exit 1

### 2. Neutraliser rss.php (cause principale du bug)
if [ -f "$AIA_DIR/rss.php" ]; then
  echo "[+] Neutralisation rss.php"
  mv "$AIA_DIR/rss.php" "$AIA_DIR/rss.php.DISABLED.$(date +%s)"
fi

### 3. Patch frontend (JS inline ou script)
echo "[+] Patch frontend AIAQUILA"

sed -i \
  -E "s|(fetch\\()(['\"]).*rss.php[^'\"]*(['\"])|\\1\\2$WORKER_URL/?url=|g" \
  "$AIA_DIR"/*.html || true

sed -i \
  -E "s|(fetch\\()(['\"]).*rss.php[^'\"]*(['\"])|\\1\\2$WORKER_URL/?url=|g" \
  "$AIA_DIR"/*.js || true

### 4. Sécuriser parsing JSON (anti Unexpected token <)
for f in "$AIA_DIR"/*.js; do
  grep -q "response.json()" "$f" && \
  sed -i 's/response.json()/response.text().then(t=>JSON.parse(t))/g' "$f"
done

### 5. Permissions
chown -R www-data:www-data "$AIA_DIR"
chmod -R 755 "$AIA_DIR"

### 6. Reload nginx (safe)
nginx -t && systemctl reload nginx

### 7. TEST DIRECT WORKER
echo
echo "=== TEST WORKER DIRECT ==="
curl -s "$WORKER_URL/?url=https://news.bitcoin.com/feed/" | head -n 20

echo
echo "=== AIAQUILA RSS FIX APPLIED SUCCESSFULLY ==="
echo "Frontend branché UNIQUEMENT sur Worker Cloudflare"
echo "Plus de PHP, plus de CORS, plus de faux JSON"
EOF
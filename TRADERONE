set -euo pipefail

OUT_DIR="/root/phantom-out"
URL="https://fireinners.online/test/"
mkdir -p "$OUT_DIR"

cat > "$OUT_DIR/render.js" <<'JS'
var page = require('webpage').create();
var system = require('system');

if (system.args.length < 3) {
  console.log("Usage: phantomjs render.js <url> <out.png>");
  phantom.exit(1);
}

var url = system.args[1];
var out = system.args[2];

page.viewportSize = { width: 1400, height: 900 };
page.settings.userAgent = "Mozilla/5.0 (X11; Linux x86_64) PhantomJS/2.1.1";

page.open(url, function(status) {
  if (status !== 'success') {
    console.log("FAIL open:", status);
    phantom.exit(2);
  }
  window.setTimeout(function() {
    page.render(out);
    console.log("OK wrote", out);
    phantom.exit(0);
  }, 2000);
});
JS

# Image PhantomJS Docker (isolé des libs de ton serveur)
docker run --rm -v "$OUT_DIR":/work -w /work wernight/phantomjs:2.1.1 \
  phantomjs render.js "$URL" /work/test.png

ls -lah "$OUT_DIR/test.png"
echo "✅ Screenshot: $OUT_DIR/test.png" 
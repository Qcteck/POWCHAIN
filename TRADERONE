<script src=\"/aiaquila/vendor/solana-web3.iife.min.js\"></script>
<script>
(function(){
  // Buffer/process globals (safe)
  try{ if(typeof globalThis.process==='undefined' && typeof process!=='undefined') globalThis.process=process; }catch(e){}
  try{ if(typeof globalThis.Buffer==='undefined' && typeof buffer!=='undefined' && buffer.Buffer) globalThis.Buffer=buffer.Buffer; }catch(e){}

  const {Connection,PublicKey,Transaction,SystemProgram,clusterApiUrl}=solanaWeb3;

  const KEY='AIAQUILA_DB_V1';
  const now=()=>Date.now();
  const dayKey=()=>new Date().toISOString().slice(0,10); // UTC day
  const $=id=>document.getElementById(id);

  const DEFAULT_POLICY={
    allowDests:{
      \"11111111111111111111111111111111\": 5000
    },
    maxLamportsPerTx: 10000,
    cooldownMsAfterFinalized: 15000
  };

  function load(){
    try{ return JSON.parse(localStorage.getItem(KEY)||'null'); }catch(e){ return null; }
  }
  function save(db){
    localStorage.setItem(KEY, JSON.stringify(db));
  }
  let DB=load()||{
    arm:false,
    wallet:null,
    policy:DEFAULT_POLICY,
    usage:{}, // {day:{dest:used}}
    pending:null, // {id,status,dest,lamports,createdAt,signedB64,sig,blockhash,lastValidBlockHeight,err}
    lastFinalizedAt:0,
    logs:[]
  };
  save(DB);

  function log(s){
    DB.logs.push('['+new Date().toISOString()+'] '+s);
    if(DB.logs.length>400) DB.logs=DB.logs.slice(-300);
    save(DB);
    render();
  }

  function setState(s){ $('chipST').textContent='STATE: '+s; }

  // RPCs: primary DRPC + fallback mainnet
  const RPCS=[
    \"https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac\",
    clusterApiUrl('mainnet-beta')
  ];
  let RPC_IDX=0;
  function conn(commitment){ return new Connection(RPCS[RPC_IDX], commitment||'confirmed'); }
  function rotateRPC(){ RPC_IDX=(RPC_IDX+1)%RPCS.length; $('chipRPC').textContent='RPC: '+RPC_IDX; }

  async function withRetry(fn, label){
    let wait=400;
    for(let i=0;i<5;i++){
      try{ return await fn(); }
      catch(e){
        const m=(e&&e.message)||String(e);
        log(label+' fail '+(i+1)+'/5: '+m);
        if(/429|rate|timeout|fetch|network/i.test(m)) rotateRPC();
        await new Promise(r=>setTimeout(r, wait));
        wait=Math.min(2500, Math.floor(wait*1.8));
      }
    }
    throw new Error(label+' failed after retries');
  }

  function policyText(){ return JSON.stringify(DB.policy, null, 2); }
  function parsePolicy(txt){
    const p=JSON.parse(txt);
    if(!p || typeof p!=='object') throw new Error('bad policy');
    if(!p.allowDests || typeof p.allowDests!=='object') throw new Error('allowDests required');
    p.maxLamportsPerTx = Number(p.maxLamportsPerTx||DEFAULT_POLICY.maxLamportsPerTx);
    p.cooldownMsAfterFinalized = Number(p.cooldownMsAfterFinalized||DEFAULT_POLICY.cooldownMsAfterFinalized);
    return p;
  }

  function usedToday(dest){
    const d=dayKey();
    const day=DB.usage[d]||{};
    return Number(day[dest]||0);
  }
  function addUsageFinalized(dest, lamports){
    const d=dayKey();
    DB.usage[d]=DB.usage[d]||{};
    DB.usage[d][dest]=Number(DB.usage[d][dest]||0)+Number(lamports||0);
    save(DB);
  }

  function inCooldown(){
    return now() < (DB.lastFinalizedAt + Number(DB.policy.cooldownMsAfterFinalized||0));
  }

  async function sha256Hex(str){
    const enc=new TextEncoder().encode(str);
    const buf=await crypto.subtle.digest('SHA-256', enc);
    return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
  }

  let provider=null;

  async function connectWallet(){
    if(!window.solana) throw new Error('Phantom requis (sur iPhone: ouvrir dans le navigateur Phantom)');
    provider=window.solana;
    if(!provider.isPhantom) log('WARN: window.solana present but not Phantom');
    const r=await provider.connect();
    DB.wallet=r.publicKey.toString();
    save(DB);
    log('Wallet connecté: '+DB.wallet);
  }

  async function disconnectWallet(){
    try{ if(provider && provider.disconnect) await provider.disconnect(); }catch(e){}
    DB.wallet=null; save(DB);
    log('Wallet déconnecté');
  }

  function validatePropose(destStr, lamStr){
    if(!DB.arm) throw new Error('ARM requis');
    if(!DB.wallet) throw new Error('Wallet requis');
    if(inCooldown()) throw new Error('Cooldown actif');
    const lam=Number(lamStr||0);
    if(!Number.isFinite(lam) || lam<=0) throw new Error('Lamports invalid');
    if(lam > Number(DB.policy.maxLamportsPerTx||0)) throw new Error('Depasse maxLamportsPerTx');
    const dest=destStr.trim();
    if(!dest) throw new Error('DEST requis');
    if(!DB.policy.allowDests[dest]) throw new Error('DEST pas dans allowlist');
    const maxDay=Number(DB.policy.allowDests[dest]);
    const used=usedToday(dest);
    if(used + lam > maxDay) throw new Error('Quota depasse (today '+used+'/'+maxDay+')');
    return {dest,lam};
  }

  async function propose(){
    const {dest,lam}=validatePropose($('dest').value, $('lam').value);
    const id=await sha256Hex(DB.wallet+'|'+dest+'|'+lam+'|'+dayKey()+'|'+now());
    DB.pending={id,status:'PROPOSED',dest,lamports:lam,createdAt:now(),signedB64:null,sig:null,blockhash:null,lastValidBlockHeight:null,err:null};
    save(DB);
    log('Proposed pending id='+id+' dest='+dest+' lamports='+lam);
  }

  function reject(){
    if(DB.pending){ DB.pending.status='REJECTED'; DB.pending.err='user_reject'; save(DB); log('Pending rejeté'); }
  }

  function resetPending(){
    DB.pending=null; save(DB); log('Pending reset');
  }

  async function approveAndSend(){
    if(!DB.pending) throw new Error('No pending');
    if(DB.pending.status==='FINALIZED') throw new Error('Already finalized');
    if(!DB.arm) throw new Error('ARM requis');
    if(!DB.wallet) throw new Error('Wallet requis');
    if(inCooldown()) throw new Error('Cooldown actif');
    const dest=DB.pending.dest, lam=Number(DB.pending.lamports);

    // If already signed, reuse signed bytes (idempotent)
    if(DB.pending.signedB64){
      setState('SENDING');
      const signedBytes=Uint8Array.from(atob(DB.pending.signedB64), c=>c.charCodeAt(0));
      const c=conn('confirmed');
      const sig=await withRetry(()=>c.sendRawTransaction(signedBytes,{skipPreflight:false,maxRetries:3}), 'sendRawTransaction');
      DB.pending.sig=sig; DB.pending.status='SENT'; save(DB);
      log('TX resent (idempotent) sig='+sig);
      await confirmFinalized();
      return;
    }

    setState('PREPARE');
    const c=conn('confirmed');
    const from=new PublicKey(DB.wallet);
    const to=new PublicKey(dest);

    const latest=await withRetry(()=>c.getLatestBlockhash('confirmed'), 'getLatestBlockhash');
    const tx=new Transaction().add(SystemProgram.transfer({fromPubkey:from,toPubkey:to,lamports:lam}));
    tx.feePayer=from;
    tx.recentBlockhash=latest.blockhash;

    DB.pending.blockhash=latest.blockhash;
    DB.pending.lastValidBlockHeight=latest.lastValidBlockHeight;
    DB.pending.status='SIGNING';
    save(DB);
    log('Signing...');

    let signed;
    try{
      signed=await provider.signTransaction(tx);
    }catch(e){
      DB.pending.status='REJECTED'; DB.pending.err='sign_reject'; save(DB);
      throw e;
    }

    const bytes=signed.serialize();
    DB.pending.signedB64=btoa(String.fromCharCode.apply(null, Array.from(bytes)));
    DB.pending.status='SIGNED';
    save(DB);
    log('Signed OK (stored signed tx for replay-safe)');

    setState('SENDING');
    const sig=await withRetry(()=>c.sendRawTransaction(bytes,{skipPreflight:false,maxRetries:3}), 'sendRawTransaction');
    DB.pending.sig=sig;
    DB.pending.status='SENT';
    save(DB);
    log('Sent sig='+sig);

    await confirmFinalized();
  }

  async function confirmFinalized(){
    if(!DB.pending || !DB.pending.sig) throw new Error('No sig to confirm');
    setState('CONFIRMING_FINALIZED');
    const c=conn('finalized');
    const sig=DB.pending.sig;
    const bh=DB.pending.blockhash;
    const lvh=DB.pending.lastValidBlockHeight;

    await withRetry(async()=>{
      // confirmTransaction can take {signature,blockhash,lastValidBlockHeight}
      await c.confirmTransaction({signature:sig,blockhash:bh,lastValidBlockHeight:lvh}, 'finalized');
      return true;
    }, 'confirmTransaction(finalized)');

    DB.pending.status='FINALIZED';
    DB.lastFinalizedAt=now();
    addUsageFinalized(DB.pending.dest, DB.pending.lamports);
    save(DB);
    log('FINALIZED ✅ sig='+sig+' (quota consumed)');
    setState('FINALIZED');
  }

  function render(){
    $('chipARM').textContent='ARM: '+(DB.arm?'ON':'OFF');
    $('chipW').textContent='WALLET: '+(DB.wallet?DB.wallet.slice(0,4)+'…'+DB.wallet.slice(-4):'-');
    $('chipNET').textContent='NET: mainnet';
    $('chipRPC').textContent='RPC: '+RPC_IDX;
    $('policy').value=policyText();
    $('chipPOL').textContent='POLICY: '+Object.keys(DB.policy.allowDests||{}).length+' dest(s)';
    $('log').textContent=(DB.logs||[]).slice(-120).join('\\n');
    $('pending').textContent=DB.pending?JSON.stringify(DB.pending,null,2):'-';
    const cd=inCooldown()?Math.max(0, Math.ceil((DB.lastFinalizedAt+Number(DB.policy.cooldownMsAfterFinalized||0)-now())/1000)):0;
    $('cooldown').textContent=cd?('cooldown '+cd+'s'):'';
  }
  render();
  setState('IDLE');

  // Resume confirm if refresh happened after send
  (async()=>{
    try{
      if(DB.pending && (DB.pending.status==='SENT' || DB.pending.status==='SIGNED') && DB.pending.sig){
        log('Resume pending confirm...');
        await confirmFinalized();
      }
    }catch(e){
      log('Resume failed: '+((e&&e.message)||String(e)));
    }
  })();

  $('btnConnect').onclick=async()=>{ try{ setState('CONNECT'); await connectWallet(); setState('READY'); }catch(e){ log('Connect err: '+((e&&e.message)||String(e))); setState('ERR'); } };
  $('btnDisconnect').onclick=async()=>{ try{ await disconnectWallet(); setState('IDLE'); }catch(e){ log('Disconnect err: '+((e&&e.message)||String(e))); } };

  $('btnARM').onclick=()=>{ DB.arm=true; save(DB); log('ARM ON'); render(); };
  $('btnDISARM').onclick=()=>{ DB.arm=false; save(DB); log('ARM OFF'); render(); };

  $('btnPropose').onclick=async()=>{ try{ setState('PROPOSE'); await propose(); setState('PROPOSED'); }catch(e){ log('Propose err: '+((e&&e.message)||String(e))); setState('ERR'); } };
  $('btnApprove').onclick=async()=>{ try{ await approveAndSend(); }catch(e){ DB.pending && (DB.pending.status='FAILED', DB.pending.err=((e&&e.message)||String(e)), save(DB)); log('Approve/send err: '+((e&&e.message)||String(e))); setState('FAILED'); } };
  $('btnReject').onclick=()=>{ try{ reject(); setState('REJECTED'); }catch(e){} };
  $('btnReset').onclick=()=>{ resetPending(); setState('IDLE'); };

  $('btnSavePolicy').onclick=()=>{ try{ DB.policy=parsePolicy($('policy').value); save(DB); log('Policy saved'); render(); }catch(e){ log('Policy parse err: '+((e&&e.message)||String(e))); } };
  $('btnLoadPolicy').onclick=()=>{ render(); log('Policy reloaded'); };

})();
</script>
</body></html>
"


cat >/root/WOLVERINE_ROLLBACK_FRONTEND_OK.sh <<'BASH'
#!/usr/bin/env bash
set -e

HTML="/var/www/wolverine/index.html"
BK="$(ls -t /var/www/wolverine/index.html.bak_* 2>/dev/null | head -n1)"

echo "=== WOLVERINE FRONTEND ROLLBACK ==="

if [ -z "$BK" ]; then
  echo "❌ AUCUN BACKUP TROUVÉ — ROLLBACK IMPOSSIBLE"
  exit 1
fi

echo "✔ Backup trouvé : $BK"
cp -a "$BK" "$HTML"

nginx -t && systemctl reload nginx

echo "✅ FRONTEND RESTAURÉ (AVANT FRONT ROSE)"
echo "👉 Recharge la page : CTRL + SHIFT + R"
BASH

chmod +x /root/WOLVERINE_ROLLBACK_FRONTEND_OK.sh
/root/WOLVERINE_ROLLBACK_FRONTEND_OK.sh
cat >/root/FIX_DUPLICATE_WOLVERINE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SNIPPET="/etc/nginx/snippets/fireinners.conf"
BACKUP="/root/snippet_fireinners_backup_$(date +%s).conf"

if [ -f "$SNIPPET" ]; then
  echo "[FIX] backup snippet"
  cp -a "$SNIPPET" "$BACKUP"

  echo "[FIX] remove any wolverine location from snippet"
  sed -i '/location\s\+\/wolverine\//,/}/d' "$SNIPPET"
else
  echo "[INFO] snippet not found, skipping"
fi

echo "[TEST] nginx config"
nginx -t

echo "[RELOAD] nginx"
systemctl reload nginx

echo "[OK] duplicate /wolverine fixed"
[ -f "$BACKUP" ] && echo "[INFO] snippet backup: $BACKUP"
SH

chmod +x /root/FIX_DUPLICATE_WOLVERINE.sh
/root/FIX_DUPLICATE_WOLVERINE.sh
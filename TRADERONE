python3 - <<'PY'
import os,re
back=os.environ["BACK"]
to_def=os.environ["TRADERONE_WALLET_DEFAULT"]
usdc=os.environ["USDC_MINT"]
rpcdef=os.environ["RPC_DEFAULT"]
txt=open(back,"r",encoding="utf-8",errors="ignore").read()

M0="// WOLV_CONFIRM_DEPOSIT_v1"
M1="// /WOLV_CONFIRM_DEPOSIT_v1"
if M0 in txt and M1 in txt:
  txt=txt.split(M0,1)[0]+txt.split(M1,1)[1]

inject=f'''
// WOLV_CONFIRM_DEPOSIT_v1
const __WOLV_USDC_MINT="{usdc}";
const __WOLV_RPC=(process.env.SOLANA_RPC||process.env.RPC_URL||"{rpcdef}");
const __WOLV_TRADERONE_WALLET=(process.env.TRADERONE_WALLET||"{to_def}");

async function __wolv_rpc(method, params){{
  const r=await fetch(__WOLV_RPC,{{method:"POST",headers:{{"content-type":"application/json"}},body:JSON.stringify({{jsonrpc:"2.0",id:1,method,params}})}});
  const j=await r.json().catch(()=>null);
  if(!r.ok||!j) throw new Error("rpc_http");
  if(j.error) throw new Error(j.error.message||"rpc_err");
  return j.result;
}}

function __wolv_num(x){{ const n=Number(x); return Number.isFinite(n)?n:0; }}

function __wolv_findSignerPub(messageKeys, pub){{
  const p=String(pub||"");
  for(const k of (messageKeys||[])) {{
    if(k && typeof k==="object") {{
      if(String(k.pubkey||"")===p && k.signer) return true;
    }} else {{
      if(String(k||"")===p) return true;
    }}
  }}
  return false;
}}

function __wolv_findIdx(messageKeys, addr){{
  const a=String(addr||"");
  for(let i=0;i<(messageKeys||[]).length;i++){{
    const k=messageKeys[i];
    const pk=(k&&typeof k==="object")?String(k.pubkey||""):String(k||"");
    if(pk===a) return i;
  }}
  return -1;
}}

function __wolv_tokenTotal(metaArr, owner, mint){{
  let total=0;
  for(const e of (metaArr||[])){{
    if(!e) continue;
    if(String(e.mint||"")!==String(mint)) continue;
    if(String(e.owner||"")!==String(owner)) continue;
    const ui=e.uiTokenAmount||{{}};
    const amt=__wolv_num(ui.uiAmount);
    if(amt) total+=amt;
  }}
  return total;
}}

app.post("/api/confirm_deposit", express.json(), async (req,res)=>{{
  try{{
    const body=req.body||{{}};
    const pub=String(body.pub||"").trim();
    const asset=String(body.asset||"").trim().toUpperCase();
    const amount=__wolv_num(body.amount);
    const sig=String(body.sig||"").trim();
    const to=String(body.to||__WOLV_TRADERONE_WALLET).trim();
    if(!pub||!sig||!(amount>0)||!to) return res.status(400).json({{ok:false,error:"params"}});
    if(asset!=="SOL" && asset!=="USDC") return res.status(400).json({{ok:false,error:"asset"}});
    if(String(to)!==String(__WOLV_TRADERONE_WALLET)) return res.status(400).json({{ok:false,error:"to_mismatch"}});
    const tx=await __wolv_rpc("getTransaction",[sig,{{encoding:"jsonParsed",commitment:"confirmed",maxSupportedTransactionVersion:0}}]);
    if(!tx || !tx.meta || !tx.transaction || !tx.transaction.message) return res.status(400).json({{ok:false,error:"tx_not_found_or_unconfirmed"}});
    if(tx.meta.err) return res.status(400).json({{ok:false,error:"tx_failed"}});
    const keys=tx.transaction.message.accountKeys||[];
    if(!__wolv_findSignerPub(keys,pub)) return res.status(400).json({{ok:false,error:"signer_not_pub"}});
    let delta=0;
    if(asset==="SOL"){{
      const idx=__wolv_findIdx(keys,to);
      if(idx<0) return res.status(400).json({{ok:false,error:"to_not_in_keys"}});
      const pre=(tx.meta.preBalances||[])[idx]||0;
      const post=(tx.meta.postBalances||[])[idx]||0;
      delta=(post-pre)/1e9;
    }} else {{
      const pre=__wolv_tokenTotal(tx.meta.preTokenBalances||[], to, __WOLV_USDC_MINT);
      const post=__wolv_tokenTotal(tx.meta.postTokenBalances||[], to, __WOLV_USDC_MINT);
      delta=(post-pre);
    }}
    if(!(delta>0)) return res.status(400).json({{ok:false,error:"delta_zero"}});
    if(delta + 1e-12 < amount*0.999) return res.status(400).json({{ok:false,error:"delta_too_small",delta}});

    // credit ledger (requires WOLV_INVEST_LEDGER_v1 patch already present)
    if(typeof __wolv_load!=="function" || typeof __wolv_apply!=="function" || typeof __wolv_save!=="function") {{
      return res.status(500).json({{ok:false,error:"ledger_patch_missing"}});
    }}
    const db=__wolv_load();
    __wolv_apply(db,pub,asset,amount,sig,"deposit");
    __wolv_save(db);

    res.json({{ok:true,asset,amount,delta,slot:tx.slot||null,blockTime:tx.blockTime||null}});
  }}catch(e){{
    res.status(500).json({{ok:false,error:String(e&&e.message||e)}});
  }}
}});
// /WOLV_CONFIRM_DEPOSIT_v1
'''
m=re.search(r"\n\s*app\.listen\s*\(",txt)
if m: txt=txt[:m.start()]+inject+"\n"+txt[m.start():]
else: txt=txt+"\n"+inject+"\n"
open(back,"w",encoding="utf-8").write(txt)
print("OK BACK:",back)
PY


#!/usr/bin/env bash
set -euo pipefail

need_root(){ [ "${EUID:-$(id -u)}" -eq 0 ] || { echo "ERR: run as root"; exit 1; }; }
ts(){ date +"%Y%m%d_%H%M%S"; }
say(){ echo "[$(date -u +"%F %T UTC")] $*"; }

DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SITESEN="/etc/nginx/sites-enabled"
INCDIR="/etc/nginx/includes"
INC="$INCDIR/wolverine_routes.inc"

BK="/root/WV_FIX_404_$(ts)"

backup_all(){
  say "Backup -> $BK"
  mkdir -p "$BK/nginx" "$BK/webroot" "$BK/meta"
  cp -a /etc/nginx "$BK/nginx/" 2>/dev/null || true
  [ -d "$WEBROOT" ] && cp -a "$WEBROOT" "$BK/webroot/" 2>/dev/null || true
  [ -f "$VHOST" ] && cp -a "$VHOST" "$BK/meta/$(basename "$VHOST").bak" 2>/dev/null || true
}

unfreeze_all(){
  say "Unfreeze (chattr -i) best-effort"
  command -v chattr >/dev/null 2>&1 || return 0
  chattr -i -R /etc/nginx 2>/dev/null || true
  chattr -i -R "$WEBROOT" 2>/dev/null || true
}

refreeze_best(){
  say "Refreeze (chattr +i) best-effort"
  command -v chattr >/dev/null 2>&1 || return 0
  chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
  chattr +i "$VHOST" 2>/dev/null || true
  chattr +i "$INC" 2>/dev/null || true
}


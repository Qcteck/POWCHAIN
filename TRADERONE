cat >/tmp/ADD_WOLVERINE_EAGLE_PAGE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DIR="/var/www/fireinners/wolverine_eagle"
SNIP="/etc/nginx/snippets/wolverine_eagle.conf"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"

mkdir -p "$DIR"

cat >"$DIR/index.html" <<'EOF'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<title>Wolverine – Vision d’aigle</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  body{margin:0;font-family:system-ui,Segoe UI,Arial;background:#0b0f14;color:#e6edf3}
  header{background:#111827;padding:12px 18px;border-bottom:1px solid #1f2937}
  h1{margin:0;font-size:16px}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:12px;padding:12px}
  .card{background:#020617;border:1px solid #1f2937;border-radius:10px;padding:10px}
  .card h2{margin:0 0 8px 0;font-size:13px;color:#38bdf8}
  iframe{width:100%;height:360px;border:0;background:#000;border-radius:8px}
  code{font-family:ui-monospace,Consolas,monospace;font-size:12px}
</style>
</head>
<body>
<header><h1>🦅 Wolverine — Vision d’aigle (VPS)</h1></header>

<div class="grid">
  <div class="card">
    <h2>TraderOne UI</h2>
    <iframe src="/wolverine/traderone/"></iframe>
  </div>

  <div class="card">
    <h2>TraderOne API status</h2>
    <iframe src="/wolverine/traderone/api/status"></iframe>
  </div>

  <div class="card">
    <h2>Commandes utiles</h2>
    <div><code>systemctl status traderone</code></div>
    <div><code>journalctl -u traderone -n 100 --no-pager</code></div>
    <div><code>nginx -t && systemctl reload nginx</code></div>
    <div><code>tail -n 80 /var/log/nginx/error.log</code></div>
  </div>
</div>
</body>
</html>
EOF

cat >"$SNIP" <<'EOF'
# WOLVERINE_EAGLE_V1
location ^~ /wolverine/eagle/ {
  alias /var/www/fireinners/wolverine_eagle/;
  try_files $uri $uri/ /wolverine/eagle/index.html;
}
EOF

python3 - <<'PY'
import re
p="/etc/nginx/sites-available/fireinners.online-ssl"
inc="    include /etc/nginx/snippets/wolverine_eagle.conf; # WOLVERINE_EAGLE_INCLUDE_V1\n"
s=open(p,"r",encoding="utf-8",errors="ignore").read()
if "wolverine_eagle.conf" in s:
    print("OK include déjà présent")
else:
    m=re.search(r'^\s*server\s*\{\s*$', s, flags=re.M)
    if not m: raise SystemExit("ERREUR: pas trouvé 'server {' dans "+p)
    s=s[:m.end()]+"\n"+inc+s[m.end():]
    open(p,"w",encoding="utf-8").write(s)
    print("OK include ajouté")
PY

nginx -t && systemctl reload nginx

echo "TEST:"
curl -ksS --max-time 6 https://fireinners.online/wolverine/eagle/ | head -n 5
SH

bash /tmp/ADD_WOLVERINE_EAGLE_PAGE.sh
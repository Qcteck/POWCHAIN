dir /b "C:\Program Files\OpenSCAD\openscad.com" 2>nul && echo OK
dir /b "C:\Program Files\OpenSCAD (Nightly)\openscad.com" 2>nul && echo OK
dir /b "C:\Program Files (x86)\OpenSCAD\openscad.com" 2>nul && echo OK



@echo off
setlocal EnableExtensions EnableDelayedExpansion
cd /d "%~dp0"

set "SCAD=%cd%\robo600_parts.scad"
if not exist "%SCAD%" (
  echo [ERREUR] SCAD introuvable: "%SCAD%"
  pause
  exit /b 1
)

set "OUT=%cd%\out_stl"
if not exist "%OUT%" mkdir "%OUT%"

set "OPENSCAD="
if exist "C:\Program Files\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD\openscad.com"
if exist "C:\Program Files\OpenSCAD (Nightly)\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD (Nightly)\openscad.com"
if exist "C:\Program Files (x86)\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files (x86)\OpenSCAD\openscad.com"

if "%OPENSCAD%"=="" (
  echo [ERREUR] openscad.com introuvable. Installe OpenSCAD ou ajuste le chemin.
  pause
  exit /b 1
)

echo OpenSCAD: "%OPENSCAD%"
echo SCAD:     "%SCAD%"
echo OUT:      "%OUT%"
echo.

set PARTS=pelvis_half1 pelvis_half2 torso_half1 torso_half2 head_half1 head_half2 back_hatch neck_ring face_plate jaw shoulder_joint elbow_joint hip_joint knee_joint upperarm_half1 upperarm_half2 forearm_half1 forearm_half2 hand thigh_half1 thigh_half2 shin_half1 shin_half2 foot dc_mount_small dc_mount_big driver_tray pca_esp_tray lcd_bezel solar_bracket_left solar_bracket_right cable_clip

for %%P in (%PARTS%) do (
  echo [%%P] ...
  "%OPENSCAD%" -o "%OUT%\%%P.stl" -D PART=\"%%P\" "%SCAD%"
  if errorlevel 1 (
    echo [ERREUR] export STL echoue: %%P
    pause
    exit /b 1
  )
)

echo.
echo OK: STL generes dans "%OUT%"
dir /b "%OUT%\*.stl" | find /c ".stl"
pause
endlocal
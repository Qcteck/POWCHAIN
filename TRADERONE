bash -lc 'set -euo pipefail;DOMAIN="fireinners.online";VHOST="/etc/nginx/sites-available/fireinners.online-ssl";HTPASS="/etc/nginx/.htpasswd_sentinel1";PATHLOC="/_private_sentinel1_/";UPSTREAM="http://127.0.0.1:3000";echo "== (A) Sanity ==";[ -f "$VHOST" ]||{ echo "ERR vhost: $VHOST introuvable"; exit 1; };echo "VHOST=$VHOST";echo "== (B) Unlock immutable if needed ==";if lsattr "$VHOST" 2>/dev/null|grep -q "^-i";then chattr -i "$VHOST";echo "unlocked";else echo "not immutable";fi;echo "== (C) Backup ==";ts="$(date +%Y%m%d-%H%M%S)";cp -a "$VHOST" "$VHOST.bak.$ts";echo "== (D) Ensure htpasswd exists (user sentinel) ==";command -v htpasswd >/dev/null 2>&1||{ apt-get update -y; apt-get install -y apache2-utils; };mkdir -p /etc/nginx; if [ -f "$HTPASS" ]; then htpasswd "$HTPASS" sentinel; else htpasswd -c "$HTPASS" sentinel; fi;chmod 640 "$HTPASS";chown root:www-data "$HTPASS" 2>/dev/null||true;echo "== (E) FORCE inject location block in SSL vhost if missing ==";if grep -q "_private_sentinel1_" "$VHOST";then echo "location already present (somewhere)";else perl -0777 -i -pe "s/(server\\s*\\{)/\$1\\n\\n    # PRIVATE SENTINEL (UI)\\n    location = \\/_private_sentinel1_ { return 301 \\/_private_sentinel1_\\/; }\\n    location ^~ \\/_private_sentinel1_\\/ {\\n      auth_basic \\\"Sentinel\\\";\\n      auth_basic_user_file \\/etc\\/nginx\\/.htpasswd_sentinel1;\\n      add_header Cache-Control \\\"no-store\\\" always;\\n      proxy_pass http:\\/\\/127.0.0.1:3000\\/;\\n      proxy_http_version 1.1;\\n      proxy_set_header Host \\$host;\\n      proxy_set_header X-Real-IP \\$remote_addr;\\n      proxy_set_header X-Forwarded-For \\$proxy_add_x_forwarded_for;\\n      proxy_set_header X-Forwarded-Proto \\$scheme;\\n    }\\n\\n/s" "$VHOST";echo "location injected";fi;echo "== (F) nginx test + reload ==";nginx -t;systemctl reload nginx;echo "== (G) LOCAL test (bypass Cloudflare) - should be 401 ==";curl -skI "https://127.0.0.1$PATHLOC" -H "Host: $DOMAIN" | head -n 20;echo "== (H) PUBLIC test - should be 401 ==";curl -sI "https://$DOMAIN$PATHLOC" | head -n 20;echo "== DONE == If LOCAL=401 but PUBLIC=200 => Cloudflare cache/rule is serving old page."'
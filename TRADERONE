cd /opt/traderone-opt || exit 1

echo "=== 1) Vérification .env ==="
if ! grep -q "^LIFI_API_KEY=" .env; then
  echo "❌ LIFI_API_KEY absente dans .env"
  echo "Ajoute-la dans /opt/traderone-opt/.env sous la forme :"
  echo "LIFI_API_KEY=ta_cle_lifi_ici"
  exit 1
else
  echo "✅ LIFI_API_KEY présente dans .env"
fi

echo
echo "=== 2) Export dans l'environnement root (pour tests immédiats) ==="
export $(grep -v '^#' .env | xargs) 2>/dev/null || true
echo "OK export"

echo
echo "=== 3) Vérifier que Node voit la clé ==="
node -e 'console.log("LIFI_API_KEY visible:", !!process.env.LIFI_API_KEY, "len=", (process.env.LIFI_API_KEY||"").length)'

echo
echo "=== 4) Injecter dans PM2 ==="
pm2 set traderone:LIFI_API_KEY "$LIFI_API_KEY"
pm2 save

echo
echo "=== 5) Restart bot ==="
pm2 restart traderone

sleep 3

echo
echo "=== 6) Re-test local /api/swap ==="
curl -sS -i -X POST "http://127.0.0.1:3000/api/swap" \
  -H "content-type: application/json" \
  --data '{
    "provider": "lifi",
    "fromChain": 101,
    "toChain": 101,
    "fromToken": "So11111111111111111111111111111111111111112",
    "toToken": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
    "fromAmount": "1000000",
    "fromAddress": "11111111111111111111111111111111",
    "slippage": 0.5
  }' | head -n 40

echo
echo "=== 7) Test via domaine public ==="
BASE="https://fireinners.online/wolverine/traderone/api"
KEY=$(grep -oP 'http_x_api_key != "\K[^"]+' /etc/nginx/sites-enabled/fireinners.online-ssl | head -n1)

curl -sS -i -X POST "$BASE/swap" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KEY" \
  --data '{
    "provider": "lifi",
    "fromChain": 101,
    "toChain": 101,
    "fromToken": "So11111111111111111111111111111111111111112",
    "toToken": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
    "fromAmount": "1000000",
    "fromAddress": "11111111111111111111111111111111",
    "slippage": 0.5
  }' | head -n 40

echo
echo "=== FIN ==="
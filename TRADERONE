set -euo pipefail

WOLV_DIR="/var/www/wolverine"
echo "=== 1) Cherche un index.html qui contient WOLVERINE/TRADERONE sur le serveur ==="
CAND="$(find /opt /var/www -type f -name index.html -not -path "*/node_modules/*" 2>/dev/null | \
  while read -r f; do
    if grep -qiE "wolverine|traderone" "$f"; then
      echo "$f"
      break
    fi
  done)"

if [ -z "${CAND:-}" ]; then
  echo "KO: aucun index.html contenant wolverine/traderone trouvé dans /opt ou /var/www"
  exit 1
fi

SRC_DIR="$(dirname "$CAND")"
echo "OK: trouvé -> $SRC_DIR"

echo "=== 2) Deploy FORCE -> /var/www/wolverine ==="
apt-get update -y >/dev/null
apt-get install -y rsync >/dev/null
mkdir -p "$WOLV_DIR"
rsync -a --delete "$SRC_DIR/" "$WOLV_DIR/"

echo "=== 3) Preuve locale ==="
grep -nEi "title|wolverine|traderone|fireinners|wallet" "$WOLV_DIR/index.html" | head -n 30 || true

echo "=== 4) Test HTTP (suivre le 301) ==="
curl -LsS https://fireinners.online/wolverine/ | grep -iE "<title>|wolverine|traderone|fireinners|wallet" | head -n 30 || true
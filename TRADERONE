say "9) Solana-RPC proxy service (NO fetch dependency; pure https/http)"
SOLRPC_DIR="/opt/wolverine-solrpc-proxy"
mkdir -p "$SOLRPC_DIR"
cat >"$SOLRPC_DIR/server.js" <<'JS'
const http=require('http'),https=require('https'),{URL}=require('url');
const express=require('express');
const app=express();
app.use(express.json({limit:'2mb'}));
const TARGET=process.env.TARGET_SOLANA_RPC||'';
app.get('/health',(req,res)=>res.json({ok:true,target:TARGET||null}));

function forward(body,res){
  if(!TARGET){ res.status(500).json({error:"TARGET_SOLANA_RPC missing"}); return; }
  let u; try{ u=new URL(TARGET); }catch(e){ res.status(500).json({error:"Bad TARGET_SOLANA_RPC"}); return; }
  const lib = (u.protocol==='https:') ? https : http;
  const data = Buffer.from(JSON.stringify(body||{}));
  const opts={
    protocol:u.protocol, hostname:u.hostname, port:u.port||((u.protocol==='https:')?443:80),
    path:u.pathname + (u.search||''),
    method:'POST',
    headers:{'content-type':'application/json','content-length':data.length}
  };
  const r=lib.request(opts,(rr)=>{
    let chunks=[];
    rr.on('data',d=>chunks.push(d));
    rr.on('end',()=>{
      const buf=Buffer.concat(chunks);
      res.status(rr.statusCode||200);
      res.set('content-type', rr.headers['content-type']||'application/json');
      res.send(buf);
    });
  });
  r.on('error',e=>res.status(502).json({error:String(e&&e.message?e.message:e)}));
  r.write(data); r.end();
}

app.post('/',(req,res)=>forward(req.body,res));
const port=Number(process.env.PORT||12713);
app.listen(port,'127.0.0.1',()=>console.log('solrpc-proxy listening',port,'->',TARGET));
JS


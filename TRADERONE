bash -lc 'cat >/root/FIND_TRADERONE_WOLVERINE.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
OUT="/root/FIND_TRADERONE_WOLVERINE_${TS}.log"
exec > >(tee -a "$OUT") 2>&1

echo "=== FIND_TRADERONE_WOLVERINE :: $TS :: $(hostname -f 2>/dev/null || hostname) ==="
echo "OUT=$OUT"
echo

# Helpers
exists(){ [ -e "$1" ] && echo "OK: $1" || echo "MISSING: $1"; }
hdr(){ echo; echo "===== $* ====="; }

hdr "1) Known key paths (expected)"
exists /var/www/wolverine
exists /var/www/wolverine/index.html
exists /opt/wolverine
exists /opt/traderone
exists /opt/traderone-opt
exists /opt/traderone-vault
exists /etc/nginx/sites-available/fireinners.online-ssl
exists /etc/nginx/includes/wolverine_routes.inc
echo

hdr "2) Wolverine frontend: list top files"
for d in /var/www/wolverine /opt/wolverine /opt/fireinners/frontend-react/app/dist/wolverine; do
  if [ -d "$d" ]; then
    echo "--- ls -la $d (top) ---"
    ls -la "$d" | head -n 120 || true
    if [ -f "$d/index.html" ]; then
      echo "--- head $d/index.html ---"
      head -n 40 "$d/index.html" || true
    fi
    if [ -d "$d/_next" ]; then
      echo "--- _next exists in $d ---"
      find "$d/_next" -maxdepth 2 -type f 2>/dev/null | head -n 40 || true
    fi
    if [ -d "$d/vendor" ]; then
      echo "--- vendor exists in $d ---"
      ls -la "$d/vendor" | head -n 80 || true
    fi
  fi
done

hdr "3) TraderOne / backend candidates: tree + entrypoints"
for d in /opt/traderone /opt/traderone-opt /opt/traderone-vault /opt/traderone* /root/traderone*; do
  [ -d "$d" ] || continue
  echo "--- DIR: $d ---"
  ls -la "$d" | head -n 120 || true
  for f in server.js index.js app.js main.js package.json ecosystem.config.js pm2.config.js .env; do
    [ -f "$d/$f" ] && echo "FOUND: $d/$f"
  done
  echo "--- search entrypoints (server.js/app.js/index.js) ---"
  find "$d" -maxdepth 4 -type f \( -name "server.js" -o -name "app.js" -o -name "index.js" -o -name "main.js" -o -name "package.json" \) 2>/dev/null | head -n 80 || true
done

hdr "4) Nginx: show active config about /wolverine and traderone/api"
if command -v nginx >/dev/null 2>&1; then
  echo "--- nginx -T grep wolverine/traderone/api ---"
  nginx -T 2>/dev/null | grep -nE "server_name|listen|/wolverine|wolverine_routes|traderone/api|proxy_pass" || true
else
  echo "nginx not found"
fi

hdr "5) Nginx files: direct grep in /etc/nginx"
if [ -d /etc/nginx ]; then
  echo "--- grep -R \"wolverine\" /etc/nginx ---"
  grep -RIn --include="*.conf" --include="*.inc" "wolverine" /etc/nginx 2>/dev/null | head -n 200 || true
  echo "--- grep -R \"traderone\" /etc/nginx ---"
  grep -RIn --include="*.conf" --include="*.inc" "traderone" /etc/nginx 2>/dev/null | head -n 200 || true
fi

hdr "6) Process + ports: what is actually running"
echo "--- pm2 status ---"
if command -v pm2 >/dev/null 2>&1; then pm2 status || true; else echo "pm2 not installed"; fi
echo
echo "--- listening ports (3000/8484/4001/80/443) ---"
if command -v ss >/dev/null 2>&1; then
  ss -ltnp | grep -E ":(80|443|3000|8484|4001)\b" || true
else
  netstat -ltnp 2>/dev/null | grep -E ":(80|443|3000|8484|4001)\b" || true
fi
echo
echo "--- systemd candidates ---"
systemctl list-units --type=service --state=running 2>/dev/null | grep -Ei "trader|wolverine|fireinners|node|pm2" || true

hdr "7) Content search: files containing \"WOLVERINE\" or \"TraderOne\""
# Limit scope to probable roots to avoid scanning whole disk
SCAN_DIRS=()
for d in /var/www/wolverine /opt /var/www /etc/nginx /root; do
  [ -d "$d" ] && SCAN_DIRS+=("$d")
done

echo "--- grep WOLVERINE (limited) ---"
for d in "${SCAN_DIRS[@]}"; do
  grep -RIn --binary-files=without-match \
    --exclude-dir=node_modules --exclude-dir=.git --exclude-dir=dist --exclude-dir=build --exclude-dir=.next \
    "WOLVERINE" "$d" 2>/dev/null | head -n 120 || true
done

echo
echo "--- grep TraderOne (limited) ---"
for d in "${SCAN_DIRS[@]}"; do
  grep -RIn --binary-files=without-match \
    --exclude-dir=node_modules --exclude-dir=.git --exclude-dir=dist --exclude-dir=build --exclude-dir=.next \
    "TraderOne" "$d" 2>/dev/null | head -n 120 || true
done

hdr "8) Quick conclusion pointers"
echo "Frontend expected at: /var/www/wolverine (served by nginx include routes)."
echo "Backend candidates under: /opt/traderone* (and/or pm2-managed app)."
echo "See this report for exact file hits: $OUT"
echo "=== DONE ==="
BASH
chmod +x /root/FIND_TRADERONE_WOLVERINE.sh
/root/FIND_TRADERONE_WOLVERINE.sh'
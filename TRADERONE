#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
TRADERONE_DIR="/opt/traderone"
SERVER="$TRADERONE_DIR/server.js"
BACKUP="$SERVER.bak.$TS"

echo "=== TRADERONE API PATCH (B+) ==="

[ -f "$SERVER" ] || { echo "ERR: server.js introuvable"; exit 1; }

echo "[1] Backup server.js"
cp "$SERVER" "$BACKUP"

echo "[2] Patch API routes (budget + dryrun)"

python3 <<'PY'
from pathlib import Path

p = Path("/opt/traderone/server.js")
s = p.read_text(errors="ignore")

if "/api/budget" in s:
    print("API déjà patchée")
    exit(0)

PATCH = """
// === API SOL ONLY ===
app.post("/wolverine/traderone/api/budget", (req,res)=>{
  const { pubkey, budgetSOL } = req.body || {};
  if(!pubkey || !budgetSOL || budgetSOL<=0){
    return res.status(400).json({error:"invalid budget"});
  }
  global.TRADERONE_BUDGET_SOL = Number(budgetSOL);
  return res.json({ok:true,budgetSOL:global.TRADERONE_BUDGET_SOL});
});

app.post("/wolverine/traderone/api/dryrun", (req,res)=>{
  const { pubkey } = req.body || {};
  if(!pubkey){
    return res.status(400).json({error:"missing pubkey"});
  }
  return res.json({
    ok:true,
    mode:"dry-run",
    budgetSOL: global.TRADERONE_BUDGET_SOL || 0,
    note:"no execution performed"
  });
});
"""

# insérer après app.use(express.json())
idx = s.find("app.use(express.json())")
if idx == -1:
    raise SystemExit("Impossible de localiser express.json")

s = s[:idx+len("app.use(express.json())")] + PATCH + s[idx+len("app.use(express.json())"):]

p.write_text(s)
print("PATCH OK")
PY

echo "[3] Restart PM2"
pm2 restart traderone-vault

sleep 2

echo "[4] Test endpoints"
curl -s -X POST http://127.0.0.1:3000/wolverine/traderone/api/budget \
  -H "Content-Type: application/json" \
  -d '{"pubkey":"11111111111111111111111111111111","budgetSOL":0.01}' | jq .

curl -s -X POST http://127.0.0.1:3000/wolverine/traderone/api/dryrun \
  -H "Content-Type: application/json" \
  -d '{"pubkey":"11111111111111111111111111111111"}' | jq .

echo "=== DONE / TRADERONE API READY ==="
set -euo pipefail
SRC="/opt/_wolverine_next_src"
DIST="/var/www/_wolverine_ui"

echo "=== 1) Patch Next config (trailingSlash) + rebuild ==="
cd "$SRC"

# ajoute trailingSlash si pas déjà là
if ! grep -q "trailingSlash" next.config.mjs; then
  sed -i "s/images: { unoptimized: true }/images: { unoptimized: true },\n  trailingSlash: true/g" next.config.mjs
fi

npm install --legacy-peer-deps >/dev/null
npm run build

echo "=== 2) Deploy ==="
rm -rf "$DIST"
mkdir -p "$DIST"
rsync -a --delete "$SRC/out/" "$DIST/"

echo "=== 3) Patch Nginx (supporte /health et assets) ==="
for NG in $(grep -RIl -E 'server_name\s+.*(fireinners\.online|www\.fireinners\.online)' /etc/nginx/sites-enabled 2>/dev/null | sort -u); do
  cp -a "$NG" "$NG.bak.nextfix.$(date +%s)"

  python3 - <<PY
from pathlib import Path
import re
p=Path("$NG")
s=p.read_text()

# retire anciens blocs /wolverine UI (pas l'API)
s = re.sub(r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*', '\n', s, flags=re.M)
s = re.sub(r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*', '\n', s, flags=re.M)

block = r'''
# --- WOLVERINE UI (Next export static) ---
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  # Next export peut être /route/index.html (trailingSlash) ou /route.html
  try_files $uri $uri/ $uri/index.html $uri.html /_wolverine_ui/index.html;
}
'''
i=s.rfind("}")
if i==-1: raise SystemExit("KO nginx conf invalide: " + str(p))
s=s[:i] + "\n" + block + "\n" + s[i:]
p.write_text(s)
print("OK patched:", p)
PY
done

nginx -t
systemctl reload nginx

echo "=== 4) Preuves ==="
echo "--- index ---"
curl -sS -I https://fireinners.online/wolverine/ | head -n 8
echo "--- health ---"
curl -sS -I https://fireinners.online/wolverine/health/ | head -n 8
echo "--- title ---"
curl -LsS https://fireinners.online/wolverine/ | grep -i "<title>" | head -n 1 || true

echo "DONE ✅"
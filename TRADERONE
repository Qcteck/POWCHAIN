bash <(cat <<'BASH'
set -euo pipefail

HTML="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE WALLET HARD RESET ==="

# 1) Vérification
[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

# 2) Backup
cp "$HTML" "$HTML.bak_wallet_reset_$TS"
echo "✔ Backup créé: $HTML.bak_wallet_reset_$TS"

# 3) Supprimer TOUT ancien wallet (HTML + JS)
sed -i '
/Connect Wallet/d;
/Refresh/d;
/Adresse:/d;
/SOL:/d;
/USDC:/d;
/solanaWeb3/d;
/Phantom/d;
/getBalance/d;
/getParsedTokenAccountsByOwner/d;
/function connect/d;
/function refresh/d;
/const RPC/d;
/const USDC_MINT/d;
/let PUB/d;
/let CONN/d;
' "$HTML"
echo "✔ Anciennes injections supprimées"

# 4) solana-web3 local garanti
mkdir -p "$VENDOR"
if [ ! -f "$VENDOR/solana-web3.min.js" ]; then
  curl -sL https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js \
    -o "$VENDOR/solana-web3.min.js"
  echo "✔ solana-web3.js installé"
fi

# 5) Injection UNIQUE et propre
sed -i '/<\/[[:space:]]*body[[:space:]]*>/i \
<script src="/wolverine/vendor/solana-web3.min.js"></script>\
<script>\
const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";\
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";\
let pub=null,conn=null;\
async function connectWallet(){\
 if(!window.solana||!window.solana.isPhantom){alert("Phantom non détecté");return;}\
 const r=await window.solana.connect();\
 pub=new solanaWeb3.PublicKey(r.publicKey.toString());\
 conn=new solanaWeb3.Connection(RPC,"confirmed");\
 document.getElementById("addr").innerText=pub.toBase58();\
 await refreshWallet();\
}\
async function refreshWallet(){\
 if(!pub||!conn)return;\
 const lam=await conn.getBalance(pub);\
 document.getElementById("sol").innerText=(lam/1e9).toFixed(6);\
 let usdc=0;\
 const acc=await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)});\
 acc.value.forEach(a=>{usdc+=a.account.data.parsed.info.tokenAmount.uiAmount||0});\
 document.getElementById("usdc").innerText=usdc.toFixed(2);\
}\
</script>\
<div id="walletbox" style="margin:40px auto;width:420px;border:2px solid #00eaff;padding:20px;color:#00eaff;font-family:monospace">\
<button onclick="connectWallet()" style="width:100%;margin-bottom:8px">Connect Wallet</button>\
<button onclick="refreshWallet()" style="width:100%;margin-bottom:12px">Refresh</button>\
Adresse: <span id="addr">-</span><br>\
SOL: <span id="sol">-</span><br>\
USDC: <span id="usdc">-</span>\
</div>' "$HTML"

echo "✔ Injection unique OK"

# 6) Reload nginx
nginx -t && systemctl reload nginx
echo "✔ nginx rechargé"

echo "=== TERMINÉ ==="
echo "➡ Ouvre https://fireinners.online/wolverine"
echo "➡ Recharge NORMAL (F5)"
BASH
)
cat >/root/fix_dup_location_wolverine_api.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

BACKEND="${1:-127.0.0.1:9000}"

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
KEEP="/etc/nginx/snippets/wolverine_traderone_backend_proxy.conf"
DISABLED="/etc/nginx/disabled-snippets"
mkdir -p "$DISABLED" /etc/nginx/snippets

ts="$(date +%Y%m%d_%H%M%S)"
[[ -f "$VHOST" ]] && cp -a "$VHOST" "${VHOST}.bak_${ts}" || true
[[ -f "$KEEP"  ]] && cp -a "$KEEP"  "${KEEP}.bak_${ts}"  || true

echo "=== [A] Files defining location ^~ /wolverine/traderone/api/ ==="
grep -RIn --line-number --color=never 'location\s\+\^~\s\+/wolverine/traderone/api/' /etc/nginx || true
echo

echo "=== [B] Rewrite KEEP snippet clean (single location) ==="
cat >"$KEEP" <<NGINX
# UI -> Backend reverse proxy ($BACKEND)

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://$BACKEND/;
}
NGINX

echo "=== [C] Disable EVERY other file that defines the same location (move to $DISABLED) ==="
# Cherche les fichiers contenant la location et déplace tout sauf KEEP
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  [[ "$file" == "$KEEP" ]] && continue
  [[ -f "$file" ]] || continue
  echo "MOVE: $file -> $DISABLED/"
  mv -f "$file" "$DISABLED"/
done < <(grep -RIl --color=never 'location\s\+\^~\s\+/wolverine/traderone/api/' /etc/nginx | sort -u)

echo
echo "=== [D] Ensure vhost includes KEEP only once (remove old includes/proxies/stubs) ==="
if [[ -f "$VHOST" ]]; then
  # remove any include lines that reference old proxy/stub snippets
  sed -i \
    -e '\|include .*wolverine_.*proxy.*;|d' \
    -e '\|include .*traderone_.*proxy.*;|d' \
    -e '\|include .*stub_.*;|d' \
    "$VHOST"

  # add the keep include once after server_name fireinners.online
  if ! grep -qF "include $KEEP;" "$VHOST"; then
    perl -i -pe '
      if(!$done && /server_name\s+.*\bfireinners\.online\b.*;/){
        print "  include /etc/nginx/snippets/wolverine_traderone_backend_proxy.conf;\n";
        $done=1;
      }
    ' "$VHOST"
  fi
fi

echo
echo "=== [E] Test + reload ==="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "TEST:"
echo "  curl -i https://fireinners.online/wolverine/traderone/api/me"
BASH

chmod +x /root/fix_dup_location_wolverine_api.sh
/root/fix_dup_location_wolverine_api.sh 127.0.0.1:9000
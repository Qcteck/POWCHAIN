cat >/root/batch_root_fireinners.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="${2:-/etc/nginx/sites-enabled/${DOMAIN}-ssl}"
SNIP="/etc/nginx/snippets/${DOMAIN}_wolverine.conf"
APPLY="${APPLY:-0}"   # 0=dry-run, 1=apply
TS="$(date +%Y%m%d_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/batch_root_${TS}"
BACKVHOST="${BACKDIR}/$(basename "$VHOST")"

say(){ printf '%s\n' "$*"; }

say "== batch_root (${DOMAIN}) =="
say "APPLY=${APPLY} (0=dry-run, 1=apply)"
say "VHOST=${VHOST}"
say "SNIP=${SNIP}"
echo

[[ -f "$VHOST" ]] || { say "ERROR: vhost introuvable: $VHOST"; exit 1; }

# 1) Build snippet (wolverine + favicon)
SNIP_CONTENT="$(cat <<'EOF'
# --- wolverine + favicon snippet ---
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}

location = /favicon.ico {
  access_log off;
  log_not_found off;
  try_files /favicon.ico =204;
}
EOF
)"

# 2) Dry-run preview
if [[ "$APPLY" != "1" ]]; then
  say "[DRY] écrirait -> $SNIP"
  say "[DRY] backup -> $BACKVHOST"
  say "[DRY] nettoierait anciens blocs '# --- injected by batchfix ---'"
  say "[DRY] garantirait 1 seule ligne: include $SNIP;"
  exit 0
fi

# 3) Write snippet
install -d /etc/nginx/snippets
printf "%s\n" "$SNIP_CONTENT" > "$SNIP"
say "OK: écrit -> $SNIP"

# 4) Backup vhost
install -d "$BACKDIR"
cp -a "$VHOST" "$BACKVHOST"
say "OK: backup -> $BACKVHOST"

# 5) Clean previous duplicated inline injections (if any)
perl -0777 -i -pe 's/\n\s*# --- injected by batchfix ---\n.*?\n\s*# --- end injected ---\n\s*//sg' "$VHOST"

# 6) Ensure include line exists ONCE inside server blocks
INCLUDE_LINE="include $SNIP;"

# Remove duplicates of the include if already present multiple times
perl -i -ne '
  BEGIN{ $seen=0; }
  if ($_ =~ /^\s*include\s+\/etc\/nginx\/snippets\/.*_wolverine\.conf\s*;\s*$/) {
    if ($seen++) { next; }  # skip duplicates
  }
  print;
' "$VHOST"

# If include not present at all, insert it just after "server_name" line (first match)
if ! grep -qF "$INCLUDE_LINE" "$VHOST"; then
  perl -i -pe '
    if (!$done && /^\s*server_name\s+/) { $_ .= "  '"$INCLUDE_LINE"'\n"; $done=1; }
  ' "$VHOST"
  say "OK: include ajouté -> $INCLUDE_LINE"
else
  say "OK: include déjà présent (dédupliqué si besoin)"
fi

# 7) Test + reload
nginx -t
systemctl reload nginx
say "OK: nginx reload"

# 8) Quick checks (local)
say "== checks =="
curl -sSI "http://127.0.0.1/wolverine/" | head -n 5 || true
curl -sSI "http://127.0.0.1/favicon.ico" | head -n 5 || true
BASH

chmod +x /root/batch_root_fireinners.sh
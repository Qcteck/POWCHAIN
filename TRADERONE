set -euo pipefail

SRV="/opt/traderone-opt/server.js"
SVC="traderone.service"
TS="$(date +%s)"

cp -a "$SRV" "$SRV.bak.$TS"
echo "Backup: $SRV.bak.$TS"

node - <<'JS'
const fs=require("fs");
const f="/opt/traderone-opt/server.js";
let s=fs.readFileSync(f,"utf8");

if (s.includes('app.post("/wolverine/traderone/api/rpc"')) {
  console.log("OK: route RPC déjà présente");
  process.exit(0);
}

const insert = `

/* WOLVERINE_RPC_PROXY_V1 */
app.post("/wolverine/traderone/api/rpc", async (req,res) => {
  try{
    const upstream = "https://api.mainnet-beta.solana.com";
    const r = await fetch(upstream, {
      method: "POST",
      headers: {"content-type":"application/json"},
      body: JSON.stringify(req.body || {})
    });
    const txt = await r.text();
    res.status(r.status);
    res.setHeader("content-type","application/json");
    res.send(txt);
  }catch(e){
    res.status(500).json({error: String(e?.message||e)});
  }
});
/* /WOLVERINE_RPC_PROXY_V1 */
`;

// insertion point (supporte plusieurs styles de serveurs)
let idx = -1;
const patterns = [
  /app\.listen\(/,
  /server\.listen\(/,
  /httpServer\.listen\(/,
  /httpsServer\.listen\(/,
  /\blisten\(\s*process\.env\.PORT\b/,
  /\bmodule\.exports\b/,
  /\bexport\s+default\b/
];

for (const p of patterns) {
  const m = s.search(p);
  if (m !== -1) { idx = m; break; }
}

if (idx === -1) {
  // fallback: ajoute à la fin
  s += "\n" + insert + "\n";
  console.log("WARN: aucun point d’insertion trouvé → route ajoutée à la fin");
} else {
  s = s.slice(0, idx) + insert + "\n" + s.slice(idx);
  console.log("OK: route RPC injectée avant le bloc de démarrage/export");
}

fs.writeFileSync(f, s, "utf8");
JS

systemctl restart "$SVC"
echo "Restarted $SVC ✅"
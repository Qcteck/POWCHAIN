set -e
cd /root

echo "=============================="
echo "1) NGINX TEST (donne fichier + ligne)"
echo "=============================="
nginx -t 2>&1 | tail -n 40 || true

echo
echo "=============================="
echo "2) Récupère le fichier fautif depuis nginx -t"
echo "=============================="
ERR=$(nginx -t 2>&1 || true)
FILE=$(echo "$ERR" | sed -n 's/.*in \(\/[^:]*\):.*/\1/p' | head -n 1)
LINE=$(echo "$ERR" | sed -n 's/.*in \/[^:]*:\([0-9][0-9]*\).*/\1/p' | head -n 1)
echo "FILE=$FILE"
echo "LINE=$LINE"

if [ -n "$FILE" ] && [ -f "$FILE" ]; then
  echo
  echo "=============================="
  echo "3) Montre 25 lignes autour de l’erreur"
  echo "=============================="
  nl -ba "$FILE" | sed -n "$((LINE-15)),$((LINE+15))p" || true

  echo
  echo "=============================="
  echo "4) Fix auto: normalise les proxy_set_header (Host / X-Real-IP / X-Forwarded-For)"
  echo "   (on remplace toutes les variantes cassées par les 3 lignes propres)"
  echo "=============================="
  cp -v "$FILE" "$FILE.bak.$(date +%Y%m%d_%H%M%S)"
  perl -pi -e 's/^\s*proxy_set_header\s+Host\s+.*;/  proxy_set_header Host \$host;/g' "$FILE"
  perl -pi -e 's/^\s*proxy_set_header\s+X-Real-IP\s+.*;/  proxy_set_header X-Real-IP \$remote_addr;/g' "$FILE"
  perl -pi -e 's/^\s*proxy_set_header\s+X-Forwarded-For\s+.*;/  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;/g' "$FILE"
fi

echo
echo "=============================="
echo "5) Force un mapping propre /wolverine/traderone/api/* -> http://127.0.0.1:12703/api/*"
echo "   dans les 2 fichiers (80 et 443) si présents"
echo "=============================="
for f in /etc/nginx/sites-available/fireinners.online /etc/nginx/sites-available/fireinners.online-ssl; do
  if [ -f "$f" ]; then
    echo "PATCH $f"
    cp -v "$f" "$f.bak.$(date +%Y%m%d_%H%M%S)"
    perl -0777 -i -pe 's#location\s+\^~\s+/wolverine/traderone/api/\s*\{.*?\}#location ^~ /wolverine/traderone/api/ {\n  proxy_pass http://127.0.0.1:12703/api/;\n  proxy_set_header Host $host;\n  proxy_set_header X-Real-IP $remote_addr;\n  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n}\n#sg' "$f"
  fi
done

echo
echo "=============================="
echo "6) Test + reload"
echo "=============================="
nginx -t
systemctl reload nginx

echo
echo "=============================="
echo "7) Tests Cloudflare (status/start) — on veut plus voir method:-32601"
echo "=============================="
BASE="https://fireinners.online/wolverine/traderone/api"
echo "--- POST $BASE/status"
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" --data '{}' | head -n 30
echo
echo "--- POST $BASE/start"
curl -sS -i -X POST "$BASE/start"  -H "content-type: application/json" --data '{}' | head -n 30
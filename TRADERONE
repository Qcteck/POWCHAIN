bash -lc 'set -euo pipefail; python3 - <<'"'"'PY'"'"'
s=r"""#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
OUT="/root/TO_HEART_${TS}"
LOG="/root/TO_HEART_${TS}.log"
HEART="/root/traderone_heart.txt"
mkdir -p "$OUT"
exec > >(tee -a "$LOG") 2>&1
say(){ echo; echo "== $* =="; }

say "0) Context"
hostnamectl 2>/dev/null | sed -n "1,6p" || true
date || true
id || true

say "1) listeners (80/443/3000)"
ss -lntp | egrep "(:80|:443|:3000)\\b" || true

PID3000="$(ss -lntp 2>/dev/null | awk "/:3000[[:space:]]/ && /users:/{ if (match(\\$0,/pid=([0-9]+)/,m)) {print m[1]; exit} }" || true)"
echo "PID3000=${PID3000:-none}"

EXE="";CWD="";CMDLINE="";ENTRY="";ENTRY_ABS=""
if [ -n "${PID3000:-}" ] && [ -d "/proc/$PID3000" ]; then
  say "2) /proc (3000)"
  EXE="$(readlink -f "/proc/$PID3000/exe" 2>/dev/null || true)"
  CWD="$(readlink -f "/proc/$PID3000/cwd" 2>/dev/null || true)"
  CMDLINE="$(tr "\\0" " " < "/proc/$PID3000/cmdline" 2>/dev/null || true)"
  echo "EXE=$EXE"
  echo "CWD=$CWD"
  echo "CMDLINE=$CMDLINE"

  say "2.1) ENTRY guess (python reads /proc directly)"
  ENTRY="$(python3 - "$PID3000" <<'PY2' 2>/dev/null || true
import sys,os
pid=sys.argv[1]
p=f"/proc/{pid}/cmdline"
try:
  data=open(p,"rb").read().split(b"\0")
except Exception:
  print(""); sys.exit(0)
args=[a.decode("utf-8","ignore") for a in data if a]
entry=""
if args:
  a0=args[0]
  if a0.endswith("node") or a0.endswith("/node") or a0=="node":
    i=1
    while i<len(args):
      a=args[i]
      if a.startswith("-"):
        i+=1; continue
      if a.endswith((".js",".mjs",".cjs")) or "/dist/" in a or a.endswith("/dist/index.js"):
        entry=a; break
      i+=1
print(entry)
PY2
)"
  echo "ENTRY_GUESS=${ENTRY:-none}"
  if [ -n "${ENTRY:-}" ]; then
    if [[ "$ENTRY" = /* ]]; then
      ENTRY_ABS="$ENTRY"
    elif [ -n "${CWD:-}" ] && [ -f "$CWD/$ENTRY" ]; then
      ENTRY_ABS="$CWD/$ENTRY"
    else
      ENTRY_ABS=""
    fi
  fi
  echo "ENTRY_ABS=${ENTRY_ABS:-none}"

  say "2.2) Env hints (filtered)"
  (strings "/proc/$PID3000/environ" 2>/dev/null | egrep -i "NODE_ENV|PORT|TRADER|WOLVERINE|RPC|SECRET|KEY|TOKEN|BASE|PROXY" || true) | head -n 200

  say "2.3) ps / pstree"
  ps -fp "$PID3000" || true
  pstree -ap "$PID3000" 2>/dev/null || true
fi

say "3) systemd candidates"
systemctl list-units --type=service --all | egrep -i "trader|wolver|3000" || true
for u in traderone.service traderone-api.service wolverine-traderone.service; do
  if systemctl status "$u" >/dev/null 2>&1; then
    echo; echo "-- status $u --"
    systemctl --no-pager status "$u" | sed -n "1,180p" || true
    echo; echo "-- cat $u --"
    systemctl cat "$u" | sed -n "1,260p" || true
  fi
done

say "4) pm2 (if present)"
if command -v pm2 >/dev/null 2>&1; then pm2 list || true; else echo "pm2 not installed"; fi

say "5) Quick disk scan (package.json)"
CANDS=(/opt/traderone /opt/traderone-opt /opt/traderone-vault /opt/wolverine /opt/fireinners /root/traderone /root/wolverine)
for d in "${CANDS[@]}"; do
  [ -d "$d" ] || continue
  echo; echo "-- $d --"
  ls -la "$d" | head -n 40 || true
  if [ -f "$d/package.json" ]; then
    echo "FOUND $d/package.json"
    node -e "const p=require(\"$d/package.json\");console.log(\"name=\",p.name,\" main=\",p.main,\" scripts=\",Object.keys(p.scripts||{}).join(\",\"))" 2>/dev/null || true
  fi
done

say "6) Write HEART"
{
  echo "TS=$TS"
  echo "PID3000=${PID3000:-}"
  echo "EXE=${EXE:-}"
  echo "CWD=${CWD:-}"
  echo "CMDLINE=${CMDLINE:-}"
  echo "ENTRY_GUESS=${ENTRY:-}"
  echo "ENTRY_ABS=${ENTRY_ABS:-}"
  echo "OUT=$OUT"
  echo "LOG=$LOG"
} | tee "$OUT/heart.txt" > "$HEART"

echo
echo "== DONE =="
echo "HEART=$HEART"
echo "OUT=$OUT"
echo "LOG=$LOG"
"""
open("/root/TO_FIND_TRADERONE_HEART_v2.sh","w",encoding="utf-8").write(s)
PY
chmod +x /root/TO_FIND_TRADERONE_HEART_v2.sh
/root/TO_FIND_TRADERONE_HEART_v2.sh
echo
echo "== HEART FILE =="
sed -n "1,220p" /root/traderone_heart.txt || true'
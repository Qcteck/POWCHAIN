import sys,re
p,mb,me,block=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
s=open(p,"r",encoding="utf-8",errors="ignore").read()

# replace existing marked block
if mb in s and me in s:
    a=s.index(mb); b=s.index(me,a)+len(me)
    s=s[:a]+block+s[b:]
    open(p,"w",encoding="utf-8").write(s)
    raise SystemExit(0)

# parse server blocks
starts=[m.start() for m in re.finditer(r'(?m)^\s*server\s*\{', s)]
def get_block(i):
    depth=0; j=i
    while j < len(s):
        c=s[j]
        if c=='{': depth+=1
        elif c=='}':
            depth-=1
            if depth==0:
                return (i,j+1,s[i:j+1])
        j+=1
    return None

blocks=[get_block(i) for i in starts]
blocks=[b for b in blocks if b]
if not blocks: raise SystemExit("ERR: aucun bloc server { } trouvé dans le fichier ciblé: "+p)

# pick block containing server_name fireinners.online, prefer listen 443
pick=None
for a,b,t in blocks:
    if re.search(r'(?m)^\s*server_name\s+.*fireinners\.online', t):
        pick=(a,b,t); break
if pick is None:
    pick=blocks[-1]
a,b,t=pick

ins=b-1
out=s[:ins].rstrip()+"\n\n"+block+"\n\n"+s[ins:]
open(p,"w",encoding="utf-8").write(out)
PY


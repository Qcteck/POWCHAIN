#!/usr/bin/env bash
set -e

echo "=== WOLVERINE HTTPS HARD FIX ==="

### 1️⃣ LOCALISER TOUS LES index.html
find /var/www -name index.html > /tmp/wolverine_indexes.txt
cat /tmp/wolverine_indexes.txt

### 2️⃣ PATCH FORCÉ (HTTP → HTTPS SAFE)
while read f; do
  echo "[PATCH] $f"

  # Supprimer toute référence HTTP explicite
  sed -i 's|http://wolverine|/wolverine|g' "$f"
  sed -i 's|http://127.0.0.1:[0-9]\+||g' "$f"
  sed -i 's|http://|https://|g' "$f"

  # Forcer endpoint balances sécurisé
  sed -i 's|/api/balances|/wolverine/api/balances|g' "$f"

done < /tmp/wolverine_indexes.txt

### 3️⃣ VÉRIFICATION
echo "=== VERIFY (should be empty) ==="
grep -R "http://" /var/www || echo "✔ OK (no http left)"

### 4️⃣ RELOAD NGINX
nginx -t
systemctl reload nginx

echo "=== DONE ==="
echo "NEXT:"
echo "➡ Ouvre la page en NAVIGATION PRIVÉE"
echo "➡ OU CTRL + SHIFT + R"
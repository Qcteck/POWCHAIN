set -e
cd /root

# 1) nouvelle clé
KEY="$(openssl rand -hex 32)"
echo "=== NOUVELLE KEY (à garder) ==="
echo "$KEY"

# 2) backups
mkdir -p /root/nginx_backups
cp -v /etc/nginx/sites-enabled/fireinners.online     "/root/nginx_backups/fireinners.online.$(date +%Y%m%d_%H%M%S)"
cp -v /etc/nginx/sites-enabled/fireinners.online-ssl "/root/nginx_backups/fireinners.online-ssl.$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true

# 3) remplace la clé dans les 2 fichiers (ligne if ($http_x_api_key != "..."))
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  sed -i -E 's/if \(\$http_x_api_key != ".*"\) \{ return 403; \}/if (\$http_x_api_key != "'"$KEY"'") { return 403; }/g' "$f"
done

# 4) test + reload
nginx -t
systemctl reload nginx

# 5) tests
BASE="https://fireinners.online/wolverine/traderone/api"

echo
echo "=== sans clé (403 attendu) ==="
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" --data '{}' | head -n 15

echo
echo "=== avec clé (200 attendu) ==="
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" -H "X-API-KEY: $KEY" --data '{}' | head -n 15
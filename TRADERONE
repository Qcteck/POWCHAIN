set -euo pipefail

### CONFIG
BASE="/opt/traderone"
FRONT="/var/www/wolverine"
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
PORT=3000
MASTER_KEY="$(hostname)-$(date +%s)"

echo "=== TRADERONE • INSTALLATION COMPLETE ==="

### 1) SYSTEM
echo "[1/6] Dépendances système"
apt-get update -y
apt-get install -y nodejs npm qrencode curl
npm install -g pm2

### 2) BACKEND
echo "[2/6] Backend sécurisé"
mkdir -p $BASE/{vaults,trades}
cd $BASE

cat > package.json <<'JSON'
{
 "name":"traderone-backend",
 "version":"1.0.0",
 "main":"server.js",
 "dependencies":{
  "express":"^4.18.2",
  "tweetnacl":"^1.0.3",
  "bs58":"^5.0.0",
  "crypto-js":"^4.2.0",
  "@solana/web3.js":"^1.95.3",
  "qrcode":"^1.5.4"
 }
}
JSON

npm install --silent

cat > server.js <<'JS'
const express=require("express");
const fs=require("fs");
const nacl=require("tweetnacl");
const bs58=require("bs58");
const CryptoJS=require("crypto-js");
const QR=require("qrcode");
const {Connection,PublicKey,Keypair,LAMPORTS_PER_SOL}=require("@solana/web3.js");

const RPC=process.env.RPC;
const MASTER=process.env.MASTER_KEY;
const app=express();
app.use(express.json());
const conn=new Connection(RPC,"confirmed");

function vaultPath(p){return __dirname+"/vaults/"+p+".json"}

function createVault(user){
 const kp=Keypair.generate();
 const enc=CryptoJS.AES.encrypt(
  bs58.encode(kp.secretKey),MASTER
 ).toString();
 fs.writeFileSync(vaultPath(user),JSON.stringify({
  user,
  pub:kp.publicKey.toBase58(),
  enc,
  active:true
 },null,2));
 return kp.publicKey.toBase58();
}

app.post("/api/vault/init",async(req,res)=>{
 const {userPub}=req.body;
 if(!userPub)return res.status(400).end();
 if(!fs.existsSync(vaultPath(userPub))){
  createVault(userPub);
 }
 const v=JSON.parse(fs.readFileSync(vaultPath(userPub)));
 const qr=await QR.toDataURL(v.pub);
 res.json({vault:v.pub,qr});
});

app.get("/api/vault/status",async(req,res)=>{
 const v=JSON.parse(fs.readFileSync(vaultPath(req.query.user)));
 const bal=await conn.getBalance(new PublicKey(v.pub));
 res.json({sol:bal/LAMPORTS_PER_SOL});
});

app.post("/api/vault/withdraw",async(req,res)=>{
 const {user,addr}=req.body;
 const v=JSON.parse(fs.readFileSync(vaultPath(user)));
 v.active=false;
 fs.writeFileSync(vaultPath(user),JSON.stringify(v,null,2));
 res.json({status:"WITHDRAW_REQUESTED",to:addr});
});

app.post("/api/vault/stop",(req,res)=>{
 const v=JSON.parse(fs.readFileSync(vaultPath(req.body.user)));
 v.active=false;
 fs.writeFileSync(vaultPath(req.body.user),JSON.stringify(v,null,2));
 res.json({stopped:true});
});

app.listen(3000,()=>console.log("TraderOne backend live"));
JS

### 3) ENV + SERVICE
echo "[3/6] Variables et service"
cat > .env <<EOF
RPC=$RPC
MASTER_KEY=$MASTER_KEY
EOF

pm2 delete traderone || true
pm2 start server.js --name traderone

#!/usr/bin/env bash
set -euo pipefail

echo "=== FIX AIAQUILA FINAL — STRUCTURE PROPRE ==="

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ENABLED="/etc/nginx/sites-enabled/fireinners.online-ssl"
BACKUP="/root/backup_fireinners_ssl_$(date +%Y%m%d_%H%M%S).conf"

# 1. Sécurité
chattr -i "$VHOST" 2>/dev/null || true
rm -f "$ENABLED" || true

# 2. Backup
cp "$VHOST" "$BACKUP"
echo "Backup: $BACKUP"

# 3. Réécriture PROPRE
cat > "$VHOST" <<'EOF'
server {
    listen 443 ssl http2;
    server_name fireinners.online;

    ssl_certificate     /etc/letsencrypt/live/fireinners.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fireinners.online/privkey.pem;

    # HEADERS PROPRES (UNE SEULE FOIS)
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
    add_header Pragma "no-cache" always;
    add_header Expires 0 always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;

    # AIAQUILA
    location /aiaquila/ {
        alias /var/www/aiaquila/;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
EOF

# 4. Symlink propre
ln -s "$VHOST" "$ENABLED"

# 5. Test NGINX
echo "Test nginx…"
nginx -t

# 6. Reload
systemctl reload nginx

# 7. Verrouillage
chattr +i "$VHOST"

echo "✅ AIAQUILA SERVI PROPREMENT"
echo "URL: https://fireinners.online/aiaquila/"
export TG_TOKEN="COLLE_LE_NOUVEAU_TOKEN_ICI"
curl -s "https://api.telegram.org/bot$TG_TOKEN/getUpdates" | python3 - <<'PY'
import json,sys
j=json.load(sys.stdin)
ids=[]
for u in j.get("result",[]):
  m=u.get("message") or {}
  c=m.get("chat") or {}
  if "id" in c: ids.append(c["id"])
print("CHAT_ID:", ids[-1] if ids else "NONE (envoie 'ping' au bot puis relance)")
PY
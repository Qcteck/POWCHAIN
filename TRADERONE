cat >/root/MEGA_AQUILATRADER_DEPLOY_V1.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
export DEBIAN_FRONTEND=noninteractive

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
hr(){ echo "----------------------------------------------------------------"; }
die(){ say "ERROR: $*"; exit 1; }

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILATRADER_${TS}"
mkdir -p "$BK"

# Paths
WWW="/var/www/aquilatrader"
INDEX="$WWW/index.html"

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGX_CONF="/etc/nginx/nginx.conf"
NGX_INC_DIR="/etc/nginx/includes"
NGX_INC_FILE="$NGX_INC_DIR/aquilatrader_routes.inc"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"

say "MEGA_AQUILATRADER_DEPLOY_V1 (static UI + nginx route /aquilatrader)"
hr

say "0) Preconditions"
[ "$(id -u)" -eq 0 ] || die "Run as root"
command -v nginx >/dev/null 2>&1 || die "nginx not found"
[ -f "$NGX_VHOST" ] || die "Missing vhost: $NGX_VHOST"
mkdir -p "$NGX_INC_DIR"

# Load askorupdate if present (preferred), else fallback to direct writes
ASK=0
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  source "$ASKLIB"
  ASK=1
  say "askorupdate: loaded ($ASKLIB)"
else
  say "askorupdate: not found ($ASKLIB) -> fallback direct writes"
fi

hr
say "1) Backup current state"
if [ -d "$WWW" ]; then
  say "Backup existing webroot: $WWW -> $BK/www_aquilatrader"
  mkdir -p "$BK"
  cp -a "$WWW" "$BK/www_aquilatrader" || true
fi
if [ -f "$NGX_VHOST" ]; then
  cp -a "$NGX_VHOST" "$BK/fireinners.online-ssl.bak"
fi
if [ -f "$NGX_INC_FILE" ]; then
  cp -a "$NGX_INC_FILE" "$BK/aquilatrader_routes.inc.bak"
fi

hr
say "2) Write AquilaTrader static page"
mkdir -p "$WWW"

cat >"$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>AquilaTrader</title>
  <style>
    :root{--bg:#060b16;--panel:#0b1020;--txt:#eaf0ff;--mut:#9fb1d8;--btn:#e9eefb;--btnTxt:#0b1020;}
    html,body{height:100%}
    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#050816,#070b18 40%,#050816);color:var(--txt)}
    .wrap{max-width:980px;margin:0 auto;padding:28px 18px}
    h1{margin:0 0 14px;font-size:46px;letter-spacing:.2px}
    .row{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
    .card{background:rgba(11,16,32,.9);border:1px solid rgba(255,255,255,.06);border-radius:14px;padding:16px}
    .wallet{color:var(--mut);margin:10px 0 14px;font-size:18px}
    input{width:min(760px,100%);height:56px;border-radius:14px;border:1px solid rgba(255,255,255,.10);background:rgba(0,0,0,.25);color:var(--txt);padding:0 16px;font-size:18px;outline:none}
    button{height:52px;min-width:150px;border-radius:16px;border:0;background:var(--btn);color:var(--btnTxt);font-size:20px;cursor:pointer}
    button.secondary{background:rgba(233,238,251,.85)}
    button:disabled{opacity:.5;cursor:not-allowed}
    .log{margin-top:16px;white-space:pre-wrap;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;color:#cfe0ff}
    a{color:#7ab7ff}
    .hint{color:var(--mut);font-size:14px;margin-top:10px}
    .sep{height:1px;background:rgba(255,255,255,.06);margin:16px 0}
  </style>
</head>
<body>
  <div class="wrap">
    <h1>AquilaTrader</h1>

    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <div class="wallet">Wallet: <span id="addr">-</span></div>
          <div class="hint">Endpoints utilisés: <code>/wolverine/traderone/api/*</code></div>
        </div>
        <div class="row">
          <button id="connect" class="secondary">Connect Wallet</button>
          <button id="health" class="secondary">Health</button>
        </div>
      </div>

      <div class="sep"></div>

      <input id="amount" type="number" min="0" step="any" value="1" />

      <div class="row" style="margin-top:14px">
        <button id="start">Start</button>
        <button id="stop" class="secondary">Stop</button>
        <button id="cash" class="secondary">Cash-out</button>
      </div>

      <div id="log" class="log"></div>
      <div class="hint">
        Tip: si Phantom est installé, le bouton Connect va récupérer l'adresse. Sinon, tu peux quand même tester Start/Stop/Health.
      </div>
    </div>

    <div class="hint" style="margin-top:14px">
      Liens: <a href="/wolverine/traderone/api/health">/wolverine/traderone/api/health</a> •
      <a href="/wolverine/traderone/vault/health">/wolverine/traderone/vault/health</a>
    </div>
  </div>

<script>
(function(){
  const $ = (s)=>document.querySelector(s);
  const logEl = $("#log");
  const addrEl = $("#addr");
  let pub = "";

  function log(msg){
    const t = new Date().toLocaleTimeString('fr-CA',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    logEl.textContent = `[${t}] ${msg}\n` + logEl.textContent;
  }

  async function post(url, body){
    const r = await fetch(url, {
      method:"POST",
      headers:{ "content-type":"application/json" },
      body: JSON.stringify(body || {})
    });
    const txt = await r.text();
    let data = txt;
    try { data = JSON.parse(txt); } catch(_){}
    if(!r.ok){
      throw new Error(`HTTP ${r.status}: ${typeof data==="string"?data:JSON.stringify(data)}`);
    }
    return data;
  }

  async function get(url){
    const r = await fetch(url, { method:"GET" });
    const txt = await r.text();
    let data = txt;
    try { data = JSON.parse(txt); } catch(_){}
    if(!r.ok) throw new Error(`HTTP ${r.status}: ${txt}`);
    return data;
  }

  $("#connect").onclick = async ()=>{
    try{
      if(!window.solana || !window.solana.isPhantom){
        log("Phantom non détecté (window.solana.isPhantom absent).");
        return;
      }
      const res = await window.solana.connect({ onlyIfTrusted:false });
      pub = (res && res.publicKey) ? res.publicKey.toString() : (window.solana.publicKey ? window.solana.publicKey.toString() : "");
      if(pub){
        addrEl.textContent = pub;
        log("Wallet connecté: " + pub);
      }else{
        log("Connect ok mais pubkey introuvable.");
      }
    }catch(e){
      log("Connect error: " + (e && e.message ? e.message : String(e)));
    }
  };

  $("#health").onclick = async ()=>{
    try{
      const d = await get("/wolverine/traderone/api/health");
      log("health: " + (typeof d==="string"?d:JSON.stringify(d)));
    }catch(e){
      log("health error: " + (e && e.message ? e.message : String(e)));
    }
  };

  $("#start").onclick = async ()=>{
    try{
      const amount = Number($("#amount").value || 0);
      const d = await post("/wolverine/traderone/api/start", { amount, userPub: pub || "" });
      log("started: " + (typeof d==="string"?d:JSON.stringify(d)));
    }catch(e){
      log("start error: " + (e && e.message ? e.message : String(e)));
    }
  };

  $("#stop").onclick = async ()=>{
    try{
      const d = await post("/wolverine/traderone/api/stop", { userPub: pub || "" });
      log("stopped: " + (typeof d==="string"?d:JSON.stringify(d)));
    }catch(e){
      log("stop error: " + (e && e.message ? e.message : String(e)));
    }
  };

  $("#cash").onclick = async ()=>{
    try{
      const d = await post("/wolverine/traderone/api/cashout", { userPub: pub || "" });
      log("cashout: " + (typeof d==="string"?d:JSON.stringify(d)));
    }catch(e){
      log("cashout error: " + (e && e.message ? e.message : String(e)));
    }
  };

  log("AquilaTrader ready.");
})();
</script>
</body>
</html>
HTML

chmod 0644 "$INDEX"
chown -R root:root "$WWW"
find "$WWW" -type d -exec chmod 0755 {} \;
find "$WWW" -type f -exec chmod 0644 {} \;

say "OK: $INDEX written"

hr
say "3) Write nginx include: $NGX_INC_FILE"
cat >"$NGX_INC_FILE" <<EOF
# aquilatrader_routes.inc (managed)
# Static webroot: $WWW

location = /aquilatrader { return 301 /aquilatrader/; }

location ^~ /aquilatrader/ {
  alias $WWW/;
  index index.html;
  try_files \$uri \$uri/ /aquilatrader/index.html;
  add_header Cache-Control "no-store" always;
}
EOF
chmod 0644 "$NGX_INC_FILE"
chown root:root "$NGX_INC_FILE"

hr
say "4) Ensure vhost includes aquilatrader include"
# unlock immutable flags if any
say "Unlock nginx files (chattr -i) if needed"
chattr -i "$NGX_VHOST" 2>/dev/null || true
chattr -i "$NGX_CONF" 2>/dev/null || true

if ! grep -qF "include $NGX_INC_FILE;" "$NGX_VHOST"; then
  say "Inject include line into vhost: $NGX_VHOST"
  # Insert after wolverine include if present, else near top of server block.
  if grep -qE 'include\s+/etc/nginx/includes/wolverine_routes\.inc;' "$NGX_VHOST"; then
    perl -0777 -pe 's|(include\s+/etc/nginx/includes/wolverine_routes\.inc;)|$1\n  include /etc/nginx/includes/aquilatrader_routes.inc;|g' -i "$NGX_VHOST"
  else
    perl -0777 -pe 's|(server\s*\{)|$1\n  include /etc/nginx/includes/aquilatrader_routes.inc;|s' -i "$NGX_VHOST"
  fi
else
  say "Vhost already includes aquilatrader include"
fi

hr
say "5) nginx -t then reload"
nginx -t
systemctl reload nginx

# re-lock (best effort)
say "Re-lock nginx files (chattr +i) best-effort"
chattr +i "$NGX_VHOST" 2>/dev/null || true
chattr +i "$NGX_CONF" 2>/dev/null || true

hr
say "6) Local health checks (with Host header)"
set +e
curl -k -sS -D "$BK/curl_headers_aquilatrader.txt" "https://127.0.0.1/aquilatrader/" -H "Host: fireinners.online" | head -n 25 >"$BK/aquilatrader_head.html"
RC1=$?
curl -k -sS "https://127.0.0.1/wolverine/traderone/api/health" -H "Host: fireinners.online" >"$BK/traderone_api_health.txt"
RC2=$?
set -e

say "curl aquilatrader rc=$RC1  (saved: $BK/aquilatrader_head.html + headers)"
say "curl traderone health rc=$RC2 (saved: $BK/traderone_api_health.txt)"

hr
say "DONE"
say "Open: https://fireinners.online/aquilatrader/"
say "Backup: $BK"
BASH

bash /root/MEGA_AQUILATRADER_DEPLOY_V1.sh
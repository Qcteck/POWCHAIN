sudo bash -lc 'set -euo pipefail;OUTDIR=/opt/fireinners/sentinel/reports;mkdir -p "$OUTDIR";TS=$(date -u +%Y%m%d_%H%M%S);OUT="$OUTDIR/index_html_${TS}.tsv";LOG="$OUTDIR/index_html_${TS}.log";:>"$OUT";:>"$LOG";printf "size\tmtime\tmode\tsha256\ttitle\tpath\n" >>"$OUT";roots=(/opt /var/www /srv /home /root);find_cmd(){ local R="$1"; find "$R" -xdev \( -path "*/.git" -o -path "*/.git/*" -o -path "*/node_modules" -o -path "*/node_modules/*" -o -path "*/.cache" -o -path "*/.cache/*" -o -path "*/dist" -o -path "*/dist/*" -o -path "*/build" -o -path "*/build/*" -o -path "*/.next" -o -path "*/.next/*" -o -path "*/tmp" -o -path "*/tmp/*" \) -prune -o -type f -iname "index.html" -print; };for R in "${roots[@]}";do [ -d "$R" ]||continue;find_cmd "$R" 2>>"$LOG";done | sort -u | while IFS= read -r f;do [ -f "$f" ]||continue;sz=$(stat -c%s "$f" 2>>"$LOG"||echo 0);mt=$(stat -c%y "$f" 2>>"$LOG"|awk "{print \$1\"T\"\$2\"Z\"}"|sed "s/\\.\\([0-9]\\+\\)Z/Z/"||echo "");md=$(stat -c%a "$f" 2>>"$LOG"||echo "");sh=$(sha256sum "$f" 2>>"$LOG"|awk "{print \$1}"||echo "");ti=$(grep -im1 "<title" "$f" 2>>"$LOG"|sed -E "s/.*<title[^>]*>//I;s#</title>.*##I"|tr -d "\r"|tr "\t" " "|tr -s " "|cut -c1-160||true);printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$sz" "$mt" "$md" "$sh" "$ti" "$f" >>"$OUT";done;echo "OK: $OUT";echo "LOG: $LOG";echo "Preview:";sed -n "1,40p" "$OUT"'
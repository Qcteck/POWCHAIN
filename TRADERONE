#!/bin/bash
set -e

FRONT="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
cp $FRONT $FRONT.bak.particles.$(date +%s)

sed -i '/<\/head>/i\
<style>\
/* === LAYERS === */\
#particles{position:fixed;inset:0;z-index:999;pointer-events:none;}\
#sharebar{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);z-index:1000;\
display:flex;gap:18px;padding:10px 18px;border-radius:22px;\
background:rgba(10,10,20,0.35);backdrop-filter:blur(14px);\
border:1px solid rgba(255,255,255,0.35);\
box-shadow:0 0 30px rgba(255,79,216,0.35);}\
#sharebar a{color:white;font-size:20px;text-decoration:none;opacity:.9}\
#sharebar a:hover{opacity:1;filter:drop-shadow(0 0 6px #fff);}\
</style>' $FRONT

sed -i '/<\/body>/i\
<canvas id="particles"></canvas>\
<div id="sharebar">\
<a href="https://twitter.com/intent/tweet" target="_blank">𝕏</a>\
<a href="https://www.facebook.com/sharer/sharer.php" target="_blank">📘</a>\
<a href="https://t.me/share/url" target="_blank">📨</a>\
</div>\
<script>\
/* === MILLIONS-LIKE PARTICLE ENGINE === */\
const c=document.getElementById("particles"),ctx=c.getContext("2d");\
let W,H,DPR=window.devicePixelRatio||1;\
function resize(){W=c.width=innerWidth*DPR;H=c.height=innerHeight*DPR;c.style.width=innerWidth+"px";c.style.height=innerHeight+"px";}\
addEventListener("resize",resize);resize();\
\
const COUNT=Math.min(80000,Math.floor(W*H/800));\
const P=new Float32Array(COUNT*7);\
for(let i=0;i<COUNT;i++){\
const o=i*7;\
P[o]=Math.random()*W;P[o+1]=Math.random()*H;\
P[o+2]=Math.random()*1.2+0.05;\
P[o+3]=Math.random()*0.8+0.05;\
P[o+4]=Math.random()*Math.PI*2;\
P[o+5]=Math.random()*2+0.2;\
P[o+6]=Math.random();}\
\
let t=0;\
function loop(){t+=0.004;\
ctx.clearRect(0,0,W,H);\
for(let i=0;i<COUNT;i++){\
const o=i*7;\
let x=P[o],y=P[o+1],r=P[o+2],v=P[o+3],ph=P[o+4],tw=P[o+5],l=P[o+6];\
ph+=0.01+l*0.02;\
y-=v*(0.6+Math.sin(t+ph));\
if(y<-10)y=H+10;\
const flick=0.5+0.5*Math.sin(tw*t+ph);\
ctx.globalAlpha=0.15+flick*0.6;\
ctx.fillStyle=`hsl(${(ph*180/Math.PI)%360},90%,70%)`;\
ctx.beginPath();ctx.arc(x,y,r*(1+flick*0.8),0,7);ctx.fill();\
P[o+1]=y;P[o+4]=ph;}\
requestAnimationFrame(loop);}\
loop();\
</script>' $FRONT

nginx -t && systemctl reload nginx
echo "✅ PARTICULES MASSIVES + BANNIERE PARTAGE OK"
#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

TS="$(date +%Y%m%d_%H%M%S)"
WORK="/opt/orion"
SRC="$WORK/src"
WWW="/var/www/orion"

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGX_INC_DIR="/etc/nginx/includes"
NGX_INC_FILE="$NGX_INC_DIR/orion_routes.inc"

ZIP_CANDIDATES=(
  "${ORION_ZIP_PATH:-}"
  "/root/orion.zip"
  "/root/orion/orion.zip"
  "/opt/orion.zip"
  "/opt/orion/orion.zip"
  "/var/www/orion.zip"
  "/tmp/orion.zip"
)

log(){ printf "\n[%s] %s\n" "$(date -u +'%F %T UTC')" "$*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [[ -f "$ASKLIB" ]]; then
  # shellcheck disable=SC1090
  source "$ASKLIB"
else
  askorupdate_file(){ local src="$1" dst="$2" mode="${3:-0644}"; mkdir -p "$(dirname "$dst")"; [[ -f "$dst" ]] && cp -a "$dst" "$dst.bak.$TS"; install -m "$mode" "$src" "$dst"; }
fi

require_root(){ [[ "$(id -u)" == "0" ]] || die "Lance ce script en root."; }
ensure_cmd(){ command -v "$1" >/dev/null 2>&1 || die "Commande manquante: $1"; }
backup_path(){ local p="$1"; [[ -e "$p" ]] && cp -a "$p" "$p.bak.$TS" || true; }
chattr_unlock(){ command -v chattr >/dev/null 2>&1 && [[ -e "$1" ]] && chattr -i "$1" 2>/dev/null || true; }
chattr_lock(){ command -v chattr >/dev/null 2>&1 && [[ -e "$1" ]] && chattr +i "$1" 2>/dev/null || true; }

apt_install_deps(){
  log "APT deps"
  apt-get update -y
  apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg unzip rsync git nginx \
    build-essential python3-minimal jq
}

install_node20(){
  if command -v node >/dev/null 2>&1 && node -v | grep -Eq '^v20\.'; then
    log "Node OK: $(node -v)"
    return 0
  fi
  log "Install/Upgrade Node 20 (NodeSource)"
  ensure_cmd curl; ensure_cmd gpg
  install -d -m 0755 /etc/apt/keyrings
  curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
  local codename; codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-noble}")"
  printf "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x %s main\n" "$codename" > /etc/apt/sources.list.d/nodesource.list
  apt-get update -y
  apt-get install -y nodejs
  node -v | grep -Eq '^v20\.' || die "Node 20 non installé correctement."
  log "Node: $(node -v) | npm: $(npm -v || true)"
}

write_nginx_include(){
  mkdir -p "$NGX_INC_DIR"
  local tmp; tmp="$(mktemp)"
  cat >"$tmp" <<'NGX'
# AUTOGENERATED: orion_routes.inc
location ^~ /orion/ {
  alias /var/www/orion/;
  try_files $uri $uri/ /orion/index.html;
  add_header Cache-Control "no-store";
}
NGX
  chattr_unlock "$NGX_INC_FILE"
  backup_path "$NGX_INC_FILE"
  askorupdate_file "$tmp" "$NGX_INC_FILE" 0644
  rm -f "$tmp"
  chattr_lock "$NGX_INC_FILE"
  log "Nginx include: $NGX_INC_FILE"
}

ensure_include_in_vhost(){
  ensure_cmd nginx
  [[ -f "$NGX_VHOST" ]] || die "Vhost introuvable: $NGX_VHOST"
  local inc_line="include $NGX_INC_FILE;"
  if grep -Fq "$inc_line" "$NGX_VHOST"; then
    log "Vhost: include déjà présent."
    return 0
  fi
  log "Vhost: insertion include orion"
  chattr_unlock "$NGX_VHOST"
  backup_path "$NGX_VHOST"
  local tmp; tmp="$(mktemp)"
  awk -v ins="$inc_line" 'BEGIN{done=0}{if(!done && $0~/^[[:space:]]*location[[:space:]]/){print "  " ins; done=1} print $0}' "$NGX_VHOST" > "$tmp"
  if ! grep -Fq "$inc_line" "$tmp"; then
    awk -v ins="$inc_line" '{l[NR]=$0}END{for(i=1;i<=NR;i++){if(i==NR && l[i]~/^[[:space:]]*}[[:space:]]*$/){print "  " ins} print l[i]}}' "$NGX_VHOST" > "$tmp"
  fi
  install -m 0644 "$tmp" "$NGX_VHOST"
  rm -f "$tmp"
  nginx -t
  systemctl reload nginx
  chattr_lock "$NGX_VHOST"
  log "Nginx reload OK"
}

deploy_placeholder(){
  log "Déploiement placeholder (évite 404 tant que le zip/repo n'est pas fourni)"
  mkdir -p "$WWW"
  backup_path "$WWW/index.html"
  cat >"$WWW/index.html" <<'HTML'
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Orion - attente du build</title><style>body{font-family:system-ui,Segoe UI,Roboto,Arial;margin:40px;max-width:900px}code,pre{background:#111;color:#0f0;padding:10px;border-radius:8px;display:block;overflow:auto}h1{margin:0 0 10px}</style></head><body><h1>Orion n'est pas encore déployé</h1><p>Le serveur attend le projet (ZIP ou repo) pour compiler et publier le build.</p><h2>Option ZIP (PC → VPS)</h2><pre><code>scp orion.zip root@72.61.79.12:/root/orion.zip
ssh root@72.61.79.12 "bash /root/MEGA_ORION_DEPLOY_V4.sh"</code></pre><h2>Option URL directe</h2><pre><code>ORION_ZIP_URL="https://TON-LIEN/orion.zip" bash /root/MEGA_ORION_DEPLOY_V4.sh</code></pre><h2>Option Git</h2><pre><code>ORION_GIT_URL="git@github.com:TONUSER/orion.git" bash /root/MEGA_ORION_DEPLOY_V4.sh</code></pre></body></html>
HTML
  chown -R www-data:www-data "$WWW" 2>/dev/null || true
  find "$WWW" -type d -exec chmod 0755 {} \; 2>/dev/null || true
  find "$WWW" -type f -exec chmod 0644 {} \; 2>/dev/null || true
}

find_orion_source(){
  # 1) ZIP local
  for p in "${ZIP_CANDIDATES[@]}"; do
    [[ -n "${p:-}" ]] || continue
    if [[ -f "$p" && -s "$p" ]]; then
      echo "zip:$p"
      return 0
    fi
  done
  # 2) URL zip
  if [[ -n "${ORION_ZIP_URL:-}" ]]; then
    ensure_cmd curl
    local out="/root/orion.zip"
    log "Téléchargement ORION_ZIP_URL -> $out"
    curl -fL --retry 3 --retry-delay 2 -o "$out" "$ORION_ZIP_URL"
    [[ -s "$out" ]] || die "Zip téléchargé vide."
    echo "zip:$out"
    return 0
  fi
  # 3) Git
  if [[ -n "${ORION_GIT_URL:-}" ]]; then
    echo "git:${ORION_GIT_URL}"
    return 0
  fi
  return 1
}

unpack_or_clone(){
  rm -rf "$SRC"
  mkdir -p "$SRC"
  local srcspec
  if ! srcspec="$(find_orion_source)"; then
    deploy_placeholder
    write_nginx_include
    ensure_include_in_vhost
    log "Aucune source fournie (zip/url/git). Placeholder servi sur /orion/."
    exit 2
  fi

  if [[ "$srcspec" == zip:* ]]; then
    local zip="${srcspec#zip:}"
    log "Source: ZIP $zip"
    unzip -q -o "$zip" -d "$SRC"
  else
    local giturl="${srcspec#git:}"
    log "Source: GIT $giturl"
    rm -rf "$SRC/repo"
    git clone --depth 1 "$giturl" "$SRC/repo"
  fi

  # Detect root projet
  local rootdir="$SRC"
  if [[ -d "$SRC/repo" ]]; then rootdir="$SRC/repo"; fi
  if [[ -f "$rootdir/package.json" ]]; then echo "$rootdir"; return 0; fi
  local pj; pj="$(find "$rootdir" -maxdepth 4 -type f -name package.json | head -n1 || true)"
  [[ -n "$pj" ]] || die "package.json introuvable dans la source."
  echo "$(dirname "$pj")"
}

build_and_deploy(){
  ensure_cmd rsync
  local rootdir; rootdir="$(unpack_or_clone)"
  log "Root projet: $rootdir"
  cd "$rootdir"

  npm config set fund false >/dev/null 2>&1 || true
  npm config set audit false >/dev/null 2>&1 || true
  npm config set fetch-retries 3 >/dev/null 2>&1 || true
  npm config set fetch-retry-mintimeout 20000 >/dev/null 2>&1 || true
  npm config set fetch-retry-maxtimeout 120000 >/dev/null 2>&1 || true

  log "npm ci"
  npm ci --no-audit --no-fund

  log "npm run build"
  npm run build

  [[ -d "$rootdir/dist" ]] || die "dist/ introuvable après build."

  log "Deploy dist/ -> $WWW"
  backup_path "$WWW"
  mkdir -p "$WWW"
  rsync -a --delete "$rootdir/dist/" "$WWW/"

  chown -R www-data:www-data "$WWW" 2>/dev/null || true
  find "$WWW" -type d -exec chmod 0755 {} \; 2>/dev/null || true
  find "$WWW" -type f -exec chmod 0644 {} \; 2>/dev/null || true
}

healthcheck(){
  ensure_cmd curl
  local code
  code="$(curl -k -s -o /dev/null -w "%{http_code}" "https://fireinners.online/orion/" || true)"
  log "Healthcheck https://fireinners.online/orion/ => HTTP $code"
}

main(){
  require_root
  ensure_cmd awk; ensure_cmd sed
  log "=== ORION DEPLOY V4 START ==="
  apt_install_deps
  install_node20
  build_and_deploy
  write_nginx_include
  ensure_include_in_vhost
  healthcheck
  log "=== ORION DEPLOY V4 DONE ==="
  log "URL: https://fireinners.online/orion/"
}

main "$@"
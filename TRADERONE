sudo bash -lc 'set -euo pipefail;OUTDIR=/opt/fireinners/sentinel/reports;mkdir -p "$OUTDIR";TS=$(date -u +%Y%m%d_%H%M%S);OUT="$OUTDIR/app_discovery_${TS}.txt";:>"$OUT";echo "UTC $(date -u -Is)" >>"$OUT";echo "HOST $(hostname)" >>"$OUT";echo >>"$OUT";IDX=$(ls -1t /opt/fireinners/sentinel/reports/index_html_*.tsv 2>/dev/null | head -n 1 || true);JS=$(ls -1t /opt/fireinners/sentinel/reports/js_files_*.tsv 2>/dev/null | head -n 1 || true);VHOST=/etc/nginx/sites-available/fireinners.online-ssl;PAT="sentinel|warrior|gate|cryptonews|crypto news|etalon|étalon|étalon cryptographique|cryptograph";echo "INDEX_TSV=$IDX" >>"$OUT";echo "JS_TSV=$JS" >>"$OUT";echo "VHOST=$VHOST" >>"$OUT";echo "PATTERN=$PAT" >>"$OUT";echo >>"$OUT";sec(){ echo "==================== $1 ====================" >>"$OUT"; };sec "MATCHES IN index_html TSV";if [ -n "$IDX" ] && [ -f "$IDX" ];then grep -iE "$PAT" "$IDX" | head -n 300 >>"$OUT" || true;else echo "NO index_html TSV FOUND" >>"$OUT";fi;echo >>"$OUT";sec "MATCHES IN js_files TSV";if [ -n "$JS" ] && [ -f "$JS" ];then grep -iE "$PAT" "$JS" | head -n 300 >>"$OUT" || true;else echo "NO js_files TSV FOUND" >>"$OUT";fi;echo >>"$OUT";sec "NGINX: private routes + auth_basic";grep -RInE --binary-files=without-match "(_private_sentinel1|warrior|gate|cryptonews|etalon|étalon|auth_basic|auth_basic_user_file)" /etc/nginx 2>/dev/null | head -n 260 >>"$OUT" || true;echo >>"$OUT";sec "VHOST ROOT + SERVED INDEX";if [ -f "$VHOST" ];then ROOT=$(awk '"'"'BEGIN{r=""}$1=="root"{gsub(/;$/,"",$2);r=$2}END{print r}'"'"' "$VHOST");echo "NGINX_ROOT=$ROOT" >>"$OUT";[ -n "$ROOT" ] && [ -f "$ROOT/index.html" ] && { echo "ROOT_INDEX_SHA=$(sha256sum "$ROOT/index.html" | awk "{print \$1}")" >>"$OUT"; echo "ROOT_INDEX_TITLE=$(grep -im1 "<title" "$ROOT/index.html" | sed -E "s/.*<title[^>]*>//I;s#</title>.*##I" | tr -d "\r" | tr -s " " | cut -c1-160)" >>"$OUT"; } || echo "ROOT_INDEX_MISSING" >>"$OUT";else echo "VHOST_NOT_FOUND" >>"$OUT";fi;echo >>"$OUT";sec "CONTENT SEARCH in /opt/fireinners (fast)";for R in /opt/fireinners /opt/fireinners/sentinel /opt/fireinners/private_sentinel1;do [ -d "$R" ]||continue;echo "-- $R --" >>"$OUT";grep -RInE --binary-files=without-match --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=dist --exclude-dir=build --exclude-dir=.next --exclude-dir=.cache --include="*.html" --include="*.js" --include="*.mjs" --include="*.cjs" --include="*.sh" --include="*.service" --include="*.conf" --include="*.yml" --include="*.yaml" "$PAT" "$R" 2>/dev/null | head -n 200 >>"$OUT" || true;done;echo >>"$OUT";sec "SYSTEMD SERVICES (name match)";systemctl list-units --type=service --all --no-pager 2>/dev/null | grep -iE "sentinel|warrior|cryptonews|trader|fire" | head -n 220 >>"$OUT" || true;echo >>"$OUT";sec "PM2 (if installed)";if command -v pm2 >/dev/null 2>&1;then pm2 ls >>"$OUT" 2>&1 || true;else echo "pm2_not_installed" >>"$OUT";fi;echo >>"$OUT";sec "LIVE NODE PROCESSES";ps -eo pid=,comm=,args= | grep -E " node($| )|nodejs($| )" | grep -v grep | head -n 220 >>"$OUT" || true;echo;echo "OK: $OUT";sed -n "1,140p" "$OUT"'
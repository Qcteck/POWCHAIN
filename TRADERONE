set -euo pipefail
TS="$(date +%Y%m%d-%H%M%S)"
DIST="/opt/fireinners/frontend-react/app/dist"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
AV="/etc/nginx/sites-available/fireinners.online-ssl"
SITE="$AV"; if [ -L "$EN" ]; then SITE="$(readlink -f "$EN")"; fi
[ -f "$SITE" ] || { echo "ERR: vhost introuvable: $SITE"; exit 1; }
export SITE_PATH="$SITE" DIST_PATH="$DIST"
echo "VHOST: $SITE"

chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$SITE" 2>/dev/null || true
cp -a "$SITE" "$SITE.bak.$TS"

mkdir -p "$DIST/stats"
cat >"$DIST/stats/index.json"<<JSON
{"ok":true,"service":"wolfchain-ui","ts":"$(date -u +%FT%TZ)"}
JSON
chmod 755 "$DIST" "$DIST/stats" 2>/dev/null || true
chmod 644 "$DIST/stats/index.json" 2>/dev/null || true

python3 - <<'PY'
import re,os
site=os.environ["SITE_PATH"]
txt=open(site,"r",encoding="utf-8",errors="ignore").read()

WS_BLOCK = '''location /ws {
  proxy_pass http://127.0.0.1:4001;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_read_timeout 86400;
}'''

STATS_BLOCK = '''# forced static /stats (UI healthcheck)
location = /stats { return 301 /stats/index.json; }
location = /stats/index.json {
  default_type application/json;
  add_header Cache-Control "no-store" always;
  alias /opt/fireinners/frontend-react/app/dist/stats/index.json;
}'''

def replace_location(txt, path, new_block):
    m=re.search(r'location\\s+%s\\s*\\{'%re.escape(path),txt)
    if not m: return txt, False
    i=m.start(); j=m.end(); depth=1; k=j
    while k < len(txt) and depth>0:
        if txt[k]=='{': depth+=1
        elif txt[k]=='}': depth-=1
        k+=1
    return txt[:i]+new_block+txt[k:], True

txt,ws_done=replace_location(txt,"/ws",WS_BLOCK)

if "location = /stats/index.json" not in txt:
    # inject in server with server_name fireinners.online
    for m in re.finditer(r'server\\s*\\{',txt):
        s=m.start(); i=m.end(); depth=1; k=i
        while k < len(txt) and depth>0:
            if txt[k]=='{': depth+=1
            elif txt[k]=='}': depth-=1
            k+=1
        end=k
        block=txt[s:end]
        if re.search(r'\\bserver_name\\b[^;]*\\bfireinners\\.online\\b',block):
            txt=txt[:end-1]+"\\n"+STATS_BLOCK+"\\n"+txt[end-1:]
            break
    else:
        txt += "\\n"+STATS_BLOCK+"\\n"

open(site,"w",encoding="utf-8").write(txt)
print("OK patch:", site, "ws_replaced:", ws_done, "stats_present:", ("location = /stats/index.json" in txt))
PY

echo "== nginx -t =="
nginx -t

echo "== reload =="
systemctl reload nginx

echo "== test stats (must be 200 + json) =="
curl -k -sS -i https://127.0.0.1/stats/index.json -H 'Host: fireinners.online' | sed -n '1,25p'

chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$SITE" 2>/dev/null || true
echo "DONE"
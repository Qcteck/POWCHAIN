source /opt/fireinners/sentinel/telegram.env
curl -sS "https://api.telegram.org/bot${TG_TOKEN}/deleteWebhook?drop_pending_updates=true" >/dev/null
curl -sS "https://api.telegram.org/bot${TG_TOKEN}/getUpdates?timeout=0&limit=20" | python3 - <<'PY'
import sys,json
j=json.loads(sys.stdin.read() or "{}")
ids=[]
for u in j.get("result",[]):
  m=u.get("message") or u.get("edited_message") or {}
  c=m.get("chat") or {}
  if "id" in c and m.get("text"):
    ids.append((c["id"], m.get("text")))
print("CHAT_ID:", ids[-1][0] if ids else "NONE")
print("LAST_TEXT:", ids[-1][1] if ids else "NONE")
PY
cat > /root/MEGA_WOLVERINE_FIX_CANON.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/WOLVERINE_PATCH_${TS}"
mkdir -p "$BK"

WEBROOT="/var/www/wolverine"
HTML="${WEBROOT}/index.html"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"

log(){ echo "[$(date +%H:%M:%S)] $*"; }

log "0) Preflight"
id -u | grep -q '^0$' || { echo "ERROR: run as root"; exit 1; }
test -f "$SITE" || { echo "ERROR: missing $SITE"; exit 1; }
test -f "$HTML" || { echo "ERROR: missing $HTML"; ls -ლა "$WEBROOT" || true; exit 1; }

log "1) Backup"
cp -a "$SITE" "$BK/fireinners.online-ssl.bak"
cp -a "$HTML" "$BK/index.html.bak"
for f in /etc/nginx/includes/wolverine*.inc; do [ -f "$f" ] && cp -a "$f" "$BK/$(basename "$f").bak" || true; done

log "2) Unfreeze nginx (+ all wolverine includes)"
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$SITE" 2>/dev/null || true
for f in /etc/nginx/includes/wolverine*.inc; do chattr -i "$f" 2>/dev/null || true; done

log "3) Write canonical include (solana-rpc + vault/api)"
mkdir -p /etc/nginx/includes
cat > "$INC" <<'NGX'
# === WOLVERINE ROUTES (CANONICAL) ===

location ^~ /wolverine/solana-rpc {
    proxy_pass http://127.0.0.1:12713;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "POST, GET, OPTIONS" always;
    add_header Access-Control-Allow-Headers "content-type, authorization" always;
    if ($request_method = OPTIONS) { return 204; }
}

location ^~ /wolverine/vault/api {
    proxy_pass http://127.0.0.1:3010;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "POST, GET, OPTIONS" always;
    add_header Access-Control-Allow-Headers "content-type, authorization" always;
    if ($request_method = OPTIONS) { return 204; }
}
NGX

log "4) Patch vhost: serve /wolverine statique + include routes"
python3 - <<PY
from pathlib import Path
import re

site=Path("$SITE")
s=site.read_text(errors="ignore")

inc="include /etc/nginx/includes/wolverine_routes.inc;"
if inc not in s:
    s=re.sub(r'(server\\s*\\{\\s*\\n)', r'\\1    '+inc+'\\n', s, count=1)

# strip any conflicting location blocks (wolverine root/static)
s=re.sub(r'\\n\\s*location\\s*=\\s*/wolverine\\s*\\{[\\s\\S]*?\\n\\s*\\}\\s*', '\\n', s, flags=re.I)
s=re.sub(r'\\n\\s*location\\s+(\\^~\\s+)?/wolverine/\\s*\\{[\\s\\S]*?\\n\\s*\\}\\s*', '\\n', s, flags=re.I)

canonical = r'''
    # --- WOLVERINE static (CANONICAL) ---
    location = /wolverine { return 301 /wolverine/; }

    location ^~ /wolverine/ {
        alias /var/www/wolverine/;
        try_files $uri $uri/ /wolverine/index.html;
        add_header Cache-Control "no-store" always;
    }
'''
# insert canonical after include line (first server block)
pat=r'(server\\s*\\{[\\s\\S]*?'+re.escape(inc)+r'\\s*\\n)'
if re.search(pat, s):
    s=re.sub(pat, r'\\1'+canonical+'\\n', s, count=1)
else:
    s=re.sub(r'(server\\s*\\{\\s*\\n)', r'\\1'+canonical+'\\n', s, count=1)

site.write_text(s)
print("OK: vhost patched")
PY

log "5) Patch frontend index.html: force ABSOLUTE RPC + vault URLs"
python3 - <<PY
from pathlib import Path
p=Path("$HTML")
s=p.read_text(errors="ignore")

# force absolute URLs (fix: Endpoint URL must start with http/https)
s=s.replace('"/wolverine/solana-rpc"','"https://fireinners.online/wolverine/solana-rpc"')
s=s.replace("'/wolverine/solana-rpc'","'https://fireinners.online/wolverine/solana-rpc'")
s=s.replace('"/wolverine/vault/api"','"https://fireinners.online/wolverine/vault/api"')
s=s.replace("'/wolverine/vault/api'","'https://fireinners.online/wolverine/vault/api'")

p.write_text(s)
print("OK: index.html patched")
PY

log "6) Restart services if present"
systemctl daemon-reload || true
if systemctl list-unit-files | grep -q '^wolverine-solrpc-proxy\.service'; then systemctl restart wolverine-solrpc-proxy.service || true; fi
if systemctl list-unit-files | grep -q '^wolverine-vault-api\.service'; then systemctl restart wolverine-vault-api.service || true; fi

log "7) nginx test + reload"
nginx -t
systemctl reload nginx

log "8) Refreeze"
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$SITE" 2>/dev/null || true
for f in /etc/nginx/includes/wolverine*.inc; do [ -f "$f" ] && chattr +i "$f" 2>/dev/null || true; done

log "9) Quick checks"
echo "--- /wolverine (should 301) ---"
curl -I -sS https://fireinners.online/wolverine | head -n 8 || true
echo "--- /wolverine/ (should 200) ---"
curl -I -sS https://fireinners.online/wolverine/ | head -n 8 || true
echo "--- solana-rpc health (should 200 JSON) ---"
curl -sS https://fireinners.online/wolverine/solana-rpc -o /dev/null -w "HTTP %{http_code}\n" || true
echo "--- vault health (should 200 JSON) ---"
curl -sS https://fireinners.online/wolverine/vault/api/health -o /dev/null -w "HTTP %{http_code}\n" || true

echo
echo "DONE. OPEN: https://fireinners.online/wolverine/  (Ctrl+F5)"
echo "BACKUP: $BK"
EOF

chmod +x /root/MEGA_WOLVERINE_FIX_CANON.sh
/root/MEGA_WOLVERINE_FIX_CANON.sh
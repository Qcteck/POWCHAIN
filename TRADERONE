set -euo pipefail

echo "=== 0) Infos ==="
hostname; date -u; nginx -v 2>&1 || true
echo

echo "=== 1) Test nginx ==="
nginx -t
echo

echo "=== 2) Ports 80/443 ==="
ss -lntp | awk '$4 ~ /:80$|:443$/ {print}'
echo

echo "=== 3) Doublons location /wolverine (fichiers + lignes) ==="
# Trouve TOUS les "location /wolverine" et variantes
grep -RIn --binary-files=without-match -E '^\s*location\s+\^~?\s*/wolverine\b|^\s*location\s+=\s*/wolverine\b|^\s*location\s+/wolverine\b' \
  /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/snippets 2>/dev/null || true
echo

echo "=== 4) Serveurs qui match fireinners.online (server_name) ==="
grep -RIn --binary-files=without-match -E '^\s*server_name\s+.*(fireinners\.online|www\.fireinners\.online)' \
  /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d 2>/dev/null || true
echo

echo "=== 5) Includes effectifs (nginx -T) filtrés wolverine ==="
nginx -T 2>/dev/null | grep -nE 'include .*wolverine|location /wolverine|server_name .*fireinners\.online' || true
echo

echo "=== 6) Snippets wolverine existants ==="
ls -la /etc/nginx/snippets | grep -i wolverine || true
echo

echo "=== 7) Erreurs récentes (cycles rewrite / forbidden / duplicate location) ==="
tail -n 200 /var/log/nginx/error.log 2>/dev/null | grep -Ei 'rewrite|cycle|duplicate location|forbidden|cannot|open\(\)' || true
echo

echo "=== 8) Test local HTTP (sans cloudflare) ==="
curl -I --max-time 2 http://127.0.0.1/ 2>&1 | head -n 5 || true
curl -I --max-time 2 http://127.0.0.1/wolverine/ 2>&1 | head -n 8 || true
echo

echo "=== FIN (audit only) ==="
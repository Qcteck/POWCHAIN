set -e
cd /root

echo "=== 1) NGINX -t (récupère fichier + ligne) ==="
ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 20

FILE="$(echo "$ERR" | sed -n 's/.*in \(\/[^:]*\):.*/\1/p' | head -n 1)"
LINE="$(echo "$ERR" | sed -n 's/.*in \/[^:]*:\([0-9]\+\).*/\1/p' | head -n 1)"
echo "FILE=$FILE"
echo "LINE=$LINE"

if [ -z "$FILE" ] || [ -z "$LINE" ] || [ ! -f "$FILE" ]; then
  echo "Impossible de détecter le fichier/ligne. (FILE/LINE vides)"
  exit 1
fi

echo
echo "=== 2) Montre la zone autour de la ligne ==="
nl -ba "$FILE" | sed -n "$((LINE-8)),$((LINE+8))p"

echo
echo "=== 3) Backup + commente EXACTEMENT la ligne fautive ==="
cp -v "$FILE" "$FILE.bak.$(date +%Y%m%d_%H%M%S)"
perl -pi -e "if (\$. == $LINE) { s/^\\s*/# FIX_DISABLED_BAD_PROXY_SET_HEADER / }" "$FILE"

echo
echo "=== 4) Re-test nginx ==="
nginx -t

echo
echo "=== 5) Reload nginx ==="
systemctl reload nginx
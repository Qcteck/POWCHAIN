bash <<'EOF'
set -euo pipefail

echo "=== AIAQUILA ROOT FIX — HOSTINGER SAFE MODE ==="

SITE_ROOT="/var/www/fireinners.online/aiaquila"
INDEX="$SITE_ROOT/index.html"
BACKUP="$SITE_ROOT/index.backup.$(date +%Y%m%d_%H%M%S).html"
SNIPPET="/etc/nginx/snippets/aiaquila_rss_proxy.conf"
WORKER="https://aiaquila-proxy.paycashnostory.workers.dev/rss"

command -v nginx >/dev/null
command -v curl >/dev/null

echo "[1/6] Test Worker depuis VPS..."
curl -fsS "$WORKER?url=https://news.bitcoin.com/feed/" | jq '.items[0].title' >/dev/null
echo "OK Worker VPS"

echo "[2/6] Backup frontend..."
cp -a "$INDEX" "$BACKUP"
echo "Backup -> $BACKUP"

echo "[3/6] Création snippet nginx (auto-load)..."
cat > "$SNIPPET" <<NGX
location /aiaquila/api/rss {
    proxy_pass https://aiaquila-proxy.paycashnostory.workers.dev/rss;
    proxy_set_header Host aiaquila-proxy.paycashnostory.workers.dev;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_ssl_server_name on;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}
NGX

echo "[4/6] Réécriture frontend (VPS LOCAL ONLY)..."
cat > "$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel (VPS)</title>
<style>
body{margin:0;padding:20px;background:#0b1b3a;color:#fff;font-family:system-ui}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px;color:#cfe}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (VPS)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
<script>
async function load(){
 const o=document.getElementById("out");
 o.textContent="Chargement…";
 try{
  const r=await fetch("/aiaquila/api/rss?url="+encodeURIComponent("https://news.bitcoin.com/feed/"),{cache:"no-store"});
  if(!r.ok) throw r.status;
  const j=await r.json();
  o.textContent=j.items.map(x=>"• "+x.title+"\n"+x.link).join("\n\n");
 }catch(e){
  o.textContent="ERREUR: "+e;
 }
}
</script>
</body>
</html>
HTML

echo "[5/6] Permissions + reload nginx..."
chown www-data:www-data "$INDEX"
chmod 644 "$INDEX"
nginx -t
systemctl reload nginx

echo "[6/6] Test endpoint VPS..."
curl -fsS "https://fireinners.online/aiaquila/api/rss?url=https://news.bitcoin.com/feed/" | jq '.items[0].title'

echo "=== ✅ AIAQUILA FONCTIONNEL (HOSTINGER SAFE) ==="
echo "Site   : https://fireinners.online/aiaquila/"
echo "Backup : $BACKUP"
EOF
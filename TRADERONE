#!/usr/bin/env bash
set -euo pipefail

echo "==============================================="
echo " AIAQUILA — ROOT INSTALL & LAUNCH"
echo "==============================================="

# -------------------------------
# 1. CHECK ROOT
# -------------------------------
if [ "$EUID" -ne 0 ]; then
  echo "❌ Ce script doit être lancé en root"
  exit 1
fi

# -------------------------------
# 2. VARIABLES
# -------------------------------
APP_DIR="/var/www/fireinners/aiaquila"
BACKUP_DIR="/root/aiaquila_backup_$(date +%Y%m%d_%H%M%S)"
NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

echo "📁 App dir    : $APP_DIR"
echo "📦 Backup dir : $BACKUP_DIR"

# -------------------------------
# 3. BACKUP EXISTANT
# -------------------------------
if [ -d "$APP_DIR" ]; then
  echo "📦 Backup de l'existant..."
  mkdir -p "$BACKUP_DIR"
  cp -a "$APP_DIR" "$BACKUP_DIR/"
fi

# -------------------------------
# 4. CREATE DIR
# -------------------------------
mkdir -p "$APP_DIR"
chown -R www-data:www-data "$APP_DIR"

# -------------------------------
# 5. WRITE FRONTEND
# -------------------------------
echo "🧠 Écriture frontend AIAQUILA"

cat > "$APP_DIR/index.html" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — Cerveau d’Analyse Continue</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{margin:0;background:#05070a;color:#e6e6e6;font-family:system-ui}
header{padding:14px 20px;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{max-width:920px;margin:0 auto;padding:20px;line-height:1.6}
article{border:1px solid #1f2937;border-radius:10px;padding:14px;margin-bottom:14px;background:#0b0f14}
h2{font-size:16px;color:#93c5fd;margin:0 0 6px}
.meta{font-size:12px;color:#9ca3af}
.feedback button{background:#111827;color:#fff;border:1px solid #374151;border-radius:6px;padding:6px 10px;cursor:pointer}
.feedback button:hover{background:#1f2937}
#status{position:fixed;bottom:14px;right:14px;font-size:11px;color:#9ca3af}
</style>
</head>
<body>
<header>
  <strong>AIAQUILA</strong>
  <span>Analyse continue</span>
</header>
<main>
  <div id="stream"></div>
</main>
<div id="status">RSS proxy connecté</div>

<script>
const MEMORY=JSON.parse(localStorage.getItem("AIAQUILA_MEMORY")||"{}");
MEMORY.entities=MEMORY.entities||{};
MEMORY.logicBias=MEMORY.logicBias||0;

function save(){localStorage.setItem("AIAQUILA_MEMORY",JSON.stringify(MEMORY));}

const RSS="https://aiaquila-proxy.paycashnostory.workers.dev/rss";

async function fetchRSS(){
  const r=await fetch(RSS);
  const t=await r.text();
  const x=new DOMParser().parseFromString(t,"text/xml");
  return [...x.querySelectorAll("item")].slice(0,6).map(i=>({
    t:i.querySelector("title")?.textContent||"",
    d:i.querySelector("description")?.textContent||"",
    p:i.querySelector("pubDate")?.textContent||""
  }));
}

function entities(txt){
  return ["Bitcoin","Solana","Ethereum","Musk","Fed","Inflation"].filter(e=>txt.includes(e));
}

function render(i){
  const e=entities(i.t+i.d);
  e.forEach(x=>MEMORY.entities[x]=(MEMORY.entities[x]||0)+1);
  save();
  return `
  <article>
    <h2>${i.t}</h2>
    <div class="meta">${i.p}</div>
    <p>${e.length?`Les données concernent directement ${e.join(", ")}.`:"Le point clé ici est l’ajustement progressif des anticipations."}</p>
    <p>Ce n’est pas le fait lui-même qui compte, mais le moment où le marché cesse d’y réagir.</p>
    <div class="feedback">
      <button onclick="fb(1)">👍</button>
      <button onclick="fb(-1)">👎</button>
    </div>
  </article>`;
}

function fb(v){
  MEMORY.logicBias=Math.max(-10,Math.min(10,MEMORY.logicBias+v));
  save();
}

async function run(){
  const s=document.getElementById("stream");
  const it=await fetchRSS();
  s.innerHTML=it.map(render).join("");
}

run();
setInterval(run,180000);
</script>
</body>
</html>
HTML

chown www-data:www-data "$APP_DIR/index.html"

# -------------------------------
# 6. VERIFY NGINX (READ-ONLY)
# -------------------------------
echo "🔍 Test nginx (sans reload forcé)"
nginx -t

# -------------------------------
# 7. FINAL CHECK
# -------------------------------
echo "==============================================="
echo "✅ AIAQUILA DÉPLOYÉ"
echo "📍 URL : https://fireinners.online/aiaquila/"
echo "📦 Backup : $BACKUP_DIR"
echo "==============================================="





chmod +x AIAQUILA_ROOT_INSTALL.sh
./AIAQUILA_ROOT_INSTALL.sh
cat > /root/wolv_nginx_batch.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APPLY=0
[[ "${1:-}" == "--apply" ]] && APPLY=1

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/nginx_backups_${TS}"
SITE_DIR="/etc/nginx/sites-enabled"
NGINX_CONF="/etc/nginx/nginx.conf"

echo "=== WOLV NGINX BATCH ==="
echo "Backup dir: $BK"
mkdir -p "$BK"

echo
echo "=== 1) Backup nginx confs ==="
cp -a "$NGINX_CONF" "$BK/nginx.conf.bak"
if [[ -d "$SITE_DIR" ]]; then
  cp -a "$SITE_DIR" "$BK/sites-enabled.bak"
fi
echo "OK backup."

echo
echo "=== 2) Nginx test ==="
nginx -t || { echo "❌ nginx -t failed"; exit 1; }
echo "✅ nginx -t OK"

echo
echo "=== 3) Listen ports (80/443) ==="
if command -v ss >/dev/null 2>&1; then
  ss -lntp | egrep ':(80|443)\s' || true
else
  netstat -lntp | egrep ':(80|443)\s' || true
fi

echo
echo "=== 4) Find server blocks for fireinners ==="
grep -RIn --color=always "server_name.*fireinners" /etc/nginx 2>/dev/null || true

echo
echo "=== 5) Find duplicate location /wolverine ==="
# Affiche les fichiers et les lignes où apparait "location /wolverine"
grep -RIn --color=always "location\s\+/wolverine" /etc/nginx 2>/dev/null || true

echo
echo "=== 6) Find try_files /index.html patterns (possible loop) ==="
grep -RIn --color=always "try_files.*index\.html" /etc/nginx 2>/dev/null || true
grep -RIn --color=always "rewrite.*index\.html" /etc/nginx 2>/dev/null || true

echo
echo "=== 7) Recent nginx errors about rewrite cycle ==="
# Ajuste le path si logs ailleurs
LOG1="/var/log/nginx/error.log"
if [[ -f "$LOG1" ]]; then
  tail -n 200 "$LOG1" | egrep -i "rewrite|internal redirection|cycle|wolverine|_next|favicon" || true
else
  echo "(no $LOG1)"
fi

echo
echo "=== 8) Quick local curls (origin reachability) ==="
set +e
curl -sS -I http://127.0.0.1/ | head -n 5
curl -sS -I http://127.0.0.1/wolverine/ | head -n 8
curl -sS -k -I https://127.0.0.1/ | head -n 5
curl -sS -k -I https://127.0.0.1/wolverine/ | head -n 8
set -e

echo
echo "=== 9) Optional FIX (apply) ==="
if [[ "$APPLY" -eq 0 ]]; then
  echo "Mode SAFE: aucune modif appliquée."
  echo "👉 Pour générer et appliquer une conf /wolverine safe: relance avec: bash /root/wolv_nginx_batch.sh --apply"
  exit 0
fi

# On tente d'identifier le vhost fireinners* principal dans sites-enabled
TARGET_FILE="$(grep -RIl "server_name.*fireinners" "$SITE_DIR" 2>/dev/null | head -n 1 || true)"
if [[ -z "$TARGET_FILE" ]]; then
  echo "❌ Impossible de trouver le fichier vhost fireinners* dans $SITE_DIR."
  echo "   Applique manuellement le fix dans le bon server{}."
  exit 1
fi

echo "Target vhost file: $TARGET_FILE"
cp -a "$TARGET_FILE" "$BK/$(basename "$TARGET_FILE").preapply.bak"

# On ajoute un bloc location /wolverine SAFE:
# - sert la SPA Next build depuis /var/www/wolverine
# - évite le loop: fallback vers /wolverine/index.html (pas /index.html global)
# - bloque l'indexing de /_next/static si besoin
# ⚠️ À adapter si ton root réel diffère
WROOT="/var/www/wolverine"

echo
echo "Injecting /wolverine location block into $TARGET_FILE"
echo "NOTE: backup saved in $BK"

# On injecte à la fin du server{} (avant la dernière accolade)
python3 - <<PY
import re, pathlib
p = pathlib.Path("$TARGET_FILE")
s = p.read_text()

block = r'''
    # --- AUTO-FIX WOLVERINE (${TS}) ---
    location ^~ /wolverine/ {
        alias ''' + "$WROOT" + r'''/;
        # Next static files
        location ^~ /wolverine/_next/ {
            try_files \$uri \$uri/ =404;
            access_log off;
            expires 30d;
        }

        # API pass-through example (si tu as un backend Node/pm2 sur 3000)
        # Décommente si nécessaire :
        # location ^~ /wolverine/api/ {
        #     proxy_pass http://127.0.0.1:3000/;
        #     proxy_set_header Host \$host;
        #     proxy_set_header X-Real-IP \$remote_addr;
        #     proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        #     proxy_set_header X-Forwarded-Proto \$scheme;
        # }

        # SPA fallback => IMPORTANT: on reste dans /wolverine/
        try_files \$uri \$uri/ /wolverine/index.html;
    }
    # --- END AUTO-FIX WOLVERINE ---
'''

# vérifie si déjà injecté
if "AUTO-FIX WOLVERINE" in s:
    raise SystemExit("Already contains AUTO-FIX WOLVERINE block; aborting.")

# injection avant la dernière "}" du fichier
m = re.search(r"\}\s*$", s, re.M)
if not m:
    raise SystemExit("Cannot find closing brace to inject.")
s2 = s[:m.start()] + block + "\n" + s[m.start():]
p.write_text(s2)
print("Injected block.")
PY

echo
echo "Re-test nginx..."
nginx -t

echo
echo "Reload nginx..."
systemctl reload nginx || service nginx reload

echo "✅ Applied. Check again:"
echo "  curl -I https://127.0.0.1/wolverine/ -k"
echo "  tail -f /var/log/nginx/error.log"
BASH

chmod +x /root/wolv_nginx_batch.sh
echo "OK: /root/wolv_nginx_batch.sh"
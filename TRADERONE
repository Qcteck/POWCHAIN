set -euo pipefail
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

node - <<'JS'
const fs=require("fs");
const f="/var/www/fireinners/wolverine/app.js";
let s=fs.readFileSync(f,"utf8");

// Remplace new Connection("/wolverine/...") par new Connection(new URL("/wolverine/...", location.origin).toString())
s = s.replace(/new\s+solanaWeb3\.Connection\(\s*["']\/wolverine\/traderone\/api\/rpc["']\s*,/g,
              'new solanaWeb3.Connection(new URL("/wolverine/traderone/api/rpc", window.location.origin).toString(),');

s = s.replace(/new\s+window\.solanaWeb3\.Connection\(\s*["']\/wolverine\/traderone\/api\/rpc["']\s*,/g,
              'new window.solanaWeb3.Connection(new URL("/wolverine/traderone/api/rpc", window.location.origin).toString(),');

fs.writeFileSync(f,s,"utf8");
console.log("OK: RPC proxy URL forced absolute");
JS

echo "DONE ✅ Ctrl+F5 sur /wolverine puis reteste START"
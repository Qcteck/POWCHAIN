bash --noprofile --norc -lc 'set -euo pipefail;
TS="$(date -u +%Y%m%d-%H%M%S)";
LOG="/root/MEGA_BATCH_MENAGE_ROOT_${TS}.log";
Q="/opt/_quarantine_vps_${TS}";
mkdir -p "$Q/baks" "$Q/mixed" "$Q/meta";
say(){ echo "[$(date -u +%F\ %T)] $*" | tee -a "$LOG"; }
run(){ say "+ $*"; "$@" >>"$LOG" 2>&1 || { say "WARN: failed: $*"; return 0; }; }

say "MEGA BATCH MENAGE ROOT  TS=$TS";
say "Log: $LOG";
say "Quarantine: $Q";

# 0) Preflight
say "0) Preflight";
say "User: $(id -u)  Host: $(hostname)  Kernel: $(uname -r)";
say "PATH: $PATH";
say "Disk before:";
df -hT | tee -a "$LOG";

# 1) Fix cargo spam (create missing file)
say "1) Fix cargo spam (/root/.cargo/env)";
run mkdir -p /root/.cargo;
if [ ! -f /root/.cargo/env ]; then
  run sh -lc ": > /root/.cargo/env";
  run chmod 644 /root/.cargo/env;
  say "Created /root/.cargo/env";
else
  say "/root/.cargo/env already exists";
fi

# 2) Locate where it is sourced (report only)
say "2) Locate cargo env sourcing (report)";
grep -RIn --exclude-dir=.git --exclude="*.log" "/root/.cargo/env" /root /etc 2>/dev/null | head -n 80 | tee -a "$LOG" || true;

# 3) apt cache clean (absolute paths)
say "3) apt cache clean (absolute paths)";
if [ -x /usr/bin/apt-get ]; then
  run /usr/bin/apt-get -y clean;
  run /usr/bin/apt-get -y autoclean;
else
  say "apt-get not found at /usr/bin/apt-get (skip)";
fi

# 4) journald vacuum (absolute paths)
say "4) journald vacuum (absolute paths)";
if [ -x /usr/bin/journalctl ]; then
  run /usr/bin/journalctl --vacuum-time=14d;
else
  say "journalctl not found at /usr/bin/journalctl (skip)";
fi

# 5) Quarantine backups + junk (safe move)
TARGETS="/opt/fireinners/frontend-react/app/dist/wolverine /opt/fireinners/frontend-react/app/dist /opt/fireinners /opt/traderone-opt /TRADERONE /root";
move_to(){ src="$1"; dst="$2"; mkdir -p "$(dirname "$dst")"; if [ ! -e "$dst" ]; then mv -n "$src" "$dst" 2>>"$LOG" || true; fi; }
is_excluded(){ case "$1" in /opt/fireinners/sentinel/*|/opt/fireinners/CHARTE_FIREINNERS.*) return 0;; esac; return 1; }

say "5) Quarantine backups (*.bak*, *.old, *~, *.tmp)";
for base in $TARGETS; do
  [ -d "$base" ] || continue;
  say "Scan backups: $base";
  find "$base" -type f \( -name "*.bak" -o -name "*.bak*" -o -name "*.bakfix*" -o -name "*~" -o -name "*.old" -o -name "*.tmp" \) 2>/dev/null \
  | while IFS= read -r f; do
      is_excluded "$f" && continue;
      rel="${f#/}";
      move_to "$f" "$Q/baks/$rel";
    done;
done

# 6) Quarantine suspicious mixed files (HTML containing bash markers)
say "6) Quarantine mixed files (HTML + bash markers)";
PAT="(set -euo pipefail|apt-get|journalctl|#!/usr/bin/env bash|^#!/bin/bash|git checkout|git push|git commit|find /|mv -n)";
for base in $TARGETS; do
  [ -d "$base" ] || continue;
  say "Scan mixed: $base";
  find "$base" -type f \( -name "*.html" -o -name "*.html.*" -o -name "*.bakfix*" \) 2>/dev/null \
  | while IFS= read -r f; do
      is_excluded "$f" && continue;
      if grep -aEq "$PAT" "$f" 2>/dev/null; then
        rel="${f#/}";
        move_to "$f" "$Q/mixed/$rel";
      fi
    done;
done

# 7) Save meta + summary
say "7) Save meta + summary";
( echo "TS=$TS"; echo "HOST=$(hostname)"; echo "KERNEL=$(uname -r)"; echo "DISK_BEFORE/AFTER are in log"; echo "TARGETS=$TARGETS"; ) > "$Q/meta/INFO.txt";
say "Disk after:";
df -hT | tee -a "$LOG";
say "Quarantine size:";
du -sh "$Q" 2>/dev/null | tee -a "$LOG" || true;

say "Top quarantined files (by size):";
(find "$Q" -type f -printf "%s\t%p\n" 2>/dev/null | sort -nr | head -n 40 | awk "{printf \"%.1fMB\t%s\n\",\$1/1024/1024,\$2}") | tee -a "$LOG" || true;

say "DONE";
say "Log: $LOG";
say "Quarantine: $Q";
echo "$LOG";'
cat >/root/TRADERONE_SOL_ONLY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/opt/traderone"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP="/root/TRADERONE_BACKUP_SOL_ONLY_$TS"
REPORT="/root/TRADERONE_SOL_ONLY_REPORT_$TS.txt"

echo "=== TRADERONE SOL ONLY MIGRATION ===" | tee "$REPORT"
echo "Target: $ROOT" | tee -a "$REPORT"

[ -d "$ROOT" ] || { echo "ERROR: $ROOT not found"; exit 1; }

mkdir -p "$BACKUP"
cp -a "$ROOT" "$BACKUP/"
echo "[OK] Backup created: $BACKUP" | tee -a "$REPORT"

cd "$ROOT"

echo "=== 1) Neutralisation USDC (code) ===" | tee -a "$REPORT"

# Remplace toute init USDC par 0 et commentaire
grep -RIl "usdc" . | while read -r f; do
  sed -i \
    -e 's/\busdc\b/sol_only_disabled_usdc/g' \
    -e 's/"USDC"/"SOL_ONLY"/g' \
    -e "s/'USDC'/'SOL_ONLY'/g" \
    "$f"
done

echo "[OK] USDC references neutralised" | tee -a "$REPORT"

echo "=== 2) Forçage logique SOL ===" | tee -a "$REPORT"

# Sécurité : toute logique asset devient SOL
grep -RIl "asset" . | while read -r f; do
  sed -i \
    -e 's/asset\s*===\s*"SOL_ONLY"/true/g' \
    -e 's/asset\s*===\s*"SOL"/true/g' \
    "$f"
done

echo "[OK] Asset logic forced to SOL" | tee -a "$REPORT"

echo "=== 3) Suppression simulations USDC ===" | tee -a "$REPORT"
rm -f simulate*usdc* simulate*month* || true
echo "[OK] Simulation files cleaned" | tee -a "$REPORT"

echo "=== 4) Vérification finale ===" | tee -a "$REPORT"
if grep -R "USDC" . >/dev/null 2>&1; then
  echo "[WARN] Residual USDC strings found:" | tee -a "$REPORT"
  grep -R "USDC" . | tee -a "$REPORT"
else
  echo "[OK] No USDC left in codebase" | tee -a "$REPORT"
fi

echo "=== 5) Restart TraderOne ===" | tee -a "$REPORT"

if pm2 list >/dev/null 2>&1; then
  pm2 restart traderone || pm2 restart all
  echo "[OK] PM2 restarted" | tee -a "$REPORT"
else
  pkill -f traderone || true
  echo "[INFO] No PM2 process detected" | tee -a "$REPORT"
fi

echo "=== DONE: TRADERONE IS NOW SOL ONLY ===" | tee -a "$REPORT"
echo "Report: $REPORT"
BASH

chmod +x /root/TRADERONE_SOL_ONLY.sh
/root/TRADERONE_SOL_ONLY.sh
#!/usr/bin/env bash
set -euo pipefail

BASE="/var/www/aiaquila"
HTML="$BASE/index.html"
BACKUP="$BASE/index.backup_$(date +%Y%m%d_%H%M%S).html"

echo "== AIAQUILA RSS PATCH =="

# 1) Vérification
[ -f "$HTML" ] || { echo "ERREUR: index.html introuvable"; exit 1; }

# 2) Backup
cp "$HTML" "$BACKUP"
echo "Backup créé: $BACKUP"

# 3) Suppression anciens scripts RSS cassés
perl -0777 -i -pe '
s/<script[^>]*>[\s\S]*?AIAQUILA[\s\S]*?<\/script>//gi
' "$HTML"

# 4) Injection JS FIX FINAL (parser + voix + sendUser)
perl -0777 -i -pe '
s|</body>|<script>
/* ===== AIAQUILA RSS FIX FINAL ===== */

const FEEDS=[
 "https://www.coindesk.com/arc/outboundfeeds/rss/",
 "https://cointelegraph.com/rss",
 "https://news.bitcoin.com/feed/",
 "https://www.newsbtc.com/feed/"
];
const PROXY="/aiaquila/rss-proxy.php?url=";
let ARTICLES=[];

function log(m){
 const l=document.getElementById("logs");
 if(l){l.textContent+=m+"\\n";l.scrollTop=l.scrollHeight;}
}

function speak(t){
 if(!t)return;
 const u=new SpeechSynthesisUtterance(t);
 u.lang="fr-FR";
 speechSynthesis.cancel();
 speechSynthesis.speak(u);
}

function parseXML(txt){
 const p=new DOMParser().parseFromString(txt,"text/xml");
 let items=[...p.querySelectorAll("item")];
 if(!items.length){
  items=[...p.querySelectorAll("entry")];
 }
 return items.map(it=>({
  title:(it.querySelector("title")||{}).textContent||"",
  desc:(it.querySelector("description")||it.querySelector("summary")||{}).textContent||""
 })).filter(a=>a.title);
}

async function loadRSS(){
 ARTICLES=[];
 log("Chargement RSS...");
 for(const f of FEEDS){
  try{
   const r=await fetch(PROXY+encodeURIComponent(f));
   const t=await r.text();
   const a=parseXML(t);
   log("Flux reçu: "+f+" ("+t.length+" chars)");
   log("Titres extraits: "+a.length);
   ARTICLES.push(...a);
  }catch(e){
   log("ERREUR flux "+f);
  }
 }
 log("TOTAL articles: "+ARTICLES.length);
 if(ARTICLES.length){
  speak("Premier article. "+ARTICLES[0].title);
 }
}

function sendUser(){
 const i=document.querySelector("#chatInput");
 if(i && i.value){
  speak(i.value);
  i.value="";
 }
}

/* auto bind */
document.addEventListener("DOMContentLoaded",()=>{
 const b=document.querySelector("button");
 if(b) b.onclick=loadRSS;
});

</script></body>|si
' "$HTML"

# 5) Permissions
chown www-data:www-data "$HTML"
chmod 644 "$HTML"

echo "PATCH APPLIQUÉ — Recharge la page (Ctrl+F5)"
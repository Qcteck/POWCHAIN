cat >/root/MEGA_AQUILA_STACKING_ROUTE_FIX_V1.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027
TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing: $1"; }

[ "$(id -u)" -eq 0 ] || die "run as root"

# FireInners VPS fixed
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"
WEBROOT="/var/www/aquila_stacking"
HTML="${WEBROOT}/index.html"

# Project (if installed)
APP="/opt/aquila_stacking"
KEYS="${APP}/keys"
PROG="aquila_stacking"

BK="/root/AQUILA_STAKING_ROUTE_FIX_BK_${TS}"
mkdir -p "$BK"
cp -a "$VHOST" "$BK/fireinners.online-ssl.bak" || true
[ -f "$INC" ] && cp -a "$INC" "$BK/aquila_stacking_routes.inc.bak" || true
[ -d "$WEBROOT" ] && cp -a "$WEBROOT" "$BK/webroot_aquila_stacking.bak" || true

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

write_file(){
  local path="$1"
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "deploy aquila_stacking route" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
    rm -f "$tmp"
  else
    chattr -i "$path" 2>/dev/null || true
    cp -a "$path" "$path.bak.$TS" 2>/dev/null || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}

need nginx
need systemctl

say "1) WEBROOT: $WEBROOT"
mkdir -p "$WEBROOT"
chmod 0755 "$WEBROOT"

say "2) Program ID"
PID="UNKNOWN"
if command -v solana-keygen >/dev/null 2>&1 && [ -f "$KEYS/${PROG}-keypair.json" ]; then
  PID="$(solana-keygen pubkey "$KEYS/${PROG}-keypair.json" 2>/dev/null || echo UNKNOWN)"
fi

say "3) index.html"
cat >"$HTML"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><style>body{font-family:system-ui,Segoe UI,Arial;margin:24px;max-width:980px}code{background:#0b1020;color:#d7e3ff;padding:10px;border-radius:10px;display:block;overflow:auto}h1{margin:0 0 12px}small{opacity:.8}</style></head><body><h1>AquilaStacking</h1><p><b>Program ID:</b><code>${PID}</code></p><p><b>Workspace:</b><code>${APP}</code></p><p><b>URL:</b><code>/aquila_stacking/</code></p><p><small>Redirect: /aquilastacking/ → /aquila_stacking/</small></p></body></html>
EOF
chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
chmod -R 0755 "$WEBROOT"

say "4) nginx include: $INC"
write_file "$INC" <<EOF
location = /aquilastacking { return 301 /aquila_stacking/; }
location ^~ /aquilastacking/ { return 301 /aquila_stacking/; }
location ^~ /aquila_stacking/ { alias ${WEBROOT}/; index index.html; try_files \$uri \$uri/ /aquila_stacking/index.html; add_header Cache-Control "no-store" always; }
EOF

say "5) ensure vhost includes $INC"
INC_LINE="include /etc/nginx/includes/aquila_stacking_routes.inc;"
MARKER="# AQUILA_STAKING_INCLUDE"

chattr -i "$VHOST" 2>/dev/null || true

if grep -qF "$INC_LINE" "$VHOST"; then
  say "vhost already includes aquila_stacking"
else
  cp -a "$VHOST" "$BK/fireinners.online-ssl.preappend.$TS" || true
  cat >>"$VHOST"<<EOF

${MARKER}
${INC_LINE}
# END_${MARKER}
EOF
fi

say "6) nginx -t + reload (rollback if fail)"
if ! nginx -t; then
  say "nginx invalid -> rollback"
  cp -a "$BK/fireinners.online-ssl.bak" "$VHOST" || true
  [ -f "$BK/aquila_stacking_routes.inc.bak" ] && cp -a "$BK/aquila_stacking_routes.inc.bak" "$INC" || true
  nginx -t || true
  die "rolled back"
fi

systemctl reload nginx
chattr +i "$VHOST" 2>/dev/null || true

say "DONE: https://fireinners.online/aquila_stacking/"
say "BK: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_ROUTE_FIX_V1.sh
bash /root/MEGA_AQUILA_STACKING_ROUTE_FIX_V1.sh
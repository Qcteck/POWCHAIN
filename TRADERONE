say "write: watch_new_tokens.ts"
cp -a "$WATCH_TS" "$BK/watch_new_tokens.ts.bak" 2>/dev/null || true
cat >"$WATCH_TS" <<'TS'
import fs from "node:fs";
import path from "node:path";
import process from "node:process";
import { PublicKey } from "@solana/web3.js";
import { env, envBool, envInt, log, sleep, withRetry } from "./lib/util.js";
import { classifySolanaError } from "./lib/solana_errors.js";
import { ensureDir, rotateBySize, writeJsonAtomic } from "./lib/rotate.js";
import { NdjsonWriter } from "./lib/ndjson_writer.js";

type TokenProfile = {
  chainId?: string;
  tokenAddress?: string;
  url?: string;
  description?: string;
  [k: string]: any;
};

type SeenDB = Record<string, number>;

function safeReadJson<T>(file: string, fallback: T): T {
  try {
    if (!fs.existsSync(file)) return fallback;
    const raw = fs.readFileSync(file, "utf8").trim();
    if (!raw) return fallback;
    return JSON.parse(raw) as T;
  } catch {
    return fallback;
  }
}

function isValidSolanaAddress(addr: string): boolean {
  try { new PublicKey(addr); return true; } catch { return false; }
}

function pruneSeen(seen: SeenDB, max: number, ttlMs: number) {
  const now = Date.now();
  for (const [k, v] of Object.entries(seen)) {
    if (now - v > ttlMs) delete seen[k];
  }
  const keys = Object.keys(seen);
  if (keys.length <= max) return;
  keys.sort((a, b) => (seen[a] ?? 0) - (seen[b] ?? 0));
  const toRemove = keys.length - max;
  for (let i = 0; i < toRemove; i++) delete seen[keys[i]];
}

async function fetchProfiles(endpoint: string, timeoutMs: number, retries: number): Promise<TokenProfile[]> {
  return withRetry<TokenProfile[]>(
    async () => {
      const ac = new AbortController();
      const t = setTimeout(() => ac.abort(), timeoutMs);
      try {
        const res = await fetch(endpoint, { headers: { accept: "application/json" }, signal: ac.signal });
        if (!res.ok) {
          const text = await res.text().catch(() => "");
          throw new Error(`HTTP ${res.status} ${res.statusText} ${text}`.trim());
        }
        return (await res.json()) as TokenProfile[];
      } finally {
        clearTimeout(t);
      }
    },
    {
      retries,
      onRetry: (_a, _w, e) => {
        const c = classifySolanaError(e);
        log("warn", "watch_fetch_retry_classified", { code: c.code });
      },
    }
  );
}

async function main() {
  const chain = env("WATCH_CHAIN", "solana").toLowerCase();
  const endpoint = env("WATCH_ENDPOINT", "https://api.dexscreener.com/token-profiles/latest/v1");
  const intervalMs = envInt("WATCH_INTERVAL_MS", "15000");
  const timeoutMs = envInt("WATCH_TIMEOUT_MS", "8000");
  const retries = envInt("WATCH_RETRIES", "5");

  const dataDir = env("DATA_DIR", "./data");
  ensureDir(dataDir);

  const seenSnapshot = env("SEEN_SNAPSHOT", path.join(dataDir, "seen.snapshot.json"));
  const eventsLog = env("EVENTS_LOG", path.join(dataDir, "events.ndjson"));

  const ndjsonBufferLines = envInt("NDJSON_BUFFER_LINES", "50");
  const ndjsonFlushMs = envInt("NDJSON_FLUSH_MS", "1000");
  const ndjsonFsync = envBool("NDJSON_FSYNC", "false");
  const ndjsonFsyncEvery = envInt("NDJSON_FSYNC_EVERY", "1");

  const rotateMaxBytes = envInt("ROTATE_MAX_BYTES", String(10 * 1024 * 1024));
  const rotateKeep = envInt("ROTATE_KEEP", "10");
  const compactEverySec = envInt("COMPACT_EVERY_SEC", "300");
  const seenMax = envInt("SEEN_MAX", "50000");
  const seenTtlSec = envInt("SEEN_TTL_SEC", String(14 * 24 * 3600));
  const onlyWithUrl = envBool("ONLY_WITH_URL", "false");

  const metricsEverySec = envInt("METRICS_EVERY_SEC", "60");
  const metricsWindowSec = envInt("METRICS_WINDOW_SEC", "300");

  let seen: SeenDB = safeReadJson<SeenDB>(seenSnapshot, {});
  pruneSeen(seen, seenMax, seenTtlSec * 1000);

  const tokenEvents: number[] = [];
  const errorEvents: number[] = [];

  let lastCompact = 0;
  let lastMetrics = 0;

  const writer = new NdjsonWriter(eventsLog, {
    bufferLines: ndjsonBufferLines,
    flushMs: ndjsonFlushMs,
    fsync: ndjsonFsync,
    fsyncEvery: Math.max(1, ndjsonFsyncEvery),
  });
  writer.start();

  const shutdown = (code: number) => {
    try { writer.close(); } catch {}
    process.exit(code);
  };

  process.on("SIGINT", () => shutdown(130));
  process.on("SIGTERM", () => shutdown(143));
  process.on("beforeExit", () => { try { writer.close(); } catch {} });

  log("info", "watch_start", {
    chain, endpoint, intervalMs, timeoutMs, retries,
    dataDir, seenSnapshot, eventsLog,
    rotateMaxBytes, rotateKeep, compactEverySec,
    seenMax, seenTtlSec, onlyWithUrl,
    metricsEverySec, metricsWindowSec,
    seenLoaded: Object.keys(seen).length,
    ndjson: {
      bufferLines: ndjsonBufferLines,
      flushMs: ndjsonFlushMs,
      fsync: ndjsonFsync,
      fsyncEvery: Math.max(1, ndjsonFsyncEvery),
    },
  });

  while (true) {
    const loopStart = Date.now();

    try {
      writer.flush();
      const rot = rotateBySize(eventsLog, rotateMaxBytes, rotateKeep);
      if (rot) {
        writer.write({
          ts: new Date().toISOString(),
          type: "rotated",
          from: rot.from,
          to: rot.to,
          rotatedAt: rot.ts,
        });
        writer.flush();
        writer.reopen();
      }

      const profiles = await fetchProfiles(endpoint, timeoutMs, retries);

      const filtered = profiles
        .filter((x) => (x.chainId ?? "").toLowerCase() === chain)
        .filter((x) => !!x.tokenAddress)
        .filter((x) => (onlyWithUrl ? !!x.url : true));

      for (const t of filtered) {
        const addr = t.tokenAddress!.trim();
        if (!addr) continue;
        if (chain === "solana" && !isValidSolanaAddress(addr)) continue;
        if (seen[addr]) continue;

        const now = Date.now();
        seen[addr] = now;
        tokenEvents.push(now);

        writer.write({
          ts: new Date(now).toISOString(),
          type: "new_token",
          chain,
          tokenAddress: addr,
          url: t.url ?? null,
          description: t.description ? String(t.description).slice(0, 200) : null,
        });

        log("info", "new_token", { tokenAddress: addr, url: t.url ?? null });
      }
    } catch (e: any) {
      const c = classifySolanaError(e);
      const now = Date.now();
      errorEvents.push(now);

      writer.write({
        ts: new Date(now).toISOString(),
        type: "error",
        code: c.code,
        message: c.message,
      });

      log("error", "watch_error", { code: c.code, err: c.message });
    }

    const now = Date.now();

    if (now - lastMetrics >= metricsEverySec * 1000) {
      lastMetrics = now;

      const winMs = metricsWindowSec * 1000;
      while (tokenEvents.length && now - tokenEvents[0] > winMs) tokenEvents.shift();
      while (errorEvents.length && now - errorEvents[0] > winMs) errorEvents.shift();

      const tokensPerMin = (tokenEvents.length / (metricsWindowSec / 60)).toFixed(2);
      const errorsPerMin = (errorEvents.length / (metricsWindowSec / 60)).toFixed(2);

      const nd = writer.consumeStats(true);

      log("info", "metrics", {
        windowSec: metricsWindowSec,
        tokensPerMin: Number(tokensPerMin),
        errorsPerMin: Number(errorsPerMin),
        seenCount: Object.keys(seen).length,
        ndjson: {
          flushes: nd.flushes,
          fsyncs: nd.fsyncs,
          lines: nd.lines,
          bytes: nd.bytes,
          avgFlushMs: Number(nd.avgFlushMs.toFixed(3)),
          maxFlushMs: Number(nd.maxFlushMs.toFixed(3)),
        },
      });
    }

    if (now - lastCompact >= compactEverySec * 1000) {
      lastCompact = now;

      pruneSeen(seen, seenMax, seenTtlSec * 1000);
      writeJsonAtomic(seenSnapshot, seen);

      writer.write({
        ts: new Date(now).toISOString(),
        type: "compact",
        seenCount: Object.keys(seen).length,
      });

      log("debug", "compacted", { seenCount: Object.keys(seen).length });
    }

    const elapsed = Date.now() - loopStart;
    const wait = Math.max(250, intervalMs - elapsed);
    await sleep(wait);
  }
}

main().catch((e) => {
  log("error", "fatal", { err: String((e as any)?.message ?? e) });
  process.exit(1);
});
TS


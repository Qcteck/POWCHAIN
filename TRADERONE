bash -lc 'set -euo pipefail;TS="$(date -u +%Y%m%d_%H%M%S)";LOG="/root/MEGA_ORION_DEPLOY_${TS}.log";exec > >(tee -a "$LOG") 2>&1;die(){ echo "ERROR: $*" >&2; exit 1; };log(){ printf "[%s] %s\n" "$(date -u +%F\ %T\ UTC)" "$*"; };[[ "$(id -u)" == "0" ]]||die "Run as root";ORION_ROOT="/var/www/orion";INC="/etc/nginx/includes/orion_routes.inc";SITES_EN="/etc/nginx/sites-enabled";SITES_AV="/etc/nginx/sites-available";BK="/root/ORION_BACKUP_${TS}";WORK="/root/.orion_work_${TS}";SRC="/root/orion.zip";log "== MEGA ORION DEPLOY ==";mkdir -p "$BK" "$WORK";command -v chattr >/dev/null 2>&1||true;unlock(){ local f="$1"; [[ -e "$f" ]]||return 0; command -v chattr >/dev/null 2>&1 && chattr -i "$f" 2>/dev/null||true; };lock(){ local f="$1"; [[ -e "$f" ]]||return 0; command -v chattr >/dev/null 2>&1 && chattr +i "$f" 2>/dev/null||true; };log "Backup nginx + orion -> $BK";tar -czf "$BK/nginx.tgz" /etc/nginx 2>/dev/null||true;tar -czf "$BK/orion_www.tgz" "$ORION_ROOT" 2>/dev/null||true;ls -la "$BK"||true;log "Detect active vhosts for fireinners.online on 443";mapfile -t VH < <(grep -RIlE "^[[:space:]]*server_name[[:space:]].*fireinners\.online" "$SITES_EN" "$SITES_AV" 2>/dev/null|sort -u);V443=();for f in "${VH[@]:-}";do if grep -qE "^[[:space:]]*listen[[:space:]]+443" "$f" 2>/dev/null;then V443+=("$f");fi;done;log "Vhost candidates (443): ${#V443[@]}";printf "%s\n" "${V443[@]:-}"|sed "s/^/ - /";if [[ "${#V443[@]}" -eq 0 ]];then die "No vhost found for fireinners.online listen 443";fi;PRIMARY="${V443[0]}";log "PRIMARY vhost: $PRIMARY";log "Disable duplicate vhosts in sites-enabled (if any)";mapfile -t EN443 < <(grep -RIlE "^[[:space:]]*server_name[[:space:]].*fireinners\.online" "$SITES_EN" 2>/dev/null|sort -u);EN443F=();for f in "${EN443[@]:-}";do if grep -qE "^[[:space:]]*listen[[:space:]]+443" "$f" 2>/dev/null;then EN443F+=("$f");fi;done;if [[ "${#EN443F[@]}" -gt 1 ]];then log "Found multiple enabled 443 vhosts for fireinners.online -> disabling extras (keep first in sort order)";p
bash -lc 'cat >/root/MEGA_AQUILA_ROUTES_VERIFY_FIX.sh<<'\''BASH'\''
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILA_ROUTES_VERIFY_FIX_BK_${TS}"
mkdir -p "$BK"
say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"

DOMAIN="fireinners.online"
PATH_A="/aquila_stacking/"
PATH_B="/iaaquila/"
WEBROOT="/var/www/aquila_stacking"
LINKROOT="/var/www/iaaquila"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"

# Candidate vhosts (do not assume)
CANDS=(
  "/etc/nginx/sites-enabled/fireinners.online-ssl"
  "/etc/nginx/sites-available/fireinners.online-ssl"
  "/etc/nginx/conf.d/000-fireinners.online-ssl.conf"
)

backup_one(){ local p="$1"; [ -e "$p" ] || return 0; mkdir -p "$BK/$(dirname "$p")"; cp -a "$p" "$BK/$p.bak" 2>/dev/null || true; }

ensure_inc(){
  say "1) Ensure include exists: $INC"
  mkdir -p "$(dirname "$INC")"
  if [ ! -s "$INC" ]; then
    cat >"$INC"<<EOF
# Aquila Stacking (React static SPA)
location = ${PATH_A%/} { return 301 $PATH_A; }
location ^~ $PATH_A {
  root /var/www;
  try_files \$uri \$uri/ ${PATH_A}index.html;
  add_header Cache-Control "no-store" always;
}
location = ${PATH_B%/} { return 301 $PATH_B; }
location ^~ $PATH_B {
  root /var/www;
  try_files \$uri \$uri/ ${PATH_B}index.html;
  add_header Cache-Control "no-store" always;
}
EOF
  fi
}

show_fs(){
  say "2) Filesystem check"
  ls -la "$WEBROOT" 2>/dev/null || true
  [ -f "$WEBROOT/index.html" ] || say "WARN: missing $WEBROOT/index.html (build/deploy issue)"
  if [ -L "$LINKROOT" ] || [ -d "$LINKROOT" ]; then
    ls -la "$LINKROOT" 2>/dev/null || true
  else
    say "WARN: missing $LINKROOT (symlink expected)"
  fi
}

nginx_dump(){
  say "3) nginx -T dump (saved)"
  nginx -T >"$BK/nginx.T.txt" 2>&1 || true
  grep -n "aquila_stacking_routes" -n "$BK/nginx.T.txt" || true
}

local_curl(){
  say "4) Local curl (Host header) => should be 200/301, NOT 404"
  set +e
  echo "--- $PATH_A ---"
  curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_A" | head -n 20
  echo
  echo "--- $PATH_B ---"
  curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_B" | head -n 20
  echo
  set -e
}

patch_first_real_vhost(){
  say "5) Patch first matching 443 server_name $DOMAIN to include $INC"
  # Prefer real files if they exist
  local patched="0"
  for f in "${CANDS[@]}"; do
    [ -f "$f" ] || continue
    backup_one "$f"
    if grep -qF "$INC" "$f"; then
      say "   already included in: $f"
      patched="1"
      break
    fi
    # Insert include just after server_name line (only inside a server block with 443+domain)
    python3 - "$f" "$DOMAIN" "$INC" <<'PY'
import re,sys,io
p,dom,inc=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(p,'r',encoding='utf-8',errors='ignore').read()
def repl(m):
  b=m.group(0)
  if re.search(r'\blisten\b[^;]*\b443\b',b) and re.search(r'\bserver_name\b[^;]*\b'+re.escape(dom)+r'\b',b):
    if inc in b: return b
    lines=b.splitlines()
    ins=1
    for i,l in enumerate(lines):
      if 'server_name' in l:
        ins=i+1; break
    lines.insert(ins,'    include %s;'%inc)
    return "\n".join(lines)
  return b
new=re.sub(r'server\s*\{[\s\S]*?\n\}',repl,s)
if new!=s:
  open(p,'w',encoding='utf-8').write(new)
  print("patched")
else:
  print("nochange")
PY
    if grep -qF "$INC" "$f"; then
      say "   patched: $f"
      patched="1"
      break
    fi
  done
  [ "$patched" = "1" ] || say "WARN: could not auto-patch a known vhost file (may be another active conf)."
}

reload_and_retest(){
  say "6) nginx -t + reload + retest"
  nginx -t
  systemctl reload nginx
  local_curl
}

main(){
  ensure_inc
  show_fs
  nginx_dump
  local_curl

  # If still 404, attempt patch then reload+retest
  if curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_A" | head -n 1 | grep -q "404"; then
    say "Detected 404 on $PATH_A => applying vhost patch"
    patch_first_real_vhost
    reload_and_retest
  else
    say "OK: not 404 locally. If browser still shows 404, it is cache/host mismatch; open in private window."
  fi

  say "DONE"
  say "BK: $BK"
  say "Open: https://$DOMAIN$PATH_A"
  say "Open: https://$DOMAIN$PATH_B"
}
main
BASH
chmod +x /root/MEGA_AQUILA_ROUTES_VERIFY_FIX.sh
/root/MEGA_AQUILA_ROUTES_VERIFY_FIX.sh'
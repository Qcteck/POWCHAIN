set -euo pipefail
TS="$(date +%s)"

echo "== 1) Voir l'erreur exacte (avec fichier:ligne) =="
nginx -t 2>&1 | tail -n 40 || true

echo
echo "== 2) Trouver tous les fichiers qui contiennent ce location RPC =="
grep -RIn --include='*.conf' -E 'location\s*=\s*/wolverine/traderone/api/rpc' /etc/nginx || true

echo
echo "== 3) Backup + supprimer le bloc location RPC PARTOUT (mauvais contexte) =="
mapfile -t FILES < <(grep -RIl --include='*.conf' -E 'location\s*=\s*/wolverine/traderone/api/rpc' /etc/nginx || true)
for f in "${FILES[@]:-}"; do
  cp -a "$f" "$f.bak.$TS"
  perl -0777 -i -pe 's/location\s*=\s*\/wolverine\/traderone\/api\/rpc\s*\{[\s\S]*?\}\s*//g' "$f"
  echo "Cleaned: $f (backup: $f.bak.$TS)"
done

echo
echo "== 4) Re-test nginx (DOIT PASSER) =="
nginx -t

echo
echo "== 5) Reload nginx =="
systemctl reload nginx

echo "OK ✅ nginx est clean"
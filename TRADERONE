set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

# IMPORTANT: ajuste si ton vhost keeper a un autre nom
KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "=== 0) Check KEEP ==="
[ -n "$KEEP" ] || { echo "❌ KEEP vide"; exit 1; }
[ -e "$KEEP" ] || { echo "❌ KEEP introuvable: $KEEP"; ls -la /etc/nginx/sites-enabled/ | sed -n '1,200p'; exit 1; }
cp -a "$KEEP" "$KEEP.bak.$TS" || true

echo "=== 1) Trouver tous les fichiers conf (server_name fireinners + listen 443) ==="
mapfile -t FILES < <(
  nginx -T 2>/dev/null | awk '
    /^# configuration file /{
      f=$4; gsub(/:.*/,"",f);  # enlève ":123"
    }
    /server_name[[:space:]]+.*(fireinners\.online|www\.fireinners\.online)/{
      if (f!="") print f
    }
  ' | sort -u | while read -r f; do
    [ -f "$f" ] || continue
    grep -qE 'listen[[:space:]]+443' "$f" && echo "$f"
  done
)

echo "Candidates 443:"
printf ' - %s\n' "${FILES[@]:-<none>}"

echo "=== 2) Désactiver TOUT conflit sauf KEEP (via symlinks sites-enabled) ==="
for f in "${FILES[@]:-}"; do
  [ "$f" = "$KEEP" ] && continue

  # Désactive le(s) symlink(s) dans sites-enabled qui pointent vers ce fichier
  while IFS= read -r link; do
    [ -L "$link" ] || continue
    cp -a "$link" "$link.bak.$TS" || true
    mv "$link" "$link.disabled.$TS"
    echo "Disabled: $link -> $(readlink -f "$link.disabled.$TS" 2>/dev/null || true)"
  done < <(find /etc/nginx/sites-enabled -maxdepth 1 -type l -print | while read -r l; do
            tgt="$(readlink -f "$l" 2>/dev/null || true)"
            [ "$tgt" = "$(readlink -f "$f" 2>/dev/null || echo "$f")" ] && echo "$l"
          done)
done

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 4) Conflicts restants (doit être vide) ==="
nginx -T 2>/dev/null | grep -i "conflicting server name" | head -n 40 || echo "✅ no more conflicts"

echo "=== 5) Retest origin bypass (doit être 200) ==="
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | head -n 25

echo "DONE ✅"
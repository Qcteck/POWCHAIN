bash <<'EOF'
set -e

WEB="/var/www/aiaquila"
HTML="$WEB/index.html"

echo "== AIAQUILA TTS FIX (NO BACKEND) =="

mkdir -p "$WEB"

cat > "$HTML" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>
body{margin:0;background:#05070a;color:#e6e6e6;font-family:system-ui}
header{padding:14px 20px;background:#0b0f1a;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{max-width:1100px;margin:auto;padding:20px}
.panel{background:#0e1424;border:1px solid #1f2937;border-radius:8px;padding:14px;margin-bottom:14px}
button{background:#1e40af;color:#fff;border:none;padding:8px 14px;border-radius:6px;cursor:pointer}
pre{background:#000;padding:10px;border-radius:6px;max-height:200px;overflow:auto}
.small{font-size:13px;color:#9cc9ff}
</style>
</head>

<body>
<header>
  <strong>AIAQUILA</strong>
  <span id="score">Score: 49.7</span>
</header>

<main>

<div class="panel">
  <h2>Journaliste IA (voix)</h2>
  <div id="speech" class="small">
    Le message paraît presque normalisé, comme intégré d’avance.
  </div><br>
  <button onclick="speak()">▶ Lire</button>
  <button onclick="stopSpeak()">⏹ Stop</button>
</div>

<div class="panel">
  <h2>Timeline</h2>
  <pre id="timeline"></pre>
</div>

<div class="panel">
  <h2>Score décisionnel</h2>
  <div id="decision">Analyse stable – aucun conflit détecté.</div>
</div>

<div class="panel">
  <h2>Logs</h2>
  <pre id="logs"></pre>
</div>

</main>

<script>
/* ====== AIAQUILA CORE 1-2-3 ====== */

// 1. Mémoire locale
const STATE = JSON.parse(localStorage.getItem("aiaquila_state") || '{"logs":[],"timeline":[]}');

// 2. Raisonnement / score
function log(msg){
  const t = new Date().toISOString().substr(11,8);
  STATE.logs.push(`[${t}] ${msg}`);
  STATE.logs = STATE.logs.slice(-50);
  localStorage.setItem("aiaquila_state", JSON.stringify(STATE));
  render();
}

// 3. TTS sécurisé navigateur
function speak(){
  speechSynthesis.cancel();
  const text = document.getElementById("speech").innerText;
  const u = new SpeechSynthesisUtterance(text);
  u.lang = "fr-FR";
  const v = speechSynthesis.getVoices().find(x=>x.lang.startsWith("fr"));
  if(v) u.voice = v;
  speechSynthesis.speak(u);
  log("Lecture vocale déclenchée");
}

function stopSpeak(){
  speechSynthesis.cancel();
  log("Lecture vocale arrêtée");
}

function render(){
  document.getElementById("logs").innerText = STATE.logs.join("\n");
  document.getElementById("timeline").innerText = STATE.timeline.join("\n");
}

log("AIAQUILA initialisée");
render();
</script>

</body>
</html>
HTML

chown -R www-data:www-data "$WEB"
chmod 644 "$HTML"

nginx -t && systemctl reload nginx

echo "== AIAQUILA TTS OK =="
echo "URL : https://fireinners.online/aiaquila/"
echo "ACTION : cliquer sur ▶ Lire (obligatoire navigateur)"
EOF
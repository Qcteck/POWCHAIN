cat > /root/FIREINNERS_WALLET_TAB_MEGA.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== FIREINNERS WALLET TAB :: MEGA PATCH ==="
DIST="/opt/fireinners/frontend-react/app/dist"
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/backup_fireinners_wallettab_$TS"
ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"

echo "[0] Checks"
[ -d "$DIST" ] || { echo "ERR dist not found: $DIST"; exit 1; }
[ -f "$DIST/index.html" ] || { echo "ERR dist/index.html missing"; exit 1; }

mkdir -p "$BK"
cp -a "$DIST/index.html" "$BK/index.html.bak"
echo "Backup: $BK/index.html.bak"

echo "[1] Source askorupdate (optional)"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  source "$ASKLIB" || true
  echo "askorupdate loaded"
else
  echo "askorupdate not found (fallback to direct write)"
fi

echo "[2] Build wallet page"
mkdir -p "$DIST/wallet"
TMPW="$(mktemp)"
cat > "$TMPW" <<HTML
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>FireInners Wallet</title><style>:root{--bg:#05060b;--p:#0a0f1e;--l:rgba(255,255,255,.14);--t:#e7f0ff;--m:#9fb3d7;--a:#9ff}*{box-sizing:border-box}html,body{margin:0;height:100%;background:radial-gradient(900px 520px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(700px 450px at 80% 20%,#101a33 0%,transparent 55%),var(--bg);color:var(--t);font:14px system-ui}a{color:var(--a);text-decoration:none}#top{position:sticky;top:0;z-index:9;background:linear-gradient(180deg,rgba(5,6,11,.92),rgba(5,6,11,.65));backdrop-filter:blur(10px);border-bottom:1px solid var(--l)}#wrap{max-width:980px;margin:0 auto;padding:14px}h1{font-size:14px;margin:0;letter-spacing:.12em;text-transform:uppercase;color:#cfe1ff}#grid{display:grid;grid-template-columns:1.2fr .8fr;gap:12px;margin-top:12px}#card{background:linear-gradient(180deg,rgba(10,15,30,.65),rgba(7,10,20,.55));border:1px solid var(--l);border-radius:16px;padding:14px}#row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}button{cursor:pointer;border:1px solid var(--l);background:rgba(0,0,0,.25);color:var(--t);padding:10px 12px;border-radius:12px;font:600 12px system-ui}button:hover{border-color:rgba(255,255,255,.25)}.muted{color:var(--m)}.k{display:block;font-size:11px;color:var(--m);margin-top:10px}.v{font:600 13px ui-monospace,Menlo,Consolas,monospace;word-break:break-all}#log{margin-top:10px;white-space:pre-wrap;font:12px ui-monospace,Menlo,Consolas,monospace;color:#cfe1ff;opacity:.9}#mini{display:flex;justify-content:space-between;gap:10px;align-items:center}#pill{padding:6px 10px;border:1px solid var(--l);border-radius:999px;background:rgba(0,0,0,.18);font:600 12px system-ui}#foot{margin-top:12px;color:var(--m);font-size:12px}</style></head><body><div id="top"><div id="wrap"><div id="mini"><h1>FireInners • Wallet</h1><div id="pill"><a href="/">Retour</a></div></div></div></div><div id="wrap"><div id="grid"><div id="card"><div id="row"><button id="btnConnect">Connect Phantom</button><button id="btnDisc" disabled>Disconnect</button><button id="btnRefresh" disabled>Refresh</button></div><span class="k">Adresse</span><div class="v" id="addr">-</div><span class="k">SOL</span><div class="v" id="sol">-</div><span class="k">USDC</span><div class="v" id="usdc">-</div><div id="log"></div><div id="foot">RPC: <span class="muted" id="rpc"></span></div></div><div id="card"><div class="muted">Ce module affiche SOL/USDC via Phantom + Solana RPC. Aucun secret, aucune seed, aucun export.</div><div style="height:10px"></div><div class="muted">Si Phantom n’est pas détecté, installe Phantom sur le navigateur/app, puis recharge.</div></div></div></div><script src="https://cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js"></script><script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script><script>(()=>{const RPC="${RPC}",USDC="${USDC}";const $=s=>document.querySelector(s);const log=m=>{$("#log").textContent=(String(m||"")+"\\n"+$("#log").textContent).slice(0,4000)};$("#rpc").textContent=RPC;let pub=null,conn=null;const fmt=n=>{try{return (+n).toLocaleString(undefined,{maximumFractionDigits:6})}catch{return String(n)}};async function refresh(){if(!pub)return;try{conn=conn||new solanaWeb3.Connection(RPC,"confirmed");const lam=await conn.getBalance(pub,"confirmed");$("#sol").textContent=fmt(lam/1e9);const usdcMint=new solanaWeb3.PublicKey(USDC);const tok=await conn.getParsedTokenAccountsByOwner(pub,{mint:usdcMint});let sum=0;for(const a of (tok.value||[])){const amt=a.account?.data?.parsed?.info?.tokenAmount?.uiAmount||0;sum+=Number(amt)||0}$("#usdc").textContent=fmt(sum);log("REFRESH OK");}catch(e){log("ERR "+(e&&e.message?e.message:e))}}async function connect(){try{const ph=window.solana; if(!ph||!ph.isPhantom){log("Phantom not detected");return;} const r=await ph.connect({onlyIfTrusted:false}); pub=r.publicKey; $("#addr").textContent=pub.toBase58(); $("#btnDisc").disabled=false; $("#btnRefresh").disabled=false; log("CONNECTED"); await refresh();}catch(e){log("ERR "+(e&&e.message?e.message:e))}}async function disconnect(){try{const ph=window.solana; if(ph&&ph.disconnect) await ph.disconnect();}catch{} pub=null; $("#addr").textContent="-"; $("#sol").textContent="-"; $("#usdc").textContent="-"; $("#btnDisc").disabled=true; $("#btnRefresh").disabled=true; log("DISCONNECTED")}$("#btnConnect").onclick=connect;$("#btnDisc").onclick=disconnect;$("#btnRefresh").onclick=refresh;setInterval(()=>{if(pub)refresh().catch(()=>{})},30000);})();</script></body></html>
HTML

echo "[3] Write wallet page (safe update)"
DESTW="$DIST/wallet/index.html"
if type askorupdate_file >/dev/null 2>&1; then
  askorupdate_file "$DESTW" "$TMPW" || { echo "askorupdate_file failed, fallback"; cp -f "$TMPW" "$DESTW"; }
else
  cp -f "$TMPW" "$DESTW"
fi
rm -f "$TMPW"

echo "[4] Inject floating WALLET tab into dist/index.html (idempotent)"
if grep -q "FIREINNERS_WALLET_TAB_v1" "$DIST/index.html"; then
  echo "Already injected, skip."
else
  TMPX="$(mktemp)"
  cp -a "$DIST/index.html" "$TMPX"
  # inject before </body> if present, else append
  INJ="<script>(function(){try{if(document.getElementById('fiWalletTab'))return;var a=document.createElement('a');a.id='fiWalletTab';a.href='/wallet/';a.textContent='WALLET';a.setAttribute('data-fi','FIREINNERS_WALLET_TAB_v1');a.style='position:fixed;top:12px;right:12px;z-index:999999;padding:10px 12px;border:1px solid rgba(255,255,255,.22);border-radius:12px;background:rgba(0,0,0,.28);backdrop-filter:blur(10px);color:#e7f0ff;font:700 12px system-ui;letter-spacing:.12em;text-decoration:none';document.addEventListener('DOMContentLoaded',function(){document.body&&document.body.appendChild(a)});if(document.body)document.body.appendChild(a);}catch(e){}})();</script>"
  if grep -qi "</body>" "$TMPX"; then
    perl -0777 -pe "s#</body>#$INJ</body>#i" -i "$TMPX"
  else
    printf "\n%s\n" "$INJ" >> "$TMPX"
  fi
  if type askorupdate_file >/dev/null 2>&1; then
    askorupdate_file "$DIST/index.html" "$TMPX" || { echo "askorupdate_file failed, fallback"; cp -f "$TMPX" "$DIST/index.html"; }
  else
    cp -f "$TMPX" "$DIST/index.html"
  fi
  rm -f "$TMPX"
fi

echo "[5] Nginx test + reload"
nginx -t
systemctl reload nginx

echo "DONE."
echo "Test: https://fireinners.online/wallet/"
SH
chmod +x /root/FIREINNERS_WALLET_TAB_MEGA.sh
bash /root/FIREINNERS_WALLET_TAB_MEGA.sh
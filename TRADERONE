bash <<'BASH'
set -euo pipefail
echo "=== WOLVERINE SOL-ONLY MEGA BATCH ==="

### 1) COUPURE TOTALE USDC + API BALANCES
echo "[1/5] Suppression API balances / USDC"
pkill -f wolverine-balances || true
pkill -f server.js || true
rm -rf /opt/wolverine-balances || true
ss -lntp | grep 3010 && echo "ERREUR: port 3010 encore actif" || echo "OK: port 3010 absent"

### 2) PATCH FRONTEND — SOL UNIQUEMENT
HTML="/var/www/wolverine/index.html"
echo "[2/5] Patch frontend SOL uniquement"
test -f "$HTML" || { echo "ERREUR: $HTML introuvable"; exit 1; }
cp -a "$HTML" "$HTML.bak_$(date +%s)"

# Nettoyage USDC + balances
sed -i \
-e '/USDC/d' \
-e '/usdc/d' \
-e '/SOL\/USDC/d' \
-e '/balances/d' \
-e '/3010/d' \
"$HTML"

# Injection logique Phantom SOL ONLY
grep -q "SOL_ONLY_PATCH" "$HTML" || sed -i '/<\/body>/i \
<!-- SOL_ONLY_PATCH -->\
<script src="https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js"></script>\
<script>\
async function connectPhantom(){\
 if(!window.solana||!window.solana.isPhantom){alert(\"Phantom manquant\");return;}\
 const r=await window.solana.connect();\
 const pub=r.publicKey.toString();\
 const c=new solanaWeb3.Connection(solanaWeb3.clusterApiUrl(\"mainnet-beta\"));\
 const bal=await c.getBalance(new solanaWeb3.PublicKey(pub));\
 const sol=(bal/1e9).toFixed(4);\
 const el=document.getElementById(\"sol\");\
 if(el) el.textContent=sol;\
}\
</script>' "$HTML"

### 3) VÉRIFICATION STRUCTURE UI
echo "[3/5] Vérification UI"
grep -q "Connect Phantom" "$HTML" || echo "ATTENTION: bouton Phantom absent"
grep -q "SOL:" "$HTML" || echo "ATTENTION: affichage SOL absent"

### 4) NGINX RELOAD
echo "[4/5] Reload nginx"
nginx -t
systemctl reload nginx

### 5) TEST FINAL
echo "[5/5] Test final"
echo "Interface: https://fireinners.online/wolverine/"
echo "Action: CTRL+SHIFT+R puis Connect Phantom"

echo "=== FIN — WOLVERINE SOL ONLY OPERATIONNEL ==="
BASH
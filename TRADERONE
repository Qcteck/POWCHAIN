naWeb3.Connection(RPC,"confirmed");const pk=provider.publicKey;const lam=await conn.getBalance(pk,"confirmed");solEl.value=(lam/1e9).toFixed(6);let usdc=0;try{const res=await conn.getParsedTokenAccountsByOwner(pk,{mint:new solanaWeb3.PublicKey(USDC_MINT)},"confirmed");for(const a of (res&&res.value)||[]){const info=a.account.data.parsed.info;const amt=info.tokenAmount.uiAmount||0;usdc+=amt}}catch(e){log("USDC read err: "+(e&&e.message||e))}usdcEl.value=usdc.toFixed(6);log("refresh ok")}catch(e){log("refresh err: "+(e&&e.message||e))}}document.getElementById("btnConnect").onclick=connect;document.getElementById("btnDisc").onclick=disconnect;document.getElementById("btnRefresh").onclick=refresh;window.addEventListener("focus",()=>setTimeout(()=>{if(getProvider()&&getProvider().publicKey)refresh()},250));})();</script></html>
HTML
  chmod 0644 "$WEBROOT/index.html"
}

dedupe_other_locations(){
  say "Dedupe other /aquilastacking locations (keep only $INC)"
  local T; T="$(mktemp)"
  nginx -T >"$T" 2>/dev/null || true
  python3 - "$T" "$INC" "$BK" <<'PY'
import sys,re,os,shutil
t,keep,bk=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(t,'r',encoding='utf-8',errors='ignore').read().splitlines()
# nginx -T includes markers: "# configuration file /path:"
cur=None
occ=[]
for i,ln in enumerate(s):
    m=re.match(r"#\s*configuration file\s+(\S+):",ln)
    if m: cur=m.group(1)
    if cur and "location" in ln and "aquilastacking" in ln:
        occ.append((cur,i,ln))
# keep occurrences in keep file only
targets=[o for o in occ if os.path.realpath(o[0])!=os.path.realpath(keep)]
# group by file
by={}
for f,i,ln in targets:
    by.setdefault(f,[]).append((i,ln))
def remove_block(txt, start_idx):
    # remove from line containing 'location' until matching brace close
    lines=txt.splitlines(True)
    # find start line by scanning for the exact location line substring 'aquilastacking'
    # we will remove the first block that matches '/aquilastacking'
    for si,l in enumerate(lines):
        if "location" in l and "aquilastacking" in l:
            start=si; break
    else:
        return txt, False
    # brace match (count { and } from start)
    depth=0
    end=start
    for j in range(start,len(lines)):
        depth += lines[j].count("{")
        depth -= lines[j].count("}")
        end=j
        if depth<=0 and j>start and "}" in lines[j]:
            break
    # delete block lines
    new = "".join(lines[:start] + lines[end+1:])
    return new, True

for f in sorted(by.keys()):
    if not f.startswith("/etc/nginx/"): 
        continue
    if not os.path.exists(f): 
        continue
    if os.path.realpath(f)==os.path.realpath(keep):
        continue
    # backup
    dest=os.path.join(bk, f.lstrip("/")) + ".dedupe.bak"
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    try:
        shutil.copy2(f, dest)
    except Exception:
        pass
    txt=open(f,'r',encoding='utf-8',errors='ignore').read()
    changed=False
    # remove all blocks that reference aquilastacking
    while True:
        txt2, ok = remove_block(txt, 0)
        if not ok: break
        txt=txt2; changed=True
    if changed:
        open(f,'w',encoding='utf-8').write(txt)
PY
}

main(){
  say "BEGIN AQUILA STACKING ONLY @ $TS"
  ensure_pkgs

  # Unfreeze targets
  for f in "$INC" "$VHOST_A" "$VHOST_E" /etc/nginx/nginx.conf; do unfreeze_one "$f"; done

  # Write include + ensure vhost includes it once
  write_inc_clean
  patch_vhost_include_once

  # Try to remove other duplicate location blocks
  dedupe_other_locations

  # Deploy webroot
  deploy_webroot

  # Test + reload
  say "nginx -t"
  if nginx -t; then
    say "reload nginx"
    systemctl reload nginx || nginx -s reload || true
  else
    say "nginx -t FAILED. Showing aquilastacking occurrences:"
    nginx -T 2>/dev/null | grep -n "aquilastacking" | head -n 200 || true
    exit 1
  fi

  # Refreeze vhost/include (best-effort)
  for f in "$INC" "$VHOST_A" /etc/nginx/nginx.conf; do refreeze_one "$f"; done

  say "OK: https://${DOMAIN}${PATH_APP}/"
}
main "$@"
SH
chmod +x /root/MEGA_AQUILA_STACKING_ONLY.sh
bash /root/MEGA_AQUILA_STACKING_ONLY.sh
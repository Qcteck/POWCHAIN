bash -lc 'cat >/root/WOLVERINE_FIX_API_PROXY.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="$(hostname -f 2>/dev/null || hostname)"
LOG="/root/WOLVERINE_FIX_API_PROXY_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

need(){ command -v "$1" >/dev/null 2>&1 || { echo "Missing: $1"; exit 1; }; }

echo "=== WOLVERINE_FIX_API_PROXY :: $TS :: $HOST ==="
echo "Log: $LOG"
echo

if [ "${EUID:-$(id -u)}" -ne 0 ]; then echo "ERROR: run as root"; exit 1; fi

need nginx
need systemctl
need curl
need python3
need grep
need sed
need awk
need cp
need mkdir
need chmod
command -v chattr >/dev/null 2>&1 || true
command -v pm2 >/dev/null 2>&1 || true

ROOT="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
API_PORT="3000"

backup_file(){ [ -f "$1" ] && cp -a "$1" "$1.bak_${TS}" && echo "Backup: $1 -> $1.bak_${TS}" || true; }
unfreeze(){ [ -e "$1" ] && chattr -i "$1" 2>/dev/null || true; }
refreeze(){ [ -e "$1" ] && chattr +i "$1" 2>/dev/null || true; }

echo "Paths:"
echo "  ROOT=$ROOT"
echo "  VHOST=$VHOST"
echo "  INC=$INC"
echo "  API_PORT=$API_PORT"
echo

echo "== 1) Sanity: backend direct (127.0.0.1:${API_PORT}) =="
echo "-- GET http://127.0.0.1:${API_PORT}/health (direct)"
curl -sS -i "http://127.0.0.1:${API_PORT}/health" | head -n 40 || true
echo

echo "== 2) Rewrite nginx include (safe under set -u) =="
mkdir -p "$(dirname "$INC")"
backup_file "$INC"
unfreeze "$INC"

# NOTE: on met des placeholders puis on remplace (aucune expansion bash risquée)
cat >"$INC" <<'EOF'
# AUTOGENERATED :: WOLVERINE API PROXY ROUTES
# DO NOT EDIT MANUALLY

location = /wolverine { return 301 /wolverine/; }

location = /wolverine/__wolverine_ok.txt {
  alias __ROOT__/__wolverine_ok.txt;
  add_header Cache-Control "no-store" always;
}

location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

location ^~ /wolverine/_next/ {
  alias __ROOT__/_next/;
  try_files $uri $uri/ =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

location ^~ /wolverine/vendor/ {
  alias __ROOT__/vendor/;
  try_files $uri =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# IMPORTANT: API must win over /wolverine/
location ^~ /wolverine/traderone/api/ {
  rewrite ^/wolverine/traderone/api/?(.*)$ /$1 break;
  proxy_pass http://127.0.0.1:__API_PORT__/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 60s;
}

location ^~ /wolverine/ {
  alias __ROOT__/;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
EOF

# Replace placeholders safely
sed -i "s|__ROOT__|$ROOT|g" "$INC"
sed -i "s|__API_PORT__|$API_PORT|g" "$INC"
chmod 644 "$INC" || true
echo "Wrote: $INC"
echo

echo "== 3) Ensure include is inside the correct SSL server{} (fireinners.online :443) =="
if [ ! -f "$VHOST" ]; then echo "ERROR: missing vhost $VHOST"; exit 1; fi
backup_file "$VHOST"
unfreeze "$VHOST"

python3 - <<PY
from pathlib import Path
p=Path("$VHOST")
s=p.read_text(errors="ignore").splitlines()

target_inc=f"include $INC;"
# Parse server blocks by brace depth, detect ssl 443 server that serves fireinners.online
out=[]
i=0
n=len(s)
while i<n:
    line=s[i]
    if "server" in line and "{" in line:
        # enter server block
        start=i
        depth=0
        block=[]
        # consume until matching close
        while i<n:
            ln=s[i]
            block.append(ln)
            depth += ln.count("{")
            depth -= ln.count("}")
            i+=1
            if depth==0:
                break
        # analyze this server block
        txt="\n".join(block)
        is_443 = ("listen" in txt and "443" in txt and "ssl" in txt)
        has_name = ("server_name" in txt and "fireinners.online" in txt)
        if is_443 and has_name:
            if target_inc not in txt:
                # insert include before last closing brace of this block
                # find last line that is only "}" or contains "}"
                for j in range(len(block)-1, -1, -1):
                    if "}" in block[j]:
                        block.insert(j, "    " + target_inc)
                        break
        out.extend(block)
    else:
        out.append(line)
        i+=1

Path("$VHOST").write_text("\n".join(out) + "\n")
print("Patched vhost: ensured include inside SSL 443 server for fireinners.online")
PY
echo

echo "== 4) Nginx effective config verification =="
echo "-- nginx -T | grep wolverine/traderone/api (must appear)"
nginx -T 2>/dev/null | grep -n "/wolverine/traderone/api/" || true
echo

echo "== 5) nginx -t + reload =="
nginx -t
systemctl reload nginx || systemctl restart nginx
echo "OK: nginx reloaded"
echo

echo "== 6) Local proxy tests (must NOT return HTML) =="
echo "-- GET http://127.0.0.1/wolverine/traderone/api/health"
curl -sS -i "http://127.0.0.1/wolverine/traderone/api/health" | head -n 60 || true
echo

echo "-- POST http://127.0.0.1/wolverine/traderone/api/vault/create"
curl -sS -i -X POST "http://127.0.0.1/wolverine/traderone/api/vault/create" \
  -H "Content-Type: application/json" \
  -d "{\"pub\":\"\"}" | head -n 80 || true
echo

echo "== 7) External (Cloudflare) spot-check =="
echo "-- https://fireinners.online/wolverine/traderone/api/health"
curl -k -sS -i "https://fireinners.online/wolverine/traderone/api/health" | head -n 40 || true
echo

echo "-- https://fireinners.online/wolverine/traderone/api/vault/create (POST)"
curl -k -sS -i -X POST "https://fireinners.online/wolverine/traderone/api/vault/create" \
  -H "Content-Type: application/json" \
  -d "{\"pub\":\"\"}" | head -n 60 || true
echo

echo "== 8) Re-freeze (best-effort) =="
refreeze "$VHOST"
refreeze "$INC"
echo "Done."
echo
echo "If /health still returns HTML, it means the include is still not in the serving server{} OR another server{} is serving the request."
echo "Next step then: print the exact serving server block from nginx -T (we can extract it automatically)."
BASH
chmod +x /root/WOLVERINE_FIX_API_PROXY.sh
/root/WOLVERINE_FIX_API_PROXY.sh'
cat >/root/fix_duplicate_include_solana_rpc_proxy.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Find all includes of solana_rpc_proxy.conf (active files) =="
mapfile -t INCS < <(
  grep -RIn --binary-files=without-match \
    -E "include\s+.*solana_rpc_proxy\.conf" \
    /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/nginx.conf 2>/dev/null \
  | grep -vE '\.bak_|\.bak$' || true
)

if [ "${#INCS[@]}" -eq 0 ]; then
  echo "No include found for solana_rpc_proxy.conf in common dirs."
  echo "Try: grep -RIn 'solana_rpc_proxy.conf' /etc/nginx"
  exit 1
fi

printf "%s\n" "${INCS[@]}"
echo

echo "== 2) Keep FIRST include, comment out the rest =="
KEEP="${INCS[0]}"
echo "KEEP => $KEEP"
echo

# group by file, comment only the matching include lines
declare -A touched=()
for i in "${INCS[@]:1}"; do
  FILE="${i%%:*}"
  [ -f "$FILE" ] || continue

  if [ -z "${touched[$FILE]+x}" ]; then
    cp -a "$FILE" "$FILE.bak_$TS"
    touched["$FILE"]=1
  fi

  # Comment any include line that references solana_rpc_proxy.conf
  sed -i -E 's@^([[:space:]]*)include([[:space:]]+.*solana_rpc_proxy\.conf.*);@\1# DISABLED_DUPLICATE include\2;@' "$FILE"
done

echo "== 3) nginx config test =="
nginx -t

echo "== 4) reload nginx =="
systemctl reload nginx || service nginx reload

echo
echo "DONE ✅ duplicate include removed"
BASH

chmod +x /root/fix_duplicate_include_solana_rpc_proxy.sh
/root/fix_duplicate_include_solana_rpc_proxy.sh
cat >/root/TRADERONE_ENABLE_BUDGET_TRANSFER_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/traderone-vault"
SERVER="$APP_DIR/server.js"
TREASURY_JSON="$APP_DIR/treasury.json"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== [1/7] Vérifications ==="
[ -f "$SERVER" ] || { echo "server.js introuvable"; exit 1; }
[ -f "$TREASURY_JSON" ] || { echo "treasury.json manquant"; exit 1; }

echo "=== [2/7] Backup ==="
cp -a "$SERVER" "${SERVER}.bak_${TS}"

echo "=== [3/7] Injection API budget (JS brut) ==="

python3 <<'PY'
from pathlib import Path
import re

p = Path("/opt/traderone-vault/server.js")
s = p.read_text()

marker = "/* === TRADERONE BUDGET ROUTE === */"
if marker in s:
    print("Route déjà présente → SKIP")
    exit(0)

inject = """
/* === TRADERONE BUDGET ROUTE === */
const { Connection, PublicKey, SystemProgram, Transaction, sendAndConfirmTransaction, Keypair } = require("@solana/web3.js");
const fs = require("fs");

const RPC = process.env.SOLANA_RPC || "https://api.mainnet-beta.solana.com";
const connection = new Connection(RPC, "confirmed");

const TREASURY = Keypair.fromSecretKey(
  Uint8Array.from(JSON.parse(fs.readFileSync("/opt/traderone-vault/treasury.json", "utf8")))
);

app.post("/wolverine/traderone/api/budget", async (req, res) => {
  try {
    const { pubkey, budgetSol } = req.body;
    if (!pubkey || !budgetSol) throw "payload invalide";

    const from = new PublicKey(pubkey);
    const lamports = Math.floor(Number(budgetSol) * 1e9);
    if (lamports <= 0) throw "montant invalide";

    const tx = new Transaction().add(
      SystemProgram.transfer({
        fromPubkey: from,
        toPubkey: TREASURY.publicKey,
        lamports
      })
    );

    const sig = await sendAndConfirmTransaction(connection, tx, [TREASURY]);
    res.json({ ok: true, signature: sig, lamports });
  } catch (e) {
    res.status(400).json({ ok: false, error: String(e) });
  }
});
"""

# injecte avant la fin du fichier
s = re.sub(r"$", inject, s)
p.write_text(s)
print("Injection OK")
PY

echo "=== [4/7] Redémarrage PM2 ==="
pm2 restart traderone-vault || pm2 restart traderone || true
sleep 2

echo "=== [5/7] Test local ==="
curl -s http://127.0.0.1:3000/wolverine/traderone/api/health || true
echo

echo "=== [6/7] Test HTTPS ==="
curl -s https://fireinners.online/wolverine/traderone/api/health || true
echo

echo "=== [7/7] FIN OK ==="
echo "API budget ACTIVE — transfert SOL réel vers TraderOne"
BASH

chmod +x /root/TRADERONE_ENABLE_BUDGET_TRANSFER_FIX.sh
/root/TRADERONE_ENABLE_BUDGET_TRANSFER_FIX.sh
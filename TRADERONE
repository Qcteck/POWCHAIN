set -e
cd /root

echo "=== 1) Stopper le traderone PM2 (doublon) ==="
pm2 delete traderone 2>/dev/null || true
pm2 save --force 2>/dev/null || true

echo
echo "=== 2) Restart wolverine-api (le vrai) ==="
systemctl restart wolverine-api.service
sleep 1
systemctl --no-pager -l status wolverine-api.service | tail -n 30 || true

echo
echo "=== 3) Vérifier ports 3000/3002 ==="
ss -lptn | egrep ':3000|:3002' || true

echo
echo "=== 4) NGINX: proxy_pass -> 3002 (dans les 2 vhosts) ==="
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  cp -v "$f" "/root/nginx_backups/$(basename "$f").$(date +%Y%m%d_%H%M%S)"
  sed -i 's/127\.0\.0\.1:3000/127.0.0.1:3002/g' "$f"
done

nginx -t
systemctl reload nginx

echo
echo "=== 5) Test direct backend (3002) ==="
curl -sS -i -X POST http://127.0.0.1:3002/api/status -H "content-type: application/json" --data '{}' | head -n 40

echo
echo "=== 6) Test public (avec ta X-API-KEY) ==="
echo 'curl -sS -i -X POST https://fireinners.online/wolverine/traderone/api/status -H "content-type: application/json" -H "X-API-KEY: TA_CLE" --data "{}" | head -n 40'
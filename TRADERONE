});

router.post("/loop/start",(req,res)=>{ if(!armOK(req.body&&req.body.arm)) return res.status(403).json({ok:false,error:"bad_arm"}); startPingLoop(); res.json({ok:true,loop:true}); });
router.post("/loop/stop",(req,res)=>{ if(!armOK(req.body&&req.body.arm)) return res.status(403).json({ok:false,error:"bad_arm"}); stopPingLoop(); res.json({ok:true,loop:false}); });

router.post("/start",(req,res)=>{
  const b=req.body||{};
  if(!armOK(b.arm)) return res.status(403).json({ok:false,error:"bad_arm"});
  state.bot.userPub=String(b.userPub||"");
  state.bot.withdrawTo=String(b.withdrawTo||"");
  state.bot.mode=String(b.mode||"dca_sol");
  state.bot.mint=String(b.mint||"");
  state.bot.budgetTotal=Math.max(0,Number(b.budgetTotal||0));
  state.bot.perTrade=Math.max(0.5,Number(b.perTrade||5));
  state.bot.spent=0;
  state.bot.startedAt=now();
  state.bot.last="START";
  state.bot.running=true;
  saveJSON(STATE_JSON,state);
  botStart();
  res.json({ok:true,bot:state.bot});
});

router.post("/stop",(req,res)=>{
  const b=req.body||{};
  if(!armOK(b.arm)) return res.status(403).json({ok:false,error:"bad_arm"});
  state.bot.running=false;
  state.bot.last="STOP";
  saveJSON(STATE_JSON,state);
  botStop();
  res.json({ok:true,bot:state.bot});
});

router.post("/withdraw",(req,res)=>{(async()=>{
  const b=req.body||{};
  if(!armOK(b.arm)) return res.status(403).json({ok:false,error:"bad_arm"});
  const to=String(b.to||state.bot.withdrawTo||"");
  if(!to) return res.status(400).json({ok:false,error:"missing_to"});
  const r=await withdrawAllTo(to);
  state.bot.last=`WITHDRAW ${r.tx||"none"}`;
  saveJSON(STATE_JSON,state);
  res.json(r);
})().catch(e=>res.status(500).json({ok:false,error:String(e&&e.message||e)}));});


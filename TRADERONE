'use strict';
const http = require('http');

const LISTEN_HOST = process.env.LISTEN_HOST || '127.0.0.1';
const LISTEN_PORT = parseInt(process.env.LISTEN_PORT || '12703', 10);
const UPSTREAM = (process.env.DRPC_HTTP || '').trim();

function send(res, code, obj) {
  const body = Buffer.from(JSON.stringify(obj));
  res.writeHead(code, {
    'content-type': 'application/json; charset=utf-8',
    'content-length': String(body.length),
    'cache-control': 'no-store'
  });
  res.end(body);
}

function readBody(req) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    req.on('data', c => chunks.push(Buffer.from(c)));
    req.on('end', () => resolve(Buffer.concat(chunks)));
    req.on('error', reject);
  });
}

const srv = http.createServer(async (req, res) => {
  try {
    if (!UPSTREAM) return send(res, 500, { error: 'DRPC_HTTP missing' });

    if (req.method === 'GET' && (req.url === '/' || req.url === '/health')) {
      return send(res, 200, { status: 'ok', upstream: 'drpc', url: UPSTREAM });
    }

    if (req.method !== 'POST') {
      return send(res, 405, { error: 'POST only', method: req.method });
    }

    const body = await readBody(req);
    const upstreamRes = await fetch(UPSTREAM, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body
    });

    const text = await upstreamRes.text();
    res.writeHead(upstreamRes.status, {
      'content-type': upstreamRes.headers.get('content-type') || 'application/json; charset=utf-8',
      'cache-control': 'no-store'
    });
    res.end(text);
  } catch (e) {
    send(res, 502, { error: String(e && e.message ? e.message : e) });
  }
});

srv.listen(LISTEN_PORT, LISTEN_HOST, () => {
  console.log(`wolverine-solrpc-proxy listening on http://${LISTEN_HOST}:${LISTEN_PORT} -> ${UPSTREAM}`);
});
JS


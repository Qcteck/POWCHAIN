#!/bin/bash
set -e

# ===== CONFIG FIXE =====
UI="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)
BACKUP="/var/www/_BACKUP_WOLVERINE_PHANTOM_$TS"
LOG="/root/wolverine_phantom_root_$TS.log"

exec > >(tee -a "$LOG") 2>&1

echo "=== WOLVERINE PHANTOM ROOT BATCH ==="

# ===== CHECK =====
[ -f "$UI" ] || { echo "❌ UI introuvable: $UI"; exit 1; }

# ===== BACKUP =====
echo "[1/4] Backup UI"
mkdir -p "$BACKUP"
cp -a "$UI" "$BACKUP/"

# ===== ÉVITER DOUBLE INJECTION =====
grep -q "PHANTOM_CONNECT_FINAL" "$UI" && {
  echo "✔️ Phantom déjà patché"
  exit 0
}

# ===== INJECTION HTML (BOUTON + ZONE WALLET) =====
echo "[2/4] Injection HTML Phantom"

sed -i "/<\/body>/i \
<!-- PHANTOM_CONNECT_FINAL -->\
<div id=\"phantomBox\" style=\"padding:10px\">\
  <button id=\"phantomConnect\">Connect Phantom</button>\
  <div id=\"walletInfo\" style=\"display:none\">\
    <div>Adresse: <span class=\"wallet-address\"></span></div>\
    <div>SOL: <span class=\"wallet-sol\">-</span></div>\
    <div>USDC: <span class=\"wallet-usdc\">-</span></div>\
  </div>\
</div>" "$UI"

# ===== INJECTION JS PHANTOM RÉEL =====
echo "[3/4] Injection JS Phantom"

sed -i "/<\/body>/i \
<script>\
/* === PHANTOM CONNECT FINAL === */\
(function(){\
 const btn=document.getElementById('phantomConnect');\
 const info=document.getElementById('walletInfo');\
 if(!btn)return;\
 btn.addEventListener('click',async()=>{\
  if(!window.solana||!window.solana.isPhantom){\
    alert('Ouvre ce site dans le navigateur Phantom');\
    return;\
  }\
  try{\
    const r=await window.solana.connect({onlyIfTrusted:false});\
    const pk=r.publicKey.toString();\
    document.querySelectorAll('.wallet-address').forEach(e=>e.textContent=pk);\
    info.style.display='block';\
    btn.style.display='none';\
    const res=await fetch('/wolverine/traderone/api/balances?pub='+pk);\
    if(!res.ok)throw new Error('backend');\
    const b=await res.json();\
    document.querySelectorAll('.wallet-sol').forEach(e=>e.textContent=b.sol);\
    document.querySelectorAll('.wallet-usdc').forEach(e=>e.textContent=b.usdc);\
  }catch(e){\
    console.error('PHANTOM ERROR',e);\
    alert('Connexion Phantom annulée');\
  }\
 });\
})();\
</script>" "$UI"

# ===== DONE =====
echo "[4/4] TERMINÉ"
echo "✔️ Phantom connecté par clic utilisateur"
echo "✔️ Adresse + soldes affichés"
echo "📦 Backup: $BACKUP"
echo "📄 Log: $LOG"
echo "=== DONE ==="
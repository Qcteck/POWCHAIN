<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>ASAN • Orbite Terre</title>
<style>
html,body{
  margin:0;
  width:100%;
  height:100%;
  overflow:hidden;
  background:#000;
}
canvas{display:block}
</style>
</head>

<body>

<script src="https://cdn.jsdelivr.net/npm/three@0.159/build/three.min.js"></script>

<script>
/* ===== SCÈNE ===== */
const scene = new THREE.Scene()
scene.background = new THREE.TextureLoader().load(
  "https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/starfield.jpg"
)

/* ===== CAMÉRA ===== */
const camera = new THREE.PerspectiveCamera(45, innerWidth/innerHeight, 0.1, 1000)
camera.position.set(0,0,8)

/* ===== RENDER ===== */
const renderer = new THREE.WebGLRenderer({antialias:true})
renderer.setSize(innerWidth, innerHeight)
document.body.appendChild(renderer.domElement)

/* ===== LUMIÈRES ===== */
scene.add(new THREE.AmbientLight(0x222222))

const sunLight = new THREE.DirectionalLight(0xffffff, 1.5)
sunLight.position.set(10,5,10)
scene.add(sunLight)

/* ===== SOLEIL (VISUEL) ===== */
const sun = new THREE.Mesh(
  new THREE.SphereGeometry(0.6,32,32),
  new THREE.MeshBasicMaterial({color:0xffdd88})
)
sun.position.copy(sunLight.position)
scene.add(sun)

/* ===== TERRE ===== */
const earth = new THREE.Mesh(
  new THREE.SphereGeometry(2,128,128),
  new THREE.MeshPhongMaterial({
    map:new THREE.TextureLoader().load(
      "https://threejs.org/examples/textures/planets/earth_atmos_2048.jpg"
    ),
    specular:new THREE.Color("grey"),
    shininess:10
  })
)
scene.add(earth)

/* ===== NUAGES ===== */
const clouds = new THREE.Mesh(
  new THREE.SphereGeometry(2.03,128,128),
  new THREE.MeshPhongMaterial({
    map:new THREE.TextureLoader().load(
      "https://threejs.org/examples/textures/planets/earth_clouds_1024.png"
    ),
    transparent:true,
    opacity:0.8
  })
)
scene.add(clouds)

/* ===== LUNE ===== */
const moonPivot = new THREE.Object3D()
scene.add(moonPivot)

const moon = new THREE.Mesh(
  new THREE.SphereGeometry(0.54,64,64),
  new THREE.MeshPhongMaterial({
    map:new THREE.TextureLoader().load(
      "https://threejs.org/examples/textures/planets/moon_1024.jpg"
    )
  })
)
moon.position.set(4.5,0,0)
moonPivot.add(moon)

/* ===== ISS ===== */
const issPivot = new THREE.Object3D()
scene.add(issPivot)

const iss = new THREE.Mesh(
  new THREE.BoxGeometry(0.25,0.05,0.1),
  new THREE.MeshStandardMaterial({color:0xdddddd})
)
iss.position.set(2.4,0,0)
issPivot.add(iss)

/* ===== INTERACTION CAMÉRA ===== */
document.addEventListener("mousemove", e=>{
  const x=(e.clientX/innerWidth-0.5)*3
  const y=-(e.clientY/innerHeight-0.5)*2
  camera.position.x=x
  camera.position.y=y
  camera.lookAt(0,0,0)
})

document.addEventListener("wheel", e=>{
  camera.position.z += e.deltaY*0.003
  camera.position.z = Math.max(4, Math.min(15, camera.position.z))
})

/* ===== ANIMATION ===== */
function animate(){
  requestAnimationFrame(animate)

  earth.rotation.y += 0.0015
  clouds.rotation.y += 0.002

  moonPivot.rotation.y += 0.0006
  issPivot.rotation.y += 0.01

  renderer.render(scene, camera)
}
animate()

/* ===== RESIZE ===== */
window.addEventListener("resize", ()=>{
  camera.aspect = innerWidth/innerHeight
  camera.updateProjectionMatrix()
  renderer.setSize(innerWidth, innerHeight)
})
</script>

</body>
</html>

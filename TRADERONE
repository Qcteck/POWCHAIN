set -e
cd /opt/traderone-opt

echo "=== A) PM2 status ==="
pm2 status || true
echo

echo "=== B) Quel script PM2 lance ? ==="
pm2 show traderone | sed -n '1,220p' || true
echo

echo "=== C) Logs (les 120 dernières lignes) ==="
pm2 logs traderone --lines 120 --nostream || true
echo

echo "=== D) Check si server.js est valide (syntax) ==="
node -c server.js && echo "OK: syntax" || echo "ERR: syntax"
echo

echo "=== E) Qui écoute sur 3000 ? ==="
ss -ltnp | egrep ':3000|:80|:443' || true
echo

echo "=== F) Démarre en mode foreground (10s) pour voir l'erreur ==="
timeout 10s node server.js || true
echo

echo "=== G) Restart propre ==="
pm2 restart traderone --update-env || pm2 restart all --update-env
sleep 1
pm2 status
echo

echo "=== H) Retest local /health et /api/status ==="
curl -sS -i http://127.0.0.1:3000/health | head -n 20 || true
echo
curl -sS -i http://127.0.0.1:3000/api/status | head -n 30 || true
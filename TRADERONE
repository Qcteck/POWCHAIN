cat >/root/patch_phantom_balance_live.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"

# Trouve l'index live le plus probable
TARGET=""
for f in /var/www/wolverine/index.html /usr/share/nginx/html/wolverine/index.html /srv/www/wolverine/index.html; do
  [[ -f "$f" ]] && TARGET="$f" && break
done
if [[ -z "$TARGET" ]]; then
  TARGET="$(grep -RIl --include="index.html" -E "Wolverine|TraderOne" /var/www /usr/share/nginx/html /srv/www 2>/dev/null | grep -vi "_backup" | head -n 1 || true)"
fi
[[ -n "$TARGET" && -f "$TARGET" ]] || { echo "[ERR] index.html live introuvable"; exit 1; }

echo "[*] TARGET=$TARGET"

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$TARGET" "${TARGET}.bak_${ts}"
echo "[OK] Backup -> ${TARGET}.bak_${ts}"

# 1) Ajoute une ligne Balance dans la walletBox si absente
if ! grep -q 'id="walletBalance"' "$TARGET"; then
  perl -0777 -i -pe '
    s@(</div>\s*</div>\s*</aside>)@<div class="muted small" id="walletBalance" style="margin-top:8px">Balance: -</div>\n$1@is;
  ' "$TARGET" || true
fi

# 2) Inject JS balance (idempotent)
if ! grep -q "PHANTOM_BALANCE_PATCH" "$TARGET"; then
  perl -0777 -i -pe '
my $js = qq{
<!-- PHANTOM_BALANCE_PATCH -->
<script>
(function(){
  const RPC = "https://api.mainnet-beta.solana.com";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"; // mainnet USDC

  async function rpc(method, params){
    const r = await fetch(RPC, {
      method:"POST",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify({ jsonrpc:"2.0", id:1, method, params })
    });
    const j = await r.json();
    if(j.error) throw new Error(j.error.message || JSON.stringify(j.error));
    return j.result;
  }

  async function fetchBalances(ownerBase58){
    // SOL
    const lamports = await rpc("getBalance", [ownerBase58, { commitment:"confirmed" }]);
    const sol = (lamports.value / 1e9);

    // USDC (SPL)
    const tok = await rpc("getTokenAccountsByOwner", [
      ownerBase58,
      { mint: USDC_MINT },
      { encoding:"jsonParsed", commitment:"confirmed" }
    ]);

    let usdc = 0;
    for(const acc of (tok.value || [])){
      const amt = acc.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
      if(typeof amt === "number") usdc += amt;
    }

    return { sol, usdc };
  }

  async function updateUI(ownerBase58){
    const el = document.getElementById("walletBalance") || document.querySelector(".walletBox .muted.small");
    if(!el) return;
    el.textContent = "Balance: …";
    try{
      const b = await fetchBalances(ownerBase58);
      el.textContent = `Balance: ${b.sol.toFixed(4)} SOL | ${b.usdc.toFixed(2)} USDC`;
    }catch(e){
      console.error("balance error", e);
      el.textContent = "Balance: (error)";
    }
  }

  document.addEventListener("DOMContentLoaded", function(){
    // si déjà connecté
    if(window.solana?.isPhantom && window.solana.publicKey){
      updateUI(window.solana.publicKey.toBase58());
    }

    // quand tu connectes (le patch connect déjà en place)
    window.solana?.on?.("connect", () => {
      if(window.solana?.publicKey) updateUI(window.solana.publicKey.toBase58());
    });

    // si changement de compte
    window.solana?.on?.("accountChanged", (pubkey) => {
      if(pubkey) updateUI(pubkey.toBase58());
      else {
        const el = document.getElementById("walletBalance");
        if(el) el.textContent = "Balance: -";
      }
    });
  });
})();
</script>
<!-- /PHANTOM_BALANCE_PATCH -->
};
s@</body>@$js\n</body>@i or die "ERR: </body> introuvable\n";
' "$TARGET"
fi

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
echo "✅ Recharge https://${DOMAIN}/wolverine/ puis clique Connect Phantom."
BASH

chmod +x /root/patch_phantom_balance_live.sh
/root/patch_phantom_balance_live.sh fireinners.online
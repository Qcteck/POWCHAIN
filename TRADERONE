#!/bin/bash
set -e

echo "🐺 WOLVERINE — MEGA PATCH v2.1 (NGINX AUTO-DETECT)"
echo "================================================"

TS=$(date +%Y%m%d_%H%M%S)
LOG="/root/wolverine_megapatch_v2_1_$TS.log"
BACKUP_BASE="/etc/nginx/_BACKUP_WOLVERINE_$TS"

exec > >(tee -a "$LOG") 2>&1

echo
echo "🔎 Recherche vhost Nginx fireinners"
NGINX_SITE=$(grep -RIl "fireinners" /etc/nginx 2>/dev/null | head -n1 || true)

if [ -z "$NGINX_SITE" ]; then
  echo "❌ Aucun vhost fireinners trouvé"
  echo "👉 Arrêt sécurisé (aucune modif)"
  exit 1
fi

echo "✔️ Vhost détecté : $NGINX_SITE"

echo
echo "📦 Backup Nginx"
mkdir -p "$BACKUP_BASE"
cp -a "$NGINX_SITE" "$BACKUP_BASE/"

echo
echo "🔌 Ports Node actifs"
ss -tulpen | grep -E "127.0.0.1:(3000|8585)" || true

echo
echo "✏️ Patch proxy_pass (3000 → 8585)"
sed -i.bak_$TS \
  's|proxy_pass http://127.0.0.1:3000|proxy_pass http://127.0.0.1:8585|g' \
  "$NGINX_SITE"

echo
echo "🧪 Test config Nginx"
nginx -t

echo
echo "♻️ Reload Nginx (sans downtime)"
systemctl reload nginx

echo
echo "🩺 Test API direct (8585)"
curl -s -w "\nHTTP %{http_code}\n" http://127.0.0.1:8585/health || true

echo
echo "🧪 Test API via proxy"
curl -s -w "\nHTTP %{http_code}\n" https://localhost/wolverine/traderone/api/health || true

echo
echo "📄 Backup : $BACKUP_BASE"
echo "📄 Log    : $LOG"

echo
echo "✅ MEGA PATCH v2.1 TERMINÉ"
echo "✔️ Proxy Nginx aligné automatiquement"
echo "❌ Aucun service arrêté"
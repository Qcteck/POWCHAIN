cat >/root/patch_phantom_live_wolverine.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"

# 1) trouver le vrai index servi
TARGET=""

# priorité : emplacements classiques
for f in \
  /var/www/wolverine/index.html \
  /usr/share/nginx/html/wolverine/index.html \
  /srv/www/wolverine/index.html; do
  if [[ -f "$f" ]]; then TARGET="$f"; break; fi
done

# fallback : cherche un index.html qui contient "Wolverine" ET "Connect Phantom" (hors dossiers backup)
if [[ -z "$TARGET" ]]; then
  TARGET="$(grep -RIl --include="index.html" -E "Wolverine|TraderOne" /var/www /usr/share/nginx/html /srv/www 2>/dev/null \
    | grep -vi "_backup" | while read -r f; do
        if grep -qi "Connect Phantom" "$f" 2>/dev/null; then echo "$f"; break; fi
      done)"
fi

if [[ -z "$TARGET" || ! -f "$TARGET" ]]; then
  echo "[ERR] Impossible de trouver le vrai index.html servi pour /wolverine/"
  echo "Donne-moi le path exact (ex: /var/www/wolverine/index.html)."
  exit 1
fi

echo "[*] TARGET=$TARGET"

# 2) backup
ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$TARGET" "${TARGET}.bak_${ts}"
echo "[OK] Backup -> ${TARGET}.bak_${ts}"

# 3) patch idempotent
if grep -q "PHANTOM_CONNECT_PATCH" "$TARGET"; then
  echo "[OK] Patch déjà présent dans le fichier LIVE."
else
  perl -0777 -i -pe '
  my $js = qq{
<!-- PHANTOM_CONNECT_PATCH -->
<script>
(function(){
  function short(pk){ return pk.slice(0,4)+"…"+pk.slice(-4); }

  async function connectPhantom(){
    if(!window.solana || !window.solana.isPhantom){
      alert("Phantom introuvable (installe l’extension Phantom)");
      return;
    }
    const r = await window.solana.connect();
    const pk = r.publicKey.toBase58();

    const st = document.querySelector(".walletBox .muted") || document.getElementById("walletState");
    if(st) st.textContent = "Connected: " + short(pk);

    console.log("Phantom connected:", pk);
  }

  document.addEventListener("DOMContentLoaded", function(){
    const btn =
      document.querySelector(".walletBox .btn.ghost") ||
      Array.from(document.querySelectorAll("button")).find(b => /connect phantom/i.test(b.textContent||""));

    if(btn){
      btn.addEventListener("click", function(ev){
        ev.preventDefault();
        connectPhantom().catch(e => {
          console.error(e);
          alert(String(e?.message || e));
        });
      });
    }

    if(window.solana?.isPhantom && window.solana.publicKey){
      const pk = window.solana.publicKey.toBase58();
      const st = document.querySelector(".walletBox .muted") || document.getElementById("walletState");
      if(st) st.textContent = "Connected: " + short(pk);
    }

    window.solana?.on?.("accountChanged", function(pubkey){
      const st = document.querySelector(".walletBox .muted") || document.getElementById("walletState");
      if(st) st.textContent = pubkey ? ("Connected: " + short(pubkey.toBase58())) : "Not connected";
    });
  });
})();
</script>
<!-- /PHANTOM_CONNECT_PATCH -->
};
  s@</body>@$js\n</body>@i or die "ERR: </body> introuvable\n";
  ' "$TARGET"
  echo "[OK] JS injecté dans le fichier LIVE."
fi

# 4) reload nginx
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "✅ Test dans TON navigateur (avec Phantom): https://${DOMAIN}/wolverine/"
BASH

chmod +x /root/patch_phantom_live_wolverine.sh
/root/patch_phantom_live_wolverine.sh fireinners.online
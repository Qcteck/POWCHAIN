sudo bash -lc '
set -euo pipefail
BK=/root/backup_probe;mkdir -p "$BK"
TS=$(date +%Y%m%d_%H%M%S)
CONF=/etc/nginx/nginx.conf

echo "[0] nginx running?"
systemctl is-active --quiet nginx && echo "nginx: active" || echo "nginx: NOT active"

echo "[1] nginx -t (capture)"
OUT="$(nginx -t 2>&1 || true)"
echo "$OUT"

if echo "$OUT" | grep -q "test is successful"; then
  echo "OK: no syntax error"; exit 0
fi

echo "[2] show file:line if present"
FILE="$(echo "$OUT" | sed -n "s/.* in \\(\\/[^:]*\\):\\([0-9][0-9]*\\).*/\\1/p" | head -n1 || true)"
LINE="$(echo "$OUT" | sed -n "s/.* in \\(\\/[^:]*\\):\\([0-9][0-9]*\\).*/\\2/p" | head -n1 || true)"
if [ -n "${FILE:-}" ] && [ -n "${LINE:-}" ] && [ -f "$FILE" ]; then
  echo "--- context $FILE:$LINE ---"
  nl -ba "$FILE" | sed -n "$((LINE-30)),$((LINE+10))p" || true
fi

echo "[3] if EOF expecting } and nginx.conf is the failing file, try auto-close"
if echo "$OUT" | grep -q "unexpected end of file" && echo "$OUT" | grep -q "expecting.*}\""; then
  echo "[3a] backup nginx.conf"
  cp -a "$CONF" "$BK/nginx.conf.$TS.bak"

  opens=$(grep -o "{" "$CONF" | wc -l || true)
  closes=$(grep -o "}" "$CONF" | wc -l || true)
  diff=$((opens-closes))
  echo "brace diff (opens-closes)=$diff"

  if [ "$diff" -gt 0 ] && [ "$diff" -lt 6 ]; then
    echo "# AUTO-CLOSE $TS" >> "$CONF"
    i=0; while [ $i -lt $diff ]; do echo "}" >> "$CONF"; i=$((i+1)); done
  else
    echo "Not auto-fixing (diff=$diff). Showing tail:"
    tail -n 80 "$CONF" || true
    exit 1
  fi

  echo "[3b] retest"
  if nginx -t; then
    systemctl reload nginx
    echo "OK: fixed + reloaded"
    exit 0
  else
    echo "FAIL: rollback nginx.conf"
    cp -a "$BK/nginx.conf.$TS.bak" "$CONF"
    nginx -t || true
    exit 1
  fi
fi

echo "Not auto-fixing (need exact file/line). Run this and paste output:"
echo "nginx -t 2>&1 | tail -n 30"
exit 1
'
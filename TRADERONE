#!/bin/bash
set -e

FRONT="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

echo "=== WOLVERINE • FIX SOLDES + BACKGROUND ==="

### 1️⃣ PATCH FRONTEND (Phantom + soldes)
node <<'NODE'
const fs=require("fs");
const p=process.env.FRONT||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html";
let h=fs.readFileSync(p,"utf8");

h=h.replace(/Internal SOL:.*?<br>/s,'Internal SOL: <span id="internalSol">-</span><br>');
h=h.replace(/Phantom SOL:.*?<br>/s,'Phantom SOL: <span id="phantomSol">-</span><br>');

if(!h.includes("connectPhantom")){
h=h.replace("</body>",`
<script>
let walletAddress=null;

async function connectPhantom(){
 if(!window.solana){alert("Phantom non détecté");return;}
 const r=await window.solana.connect();
 walletAddress=r.publicKey.toString();
 document.querySelector("strong")?.remove();
 document.querySelector("body").innerHTML=document.body.innerHTML.replace("Wallet: -","Wallet: "+walletAddress);
 loadBalances();
}

async function loadBalances(){
 if(!walletAddress)return;
 const r=await fetch("/api/balances?user="+walletAddress);
 const j=await r.json();
 document.getElementById("phantomSol").textContent=j.phantom.sol.toFixed(4)+" SOL";
 document.getElementById("internalSol").textContent=j.internal.sol.toFixed(4)+" SOL";
}
</script>
</body>`);
}

fs.writeFileSync(p,h);
NODE

### 2️⃣ BACKGROUND UNIVERSEL
node <<'NODE'
const fs=require("fs");
const p="/opt/fireinners/frontend-react/app/dist/wolverine/index.html";
let h=fs.readFileSync(p,"utf8");

h=h.replace(/<style>[\s\S]*?<\/style>/,`
<style>
html,body{
 margin:0;
 height:100%;
 font-family:system-ui;
 background:linear-gradient(135deg,#ff4fd8,#30e3ca);
 background-attachment:fixed;
}

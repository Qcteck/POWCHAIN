cat >/tmp/wolfchain_patch_stats.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/opt/fireinners/frontend-react/app/dist"
if [[ -f "$VHOST" ]]; then
  R="$(awk 'BEGIN{r=""} /^\s*root\s+/{gsub(/;$/,"",$2); if(r=="") r=$2} END{print r}' "$VHOST" || true)"
  [[ -n "${R:-}" ]] && ROOT="$R"
fi
ts(){ date +"%Y%m%d-%H%M%S"; }
bk(){ [[ -f "$1" ]] && cp -a "$1" "$1.bak.$(ts)" && echo "backup: $1.bak.$(ts)" || true; }

echo "ROOT=$ROOT"
test -d "$ROOT" || { echo "ERR: root introuvable: $ROOT"; exit 1; }

mkdir -p "$ROOT/stats"

# vrai endpoint statique
cat >"$ROOT/stats/index.json" <<'JSON'
{"ok":true,"service":"WOLFCHAIN-static","note":"/stats/index.json static ping. Replace with real backend later if desired.","ts":0}
JSON

# page lisible si ouverte au navigateur
cat >"$ROOT/stats/index.html" <<'HTML'
<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>/stats</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;font:14px system-ui;background:#05060b;color:#e7f0ff}pre{max-width:900px;white-space:pre-wrap;background:#0a0f1e;border:1px solid #1b2a44;border-radius:14px;padding:14px}</style><pre id="p">loading...</pre><script>fetch("./index.json",{cache:"no-store"}).then(r=>r.json()).then(j=>{j.ts=Date.now();document.getElementById("p").textContent=JSON.stringify(j,null,2)}).catch(e=>{document.getElementById("p").textContent="ERR"})</script>
HTML

# patch ping URL dans les pages
HOME="$ROOT/index.html"
WOLV="$ROOT/wolverine/index.html"
for f in "$HOME" "$WOLV"; do
  if [[ -f "$f" ]]; then
    bk "$f"
    # remplace fetch("/stats"...) => fetch("/stats/index.json"...)
    sed -i 's#fetch("/stats"#fetch("/stats/index.json"#g' "$f"
    sed -i "s#fetch('/stats'#fetch('/stats/index.json'#g" "$f"
    sed -i 's#fetch(`/stats`#fetch(`/stats/index.json`#g' "$f"
  fi
done

# permissions anti-403
chmod 755 "$ROOT" || true
find "$ROOT" -type d -exec chmod 755 {} \; 2>/dev/null || true
find "$ROOT" -type f -exec chmod 644 {} \; 2>/dev/null || true

echo "OK"
echo "Test local nginx: curl -sS -i https://127.0.0.1/stats/index.json -H 'Host: fireinners.online' | head -n 5"
SH
bash /tmp/wolfchain_patch_stats.sh
cat >/root/probe_traderone_public.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
BASE="${1:-https://fireinners.online/wolverine/traderone/api}"
paths=( "/" "/ping" "/status" "/health" "/api/ping" "/api/status" "/v1/ping" "/v1/status" )

req() {
  local method="$1" url="$2"
  echo "== $method $url =="
  curl -sS -D- -X "$method" "$url" -o /dev/null | head -n 20 || true
  echo
}

for p in "${paths[@]}"; do
  req GET  "${BASE}${p}"
  req POST "${BASE}${p}"
done
BASH


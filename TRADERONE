bash <(cat <<'BASH'
set -euo pipefail

HTML="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_nocache.inc"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE — FIX GLOBAL ONE SHOT ==="

# 1) Vérifs
[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }
mkdir -p "$VENDOR"

# 2) Backup
cp "$HTML" "$HTML.bak_GLOBAL_$TS"
echo "✔ Backup $HTML.bak_GLOBAL_$TS"

# 3) solana-web3 local (si absent)
if [ ! -f "$VENDOR/solana-web3.min.js" ]; then
  curl -sL https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js \
    -o "$VENDOR/solana-web3.min.js"
  echo "✔ solana-web3.js local installé"
fi

# 4) Nettoyage TOUTES injections cassées
sed -i '
/createVault/d;
/vaultaddr/d;
/vaultsol/d;
/vaultusdc/d;
/setUserPub/d;
/window.setUserPub/d;
/USER_PUB/d;
' "$HTML"
echo "✔ Anciennes injections supprimées"

# 5) Injection WALLET PROPRE (Phantom + SOL + USDC)
sed -i '/<\/[[:space:]]*body[[:space:]]*>*/i \
<script src="/wolverine/vendor/solana-web3.min.js"></script>\
<script>\
const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";\
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";\
let PUB=null;\
let CONN=null;\
async function connect(){\
 if(!window.solana||!window.solana.isPhantom){alert("Phantom absent");return;}\
 const r=await window.solana.connect();\
 PUB=new solanaWeb3.PublicKey(r.publicKey.toString());\
 CONN=new solanaWeb3.Connection(RPC,"confirmed");\
 document.getElementById("addr").innerText=PUB.toBase58();\
 await refresh();\
}\
async function refresh(){\
 if(!PUB||!CONN)return;\
 const lam=await CONN.getBalance(PUB);\
 document.getElementById("sol").innerText=(lam/1e9).toFixed(6);\
 let u=0;\
 const accts=await CONN.getParsedTokenAccountsByOwner(PUB,{mint:new solanaWeb3.PublicKey(USDC_MINT)});\
 accts.value.forEach(x=>{u+=x.account.data.parsed.info.tokenAmount.uiAmount||0});\
 document.getElementById("usdc").innerText=u.toFixed(2);\
}\
</script>\
<div style="margin:20px;border:1px solid #00eaff;padding:12px">\
<button onclick="connect()">Connect Wallet</button>\
<button onclick="refresh()">Refresh</button><br><br>\
Adresse: <span id="addr">-</span><br>\
SOL: <span id="sol">-</span><br>\
USDC: <span id="usdc">-</span>\
</div>' "$HTML"
echo "✔ Wallet Phantom + SOL + USDC injecté"

# 6) Forcer NO-CACHE côté serveur
cat > "$INC" <<'NG'
add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
add_header Pragma "no-cache" always;
add_header Expires "0" always;
NG

if ! grep -q "wolverine_nocache.inc" "$NGINX_SITE"; then
  sed -i '/location \/wolverine/ a \        include /etc/nginx/includes/wolverine_nocache.inc;' "$NGINX_SITE"
  echo "✔ Nocache nginx injecté"
else
  echo "ℹ Nocache déjà présent"
fi

# 7) Désactiver service workers
for f in /var/www/wolverine/sw.js /var/www/wolverine/service-worker.js; do
  if [ -f "$f" ]; then
    echo 'self.addEventListener("install",e=>self.skipWaiting());self.addEventListener("fetch",e=>{});' > "$f"
    echo "✔ Service worker neutralisé: $f"
  fi
done

# 8) Purge cache nginx (si existant)
rm -rf /var/cache/nginx/* 2>/dev/null || true

# 9) Reload nginx
nginx -t && systemctl reload nginx
echo "✔ nginx reload OK"

echo "=== TERMINÉ ==="
echo "Ouvre https://fireinners.online/wolverine"
echo "Recharge simple (F5) suffit maintenant"
BASH
)
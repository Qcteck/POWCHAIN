cat >/root/FIX_AGENTIA_SAFE_NO_WOLVERINE_TOUCH.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

WOLV_HTML="/var/www/wolverine/index.html"
NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
APP_DIR="/opt/agentia"
JS="${APP_DIR}/server.js"
SVC="agentia.service"

[ "$(id -u)" -eq 0 ] || { echo "ERROR: run as root"; exit 1; }

sha(){ [ -f "$1" ] && sha256sum "$1" | awk '{print $1}' || echo "MISSING"; }

BEF_W_HTML="$(sha "$WOLV_HTML")"
BEF_NGX="$(sha "$NGX_SITE")"

echo "== BEFORE hashes =="
echo "wolverine index: $BEF_W_HTML  $WOLV_HTML"
echo "nginx vhost    : $BEF_NGX  $NGX_SITE"

echo "== BEFORE Wolverine health (best effort) =="
curl -kfsS "https://fireinners.online/wolverine/" | head -c 200 >/dev/null || true
echo "OK: wolverine reachable (or ignored if blocked)"

[ -f "$JS" ] || { echo "ERROR: missing $JS"; exit 1; }
cp -a "$JS" "${JS}.bak_${TS}"

python3 - <<'PY'
from pathlib import Path
p=Path("/opt/agentia/server.js")
s=p.read_text(errors="ignore").splitlines()
out=[]
for ln in s:
    if "app.listen(PORT, HOST=>{}" in ln: 
        continue
    out.append(ln)
out2=[]
for ln in out:
    if "app.listen(" in ln and "PORT" in ln:
        continue
    out2.append(ln)
out2.append("app.listen(PORT, '127.0.0.1', ()=>{ log('info','server_start',{port:PORT,base:BASE}); });")
p.write_text("\n".join(out2) + "\n")
print("OK: AgentIA listen fixed")
PY

systemctl daemon-reload
systemctl restart "$SVC"
sleep 1

echo "== AgentIA health (local) =="
curl -fsS "http://127.0.0.1:9697/agentia/health" | head -c 500; echo

echo "== AFTER hashes =="
AFT_W_HTML="$(sha "$WOLV_HTML")"
AFT_NGX="$(sha "$NGX_SITE")"
echo "wolverine index: $AFT_W_HTML  $WOLV_HTML"
echo "nginx vhost    : $AFT_NGX  $NGX_SITE"

if [ "$BEF_W_HTML" != "$AFT_W_HTML" ]; then
  echo "ERROR: Wolverine index changed (should not). Aborting."
  exit 1
fi
if [ "$BEF_NGX" != "$AFT_NGX" ]; then
  echo "ERROR: Nginx vhost changed (should not). Aborting."
  exit 1
fi

echo "== AFTER Wolverine check (best effort) =="
curl -kfsS "https://fireinners.online/wolverine/" | head -c 200 >/dev/null || true
echo "OK: Wolverine not touched; AgentIA fixed."
BASH

bash /root/FIX_AGENTIA_SAFE_NO_WOLVERINE_TOUCH.sh
cat > /root/MEGA_WOLVERINE_FIX_404.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

WEBROOT ("x") # placeholder to avoid accidental paste truncation
WEBROOT="/var/www/wolverine"
HTML="$WEBROOT/index.html"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_INC="/etc/nginx/includes/wolverine_routes.inc"

log(){ echo "[$(date +%H:%M:%S)] $*"; }

log "== 0) Preflight =="
id -u | grep -q '^0$' || { echo "ERROR: run as root"; exit 1; }
test -f "$NGINX_SITE" || { echo "ERROR: missing $NGINX_SITE"; exit 1; }
mkdir -p "$WEBROOT"
test -f "$HTML" || { echo "ERROR: missing $HTML (expected Wolverine frontend here)"; ls -la "$WEBROOT" || true; exit 1; }

log "== 1) Backup =="
mkdir -p /root/wolverine_backups
cp -a "$NGINX_SITE" "/root/wolverine_backups/fireinners.online-ssl.bak_$TS"
[ -f "$NGINX_INC" ] && cp -a "$NGINX_INC" "/root/wolverine_backups/wolverine_routes.inc.bak_$TS" || true
cp -a "$HTML" "/root/wolverine_backups/index.html.bak_$TS"

log "== 2) Unfreeze nginx files (if immutable) =="
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$NGINX_SITE" 2>/dev/null || true
chattr -i "$NGINX_INC" 2>/dev/null || true

log "== 3) Ensure include exists + contains proxies (solana-rpc + vault/api) =="
mkdir -p "$(dirname "$NGINX_INC")"
if [ ! -f "$NGINX_INC" ]; then
cat > "$NGINX_INC" <<'NGX'
# === WOLVERINE ROUTES (CANONICAL) ===
location ^~ /wolverine/solana-rpc {
    proxy_pass http://127.0.0.1:12713;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "POST, GET, OPTIONS" always;
    add_header Access-Control-Allow-Headers "content-type, authorization" always;
    if ($request_method = OPTIONS) { return 204; }
}
location ^~ /wolverine/vault/api {
    proxy_pass http://127.0.0.1:3010;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "POST, GET, OPTIONS" always;
    add_header Access-Control-Allow-Headers "content-type, authorization" always;
    if ($request_method = OPTIONS) { return 204; }
}
NGX
fi

log "== 4) Patch vhost: add canonical /wolverine static serve + include routes =="
python3 - <<PY
from pathlib import Path
import re

site=Path("$NGINX_SITE")
s=site.read_text(errors="ignore")

# ensure include line inside server block
inc_line="include /etc/nginx/includes/wolverine_routes.inc;"
if inc_line not in s:
    # insert after first 'server {' line
    s=re.sub(r'(server\\s*\\{\\s*\\n)', r'\\1    '+inc_line+'\\n', s, count=1)

# remove any existing location blocks that collide with /wolverine or /wolverine/
def strip_locations(txt):
    # remove: location = /wolverine { ... }
    txt=re.sub(r'\\n\\s*location\\s*=\\s*/wolverine\\s*\\{[\\s\\S]*?\\n\\s*\\}\\s*', '\\n', txt, flags=re.I)
    # remove: location ^~ /wolverine/ { ... } or location /wolverine/ { ... }
    txt=re.sub(r'\\n\\s*location\\s+(\\^~\\s+)?/wolverine/\\s*\\{[\\s\\S]*?\\n\\s*\\}\\s*', '\\n', txt, flags=re.I)
    return txt

s2=strip_locations(s)

# canonical blocks
canonical = r'''
    # --- WOLVERINE static (CANONICAL) ---
    location = /wolverine { return 301 /wolverine/; }

    location ^~ /wolverine/ {
        alias /var/www/wolverine/;
        try_files $uri $uri/ /wolverine/index.html;
        add_header Cache-Control "no-store" always;
    }
'''

# insert canonical blocks inside first server { ... }
m=re.search(r'server\\s*\\{', s2)
if not m:
    raise SystemExit("ERROR: cannot find server { in vhost")
# insert after include if present else after server {
if inc_line in s2:
    # after the include line inside first server
    s3=re.sub(r'(server\\s*\\{[\\s\\S]*?'+re.escape(inc_line)+r'\\s*\\n)', r'\\1'+canonical+'\\n', s2, count=1)
else:
    s3=re.sub(r'(server\\s*\\{\\s*\\n)', r'\\1'+canonical+'\\n', s2, count=1)

site.write_text(s3)
print("OK: vhost patched with canonical /wolverine static + include")
PY


cat >/root/site_on.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HOST="fireinners.online"
CFG="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "=== 1) Check files (wolverine) ==="
ls -lah /var/www/wolverine | head -n 50 || true
test -f /var/www/wolverine/index.html && echo "OK: /var/www/wolverine/index.html exists" || echo "WARN: missing /var/www/wolverine/index.html"
echo

echo "=== 2) nginx config sanity ==="
test -f "$CFG" && echo "OK: $CFG exists" || echo "WARN: missing $CFG"
nginx -t
echo

echo "=== 3) reload nginx ==="
systemctl reload nginx || service nginx reload
echo

echo "=== 4) ORIGIN checks (bypass Cloudflare) ==="
echo "--- /wolverine/ ---"
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}/wolverine/ | head -n 12 || true
echo "--- /wolverine/index.html ---"
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}/wolverine/index.html | head -n 12 || true
echo "--- /wolverine/traderone/api/ (should stay blocked publicly; localhost may be allowed) ---"
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}/wolverine/traderone/api/ | head -n 12 || true
echo

echo "=== 5) PUBLIC check (Cloudflare) ==="
curl -skI https://${HOST}/wolverine/ | head -n 12 || true

echo "DONE ✅"
BASH

chmod +x /root/site_on.sh
/root/site_on.sh
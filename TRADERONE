cat > /root/WOLVERINE_FIX_SOL_DISPLAY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)
LOG="/root/WOLVERINE_FIX_SOL_$TS.log"

echo "=== WOLVERINE FIX SOL DISPLAY ===" | tee -a "$LOG"

[ -f "$HTML" ] || { echo "index.html introuvable"; exit 1; }

echo "[1/5] Backup index.html" | tee -a "$LOG"
cp -a "$HTML" "$HTML.bak_sol_$TS"

echo "[2/5] Nettoyage anciennes injections SOL" | tee -a "$LOG"
sed -i '/getBalance(/d' "$HTML"
sed -i '/SOL.*innerText/d' "$HTML"

echo "[3/5] Injection fonction SOL canonique" | tee -a "$LOG"
sed -i '/<\/body>/i \
<script>\n\
async function readSOL(pub){\n\
 try{\n\
  if(!pub||!window.solanaWeb3)return \"0.000000\";\n\
  const c=new solanaWeb3.Connection(RPC,\"confirmed\");\n\
  const lamports=await c.getBalance(new solanaWeb3.PublicKey(pub));\n\
  return (lamports/1e9).toFixed(6);\n\
 }catch(e){return \"0.000000\"}\n\
}\n\
</script>' "$HTML"

echo "[4/5] Branchement SOL dans refresh()" | tee -a "$LOG"
sed -i 's/document.getElementById("address").innerText/pub&&document.getElementById("sol")&&(document.getElementById("sol").innerText=await readSOL(pub));\
document.getElementById("address").innerText/' "$HTML" || true

echo "[5/5] Reload nginx + purge cache serveur" | tee -a "$LOG"
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx

echo
echo "=== TERMINÉ ==="
echo "ACTION: CTRL + SHIFT + R"
echo "Backup: $HTML.bak_sol_$TS"
echo "Log: $LOG"
BASH

chmod +x /root/WOLVERINE_FIX_SOL_DISPLAY.sh
/root/WOLVERINE_FIX_SOL_DISPLAY.sh
  ALLOW_MINTS: (process.env.ALLOW_MINTS || '').split(',').map(s=>s.trim()).filter(Boolean)
};

let ARMED = false;
let LAST_TRADE_TS = 0;

function readFileStrict(p){
  return fs.readFileSync(p, 'utf8').trim();
}

function decryptKeypair(masterHex, encB64){
  // Envelope simple: iv(12) + tag(16) + ciphertext
  const buf = Buffer.from(encB64, 'base64');
  if (buf.length < 12+16+1) throw new Error('enc blob too small');
  const iv = buf.subarray(0, 12);
  const tag = buf.subarray(12, 28);
  const ct = buf.subarray(28);

  const key = crypto.createHash('sha256').update(Buffer.from(masterHex, 'hex')).digest();
  const dec = crypto.createDecipheriv('aes-256-gcm', key, iv);
  dec.setAuthTag(tag);
  const pt = Buffer.concat([dec.update(ct), dec.final()]);
  const s = pt.toString('utf8').trim();
  const secret = bs58.decode(s);
  if (!(secret && secret.length === 64)) throw new Error('secret must be 64 bytes (base58 of Solana secretKey)');
  return Keypair.fromSecretKey(secret);
}

function loadSigner(){
  const master = readFileStrict(CFG.MASTER_FILE);
  const enc = readFileStrict(CFG.KEY_ENC_FILE);
  const kp = decryptKeypair(master, enc);
  return kp;
}

function mustAllowMint(m){
  if (!CFG.ALLOW_MINTS.length) return true; // si vide: allow-all (tu peux forcer par env)
  return CFG.ALLOW_MINTS.includes(m);
}

async function fetchJson(url, opts={}, timeoutMs=12000){
  const ac = new AbortController();
  const t = setTimeout(()=>ac.abort(), timeoutMs);
  try{
    const r = await fetch(url, { ...opts, signal: ac.signal, cache: 'no-store' });
    if (!r.ok){
      const txt = await r.text().catch(()=> '');
      throw new Error(`HTTP ${r.status} ${r.statusText} | ${txt.slice(0,240)}`);
    }
    return await r.json();
  } finally {
    clearTimeout(t);
  }
}

async function jupQuote({inputMint, outputMint, amount, slippageBps}){
  const u = new URL(CFG.JUP_QUOTE_URL);
  u.searchParams.set('inputMint', inputMint);
  u.searchParams.set('outputMint', outputMint);
  u.searchParams.set('amount', String(amount)); // in smallest units
  u.searchParams.set('slippageBps', String(slippageBps));
  // optional: u.searchParams.set('onlyDirectRoutes','false');
  return await fetchJson(u.toString());
}

async function jupSwap({quoteResponse, userPublicKey}){
  const body = {
    quoteResponse,
    userPublicKey,
    wrapUnwrapSOL: true,
    dynamicComputeUnitLimit: true,
    // prioritizationFeeLamports: "auto" // peut être activé si besoin
  };
  return await fetchJson(CFG.JUP_SWAP_URL, {
    method: 'POST',
    headers: {'content-type':'application/json'},
    body: JSON.stringify(body)
  }, 20000);
}

async function sendSwapTx(connection, signer, swapTransactionB64){
  const raw = Buffer.from(swapTransactionB64, 'base64');
  const tx = VersionedTransaction.deserialize(raw);
  tx.sign([signer]);
  const sig = await connection.sendTransaction(tx, {
    skipPreflight: false,
    maxRetries: 3
  });
  return sig;
}

// ====================== Autopilot minimal ======================
// Cible simple: trade USDC -> token pour un mint donné via endpoint API /targets
const TARGETS = new Map(); // mint -> { mint, amountUsdc, createdAt }

function usdcToBaseUnits(usdc){
  // USDC Solana = 6 decimals
  return Math.floor(usdc * 1e6);
}

async function doBuy(mint, amountUsdc){
  if (!CFG.ENABLE_TRADING) throw new Error('ENABLE_TRADING=0');
  if (!ARMED) throw new Error('not armed');
  if (!mustAllowMint(mint)) throw new Error('mint not allowed');
  if (!(amountUsdc > 0)) throw new Error('amountUsdc invalid');
  if (amountUsdc > CFG.MAX_TRADE_USDC) throw new Error(`amountUsdc exceeds MAX_TRADE_USDC=${CFG.MAX_TRADE_USDC}`);

  const t = Date.now();
  if (t - LAST_TRADE_TS < CFG.COOLDOWN_SEC * 1000) throw new Error('cooldown active');
  LAST_TRADE_TS = t;

  const signer = loadSigner();
  const connection = new Connection(CFG.SOL_RPC, 'confirmed');

  const amount = usdcToBaseUnits(amountUsdc);
  const quote = await jupQuote({
    inputMint: CFG.USDC_MINT,
    outputMint: mint,
    amount,
    slippageBps: CFG.MAX_SLIPPAGE_BPS
  });

  if (!quote || !quote.routePlan) throw new Error('bad quote');
  const swap = await jupSwap({ quoteResponse: quote, userPublicKey: signer.publicKey.toBase58() });
  if (!swap || !swap.swapTransaction) throw new Error('bad swap');

  const sig = await sendSwapTx(connection, signer, swap.swapTransaction);
  return { sig, payer: signer.publicKey.toBase58(), inputMint: CFG.USDC_MINT, outputMint: mint, amountUsdc };
}

async function autopilotTick(){
  if (!CFG.AUTO_ENABLED) return;
  if (!CFG.ENABLE_TRADING) return;
  if (!ARMED) return;
  // boucle targets
  for (const [mint, t] of TARGETS.entries()){
    try{
      const r = await doBuy(mint, t.amountUsdc);
      console.log(j({ts: nowISO(), type:'AUTO_BUY_OK', mint, amountUsdc: t.amountUsdc, sig: r.sig}));
      TARGETS.delete(mint);
      break; // 1 trade par tick
    } catch(e){
      console.log(j({ts: nowISO(), type:'AUTO_BUY_ERR', mint, err: String(e.message||e)}));
    }
  }
}


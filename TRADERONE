cat >/root/fix_phantom_balances_live.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SRC="/opt/WOLVERINE1_export/ui/phantom_balances.js"
LIVE="/var/www/wolverine"
IDX="$LIVE/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Check source file =="
test -f "$SRC" || { echo "Missing source: $SRC"; exit 1; }

echo "== 2) Copy to LIVE =="
cp -v "$SRC" "$LIVE/phantom_balances.js"
chmod 644 "$LIVE/phantom_balances.js"

echo "== 3) Ensure index.html references /wolverine/phantom_balances.js =="
test -f "$IDX" || { echo "Missing live index: $IDX"; exit 1; }
cp -a "$IDX" "$IDX.bak_${TS}"

# remove wrong path if present
sed -i 's@src="/phantom_balances.js"@src="/wolverine/phantom_balances.js"@g' "$IDX"

# add tag if missing
if ! grep -q 'phantom_balances.js' "$IDX"; then
  sed -i 's@</body>@<script src="/wolverine/phantom_balances.js"></script>\n</body>@' "$IDX"
fi

echo "== 4) Verify file exists + served 200 =="
ls -lah "$LIVE/phantom_balances.js"
curl -sk -D- https://fireinners.online/wolverine/phantom_balances.js | head -n 20

echo
echo "DONE ✅  -> Hard refresh Ctrl+F5 then connect Phantom"
BASH

chmod +x /root/fix_phantom_balances_live.sh
/root/fix_phantom_balances_live.sh
cat > /root/FIX_NGINX_WOLVERINE_INCLUDE_NUKE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/wolverine_force_root.inc"
BACKUP="${INC}.bak.$(date +%s)"

echo "=== NGINX WOLVERINE INCLUDE NUKER ==="

if [ -f "$INC" ]; then
  echo "[!] Found $INC"
  cp "$INC" "$BACKUP"
  echo "[OK] Backup: $BACKUP"

  # Comment every non-empty line
  sed -i 's/^[[:space:]]*[^#]/# &/' "$INC"

  # Safety: remove any remaining braces
  sed -i 's/[{}]/#/g' "$INC"

  echo "[OK] Include fully neutralised"
else
  echo "[INFO] Include not found, nothing to do"
fi

echo "[*] Testing nginx config"
nginx -t

echo "[*] Reloading nginx"
nginx -s reload

echo "=== DONE: NGINX BOOTABLE ==="
BASH

chmod +x /root/FIX_NGINX_WOLVERINE_INCLUDE_NUKE.sh





/root/FIX_NGINX_WOLVERINE_INCLUDE_NUKE.sh

if [ -f "$ASKOR" ]; then . "$ASKOR"; else
  askorupdate_file(){ local p="$1" n="$2" c="$3"; [ -f "$p" ] && cp -a "$p" "$p.bak.$(date -u +%Y%m%dT%H%M%SZ)" || true; umask 077; cat >"$p" <<<"$c"; }
  askorupdate_yesno(){ read -r -p "$1 (y/N) " a || true; case "${a,,}" in y|yes) return 0;; *) return 1;; esac; }
fi

say "== WOLVERINE API MEGA INSTALL =="

<script type="module">
import {Connection,PublicKey,Transaction,SystemProgram} from "./vendor/solana-web3-bundle.js";

const BASE="/aiaquila";
const api=p=>fetch(`${BASE}/api/${p}`,{cache:"no-store"});
const post=(p,b)=>fetch(`${BASE}/api/${p}`,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(b||{})});
const $=id=>document.getElementById(id);
const logEl=$("log"),pendEl=$("pendingBox");

let ARM=false;
let provider=null;
let pub=null;
let rpcPrimary=null;
let rpcBackup=null;
let lastState=null;


bash -lc 'set -euo pipefail
F="/root/WV_FIX_WOLVERINE_404_V4.sh"
cat >"$F"<<'"'"'SH'"'"'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
INCDIR="/etc/nginx/includes"
INC_WOLV="$INCDIR/wolverine_routes.inc"
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WV_WOLV404_V4_${TS}"

say(){ echo "[$(date -u "+%F %T UTC")] $*"; }
need_root(){ [ "$(id -u)" -eq 0 ] || { echo "ERR: root only"; exit 1; }; }

backup_all(){
  mkdir -p "$BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  if [ -d "$WEBROOT" ]; then cp -a "$WEBROOT" "$BK/webroot_wolverine" 2>/dev/null || true; fi
  say "Backup -> $BK"
}

rollback(){
  say "ROLLBACK nginx from backup"
  [ -d "$BK/nginx" ] || { say "No backup dir"; return 0; }
  mv /etc/nginx "/etc/nginx.broken_${TS}" 2>/dev/null || true
  cp -a "$BK/nginx" /etc/nginx 2>/dev/null || true
  nginx -t || true
  systemctl reload nginx || systemctl restart nginx || true
}

unfreeze(){
  command -v chattr >/dev/null 2>&1 || return 0
  chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
  chattr -i -R /etc/nginx/sites-available /etc/nginx/sites-enabled /etc/nginx/includes 2>/dev/null || true
}

refreeze_best(){
  command -v chattr >/dev/null 2>&1 || return 0
  chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
}

pick_primary_ssl_vhost(){
  local p=""
  if [ -e "/etc/nginx/sites-enabled/fireinners.online-ssl" ]; then
    p="/etc/nginx/sites-enabled/fireinners.online-ssl"
    echo "$p"; return 0
  fi
  local cands
  mapfile -t cands < <(grep -RIl --include="*" -e "server_name[[:space:]].*\\b${DOMAIN}\\b" /etc/nginx/sites-enabled 2>/dev/null | sort -u || true)
  for f in "${cands[@]}"; do
    if grep -Eq "listen[[:space:]]+443" "$f" 2>/dev/null; then
      echo "$f"; return 0
    fi
  done
  for f in "${cands[@]}"; do echo "$f"; return 0; done
  echo ""
}

disable_duplicate_ssl_vhosts(){
  local primary="$1"
  local keep_real
  keep_real="$(readlink -f "$primary" 2>/dev/null || echo "$primary")"
  mkdir -p "$BK/disabled_sitesenabled"
  shopt -s nullglob
  for f in /etc/nginx/sites-enabled/*; do
    [ -f "$f" ] || continue
    local real
    real="$(readlink -f "$f" 2>/dev/null || echo "$f")"
    if grep -Eq "server_name[[:space:]].*\\b${DOMAIN}\\b" "$f" 2>/dev/null && grep -Eq "listen[[:space:]]+443" "$f" 2>/dev/null; then
      if [ "$real" != "$keep_real" ]; then
        cp -a "$f" "$BK/disabled_sitesenabled/$(basename "$f")" 2>/dev/null || true
        rm -f "$f" || true
        say "Disabled dup ssl vhost: $f"
      fi
    fi
  done
  shopt -u nullglob
}

ensure_enabled_symlink(){
  if [ -e /etc/nginx/sites-available/fireinners.online-ssl ]; then
    ln -sf /etc/nginx/sites-available/fireinners.online-ssl /etc/nginx/sites-enabled/fireinners.online-ssl
    say "Ensured symlink: sites-enabled/fireinners.online-ssl"
  fi
}

ensure_webroot(){
  mkdir -p "$WEBROOT"
  if [ ! -f "$WEBROOT/index.html" ]; then
    cat >"$WEBROOT/index.html"<<HTML
<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WOLVERINE</title><style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;margin:24px;color:#111}code{background:#f3f3f3;padding:2px 6px;border-radius:6px}</style><h1>WOLVERINE OK</h1><p>Static webroot: <code>$WEBROOT</code></p><p><a href="/wolverine/">/wolverine/</a> · <a href="/wolverine/vault-api/health">/wolverine/vault-api/health</a> · <a href="/wolverine/traderone/api">/wolverine/traderone/api</a></p>
HTML
    say "Created $WEBROOT/index.html"
  fi
}

disable_wolverine_duplicate_includes(){
  mkdir -p "$BK/disabled_includes"
  shopt -s nullglob
  for f in "$INCDIR"/*.inc "$INCDIR"/*.conf "$INCDIR"/*.nginx; do
    [ -f "$f" ] || continue
    [ "$f" = "$INC_WOLV" ] && continue
    if grep -Eq "location[[:space:]]+\\^~[[:space:]]+/wolverine/|location[[:space:]]+=[[:space:]]+/wolverine" "$f" 2>/dev/null; then
      cp -a "$f" "$BK/disabled_includes/$(basename "$f")" 2>/dev/null || true
      mv -f "$f" "$f.disabled_${TS}" 2>/dev/null || true
      say "Disabled include with wolverine locations: $f"
    fi
  done
  shopt -u nullglob
}

write_wolverine_include(){
  mkdir -p "$INCDIR"
  cat >"$INC_WOLV"<<NGX
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  alias $WEBROOT/;
  index index.html;
  try_files \$uri \$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:3000/;
}
location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:8484/;
}
NGX
  say "Wrote $INC_WOLV"
}

ensure_include_once_in_vhost(){
  local vh="$1"
  [ -n "$vh" ] || { say "ERR: no vhost found"; exit 1; }
  local real
  real="$(readlink -f "$vh" 2>/dev/null || echo "$vh")"
  cp -a "$real" "$BK/$(basename "$real").bak" 2>/dev/null || true
  if grep -Eq "include[[:space:]]+$INC_WOLV;" "$real" 2>/dev/null; then
    say "Include already present in: $real"
  else
    awk -v inc="    include '"$INC_WOLV"';" '"'"'
      BEGIN{inserver=0;added=0}
      /^[[:space:]]*server[[:space:]]*\{/ {inserver=1}
      inserver==1 && /^[[:space:]]*\}/ && added==0 {print inc; added=1; inserver=0}
      {print}
    '"'"' "$real" >"$real.tmp"
    mv -f "$real.tmp" "$real"
    say "Injected include into: $real"
  fi
  # remove duplicate include lines if multiple
  awk -v pat="include '"$INC_WOLV"';" '"'"'
    { if(index($0,pat)){c++; if(c>1) next} print }
  '"'"' "$real" >"$real.tmp2"
  mv -f "$real.tmp2" "$real"
}

nginx_test_reload(){
  nginx -t
  systemctl reload nginx || systemctl restart nginx
}

tests(){
  say "TEST LOCAL (bypass CF) HEAD /wolverine/"
  curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true
  say "TEST LOCAL (bypass CF) GET first bytes"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | head -c 220 || true; echo
  say "TEST PUBLIC HEAD /wolverine/"
  curl -skI "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true
  say "SHOW nginx -T (server_name ${DOMAIN} listen 443) file markers"
  nginx -T 2>/dev/null | awk '"'"'/^# configuration file /{file=$4} /server_name[[:space:]]+.*'"$DOMAIN"'/ {sn=1} sn&&/listen[[:space:]]+443/ {print "FILE:",file; sn=0}'"'"' | head -n 20 || true
}

main(){
  need_root
  say "WV_FIX_WOLVERINE_404_V4 start"
  backup_all
  unfreeze
  ensure_webroot
  disable_wolverine_duplicate_includes
  write_wolverine_include
  ensure_enabled_symlink
  local primary
  primary="$(pick_primary_ssl_vhost)"
  say "Primary SSL vhost: ${primary:-NONE}"
  disable_duplicate_ssl_vhosts "${primary:-}"
  ensure_include_once_in_vhost "$primary"
  if ! nginx_test_reload; then
    say "nginx reload failed -> rollback"
    rollback
    exit 1
  fi
  refreeze_best
  tests
  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
}

main "$@"
SH
sed -i "s/\r$//" "$F" || true
chmod +x "$F"
"$F"
'
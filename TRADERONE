import re, sys
path=sys.argv[1]
s=open(path,'r',encoding='utf-8',errors='replace').read().splitlines(True)

# Remove any existing managed block
out=[]
i=0
in_managed=False
while i < len(s):
    line=s[i]
    if "BEGIN_AQUILATRADER_MANAGED" in line:
        in_managed=True
        i+=1
        continue
    if in_managed:
        if "END_AQUILATRADER_MANAGED" in line:
            in_managed=False
        i+=1
        continue
    out.append(line)
    i+=1

s=out

# Remove any location blocks matching /aquilatrader (with or without '=' and with optional trailing slash)
loc_re = re.compile(r'^\s*location\s+(\^~\s+|=+\s+|~\*?\s+)?/aquilatrader/?\s*{', re.I)

clean=[]
i=0
while i < len(s):
    line=s[i]
    if loc_re.search(line):
        # Skip this block using brace depth
        depth = 0
        # count braces on this line
        depth += line.count('{') - line.count('}')
        i += 1
        while i < len(s) and depth > 0:
            depth += s[i].count('{') - s[i].count('}')
            i += 1
        continue
    clean.append(line)
    i += 1

sys.stdout.write(''.join(clean))
PY

cat >"${BK}/aquilatrader_block.ngx" <<'NGX'
# BEGIN_AQUILATRADER_MANAGED
# AquilaTrader static route (managed)
location = /aquilatrader { return 301 /aquilatrader/; }

location ^~ /aquilatrader/ {
  alias /var/www/aquilatrader/;
  try_files $uri $uri/ /aquilatrader/index.html;
  add_header Cache-Control "no-store" always;
}
# END_AQUILATRADER_MANAGED
NGX

# Write back include with appended managed block
TMP_INC="$(mktemp)"
cat "${BK}/wolverine_static.cleaned" >"$TMP_INC"
# Ensure newline then block
printf "\n%s\n" "$(cat "${BK}/aquilatrader_block.ngx")" >>"$TMP_INC"

if declare -F askorupdate_file >/dev/null 2>&1; then
  askorupdate_file "$INC" "$TMP_INC"
else

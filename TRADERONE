set -e
cd /root

echo "=== 1) PID qui écoute sur 3000 ==="
PID="$(lsof -t -iTCP:3000 -sTCP:LISTEN | head -n 1 || true)"
echo "PID=$PID"
[ -n "$PID" ] || { echo "Rien n'écoute sur 3000"; exit 1; }

echo
echo "=== 2) CMD + CWD ==="
echo -n "CMD: "; tr '\0' ' ' < /proc/$PID/cmdline; echo
CWD="$(readlink -f /proc/$PID/cwd)"
echo "CWD=$CWD"

echo
echo "=== 3) Chercher la route /api/status dans CE projet (sans node_modules) ==="
grep -RIn --line-number --exclude-dir=node_modules --exclude-dir=.git \
  -E 'app\.(get|post)\(\s*["'\'']\/api\/status|\/api\/status' \
  "$CWD" 2>/dev/null | head -n 50 || true

echo
echo "=== 4) Chercher l'ajout du champ JSON internal (sans headers système) ==="
grep -RIn --line-number --exclude-dir=node_modules --exclude-dir=.git \
  -E 'internal\s*:\s*|\"internal\"\s*:' \
  "$CWD" 2>/dev/null | head -n 50 || true
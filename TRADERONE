      userAgent: navigator.userAgent
    });
  }, []);

  if (!info) return null;

  return (
    <div className="card">
      <h3 style={{marginTop:0}}>Wallet Debug</h3>
      <pre style={{margin:0, whiteSpace:"pre-wrap"}}>{JSON.stringify(info, null, 2)}</pre>
      {(info.inIframe || !info.hasSolana || !info.isPhantom) && (
        <div className="bad small" style={{marginTop:10}}>

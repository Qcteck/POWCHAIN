cat >/tmp/WOLV_FULL_CHECK_AND_FIX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

hr(){ echo; echo "================ $* ================"; }

hr "1) TraderOne tourne ? (port 8585)"
ss -lntp | grep -E '(:8585)\b' || echo "!! 8585 NOT LISTENING"
systemctl status traderone.service --no-pager -n 20 || true

hr "2) TraderOne répond en LOCAL ? (doit PAS être du HTML wolverine)"
curl -sS --max-time 5 http://127.0.0.1:8585/ | head -c 120; echo
curl -sS --max-time 5 http://127.0.0.1:8585/api/status | head -c 200; echo

hr "3) Fix Nginx: snippet proxy TraderOne (API+WS+UI) + include dans vhost SSL"
SNIP="/etc/nginx/snippets/wolverine_traderone_backend.conf"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"

cat >"$SNIP" <<'EOF'
# TRADERONE_WOLV_PROXY_V2

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:8585/api/;
}

location ^~ /wolverine/traderone/ws {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
  proxy_pass http://127.0.0.1:8585/ws;
}

location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:8585/;
}
EOF

python3 - <<'PY'
import re
p="/etc/nginx/sites-available/fireinners.online-ssl"
inc="    include /etc/nginx/snippets/wolverine_traderone_backend.conf; # TRADERONE_INCLUDE_V1\n"
s=open(p,"r",encoding="utf-8",errors="ignore").read()
if "wolverine_traderone_backend.conf" in s:
    print("OK: include déjà présent")
else:
    m=re.search(r'^\s*server\s*\{\s*$', s, flags=re.M)
    if not m: raise SystemExit("ERREUR: pas trouvé 'server {' dans "+p)
    s=s[:m.end()]+"\n"+inc+s[m.end():]
    open(p,"w",encoding="utf-8").write(s)
    print("OK: include ajouté")
PY

nginx -t
systemctl reload nginx

hr "4) Tests PUBLICS (le status doit PAS commencer par <!doctype html)"
echo "--- /wolverine/traderone/ (head)"; curl -kIs --max-time 6 https://fireinners.online/wolverine/traderone/ | head -n 8
echo "--- /wolverine/traderone/api/status (body head)"; curl -ksS --max-time 6 https://fireinners.online/wolverine/traderone/api/status | head -c 200; echo

hr "5) Si encore HTML, montre où Nginx charge vraiment les locations"
nginx -T 2>/dev/null | grep -nE "server_name fireinners\.online|listen 443|wolverine/traderone|TRADERONE_" | head -n 220 || true
SH

bash /tmp/WOLV_FULL_CHECK_AND_FIX.sh
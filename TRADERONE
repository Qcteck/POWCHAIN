#!/usr/bin/env bash
set -euo pipefail

### CONFIG
SITE_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$SITE_DIR/index.html"
BACKUP="$SITE_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"

# URL WORKER CORRECTE (celle qui RÉPOND)
WORKER_BASE="https://aiaquila-proxy.paycashnostory.workers.dev"
WORKER_RSS="$WORKER_BASE/rss"

echo "=== AIAQUILA • FIX FINAL (WORKER ONLY) ==="

echo "[1/7] Vérification DNS Worker..."
curl -fsSL "$WORKER_BASE" >/dev/null || {
  echo "❌ Worker inaccessible: $WORKER_BASE"
  exit 1
}
echo "✅ Worker OK"

echo "[2/7] Backup frontend..."
cp -a "$INDEX" "$BACKUP"
echo "Backup -> $BACKUP"

echo "[3/7] Réécriture frontend (JSON ONLY / WORKER ONLY)..."
cat > "$INDEX" <<'HTML'
<!doctype html><html lang="fr"><head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;padding:20px;font-family:system-ui;background:#0b1b3a;color:#fff}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
</style>
</head><body>
<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
<script>
const API="__WORKER_RSS__";
async function load(){
 const out=document.getElementById("out");
 out.textContent="Chargement…\n";
 try{
  const r=await fetch(API,{cache:"no-store"});
  if(!r.ok) throw new Error("HTTP "+r.status);
  const j=await r.json();
  if(!Array.isArray(j)) throw new Error("JSON invalide");
  out.textContent=j.map((a,i)=>`${i+1}. ${a.title}\n${a.link}\n`).join("\n");
 }catch(e){
  out.textContent="ERREUR: "+e.message;
 }
}
</script>
</body></html>
HTML

# inject URL
sed -i "s#__WORKER_RSS__#${WORKER_RSS}#g" "$INDEX"

echo "[4/7] Test Worker direct (RSS)..."
curl -fsSL "$WORKER_RSS" | head -n 3 || {
  echo "❌ RSS Worker inaccessible"
  exit 1
}
echo "✅ RSS Worker OK"

echo "[5/7] Permissions..."
chown -R www-data:www-data "$SITE_DIR"
chmod 644 "$INDEX"

echo "[6/7] Reload nginx..."
nginx -t
systemctl reload nginx

echo "[7/7] OK"
echo "URL ACTIVE : https://fireinners.online/aiaquila/"
echo "WORKER    : $WORKER_RSS"
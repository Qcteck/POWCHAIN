bash -c "$(cat <<'BASH'
set -euo pipefail

DIR=/opt/wolverine-balances
mkdir -p $DIR
cd $DIR

cat > server.js <<'JS'
import express from "express";
import { Connection, PublicKey } from "@solana/web3.js";

const app = express();
const RPC = "https://api.mainnet-beta.solana.com";
const USDC_MINT = new PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");
const conn = new Connection(RPC, "confirmed");

app.get("/balances/:addr", async (req, res) => {
  try {
    let addr = req.params.addr.trim().replace(/[^1-9A-HJ-NP-Za-km-z]/g,"");
    const pub = new PublicKey(addr);

    const lamports = await conn.getBalance(pub);
    const sol = lamports / 1e9;

    const tokens = await conn.getParsedTokenAccountsByOwner(
      pub,
      { mint: USDC_MINT }
    );

    let usdc = 0;
    for (const a of tokens.value) {
      usdc += Number(a.account.data.parsed.info.tokenAmount.uiAmount || 0);
    }

    res.json({ sol, usdc });
  } catch (e) {
    res.status(400).json({ error: e.message });
  }
});

app.listen(3010, () => console.log("BALANCES API ON 3010"));
JS

npm init -y >/dev/null
npm install express @solana/web3.js >/dev/null

pkill -f server.js || true
nohup node server.js >/tmp/wolverine-balances.log 2>&1 &

sleep 2
ss -lnt | grep :3010 && echo "API RUNNING"
BASH
)"
cat >/root/WOLVERINE_ROLLBACK_STRICT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "===== WOLVERINE STRICT ROLLBACK ====="

LATEST_SAVEPOINT=$(ls -d /root/WOLVERINE_SAVEPOINT_* 2>/dev/null | sort | tail -n 1)
if [ -z "$LATEST_SAVEPOINT" ]; then
  echo "❌ Aucun SAVEPOINT trouvé"
  exit 1
fi

echo "✅ Savepoint utilisé : $LATEST_SAVEPOINT"

systemctl stop nginx || true
pm2 stop all || true

rm -rf /var/www/wolverine
cp -a "$LATEST_SAVEPOINT/frontend_wolverine" /var/www/wolverine

cp -a "$LATEST_SAVEPOINT/nginx_sites"/* /etc/nginx/sites-available/
cp -a "$LATEST_SAVEPOINT/nginx_sites"/* /etc/nginx/sites-enabled/

chown -R www-data:www-data /var/www/wolverine
chmod -R 755 /var/www/wolverine

rm -rf /var/cache/nginx/* || true

nginx -t

systemctl start nginx
pm2 start all || true

echo "✅ ROLLBACK TERMINÉ — CTRL+SHIFT+R"
BASH

chmod +x /root/WOLVERINE_ROLLBACK_STRICT.sh
/root/WOLVERINE_ROLLBACK_STRICT.sh
bash -lc 'cat > /root/MEGA_WOLVERINE_AQUILA_SOL.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/MEGA_WOLVERINE_AQUILA_SOL_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

need(){ command -v "$1" >/dev/null 2>&1 || { echo "Missing: $1"; exit 1; }; }
need bash; need python3; need nginx; need systemctl; need curl; need ss; need sed; need grep; need awk

if [ "${EUID:-$(id -u)}" -ne 0 ]; then echo "ERROR: run as root"; exit 1; fi

HTML="/var/www/wolverine/index.html"
VENDOR_DIR="/var/www/wolverine/vendor"
WEB3_IIFE="${VENDOR_DIR}/solana-web3.min.js"

NGX_MAIN="/etc/nginx/nginx.conf"
NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGX_INC="/etc/nginx/includes/wolverine_routes.inc"

VAULT_DIR="/opt/traderone-vault"
VAULT_JS="${VAULT_DIR}/server.js"
VAULT_PORT="3010"
VAULT_SVC="/etc/systemd/system/traderone-vault.service"

echo "=== MEGA_WOLVERINE_AQUILA_SOL :: $TS ==="
echo "LOG=$LOG"
echo

echo "== 0) Savepoint (if present) =="
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then /root/WOLVERINE_SAVEPOINT.sh || true; fi

echo "== 1) Preconditions =="
test -f "$HTML" || { echo "Missing $HTML"; exit 1; }
mkdir -p /root/wolverine_backups
cp -a "$HTML" "/root/wolverine_backups/index.html.bak_${TS}"

echo "== 2) Ensure local Solana web3.js vendor =="
mkdir -p "$VENDOR_DIR"
if [ ! -s "$WEB3_IIFE" ]; then
  curl -fsSL "https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js" -o "$WEB3_IIFE"
  chmod 0644 "$WEB3_IIFE"
fi
ls -la "$WEB3_IIFE" | head -n 1

echo "== 3) Ensure TraderOne Vault backend runs on 127.0.0.1:${VAULT_PORT} =="
mkdir -p "$VAULT_DIR"
if [ ! -f "$VAULT_JS" ]; then
  echo "ERROR: Missing $VAULT_JS (vault backend not found). Aborting to avoid creating wrong backend."
  exit 1
fi

# Create/patch systemd service (safe backup)
if [ -f "$VAULT_SVC" ]; then cp -a "$VAULT_SVC" "/root/wolverine_backups/traderone-vault.service.bak_${TS}"; fi
cat > "$VAULT_SVC" <<EOF
[Unit]
Description=TraderOne Vault Backend (Wolverine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=NODE_ENV=production
Environment=PORT=${VAULT_PORT}
ExecStart=/usr/bin/node ${VAULT_JS}
WorkingDirectory=${VAULT_DIR}
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable traderone-vault.service >/dev/null 2>&1 || true

# Free port if occupied by stray node
PIDS="$(ss -ltnp 2>/dev/null | awk '"'"'$4 ~ /127\.0\.0\.1:'"${VAULT_PORT}"'$/ {print $0}'"'"' | sed -n '"'"'s/.*pid=\([0-9]\+\).*/\1/p'"'"' | sort -u)"
if [ -n "${PIDS:-}" ]; then
  echo "Port ${VAULT_PORT} already in use -> killing: ${PIDS}"
  for p in $PIDS; do kill -9 "$p" 2>/dev/null || true; done
fi

systemctl restart traderone-vault.service
sleep 1
systemctl --no-pager -l status traderone-vault.service | head -n 20 || true
ss -ltnp | grep -E "127\\.0\\.0\\.1:${VAULT_PORT}\\b" || true

echo "== 4) Patch nginx routes: /wolverine/vault/api -> 127.0.0.1:${VAULT_PORT} (no 301/308) =="
for f in "$NGX_MAIN" "$NGX_VHOST" "$NGX_INC"; do [ -e "$f" ] && chattr -i "$f" 2>/dev/null || true; done
mkdir -p "$(dirname "$NGX_INC")"
touch "$NGX_INC"
cp -a "$NGX_INC" "/root/wolverine_backups/wolverine_routes.inc.bak_${TS}" || true

python3 - <<PY
import re
from pathlib import Path
inc=Path("${NGX_INC}")
s=inc.read_text(errors="ignore")

# remove older Aquila/Vault blocks if any
def drop_block(tag):
  nonlocal_s=None

lines=s.splitlines(True)
out=[]
i=0
drop_tags=set(["##WOLVERINE_VAULT_API_CANONICAL_V1"])
while i<len(lines):
  if any(t in lines[i] for t in drop_tags):
    i+=1
    # drop until blank line
    while i<len(lines) and lines[i].strip()!="":
      i+=1
    continue
  out.append(lines[i]); i+=1

if out and out[-1].strip()!="":
  out.append("\n")

block = r"""##WOLVERINE_VAULT_API_CANONICAL_V1
location = /wolverine/vault/api {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:${VAULT_PORT}/;
}
location /wolverine/vault/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:${VAULT_PORT}/;
}
"""
out.append(block + "\n")
inc.write_text("".join(out))
print("OK: nginx include updated")
PY

nginx -t
systemctl reload nginx
for f in "$NGX_MAIN" "$NGX_VHOST" "$NGX_INC"; do [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true; done

echo "== 5) Patch Wolverine index.html: inject Aquila (SOL Budget -> Phantom popup -> Vault create -> SOL transfer) =="
python3 - <<'PY'
from pathlib import Path
import re

p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# Ensure solana-web3 iife is present once
web3_tag = '<script src="/wolverine/vendor/solana-web3.min.js"></script>'
if web3_tag not in s:
  m=re.search(r"<head[^>]*>", s, re.I)
  if m:
    s=s[:m.end()]+web3_tag+s[m.end():]
  else:
    s=web3_tag+s
while s.count(web3_tag) > 1:
  s=s.replace(web3_tag, "", 1)

# Inject Aquila UI+JS once

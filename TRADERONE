cat >/root/force_phantom_onclick.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TARGET="/var/www/wolverine/index.html"
if [[ ! -f "$TARGET" ]]; then
  echo "[ERR] Je ne trouve pas $TARGET. Donne le chemin exact de ton index.html."
  exit 1
fi

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$TARGET" "${TARGET}.bak_${ts}"
echo "[OK] Backup -> ${TARGET}.bak_${ts}"

# 1) ajoute un id au bouton "Connect Phantom" si absent
perl -0777 -i -pe '
s@(<button\s+class="btn\s+ghost")([^>]*>Connect Phantom</button>)@$1 id="connectPhantom"$2@i
' "$TARGET"

# 2) injecte un script minimal (idempotent)
if ! grep -q "PHANTOM_ONCLICK_PATCH" "$TARGET"; then
  perl -0777 -i -pe '
my $js = qq{
<!-- PHANTOM_ONCLICK_PATCH -->
<script>
async function __connectPhantom(){
  if(!window.solana || !window.solana.isPhantom){
    alert("Phantom introuvable (installe/active l’extension Phantom)");
    return;
  }
  const r = await window.solana.connect();
  const pk = r.publicKey.toBase58();
  const st = document.querySelector(".walletBox .muted");
  if(st) st.textContent = "Connected: " + pk.slice(0,4) + "…" + pk.slice(-4);
  console.log("Phantom connected:", pk);
}
document.addEventListener("DOMContentLoaded", () => {
  const btn = document.getElementById("connectPhantom");
  if(btn) btn.onclick = (e) => { e.preventDefault(); __connectPhantom().catch(err => alert(String(err?.message||err))); };
});
</script>
<!-- /PHANTOM_ONCLICK_PATCH -->
};
s@</body>@$js\n</body>@i;
' "$TARGET"
fi

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
echo "✅ Test: https://fireinners.online/wolverine/?v=$ts"
BASH

chmod +x /root/force_phantom_onclick.sh
/root/force_phantom_onclick.sh
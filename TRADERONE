cat >/root/quick_audit_balance.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="fireinners.online"
ROOT="/var/www/wolverine"
ts="$(date +%s)"

hr(){ echo -e "\n========== $* ==========\n"; }

hr "1) API health (must be 200 JSON)"
curl -sk -i "https://${DOMAIN}/wolverine/traderone/api/health" | sed -n '1,15p'
echo "-- body(120):"; curl -sk "https://${DOMAIN}/wolverine/traderone/api/health" | head -c 120; echo

hr "2) RPC getVersion (must be 200 JSON)"
curl -sk -i "https://${DOMAIN}/wolverine/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,25p'

hr "3) CORS preflight OPTIONS /wolverine/rpc (should be 204/200 + allow-*)"
curl -sk -i -X OPTIONS "https://${DOMAIN}/wolverine/rpc" \
  -H "Origin: https://${DOMAIN}" \
  -H "Access-Control-Request-Method: POST" \
  -H "Access-Control-Request-Headers: content-type" | sed -n '1,25p'

hr "4) phantom_patch.js headers (cache?)"
curl -skI "https://${DOMAIN}/wolverine/phantom_patch.js" | sed -n '1,30p'

hr "5) phantom_patch.js contains /srpc ? (NO FLOOD)"
if curl -sk "https://${DOMAIN}/wolverine/phantom_patch.js?v=${ts}" | grep -n "/srpc" >/tmp/srpc_hits.$$ 2>/dev/null; then
  echo "[BAD] /srpc still referenced in phantom_patch.js:"
  head -n 10 /tmp/srpc_hits.$$
else
  echo "OK: no /srpc ✅"
fi
rm -f /tmp/srpc_hits.$$ 2>/dev/null || true

hr "6) disk scan for /srpc leftovers (limited)"
grep -RIn --exclude-dir=node_modules --exclude-dir=.next --exclude='*.map' "/srpc" \
  "$ROOT" /etc/nginx/snippets 2>/dev/null | head -n 50 || true

hr "7) show nginx definitions for /srpc and /wolverine/rpc (to avoid surprises)"
grep -RIn "location.*srpc" /etc/nginx/sites-enabled /etc/nginx/snippets 2>/dev/null || true
grep -RIn "location.*wolverine/rpc" /etc/nginx/sites-enabled /etc/nginx/snippets 2>/dev/null || true

hr "DONE ✅ (paste sections 4 + 5 + 6)"
BASH

chmod +x /root/quick_audit_balance.sh
/root/quick_audit_balance.sh
bash -lc 'cat >/root/FIND_TRADERONE_CORE_RUN.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/FIND_TRADERONE_CORE_${TS}.log"
exec > >(tee -a "$LOG") 2>&1
[ "${EUID:-$(id -u)}" -eq 0 ] || { echo "ERROR: run as root"; exit 1; }

echo "=== FIND_TRADERONE_CORE :: $TS ==="
echo "LOG=$LOG"
echo

echo "== 1) Process actually listening on :3000 (THE CORE) =="
ss -ltnp | grep -E ":3000\b" || true
PIDS="$(ss -ltnp 2>/dev/null | awk "/:3000[[:space:]]/ {match(\$0,/pid=([0-9]+)/,m); if(m[1]!=\"\") print m[1]}" | sort -u)"
echo
if [ -n "${PIDS:-}" ]; then
  for pid in $PIDS; do
    echo "---- CORE PID $pid ----"
    echo "cmdline:"; tr "\0" " " </proc/$pid/cmdline 2>/dev/null || true; echo
    echo "cwd:"; readlink -f /proc/$pid/cwd 2>/dev/null || true
    echo "exe:"; readlink -f /proc/$pid/exe 2>/dev/null || true
    echo "env(filtered):"
    tr "\0" "\n" </proc/$pid/environ 2>/dev/null | grep -Ei "^(PORT=|NODE_ENV=|RPC|PROXY|JWT|SECRET|KEY|DB|REDIS|HOST=|BASE_URL=)" || true
    echo
  done
else
  echo "No PID found on :3000 (core not bound on 3000 right now)."
fi
echo

echo "== 2) PM2 candidate apps (traderone/vault/wolverine) =="
if command -v pm2 >/dev/null 2>&1; then
  pm2 ls || true
  echo
  pm2 jlist 2>/dev/null | python3 - <<'"'"'PY'"'"'
import json,sys
try: a=json.load(sys.stdin)
except: 
  print("pm2 jlist unreadable"); sys.exit(0)
for p in a:
  n=p.get("name","")
  if any(k in n.lower() for k in ["traderone","vault","wolverine"]):
    print("###",n)
    env=(p.get("pm2_env") or {})
    print("cwd:", env.get("pm_cwd"))
    print("script:", env.get("pm_exec_path"))
    print("args:", env.get("args"))
    print("PORT:", (env.get("env") or {}).get("PORT"))
    print()
PY
else
  echo "pm2 not installed."
fi
echo

echo "== 3) systemd units matching traderone/vault/wolverine =="
if command -v systemctl >/dev/null 2>&1; then
  systemctl list-unit-files --type=service | grep -Ei "traderone|vault|wolverine" || true
  echo
  systemctl list-units --type=service --all | awk "{print \$1}" | grep -Ei "traderone|vault|wolverine" | while read -r svc; do
    echo "### $svc"
    systemctl status "$svc" --no-pager || true
    echo
    systemctl cat "$svc" --no-pager || true
    echo
  done
else
  echo "systemctl not available."
fi
echo

echo "== 4) Known fixed paths (your project memory) =="
for p in /opt/wolverine /var/www/wolverine /opt/traderone /opt/traderone-opt /opt/traderone-vault; do
  if [ -e "$p" ]; then echo "--- $p"; ls -la "$p" | head -n 80 || true; echo; fi
done

echo "== 5) Find entrypoints under /opt (server/app/index + package.json) =="
find /opt -maxdepth 6 -type f \( -name "server.js" -o -name "app.js" -o -name "index.js" -o -name "main.js" -o -name "package.json" -o -name "ecosystem.config.js" -o -name ".env" \) -not -path "*/node_modules/*" 2>/dev/null | sed "s#^#/opt-hit: #"
echo

echo "== 6) Git remotes (WOLVERINE/TraderOne repos on VPS) =="
if command -v git >/dev/null 2>&1; then
  find /opt /root -maxdepth 5 -type d -name .git 2>/dev/null | sort -u | while read -r gd; do
    repo="$(dirname "$gd")"
    echo "### REPO: $repo"
    git -C "$repo" remote -v 2>/dev/null || true
    echo
  done
else
  echo "git not installed."
fi
echo

echo "== 7) Nginx proof (where /wolverine/traderone/api goes) =="
if command -v nginx >/dev/null 2>&1; then
  nginx -T 2>/dev/null | grep -nE "server_name.*fireinners\.online|include /etc/nginx/includes/wolverine_routes\.inc|location \^~ /wolverine/traderone/api/|proxy_pass http://127\.0\.0\.1:3000" | head -n 260 || true
else
  echo "nginx not installed."
fi
echo

echo "DONE. LOG=$LOG"
BASH
chmod +x /root/FIND_TRADERONE_CORE_RUN.sh
/root/FIND_TRADERONE_CORE_RUN.sh'
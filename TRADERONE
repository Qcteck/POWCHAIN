bash <<'EOF'
set -e
echo "=== WOLVERINE • RESTORE UI + ADD PHANTOM ==="

BASE="/opt/fireinners"
FRONT="$BASE/frontend-react/app/dist/wolverine"
BACKUP="$BASE/backup_restore_$(date +%Y%m%d_%H%M%S)"

echo "[1/6] Backup actuel"
mkdir -p "$BACKUP"
cp -a "$FRONT" "$BACKUP/" || true

echo "[2/6] Restauration UI propre (index existant)"
# on suppose que ton index propre était encore en cache git ou backup précédent
if [ -f "$BASE/backup_wolverine_latest/index.html" ]; then
  cp "$BASE/backup_wolverine_latest/index.html" "$FRONT/index.html"
else
  echo "⚠️ Aucun index propre détecté automatiquement"
  echo "➡️ Le script ajoute Phantom SANS toucher au layout existant"
fi

echo "[3/6] Injection Phantom.js (NON intrusif)"
mkdir -p "$FRONT/js"
cat > "$FRONT/js/phantom.js" <<'JS'
(function(){
  async function connect(){
    if(!window.solana || !window.solana.isPhantom){
      window.location.href="https://phantom.app/ul/browse/"+encodeURIComponent(location.href);
      return;
    }
    const r = await window.solana.connect({onlyIfTrusted:false});
    const pub = r.publicKey.toString();
    const el = document.getElementById("walletAddress");
    if(el) el.textContent = pub;

    fetch("/wolverine/traderone/api/balances?pub="+pub)
      .then(r=>r.json())
      .then(b=>{
        const s=document.getElementById("sol"); if(s) s.textContent=b.sol.toFixed(4);
        const u=document.getElementById("usdc"); if(u) u.textContent=b.usdc.toFixed(2);
      });
  }
  window.connectPhantom = connect;
})();
JS

echo "[4/6] Ajout hook Phantom SANS casser le HTML"
grep -q "phantom.js" "$FRONT/index.html" || \
sed -i 's#</body>#<script src="js/phantom.js"></script></body>#' "$FRONT/index.html"

echo "[5/6] Aucun CSS touché, aucun layout touché"

echo "[6/6] Permissions"
chown -R www-data:www-data "$FRONT"

echo "=== FIN ==="
echo "Backup : $BACKUP"
echo "UI d'origine conservée + Phantom ajouté"
EOF
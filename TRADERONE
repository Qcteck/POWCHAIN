cat >/root/MEGA_WOLVERINE_FIX_VAULT_API.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
trap 'echo "[FATAL] line=$LINENO exit=$? cmd=$BASH_COMMAND" >&2' ERR

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

DOMAIN="fireinners.online"
INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

VAULT_DIR="/opt/traderone-vault-api"
VAULT_PORT="3010"
UNIT="/etc/systemd/system/traderone-vault-api.service"

say "0) Preflight"
id -u | grep -q '^0$' || { echo "ERROR: run as root"; exit 1; }
command -v ss >/dev/null || { echo "ERROR: ss missing"; exit 1; }
command -v curl >/dev/null || { echo "ERROR: curl missing"; exit 1; }
command -v node >/dev/null || { echo "ERROR: node missing"; exit 1; }
command -v npm  >/dev/null || { echo "ERROR: npm missing"; exit 1; }
command -v nginx >/dev/null || { echo "ERROR: nginx missing"; exit 1; }
NODEBIN="$(command -v node)"
say "Node = $NODEBIN"

say "1) Stop vault service (ignore errors)"
systemctl stop traderone-vault-api.service 2>/dev/null || true

say "2) Free port ${VAULT_PORT}"
PIDS="$(ss -ltnp 2>/dev/null | awk -v p=":${VAULT_PORT}" '$0 ~ p {print $0}' | sed -n 's/.*pid=\([0-9]\+\).*/\1/p' | sort -u | tr '\n' ' ')"
if [ -n "${PIDS// }" ]; then
  say " - killing PIDs on :${VAULT_PORT} => ${PIDS}"
  kill -9 ${PIDS} || true
else
  say " - no listener found on :${VAULT_PORT}"
fi

say "3) Ensure vault app exists + deps"
mkdir -p "$VAULT_DIR/vaults"
chmod 700 "$VAULT_DIR" "$VAULT_DIR/vaults" || true
cd "$VAULT_DIR"
[ -f package.json ] || npm init -y >/dev/null 2>&1
npm i express bs58 @solana/web3.js >/dev/null 2>&1

say "4) Write hardened vault server.js"
cat >"$VAULT_DIR/server.js" <<'JS'
const fs=require('fs'),path=require('path');
const express=require('express');
const bs58=require('bs58');
const {Keypair}=require('@solana/web3.js');

const app=express();
app.use(express.json({limit:'1mb'}));

const ROOT=__dirname;
const VAULTS=path.join(ROOT,'vaults');
const MAP=path.join(ROOT,'map.json');

function loadMap(){ try{return JSON.parse(fs.readFileSync(MAP,'utf8'))}catch(e){return {}} }
function saveMap(m){ fs.writeFileSync(MAP, JSON.stringify(m,null,2), {mode:0o600}); }

app.get('/health',(req,res)=>res.json({ok:true,service:"vault-api",ts:new Date().toISOString()}));

app.get('/vault',(req,res)=>{
  const user=String((req.query.userPub||'')||'').trim();
  const m=loadMap();
  res.json({ok:true,userPub:user||null,vaultPub:(user && m[user])?m[user]:null});
});

app.post('/create',(req,res)=>{
  const user=String((req.body&&req.body.userPub)||'').trim();
  const m=loadMap();
  if(user && m[user]) return res.json({ok:true,userPub:user,vaultPub:m[user],existing:true});
  const kp=Keypair.generate();
  const vaultPub=kp.publicKey.toBase58();
  const secret58=bs58.encode(Buffer.from(kp.secretKey));
  fs.writeFileSync(path.join(VAULTS, vaultPub+'.json'), JSON.stringify({vaultPub,secret58,createdAt:new Date().toISOString()},null,2), {mode:0o600});
  if(user){ m[user]=vaultPub; saveMap(m); }
  res.json({ok:true,userPub:user||null,vaultPub,existing:false});
});

const port=parseInt(process.env.PORT||'3010',10);
const server=app.listen(port,'127.0.0.1',()=>console.log('vault-api listening',port));
server.on('error',(e)=>{ console.error('server error',e); process.exit(2); });
setInterval(()=>{}, 1<<30);
JS

say "5) Rewrite systemd unit (disable start-limit)"
cat >"$UNIT" <<EOF
[Unit]
Description=TraderOne Vault API (AQUILA)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=$VAULT_DIR
Environment=PORT=$VAULT_PORT
ExecStart=$NODEBIN $VAULT_DIR/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF

say "6) Ensure nginx route exists for /wolverine/vault/api -> 127.0.0.1:${VAULT_PORT}"
test -f "$INC" || { echo "ERROR: missing $INC"; exit 1; }
grep -q "/wolverine/vault/api" "$INC" || {
  cat >>"$INC" <<EOF

# Vault API (create vault + mapping) behind nginx
location ^~ /wolverine/vault/api {
  rewrite ^/wolverine/vault/api/?(.*)\$ /\$1 break;
  proxy_pass http://127.0.0.1:${VAULT_PORT};
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  add_header Access-Control-Allow-Origin "*" always;
  add_header Access-Control-Allow-Methods "POST, GET, OPTIONS" always;
  add_header Access-Control-Allow-Headers "content-type, authorization" always;
  if (\$request_method = OPTIONS) { return 204; }
}
EOF
}

say "7) Start vault service"
systemctl daemon-reload
systemctl enable --now traderone-vault-api.service >/dev/null 2>&1 || true
systemctl reset-failed traderone-vault-api.service || true
systemctl restart traderone-vault-api.service

say "8) Nginx test + reload"
nginx -t
systemctl reload nginx

say "9) Local tests"
ss -ltnp | grep -E ":${VAULT_PORT}\b" || true
curl -sS -i "http://127.0.0.1:${VAULT_PORT}/health" | head -n 12 || true
curl -sS -i "http://127.0.0.1:${VAULT_PORT}/vault?userPub=test" | head -n 12 || true

say "10) Public tests"
curl -sS -i "https://${DOMAIN}/wolverine/vault/api/health" | head -n 12 || true
curl -sS -i "https://${DOMAIN}/wolverine/vault/api/vault?userPub=test" | head -n 12 || true

say "11) Status + last logs"
systemctl --no-pager status traderone-vault-api.service || true
journalctl -u traderone-vault-api.service -n 160 --no-pager || true

say "DONE"
BASH
chmod +x /root/MEGA_WOLVERINE_FIX_VAULT_API.sh
/root/MEGA_WOLVERINE_FIX_VAULT_API.sh
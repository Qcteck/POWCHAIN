# 1) Dry-run (aucune modif)
APPLY=0 bash /root/fireinners_batch.sh | tee /root/fireinners_batch_dryrun_$(date +%F_%H%M%S).log

# 2) Vérif nginx (syntax + reload si OK)
nginx -t && systemctl reload nginx

# 3) Vérif écoute ports
ss -lntp | egrep ':(80|443)\s'

# 4) Vérifs HTTP/HTTPS côté VPS (Host header)
curl -sI  http://127.0.0.1/wolverine/   -H 'Host: fireinners.online' | head -n 20
curl -sI https://127.0.0.1/wolverine/   -H 'Host: fireinners.online' -k | head -n 20
curl -sI https://127.0.0.1/favicon.ico  -H 'Host: fireinners.online' -k | head -n 20

# 5) Vérifs publics (via Cloudflare)
curl -sI  http://fireinners.online/wolverine/  | egrep -i 'HTTP/|location:'
curl -sI https://fireinners.online/wolverine/  | egrep -i 'HTTP/|server:|content-type:'
curl -sI https://fireinners.online/favicon.ico | egrep -i 'HTTP/|server:'
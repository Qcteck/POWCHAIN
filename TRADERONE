export async function fetchOnchainBalances(pubkey) {
  if (!window.solanaWeb3) throw new Error("solanaWeb3 not loaded");
  const conn = new window.solanaWeb3.Connection(
    window.solanaWeb3.clusterApiUrl("mainnet-beta")
  );
  const lamports = await conn.getBalance(new window.solanaWeb3.PublicKey(pubkey));
  return { SOL: lamports / 1e9 };
}

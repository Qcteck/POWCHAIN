cat >/root/MEGA_WOLVERINE_DIAG.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
FRONT_DIR="/var/www/wolverine"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_INC="/etc/nginx/includes/wolverine_routes.inc"
OUT="/root/MEGA_WOLVERINE_DIAG_${TS}.log"

w(){ printf "%s\n" "$*" | tee -a "$OUT" >/dev/null; }
sep(){ w ""; w "==================== $* ===================="; }

http_code_local(){ local path="$1"; curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1${path}" -H "Host: ${HOST}" || true; }
http_code_ext(){ local path="$1"; curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}${path}" || true; }

w "# MEGA_WOLVERINE_DIAG $TS"
w "date=$(date -Is)"
w "host=$(hostname)"
w "whoami=$(whoami)"
w "pwd=$(pwd)"
w "-------------------------------------------"

sep "A) Fichiers MEGA Wolverine (nohup/log) + tailles"
(ls -lah /root/MEGA_*WOLVERINE*.nohup /root/MEGA_*WOLVERINE*.log 2>/dev/null || true) | tee -a "$OUT" >/dev/null
w "Derniers 10 fichiers /root (MEGA*) :"
(ls -lt /root/MEGA_* 2>/dev/null | head -n 10 || true) | tee -a "$OUT" >/dev/null

sep "B) Contenu nohup (AUTOFIX) - tail/head"
if [[ -f /root/MEGA_NGINX_AUTOFIX_WOLVERINE.nohup ]]; then
  w "-- head(80) --"; head -n 80 /root/MEGA_NGINX_AUTOFIX_WOLVERINE.nohup | tee -a "$OUT" >/dev/null || true
  w "-- tail(120) --"; tail -n 120 /root/MEGA_NGINX_AUTOFIX_WOLVERINE.nohup | tee -a "$OUT" >/dev/null || true
else
  w "ABSENT: /root/MEGA_NGINX_AUTOFIX_WOLVERINE.nohup"
fi

sep "C) Dernier LOG MEGA_NGINX_AUTOFIX_WOLVERINE_*"
LASTLOG="$(ls -1t /root/MEGA_NGINX_AUTOFIX_WOLVERINE_*.log 2>/dev/null | head -n 1 || true)"
w "LASTLOG=$LASTLOG"
if [[ -n "${LASTLOG:-}" && -f "$LASTLOG" ]]; then
  w "-- tail(200) --"; tail -n 200 "$LASTLOG" | tee -a "$OUT" >/dev/null || true
  w "-- grep erreurs --"
  egrep -n "ERREUR:|WARN:|duplicate|not allowed here|emerg|failed|successful|include|location" "$LASTLOG" 2>/dev/null | tail -n 80 | tee -a "$OUT" >/dev/null || true
else
  w "Aucun log MEGA_NGINX_AUTOFIX_WOLVERINE_*.log trouvé."
fi

sep "D) nginx -t (erreur exacte)"
NGT="$(nginx -t 2>&1 || true)"
w "$NGT"

sep "E) Extraits vhost + include (wolverine)"
w "FILE: $NGINX_SITE"
if [[ -f "$NGINX_SITE" ]]; then
  egrep -n "server_name|listen|include /etc/nginx/includes/wolverine_routes\.inc|location .*/wolverine" "$NGINX_SITE" 2>/dev/null | tee -a "$OUT" >/dev/null || true
else
  w "ABSENT: $NGINX_SITE"
fi
w "FILE: $NGINX_INC"
if [[ -f "$NGINX_INC" ]]; then
  egrep -n "location|proxy_pass|alias|try_files" "$NGINX_INC" 2>/dev/null | tee -a "$OUT" >/dev/null || true
else
  w "ABSENT: $NGINX_INC"
fi

sep "F) Ports/listeners (80/443/3000)"
(ss -lntp 2>/dev/null || true) | egrep -n ":80|:443|:3000" | tee -a "$OUT" >/dev/null || true

sep "G) Status nginx"
(systemctl is-active nginx 2>/dev/null || true) | tee -a "$OUT" >/dev/null
(systemctl status nginx --no-pager -l 2>/dev/null | tail -n 80 || true) | tee -a "$OUT" >/dev/null

sep "H) Permissions front"
if [[ -d "$FRONT_DIR" ]]; then
  ls -ld "$FRONT_DIR" | tee -a "$OUT" >/dev/null
  [[ -f "$FRONT_DIR/index.html" ]] && ls -l "$FRONT_DIR/index.html" | tee -a "$OUT" >/dev/null || true
else
  w "ABSENT: $FRONT_DIR"
fi

sep "I) Probes HTTP (LOCAL/EXT)"
w "LOCAL /wolverine/               => $(http_code_local "/wolverine/")"
w "LOCAL /wolverine/traderone/api/ => $(http_code_local "/wolverine/traderone/api/")"
w "EXT   /wolverine/               => $(http_code_ext "/wolverine/")"
w "EXT   /wolverine/traderone/api/ => $(http_code_ext "/wolverine/traderone/api/")"

sep "DONE"
w "OUT=$OUT"
echo "$OUT"
BASH
chmod +x /root/MEGA_WOLVERINE_DIAG.sh
nohup /root/MEGA_WOLVERINE_DIAG.sh >/root/MEGA_WOLVERINE_DIAG.nohup 2>&1 </dev/null & disown
echo "Lancé. Lis: tail -n 220 /root/MEGA_WOLVERINE_DIAG.nohup"
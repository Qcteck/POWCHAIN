cat >/root/AIAQUILA_FINAL_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SITE="fireinners.online"
ROOT="/var/www/fireinners.online/aiaquila"
INDEX="$ROOT/index.html"
BACKUP="$ROOT/index.backup.$(date +%Y%m%d_%H%M%S).html"

SNIP="/etc/nginx/conf.d/aiaquila_rss.conf"

echo "=== AIAQUILA FINAL FIX (DIRECT RSS) ==="

### 1) Backup frontend
echo "[1/6] Backup frontend"
cp -a "$INDEX" "$BACKUP"
echo "Backup -> $BACKUP"

### 2) Write nginx RSS + health
echo "[2/6] Write nginx RSS + health config"
cat >"$SNIP" <<'NGX'
# AIAQUILA RSS DIRECT (NO WORKER)

location /aiaquila/api/rss {
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    proxy_pass https://news.bitcoin.com/feed/;
    proxy_set_header Host news.bitcoin.com;
    proxy_set_header User-Agent "AIAQUILA-RSS";
    proxy_ssl_server_name on;

    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}

location /aiaquila/health {
    default_type text/plain;
    return 200 "OK AIAQUILA\n";
}
NGX

### 3) Rewrite frontend (LOCAL API ONLY)
echo "[3/6] Rewrite frontend index.html"
cat >"$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel (FINAL)</title>
<style>
body{margin:0;padding:20px;background:#0b1b3a;color:#fff;font-family:system-ui}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px;color:#cfe}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (FINAL)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
<script>
async function load(){
 const o=document.getElementById("out");
 o.textContent="Chargement…";
 try{
  const r=await fetch("/aiaquila/api/rss",{cache:"no-store"});
  if(!r.ok) throw r.status;
  const txt=await r.text();
  const xml=new DOMParser().parseFromString(txt,"text/xml");
  const items=[...xml.querySelectorAll("item")].slice(0,20);
  o.textContent=items.map(i=>
    "• "+(i.querySelector("title")?.textContent||"")+"\n"+
    (i.querySelector("link")?.textContent||"")
  ).join("\n\n");
 }catch(e){
  o.textContent="ERREUR: "+e;
 }
}
</script>
</body>
</html>
HTML

### 4) Test nginx
echo "[4/6] nginx test"
nginx -t

### 5) Reload nginx
echo "[5/6] reload nginx"
systemctl reload nginx

### 6) Done
echo "[6/6] DONE"
echo "Frontend : https://$SITE/aiaquila/"
echo "RSS API  : https://$SITE/aiaquila/api/rss"
echo "Health   : https://$SITE/aiaquila/health/"
BASH

chmod +x /root/AIAQUILA_FINAL_FIX.sh
/root/AIAQUILA_FINAL_FIX.sh
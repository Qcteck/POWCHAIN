cat >"$VAULT_DIR/server.js"<<'EOF'
const http = require("http");
const { URL } = require("url");
const fs = require("fs");
const path = require("path");
const bs58 = require("bs58");
const { Keypair } = require("@solana/web3.js");

const HOST = process.env.HOST || "127.0.0.1";
const PORT = Number(process.env.PORT || "8787");
const STATE_DIR = process.env.STATE_DIR || path.join(__dirname, "state");
const STATE_FILE = process.env.STATE_FILE || path.join(STATE_DIR, "state.json");

fs.mkdirSync(STATE_DIR, { recursive: true });

function loadState() {
  try {
    const raw = fs.readFileSync(STATE_FILE, "utf8");
    const j = JSON.parse(raw);
    if (j && typeof j === "object") return j;
  } catch {}
  return { vaults: {}, createdAt: new Date().toISOString() };
}
function saveState(s) {
  fs.writeFileSync(STATE_FILE, JSON.stringify(s, null, 2));
}

function send(res, code, obj) {
  const body = JSON.stringify(obj);
  res.writeHead(code, {
    "content-type": "application/json; charset=utf-8",
    "cache-control": "no-store"
  });
  res.end(body);
}

function readJson(req) {
  return new Promise((resolve, reject) => {
    let data = "";
    req.on("data", (c) => {
      data += c;
      if (data.length > 1_000_000) { reject(new Error("payload_too_large")); req.destroy(); }
    });
    req.on("end", () => {
      if (!data) return resolve({});
      try { resolve(JSON.parse(data)); } catch (e) { reject(new Error("bad_json")); }
    });
  });
}

// minimal rate limit (per IP, 60 req / 10 min)
const RL = new Map();
function rateLimit(ip) {
  const now = Date.now();
  const win = 10 * 60 * 1000;
  const lim = 60;
  const rec = RL.get(ip) || { t: now, n: 0 };
  if (now - rec.t > win) { rec.t = now; rec.n = 0; }
  rec.n++;
  RL.set(ip, rec);
  return rec.n <= lim;
}

const server = http.createServer(async (req, res) => {
  const u = new URL(req.url, "http://x");
  const ip = (req.headers["x-forwarded-for"] || "").toString().split(",")[0].trim() || req.socket.remoteAddress || "unknown";

  if (!rateLimit(ip)) return send(res, 429, { ok:false, error:"rate_limited" });

  if (req.method === "GET" && u.pathname === "/health") {
    return send(res, 200, { ok:true, service:"vault-api", host:HOST, port:PORT });
  }

  if (req.method === "POST" && u.pathname === "/create") {
    let body;
    try { body = await readJson(req); } catch (e) { return send(res, 400, { ok:false, error: e.message }); }

    const userPub = (body.userPub || body.pub || body.owner || "").toString().trim();
    const state = loadState();
    state.vaults = state.vaults || {};

    // If userPub provided and already has vault, reuse
    if (userPub && state.vaults[userPub] && state.vaults[userPub].vaultPub) {
      return send(res, 200, { ok:true, userPub, vaultPub: state.vaults[userPub].vaultPub, existing:true });
    }

    // Generate real Solana keypair
    const kp = Keypair.generate();
    const vaultPub = kp.publicKey.toBase58();
    const secret58 = bs58.encode(Buffer.from(kp.secretKey)); // 64 bytes

    // Store mapping (keep it minimal)
    const key = userPub || `anon:${vaultPub}`;
    state.vaults[key] = { vaultPub, secret58, createdAt: new Date().toISOString() };
    saveState(state);

    return send(res, 200, { ok:true, userPub: userPub || null, vaultPub, existing:false });
  }

  return send(res, 404, { ok:false, error:"not_found" });
});

server.listen(PORT, HOST, () => {
  console.log(JSON.stringify({ ok:true, service:"vault-api", host:HOST, port:PORT }));
});
EOF


set -euo pipefail

echo "=== 1) Trouver TOUS les server_name fireinners.online en conf effective ==="
nginx -T 2>/dev/null | grep -nE 'conflicting server name|server_name (fireinners\.online|www\.fireinners\.online)' | head -n 200
echo

echo "=== 2) Trouver dans quels fichiers ça se trouve ==="
grep -RIn --line-number -E 'server_name\s+(fireinners\.online|www\.fireinners\.online)\b' /etc/nginx | head -n 200
echo

echo "=== 3) Lister tous les vhosts qui écoutent 443 ==="
grep -RIn --line-number -E 'listen\s+443\b' /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | head -n 200
echo

echo "=== 4) Désactiver les doublons (on garde fireinners.online-ssl uniquement) ==="
mkdir -p /etc/nginx/sites-disabled
# Désactive tout fichier (hors fireinners.online-ssl) qui contient server_name fireinners
while IFS= read -r f; do
  [ -f "$f" ] || continue
  base="$(basename "$f")"
  if [ "$base" != "fireinners.online-ssl" ]; then
    echo "MOVE DUP: $f -> /etc/nginx/sites-disabled/$base.$(date +%s)"
    mv "$f" "/etc/nginx/sites-disabled/$base.$(date +%s)" || true
  fi
done < <(grep -RIl -E 'server_name\s+(fireinners\.online|www\.fireinners\.online)\b' /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | sort -u)

echo "=== 5) Test + reload ==="
nginx -t
systemctl reload nginx
echo "OK: nginx reloaded"

echo "=== 6) Re-test LOCAL avec SNI correct ==="
curl -k -sS -i --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/ | head -n 8
echo
curl -k -sS -i --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/traderone/api/health | head -n 15
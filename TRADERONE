bash -lc 'cat >/root/WOLVERINE_FIX_API_PROXY_v3.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="$(hostname -f 2>/dev/null || hostname)"
LOG="/root/WOLVERINE_FIX_API_PROXY_v3_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

need(){ command -v "$1" >/dev/null 2>&1 || { echo "Missing: $1"; exit 1; }; }

echo "=== WOLVERINE_FIX_API_PROXY_v3 :: $TS :: $HOST ==="
echo "Log: $LOG"
echo

if [ "${EUID:-$(id -u)}" -ne 0 ]; then echo "ERROR: run as root"; exit 1; fi

need nginx
need systemctl
need curl
need python3
need cp
need mkdir
need chmod
need grep
command -v chattr >/dev/null 2>&1 || true

ROOT="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
API_PORT="3000"

backup_file(){ [ -f "$1" ] && cp -a "$1" "$1.bak_${TS}" && echo "Backup: $1 -> $1.bak_${TS}" || true; }
unfreeze(){ [ -e "$1" ] && chattr -i "$1" 2>/dev/null || true; }
refreeze(){ [ -e "$1" ] && chattr +i "$1" 2>/dev/null || true; }

echo "Paths:"
echo "  ROOT=$ROOT"
echo "  VHOST=$VHOST"
echo "  INC=$INC"
echo "  API_PORT=$API_PORT"
echo

echo "== 1) Sanity: backend direct (must be JSON) =="
curl -sS -i "http://127.0.0.1:${API_PORT}/health" | head -n 40 || true
echo

echo "== 2) Rewrite nginx include (bash must NOT expand nginx variables) =="
mkdir -p "$(dirname "$INC")"
backup_file "$INC"
unfreeze "$INC"

# NOTE: <<'EOF' prevents bash from expanding nginx $uri/$host/... even under set -u
cat >"$INC" <<'"'"'EOF'"'"'
# AUTOGENERATED :: WOLVERINE ROUTES + API PROXY (SAFE)
# This file intentionally contains nginx $variables.

location = /wolverine { return 301 /wolverine/; }

location = /wolverine/__wolverine_ok.txt {
  alias __ROOT__/__wolverine_ok.txt;
  add_header Cache-Control "no-store" always;
}

location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

location ^~ /wolverine/_next/ {
  alias __ROOT__/_next/;
  try_files $uri $uri/ =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

location ^~ /wolverine/vendor/ {
  alias __ROOT__/vendor/;
  try_files $uri =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# API must win over /wolverine/
location ^~ /wolverine/traderone/api/ {
  rewrite ^/wolverine/traderone/api/?(.*)$ /$1 break;
  proxy_pass http://127.0.0.1:__API_PORT__/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 60s;
}

location ^~ /wolverine/ {
  alias __ROOT__/;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
EOF

python3 - <<PY
from pathlib import Path
p=Path("$INC")
s=p.read_text()
s=s.replace("__ROOT__", "$ROOT").replace("__API_PORT__", "$API_PORT")
p.write_text(s)
print("OK: include written + placeholders replaced")
PY

chmod 644 "$INC" || true
echo "Wrote: $INC"
echo

echo "== 3) Ensure include is inside SSL 443 server block for fireinners.online =="
if [ ! -f "$VHOST" ]; then echo "ERROR: missing vhost $VHOST"; exit 1; fi
backup_file "$VHOST"
unfreeze "$VHOST"

python3 - <<PY
from pathlib import Path
p=Path("$VHOST")
lines=p.read_text(errors="ignore").splitlines()

inc_line=f"include $INC;"
out=[]
i=0
n=len(lines)

def is_ssl_443(t:str)->bool:
    return ("listen" in t and "443" in t and "ssl" in t)

def has_name(t:str)->bool:
    return ("server_name" in t and "fireinners.online" in t)

while i<n:
    line=lines[i]
    if "server" in line and "{" in line:
        depth=0
        block=[]
        while i<n:
            ln=lines[i]
            block.append(ln)
            depth += ln.count("{")
            depth -= ln.count("}")
            i+=1
            if depth==0:
                break
        txt="\n".join(block)
        if is_ssl_443(txt) and has_name(txt):
            if inc_line not in txt:
                for j in range(len(block)-1,-1,-1):
                    if "}" in block[j]:
                        block.insert(j,"    "+inc_line)
                        break
        out.extend(block)
    else:
        out.append(line)
        i+=1

p.write_text("\n".join(out)+ "\n")
print("OK: include ensured in SSL 443 server{}")
PY
echo

echo "== 4) Verify nginx sees API location =="
nginx -T 2>/dev/null | grep -n "/wolverine/traderone/api/" || true
echo

echo "== 5) nginx -t + reload =="
nginx -t
systemctl reload nginx || systemctl restart nginx
echo "OK: nginx reloaded"
echo

echo "== 6) Tests via nginx proxy (MUST be JSON, not HTML) =="
echo "-- GET http://127.0.0.1/wolverine/traderone/api/health"
curl -sS -i "http://127.0.0.1/wolverine/traderone/api/health" | head -n 80 || true
echo

echo "-- POST http://127.0.0.1/wolverine/traderone/api/vault/create"
curl -sS -i -X POST "http://127.0.0.1/wolverine/traderone/api/vault/create" \
  -H "Content-Type: application/json" \
  -d "{\"pub\":\"\"}" | head -n 120 || true
echo

echo "== 7) External spot-check (Cloudflare) =="
echo "-- https://fireinners.online/wolverine/traderone/api/health"
curl -k -sS -i "https://fireinners.online/wolverine/traderone/api/health" | head -n 80 || true
echo

echo "-- https://fireinners.online/wolverine/traderone/api/vault/create (POST)"
curl -k -sS -i -X POST "https://fireinners.online/wolverine/traderone/api/vault/create" \
  -H "Content-Type: application/json" \
  -d "{\"pub\":\"\"}" | head -n 120 || true
echo

echo "== 8) Re-freeze (best-effort) =="
refreeze "$VHOST"
refreeze "$INC"
echo "Done."
echo "Log: $LOG"
BASH
chmod +x /root/WOLVERINE_FIX_API_PROXY_v3.sh
/root/WOLVERINE_FIX_API_PROXY_v3.sh'
bash -c "$(cat <<'BASH'
set -euo pipefail
HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

echo "=== FRONTEND SPL DEBUG MODE ==="
cp "$HTML" "$HTML.debug_$TS"

cat >"$HTML" <<'HTML'
<!DOCTYPE html><html><head><meta charset="utf-8"/>
<title>Wolverine Wallet DEBUG</title>
<style>
body{background:#0b0b0b;color:#0ff;font-family:Arial}
#w{max-width:700px;margin:40px auto;padding:20px;border:1px solid #0ff;border-radius:8px}
button{width:100%;padding:12px;margin-top:10px;background:#0ff;border:0;font-weight:bold}
pre{white-space:pre-wrap;background:#000;padding:10px;margin-top:10px;border:1px solid #0ff;font-size:12px}
</style>
<script src="/wolverine/vendor/solana-web3.min.js"></script>
</head>
<body>
<div id="w">
<button id="c">Connect Phantom</button>
<button id="d" style="display:none">Disconnect</button>
<div>Address: <span id="a">-</span></div>
<div>SOL: <span id="s">-</span></div>
<div>USDC (calc): <span id="u">-</span></div>
<h3>RAW TOKEN ACCOUNTS (frontend)</h3>
<pre id="raw">-</pre>
</div>

<script>
const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const conn=new solanaWeb3.Connection(RPC,"confirmed");

c.onclick=async()=>{
 if(!window.solana||!solana.isPhantom){alert("Phantom missing");return;}
 const r=await solana.connect();
 const pub=r.publicKey;
 a.textContent=pub.toString();

 const lamports=await conn.getBalance(pub);
 s.textContent=(lamports/1e9).toFixed(6);

 const all=await conn.getParsedTokenAccountsByOwner(
   pub,{programId:new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")}
 );

 raw.textContent=JSON.stringify(all.value.map(x=>x.account.data.parsed.info),null,2);

 let tot=0;
 all.value.forEach(x=>{
  const info=x.account.data.parsed.info;
  if(info.mint===USDC){
    const ta=info.tokenAmount;
    tot+=Number(ta.amount)/Math.pow(10,ta.decimals);
  }
 });
 u.textContent=tot.toFixed(2);

 c.style.display="none";d.style.display="block";
};

d.onclick=async()=>{
 await solana.disconnect();
 a.textContent=s.textContent=u.textContent=raw.textContent="-";
 d.style.display="none";c.style.display="block";
};
</script>
</body></html>
HTML

echo "=== DEBUG PAGE ACTIVE ==="
echo "➡️ CONNECT WALLET, COPIE LE CONTENU 'RAW TOKEN ACCOUNTS'"
BASH
)"
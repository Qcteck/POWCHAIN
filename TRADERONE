onst dt=(b.t-a.t)/1000;if(dt<=0)return null;const dp=b.p-a.p;return {usdps:dp/dt,pctps:(a.p? (dp/a.p)/dt : 0)}};const triUpdate=()=>{const s=st.samples;if(s.length<2)return;const now=Date.now();let a=s[0];for(let i=0;i<s.length;i++){if(now-s[i].t>=60000){a=s[i];break}}const b=s[s.length-1];const dtMin=Math.max(1e-6,(b.t-a.t)/60000);const dtScaled=dtMin*TIME_SCALE;const dp=b.p-a.p;const dpct=(a.p? (dp/a.p)*100 : 0);const triPct=Math.hypot(dpct,dtScaled);const triUsd=Math.hypot(dp,dtScaled);const mix=Math.hypot(triPct*cfg.triW,triUsd*(1-cfg.triW));st.triPct=triPct;st.triUsd=triUsd;st.triMix=mix};async function tickOnce(){const j=await fetchJson("https://api.dexscreener.com/latest/dex/tokens/"+encodeURIComponent(mint),3);const pair=pickPair(j.pairs);if(!pair)return {ok:false,err:"no pair"};const p=num(pair.priceUsd);if(p==null)return {ok:false,err:"no price"};const v5=num(pair.volume&&pair.volume.m5);const buys=num(pair.txns&&pair.txns.m5&&pair.txns.m5.buys);const sells=num(pair.txns&&pair.txns.m5&&pair.txns.m5.sells);st.lastPrice=p;st.lastSnap={url:pair.url||"",liq:(pair.liquidity&&pair.liquidity.usd)||0,vol5:v5||0,buys:buys||0,sells:sells||0};pushSample(p);triUpdate();const ts=Date.now();let totalScore=0,totalW=0,Pi=[0,0,0],TrW=0,TrAgg=0,R2W=0,R2Agg=0,PyW=0,PyAgg=0,ChW=0,ChAgg=0;for(const t of tfs){const b=bucket(ts,t.sec);if(!t.candle||t.candle.b!==b){if(t.candle){const close=t.candle.c;t.emaF=ema(t.emaF,close,cfg.emaFast);t.emaS=ema(t.emaS,close,cfg.emaSlow);const rsi=rsiW(t,close);const bb=boll(t,close);const imb=imbLog(buys,sells);const vr=volRel(t,v5);const obs={p:close,emaF:t.emaF,emaS:t.emaS,rsi,bb,imb,vr};let score=tfScore(obs);const py=pythVol(t,obs);t.lastPyAvg=py.avg;const lam=chaosLyap(t,py.d);t.lastCha=lam;const tr=pushReg(t,close);if(tr&&tr.r2>=cfg.regR2Min){const boost=Math.min(cfg.regCap,Math.abs(tr.slopeSec)*cfg.regK*60)*tr.r2;score+=(tr.slopeSec>=0?1:-1)*boost}const pyPenalty=Math.min(cfg.pyCap,(py.avg==null?0:py.avg*cfg.pyK));const chaPenalty=Math.
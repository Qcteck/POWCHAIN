from pathlib import Path
p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")

old = 'pubkey: window.solana.publicKey.toString(),\\n\\s*budgetSol: b'
new = 'from: window.solana.publicKey.toString(),\\n      amount: b'

if "amount: b" in s:
    print("✔ Payload déjà corrigé")

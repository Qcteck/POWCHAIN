set -euo pipefail
TS="$(date +%s)"
DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/wolv_rpc_proxy.conf"
DUMP="/tmp/nginxT.$TS.txt"

echo "== 0) snippet RPC (avec header preuve) =="
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'EOF'
# Wolverine: Solana RPC proxy (same-origin)
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  add_header X-Wolv-RPC "1" always;

  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF

echo "== 1) Dump config finale nginx =="
nginx -T > "$DUMP" 2>&1

echo "== 2) Trouver le VRAI vhost (1er server{} qui match server_name $DOMAIN + listen 443) =="
TARGET="$(python3 - <<'PY'
import re, sys
dump=open(sys.argv[1],'r',errors='ignore').read().splitlines()
cur=None
i=0
while i<len(dump):
    line=dump[i]
    m=re.match(r'^# configuration file (.+):$', line)
    if m: cur=m.group(1).strip()
    if 'server' in line and re.search(r'^\s*server\s*\{', line):
        # collect server block from this line until braces balanced (in nginx -T dump)
        br=0; j=i; block=[]
        while j<len(dump):
            l=dump[j]
            br += l.count('{') - l.count('}')
            block.append(l)
            if br==0 and j>i: break
            j+=1
        txt="\n".join(block)
        if re.search(r'listen\s+443', txt) and re.search(r'server_name\s+.*\bfireinners\.online\b', txt):
            print(cur or "")
            sys.exit(0)
        i=j
    i+=1
print("")
PY
"$DUMP")"

echo "TARGET=$TARGET"
[ -n "${TARGET:-}" ] || { echo "ERR: impossible de trouver le server 443 actif pour $DOMAIN"; exit 1; }
[ -f "$TARGET" ] || { echo "ERR: fichier TARGET introuvable sur disque: $TARGET"; exit 1; }

echo "== 3) Inject include snippet dans TARGET (si absent) =="
cp -a "$TARGET" "$TARGET.bak.$TS"

python3 - <<'PY'
import sys,re
target=sys.argv[1]
snip='/etc/nginx/snippets/wolv_rpc_proxy.conf'
s=open(target,'r',errors='ignore').read().splitlines(True)

# si déjà inclus, stop
for line in s:
    if re.search(r'include\s+'+re.escape(snip)+r'\s*;', line):
        print("OK: include déjà présent")
        sys.exit(0)

out=[]
i=0
while i<len(s):
    out.append(s[i])
    # inject juste après la ligne server_name fireinners.online (dans ce fichier)
    if re.search(r'\bserver_name\b.*\bfireinners\.online\b', s[i]) and not any('wolv_rpc_proxy.conf' in x for x in out[-5:]):
        out.append("  include /etc/nginx/snippets/wolv_rpc_proxy.conf;\n")
        # inject une seule fois
        out.extend(s[i+1:])
        break
    i+=1

open(target,'w').write(''.join(out))
print("Injected include into:", target)
PY
"$TARGET"

echo "== 4) nginx test + reload =="
nginx -t
systemctl reload nginx

echo "== 5) TEST (doit montrer X-Wolv-RPC: 1 et PAS 404) =="
curl -ksS -i "https://$DOMAIN/wolverine/traderone/api/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 60
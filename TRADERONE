cat >/root/clean_solana_rpc_conf.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"

echo "== Backup =="
cp -a "$SNIP" "${SNIP}.bak_${TS}"
echo "Saved: ${SNIP}.bak_${TS}"

echo
echo "== Rewrite solana_rpc_proxy.conf (ONLY /wolverine/rpc) =="
cat >"$SNIP" <<'EOF'
# Include INSIDE server{} only.

# Solana JSON-RPC proxy for the UI / Phantom
location = /wolverine/rpc {
  auth_basic off;
  allow all;

  add_header Access-Control-Allow-Origin "*" always;
  add_header Access-Control-Allow-Headers "*" always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;

  if ($request_method = OPTIONS) { return 204; }

  # Avoid upstream WAF rejecting browser / Phantom headers
  proxy_set_header Origin "";
  proxy_set_header Referer "";
  proxy_set_header Sec-Fetch-Site "";
  proxy_set_header Sec-Fetch-Mode "";
  proxy_set_header Sec-Fetch-Dest "";
  proxy_set_header Connection "";
  # proxy_set_header User-Agent "curl/8.5.0";

  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_http_version 1.1;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;
}
EOF

echo
echo "== Kill /solana-rpc duplicates (comment them everywhere, keep none) =="
# If you still need /solana-rpc later, we can re-add it ONCE in the vhost.
grep -RIn --exclude='*.bak*' --exclude-dir='_saved_*' \
  -E '^[[:space:]]*location[[:space:]].*/solana-rpc' \
  /etc/nginx/sites-enabled /etc/nginx/snippets /etc/nginx/conf.d 2>/dev/null || true

# comment any active /solana-rpc location lines
while IFS= read -r hit; do
  file="${hit%%:*}"
  rest="${hit#*:}"
  line="${rest%%:*}"
  cp -a "$file" "${file}.bak_${TS}"
  sed -i "${line}s@^[[:space:]]*@# DISABLED_SOLANA_RPC_${TS} @" "$file"
  echo "Disabled: $file:$line"
done < <(
  grep -RIn --exclude='*.bak*' --exclude-dir='_saved_*' \
    -E '^[[:space:]]*location[[:space:]].*/solana-rpc' \
    /etc/nginx/sites-enabled /etc/nginx/snippets /etc/nginx/conf.d 2>/dev/null || true
)

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx

echo "DONE ✅"
BASH

chmod +x /root/clean_solana_rpc_conf.sh
/root/clean_solana_rpc_conf.sh
bash <<'BASH'
set -euo pipefail

HTML="/var/www/wolverine/index.html"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== [1] Vérifications =="
test -f "$HTML" || { echo "❌ index.html introuvable"; exit 1; }

echo "== [2] Backup frontend =="
cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup: ${HTML}.bak_${TS}"

echo "== [3] Patch frontend (API + payload) =="
python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")
orig=s

# Forcer l'URL API correcte
import re
s=re.sub(r'const\s+API\s*=\s*["\'][^"\']+["\']','const API="/wolverine/traderone/api/budget"',s)

# Normaliser le payload -> { from, amount }
# Remplace tout body: JSON.stringify({...}) par la version canonique
s=re.sub(
    r'body\s*:\s*JSON\.stringify\(\s*\{[^}]*\}\s*\)',
    'body: JSON.stringify({ from: window.solana.publicKey.toString(), amount: b })',
    s,
    flags=re.S
)

if s==orig:
    print("⚠ Aucun changement détecté (déjà conforme ?)")
else:
    p.write_text(s)
    print("✔ Frontend corrigé")
PY

echo "== [4] Test nginx =="
nginx -t

echo "== [5] Reload nginx =="
systemctl reload nginx

echo "== [6] Test API locale =="
curl -s http://127.0.0.1:3000/wolverine/traderone/api/health | grep ok && echo "✔ API locale OK" || echo "❌ API locale NOK"

echo "== [7] Test API publique =="
curl -s https://fireinners.online/wolverine/traderone/api/health | grep ok && echo "✔ API publique OK" || echo "❌ API publique NOK"

echo "== TERMINÉ =="
echo "➡ UI prête : bouton 'Envoyer à TraderOne' doit maintenant renvoyer du JSON"
BASH
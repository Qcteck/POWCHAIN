
# BATCH_FLY_probe.sh (préflight read-only)
set -euo pipefail
echo "==================== PROBE BATCH FLY (READ-ONLY) ===================="
date -u || true
echo
hostnamectl 2>/dev/null || true
echo
echo "[OS]"; (lsb_release -ds 2>/dev/null || (grep PRETTY_NAME /etc/os-release 2>/dev/null|cut -d= -f2|tr -d '"')) || true
echo "[KERNEL]"; uname -r || true
echo
echo "[BIN] node/nginx/systemctl/openssl/curl"
for b in node nginx systemctl openssl curl ss ufw; do command -v "$b" >/dev/null 2>&1 && echo "OK $b=$( ($b -v 2>/dev/null || $b version 2>/dev/null || echo present) | head -n 1 )" || echo "MISS $b"; done
echo
echo "[PORT] 9696 listening?"
(ss -ltnpH 2>/dev/null | grep -E '(:9696)\b' && echo "WARN: 9696 already in use") || echo "OK: 9696 free"
echo
echo "[NGINX] config test"
(nginx -t 2>&1 | sed -n '1,6p') || true
echo
echo "[UFW] status (read-only)"
(ufw status verbose 2>/dev/null | sed -n '1,80p') || echo "UFW not accessible"
echo
echo "[SITES] candidate vhosts"
ls -1 /etc/nginx/sites-enabled 2>/dev/null || true
echo
echo "[TARGET] best guess vhost file"
if [ -f /etc/nginx/sites-available/fireinners.online-ssl ]; then echo "/etc/nginx/sites-available/fireinners.online-ssl"; elif [ -f /etc/nginx/sites-enabled/fireinners.online-ssl ]; then echo "/etc/nginx/sites-enabled/fireinners.online-ssl"; else echo "NOT FOUND (you will need to set VHOST_FILE in mega batch)"; fi
echo
echo "DONE. If MISS binaries or nginx -t not OK, fix before mega batch."





sudo bash BATCH_FLY_probe.sh
sudo bash MEGA_BATCH_probe.sh







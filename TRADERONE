cat >/root/push_github_with_pat_basic.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

REPO="Qcteck/WOLVERINE1"
EXPORT="/opt/WOLVERINE1_export"
cd "$EXPORT"

echo "== 1) Enter PAT (hidden) =="
read -s -p "PAT: " PAT; echo
[ -n "$PAT" ] || { echo "Empty PAT"; exit 1; }

echo "== 2) Purge cached credentials (common cause of 'invalid credentials') =="
rm -f /root/.git-credentials 2>/dev/null || true
git config --global --unset credential.helper 2>/dev/null || true
git config --global --unset-all credential.helper 2>/dev/null || true

echo "== 3) Ensure origin =="
git remote remove origin 2>/dev/null || true
git remote add origin "https://github.com/${REPO}.git"
git branch -M main 2>/dev/null || true

echo "== 4) Push using BASIC auth header (no prompt) =="
B64="$(printf 'x-access-token:%s' "$PAT" | base64 -w0 2>/dev/null || printf 'x-access-token:%s' "$PAT" | base64)"
git -c http.https://github.com/.extraheader="AUTHORIZATION: basic ${B64}" push -u origin main

echo "DONE ✅ pushed"
BASH

chmod +x /root/push_github_with_pat_basic.sh
/root/push_github_with_pat_basic.sh
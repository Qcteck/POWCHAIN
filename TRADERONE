bash <<'EOF'
set -e

echo "=== AIAQUILA RSS FIX — INSTALLATION ==="

# 1) Dépendances
apt update -y
apt install -y php php-curl nginx

# 2) Dossier
ROOT=/var/www/aiaquila
mkdir -p $ROOT
chown -R www-data:www-data $ROOT

# 3) Proxy PHP RSS (CORS OK)
cat > $ROOT/rss-proxy.php <<'PHP'
<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/xml; charset=UTF-8");

if (!isset($_GET["url"])) {
  http_response_code(400);
  echo "<error>missing url</error>";
  exit;
}

$ch = curl_init($_GET["url"]);
curl_setopt_array($ch, [
  CURLOPT_RETURNTRANSFER => true,
  CURLOPT_FOLLOWLOCATION => true,
  CURLOPT_TIMEOUT => 15,
  CURLOPT_USERAGENT => "Mozilla/5.0 (AIAQUILA RSS)"
]);

$data = curl_exec($ch);
curl_close($ch);

if (!$data) {
  http_response_code(502);
  echo "<error>fetch failed</error>";
  exit;
}

echo $data;
PHP

# 4) Frontend HTML RSS RÉEL
cat > $ROOT/index.html <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{background:#111;color:#eee;font-family:Arial;padding:20px}
button{padding:10px;font-size:16px}
#articles div{margin:6px 0}
pre{background:#000;padding:10px}
</style>

<h1>🦅 AIAQUILA — RSS réel</h1>
<button onclick="loadRSS()">Lire les articles</button>

<pre id="log"></pre>
<div id="articles"></div>

<script>
const FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://news.bitcoin.com/feed/"
];

const PROXY = "./rss-proxy.php?url=";
let ARTICLES = [];

async function loadRSS(){
  ARTICLES=[];
  log("Démarrage RSS...");
  for(const feed of FEEDS){
    try{
      const r = await fetch(PROXY+encodeURIComponent(feed));
      const t = await r.text();
      const xml = new DOMParser().parseFromString(t,"text/xml");
      const items=[...xml.querySelectorAll("item"),...xml.querySelectorAll("entry")];
      log("Flux "+feed+" → "+items.length+" articles");
      items.forEach(i=>{
        const title=i.querySelector("title")?.textContent?.trim();
        if(title) ARTICLES.push(title);
      });
    }catch(e){
      log("Erreur flux "+feed);
    }
  }
  log("TOTAL: "+ARTICLES.length+" articles");
  render();
}

function render(){
  const d=document.getElementById("articles");
  d.innerHTML="";
  ARTICLES.forEach(t=>{
    const x=document.createElement("div");
    x.textContent="• "+t;
    d.appendChild(x);
  });
}

function log(m){
  document.getElementById("log").textContent+=m+"\\n";
}
</script>
</html>
HTML

# 5) Permissions
chown -R www-data:www-data $ROOT
chmod 755 $ROOT
chmod 644 $ROOT/*

# 6) Reload nginx
nginx -t && systemctl reload nginx

echo "=== OK ==="
echo "Ouvre : https://fireinners.online/aiaquila/"
EOF
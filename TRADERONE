set -euo pipefail
SVC=amcq
MPID="$(systemctl show -p MainPID --value $SVC)"
PORT="$(ss -lntp | sed -n "s/.*127\\.0\\.0\\.1:\\([0-9]\\+\\).*pid=$MPID,.*/\\1/p" | head -n1)"
echo "MainPID=$MPID PORT=$PORT"
for P in /health /status /api/status /ping; do
  echo "-- $P"
  curl -m 2 -sS -i "http://127.0.0.1:$PORT$P" | head -n 8 || true
done
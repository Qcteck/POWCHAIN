cat >/tmp/WOLVERINE_PATCH_RIGHT_VHOST_AND_TEST.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
PORT_BACKEND="9696"   # TraderOne node détecté chez toi

echo "== 1) LISTEN (nginx + ports) =="
ss -lntp | egrep ':(80|443|8080|8443|8880|8585|9696)\s' || true
echo

echo "== 2) Trouver le fichier nginx qui contient server_name $DOMAIN =="
CONF="$(nginx -T 2>/dev/null | awk '
  /^# configuration file / {file=$4; sub(":$","",file)}
  $0 ~ "server_name" && $0 ~ "'"$DOMAIN"'" {print file; exit}
')"
echo "CONF=$CONF"
[ -n "${CONF:-}" ] && [ -f "$CONF" ] || { echo "ERROR: conf introuvable pour $DOMAIN"; exit 1; }
echo

echo "== 3) Ajoute le proxy API dans CE server{} (si absent) =="
TS="$(date +%s)"
cp -a "$CONF" "$CONF.bak.$TS"

if grep -q "WOLVERINE_TRADERONE_API_BEGIN" "$CONF"; then
  echo "Block déjà présent, skip."
else
  awk -v domain="$DOMAIN" -v port="$PORT_BACKEND" '
  BEGIN{in_server=0; has_domain=0; inserted=0}
  {
    line=$0
    if ($0 ~ /^[[:space:]]*server[[:space:]]*\{/){ in_server=1; has_domain=0 }
    if (in_server && $0 ~ /server_name/ && $0 ~ domain){ has_domain=1 }

    if (in_server && has_domain && $0 ~ /^[[:space:]]*\}[[:space:]]*$/ && inserted==0){
      print ""
      print "  # WOLVERINE_TRADERONE_API_BEGIN"
      print "  location ^~ /wolverine/traderone/api/ {"
      print "    proxy_http_version 1.1;"
      print "    proxy_set_header Host $host;"
      print "    proxy_set_header X-Real-IP $remote_addr;"
      print "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
      print "    proxy_set_header X-Forwarded-Proto $scheme;"
      print "    proxy_pass http://127.0.0.1:" port "/api/;"
      print "  }"
      print "  # WOLVERINE_TRADERONE_API_END"
      print ""
      inserted=1
    }

    print line
    if (in_server && $0 ~ /^[[:space:]]*\}[[:space:]]*$/){ in_server=0 }
  }' "$CONF.bak.$TS" > "$CONF"
fi

nginx -t && systemctl reload nginx
echo

echo "== 4) Détecte sur quel port nginx écoute (http) pour tester localement =="
# on prend le premier port d'écoute nginx (80/8080/8880) si dispo
TEST_PORT="$(ss -lntp | awk '/nginx/ && ($4 ~ /:80$/ || $4 ~ /:8080$/ || $4 ~ /:8880$/){split($4,a,":"); print a[length(a)]; exit}')"
[ -n "${TEST_PORT:-}" ] || { echo "ERROR: je ne vois pas nginx écouter sur 80/8080/8880"; exit 2; }

echo "TEST_PORT=$TEST_PORT"
echo

echo "== 5) TEST local (doit commencer par { ) =="
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
curl -sS -D- "http://127.0.0.1:${TEST_PORT}/wolverine/traderone/api/balances2?wallet=$WALLET" \
  -H "Host: $DOMAIN" | head -c 400
echo
echo "DONE ✅"
SH

bash /tmp/WOLVERINE_PATCH_RIGHT_VHOST_AND_TEST.sh
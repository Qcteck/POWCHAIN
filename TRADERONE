cat >/root/wvfix.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST_AV="/etc/nginx/sites-available/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/WVFIX_${TS}"
VAULT_PORT="8787"

say(){ echo "[$(date +%H:%M:%S)] $*"; }
need_root(){ [ "$(id -u)" = "0" ] || { echo "ROOT only"; exit 1; }; }

unfreeze(){
  command -v chattr >/dev/null 2>&1 || return 0
  for p in /etc/nginx/sites-available /etc/nginx/sites-enabled /etc/nginx/includes /etc/nginx/snippets /etc/nginx/nginx.conf; do
    [ -e "$p" ] || continue
    say "chattr -i (best-effort) $p"
    find "$p" -xdev -print0 2>/dev/null | xargs -0 -r chattr -i 2>/dev/null || true
  done
}

backup(){
  say "Backup => $BK"
  mkdir -p "$BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  mkdir -p "$BK/www"
  cp -a "$WEBROOT" "$BK/www/wolverine" 2>/dev/null || true
}

ensure_webroot(){
  mkdir -p "$WEBROOT"
  if [ ! -f "$WEBROOT/index.html" ]; then
    say "Create placeholder $WEBROOT/index.html"
    cat >"$WEBROOT/index.html"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WOLVERINE</title></head><body style="font-family:system-ui;padding:24px"><h1>WOLVERINE</h1><p>placeholder</p></body></html>
EOF
  fi
  say "Webroot content:"
  ls -la "$WEBROOT" | sed -n '1,30p' || true
}

disable_dup_vhosts(){
  say "Disable duplicate enabled vhosts for ${DOMAIN} (keep fireinners.online + fireinners.online-ssl)"
  shopt -s nullglob
  for f in /etc/nginx/sites-enabled/*; do
    [ -f "$f" ] || continue
    if grep -qE "server_name[[:space:]].*\\b${DOMAIN//./\\.}\\b" "$f"; then
      b="$(basename "$f")"
      if [ "$b" != "fireinners.online" ] && [ "$b" != "fireinners.online-ssl" ]; then
        say "Disable: $f"
        mv -f "$f" "$f.WV_DISABLED_${TS}" || true
      fi
    fi
  done
}

disable_other_wolverine_includes(){
  say "Disable other includes/snippets redefining /wolverine* (keep only $INC)"
  shopt -s nullglob
  for f in /etc/nginx/includes/* /etc/nginx/snippets/*; do
    [ -f "$f" ] || continue
    [ "$f" = "$INC" ] && continue
    if grep -qE "location[[:space:]]+\\^~[[:space:]]+/wolverine/|location[[:space:]]+=[[:space:]]+/wolverine\\b|/wolverine/vault-api/" "$f"; then
      say "Disable: $f"
      mv -f "$f" "$f.WV_DISABLED_${TS}" || true
    fi
  done
}

write_inc(){
  say "Write canonical include => $INC"
  mkdir -p "$(dirname "$INC")"
  cat >"$INC"<<EOF
# WV_CANONICAL ${TS}
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  alias ${WEBROOT}/;
  index index.html;
  try_files \$uri \$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:${VAULT_PORT}/;
}
location ^~ /wolverine/traderone/vault/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:${VAULT_PORT}/;
}
EOF
}

strip_old_wolverine_from_vhost(){
  say "Strip old wolverine include/location from vhost (best-effort)"
  [ -f "$VHOST_AV" ] || { say "ERROR: missing $VHOST_AV"; exit 1; }
  sed -i -E "/include[[:space:]]+[^;]*wolverine[^;]*;/d" "$VHOST_AV" || true
  python3 - <<PY
import re
p="${VHOST_AV}"
s=open(p,"r",encoding="utf-8",errors="ignore").read()
# remove any location blocks matching /wolverine*
pat=re.compile(r'\\blocation\\b[^\\n]*?(/wolverine[^\\s{]*)[^\\n]*\\{',re.I)
out=[]; i=0; n=len(s)
while True:
    m=pat.search(s,i)
    if not m: out.append(s[i:]); break
    out.append(s[i:m.start()])
    j=m.end()-1
    depth=0; k=j
    while k<n:
        if s[k]=='{': depth+=1
        elif s[k]=='}':
            depth-=1
            if depth==0: k+=1; break
        k+=1
    i=k
open(p,"w",encoding="utf-8").write("".join(out))
PY
}

inject_into_443(){
  say "Inject include into correct 443 server block in $VHOST_AV"
  grep -qF "include $INC;" "$VHOST_AV" && { say "Already injected"; return 0; }
  awk -v dom="$DOMAIN" -v inc="$INC" '
  BEGIN{inS=0;depth=0;is443=0;isDom=0;done=0;}
  function c(s,ch){ n=gsub(ch,"",s); return n }
  {
    line=$0
    if (line ~ /^[[:space:]]*server[[:space:]]*\{/){ inS=1; depth=1; is443=0; isDom=0; }
    if (inS){
      t=line
      depth += c(t,/\{/)-c(t,/\}/)
      if (line ~ /listen[[:space:]]+443/){ is443=1 }
      if (line ~ /server_name/ && line ~ dom){ isDom=1 }
    }
    print $0
    if (inS && !done && is443 && isDom && line ~ /server_name/ && line ~ dom){
      print "    include " inc ";"
      done=1
    }
    if (inS && depth<=0){ inS=0; depth=0; is443=0; isDom=0; }
  }' "$VHOST_AV" >"$VHOST_AV.tmp" && mv -f "$VHOST_AV.tmp" "$VHOST_AV"
  grep -nF "include $INC;" "$VHOST_AV" || true
}

reload_nginx(){
  say "nginx -t"
  nginx -t
  say "systemctl reload nginx"
  systemctl reload nginx || systemctl restart nginx
}

tests(){
  say "Port vault ${VAULT_PORT} listening?"
  ss -lntp | grep -q ":${VAULT_PORT} " && say "OK: listening" || say "WARN: not found"
  say "SNI TEST: /wolverine/ (HEAD)"
  curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n '1,12p' || true
  say "SNI TEST: /wolverine/ (first bytes)"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | head -c 200 || true; echo
  say "SNI TEST: /wolverine/vault-api/health (MUST JSON)"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/vault-api/health" || true; echo
}

main(){
  need_root
  backup
  unfreeze
  ensure_webroot
  disable_dup_vhosts
  disable_other_wolverine_includes
  write_inc
  strip_old_wolverine_from_vhost
  inject_into_443
  reload_nginx
  tests
  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
}
main "$@"
BASH
chmod +x /root/wvfix.sh
bash /root/wvfix.sh
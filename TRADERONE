PID=$(lsof -t -iTCP:3000 -sTCP:LISTEN | head -n1)
CWD=$(readlink -f /proc/$PID/cwd)
echo "PID=$PID"
echo "CWD=$CWD"

# Cherche le handler /api/status dans le code (JS/TS seulement)
grep -RIn --line-number \
  --exclude-dir=node_modules --exclude-dir=.git --exclude-dir=include \
  --exclude='*.bak*' --exclude='*.log' \
  -E 'app\.(get|post)\(\s*["'\'']\/api\/status|router\.(get|post)\(\s*["'\'']\/api\/status' \
  "$CWD" | head -n 30
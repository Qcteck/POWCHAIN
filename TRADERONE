cat >/root/WOLVERINE_FIX_BIND_PROPER.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
BACKUP="$HTML.fix_bind_$(date +%Y%m%d_%H%M%S)"

cp "$HTML" "$BACKUP"
echo "[OK] Backup $BACKUP"

perl -0777 -i -pe '
# 1) Supprime tous les onclick inline (sécurité)
s/\sonclick="[^"]*"//g;

# 2) Force refreshSOL global si présent
s/function\s+refreshSOL\s*\(/window.refreshSOL = async function(/g;

# 3) Injecte binder DOMContentLoaded propre
s#</script>#document.addEventListener("DOMContentLoaded",()=>{const btn=[...document.querySelectorAll("button")].find(b=>b.textContent.trim()==="Refresh");if(btn&&window.refreshSOL){btn.addEventListener("click",()=>{console.log("REFRESH CLICK OK");window.refreshSOL();});}});\n</script>#s
' "$HTML"

nginx -t && systemctl reload nginx
echo "DONE — CTRL+SHIFT+R"
BASH

chmod +x /root/WOLVERINE_FIX_BIND_PROPER.sh
/root/WOLVERINE_FIX_BIND_PROPER.sh
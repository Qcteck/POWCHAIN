cat >/root/FIX_WOLVERINE_NGINX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WOLVERINE_$TS"
mkdir -p "$BK"

echo "== BACKUP includes =="
cp -a /etc/nginx/includes "$BK/" || true
cp -a /etc/nginx/sites-available/fireinners.online-ssl "$BK/" || true

echo "== REMOVE ALL previous wolverine locations =="
for f in /etc/nginx/includes/*.inc; do
  sed -i '/location \^~ \/wolverine\//,/}/d' "$f" || true
done

sed -i '/location \^~ \/wolverine\//,/}/d' /etc/nginx/sites-available/fireinners.online-ssl || true

echo "== CREATE SINGLE canonical include =="
cat >/etc/nginx/includes/wolverine.inc <<'NGINX'
# WOLVERINE_CANONICAL_V1
location ^~ /wolverine/ {
    alias /var/www/wolverine/;
    try_files $uri $uri/ /wolverine/index.html;
    add_header Cache-Control "no-store" always;
}
NGINX

chmod 644 /etc/nginx/includes/wolverine.inc

echo "== ENSURE include is loaded ONCE =="
grep -q "wolverine.inc" /etc/nginx/sites-available/fireinners.online-ssl || \
sed -i '/server\s*{/a\    include /etc/nginx/includes/wolverine.inc;' \
/etc/nginx/sites-available/fireinners.online-ssl

echo "== RELOAD nginx =="
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
nginx -t
systemctl reload nginx
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true

echo "== DONE =="
echo "Backup in: $BK"
BASH

chmod +x /root/FIX_WOLVERINE_NGINX.sh
bash /root/FIX_WOLVERINE_NGINX.sh |& tee /root/FIX_WOLVERINE_NGINX.log
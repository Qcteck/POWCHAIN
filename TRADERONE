bash -c "$(cat <<'BASH'
set -euo pipefail

APP=/opt/wolverine
mkdir -p $APP
cd $APP

# server
cat > server.js <<'JS'
const express=require("express");
const {Connection,PublicKey}=require("@solana/web3.js");
const app=express();
app.use(express.json());

const RPC="https://api.mainnet-beta.solana.com";
const USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

app.get("/balances/:addr",async(req,res)=>{
 try{
  const conn=new Connection(RPC,"confirmed");
  const pub=new PublicKey(req.params.addr);

  const sol=(await conn.getBalance(pub))/1e9;

  let usdc=0;
  const accs=await conn.getParsedTokenAccountsByOwner(
    pub,
    {programId:new PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")}
  );
  accs.value.forEach(a=>{
    const i=a.account.data.parsed.info;
    if(i.mint===USDC){
      usdc+=Number(i.tokenAmount.uiAmount);
    }
  });

  res.json({sol,usdc});
 }catch(e){
  res.status(500).json({error:String(e)});
 }
});

app.listen(3010,()=>console.log("Wolverine balance API 3010"));
JS

npm init -y >/dev/null
npm install express @solana/web3.js >/dev/null

pkill -f server.js || true
node server.js &

# nginx
NG=/etc/nginx/sites-available/fireinners.online-ssl
grep -q wolverine/balances $NG || sed -i '/location \/wolverine {/a\\n    location /wolverine/balances/ {\n        proxy_pass http://127.0.0.1:3010/balances/;\n    }\n' $NG

nginx -t && systemctl reload nginx

echo "OK SERVER + API"
BASH
)"
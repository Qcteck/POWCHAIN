cat >/root/find_phantom_connect_in_ui.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

UI="/opt/WOLVERINE1_export/ui"

echo "== UI dir =="
ls -lah "$UI" | head -n 30 || true
echo

echo "== Search Phantom / window.solana / connect =="
grep -RIn --exclude-dir=.git --exclude-dir=node_modules \
  -E 'window\.solana|phantom|solana\.connect\(|connect\(\)|isPhantom|publicKey' \
  "$UI" | head -n 80 || true

echo
echo "DONE ✅ (paste the best matching line(s) here)"
BASH

chmod +x /root/find_phantom_connect_in_ui.sh
/root/find_phantom_connect_in_ui.sh
bash -lc 'set -euo pipefail; TS="$(date +%Y%m%d_%H%M%S)"; F="/root/MEGA_FIX_AIAQUILA_DUP_${TS}.sh"; cat >"$F"<<'"'"'EOF'"'"'
#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
say(){ printf "%s\n" "$*"; }

LOC="/aiaquila/api/rss"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGXCONF="/etc/nginx/nginx.conf"
INC_DIR="/etc/nginx/includes"
AQ_INC="$INC_DIR/aiaquila_routes.inc"
SNIP_DIR="/etc/nginx/snippets"
AQ_SNIP="$SNIP_DIR/aiaquila_locations.conf"

BK="/root/BK_FIX_AQ_DUP_$(date +%Y%m%d_%H%M%S)"
say "BACKUP -> $BK"
mkdir -p "$BK"
cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true

if command -v chattr >/dev/null 2>&1; then
  say "UNFREEZE chattr -i (best effort)"
  for f in "$NGXCONF" "$VHOST" /etc/nginx/snippets/* /etc/nginx/includes/* /etc/nginx/conf.d/* /etc/nginx/sites-available/* /etc/nginx/sites-enabled/*; do
    [ -e "$f" ] || continue
    chattr -i "$f" 2>/dev/null || true
  done
fi

say "ENSURE dirs"
mkdir -p "$INC_DIR" "$SNIP_DIR"

say "1) FORCE official AIAQUILA include (single source of truth)"
cat >"$AQ_INC"<<'INC'
# AIAQUILA routes (server-level include only)
# Keep ONLY location blocks here (no http{} / server{})

location ^~ /aiaquila/api/rss {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000;
}
INC

say "2) NEUTRALIZE snippet file that is breaking nginx (snippets MUST NOT carry active locations if included globally)"
if [ -f "$AQ_SNIP" ]; then cp -a "$AQ_SNIP" "$BK/" 2>/dev/null || true; fi
cat >"$AQ_SNIP"<<'TXT'
# (neutralized) do not define locations here
# Official include: /etc/nginx/includes/aiaquila_routes.inc
TXT

say "3) REMOVE/NEUTRALIZE any other duplicates of location $LOC everywhere except $AQ_INC"
python3 - <<'PY'
import glob, pathlib, re
LOC="/aiaquila/api/rss"
KEEP="/etc/nginx/includes/aiaquila_routes.inc"

paths=set()
paths.add("/etc/nginx/nginx.conf")
paths |= set(glob.glob("/etc/nginx/conf.d/*.conf"))
paths |= set(glob.glob("/etc/nginx/sites-available/*"))
paths |= set(glob.glob("/etc/nginx/sites-enabled/*"))
paths |= set(glob.glob("/etc/nginx/snippets/*.conf"))
paths |= set(glob.glob("/etc/nginx/includes/*.inc"))
paths |= set(glob.glob("/etc/nginx/includes/*.conf"))

def strip_dup_locations(text):
  lines=text.splitlines(True)
  out=[]
  i=0
  n=len(lines)
  rx=re.compile(r'^\s*location\s+.*\b'+re.escape(LOC)+r'\b.*\{', re.I)
  while i<n:
    if rx.search(lines[i]):
      # remove full location block
      brace = lines[i].count("{")-lines[i].count("}")
      j=i+1
      while j<n and brace>0:
        brace += lines[j].count("{")-lines[j].count("}")
        j+=1
      out.append(f"# (removed duplicate) location for {LOC}\n")
      i=j
    else:
      out.append(lines[i]); i+=1
  return "".join(out)

patched=[]
for fp in sorted(paths):
  if fp==KEEP: 
    continue
  p=pathlib.Path(fp)
  if not p.exists() or not p.is_file():
    continue
  t=p.read_text(encoding="utf-8", errors="ignore")
  nt=strip_dup_locations(t)
  if nt!=t:
    p.write_text(nt, encoding="utf-8")
    patched.append(fp)

print("OK removed duplicates in", len(patched), "files")
for x in patched[:50]:
  print(" -", x)
PY

say "4) ENSURE vhost includes AIAQUILA include exactly once (server-level)"
python3 - <<'PY'
import re, pathlib
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
inc="include /etc/nginx/includes/aiaquila_routes.inc;"
p=pathlib.Path(VHOST)
s=p.read_text(encoding="utf-8", errors="ignore")

def ensure_once(block, line):
  block=re.sub(r'^\s*'+re.escape(line)+r'\s*$\n?', '', block, flags=re.M)
  return re.sub(r'(\bserver\s*\{\s*)', r'\1\n  '+line+'\n', block, count=1, flags=re.S)

# patch only server that has server_name fireinners.online
parts=[]; i=0
while True:
  m=re.search(r'\bserver\s*\{', s[i:])
  if not m: parts.append(s[i:]); break
  start=i+m.start()
  if start>i: parts.append(s[i:start])
  j=start; brace=0
  while j<len(s):
    if s[j]=="{": brace+=1
    elif s[j]=="}":
      brace-=1
      if brace==0: j+=1; break
    j+=1
  parts.append(s[start:j]); i=j

new=[]
for part in parts:
  if re.match(r'^\s*server\s*\{', part) and re.search(r'\bserver_name\b[^;]*\bfireinners\.online\b', part):
    part=ensure_once(part, inc)
  new.append(part)

p.write_text("".join(new), encoding="utf-8")
print("OK ensured include in vhost")
PY

say "5) NGINX TEST"
nginx -t

say "6) RELOAD nginx"
systemctl reload nginx 2>/dev/null || systemctl restart nginx

if command -v chattr >/dev/null 2>&1; then
  say "REFREEZE chattr +i (best effort)"
  for f in "$NGXCONF" "$VHOST" "$AQ_SNIP" "$AQ_INC"; do
    [ -e "$f" ] || continue
    chattr +i "$f" 2>/dev/null || true
  done
fi

say "DONE"
say "Backup: $BK"
echo "Test:"
echo "  https://fireinners.online/aiaquila/api/rss"
EOF
chmod +x "$F"
bash "$F"
echo "OK: ran $F"
'
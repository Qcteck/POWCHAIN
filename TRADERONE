mkdir -p "$BK"

backup_file(){ local f="$1"; [ -f "$f" ] && cp -a "$f" "$BK/$(basename "$f").bak" 2>/dev/null || true; }
unfreeze(){ chattr -i /etc/nginx/nginx.conf 2>/dev/null || true; chattr -i "$VHOST" 2>/dev/null || true; chattr -i "$INC" 2>/dev/null || true; }
freeze(){ chattr +i /etc/nginx/nginx.conf 2>/dev/null || true; chattr +i "$VHOST" 2>/dev/null || true; chattr +i "$INC" 2>/dev/null || true; }

detect_vhost(){
  local cand=""
  if [ -f /etc/nginx/sites-available/fireinners.online-ssl ]; then
    cand="/etc/nginx/sites-available/fireinners.online-ssl"
  else
    cand="$(nginx -T 2>/dev/null | awk '
      $0 ~ /# configuration file/ {f=$4}
      $0 ~ /server_name/ && $0 ~ /fireinners\.online/ {sn=1}
      $0 ~ /listen/ && $0 ~ /443/ {l443=1}
      sn && l443 {print f; exit}
    ')"
  fi
  [ -n "${cand:-}" ] && [ -f "$cand" ] || die "cannot detect vhost for ${DOMAIN}"
  echo "$cand"
}

write_file_safe(){
  local path="$1" tmp
  tmp="$(mktemp)"
  cat >"$tmp"
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "aiaquila" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
    rm -f "$tmp"
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(basename "$path").bak" 2>/dev/null || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}

inject_include_once(){
  local f="$1"
  local MB="# >>> AIAQUILA_INCLUDE_BEGIN >>>"
  local ME="# <<< AIAQUILA_INCLUDE_END <<<"
  grep -qF "$MB" "$f" && return 0
  local tmp="$BK/vhost.patched.conf"
  awk -v mb="$MB" -v me="$ME" -v inc="$INC" '
    BEGIN{in_server=0;done=0}
    /^\s*server\s*\{/ {in_server=1}
    in_server && /^\s*}\s*$/ && !done {
      print "  " mb
      print "  include " inc ";"
      print "  " me
      done=1
    }
    {print}
  ' "$f" >"$tmp"
  cp -a "$tmp" "$f"
}

say "0) Detect ACTIVE vhost"
VHOST="$(detect_vhost)"
say "ACTIVE_VHOST=$VHOST"

say "1) Backup"
backup_file "$VHOST"
backup_file "$INC"
mkdir -p "$BK/web"

echo "== Tous les vhosts qui déclarent fireinners.online =="
grep -RIn --include='*.conf' --include='*' -E 'server_name\s+.*fireinners\.online' \
  /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d 2>/dev/null || true
echo

echo "== Lister sites-enabled =="
ls -lah /etc/nginx/sites-enabled
echo

echo "== Désactiver tout sauf /etc/nginx/sites-enabled/fireinners =="
for f in /etc/nginx/sites-enabled/fireinners*; do
  [ -e "$f" ] || continue
  if [ "$f" != "/etc/nginx/sites-enabled/fireinners" ]; then
    echo "REMOVE $f"
    rm -f "$f"
  fi
done

nginx -t && systemctl reload nginx
echo
echo "== Recheck conflicts (doit être vide) =="
nginx -T 2>&1 | grep -i "conflicting server name" || echo "OK: no conflicts ✅"
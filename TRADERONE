set -e
cd /opt/traderone-opt

echo "=== 0) Backup ==="
cp -a server.js "server.js.bak.force_dexes.$(date +%s)"

echo "=== 1) Ensure allowlist file ==="
mkdir -p config
test -f config/dex_allowlist.json || cat > config/dex_allowlist.json <<'JSON'
[
  "sushiswap","jupiter","dflow","okx","mayan","chainflip",
  "gasZipBridge","relaydepository","odos","fly","relay"
]
JSON

echo "=== 2) Force insert route just before app.listen(...) ==="
node <<'NODE'
const fs = require("fs");
const p = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(p,"utf8");

if (s.includes("FORCED_DEXES_ROUTE_V1")) {
  console.log("OK: already patched");
  process.exit(0);
}

const listenIdx = s.search(/\bapp\.listen\s*\(/);
if (listenIdx === -1) throw new Error("app.listen(...) not found");

const snippet = `
// === FORCED_DEXES_ROUTE_V1 ===
app.get("/api/dexes", (req,res)=>{
  try{
    const raw = fs.readFileSync(path.join(__dirname,"config","dex_allowlist.json"),"utf8");
    const a = JSON.parse(raw);
    const dexes = Array.isArray(a) ? a.map(x=>String(x).trim()).filter(Boolean) : [];
    return res.json({ ok:true, dexes });
  }catch(e){
    return res.status(200).json({ ok:true, dexes: [], warn: String(e && e.message || e) });
  }
});

`;

s = s.slice(0, listenIdx) + snippet + s.slice(listenIdx);
fs.writeFileSync(p, s);
console.log("OK: inserted forced /api/dexes before app.listen");
NODE

echo "=== 3) Sanity check (show the inserted lines) ==="
grep -n "FORCED_DEXES_ROUTE_V1" -n server.js || true
echo

echo "=== 4) Restart PM2 (by id 0, since screenshot shows id=0) ==="
node --check server.js
pm2 restart 0 --update-env
sleep 1

echo "=== 5) Test ==="
ss -ltnp | grep ':3000' || true
curl -sS http://127.0.0.1:3000/api/dexes | head -c 400; echo
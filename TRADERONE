sudo bash -lc 'set -euo pipefail
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/probe_location.conf"
TOKEN="$(awk -F= "/^PROBE_TOKEN=/{print \$2}" /opt/probe/probe.env 2>/dev/null || true)"
echo "TOKEN=$TOKEN"
echo "[1] backend local direct (9696)"
curl -sS "http://127.0.0.1:9696/probe?token=$TOKEN" | head -c 140; echo; echo
echo "[2] nginx direct (bypass cloudflare) : https://127.0.0.1/probe with Host header"
curl -sk -H "Host: fireinners.online" -H "X-Probe-Token: $TOKEN" https://127.0.0.1/probe | head -c 140; echo; echo
echo "[3] which vhost is enabled"
ls -la /etc/nginx/sites-enabled | sed -n "1,120p"; echo
echo "[4] confirm include + snippet content"
grep -n "probe_location.conf" "$VHOST" || true
echo "--- snippet ---"
sed -n "1,80p" "$SNIP" || true
echo
echo "[5] show active config lines for /probe + server_name fireinners.online"
nginx -T 2>/dev/null | grep -nE "server_name .*fireinners\.online|location /probe|probe_location\.conf" | head -n 120
'
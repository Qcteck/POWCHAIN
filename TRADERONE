SVR_JS=$(cat <<'"'"'JS'"'"'
"use strict";
const fs=require("fs");
const path=require("path");
const express=require("express");
const {execFile}=require("child_process");

const VERSION="WOLVERINE+TRADERONE 2026-01-02";
const app=express();
app.set("trust proxy",true);
app.use(express.json({limit:"1mb"}));
app.use((req,res,next)=>{res.setHeader("Access-Control-Allow-Origin","*");res.setHeader("Access-Control-Allow-Methods","GET,POST,OPTIONS");res.setHeader("Access-Control-Allow-Headers","content-type");res.setHeader("Cache-Control","no-store");if(req.method==="OPTIONS")return res.sendStatus(204);next();});

const ENV=(k,d)=>process.env[k]??d;
const PORT=parseInt(ENV("PORT","3050"),10)||3050;

const MONITOR_URL=ENV("MONITOR_URL","https://bbbotrader.paycashnostory.workers.dev/ping");
const MONITOR_SEC=Math.max(0,parseInt(ENV("MONITOR_SEC","10"),10)||10);
const MONITOR_FAILS=Math.max(1,parseInt(ENV("MONITOR_FAILS","3"),10)||3);
const TG_ALERTS=String(ENV("TG_ALERTS","0"))==="1";
const WOLV_SEND=ENV("WOLV_SEND","/usr/local/bin/wolv_send");

let traderOne={running:false,mode:"dca",budgetUSDC:0,spentUSDC:0,tokenMint:"",lastAction:0};
let mon={enabled:true,lastOk:null,fails:0,effective:"UNKNOWN",lastMsg:0};

function now(){return Date.now();}
function okjson(res,obj){res.json(Object.assign({ok:true,ts:Date.now(),version:VERSION},obj||{}));}
function errjson(res,code,msg,extra){res.status(code||400).json(Object.assign({ok:false,error:String(msg||"error"),ts:Date.now(),version:VERSION},extra||{}));}

function tgSend(text){
  if(!TG_ALERTS) return;
  if(!text) return;
  if(!fs.existsSync(WOLV_SEND)) return;
  execFile(WOLV_SEND,[String(text)],{timeout:8000},()=>{});
}

async function fetchText(url){
  const ctrl=new AbortController();
  const t=setTimeout(()=>ctrl.abort(),8000);
  try{
    const r=await fetch(url,{signal:ctrl.signal});
    const tx=await r.text();
    return {ok:r.ok,status:r.status,text:tx};
  }finally{clearTimeout(t);}
}

async function monitorTick(){
  if(!mon.enabled) return;
  const r=await fetchText(MONITOR_URL).catch(e=>({ok:false,status:0,text:String(e&&e.message||e)}));
  const isOk=r.ok && (String(r.text||"").toLowerCase().includes("pong") || String(r.text||"").toLowerCase().includes("ok"));
  mon.lastOk=now();
  if(isOk){ mon.fails=0; if(mon.effective!=="UP"){ mon.effective="UP"; tgSend(`WOLVERINE: API UP (recovery) ${new Date().toISOString()}`); } }
  else{ mon.fails++; if(mon.fails>=MONITOR_FAILS && mon.effective!=="DOWN"){ mon.effective="DOWN"; tgSend(`WOLVERINE: API DOWN (>=${MONITOR_FAILS} fails) ${new Date().toISOString()}`); } }
}

if(MONITOR_SEC>0){
  setInterval(()=>{monitorTick();},MONITOR_SEC*1000).unref();
  setTimeout(()=>monitorTick(),600).unref();
}

app.get("/",(req,res)=>res.type("text/plain").send("wolverine-api"));
app.get("/health",(req,res)=>okjson(res,{uptime:process.uptime(),port:PORT}));
app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));
app.get("/config",(req,res)=>okjson(res,{
  apiBase:"/wolverine/api",
  jupBase:"/wolverine/api/jup",
  monitor:{url:MONITOR_URL,sec:MONITOR_SEC,fails:MONITOR_FAILS,tgAlerts:TG_ALERTS,enabled:mon.enabled,effective:mon.effective,failsNow:mon.fails},
  traderOne:traderOne
}));

app.get("/monitor/status",(req,res)=>okjson(res,{monitor:mon}));
app.post("/monitor/start",(req,res)=>{mon.enabled=true; okjson(res,{monitor:mon});});
app.post("/monitor/stop",(req,res)=>{mon.enabled=false; okjson(res,{monitor:mon});});
app.post("/monitor/test",(req,res)=>{tgSend(`WOLVERINE: TEST ${new Date().toISOString()}`); okjson(res,{sent:TG_ALERTS && fs.existsSync(WOLV_SEND)});});

app.get("/traderone/status",(req,res)=>okjson(res,{traderOne}));
app.post("/traderone/start",(req,res)=>{
  const b=req.body||{};
  traderOne.running=true;
  traderOne.mode=String(b.mode||traderOne.mode||"dca");
  traderOne.budgetUSDC=Number(b.budgetUSDC||traderOne.budgetUSDC||0);
  traderOne.tokenMint=String(b.tokenMint||traderOne.tokenMint||"");
  traderOne.lastAction=now();
  tgSend(`WOLVERINE: START mode=${traderOne.mode} budget=${traderOne.budgetUSDC} ${new Date().toISOString()}`);
  okjson(res,{traderOne});
});
app.post("/traderone/stop",(req,res)=>{
  traderOne.running=false; traderOne.lastAction=now();
  tgSend(`WOLVERINE: STOP ${new Date().toISOString()}`);
  okjson(res,{traderOne});
});

const JUP_QUOTE="https://quote-api.jup.ag/v6/quote";
const JUP_SWAP="https://quote-api.jup.ag/v6/swap";

app.get("/jup/quote", async (req,res)=>{
  try{
    const q=new URLSearchParams(req.query||{}).toString();
    const url=JUP_QUOTE+(q?("?"+q):"");
    const r=await fetch(url,{headers:{"accept":"application/json"}});
    const t=await r.text();
    res.status(r.status).type("application/json").send(t);
  }catch(e){ errjson(res,500,"jup_quote_failed",{detail:String(e&&e.message||e)}); }
});

app.post("/jup/swap", async (req,res)=>{
  try{
    const body=req.body||{};
    const r=await fetch(JUP_SWAP,{method:"POST",headers:{"content-type":"application/json","accept":"application/json"},body:JSON.stringify(body)});
    const t=await r.text();
    res.status(r.status).type("application/json").send(t);
  }catch(e){ errjson(res,500,"jup_swap_failed",{detail:String(e&&e.message||e)}); }
});

app.use((req,res)=>errjson(res,404,"not_found",{path:req.path}));

app.listen(PORT, "127.0.0.1", ()=>{ console.log(`[${new Date().toISOString()}] ${VERSION} listening 127.0.0.1:${PORT}`); });
JS
)


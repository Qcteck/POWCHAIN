bash -lc 'cat > /root/MEGA_WOLVERINE_FIX_400_301.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
need(){ command -v "$1" >/dev/null 2>&1 || { echo "Missing: $1"; exit 1; }; }
need sed; need grep; need ss; need systemctl; need nginx; need curl; need python3

NGX_INC="/etc/nginx/includes/wolverine_routes.inc"
NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SOL_SVC="/etc/systemd/system/wolverine-solrpc-proxy.service"
SOL_UPSTREAM="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"

echo "== 0) Savepoint (if present) =="
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then /root/WOLVERINE_SAVEPOINT.sh || true; fi

echo "== 1) Patch Solana RPC proxy upstream -> DRPC SOLANA =="
test -f "$SOL_SVC" || { echo "Missing $SOL_SVC (solrpc proxy service not installed)"; exit 1; }
cp -a "$SOL_SVC" "/root/wolverine_backups/wolverine-solrpc-proxy.service.bak_${TS}" 2>/dev/null || true
sed -i "s|^Environment=UPSTREAM=.*$|Environment=UPSTREAM=${SOL_UPSTREAM}|g" "$SOL_SVC"
systemctl daemon-reload
systemctl restart wolverine-solrpc-proxy.service
sleep 1
systemctl --no-pager -l status wolverine-solrpc-proxy.service | head -n 25 || true

echo "== 2) Patch nginx include to avoid 301 on /wolverine/vault/api (no trailing slash) =="
for f in "$NGX_VHOST" "$NGX_INC" "/etc/nginx/nginx.conf"; do [ -e "$f" ] && chattr -i "$f" 2>/dev/null || true; done
mkdir -p "$(dirname "$NGX_INC")"
touch "$NGX_INC"

python3 - <<'PY'
from pathlib import Path
inc=Path("/etc/nginx/includes/wolverine_routes.inc")
s=inc.read_text(errors="ignore") if inc.exists() else ""
def ensure(tag, block):
  global s
  if tag in s: return
  s += "\n\n"+block.strip()+"\n"
ensure("##WOLVERINE_VAULT_API_NOSLASH_V1", r"""
##WOLVERINE_VAULT_API_NOSLASH_V1
location = /wolverine/vault/api { return 308 /wolverine/vault/api/; }
""")
ensure("##WOLVERINE_SOLANA_RPC_NOSLASH_V1", r"""
##WOLVERINE_SOLANA_RPC_NOSLASH_V1
location = /wolverine/solana-rpc { return 308 /wolverine/solana-rpc; }
""")
inc.write_text(s)
print("OK: nginx include updated")
PY

nginx -t
systemctl reload nginx

for f in "$NGX_VHOST" "$NGX_INC" "/etc/nginx/nginx.conf"; do [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true; done

echo "== 3) Quick tests (show HTTP codes) =="
echo "-- vault api local (should be 200 JSON) --"
curl -sS -D - "http://127.0.0.1:3010/health" -o /tmp/vault_health_${TS}.out || true
head -n 20 /tmp/vault_health_${TS}.out || true

echo
echo "-- solana rpc local (should be 200 + ok/healthy) --"
curl -sS -D - -H "content-type: application/json" -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\"}" "http://127.0.0.1:12703/" -o /tmp/sol_local_${TS}.out || true
head -n 20 /tmp/sol_local_${TS}.out || true

echo
echo "-- public same-origin solana-rpc (should be 200) --"
curl -sS -D - -H "content-type: application/json" -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\"}" "https://fireinners.online/wolverine/solana-rpc" -o /tmp/sol_pub_${TS}.out || true
head -n 20 /tmp/sol_pub_${TS}.out || true

echo
echo "DONE"
echo "OPEN: https://fireinners.online/wolverine/ (Ctrl+F5)"
echo "OPEN: https://fireinners.online/wolverine/health/ (Ctrl+F5)"
BASH
chmod +x /root/MEGA_WOLVERINE_FIX_400_301.sh
/root/MEGA_WOLVERINE_FIX_400_301.sh | tee /root/MEGA_WOLVERINE_FIX_400_301_${TS}.log'
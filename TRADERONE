cat >/root/MEGA_WOLVERINE_FIX_EOF_PATCH.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
F="/root/MEGA_WOLVERINE_FIX_AQUILA_RPCVAULT.sh"
[ -f "$F" ] || { echo "MISSING: $F"; exit 1; }

echo "== 1) Backup =="
cp -a "$F" "${F}.bak_$(date +%Y%m%d_%H%M%S)"

echo "== 2) Strip CRLF (Windows) + fix common here-doc EOF issues =="
python3 - <<'PY'
from pathlib import Path
p=Path("/root/MEGA_WOLVERINE_FIX_AQUILA_RPCVAULT.sh")
s=p.read_text(errors="ignore")

# remove Windows CR
s=s.replace("\r\n","\n").replace("\r","\n")

# ensure file ends with newline
if not s.endswith("\n"):
    s += "\n"

# sanity: if someone pasted a broken heredoc terminator with spaces, normalize
# (no harm if already ok)
s=s.replace("<< 'BASH'\n","<<'BASH'\n")
s=s.replace("<< \"BASH\"\n","<<'BASH'\n")

p.write_text(s)
print("OK: normalized newlines; ensured trailing newline")
PY

echo "== 3) Shell syntax check =="
bash -n "$F" && echo "OK: bash -n passes"

echo "== 4) Run =="
bash "$F"
BASH
chmod +x /root/MEGA_WOLVERINE_FIX_EOF_PATCH.sh
/root/MEGA_WOLVERINE_FIX_EOF_PATCH.sh
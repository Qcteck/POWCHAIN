DOMAIN="fireinners.online"

echo "== LISTEN 80/443 =="
ss -lntp | egrep ':(80|443)\s' || true
echo

echo "== nginx status + logs récents =="
systemctl status nginx --no-pager -l | sed -n '1,40p' || true
journalctl -u nginx -n 60 --no-pager || true
echo

echo "== Conf active (sites-enabled) =="
ls -lah /etc/nginx/sites-enabled/ || true
echo
echo "--- fireinners enabled file:"
sed -n '1,220p' /etc/nginx/sites-enabled/fireinners 2>/dev/null || echo "NO /etc/nginx/sites-enabled/fireinners"
echo
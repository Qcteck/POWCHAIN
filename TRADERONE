bash <<'EOF'
set -e

DOMAIN="fireinners.online"
SUB="www.fireinners.online"
ROOT_DIR="/opt/fireinners/frontend-react/app/dist"
NGINX_SSL="/etc/nginx/sites-available/fireinners.online-ssl"

echo "=== FIREINNERS • HTTPS + WOLVERINE DEPLOY ==="

# 1) Installer nginx + certbot si absent
apt update -y
apt install -y nginx certbot python3-certbot-nginx

# 2) Démarrer nginx
systemctl enable nginx
systemctl start nginx

# 3) Vérifier port 80 ouvert
ss -lnt | grep -q ':80' || { echo "[ERR] Port 80 fermé"; exit 1; }

# 4) Générer certificat SSL
certbot certonly --nginx -d "$DOMAIN" -d "$SUB" --non-interactive --agree-tos -m admin@$DOMAIN

# 5) Créer vhost SSL
cat > "$NGINX_SSL" <<NG
server {
    listen 443 ssl;
    server_name $DOMAIN $SUB;

    ssl_certificate /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;

    root $ROOT_DIR;
    index index.html;

    location /wolverine {
        try_files \$uri \$uri/ /wolverine/index.html;
    }
}
NG

ln -sf "$NGINX_SSL" /etc/nginx/sites-enabled/fireinners.online-ssl

# 6) Reload nginx
nginx -t
systemctl reload nginx

# 7) Vérifier port 443
ss -lnt | grep -q ':443' || { echo "[ERR] 443 toujours fermé"; exit 1; }

# 8) Test HTTPS réel
curl -fsSL https://www.fireinners.online/wolverine >/dev/null

echo "=== SUCCESS ==="
echo "URL : https://www.fireinners.online/wolverine"
EOF
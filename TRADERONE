APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

# Remplace la ligne bugguée par une version correcte
perl -i -pe 's/const msg = j\?\.\s*error\s*\?\s*:\s*txt\.slice\(0,200\);/const msg = (j \&\& j.error) ? String(j.error) : txt.slice(0,200);/g' "$APPJS"

# Vérifie qu’il reste plus de "? :"
grep -nE '\?\s*:' "$APPJS" | head -n 20 || true

echo "OK. Maintenant Ctrl+F5 sur /wolverine"
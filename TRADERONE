cat >/root/check_usdc_accounts_debug.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

RPC="https://fireinners.online/wolverine/rpc"
USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
WALLET="COLLE_L_ADRESSE_PHANTOM_ICI"   # <- IMPORTANT

PAY=$(cat <<JSON
{"jsonrpc":"2.0","id":1,"method":"getTokenAccountsByOwner",
 "params":["$WALLET",{"mint":"$USDC"},{"encoding":"jsonParsed"}]}
JSON
)

echo "== POST $RPC =="
resp="$(curl -sk -w "\nHTTP_CODE:%{http_code}\n" "$RPC" -H 'content-type: application/json' --data "$PAY")"
echo "$resp" | head -n 80

echo
code="$(echo "$resp" | sed -n 's/^HTTP_CODE://p')"
body="$(echo "$resp" | sed '/^HTTP_CODE:/d')"

if [ "$code" != "200" ]; then
  echo "RPC returned HTTP $code (not 200) ❌"
  exit 1
fi

echo "$body" | python3 - <<'PY'
import json,sys
txt=sys.stdin.read().strip()
j=json.loads(txt)
vals=j.get("result",{}).get("value",[])
print("token accounts:", len(vals))
total=0.0
for v in vals:
    ta=v["account"]["data"]["parsed"]["info"]["tokenAmount"]
    s=ta.get("uiAmountString") or "0"
    total += float(s)
print("USDC total:", total)
PY
BASH

chmod +x /root/check_usdc_accounts_debug.sh
/root/check_usdc_accounts_debug.sh
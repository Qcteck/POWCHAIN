set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DIR="/root/nginx_backups_$TS"
KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "=== 1) Sanity ==="
nginx -T 2>/dev/null | grep -i "conflicting server name" || echo "✅ no more conflicts"
[ -f "$KEEP" ] || { echo "❌ KEEP missing: $KEEP"; exit 1; }

echo "=== 2) Ranger les backups (sans rien casser) ==="
mkdir -p "$DIR"
shopt -s nullglob
mv /etc/nginx/sites-enabled/fireinners.online-ssl.bak* "$DIR/" 2>/dev/null || true
mv /etc/nginx/sites-enabled/*.disabled.* "$DIR/" 2>/dev/null || true
echo "Backups moved to: $DIR"

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 4) Tests endpoints ==="
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | sed -n '1,30p'

curl -sk --resolve fireinners.online:443:127.0.0.1 \
 "https://fireinners.online/wolverine/traderone/api/auth/phantom/challenge?pubkey=11111111111111111111111111111111" | head -c 260; echo
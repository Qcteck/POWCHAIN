#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
OUT="/root/WOLVERINE_VPS_MAP_${TS}.txt"

say(){ printf "\n== %s ==\n" "$*"; }
w(){ printf "%s\n" "$*" | tee -a "$OUT" >/dev/null; }

echo "# VPS MAP ${TS}" > "$OUT"

say "A) Identity"
w "date: $(date -Is)"
w "hostname: $(hostname)"
w "os: $(lsb_release -ds 2>/dev/null || cat /etc/os-release | head -n 1)"
w "kernel: $(uname -r)"
w "ip (best effort): $(ip -4 addr show | awk '/inet /{print $2,$NF}' | tr '\n' '; ')"

say "B) Ports/listeners"
w "ss -lntup:"
(ss -lntup || true) | tee -a "$OUT" >/dev/null

say "C) Nginx"
w "nginx -v: $(nginx -v 2>&1 || true)"
w "nginx -t:"
(nginx -t 2>&1 || true) | tee -a "$OUT" >/dev/null
w "sites-enabled:"
(ls -la /etc/nginx/sites-enabled 2>/dev/null || true) | tee -a "$OUT" >/dev/null
w "fireinners.online-ssl snippet (first 240 lines):"
sed -n '1,240p' /etc/nginx/sites-available/fireinners.online-ssl 2>/dev/null | tee -a "$OUT" >/dev/null
w "includes (grep wolverine):"
grep -Rni --line-number "wolverine" /etc/nginx/includes 2>/dev/null | head -n 200 | tee -a "$OUT" >/dev/null

say "D) Wolverine Front"
for p in /var/www/wolverine/index.html /opt/fireinners/frontend-react/app/dist/wolverine/index.html; do
  if [[ -f "$p" ]]; then
    w "FOUND frontend index: $p"
    w "sha256: $(sha256sum "$p" | awk '{print $1}')"
    w "size: $(wc -c < "$p") bytes"
  else
    w "missing: $p"
  fi
done

say "E) systemd services (node related)"
w "systemd list (node/traderone/wolverine/fireinners/qplus/amcq):"
(systemctl list-units --type=service --all | egrep -i "node|traderone|wolverine|fireinners|qplus|amcq" || true) | tee -a "$OUT" >/dev/null

say "F) Candidate backend directories"
w "scan /opt for package.json (top 120):"
(find /opt -maxdepth 6 -name package.json -print 2>/dev/null | head -n 120 || true) | tee -a "$OUT" >/dev/null
w "scan /root for package.json (top 120):"
(find /root -maxdepth 6 -name package.json -print 2>/dev/null | head -n 120 || true) | tee -a "$OUT" >/dev/null

say "G) TraderOne service file if exists"
if [[ -f /etc/systemd/system/traderone.service ]]; then
  w "FOUND /etc/systemd/system/traderone.service:"
  sed -n '1,220p' /etc/systemd/system/traderone.service | tee -a "$OUT" >/dev/null
else
  w "missing: /etc/systemd/system/traderone.service"
fi

say "H) Quick HTTP local probes"
set +e
w "curl -I http://127.0.0.1/wolverine/ :"
curl -sS -I http://127.0.0.1/wolverine/ | head -n 15 | tee -a "$OUT" >/dev/null
w "curl -I http://127.0.0.1/wolverine/traderone/api/ :"
curl -sS -I http://127.0.0.1/wolverine/traderone/api/ | head -n 15 | tee -a "$OUT" >/dev/null
set -e

say "DONE"
echo
echo "Rapport généré: $OUT"
echo "Colle-moi le contenu de ce fichier (ou juste les sections C/D/G/H) et je verrouille la cartographie."
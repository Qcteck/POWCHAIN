<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE • TraderOne (Custodial)</title><style>:root{--bg:#05060a;--p:#0c101c;--p2:#0b1326;--b:#22314f;--t:#eaf2ff;--m:#a9b8d6;--a:#ff7a18;--a2:#00d4ff;--ok:#6dffb0;--bad:#ff6d6d}*{box-sizing:border-box}html,body{height:100%;margin:0;background:radial-gradient(1200px 700px at 20% 0%,rgba(255,122,24,.18),transparent 55%),radial-gradient(900px 600px at 90% 10%,rgba(0,212,255,.16),transparent 60%),radial-gradient(1000px 700px at 40% 110%,rgba(109,255,176,.08),transparent 55%),var(--bg);color:var(--t);font:14px system-ui}a{color:var(--a2);text-decoration:none}#wrap{max-width:1150px;margin:0 auto;padding:18px}#top{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-bottom:14px}#brand{display:flex;gap:10px;align-items:center}#dot{width:14px;height:14px;border-radius:5px;background:linear-gradient(135deg,var(--a2),var(--a));box-shadow:0 0 22px rgba(255,122,24,.35)}#title{font-weight:900;letter-spacing:.6px}#sub{color:var(--m);font-size:12px;margin-top:2px}#grid{display:grid;grid-template-columns:420px 1fr;gap:14px}@media(max-width:980px){#grid{grid-template-columns:1fr}}.card{background:linear-gradient(180deg,rgba(12,16,28,.86),rgba(8,10,16,.76));border:1px solid rgba(34,49,79,.9);border-radius:18px;box-shadow:0 12px 36px rgba(0,0,0,.45);backdrop-filter:blur(8px)}.pad{padding:14px}.h{font-weight:800;margin:0 0 10px 0}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.col{display:flex;flex-direction:column;gap:8px}.pill{padding:10px 12px;border-radius:14px;border:1px solid rgba(34,49,79,.9);background:rgba(7,10,20,.55);color:var(--t)}.btn{cursor:pointer;user-select:none;padding:10px 12px;border-radius:14px;border:1px solid rgba(34,49,79,.95);background:linear-gradient(135deg,rgba(255,122,24,.16),rgba(0,212,255,.10));color:var(--t);font-weight:800}button.btn{appearance:none}.btn:hover{filter:brightness(1.12)}.btn2{background:rgba(7,10,20,.55)}.kv{display:grid;grid-template-columns:120px 1fr;gap:8px;align-items:center}.k{color:var(--m)}.v{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;word-break:break-all}.hr{height:1px;background:rgba(34,49,79,.75);margin:12px 0}.good{color:var(--ok)}.bad{color:var(--bad)}#log{height:360px;overflow:auto;font:12px ui-monospace,Menlo,Consolas,monospace;background:rgba(0,0,0,.25);border:1px solid rgba(34,49,79,.8);border-radius:14px;padding:10px;white-space:pre-wrap}input,select{outline:none}select.pill{cursor:pointer}.mini{font-size:12px;color:var(--m)}.tag{padding:5px 9px;border-radius:999px;border:1px solid rgba(34,49,79,.9);background:rgba(7,10,20,.55);font-size:12px;color:var(--m)}.spin{display:inline-block;width:10px;height:10px;border-radius:999px;border:2px solid rgba(255,255,255,.25);border-top-color:var(--a2);animation:sp 1s linear infinite}@keyframes sp{to{transform:rotate(360deg)}}</style></head><body><div id="wrap"><div id="top"><div id="brand"><div id="dot"></div><div><div id="title">WOLVERINE</div><div id="sub">Custodial TraderOne • Dépôt Phantom • Swaps Jupiter • TG monitor</div></div></div><div class="row"><div class="tag" id="net">API: …</div><div class="tag" id="tstat">Engine: …</div><div class="tag" id="rstat">Refresh <span id="sp" class="spin" style="display:none"></span></div></div></div><div id="grid"><div class="card pad"><div class="h">Control</div><div class="kv"><div class="k">Wallet</div><div class="v" id="wpub">—</div></div><div class="row" style="margin-top:10px"><button class="btn" id="btnConn">Connect Phantom</button><button class="btn btn2" id="btnDisc">Disconnect</button></div><div class="hr"></div><div class="h">Adresse du bot (TraderOne)</div><div class="kv"><div class="k">Bot</div><div class="v" id="botpub">—</div></div><div class="row" style="margin-top:10px"><button class="btn btn2" id="btnCopyBot">Copy</button><button class="btn btn2" id="btnOpenSol">Explorer</button></div><div class="hr"></div><div class="h">Dépôt (budget)</div><div class="mini">Tu déposes vers l’adresse du bot. Après signature, on “claim” le tx pour créditer ton compte interne.</div><div class="row" style="margin-top:10px"><select class="pill" id="depToken"><option value="USDC">USDC</option><option value="SOL">SOL</option></select><input class="pill" id="depAmt" placeholder="Montant (ex: 25)" style="flex:1"/></div><div class="row" style="margin-top:10px"><button class="btn" id="btnDeposit">Deposit via Phantom</button><button class="btn btn2" id="btnClaim">Claim last tx</button></div><div class="hr"></div><div class="h">Autotrade</div><div class="row"><select class="pill" id="mode" style="flex:1"><option value="dca_sol_safe">DCA buy SOL (safe)</option><option value="buy_token">Buy token (one-shot)</option></select></div><div class="row" style="margin-top:10px"><input class="pill" id="tokenMint" placeholder="token mint (si buy_token)" style="flex:1"/></div><div class="row" style="margin-top:10px"><input class="pill" id="interval" placeholder="interval sec (ex: 30)" style="flex:1"/></div><div class="row" style="margin-top:10px"><button class="btn" id="btnStart">Start WOLVERINE</button><button class="btn btn2" id="btnStop">Stop</button></div><div class="hr"></div><div class="h">Withdraw</div><div class="row"><select class="pill" id="wdToken"><option value="USDC">USDC</option><option value="SOL">SOL</option></select><input class="pill" id="wdAmt" placeholder="Montant (ex: 5)" style="flex:1"/></div><div class="row" style="margin-top:10px"><button class="btn" id="btnWd">Withdraw to my Phantom</button></div><div class="hr"></div><div class="mini">Sécurité: le bot ne dépense que le crédit interne. L’utilisateur signe uniquement dépôt/retrait via Phantom.</div><div class="mini" id="ready">Ready.</div></div><div class="card pad"><div class="h">TraderOne Console</div><div class="row"><div class="tag">Bot SOL: <span id="bsol">—</span></div><div class="tag">Bot USDC: <span id="busdc">—</span></div><div class="tag">My credit SOL: <span id="csol">—</span></div><div class="tag">My credit USDC: <span id="cusdc">—</span></div></div><div class="hr"></div><div id="log"></div><div class="row" style="margin-top:10px"><button class="btn btn2" id="btnRefresh">Refresh now</button><button class="btn btn2" id="btnPing">Ping</button></div></div></div></div><script type="module">const API=location.origin+"/wolverine/api";let P=null,lastSig="";const $=s=>document.querySelector(s);const log=(m,c="")=>{const el=$("#log");const t=new Date().toISOString();el.textContent=`${t} ${m}\n`+el.textContent;el.scrollTop=0;if(c)$("#ready").textContent=c};const fmt=(n,dec=9)=>{try{n=BigInt(n||0)}catch{n=0n}const p=10n**BigInt(dec);const i=(n/p).toString();let f=(n%p).toString().padStart(dec,"0").replace(/0+$/,"");return f?`${i}.${f}`:i};const uiToBase=(s,dec)=>{s=String(s||"0").trim();if(!/^\d+(\.\d+)?$/.test(s))return 0n;let[a,b=""]=s.split(".");b=(b+"0".repeat(dec)).slice(0,dec);return BigInt(a||"0")*BigInt(10**dec)+BigInt(b||"0")};async function j(url,opt){const r=await fetch(url,opt);const t=await r.text();let o=null;try{o=JSON.parse(t)}catch{}if(!r.ok)throw new Error((o&&o.error)||t||("HTTP "+r.status));return o??t}async function loadBot(){const a=await j(API+"/address");$("#net").textContent="API: /wolverine/api";$("#botpub").textContent=a.bot_pubkey;$("#btnOpenSol").onclick=()=>window.open("https://solscan.io/account/"+a.bot_pubkey,"_blank");$("#btnCopyBot").onclick=async()=>{try{await navigator.clipboard.writeText(a.bot_pubkey);log("copied bot address")}catch{}}}async function connPhantom(){if(!window.solana||!window.solana.isPhantom)throw new Error("Phantom manquant");const r=await window.solana.connect({onlyIfTrusted:false});P=r.publicKey.toString();$("#wpub").textContent=P;log("phantom connected "+P,"Connected.");}async function discPhantom(){try{await window.solana.disconnect()}catch{}P=null;$("#wpub").textContent="—";log("phantom disconnected","Disconnected.")}async function getBalances(){if(!P){$("#csol").textContent="—";$("#cusdc").textContent="—";return}const r=await j(API+"/balances?owner="+encodeURIComponent(P));$("#bsol").textContent=fmt(r.bot.sol,9);$("#busdc").textContent=fmt(r.bot.usdc,6);$("#csol").textContent=fmt(r.user.credit_sol,9);$("#cusdc").textContent=fmt(r.user.credit_usdc,6);$("#tstat").textContent="Engine: "+(r.engine?.running?"RUN":"OFF")+" • "+(r.engine?.mode||"");}async function claim(sig){if(!P)throw new Error("connect phantom");if(!sig)throw new Error("no sig");const r=await j(API+"/claim",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({owner:P,sig})});log("claim ok usdc="+fmt(r.credited.usdc,6)+" sol="+fmt(r.credited.sol,9));}async function deposit(){if(!P)throw new Error("connect phantom");const token=$("#depToken").value;const amt=$("#depAmt").value;const bot=$("#botpub").textContent.trim();if(!bot)throw new Error("bot addr missing");if(token==="SOL"){const lam=uiToBase(amt,9);if(lam<=0n)throw new Error("bad amount");const {Connection,PublicKey,SystemProgram,Transaction,LAMPORTS_PER_SOL}=await import("https://esm.sh/@solana/web3.js@1.95.3");const c=new Connection("https://api.mainnet-beta.solana.com","confirmed");const tx=new Transaction().add(SystemProgram.transfer({fromPubkey:new PublicKey(P),toPubkey:new PublicKey(bot),lamports:Number(lam)}));tx.feePayer=new PublicKey(P);tx.recentBlockhash=(await c.getLatestBlockhash("confirmed")).blockhash;const signed=await window.solana.signTransaction(tx);const sig=await c.sendRawTransaction(signed.serialize(),{skipPreflight:false,maxRetries:3});await c.confirmTransaction(sig,"confirmed");lastSig=sig;log("deposit SOL tx "+sig);await claim(sig);return}const {Connection,PublicKey,Transaction}=await import("https://esm.sh/@solana/web3.js@1.95.3");const {getAssociatedTokenAddress,createAssociatedTokenAccountInstruction,createTransferInstruction,TOKEN_PROGRAM_ID,ASSOCIATED_TOKEN_PROGRAM_ID}=await import("https://esm.sh/@solana/spl-token@0.4.9");const USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const c=new Connection("https://api.mainnet-beta.solana.com","confirmed");const ownerPk=new PublicKey(P),botPk=new PublicKey(bot),mint=new PublicKey(USDC);const fromAta=await getAssociatedTokenAddress(mint,ownerPk,false,TOKEN_PROGRAM_ID,ASSOCIATED_TOKEN_PROGRAM_ID);const toAta=await getAssociatedTokenAddress(mint,botPk,false,TOKEN_PROGRAM_ID,ASSOCIATED_TOKEN_PROGRAM_ID);const tx=new Transaction();const toInfo=await c.getAccountInfo(toAta,"confirmed");if(!toInfo)tx.add(createAssociatedTokenAccountInstruction(ownerPk,toAta,botPk,mint,TOKEN_PROGRAM_ID,ASSOCIATED_TOKEN_PROGRAM_ID));const a=uiToBase(amt,6);if(a<=0n)throw new Error("bad amount");tx.add(createTransferInstruction(fromAta,toAta,ownerPk,Number(a),[],TOKEN_PROGRAM_ID));tx.feePayer=ownerPk;tx.recentBlockhash=(await c.getLatestBlockhash("confirmed")).blockhash;const signed=await window.solana.signTransaction(tx);const sig=await c.sendRawTransaction(signed.serialize(),{skipPreflight:false,maxRetries:3});await c.confirmTransaction(sig,"confirmed");lastSig=sig;log("deposit USDC tx "+sig);await claim(sig)}async function start(){if(!P)throw new Error("connect phantom");const mode=$("#mode").value;const tokenMint=$("#tokenMint").value.trim();const intervalSec=+($("#interval").value||"30");const r=await j(API+"/start",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({owner:P,mode,tokenMint,intervalSec})});log("start ok mode="+r.engine.mode,"Running.")}async function stop(){await j(API+"/stop",{method:"POST"});log("stop ok","Stopped.")}async function withdraw(){if(!P)throw new Error("connect phantom");const token=$("#wdToken").value;const amount=$("#wdAmt").value;const r=await j(API+"/withdraw",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({owner:P,token,amount})});log("withdraw tx "+r.sig)}async function ping(){const t=await fetch(API+"/ping").then(r=>r.text());log("ping "+t)}let inflight=false;async function refresh(){if(inflight)return;inflight=true;$("#sp").style.display="inline-block";try{await getBalances()}catch(e){log("refresh err "+e.message)}finally{$("#sp").style.display="none";inflight=false}}$("#btnConn").onclick=()=>connPhantom().catch(e=>log("ERR "+e.message));$("#btnDisc").onclick=()=>discPhantom();$("#btnDeposit").onclick=()=>deposit().catch(e=>log("ERR "+e.message));$("#btnClaim").onclick=()=>claim(lastSig).catch(e=>log("ERR "+e.message));$("#btnStart").onclick=()=>start().catch(e=>log("ERR "+e.message));$("#btnStop").onclick=()=>stop().catch(e=>log("ERR "+e.message));$("#btnWd").onclick=()=>withdraw().catch(e=>log("ERR "+e.message));$("#btnRefresh").onclick=()=>refresh();$("#btnPing").onclick=()=>ping().catch(e=>log("ERR "+e.message));(async()=>{await loadBot();await ping();await refresh();setInterval(()=>refresh(),2000)})().catch(e=>log("BOOT ERR "+e.message));</script></body></html>






set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_prod.conf"

echo "=== 0) Backup ==="
cp -a "$KEEP" "$KEEP.bak.$TS" || true
cp -a "$SNIP" "$SNIP.bak.$TS" 2>/dev/null || true

echo "=== 1) Montrer où est le(s) location /wolverine/ (debug) ==="
nginx -T 2>/dev/null | grep -nE "location\s+\^~\s+/wolverine/|location\s+/wolverine/" | head -n 60 || true

echo "=== 2) Rewrite snippet SANS /wolverine/ (API ONLY) ==="
API_PORT="3005"

cat > "$SNIP" <<NGX
# Wolverine PROD routing - API ONLY (avoid duplicate /wolverine/ location)
# API: http://127.0.0.1:${API_PORT}

# API MUST win (no SPA fallback)
location ^~ /wolverine/traderone/api/ {
  add_header X-Wolverine-API HIT always;

  proxy_pass http://127.0.0.1:${API_PORT}/;
  proxy_http_version 1.1;

  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
}
NGX

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 4) Test API (doit être 200 + header X-Wolverine-API) ==="
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | sed -n '1,35p'

echo "DONE ✅"
cat >/tmp/DIAG_TRADERONE_RESTARTS_ROOT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

export SYSTEMD_PAGER=cat
export PAGER=cat

echo "== 1) Health LOCAL vs NGINX =="
curl -sS  -o /dev/null -w "LOCAL  http_code=%{http_code}\n" http://127.0.0.1:8585/api/health || true
curl -ksS -o /dev/null -w "NGINX  http_code=%{http_code}\n" https://fireinners.online/wolverine/traderone/api/health || true
echo

echo "== 2) Derniers (stop/start) traderone avec détails (qui déclenche) =="
journalctl -u traderone.service -n 200 --no-pager -o short-precise | egrep -i 'Starting|Started|Stopping|Stopped|Failed|exit-code|Main process' || true
echo

echo "== 3) Logs watchdog (voit-il des fails / restarts) =="
journalctl -u traderone-watchdog.service -n 120 --no-pager -o short-precise || true
echo

echo "== 4) Timers actifs liés à traderone =="
systemctl list-timers --all | egrep -i 'traderone|watchdog' || true
echo

echo "== 5) Cherche d'autres restarts (cron/systemd) =="
grep -RIn --color=never -E 'traderone|8585|traderone_watchdog' /etc/cron* /etc/systemd/system 2>/dev/null | head -n 120 || true
SH

bash /tmp/DIAG_TRADERONE_RESTARTS_ROOT.sh



cat >/usr/local/bin/traderone_watchdog.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
URL="http://127.0.0.1:8585/api/health"
STATE="/run/traderone_watchdog_failcount"

code="$(curl -sS --max-time 6 -o /dev/null -w "%{http_code}" "$URL" || echo 000)"

if [ "$code" = "200" ]; then
  rm -f "$STATE"
  exit 0
fi

n=0; [ -f "$STATE" ] && n="$(cat "$STATE" 2>/dev/null || echo 0)"
n=$((n+1)); echo "$n" > "$STATE"

logger -t traderone_watchdog "health=$code failcount=$n"

if [ "$n" -ge 3 ]; then
  rm -f "$STATE"
  logger -t traderone_watchdog "RESTART traderone.service (3 fails)"
  systemctl restart traderone.service
fi
EOF

chmod +x /usr/local/bin/traderone_watchdog.sh
systemctl daemon-reload


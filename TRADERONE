cat >/root/fix_conflicting_server_name_443.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ts="$(date +%Y%m%d_%H%M%S)"
DIS="/etc/nginx/disabled-sites"
mkdir -p "$DIS"

echo "== 1) Show all server_name for 443 (enabled only) =="
grep -RIn --line-number -E "listen\s+443|server_name" /etc/nginx/sites-enabled | sed -n '1,200p' || true
echo

echo "== 2) List enabled vhosts =="
ls -la /etc/nginx/sites-enabled
echo

echo "== 3) Find enabled files that mention fireinners.online =="
mapfile -t files < <(grep -RIl "server_name" /etc/nginx/sites-enabled | xargs -r grep -l "fireinners\.online" || true)

printf '%s\n' "${files[@]}" | nl -ba || true
echo

echo "== 4) If multiple files match, keep ONLY fireinners.online-ssl symlink and disable the others =="
KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"

for f in "${files[@]}"; do
  [[ -e "$f" ]] || continue
  if [[ "$f" != "$KEEP" ]]; then
    echo "DISABLE $f -> $DIS/"
    mv -f "$f" "$DIS/$(basename "$f").disabled_$ts"
  fi
done

echo
echo "== 5) Ensure the keep symlink exists (points to sites-available) =="
ln -sf /etc/nginx/sites-available/fireinners.online-ssl /etc/nginx/sites-enabled/fireinners.online-ssl

echo
echo "== 6) systemd daemon-reload + nginx test + reload =="
systemctl daemon-reload || true
nginx -t
systemctl reload nginx
echo "[OK] done"

echo
echo "== 7) Re-check warnings quickly =="
nginx -t 2>&1 | grep -i "conflicting server name" || echo "No conflicting server name warnings ✅"
BASH

chmod +x /root/fix_conflicting_server_name_443.sh
/root/fix_conflicting_server_name_443.sh
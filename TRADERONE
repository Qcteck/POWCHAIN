function toNum(v){const n=Number(String(v||"").trim());return (Number.isFinite(n)?n:NaN);}
async function proposeSwap(){const inMint=$("#inMint").value.trim();const outMint=$("#outMint").value.trim();const amt=toNum($("#amt").value);const slip=toNum($("#slip").value);
if(!outMint||!isFinite(amt)||amt<=0||!isFinite(slip)||slip<=0){$("#exSt").value="BAD INPUT";return;}
const r=await post("exec/swap/propose",{inMint,outMint,amountIn:amt,slippageBps:slip,dir:"IN_TO_OUT"}).then(x=>x.json());
if(!r.ok){$("#exSt").value="PROPOSE FAIL";add("SYS","Propose fail: "+(r.err||""),"sys");return;}
$("#pid").value=r.id;$("#exSt").value="PENDING CREATED";add("SYS","PENDING swap: "+r.id,"sys");add("AI","Tu veux APPROVE ce pending? (sinon rien n’exécute)","ai");}
async function approvePending(){const id=$("#pid").value.trim(); if(!id){$("#exSt").value="NO PENDING";return;}
const r=await post("decision/resolve",{id,ok:true}).then(x=>x.json()); if(!r.ok){$("#exSt").value="APPROVE FAIL";add("SYS","Approve fail","sys");return;}
$("#exSt").value="APPROVED";add("SYS","Approved: "+id,"sys");}
async function prepareTx(){const id=$("#pid").value.trim();const pub=$("#pub").value.trim();if(!id||!pub){$("#exSt").value="MISSING";return;}
const inMint=$("#inMint").value.trim(); const dec=(inMint.startsWith("So111")?9:6);
const r=await post("exec/swap/prepare",{pendingId:id,userPub:pub,decimalsIn:dec}).then(x=>x.json());
if(!r.ok){$("#exSt").value="PREP FAIL";add("SYS","Prepare fail: "+(r.err||""),"sys");return;}
S.txB64=r.swapTransactionBase64;$("#exSt").value="TX READY";add("SYS","Prepared TX. usd~"+(r.usdEstimate||0),"sys");}
async function signSend(){try{
const pub=$("#pub").value.trim(); if(!pub||!S.phantom){$("#exSt").value="NO PHANTOM";return;}
const rpc=$("#rpc").value.trim(); if(!rpc){$("#exSt").value="NO RPC";return;}
if(!S.txB64){$("#exSt").value="NO TX";return;}
const {Connection,VersionedTransaction}=window.solanaWeb3;
const conn=new Connection(rpc,{commitment:"confirmed"});
const tx=VersionedTransaction.deserialize(Uint8Array.from(atob(S.txB64),c=>c.charCodeAt(0)));
$("#exSt").value="SIGN…";
const signed=await S.phantom.signTransaction(tx);
$("#exSt").value="SEND…";
const sig=await conn.sendRawTransaction(signed.serialize(),{skipPreflight:false,maxRetries:3});
$("#sig").value=sig;$("#exSt").value="SENT";
add("SYS","TX sent: "+sig,"sys");
$("#exSt").value="COMMIT…";
const pid=$("#pid").value.trim();
const c=await post("exec/commit",{pendingId:pid,txSig:sig}).then(x=>x.json());
if(c.ok){$("#exSt").value="FINALIZED+COMMITTED";add("SYS","COMMIT OK finalized: "+sig,"sys");}
else{$("#exSt").value="COMMIT FAIL";add("SYS","COMMIT FAIL: "+JSON.stringify(c),"sys");}
}catch(e){$("#exSt").value="SIGN/SEND FAIL";add("SYS","Sign/Send fail: "+e,"sys");}}
async function kill(){add("SYS","Kill-switch est server-side via config/exec_allowlist.json (killSwitch=true).","sys");$("#exSt").value="EDIT CFG ON VPS";}


chown -R www-data:www-data "$BASE"
chmod 644 "$BASE/index.html" "$STATE_JS"

nginx -t
systemctl reload nginx

echo "$(date) AIAQUILA FULL ACTIVE" >> "$LOG"

echo "==============================="
echo "✅ AIAQUILA 1-2-3-4-5 ACTIVE"
echo "➡ https://fireinners.online/aiaquila/"
echo "==============================="

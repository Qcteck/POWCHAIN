set -euo pipefail
SECRET_PATH="/sentinel1"
APP_DIR="/opt/traderone"
NGX="/etc/nginx/sites-available/fireinners.online-ssl"

echo "=== BATCH FLY / TRADERONE ==="
echo "[SYSTEM]";uname -a||true;lsb_release -a 2>/dev/null||true;date
echo
echo "[NGINX]";systemctl is-active nginx && echo "nginx:active" || echo "nginx:inactive"
nginx -t || true
echo
echo "[LISTEN 443]";ss -lntp | egrep "(:443\b|nginx)" || true
echo
echo "[UFW]";ufw status||true
echo
echo "[VHOST exists?] $NGX";test -f "$NGX" && echo "OK" || echo "MISSING"
echo
echo "[APP_DIR] $APP_DIR";test -d "$APP_DIR" && (echo "present";ls -la "$APP_DIR" | sed -n '1,40p') || echo "absent"
echo
echo "[SECRET_PATH collision?]";grep -R "location[[:space:]]\+\\^\\~[[:space:]]\\+$SECRET_PATH/" -n /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null || echo "none"
echo
echo "[HTTPS page check] https://127.0.0.1$SECRET_PATH/ (local)";curl -k -sS --max-time 2 "https://127.0.0.1$SECRET_PATH/" | head -c 180; echo
echo "=== END ==="
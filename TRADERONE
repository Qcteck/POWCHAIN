cat >/root/MEGA_FIX_WOLVERINE_403_BY_RULE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
SITES="/etc/nginx/sites-available/fireinners.online-ssl"

echo "== MEGA_FIX_WOLVERINE_403_BY_RULE :: $TS =="
echo

echo "== 0) Preconditions =="
test -f "$SITES" || { echo "[FATAL] Missing $SITES"; exit 1; }

# Try to remove immutable bit if present (best-effort)
if command -v lsattr >/dev/null 2>&1; then
  echo "--- lsattr (before) ---"
  lsattr "$SITES" || true
fi
chattr -i "$SITES" 2>/dev/null || true

echo
echo "== 1) Pick WOLVERINE folder (must contain index.html) =="
CAND1="/opt/fireinners/frontend-react/app/dist/wolverine"
CAND2="/var/www/wolverine"
WOLV=""
if test -f "$CAND1/index.html"; then WOLV="$CAND1"; fi
if test -z "$WOLV" && test -f "$CAND2/index.html"; then WOLV="$CAND2"; fi
if test -z "$WOLV"; then
  echo "[FATAL] Can't find wolverine index.html in:"
  echo " - $CAND1/index.html"
  echo " - $CAND2/index.html"
  echo
  echo "Run:"
  echo "  ls -la $CAND1 || true"
  echo "  ls -la $CAND2 || true"
  exit 1
fi
echo "OK: WOLV=$WOLV"

echo
echo "== 2) Backup nginx vhost =="
cp -a "$SITES" "${SITES}.bak_${TS}"
echo "Backup: ${SITES}.bak_${TS}"

echo
echo "== 3) Inject override location block (allow all) into correct server{} =="
python3 - <<PY
from pathlib import Path
import re

sites = Path("$SITES")
txt = sites.read_text(errors="ignore")

BEGIN = "# --- AUTO_WOLVERINE_403_FIX_BEGIN ---"
END   = "# --- AUTO_WOLVERINE_403_FIX_END ---"

# Idempotent: if already present, do nothing
if BEGIN in txt and END in txt:
    print("OK: marker already present, no change")
else:
    wpath = r"$WOLV".replace("\\", "/").rstrip("/")
    block = f"""
    {BEGIN}
    # Force public access for /wolverine (override inherited deny rules)
    location = /wolverine {{ return 301 /wolverine/; }}
    location ^~ /wolverine/ {{
        allow all;
        auth_basic off;
        satisfy any;
        # Serve static files directly from the wolverine folder
        alias {wpath}/;
        try_files $uri $uri/ /index.html;
    }}
    {END}
"""

    # Find the server{} that contains server_name fireinners.online (or www.fireinners.online)
    # Simple brace matching for server blocks.
    pattern = re.compile(r"server\s*\{", re.I)
    idxs = [m.start() for m in pattern.finditer(txt)]
    if not idxs:
        raise SystemExit("FATAL: No server{ } blocks found in vhost")

    def find_block(start):
        depth = 0
        i = start
        while i < len(txt):
            c = txt[i]
            if c == "{": depth += 1
            elif c == "}":
                depth -= 1
                if depth == 0:
                    return (start, i+1)
            i += 1
        return None

    chosen = None
    for s in idxs:
        blk = find_block(s)
        if not blk: 
            continue
        a,b = blk
        chunk = txt[a:b]
        if re.search(r"server_name\s+[^;]*\bfireinners\.online\b", chunk, re.I):
            chosen = (a,b,chunk)
            break

    if not chosen:
        raise SystemExit("FATAL: Could not locate server block containing server_name fireinners.online")

    a,b,chunk = chosen

    # Insert right before the closing "}" of that server{}
    insert_pos = b-1
    newtxt = txt[:insert_pos] + block + txt[insert_pos:]
    sites.write_text(newtxt)
    print("OK: injected AUTO_WOLVERINE_403_FIX block into fireinners.online server{}")
PY

echo
echo "== 4) Show any deny rules near wolverine (for verification) =="
nginx -T 2>/dev/null | grep -nEi "wolverine|deny|allow|auth_basic" | head -n 220 || true

echo
echo "== 5) Test + reload nginx =="
nginx -t
systemctl reload nginx

echo
echo "== 6) Local header checks =="
for U in "https://127.0.0.1/wolverine/" "https://127.0.0.1/wolverine/index.html"; do
  echo "--- curl -kI $U ---"
  curl -kI "$U" | sed -n '1,20p' || true
done

echo
echo "== 7) Tail nginx error log (last 60 lines) =="
test -f /var/log/nginx/error.log && tail -n 60 /var/log/nginx/error.log || true

# Restore immutable bit if it was used (best-effort)
chattr +i "$SITES" 2>/dev/null || true
if command -v lsattr >/dev/null 2>&1; then
  echo "--- lsattr (after) ---"
  lsattr "$SITES" || true
fi

echo
echo "DONE."
BASH
chmod +x /root/MEGA_FIX_WOLVERINE_403_BY_RULE.sh
/root/MEGA_FIX_WOLVERINE_403_BY_RULE.sh
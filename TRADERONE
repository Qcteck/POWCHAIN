bash -s <<'SH'
set -euo pipefail
TS="$(date +%s)"
SITE="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SITESEN="/etc/nginx/sites-enabled"
NGINXCONF="/etc/nginx/nginx.conf"
DIST="/opt/fireinners/frontend-react/app/dist"
WOLVDIR="$DIST/wolverine"
UI="$WOLVDIR/index.html"
MARK_BEGIN="# BEGIN WOLVERINE_BLOCK_V1"
MARK_END="# END WOLVERINE_BLOCK_V1"

log(){ echo "[MEGA_WOLV][$TS] $*"; }
die(){ echo "[MEGA_WOLV][$TS][ERR] $*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "Lance en root."

# 1) Dossiers
mkdir -p "$WOLVDIR"

# 2) Déverrouille nginx si immuable + backups
chattr -i "$NGINXCONF" "$VHOST" 2>/dev/null || true
cp -af "$NGINXCONF" "${NGINXCONF}.bak.$TS" || true
[ -f "$VHOST" ] || die "VHOST introuvable: $VHOST"
cp -af "$VHOST" "${VHOST}.bak.$TS"

# 3) GIT PULL (trouve un repo existant, stash auto)
pick_repo_dir(){ for d in /opt/fireinners /opt/fireinners/frontend-react /opt/traderone-opt; do [ -d "$d/.git" ] && { echo "$d"; return 0; }; done; return 1; }
REPO="$(pick_repo_dir || true)"
[ -n "${REPO:-}" ] || die "Repo .git introuvable dans /opt/fireinners /opt/fireinners/frontend-react /opt/traderone-opt"
log "GIT repo=$REPO"
cd "$REPO"
if ! git diff --quiet || ! git diff --cached --quiet; then git stash push -u -m "autostash-$TS" >/dev/null || true; log "GIT autostash=1"; else log "GIT autostash=0"; fi
git fetch --all --prune
git pull --rebase
log "GIT commit=$(git rev-parse --short HEAD)"

# 4) UI WOLVERINE (interface que tu aimes) -> /opt/fireinners/frontend-react/app/dist/wolverine/index.html
cat >"$UI" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE</title><style>:root{--bg:rgba(6,16,39,.85);--bg-light:rgba(240,240,240,.92);--text:#f0f0f0;--text-dark:#111;--accent:#fff;--m:#c0c8e0;--ok:#86ffd0;--bad:#ff7b7b}*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,-apple-system,Segoe UI,Roboto}html,body{height:100%;background:radial-gradient(1100px 600px at 20% 0%,rgba(10,19,40,.7) 0%,transparent 60%),radial-gradient(900px 520px at 80% 20%,rgba(16,26,51,.7) 0%,transparent 55%),var(--bg);color:var(--text)}body.light{background:var(--bg-light);color:var(--text-dark)}#wrap{max-width:1200px;margin:18px auto;padding:16px;display:flex;flex-direction:column;gap:14px;background:rgba(0,0,0,.2);border-radius:18px}#bar{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:rgba(0,0,0,.25);border:1px solid rgba(255,255,255,.12);box-shadow:0 10px 40px rgba(255,255,255,.05)}#logo{width:50px;height:50px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.35),transparent 55%),linear-gradient(135deg,rgba(255,255,255,.14),rgba(0,0,0,.18));position:relative;overflow:hidden}#logo::after{content:"W";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-weight:900;letter-spacing:.5px;opacity:.9}#logo.hasimg::after{content:""}#logo.hasimg{background:url("./logo.png") no-repeat center/contain}#title{font-weight:800;letter-spacing:.6px}#sub{color:var(--m);font-size:12px;margin-top:2px}#topBtns{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}button{padding:8px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.18);cursor:pointer;user-select:none;transition:all .15s;background:rgba(255,255,255,.15);color:#fff}button:hover{border-color:rgba(255,255,255,.35);transform:translateY(-1px)}button:active{transform:translateY(1px)}.primary{background:linear-gradient(135deg,rgba(255,255,255,.85),rgba(238,238,238,.85));color:#000;border-color:rgba(255,255,255,.28)}.danger{background:linear-gradient(135deg,rgba(255,74,74,.85),rgba(176,16,16,.85));border-color:rgba(255,190,190,.28)}.okbtn{background:linear-gradient(135deg,rgba(31,224,141,.85),rgba(10,155,98,.85));border-color:rgba(170,255,220,.28)}.ghost{opacity:.7}#grid{display:grid;grid-template-columns:1.05fr .95fr;gap:14px}#card,#console{border-radius:18px;background:rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.12);box-shadow:0 10px 40px rgba(255,255,255,.05)}#card{padding:14px 14px 16px;display:flex;flex-direction:column;gap:12px}h3{font-size:14px;letter-spacing:.3px;color:rgba(255,255,255,.92)}body.light h3{color:#111}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:6px 0}label{display:block;color:var(--m);font-size:12px;margin-bottom:4px}input,select{width:100%;padding:10px 12px;border-radius:14px;background:rgba(0,0,0,.15);border:1px solid rgba(255,255,255,.16);color:var(--text);outline:none}body.light input,body.light select{background:rgba(255,255,255,.8);color:#111;border-color:rgba(0,0,0,.12)}input:focus,select:focus{border-color:rgba(255,255,255,.35)}.col{flex:1;min-width:220px}.mini{min-width:160px}.kpi{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}.box{padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);box-shadow:0 0 8px rgba(255,255,255,.08)}body.light .box{background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.1)}.box b{display:block;font-size:12px;color:var(--m);font-weight:600}.box span{display:block;margin-top:4px;font-size:13px}#console{padding:14px 14px 16px;display:flex;flex-direction:column;gap:10px}#log{height:300px;overflow:auto;padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;white-space:pre-wrap;color:#fff}body.light #log{background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.1);color:#111}#foot{margin-top:2px;color:var(--m);font-size:12px;display:flex;gap:12px;flex-wrap:wrap;align-items:center}#dot{display:inline-block;width:8px;height:8px;border-radius:99px;background:#666}#dot.ok{background:var(--ok)}#dot.bad{background:var(--bad)}#settingsPanel{position:fixed;top:60px;right:20px;width:230px;padding:14px;background:rgba(0,0,0,.75);border-radius:14px;display:none;flex-direction:column;gap:8px;z-index:999;border:1px solid rgba(255,255,255,.12)}#settingsPanel label{color:#fff;font-size:12px}#settingsPanel select,#settingsPanel input[type=color]{width:100%}@media(max-width:980px){#grid{grid-template-columns:1fr}}</style></head><body><div id="wrap"><div id="bar"><div id="logo"></div><div><div id="title">WOLVERINE</div><div id="sub">TraderOne • Monitoring • KPI</div></div><div id="topBtns"><button id="bPing" class="ghost">Ping</button><button id="bRefresh" class="ghost">Refresh</button><button id="bSettings" class="ghost">Settings</button><button id="bStart" class="primary">Start</button><button id="bStop" class="danger">Stop</button></div></div><div id="grid"><div id="card"><h3>Contrôle Wallet</h3><div class="row"><div class="col mini"><label>Wallet (Phantom)</label><div class="row" style="margin:0"><button id="bConnect" class="primary">Connect</button><button id="bDisconnect">Disconnect</button></div></div><div class="col"><label>Adresse Phantom</label><input id="addr" placeholder="non connecté" readonly></div></div><div class="kpi"><div class="box" id="k1"><b>SOL (user)</b><span id="sol">-</span></div><div class="box" id="k2"><b>USDC (user)</b><span id="usdc">-</span></div><div class="box" id="k3"><b>USDC (bot)</b><span id="cust">-</span></div></div><div class="row"><div class="col"><label>Budget (USDC)</label><input id="budget" inputmode="decimal" placeholder="ex: 50"></div><div class="col"><label>Mode</label><select id="mode"><option value="safe">SAFE</option><option value="risk">RISK</option></select></div></div><div class="row"><div class="col"><label>Mint (optionnel)</label><input id="mint" placeholder="SPL mint (solana)"></div><div class="col mini"><label>Auto refresh</label><select id="auto"><option value="on">ON</option><option value="off">OFF</option></select></div></div></div><div id="console"><h3>Console</h3><div id="log"></div><div id="foot"><span><i id="dot"></i> <span id="apiState">API: ?</span></span><span>Dernier refresh: <span id="last">-</span></span><span>Erreurs: <span id="errs">0</span></span><span>Latence: <span id="lat">-</span></span></div></div></div></div><div id="settingsPanel"><label>Thème</label><select id="themeSelect"><option value="dark">Sombre</option><option value="light">Clair</option></select><label>Auto-refresh</label><select id="autoSelect"><option value="on">ON</option><option value="off">OFF</option></select><hr style="border:none;border-top:1px solid rgba(255,255,255,.2);margin:6px 0"><label>Couleur fond</label><input type="color" id="colorBg" value="#061027"><label>Couleur cartes</label><input type="color" id="colorCard" value="#000000"><label>Couleur boutons</label><input type="color" id="colorBtn" value="#ffffff"><label>Couleur contours</label><input type="color" id="colorBorder" value="#ffffff"></div><script>(()=>{const $=s=>document.querySelector(s);const logEl=$("#log"),dot=$("#dot"),apiState=$("#apiState");let errs=0,autoTimer=0,running=false,connected=false;const API_BASE="/wolverine/api";function now(){return new Date().toISOString().replace("T"," ").replace("Z"," UTC")}function log(m){logEl.textContent+=`[${now()}] ${m}\n`;logEl.scrollTop=logEl.scrollHeight}function setErr(){ $("#errs").textContent=String(++errs)}function setLat(ms){$("#lat").textContent=(ms>=0?`${ms}ms`:"-")}function setLast(){ $("#last").textContent=now()}function hexToRgba(hex,a=1){let c;if(/^#([A-Fa-f0-9]{3}){1,2}$/.test(hex)){c=hex.substring(1).split('');if(c.length==3)c=[c[0],c[0],c[1],c[1],c[2],c[2]];c='0x'+c.join('');return `rgba(${(c>>16)&255},${(c>>8)&255},${c&255},${a})`;}return hex}function savePrefs(p){localStorage.setItem("wolvPrefs",JSON.stringify(p))}function loadPrefs(){return JSON.parse(localStorage.getItem("wolvPrefs")||"{}")}function applyColors(p){if(p.bg)document.documentElement.style.setProperty('--bg',hexToRgba(p.bg,.85));if(p.card)document.querySelectorAll('#card,#console').forEach(el=>{el.style.background=hexToRgba(p.card,.2)});if(p.btn)document.querySelectorAll('button').forEach(el=>{el.style.background=hexToRgba(p.btn,.15)});if(p.border)document.querySelectorAll('#card,#console,button').forEach(el=>{el.style.borderColor=hexToRgba(p.border,.18)})}function updateButtons(){$("#bConnect").disabled=connected;$("#bDisconnect").disabled=!connected;$("#bStart").disabled=!connected||running;$("#bStop").disabled=!running}function fmt(n){const x=Number(n);return Number.isFinite(x)?(Math.round(x*100000)/100000).toString():"-"}async function connect(){try{const p=window.solana;if(!p||!p.isPhantom){log("Phantom introuvable");setErr();return}const res=await p.connect();$("#addr").value=res.publicKey.toString();log("Phantom connecté");connected=true;updateButtons();await refresh()}catch(e){setErr();log("Phantom connect error")}}async function disconnect(){try{const p=window.solana;if(p&&p.disconnect)await p.disconnect();$("#addr").value="";log("Phantom déconnecté");connected=false;updateButtons()}catch(e){setErr();log("Phantom disconnect error")}}async function apiPost(path,obj){try{const r=await fetch(API_BASE+path,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(obj||{}),cache:"no-store"});const txt=await r.text();let out=null;try{out=JSON.parse(txt)}catch(_){out={nonjson:txt}}return{ok:r.ok,status:r.status,data:out}}catch(e){setErr();return{ok:false,status:0,data:{err:"fetch"}}}}async function start(){running=true;updateButtons();const payload={budgetUsdc:parseFloat($("#budget").value)||0,mode:$("#mode").value,mint:$("#mint").value.trim(),phantomPubkey:$("#addr").value,ts:Date.now()};const r=await apiPost("/start",payload);log("start: "+JSON.stringify(r));if(!r.ok)setErr()}async function stop(){running=false;updateButtons();const r=await apiPost("/stop",{ts:Date.now()});log("stop: "+JSON.stringify(r));if(!r.ok)setErr()}async function ping(){const t0=performance.now();const r=await fetch(API_BASE+"/ping",{cache:"no-store"});const tx=(await r.text()).trim();setLat(Math.round(performance.now()-t0));dot.className=(tx==="pong")?"ok":"bad";apiState.textContent="API: "+tx;log("ping: "+tx);return tx}async function balances(){const pub=$("#addr").value.trim();if(!pub)return null;const r=await fetch(API_BASE+"/balances2?pub="+encodeURIComponent(pub),{cache:"no-store"});const txt=await r.text();let j=null;try{j=JSON.parse(txt)}catch(_){j={nonjson:txt}}return j}function setKpi(sol,usdc,bot){$("#sol").textContent=fmt(sol);$("#usdc").textContent=fmt(usdc);$("#cust").textContent=fmt(bot);const k=(el,ok)=>{el.style.borderColor=ok?"var(--ok)":"var(--bad)"};k($("#k1"),Number(sol)>0);k($("#k2"),Number(usdc)>=0);k($("#k3"),Number(bot)>=0)}async function refresh(){try{await ping();let b=null;try{b=await balances()}catch(e){b=null}if(b&&b.nonjson){log("balances2 non-json: "+String(b.nonjson).slice(0,140));setErr()}else if(b){const us=b.user||b.phantom||b.wallet||b;const bt=b.bot||b.traderone||b.custody||{};setKpi(us.sol,us.usdc,bt.usdc);log("balances2: "+JSON.stringify({user:{sol:us.sol,usdc:us.usdc},bot:{usdc:bt.usdc}}))}setLast()}catch(e){setErr();dot.className="bad";apiState.textContent="API: ERR";log("refresh error")}}function autoSet(){clearInterval(autoTimer);autoTimer=0;if($("#auto").value==="on")autoTimer=setInterval(()=>refresh().catch(()=>0),8000)}$("#bConnect").onclick=connect;$("#bDisconnect").onclick=disconnect;$("#bStart").onclick=start;$("#bStop").onclick=stop;$("#bPing").onclick=refresh;$("#bRefresh").onclick=refresh;$("#bSettings").onclick=()=>$("#settingsPanel").style.display=($("#settingsPanel").style.display==="flex"?"none":"flex");$("#themeSelect").onchange=e=>{document.body.className=e.target.value;savePrefs({...loadPrefs(),theme:e.target.value})};$("#autoSelect").onchange=e=>{$("#auto").value=e.target.value;autoSet();savePrefs({...loadPrefs(),autoRefresh:e.target.value})};$("#colorBg").oninput=e=>{applyColors({...loadPrefs(),bg:e.target.value});savePrefs({...loadPrefs(),bg:e.target.value})};$("#colorCard").oninput=e=>{applyColors({...loadPrefs(),card:e.target.value});savePrefs({...loadPrefs(),card:e.target.value})};$("#colorBtn").oninput=e=>{applyColors({...loadPrefs(),btn:e.target.value});savePrefs({...loadPrefs(),btn:e.target.value})};$("#colorBorder").oninput=e=>{applyColors({...loadPrefs(),border:e.target.value});savePrefs({...loadPrefs(),border:e.target.value})};(async()=>{try{const img=new Image();img.onload=()=>{$("#logo").classList.add("hasimg")};img.src="./logo.png?ts="+Date.now()}catch(e){}const prefs=loadPrefs();if(prefs.theme)document.body.className=prefs.theme;if(prefs.autoRefresh)$("#auto").value=prefs.autoRefresh;applyColors(prefs);updateButtons();autoSet();await refresh()})();})();</script></body></html>
HTML
chmod 0644 "$UI" || true
log "UI écrite: $UI"

# 5) NGINX: désactive les vhosts en double (même server_name) SANS toucher au canon
CANON="$VHOST"
mkdir -p /root/wolv_backups 2>/dev/null || true
for f in "$SITESEN"/*; do
  [ -e "$f" ] || continue
  tgt="$f"
  [ -L "$f" ] && tgt="$(readlink -f "$f" || echo "$f")"
  if grep -qE "^[[:space:]]*server_name[[:space:]].*${SITE//./\\.}" "$tgt" 2>/dev/null; then
    if [ "$(readlink -f "$tgt" 2>/dev/null || echo "$tgt")" != "$(readlink -f "$CANON" 2>/dev/null || echo "$CANON")" ]; then
      mv -f "$f" "$f.disabled.$TS" 2>/dev/null || rm -f "$f" 2>/dev/null || true
      log "disable extra sites-enabled: $f"
    fi
  fi
done
ln -sfn "$CANON" "$SITESEN/$(basename "$CANON")" || true

# 6) Patch vhost: bloc Wolverine (idempotent)
BLOCK="$MARK_BEGIN
location ^~ /wolverine/api/ {
  rewrite ^/wolverine/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_read_timeout 60s;
}
location ^~ /wolverine/ {
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  try_files \$uri \$uri/ /wolverine/index.html;
}
$MARK_END"

if grep -qF "$MARK_BEGIN" "$VHOST"; then
  perl -0777 -i -pe 's/\Q'"$MARK_BEGIN"'\E.*?\Q'"$MARK_END"'\E/'"$BLOCK"'/s' "$VHOST"
  log "VHOST bloc remplacé"
else
  perl -0777 -i -pe 's/\n}\s*\z/\n'"$BLOCK"'\n}\n/s' "$VHOST"
  log "VHOST bloc inséré"
fi

# 7) Reload nginx (restore auto si fail)
if nginx -t; then
  systemctl restart nginx || systemctl reload nginx || true
  log "NGINX OK"
else
  cp -af "${VHOST}.bak.$TS" "$VHOST" || true
  systemctl restart nginx || true
  die "nginx -t a échoué. J'ai restauré: ${VHOST}.bak.$TS"
fi

# 8) (option) remets immuable
chattr +i "$NGINXCONF" "$VHOST" 2>/dev/null || true

log "DONE"
log "URL: https://$SITE/wolverine/"
SH
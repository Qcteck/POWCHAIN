python3 - <<'PY'
import re

ngx = "/etc/nginx/sites-available/fireinners.online-ssl"
inc = "include /etc/nginx/snippets/wolverine_static_tryfiles.conf; # WOLV_STATIC_TRYFILES_V1\n"

with open(ngx, "r", encoding="utf-8", errors="ignore") as f:
    s = f.read()

if "wolverine_static_tryfiles.conf" in s:
    print("OK: include déjà présent")
else:
    # insère après le premier "server {"
    m = re.search(r'(^\s*server\s*\{\s*$)', s, flags=re.M)
    if not m:
        raise SystemExit("ERREUR: pas trouvé 'server {'.")
    pos = m.end()
    s2 = s[:pos] + "\n    " + inc + s[pos:]
    with open(ngx, "w", encoding="utf-8") as f:
        f.write(s2)
    print("OK: include ajouté")

PY

nginx -t && systemctl reload nginx



echo "=== HTML /wolverine (premières lignes) ==="
curl -ksS https://fireinners.online/wolverine/ | sed -n '1,40p'

echo
echo "=== Scripts référencés ==="
curl -ksS https://fireinners.online/wolverine/ | grep -oE '<script[^>]+src="[^"]+"' | sed -E 's/.*src="([^"]+)".*/\1/' | nl -ba

echo
echo "=== Test rapide de chaque script (status + 1ère ligne) ==="
while read -r p; do
  [ -z "$p" ] && continue
  u="https://fireinners.online${p}"
  echo "--- $u"
  curl -kIs "$u" | head -n 1
  curl -ksS "$u" | head -n 1
done < <(curl -ksS https://fireinners.online/wolverine/ | grep -oE '<script[^>]+src="[^"]+"' | sed -E 's/.*src="([^"]+)".*/\1/')


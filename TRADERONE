set -e
cd /root

echo "=== 1) TEST POST sur le gateway (3002) ==="
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" \
  -H "content-type: application/json" --data '{}' | head -n 40 || true

echo
echo "=== 2) Montre le handler gateway (autour de app.use /wolverine/api/) ==="
nl -ba /opt/wolverine-api/server.js | sed -n '100,160p'

echo
echo "=== 3) PATCH: gateway forward req.method + body (backup + edit) ==="
cp -v /opt/wolverine-api/server.js "/root/wolverine-api.server.js.$(date +%Y%m%d_%H%M%S).bak"

# Remplace un "method: 'GET'" (si présent) par "method: req.method"
perl -pi -e "s/method:\s*'GET'/method: req.method/g" /opt/wolverine-api/server.js

# Si le gateway utilise fetch(), on injecte un body conditionnel (POST/PUT/PATCH)
# (ça n'ajoute le body que si on voit 'fetch(' dans le fichier)
if grep -q "fetch(" /opt/wolverine-api/server.js; then
  perl -0777 -i -pe 's/(fetch\(\s*upstreamUrl\s*,\s*\{\s*\n(?:[^\}]*\n)*?method:\s*req\.method\s*,\s*\n)/$1  body: (req.method === "GET" || req.method === "HEAD") ? undefined : JSON.stringify(req.body || {}),\n/s' /opt/wolverine-api/server.js || true
fi

systemctl restart wolverine-api.service
sleep 1

echo
echo "=== 4) RE-TEST POST gateway (3002) ==="
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" \
  -H "content-type: application/json" --data '{}' | head -n 60 || true
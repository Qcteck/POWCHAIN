set -euo pipefail
TS="$(date +%s)"

echo "== 0) Mettre de côté les backups qui cassent nginx (si nginx include *) =="
mkdir -p /root/nginx_quarantine_$TS
for dir in /etc/nginx/sites-enabled /etc/nginx/conf.d; do
  [ -d "$dir" ] || continue
  find "$dir" -maxdepth 1 -type f \
    \( -name "*.bak.*" -o -name "*.bad.*" -o -name "*.old" -o -name "*.tmp" -o -name "*~" \) \
    -print -exec mv -v {} /root/nginx_quarantine_"$TS"/ \; || true
done

echo
echo "== 1) Voir l’erreur exacte (file:line) =="
nginx -t 2>&1 | tail -n 60 || true

echo
echo "== 2) Trouver et supprimer TOUTES les lignes proxy_set_header qui ont une valeur manquante =="
# match: proxy_set_header <NAME> ;
mapfile -t BADFILES < <(grep -RIl --include='*.conf' -E 'proxy_set_header[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;' /etc/nginx || true)

if [ "${#BADFILES[@]}" -eq 0 ]; then
  echo "Aucune ligne cassée trouvée avec ce pattern."
else
  printf "Fichiers à corriger:\n"; printf " - %s\n" "${BADFILES[@]}"
  for f in "${BADFILES[@]}"; do
    cp -a "$f" "$f.bak.$TS"
    sed -i -E '/proxy_set_header[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;/d' "$f"
    echo "Fixed: $f (backup: $f.bak.$TS)"
  done
fi

echo
echo "== 3) Re-test nginx (DOIT PASSER) =="
nginx -t

echo
echo "== 4) Reload nginx =="
systemctl reload nginx

echo "OK ✅ nginx reload"
<script src="https://static.sketchfab.com/api/sketchfab-viewer-1.12.1.js"></script>
<script>
/* ========= RSS / Ticker / Voix ========= */
const FEEDS=[
 "https://journalducoin.com/feed/","https://cryptoast.fr/feed/","https://coinacademy.fr/feed/",
 "https://fr.beincrypto.com/feed/","https://cryptonaute.fr/feed/","https://fr.cryptonews.com/news/feed/",
 "https://www.cointribune.com/feed/","https://bitcoin.fr/feed","https://coinjournal.net/fr/actualites/feed/"
];
const $=id=>document.getElementById(id),sleep=ms=>new Promise(r=>setTimeout(r,ms)),
      clean=t=>(t||"").replace(/<[^>]+>/g," ").replace(/\s+/g," ").trim();

async function fetchVia(u){try{const r=await fetch("https://api.allorigins.win/raw?url="+encodeURIComponent(u));return await r.text()}catch{return""}}
function parseXML(x){if(!x)return[];const d=new DOMParser().parseFromString(x,"application/xml");
  return[...d.querySelectorAll("item,entry")].map(n=>({title:clean(n.querySelector("title")?.textContent||"")})).filter(v=>v.title)}

let QUEUE=[],qi=0,timer=null;
function setTick(it){$('msg').innerHTML='• '+it.title;$('msg').style.animation='none';void $('msg').offsetWidth;$('msg').style.animation=''}
async function loadAll(){const jobs=FEEDS.map(async f=>parseXML(await fetchVia(f)));return(await Promise.all(jobs)).flat()}
function startTicker(){if(!QUEUE.length)return;clearInterval(timer);$('count').textContent=QUEUE.length;setTick(QUEUE[qi%QUEUE.length]);const per=14000;timer=setInterval(()=>{qi=(qi+1)%QUEUE.length;setTick(QUEUE[qi])},per)}

let maleQc=null;speechSynthesis.onvoiceschanged=()=>{const vs=speechSynthesis.getVoices();
  maleQc=vs.find(v=>/fr[-_]?CA|québ|canad/i.test(v.lang))||vs.find(v=>/^fr\b/i.test(v.lang))||vs[0];};

/* ========= Modèles / Décors (officiels) ========= */
const MODELS=[
  {id:"79853f26b0424c89baf7d8f0020c08b6",name:"Woman 2 C4D"},
  {id:"89700ba9bbde42dfb9b79a46622fdb56",name:"Wednesday Addams"},
  {id:"e6c60cafd33c4d54b0b840c4146ed244",name:"Indian Office Woman"},
  {id:"21594aa9db994b188abd3dd84e2b119f",name:"Woman with some animations"}
];
const BACKDROPS=[
  {id:"fe8b98be13a6467f85c6343676ae3bb2",name:"Studio futuriste"},
  {id:"bab28c8336f944afad0cc759d7f5ec0b",name:"Old bar"},
  {id:"a1177381d3464f75b10cb8f462f0b9a5",name:"After the rain — VR"}
];

let mode="bg",m=0,b=0,apiBg=null,apiModel=null,readyBg=false,readyModel=false;

/* ====== Init Sketchfab (gestes natifs identiques) ====== */
function initViewer(el,uid,onReady){
  const c=new Sketchfab('1.12.1',el); el.style.opacity=.2;
  c.init(uid,{autostart:0,transparent:1,ui_infos:0,ui_watermark:0,ui_theme:'dark',ui_controls:1,camera:0,
    success:a=>{a.start();a.addEventListener('viewerready',()=>{el.style.opacity=1;onReady(a)})},
    error:()=>{el.src=`https://sketchfab.com/models/${uid}/embed?autostart=0&ui_controls=1&camera=0&ui_infos=0&ui_watermark=0&transparent=1`;el.style.opacity=1;onReady(null)}});
}
function loadBg(uid){readyBg=false;initViewer($('bg'),uid,a=>{apiBg=a;readyBg=!!a;applyRouting();})}
function loadModel(uid){readyModel=false;initViewer($('reporterIframe'),uid,a=>{apiModel=a;readyModel=!!a;applyRouting();})}

/* ====== Pointer routing: un seul calque interactif ====== */
function applyRouting(){
  const bg=$('bg'), wrap=$('reporter'), rep=$('reporterIframe');
  if(mode==='bg'){
    bg.style.pointerEvents='auto';
    wrap.style.pointerEvents='none';   // IMPORTANT: le conteneur ne bloque pas le décor
    rep.style.pointerEvents='none';
    $('toggle').textContent='🎬 Décor';
  }else{
    bg.style.pointerEvents='none';
    wrap.style.pointerEvents='auto';
    rep.style.pointerEvents='auto';
    $('toggle').textContent='🧍 Modèle';
  }
  setInfo();
}
function setInfo(){const cur=mode==="bg"?BACKDROPS[b]:MODELS[m];$('info').textContent=(mode==="bg"?"Décor : ":"Modèle : ")+cur.name}

/* ====== Caméra: clonage au switch ====== */
function getCam(api){return new Promise(ok=>{try{api.getCameraLookAt((e,c)=>{if(e||!c){ok(null);return}
  const eye=c.position||c.eye||[0,1.6,3],target=c.target||c.center||[0,1.45,0];
  try{api.getFov((er,f)=>ok({eye,target,fov:er?null:f}))}catch{ok({eye,target,fov:null})}})}catch{ok(null)}})}
function setCam(api,{eye,target,fov},t=0.01){try{api.setCameraLookAt(eye,target,t)}catch{}try{if(fov!=null&&api.setFov)api.setFov(fov)}catch{}}
async function cloneCam(src,dst){const v=await getCam(src);if(v)setCam(dst,v,0.01)}

/* ====== LIP-SYNC “officiel” (morphs + fallback) ====== */
let speaking=false, env=0, vuTimer=null, morphTimer=null, seekTimer=null, morphName=null;
const VU=$('vu'), VUbars=[...VU.querySelectorAll('span')];
const MORPHS=["jawOpen","mouthOpen","MouthOpen","Mouth_Open","Jaw_Open","Aah","AA","AAA","Ah","Mouth_Ah",
  "viseme_aa","viseme_ii","viseme_ou","viseme_U","viseme_O","viseme_E",
  "vrc.v_aa","vrc.v_E","vrc.v_O","vrc.v_U","vrc.v_I","lipsRoll","Lips_Open","CheekPuff"];

async function detectMorph(){
  morphName=null;
  try{
    if(!apiModel||!apiModel.setMorphTarget) return null;
    for(const n of MORPHS){
      try{ apiModel.setMorphTarget(n,0.0); morphName=n; break; }catch{}
    }
  }catch{}
  return morphName;
}
function mouthOpen(v){
  try{
    if(apiModel && morphName && apiModel.setMorphTarget) apiModel.setMorphTarget(morphName,Math.max(0,Math.min(1,v)));
  }catch{}
}
function startVU(){
  VU.style.display='flex';
  clearInterval(vuTimer);
  vuTimer=setInterval(()=>{
    const a=Math.min(5,1+Math.round(env*4));
    VUbars.forEach((b,k)=>b.classList.toggle('on',k<a));
    env=Math.max(0,env-0.06);
  },70);
}
function stopVU(){ clearInterval(vuTimer); vuTimer=null; VU.style.display='none'; VUbars.forEach(b=>b.classList.remove('on')); }

function startMouthLoop(){
  clearInterval(morphTimer);
  morphTimer=setInterval(()=>{
    // oscillation + “kicks” sur les syllabes via env
    const kick=env*0.75;
    const base=0.35+Math.sin(performance.now()/120)*0.25 + (Math.random()-0.5)*0.08 + kick;
    mouthOpen(Math.max(0.08,Math.min(0.98,base)));
  },60);
}
function stopMouthLoop(){ clearInterval(morphTimer); morphTimer=null; mouthOpen(0); }

function startSeekFallback(){
  if(seekTimer) clearInterval(seekTimer);
  if(!apiModel||!apiModel.setCurrentAnimationTime) return;
  let t=0;
  // on “gratte” l’anim (si une anim bouche existe côté modèle)
  seekTimer=setInterval(()=>{ if(!speaking){clearInterval(seekTimer); seekTimer=null; return;}
    try{ t=(t+0.04)%1.0; apiModel.setCurrentAnimationTime(t); }catch{} },70);
}
function stopSeekFallback(){ if(seekTimer){clearInterval(seekTimer); seekTimer=null;} }

/* ====== Voix + déclencheurs lip-sync ====== */
async function speak(text){
  try{ speechSynthesis.cancel(); }catch{}
  await detectMorph(); // essaie morphs d’abord

  return new Promise(res=>{
    const u=new SpeechSynthesisUtterance(text);
    u.lang='fr-CA'; if(maleQc) u.voice=maleQc; u.rate=1; u.pitch=.9;

    u.onstart=()=>{
      speaking=true; env=.8; startVU(); startMouthLoop();
      if(!morphName) startSeekFallback();
    };
    u.onboundary=()=>{ env=Math.min(1,env+0.55); mouthOpen(.98); setTimeout(()=>mouthOpen(.4),70); };
    u.onend=()=>{ speaking=false; stopVU(); stopMouthLoop(); stopSeekFallback(); res(); };

    speechSynthesis.speak(u);
  });
}

/* ====== Lecture RSS avec voix + lipsync ====== */
async function readItem(it){ $('nowTitle').textContent=it.title; await speak(it.title); }
async function loop(){ while(true){ if(qi>=QUEUE.length){ QUEUE=await loadAll(); qi=0; startTicker(); }
  if(!QUEUE.length) break; await readItem(QUEUE[qi++]); await sleep(420); }}

/* ====== UI ====== */
$('toggle').onclick=async()=>{
  const was=mode;
  mode = (mode==='bg') ? 'model' : 'bg';
  try{ if(was==='bg'&&readyBg&&readyModel) await cloneCam(apiBg,apiModel);
       if(was==='model'&&readyModel&&readyBg) await cloneCam(apiModel,apiBg); }catch{}
  applyRouting();
};
$('right').onclick=()=>{ if(mode==='bg'){ b=(b+1)%BACKDROPS.length; loadBg(BACKDROPS[b].id); }
                          else{ m=(m+1)%MODELS.length; loadModel(MODELS[m].id); } setInfo(); };
$('left').onclick=()=>{ if(mode==='bg'){ b=(b-1+BACKDROPS.length)%BACKDROPS.length; loadBg(BACKDROPS[b].id); }
                         else{ m=(m-1+MODELS.length)%MODELS.length; loadModel(MODELS[m].id); } setInfo(); };

/* ====== ON AIR ====== */
$('onair').onclick=async()=>{ if(speechSynthesis.speaking){ speechSynthesis.cancel(); $('onair').textContent='▶️ ON AIR'; return; }
  $('onair').textContent='⏹️ Stop'; if(!QUEUE.length){ QUEUE=await loadAll(); startTicker(); } loop(); };
$('pause').onclick=()=>speechSynthesis.pause();
$('resume').onclick=()=>speechSynthesis.resume();
$('nextNews').onclick=()=>{ speechSynthesis.cancel(); qi=(qi+1)%QUEUE.length; };

/* ====== Boot ====== */
(async()=>{
  QUEUE=await loadAll(); startTicker();
  loadBg(BACKDROPS[b].id); loadModel(MODELS[m].id); applyRouting(); setInfo();
})();
</script>

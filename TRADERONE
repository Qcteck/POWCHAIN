cat >/root/WOLVERINE_SOLANA_WALLET_MODAL_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup index.html =="
cp "$HTML" "$HTML.bak_$TS"

echo "== Clean wrong EVM WalletConnect stuff =="
sed -i '/WalletConnect/d;/connectWC/d;/walletconnect/d;/Rainbow/d' "$HTML"

echo "== Vendor dir =="
mkdir -p "$VENDOR"

echo "== Download Solana Wallet Adapter (local) =="
curl -fsSL https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js \
  -o "$VENDOR/solana-web3.js"

curl -fsSL https://unpkg.com/@solana/wallet-adapter-ui@0.9.23/lib/index.iife.js \
  -o "$VENDOR/solana-wallet-adapter-ui.js"

curl -fsSL https://unpkg.com/@solana/wallet-adapter-wallets@0.19.32/lib/index.iife.js \
  -o "$VENDOR/solana-wallet-adapter-wallets.js"

echo "== Inject Solana wallet scripts =="
sed -i "/<\/head>/i \
<script src=\"/wolverine/vendor/solana-web3.js\"></script>\n\
<script src=\"/wolverine/vendor/solana-wallet-adapter-wallets.js\"></script>\n\
<script src=\"/wolverine/vendor/solana-wallet-adapter-ui.js\"></script>\n\
<link rel=\"stylesheet\" href=\"https://unpkg.com/@solana/wallet-adapter-ui@0.9.23/styles.css\"/>
" "$HTML"

echo "== Inject Solana Wallet Modal logic =="
sed -i "/<script>/a \
const { PhantomWalletAdapter, SolflareWalletAdapter, BackpackWalletAdapter } = solanaWalletAdapterWallets;\n\
const wallets = [ new PhantomWalletAdapter(), new SolflareWalletAdapter(), new BackpackWalletAdapter() ];\n\
const walletModal = new solanaWalletAdapterUi.WalletModalProvider({ wallets });\n\
async function connect(){ walletModal.open(); }\n" "$HTML"

echo "== Fix permissions =="
chown -R www-data:www-data /var/www/wolverine
chmod 644 "$HTML"

echo "=============================="
echo "✅ SOLANA WALLET MODAL INSTALLED"
echo "❌ WalletConnect / Rainbow REMOVED"
echo "➡️ Reload browser CTRL + SHIFT + R"
echo "=============================="
BASH

chmod +x /root/WOLVERINE_SOLANA_WALLET_MODAL_FIX.sh





/root/WOLVERINE_SOLANA_WALLET_MODAL_FIX.sh


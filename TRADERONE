set -e
cd /root

echo "=== 1) Montre la zone autour de la ligne 804 ==="
nl -ba /etc/nginx/nginx.conf | sed -n '780,820p'

echo
echo "=== 2) Liste toutes les lignes proxy_set_header dans nginx.conf ==="
grep -n "proxy_set_header" /etc/nginx/nginx.conf || true

echo
echo "=== 3) Backup + commente la ligne 804 (le crash) ==="
cp -v /etc/nginx/nginx.conf /etc/nginx/nginx.conf.bak.$(date +%Y%m%d_%H%M%S)
sed -i '804s/^\s*/# FIX_DISABLED_BAD_PROXY_SET_HEADER /' /etc/nginx/nginx.conf

echo
echo "=== 4) Re-test nginx ==="
nginx -t

echo
echo "=== 5) Reload nginx ==="
systemctl reload nginx
#!/usr/bin/env bash
set -euo pipefail

# === Wolverine Nginx FINAL FIX (dedup "location /wolverine" + canonical routes) ===
HOST="fireinners.online"
FRONT_DIR="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"
INC_DIR="/etc/nginx/includes"
INC="${INC_DIR}/wolverine_routes.inc"

TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/MEGA_WOLVERINE_NGINX_FINALFIX_${TS}.log"
NOHUPF="/root/MEGA_WOLVERINE_NGINX_FINALFIX_${TS}.nohup"

# self-background to survive console disconnects
if [[ "${1:-}" != "--run" ]]; then
  echo "Launching in background (nohup) -> $NOHUPF"
  nohup bash "$0" --run >"$NOHUPF" 2>&1 </dev/null & disown || true
  echo "Now run: tail -n 260 $NOHUPF"
  exit 0
fi

w(){ printf "%s\n" "$*" | tee -a "$LOG" >/dev/null; }
say(){ w ""; w "== $* =="; }
die(){ w "ERREUR: $*"; exit 1; }
ok(){ w "OK: $*"; }
warn(){ w "WARN: $*"; }

ensure_pkg(){
  local p="$1"
  if ! dpkg -s "$p" >/dev/null 2>&1; then
    apt-get update -y >>"$LOG" 2>&1
    apt-get install -y "$p" >>"$LOG" 2>&1
  fi
}

is_immutable(){
  local f="$1"
  lsattr -d "$f" 2>/dev/null | awk '{print $1}' | grep -q 'i' && return 0 || return 1
}

unlock_if_immutable(){
  local f="$1" name="$2"
  if [[ -e "$f" ]] && is_immutable "$f"; then
    chattr -i "$f" >>"$LOG" 2>&1 || true
    ok "chattr -i $name ($f)"
    return 0
  fi
  return 1
}

relock_if_needed(){
  local f="$1" name="$2" was="$3"
  if [[ "$was" == "1" ]] && [[ -e "$f" ]]; then
    chattr +i "$f" >>"$LOG" 2>&1 || true
    ok "chattr +i $name ($f)"
  fi
}

backup_file(){
  local f="$1"
  [[ -f "$f" ]] || return 0
  cp -a "$f" "$f.bak_${TS}" >>"$LOG" 2>&1 || true
  ok "backup: $f.bak_${TS}"
}

http_code_local(){
  local path="$1"
  curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1${path}" -H "Host: ${HOST}" || true
}
http_code_ext(){
  local path="$1"
  curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}${path}" || true
}


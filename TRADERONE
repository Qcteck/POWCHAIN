set -euo pipefail

BASE="/var/www/fireinners/wolverine"
HTML="$BASE/index.html"
APPJS="$BASE/app.js"
TS="$(date +%s)"

cp -a "$HTML"  "$HTML.bak.$TS"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backups: $HTML.bak.$TS | $APPJS.bak.$TS"

# A) Fix index.html: scripts vendor AVANT app.js + cache-bust
perl -i -pe 's#\s*<script[^>]+/wolverine/vendor/web3\.min\.js[^>]*></script>##gi;
             s#\s*<script[^>]+/wolverine/vendor/spl-token\.min\.js[^>]*></script>##gi;' "$HTML"

# remplace app.js par app.js?v=TS
perl -i -pe 's/src="\/wolverine\/app\.js(\?v=[0-9]+)?"/src="\/wolverine\/app.js?v='"$TS"'"/g' "$HTML"

# injecte vendor scripts juste avant app.js
perl -0777 -i -pe 's#(<script[^>]+src="\/wolverine\/app\.js\?v=[0-9]+"[^>]*></script>)#  <script src="\/wolverine\/vendor\/web3.min.js?v='"$TS"'"><\/script>\n  <script src="\/wolverine\/vendor\/spl-token.min.js?v='"$TS"'"><\/script>\n  $1#s' "$HTML"

# B) Patch app.js: CONNECT ne dépend plus des libs (Phantom seulement)
node - <<'JS'
const fs=require("fs");
const f="/var/www/fireinners/wolverine/app.js";
let s=fs.readFileSync(f,"utf8");

// Remplace dans le handler connect: "if (!libsOk()) ..." par rien
s = s.replace(/if\s*\(\s*!libsOk\(\)\s*\)\s*\{\s*setStatus\([^)]*\)\s*;\s*return\s*;\s*\}\s*/g, "");

// Si tu avais un guard global qui bloque tout, on le rend non-bloquant pour connect
fs.writeFileSync(f,s,"utf8");
console.log("Patched connect to not require libs");
JS

echo "OK ✅ Fais Ctrl+F5 sur /wolverine puis reteste Connect."
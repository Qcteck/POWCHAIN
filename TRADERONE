cat >/root/TRADERONE_FIX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== TRADERONE FIX (NO NGINX) ==="

# 1) Stop & disable nginx (sans purge)
if systemctl is-active --quiet nginx; then
  systemctl stop nginx || true
fi
systemctl disable nginx || true
echo "[OK] nginx stopped/disabled"

# 2) Dossiers figés
APP_DIR="/opt/traderone"
DATA_DIR="/opt/traderone/data"
LOG_DIR="/opt/traderone/logs"
mkdir -p "$APP_DIR" "$DATA_DIR" "$LOG_DIR"

# 3) Variables d'environnement (adapter PORT si besoin)
ENV_FILE="/opt/traderone/.env"
cat >"$ENV_FILE" <<EOF
NODE_ENV=production
PORT=3000
DATA_DIR=$DATA_DIR
LOG_DIR=$LOG_DIR
EOF
echo "[OK] env written"

# 4) Dépendances Node (safe)
cd "$APP_DIR"
if [ -f package.json ]; then
  npm ci --omit=dev || npm install --omit=dev
else
  echo "[WARN] package.json absent (skip npm)"
fi

# 5) PM2 — clean start
pm2 delete traderone || true

# Choix du point d’entrée
ENTRY=""
for f in server.js index.js app.js main.js; do
  if [ -f "$APP_DIR/$f" ]; then ENTRY="$f"; break; fi
done
if [ -z "$ENTRY" ]; then
  echo "[ERR] Aucun entrypoint trouvé (server.js/index.js/app.js/main.js)"
  exit 1
fi

pm2 start "$APP_DIR/$ENTRY" --name traderone --env production
pm2 save

# 6) Ouverture firewall si actif
if command -v ufw >/dev/null 2>&1; then
  ufw allow 3000/tcp || true
fi

# 7) Vérif locale
sleep 2
curl -fsS http://127.0.0.1:3000/ || echo "[INFO] endpoint root non défini (ok si API-only)"

echo "=== TRADERONE RUNNING (DIRECT, NO NGINX) ==="
pm2 status
SH

chmod +x /root/TRADERONE_FIX.sh
/root/TRADERONE_FIX.sh
bash <<'EOF'
set -euo pipefail

WEB="/var/www/aiaquila"
HTML="$WEB/index.html"

echo "== AIAQUILA TTS AUTO (1 clic) =="

mkdir -p "$WEB"

cat > "$HTML" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{margin:0;background:#05070a;color:#e6e6e6;font-family:system-ui}
header{padding:14px 20px;background:#0b0f1a;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{max-width:1100px;margin:auto;padding:20px}
.panel{background:#0e1424;border:1px solid #1f2937;border-radius:8px;padding:14px;margin-bottom:14px}
button,select{background:#1e40af;color:#fff;border:none;padding:8px 14px;border-radius:6px;cursor:pointer;margin-right:6px}
button.secondary{background:#374151}
.small{font-size:13px;color:#9cc9ff}
pre{background:#000;padding:10px;border-radius:6px;max-height:200px;overflow:auto}
.badge{font-size:12px;color:#9cc9ff}
</style>
</head>

<body>
<header>
  <strong>AIAQUILA</strong>
  <span id="status" class="badge">TTS: verrouillé</span>
</header>

<main>

<div class="panel">
  <h2>Journaliste IA (voix)</h2>
  <div id="speech" class="small">
    Le ton de l’article est posé, presque résigné. Rien d’alarmiste,
    mais une suite logique d’événements déjà intégrés par le marché.
  </div><br>

  <button id="unlock">▶ Démarrer la voix</button>

  <select id="voiceSel"></select>
  <button class="secondary" onclick="pauseSpeak()">⏸ Pause</button>
  <button class="secondary" onclick="stopSpeak()">⏹ Stop</button>
</div>

<div class="panel">
  <h2>Timeline</h2>
  <pre id="timeline"></pre>
</div>

<div class="panel">
  <h2>Logs</h2>
  <pre id="logs"></pre>
</div>

</main>

<script>
/* =======================
   AIAQUILA TTS CORE
   ======================= */

let unlocked = false;
let voices = [];
let queue = [];
let idx = 0;

const STATE = JSON.parse(localStorage.getItem("aiaquila_state_v2") || '{"logs":[],"timeline":[]}');

function save(){
  localStorage.setItem("aiaquila_state_v2", JSON.stringify(STATE));
}

function log(msg){
  const t = new Date().toISOString().substr(11,8);
  STATE.logs.push(`[${t}] ${msg}`);
  STATE.logs = STATE.logs.slice(-100);
  STATE.timeline.push(msg);
  save();
  render();
}

/* === VOIX === */
function loadVoices(){
  voices = speechSynthesis.getVoices();
  const sel = document.getElementById("voiceSel");
  sel.innerHTML = voices
    .filter(v=>v.lang.startsWith("fr"))
    .map(v=>`<option value="${v.name}">${v.name}</option>`)
    .join("");
}
speechSynthesis.onvoiceschanged = loadVoices;
loadVoices();

/* === DEVERROUILLAGE AUDIO (1 clic) === */
document.getElementById("unlock").onclick = () => {
  if(unlocked) return;
  unlocked = true;
  document.getElementById("status").textContent = "TTS: actif";
  log("Audio déverrouillé par utilisateur");
  buildQueue();
  speakNext();
};

/* === ENCHAÎNEMENT INTELLIGENT === */
function buildQueue(){
  const base = document.getElementById("speech").innerText.trim();
  queue = [
    base,
    "Ce qui ressort surtout, c’est l’absence de surprise réelle.",
    "Le marché semble déjà positionné sur ce scénario.",
    "La question n’est plus si cela va arriver, mais jusqu’où.",
    "Quel est ton ressenti face à cette normalisation ?"
  ];
  idx = 0;
  log("Playlist vocale construite ("+queue.length+")");
}

function speakNext(){
  if(!unlocked || idx >= queue.length) return;

  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(queue[idx]);

  u.lang = "fr-FR";
  u.rate = 1;
  u.pitch = 1;

  const selName = document.getElementById("voiceSel").value;
  const v = voices.find(x=>x.name === selName);
  if(v) u.voice = v;

  u.onend = () => {
    idx++;
    setTimeout(speakNext, 600); // respiration naturelle
  };

  speechSynthesis.speak(u);
  log("Lecture: "+queue[idx]);
}

/* === CONTROLES === */
function pauseSpeak(){
  speechSynthesis.pause();
  log("Lecture en pause");
}

function stopSpeak(){
  speechSynthesis.cancel();
  idx = queue.length;
  log("Lecture arrêtée");
}

/* === UI === */
function render(){
  document.getElementById("logs").innerText = STATE.logs.join("\n");
  document.getElementById("timeline").innerText = STATE.timeline.join("\n");
}

log("AIAQUILA prête");
render();
</script>

</body>
</html>
HTML

chown -R www-data:www-data "$WEB"
chmod 644 "$HTML"

nginx -t && systemctl reload nginx

echo "==============================="
echo "AIAQUILA TTS AUTO ACTIF"
echo "URL : https://fireinners.online/aiaquila/"
echo "ACTION : 1 clic sur ▶ Démarrer la voix"
echo "==============================="
EOF
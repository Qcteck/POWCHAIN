set -e
BASE="https://fireinners.online/wolverine/traderone/api/status"

# récupère la clé depuis le vhost SSL
KEY=$(grep -oP 'http_x_api_key != "\K[^"]+' /etc/nginx/sites-enabled/fireinners.online-ssl | head -n1)

# test AVEC clé -> 200 attendu
curl -sS -i -X POST "$BASE" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KEY" \
  --data '{}' | head -n 25
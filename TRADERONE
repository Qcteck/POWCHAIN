cat >/root/WOLVERINE_DEBUG_USDC_RPC.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
BACKUP="$HTML.debug_$(date +%Y%m%d_%H%M%S)"

cp "$HTML" "$BACKUP"
echo "[OK] Backup $BACKUP"

perl -0777 -i -pe '
s#</script>#async function debugUSDC(){\n\
  console.clear();\n\
  console.log(\"=== USDC RPC DEBUG ===\");\n\
  const programs=[solanaWeb3.TOKEN_PROGRAM_ID,solanaWeb3.TOKEN_2022_PROGRAM_ID];\n\
  for(const pid of programs){\n\
    try{\n\
      const r=await connection.getParsedTokenAccountsByOwner(pubkey,{programId:pid});\n\
      console.log(\"PROGRAM\",pid.toBase58(),\"COUNT\",r.value.length);\n\
      r.value.forEach((a,i)=>{\n\
        console.log(i,a.account.data.parsed.info);\n\
      });\n\
    }catch(e){console.error(pid.toBase58(),e);}\n\
  }\n\
}\n\
const _oldRefreshSOL=refreshSOL;\n\
refreshSOL=async()=>{await _oldRefreshSOL();await debugUSDC();};\n\
</script>#s' "$HTML"

nginx -t && systemctl reload nginx
echo "DONE — OUVRE LA CONSOLE (F12) ET CLIQUE REFRESH"

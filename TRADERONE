#!/bin/bash
set -e

echo "=== AIAQUILA RSS FINAL FIX ==="

FRONT="/var/www/fireinners.online/aiaquila/index.html"
BACKUP="/var/www/fireinners.online/aiaquila/index.backup.$(date +%Y%m%d_%H%M%S).html"

WORKER_BASE="https://paycashnostory.workers.dev"
RSS_ENDPOINT="$WORKER_BASE/rss"

echo "[1/4] Backup frontend"
cp "$FRONT" "$BACKUP"
echo "Backup -> $BACKUP"

echo "[2/4] Rewrite frontend (JSON ONLY, WORKER ONLY)"

cat > "$FRONT" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;padding:20px;font-family:system-ui;background:#0b1b3a;color:#fff}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (Worker)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>

<script>
const API="https://paycashnostory.workers.dev/rss";

async function load(){
  const out=document.getElementById("out");
  out.textContent="Chargement…\n";
  try{
    const r=await fetch(API,{cache:"no-store"});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();
    if(!Array.isArray(j)) throw new Error("JSON invalide");

    let t="";
    j.forEach((a,i)=>{
      t+=`${i+1}. ${a.title}\n${a.link}\n\n`;
    });
    out.textContent=t || "Aucun article";
  }catch(e){
    out.textContent="ERREUR: "+e.message;
  }
}
</script>
</body>
</html>
HTML

echo "[3/4] Test direct Worker /rss"
curl -fsSL "$RSS_ENDPOINT" | head -c 300 || echo "❌ Worker inaccessible"

echo "[4/4] Reload nginx"
nginx -t && systemctl reload nginx

echo "=== OK ==="
echo "URL : https://fireinners.online/aiaquila/"
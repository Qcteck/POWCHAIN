bash -lc 'set -euo pipefail
DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
SNIP="/etc/nginx/snippets/private_sentinel1.conf"
HTPASS="/etc/nginx/.htpasswd_private_sentinel1"
USER="sentinel"
PATHLOC="/_private_sentinel1/"
PROXY="http://127.0.0.1:3000"

echo "[1] prereqs"
command -v nginx >/dev/null
if ! command -v htpasswd >/dev/null; then
  apt-get update -y
  apt-get install -y apache2-utils
fi

echo "[2] htpasswd (skip if exists)"
if [ ! -f "$HTPASS" ]; then
  htpasswd -c "$HTPASS" "$USER"
else
  echo "htpasswd exists: $HTPASS"
fi
chmod 640 "$HTPASS"
chown root:www-data "$HTPASS" 2>/dev/null || true

echo "[3] write snippet: $SNIP"
mkdir -p /etc/nginx/snippets
cp -a "$SNIP" "/root/private_sentinel1.conf.bak.$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
cat >"$SNIP" <<EOF
location ^~ ${PATHLOC} {
  auth_basic "Sentinel";
  auth_basic_user_file ${HTPASS};
  proxy_pass ${PROXY}/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  add_header Cache-Control "no-store" always;
}
location = ${PATHLOC%/} { return 301 ${PATHLOC}; }
EOF
chmod 644 "$SNIP"

echo "[4] ensure vhost includes snippet: $VHOST"
test -f "$VHOST"
if ! grep -RInq "snippets/private_sentinel1\.conf" "$VHOST"; then
  cp -a "$VHOST" "/root/${DOMAIN}-ssl.bak.$(date +%Y%m%d-%H%M%S)"
  awk -v ins="    include ${SNIP};" '
    {print}
    $0 ~ /^[ \t]*listen[ \t]+443[ \t]+ssl/ {print ins}
  ' "$VHOST" >"/tmp/${DOMAIN}-ssl" && mv "/tmp/${DOMAIN}-ssl" "$VHOST"
else
  echo "include already present"
fi

echo "[5] nginx test + reload"
nginx -t
systemctl reload nginx

echo "[6] quick tests (expect 401 then 200 after password prompt)"
curl -I "https://${DOMAIN}${PATHLOC}" | head -n 5 || true
curl -I -u "${USER}" "https://${DOMAIN}${PATHLOC}" | head -n 5 || true

echo "DONE"
'
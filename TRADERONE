cat >/tmp/WOLVERINE_FIX_443_DIAG.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "== Public IP =="
curl -4 -s api.ipify.org; echo
echo

echo "== LISTEN 80/443 (IPv4/IPv6) =="
ss -lntp | egrep ':(80|443)\s' || true
echo

echo "== Who owns 443 (lsof) =="
lsof -iTCP:443 -sTCP:LISTEN -nP 2>/dev/null || echo "No LISTEN on 443"
echo

echo "== Services web =="
for s in nginx apache2 caddy; do
  echo "--- $s"
  systemctl status "$s" --no-pager -l 2>/dev/null | sed -n '1,15p' || true
done
echo

echo "== UFW =="
ufw status verbose 2>/dev/null || true
echo
SH

bash /tmp/WOLVERINE_FIX_443_DIAG.sh
cat >/tmp/SANITIZE_TRADERONE_UNIT_ROOT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 0) STOP watchdog to avoid loops =="
systemctl stop traderone-watchdog.timer traderone-watchdog.service 2>/dev/null || true

echo "== 1) SHOW what is REALLY on disk =="
echo "--- /etc/systemd/system/traderone.service (with line numbers) ---"
nl -ba /etc/systemd/system/traderone.service | sed -n '1,220p'
echo
echo "--- systemctl cat traderone.service ---"
systemctl cat traderone.service | sed -n '1,220p'

echo
echo "== 2) WRITE CLEAN unit (overwrite) =="
cat >/etc/systemd/system/traderone.service <<'EOF'
[Unit]
Description=TraderOne Backend (Wolverine)
After=network-online.target nginx.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/opt/traderone-opt
Environment=NODE_ENV=production
Restart=always
RestartSec=3

ExecStartPre=/bin/bash -lc 'mkdir -p /opt/traderone-opt; [ -f /opt/traderone-opt/state.json ] || echo "{}" > /opt/traderone-opt/state.json; [ -f /opt/traderone-opt/trades.log ] || : > /opt/traderone-opt/trades.log; chown -R root:root /opt/traderone-opt; chmod 644 /opt/traderone-opt/state.json /opt/traderone-opt/trades.log'
ExecStart=/usr/bin/node /opt/traderone-opt/server.js

KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

echo "== 3) RELOAD + RESTART =="
systemctl daemon-reload
systemctl restart traderone.service
sleep 2
systemctl status traderone.service --no-pager || true

echo "== 4) HEALTH (local) =="
curl -sS -o /dev/null -w "LOCAL http_code=%{http_code}\n" http://127.0.0.1:8585/api/health || true

echo "== 5) Re-enable watchdog timer (if you want) =="
systemctl start traderone-watchdog.timer 2>/dev/null || true
systemctl status traderone-watchdog.timer --no-pager || true
SH

bash /tmp/SANITIZE_TRADERONE_UNIT_ROOT.sh
cat >/root/MEGA_BUNDLER_RUN_DIAG.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run as root"

S="/root/MEGA_BUNDLER_REACT_UI_API_V1_FIX.sh"
[ -f "$S" ] || die "missing: $S"

LOG="/root/BUNDLER_LASTRUN.log"
: >"$LOG"
chmod 600 "$LOG" || true

say "run: $S (trace -> $LOG)"
set +e
bash -x "$S" >>"$LOG" 2>&1
RC=$?
set -e

say "exit_code: $RC"
say "tail (last 120 lines)"
tail -n 120 "$LOG" || true

say "status: systemd bundler-api"
systemctl status bundler-api --no-pager -l | sed -n '1,140p' || true
say "journal: bundler-api (last 120)"
journalctl -u bundler-api -n 120 --no-pager || true

say "nginx: test + bundler include presence"
nginx -t || true
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/bundler_routes.inc"
say "vhost: $VHOST"
grep -nF "bundler_routes.inc" "$VHOST" || true
say "include: $INC"
ls -la "$INC" || true
sed -n '1,220p' "$INC" 2>/dev/null || true

say "ports/listen"
ss -ltnp | awk 'NR==1||/(:9797|:80|:443)\b/' || true

say "curl tests"
curl -fsS "http://127.0.0.1:9797/health" | head -c 300; echo || true
curl -fsSI "https://fireinners.online/bundler/" | head -n 12 | tr -d '\r' || true
curl -fsSI "https://fireinners.online/bundler/api/health" | head -n 12 | tr -d '\r' || true
curl -fsSI "https://fireinners.online/bundler/data/api.ndjson" | head -n 12 | tr -d '\r' || true

say "DONE (log: $LOG)"
exit "$RC"
BASH

chmod +x /root/MEGA_BUNDLER_RUN_DIAG.sh
/root/MEGA_BUNDLER_RUN_DIAG.sh
set -euo pipefail

# quelle version tu veux tester ?
SRC="/var/www/wolverine/_index_versions/v0008.html"

TEST_DIR="/var/www/wolverine/test"
mkdir -p "$TEST_DIR"

[ -f "$SRC" ] || { echo "❌ Missing $SRC"; exit 1; }

cp -a "$SRC" "$TEST_DIR/index.html"
chown -R www-data:www-data /var/www/wolverine 2>/dev/null || true
chmod -R a+rX /var/www/wolverine || true

nginx -t && systemctl reload nginx

echo "✅ TEST:"
curl -sS -I https://fireinners.online/wolverine/test/ | head -n 20 || true
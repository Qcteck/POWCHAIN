set -euo pipefail

HTML="/var/www/fireinners/wolverine/index.html"
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"

cp -a "$HTML"  "$HTML.bak.$TS"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backups: $HTML.bak.$TS | $APPJS.bak.$TS"

# 1) Nettoie les anciens tags solana libs (si présents)
perl -i -pe 's#\s*<script[^>]+(unpkg|jsdelivr)\.com/@solana/web3\.js[^>]*></script>##gi;
             s#\s*<script[^>]+(unpkg|jsdelivr)\.com/@solana/spl-token[^>]*></script>##gi' "$HTML"

# 2) Injecte les libs AVANT app.js (ordre garanti)
perl -0777 -i -pe 's#(<script[^>]+src="[^"]*app\.js[^"]*"[^>]*></script>)#  <script src="https://cdn.jsdelivr.net/npm/@solana/web3.js@1.95.4/lib/index.iife.min.js"></script>\n  <script src="https://cdn.jsdelivr.net/npm/@solana/spl-token@0.4.8/lib/index.iife.min.js"></script>\n  $1#s' "$HTML"

# 3) Force app.js à utiliser window.solanaWeb3 + window.splToken (jamais splToken direct)
perl -i -pe 's/\bsolanaWeb3\./window.solanaWeb3./g; s/\bsplToken\./window.splToken./g' "$APPJS"

# 4) Ajoute un guard simple (si libs pas là, message clair au lieu de crash)
perl -0777 -i -pe 's|(\/\*\s*WOLVERINE_START_SEND_USDC_BEGIN\s*\*\/[\s\S]*?\(function\(\)\{\s*)|\1\n  if(!window.solanaWeb3 || !window.solanaWeb3.PublicKey){ console.log(\"ERR web3 missing\"); return; }\n  if(!window.splToken){ console.log(\"ERR splToken missing\"); return; }\n|s' "$APPJS" || true

echo "OK ✅ Fais Ctrl+F5 sur /wolverine puis teste:"
echo 'Dans Console: window.solanaWeb3?.PublicKey && window.splToken ? "libs OK" : "libs MISSING"'
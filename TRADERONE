python3 - <<'PY'
import os, re, shutil, subprocess, datetime

BK=os.environ["BK"]
DOMAIN=os.environ["DOMAIN"]
PATH_OK=os.environ["PATH_OK"]
WEBROOT=os.environ["WEBROOT"]
TAG="AQUILA_STACKING_V8"
HDR="X-AquilaStacking"

def run(cmd):
    return subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True)

ngT = run(["nginx","-T"])
open(os.path.join(BK,"nginx.T.txt"),"w").write(ngT)

# list loaded file paths in nginx -T order
files=[]
for line in ngT.splitlines():
    m=re.match(r"^# configuration file (\S+):\d+", line)
    if m:
        f=m.group(1)
        if f not in files:
            files.append(f)

# filter likely vhost files (loaded) that mention fireinners.online or cert path
cand=[]
for f in files:
    if not os.path.isfile(f): 
        continue
    try:
        txt=open(f,"r",errors="ignore").read()
    except Exception:
        continue
    if re.search(r"\bfireinners\.online\b", txt) or "letsencrypt/live/fireinners.online" in txt or "fireinners.online-ssl" in txt:
        cand.append(f)

open(os.path.join(BK,"candidates.txt"),"w").write("\n".join(cand)+"\n")

loc_block=f"""
  # {TAG} BEGIN
  location = /aquilastacking {{ return 301 {PATH_OK}; }}
  location ^~ /aquilastacking/ {{ return 301 {PATH_OK}; }}
  location = {PATH_OK.rstrip('/')} {{ return 301 {PATH_OK}; }}
  location ^~ {PATH_OK} {{
    alias {WEBROOT}/;
    index index.html;
    try_files $uri $uri/ {PATH_OK}index.html;
    add_header {HDR} "1" always;
    add_header Cache-Control "no-store" always;
  }}
  # {TAG} END
""".lstrip("\n")

def remove_tag_blocks(s:str)->str:
    # remove any previous tagged blocks (any version) to avoid duplication
    return re.sub(r"\n?[ \t]*#\s*AQUILA_STACKING_[A-Z0-9_]*\s+BEGIN.*?#\s*AQUILA_STACKING_[A-Z0-9_]*\s+END\s*\n", "\n", s, flags=re.S)

def patch_server_blocks(text:str)->tuple[str,int]:
    out=[]
    i=0
    n=len(text)
    patched=0

    pat=re.compile(r"\bserver\s*\{", re.M)
    for m in pat.finditer(text):
        s=m.start()
        out.append(text[i:s])
        brace=text.find("{", s)
        if brace==-1:
            out.append(text[s:]); i=n; break

        depth=0
        k=brace
        while k<n:
            if text[k]=="{": depth+=1
            elif text[k]=="}":
                depth-=1
                if depth==0:
                    end=k+1
                    break
            k+=1
        else:
            out.append(text[s:]); i=n; break

        block=text[s:end]

        # must be 443 + server_name fireinners.online (effective block)
        has_443 = re.search(r"listen\s+[^;]*\b443\b", block) is not None
        has_name = re.search(r"server_name\s+[^;]*\b"+re.escape(DOMAIN)+r"\b", block) is not None

        if has_443 and has_name:
            b=remove_tag_blocks(block)
            if TAG not in b:
                lines=b.splitlines(True)
                ins=None
                for idx,ln in enumerate(lines):
                    if re.match(r"^\s*location\s+", ln):
                        ins=idx; break
                if ins is None:
                    # insert before last closing brace
                    ins=len(lines)-1
                # ensure there is a newline before insertion
                if ins>0 and not lines[ins-1].endswith("\n"):
                    lines[ins-1]=lines[ins-1]+"\n"
                lines.insert(ins, loc_block if loc_block.endswith("\n") else loc_block+"\n")
                block="".join(lines)
                patched+=1

        out.append(block)
        i=end

    out.append(text[i:])
    return "".join(out), patched

touched=[]
for f in cand:
    try:
        src=open(f,"r",errors="ignore").read()
    except Exception:
        continue
    new, cnt = patch_server_blocks(src)
    if cnt>0:
        # backup
        bak=os.path.join(BK, f.replace("/","_")+".bak")
        shutil.copy2(f, bak)
        # unlock immutable if needed
        subprocess.run(["bash","-lc", f"chattr -i '{f}' 2>/dev/null || true"], check=False)
        shutil.copy2(f, f+f".bak.{datetime.datetime.utcnow().strftime('%Y%m%d_%H%M%S')}")
        open(f,"w").write(new)
        touched.append((f,cnt))

open(os.path.join(BK,"patched.txt"),"w").write("\n".join([f"{a} :: {b}" for a,b in touched])+"\n")

if not touched:
    raise SystemExit("No 443 fireinners.online server block was patched. See BK/nginx.T.txt and BK/candidates.txt")

print("[OK] patched files:")
for a,b in touched:
    print(" -",a,"(server blocks patched:",b,")")
PY

say "3) nginx -t + reload (rollback if fail)"
if ! nginx -t; then
  say "nginx invalid -> rollback"
  for b in "$BK"/*.bak; do
    [ -f "$b" ] || continue
    orig="$(echo "$b" | sed "s#^$BK/##" | sed 's#_#/#g' | sed 's/\.bak$//')"
    [ -f "$orig" ] && cp -a "$b" "$orig" || true
  done
  nginx -t || true
  die "rolled back (see $BK)"
fi
systemctl reload nginx

say "4) prove LOADED config contains aquila_stacking block"
nginx -T 2>/dev/null | grep -n "AQUILA_STACKING_V8" | head -n 50 || true

say "5) local verify (must be 200 + header X-AquilaStacking: 1)"
curl -skI --resolve ${DOMAIN}:443:127.0.0.1 "https://${DOMAIN}${PATH_OK}" | head -n 60
curl -sk  --resolve ${DOMAIN}:443:127.0.0.1 "https://${DOMAIN}${PATH_OK}" | head -n 12

say "DONE"
say "URL: https://${DOMAIN}${PATH_OK}"
say "BK: $BK"
BASH

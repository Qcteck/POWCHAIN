cat >/tmp/FIND_WOLVERINE_DUPLICATE_REAL.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
VHOST="$(readlink -f "$EN" 2>/dev/null || echo "$EN")"
SNIP="/etc/nginx/snippets/fireinners-wolverine.conf"

echo "VHOST=$VHOST"
echo

echo "=== 1) /wolverine locations DANS LE VHOST (si tu en vois une -> c'est le doublon) ==="
grep -nE '^\s*location\s+.*\/wolverine\/' "$VHOST" || true
grep -nE '^\s*location\s+.*\/wolverine(\s|\/|$)' "$VHOST" || true
echo

echo "=== 2) Le snippet a bien UNE seule location /wolverine/ ? ==="
grep -nE '^\s*location\s+.*\/wolverine\/' "$SNIP" || true
echo

echo "=== 3) Cherche TOUTE définition de location /wolverine/ dans /etc/nginx ==="
# (c'est ça qui va révéler le 2e bloc qui fait doublon)
grep -RIn --color=never -E '^\s*location\s+.*\/wolverine\/' \
  /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/snippets \
  || true
echo

echo "=== 4) Cherche TOUTE référence au snippet (même indirecte) ==="
grep -RIn --color=never 'fireinners-wolverine\.conf' \
  /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/snippets \
  || true
echo

echo "=== 5) nginx -t (doit encore échouer, mais on aura le coupable au-dessus) ==="
nginx -t || true
SH

bash /tmp/FIND_WOLVERINE_DUPLICATE_REAL.sh
"use strict";
const fs=require("fs"),path=require("path");
const cfgPath=process.env.CFG||"/opt/einshtein-solana/config.json";
const watchPath=process.env.WATCH||"/opt/einshtein-solana/watchlist.json";
const armFlag=process.env.ARM||"/opt/einshtein-solana/ARM_ON";
function nowISO(){return new Date().toISOString();}
function jread(p,fb){try{return JSON.parse(fs.readFileSync(p,"utf8"));}catch(e){return fb;}}
function jwrite(p,o){fs.writeFileSync(p,JSON.stringify(o,null,2));}
const statePath="/opt/einshtein-solana/state.json";
let CFG=jread(cfgPath,null); if(!CFG) throw new Error("Missing config.json");
let STATE=jread(statePath,{m:{}});
function appendND(obj){
  const line=JSON.stringify(Object.assign({ts:nowISO()},obj))+"\n";
  try{fs.appendFileSync(CFG.ndjson_path,line,{encoding:"utf8"});}catch(e){}
}
async function fetchJson(url,timeoutMs=8000){
  const ac=new AbortController(); const t=setTimeout(()=>ac.abort(),timeoutMs);
  try{
    const r=await fetch(url,{signal:ac.signal,headers:{"user-agent":"einshtein-solana/1.0"}});
    const txt=await r.text();
    let js=null; try{js=JSON.parse(txt);}catch(e){}
    return {ok:r.ok,status:r.status,js,txt};
  } finally { clearTimeout(t); }
}
function clamp(n,a,b){return Math.max(a,Math.min(b,n));}
function pct(a,b){ if(!isFinite(a)||!isFinite(b)||b===0) return null; return (a-b)/b; }
function safeNum(x){ const n=Number(x); return isFinite(n)?n:null; }

function estimateSpread(pair){
  // Dexscreener n'expose pas toujours bid/ask; on approx via priceChange ou via liquidity/vol proxy.
  // On garde simple: spread estimé = min(max_spread, 0.5% + 2%*(1 - liqFactor))
  const liq=safeNum(pair?.liquidity?.usd)||0;
  const liqFactor=clamp(liq/50000,0,1);
  const est=0.005 + 0.02*(1-liqFactor);
  return est;
}

async function macro(){
  const r=await fetchJson(CFG.coingecko.simple,8000);
  if(!r.ok||!r.js) return {ok:false};
  const btc=safeNum(r.js?.bitcoin?.usd);
  const sol=safeNum(r.js?.solana?.usd);
  if(!btc||!sol) return {ok:false};
  // trend ultra-simple: compare vs last snapshot (STATE.macro)
  const prev=STATE.macro||{};
  const btcCh=prev.btc? (btc-prev.btc)/prev.btc : 0;
  const solCh=prev.sol? (sol-prev.sol)/prev.sol : 0;
  const score=Math.round(50 + (btcCh*500) + (solCh*300)); // sensitivités
  const risk=score>=55?"on":(score<=45?"off":"neutral");
  STATE.macro={btc,sol,score:risk==="on"?Math.min(100,score):Math.max(0,score),risk,at:Date.now()};
  return {ok:true,btc,sol,score:STATE.macro.score,risk};
}

function pivotUpdate(mint,px){
  const m=STATE.m[mint]||{px:[],pos:null,lastSignal:null};
  m.px.push(px);
  if(m.px.length>CFG.pivot_lookback) m.px.shift();
  const pivot=Math.max(...m.px);
  m.pivot=pivot;
  STATE.m[mint]=m;
  return m;
}

function canExecute(){
  // ARM file gates execution + config execute_enabled true
  const armed=fs.existsSync(armFlag);
  return Boolean(armed && CFG.execute_enabled);
}

async function callTraderOne(endpoint,body){
  // Try local then public
  const tries=[CFG.traderone_api_local,CFG.traderone_api_public].filter(Boolean);
  let last=null;
  for(const base of tries){
    try{
      const url=base.replace(/\/$/,"")+endpoint;
      const r=await fetch(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body||{})});
      const txt=await r.text();
      last={ok:r.ok,status:r.status,txt,base,url};
      if(r.ok) return last;
    }catch(e){
      last={ok:false,status:0,txt:String(e),base};
    }
  }
  return last||{ok:false,status:0,txt:"no-tries"};
}

function decide(mint,info,macroState){
  const m=STATE.m[mint];
  const px=info.px, liq=info.liq, vol=info.vol, spread=info.spread;
  const dd=pct(px,m.pivot); // (px - pivot)/pivot (negative if drawdown)
  const inZoneA=(dd!==null && dd>=CFG.zoneA_dd_min && dd<=CFG.zoneA_dd_max);
  const liqOK=(liq===null?false:liq>=CFG.min_liq_usd);
  const spreadOK=(spread===null?false:spread<=CFG.max_spread);
  const macroRisk=macroState?.risk||"unknown";
  const macroOK=(macroRisk!=="off"); // simple rule
  const reasons=[];
  if(inZoneA) reasons.push("zoneA");
  if(liqOK) reasons.push("liqOK"); else reasons.push("liqLOW");
  if(spreadOK) reasons.push("spreadOK"); else reasons.push("spreadHIGH");
  if(macroOK) reasons.push("macroOK"); else reasons.push("macroOFF");

  // SELL logic if we have an open pos
  let pos=m.pos;
  if(pos){
    const up=pct(px,pos.entry);
    const hit1=up!==null && up>=CFG.tp1;
    const hit2=up!==null && up>=CFG.tp2;
    const hit3=up!==null && up>=CFG.tp3;
    if(hit3) return {signal:"sell",level:"tp3",up,dd,px,reasons:["tp3",macroRisk]};
    if(hit2) return {signal:"sell",level:"tp2",up,dd,px,reasons:["tp2",macroRisk]};
    if(hit1) return {signal:"sell",level:"tp1",up,dd,px,reasons:["tp1",macroRisk]};
  }

  // BUY signal
  if(inZoneA && liqOK && spreadOK){
    // if macro off -> reduce/skip, here we still allow signal but with caution
    return {signal:"buy",dd,px,reasons};
  }
  return {signal:null,dd,px,reasons};
}

async function tickMint(mint,macroState){
  const r=await fetchJson(CFG.dexscreener.token+mint,9000);
  if(!r.ok||!r.js) { appendND({type:"err",where:"dexscreener",mint,status:r.status}); return; }
  const pairs=r.js.pairs||[];
  // pick best pair: highest liquidity.usd
  let best=null, bestL=0;
  for(const p of pairs){
    const liq=safeNum(p?.liquidity?.usd)||0;
    if(liq>bestL){bestL=liq;best=p;}
  }
  if(!best){ appendND({type:"err",where:"pairs",mint,reason:"no_pairs"}); return; }

  const px=safeNum(best?.priceUsd);
  const liq=safeNum(best?.liquidity?.usd);
  const vol=safeNum(best?.volume?.h24);
  const spread=estimateSpread(best);
  if(!px){ appendND({type:"err",where:"price",mint,reason:"no_price"}); return; }

  const m=pivotUpdate(mint,px);
  const dd=pct(px,m.pivot);
  appendND({type:"price",chain:"solana",mint,px,liq_usd:liq,vol24:vol,pivot:m.pivot,dd,spread_est:spread,macro:(macroState?.risk||null)});

  const d=decide(mint,{px,liq,vol,spread},macroState);
  if(d.signal){
    // de-dup: avoid repeating same signal too often
    const k=d.signal+":"+(d.level||"");
    const last=m.lastSignal||{k:null,t:0};
    const now=Date.now();
    if(last.k===k && (now-last.t)<(CFG.poll_ms*3)) return;

    m.lastSignal={k,t:now};
    STATE.m[mint]=m;

    appendND({type:"signal",side:d.signal,level:d.level||null,chain:"solana",mint,px:d.px,dd:d.dd,reason:d.reasons,execute_allowed:canExecute()});

    // execution (gated)
    if(canExecute()){
      if(d.signal==="buy"){
        // record pos locally first (optimistic; real fill handled by TraderOne)
        m.pos={entry:d.px,at:now};
        STATE.m[mint]=m;
        // call start endpoint (TraderOne decides actual routing)
        const res=await callTraderOne("/start",{chain:"solana",mint,mode:"einshtein",budget_usd:50});
        appendND({type:"exec",action:"start",mint,ok:res.ok,status:res.status,base:res.base||null});
      } else if(d.signal==="sell"){
        // call stop/withdraw depending strategy; here stop then withdraw is safer (but we only stop by default)
        const res=await callTraderOne("/stop",{chain:"solana",mint,mode:"einshtein"});
        appendND({type:"exec",action:"stop",mint,ok:res.ok,status:res.status,base:res.base||null});
        // clear pos locally
        m.pos=null; STATE.m[mint]=m;
      }
    }
  }
}

async function loop(){
  try{
    CFG=jread(cfgPath,CFG);
    // sync execute_enabled with ARM existence (hard gate)
    const armed=fs.existsSync(armFlag);
    if(armed && !CFG.execute_enabled){ CFG.execute_enabled=true; jwrite(cfgPath,CFG); }
    if(!armed && CFG.execute_enabled){ CFG.execute_enabled=false; jwrite(cfgPath,CFG); }

    const wl=jread(watchPath,{mints:[]}).mints||[];
    const mac=await macro();
    if(mac.ok) appendND({type:"macro",btc:mac.btc,sol:mac.sol,risk:mac.risk,score:mac.score});
    for(const mint of wl){
      if(typeof mint==="string" && mint.length>20) await tickMint(mint,mac.ok?mac:null);
    }
    fs.writeFileSync(statePath,JSON.stringify(STATE,null,2));
  } catch(e){
    appendND({type:"err",where:"loop",msg:String(e)});
  }
}
appendND({type:"status",status:"einshtein-solana-start"});
setInterval(loop,CFG.poll_ms||20000);
loop();
JS


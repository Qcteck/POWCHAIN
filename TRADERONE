set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

# 1) Crée le dossier test + met la version à tester (ici v0008)
SRC="/var/www/wolverine/_index_versions/v0008.html"
TEST_DIR="/var/www/wolverine_test"
mkdir -p "$TEST_DIR"

[ -f "$SRC" ] || { echo "❌ Missing $SRC"; exit 1; }

cp -a "$SRC" "$TEST_DIR/index.html"
chown -R www-data:www-data "$TEST_DIR" 2>/dev/null || true
chmod -R a+rX "$TEST_DIR" || true

# 2) Snippet nginx pour OVERRIDE /wolverine/test/
SNIP="/etc/nginx/snippets/wolverine_test.conf"
mkdir -p /etc/nginx/snippets

cat > "$SNIP" <<'NGX'
# Wolverine TEST (override /wolverine/)
location = /wolverine/test { return 301 /wolverine/test/; }
location ^~ /wolverine/test/ {
  alias /var/www/wolverine_test/;
  try_files $uri $uri/ /wolverine/test/index.html;
}
NGX

# 3) Injecte le snippet dans les fichiers nginx qui servent déjà /wolverine (pas ceux qui parlent de fireinnerblockchain)
FILES="$(nginx -T 2>/dev/null | awk '
  /^# configuration file /{f=$4}
  /fireinnerblockchain/ {next}
  /\/wolverine/ {print f}
' | sort -u)"

echo "Inject in:"
echo "$FILES"

for f in $FILES; do
  [ -f "$f" ] || continue
  grep -q "snippets/wolverine_test.conf" "$f" && continue
  cp -a "$f" "$f.bak.wolvtest.$TS"
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/wolverine_test.conf;/' "$f"
done

nginx -t
systemctl reload nginx

echo "✅ TEST LINK:"
echo "https://fireinners.online/wolverine/test/"
curl -sS -I https://fireinners.online/wolverine/test/ | head -n 12 || true
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
[ -f "$VHOST" ] || { echo "❌ Vhost introuvable: $VHOST"; exit 1; }

cp -a "$VHOST" "$VHOST.bak.$TS"

python3 - <<'PY'
import re
path = "/etc/nginx/sites-enabled/fireinners.online-ssl"
target = "/wolverine/traderone/api"

s = open(path, "r", encoding="utf-8", errors="ignore").read()
lines = s.splitlines(True)

# match ONLY the exact location /wolverine/traderone/api (with optional trailing slash)
loc_re = re.compile(r'^\s*location\s+(?:\^~\s+|=+\s+|~\*?\s+)?' + re.escape(target) + r'/?\s*\{', re.M)

m = loc_re.search(s)
if not m:
    raise SystemExit("❌ Aucun bloc location EXACT /wolverine/traderone/api trouvé dans le vhost.")

# compute start line index
start_char = m.start()
start_line = s[:start_char].count("\n")

# remove block by brace counting
out = []
depth = 0
i = 0
removed = False
while i < len(lines):
    if i == start_line:
        removed = True
        # start from this line, count braces until balanced
        j = i
        while j < len(lines):
            depth += lines[j].count("{") - lines[j].count("}")
            j += 1
            if depth <= 0:
                break
        # skip i..j
        i = j
        continue
    out.append(lines[i])
    i += 1

open(path, "w", encoding="utf-8").write("".join(out))
print("✅ Bloc location /wolverine/traderone/api supprimé du vhost")
PY

nginx -t
systemctl reload nginx
echo "✅ OK (backup: $VHOST.bak.$TS)"
cat >/root/fix_react_404_and_phantom.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/var/www/wolverine"
INDEX="$ROOT/index.html"
JS="$ROOT/phantom_patch.js"
[[ -f "$INDEX" ]] || { echo "[ERR] $INDEX introuvable"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$INDEX" "${INDEX}.bak_${ts}"
echo "[OK] Backup -> ${INDEX}.bak_${ts}"

# 1) JS patch (runs early, before app)
cat >"$JS" <<'JS'
(function(){
  // --- A) Prevent UI crash if backend endpoints are missing (404) ---
  const MOCKS = {
    "/wolverine/traderone/api/me":        () => ({ ok:true, me:{ id:"guest", wallet:null } }),
    "/wolverine/traderone/api/positions": () => ({ ok:true, positions:[] }),
    "/wolverine/traderone/api/orders":    () => ({ ok:true, orders:[] }),
    "/wolverine/traderone/api/pnl":       () => ({ ok:true, pnl:{ total:0, daily:0 } }),
  };

  const origFetch = window.fetch.bind(window);
  window.fetch = async (input, init) => {
    const url = typeof input === "string" ? input : (input?.url || "");
    try{
      const res = await origFetch(input, init);
      if(res && res.status === 404){
        const key = Object.keys(MOCKS).find(k => url.includes(k));
        if(key){
          return new Response(JSON.stringify(MOCKS[key]()), {
            status: 200,
            headers: { "Content-Type":"application/json" }
          });
        }
      }
      return res;
    }catch(e){
      const key = Object.keys(MOCKS).find(k => url.includes(k));
      if(key){
        return new Response(JSON.stringify(MOCKS[key]()), {
          status: 200,
          headers: { "Content-Type":"application/json" }
        });
      }
      throw e;
    }
  };

  // --- B) Phantom connect + SOL/USDC balance overlay (no React DOM touch) ---
  const RPC = "https://api.mainnet-beta.solana.com";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";

  function ensureOverlay(){
    let box = document.getElementById("__phantom_overlay");
    if(box) return box;
    box = document.createElement("div");
    box.id="__phantom_overlay";
    box.style.cssText="position:fixed;right:16px;bottom:16px;z-index:99999;background:rgba(0,0,0,.85);color:#fff;padding:10px 12px;border-radius:10px;font:12px/1.35 system-ui;max-width:70vw;white-space:pre-line";
    document.body.appendChild(box);
    return box;
  }
  function setMsg(msg){ ensureOverlay().textContent = msg; }
  function short(pk){ return pk.slice(0,4)+"…"+pk.slice(-4); }

  async function rpc(method, params){
    const r = await fetch(RPC, {
      method:"POST",
      headers:{ "Content-Type":"application/json" },
      body: JSON.stringify({ jsonrpc:"2.0", id:1, method, params })
    });
    const j = await r.json();
    if(j.error) throw new Error(j.error.message || JSON.stringify(j.error));
    return j.result;
  }

  async function fetchBalances(owner){
    const bal = await rpc("getBalance", [owner, { commitment:"confirmed" }]);
    const sol = bal.value / 1e9;

    const tok = await rpc("getTokenAccountsByOwner", [
      owner,
      { mint: USDC_MINT },
      { encoding:"jsonParsed", commitment:"confirmed" }
    ]);

    let usdc = 0;
    for(const acc of (tok.value || [])){
      const amt = acc.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
      if(typeof amt === "number") usdc += amt;
    }
    return { sol, usdc };
  }

  async function updateOverlay(pk){
    setMsg(`Connected: ${short(pk)}\nBalance: …`);
    try{
      const b = await fetchBalances(pk);
      setMsg(`Connected: ${short(pk)}\nBalance: ${b.sol.toFixed(4)} SOL | ${b.usdc.toFixed(2)} USDC`);
    }catch(e){
      console.error("balance error", e);
      setMsg(`Connected: ${short(pk)}\nBalance: (error RPC)`);
    }
  }

  async function connectPhantom(){
    if(!window.solana || !window.solana.isPhantom){
      setMsg("Phantom introuvable (extension)");
      return;
    }
    const r = await window.solana.connect();
    const pk = r.publicKey.toBase58();
    window.__WALLET_PK__ = pk;
    await updateOverlay(pk);
  }

  function findConnectEl(){
    const direct = document.querySelector(".walletBox .btn.ghost");
    if(direct) return direct;
    const nodes = Array.from(document.querySelectorAll("button,a,div,span"));
    return nodes.find(n => /connect phantom/i.test((n.textContent||"").trim()));
  }

  function hook(){
    const el = findConnectEl();
    if(el && !el.__phantom_hooked){
      el.__phantom_hooked = true;
      el.addEventListener("click", (ev)=>{
        ev.preventDefault();
        connectPhantom().catch(err => setMsg("Connect error: " + String(err?.message||err)));
      }, { passive:false });
      setMsg("Patch loaded — clique Connect Phantom");
    }
  }

  window.addEventListener("load", ()=>{
    setMsg("Patch loaded — searching button…");
    hook();
    const obs = new MutationObserver(()=>hook());
    obs.observe(document.documentElement, { childList:true, subtree:true });

    if(window.solana?.isPhantom && window.solana.publicKey){
      updateOverlay(window.solana.publicKey.toBase58());
    }
    window.solana?.on?.("accountChanged", (pubkey)=>{
      if(pubkey) updateOverlay(pubkey.toBase58());
      else setMsg("Not connected");
    });
  });

  window.__PHANTOM_PATCH_LOADED__ = true;
})();
JS

# 2) Ensure script tag is in <head> BEFORE next/react scripts (idempotent)
# Remove any old phantom script tags first
perl -0777 -i -pe '
s/<!-- PHANTOM_EXTERNAL_PATCH -->.*?<!-- \/PHANTOM_EXTERNAL_PATCH -->\s*//msi;
s@<script[^>]+phantom_patch\.js[^>]*></script>\s*@@gsi;
' "$INDEX"

# Insert right after <head ...>
perl -0777 -i -pe '
my $tag = qq{\n<!-- PHANTOM_EXTERNAL_PATCH -->\n<script src="/wolverine/phantom_patch.js?v='${ts}'" defer></script>\n<!-- /PHANTOM_EXTERNAL_PATCH -->\n};
s@(<head[^>]*>)@$1$tag@i;
' "$INDEX"

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
echo "✅ Test: https://fireinners.online/wolverine/?v=$ts"
BASH

chmod +x /root/fix_react_404_and_phantom.sh
/root/fix_react_404_and_phantom.sh
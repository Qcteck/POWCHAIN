cat >/root/batch_root_wolverine_full.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-}"
APPLY="${APPLY:-0}"                         # 0=dry-run, 1=apply
APP_DIR="${APP_DIR:-}"                      # optional
OUT_DIR="${OUT_DIR:-/var/www/wolverine}"
BASE_PATH="${BASE_PATH:-/wolverine}"

NETWORK="${NETWORK:-mainnet}"               # mainnet|devnet (UI info only)
RPC="${RPC:-}"                              # optional
WOLVERINE_WALLET="${WOLVERINE_WALLET:-DgpM2PXA9it1g8myWnVXeosu72GkwmjgpeGUigpyLkYC}"
USDC_MINT="${USDC_MINT:-}"                  # mainnet default auto, devnet must set

if [[ -z "$DOMAIN" ]]; then
  echo "Usage: APPLY=0|1 [APP_DIR=/path] [OUT_DIR=/var/www/wolverine] [NETWORK=mainnet|devnet] [USDC_MINT=...] $0 <domain>"
  exit 2
fi

ts(){ date +%Y%m%d_%H%M%S; }
say(){ echo "[$(ts)] $*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { echo "[ERR] missing: $1"; exit 1; }; }
need node; need npm; need find; need grep; need rsync; need nginx; need systemctl

# Defaults
if [[ -z "$RPC" ]]; then
  if [[ "$NETWORK" == "devnet" ]]; then
    RPC="https://api.devnet.solana.com"
  else
    RPC="https://api.mainnet-beta.solana.com"
  fi
fi

if [[ -z "$USDC_MINT" ]]; then
  if [[ "$NETWORK" == "mainnet" ]]; then
    USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
  else
    echo "[ERR] Devnet: tu dois fournir USDC_MINT (mint USDC devnet)."
    exit 1
  fi
fi

say "== Wolverine FULL =="
say "DOMAIN=$DOMAIN APPLY=$APPLY"
say "APP_DIR=${APP_DIR:-AUTO}"
say "OUT_DIR=$OUT_DIR BASE_PATH=$BASE_PATH"
say "NETWORK=$NETWORK RPC=$RPC"
say "WOLVERINE_WALLET=$WOLVERINE_WALLET"
say "USDC_MINT=$USDC_MINT"
echo

run(){
  if [[ "$APPLY" == "1" ]]; then
    bash -lc "$*"
  else
    say "[DRY] $*"
  fi
}

# 1) Find APP_DIR
if [[ -z "$APP_DIR" ]]; then
  if [[ -d /opt/_wolverine_next_src ]]; then
    APP_DIR="/opt/_wolverine_next_src"
  else
    mapfile -t PJS < <(
      find /opt /var/www /srv -maxdepth 7 -name package.json \
        -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null
    )
    for pj in "${PJS[@]}"; do
      if grep -q '"next"' "$pj"; then
        d="$(dirname "$pj")"
        if [[ -d "$d/app" || -d "$d/pages" ]]; then APP_DIR="$d"; break; fi
        [[ -z "$APP_DIR" ]] && APP_DIR="$d"
      fi
    done
  fi
fi
[[ -n "${APP_DIR:-}" ]] || { echo "[ERR] Next repo introuvable"; exit 1; }
say "APP_DIR=$APP_DIR"
run "cd '$APP_DIR'"

# 2) Patch next.config.* for static export under /wolverine
# Supports next.config.js or next.config.mjs (creates one if none)
CFG_JS="$APP_DIR/next.config.js"
CFG_MJS="$APP_DIR/next.config.mjs"

CFG_BAK_DIR="/root/backup_wolverine_full_$(ts)"
mkdir -p "$CFG_BAK_DIR"

write_cfg_js(){
  cat >"$CFG_JS" <<EOF
/** @type {import('next').NextConfig} */
const nextConfig = {
  output: "export",
  basePath: "${BASE_PATH}",
  assetPrefix: "${BASE_PATH}",
  trailingSlash: true,
};
module.exports = nextConfig;
EOF
}
write_cfg_mjs(){
  cat >"$CFG_MJS" <<EOF
/** @type {import('next').NextConfig} */
const nextConfig = {
  output: "export",
  basePath: "${BASE_PATH}",
  assetPrefix: "${BASE_PATH}",
  trailingSlash: true,
};
export default nextConfig;
EOF
}

if [[ "$APPLY" == "1" ]]; then
  if [[ -f "$CFG_MJS" ]]; then cp -a "$CFG_MJS" "$CFG_BAK_DIR/next.config.mjs.bak"; write_cfg_mjs
  elif [[ -f "$CFG_JS" ]]; then cp -a "$CFG_JS" "$CFG_BAK_DIR/next.config.js.bak"; write_cfg_js
  else
    # default to JS
    write_cfg_js
  fi
  say "OK: next.config patched for export + basePath"
else
  say "[DRY] would patch next.config.(js|mjs) to output:export + basePath/assetPrefix ${BASE_PATH}"
fi

# 3) Phantom UI code
run "cd '$APP_DIR' && mkdir -p lib components app pages"

if [[ "$APPLY" == "1" ]]; then
  # lib/solana.ts
  [[ -f "$APP_DIR/lib/solana.ts" ]] && cp -a "$APP_DIR/lib/solana.ts" "$CFG_BAK_DIR/solana.ts.bak" || true
  cat >"$APP_DIR/lib/solana.ts" <<EOF
import { Connection, PublicKey } from "@solana/web3.js";

export const NETWORK = process.env.NEXT_PUBLIC_SOLANA_NETWORK ?? "${NETWORK}";
export const RPC = process.env.NEXT_PUBLIC_SOLANA_RPC ?? "${RPC}";
export const connection = new Connection(RPC, "confirmed");

export const WOLVERINE_WALLET = new PublicKey("${WOLVERINE_WALLET}");
export const USDC_MINT = new PublicKey("${USDC_MINT}");
EOF

  # components/PhantomWolverine.tsx
  [[ -f "$APP_DIR/components/PhantomWolverine.tsx" ]] && cp -a "$APP_DIR/components/PhantomWolverine.tsx" "$CFG_BAK_DIR/PhantomWolverine.tsx.bak" || true
  cat >"$APP_DIR/components/PhantomWolverine.tsx" <<'EOF'
"use client";

import React, { useEffect, useMemo, useState } from "react";
import { PublicKey, SystemProgram, Transaction, LAMPORTS_PER_SOL } from "@solana/web3.js";
import {
  getAssociatedTokenAddress,
  createAssociatedTokenAccountInstruction,
  createTransferInstruction,
} from "@solana/spl-token";
import { connection, WOLVERINE_WALLET, USDC_MINT, NETWORK } from "../lib/solana";

type PhantomProvider = {
  isPhantom?: boolean;
  publicKey?: PublicKey;
  connect: (opts?: { onlyIfTrusted?: boolean }) => Promise<{ publicKey: PublicKey }>;
  disconnect: () => Promise<void>;
  signAndSendTransaction: (tx: Transaction) => Promise<{ signature: string }>;
};

function getPhantom(): PhantomProvider | null {
  const w = window as any;
  return w?.solana?.isPhantom ? (w.solana as PhantomProvider) : null;
}

export default function PhantomWolverine() {
  const phantom = useMemo(() => (typeof window !== "undefined" ? getPhantom() : null), []);
  const [pubkey, setPubkey] = useState<string>("");
  const [sol, setSol] = useState<number>(0);
  const [usdc, setUsdc] = useState<number>(0);
  const [loading, setLoading] = useState(false);

  const [sendSolAmount, setSendSolAmount] = useState("0.01");
  const [sendUsdcAmount, setSendUsdcAmount] = useState("1");

  async function refreshBalances(owner: PublicKey) {
    const lamports = await connection.getBalance(owner, "confirmed");
    setSol(lamports / LAMPORTS_PER_SOL);

    const ownerUsdcAta = await getAssociatedTokenAddress(USDC_MINT, owner, false);
    const bal = await connection.getTokenAccountBalance(ownerUsdcAta).catch(() => null);
    setUsdc(bal ? Number(bal.value.uiAmount ?? 0) : 0);
  }

  async function connectWallet() {
    if (!phantom) return alert("Phantom non détecté.");
    const res = await phantom.connect();
    setPubkey(res.publicKey.toBase58());
    await refreshBalances(res.publicKey);
  }

  async function disconnect() {
    if (!phantom) return;
    await phantom.disconnect();
    setPubkey(""); setSol(0); setUsdc(0);
  }

  async function sendSOL() {
    if (!phantom?.publicKey) return;
    setLoading(true);
    try {
      const from = phantom.publicKey;
      const lamports = Math.round(Number(sendSolAmount) * LAMPORTS_PER_SOL);

      const tx = new Transaction().add(
        SystemProgram.transfer({ fromPubkey: from, toPubkey: WOLVERINE_WALLET, lamports })
      );
      tx.feePayer = from;
      tx.recentBlockhash = (await connection.getLatestBlockhash("confirmed")).blockhash;

      const { signature } = await phantom.signAndSendTransaction(tx);
      await connection.confirmTransaction(signature, "confirmed");
      await refreshBalances(from);
      alert(`SOL envoyé ✅ tx: ${signature}`);
    } finally { setLoading(false); }
  }

  async function sendUSDC() {
    if (!phantom?.publicKey) return;
    setLoading(true);
    try {
      const owner = phantom.publicKey;
      const fromAta = await getAssociatedTokenAddress(USDC_MINT, owner, false);
      const toAta = await getAssociatedTokenAddress(USDC_MINT, WOLVERINE_WALLET, false);

      // assume USDC 6 decimals
      const baseUnits = BigInt(Math.round(Number(sendUsdcAmount) * 1_000_000));

      const ixs = [];
      const toInfo = await connection.getAccountInfo(toAta).catch(() => null);
      if (!toInfo) {
        ixs.push(createAssociatedTokenAccountInstruction(owner, toAta, WOLVERINE_WALLET, USDC_MINT));
      }
      ixs.push(createTransferInstruction(fromAta, toAta, owner, baseUnits));

      const tx = new Transaction().add(...ixs);
      tx.feePayer = owner;
      tx.recentBlockhash = (await connection.getLatestBlockhash("confirmed")).blockhash;

      const { signature } = await phantom.signAndSendTransaction(tx);
      await connection.confirmTransaction(signature, "confirmed");
      await refreshBalances(owner);
      alert(`USDC envoyé ✅ tx: ${signature}`);
    } finally { setLoading(false); }
  }

  useEffect(() => {
    (async () => {
      if (!phantom) return;
      try {
        const res = await phantom.connect({ onlyIfTrusted: true });
        setPubkey(res.publicKey.toBase58());
        await refreshBalances(res.publicKey);
      } catch {}
    })();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  return (
    <div style={{ maxWidth: 760, fontFamily: "system-ui, sans-serif" }}>
      <h2>Wolverine</h2>
      <div style={{ opacity: 0.7 }}>Network: {NETWORK}</div>

      {!pubkey ? (
        <button onClick={connectWallet}>Connect Phantom</button>
      ) : (
        <>
          <div><b>Wallet connecté:</b> {pubkey}</div>
          <div style={{ marginTop: 8 }}>
            <b>SOL:</b> {sol.toFixed(6)}<br />
            <b>USDC:</b> {usdc.toFixed(2)}
          </div>

          <div style={{ marginTop: 12, padding: 12, border: "1px solid #ddd", borderRadius: 8 }}>
            <div><b>Destination WOLVERINE:</b> {WOLVERINE_WALLET.toBase58()}</div>

            <div style={{ marginTop: 10 }}>
              <b>Envoyer SOL</b><br />
              <input value={sendSolAmount} onChange={(e) => setSendSolAmount(e.target.value)} />
              <button disabled={loading} onClick={sendSOL} style={{ marginLeft: 8 }}>Send SOL</button>
            </div>

            <div style={{ marginTop: 10 }}>
              <b>Envoyer USDC</b><br />
              <input value={sendUsdcAmount} onChange={(e) => setSendUsdcAmount(e.target.value)} />
              <button disabled={loading} onClick={sendUSDC} style={{ marginLeft: 8 }}>Send USDC</button>
            </div>

            <div style={{ marginTop: 10 }}>
              <button onClick={disconnect}>Disconnect</button>
            </div>
          </div>
        </>
      )}
    </div>
  );
}
EOF

  # Inject into home
  if [[ -f "$APP_DIR/app/page.tsx" ]]; then
    cp -a "$APP_DIR/app/page.tsx" "$CFG_BAK_DIR/app_page.tsx.bak" || true
    cat >"$APP_DIR/app/page.tsx" <<'EOF'
import PhantomWolverine from "../components/PhantomWolverine";
export default function Page() { return <PhantomWolverine />; }
EOF
    say "OK: injected into app/page.tsx"
  elif [[ -f "$APP_DIR/pages/index.tsx" ]]; then
    cp -a "$APP_DIR/pages/index.tsx" "$CFG_BAK_DIR/pages_index.tsx.bak" || true
    cat >"$APP_DIR/pages/index.tsx" <<'EOF'
import dynamic from "next/dynamic";
const PhantomWolverine = dynamic(() => import("../components/PhantomWolverine"), { ssr: false });
export default function Home() { return <PhantomWolverine />; }
EOF
    say "OK: injected into pages/index.tsx"
  else
    say "[WARN] No app/page.tsx or pages/index.tsx found. You must manually import PhantomWolverine in your real entry."
    find "$APP_DIR" -maxdepth 4 -type f \( -name 'page.tsx' -o -name 'index.tsx' -o -name 'App.tsx' \) -not -path '*/node_modules/*' | head -n 30 || true
  fi

else
  say "[DRY] would write lib/solana.ts + components/PhantomWolverine.tsx + inject into home"
fi

# 4) Install deps + build (export generates out/ with output:'export')
run "cd '$APP_DIR' && npm i @solana/web3.js @solana/spl-token"
run "cd '$APP_DIR' && npm i"
run "cd '$APP_DIR' && npm run build"

if [[ "$APPLY" == "1" ]]; then
  [[ -d "$APP_DIR/out" ]] || { echo "[ERR] out/ introuvable après build (output: export attendu)."; exit 1; }
fi

# 5) Publish out/ -> OUT_DIR
run "mkdir -p '$OUT_DIR'"
run "rsync -a --delete '$APP_DIR/out/' '$OUT_DIR/'"

# 6) Disable server service (not compatible / not needed)
run "systemctl stop wolverine-next 2>/dev/null || true"
run "systemctl disable wolverine-next 2>/dev/null || true"

# 7) Rebuild nginx vhost clean
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
BACKDIR="/etc/nginx/sites-disabled/backup_rebuild_$(ts)"
run "mkdir -p '$BACKDIR' && ( [ -f '$VHOST' ] && cp -a '$VHOST' '$BACKDIR/$(basename "$VHOST")' || true )"

if [[ "$APPLY" == "1" ]]; then
  cat >"$VHOST" <<EOF
# ${DOMAIN} - rebuilt $(ts)

server {
  listen 80;
  listen [::]:80;
  server_name ${DOMAIN} www.${DOMAIN};
  return 301 https://\$host\$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name ${DOMAIN} www.${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

  access_log /var/log/nginx/${DOMAIN}.access.log;
  error_log  /var/log/nginx/${DOMAIN}.error.log;

  location = /favicon.ico {
    access_log off;
    log_not_found off;
    return 204;
  }

  location = / {
    return 302 ${BASE_PATH}/;
  }

  location ^~ ${BASE_PATH}/ {
    alias ${OUT_DIR}/;
    index index.html;
    try_files \$uri \$uri/ ${BASE_PATH}/index.html;
  }
}
EOF
  nginx -t
  systemctl reload nginx
  say "OK: nginx reloaded"
else
  say "[DRY] would rewrite $VHOST and reload nginx"
fi

echo
say "DONE."
say "Backups: $CFG_BAK_DIR and $BACKDIR"
echo
echo "Tests:"
echo "  curl -k -sSI https://127.0.0.1${BASE_PATH}/ -H 'Host: ${DOMAIN}' | head -n 15"
echo "  curl -sSI https://${DOMAIN}${BASE_PATH}/ | head -n 15"
echo "  curl -s https://${DOMAIN}${BASE_PATH}/ | head -n 40"
BASH

chmod +x /root/batch_root_wolverine_full.sh
echo "OK: /root/batch_root_wolverine_full.sh prêt"







APPLY=1 NETWORK=mainnet \
WOLVERINE_WALLET="DgpM2PXA9it1g8myWnVXeosu72GkwmjgpeGUigpyLkYC" \

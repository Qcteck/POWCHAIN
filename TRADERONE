cat >/tmp/WOLVERINE_ENABLE_443_NGINX_PROXY_8585.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
EMAIL="admin@fireinners.online"

echo "== Install nginx+certbot =="
apt-get update -y
apt-get install -y nginx certbot python3-certbot-nginx

echo "== UFW allow 80/443 =="
ufw allow 80/tcp || true
ufw allow 443/tcp || true
ufw reload || true

echo "== Create nginx vhost (HTTP -> proxy 8585) =="
cat >/etc/nginx/sites-available/fireinners <<'EOF'
server {
  listen 80;
  listen [::]:80;
  server_name fireinners.online;

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:8585;
  }
}
EOF

ln -sf /etc/nginx/sites-available/fireinners /etc/nginx/sites-enabled/fireinners
rm -f /etc/nginx/sites-enabled/default 2>/dev/null || true

nginx -t
systemctl restart nginx

echo "== Check LISTEN 80/443 (should at least have 80 now) =="
ss -lntp | egrep ':(80|443)\s' || true
echo

echo "== Obtain SSL + enable 443 (certbot will add listen 443) =="
certbot --nginx -d "$DOMAIN" -m "$EMAIL" --agree-tos --non-interactive --redirect

echo "== Final LISTEN 80/443 =="
ss -lntp | egrep ':(80|443)\s' || true
echo

echo "== Test HTTPS =="
curl -vkI "https://$DOMAIN/" --max-time 10 2>&1 | sed -n '1,25p'
SH

bash /tmp/WOLVERINE_ENABLE_443_NGINX_PROXY_8585.sh
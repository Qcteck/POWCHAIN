cat >/root/FIREINNERS_WALLET_FIX_SOLRPC_SLASH_MEGA.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
BKDIR="/root/backup_fireinners_wallet_${TS}"
mkdir -p "$BKDIR"

CANDIDATES=(
"/opt/fireinners/frontend-react/app/dist/wallet/index.html"
"/opt/fireinners/frontend-react/app/dist/wallet/index.htm"
"/opt/fireinners/frontend-react/app/dist/wallet.html"
"/opt/fireinners/frontend-react/app/dist/index.html"
)

WALLET_HTML=""
for f in "${CANDIDATES[@]}"; do [ -f "$f" ] && WALLET_HTML="$f" && break; done
if [ -z "$WALLET_HTML" ]; then
  echo "ERR: wallet html not found. Tried:"; printf " - %s\n" "${CANDIDATES[@]}"; exit 2
fi

echo "Wallet HTML: $WALLET_HTML"
cp -a "$WALLET_HTML" "$BKDIR/$(basename "$WALLET_HTML").bak"

python3 - "$WALLET_HTML" <<'PY'
import re, sys, pathlib
p = pathlib.Path(sys.argv[1])
s = p.read_text(encoding="utf-8", errors="ignore")

# 1) Force slash final: https://fireinners.online/solrpc/ (évite 301->GET)
s2 = re.sub(r'(https?://fireinners\.online/solrpc)(?!/)', r'\1/', s)

# 2) Aussi corriger les occurrences de "/solrpc" dans les URLs (mais pas "/solrpc/")
#    ex: "https://fireinners.online/solrpc" -> "https://fireinners.online/solrpc/"
s2 = re.sub(r'(/solrpc)(?!/)', r'\1/', s2)

# 3) Ajouter des placeholders d'IDs si absent (évite textContent sur null)
if "FI_SOLRPC_PLACEHOLDERS_V1" not in s2:
    placeholders = r'''
<!-- FI_SOLRPC_PLACEHOLDERS_V1 -->
<div id="fi_placeholders" style="display:none">
  <span id="rpcSOL"></span><span id="rpcUSDC"></span>
  <span id="rpcSol"></span><span id="rpcUsdc"></span><span id="rpcUSdc"></span>
  <span id="solVal"></span><span id="usdcVal"></span>
  <pre id="msgBox"></pre><pre id="log"></pre><pre id="status"></pre>
</div>
'''
    if "</body>" in s2:
        s2 = s2.replace("</body>", placeholders + "\n</body>")
    else:
        s2 += "\n" + placeholders + "\n"

if s2 != s:
    p.write_text(s2, encoding="utf-8")
    print("OK: patched wallet (force /solrpc/ + placeholders).")
else:
    print("OK: nothing to change (already patched).")
PY

echo "Done. Backup in: $BKDIR"
echo "Test:"
echo "  curl -fsS https://fireinners.online/solrpc/ping && echo"
echo "  curl -fsS -H 'content-type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\"}' https://fireinners.online/solrpc/ && echo"
echo "Open:"
echo "  https://fireinners.online/wallet/?v=${TS}"
SH
chmod +x /root/FIREINNERS_WALLET_FIX_SOLRPC_SLASH_MEGA.sh
bash /root/FIREINNERS_WALLET_FIX_SOLRPC_SLASH_MEGA.sh
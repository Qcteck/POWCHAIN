say "== 10) Inject include into correct 443 server block (fireinners.online) =="
MARK_BEGIN="# AIAQUILA_INCLUDE_BEGIN"
MARK_END="# AIAQUILA_INCLUDE_END"
if ! grep -qF "$MARK_BEGIN" "$VHOST"; then
  awk -v domain="$DOMAIN" -v inc="$INC" -v mb="$MARK_BEGIN" -v me="$MARK_END" '
    function ltrim(s){sub(/^[ \t\r\n]+/,"",s);return s}
    BEGIN{inserver=0;depth=0;hasDomain=0;has443=0}
    {
      line=$0
      # track server block
      if(!inserver && line ~ /^[ \t]*server[ \t]*\{/){inserver=1;depth=1;hasDomain=0;has443=0;print;next}
      if(inserver){
        if(line ~ /server_name/ && line ~ domain){hasDomain=1}
        if(line ~ /listen/ && line ~ /443/){has443=1}
        # update depth by braces
        ob=gsub(/\{/,"&",line); cb=gsub(/\}/,"&",line); depth += (ob - cb)
        # when leaving server block, inject before the closing brace line that ends it
        if(depth==0){
          if(hasDomain && has443){
            print "  " mb
            print "  include " inc ";"
            print "  " me
          }
          inserver=0
          print $0
          next
        }
        print $0
        next
      }
      print $0
    }
  ' "$VHOST" >"$BK/vhost.patched"
  cp -a "$BK/vhost.patched" "$VHOST"
fi


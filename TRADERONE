set -e
cd /root

D="https://fireinners.online"

echo "=== A) Test REST en GET (si dispo) ==="
for p in \
  "$D/wolverine/traderone/api/health" \
  "$D/wolverine/traderone/api/ping" \
  "$D/wolverine/api/health" \
  "$D/wolverine/api/ping" \
; do
  echo "--- GET $p"
  curl -sS -i "$p" | head -n 15 || true
  echo
done

echo "=== B) Test REST en POST /api/status (le plus safe) ==="
for p in \
  "$D/wolverine/traderone/api/status" \
  "$D/wolverine/traderone/api/api/status" \
  "$D/wolverine/api/status" \
  "$D/wolverine/api/api/status" \
; do
  echo "--- POST $p"
  curl -sS -i "$p" -H "content-type: application/json" --data '{}' | head -n 25 || true
  echo
done

echo "=== C) Test START (une fois que STATUS marche) ==="
for p in \
  "$D/wolverine/traderone/api/start" \
  "$D/wolverine/traderone/api/api/start" \
  "$D/wolverine/api/start" \
  "$D/wolverine/api/api/start" \
; do
  echo "--- POST $p"
  curl -sS -i "$p" -H "content-type: application/json" --data '{}' | head -n 30 || true
  echo
done
cat >/root/TRADERONE_FIX_FINAL.sh <<'SH'
#!/usr/bin/env bash
set -e

echo "=== TRADERONE FINAL FIX (CLEAN) ==="

APP_DIR="/opt/traderone"
PORT=3000

# 1) Sécurité
systemctl stop nginx 2>/dev/null || true
systemctl disable nginx 2>/dev/null || true

# 2) Node + pm2
command -v node >/dev/null || (curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && apt install -y nodejs)
command -v pm2 >/dev/null || npm i -g pm2

# 3) Dossiers
mkdir -p "$APP_DIR"
cd "$APP_DIR"

# 4) ENV
cat > .env <<EOF
NODE_ENV=production
PORT=$PORT
EOF

# 5) SERVER.JS (⚠️ HEREDOC ISOLÉ, SAFE)
cat > server.js <<'EOF'
import http from "http";
import url from "url";

const PORT = process.env.PORT || 3000;

const server = http.createServer((req,res)=>{
  const {pathname}=url.parse(req.url,true);

  if(pathname==="/health"){
    res.writeHead(200,{"Content-Type":"application/json"});
    return res.end(JSON.stringify({ok:true}));
  }

  if(req.method==="POST" && pathname==="/start"){
    let body="";
    req.on("data",c=>body+=c);
    req.on("end",()=>{
      res.writeHead(200,{"Content-Type":"application/json"});
      res.end(JSON.stringify({started:true,input:body||null}));
    });
    return;
  }

  res.writeHead(200,{"Content-Type":"text/html"});
  res.end(`<!doctype html>
<html><body style="background:#111;color:#eee;font-family:Arial">
<h1>TraderOne LIVE</h1>
<button onclick="go()">START</button>
<pre id="out"></pre>
<script>
async function go(){
 const r=await fetch('/start',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});
 out.textContent=JSON.stringify(await r.json(),null,2);
}
</script>
</body></html>`);
});

server.listen(PORT,"0.0.0.0",()=>console.log("LIVE",PORT));
EOF

# 6) PM2 RESET
pm2 delete traderone 2>/dev/null || true
pm2 start server.js --name traderone
pm2 save

# 7) TEST
sleep 2
curl -fs http://127.0.0.1:$PORT/health && echo " OK"

echo "=== TRADERONE UP ==="
pm2 status
SH

chmod +x /root/TRADERONE_FIX_FINAL.sh
/root/TRADERONE_FIX_FINAL.sh
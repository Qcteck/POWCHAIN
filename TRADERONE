  index index.html;
  try_files \$uri \$uri/ /${SLUG}/index.html;
}
EOF

# -------------------------
# 12) Inject include into ACTIVE_VHOST (unique marker)
# -------------------------
say "== 12) Inject include into vhost (unique marker) =="
MARK_BEGIN="# AIAQUILA_INCLUDE_BEGIN"
MARK_END="# AIAQUILA_INCLUDE_END"
if ! grep -qF "$MARK_BEGIN" "$VHOST"; then
  tmp="$BK/vhost.tmp"
  awk -v mb="$MARK_BEGIN" -v me="$MARK_END" -v inc="$INC" '
    {print}
    # inject before last "}" if inside any server block; pragmatic and idempotent by marker
    END{
    }
  ' "$VHOST" >"$tmp"
  # simple safe inject: insert markers + include right before final closing brace of file
  # (works even if multiple servers; include file has ^~ so it wins for that path)
  sed -i "s|^[[:space:]]*}$|  ${MARK_BEGIN}\n  include ${INC};\n  ${MARK_END}\n}|" "$tmp"
  cp -a "$tmp" "$VHOST"
fi

# -------------------------
# 13) nginx test + reload
# -------------------------
say "== 13) nginx test + reload =="
nginx -t
systemctl reload nginx

# -------------------------
# 14) Smoke tests (local TLS resolve)
# -------------------------
say "== 14) Smoke tests =="
echo "---- /aiaquila/ (HEAD) ----"
curl -kIsS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/${SLUG}/" | head -n 12 || true
echo "---- /aiaquila/api/health ----"
curl -kSs --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/${SLUG}/api/health" || true
echo

# -------------------------
# 15) Freeze nginx files (confirmed)
# -------------------------
say "== 15) Freeze (chattr +i) =="
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$VHOST" 2>/dev/null || true
chattr +i "$INC" 2>/dev/null || true

say "DONE"
echo "URL: https://${DOMAIN}/${SLUG}/"
echo "API: https://${DOMAIN}/${SLUG}/api/health"
echo -n "ADMIN_TOKEN: "; cat "$CFG/admin.token"; echo
echo "POLICY: $CFG/exec_allowlist.json"
echo "BACKUP: $BK"
BASH
chmod +x /root/MEGA_AIAQUILA_DEPLOY_V1.sh
bash /root/MEGA_AIAQUILA_DEPLOY_V1.sh
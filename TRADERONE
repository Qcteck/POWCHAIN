cat >/root/github_push_root_batch.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

REPO="Qcteck/WOLVERINE1"
DIR="/opt/WOLVERINE1_export"

cd "$DIR"

echo "== 1) PAT (hidden) =="
read -s -p "PAT: " PAT; echo
[ -n "$PAT" ] || { echo "Empty PAT"; exit 1; }

echo
echo "== 2) Quick SSO header check (if required, GitHub will say so) =="
curl -sSI -H "Authorization: Bearer ${PAT}" https://api.github.com/user | grep -i 'x-github-sso' || echo "No X-GitHub-SSO header"

echo
echo "== 3) Purge any cached git credentials =="
rm -f /root/.git-credentials 2>/dev/null || true
git config --global --unset-all credential.helper 2>/dev/null || true

echo
echo "== 4) Ensure branch main =="
git branch -M main 2>/dev/null || true

echo
echo "== 5) FORCE push with token in URL (TEMP), then clean origin =="
git remote remove origin 2>/dev/null || true
git remote add origin "https://x-access-token:${PAT}@github.com/${REPO}.git"

GIT_TERMINAL_PROMPT=0 git push -u origin main

# remove token from remote right after
git remote set-url origin "https://github.com/${REPO}.git"

echo
echo "DONE ✅ pushed + origin cleaned"
BASH

chmod +x /root/github_push_root_batch.sh
/root/github_push_root_batch.sh
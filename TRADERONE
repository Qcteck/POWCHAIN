#!/bin/bash
set -e

echo "=== AIAQUILA RSS PROXY INSTALL (FINAL) ==="

# 1) Dépendances
apt update
apt install -y php php-curl nginx

# 2) Dossier
mkdir -p /var/www/aiaquila
chown -R www-data:www-data /var/www/aiaquila

# 3) Proxy PHP CORRECT
cat > /var/www/aiaquila/rss-proxy.php <<'PHP'
<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/xml; charset=UTF-8");

if (!isset($_GET["url"])) {
  http_response_code(400);
  echo "<error>missing url</error>";
  exit;
}

$url = $_GET["url"];

$ch = curl_init($url);
curl_setopt_array($ch, [
  CURLOPT_RETURNTRANSFER => true,
  CURLOPT_FOLLOWLOCATION => true,
  CURLOPT_TIMEOUT => 15,
  CURLOPT_USERAGENT => "Mozilla/5.0 (AIAQUILA)"
]);

$data = curl_exec($ch);
$err  = curl_error($ch);
curl_close($ch);

if (!$data) {
  http_response_code(502);
  echo "<error>fetch failed: $err</error>";
  exit;
}

echo $data;
PHP

# 4) Permissions
chown www-data:www-data /var/www/aiaquila/rss-proxy.php
chmod 644 /var/www/aiaquila/rss-proxy.php

# 5) Reload nginx
nginx -t
systemctl reload nginx

echo "=== INSTALL OK ==="
echo "TEST:"
echo "https://fireinners.online/aiaquila/rss-proxy.php?url=https://www.coindesk.com/arc/outboundfeeds/rss/"
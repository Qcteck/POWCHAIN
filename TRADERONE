#!/usr/bin/env bash
set -euo pipefail
umask 022

echo "== EINSHSTEIN APP • REACT (VITE) =="

# Paths
BASE="/opt/einshtein-app"
SRC="$BASE/src"
WWW="/var/www/aquilatrader/app"
NGX="/etc/nginx"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_EINSHSTEIN_APP_${TS}"

mkdir -p "$BK"
[ -d "$BASE" ] && cp -a "$BASE" "$BK/base" || true
[ -d "$WWW" ] && cp -a "$WWW" "$BK/www" || true

# Ensure Node (LTS)
if ! command -v node >/dev/null 2>&1; then
  echo "Installing Node LTS..."
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt-get install -y nodejs
fi

# Clean & init Vite React
rm -rf "$BASE"
mkdir -p "$BASE"
cd "$BASE"

npm init -y >/dev/null
npm install react react-dom >/dev/null
npm install -D vite @vitejs/plugin-react >/dev/null

# Vite config
cat > vite.config.js <<'EOF'
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
export default defineConfig({
  plugins: [react()],
  build: { outDir: 'dist' }
})
EOF

# HTML
mkdir -p public
cat > public/index.html <<'EOF'
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Einshtein App</title>
</head>
<body>
  <div id="root"></div>
  <script type="module" src="/src/main.jsx"></script>
</body>
</html>
EOF

# React entry
mkdir -p src
cat > src/main.jsx <<'EOF'
import React from 'react'
import { createRoot } from 'react-dom/client'
import App from './App.jsx'
import './style.css'

createRoot(document.getElementById('root')).render(<App />)
EOF

# App logic (NO TRADE CONTROLS)
cat > src/App.jsx <<'EOF'
import React, { useState } from 'react'

export default function App() {
  const [risk, setRisk] = useState(25)
  const [floor, setFloor] = useState(8)

  return (
    <div className="wrap">
      <header className="card">
        <h1>Einshtein</h1>
        <p className="muted">Autorisation du risque • L’algorithme décide</p>
      </header>

      <section className="card">
        <h2>État</h2>
        <div className="row">
          <span className="pill ok">ACTIF</span>
          <span className="pill">Solana • Microcaps</span>
        </div>
        <p className="small">
          Dernière décision : <b>NO-TRADE</b><br/>
          Raison : structure insuffisamment cohérente
        </p>
      </section>

      <section className="card">
        <h2>Risque autorisé</h2>
        <input type="range" min="1" max="100" value={risk}
          onChange={e=>setRisk(+e.target.value)} />
        <div className="row">
          <b>{risk}%</b>
          <span className="muted small">
            Plus élevé → agit un peu plus souvent quand c’est cohérent
          </span>
        </div>
      </section>

      <section className="card">
        <h2>Plancher du budget</h2>
        <input type="range" min="0" max="100" value={floor}
          onChange={e=>setFloor(+e.target.value)} />
        <div className="row">
          <b>{floor}%</b>
          <span className="muted small">
            Taille minimale d’un trade s’il est autorisé
          </span>
        </div>
      </section>

      <section className="card">
        <h2>Rappels</h2>
        <ul className="small">
          <li>Aucun bouton BUY / SELL</li>
          <li>Ces réglages n’obligent jamais un trade</li>
          <li>La porte (liq/vol/tx) ne baisse jamais</li>
        </ul>
      </section>

      <footer className="card small muted">
        Frais plateforme (0.001%) : cumul public •
        Droits intellectuels (2%) : privé
      </footer>
    </div>
  )
}
EOF

# Styles
cat > src/style.css <<'EOF'
:root{--bg:#070a0f;--fg:#d9e6ff;--mut:#7ea3d7;--b:#142033;--ok:#20ff7a}
*{box-sizing:border-box;font-family:system-ui,-apple-system,Segoe UI,Roboto}
body{margin:0;background:var(--bg);color:var(--fg)}
.wrap{max-width:720px;margin:0 auto;padding:14px}
.card{background:#0b1220;border:1px solid var(--b);border-radius:14px;padding:12px;margin-bottom:12px}
h1{margin:0;font-size:18px}
h2{margin:0 0 8px 0;font-size:14px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.pill{padding:4px 8px;border-radius:999px;border:1px solid var(--b);font-size:12px}
.ok{border-color:#2b7a4a;color:var(--ok)}
.muted{color:var(--mut)}
.small{font-size:12px}
input[type=range]{width:100%}
EOF

# Build
npm run build >/dev/null

# Deploy
rm -rf "$WWW"
mkdir -p "$(dirname "$WWW")"
cp -a dist "$WWW"

# Nginx include (idempotent)
INC="$NGX/includes/aquilatrader_app.inc"
mkdir -p "$(dirname "$INC")"
cat > "$INC" <<'EOF'
location /aquilatrader/app/ {
  alias /var/www/aquilatrader/app/;
  try_files $uri $uri/ /index.html;
}
EOF

# Inject include if not present
VHOST="$(ls $NGX/sites-available/*fireinners* 2>/dev/null | head -n1 || true)"
if [ -n "$VHOST" ] && ! grep -q aquilatrader_app.inc "$VHOST"; then
  sed -i '/server {/a \    include /etc/nginx/includes/aquilatrader_app.inc;' "$VHOST"
fi

nginx -t
systemctl reload nginx

echo "== DONE =="
echo "URL: https://www.fireinners.online/aquilatrader/app/"
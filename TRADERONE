bash -lc 'set -euo pipefail
RPC_FALLBACK="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"
BOT_FALLBACK="e8DbBrTJxRetx3HNFb83CsXMySETydHVLwxMzkjcVqh"
MARK="WOLV_START_SENDONLY_V3"

JS="$(cat <<JS
/* ${MARK} */
(()=>{const W=window;
const LOG=(...a)=>console.log("[WOLV-START]",...a);
const STATUS=(t)=>{try{const el=document.querySelector("#status,#statusLine,[data-status]");if(el){if(/Status:/i.test(el.textContent||""))el.textContent="Status: "+t;else el.textContent=t;}}catch(e){}LOG("STATUS:",t);};

const byText=(re)=>[...document.querySelectorAll("button,input[type=button],input[type=submit],a")].find(x=>re.test(((x.textContent||x.value||"")+"").trim()));
const startBtn=()=>byText(/START\\s*WOLVERINE|^START$/i);
const budgetEl=()=>document.querySelector("#budget,input[name=budget]")||[...document.querySelectorAll("input")].find(i=>/budget/i.test((i.id||"")+(i.name||"")+(i.placeholder||"")) )||[...document.querySelectorAll("input")].find(i=>i.type==="number"||/^[0-9.,]+$/.test(i.value||""));
const budget=()=>{const el=budgetEl();const v=parseFloat(((el&&el.value)||"").toString().replace(",", "."));return isFinite(v)?v:0;};

const findBot=()=>{try{const t=document.body.innerText||"";const m=t.match(/Adresse\\s*:\\s*([1-9A-HJ-NP-Za-km-z]{32,44})/i);if(m&&m[1])return m[1];}catch(e){}return (W.TRADERONE_WALLET||W.__TRADERONE_WALLET||"${BOT_FALLBACK}");};

function ensureUI(){
  if(document.querySelector("#wolvAsset"))return;
  const s=startBtn(); if(!s)return;
  const wrap=document.createElement("span");wrap.style.display="inline-flex";wrap.style.gap="6px";wrap.style.alignItems="center";wrap.style.marginLeft="8px";
  const sel=document.createElement("select");sel.id="wolvAsset";sel.innerHTML="<option value=\\"SOL\\">SOL</option><option value=\\"USDC\\">USDC</option>";
  sel.value=localStorage.getItem("WOLV_ASSET")||"USDC";
  sel.onchange=()=>localStorage.setItem("WOLV_ASSET",sel.value);
  wrap.appendChild(document.createTextNode("Asset:"));wrap.appendChild(sel);
  s.parentNode.insertBefore(wrap,s.nextSibling);
}
const getAsset=()=>document.querySelector("#wolvAsset")?.value||localStorage.getItem("WOLV_ASSET")||"USDC";

function addScript(src){return new Promise((res,rej)=>{const s=document.createElement("script");s.src=src;s.async=true;s.onload=()=>res(src);s.onerror=()=>rej(new Error("load fail "+src));document.head.appendChild(s);});}
async function ensureLibs(){
  if(W.solanaWeb3&&W.solanaWeb3.PublicKey&&W.solanaWeb3.Connection){LOG("libs déjà OK");return W.solanaWeb3;}
  STATUS("DEBUG: charge libs...");
  const base="/wolverine/vendor/";
  await addScript(base+"solana-web3.min.js");
  await addScript(base+"spl-token.min.js");
  if(!(W.solanaWeb3&&W.solanaWeb3.PublicKey&&W.solanaWeb3.Connection)) throw new Error("libs pas prêtes (web3)");
  LOG("libs OK",!!W.solanaWeb3,!!W.splToken);
  return W.solanaWeb3;
}
async function phantom(){
  const P=W.phantom?.solana||W.solana; 
  if(!P) throw new Error("Phantom introuvable");
  if(!P.isConnected){
    STATUS("DEBUG: connect Phantom (popup)...");
    await P.connect({onlyIfTrusted:false});
  }
  LOG("phantom connected",P.publicKey?.toString?.());
  return P;
}
function conn(S){return W.__WOLV_CONN__||(W.__WOLV_CONN__=new S.Connection(W.__RPC__||W.RPC_URL||"${RPC_FALLBACK}","confirmed"));}

async function sendSOL(S,owner,to,amtSOL){
  const c=conn(S);
  const lamports=Math.round(amtSOL*1e9);
  const ix=S.SystemProgram.transfer({fromPubkey:owner,toPubkey:to,lamports});
  const {blockhash,lastValidBlockHeight}=await c.getLatestBlockhash("confirmed");
  const tx=new S.Transaction({feePayer:owner,blockhash,lastValidBlockHeight}).add(ix);
  return {tx,blockhash,lastValidBlockHeight,c};
}
async function sendUSDC(S,owner,to,amtUSDC){
  const c=conn(S);
  const T=W.splToken; if(!T) throw new Error("spl-token manquant");
  const mint=new S.PublicKey("${USDC_MINT}");
  const TOKEN_PROGRAM_ID=T.TOKEN_PROGRAM_ID||new S.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA");
  const ASSOCIATED_TOKEN_PROGRAM_ID=T.ASSOCIATED_TOKEN_PROGRAM_ID||new S.PublicKey("ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL");
  const ata=(ownerPk)=>{const [a]=S.PublicKey.findProgramAddressSync([ownerPk.toBuffer(),TOKEN_PROGRAM_ID.toBuffer(),mint.toBuffer()],ASSOCIATED_TOKEN_PROGRAM_ID);return a;};
  const fromAta=ata(owner), toAta=ata(to);
  const ixs=[];
  const toInfo=await c.getAccountInfo(toAta,"confirmed");
  if(!toInfo && T.createAssociatedTokenAccountInstruction){
    ixs.push(T.createAssociatedTokenAccountInstruction(owner,toAta,to,mint,TOKEN_PROGRAM_ID,ASSOCIATED_TOKEN_PROGRAM_ID));
  }
  const amt=Math.round(amtUSDC*1e6);
  if(!T.createTransferInstruction) throw new Error("createTransferInstruction manquant");
  ixs.push(T.createTransferInstruction(fromAta,toAta,owner,amt,[],TOKEN_PROGRAM_ID));
  const {blockhash,lastValidBlockHeight}=await c.getLatestBlockhash("confirmed");
  const tx=new S.Transaction({feePayer:owner,blockhash,lastValidBlockHeight}); ixs.forEach(ix=>tx.add(ix));
  return {tx,blockhash,lastValidBlockHeight,c};
}

async function startSend(){
  ensureUI();
  STATUS("DEBUG: start click");
  const S=await ensureLibs();
  const P=await phantom();
  const owner=new S.PublicKey(P.publicKey.toString());
  const bot=new S.PublicKey(findBot());
  const amt=budget(); if(!(amt>0)) throw new Error("Budget invalide");
  const asset=getAsset();

  LOG("PARAMS", {asset, amt, from: owner.toBase58(), to: bot.toBase58()});

  STATUS("DEBUG: build tx...");
  const pack = asset==="SOL" ? await sendSOL(S,owner,bot,amt) : await sendUSDC(S,owner,bot,amt);

  STATUS("DEBUG: signature Phantom (popup)...");
  let txid;
  if(P.signAndSendTransaction){
    const r=await P.signAndSendTransaction(pack.tx);
    txid=(r.signature||r).toString();
  } else {
    const stx=await P.signTransaction(pack.tx);
    txid=await pack.c.sendRawTransaction(stx.serialize(),{skipPreflight:false});
  }
  LOG("TXID", txid);

  STATUS("DEBUG: confirm...");
  await pack.c.confirmTransaction({signature:txid,blockhash:pack.blockhash,lastValidBlockHeight:pack.lastValidBlockHeight},"confirmed");

  STATUS("OK (envoyé) "+txid.slice(0,8)+"...");
}

function bind(){
  const b=startBtn(); if(!b){setTimeout(bind,250);return;}
  ensureUI();
  b.addEventListener("click",(e)=>{
    e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();
    startSend().catch(err=>{const m=(err&&err.message)||String(err);STATUS("ERR: "+m);LOG("ERR FULL",err);});
  },true);
  STATUS("READY");
}

if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",bind); else bind();
})();
JS
)"

patched=0
while IFS= read -r f; do
  d="$(dirname "$f")"; mkdir -p "$d/patches"
  printf "%s\n" "$JS" > "$d/patches/wolv_start_sendonly.js"

  # inject vendor libs in <head> (si pas déjà)
  if ! grep -q "/wolverine/vendor/solana-web3.min.js" "$f"; then
    perl -0777 -pe "s#</head>#<script src=\"/wolverine/vendor/solana-web3.min.js\"></script><script src=\"/wolverine/vendor/spl-token.min.js\"></script>\\n</head>#i" -i "$f"
  fi

  # inject patch script avant </body> (remplace ancien patch si présent)
  perl -0777 -pe "s#<script[^>]+/patches/[^\"\\x27>]+\\.js[^>]*></script>\\s*##ig" -i "$f" || true
  if ! grep -q "${MARK}" "$f"; then
    if grep -qi "</body>" "$f"; then
      perl -0777 -pe "s#</body>#<script src=\"./patches/wolv_start_sendonly.js\"></script>\\n</body>#i" -i "$f"
    else
      printf "\n<script src=\"./patches/wolv_start_sendonly.js\"></script>\n" >> "$f"
    fi
  fi

  echo "[OK] START SENDONLY PATCH -> $f"
  patched=1
done < <(find /opt /var/www /srv /root /home -type f -iname "index.html" 2>/dev/null | xargs -r grep -Il "START WOLVERINE" 2>/dev/null || true)

[ "$patched" -eq 1 ] || { echo "[ERR] index.html avec START WOLVERINE introuvable"; exit 2; }
echo "DONE. Recharge la page (Ctrl+F5). Clique START -> popup Phantom -> confirm -> envoyé. Debug dans Console: [WOLV-START]."
'
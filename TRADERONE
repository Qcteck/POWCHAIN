cat > /root/FIREINNERS_WALLET_TAB_FLY.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== FIREINNERS WALLET TAB :: BATCH FLY (read-only) ==="
DIST="/opt/fireinners/frontend-react/app/dist"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
echo "[1] Paths"
echo "DIST=$DIST"
echo "VHOST=$VHOST"
echo
echo "[2] Existence"
[ -d "$DIST" ] && echo "OK dist dir" || { echo "ERR dist dir not found"; exit 1; }
[ -f "$DIST/index.html" ] && echo "OK dist/index.html" || { echo "ERR dist/index.html not found"; exit 1; }
[ -f "$VHOST" ] && echo "OK vhost" || echo "WARN vhost missing (path differs?)"
echo
echo "[3] Immutable flags"
lsattr "$DIST/index.html" 2>/dev/null || true
echo
echo "[4] Existing wallet route?"
[ -d "$DIST/wallet" ] && echo "WARN dist/wallet already exists" || echo "OK dist/wallet not present"
grep -q "FIREINNERS_WALLET_TAB_v1" "$DIST/index.html" && echo "WARN wallet tab already injected" || echo "OK wallet tab not injected"
echo
echo "[5] Nginx sanity"
nginx -t && echo "OK nginx -t" || { echo "ERR nginx -t failed"; exit 1; }
echo
echo "[6] Preview first lines of dist/index.html (for safety)"
head -n 5 "$DIST/index.html" || true
echo
echo "DONE (no changes made)."
SH
chmod +x /root/FIREINNERS_WALLET_TAB_FLY.sh
bash /root/FIREINNERS_WALLET_TAB_FLY.sh
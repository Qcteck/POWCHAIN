cat >/tmp/MEGA_WOLVERINE_CONFIG_V2.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ASKMOD="/opt/fireinners/sentinel/lib/askorupdate.sh";[ -f "$ASKMOD" ]&&. "$ASKMOD"||true
say(){ printf "%s\n" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: manque $1"; exit 1; }; }
askyn(){ local q="$1" a=""; if command -v askorupdate_yesno >/dev/null 2>&1; then askorupdate_yesno "$q" || exit 0; else read -r -p "$q (y/N) " a||true; case "${a,,}" in y|yes) :;; *) say "Stop."; exit 0;; esac; fi; }

NG="/etc/nginx/sites-available/fireinners.online-ssl"
OUTDIR="/var/lib/wolverine-config"
OUTJSON="$OUTDIR/public-config.json"
CUSTDIR="/var/lib/wolverine-custody"
KEYFILE="$CUSTDIR/solana-keypair.json"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"
TOKEN_PROGRAM="TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
ASSOC_PROGRAM="ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL"

need awk; need grep; need sed; need ss; need node; need nginx; need curl; need head; need find; need chmod; need mkdir; need cp; need perl

[ -f "$NG" ] || { say "ERREUR: nginx vhost absent: $NG"; exit 1; }

say "=== PRE-FLIGHT (read-only) ==="
say "NGINX: $NG"

PORT="$(awk '
  $0 ~ /location[[:space:]]+\/wolverine\/api/ {inloc=1}
  inloc && $0 ~ /proxy_pass/ {
    if (match($0,/127\.0\.0\.1:([0-9]+)/,a)) {print a[1]; exit}
    if (match($0,/localhost:([0-9]+)/,a)) {print a[1]; exit}
  }
  inloc && $0 ~ /}/ {inloc=0}
' "$NG" | head -n1 || true)"
[ -n "${PORT:-}" ] || { say "ERREUR: port backend introuvable pour /wolverine/api"; exit 1; }
say "BACKEND PORT (nginx): $PORT"

PID="$(ss -ltnp 2>/dev/null | grep -E ":$PORT[[:space:]]" | head -n1 | sed -n 's/.*pid=\([0-9]\+\).*/\1/p' || true)"
[ -n "${PID:-}" ] || { say "ERREUR: aucun process n'écoute sur $PORT"; exit 1; }
say "PID: $PID"

CWD="$(readlink -f "/proc/$PID/cwd" 2>/dev/null || true)"
[ -n "${CWD:-}" ] || { say "ERREUR: impossible de lire cwd du PID"; exit 1; }
say "CWD: $CWD"

say "Test health:"
curl -sS "https://fireinners.online/wolverine/api/health" || true
echo

askyn "Continuer (création keypair custodial si absente + création /wolverine/api/config)?"

mkdir -p "$OUTDIR" "$CUSTDIR"
chmod 700 "$OUTDIR" "$CUSTDIR"

# Trouver keypair existante: priorite KEYFILE, sinon cherche dans CWD
KEY=""
if [ -f "$KEYFILE" ]; then KEY="$KEYFILE"; fi
if [ -z "$KEY" ]; then
  KEY="$(find "$CWD" -maxdepth 4 -type f \( -name '*keypair*.json' -o -name '*wallet*.json' -o -name '*.key' -o -name '*.json' \) 2>/dev/null | head -n1 || true)"
fi

# Si pas de key, on en crée une officielle
if [ -z "${KEY:-}" ] || [ ! -f "${KEY:-/nope}" ]; then
  say "Aucune keypair trouvée -> création: $KEYFILE"
  ( cd "$CWD" 2>/dev/null || true
    node - <<'JS'
const fs=require('fs');
let Web3;
try{ Web3=require('@solana/web3.js'); }catch(e){
  console.error("ERR: @solana/web3.js introuvable depuis ce dossier. Installe-le dans le backend (npm i @solana/web3.js) ou dis-moi où il est.");
  process.exit(2);
}
const {Keypair}=Web3;
const kp=Keypair.generate();
const out=process.env.KEYFILE;
fs.writeFileSync(out, JSON.stringify(Array.from(kp.secretKey)));
console.log("CREATED_KEYPAIR", out);
console.log("BOT", kp.publicKey.toBase58());
JS
  ) || true
  KEY="$KEYFILE"
fi

[ -f "$KEY" ] || { say "ERREUR: keypair introuvable et création échouée. Dis-moi si @solana/web3.js est installé dans $CWD/node_modules."; exit 1; }
chmod 600 "$KEY" || true
say "KEYPAIR: $KEY"

# Générer config json (bot + ATA USDC)
( cd "$CWD" 2>/dev/null || true
  KEY="$KEY" OUTJSON="$OUTJSON" USDC_MINT="$USDC_MINT" TOKEN_PROGRAM="$TOKEN_PROGRAM" ASSOC_PROGRAM="$ASSOC_PROGRAM" node - <<'JS'
const fs=require('fs');
let Web3;
try{ Web3=require('@solana/web3.js'); }catch(e){
  console.error("ERR: @solana/web3.js introuvable depuis ce dossier. Installe-le dans le backend (npm i @solana/web3.js) ou dis-moi où il est.");
  process.exit(2);
}
const {PublicKey,Keypair}=Web3;
const keyPath=process.env.KEY;
const outPath=process.env.OUTJSON;
const usdcMint=process.env.USDC_MINT;
const tokenProg=process.env.TOKEN_PROGRAM;
const assocProg=process.env.ASSOC_PROGRAM;

const raw=fs.readFileSync(keyPath,'utf8').trim();
let secret;
try{ const j=JSON.parse(raw); secret=Uint8Array.from(Array.isArray(j)?j:j.secretKey); }catch(e){ console.error("ERR keypair json:",e.message); process.exit(1); }
const kp=Keypair.fromSecretKey(secret);
const bot=kp.publicKey;

function ata(mint, owner){
  const mintPk=new PublicKey(mint);
  const ownerPk=new PublicKey(owner);
  const tp=new PublicKey(tokenProg);
  const ap=new PublicKey(assocProg);
  const [pda]=PublicKey.findProgramAddressSync([ownerPk.toBuffer(), tp.toBuffer(), mintPk.toBuffer()], ap);
  return pda;
}
const botUsdcAta=ata(usdcMint, bot).toBase58();

const payload={
  ok:true,
  bot:bot.toBase58(),
  botUsdcAta,
  usdcMint,
  note:"Custodial: envoyer SOL (fees) à bot. Envoyer USDC budget à botUsdcAta. Utilise /wolverine/api/health pour état."
};
fs.writeFileSync(outPath, JSON.stringify(payload,null,2));
console.log("BOT=",payload.bot);
console.log("USDC_ATA=",payload.botUsdcAta);
JS
)

chmod 644 "$OUTJSON"

# Patch nginx (alias exact /wolverine/api/config) - gérer immutable avant écriture
IMM=0
lsattr "$NG" 2>/dev/null | grep -q ' i ' && IMM=1 || true
[ "$IMM" = "1" ] && { say "NGINX immutable -> unlock temporaire"; chattr -i "$NG" || true; }

cp -a "$NG" "$NG.bak.$(date +%s)"

if grep -q 'location = /wolverine/api/config' "$NG"; then
  say "NGINX: location /wolverine/api/config déjà présent."
else
  TMP="$(mktemp)"
  perl -0777 -pe '
    my $ins = "\n    location = /wolverine/api/config {\n        default_type application/json;\n        alias /var/lib/wolverine-config/public-config.json;\n        add_header Cache-Control \"no-store\";\n    }\n";
    if (s/(\\n\\s*location\\s+\\/wolverine\\/api[^\\n]*\\{)/$ins$1/s) { }
    else { s/(\\n\\})/$ins$1/s; }
  ' "$NG" >"$TMP"
  mv "$TMP" "$NG"
  say "NGINX: location /wolverine/api/config ajoutée."
fi

nginx -t
systemctl reload nginx

[ "$IMM" = "1" ] && { say "NGINX re-lock"; chattr +i "$NG" || true; }

say "TEST CONFIG:"
curl -sS https://fireinners.online/wolverine/api/config; echo
say "DONE."
SH
bash /tmp/MEGA_WOLVERINE_CONFIG_V2.sh
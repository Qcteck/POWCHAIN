cat >/root/WOLVERINE_FIX_SOL_BALANCE_ONLY.sh <<'BASH'
#!/usr/bin/env bash
set -e

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE FIX SOL BALANCE ONLY ==="

# backup
cp -a "$HTML" "$HTML.bak_$TS"

node <<'NODE'
const fs=require("fs");
const f="/var/www/wolverine/index.html";
let s=fs.readFileSync(f,"utf8");

if(!s.includes("getBalance(")){
  s=s.replace(
    "</script>",
`
async function refreshSolBalance(){
 if(!window.solana||!window.solana.publicKey)return;
 if(!window._solConnection){
  window._solConnection=new solanaWeb3.Connection(
   "https://api.mainnet-beta.solana.com","confirmed"
  );
 }
 const lamports=await window._solConnection.getBalance(window.solana.publicKey);
 const sol=(lamports/1e9).toFixed(6);
 const el=document.querySelector("#sol,#solBalance,[data-sol]");
 if(el) el.innerText=sol;
}

if(window.solana){
 window.solana.on("connect",()=>setTimeout(refreshSolBalance,500));
}

setInterval(()=>{
 if(window.solana&&window.solana.publicKey) refreshSolBalance();
},15000);
</script>`
  );
  fs.writeFileSync(f,s);
  console.log("✔ SOL balance logic injected");
}else{
  console.log("✔ SOL balance already present");
}
NODE

nginx -t && systemctl reload nginx
echo "✅ SOLDE SOLANA RÉTABLI — UI INTACT"
BASH

chmod +x /root/WOLVERINE_FIX_SOL_BALANCE_ONLY.sh
/root/WOLVERINE_FIX_SOL_BALANCE_ONLY.sh
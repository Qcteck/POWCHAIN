import re,sys
txt=open(sys.argv[1],'r',errors='ignore').read().splitlines()
cur=None
blocks=[]
i=0
# Track current config file from nginx -T markers
for line in txt:
    m=re.match(r'# configuration file (.+?):', line.strip())
    if m: cur=m.group(1); continue
# Parse server blocks roughly from full text by scanning per-file is hard in nginx -T.
# Instead: extract candidate config files by grepping for "server_name" & "fireinners.online" & "listen 443".
files=set()
cur=None
for line in txt:
    m=re.match(r'# configuration file (.+?):', line.strip())
    if m: cur=m.group(1); continue
    if cur and ('server_name' in line and 'fireinners.online' in line):
        files.add(cur)
    if cur and ('server_name' in line and 'fireinners.online' in line):
        pass
# choose best file: one that also contains "listen 443" near the mention
best=None
best_score=-1
for f in files:
    # score: count of listen 443 + server_name
    score=0
    cur=None
    for line in txt:
        m=re.match(r'# configuration file (.+?):', line.strip())
        if m: cur=m.group(1); continue
        if cur!=f: continue
        if 'server_name' in line and 'fireinners.online' in line: score+=10
        if re.search(r'listen\s+443', line): score+=3
        if 'ssl' in line: score+=1
    if score>best_score:
        best_score=score
        best=f
print(best or '')

set -e
cd /root

echo "=== 0) Erreur nginx actuelle (complète) ==="
nginx -t 2>&1 || true

echo
echo "=== 1) Trouve TOUTES les proxy_set_header vides (valeur manquante) ==="
# match: proxy_set_header <NAME> ;
grep -RIn --line-number --color=always -E 'proxy_set_header[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;' \
  /etc/nginx/nginx.conf /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null | head -n 200 || true

echo
echo "=== 2) Backup des vhosts (on patch surtout fireinners) ==="
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  cp -v "$f" "$f.bak.$(date +%Y%m%d_%H%M%S)"
done

echo
echo "=== 3) Patch: remplace proxy_set_header vides (même si 2 sur une ligne) ==="
for f in /etc/nginx/nginx.conf /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  echo "PATCH $f"

  # Host
  perl -pi -e 's/\bproxy_set_header\s+Host\s*;\s*/proxy_set_header Host $host;\n/g' "$f"
  # X-Real-IP
  perl -pi -e 's/\bproxy_set_header\s+X-Real-IP\s*;\s*/proxy_set_header X-Real-IP $remote_addr;\n/g' "$f"
  # X-Forwarded-For
  perl -pi -e 's/\bproxy_set_header\s+X-Forwarded-For\s*;\s*/proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n/g' "$f"
  # X-Forwarded-Proto
  perl -pi -e 's/\bproxy_set_header\s+X-Forwarded-Proto\s*;\s*/proxy_set_header X-Forwarded-Proto $scheme;\n/g' "$f"
done

echo
echo "=== 4) Re-scan (il ne doit plus rien rester) ==="
grep -RIn -E 'proxy_set_header[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;' \
  /etc/nginx/nginx.conf /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl 2>/dev/null || true

echo
echo "=== 5) nginx -t + reload ==="
nginx -t
systemctl reload nginx
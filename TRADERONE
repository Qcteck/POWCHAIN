cat >/root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V1.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027

TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v python3 >/dev/null 2>&1 || die "python3 missing"
command -v curl >/dev/null 2>&1 || die "curl missing"

DOMAIN="fireinners.online"
WEBROOT="/var/www/aquila_stacking"
# Expose BOTH paths to the same WEBROOT (fixes /iaaquila/ 404)
PATH_A="/aquila_stacking/"
PATH_B="/iaaquila/"

INC="/etc/nginx/includes/aquila_stacking_routes.inc"
BK="/root/AQUILA_STACKING_WEBROUTE_FIX_BK_${TS}"
mkdir -p "$BK"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "aquila_stacking web routes" || { rm -f "$tmp"; die "askorupdate_file failed for $path"; }
    rm -f "$tmp"
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(echo "$path" | sed 's#/#_#g').bak" || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}

say "1) Ensure WEBROOT + index.html"
mkdir -p "$WEBROOT"
chmod 0755 "$WEBROOT" || true
chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true

APP="/opt/aquila_stacking"
PROG="aquila_stacking"
PID_LOCAL="UNKNOWN"
PID_DEV="UNKNOWN"
PID_MAIN="UNKNOWN"
if command -v solana-keygen >/dev/null 2>&1; then
  [ -f "$APP/target/deploy/${PROG}-keypair.json" ] && PID_LOCAL="$(solana-keygen pubkey "$APP/target/deploy/${PROG}-keypair.json" 2>/dev/null || echo UNKNOWN)"
  [ -f "$APP/keys/${PROG}-devnet-keypair.json" ] && PID_DEV="$(solana-keygen pubkey "$APP/keys/${PROG}-devnet-keypair.json" 2>/dev/null || echo UNKNOWN)"
  [ -f "$APP/keys/${PROG}-mainnet-keypair.json" ] && PID_MAIN="$(solana-keygen pubkey "$APP/keys/${PROG}-mainnet-keypair.json" 2>/dev/null || echo UNKNOWN)"
fi

cat >"$WEBROOT/index.html"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><style>body{font-family:system-ui,Segoe UI,Arial;margin:24px;max-width:980px}code{background:#0b1020;color:#d7e3ff;padding:2px 6px;border-radius:6px}pre{background:#0b1020;color:#d7e3ff;padding:12px;border-radius:10px;overflow:auto}a{color:#2b6fff;text-decoration:none}a:hover{text-decoration:underline}.box{border:1px solid #e5e7eb;border-radius:12px;padding:14px;margin:12px 0}</style></head><body><h1>AquilaStacking</h1><div class="box"><b>Public URLs</b><div>• <a href="${PATH_A}">${PATH_A}</a></div><div>• <a href="${PATH_B}">${PATH_B}</a></div></div><div class="box"><b>Program IDs</b><pre>localnet: ${PID_LOCAL}
devnet : ${PID_DEV}
mainnet: ${PID_MAIN}</pre></div><div class="box"><b>Workspace</b><div><code>${APP}</code></div><div><b>Webroot</b> <code>${WEBROOT}</code></div><div><b>Domain</b> <code>${DOMAIN}</code></div></div></body></html>
EOF
chown www-data:www-data "$WEBROOT/index.html" 2>/dev/null || true
chmod 0644 "$WEBROOT/index.html" || true

say "2) Write nginx include (routes)"
ROUTES="### AQUILA_STACKING_ROUTES_BEGIN
location = ${PATH_A%/} { return 301 ${PATH_A}; }
location ^~ ${PATH_A} {
  alias ${WEBROOT}/;
  index index.html;
  add_header Cache-Control \"no-store\" always;
  try_files \$uri \$uri/ /index.html =404;
}
location = ${PATH_B%/} { return 301 ${PATH_B}; }
location ^~ ${PATH_B} {
  alias ${WEBROOT}/;
  index index.html;
  add_header Cache-Control \"no-store\" always;
  try_files \$uri \$uri/ /index.html =404;
}
### AQUILA_STACKING_ROUTES_END"
write_file "$INC" "$ROUTES"

say "3) Patch active nginx configs serving ${DOMAIN} (443) to include routes (idempotent)"
nginx -T >"$BK/nginx_T.txt" 2>&1 || { cp -a /var/log/nginx/error.log "$BK/" 2>/dev/null || true; die "nginx -T failed"; }

python3 - <<'PY'
import re, os, sys, shutil, datetime
BK=os.environ["BK"]
DOMAIN=os.environ["DOMAIN"]
INC=os.environ["INC"]
T=open(os.path.join(BK,"nginx_T.txt"),"r",errors="ignore").read()

# collect files referenced in nginx -T output
files=[]
for m in re.finditer(r"^# configuration file (.+?):", T, flags=re.M):
    p=m.group(1).strip()
    if p.startswith("/"):
        files.append(p)
# prefer enabled vhosts + conf.d
prio=[]
def score(p):
    s=0
    if "/etc/nginx/sites-enabled/" in p: s+=50
    if "/etc/nginx/conf.d/" in p: s+=40
    if "fireinners" in p: s+=30
    if "ssl" in p: s+=10
    return -s
files=sorted(set(files), key=score)

def patch_file(path):
    try:
        txt=open(path,"r",errors="ignore").read()
    except:
        return False, "unreadable"
    if "AQUILA_STACKING_ROUTES_BEGIN" in txt and INC in txt:
        return True, "already"
    # find server blocks containing server_name DOMAIN and listening 443 (or ssl)
    # naive but deterministic insertion: add include inside that server block after the opening line
    out=[]
    i=0
    n=len(txt)
    changed=False

    # tokenize by characters to track braces; parse server blocks
    pattern=re.compile(r"\bserver\s*\{", re.I)
    for m in pattern.finditer(txt):
        pass

    # manual scan
    idx=0
    while True:
        m=pattern.search(txt, idx)
        if not m:
            out.append(txt[idx:])
            break
        out.append(txt[idx:m.start()])
        # find matching closing brace for this server block
        start=m.start()
        brace_pos=txt.find("{", m.end()-1)
        if brace_pos==-1:
            out.append(txt[m.start():])
            break
        depth=0
        j=brace_pos
        while j<n:
            c=txt[j]
            if c=="{": depth+=1
            elif c=="}":
                depth-=1
                if depth==0:
                    end=j+1
                    break
            j+=1
        else:
            out.append(txt[m.start():])
            break
        block=txt[start:end]
        idx=end

        # checks
        if re.search(rf"\bserver_name\b[^;]*\b{re.escape(DOMAIN)}\b", block) and re.search(r"\blisten\b[^;]*\b443\b", block):
            if INC not in block:
                # insert include near top of server block (after first newline following '{')
                k=block.find("{")
                k2=block.find("\n", k)
                if k2==-1: k2=k+1
                insert=f"\n    include {INC};\n"
                block=block[:k2+1]+insert+block[k2+1:]
                changed=True
        out.append(block)

    newtxt="".join(out)
    if changed:
        b=os.path.join(BK, os.path.basename(path)+".bak")
        shutil.copy2(path, b)
        # try unlock immutability (best effort)
        try:
            os.system(f"chattr -i {path} 2>/dev/null || true")
        except: pass
        open(path,"w").write(newtxt)
        return True, "patched"
    return True, "no-match"

patched=[]
for p in files:
    ok,st=patch_file(p)
    if ok and st in ("patched","already"):
        patched.append((p,st))

# write report
rep=os.path.join(BK,"patched_files.txt")
with open(rep,"w") as f:
    for p,st in patched:
        f.write(f"{st}\t{p}\n")

print("patched_count=",len(patched))
PY

say "4) nginx test + reload"
nginx -t
systemctl reload nginx

say "5) Local HTTPS verify (no DNS dependency)"
curl -k -sS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_B}" | head -n 3 || true
curl -k -sS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_A}" | head -n 3 || true

say "DONE"
say "Open: https://${DOMAIN}${PATH_B}"
say "Open: https://${DOMAIN}${PATH_A}"
say "INC: $INC"
say "WEBROOT: $WEBROOT"
say "BK: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V1.sh
BK="/root/AQUILA_STACKING_WEBROUTE_FIX_BK_$(date +%Y%m%d_%H%M%S)" DOMAIN="fireinners.online" INC="/etc/nginx/includes/aquila_stacking_routes.inc" bash /root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V1.sh
bash -lc 'set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/TRADERONE_HEART_${TS}.log"
OUT="/root/TRADERONE_HEART_${TS}"
mkdir -p "$OUT"
exec > >(tee -a "$LOG") 2>&1

say(){ echo; echo "== $* =="; }

WEBROOT="/var/www/wolverine"
HOST="fireinners.online"
API_LOCAL="http://127.0.0.1:3000"
API_PUBLIC="https://${HOST}/wolverine/traderone/api"
SAVE_HEART="/root/traderone_heart.txt"

say "0) Quick context"
hostnamectl 2>/dev/null | sed -n "1,6p" || true
date || true
id || true

say "1) Who is listening (80/443/3000) + process cwd"
ss -lntp | egrep "(:80|:443|:3000)\b" || true

PID3000="$(ss -lntp 2>/dev/null | awk "/:3000[[:space:]]/ && /users:/ {gsub(/.*pid=/,\"\",\$0); gsub(/,.*/,\"\",\$0); print \$0; exit}")"
echo "PID3000=${PID3000:-none}"

if [ -n "${PID3000:-}" ] && [ -d "/proc/$PID3000" ]; then
  echo "-- /proc/$PID3000/cmdline --"
  tr "\0" " " < "/proc/$PID3000/cmdline" || true; echo
  echo "-- /proc/$PID3000/cwd --"
  readlink -f "/proc/$PID3000/cwd" || true
  echo "-- /proc/$PID3000/exe --"
  readlink -f "/proc/$PID3000/exe" || true
  echo "-- ps --"
  ps -fp "$PID3000" || true
  echo "-- env hints --"
  (strings "/proc/$PID3000/environ" 2>/dev/null | egrep -i "NODE_ENV|PORT|TRADER|WOLVERINE|RPC|SECRET|KEY|TOKEN" | head -n 80) || true
fi

say "2) Find TraderOne code on disk (package.json / server.js / index.js / app.js)"
CANDS=(
  "/opt/traderone"
  "/opt/traderone-opt"
  "/opt/traderone-vault"
  "/opt/wolverine"
  "/opt/fireinners"
  "/root/traderone"
  "/root/wolverine"
)
> "$OUT/candidates.txt"
for d in "${CANDS[@]}"; do [ -d "$d" ] && echo "$d" >> "$OUT/candidates.txt"; done
cat "$OUT/candidates.txt" || true

find_hit(){ local base="$1" pat="$2"; find "$base" -maxdepth 6 -type f -name "$pat" 2>/dev/null | head -n 50; }

> "$OUT/backend_files.txt"
for d in $(cat "$OUT/candidates.txt" 2>/dev/null || true); do
  echo "## $d" >> "$OUT/backend_files.txt"
  find_hit "$d" "package.json" >> "$OUT/backend_files.txt" || true
  find_hit "$d" "server.js" >> "$OUT/backend_files.txt" || true
  find_hit "$d" "index.js" >> "$OUT/backend_files.txt" || true
  find_hit "$d" "app.js" >> "$OUT/backend_files.txt" || true
  find "$d" -maxdepth 6 -type f -iname "*trader*one*" 2>/dev/null | head -n 50 >> "$OUT/backend_files.txt" || true
done
sed -n "1,260p" "$OUT/backend_files.txt" || true

say "3) Determine backend ENTRY (best guess)"
HEART=""
if [ -n "${PID3000:-}" ] && [ -d "/proc/$PID3000" ]; then
  HEART="$(readlink -f "/proc/$PID3000/cwd" 2>/dev/null || true)"
fi
if [ -z "$HEART" ]; then
  HEART="$(awk "NF{print;exit}" "$OUT/backend_files.txt" | sed "s#/package.json##" || true)"
fi
echo "HEART_DIR=$HEART" | tee "$SAVE_HEART"

if [ -n "$HEART" ] && [ -f "$HEART/package.json" ]; then
  say "3.1) HEART package.json (scripts/main)"
  node -e "const p=require(\"$HEART/package.json\"); console.log(JSON.stringify({name:p.name,main:p.main,scripts:p.scripts},null,2));" 2>/dev/null || true
fi

say "4) Live API checks (local + public)"
curl -sS -i "$API_LOCAL/health" | head -n 60 || true
curl -sS -i "$API_PUBLIC/health" | head -n 60 || true
curl -sS -i "$API_PUBLIC/ping" | head -n 60 || true

say "5) Frontend currently served (/var/www/wolverine/index.html) + detect STUB"
test -f "$WEBROOT/index.html" && { ls -la "$WEBROOT/index.html"; head -n 40 "$WEBROOT/index.html" | sed "s/\t/  /g"; } || echo "MISSING $WEBROOT/index.html"
STUB="0"
if [ -f "$WEBROOT/index.html" ] && grep -qiE "UI stub|Coming soon|Not connected" "$WEBROOT/index.html"; then STUB="1"; fi
echo "FRONT_STUB=$STUB"

say "6) Try to locate REAL Wolverine static export on VPS"
# Search for a directory containing /wolverine/_next/static OR out/_next/static OR .next/static (built/exported)
REAL=""
for base in /opt/wolverine /opt/fireinners/frontend-react/app/dist/wolverine /opt/fireinners/frontend-react/app/dist /var/www/wolverine /opt/fireinners /root; do
  [ -d "$base" ] || continue
  # exported next: out/_next/static
  hit="$(find "$base" -maxdepth 4 -type d -path "*/_next/static" 2>/dev/null | head -n 1 || true)"
  if [ -n "$hit" ]; then
    # root is parent of _next
    root="$(dirname "$(dirname "$hit")")"
    # root might be .../out or .../wolverine
    if [ -f "$root/index.html" ]; then REAL="$root"; break; fi
  fi
done
echo "REAL_FRONT_ROOT=$REAL"

say "7) If stub -> deploy REAL if found (safe backup first)"
if [ "$STUB" = "1" ] && [ -n "$REAL" ] && [ -d "$REAL" ]; then
  BK="/root/WOLVERINE_FRONT_BAK_${TS}"
  mkdir -p "$BK"
  if [ -d "$WEBROOT" ]; then tar -czf "$BK/webroot_${TS}.tgz" -C "$WEBROOT" . 2>/dev/null || true; fi

  # keep vendor folder if present in target (user wants local solana libs)
  mkdir -p "$WEBROOT"
  rsync -a --delete --exclude "vendor/" "$REAL/" "$WEBROOT/"
  if [ -d "$REAL/vendor" ]; then
    mkdir -p "$WEBROOT/vendor"
    rsync -a "$REAL/vendor/" "$WEBROOT/vendor/"
  fi

  echo "DEPLOYED_REAL_FRONT_FROM=$REAL" | tee "$OUT/deploy_result.txt"
fi

say "8) If still stub and /opt/wolverine is a repo -> attempt build/export (best-effort)"
if [ "$STUB" = "1" ] && [ -d "/opt/wolverine/.git" ]; then
  cd /opt/wolverine
  echo "-- git status --"; git status --porcelain=v1 || true
  echo "-- git pull --"; git pull --rebase || true

  if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 && [ -f package.json ]; then
    node -v || true; npm -v || true
    SCRIPTS="$(node -e "const p=require(\"./package.json\"); console.log(Object.keys(p.scripts||{}).join(\" \"));" 2>/dev/null || true)"
    echo "SCRIPTS=$SCRIPTS"

    # install only if node_modules missing
    if [ ! -d node_modules ] && [ -f package-lock.json ]; then
      npm ci || true
    fi

    # build
    if echo " $SCRIPTS " | grep -q " build "; then npm run build || true; fi

    # export (preferred) or next export
    EXPORTED=""
    if echo " $SCRIPTS " | grep -q " export "; then
      npm run export && EXPORTED="1" || true
    fi
    # common alt: next export via npm run export already; if not, try npx next export
    if [ -z "$EXPORTED" ] && command -v npx >/dev/null 2>&1; then
      (npx next export -o out && EXPORTED="1") || true
    fi

    # deploy if out exists
    if [ -d out ] && [ -f out/index.html ]; then
      BK="/root/WOLVERINE_FRONT_BAK_${TS}_FROM_BUILD"
      mkdir -p "$BK"
      tar -czf "$BK/webroot_${TS}.tgz" -C "$WEBROOT" . 2>/dev/null || true
      rsync -a --delete --exclude "vendor/" "out/" "$WEBROOT/"
      echo "DEPLOYED_FROM=/opt/wolverine/out" | tee -a "$OUT/deploy_result.txt"
    fi
  fi
fi

say "9) Nginx quick test + tail errors"
nginx -t || true
systemctl reload nginx || systemctl restart nginx || true
curl -sS -I "https://${HOST}/wolverine/" | head -n 30 || true
tail -n 80 /var/log/nginx/error.log 2>/dev/null || true

say "10) Final outputs"
echo "LOG=$LOG"
echo "OUTDIR=$OUT"
echo "HEART_SAVED=$SAVE_HEART"
ls -ლა "$OUT" 2>/dev/null || true
echo "DONE"'
cat >/root/FIREINNERS_WALLET_USDC_SOLRPC_MEGA.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/backup_fireinners_wallet_usdc_solrpc_${TS}"
mkdir -p "$BK"

WALLET_HTML="/opt/fireinners/frontend-react/app/dist/wallet/index.html"
ROOT_HTML="/opt/fireinners/frontend-react/app/dist/index.html"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/fireinners-solrpc-proxy.conf"

PROXY_DIR="/opt/fireinners/solrpc-proxy"
PROXY_HOST="127.0.0.1"
PROXY_PORT="12703"
PROXY_SVC="/etc/systemd/system/fireinners-solrpc-proxy.service"

WF_DIR="/opt/fireinners/solrpc-proxy"
WF_CANON="$WF_DIR/wallet_v1_solrpc.html"
WF_SH="$WF_DIR/walletfix.sh"
WF_SVC="/etc/systemd/system/fireinners-walletfix.service"
WF_TMR="/etc/systemd/system/fireinners-walletfix.timer"

need_root(){ [ "$(id -u)" = "0" ] || { echo "ERR: run as root"; exit 1; }; }
have(){ command -v "$1" >/dev/null 2>&1; }

is_immutable(){
  local f="$1"
  [ -e "$f" ] || return 1
  lsattr "$f" 2>/dev/null | awk '{print $1}' | grep -q 'i'
}
unlock(){
  local f="$1"
  [ -e "$f" ] || return 0
  if is_immutable "$f"; then chattr -i "$f" 2>/dev/null || true; fi
}
lock(){
  local f="$1"
  [ -e "$f" ] || return 0
  chattr +i "$f" 2>/dev/null || true
}

echo "=== FIREINNERS WALLET USDC SOLRPC :: MEGA (safe) ==="
need_root
have node || { echo "ERR: node missing"; exit 1; }
have nginx || true

echo "[0] Backup"
[ -f "$WALLET_HTML" ] && cp -a "$WALLET_HTML" "$BK/index.html.wallet.bak" || true
[ -f "$ROOT_HTML" ] && cp -a "$ROOT_HTML" "$BK/index.html.root.bak" || true
[ -f "$VHOST" ] && cp -a "$VHOST" "$BK/vhost.bak" || true
[ -f "$SNIP" ] && cp -a "$SNIP" "$BK/snippet.bak" || true

echo "[1] Install/Update solrpc proxy app"
mkdir -p "$PROXY_DIR"
cat >"$PROXY_DIR/server.js" <<'JS'
"use strict";
const express=require("express");
const app=express();

const HOST=process.env.HOST||"127.0.0.1";
const PORT=parseInt(process.env.PORT||"12703",10);
const JSON_LIMIT=process.env.JSON_LIMIT||"10mb";
const TIMEOUT_MS=parseInt(process.env.TIMEOUT_MS||"12000",10);

const UPSTREAMS=(process.env.UPSTREAMS||[
  "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",
  "https://api.mainnet-beta.solana.com",
  "https://solana-rpc.publicnode.com",
  "https://rpc.ankr.com/solana"
].join(",")).split(",").map(s=>s.trim()).filter(Boolean);

app.use((req,res,next)=>{
  res.setHeader("Access-Control-Allow-Origin","*");
  res.setHeader("Access-Control-Allow-Methods","GET,POST,OPTIONS");
  res.setHeader("Access-Control-Allow-Headers","Content-Type,Authorization");
  if(req.method==="OPTIONS") return res.status(204).end();
  next();
});
app.use(express.json({limit:JSON_LIMIT}));

app.get("/ping",(req,res)=>res.json({ok:true,ts:Date.now(),upstreams:UPSTREAMS.length}));
app.post(["/","/rpc"], async (req,res)=>{
  const body=req.body;
  const errors=[];
  for(const u of UPSTREAMS){
    try{
      const ctrl=new AbortController();
      const t=setTimeout(()=>ctrl.abort(), TIMEOUT_MS);
      const r=await fetch(u,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body),signal:ctrl.signal});
      clearTimeout(t);
      const txt=await r.text();
      if(!r.ok) throw new Error("HTTP "+r.status+" "+txt.slice(0,200));
      let j;
      try{ j=JSON.parse(txt); }catch(e){ throw new Error("Bad JSON"); }
      if(j && j.error){
        // erreurs fréquentes type "Temporary internal error" -> on failover
        throw new Error("RPC "+JSON.stringify(j.error).slice(0,240));
      }
      res.status(200).type("application/json").send(txt);
      return;
    }catch(e){
      errors.push({upstream:u,err:String(e).slice(0,260)});
      continue;
    }
  }
  res.status(502).json({ok:false,errors});
});
app.use((req,res)=>res.status(404).json({ok:false,err:"not found"}));

app.listen(PORT,HOST,()=>console.log("solrpc proxy on "+HOST+":"+PORT+" upstreams="+UPSTREAMS.length));
JS

cat >"$PROXY_SVC" <<EOF
[Unit]
Description=FireInners Solana JSON-RPC proxy (CORS-safe, failover)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOST=${PROXY_HOST}
Environment=PORT=${PROXY_PORT}
Environment=JSON_LIMIT=10mb
Environment=TIMEOUT_MS=12000
ExecStart=/usr/bin/node ${PROXY_DIR}/server.js
Restart=always
RestartSec=2
User=root
WorkingDirectory=${PROXY_DIR}

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now fireinners-solrpc-proxy.service
systemctl restart fireinners-solrpc-proxy.service || true

echo "[2] Nginx snippet + include in vhost (handles chattr +i)"
mkdir -p "$(dirname "$SNIP")"
cat >"$SNIP" <<EOF
# FIREINNERS_SOLRPC_SNIPPET_v1
location /solrpc/ {
  proxy_pass http://${PROXY_HOST}:${PROXY_PORT}/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_connect_timeout 15s;
  proxy_read_timeout 60s;
}
EOF

if [ -f "$VHOST" ]; then
  if ! grep -q "fireinners-solrpc-proxy.conf" "$VHOST"; then
    unlock "$VHOST"
    python3 - "$VHOST" "$SNIP" <<'PY'
import sys, pathlib
v=pathlib.Path(sys.argv[1])
snip=sys.argv[2]
txt=v.read_text()
inc=f"include {snip};"
if inc in txt: 
  sys.exit(0)
# insère avant la dernière accolade fermante
i=txt.rfind("}")
if i<0: 
  raise SystemExit("ERR: cannot find closing brace in vhost")
new=txt[:i].rstrip()+"\n\n    "+inc+"\n}\n"
v.write_text(new)
PY
    lock "$VHOST"
  fi
fi

nginx -t
systemctl reload nginx


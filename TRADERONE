<script>
/* ===== Config ===== */
const RPC=\"https://api.mainnet-beta.solana.com\";
const DBK=\"AIAQUILA_DB_V2\";

/* ===== DB ===== */
const now=()=>Date.now();
const load=()=>{try{return JSON.parse(localStorage.getItem(DBK)||\"null\")}catch(e){return null}};
const save=(d)=>localStorage.setItem(DBK,JSON.stringify(d));

let DB=load()||{
  arm:false,
  kill:false,
  cooldownSec:10,
  lastActionAt:0,
  pending:null,        // {id, dest, lamports, createdAt}
  sentLog:[],          // [{t,sig,dest,lamports,slot,finalized}]
  quota:{windowMs:10*60*1000,maxTx:3}, // 3 tx / 10 minutes
  allowlist:[],
  logs:[]
};
save(DB);

/* ===== UI ===== */
const \$=id=>document.getElementById(id);
function log(msg,type){
  const line=`[${new Date().toISOString()}] ${type||\"INFO\"} ${msg}`;
  DB.logs.push(line);
  if(DB.logs.length>200) DB.logs=DB.logs.slice(-200);
  save(DB);
  render();
}
function render(){
  \$(\"chipRPC\").textContent=\"RPC:mainnet\";
  \$(\"chipARM\").textContent=\"ARM:\"+(DB.arm?\"ON\":\"OFF\");
  \$(\"chipPOL\").textContent=\"POLICY:\"+(DB.kill?\"KILL\":\"OK\");
  \$(\"chipST\").textContent=\"STATE:\"+(DB.pending?\"PENDING\":\"IDLE\");
  \$(\"log\").textContent=DB.logs.slice(-120).join(\"\\n\");
  \$(\"lam\").value=String((DB.pending&&DB.pending.lamports)||1000000);
  \$(\"cool\").value=String(DB.cooldownSec||0);
  \$(\"allow\").value=(DB.allowlist||[]).join(\"\\n\");
  \$(\"quotaLine\").textContent=`${DB.quota.maxTx} tx / ${(DB.quota.windowMs/60000)|0} min`;
  \$(\"killLine\").textContent=DB.kill?\"ON\":\"OFF\";
}
render();

/* ===== Phantom / web3 ===== */
let provider=null;
let pubkey=null;

function providerOk(){
  if(!window.solana || !window.solana.isPhantom) return false;
  return true;
}

async function connect(){
  if(!providerOk()) throw new Error(\"Phantom requis\");
  provider=window.solana;
  const r=await provider.connect();
  pubkey=r.publicKey.toString();
  \$(\"chipWAL\").textContent=\"WALLET:ON\";
  \$(\"walletLine\").textContent=pubkey;
  log(\"Wallet connecté: \"+pubkey);
}

async function disconnect(){
  try{ if(provider && provider.disconnect) await provider.disconnect(); }catch(e){}
  provider=null; pubkey=null;
  \$(\"chipWAL\").textContent=\"WALLET:OFF\";
  \$(\"walletLine\").textContent=\"Déconnecté\";
  log(\"Wallet déconnecté\");
}

/* ===== Policy ===== */
function parseAllowlist(txt){
  return txt.split(/\\r?\\n/).map(s=>s.trim()).filter(Boolean);
}
function inAllowlist(dest){
  const a=(DB.allowlist||[]).map(s=>s.trim());
  return a.includes(dest.trim());
}
function quotaCount(){
  const w=DB.quota.windowMs;
  const t0=now()-w;
  return (DB.sentLog||[]).filter(x=>x.t>=t0).length;
}
function cooldownOk(){
  const cd=(DB.cooldownSec||0)*1000;
  return (now()- (DB.lastActionAt||0)) >= cd;
}

/* ===== Buttons ===== */
\$(\"btnConnect\").onclick=async()=>{ try{ await connect(); }catch(e){ log(e.message||String(e),\"ERR\"); alert(e.message||String(e)); } };
\$(\"btnDisconnect\").onclick=async()=>{ await disconnect(); };

\$(\"btnARM\").onclick=()=>{ DB.arm=true; save(DB); log(\"ARM ON\"); render(); };
\$(\"btnDISARM\").onclick=()=>{ DB.arm=false; save(DB); log(\"ARM OFF\"); render(); };

\$(\"btnKill\").onclick=()=>{ DB.kill=true; save(DB); log(\"KILL-SWITCH ON\",\"WARN\"); render(); };
\$(\"btnUnkill\").onclick=()=>{ DB.kill=false; save(DB); log(\"KILL-SWITCH OFF\"); render(); };

\$(\"btnSavePolicy\").onclick=()=>{
  DB.allowlist=parseAllowlist(\$(\"allow\").value);
  save(DB);
  log(\"Policy sauvegardée: allowlist=\"+DB.allowlist.length);
};
\$(\"btnLoadPolicy\").onclick=()=>{ render(); log(\"Policy rechargée\"); };

\$(\"btnRefresh\").onclick=()=>{ render(); log(\"Refresh\"); };
\$(\"btnClear\").onclick=()=>{ DB.logs=[]; save(DB); render(); };

\$(\"btnPropose\").onclick=()=>{
  try{
    if(DB.kill) throw new Error(\"KILL-SWITCH actif\");
    if(!DB.arm) throw new Error(\"ARM requis\");
    if(!provider||!pubkey) throw new Error(\"Wallet requis\");
    if(DB.pending) throw new Error(\"Déjà PENDING (rejeter ou signer)\");
    DB.cooldownSec=parseInt(\$(\"cool\").value||\"0\",10)||0;

    const dest=(\$(\"dest\").value||\"\").trim();
    const lamports=parseInt(\$(\"lam\").value||\"0\",10);
    if(!dest) throw new Error(\"Destination requise\");
    if(!Number.isFinite(lamports) || lamports<=0) throw new Error(\"Lamports invalides\");
    if(!inAllowlist(dest)) throw new Error(\"Destination hors allowlist\");
    if(quotaCount()>=DB.quota.maxTx) throw new Error(\"Quota dépassé\");
    if(!cooldownOk()) throw new Error(\"Cooldown actif\");
    // Validate pubkeys (throws if invalid)
    new solanaWeb3.PublicKey(dest);
    new solanaWeb3.PublicKey(pubkey);

    const pid=\"p_\"+Math.random().toString(16).slice(2)+\"_\"+Date.now();
    DB.pending={id:pid,dest,lamports,createdAt:now()};
    save(DB);
    log(`Proposition OK -> ${dest} + ${lamports} lamports (id ${pid})`);
  }catch(e){
    log(e.message||String(e),\"ERR\");
    alert(e.message||String(e));
  }
};

\$(\"btnReject\").onclick=()=>{
  if(DB.pending){ log(\"Proposition rejetée: \"+DB.pending.id,\"WARN\"); DB.pending=null; save(DB); render(); }
  else log(\"Aucune proposition à rejeter\",\"WARN\");
};

let busy=false;

\$(\"btnApprove\").onclick=async()=>{
  if(busy) return;
  busy=true;
  try{
    if(DB.kill) throw new Error(\"KILL-SWITCH actif\");
    if(!DB.arm) throw new Error(\"ARM requis\");
    if(!provider||!pubkey) throw new Error(\"Wallet requis\");
    if(!DB.pending) throw new Error(\"Aucune proposition (PROPOSE d\\x27abord)\");
    if(!cooldownOk()) throw new Error(\"Cooldown actif\");
    if(quotaCount()>=DB.quota.maxTx) throw new Error(\"Quota dépassé\");
    if(!inAllowlist(DB.pending.dest)) throw new Error(\"Destination hors allowlist\");

    const conn=new solanaWeb3.Connection(RPC,{commitment:\"confirmed\"});
    const from=new solanaWeb3.PublicKey(pubkey);
    const to=new solanaWeb3.PublicKey(DB.pending.dest);

    // Blockhash
    const bh=await conn.getLatestBlockhash(\"confirmed\");

    const tx=new solanaWeb3.Transaction({
      feePayer: from,
      recentBlockhash: bh.blockhash
    }).add(
      solanaWeb3.SystemProgram.transfer({
        fromPubkey: from,
        toPubkey: to,
        lamports: DB.pending.lamports
      })
    );

    log(\"Signature demandée à Phantom…\");
    let signed;
    try{
      signed=await provider.signTransaction(tx);
    }catch(e){
      throw new Error(\"User reject / signTransaction failed\");
    }

    log(\"Envoi TX…\");
    let sig;
    try{
      sig=await conn.sendRawTransaction(signed.serialize(),{skipPreflight:false,maxRetries:3});
    }catch(e){
      throw new Error(\"sendRawTransaction failed (RPC/down/rate-limit)\");
    }

    log(\"Confirmations… (finalized)\");
    const conf=await conn.confirmTransaction({signature:sig,blockhash:bh.blockhash,lastValidBlockHeight:bh.lastValidBlockHeight},\"finalized\");
    if(conf && conf.value && conf.value.err) throw new Error(\"finalized err: \"+JSON.stringify(conf.value.err));

    DB.lastActionAt=now();
    DB.sentLog.push({t:now(),sig,dest:DB.pending.dest,lamports:DB.pending.lamports,finalized:true});
    if(DB.sentLog.length>50) DB.sentLog=DB.sentLog.slice(-50);

    log(\"TX FINALIZED: \"+sig);
    DB.pending=null;
    save(DB);
    render();
  }catch(e){
    log(e.message||String(e),\"ERR\");
    alert(e.message||String(e));
  }finally{
    busy=false;
  }
};

/* ===== Init ===== */
(function init(){
  \$(\"chipNET\").textContent=\"NET:mainnet\";
  \$(\"dest\").value=(DB.allowlist && DB.allowlist[0])?DB.allowlist[0]:\"\";

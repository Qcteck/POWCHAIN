cat >/root/check_public_assets.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="${1:-fireinners.online}"

echo "== Public checks via Cloudflare =="

echo "-- /wolverine/ (should be 200) --"
curl -sSI "https://${DOMAIN}/wolverine/" | head -n 12
echo

# Récupère un asset réel depuis le HTML
HTML="$(curl -s "https://${DOMAIN}/wolverine/" | head -c 400000)"
ASSET="$(printf "%s" "$HTML" | grep -oE '/wolverine/_next/[^"]+\.(js|css)' | head -n 1 || true)"

echo "-- /wolverine/_next/ (directory; 403 OK) --"
curl -sSI "https://${DOMAIN}/wolverine/_next/" | head -n 12
echo

if [[ -z "$ASSET" ]]; then
  echo "[WARN] Aucun asset /wolverine/_next/...(.js/.css) trouvé dans le HTML."
  exit 0
fi

echo "Asset detected: $ASSET"
echo "-- asset file (should be 200 or 304) --"
curl -sSI "https://${DOMAIN}${ASSET}" | head -n 15
BASH

chmod +x /root/check_public_assets.sh
/root/check_public_assets.sh fireinners.online
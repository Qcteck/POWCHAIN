set -e

echo "=== 1) Vérifier ce que /wolverine sert actuellement ==="
ls -lah /var/www
echo
ls -lah /var/www/wolverine || echo "/var/www/wolverine absent"

echo
echo "=== 2) Forcer nginx à servir /var/www/wolverine pour /wolverine ==="

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.wolverine_fix"

python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# Supprimer anciens blocs /wolverine (sans toucher /wolverine/traderone/api)
s = re.sub(r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}', '', s)
s = re.sub(r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}', '', s)

block = r'''
# --- WOLVERINE UI ---
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/ {
    root /var/www;
    index index.html;
    try_files $uri $uri/ /wolverine/index.html;
}
'''

i = s.rfind("}")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("Bloc nginx injecté")
PY

nginx -t
systemctl reload nginx

echo
echo "=== 3) Test ==="
curl -LsS https://fireinners.online/wolverine/ | head -n 5
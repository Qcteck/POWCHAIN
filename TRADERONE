HTML
  chmod 0644 "$INDEX"
else
  say "index exists: $INDEX (no-op)"
fi
hr

# -----------------------------
# 2) Patch include: remove duplicates then add ONE managed block
# -----------------------------
say "2) Patch include (dedupe any /aquilatrader blocks) -> $INC"

python3 - <<'PY'
import re, sys, pathlib

inc_path = pathlib.Path("/etc/nginx/includes/wolverine_static.inc")
txt = inc_path.read_text(encoding="utf-8", errors="replace").splitlines(True)

def drop_managed_markers(lines):
  out=[]
  skip=False
  for ln in lines:
    if re.search(r'^\s*#\s*BEGIN\s+AQUILATRADER_MANAGED\b', ln):
      skip=True
      continue
    if re.search(r'^\s*#\s*END\s+AQUILATRADER_MANAGED\b', ln):
      skip=False
      continue
    if not skip:
      out.append(ln)
  return out

def drop_location_aquilatrader(lines):
  """
  Remove any nginx 'location ... /aquilatrader' blocks (manual or partial),
  including location = /aquilatrader and location ^~ /aquilatrader/
  """
  out=[]
  i=0
  n=len(lines)

  # match location headers that mention /aquilatrader
  loc_re = re.compile(r'^\s*location\s+(.+?)\s*\{\s*$')

  def header_is_aquilatrader(h):
    # normalize multiple spaces
    h = " ".join(h.strip().split())
    # examples:
    # location = /aquilatrader {
    # location ^~ /aquilatrader/ {
    # location /aquilatrader {
    return "/aquilatrader" in h

  while i<n:
    ln=lines[i]
    m=loc_re.match(ln)
    if m and header_is_aquilatrader(ln):
      # skip this whole block by brace depth
      depth=0
      # consume header line
      # count braces in header line
      depth += ln.count("{") - ln.count("}")
      i += 1
      while i<n and depth>0:
        depth += lines[i].count("{") - lines[i].count("}")
        i += 1
      continue
    else:
      out.append(ln)
      i += 1
  return out

clean = drop_managed_markers(txt)
clean = drop_location_aquilatrader(clean)

managed = r'''
# BEGIN AQUILATRADER_MANAGED
location = /aquilatrader { return 301 /aquilatrader/; }

location ^~ /aquilatrader/ {
  alias /var/www/aquilatrader/;
  try_files $uri $uri/ /aquilatrader/index.html;
  add_header Cache-Control "no-store" always;
}
# END AQUILATRADER_MANAGED
'''.lstrip("\n")

# ensure file ends with newline
if clean and not clean[-1].endswith("\n"):
  clean[-1] += "\n"

# append managed block
if clean and not clean[-1].endswith("\n"):
  clean.append("\n")
clean.append("\n" + managed.strip("\n") + "\n")

inc_path.write_text("".join(clean), encoding="utf-8")
print("OK: cleaned + wrote single /aquilatrader managed block ->", str(inc_path))
PY

hr

# -----------------------------
# 3) nginx -t then reload (rollback on failure)
# -----------------------------
say "3) nginx -t then reload"
set +e
nginx -t
RC=$?
set -e
if [ "$RC" -ne 0 ]; then
  say "nginx -t FAILED -> rollback backups"
  cp -a "$BK/$(basename "$VHOST").bak" "$VHOST" || true
  cp -a "$BK/$(basename "$INC").bak"   "$INC"   || true
  nginx -t || true
  die "Rollback done. Fix not applied. Check: $BK and $LOG"
fi

systemctl reload nginx
hr

# -----------------------------
# 4) Quick checks
# -----------------------------
say "4) Quick local checks (Host header)"
curl -sk "https://127.0.0.1/aquilatrader/" -H "Host: ${DOMAIN}" | head -n 20 || true
hr
say "DONE. Open: https://${DOMAIN}/aquilatrader/"
say "Log:  ${LOG}"
say "BK:   ${BK}"
BASH

chmod +x /root/MEGA_AQUILATRADER_FIX_V2.sh
bash /root/MEGA_AQUILATRADER_FIX_V2.sh
function mkdirp(p){try{fs.mkdirSync(p,{recursive:true});}catch{}}
function readJSON(p,def){try{return JSON.parse(fs.readFileSync(p,"utf8"));}catch{return def}}
function writeJSON(p,obj,mode){mkdirp(path.dirname(p));fs.writeFileSync(p,JSON.stringify(obj,null,2));try{fs.chmodSync(p,mode||0o600);}catch{}}
function now(){return Date.now()}
function sh(cmd){try{require("child_process").execSync(cmd,{stdio:"ignore"});return true}catch{return false}}
function tg(msg){if(!TG_ALERTS) return; if(fs.existsSync(WOLV_SEND)) sh(`${WOLV_SEND} ${JSON.stringify(msg)}`)}
function b58(x){return new PublicKey(x).toBase58()}

function loadKeypair(){
  try{
    if(fs.existsSync(KEYPAIR_FILE)){
      const a=readJSON(KEYPAIR_FILE,null); if(!a||!Array.isArray(a)) throw new Error("bad keypair");
      return Keypair.fromSecretKey(Uint8Array.from(a));
    }
  }catch(e){}
  const kp=Keypair.generate();
  writeJSON(KEYPAIR_FILE,Array.from(kp.secretKey),0o600);
  tg(`WOLVERINE: KEYPAIR CREATED ${kp.publicKey.toBase58()}`);
  return kp;
}
const BOT_KP=loadKeypair();
const BOT_PK=BOT_KP.publicKey;

const state=readJSON(STATE_FILE,{users:{},engine:{running:false,mode:"dca_sol_safe",intervalSec:30,owner:"",tokenMint:"",lastTick:0,lastTx:"",startedAt:0}});
function saveState(){writeJSON(STATE_FILE,state,0o600)}

function getUser(owner){
  const k=b58(owner);
  if(!state.users[k]) state.users[k]={credit_usdc:0,credit_sol:0,spent_usdc:0,spent_sol:0,profit_usdc:0,profit_sol:0,lastClaimSig:"",createdAt:now(),updatedAt:now()};
  state.users[k].updatedAt=now();
  return state.users[k];
}

async function getSol(pk){return await conn.getBalance(pk,"confirmed")}
async function getUsdcAta(ownerPk){
  const ata=await getAssociatedTokenAddress(USDC_MINT,ownerPk,false,TOKEN_PROGRAM_ID,ASSOCIATED_TOKEN_PROGRAM_ID);
  return ata;
}
async function getTokenBal(ata){
  try{
    const r=await conn.getTokenAccountBalance(ata,"confirmed");
    return BigInt(r.value.amount||"0");
  }catch{return 0n}
}
function uiToBaseUnits(amountUi,decimals){ // string/number -> bigint
  const s=String(amountUi||"0").trim();
  if(!/^\d+(\.\d+)?$/.test(s)) return 0n;
  const [a,b=""]=s.split(".");
  const frac=(b+"0".repeat(decimals)).slice(0,decimals);
  return BigInt(a||"0")*BigInt(10**decimals)+BigInt(frac||"0");
}
function baseUnitsToUi(bi,decimals){
  bi=BigInt(bi||0);
  const sign=bi<0n?"-":"";
  if(bi<0n) bi=-bi;
  const p=10n**BigInt(decimals);
  const i=(bi/p).toString();
  let f=(bi%p).toString().padStart(decimals,"0").replace(/0+$/,"");
  return sign+(f?`${i}.${f}`:i);
}

async function ensureAtaIx(payer,owner,mint){
  const ata=await getAssociatedTokenAddress(mint,owner,false,TOKEN_PROGRAM_ID,ASSOCIATED_TOKEN_PROGRAM_ID);
  const info=await conn.getAccountInfo(ata,"confirmed");
  if(info) return {ata,ix:null};
  return {ata,ix:createAssociatedTokenAccountInstruction(payer,ata,owner,mint,TOKEN_PROGRAM_ID,ASSOCIATED_TOKEN_PROGRAM_ID)};
}

async function sendSol(toPk,lamports){
  const tx=new Transaction().add(SystemProgram.transfer({fromPubkey:BOT_PK,toPubkey:toPk,lamports:Number(lamports)}));
  const sig=await conn.sendTransaction(tx,[BOT_KP],{skipPreflight:false,maxRetries:3});
  await conn.confirmTransaction(sig,"confirmed");
  return sig;
}

async function sendUsdc(toPk,amountBase){ // amountBase bigint (6 dec)
  const {ata:fromAta,ix:ixFrom}=await ensureAtaIx(BOT_PK,BOT_PK,USDC_MINT);
  const {ata:toAta,ix:ixTo}=await ensureAtaIx(BOT_PK,toPk,USDC_MINT);
  const tx=new Transaction();
  if(ixFrom) tx.add(ixFrom);
  if(ixTo) tx.add(ixTo);
  tx.add(createTransferInstruction(fromAta,toAta,BOT_PK,Number(amountBase),[],TOKEN_PROGRAM_ID));
  const sig=await conn.sendTransaction(tx,[BOT_KP],{skipPreflight:false,maxRetries:3});
  await conn.confirmTransaction(sig,"confirmed");
  return sig;
}

async function jupSwap(inputMint,outputMint,amountBase,slippageBps=50){
  const url=JUP_QUOTE+`?inputMint=${inputMint}&outputMint=${outputMint}&amount=${amountBase.toString()}&slippageBps=${slippageBps}`;
  const q=await fetch(url,{headers:{"accept":"application/json"}});
  if(!q.ok) throw new Error("quote_failed");
  const quote=await q.json();
  if(!quote||!quote.routePlan) throw new Error("quote_empty");

  const s=await fetch(JUP_SWAP,{method:"POST",headers:{"content-type":"application/json","accept":"application/json"},body:JSON.stringify({
    quoteResponse:quote,
    userPublicKey:BOT_PK.toBase58(),
    wrapAndUnwrapSol:true,
    useSharedAccounts:true,
    dynamicComputeUnitLimit:true,
    prioritizationFeeLamports:"auto"
  })});
  if(!s.ok) throw new Error("swap_failed");
  const swap=await s.json();
  if(!swap||!swap.swapTransaction) throw new Error("swap_no_tx");

  const raw=Buffer.from(swap.swapTransaction,"base64");
  const {VersionedTransaction}=require("@solana/web3.js");
  const vtx=VersionedTransaction.deserialize(raw);
  vtx.sign([BOT_KP]);
  const sig=await conn.sendRawTransaction(vtx.serialize(),{skipPreflight:false,maxRetries:3});
  await conn.confirmTransaction(sig,"confirmed");
  return sig;
}

async function parseClaimTx(sig,ownerStr){
  const owner=new PublicKey(ownerStr);
  const tx=await conn.getTransaction(sig,{maxSupportedTransactionVersion:0,commitment:"confirmed"});
  if(!tx||!tx.transaction) throw new Error("tx_not_found");
  const msg=tx.transaction.message;
  const acctKeys=msg.accountKeys.map(k=>k.pubkey?k.pubkey:k); // v0 compat
  const ownerOk=acctKeys.some(k=>k.toBase58&&k.toBase58()===owner.toBase58()) || acctKeys.some(k=>String(k)===owner.toBase58());
  const botOk=acctKeys.some(k=>k.toBase58&&k.toBase58()===BOT_PK.toBase58()) || acctKeys.some(k=>String(k)===BOT_PK.toBase58());
  if(!ownerOk||!botOk) throw new Error("not_related");

  // Detect SOL transfer to BOT (system program)
  let solToBot=0n;
  try{
    const pre=tx.meta?.preBalances||[];
    const post=tx.meta?.postBalances||[];
    for(let i=0;i<acctKeys.length;i++){
      const k=acctKeys[i].toBase58?acctKeys[i].toBase58():String(acctKeys[i]);
      if(k===BOT_PK.toBase58()){
        const d=BigInt(post[i]||0)-BigInt(pre[i]||0);
        if(d>0n) solToBot+=d;
      }
    }
  }catch{}

  // Detect USDC transfer to BOT via token balance deltas on BOT ATA
  let usdcToBot=0n;
  try{
    const botAta=(await getUsdcAta(BOT_PK)).toBase58();
    const preTB=tx.meta?.preTokenBalances||[];
    const postTB=tx.meta?.postTokenBalances||[];
    const preMap=new Map(); const postMap=new Map();
    for(const b of preTB){ if(b.mint===USDC_MINT.toBase58() && b.owner===BOT_PK.toBase58()) preMap.set(b.accountIndex,BigInt(b.uiTokenAmount?.amount||"0")); }
    for(const b of postTB){ if(b.mint===USDC_MINT.toBase58() && b.owner===BOT_PK.toBase58()) postMap.set(b.accountIndex,BigInt(b.uiTokenAmount?.amount||"0")); }
    for(const [idx,postAmt] of postMap){
      const preAmt=preMap.get(idx)||0n;
      const d=postAmt-preAmt;
      if(d>0n) usdcToBot+=d;
    }
    // fallback: if token balances arrays not include owner, try by token account in inner instructions (best-effort)
  }catch{}

  if(solToBot===0n && usdcToBot===0n) throw new Error("no_deposit_detected");
  return {solToBot,usdcToBot};
}

const loops=new Map(); // owner -> timer
async function tick(ownerStr){
  const owner=b58(ownerStr);
  const u=getUser(owner);
  if(!state.engine.running || state.engine.owner!==owner) return;

  const mode=state.engine.mode||"dca_sol_safe";
  const intervalSec=Math.max(10,+(state.engine.intervalSec||30));
  state.engine.lastTick=now();

  // sanity: don't trade if credits empty
  const creditUsdc=BigInt(u.credit_usdc||0);
  const creditSol=BigInt(u.credit_sol||0);

  try{
    if(mode==="dca_sol_safe"){
      // Buy SOL with USDC: spend a small slice each tick (2% of credit, min 1 USDC, max 25 USDC)
      const slicePct=0.02;
      let spend=BigInt(Math.floor(Number(creditUsdc)*slicePct));
      const min=1_000_000n, max=25_000_000n;
      if(spend<min) spend=min;
      if(spend>max) spend=max;
      if(creditUsdc<spend) throw new Error("no_usdc_credit");
      const sig=await jupSwap(USDC_MINT.toBase58(),"So11111111111111111111111111111111111111112",spend,50);
      u.credit_usdc=(creditUsdc-spend).toString();
      u.spent_usdc=(BigInt(u.spent_usdc||0)+spend).toString();
      state.engine.lastTx=sig;
      tg(`WOLVERINE: TRADE OK dca_sol_safe spend ${baseUnitsToUi(spend,6)} USDC tx ${sig}`);
      saveState();
      return;
    }

    if(mode==="buy_token"){
      const mint=String(state.engine.tokenMint||"").trim();
      if(!mint) throw new Error("missing_tokenMint");
      // Buy token with USDC: one-shot (all credit up to 50 USDC cap)
      let spend=BigInt(u.credit_usdc||0);
      const cap=50_000_000n;
      if(spend>cap) spend=cap;
      if(spend<=0n) throw new Error("no_usdc_credit");
      const sig=await jupSwap(USDC_MINT.toBase58(),mint,spend,75);
      u.credit_usdc=(BigInt(u.credit_usdc||0)-spend).toString();
      u.spent_usdc=(BigInt(u.spent_usdc||0)+spend).toString();
      state.engine.lastTx=sig;
      tg(`WOLVERINE: TRADE OK buy_token spend ${baseUnitsToUi(spend,6)} USDC mint ${mint} tx ${sig}`);
      state.engine.running=false; // one-shot stop
      saveState();
      return;
    }

    throw new Error("unknown_mode");
  }catch(e){
    tg(`WOLVERINE: TRADE ERR ${String(e&&e.message||e)}`);
    saveState();
  }finally{
    // re-arm next tick
    if(state.engine.running && state.engine.owner===owner){
      const t=setTimeout(()=>tick(owner).catch(()=>{}),intervalSec*1000);
      loops.set(owner,t);
    }
  }
}


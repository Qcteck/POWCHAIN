#!/usr/bin/env bash
set -euo pipefail

DIST="/opt/fireinners/frontend-react/app/dist"
MAIN_HTML="$DIST/index.html"
WALLET_DIR="$DIST/wallet"
WALLET_HTML="$WALLET_DIR/index.html"

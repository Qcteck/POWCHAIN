cat >/root/fix_wallet_ui_status_and_balances.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/var/www/wolverine"
JS="$ROOT/phantom_patch.js"

ts="$(date +%Y%m%d_%H%M%S)"
mkdir -p "$ROOT"

# backup si existe
if [[ -f "$JS" ]]; then
  cp -a "$JS" "${JS}.bak_${ts}"
  echo "[OK] Backup -> ${JS}.bak_${ts}"
fi

cat >"$JS" <<'JS'
(function () {
  const RPC = "https://api.mainnet-beta.solana.com";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
  const REFRESH_MS = 15000;

  const short = (s) => (s ? s.slice(0, 4) + "…" + s.slice(-4) : "");

  async function rpc(method, params) {
    const r = await fetch(RPC, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }),
    });
    const j = await r.json();
    if (j.error) throw new Error(j.error.message || JSON.stringify(j.error));
    return j.result;
  }

  async function fetchBalances(owner) {
    const bal = await rpc("getBalance", [owner, { commitment: "confirmed" }]);
    const sol = (bal.value || 0) / 1e9;

    const tok = await rpc("getTokenAccountsByOwner", [
      owner,
      { mint: USDC_MINT },
      { encoding: "jsonParsed", commitment: "confirmed" },
    ]);

    let usdc = 0;
    for (const acc of (tok.value || [])) {
      const amt = acc.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
      if (typeof amt === "number") usdc += amt;
    }

    return { sol, usdc };
  }

  // ---- UI helpers (fix ton bug) ----
  function findWalletCard() {
    // Cherche la carte qui contient "Wallet" + le bouton Connect Phantom
    const cards = Array.from(document.querySelectorAll("div,section,aside"));
    for (const c of cards) {
      const t = (c.textContent || "").toLowerCase();
      if (t.includes("wallet") && t.includes("connect phantom")) return c;
      if (t.includes("wallet") && t.includes("not connected")) return c;
    }
    return null;
  }

  function updateWalletCardConnected(pk, sol, usdc) {
    const card = findWalletCard();
    if (!card) return;

    // 1) Remplace "Not connected" si trouvé
    const nodes = Array.from(card.querySelectorAll("*"));
    const statusNode = nodes.find(n => /not connected/i.test((n.textContent || "").trim()));
    if (statusNode) statusNode.textContent = "Connected";

    // 2) Bouton "Connect Phantom" -> "Connected" + disable
    const btn = Array.from(card.querySelectorAll("button,a,div,span"))
      .find(n => /connect phantom/i.test((n.textContent || "").trim()));
    if (btn) {
      btn.textContent = "Connected";
      btn.style.pointerEvents = "none";
      btn.style.opacity = "0.8";
    }

    // 3) Ajoute ligne balances dans la carte Wallet
    let bal = card.querySelector("#__wallet_bal_line");
    if (!bal) {
      bal = document.createElement("div");
      bal.id = "__wallet_bal_line";
      bal.style.cssText = "margin-top:8px;font:12px system-ui;opacity:.95";
      card.appendChild(bal);
    }
    bal.textContent = `SOL: ${sol.toFixed(4)} | USDC: ${usdc.toFixed(2)} | ${short(pk)}`;
  }

  // Overlay bas droite (optionnel mais utile)
  function ensureOverlay() {
    let el = document.getElementById("__wallet_overlay");
    if (el) return el;
    el = document.createElement("div");
    el.id = "__wallet_overlay";
    el.style.cssText =
      "position:fixed;right:16px;bottom:16px;z-index:99999;" +
      "background:rgba(0,0,0,.85);color:#fff;padding:10px 12px;" +
      "border-radius:10px;font:12px/1.35 system-ui;max-width:80vw;white-space:pre-line";
    el.textContent = "Patch loaded — searching button…";
    document.body.appendChild(el);
    return el;
  }
  function setOverlay(msg) { ensureOverlay().textContent = msg; }

  async function refreshAll() {
    const pk = window.solana?.publicKey?.toBase58?.() || window.__WALLET_PK__;
    if (!pk) return;

    try {
      const { sol, usdc } = await fetchBalances(pk);
      setOverlay(`Connected: ${short(pk)}\nSOL ${sol.toFixed(4)} | USDC ${usdc.toFixed(2)}`);
      updateWalletCardConnected(pk, sol, usdc);
    } catch (e) {
      console.error(e);
      setOverlay(`Connected: ${short(pk)}\nBalance: RPC error`);
    }
  }

  async function connect() {
    if (!window.solana || !window.solana.isPhantom) {
      setOverlay("Phantom introuvable.\n➡️ Ouvre le site dans Phantom Browser.");
      return;
    }
    const r = await window.solana.connect();
    const pk = r.publicKey.toBase58();
    window.__WALLET_PK__ = pk;
    await refreshAll();
  }

  function hookConnectButton() {
    // Ton UI a un bouton "Connect Phantom"
    const nodes = Array.from(document.querySelectorAll("button,a,div,span"));
    const btn = nodes.find(n => /connect phantom/i.test((n.textContent || "").trim()));
    if (btn && !btn.__hooked_phantom) {
      btn.__hooked_phantom = true;
      btn.addEventListener("click", (ev) => {
        ev.preventDefault();
        connect().catch(err => {
          console.error(err);
          setOverlay("Connect error");
        });
      }, { passive: false });
    }
  }

  window.addEventListener("load", () => {
    ensureOverlay();
    hookConnectButton();

    // si déjà connecté
    if (window.solana?.isPhantom && window.solana.publicKey) {
      window.__WALLET_PK__ = window.solana.publicKey.toBase58();
      refreshAll();
    }

    // observe DOM (pages settings etc)
    const obs = new MutationObserver(() => hookConnectButton());
    obs.observe(document.documentElement, { childList: true, subtree: true });

    // refresh auto
    setInterval(refreshAll, REFRESH_MS);

    window.solana?.on?.("accountChanged", (pubkey) => {
      if (pubkey) {
        window.__WALLET_PK__ = pubkey.toBase58();
        refreshAll();
      } else {
        setOverlay("Wallet: not connected");
      }
    });
  });

  window.__WALLET_PATCH_LOADED__ = true;
})();
JS

echo "[OK] Patched $JS"

# Inject le script dans toutes les pages html sous /var/www/wolverine (si pas déjà)
echo "[*] Inject script tag into HTML pages (if missing)…"
while IFS= read -r -d '' f; do
  if ! grep -q "phantom_patch.js" "$f"; then
    cp -a "$f" "${f}.bak_${ts}"
    perl -0777 -i -pe '
      my $tag = qq{\n<!-- WALLET_BALANCES_PATCH -->\n<script src="/wolverine/phantom_patch.js?v='"$ts"'" defer></script>\n<!-- /WALLET_BALANCES_PATCH -->\n};
      s@(<head[^>]*>)@$1$tag@i;
    ' "$f"
    echo "  + injected -> $f"
  fi
done < <(find "$ROOT" -maxdepth 4 -type f -name "*.html" -print0)

nginx -t
systemctl reload nginx
echo "✅ OK. Test: https://fireinners.online/wolverine/settings/?v=$ts"
BASH

chmod +x /root/fix_wallet_ui_status_and_balances.sh
/root/fix_wallet_ui_status_and_balances.sh
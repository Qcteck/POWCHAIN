      S.article.tags = detectTags(it.title, "");
      S.article.sent = sentiment(it.title, "");
      S.article.summary = "• (Article non lu: CAP ARTICLE OFF)\n• Basé sur le titre seulement.";
      S.article.q = 15;
      S.article.paywall = false;
      save(); renderStates();
      logExperiment({domain:S.article.domain, q:S.article.q, ok:false});
      startConversation();
      return;
    }

    S.state.mode = "ARTICLE_READ"; save(); renderStates();
    add("SYS","Lecture article…","sys");

    let raw = "";
    try{
      raw = await fetchText(it.link);
    }catch(e){
      pushErr("Article fetch fail");
      S.state.mode = "DISCUSS"; save(); renderStates();
      // fallback title-only
      S.article.text = "";
      S.article.tags = detectTags(it.title, "");
      S.article.sent = sentiment(it.title, "");
      S.article.summary = "• (Article bloqué)\n• Basé sur le titre seulement.";
      S.article.q = 20;
      S.article.paywall = true;
      save(); renderStates();
      logExperiment({domain:S.article.domain, q:S.article.q, ok:false});
      startConversation();
      return;
    }

    const ex = extractMainText(raw, it.link);
    S.article.text = ex.text || "";
    S.article.q = ex.q || 0;
    S.article.paywall = !!ex.paywall;
    S.article.domain = ex.domain || S.article.domain || "";

    S.article.tags = detectTags(it.title, S.article.text);
    S.article.sent = sentiment(it.title, S.article.text);
    S.article.summary = summarize(S.article.text);

    // confidence adjust
    if(S.article.q < 35) S.state.confidence = Math.max(90, S.state.confidence - 1.5);
    else if(S.article.q >= 75) S.state.confidence = Math.min(99.4, S.state.confidence + 0.3);

    S.state.mode = "DISCUSS"; save(); renderStates();
    logExperiment({domain:S.article.domain, q:S.article.q, ok:S.article.q>=45 && !S.article.paywall});
    startConversation();
  };

  const addRuleWithConfirm = (ruleText) => {
    if(!S.caps.learn){
      add("AI","CAP APPRENDRE est OFF. Active-le si tu veux mémoriser des règles.","warn");
      return;
    }
    openConfirm({
      title: "APPRENTISSAGE • AJOUT RÈGLE",
      meta: "Action: ajouter une règle locale (confirmé par toi)",
      body: `Règle proposée:\n${ruleText}\n\nConfirmer => j’ajoute la règle.`,
      onYes: () => {
        S.learn.rules.push(ruleText);
        save();
        add("SYS","Règle ajoutée.","sys");
      },
      onNo: () => add("SYS","Règle refusée.","sys"),
      onAlt: () => add("AI","Alternative: je n’ajoute rien et je continue la discussion.","ai"),
      altLabel: "CONTINUER"
    });
  };

  const renderQuick = () => {
    // Always visible actions (1 click)
    quickBtns([
      {t:"DÉCISION", f:()=>decideNext()},
      {t:"ARTICLE WEB", f:()=>generateWebArticle()},
      {t:"X POST", f:()=>openConfirm({
        title:"X • POST (SANS API)",
        meta:"Action: générer + copier + ouvrir X",
        body:"Confirmer => je génère un post basé sur l’article et je te le copie, puis j’ouvre X.",
        onYes: async()=>{ const txt=buildXPost("X_THREAD"); await copyToClipboard(txt); xIntent(txt); },
        onNo: ()=>add("SYS","Refusé.","sys"),
        onAlt: ()=>xDepositPost(),
        altLabel:"DEMANDE DÉPÔT"
      })},
      {t:"DEMANDE DÉPÔT", f:()=>xDepositPost()},
      {t:"ANNONCE TOKEN", f:()=>xTokenAnnouncement()},
      {t:"PUMP.FUN", f:()=>pumpfunChecklist()},
      {t:"PHANTOM CONNECT", f:()=>phantomConnect()},
      {t:"PROCHAIN TITRE", f:()=>nextPick()},
      {t:"AJOUTER RÈGLE", f:()=>addRuleWithConfirm("Filtrer RSS: prioriser Macro + Sécurité; ignorer Q<35 et paywall probable.")}
    ]);
  };

  const handle = async (v) => {
    const s = String(v||"").trim();
    if(!s) return;
    add("Utilisateur", s, "user");

    const L = s.toLowerCase();

    if(L==="oui"){
      add("AI","OK. Je propose une décision maintenant.","ai");
      decideNext();
      return;
    }
    if(L==="non"){
      add("AI","OK. Question (1): prochain titre ou article web?","ai");
      quickBtns([
        {t:"PROCHAIN TITRE", f:()=>nextPick()},
        {t:"ARTICLE WEB", f:()=>generateWebArticle()},
        {t:"X POST", f:()=>executeDecision("X_THREAD")},
        {t:"PUMP.FUN", f:()=>pumpfunChecklist()}
      ]);
      return;
    }

    if(L==="decision" || L==="décision"){ decideNext(); return; }
    if(L==="next" || L==="prochain"){ nextPick(); return; }
    if(L==="pump"){ pumpfunChecklist(); return; }
    if(L==="phantom"){ phantomConnect(); return; }
    if(L==="x"){ executeDecision("X_THREAD"); return; }

    // numeric pick
    if(/^(?:[1-9]|1[0-2])$/.test(L)){
      const i = parseInt(L,10)-1;
      await choose(i);
      return;
    }

    add("AI", sarcasm(
      "Reçu. Pour avancer vite: utilise un bouton (c’est littéralement le but).",
      "Reçu. Utilise un bouton."
    ), "ai");
  };

  // wire UI
  $("#send").onclick = () => { const v=inEl.value; inEl.value=""; handle(v); };
  inEl.addEventListener("keydown", e => {
    if(e.key==="Enter"){ e.preventDefault(); const v=inEl.value; inEl.value=""; handle(v); }
  });

  $("#btnNext").onclick = () => nextPick();
  $("#btnReset").onclick = () => { localStorage.removeItem(KEY); location.reload(); };

  $("#btnVoice").onclick = () => {
    S.prefs.voice = !S.prefs.voice;
    if(!audioUnlocked){ audioUnlocked = true; localStorage.setItem("jarvis_audio_unlocked","true"); }
    save();
    $("#btnVoice").textContent = "VOIX " + (S.prefs.voice ? "ON" : "OFF");
    add("SYS","Voix: " + (S.prefs.voice ? "ON" : "OFF"), "sys");
    speak(S.prefs.voice ? "Voix activée." : "Voix désactivée.");
  };

  // caps
  capBtns.rss.onclick = ()=>toggleCap("rss");
  capBtns.article.onclick = ()=>toggleCap("article");
  capBtns.decision.onclick = ()=>toggleCap("decision");
  capBtns.learn.onclick = ()=>toggleCap("learn");
  capBtns.wallet.onclick = ()=>toggleCap("wallet");
  capBtns.pump.onclick = ()=>toggleCap("pump");
  capBtns.x.onclick = ()=>toggleCap("x");

  // boot
  load();
  renderCaps();
  renderStates();
  renderRSS();
  renderQuick();

  setInterval(()=>renderStates(), 750);
  window.addEventListener("online", renderStates);
  window.addEventListener("offline", renderStates);

  add("SYS","Boot. Je lis un RSS + un article, puis je commence la discussion.","sys");
  loadRSS();

})();
</script>
</body>
</html>
cat >/root/fix_traderone_api_auto.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
API_UPSTREAM="${API_UPSTREAM:-}"   # optionnel: ex "http://127.0.0.1:3000"
CANDIDATE_PORTS="${CANDIDATE_PORTS:-3000 3001 8080 8000 5000 4000 5173}"

ts="$(date +%Y%m%d_%H%M%S)"
echo "[*] DOMAIN=$DOMAIN"
echo "[*] VHOST=$VHOST"
[[ -f "$VHOST" ]] || { echo "[ERR] vhost introuvable: $VHOST"; exit 1; }

# 1) Auto-detect upstream if not provided
if [[ -z "$API_UPSTREAM" ]]; then
  # try to pick a listening port from a known list
  PORT=""
  for p in $CANDIDATE_PORTS; do
    if ss -lntp 2>/dev/null | grep -qE "LISTEN.*:${p}\b"; then
      PORT="$p"; break
    fi
  done

  # fallback: pick first LISTEN port owned by node
  if [[ -z "$PORT" ]]; then
    PORT="$(ss -lntp 2>/dev/null | awk '
      /LISTEN/ && /node/ {
        match($4, /:([0-9]+)$/, m); if (m[1]!="") { print m[1]; exit }
      }' || true)"
  fi

  [[ -n "$PORT" ]] || {
    echo "[ERR] Aucun backend détecté. Donne la sortie de: ss -lntp | sed -n '1,160p'"
    exit 1
  }

  API_UPSTREAM="http://127.0.0.1:${PORT}"
fi

echo "[*] API_UPSTREAM=$API_UPSTREAM"

# 2) Backup
BACKDIR="/etc/nginx/sites-disabled/backup_api_proxy_${ts}"
mkdir -p "$BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
echo "[OK] Backup -> $BACKDIR/$(basename "$VHOST")"

export API_UPSTREAM

# 3) Patch (idempotent): insert proxy block before static /wolverine/ block
perl -0777 -i -pe '
my $up = $ENV{API_UPSTREAM} // die "missing API_UPSTREAM";
# remove existing injected block if present
s/\n\s*# --- traderone api proxy \(injected\) ---.*?\n\s*# --- end traderone api proxy ---\n//ms;

my $block = qq{
  # --- traderone api proxy (injected) ---
  location ^~ /wolverine/traderone/api/ {
    if (\$request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
      add_header Access-Control-Allow-Headers "Authorization,Content-Type,Accept" always;
      return 204;
    }

    proxy_pass $up/;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;

    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
  # --- end traderone api proxy ---
};

# insert before location ^~ /wolverine/
s/\n(\s*location\s+\^\~\s+\/wolverine\/\s*\{)/\n$block\n$1/ms
  or die "ERR: cannot find location ^~ /wolverine/ block to insert before\n";
' "$VHOST"

echo "[*] nginx -t"
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== Tests HTTP =="
curl -sSI "https://${DOMAIN}/wolverine/traderone/api/" | head -n 20 || true
echo
curl -sSI -X POST "https://${DOMAIN}/wolverine/traderone/api/" | head -n 20 || true
echo
echo "== Local upstream quick check =="
curl -sS "${API_UPSTREAM}/" | head -n 5 || true

echo
echo "== If still failing, last logs =="
tail -n 40 "/var/log/nginx/${DOMAIN}.error.log" 2>/dev/null || true
BASH

chmod +x /root/fix_traderone_api_auto.sh
/root/fix_traderone_api_auto.sh fireinners.online
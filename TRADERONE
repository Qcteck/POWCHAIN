bash <<'EOF'
set -e

echo "=== AIAQUILA — FIX NGINX ROOT ==="

AIA_DIR=/var/www/aiaquila
NGX_SITE=/etc/nginx/sites-available/fireinners.online-ssl

# Sécurité
if [ ! -d "$AIA_DIR" ]; then
  echo "ERREUR: $AIA_DIR n'existe pas"
  exit 1
fi

# Backup nginx
cp $NGX_SITE ${NGX_SITE}.bak.$(date +%s)

# Injecte location /aiaquila/ explicite
perl -0777 -i -pe '
s@(\s*location\s*/\s*\{[\s\S]*?\})@$1\n\nlocation /aiaquila/ {\n    alias /var/www/aiaquila/;\n    index index.html;\n    try_files \$uri \$uri/ =404;\n}\n@s
' $NGX_SITE

# Permissions
chown -R www-data:www-data /var/www/aiaquila
chmod -R 755 /var/www/aiaquila

# Test + reload
nginx -t
systemctl reload nginx

echo "=== FIX APPLIQUÉ ==="
echo "URL: https://fireinners.online/aiaquila/"
echo "CTRL+F5 OBLIGATOIRE"
EOF
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Pokémon Battle – Tournoi 8vs8</title>
<style>
html, body { margin:0; padding:0; width:100%; height:100%; font-family:Arial; background:#0b1220; color:#fff; display:flex; flex-direction:column; align-items:center; }
#controls{margin:10px}
#arena{display:flex; justify-content:center; gap:50px; width:100%; flex:1; align-items:center;}
.poke{width:25%; background:#111a33; padding:10px; border-radius:10px; display:flex; flex-direction:column; align-items:center;}
.poke img{width:100%; height:auto}
.bar{height:12px; background:#333; border-radius:6px; overflow:hidden; width:80%; margin:6px 0}
.bar span{display:block; height:100%; background:#3cff6b; transition:width .3s}
button{padding:8px 14px; margin:6px; border-radius:6px; border:none; font-weight:bold; cursor:pointer}
#log{width:90%; max-width:800px; margin:10px auto; background:#111a33; padding:10px; border-radius:8px; text-align:left; height:25%; overflow-y:auto;}
</style>
</head>
<body>

<h1>Pokémon Battle – Tournoi 8vs8</h1>

<div id="controls">
<button onclick="startTournament8vs8()">Commencer Tournoi 8vs8</button>
<button onclick="resetArena()">Réinitialiser</button>
</div>

<div id="arena" style="display:none">
  <div class="poke" id="p1"></div>
  <div class="poke" id="p2"></div>
</div>

<div id="log"></div>

<script>
const POKEMONS=[
 {name:"Pikachu",hp:100,atk:20,img:"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/25.png"},
 {name:"Bulbizarre",hp:120,atk:18,img:"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/1.png"},
 {name:"Salamèche",hp:110,atk:19,img:"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/4.png"},
 {name:"Carapuce",hp:130,atk:17,img:"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/7.png"},
 {name:"Évoli",hp:105,atk:18,img:"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/133.png"},
 {name:"Ronflex",hp:150,atk:15,img:"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/143.png"},
 {name:"Dracaufeu",hp:140,atk:22,img:"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/6.png"},
 {name:"Tortank",hp:145,atk:19,img:"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/9.png"}
];

function clone(p){return {...p,hp:p.hp,max:p.hp};}
function log(t){const l=document.getElementById('log'); l.innerHTML+=t+'<br>'; l.scrollTop=l.scrollHeight;}

function render(a,b){
 document.getElementById('arena').style.display='flex';
 document.getElementById('p1').innerHTML=`<h3>${a.name}</h3><img src="${a.img}"><div class="bar"><span style="width:${a.hp/a.max*100}%"></span></div><p>${a.hp} HP</p>`;
 document.getElementById('p2').innerHTML=`<h3>${b.name}</h3><img src="${b.img}"><div class="bar"><span style="width:${b.hp/b.max*100}%"></span></div><p>${b.hp} HP</p>`;
}

async function fight(a,b){
 log(`<b>${a.name} vs ${b.name}</b>`);
 while(a.hp>0 && b.hp>0){
  b.hp=Math.max(0,b.hp-a.atk);
  render(a,b);
  log(`${a.name} attaque (-${a.atk})`);
  await delay(600);
  if(b.hp<=0) break;
  a.hp=Math.max(0,a.hp-b.atk);
  render(a,b);
  log(`${b.name} contre-attaque (-${b.atk})`);
  await delay(600);
 }
 const win=a.hp>0?a:b;
 log(`🏆 ${win.name} gagne`);
 return win;
}

function delay(ms){return new Promise(r=>setTimeout(r,ms));}

async function startTournament8vs8(){
 document.getElementById('log').innerHTML='';
 let pool=POKEMONS.map(clone);
 while(pool.length>1){
  let a=pool.shift(), b=pool.shift();
  render(a,b);
  pool.push(await fight(a,b));
 }
 log(`🏆 VAINQUEUR FINAL : ${pool[0].name}`);
}

function resetArena(){
 document.getElementById('arena').style.display='none';
 document.getElementById('log').innerHTML='';
}
</script>
</body>
</html>

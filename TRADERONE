set -e
cd /root

echo "=== 1) Etat port 3000 ==="
ss -lptn 'sport = :3000' || true
lsof -nP -iTCP:3000 -sTCP:LISTEN || true

echo
echo "=== 2) Services systemd possibles ==="
systemctl list-units --type=service --all | egrep -i 'wolverine|traderone|node|pm2' || true

echo
echo "=== 3) PM2 list (voir si /opt/wolverine est géré par PM2) ==="
pm2 list || true

echo
echo "=== 4) Tentatives de restart (safe) ==="
systemctl restart wolverine 2>/dev/null || true
systemctl restart traderone 2>/dev/null || true
systemctl restart pm2-root 2>/dev/null || true
pm2 resurrect 2>/dev/null || true
pm2 restart all --update-env 2>/dev/null || true

sleep 1
echo
echo "=== 5) Si 3000 est toujours DOWN, start direct /opt/wolverine/server.js via PM2 ==="
if ! ss -lptn 'sport = :3000' | grep -q LISTEN; then
  if [ -f /opt/wolverine/server.js ]; then
    pm2 start /opt/wolverine/server.js --name wolverine --update-env
  else
    echo "!! /opt/wolverine/server.js introuvable. Liste /opt:"
    ls -lah /opt | head
  fi
fi

sleep 1
echo
echo "=== 6) Recheck + test backend ==="
ss -lptn 'sport = :3000' || true
curl -sS -i -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' | head -n 60 || true

echo
echo "=== 7) Logs si ça plante ==="
pm2 logs wolverine --lines 60 2>/dev/null || pm2 logs --lines 60 2>/dev/null || true
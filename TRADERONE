cat >/root/fix_api_health_proxy_autodetect.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SSL="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/traderone_api_proxy.conf"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== 0) Autodetect backend port (looking for /api/health) =="
PORT=""
for p in 3000 3001 3100 8080 8000 5000; do
  code="$(curl -s -o /tmp/h.$$ -w "%{http_code}" "http://127.0.0.1:$p/api/health" || true)"
  if [[ "$code" == "200" ]]; then
    head -c 200 /tmp/h.$$ | tr -d '\n' | grep -qiE '^\{|"status"|health|ok' && PORT="$p" && break
  fi
done
rm -f /tmp/h.$$ 2>/dev/null || true

if [[ -z "$PORT" ]]; then
  echo "[ERR] Backend introuvable sur les ports testés."
  echo "Lance ça et colle-moi la sortie :"
  echo "  ss -lntp | grep -E 'node|:3000|:3001|:3100|:8080|:8000|:5000'"
  exit 1
fi
echo "[OK] Backend found on 127.0.0.1:$PORT"

echo "== 1) Backup nginx files =="
cp -a "$SSL" "${SSL}.bak_${ts}" 2>/dev/null || true
cp -a "$SNIP" "${SNIP}.bak_${ts}" 2>/dev/null || true

echo "== 2) Write API proxy snippet (HIGH priority, beats SPA) =="
mkdir -p /etc/nginx/snippets
cat >"$SNIP" <<NGINX
# Include INSIDE server{} only.

# Exact health (must hit backend, never SPA)
location = /wolverine/traderone/api/health {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:${PORT};
}

# All API routes
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";

  rewrite ^/wolverine/traderone/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:${PORT};
}
NGINX

echo "== 3) Ensure snippet included ONCE (and before SPA fallback) =="
awk '
  {
    if ($0 ~ /include[[:space:]]+\/etc\/nginx\/snippets\/traderone_api_proxy\.conf;/) {
      if (seen==1) next;
      seen=1;
    }
    print
  }
' "$SSL" > /tmp/ssl.$$ && cat /tmp/ssl.$$ > "$SSL" && rm -f /tmp/ssl.$$

if ! grep -q "traderone_api_proxy.conf" "$SSL"; then
  # insert right after server_name line (safe, early in server{})
  sed -i '/server_name .*fireinners\.online/ a\  include /etc/nginx/snippets/traderone_api_proxy.conf;' "$SSL"
fi

ln -sf "$SSL" "$EN"

echo "== 4) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== 5) TEST local backend =="
curl -sS "http://127.0.0.1:${PORT}/api/health" | head -c 400
echo

echo
echo "== 6) TEST public (MUST NOT be HTML) =="
echo "-- headers:"
curl -sk -i "https://${DOMAIN}/wolverine/traderone/api/health" | sed -n '1,25p'
echo
echo "-- body (first 400 chars):"
curl -sk "https://${DOMAIN}/wolverine/traderone/api/health" | head -c 400
echo

echo
echo "DONE ✅"
BASH

chmod +x /root/fix_api_health_proxy_autodetect.sh
/root/fix_api_health_proxy_autodetect.sh
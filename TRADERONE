cat >/root/WOLV_FIX_405_PROXY_V3.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX="/etc/nginx/nginx.conf"
PORT="3000"

[ -f "$SITE" ] || { echo "ERR: nginx site introuvable: $SITE"; exit 1; }

# 1) Patch NGINX: /wolverine/api/* -> /api/* -> node:3000
chattr -i "$NGINX" "$SITE" 2>/dev/null || true

python3 - <<'PY'
import pathlib, re
p=pathlib.Path("/etc/nginx/sites-available/fireinners.online-ssl")
s=p.read_text(encoding="utf-8",errors="ignore")

marker="# WOLV_API_PROXY_V3"
if marker in s:
  print("OK nginx proxy déjà présent")
else:
  block=f"""
    {marker}
    location ^~ /wolverine/api/ {{
        rewrite ^/wolverine/api/(.*)$ /api/$1 break;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }}
    # END WOLV_API_PROXY_V3
"""
  # insère dans le server { ... } principal (avant le dernier '}')
  m=list(re.finditer(r'\n\s*server\s*\{', s))
  if not m:
    raise SystemExit("ERR: bloc server { introuvable dans le vhost")
  # prend le dernier server (souvent le ssl)
  start=m[-1].start()
  tail=s[start:]
  # trouve la dernière '}' de ce server (naïf mais ok ici)
  idx=tail.rfind("\n}")
  if idx==-1:
    raise SystemExit("ERR: fin de bloc server introuvable")
  tail2=tail[:idx] + "\n" + block + tail[idx:]
  s2=s[:start]+tail2
  p.write_text(s2,encoding="utf-8")
  print("OK nginx proxy installé")
PY

nginx -t
systemctl reload nginx
chattr +i "$NGINX" "$SITE" 2>/dev/null || true

# 2) Patch FRONT: enlever doublons + utiliser /wolverine/api/*

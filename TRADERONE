cat >/tmp/wolfchain_healthcheck_fly.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
H="fireinners.online"
ROOT=""
if test -f "$VHOST"; then
  ROOT=$(awk 'BEGIN{r=""} /^[ \t]*root[ \t]+/{gsub(/;$/,"",$2); if(r==""){r=$2}} END{print r}' "$VHOST" 2>/dev/null || true)
fi
test -n "${ROOT:-}" || ROOT="/opt/fireinners/frontend-react/app/dist"

echo "================ WOLFCHAIN FLY CHECK ================"
echo "date: $(date -u)"
echo "vhost: $VHOST"
echo "host : $H"
echo "root : $ROOT"
echo "-----------------------------------------------------"

echo "[1] nginx config + root exists"
test -f "$VHOST" && echo "OK: vhost file exists" || echo "WARN: vhost file missing"
test -d "$ROOT" && echo "OK: root dir exists" || { echo "ERR: root dir missing"; exit 1; }

echo
echo "[2] required pages exist"
REQ=("/index.html" "/wallet/index.html" "/dex/index.html" "/bridge/index.html" "/explorer/index.html" "/mining/index.html" "/options/index.html" "/wolverin/index.html")
for p in "${REQ[@]}"; do
  if test -f "$ROOT$p"; then
    echo "OK: $p"
  else
    echo "ERR: missing $p"
  fi
done

echo
echo "[3] permission chain (anti-403) for root + main files"
namei -l "$ROOT" 2>/dev/null || true
for p in "${REQ[@]}"; do
  f="$ROOT$p"
  test -f "$f" && (stat -c "perm %a owner %U:%G  %n" "$f" 2>/dev/null || ls -la "$f") || true
done

echo
echo "[4] content sanity (branding)"
for f in "$ROOT/index.html" "$ROOT/wolverin/index.html" "$ROOT/wallet/index.html" "$ROOT/dex/index.html"; do
  if test -f "$f"; then
    echo "--- $(basename "$(dirname "$f")")/$(basename "$f") ---"
    grep -nE "WOLFCHAIN|WOLVERIN" "$f" | head -n 20 || echo "WARN: branding strings not found in $f"
  fi
done

echo
echo "[5] local HTTPS checks via nginx (Host header)"
URLS=("/" "/wallet/" "/dex/" "/bridge/" "/explorer/" "/mining/" "/options/" "/wolverin/" "/traderone/" "/stats")
for u in "${URLS[@]}"; do
  printf "%-12s " "$u"
  # show status + content-type + location
  curl -kIs "https://127.0.0.1$u" -H "Host: $H" | awk 'BEGIN{s="";ct="";loc=""} NR==1{s=$0} /^content-type:/{ct=$0} /^location:/{loc=$0} END{print s" | "ct" | "loc}' || echo "curl ERR"
done

echo
echo "[6] /stats body (first 200 chars)"
curl -kfsS "https://127.0.0.1/stats" -H "Host: $H" | head -c 200 || echo "ERR: /stats not reachable"

echo
echo
echo "[7] backend ports listening (for real modules)"
(ss -lntp 2>/dev/null || netstat -lntp 2>/dev/null || true) | egrep -n ":(3000|4001|8484|8585)\b" || echo "NOTE: no matching ports shown (3000/4001/8484/8585)"

echo
echo "[8] nginx last errors (if available)"
tail -n 30 /var/log/nginx/error.log 2>/dev/null || echo "no nginx error.log access"

echo "====================== DONE ========================="
BASH
bash /tmp/wolfchain_healthcheck_fly.sh
"use strict";
const fs=require("fs");
const express=require("express");
const fetch=require("node-fetch");
const {Connection,PublicKey}=require("@solana/web3.js");
const spl=require("@solana/spl-token");

const BOT_PUB=new PublicKey(process.env.BOT_PUB);
const USDC_MINT=new PublicKey(process.env.USDC_MINT);
const RPC_URL=process.env.RPC_URL;
const LEDGER_FILE=process.env.LEDGER_FILE;
const API_PORT=Number(process.env.API_PORT||3002);

const conn=new Connection(RPC_URL,"confirmed");
const app=express();
app.use(express.json({limit:"256kb"}));

const n=x=>{const v=Number(x);return Number.isFinite(v)?v:0;};
const now=()=>Date.now();

function readLedger(){try{return JSON.parse(fs.readFileSync(LEDGER_FILE,"utf8")||"{}")}catch{return {users:{},deposits_seen:{}}}}
function writeLedger(L){fs.writeFileSync(LEDGER_FILE,JSON.stringify(L,null,2));}
function botUsdcAta(){ return spl.getAssociatedTokenAddressSync(USDC_MINT,BOT_PUB,false); }

function matchSolDeposit(tx,fromPub,minSol){
  if(!tx||tx.meta?.err) return null;
  const ix=tx.transaction?.message?.instructions||[];
  for(const it of ix){
    if(it?.program==="system"&&it?.parsed?.type==="transfer"){
      const info=it.parsed.info||{};
      if(info.source===fromPub && info.destination===BOT_PUB.toBase58()){
        const sol=n(info.lamports)/1e9;
        if(sol+1e-12>=minSol) return {sig:tx.transaction.signatures?.[0],amount:sol};
      }
    }
  }
  return null;
}
function matchUsdcDeposit(tx,fromPub,minUsdc){
  if(!tx||tx.meta?.err) return null;
  const dstAta=botUsdcAta().toBase58();
  const ix=tx.transaction?.message?.instructions||[];
  for(const it of ix){
    if(it?.program==="spl-token" && it?.parsed){
      const info=it.parsed.info||{};
      const dst=info.destination;
      if(dst===dstAta){
        let ui=0;
        if(info.tokenAmount && info.tokenAmount.uiAmount!=null) ui=n(info.tokenAmount.uiAmount);
        else if(info.amount) ui=n(info.amount)/1e6;
        const auth=info.authority||"";
        if(auth===fromPub && ui+1e-12>=minUsdc) return {sig:tx.transaction.signatures?.[0],amount:ui};
      }
    }
  }
  return null;
}
async function scanDeposit(pub,asset,amount){
  const fromPub=new PublicKey(pub).toBase58();
  const L=readLedger();
  if(!L.users) L.users={};
  if(!L.deposits_seen) L.deposits_seen={};

  const target=(asset==="USDC")?botUsdcAta():BOT_PUB;
  const sigs=await conn.getSignaturesForAddress(target,{limit:50});
  for(const s of sigs){
    const sig=s.signature;
    if(!sig||L.deposits_seen[sig]) continue;
    const tx=await conn.getParsedTransaction(sig,{maxSupportedTransactionVersion:0,commitment:"confirmed"});
    const hit=(asset==="SOL")?matchSolDeposit(tx,fromPub,amount):matchUsdcDeposit(tx,fromPub,amount);
    if(hit&&hit.sig){
      L.deposits_seen[hit.sig]={at:now(),pub:fromPub,asset,amount:hit.amount};
      if(!L.users[fromPub]) L.users[fromPub]={mode:"AUTO",last_deposit:null};
      L.users[fromPub].last_deposit={sig:hit.sig,asset,amount:hit.amount,at:now()};
      writeLedger(L);
      return {ok:true,sig:hit.sig,amount:hit.amount};
    }
  }
  writeLedger(L);
  return {ok:false};
}

app.get("/wolverine/api/health",(_req,res)=>res.json({ok:true}));
app.get("/wolverine/api/wolv_state",(req,res)=>{
  const pub=String(req.query.pub||"");
  const L=readLedger();
  const u=(pub && L.users && L.users[pub])?L.users[pub]:{mode:"AUTO",last_deposit:null};
  res.json({ok:true,bot_pub:BOT_PUB.toBase58(),bot_usdc_ata:botUsdcAta().toBase58(),user:u});
});
app.post("/wolverine/api/wolv_set_mode",(req,res)=>{
  const pub=String(req.body?.pub||"");
  const mode=String(req.body?.mode||"AUTO").toUpperCase().slice(0,24);
  if(!pub) return res.status(400).json({ok:false,err:"bad_params"});
  const L=readLedger(); if(!L.users) L.users={};
  if(!L.users[pub]) L.users[pub]={mode:"AUTO",last_deposit:null};
  L.users[pub].mode=mode; writeLedger(L);
  res.json({ok:true,mode});
});
app.post("/wolverine/api/wolv_confirm_deposit",async(req,res)=>{
  try{
    const pub=String(req.body?.pub||"");
    const asset=String(req.body?.asset||"USDC").toUpperCase();
    const amount=n(req.body?.amount);
    if(!pub||!["SOL","USDC"].includes(asset)||!(amount>0)) return res.status(400).json({ok:false,err:"bad_params"});
    const out=await scanDeposit(pub,asset,amount);
    res.json(out);
  }catch(e){
    res.status(500).json({ok:false,err:String(e&&e.message?e.message:e)});
  }
});

// proxy vers ton backend existant (127.0.0.1:3000) pour start etc
app.use("/wolverine/api/",async(req,res)=>{
  try{
    const sub=req.originalUrl.replace(/^\/wolverine\/api\//,"");
    const url=`http://127.0.0.1:3000/api/${sub}`;
    const headers={...req.headers}; delete headers.host;
    const body=(req.method==="GET"||req.method==="HEAD")?undefined:JSON.stringify(req.body??{});
    const r=await fetch(url,{method:req.method,headers:{...headers,"content-type":"application/json"},body});
    const txt=await r.text();
    res.status(r.status);
    try{res.json(JSON.parse(txt));}catch{res.type("text/plain").send(txt);}
  }catch(e){
    res.status(502).json({ok:false,err:"proxy_fail",detail:String(e&&e.message?e.message:e)});
  }
});

app.listen(API_PORT,"127.0.0.1",()=>console.log("wolverine-api 127.0.0.1:"+API_PORT));
JS


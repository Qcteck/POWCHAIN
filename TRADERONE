#!/usr/bin/env bash
set -e

echo "=== WOLVERINE SOL BALANCE FIX (ROOT BATCH) ==="

### 1️⃣ BACKEND BALANCES
mkdir -p /opt/wolverine-balances
cd /opt/wolverine-balances

cat > server.js <<'JS'
import express from "express";
import { Connection, PublicKey } from "@solana/web3.js";

const app = express();
const RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const conn = new Connection(RPC, "confirmed");

app.get("/balances/:pub", async (req, res) => {
  try {
    const pub = new PublicKey(req.params.pub);
    const lamports = await conn.getBalance(pub);
    res.json({ sol: lamports / 1e9 });
  } catch (e) {
    res.status(400).json({ error: e.message });
  }
});

app.listen(3010, () => console.log("BALANCES API ON 3010"));
JS

cat > package.json <<'JSON'
{ "type":"module","dependencies":{"express":"^4","@solana/web3.js":"^1.95.0"} }
JSON

npm install --silent
pkill -f server.js || true
nohup node server.js >/opt/wolverine-balances/balances.log 2>&1 &

sleep 1
ss -lnt | grep 3010 && echo "✔ Backend balances UP"

---

### 2️⃣ NGINX PROXY
NGINX_CONF="/etc/nginx/sites-available/fireinners.online-ssl"

grep -q "wolverine/api/balances" "$NGINX_CONF" || sed -i '/location \/wolverine {/a \
    location /wolverine/api/balances/ {\
        proxy_pass http://127.0.0.1:3010/balances/;\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
    }\
' "$NGINX_CONF"

nginx -t
systemctl reload nginx

echo "✔ NGINX proxy OK"

---

### 3️⃣ FRONTEND FIX
HTML="/var/www/wolverine/index.html"

sed -i 's|http://127.0.0.1:3010/balances|/wolverine/api/balances|g' "$HTML"

echo "✔ Frontend endpoint fixed"

---

echo "=== DONE ==="
echo "➡ Recharge la page /wolverine"
echo "➡ Clique Connect Phantom"
echo "➡ SOL S’AFFICHE"
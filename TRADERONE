cat >/root/WOLV_FORCE_SINGLE_DEPOT_AND_FIX_PERMS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%s)"

DIST="/opt/fireinners/frontend-react/app/dist"
WOLV="$DIST/wolverine"
mkdir -p "$WOLV"

# Trouver vhost canon (fireinners.online + listen 443)
CANON="$(python3 - <<'PY'
import re,glob,sys,os
paths=[]
paths+=glob.glob("/etc/nginx/sites-available/*")
paths+=glob.glob("/etc/nginx/conf.d/*")
def read(p):
  try: return open(p,"r",encoding="utf-8",errors="ignore").read()
  except: return ""
def server_blocks(txt):
  out=[]
  for m in re.finditer(r'(?m)^\s*server\s*\{', txt):
    i=m.start(); depth=0; j=i
    while j<len(txt):
      c=txt[j]
      if c=='{': depth+=1
      elif c=='}':
        depth-=1
        if depth==0:
          out.append((i,j+1,txt[i:j+1])); break
      j+=1
  return out
c=[]
for p in paths:
  if re.search(r'\.(bak|old|save|disabled)(\.|$)', p): 
    continue
  s=read(p)
  for a,b,t in server_blocks(s):
    if re.search(r'(?m)^\s*server_name\s+.*\bfireinners\.online\b', t):
      score=0
      if re.search(r'(?m)^\s*listen\s+443', t): score+=10
      if "ssl" in t: score+=2
      c.append((score,p))
if not c: sys.exit("ERR: vhost fireinners.online introuvable")
c.sort(reverse=True)
print(c[0][1])
PY
)"
CANON_REAL="$(readlink -f "$CANON" || echo "$CANON")"

# Déverrouille (immutable) sur tout ce qui peut bloquer (sans casser)
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$CANON" 2>/dev/null || true
for f in /etc/nginx/sites-enabled/* /etc/nginx/sites-available/* /etc/nginx/conf.d/*; do
  [ -e "$f" ] || continue
  case "$f" in
    *.bak*|*.disabled.*|*.old*|*.save*) continue;;
  esac
  chattr -i "$f" 2>/dev/null || true
done

# Désactive tous les doublons fireinners.online dans sites-enabled (sauf canon)
for f in /etc/nginx/sites-enabled/*; do
  [ -e "$f" ] || continue
  tgt="$f"; [ -L "$f" ] && tgt="$(readlink -f "$f" || echo "$f")"
  txt="$(python3 - <<PY
import sys
p=sys.argv[1]
try: print(open(p,'r',encoding='utf-8',errors='ignore').read())
except: print('')
PY
"$tgt")"
  if echo "$txt" | grep -qE '^\s*server_name\s+.*\bfireinners\.online\b'; then
    if [ "$tgt" != "$CANON_REAL" ]; then
      chattr -i "$f" 2>/dev/null || true
      if [ -L "$f" ]; then
        rm -f "$f"
      else
        mv -f "$f" "$f.disabled.$TS"
      fi
    fi
  fi
done

# Assure le lien canon
ln -sf "$CANON" "/etc/nginx/sites-enabled/$(basename "$CANON")"

# Injecte/replace le bloc Wolverine (proxy API + serve UI + no-cache)
MARK_BEGIN="# BEGIN WOLV_SINGLE_UI_V2"
MARK_END="# END WOLV_SINGLE_UI_V2"
BLOCK="$MARK_BEGIN
location ^~ /wolverine/api/ {
  proxy_pass http://127.0.0.1:3000/api/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  proxy_read_timeout 60s;
}
location = /wolverine/ {
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  return 302 /wolverine/index.html;
}
location ^~ /wolverine/ {
  alias /opt/fireinners/frontend-react/app/dist/wolverine/;
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  try_files \$uri \$uri/ /index.html;
}
$MARK_END"

python3 - "$CANON" "$MARK_BEGIN" "$MARK_END" "$BLOCK" <<'PY'
import sys,re
p,mb,me,block=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
s=open(p,"r",encoding="utf-8",errors="ignore").read()

# remove any older wolv blocks
s=re.sub(r'(?s)# BEGIN WOLV_.*?# END WOLV_.*?\n?','',s)

def server_blocks(txt):
  out=[]
  for m in re.finditer(r'(?m)^\s*server\s*\{', txt):
    i=m.start(); depth=0; j=i
    while j<len(txt):
      c=txt[j]
      if c=='{': depth+=1
      elif c=='}':
        depth-=1
        if depth==0:
          out.append((i,j+1,txt[i:j+1])); break
      j+=1
  return out

B=server_blocks(s)
c=[b for b in B if re.search(r'(?m)^\s*server_name\s+.*\bfireinners\.online\b', b[2])]
if not c: raise SystemExit("ERR: aucun server{} fireinners.online dans "+p)

pick=None
for b in c:
  if re.search(r'(?m)^\s*listen\s+443', b[2]): pick=b; break
if pick is None: pick=c[0]

a,b,t=pick
ins=b-1
s=s[:ins].rstrip()+"\n\n"+block+"\n\n"+s[ins:]
open(p,"w",encoding="utf-8").write(s)
PY

# Purge anciennes variantes d'UI pour éviter affichage doublon
rm -f "$WOLV"/index.*.html 2>/dev/null || true

# UI SINGLE: 1 dépôt manuel (plus de retrait / plus de sections dupliquées)
cat >"$WOLV/index.html" <<'HTML'

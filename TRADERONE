cat >/root/WOLV_TLS_DIAG_JUP.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== Date + OpenSSL ==="
date || true
openssl version || true
echo

echo "=== Test HTTPS basique (Google/Cloudflare) ==="
for u in https://www.google.com https://cloudflare.com; do
  echo "--- $u"
  curl -4 -sS -I --max-time 8 --http1.1 "$u" | head -n 5 || true
done
echo

echo "=== DNS quote-api.jup.ag ==="
getent hosts quote-api.jup.ag || true
echo

echo "=== Jupiter (variantes curl) ==="
URL="https://quote-api.jup.ag/v6/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50"

echo "--- http1.1 tls1.2"
curl -4 -sS --max-time 10 --http1.1 --tlsv1.2 -v "$URL" -o /dev/null 2>&1 | tail -n 12 || true
echo

echo "--- http1.1 tls1.3"
curl -4 -sS --max-time 10 --http1.1 --tlsv1.3 -v "$URL" -o /dev/null 2>&1 | tail -n 12 || true
echo

echo "--- seclevel1 (compat)"
curl -4 -sS --max-time 10 --http1.1 --tlsv1.2 --ciphers 'DEFAULT:@SECLEVEL=1' -v "$URL" -o /dev/null 2>&1 | tail -n 12 || true
echo

echo "=== OpenSSL handshake (TLS1.2) ==="
echo | openssl s_client -connect quote-api.jup.ag:443 -servername quote-api.jup.ag -tls1_2 2>/dev/null | egrep -i 'subject=|issuer=|Verify return|alert|handshake' | head -n 25 || true
echo

echo "DONE"
BASH

bash /root/WOLV_TLS_DIAG_JUP.sh
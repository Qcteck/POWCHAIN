cat >/tmp/HARD_RESET_WOLVERINE_INDEX_AND_NOCACHE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"

FRONT_DIR="/var/www/fireinners/wolverine"
INDEX="$FRONT_DIR/index.html"
SNIP="/etc/nginx/snippets/wolverine_unified.conf"

echo "=== 0) Backup index ==="
mkdir -p "$FRONT_DIR"
[ -f "$INDEX" ] && cp -a "$INDEX" "$INDEX.bak.$T" || true

echo "=== 1) Write CLEAN /wolverine/index.html (no JS outside <script>) ==="
cat >"$INDEX" <<'EOF'
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Wolverine</title>
  <style>
    body{margin:0;font-family:system-ui,Segoe UI,Arial;background:#0b0f14;color:#e6edf3}
    header{background:#111827;padding:12px 16px;border-bottom:1px solid #1f2937}
    h1{margin:0;font-size:16px}
    .wrap{padding:12px}
    .btn{display:inline-block;margin-right:8px;margin-bottom:8px;padding:9px 10px;border-radius:12px;
      border:1px solid rgba(255,255,255,.18);background:rgba(10,18,34,.88);color:#e7f0ff;text-decoration:none}
    iframe{width:100%;height:72vh;border:0;border-radius:12px;background:#000}
    pre{background:#05060b;border:1px solid #1f2937;border-radius:10px;padding:10px;overflow:auto}
  </style>
</head>
<body>
  <header><h1>Wolverine</h1></header>
  <div class="wrap">
    <a class="btn" href="/wolverine/traderone/" target="_blank">TraderOne UI</a>
    <a class="btn" href="/wolverine/api/status" target="_blank">API status</a>
    <a class="btn" href="/wolverine/api/health" target="_blank">API health</a>

    <div style="height:10px"></div>
    <iframe src="/wolverine/traderone/"></iframe>

    <div style="height:10px"></div>
    <pre id="log">Console…</pre>
  </div>

  <script>
    window.__WOLV__ = window.__WOLV__ || { s:{} };
    window.__WOLV__.API = location.origin + "/wolverine/api";
    const log=(t)=>{const el=document.getElementById('log'); el.textContent=(el.textContent==="Console…"?"":el.textContent+"\n")+t;}
    log("front ready: " + new Date().toISOString());
  </script>

  <script defer src="/wolverine/traderone_overlay.js?v=2"></script>
</body>
</html>
EOF

echo "=== 2) Ensure /wolverine/ has NO-CACHE headers in nginx snippet ==="
if [ -f "$SNIP" ] && grep -q "location \\^~ /wolverine/" "$SNIP"; then
  # inject no-cache headers inside the /wolverine/ location if missing
  python3 - <<PY
import re
p="${SNIP}"
s=open(p,"r",encoding="utf-8",errors="ignore").read()
# find the /wolverine/ location block
m=re.search(r'(location\s+\^~\s+/wolverine/\s*\{)(.*?)(\n\})', s, flags=re.S)
if not m:
    print("WARN: can't find location ^~ /wolverine/ in", p)
    raise SystemExit(0)
block=m.group(0)
if "Cache-Control" in block:
    print("OK: cache headers already present")
else:
    ins = "\n  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate\" always;\n  add_header Pragma \"no-cache\" always;\n  add_header Expires \"0\" always;\n"
    new = block.replace(m.group(1), m.group(1)+ins, 1)
    s = s.replace(block, new, 1)
    open(p,"w",encoding="utf-8").write(s)
    print("OK: cache headers injected into /wolverine/ location")
PY
else
  echo "WARN: $SNIP missing or no /wolverine/ location found. (We still fixed index.html)"
fi

echo "=== 3) Reload nginx + verify /wolverine/ served content ==="
nginx -t
systemctl reload nginx

echo "--- HEADERS /wolverine/ ---"
curl -kIs --max-time 8 https://fireinners.online/wolverine/ | head -n 20
echo
echo "--- FIRST LINES /wolverine/ (must NOT contain '(()=>{...})' outside <script>) ---"
curl -ksS --max-time 8 https://fireinners.online/wolverine/ | nl -ba | head -n 12
SH

bash /tmp/HARD_RESET_WOLVERINE_INDEX_AND_NOCACHE.sh
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX USDC BALANCE (FINAL) ==="

[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup créé: ${HTML}.bak_${TS}"

# Remplacer UNIQUEMENT la partie USDC JS
sed -i '
/getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)})/{ 
c\
      const tokenAccounts = await conn.getParsedTokenAccountsByOwner(pub,{programId:new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")});\
      let u=0;\
      tokenAccounts.value.forEach(a=>{\
        const info=a.account.data.parsed.info;\
        if(info.mint===USDC_MINT){\
          u+=info.tokenAmount.uiAmount||0;\
        }\
      });\
      balUsdc.textContent=u.toFixed(2);
}' "$HTML"

echo "✅ USDC LOGIQUE CORRIGÉE"
echo "➡️ CTRL + F5 obligatoire"
cat >/root/fix_github_email_privacy_and_push.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DIR="/opt/WOLVERINE1_export"

cd "$DIR"

echo "== 1) Set git identity to GitHub noreply =="
# Mets TON username GitHub ici :
GH_USER="Qcteck"
# Si tu connais ton ID GitHub (numéro), mets-le ici pour être 100% safe.
# Sinon laisse 0, ça marche souvent quand même.
GH_ID="0"

git config user.name "$GH_USER"
if [ "$GH_ID" = "0" ]; then
  git config user.email "${GH_USER}@users.noreply.github.com"
else
  git config user.email "${GH_ID}+${GH_USER}@users.noreply.github.com"
fi

echo "Using email: $(git config user.email)"

echo
echo "== 2) Rewrite last commit author (no history mess) =="
git commit --amend --no-edit --reset-author

echo
echo "== 3) Push again =="
git push -u origin main
BASH

chmod +x /root/fix_github_email_privacy_and_push.sh
/root/fix_github_email_privacy_and_push.sh
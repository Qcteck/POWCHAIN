bash -lc 'set -euo pipefail
TMP=/tmp/MEGA_WOLVERINE_FIX.sh
cat >"$TMP" <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail

APPDIR="/opt/fireinners/wolverine-api"
FRONTDIR="/opt/fireinners/frontend-react/app/dist/wolverine"
ENVF="$APPDIR/.env"
SERVICE="wolverine-api"
NG="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/fireinners-wolverine.conf"

say(){ printf "%s\n" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: $1 manquant"; exit 1; }; }

need node; need npm; need systemctl; need nginx; need sed; need awk; need grep; need curl; need base64; need chattr

ASKOR="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKOR" ]; then
  # shellcheck disable=SC1090
  source "$ASKOR"
else
  askorupdate_yesno(){ return 0; }
  askorupdate_file(){
    local dst="$1" name="$2" content="$3"
    mkdir -p "$(dirname "$dst")"
    [ -f "$dst" ] && cp -a "$dst" "$dst.bak.$(date +%s)" || true
    chattr -i "$dst" 2>/dev/null || true
    printf "%s" "$content" >"$dst"
  }
fi

say "=== BATCH FLY (read-only) ==="
say "whoami: $(whoami)"
say "host: $(hostname)"
say "node: $(node -v)"
say "nginx: $(nginx -v 2>&1 | head -n1)"
[ -f "$NG" ] || { say "ERREUR: vhost absent: $NG"; exit 1; }

mkdir -p "$APPDIR" "$FRONTDIR"
chmod 755 "$APPDIR" "$FRONTDIR" || true

# env (ne casse pas ton setup)
if [ ! -f "$ENVF" ]; then
  cat >"$ENVF" <<EOF
PORT=3050
BASE_PATH=/wolverine
RPC_URL=https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac
MONITOR_URL=https://bbbotrader.paycashnostory.workers.dev/ping
MONITOR_SEC=10
MONITOR_FAILS=3
TG_ALERTS=0
WOLV_SEND=/usr/local/bin/wolv_send
EOF
  chmod 600 "$ENVF" || true
fi

PKG_JSON=$(cat <<'"'"'JSON'"'"'
{"name":"wolverine-api","private":true,"version":"1.0.0","main":"server.js","type":"commonjs","dependencies":{"dotenv":"^16.4.5","express":"^4.19.2","@solana/web3.js":"^1.95.4"}}
JSON
)

SVR_JS=$(cat <<'"'"'JS'"'"'
"use strict";
require("dotenv").config();
const fs=require("fs"),path=require("path"),express=require("express");
const {Connection,Keypair}=require("@solana/web3.js");

const PORT=parseInt(process.env.PORT||"3050",10);
const BASE=(process.env.BASE_PATH||"/wolverine").replace(/\/$/,"");
const RPC_URL=process.env.RPC_URL||"https://api.mainnet-beta.solana.com";
const MONITOR_URL=process.env.MONITOR_URL||"";
const MONITOR_SEC=Math.max(2,parseInt(process.env.MONITOR_SEC||"10",10));
const MONITOR_FAILS=Math.max(1,parseInt(process.env.MONITOR_FAILS||"3",10));
const TG_ALERTS=(process.env.TG_ALERTS||"0")==="1";
const WOLV_SEND=process.env.WOLV_SEND||"/usr/local/bin/wolv_send";

const WALLET_FILE=path.join(__dirname,"wallet.json");
const now=()=>new Date().toISOString();

function loadOrCreateWallet(){
  try{
    const o=JSON.parse(fs.readFileSync(WALLET_FILE,"utf8"));
    if(o&&Array.isArray(o.secretKey)&&o.secretKey.length>=32){
      return Keypair.fromSecretKey(Uint8Array.from(o.secretKey));
    }
  }catch(_){}
  const kp=Keypair.generate();
  fs.writeFileSync(WALLET_FILE,JSON.stringify({created:now(),pub:kp.publicKey.toBase58(),secretKey:Array.from(kp.secretKey)}));
  try{fs.chmodSync(WALLET_FILE,0o600);}catch(_){}
  return kp;
}
const CUSTODIAL=loadOrCreateWallet();
const conn=new Connection(RPC_URL,"confirmed");

let STATE={running:false,mode:"safe",budget_usdc:0,owner_pub:null,last_ping:null,last_ping_ok:null,fails:0,effective:"INIT",started_at:null};

function tgSend(text){
  if(!TG_ALERTS) return;
  try{ require("child_process").execFile(WOLV_SEND,[String(text||"").slice(0,900)],{timeout:8000},()=>{}); }catch(_){}
}

async function doPingOnce(){
  if(!MONITOR_URL) return {ok:false,err:"no MONITOR_URL"};
  try{
    const r=await fetch(MONITOR_URL,{method:"GET",cache:"no-store",redirect:"follow",signal:AbortSignal.timeout(8000)});
    const t=await r.text();
    const ok=r.ok && /pong/i.test(t||"");
    return {ok,code:r.status,txt:(t||"").slice(0,80)};
  }catch(e){ return {ok:false,err:String(e&&e.message||e)}; }
}

let pingTimer=null;
async function pingTick(){
  const res=await doPingOnce();
  STATE.last_ping=now();
  STATE.last_ping_ok=!!res.ok;
  if(res.ok) STATE.fails=0; else STATE.fails=(STATE.fails||0)+1;
  const prev=STATE.effective;
  STATE.effective=res.ok?"UP":(STATE.fails>=MONITOR_FAILS?"DOWN":"FLAKY");
  if(prev!==STATE.effective){
    if(STATE.effective==="UP") tgSend(`WOLVERINE: API UP (recovery) ${now()}`);
    else if(STATE.effective==="DOWN") tgSend(`WOLVERINE: API DOWN (>=${MONITOR_FAILS} fails) ${now()}`);
    else tgSend(`WOLVERINE: API STATE ${STATE.effective} ${now()}`);
  }
}
function startLoop(){ if(pingTimer) return; pingTimer=setInterval(()=>{pingTick().catch(()=>{});},MONITOR_SEC*1000); pingTick().catch(()=>{}); }
function stopLoop(){ if(!pingTimer) return; clearInterval(pingTimer); pingTimer=null; }

const app=express();
app.disable("x-powered-by");
app.use((req,res,next)=>{ res.setHeader("Cache-Control","no-store, no-cache, must-revalidate, proxy-revalidate"); res.setHeader("Pragma","no-cache"); res.setHeader("Expires","0"); next(); });
app.use(express.json({limit:"256kb"}));

app.get("/",(_req,res)=>res.type("text/plain").send("wolverine-api"));
app.get("/health",(_req,res)=>res.json({ok:true,uptime:process.uptime(),ts:Date.now()}));
app.get("/ping",(_req,res)=>res.type("text/plain").send("pong"));

app.get("/config",(_req,res)=>res.json({
  ok:true,base:BASE,api:`${BASE}/api`,rpc:RPC_URL,
  monitor:{url:MONITOR_URL,sec:MONITOR_SEC,fails:MONITOR_FAILS},
  tg_alerts:TG_ALERTS?1:0,custodial_pub:CUSTODIAL.publicKey.toBase58(),ts:Date.now()
}));
app.get("/wallet",(_req,res)=>res.json({ok:true,pub:CUSTODIAL.publicKey.toBase58(),ts:Date.now()}));
app.get("/status",(_req,res)=>res.json({ok:true,state:STATE,ts:Date.now()}));

app.post("/start",(req,res)=>{
  const b=Number(req.body&&req.body.budget_usdc||0);
  const m=String(req.body&&req.body.mode||"safe");
  const owner=String(req.body&&req.body.owner_pub||"").trim();
  if(owner && !/^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(owner)) return res.status(400).json({ok:false,error:"bad owner_pub"});
  STATE.running=true; STATE.started_at=now();
  STATE.budget_usdc=isFinite(b)&&b>=0?b:0;
  STATE.mode=m.slice(0,40);
  STATE.owner_pub=owner||null;
  startLoop();
  res.json({ok:true,state:STATE,ts:Date.now()});
});
app.post("/stop",(_req,res)=>{ STATE.running=false; stopLoop(); res.json({ok:true,state:STATE,ts:Date.now()}); });

app.listen(PORT,"127.0.0.1",()=>{ startLoop(); });
JS
)

UNIT=$(cat <<EOF
[Unit]
Description=Wolverine API (fireinners.online/wolverine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$APPDIR
EnvironmentFile=$ENVF
ExecStart=/usr/bin/env node $APPDIR/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF
)

# FRONT HTML: nouvelle palette VIOLET/TEAL visible + toggle EN/FR + refresh 2s
HTML_B64="$(cat <<'"'"'EOF_B64'"'"'
 
EOF_B64
)"

# write files
askorupdate_file "$APPDIR/package.json" "WOLVERINE package.json" "$PKG_JSON"
askorupdate_file "$APPDIR/server.js" "WOLVERINE server.js" "$SVR_JS"

# write html safely
chattr -i "$FRONTDIR/index.html" 2>/dev/null || true
printf "%s" "$HTML_B64" | base64 -d >"$FRONTDIR/index.html"
chmod 644 "$FRONTDIR/index.html" || true

# deps
cd "$APPDIR"
npm i --omit=dev

# systemd
askorupdate_file "/etc/systemd/system/$SERVICE.service" "WOLVERINE systemd unit" "$UNIT"
systemctl daemon-reload
systemctl enable "$SERVICE" >/dev/null 2>&1 || true
systemctl restart "$SERVICE"

# nginx: unlock -> write snippet -> ensure include -> test -> reload -> relock
chattr -i "$SNIP" 2>/dev/null || true
cat >"$SNIP" <<EOF
# WOLVERINE (generated) fireinners.online/wolverine
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/api/ {
  proxy_pass http://127.0.0.1:3050/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
}
location ^~ /wolverine/ {
  alias $FRONTDIR/;
  try_files \$uri \$uri/ /wolverine/index.html;
}
EOF

chattr -i "$NG" 2>/dev/null || true
if ! grep -q "snippets/fireinners-wolverine.conf" "$NG"; then
  awk -v ins="    include /etc/nginx/snippets/fireinners-wolverine.conf;" '
    BEGIN{done=0}
    {print}
    !done && $0 ~ /^server[[:space:]]*\{/ {print ins; done=1}
  ' "$NG" >"$NG.tmp" && mv "$NG.tmp" "$NG"
fi

nginx -t
systemctl reload nginx

# relock (conforme à ta règle)
chattr +i "$SNIP" 2>/dev/null || true
chattr +i "$NG" 2>/dev/null || true

say "=== DONE ==="
say "Front :  https://fireinners.online/wolverine/"
say "Ping  :  https://fireinners.online/wolverine/api/ping"
say "Health:  https://fireinners.online/wolverine/api/health"
say "Config:  https://fireinners.online/wolverine/api/config"
say "Wallet:  https://fireinners.online/wolverine/api/wallet"
say "Status:  https://fireinners.online/wolverine/api/status"
say "Deposit address(pub): $(curl -fsS https://fireinners.online/wolverine/api/wallet | sed -n '"'"'s/.*"pub":"\([^"]*\)".*/\1/p'"'"' || true)"
BASH
chmod +x "$TMP"
"$TMP"
'
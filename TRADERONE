const express=require("express");
const http=require("http");
const https=require("https");
const app=express();
app.use(express.json({limit:"2mb"}));
app.use((req,res,next)=>{res.setHeader("Access-Control-Allow-Origin","*");res.setHeader("Access-Control-Allow-Headers","content-type");res.setHeader("Access-Control-Allow-Methods","GET,POST,OPTIONS");if(req.method==="OPTIONS")return res.sendStatus(204);next();});

const WRAP_PORT=${WRAP_PORT};
const PROBABLE_PORTS=[3000,3001,3010,3200,3333,8484,9696].filter(p=>p!==WRAP_PORT);
let REAL=null;

function tryDetect(cb){
  if(REAL) return cb(null,REAL);
  let i=0;
  const next=()=>{
    if(i>=PROBABLE_PORTS.length) return cb(null,null);
    const p=PROBABLE_PORTS[i++];
    const req=http.request({host:"127.0.0.1",port:p,path:"/health",method:"GET",timeout:450}, r=>{
      let d=""; r.on("data",c=>d+=c); r.on("end",()=>{
        if(r.statusCode===200 && d.includes("traderone") || d.includes("TraderOne")){
          REAL={host:"127.0.0.1",port:p}; return cb(null,REAL);
        }
        // try /status as fallback
        const req2=http.request({host:"127.0.0.1",port:p,path:"/status",method:"GET",timeout:450}, r2=>{
          let d2=""; r2.on("data",c=>d2+=c); r2.on("end",()=>{
            if(r2.statusCode===200 && (d2.includes("traderone")||d2.includes("TraderOne"))){
              REAL={host:"127.0.0.1",port:p}; return cb(null,REAL);
            }
            next();
          });
        });
        req2.on("error",()=>next());
        req2.on("timeout",()=>{try{req2.destroy();}catch(e){}; next();});
        req2.end();
      });
    });
    req.on("error",()=>next());
    req.on("timeout",()=>{try{req.destroy();}catch(e){}; next();});
    req.end();
  };
  next();
}

function proxyToReal(req,res,real){
  const opts={host:real.host,port:real.port,path:req.originalUrl,method:req.method,headers:{...req.headers,host:req.headers.host||"127.0.0.1"}};
  const preq=http.request(opts, pres=>{
    res.status(pres.statusCode||502);
    Object.entries(pres.headers||{}).forEach(([k,v])=>{ try{ if(v!==undefined) res.setHeader(k,v);}catch(e){} });
    pres.pipe(res);
  });
  preq.on("error",()=>res.status(502).json({ok:false,error:"proxy_failed",real}));
  if(req.method!=="GET" && req.method!=="HEAD") preq.write(JSON.stringify(req.body||{}));
  preq.end();
}

app.get("/health",(req,res)=>{

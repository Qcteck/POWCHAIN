# 1) Vérifie le flag i (tu vas voir un "i" dans les attributs)
lsattr /etc/nginx/nginx.conf

# 2) Dégèle uniquement nginx.conf
chattr -i /etc/nginx/nginx.conf

# 3) Patch SAFE (on évite sed -i)
cp -a /etc/nginx/nginx.conf /etc/nginx/nginx.conf.BAK_$(date +%Y%m%d_%H%M%S)
sed -E 's/^([[:space:]]*)server[[:space:]]*\{/\1# server {/' /etc/nginx/nginx.conf > /tmp/nginx.conf.new
mv /tmp/nginx.conf.new /etc/nginx/nginx.conf

# 4) Test puis reload (reload seulement si test OK)
nginx -t && systemctl reload nginx

# 5) Regel
chattr +i /etc/nginx/nginx.conf
lsattr /etc/nginx/nginx.conf
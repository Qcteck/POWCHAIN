#!/bin/bash
set -e

echo "=== AIAQUILA RSS FIX FINAL ==="

apt update -y
apt install -y php php-curl nginx

A=/var/www/aiaquila
mkdir -p $A
cd $A

### PROXY RSS
cat > rss.php <<'PHP'
<?php
header("Access-Control-Allow-Origin: *");
if(!isset($_GET["url"])) die();
$ch=curl_init($_GET["url"]);
curl_setopt_array($ch,[
 CURLOPT_RETURNTRANSFER=>true,
 CURLOPT_FOLLOWLOCATION=>true,
 CURLOPT_TIMEOUT=>10,
 CURLOPT_USERAGENT=>"AIAQUILA"
]);
echo curl_exec($ch);
curl_close($ch);
PHP

### FRONTEND FIX
cat > index.html <<'HTML'
<!DOCTYPE html><html><meta charset="utf-8">
<title>AIAQUILA</title>
<style>
body{background:#111;color:#eee;font-family:Arial;padding:20px}
button{padding:10px}
#log{white-space:pre;background:#000;padding:10px;margin-top:10px}
</style>

<h1>🦅 AIAQUILA — RSS réel</h1>
<button onclick="loadRSS()">Lire les articles</button>
<button onclick="analyze()">Analyser</button>
<div id="out"></div>
<div id="log"></div>

<script>
const FEEDS=[
"https://www.coindesk.com/arc/outboundfeeds/rss/",
"https://cointelegraph.com/rss",
"https://news.bitcoin.com/feed/"
];
const PROXY="rss.php?url=";
let ARTICLES=[];
const logEl=document.getElementById("log");
const log=t=>logEl.textContent+=t+"\\n";

async function loadRSS(){
 ARTICLES=[];logEl.textContent="";
 for(const f of FEEDS){
  log("Flux: "+f);
  const r=await fetch(PROXY+encodeURIComponent(f));
  const t=await r.text();
  const x=new DOMParser().parseFromString(t,"text/xml");

  /* RSS */
  x.querySelectorAll("item").forEach(i=>{
    ARTICLES.push(i.querySelector("title")?.textContent||"");
  });

  /* ATOM */
  x.querySelectorAll("entry").forEach(e=>{
    ARTICLES.push(e.querySelector("title")?.textContent||"");
  });
 }
 log("TOTAL articles: "+ARTICLES.length);
 speak("Articles trouvés "+ARTICLES.length);
}

function speak(t){
 const u=new SpeechSynthesisUtterance(t);
 u.lang="fr-FR";
 speechSynthesis.cancel();
 speechSynthesis.speak(u);
}

function analyze(){
 if(!ARTICLES.length){speak("Aucun article");return;}
 speak("Analyse en cours");
 document.getElementById("out").textContent=
 ARTICLES.slice(0,5).join(" • ");
}
</script>
</html>
HTML

chown -R www-data:www-data $A
chmod -R 755 $A
nginx -t && systemctl reload nginx

echo "=== OK : RSS RÉEL FONCTIONNEL ==="
echo "→ https://fireinners.online/aiaquila/"
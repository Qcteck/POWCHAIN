lcd /opt/wolverine || exit 1

echo "[1/5] Installing deps"
npm install --omit=dev || exit 1

echo "[2/5] Stopping old TraderOne if any"
pm2 delete traderone 2>/dev/null || true

echo "[3/5] Starting TraderOne backend"
pm2 start server.js --name traderone --time || exit 1

echo "[4/5] Saving PM2 state"
pm2 save || exit 1

echo "[5/5] Status"
pm2 status traderone
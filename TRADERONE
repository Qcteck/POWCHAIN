cat >/root/FIX_NDJSON_SLASH_REDIRECT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/ndjson_fireinners.inc"
NGX="/etc/nginx/nginx.conf"

echo "[1/4] Unfreeze nginx (best effort)..."
chattr -i "$NGX" 2>/dev/null || true
chattr -i /etc/nginx/includes/*.inc 2>/dev/null || true

echo "[2/4] Patch ndjson include (slash redirect)..."
cat >>"$INC" <<'NGINX'

# --- NDJSON slash safety (mobile / Safari) ---
location = /ndjson {
  return 301 /ndjson/;
}
location = /data {
  return 301 /data/;
}
NGINX

echo "[3/4] Test nginx..."
nginx -t

echo "[4/4] Reload nginx..."
systemctl reload nginx

echo "DONE: NDJSON slash redirect fixed"
BASH

bash /root/FIX_NDJSON_SLASH_REDIRECT.sh |& tee /root/FIX_NDJSON_SLASH_REDIRECT.log
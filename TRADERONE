cat >/root/debug_403_wolverine_rpc_browser.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

URL="https://fireinners.online/wolverine/rpc"
PAY='{"jsonrpc":"2.0","id":1,"method":"getVersion"}'

echo "== 1) Plain curl (server-style) =="
curl -sk -D- "$URL" \
  -H 'content-type: application/json' \
  --data "$PAY" | head -n 40
echo

echo "== 2) Browser-like headers (Origin/Sec-Fetch) =="
curl -sk -D- "$URL" \
  -H 'content-type: application/json' \
  -H 'Origin: https://fireinners.online' \
  -H 'Referer: https://fireinners.online/wolverine/' \
  -H 'Sec-Fetch-Site: same-origin' \
  -H 'Sec-Fetch-Mode: cors' \
  -H 'Sec-Fetch-Dest: empty' \
  --data "$PAY" | head -n 60
echo

echo "== 3) Check who returns the 403 (look for: server: cloudflare / cf-ray) =="
curl -sk -o /dev/null -D- "$URL" \
  -H 'content-type: application/json' \
  -H 'Origin: https://fireinners.online' \
  --data "$PAY" | egrep -i 'HTTP/|server:|cf-ray:|cf-cache-status:|www-authenticate:|x-|access-control' || true

echo
echo "DONE ✅"
BASH

chmod +x /root/debug_403_wolverine_rpc_browser.sh
/root/debug_403_wolverine_rpc_browser.sh
cat >/root/MEGA_AQUILATRADER_INSTALL_FIX_V4.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }

DOMAIN="fireinners.online"
WWW="/var/www/aquilatrader"
INDEX="$WWW/index.html"
NGX_INC_DIR="/etc/nginx/includes"
NGX_INC="$NGX_INC_DIR/aquilatrader_static.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGXCONF="/etc/nginx/nginx.conf"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_AQUILATRADER_FIX_${TS}"
mkdir -p "$BK"

need_root(){
  [ "$(id -u)" -eq 0 ] || die "Run as root."
}

has_immutable(){
  local f="$1"
  command -v lsattr >/dev/null 2>&1 || return 1
  lsattr -d "$f" 2>/dev/null | awk '{print $1}' | grep -q 'i'
}

unfreeze_if_needed(){
  local f="$1"
  if [ -e "$f" ] && has_immutable "$f"; then
    say "chattr -i $f"
    chattr -i "$f" || die "Cannot chattr -i $f"
    echo "$f" >>"$BK/was_immutable.txt"
  fi
}

refreeze_previous(){
  [ -f "$BK/was_immutable.txt" ] || return 0
  while IFS= read -r f; do
    [ -e "$f" ] || continue
    say "chattr +i $f"
    chattr +i "$f" || true
  done <"$BK/was_immutable.txt"
}

backup_file(){
  local f="$1"
  [ -e "$f" ] || return 0
  cp -a "$f" "$BK/$(basename "$f").bak" 2>/dev/null || true
}

# Remove any nginx "location ... /aquilatrader" blocks from a file (brace-aware)
purge_aquilatrader_locations_in_file(){
  local f="$1"
  [ -f "$f" ] || return 0
  # Skip our dedicated include
  [ "$f" = "$NGX_INC" ] && return 0

  python3 - <<PY
import re,sys
p=sys.argv[1]
s=open(p,'r',encoding='utf-8',errors='ignore').read().splitlines(True)

def strip_locations(lines):
    out=[]
    i=0
    changed=False
    while i<len(lines):
        line=lines[i]
        # detect start of a location block that mentions aquilatrader
        if re.search(r'^\s*location\b.*aquilatrader', line):
            changed=True
            # consume until brace-balanced end
            depth=0
            # if current line contains "{", count it
            depth += line.count("{") - line.count("}")
            i+=1
            while i<len(lines) and depth>0:
                depth += lines[i].count("{") - lines[i].count("}")
                i+=1
            continue
        # also handle legacy marker blocks if present
        if "AQUILATRADER_MANAGED" in line:
            changed=True
            # drop until END marker
            i+=1
            while i<len(lines) and "END AQUILATRADER_MANAGED" not in lines[i]:
                i+=1
            if i<len(lines): i+=1
            continue
        out.append(line); i+=1
    return out, changed

out,changed=strip_locations(s)
if changed:
    open(p,'w',encoding='utf-8').write(''.join(out))
    print("PURGED:",p)
else:
    print("NOOP:",p)
PY
}

ensure_include_once_in_vhost(){
  [ -f "$VHOST" ] || die "Missing vhost: $VHOST"

  python3 - <<PY
import re,sys
vhost=sys.argv[1]
inc=sys.argv[2]

lines=open(vhost,'r',encoding='utf-8',errors='ignore').read().splitlines(True)

# already included?
if any(re.search(r'^\s*include\s+'+re.escape(inc)+r'\s*;', ln) for ln in lines):
    print("VHOST: include already present")
    sys.exit(0)

def find_server_blocks(lines):
    blocks=[]
    i=0
    while i<len(lines):
        if re.match(r'^\s*server\s*\{', lines[i]):
            start=i
            depth=lines[i].count("{")-lines[i].count("}")
            i+=1
            while i<len(lines) and depth>0:
                depth += lines[i].count("{")-lines[i].count("}")
                i+=1
            end=i
            blocks.append((start,end))
        else:
            i+=1
    return blocks

blocks=find_server_blocks(lines)

def block_text(a,b):
    return ''.join(lines[a:b])

target=None
for a,b in blocks:
    t=block_text(a,b)
    if re.search(r'listen\s+443', t) and re.search(r'\bserver_name\b[^;]*\bfireinners\.online\b', t):
        target=(a,b); break

if not target:
    # fallback: first listen 443 server
    for a,b in blocks:
        t=block_text(a,b)
        if re.search(r'listen\s+443', t):
            target=(a,b); break

if not target:
    raise SystemExit("VHOST: no server { } block found")

a,b=target
# insert include just before the closing brace of that server block
# find last line containing only "}" (or indented) within block end-1 backwards
insert_at=None
for j in range(b-1,a,-1):
    if re.match(r'^\s*\}\s*$', lines[j]):
        insert_at=j
        break
if insert_at is None:
    raise SystemExit("VHOST: cannot find server closing brace")

ins = f"    include {inc};\n"
lines.insert(insert_at, ins)

open(vhost,'w',encoding='utf-8').write(''.join(lines))
print("VHOST: inserted include ->",inc)
PY
}

main(){
  need_root
  command -v nginx >/dev/null 2>&1 || die "nginx not found"
  command -v systemctl >/dev/null 2>&1 || die "systemctl not found"

  say "MEGA_AQUILATRADER_INSTALL_FIX_V4"
  say "Goal: https://${DOMAIN}/aquilatrader/ serves ${INDEX}"
  say "Log: /root/MEGA_AQUILATRADER_INSTALL_FIX_V4.log"
  say "Backup: ${BK}"
  echo

  say "0) Backup + unfreeze nginx files if immutable"
  backup_file "$NGXCONF"
  backup_file "$VHOST"
  mkdir -p "$NGX_INC_DIR"
  [ -f "$NGX_INC" ] && backup_file "$NGX_INC"
  unfreeze_if_needed "$NGXCONF"
  unfreeze_if_needed "$VHOST"
  unfreeze_if_needed "$NGX_INC_DIR" || true
  # unfreeze common includes that might contain old blocks
  for f in /etc/nginx/includes/*.inc /etc/nginx/snippets/*.conf; do
    [ -e "$f" ] || continue
    unfreeze_if_needed "$f" || true
  done

  say "1) Ensure AquilaTrader webroot + index"
  mkdir -p "$WWW"
  if [ ! -f "$INDEX" ]; then
    cat >"$INDEX" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>AquilaTrader</title><style>body{margin:0;font-family:system-ui;background:#0b1020;color:#fff}main{max-width:780px;margin:40px auto;padding:0 18px}h1{margin:0 0 14px;font-size:44px}label{display:block;opacity:.85;margin:10px 0 8px}input{width:100%;padding:16px;border-radius:12px;border:1px solid #2b3552;background:#0f162c;color:#e7eeff;font-size:18px}button{padding:14px 22px;border-radius:14px;border:1px solid #2b3552;background:#f1f4ff;color:#1b2b5a;font-size:18px;cursor:pointer}button:hover{filter:brightness(.98)}.row{display:flex;gap:16px;margin-top:14px;flex-wrap:wrap}.muted{opacity:.85}</style></head><body><main><h1>AquilaTrader</h1><div class="muted">Wallet: <span id="addr">-</span></div><label>Montant / Param</label><input id="amt" value="1"/><div class="row"><button id="start">Start</button><button id="stop">Stop</button><button id="cash">Cash-out</button></div><pre id="log" style="margin-top:18px;white-space:pre-wrap;opacity:.9"></pre><script>
const L=(m)=>{const el=document.getElementById('log');el.textContent+=(m+"\n");};
async function post(u,o){return fetch(u,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(o||{})});}
document.getElementById('start').onclick=async()=>{L("start...");try{await post("/wolverine/traderone/api/start",{amount:document.getElementById('amt').value});L("started");}catch(e){L("ERR "+e);}};
document.getElementById('stop').onclick=async()=>{L("stop...");try{await post("/wolverine/traderone/api/stop",{});L("stopped");}catch(e){L("ERR "+e);}};
document.getElementById('cash').onclick=async()=>{L("cashout...");try{const r=await post("/wolverine/traderone/api/cashout",{});L("cashout sent");}catch(e){L("ERR "+e);}};
</script></main></body></html>
HTML
    say "Wrote $INDEX"
  else
    say "Index exists: $INDEX (kept)"
  fi

  say "2) Create dedicated nginx include (single source of truth)"
  cat >"$NGX_INC" <<'NGX'
# AquilaTrader static route (managed)
location = /aquilatrader { return 301 /aquilatrader/; }
location ^~ /aquilatrader/ {
  alias /var/www/aquilatrader/;
  try_files $uri $uri/ /aquilatrader/index.html;
  add_header Cache-Control "no-store" always;
}
NGX
  say "Wrote $NGX_INC"

  say "3) Purge old /aquilatrader location blocks from other nginx includes/snippets to stop duplicates"
  # common places where old blocks were inserted
  for f in /etc/nginx/includes/*.inc /etc/nginx/snippets/*.conf; do
    [ -f "$f" ] || continue
    purge_aquilatrader_locations_in_file "$f" || true
  done

  say "4) Ensure vhost includes $NGX_INC exactly once"
  ensure_include_once_in_vhost

  say "5) nginx -t then reload (rollback if fails)"
  set +e
  nginx -t >/dev/null 2>&1
  RC=$?
  set -e
  if [ "$RC" -ne 0 ]; then
    say "nginx -t FAILED -> rollback"
    [ -f "$BK/$(basename "$VHOST").bak" ] && cp -a "$BK/$(basename "$VHOST").bak" "$VHOST" || true
    [ -f "$BK/$(basename "$NGXCONF").bak" ] && cp -a "$BK/$(basename "$NGXCONF").bak" "$NGXCONF" || true
    [ -f "$BK/$(basename "$NGX_INC").bak" ] && cp -a "$BK/$(basename "$NGX_INC").bak" "$NGX_INC" || true
    nginx -t || true
    refreeze_previous || true
    die "Rollback done. nginx config invalid. Check: $BK"
  fi

  systemctl reload nginx

  say "6) Quick local checks (Host header)"
  curl -sk "https://127.0.0.1/aquilatrader/" -H "Host: ${DOMAIN}" | head -n 20 || true
  echo
  say "DONE. Open: https://${DOMAIN}/aquilatrader/"
  say "Backup: $BK"

  refreeze_previous || true
}

main "$@"
BASH
chmod +x /root/MEGA_AQUILATRADER_INSTALL_FIX_V4.sh

bash /root/MEGA_AQUILATRADER_INSTALL_FIX_V4.sh |& tee /root/MEGA_AQUILATRADER_INSTALL_FIX_V4.log
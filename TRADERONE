set -e
cd /root

echo "=== 1) Nettoie tout traderone ==="
pm2 delete traderone 2>/dev/null || true

echo
echo "=== 2) Start le VRAI server.js (pas .bak) ==="
PORT=3000 HOST=127.0.0.1 pm2 start /opt/traderone-opt/server.js --name traderone --update-env

sleep 1
echo
echo "=== 3) Qui écoute sur 3000 ? ==="
ss -lptn 'sport = :3000' || true
lsof -nP -iTCP:3000 -sTCP:LISTEN || true

echo
echo "=== 4) Test /api/status (GET puis POST) ==="
curl -sS -i "http://127.0.0.1:3000/api/status" | head -n 40 || true
echo
curl -sS -i -X POST "http://127.0.0.1:3000/api/status" -H "content-type: application/json" --data '{}' | head -n 60 || true

echo
echo "=== 5) Logs si ça foire ==="
pm2 logs traderone --lines 60 || true
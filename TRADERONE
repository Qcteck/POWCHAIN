python3 - <<'PY'
from pathlib import Path
import re

p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

vendor_tag='<script src="/wolverine/vendor/solana-web3.min.js"></script>'

# Ensure vendor tag exists
if vendor_tag not in s:
  s=re.sub(r"(<head[^>]*>)", r"\1"+vendor_tag, s, count=1, flags=re.I)

# Ensure vendor tag is BEFORE any other script tags (best-effort)
# If multiple scripts exist and vendor is after them, move it to just after <head>.
m_head=re.search(r"<head[^>]*>", s, flags=re.I)
if m_head:
  head_end=m_head.end()
  s_wo=s.replace(vendor_tag,"")
  s=s_wo[:head_end]+vendor_tag+s_wo[head_end:]

MARK_A="/*AQUILA_VAULT_UI_BEGIN*/"
MARK_B="/*AQUILA_VAULT_UI_END*/"

ui_js=r"""/*AQUILA_VAULT_UI_BEGIN*/
(function(){
  function q(sel){return document.querySelector(sel);}
  function el(tag,attrs,children){
    var e=document.createElement(tag);
    if(attrs){for(var k in attrs){
      if(k==="style"){for(var sk in attrs.style)e.style[sk]=attrs.style[sk];}
      else if(k==="class") e.className=attrs[k];
      else e.setAttribute(k,attrs[k]);
    }}
    (children||[]).forEach(function(c){ if(typeof c==="string") e.appendChild(document.createTextNode(c)); else if(c) e.appendChild(c);});
    return e;
  }
  function now(){return new Date().toISOString().replace("T"," ").replace("Z","");}
  function log(msg){
    var box=q("#log"); if(!box) return;
    box.value=(box.value?box.value+"\n":"")+"["+now()+"] "+msg;
    box.scrollTop=box.scrollHeight;
  }
  function needWeb3(){
    if(!window.solanaWeb3) throw new Error("solanaWeb3 not defined (vendor not loaded)");
    return window.solanaWeb3;
  }

  var RPC_SAME_ORIGIN="/wolverine/solana-rpc";

  async function connectPhantom(){
    if(!window.solana) throw new Error("Phantom not found");
    var r=await window.solana.connect({onlyIfTrusted:false});
    return r.publicKey.toString();
  }

  async function apiJson(url){
    var r=await fetch(url,{cache:"no-store"});
    if(!r.ok) throw new Error("HTTP "+r.status+" "+url);
    return await r.json();
  }

  async function getVault(pub){
    return await apiJson("/wolverine/traderone/api/vault?pub="+encodeURIComponent(pub));
  }

  async function getDepositTx(pub,lamports){
    return await apiJson("/wolverine/traderone/api/vault/tx/deposit?pub="+encodeURIComponent(pub)+"&lamports="+encodeURIComponent(String(lamports)));
  }

  async function signSendV0(txB64, blockhash, lastValidBlockHeight){
    var solanaWeb3=needWeb3();
    var raw=Uint8Array.from(atob(txB64),c=>c.charCodeAt(0));
    var tx=solanaWeb3.VersionedTransaction.deserialize(raw);
    if(!window.solana || !window.solana.signTransaction) throw new Error("Wallet cannot signTransaction");
    tx=await window.solana.signTransaction(tx);
    var conn=new solanaWeb3.Connection(RPC_SAME_ORIGIN,{commitment:"confirmed"});
    var sig=await conn.sendRawTransaction(tx.serialize(),{skipPreflight:false,maxRetries:3});
    await conn.confirmTransaction({signature:sig,blockhash:blockhash,lastValidBlockHeight:lastValidBlockHeight},"confirmed");
    return sig;
  }

  function mount(){
    if(q("#aquilaVaultCard")) return;

    var host=q("#walletBox")||q(".walletBox")||q("#wallet")||document.body;
    var card=el("div",{id:"aquilaVaultCard",style:{marginTop:"10px",padding:"10px",border:"1px solid #ccc",borderRadius:"8px",maxWidth:"520px"}},[
      el("div",{style:{fontWeight:"700",marginBottom:"8px"}},["Aquila Vault (one-click)"]),
      el("div",{style:{display:"grid",gridTemplateColumns:"140px 1fr",gap:"8px",alignItems:"center"}},[
        el("div",{},["Deposit (SOL)"]),
        el("input",{id:"aquilaDepositSol",type:"number",min:"0",step:"0.001",value:"0.01",style:{padding:"6px",border:"1px solid #ccc",borderRadius:"6px"}},[])
      ]),
      el("div",{style:{display:"flex",gap:"8px",marginTop:"10px",flexWrap:"wrap"}},[
        el("button",{id:"aquilaVaultBtn",style:{padding:"8px 10px",border:"1px solid #333",borderRadius:"8px",cursor:"pointer"}},["Create/Load Vault"]),
        el("button",{id:"aquilaDepBtn",style:{padding:"8px 10px",border:"1px solid #333",borderRadius:"8px",cursor:"pointer"}},["Deposit to Vault"])
      ]),
      el("div",{style:{marginTop:"10px",fontSize:"12px"}},[
        el("div",{},["Vault: ",el("span",{id:"aquilaVaultAddr",style:{fontFamily:"monospace"}},["-"])]),
        el("div",{},["Last TX: ",el("span",{id:"aquilaLastSig",style:{fontFamily:"monospace"}},["-"])])
      ])
    ]);

    host.appendChild(card);

    q("#aquilaVaultBtn").addEventListener("click", async function(){
      try{
        log("Vault: connect wallet...");
        var pub=await connectPhantom();
        log("Wallet: "+pub);
        log("Vault: API create/load...");
        var v=await getVault(pub);
        q("#aquilaVaultAddr").textContent=v.vault||"-";
        log("Vault: "+(v.vault||"-"));
      }catch(e){
        log("Vault error: "+((e&&e.message)?e.message:String(e)));
      }
    });

    q("#aquilaDepBtn").addEventListener("click", async function(){
      try{
        var solanaWeb3=needWeb3();
        log("Deposit: connect wallet...");
        var pub=await connectPhantom();
        log("Wallet: "+pub);
        var v=await getVault(pub);
        if(!v.vault) throw new Error("No vault");
        q("#aquilaVaultAddr").textContent=v.vault;

        var sol=parseFloat(q("#aquilaDepositSol").value||"0");
        if(!(sol>0)) throw new Error("Invalid SOL amount");
        var lamports=Math.floor(sol*solanaWeb3.LAMPORTS_PER_SOL);

        log("Deposit: build unsigned v0 tx via backend...");
        var t=await getDepositTx(pub,lamports);
        if(!t.txB64) throw new Error("Missing txB64");
        log("Deposit: sign+send...");
        var sig=await signSendV0(t.txB64,t.blockhash,t.lastValidBlockHeight);
        q("#aquilaLastSig").textContent=sig;
        log("Deposit OK: "+sig);
      }catch(e){
        log("Deposit error: "+((e&&e.message)?e.message:String(e)));
      }
    });
  }

  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", mount);
  else mount();
})();
/*AQUILA_VAULT_UI_END*/"""

if MARK_A not in s:
  # insert before </body>
  if re.search(r"</body>", s, flags=re.I):
    s=re.sub(r"</body>", "<script>"+ui_js+"</script></body>", s, count=1, flags=re.I)
  else:
    s=s+"\n<script>"+ui_js+"</script>\n"
else:
  # replace existing block (safe refresh)
  s=re.sub(re.escape(MARK_A)+r".*?"+re.escape(MARK_B), ui_js, s, flags=re.S)

p.write_text(s)
print("OK: index.html patched")
PY

echo "== 3) Patch TraderOne server.cjs: add /api/vault + /api/vault/tx/deposit (Express) =="
python3 - <<'PY'
from pathlib import Path
import re

p=Path("/opt/traderone/server.cjs")
s=p.read_text(errors="ignore")

MARK_A="/*AQUILA_VAULT_ROUTES_BEGIN*/"
MARK_B="/*AQUILA_VAULT_ROUTES_END*/"

routes=r"""/*AQUILA_VAULT_ROUTES_BEGIN*/
(function(){
  try{
    const fs=require("fs");
    const path=require("path");
    const crypto=require("crypto");
    const {Connection,Keypair,PublicKey,SystemProgram,TransactionMessage,VersionedTransaction}=require("@solana/web3.js");

    const DATA_DIR=process.env.TRADERONE_DATA_DIR||"/opt/traderone/data";
    const VAULTS_FILE=path.join(DATA_DIR,"vaults.json");
    const MASTER_KEY_FILE=process.env.VAULT_MASTER_KEY_FILE||"/opt/traderone/.vault_master_key";
    const RPC_URL=process.env.SOLANA_RPC||"https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";

    function mkdirp(d){try{fs.mkdirSync(d,{recursive:true});}catch(_){}}
    mkdirp(DATA_DIR);

    function loadMaster(){
      try{
        if(fs.existsSync(MASTER_KEY_FILE)){
          const b=Buffer.from(fs.readFileSync(MASTER_KEY_FILE,"utf8").trim(),"base64");
          if(b.length===32) return b;
        }
      }catch(_){}
      const b=crypto.randomBytes(32);
      try{fs.writeFileSync(MASTER_KEY_FILE,b.toString("base64"),{mode:0o600});}catch(_){}
      try{fs.chmodSync(MASTER_KEY_FILE,0o600);}catch(_){}
      return b;
    }
    const MASTER=loadMaster();

    function enc(buf){
      const iv=crypto.randomBytes(12);
      const c=crypto.createCipheriv("aes-256-gcm",MASTER,iv);
      const ct=Buffer.concat([c.update(buf),c.final()]);
      const tag=c.getAuthTag();
      return Buffer.concat([iv,tag,ct]).toString("base64");
    }
    function dec(b64){
      const raw=Buffer.from(b64,"base64");
      const iv=raw.subarray(0,12);
      const tag=raw.subarray(12,28);
      const ct=raw.subarray(28);
      const d=crypto.createDecipheriv("aes-256-gcm",MASTER,iv);
      d.setAuthTag(tag);
      return Buffer.concat([d.update(ct),d.final()]);
    }

    function readVaults(){
      try{
        if(!fs.existsSync(VAULTS_FILE)) return {};
        const j=JSON.parse(fs.readFileSync(VAULTS_FILE,"utf8"));
        return (j&&typeof j==="object")?j:{};
      }catch(_){return {};}
    }
    function writeVaults(v){
      try{fs.writeFileSync(VAULTS_FILE,JSON.stringify(v,null,2),{mode:0o600});}catch(_){}
      try{fs.chmodSync(VAULTS_FILE,0o600);}catch(_){}
    }
    function validPub(p){
      try{new PublicKey(p);return true;}catch(_){return false;}
    }

    function getOrCreateVault(userPub){
      const vaults=readVaults();
      if(vaults[userPub] && vaults[userPub].vault && vaults[userPub].encSk){
        return {vault:vaults[userPub].vault,existed:true};
      }
      const kp=Keypair.generate();
      vaults[userPub]={
        vault:kp.publicKey.toString(),
        encSk:enc(Buffer.from(kp.secretKey)),
        createdAt:new Date().toISOString()
      };
      writeVaults(vaults);
      return {vault:kp.publicKey.toString(),existed:false};
    }

    async function buildDepositTx(userPub,lamports){
      const v=getOrCreateVault(userPub);
      const user=new PublicKey(userPub);
      const vault=new PublicKey(v.vault);
      const conn=new Connection(RPC_URL,"confirmed");
      const latest=await conn.getLatestBlockhash("confirmed");
      const ix=SystemProgram.transfer({fromPubkey:user,toPubkey:vault,lamports:Number(lamports)});
      const msg=new TransactionMessage({payerKey:user,recentBlockhash:latest.blockhash,instructions:[ix]}).compileToV0Message();
      const tx=new VersionedTransaction(msg);
      const txB64=Buffer.from(tx.serialize()).toString("base64");
      return {vault:v.vault,txB64,blockhash:latest.blockhash,lastValidBlockHeight:latest.lastValidBlockHeight};
    }

    if(typeof app==="undefined" || !app || !app.get){
      console.log("AQUILA_VAULT: app not found, routes not attached");
      return;
    }

    app.get("/api/vault", async (req,res)=>{
      try{
        const pub=String(req.query.pub||"").trim();
        if(!validPub(pub)) return res.status(400).json({error:"bad pub"});
        const v=getOrCreateVault(pub);
        res.json({status:"ok",user:pub,vault:v.vault,existed:v.existed});
      }catch(e){
        res.status(500).json({error:(e&&e.message)?e.message:String(e)});
      }
    });

    app.get("/api/vault/tx/deposit", async (req,res)=>{
      try{
        const pub=String(req.query.pub||"").trim();
        const lamports=Number(req.query.lamports||0);
        if(!validPub(pub)) return res.status(400).json({error:"bad pub"});
        if(!(lamports>0)) return res.status(400).json({error:"bad lamports"});
        const out=await buildDepositTx(pub,lamports);
        res.json({status:"ok",...out});
      }catch(e){
        res.status(500).json({error:(e&&e.message)?e.message:String(e)});
      }
    });

    console.log("AQUILA_VAULT: routes enabled");
  }catch(e){
    console.error("AQUILA_VAULT init error:", (e&&e.message)?e.message:String(e));
  }
})();
/*AQUILA_VAULT_ROUTES_END*/"""

if MARK_A in s:
  s=re.sub(re.escape(MARK_A)+r".*?"+re.escape(MARK_B), routes, s, flags=re.S)
  print("OK: replaced existing vault routes block")
else:
  # Insert right after existing health route if present (best anchor)
  m=re.search(r"app\.get\((['\"]/api/health['\"]).*?\)\s*;", s, flags=re.S)
  if m:
    i=m.end()
    s=s[:i]+"\n"+routes+"\n"+s[i:]
    print("OK: inserted after /api/health route")
  else:
    # Insert after app = express() if present
    m2=re.search(r"const\s+app\s*=\s*express\(\)\s*;", s)
    if m2:
      i=m2.end()
      s=s[:i]+"\n"+routes+"\n"+s[i:]
      print("OK: inserted after express()")
    else:
      s=s+"\n\n"+routes+"\n"
      print("OK: appended at end (no anchor found)")

p.write_text(s)
PY


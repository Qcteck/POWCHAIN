cat >/root/fix_traderone_basepath_api.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
API_UPSTREAM="${API_UPSTREAM:-http://127.0.0.1:8585}"
BASE_PREFIX="${BASE_PREFIX:-/api/}"   # <= le backend semble être sous /api/

echo "[*] DOMAIN=$DOMAIN"
echo "[*] VHOST=$VHOST"
echo "[*] API_UPSTREAM=$API_UPSTREAM"
echo "[*] BASE_PREFIX=$BASE_PREFIX"

ts="$(date +%Y%m%d_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/backup_traderone_basepath_${ts}"
mkdir -p "$BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
echo "[OK] Backup -> $BACKDIR/$(basename "$VHOST")"

export API_UPSTREAM BASE_PREFIX

perl -0777 -i -pe '
my $up = $ENV{API_UPSTREAM} // die "missing API_UPSTREAM";
my $base = $ENV{BASE_PREFIX} // "/api/";
$base = "/$base" unless $base =~ m{^/};
$base .= "/" unless $base =~ m{/$};

# remove previous injected block if exists
s/\n\s*# --- traderone api proxy \(injected\) ---.*?\n\s*# --- end traderone api proxy ---\n//ms;

my $block = qq{
  # --- traderone api proxy (injected) ---
  location ^~ /wolverine/traderone/api/ {
    # /wolverine/traderone/api/X -> /api/X (backend)
    rewrite ^/wolverine/traderone/api/?(.*)\$ $base\$1 break;

    if (\$request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
      add_header Access-Control-Allow-Headers "Authorization,Content-Type,Accept" always;
      return 204;
    }

    proxy_pass $up;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
  # --- end traderone api proxy ---
};

# insert before static /wolverine/ block
s/\n(\s*location\s+\^\~\s+\/wolverine\/\s*\{)/\n$block\n$1/ms
  or die "ERR: cannot find location ^~ /wolverine/ block\n";
' "$VHOST"

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== Tests (doivent être JSON 200) =="
curl -sS -D- "https://${DOMAIN}/wolverine/traderone/api/status" -o /dev/null | head -n 20 || true
echo
curl -sS -D- -X POST "https://${DOMAIN}/wolverine/traderone/api/status" -o /dev/null | head -n 20 || true
BASH

chmod +x /root/fix_traderone_basepath_api.sh
API_UPSTREAM="http://127.0.0.1:8585" /root/fix_traderone_basepath_api.sh fireinners.online
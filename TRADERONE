set -e
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/backup_nginx_fix_$TS"
mkdir -p "$BK"

echo "[0] Etat FS + attrs"
mount | grep " on / type " || true
lsattr /etc/nginx 2>/dev/null || true
lsattr /etc/nginx/nginx.conf 2>/dev/null || true

echo "[1] Retire immutable (+i) sur dossier + fichiers nginx"
chattr -R -i /etc/nginx 2>/dev/null || true
chattr -i /etc/nginx 2>/dev/null || true
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true

echo "[2] Backups"
cp -a /etc/nginx/nginx.conf "$BK/nginx.conf.bak" 2>/dev/null || true
cp -a /etc/nginx/sites-enabled/fireinners.online-ssl "$BK/fireinners.online-ssl.bak" 2>/dev/null || true
cp -a /etc/nginx/sites-available/fireinners.online-ssl "$BK/fireinners.online-ssl.AV.bak" 2>/dev/null || true

repair_braces () {
  F="$1"
  [ -f "$F" ] || return 0
  O="$(grep -o "{" "$F" | wc -l | tr -d ' ')"
  C="$(grep -o "}" "$F" | wc -l | tr -d ' ')"
  D=$((O-C))
  echo "   - $F opens=$O closes=$C diff=$D"
  if [ "$D" -gt 0 ] && [ "$D" -lt 8 ]; then
    printf "\n" >> "$F"
    i=0; while [ $i -lt $D ]; do echo "}" >> "$F"; i=$((i+1)); done
    echo "     -> appended $D brace(s)"
  fi
}

echo "[3] Répare accolades manquantes (nginx.conf + vhost)"
repair_braces /etc/nginx/nginx.conf
repair_braces /etc/nginx/sites-enabled/fireinners.online-ssl
repair_braces /etc/nginx/sites-available/fireinners.online-ssl

echo "[4] Test nginx"
nginx -t

echo "[5] Reload nginx"
systemctl reload nginx

echo "OK: nginx test + reload réussi. Backups: $BK"
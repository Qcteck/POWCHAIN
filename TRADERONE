sudo -i
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/wolv_rpc_proxy.conf"
INC="include /etc/nginx/snippets/wolv_rpc_proxy.conf;"
TS="$(date +%s)"

echo "== 1) Snippet RPC =="
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'EOF'
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  add_header X-Wolv-RPC "1" always;

  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF

echo "== 2) Inject include dans TOUS les server 443 =="
for f in $(grep -RIl --include="*.conf" -E "^\s*listen\s+.*443" /etc/nginx 2>/dev/null | grep -v "/snippets/"); do
  cp -a "$f" "$f.bak.$TS" || true
  if ! grep -qF "$INC" "$f"; then
    # Ajoute l'include juste après la première ligne listen ...443 du fichier
    sed -i '0,/^[[:space:]]*listen[[:space:]].*443/s//&\n  include \/etc\/nginx\/snippets\/wolv_rpc_proxy.conf;/' "$f" || true
  fi
done

echo "== 3) nginx test + reload =="
nginx -t
systemctl reload nginx

echo "== 4) TEST LOCAL FORCE (doit montrer X-Wolv-RPC: 1) =="
curl -ksS -i --resolve ${DOMAIN}:443:127.0.0.1 \
  "https://${DOMAIN}/wolverine/traderone/api/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 80
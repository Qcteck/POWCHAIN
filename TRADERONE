#!/usr/bin/env bash
set -euo pipefail

# ==============================
# MEGA FIX ROOT — WOLVERINE UI + PHANTOM + SOLDES
# À lancer en ROOT, n'importe où
# ==============================

DOMAIN="fireinners.online"
BASE="/var/www/wolverine"
INDEX="$BASE/index.html"
VENDOR="$BASE/vendor"
JS="$BASE/wallet-balances.js"
NGCONF="/etc/nginx/sites-available/fireinners.online-ssl"
BACK="/root/nginx_backup_$(date +%Y%m%d_%H%M%S).conf"

echo "== BACKUP NGINX =="
cp -a "$NGCONF" "$BACK"

echo "== ENSURE DIRS =="
mkdir -p "$BASE" "$VENDOR"

echo "== ENSURE solanaWeb3 (LOCAL) =="
if [ ! -f "$VENDOR/solanaWeb3.min.js" ]; then
  curl -fsSL https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js -o "$VENDOR/solanaWeb3.min.js"
fi

echo "== WRITE wallet-balances.js =="
cat > "$JS" <<'JS'
(async()=>{
  if(!window.solana||!window.solana.isPhantom)return;
  const RPC="https://api.mainnet-beta.solana.com";
  const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
  await window.solana.connect({onlyIfTrusted:true}).catch(()=>{});
  const pub=window.solana.publicKey;if(!pub)return;
  const conn=new solanaWeb3.Connection(RPC,"confirmed");
  const sol=await conn.getBalance(pub);
  const solEl=document.getElementById("sol");if(solEl)solEl.innerText=(sol/1e9).toFixed(4);
  let usdc=0;
  const toks=await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)});
  toks.value.forEach(t=>{usdc+=t.account.data.parsed.info.tokenAmount.uiAmount||0});
  const usdcEl=document.getElementById("usdc");if(usdcEl)usdcEl.innerText=usdc.toFixed(2);
})();
JS
chmod 644 "$JS"

echo "== ENSURE HTML TARGETS + LOAD ORDER =="
grep -q 'id="sol"' "$INDEX" || sed -i 's/SOL:.*/SOL: <span id="sol">0<\/span>/' "$INDEX"
grep -q 'id="usdc"' "$INDEX" || sed -i 's/USDC:.*/USDC: <span id="usdc">0<\/span>/' "$INDEX"
sed -i '/solanaWeb3.min.js/d' "$INDEX"
sed -i '/wallet-balances.js/d' "$INDEX"
sed -i 's#</body>#<script src="/wolverine/vendor/solanaWeb3.min.js"></script><script src="/wolverine/wallet-balances.js"></script></body>#' "$INDEX"

echo "== FIX NGINX (SINGLE /wolverine LOCATION + CSP OK) =="
sed -i '/location \/wolverine\//,/}/d' "$NGCONF"
sed -i '/server {/a \
    location /wolverine/ {\
        root /var/www;\
        index index.html;\
        try_files $uri $uri/ /wolverine/index.html;\
        add_header Cache-Control "no-store";\
    }\
    add_header Content-Security-Policy "default-src '\''self'\'' data: blob:; script-src '\''self'\'' '\''unsafe-eval'\'' '\''unsafe-inline'\''; style-src '\''self'\'' '\''unsafe-inline'\''; img-src * data:; connect-src *;" always;\
' "$NGCONF"

echo "== TEST & RELOAD NGINX =="
nginx -t
systemctl reload nginx

echo "== DONE =="
echo "OPEN: https://fireinners.online/wolverine/"
cat >/root/WOLVERINE_SAVEPOINT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
BASE="/root/WOLVERINE_SAVE_$TS"

echo "=== WOLVERINE SAVEPOINT $TS ==="
mkdir -p "$BASE"

echo "[1/6] Sauvegarde frontend Wolverine"
mkdir -p "$BASE/frontend"
cp -a /var/www/wolverine "$BASE/frontend/" 2>/dev/null || true

echo "[2/6] Sauvegarde vendor JS"
mkdir -p "$BASE/vendor"
cp -a /var/www/wolverine/vendor "$BASE/vendor/" 2>/dev/null || true

echo "[3/6] Sauvegarde nginx"
mkdir -p "$BASE/nginx"
cp -a /etc/nginx/nginx.conf "$BASE/nginx/" 2>/dev/null || true
cp -a /etc/nginx/sites-available "$BASE/nginx/" 2>/dev/null || true
cp -a /etc/nginx/sites-enabled "$BASE/nginx/" 2>/dev/null || true

echo "[4/6] Sauvegarde PM2"
mkdir -p "$BASE/pm2"
pm2 save || true
cp -a /root/.pm2 "$BASE/pm2/" 2>/dev/null || true

echo "[5/6] Sauvegarde backend TraderOne / Vault"
mkdir -p "$BASE/backend"
cp -a /opt/traderone* "$BASE/backend/" 2>/dev/null || true
cp -a /opt/traderone-vault* "$BASE/backend/" 2>/dev/null || true

echo "[6/6] Snapshot terminé"
echo "SAVEPOINT = $BASE"

echo
echo "AUCUNE MODIFICATION APPLIQUÉE"
echo "État figé avec succès"
BASH

chmod +x /root/WOLVERINE_SAVEPOINT.sh
set -e
cd /opt/traderone-opt

echo "=== 1) PID qui écoute sur 3000 ==="
PID3000=$(ss -ltnp | sed -n 's/.*:3000.*pid=\([0-9]\+\).*/\1/p' | head -n1)
echo "PID3000=$PID3000"
ps -fp "$PID3000" || true
echo

echo "=== 2) Liste PM2 ==="
pm2 ls || true
echo

echo "=== 3) Trouver le process PM2 qui a ce PID (et le restart) ==="
PM2_INFO=$(pm2 jlist | node -e '
let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
  const j=JSON.parse(d);
  const pid=Number(process.env.PID3000);
  const p=j.find(x=>x && x.pid===pid);
  if(!p){ console.log("NOT_FOUND"); process.exit(0); }
  console.log(JSON.stringify({name:p.name, pm_id:p.pm_id, pid:p.pid, cwd:(p.pm2_env&&p.pm2_env.pm_cwd)||null, script:(p.pm2_env&&p.pm2_env.pm_exec_path)||null},null,2));
})' PID3000="$PID3000")

echo "$PM2_INFO"

if echo "$PM2_INFO" | grep -q "NOT_FOUND"; then
  echo "KO: Ce PID n'est pas géré par PM2. (Donc c'est lancé autrement.)"
  echo "=> Donne la sortie de: ps -fp $PID3000"
  exit 1
fi

PM2_ID=$(echo "$PM2_INFO" | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{console.log(JSON.parse(d).pm_id)})')
echo "PM2_ID=$PM2_ID"

pm2 restart "$PM2_ID" --update-env
sleep 1
echo

echo "=== 4) Vérifs ==="
node --check server.js
ss -ltnp | egrep ':3000|:8585' || true
echo
curl -sS -i http://127.0.0.1:3000/health | head -n 12 || true
echo
curl -sS http://127.0.0.1:3000/api/dexes | head -c 400; echo
echo "=== DONE ==="
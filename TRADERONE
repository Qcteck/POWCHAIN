set -e
cd /root

echo "=== 1) Process qui écoute sur 12703 ==="
ss -ltnp | grep :12703 || echo "Rien sur 12703"

echo
echo "=== 2) PID + commande exacte (si dispo) ==="
sudo lsof -iTCP:12703 -sTCP:LISTEN -n -P || true
PID=$(sudo lsof -t -iTCP:12703 -sTCP:LISTEN 2>/dev/null | head -n 1 || true)
if [ -n "$PID" ]; then
  echo "PID=$PID"
  ps -fp "$PID"
  echo
  echo "=== 3) Dossier du process ==="
  readlink -f "/proc/$PID/cwd" || true
  echo
  echo "=== 4) Ligne de commande complète ==="
  tr '\0' ' ' < "/proc/$PID/cmdline" ; echo
else
  echo "Pas de PID trouvé pour 12703"
fi

echo
echo "=== 5) Trouver le code getHealth ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git "getHealth" /opt /root 2>/dev/null | head -n 80

echo
echo "=== 6) Chercher les méthodes exposées (jsonrpc/methods) ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git -E "jsonrpc|methods\\s*=|case\\s+['\"]|method.*===" /opt /root 2>/dev/null | head -n 120
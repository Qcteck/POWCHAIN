<script>
(() => {
  const $ = (id)=>document.getElementById(id);
  const logEl=$("log");
  const log=(...a)=>{const s=a.map(x=>typeof x==="string"?x:JSON.stringify(x,null,2)).join(" ");logEl.textContent+=s+"\n";logEl.scrollTop=logEl.scrollHeight;};
  const RPC_ENDPOINT=location.origin + "/aquilastacking/rpc";
  $("rpcBadge").textContent="/aquilastacking/rpc";

  let provider=null, pubkey=null, conn=null, ARMED=false, selectedStake=null;

  const {Connection,PublicKey,LAMPORTS_PER_SOL,Transaction,SystemProgram} = solanaWeb3;

  // Stake Program helpers (native program id + layouts)
  const STAKE_PROGRAM_ID = new PublicKey("Stake11111111111111111111111111111111111111");
  const SYSVAR_RENT = new PublicKey("SysvarRent111111111111111111111111111111111");
  const SYSVAR_CLOCK = new PublicKey("SysvarC1ock11111111111111111111111111111111");
  const SYSVAR_STAKE_HISTORY = new PublicKey("SysvarStakeHistory1111111111111111111111111");
  const STAKE_CONFIG_ID = new PublicKey("StakeConfig11111111111111111111111111111111");

  const ui = {
    setConnected(on){
      $("btnConnect").disabled=on;
      $("btnDisconnect").disabled=!on;
      $("btnRefresh").disabled=!on;
      $("btnArm").disabled=!on;
      $("btnDisarm").disabled=!on;
      $("btnCreateDelegate").disabled=!on || !ARMED;
      $("btnList").disabled=!on;
      $("btnDeactivate").disabled=!on || !ARMED;
      $("btnWithdraw").disabled=!on || !ARMED;
    },
    setArmed(on){
      ARMED=on;
      $("btnCreateDelegate").disabled=!pubkey || !ARMED;
      $("btnDeactivate").disabled=!pubkey || !ARMED;
      $("btnWithdraw").disabled=!pubkey || !ARMED;
      log("ARM", on ? "OK" : "OFF");
    }
  };

  async function ensureConn(){
    if(!conn) conn=new Connection(RPC_ENDPOINT,"confirmed");
    return conn;
  }

  async function refresh(){
    if(!pubkey) return;
    const c=await ensureConn();
    try{
      const bal=await c.getBalance(pubkey,"confirmed");
      $("sol").value=(bal/LAMPORTS_PER_SOL).toFixed(6);
      log("SOL balance:", $("sol").value);
    }catch(e){
      log("ERR refresh balance:", String(e?.message||e));
    }
  }

  async function connect(){
    provider = window.solana;
    if(!provider || !provider.isPhantom){ log("ERR: Phantom not found"); return; }
    try{
      const r = await provider.connect();
      pubkey = r.publicKey;
      $("addr").value = pubkey.toBase58();
      log("Wallet connected:", pubkey.toBase58());
      ui.setConnected(true);
      await refresh();
    }catch(e){ log("ERR connect:", String(e?.message||e)); }
  }

  async function disconnect(){
    try{ await provider?.disconnect?.(); }catch(e){}
    provider=null; pubkey=null; conn=null; selectedStake=null; $("stakeSel").value=""; $("addr").value=""; $("sol").value="";
    $("tbl").querySelector("tbody").innerHTML="";
    ui.setConnected(false);
    log("Disconnected");
  }

  function u32le(n){ const b=new Uint8Array(4); new DataView(b.buffer).setUint32(0,n,true); return b; }
  function u64le(n){ // n is BigInt
    const b=new Uint8Array(8); const v=new DataView(b.buffer);
    v.setUint32(0, Number(n & 0xffffffffn), true);
    v.setUint32(4, Number((n>>32n) & 0xffffffffn), true);
    return b;
  }
  function pkBytes(pk){ return pk.toBytes(); }
  function concat(...arrs){ let n=0; for(const a of arrs) n+=a.length; const out=new Uint8Array(n); let o=0; for(const a of arrs){ out.set(a,o); o+=a.length; } return out; }

  // Stake instruction formats (native program)
  // Initialize: u32 = 0, Authorized{staker,withdrawer}, Lockup{unixTimestamp,i64? ; epoch u64? ; custodian pubkey}
  // We'll use lockup all zeros and custodian = default (pubkey all zeros)
  function ixStakeInitialize(stakePub, authorizedStaker, authorizedWithdrawer){
    const LOCKUP_ZERO = concat(u64le(0n), u64le(0n), new Uint8Array(32)); // (unixTimestamp, epoch, custodian) as u64/u64/32
    const data = concat(u32le(0), pkBytes(authorizedStaker), pkBytes(authorizedWithdrawer), LOCKUP_ZERO);
    return new solanaWeb3.TransactionInstruction({
      programId: STAKE_PROGRAM_ID,
      keys: [
        {pubkey: stakePub, isSigner: false, isWritable: true},
        {pubkey: SYSVAR_RENT, isSigner: false, isWritable: false},
      ],
      data
    });
  }

  // DelegateStake: u32 = 2
  function ixStakeDelegate(stakePub, votePub, stakerPub){
    const data = u32le(2);
    return new solanaWeb3.TransactionInstruction({
      programId: STAKE_PROGRAM_ID,
      keys: [
        {pubkey: stakePub, isSigner:false, isWritable:true},
        {pubkey: votePub, isSigner:false, isWritable:false},
        {pubkey: SYSVAR_CLOCK, isSigner:false, isWritable:false},
        {pubkey: SYSVAR_STAKE_HISTORY, isSigner:false, isWritable:false},
        {pubkey: STAKE_CONFIG_ID, isSigner:false, isWritable:false},
        {pubkey: stakerPub, isSigner:true, isWritable:false},
      ],
      data
    });
  }

  // Deactivate: u32 = 5
  function ixStakeDeactivate(stakePub, stakerPub){
    const data = u32le(5);
    return new solanaWeb3.TransactionInstruction({
      programId: STAKE_PROGRAM_ID,
      keys: [
        {pubkey: stakePub, isSigner:false, isWritable:true},
        {pubkey: SYSVAR_CLOCK, isSigner:false, isWritable:false},
        {pubkey: stakerPub, isSigner:true, isWritable:false},
      ],
      data
    });
  }

  // Withdraw: u32 = 4, lamports u64
  function ixStakeWithdraw(stakePub, toPub, withdrawerPub, lamportsBig){
    const data = concat(u32le(4), u64le(lamportsBig));
    return new solanaWeb3.TransactionInstruction({
      programId: STAKE_PROGRAM_ID,
      keys: [
        {pubkey: stakePub, isSigner:false, isWritable:true},
        {pubkey: toPub, isSigner:false, isWritable:true},
        {pubkey: SYSVAR_CLOCK, isSigner:false, isWritable:false},
        {pubkey: SYSVAR_STAKE_HISTORY, isSigner:false, isWritable:false},
        {pubkey: withdrawerPub, isSigner:true, isWritable:false},
      ],
      data
    });
  }

  async function signSend(tx){
    tx.feePayer = pubkey;
    const c=await ensureConn();
    const {blockhash,lastValidBlockHeight}=await c.getLatestBlockhash("confirmed");
    tx.recentBlockhash=blockhash;

    try{
      // Prefer signAndSendTransaction if present
      if(provider.signAndSendTransaction){
        const res=await provider.signAndSendTransaction(tx);
        log("TX sent:", res.signature);
        await c.confirmTransaction({signature:res.signature,blockhash,lastValidBlockHeight},"confirmed");
        log("TX confirmed:", res.signature);
        return res.signature;
      }
      const signed=await provider.signTransaction(tx);
      const sig=await c.sendRawTransaction(signed.serialize(),{skipPreflight:false,preflightCommitment:"confirmed"});
      log("TX sent:", sig);
      await c.confirmTransaction({signature:sig,blockhash,lastValidBlockHeight},"confirmed");
      log("TX confirmed:", sig);
      return sig;
    }catch(e){
      log("ERR sign/send:", String(e?.message||e));
      throw e;
    }
  }

  async function createAndDelegate(){
    if(!pubkey) return;
    if(!ARMED){ log("ERR: ARM required"); return; }

    const voteStr=$("vote").value.trim();
    if(!voteStr) { log("ERR: Vote account required"); return; }

    const amtSol = Number($("amt").value || "0");
    if(!(amtSol>0)) { log("ERR: Amount must be > 0"); return; }

    const c=await ensureConn();
    const votePub=new PublicKey(voteStr);

    try{
      const stakeKp = solanaWeb3.Keypair.generate();
      const stakePub = stakeKp.publicKey;

      // Rent-exempt reserve for stake account
      const rentEx = await c.getMinimumBalanceForRentExemption(200); // stake acct size ~200 bytes
      const lamports = Math.floor(amtSol * LAMPORTS_PER_SOL);
      const total = rentEx + lamports;

      log("Create stake account:", stakePub.toBase58());
      log("RentEx:", rentEx, "Lamports stake:", lamports, "Total:", total);

      const tx=new Transaction();
      tx.add(SystemProgram.createAccount({
        fromPubkey: pubkey,
        newAccountPubkey: stakePub,
        lamports: total,
        space: 200,
        programId: STAKE_PROGRAM_ID
      }));

      // Initialize authorized = wallet for both staker + withdrawer
      tx.add(ixStakeInitialize(stakePub, pubkey, pubkey));
      tx.add(ixStakeDelegate(stakePub, votePub, pubkey));

      // Partial sign with stake keypair (new account)
      tx.partialSign(stakeKp);

      const sig = await signSend(tx);
      selectedStake = stakePub.toBase58();
      $("stakeSel").value = selectedStake;
      log("DONE stake created+delegated:", selectedStake, "tx:", sig);

      await listStakes();
    }catch(e){
      log("ERR create/delegate:", String(e?.message||e));
    }
  }

  function parseStakeState(data){
    // Minimal: we won't decode full state; just show that account exists and lamports.
    return {ok:true};
  }

  async function listStakes(){
    if(!pubkey) return;
    const c=await ensureConn();
    try{
      const resp = await c.getParsedProgramAccounts(STAKE_PROGRAM_ID,{
        filters:[
          {dataSize:200},
          {memcmp:{offset:44, bytes: pubkey.toBase58()}} // authorized staker offset heuristic (works for initialized stake); fallback if empty
        ]
      }).catch(()=>null);

      // If memcmp heuristic fails, fall back to getProgramAccounts (bigger) and filter client-side by parsed stake authority
      let rows=[];
      if(resp && Array.isArray(resp) && resp.length){
        for(const a of resp){
          rows.push({pub:a.pubkey.toBase58(), status:"(stake acct)", delegated:"—"});
        }
      }else{
        // fallback: scan stake accounts with parsed json; filter where wallet is either staker or withdrawer
        const all = await c.getParsedProgramAccounts(STAKE_PROGRAM_ID,{filters:[{dataSize:200}]});
        for(const a of all){
          const info=a.account?.data?.parsed?.info;
          if(!info) continue;
          const auth=info?.meta?.authorized;
          const staker=auth?.staker;
          const withdrawer=auth?.withdrawer;
          if(staker===pubkey.toBase58() || withdrawer===pubkey.toBase58()){
            const del=info?.stake?.delegation;
            const act=del?.activationEpoch;
            const deact=del?.deactivationEpoch;
            const stakeLam=del?.stake;
            let st="initialized";
            if(del){ st = (deact && deact!=="18446744073709551615") ? "deactivating/Inactive?" : "delegated/active?"; }
            rows.push({pub:a.pubkey.toBase58(), status:st, delegated: stakeLam? (Number(stakeLam)/LAMPORTS_PER_SOL).toFixed(4)+" SOL":"—"});
          }
        }
      }

      const tb=$("tbl").querySelector("tbody");
      tb.innerHTML="";
      for(const r of rows){
        const tr=document.createElement("tr");
        tr.innerHTML=`<td><a href="#" data-pub="${r.pub}">${r.pub}</a></td><td>${r.status}</td><td>${r.delegated}</td>`;
        tb.appendChild(tr);
      }
      tb.querySelectorAll("a[data-pub]").forEach(a=>{
        a.onclick=(ev)=>{ev.preventDefault(); selectedStake=a.getAttribute("data-pub"); $("stakeSel").value=selectedStake; log("Selected stake:", selectedStake);};
      });
      log("Stake accounts:", rows.length);
    }catch(e){
      log("ERR list stakes:", String(e?.message||e));
    }
  }

  async function deactivate(){
    if(!pubkey) return;
    if(!ARMED){ log("ERR: ARM required"); return; }
    const stakeStr = selectedStake || $("stakeSel").value.trim();
    if(!stakeStr){ log("ERR: select stake account"); return; }
    const c=await ensureConn();
    try{
      const stakePub = new PublicKey(stakeStr);
      const tx=new Transaction().add(ixStakeDeactivate(stakePub,pubkey));
      const sig=await signSend(tx);
      log("Deactivate sent:", sig);
      await listStakes();
    }catch(e){ log("ERR deactivate:", String(e?.message||e)); }
  }

  async function withdraw(){
    if(!pubkey) return;
    if(!ARMED){ log("ERR: ARM required"); return; }
    const stakeStr = selectedStake || $("stakeSel").value.trim();
    if(!stakeStr){ log("ERR: select stake account"); return; }
    const c=await ensureConn();
    try{
      const stakePub = new PublicKey(stakeStr);
      const acc = await c.getAccountInfo(stakePub,"confirmed");
      if(!acc){ log("ERR: stake account not found"); return; }
      // Withdraw everything (including rent) - stake must be inactive or it will fail (StakeInactive)
      const lamportsBig = BigInt(acc.lamports);
      log("Withdraw lamports:", String(lamportsBig));
      const tx=new Transaction().add(ixStakeWithdraw(stakePub,pubkey,pubkey,lamportsBig));
      const sig=await signSend(tx);
      log("Withdraw sent:", sig);
      await listStakes();
      await refresh();
    }catch(e){ log("ERR withdraw:", String(e?.message||e)); }
  }

  $("btnConnect").onclick=connect;
  $("btnDisconnect").onclick=disconnect;
  $("btnRefresh").onclick=refresh;
  $("btnArm").onclick=()=>ui.setArmed(true);
  $("btnDisarm").onclick=()=>ui.setArmed(false);

  $("btnCreateDelegate").onclick=createAndDelegate;
  $("btnList").onclick=listStakes;
  $("btnDeactivate").onclick=deactivate;
  $("btnWithdraw").onclick=withdraw;

  // init
  log("Ready. ARM -> CREATE+DELEGATE / DEACTIVATE / WITHDRAW");
  log("RPC:", RPC_ENDPOINT);
  ui.setConnected(false);
})();

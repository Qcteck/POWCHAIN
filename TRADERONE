cat >/root/WOLVERINE_ROLLBACK_STRICT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "===== WOLVERINE ROLLBACK STRICT ====="

# 1) Trouver le dernier savepoint valide
SAVEPOINT=$(ls -d /root/WOLVERINE_SAVEPOINT_* 2>/dev/null | sort | tail -n 1)
if [ -z "$SAVEPOINT" ]; then
  echo "❌ Aucun savepoint trouvé"
  exit 1
fi
echo "✅ Savepoint: $SAVEPOINT"

# 2) Stop nginx
systemctl stop nginx || true

# 3) Supprimer le frontend actuel
rm -rf /var/www/wolverine

# 4) Restaurer le frontend sain (celui avec SOL OK)
cp -a "$SAVEPOINT/frontend_wolverine" /var/www/wolverine

# 5) Permissions propres
chown -R www-data:www-data /var/www/wolverine
chmod -R 755 /var/www/wolverine

# 6) Purge cache nginx
rm -rf /var/cache/nginx/* || true

# 7) Reload nginx
nginx -t
systemctl start nginx

echo "✅ ROLLBACK TERMINÉ — Recharge CTRL+SHIFT+R"
BASH

chmod +x /root/WOLVERINE_ROLLBACK_STRICT.sh
/root/WOLVERINE_ROLLBACK_STRICT.sh
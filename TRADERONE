cat >/root/purge_enabled_fireinners_baks_now.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

EN="/etc/nginx/sites-enabled"
DST="/etc/nginx/sites-disabled/cleanup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$DST"

echo "== BEFORE =="
ls -lah "$EN"

echo
echo "== Move ALL fireinners.online-ssl.bak* out of sites-enabled =="
shopt -s nullglob
for f in "$EN"/fireinners.online-ssl.bak* "$EN"/fireinners.online-ssl.*; do
  [ -e "$f" ] || continue
  [ "$f" = "$EN/fireinners.online-ssl" ] && continue
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== AFTER (must show only fireinners.online-ssl) =="
ls -lah "$EN"

echo
echo "== nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/purge_enabled_fireinners_baks_now.sh
/root/purge_enabled_fireinners_baks_now.sh
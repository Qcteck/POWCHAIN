function logStatus(t){try{const el=$("#status")||$("#Status")||null;if(el)el.textContent=t;}catch(_){}console.log("[WOLV]",t);}
function findBtnByText(txt){const t=String(txt||"").toLowerCase();return $$("button").find(b=>String(b.textContent||"").toLowerCase().includes(t))||null;}

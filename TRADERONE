#!/usr/bin/env bash
set -euo pipefail

DIR="/opt/traderone-vault"
WALLET="$DIR/wallet.json"

echo "=== Création wallet TraderOne ==="

mkdir -p "$DIR"

if [ -f "$WALLET" ]; then
  echo "wallet.json existe déjà — ABORT"
  exit 1
fi

node <<'JS'
const fs = require("fs");
const { Keypair } = require("@solana/web3.js");
const bs58 = require("bs58");

const kp = Keypair.generate();

fs.writeFileSync(
  "/opt/traderone-vault/wallet.json",
  JSON.stringify({
    pubkey: kp.publicKey.toBase58(),
    secretKey: bs58.encode(kp.secretKey)
  }, null, 2)
);

console.log("=== WALLET TRADERONE CRÉÉ ===");
console.log("PUBKEY:", kp.publicKey.toBase58());
JS

chmod 600 "$WALLET"

echo "=== Permissions OK ==="
ls -l "$WALLET"

echo "✅ WALLET TRADERONE PRÊT"
></div></div></div></div></div><script>/* Buffer polyfill minimal */(()=>{try{if(!globalThis.global)globalThis.global=globalThis;if(!globalThis.process)globalThis.process={env:{}};if(!globalThis.Buffer){const B={from:(u)=>u,alloc:(n)=>new Uint8Array(n)};globalThis.Buffer=B;globalThis.global.Buffer=B;}}catch(e){}})();</script><script src="https://cdn.jsdelivr.net/npm/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script><script>(()=>{const $=s=>document.querySelector(s);const logEl=$("#log");const apiP=$("#api"),monP=$("#mon"),st=$("#statusLine");const SOL=$("#sol"),USDC=$("#usdc"),BUD=$("#budget"),CH=$("#chunk"),MINT=$("#mint"),MODE=$("#mode");const btnConn=$("#btnConn"),btnDisc=$("#btnDisc"),btnSave=$("#btnSave"),btnStart=$("#btnStart"),btnStop=$("#btnStop");const btnHealth=$("#btnHealth"),btnStatus=$("#btnStatus"),btnPing=$("#btnPing");const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const PROXY_BASE="https://bbtrader-jup.paycashnostory.workers.dev";const API_BASE="/wolverine/api";let conn=null,wallet=null,autoon=false,spent=0;const LS=(k,v)=>v===undefined?localStorage.getItem(k):localStorage.setItem(k,v);const j=(o)=>JSON.stringify(o);const sleep=(ms)=>new Promise(r=>setTimeout(r,ms));function L(x,cls){const t=new Date().toISOString();logEl.textContent+=`[${t}] ${x}\n`;logEl.scrollTop=1e9;if(cls){}}function setLine(x){st.textContent=x;}async function api(path,opts){const r=await fetch(API_BASE+path,{...opts,headers:{...(opts&&opts.headers||{}),"content-type":"application/json"}});const tx=await r.text();let jsn=null;try{jsn=JSON.parse(tx);}catch(e){}return {ok:r.ok,code:r.status,text:tx,json:jsn};}function hasPhantom(){return !!(window.solana&&window.solana.isPhantom);}async function connect(){if(!hasPhantom()){L("Phantom absent","bad");setLine("Phantom absent.");return;}wallet=(await window.solana.connect({onlyIfTrusted:false})).publicKey;L("Connected: "+wallet.toB
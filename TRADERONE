bash <<'WOLVERINE_FINAL_98'
set -e

# 1) KILL NGINX COMPLETELY
systemctl stop nginx || true
systemctl disable nginx || true
pkill -f nginx || true

# 2) KILL ANY OLD NODE
pkill -f wolverine || true

# 3) WRITE CLEAN HTTPS STATIC SERVER (NO NGINX)
cat > /root/wolverine_live.js <<'JS'
const https=require("https"),fs=require("fs"),path=require("path");
const root="/var/www/wolverine";
const mime={".html":"text/html",".js":"application/javascript",".css":"text/css",".json":"application/json",".png":"image/png",".svg":"image/svg+xml"};
https.createServer({
  key:fs.readFileSync("/etc/letsencrypt/live/fireinners.online/privkey.pem"),
  cert:fs.readFileSync("/etc/letsencrypt/live/fireinners.online/fullchain.pem")
},(req,res)=>{
  let p=req.url.split("?")[0];
  if(p==="/"||p==="/wolverine/"||p==="/wolverine") p="/index.html";
  if(p.startsWith("/wolverine/")) p=p.replace("/wolverine","");
  let f=path.join(root,p);
  if(!fs.existsSync(f)||fs.statSync(f).isDirectory()) f=path.join(root,"index.html");
  res.writeHead(200,{"Content-Type":mime[path.extname(f)]||"application/octet-stream"});
  res.end(fs.readFileSync(f));
}).listen(443,()=>console.log("WOLVERINE LIVE HTTPS 443"));
JS

# 4) RUN
node /root/wolverine_live.js >/root/wolverine_live.log 2>&1 &

sleep 2

# 5) HARD TEST
curl -k -s -o /dev/null -w "%{http_code}\n" https://fireinners.online/wolverine/

cat >/tmp/DEBUG_UNEXPECTED_TOKEN_LT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== A) Affiche les 20 premières lignes du HTML servi (/wolverine/) avec numéros ==="
curl -ksS --max-time 8 https://fireinners.online/wolverine/ | nl -ba | head -n 25

echo
echo "=== B) Liste les scripts référencés (src=) ==="
curl -ksS --max-time 8 https://fireinners.online/wolverine/ \
 | grep -oE 'src="[^"]+"' | sed 's/src="//;s/"$//' | nl -ba || true

echo
echo "=== C) Pour chaque script, vérifie le Content-Type + le début du body ==="
SCRIPTS=$(curl -ksS --max-time 8 https://fireinners.online/wolverine/ \
 | grep -oE 'src="[^"]+"' | sed 's/src="//;s/"$//' || true)

i=0
for u in $SCRIPTS; do
  i=$((i+1))
  echo
  echo "--- [$i] $u ---"
  curl -kIs --max-time 8 "https://fireinners.online$u" | head -n 12
  echo "--- body head ---"
  curl -ksS --max-time 8 "https://fireinners.online$u" | head -c 120; echo
done
SH

bash /tmp/DEBUG_UNEXPECTED_TOKEN_LT.sh
cat >/root/AIAQUILA_SSL_SAFE_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SNIPPET="/etc/nginx/snippets/aiaquila_locations.conf"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== AIAQUILA SSL SAFE FINAL ==="

### 1) Remove invalid standalone server
rm -f /etc/nginx/sites-enabled/aiaquila.server
rm -f /etc/nginx/sites-available/aiaquila.server

### 2) Write SAFE snippet (locations only)
echo "[1/5] Writing snippet"
cat >"$SNIPPET" <<'NGX'
# AIAQUILA RSS API
location /aiaquila/api/rss {
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    proxy_pass https://news.bitcoin.com/feed/;
    proxy_set_header Host news.bitcoin.com;
    proxy_set_header User-Agent "AIAQUILA-RSS";
    proxy_ssl_server_name on;

    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}

# AIAQUILA Health
location /aiaquila/health {
    default_type text/plain;
    return 200 "OK AIAQUILA\n";
}
NGX

### 3) Backup vhost
echo "[2/5] Backup vhost"
cp -a "$VHOST" "$VHOST.backup.$TS"

### 4) Include snippet SAFELY if missing
echo "[3/5] Inject include"
grep -q "aiaquila_locations.conf" "$VHOST" || \
sed -i '/server_name fireinners.online;/a\\
    include /etc/nginx/snippets/aiaquila_locations.conf;' "$VHOST"

### 5) Test & reload nginx
echo "[4/5] nginx test"
nginx -t

echo "[5/5] Reload nginx"
systemctl reload nginx

echo "DONE"
echo "Health : https://fireinners.online/aiaquila/health"
echo "RSS    : https://fireinners.online/aiaquila/api/rss"
BASH

chmod +x /root/AIAQUILA_SSL_SAFE_FINAL.sh
/root/AIAQUILA_SSL_SAFE_FINAL.sh
bash -lc 'cat >/root/AQFIX.sh<<'\''BASH'\''
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQFIX_BK_${TS}"
mkdir -p "$BK"
say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run as root"
umask 022

DOMAIN="fireinners.online"
PATH_A="/aquila_stacking/"
PATH_B="/iaaquila/"
WEBROOT="/var/www/aquila_stacking"
LINKROOT="/var/www/iaaquila"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"

REACT_APP="/opt/aquila_stacking_react"
REACT_DIST="$REACT_APP/dist"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

backup_one(){ local p="$1"; [ -e "$p" ] || return 0; mkdir -p "$BK/$(dirname "$p")"; cp -a "$p" "$BK/$p.bak" 2>/dev/null || true; }

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "AQ routes fix" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(echo "$path" | sed "s#/#_#g").bak" 2>/dev/null || true
    install -m 0644 "$tmp" "$path"
  fi
  rm -f "$tmp"
}

ensure_webroot(){
  say "1) Ensure WEBROOT"
  mkdir -p "$WEBROOT"
  chmod 0755 "$WEBROOT" || true
  chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
}

deploy_dist_if_any(){
  say "2) Deploy React dist if present"
  if [ -d "$REACT_DIST" ] && [ -f "$REACT_DIST/index.html" ]; then
    say "   dist found -> deploy"
    rm -rf "$WEBROOT"/*
    cp -a "$REACT_DIST"/. "$WEBROOT"/
    chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
    chmod -R a+rX "$WEBROOT" 2>/dev/null || true
  else
    say "   dist missing -> keep existing"
  fi

  if [ ! -f "$WEBROOT/index.html" ]; then
    say "   create fallback index.html"
    cat >"$WEBROOT/index.html"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aquila</title><style>body{font-family:system-ui;margin:24px;background:#0b1020;color:#d7e3ff}code{background:#111a33;padding:3px 6px;border-radius:6px}</style></head><body><h1>Aquila Stacking</h1><p>Fallback served (React dist not found).</p><p>WEBROOT <code>/var/www/aquila_stacking</code></p><p>Paths <code>/aquila_stacking/</code> and <code>/iaaquila/</code></p></body></html>
EOF
    chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
    chmod -R a+rX "$WEBROOT" 2>/dev/null || true
  fi

  if [ ! -e "$LINKROOT" ]; then
    ln -s "$WEBROOT" "$LINKROOT" 2>/dev/null || true
  fi
}

ensure_inc(){
  say "3) Write nginx include $INC"
  mkdir -p "$(dirname "$INC")"
  write_file "$INC" \
"# Aquila Stacking routes\n\
location = ${PATH_A%/} { return 301 $PATH_A; }\n\
location ^~ $PATH_A {\n\
  root /var/www;\n\
  try_files \$uri \$uri/ ${PATH_A}index.html;\n\
  add_header Cache-Control \"no-store\" always;\n\
}\n\
location = ${PATH_B%/} { return 301 $PATH_B; }\n\
location ^~ $PATH_B {\n\
  root /var/www;\n\
  try_files \$uri \$uri/ ${PATH_B}index.html;\n\
  add_header Cache-Control \"no-store\" always;\n\
}\n"
}

patch_vhosts(){
  say "4) Patch vhosts to include routes"
  local files
  files="$(grep -RIl --exclude='*.dpkg-*' --exclude='*.bak' -E "server_name[[:space:]].*\\b${DOMAIN}\\b" /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d 2>/dev/null || true)"
  [ -n "$files" ] || { say "WARN: no vhost found for $DOMAIN"; return 0; }
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    backup_one "$f"
    if grep -qF "$INC" "$f"; then
      say "   ok include already: $f"
      continue
    fi
    python3 - "$f" "$DOMAIN" "$INC" <<'PY'
import re,sys
p,dom,inc=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(p,'r',encoding='utf-8',errors='ignore').read()
def patch(block):
  if inc in block: return block, False
  if not re.search(r'\blisten\b[^;]*\b443\b', block): return block, False
  if not re.search(r'\bserver_name\b[^;]*\b'+re.escape(dom)+r'\b', block): return block, False
  lines=block.splitlines()
  ins=None
  for i,l in enumerate(lines):
    if re.search(r'\bserver_name\b', l):
      ins=i+1; break
  if ins is None: ins=1
  lines.insert(ins, "    include %s;"%inc)
  return "\n".join(lines), True

out=[]
changed=False
pos=0
for m in re.finditer(r'server\s*\{', s):
  start=m.start()
  out.append(s[pos:start])
  i=start
  depth=0
  while i < len(s):
    c=s[i]
    if c=='{': depth+=1
    elif c=='}':
      depth-=1
      if depth==0:
        end=i+1
        block=s[start:end]
        newb,ch=patch(block)
        out.append(newb)
        changed=changed or ch
        pos=end
        break
    i+=1
else:
  out=[s]
new="".join(out)+s[pos:]
if changed:
  open(p,'w',encoding='utf-8').write(new)
  print("patched")
else:
  print("nochange")
PY
    if grep -qF "$INC" "$f"; then
      say "   patched: $f"
    else
      say "   WARN not patched: $f"
    fi
  done <<<"$files"
}

reload_and_test(){
  say "5) nginx -t + reload"
  nginx -t
  systemctl reload nginx

  say "6) Local tests (must NOT be 404)"
  echo "--- ${PATH_A} ---"
  curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_A" | head -n 12 || true
  echo "--- ${PATH_B} ---"
  curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_B" | head -n 12 || true
  echo "include hit:"
  nginx -T 2>/dev/null | grep -n "aquila_stacking_routes" -n | head -n 20 || true
}

main(){
  ensure_webroot
  deploy_dist_if_any
  ensure_inc
  patch_vhosts
  reload_and_test
  say "DONE"
  say "BK: $BK"
  say "Open: https://$DOMAIN$PATH_A"
  say "Open: https://$DOMAIN$PATH_B"
}
main
BASH
chmod +x /root/AQFIX.sh
/root/AQFIX.sh'
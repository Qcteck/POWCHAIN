cat >/root/FIX_NGINX_FIREINNERS_ROOT.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SSL_VHOST="fireinners.online-ssl"
SITES_AVAILABLE="/etc/nginx/sites-available"
SITES_ENABLED="/etc/nginx/sites-enabled"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX NGINX FIREINNERS (ROOT / SAFE) ==="

if [ "$EUID" -ne 0 ]; then
  echo "❌ Must be root"
  exit 1
fi

if [ ! -f "$SITES_AVAILABLE/$SSL_VHOST" ]; then
  echo "❌ Missing vhost: $SSL_VHOST"
  exit 1
fi

mkdir -p /root/nginx_sites_enabled_backup
cp -a "$SITES_ENABLED" "/root/nginx_sites_enabled_backup/backup_$TS"

for f in "$SITES_ENABLED"/*; do
  [ -e "$f" ] || continue
  name="$(basename "$f")"
  if echo "$name" | grep -q "fireinners" && [ "$name" != "$SSL_VHOST" ]; then
    rm -f "$f"
    echo "Removed: $name"
  fi
done

ln -sf "$SITES_AVAILABLE/$SSL_VHOST" "$SITES_ENABLED/$SSL_VHOST"

nginx -t
systemctl start nginx
systemctl status nginx --no-pager

echo "=== NGINX OK ==="
EOF
chmod +x /root/FIX_NGINX_FIREINNERS_ROOT.sh
/root/FIX_NGINX_FIREINNERS_ROOT.sh
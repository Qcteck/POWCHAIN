cat >/root/FIX_TRADERONE_API_NGINX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
REPORT="/root/FIX_TRADERONE_API_NGINX_$TS.log"

NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
BACKUP="$NGINX_SITE.bak.$TS"

echo "=== FIX TRADERONE API NGINX ===" | tee "$REPORT"

############################
# 1) Backup
############################
cp -a "$NGINX_SITE" "$BACKUP"
echo "[OK] Backup: $BACKUP" | tee -a "$REPORT"

############################
# 2) Inject API location if missing
############################
if ! grep -q "traderone/api" "$NGINX_SITE"; then
echo "[*] Injecting TraderOne API location" | tee -a "$REPORT"

sed -i '/location \/wolverine\/ {/a\
    location /wolverine/traderone/api/ {\
        proxy_pass http://127.0.0.1:3000; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
    }\
' "$NGINX_SITE"

echo "[OK] API location added" | tee -a "$REPORT"
else
echo "[OK] API location already present" | tee -a "$REPORT"
fi

############################
# 3) Test & reload nginx
############################
echo "[*] Testing nginx config" | tee -a "$REPORT"
nginx -t

echo "[*] Reloading nginx" | tee -a "$REPORT"
nginx -s reload

echo "=== DONE: API ROUTING FIXED ===" | tee -a "$REPORT"
echo "Report: $REPORT"
BASH

chmod +x /root/FIX_TRADERONE_API_NGINX.sh
/root/FIX_TRADERONE_API_NGINX.sh
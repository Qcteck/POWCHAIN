set -euo pipefail

EN="/etc/nginx/sites-enabled"
DIS="/etc/nginx/sites-disabled/cleanup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$DIS"

echo "=== A) Déplacer tous les backups hors de sites-enabled (sinon nginx les charge) ==="
shopt -s nullglob
for f in "$EN"/*bak* "$EN"/*before_edit* "$EN"/*dupe* "$EN"/*rm_tests* "$EN"/*.bak.*; do
  mv "$f" "$DIS/" && echo "Moved: $f -> $DIS/"
done
shopt -u nullglob

echo "=== B) Corriger tous les include /etc/nginx/snippets/*.conf cassés ==="
while IFS= read -r line; do
  file="${line%%:*}"
  inc="$(echo "$line" | sed -n 's/.*include\s\+\([^;]*\.conf\);.*/\1/p')"
  [ -n "$inc" ] || continue
  [ -f "$inc" ] && continue

  alt="${inc%.conf}.server.inc"
  cp -a "$file" "$file.bak.$(date +%s)" || true

  if [ -f "$alt" ]; then
    sed -i "s|include $inc;|include $alt;|g" "$file"
    echo "Patched: $file ($inc -> $alt)"
  else
    sed -i "\|include $inc;|d" "$file"
    echo "Removed: $file (include $inc;)"
  fi
done < <(grep -RIn --color=never 'include\s\+/etc/nginx/snippets/[^;]*\.conf;' /etc/nginx || true)

echo "=== C) Test + reload ==="
nginx -t
systemctl reload nginx
echo "✅ OK"
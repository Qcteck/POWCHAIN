<script>
(function(){
  const $=s=>document.querySelector(s);
  const term=$("#term"),termTag=$("#termTag"),title=$("#title"),subtitle=$("#subtitle"),clock=$("#clock");
  const wStatus=$("#wStatus"),wPub=$("#wPub"),balSol=$("#balSol"),balUsdc=$("#balUsdc"),apiOut=$("#apiOut");
  const apiBase=$("#apiBase");
  const log=(m)=>{term.textContent+=m+"\\n";term.scrollTop=term.scrollHeight;};
  const setTag=(t)=>termTag.textContent=t;
  const setPill=(el,txt,kind)=>{el.textContent=txt; el.style.borderColor= kind==="ok"?"rgba(54,211,153,.35)":kind==="bad"?"rgba(255,77,77,.35)":"rgba(255,255,255,.10)"; el.style.background= kind==="ok"?"rgba(54,211,153,.10)":kind==="bad"?"rgba(255,77,77,.10)":"rgba(255,255,255,.03)";};

  function tick(){const d=new Date();clock.textContent=d.toLocaleString();} setInterval(tick,1000); tick();

  const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
  const RPC=location.origin; // nginx doit proxy ou laisser le client utiliser Phantom default; ici on utilise cluster via wallet adapter si dispo

  let provider=null, pubkey=null;

  function haveLibs(){
    return (window.solanaWeb3 && window.solanaWeb3.PublicKey);
  }

  async function connect(){
    if(!window.solana || !window.solana.isPhantom){setTag("NO PHANTOM");log("[ERR] Phantom non détecté.");return;}
    provider=window.solana;
    const r=await provider.connect({onlyIfTrusted:false});
    pubkey = r.publicKey ? r.publicKey.toString() : (provider.publicKey?provider.publicKey.toString():null);
    setPill(wStatus,"CONNECTED","ok");
    wPub.textContent=pubkey||"—";
    log("[OK] Connected: "+(pubkey||"—"));
  }

  async function disconnect(){
    try{ if(provider && provider.disconnect) await provider.disconnect(); }catch(e){}
    provider=null; pubkey=null;
    setPill(wStatus,"DISCONNECTED","bad");
    wPub.textContent="—"; balSol.textContent="—"; balUsdc.textContent="—";
    log("[OK] Disconnected");
  }

  async function refreshBalances(){
    if(!pubkey){setTag("NO WALLET");log("[ERR] Connect wallet first.");return;}
    if(!haveLibs()){setTag("NO LIBS");log("[WARN] libs Solana manquantes (/vendor). Balances non dispo.");return;}
    setTag("BALANCES…");
    const {Connection,PublicKey,LAMPORTS_PER_SOL} = solanaWeb3;

    // RPC: on utilise l’endpoint du wallet si possible, sinon mainnet-beta public (fallback)
    const endpoints=[
      "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",
      "https://api.mainnet-beta.solana.com"
    ];
    let conn=null, lastErr=null;
    for(const ep of endpoints){
      try{conn=new Connection(ep,{commitment:"confirmed"}); await conn.getLatestBlockhash(); lastErr=null; break;}catch(e){lastErr=e; conn=null;}
    }
    if(!conn){setTag("RPC FAIL");log("[ERR] RPC unreachable: "+(lastErr?lastErr.message:lastErr));return;}

    const owner=new PublicKey(pubkey);
    const lam=await conn.getBalance(owner,"confirmed");
    balSol.textContent=(lam/LAMPORTS_PER_SOL).toFixed(6);

    // USDC sum via parsed token accounts
    let usdc=0;
    try{
      const accts=await conn.getParsedTokenAccountsByOwner(owner,{programId:new PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")},"confirmed");
      for(const it of accts.value){
        const info=it.account.data.parsed.info;
        if(info && info.mint===USDC_MINT){
          const ui=info.tokenAmount && info.tokenAmount.uiAmount;
          if(typeof ui==="number") usdc+=ui;
        }
      }
    }catch(e){log("[WARN] USDC read fail: "+e.message);}
    balUsdc.textContent=usdc.toFixed(2);
    setTag("READY");
    log("[OK] Balances updated");
  }

  async function apiPing(){
    const base=(apiBase.value||"/wolverine/traderone/api").trim();
    setTag("API…");
    try{
      const r=await fetch(base.replace(/\\/$/,"")+"/health",{cache:"no-store"});
      const t=await r.text();
      apiOut.textContent=r.status+" "+t.slice(0,160);
      setTag(r.ok?"API OK":"API ERR");
      log("[API] "+r.status+" "+t.slice(0,120));
    }catch(e){
      apiOut.textContent="ERR "+e.message;
      setTag("API FAIL");
      log("[ERR] API ping: "+e.message);
    }
  }

  async function postJson(url,obj){
    const r=await fetch(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(obj),cache:"no-store"});
    const t=await r.text();
    log("[POST] "+url+" -> "+r.status+" "+t.slice(0,140));
    return {status:r.status, body:t};
  }

  function setRoute(route){
    [...document.querySelectorAll("#nav a")].forEach(a=>a.classList.toggle("active",a.dataset.route===route));
    title.textContent=route.charAt(0).toUpperCase()+route.slice(1);
    subtitle.textContent=location.origin+"/wolverine/ • route #/"+route;
    log("\\n[ROUTE] "+route);
  }

  function bootRoute(){
    const h=(location.hash||"#/dashboard").replace(/^#\\//,"");
    setRoute(h||"dashboard");
  }

  document.querySelectorAll("#nav a").forEach(a=>a.addEventListener("click",()=>setRoute(a.dataset.route)));
  window.addEventListener("hashchange",bootRoute);

  $("#btnConnect").onclick=()=>connect();
  $("#btnDisconnect").onclick=()=>disconnect();
  $("#btnRefresh").onclick=()=>refreshBalances();
  $("#btnHealth").onclick=()=>apiPing();
  $("#btnMode").onclick=()=>postJson((apiBase.value||"/wolverine/traderone/api").replace(/\\/$/,"")+"/mode",{mode:"paper",ts:Date.now()});
  $("#btnWithdraw").onclick=()=>postJson((apiBase.value||"/wolverine/traderone/api").replace(/\\/$/,"")+"/withdraw",{to:pubkey||null,all:true,ts:Date.now()});

  setPill(wStatus,"DISCONNECTED","bad");
  bootRoute();
  log("[BOOT] UI loaded");
})();
</script>
</body></html>

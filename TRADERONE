#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

echo "=== RESTORE FIREINNERS SSL VHOST (SAFE) ==="

# 1) Trouver le dernier backup
LAST_BAK="$(ls -1t ${VHOST}.bak_* 2>/dev/null | head -n1)"

if [ -z "${LAST_BAK}" ]; then
  echo "❌ Aucun backup trouvé pour ${VHOST}"
  exit 1
fi

echo "✔ Backup trouvé : ${LAST_BAK}"

# 2) Restaurer le vhost
cp -f "${LAST_BAK}" "${VHOST}"
echo "✔ Vhost restauré depuis backup"

# 3) Test NGINX
echo "== nginx -t =="
nginx -t

# 4) Reload NGINX
systemctl reload nginx
echo "✔ NGINX reload OK"

echo "=== RESTORE TERMINÉ ==="
echo "➡️ CTRL + F5 dans le navigateur"
set -e
cd /root

echo "=== 1) Cherche fichiers de clé possibles ==="
ls -lah /root/x_api_key_*.txt 2>/dev/null || echo "OK: aucun /root/x_api_key_*.txt"

echo
echo "=== 2) Cherche d'autres fichiers récents qui contiennent la clé (pattern hex 64) ==="
# Liste les fichiers txt récents (si tu en as) sans afficher leur contenu
find /root -maxdepth 1 -type f -name "*.txt" -printf "%TY-%Tm-%Td %TH:%TM %p\n" 2>/dev/null | tail -n 30 || true

echo
echo "=== 3) Si tu veux supprimer TOUS les x_api_key_*.txt (au cas où) ==="
for f in /root/x_api_key_*.txt; do
  [ -e "$f" ] || continue
  echo "Delete: $f"
  if command -v shred >/dev/null 2>&1; then shred -u -z -n 3 "$f"; else rm -f "$f"; fi
done

echo
echo "=== 4) Vérif finale ==="
ls -lah /root/x_api_key_*.txt 2>/dev/null || echo "OK: plus aucun fichier de clé"
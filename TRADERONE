set -euo pipefail
TS="$(date +%s)"

REPO="/opt/fireinners/WOLVERINE"
DIST="/var/www/wolverine"

cd "$REPO"

echo "=== 1) Trouver un package.json qui a un script build ==="
PKG="$(find . -name package.json -not -path "*/node_modules/*" -print0 \
  | xargs -0 -I{} sh -c 'grep -q "\"build\"" "{}" && echo "{}"' | head -n 1 || true)"

if [ -z "${PKG:-}" ]; then
  echo "KO: aucun package.json avec script build dans $REPO"
  echo "Voici les scripts dispo dans TRADERONE (pour voir le vrai nom):"
  (cd "$REPO/TRADERONE" && npm run || true)
  exit 1
fi

APP_DIR="$(dirname "$PKG")"
echo "OK: frontend détecté -> $APP_DIR"

echo "=== 2) Pré-requis + Node ==="
apt-get update -y >/dev/null
apt-get install -y rsync curl >/dev/null
if ! command -v node >/dev/null 2>&1; then
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash - >/dev/null
  apt-get install -y nodejs >/dev/null
fi

echo "=== 3) Choisir le bon package manager ==="
PM="npm"
[ -f "$APP_DIR/pnpm-lock.yaml" ] && PM="pnpm"
[ -f "$APP_DIR/yarn.lock" ] && PM="yarn"

if [ "$PM" = "pnpm" ] && ! command -v pnpm >/dev/null 2>&1; then
  npm i -g pnpm
fi
if [ "$PM" = "yarn" ] && ! command -v yarn >/dev/null 2>&1; then
  npm i -g yarn
fi

echo "=== 4) Build (base /wolverine/) ==="
cd "$APP_DIR"

# si Vite l’utilise, parfait; sinon ça ne casse rien
cat > .env.production <<'EOF'
VITE_BASE=/wolverine/
VITE_API_BASE=/wolverine/traderone/api
EOF

if [ "$PM" = "pnpm" ]; then
  pnpm install
  pnpm run build
elif [ "$PM" = "yarn" ]; then
  yarn install
  yarn build
else
  npm install
  npm run build
fi

OUT=""
for d in dist build out; do
  [ -d "$APP_DIR/$d" ] && OUT="$APP_DIR/$d" && break
done
[ -n "$OUT" ] || { echo "KO: pas de dist/build/out après build"; exit 1; }

echo "=== 5) Deploy => /var/www/wolverine (backup de l'actuel) ==="
if [ -d "$DIST" ]; then
  mv "$DIST" "/var/www/wolverine_backup_$TS"
fi
mkdir -p "$DIST"
rsync -a --delete "$OUT/" "$DIST/"

chmod -R 755 /var/www
find "$DIST" -type f -exec chmod 644 {} \;

echo "=== 6) Preuve ==="
grep -i "<title>" -n "$DIST/index.html" | head -n 3 || true
ls -lah "$DIST" | head -n 20

echo "DONE ✅"
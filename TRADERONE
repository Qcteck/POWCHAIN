bash <<'BATCH'
set -e

echo "======================================"
echo "TRADERONE API LISTEN HARD FIX (FINAL)"
echo "======================================"

APP_NAME="traderone-vault"
APP_DIR="/opt/traderone-vault"
SERVER_JS="$APP_DIR/server.js"
PORT=9696

### 1) BACKUP
echo "[1/6] Backup server.js"
cp "$SERVER_JS" "$SERVER_JS.bak_$(date +%Y%m%d_%H%M%S)"

### 2) REMOVE ALL app.listen
echo "[2/6] Nettoyage anciens app.listen"
sed -i '/app\.listen(/d' "$SERVER_JS"

### 3) FORCE LISTEN 0.0.0.0:9696
echo "[3/6] Injection listen global"
cat >> "$SERVER_JS" <<EOF

/* ===== TRADERONE LISTEN FIX ===== */
const LISTEN_PORT = process.env.PORT || $PORT;
app.listen(LISTEN_PORT, "0.0.0.0", () => {
  console.log("🔥 TraderOne API listening on", LISTEN_PORT);
});
/* ===== END LISTEN FIX ===== */
EOF

### 4) RESTART PM2 CLEAN
echo "[4/6] Restart PM2 clean"
pm2 delete "$APP_NAME" || true
pm2 start "$SERVER_JS" --name "$APP_NAME"
pm2 save
sleep 2

### 5) TEST API LOCALE
echo "[5/6] Test API locale"
if curl -s http://127.0.0.1:$PORT/wolverine/traderone/api/health | grep -q '"ok":true'; then
  echo "✅ API locale OK"
else
  echo "❌ API locale KO"
  pm2 logs "$APP_NAME" --lines 20
  exit 1
fi

### 6) TEST API PUBLIQUE
echo "[6/6] Test API publique"
if curl -s https://fireinners.online/wolverine/traderone/api/health | grep -q '"ok":true'; then
  echo "✅ API publique OK"
else
  echo "❌ API publique KO"
  exit 1
fi

echo "======================================"
echo "✅ TRADERONE API 100% OPERATIONNEL"
echo "======================================"
BATCH
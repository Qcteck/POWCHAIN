cat >/root/traderone_where_is_live.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APP="/opt/traderone-opt"
echo "=== APP dir ==="
ls -lah "$APP" | sed -n '1,120p'
echo

echo "=== Which file is /opt/traderone-opt/server.js really? ==="
readlink -f "$APP/server.js" || true
stat "$APP/server.js" || true
echo

echo "=== If there are *.bad.* backups, list newest first ==="
ls -ltah "$APP"/server.js* 2>/dev/null | head -n 30 || true
echo

echo "=== Show first route lines from LIVE server.js (first 120 lines) ==="
sed -n '1,120p' "$APP/server.js" | nl -ba | sed -n '1,120p'
echo "DONE ✅"
BASH

chmod +x /root/traderone_where_is_live.sh
/root/traderone_where_is_live.sh
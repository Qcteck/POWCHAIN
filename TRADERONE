cat >"$VAULT_DIR/server.js" <<'JS'
const fs=require('fs'),path=require('path');
const express=require('express');
const {Keypair}=require('@solana/web3.js');

const app=express();
app.use(express.json({limit:'1mb'}));

const ROOT=__dirname;
const VAULTS=path.join(ROOT,'vaults');
const MAP=path.join(ROOT,'map.json');

function loadMap(){ try{ return JSON.parse(fs.readFileSync(MAP,'utf8')); }catch(e){ return {}; } }
function saveMap(m){ fs.writeFileSync(MAP, JSON.stringify(m,null,2), {mode:0o600}); }

function safeJson(res, code, obj){
  try{ res.status(code).set('content-type','application/json').send(JSON.stringify(obj)); }
  catch(e){ try{ res.status(500).set('content-type','application/json').send(JSON.stringify({ok:false,error:String(e&&e.message?e.message:e)})); }catch(_){ } }
}

app.get('/health',(req,res)=>safeJson(res,200,{ok:true,service:"vault-api"}));

app.get('/vault',(req,res)=>{
  const user=String((req.query.userPub||'')||'').trim();
  const m=loadMap();
  safeJson(res,200,{ok:true,userPub:user||null,vaultPub:(user && m[user])?m[user]:null});
});

app.post('/create',(req,res)=>{
  const user=String(((req.body&&req.body.userPub)||'')||'').trim();
  const m=loadMap();
  if(user && m[user]) return safeJson(res,200,{ok:true,userPub:user,vaultPub:m[user],existing:true});

  const kp=Keypair.generate();
  const vaultPub=kp.publicKey.toBase58();

  // IMPORTANT: store secretKey as JSON array (no bs58, no ESM issues)
  const secretArr=Array.from(kp.secretKey);
  const file=path.join(VAULTS, vaultPub+'.json');
  fs.writeFileSync(file, JSON.stringify({vaultPub,secretArr,createdAt:new Date().toISOString()},null,2), {mode:0o600});

  if(user){ m[user]=vaultPub; saveMap(m); }
  safeJson(res,200,{ok:true,userPub:user||null,vaultPub,existing:false});
});

const port=parseInt(process.env.PORT||'3010',10);
app.listen(port,'127.0.0.1',()=>console.log('vault-api listening',port));
JS


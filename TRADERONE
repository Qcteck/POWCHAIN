bash <<'BASH'
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
HTML="/var/www/wolverine/index.html"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"

echo "== [1] BACKUP =="
cp -a "$HTML" "${HTML}.bak_${TS}"
cp -a "$SITE" "${SITE}.bak_${TS}"
echo "✔ Backups OK"

echo "== [2] PATCH NGINX : route API PRIORITAIRE =="
python3 - <<'PY'
from pathlib import Path
p=Path("/etc/nginx/sites-available/fireinners.online-ssl")
s=p.read_text()

BLOCK = """
location ^~ /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
"""

if "/wolverine/traderone/api/" in s:
    print("✔ Route API déjà présente")
else:
    s = s.replace("location /wolverine/ {", BLOCK + "\nlocation /wolverine/ {")
    p.write_text(s)
    print("✔ Route API injectée AVANT frontend")
PY

echo "== [3] RELOAD NGINX =="
nginx -t
systemctl reload nginx

echo "== [4] PATCH FRONTEND : fetch FIXE =="
python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# force endpoint canonique
s=s.replace(
    'fetch(',
    'fetch("/wolverine/traderone/api/budget",'
)

# force JSON strict
if "Content-Type" not in s:
    s=s.replace(
        'fetch("/wolverine/traderone/api/budget",{',
        'fetch("/wolverine/traderone/api/budget",{method:"POST",headers:{"Content-Type":"application/json"},'
    )

# force payload
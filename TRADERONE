APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

# détecte ids si présents
BTN_START_ID="$(grep -oP 'const\s+btnStart\s*=\s*document\.getElementById\("\K[^"]+' "$APPJS" | head -n1 || true)"
BUDGET_ID="$(grep -oP 'const\s+budgetEl\s*=\s*document\.getElementById\("\K[^"]+' "$APPJS" | head -n1 || true)"
: "${BTN_START_ID:=btnStart}"
: "${BUDGET_ID:=budget}"

# enlève ancien bloc start si présent
perl -0777 -i -pe 's|/\*\s*WOLVERINE_START_FIX_BEGIN\s*\*/.*?/\*\s*WOLVERINE_START_FIX_END\s*\*/\s*||sg' "$APPJS" || true

cat >> "$APPJS" <<JS

/* WOLVERINE_START_FIX_BEGIN */
(function(){
  const btnStart = document.getElementById("${BTN_START_ID}");
  const budgetEl = document.getElementById("${BUDGET_ID}");
  if (!btnStart || !budgetEl) return;

  btnStart.onclick = async () => {
    try {
      if (typeof pubkey === "undefined" || !pubkey) { setStatus("Connecte d'abord ton wallet"); return; }

      const b = Number(budgetEl.value);
      if (!isFinite(b) || b <= 0) { setStatus("Budget invalide"); return; }

      setStatus("START en cours...");
      const r = await fetch("/wolverine/traderone/api/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ wallet: pubkey.toString(), budget: b })
      });

      const txt = await r.text();
      let j = null;
      try { j = JSON.parse(txt); } catch(e) {}

      if (!r.ok) {
        const msg = j?.error ? `${j.error} (botUsdc=${j.botUsdc ?? "?"}, needed=${j.needed ?? b})` : txt.slice(0,200);
        setStatus("REFUSÉ ❌ " + msg);
        console.log("START refused:", r.status, j || txt);
        return;
      }

      setStatus("START OK ✅");
      console.log("START ok:", j || txt);
    } catch (e) {
      setStatus("ERR " + (e?.message || e));
    }
  };
})();
/* WOLVERINE_START_FIX_END */

JS

echo "Patched START handler. Now Ctrl+F5 on /wolverine"
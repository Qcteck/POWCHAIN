PORT=9696
DOMAIN="fireinners.online"
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"

echo "== 1) Vérifie que le bloc proxy existe dans les 2 vhosts =="
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  echo "---- $f"
  [ -f "$f" ] || { echo "MISSING"; continue; }
  grep -nE 'WOLVERINE_TRADERONE_API_BEGIN|location \^~ /wolverine/traderone/api/|proxy_pass http://127\.0\.0\.1' "$f" || echo "NO BLOCK FOUND"
done
echo

echo "== 2) Test CORRECT (local HTTP) en forçant le Host (doit être JSON) =="
curl -sS -D- "http://127.0.0.1/wolverine/traderone/api/balances2?wallet=$WALLET" \
  -H "Host: $DOMAIN" | head -c 400
echo
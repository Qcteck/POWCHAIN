set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

SNIP="/etc/nginx/snippets/fireinners_test.conf"
WEB="/var/www/fireinners-test"
BACK="/etc/nginx.bak_fix500_$TS"

mkdir -p "$BACK"
cp -a /etc/nginx "$BACK/"

echo "=== 1) Logs nginx (cause exacte du 500) ==="
tail -n 120 /var/log/nginx/error.log || true

echo
echo "=== 2) Vérif fichiers / droits ==="
ls -lah "$WEB" | head -n 40 || true
namei -l "$WEB" || true

echo
echo "=== 3) Fix permissions ==="
chown -R www-data:www-data "$WEB" || true
chmod 0755 /var /var/www "$WEB" || true
chmod -R a+rX "$WEB" || true

echo
echo "=== 4) Fix snippet /test (anti-loop, alias propre) ==="
cat > "$SNIP" <<'NGX'
# /test -> /test/
location = /test { return 301 /test/; }

location ^~ /test/ {
  alias /var/www/fireinners-test/;
  index index.html;
  # IMPORTANT: avec alias, on NE met PAS /test/index.html ici (sinon boucle possible)
  try_files $uri $uri/ =404;
  add_header Cache-Control "no-store" always;
}
NGX

echo
echo "=== 5) Test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 6) Test local (reproduit l'extérieur) ==="
curl -I https://127.0.0.1/test/ --insecure -H "Host: fireinners.online" | head -n 25 || true
curl -I https://127.0.0.1/test/ --insecure -H "Host: www.fireinners.online" | head -n 25 || true
cat >/root/results_only.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
H="fireinners.online"

p () { curl -sk -o /dev/null -w "%{http_code}\n" "$1"; }
o () { curl -sk -o /dev/null -w "%{http_code}\n" --resolve ${H}:443:127.0.0.1 "$1"; }

echo "PUBLIC /wolverine/index.html: $(p https://$H/wolverine/index.html)"
echo "ORIGIN /wolverine/index.html: $(o https://$H/wolverine/index.html)"
echo "PUBLIC /wolverine/traderone/api/: $(p https://$H/wolverine/traderone/api/)"
echo "ORIGIN /wolverine/traderone/api/: $(o https://$H/wolverine/traderone/api/)"
BASH

chmod +x /root/results_only.sh
/root/results_only.sh
bash <<'BASH'
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== [1] Backup index.html =="
cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup OK"

echo "== [2] Patch FRONTEND fetch (endpoint + JSON strict) =="
python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")
orig=s

# URL API CANONIQUE
s=s.replace(
    'fetch(API',
    'fetch("/wolverine/traderone/api/budget"'
)

# Forcer POST + headers JSON
if 'Content-Type' not in s:
    s=s.replace(
        'fetch("/wolverine/traderone/api/budget", {',
        'fetch("/wolverine/traderone/api/budget", { method:"POST", headers:{"Content-Type":"application/json"},'
    )

# Payload canonique
s=s.replace(
    'body: JSON.stringify(payload)',
    'body: JSON.stringify({from:window.solana.publicKey.toString(),amount:b})'
)

if s==orig:
    print("⚠ Aucun changement (déjà patché ?)")
else:
    p.write_text(s)
    print("✔ Frontend PATCHÉ (endpoint JSON strict)")
PY

echo "== [3] Test API locale brute =="
curl -i -X POST http://127.0.0.1:3000/wolverine/traderone/api/budget \
 -H "Content-Type: application/json" \
 -d '{"from":"test","amount":0.001}' | head -n 5

echo "== [4] Test API publique brute =="
curl -i -X POST https://fireinners.online/wolverine/traderone/api/budget \
 -H "Content-Type: application/json" \
 -d '{"from":"test","amount":0.001}' | head -n 5

echo "== [5] Reload nginx =="
nginx -t && systemctl reload nginx

echo "== TERMINÉ =="
echo "➡ Si l’API renvoie JSON ici, l’UI fonctionnera."
BASH
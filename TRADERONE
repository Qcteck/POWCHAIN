#!/bin/bash
set -e

echo "🐺 WOLVERINE — MEGA OFFICIALIZE v1"
echo "================================="

TS=$(date +%Y%m%d_%H%M%S)
ARCHIVE_BASE="/var/www/_ARCHIVE_WOLVERINE_$TS"
LOG="/root/wolverine_megabatch_$TS.log"

exec > >(tee -a "$LOG") 2>&1

echo
echo "📁 Création dossier archive : $ARCHIVE_BASE"
mkdir -p "$ARCHIVE_BASE"

echo
echo "🧊 Gel des UIs concurrentes (aucune suppression)"

for d in \
  /var/www/_wolverine_ui \
  /var/www/html/wolverine \
  /var/www/fireinners/wolverine
do
  if [ -d "$d" ]; then
    echo "➡️  Archive $d"
    mv "$d" "$ARCHIVE_BASE/$(basename "$d")"
  else
    echo "✔️  $d absent"
  fi
done

echo
echo "🟢 UI OFFICIELLE CONSERVÉE : /var/www/wolverine"
ls -lah /var/www/wolverine | head -n 5

echo
echo "🧠 Backend TraderOne (statut service)"
systemctl status traderone.service --no-pager || true

echo
echo "🔌 Ports d’écoute Node"
ss -tulpen | grep -E "3000|8585" || true

echo
echo "🩺 Test API health"
curl -s -o /tmp/wolv_health.txt -w "%{http_code}\n" \
  http://127.0.0.1:3000/health || true
echo "↪️ Réponse brute :"
cat /tmp/wolv_health.txt || true

echo
echo "🧪 Test via Nginx proxy"
curl -s -o /tmp/wolv_proxy_health.txt -w "%{http_code}\n" \
  https://localhost/wolverine/traderone/api/health || true
echo "↪️ Réponse brute :"
cat /tmp/wolv_proxy_health.txt || true

echo
echo "📦 Repo officiel détecté"
cd /opt/fireinners/WOLVERINE
git status -sb || true

echo
echo "📌 Backend actif (source réelle)"
readlink -f /proc/$(pgrep -f traderone-opt/server.js | head -n1)/cwd || true

echo
echo "✅ MEGA BATCH TERMINÉ"
echo "📄 Log : $LOG"
echo "❄️ Aucun service arrêté"
echo "❌ Aucun fichier supprimé"
echo "✔️ Structure OFFICIELLE définie"
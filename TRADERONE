cat >/root/NGX_DISABLE_BROKEN_SSL_CONFD.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
NGX="/etc/nginx"
CONFD="$NGX/conf.d"
DIS="$NGX/disabled-conf.d"
BK="/root/BK_NGX_CONFD_${TS}"

say(){ echo "[$(date -u +'%Y-%m-%d %H:%M:%S UTC')] $*"; }

mkdir -p "$BK" "$DIS"

say "BACKUP -> $BK/nginx.tgz"
tar -czf "$BK/nginx.tgz" "$NGX" 2>/dev/null || tar -czf "$BK/nginx.tgz" "$NGX"

say "UNFREEZE chattr -i (best effort)"
if command -v chattr >/dev/null 2>&1; then
  chattr -i "$NGX/nginx.conf" 2>/dev/null || true
  find "$NGX" -maxdepth 2 -type f \( -name "*.conf" -o -name "*.inc" \) -print0 2>/dev/null | while IFS= read -r -d '' f; do chattr -i "$f" 2>/dev/null || true; done
fi

disable_one(){
  local f="$1"
  [ -f "$f" ] || return 0
  local base="$(basename "$f")"
  local dst="$DIS/${base}.disabled_${TS}"
  say "DISABLE -> $dst"
  mv -f "$f" "$dst"
}

# 1) Disable the exact culprit if present
disable_one "$CONFD/aiaquila_server.conf"

# 2) Disable any other conf.d/*.conf that has listen ssl but no ssl_certificate
if [ -d "$CONFD" ]; then
  while IFS= read -r -d '' f; do
    # active listen ssl?
    if grep -Eq '^[[:space:]]*listen[[:space:]].*\bssl\b' "$f"; then
      # missing active ssl_certificate?
      if ! grep -Eq '^[[:space:]]*ssl_certificate[[:space:]]+' "$f"; then
        say "FOUND broken ssl (no ssl_certificate) in: $f"
        disable_one "$f"
      fi
    fi
  done < <(find "$CONFD" -maxdepth 1 -type f -name "*.conf" -print0 2>/dev/null)
fi

say "NGINX TEST"
if nginx -t; then
  say "RELOAD nginx"
  systemctl reload nginx
else
  say "ERROR: nginx -t failed. Showing top related lines:"
  nginx -T 2>/dev/null | grep -nE 'conf\.d/|aiaquila|listen.*ssl|ssl_certificate|ssl_certificate_key' | head -n 260 || true
  exit 1
fi

say "REFREEZE chattr +i (best effort)"
if command -v chattr >/dev/null 2>&1; then
  chattr +i "$NGX/nginx.conf" 2>/dev/null || true
fi

say "DONE. Backup: $BK/nginx.tgz"
echo "OPEN: https://fireinners.online/"
echo "OPEN: https://fireinners.online/wolverine/"
SH
chmod +x /root/NGX_DISABLE_BROKEN_SSL_CONFD.sh
bash /root/NGX_DISABLE_BROKEN_SSL_CONFD.sh
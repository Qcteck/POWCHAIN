set -e
cd /root

echo "=== 1) PID qui écoute sur 3000 ==="
PID="$(lsof -t -iTCP:3000 -sTCP:LISTEN | head -n 1 || true)"
echo "PID=$PID"
[ -n "$PID" ] || { echo "Rien n'écoute sur 3000"; exit 1; }

echo
echo "=== 2) CMD + CWD du process ==="
tr '\0' ' ' < /proc/$PID/cmdline; echo
CWD="$(readlink -f /proc/$PID/cwd)"
echo "CWD=$CWD"

echo
echo "=== 3) Cherche /api/status dans le bon dossier ==="
grep -RIn --line-number -E 'app\.post\(["'\''"]\/api\/status|\/api\/status' "$CWD" 2>/dev/null | head -n 50 || true

echo
echo "=== 4) Fallback: cherche 'internal:' dans le même dossier ==="
grep -RIn --line-number -E 'internal\s*:' "$CWD" 2>/dev/null | head -n 50 || true
cat > /root/TRADERONE_FIX_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== TRADERONE FINAL FIX (UI + API + RPC) ==="

UI="/var/www/wolverine/index.html"
API="/opt/traderone/server.js"
NGX="/etc/nginx/sites-available/fireinners.online-ssl"

TS=$(date +%s)

# 1) Backup
cp "$UI" "$UI.bak.$TS"
cp "$API" "$API.bak.$TS"
cp "$NGX" "$NGX.bak.$TS"

echo "[OK] Backups created"

# 2) Force RPC HTTPS in UI
sed -i \
  -E 's|new Connection\([^)]*\)|new Connection("https://lb.drpc.live/solana/AsxThpeKkEjGtZhCNUEQYo1ZluSgmwsR76RdFhW5UfFk","confirmed")|g' \
  "$UI"

echo "[OK] RPC HTTPS forced"

# 3) Disable all SPL / token account calls (SOL ONLY)
sed -i \
  -E 's|getParsedTokenAccountsByOwner|/* DISABLED SOL ONLY */ null|g' \
  "$UI"

echo "[OK] SPL calls neutralised"

# 4) Kill broken RegExp constructions
sed -i \
  -E 's|new RegExp\([^)]*\)|null|g' \
  "$UI"

echo "[OK] Broken RegExp removed"

# 5) Ensure backend API routes exist (budget + dryrun)
grep -q "/api/budget" "$API" || cat >> "$API" <<'JS'

app.post("/wolverine/traderone/api/budget",(req,res)=>{
  const { budgetSOL } = req.body || {};
  if(!budgetSOL || budgetSOL<=0) return res.status(400).json({error:"invalid budget"});
  global.TRADERONE_BUDGET_SOL = Number(budgetSOL);
  res.json({ok:true,budgetSOL:global.TRADERONE_BUDGET_SOL});
});

app.post("/wolverine/traderone/api/dryrun",(req,res)=>{
  res.json({ok:true,mode:"dry-run",note:"no execution"});
});
JS

echo "[OK] Backend API ensured"

# 6) Fix nginx to allow POST → Node
grep -q "traderone/api" "$NGX" || sed -i '/location \/wolverine {/a \
    location /wolverine/traderone/api/ {\n\
        proxy_pass http://127.0.0.1:3000;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    }\n' "$NGX"

nginx -t && systemctl reload nginx
echo "[OK] Nginx proxy fixed"

# 7) Restart backend
pm2 restart traderone-vault
pm2 save

echo "=== DONE: TRADERONE STABLE / SOL ONLY / NO UI ERRORS ==="
BASH

chmod +x /root/TRADERONE_FIX_FINAL.sh
/root/TRADERONE_FIX_FINAL.sh
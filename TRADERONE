set -e
cd /root

echo "=== 0) Cherche toutes les lignes proxy_set_header vides ==="
grep -RIn --line-number -E 'proxy_set_header[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;' \
  /etc/nginx/nginx.conf /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/snippets 2>/dev/null || true

echo
echo "=== 1) Backup des fichiers nginx qu'on va toucher ==="
mkdir -p /root/nginx_backups_full
for f in /etc/nginx/nginx.conf /etc/nginx/sites-enabled/* /etc/nginx/conf.d/* /etc/nginx/snippets/*; do
  [ -f "$f" ] || continue
  cp -n "$f" "/root/nginx_backups_full/$(echo "$f" | sed 's#/#__#g').bak" 2>/dev/null || true
done

echo
echo "=== 2) Fix global: remplit les headers connus, commente les inconnus, sépare si collés ==="
for f in /etc/nginx/nginx.conf /etc/nginx/sites-enabled/* /etc/nginx/conf.d/* /etc/nginx/snippets/*; do
  [ -f "$f" ] || continue

  perl -pi -e '
    # sépare si plusieurs directives sur la même ligne
    s/;\s*(proxy_set_header)/;\n  $1/g;

    # remplit les vides connus
    s/\bproxy_set_header\s+Host\s*;/proxy_set_header Host \$host;/g;
    s/\bproxy_set_header\s+X-Real-IP\s*;/proxy_set_header X-Real-IP \$remote_addr;/g;
    s/\bproxy_set_header\s+X-Forwarded-For\s*;/proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;/g;
    s/\bproxy_set_header\s+X-Forwarded-Proto\s*;/proxy_set_header X-Forwarded-Proto \$scheme;/g;

    # tout proxy_set_header encore vide -> commenté (pour ne plus casser nginx -t)
    s/^\s*(proxy_set_header\s+[A-Za-z0-9_-]+\s*;)\s*$/# FIX_REMOVED_EMPTY $1/mg;
  ' "$f"
done

echo
echo "=== 3) Re-scan: il ne doit plus rester de 'proxy_set_header XXX ;' non commenté ==="
grep -RIn --line-number -E '^[[:space:]]*proxy_set_header[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;' \
  /etc/nginx/nginx.conf /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/snippets 2>/dev/null || true

echo
echo "=== 4) nginx -t + reload ==="
nginx -t
systemctl reload nginx
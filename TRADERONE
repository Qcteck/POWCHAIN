add("AI",`Titre:\n${it.title}\n\nTags: ${(a.tags||[]).join(", ")||"—"}\nSentiment: ${a.sent||"—"}\nQualité: ${a.quality||0}/100 (${a.method})\n\nRésumé:\n${a.summary||"—"}\n\nLLM:\n${a.llm||"(LLM OFF)"}\n\nQuestion: focus PRIX ou NEWS?`,"ai");}

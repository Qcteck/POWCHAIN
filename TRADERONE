# 3) Patch nginx: /wolverine/ (alias) + /wolverine/api/ -> 127.0.0.1:3000/api/
MARK_BEGIN="# BEGIN WOLV_SINGLE_UI_V5"
MARK_END="# END WOLV_SINGLE_UI_V5"
BLOCK="$MARK_BEGIN
location ^~ /wolverine/api/ {
  rewrite ^/wolverine/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_read_timeout 60s;
}
location = /wolverine/ {
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  return 302 /wolverine/index.$TS.html;
}
location ^~ /wolverine/ {
  alias /opt/fireinners/frontend-react/app/dist/wolverine/;
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  try_files \$uri \$uri/ /index.$TS.html;
}
$MARK_END"


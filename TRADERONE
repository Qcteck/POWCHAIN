
bash <<'EOF'
set -e

TARGET="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
BACKUP="$TARGET.bak.$(date +%s)"

echo "[1/4] Backup UI"
cp "$TARGET" "$BACKUP"

echo "[2/4] Writing Wolverine UI"

cat > "$TARGET" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>TraderOne</title>
<style>
body{background:#0b1020;color:#fff;font-family:system-ui;margin:0}
#c{max-width:900px;margin:20px auto;padding:16px}
button,input{padding:10px 14px;border-radius:10px;border:0;margin:6px}
input{width:100%}
</style>
</head>
<body>
<div id="c">
<h2>TraderOne</h2>

<button id="con">Connect Phantom</button>
<div>Wallet: <span id="addr">-</span></div>

<div>Internal SOL: <b id="int">-</b></div>
<div>Phantom SOL: <b id="pha">-</b></div>

<input id="amt" placeholder="Budget SOL"/>
<button id="start">Start</button>
<button id="stop">Stop</button>
<button id="cash">Cash-out</button>

<pre id="log"></pre>
</div>

<script src="/wolverine/vendor/web3.min.js"></script>
<script>
const log=t=>document.querySelector("#log").textContent+=t+"\\n";
let pub=null;

async function getBalances(){
  const r=await fetch("/api/balances",{headers:pub?{"x-phantom":pub}:{}})
  const j=await r.json();
  document.querySelector("#int").textContent=j.internal?.toFixed(4)+" SOL";
  document.querySelector("#pha").textContent=j.phantom?j.phantom.toFixed(4)+" SOL":"-";
}

document.querySelector("#con").onclick=async()=>{
  const p=window.solana;if(!p)return alert("Install Phantom");
  const r=await p.connect();
  pub=r.publicKey.toString();
  document.querySelector("#addr").textContent=pub;
  await getBalances();
};

async function post(u,o){
  return fetch(u,{
    method:"POST",
    headers:{"content-type":"application/json"},
    body:JSON.stringify(o||{})
  });
}

document.querySelector("#start").onclick=async()=>{
  const amt=parseFloat(document.querySelector("#amt").value||"0");
  if(!pub||amt<=0)return alert("Connect Phantom + budget");
  await post("/api/start",{phantom:pub,amount:amt});
  log("START "+amt+" SOL");
  setTimeout(getBalances,1500);
};

document.querySelector("#stop").onclick=async()=>{
  await post("/api/stop");
  log("STOP");
};

document.querySelector("#cash").onclick=async()=>{
  await post("/api/cashout",{phantom:pub});
  log("CASHOUT");
  setTimeout(getBalances,1500);
};
</script>
</body>
</html>
HTML

echo "[3/4] Reload nginx"
nginx -t && systemctl reload nginx

echo "[4/4] DONE"
echo "Backup: $BACKUP"
echo "URL: https://www.fireinners.online/wolverine"
EOF
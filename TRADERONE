U.q("#btnBot").onclick=async()=>U.log("bot monitor via TG (server-side)","ok");
U.q("#btnPing").onclick=ping;
U.q("#btnLoop").onclick=async()=>{U.log("loop toggle auto="+U.q("#auto").value,"ok")};

(async()=>{try{const cfg=await config();if(cfg&&cfg.custodyPubkey)U.q("#custBal").textContent=(cfg.custodyBal||"-");await ping();await refresh()}catch(e){U.err("boot error")}})();

let lastRun=0;
async function loop(){try{const on=U.q("#auto").value==="1";if(on){const st=await refresh();const fast=st&&st.running;const delay=fast?S.pollFast:S.pollSlow;lastRun=Date.now();setTimeout(loop,delay);}else setTimeout(loop,800);}catch(_){setTimeout(loop,1200)}}
loop();
})();

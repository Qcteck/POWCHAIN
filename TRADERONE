cat >/tmp/MEGA_WOLVERINE_CHMOD_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
[ "$(id -u)" = "0" ] || { echo "ERREUR: lance en root"; exit 1; }

WEBDIR="/opt/fireinners/frontend-react/app/dist/wolverine"
INDEX="$WEBDIR/index.html"

echo "=== PRE-FLY ==="
nginx -t >/dev/null && echo "NGINX: OK"

echo "=== FIND SCRIPT (tmp) ==="
CAND="$(ls -1t /tmp/MEGA_WOLVERINE_*FRONT*.sh 2>/dev/null | head -n 1 || true)"
if [ -z "${CAND:-}" ]; then
  echo "Aucun script /tmp/MEGA_WOLVERINE_*FRONT*.sh trouvé. Je patch quand même les perms du front."
else
  echo "SCRIPT=$CAND"
  if grep -q 'chmod "\$n" "\$p"' "$CAND" 2>/dev/null; then
    echo "Patch: chmod \"\$n\" \"\$p\" -> chmod 0644 \"\$p\""
    sed -i 's/chmod "\$n" "\$p"/chmod 0644 "\$p"/g' "$CAND"
  fi
  if grep -q "chmod '\\$n' '\\$p'" "$CAND" 2>/dev/null; then
    sed -i "s/chmod '\\$n' '\\$p'/chmod 0644 '\\$p'/g" "$CAND"
  fi
  if grep -q 'chmod "\$n" \$p' "$CAND" 2>/dev/null; then
    sed -i 's/chmod "\$n" \$p/chmod 0644 "\$p"/g' "$CAND"
  fi
  echo "SCRIPT PATCHED (if needed)."
fi

echo "=== FIX PERMS (front) ==="
mkdir -p "$WEBDIR"
chattr -i "$INDEX" 2>/dev/null || true
chmod 0755 "$WEBDIR"
[ -f "$INDEX" ] && chmod 0644 "$INDEX" || true

echo "=== NGINX RELOAD ==="
nginx -t
systemctl reload nginx

echo "=== TESTS ==="
echo "-- front head --"
curl -sS https://fireinners.online/wolverine/ | head -c 220; echo
echo "-- ping --"
curl -sS https://fireinners.online/wolverine/api/ping | head -c 20; echo
echo "DONE."
BASH
bash /tmp/MEGA_WOLVERINE_CHMOD_FIX.sh
cat > /root/TRADERONE_UI_BUDGET_SOL_FIXED.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

UI_HTML="/var/www/wolverine/index.html"
BACKEND="/opt/traderone/server.js"
REPORT="/root/TRADERONE_UI_BUDGET_SOL_$(date +%Y%m%d_%H%M%S).log"

echo "=== TRADERONE UI BUDGET SOL FIXED ===" | tee "$REPORT"

### 1) BACKUP
cp "$UI_HTML" "$UI_HTML.bak.$(date +%s)"
cp "$BACKEND" "$BACKEND.bak.$(date +%s)"
echo "[OK] Backups done" | tee -a "$REPORT"

### 2) PATCH UI (SAFE)
python3 <<'PY'
from pathlib import Path

p = Path("/var/www/wolverine/index.html")
html = p.read_text(errors="ignore")

if "sendBudgetSOL" in html:
    print("UI already patched")
    exit(0)

BLOCK = """
<div style="margin-top:10px">
  <input id="budgetSol" type="number" step="0.001" min="0.001" placeholder="Budget SOL">
  <button id="sendBudgetSOL">Envoyer à TraderOne</button>
</div>
<pre id="budgetStatus"></pre>

<script>
(() => {
  const API="/wolverine/traderone/api/budget";
  const btn=document.getElementById("sendBudgetSOL");
  if(!btn) return;

  btn.onclick=async()=>{
    try{
      if(!window.solana||!window.solana.publicKey) throw "Wallet non connecté";
      const b=parseFloat(document.getElementById("budgetSol").value);
      if(!b||b<=0) throw "Budget invalide";

      const r=await fetch(API,{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({pubkey:window.solana.publicKey.toString(),budgetSOL:b})
      });
      const j=await r.json();
      document.getElementById("budgetStatus").textContent="OK "+JSON.stringify(j);
    }catch(e){
      document.getElementById("budgetStatus").textContent="ERREUR "+e;
    }
  };
})();
</script>
"""

html = html.replace("</body>", BLOCK + "\n</body>")
p.write_text(html)
print("UI patched successfully")
PY

echo "[OK] UI patched" | tee -a "$REPORT"

### 3) BACKEND ENDPOINT (SAFE APPEND)
grep -q 'api/budget' "$BACKEND" || cat >> "$BACKEND" <<'JS'

app.post("/api/budget",(req,res)=>{
  const {pubkey,budgetSOL}=req.body||{};
  if(!pubkey||!budgetSOL||budgetSOL<=0)
    return res.status(400).json({error:"invalid_budget"});
  if(!global.db) global.db={};
  if(!db[pubkey]) db[pubkey]={sol:0};
  db[pubkey].budgetSOL=Number(budgetSOL);
  console.log("[TRADERONE] Budget SOL",pubkey,budgetSOL);
  res.json({ok:true,budgetSOL});
});
JS

echo "[OK] Backend endpoint ready" | tee -a "$REPORT"

### 4) RELOAD
nginx -s reload
pm2 restart traderone-vault || pm2 restart traderone || true

echo "[OK] Services reloaded" | tee -a "$REPORT"
echo "DONE. REPORT: $REPORT"
BASH

chmod +x /root/TRADERONE_UI_BUDGET_SOL_FIXED.sh
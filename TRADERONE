import os, re, subprocess, sys, shutil, datetime, textwrap

BK=os.environ.get("BK")
DOMAIN=os.environ.get("DOMAIN","fireinners.online")
PATH_OK=os.environ.get("PATH_OK","/aquila_stacking/")
WEBROOT=os.environ.get("WEBROOT","/var/www/aquila_stacking")
TAG="AQUILA_STACKING_ONESHOT_V7"

def run(cmd):
    return subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True)

ngT = run(["nginx","-T"])
open(os.path.join(BK,"nginx.T.txt"),"w").write(ngT)

# --- locate first server block (in nginx -T order) that has server_name DOMAIN and listen 443 ---
cur_file=None
best_file=None

lines=ngT.splitlines()
i=0
while i < len(lines):
    line=lines[i]
    m=re.match(r"^# configuration file (\S+):\d+", line)
    if m:
        cur_file=m.group(1)
        i+=1
        continue

    if re.match(r"^\s*server\s*\{\s*$", line):
        start_file=cur_file
        depth=0
        block=[]
        # read block with brace tracking
        j=i
        while j < len(lines):
            l=lines[j]
            block.append(l)
            depth += l.count("{")
            depth -= l.count("}")
            if depth==0 and j>i:
                break
            j+=1
        blk="\n".join(block)
        has_name = re.search(r"server_name\s+[^;]*\b"+re.escape(DOMAIN)+r"\b", blk) is not None
        has_443  = re.search(r"listen\s+[^;]*\b443\b", blk) is not None
        if has_name and has_443 and start_file and os.path.isfile(start_file):
            best_file=start_file
            break
        i=j+1
        continue

    i+=1

if not best_file:
    raise SystemExit(f"no active 443 server block found for {DOMAIN} in nginx -T (see {BK}/nginx.T.txt)")

# backup target file
base=os.path.basename(best_file).replace("/","_")
shutil.copy2(best_file, os.path.join(BK, f"active_vhost_{base}.bak"))

# --- patch target file: insert location block inside matching 443 server{} (domain) ---
src=open(best_file,"r").read()

loc_block=textwrap.dedent(f"""\
  # {TAG} BEGIN
  location = /aquilastacking {{ return 301 {PATH_OK}; }}
  location ^~ /aquilastacking/ {{ return 301 {PATH_OK}; }}
  location = {PATH_OK.rstrip('/')} {{ return 301 {PATH_OK}; }}
  location ^~ {PATH_OK} {{
    alias {WEBROOT}/;
    index index.html;
    try_files $uri $uri/ {PATH_OK}index.html;
    add_header Cache-Control "no-store" always;
  }}
  # {TAG} END
""")

def patch_servers(text:str)->tuple[str,int]:
    out=[]
    n=len(text)
    pos=0
    patched=0

    # scan for "server" blocks with brace matching
    pat=re.compile(r"\bserver\s*\{", re.M)
    for m in pat.finditer(text):
        s=m.start()
        # append chunk before this server
        out.append(text[pos:s])
        # find opening brace
        brace_pos=text.find("{", s)
        if brace_pos==-1:
            out.append(text[s:]); pos=n; break
        # walk braces
        depth=0
        k=brace_pos
        while k < n:
            if text[k]=="{": depth+=1
            elif text[k]=="}":
                depth-=1
                if depth==0:
                    end=k+1
                    break
            k+=1
        else:
            out.append(text[s:]); pos=n; break

        block=text[s:end]
        # decide if this server block should be patched
        has_name = re.search(r"server_name\s+[^;]*\b"+re.escape(DOMAIN)+r"\b", block) is not None
        has_443  = re.search(r"listen\s+[^;]*\b443\b", block) is not None

        if has_name and has_443 and (TAG not in block):
            lines=block.splitlines(True)
            # find insert point: before first "location" line, else before final "}"
            ins=None
            for idx,ln in enumerate(lines):
                if re.match(r"^\s*location\s+", ln):
                    ins=idx
                    break
            if ins is None:
                # insert before last closing brace line
                ins=len(lines)-1
            # ensure block ends with newline before brace (best effort)
            lines.insert(ins, loc_block + ("\n" if not loc_block.endswith("\n") else ""))
            block="".join(lines)
            patched+=1

        out.append(block)
        pos=end

    out.append(text[pos:])
    return "".join(out), patched

new, cnt = patch_servers(src)
if cnt==0:
    # still write unchanged? no. fail to force visibility
    raise SystemExit(f"target vhost {best_file} had no patchable server{{}} blocks (or already patched).")

# write back with a direct .bak timestamp too
shutil.copy2(best_file, best_file+f".bak.{datetime.datetime.utcnow().strftime('%Y%m%d_%H%M%S')}")
open(best_file,"w").write(new)

print(f"[OK] active 443 vhost patched: {best_file} (server blocks patched: {cnt})")

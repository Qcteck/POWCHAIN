#!/bin/bash
set -e

echo "🐺 WOLVERINE — MEGA UI PATCH v3 (FULL PAGE FIT)"
echo "=============================================="

UI="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)
BACKUP="/var/www/_BACKUP_WOLVERINE_UI_V3_$TS"
LOG="/root/wolverine_ui_v3_$TS.log"

exec > >(tee -a "$LOG") 2>&1

[ -f "$UI" ] || { echo "❌ UI introuvable"; exit 1; }

echo "📦 Backup UI"
mkdir -p "$BACKUP"
cp -a "$UI" "$BACKUP/"

grep -q "WOLVERINE_FULLPAGE_PATCH" "$UI" && {
  echo "✔️ Patch déjà appliqué"
  exit 0
}

echo "✏️ Injection CSS full-page (no scroll)"

sed -i "/<\/head>/i \
<!-- WOLVERINE_FULLPAGE_PATCH -->\
<style>\
html,body{width:100%;height:100%;margin:0;padding:0;overflow:hidden}\
body{display:flex}\
#app{display:flex;flex-direction:row;width:100vw;height:100vh;overflow:hidden}\
.sidebar{flex:0 0 220px;overflow:hidden}\
.content{flex:1;display:flex;flex-direction:column;overflow:hidden}\
.topbar{flex:0 0 auto}\
.main{flex:1;overflow:hidden;padding:8px}\
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:8px;height:100%}\
.panel{min-height:0;overflow:hidden}\
canvas{max-width:100%!important;max-height:100%!important}\
iframe{max-width:100%!important;max-height:100%!important;border:0}\
@media(max-width:768px){\
.sidebar{flex:0 0 60px}\
.main{padding:6px}\
}\
@media(max-width:480px){\
.sidebar{display:none}\
}\
</style>" "$UI"

echo "🧪 Vérification overflow"
grep -q "overflow:hidden" "$UI" && echo "✔️ Overflow verrouillé"

echo
echo "✅ MEGA UI PATCH v3 TERMINÉ"
echo "📄 Backup : $BACKUP"
echo "📄 Log    : $LOG"
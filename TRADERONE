cat >/root/MEGA_AGENTIA_DEPLOY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

# === CONFIG ===
APP="agentia"
APP_DIR="/opt/${APP}"
PORT="9697"
HOST="127.0.0.1"
SVC="${APP}.service"
NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGX_INC="/etc/nginx/includes/${APP}_routes.inc"
DATA_DIR="${APP_DIR}/data"
PUB_DIR="${APP_DIR}/public"
TS="$(date +%Y%m%d_%H%M%S)"

need_root(){ [ "$(id -u)" -eq 0 ] || { echo "ERROR: run as root"; exit 1; }; }
cmd(){ echo "+ $*"; "$@"; }

# Optional askorupdate helpers (safe file update + chattr handling)
ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  source "$ASKLIB"
else
  askorupdate_file(){
    local dst="$1"; local tmp="$2"
    mkdir -p "$(dirname "$dst")"
    [ -f "$dst" ] && cp -a "$dst" "${dst}.bak_${TS}" || true
    cp -a "$tmp" "$dst"
  }
  askorupdate_yesno(){ return 0; }
fi

install_node_if_missing(){
  if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
    echo "OK: node=$(node -v) npm=$(npm -v)"
    return 0
  fi
  echo "== Installing Node.js (NodeSource) =="
  cmd apt-get update -y
  cmd apt-get install -y ca-certificates curl gnupg
  cmd install -d -m 0755 /etc/apt/keyrings
  cmd bash -lc 'curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg'
  cmd bash -lc 'echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list'
  cmd apt-get update -y
  cmd apt-get install -y nodejs
  echo "OK: node=$(node -v) npm=$(npm -v)"
}

write_backend(){
  mkdir -p "$APP_DIR" "$DATA_DIR" "$PUB_DIR"
  cat >"${APP_DIR}/server.js" <<'JS'
'use strict';
const path=require('path');
const fs=require('fs');
const express=require('express');
const helmet=require('helmet');
const compression=require('compression');
const Database=require('better-sqlite3');

const APP='agentia';
const PORT=parseInt(process.env.PORT||'9697',10);
const BASE=(process.env.BASE_PATH||'/agentia').replace(/\/+$/,'');
const DATA_DIR=process.env.DATA_DIR||path.join(__dirname,'data');
const DB_PATH=process.env.DB_PATH||path.join(DATA_DIR,'agentia.db');

fs.mkdirSync(DATA_DIR,{recursive:true});
const db=new Database(DB_PATH);
db.pragma('journal_mode = WAL');
db.exec(`
CREATE TABLE IF NOT EXISTS kv (k TEXT PRIMARY KEY, v TEXT NOT NULL, updated_at INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS decisions (id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS runs (id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, kind TEXT NOT NULL, input TEXT NOT NULL, output TEXT NOT NULL, score REAL, notes TEXT);
CREATE TABLE IF NOT EXISTS logs (id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, level TEXT NOT NULL, msg TEXT NOT NULL, meta TEXT);
`);

const setKV=db.prepare('INSERT INTO kv(k,v,updated_at) VALUES(?,?,?) ON CONFLICT(k) DO UPDATE SET v=excluded.v, updated_at=excluded.updated_at');
const getKV=db.prepare('SELECT v,updated_at FROM kv WHERE k=?');
const listKV=db.prepare('SELECT k,v,updated_at FROM kv ORDER BY k ASC');

const addDecision=db.prepare('INSERT INTO decisions(ts,title,body) VALUES(?,?,?)');
const listDecisions=db.prepare('SELECT id,ts,title,body FROM decisions ORDER BY id DESC LIMIT ?');
const getDecision=db.prepare('SELECT id,ts,title,body FROM decisions WHERE id=?');

const addRun=db.prepare('INSERT INTO runs(ts,kind,input,output,score,notes) VALUES(?,?,?,?,?,?)');
const listRuns=db.prepare('SELECT id,ts,kind,score,notes,input,output FROM runs ORDER BY id DESC LIMIT ?');

const addLog=db.prepare('INSERT INTO logs(ts,level,msg,meta) VALUES(?,?,?,?)');
function log(level,msg,meta){
  try{ addLog.run(Date.now(),String(level||'info'),String(msg||''), meta?JSON.stringify(meta):null); }catch(_){}
}

const app=express();
app.set('trust proxy', true);
app.use(helmet({contentSecurityPolicy:false}));
app.use(compression());
app.use(express.json({limit:'1mb'}));

app.get(`${BASE}/health`, (req,res)=>res.json({ok:true,app:APP,base:BASE,ts:Date.now()}));
app.get(`${BASE}/api/status`, (req,res)=>{
  const memCount=listKV.all().length;
  const decisionsCount=db.prepare('SELECT COUNT(1) c FROM decisions').get().c;
  const runsCount=db.prepare('SELECT COUNT(1) c FROM runs').get().c;
  res.json({ok:true,app:APP,base:BASE,db:DB_PATH,memCount,decisionsCount,runsCount,ts:Date.now()});
});

app.get(`${BASE}/api/memory`, (req,res)=>{ res.json({ok:true,items:listKV.all()}); });
app.get(`${BASE}/api/memory/:key`, (req,res)=>{
  const r=getKV.get(req.params.key);
  if(!r) return res.status(404).json({ok:false,error:'not_found'});
  res.json({ok:true,key:req.params.key,value:r.v,updated_at:r.updated_at});
});
app.post(`${BASE}/api/memory/:key`, (req,res)=>{
  const v=(req.body&&typeof req.body.value==='string')?req.body.value:JSON.stringify(req.body||{});
  setKV.run(req.params.key, v, Date.now());
  log('info','memory_set',{key:req.params.key,bytes:Buffer.byteLength(v||'')});
  res.json({ok:true,key:req.params.key});
});

app.post(`${BASE}/api/decisions`, (req,res)=>{
  const title=String((req.body&&req.body.title)||'');
  const body=String((req.body&&req.body.body)||'');
  if(!title || !body) return res.status(400).json({ok:false,error:'title_and_body_required'});
  const info=addDecision.run(Date.now(), title, body);
  log('info','decision_add',{id:info.lastInsertRowid,title});
  res.json({ok:true,id:info.lastInsertRowid});
});
app.get(`${BASE}/api/decisions`, (req,res)=>{
  const lim=Math.max(1,Math.min(200,parseInt(String(req.query.limit||'50'),10)||50));
  res.json({ok:true,items:listDecisions.all(lim)});
});
app.get(`${BASE}/api/decisions/:id`, (req,res)=>{
  const id=parseInt(req.params.id,10);
  const r=getDecision.get(id);
  if(!r) return res.status(404).json({ok:false,error:'not_found'});
  res.json({ok:true,item:r});
});

app.post(`${BASE}/api/runs`, (req,res)=>{
  const kind=String((req.body&&req.body.kind)||'');
  const input=String((req.body&&req.body.input)||'');
  const output=String((req.body&&req.body.output)||'');
  const score=(req.body&&req.body.score!=null)?Number(req.body.score):null;
  const notes=(req.body&&req.body.notes!=null)?String(req.body.notes):null;
  if(!kind || !input || !output) return res.status(400).json({ok:false,error:'kind_input_output_required'});
  const info=addRun.run(Date.now(), kind, input, output, Number.isFinite(score)?score:null, notes);
  log('info','run_add',{id:info.lastInsertRowid,kind,score});
  res.json({ok:true,id:info.lastInsertRowid});
});
app.get(`${BASE}/api/runs`, (req,res)=>{
  const lim=Math.max(1,Math.min(200,parseInt(String(req.query.limit||'50'),10)||50));
  res.json({ok:true,items:listRuns.all(lim)});
});

app.get(`${BASE}/api/logs`, (req,res)=>{
  const lim=Math.max(1,Math.min(200,parseInt(String(req.query.limit||'50'),10)||50));
  const rows=db.prepare('SELECT id,ts,level,msg,meta FROM logs ORDER BY id DESC LIMIT ?').all(lim);
  res.json({ok:true,items:rows});
});

app.use(`${BASE}/`, express.static(path.join(__dirname,'public'), {index:'index.html', maxAge:0, etag:false, lastModified:false}));

app.use((req,res)=>res.status(404).json({ok:false,error:'not_found'}));

app.listen(PORT, HOST=>{});
app.listen(PORT, '127.0.0.1', ()=>{ log('info','server_start',{port:PORT,base:BASE}); });

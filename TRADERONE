set -euo pipefail

REPO="/opt/fireinners/WOLVERINE"
DIST="/var/www/wolverine"
NG="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "=== 1) Node + deps ==="
apt-get update -y
apt-get install -y curl rsync git
if ! command -v node >/dev/null 2>&1; then
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt-get install -y nodejs
fi
node -v
npm -v

echo "=== 2) Build frontend ==="
cd "$REPO"

# Vite env (si tu n'es pas sur Vite, dis-moi et je te donne la variante)
cat > .env.production <<'EOF'
VITE_BASE=/wolverine/
VITE_API_BASE=/wolverine/traderone/api
EOF

npm ci
npm run build

echo "=== 3) Deploy dist => /var/www/wolverine ==="
mkdir -p "$DIST"
rsync -a --delete "$REPO/dist/" "$DIST/"
chmod -R 755 /var/www
find "$DIST" -type f -exec chmod 644 {} \;

echo "=== 4) Nginx: UI /wolverine sert /var/www/wolverine (sans casser l'API existante) ==="
cp -a "$NG" "$NG.bak.ui_deploy_$(date +%s)"

python3 - <<'PY'
from pathlib import Path
import re
ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# Supprime anciens blocs UI /wolverine (on ne touche pas à l'API)
for pat in [
  r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*',
]:
  s = re.sub(pat, "\n", s, flags=re.M)

block = r'''
# --- WOLVERINE UI (served from /var/www/wolverine) ---
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}
'''

i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: pas trouvé de '}' final dans le conf nginx")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: UI bloc inserted")
PY

nginx -t
systemctl reload nginx

echo "=== 5) Tests ==="
curl -sS -I https://fireinners.online/wolverine/ | head -n 12
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12
echo "DONE ✅"
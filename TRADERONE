cat >/root/MEGA_AQUILA_STACKING_DEPLOY_ROUTE_AQUILA_STAKING.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027
TS="$(date +%Y%m%d_%H%M%S)"
echo "== MEGA_AQUILA_STACKING_DEPLOY_ROUTE_AQUILA_STAKING @ $TS =="

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"

# Fixed paths (VPS FireInners)
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"
WEBROOT="/var/www/aquila_stacking"
HTML="${WEBROOT}/index.html"

# Existing AquilaStacking build path (from V7_100)
APP="/opt/aquila_stacking"
KEYS="${APP}/keys"
PROG="aquila_stacking"

BK="/root/AQUILA_STAKING_ROUTE_BK_${TS}"
mkdir -p "$BK"
cp -a "$VHOST" "$BK/fireinners.online-ssl.bak" || true
[ -f "$INC" ] && cp -a "$INC" "$BK/aquila_stacking_routes.inc.bak" || true
[ -d "$WEBROOT" ] && cp -a "$WEBROOT" "$BK/webroot_aquila_stacking.bak" || true

# Optional: reuse FireInners sentinel safe update helpers if present
ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp" <<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "deploy aquila_stacking route" || { rm -f "$tmp"; die "askorupdate_file failed for $path"; }
    rm -f "$tmp"
  else
    chattr -i "$path" 2>/dev/null || true
    cp -a "$path" "$path.bak.$TS" 2>/dev/null || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}

need(){ command -v "$1" >/dev/null 2>&1 || die "missing: $1"; }
need nginx

say "1) Ensure WEBROOT exists: $WEBROOT"
mkdir -p "$WEBROOT"
chmod 0755 "$WEBROOT"

say "2) Determine Program ID (if project exists)"
PID="UNKNOWN"
if [ -f "$KEYS/${PROG}-keypair.json" ] && command -v solana-keygen >/dev/null 2>&1; then
  PID="$(solana-keygen pubkey "$KEYS/${PROG}-keypair.json" 2>/dev/null || echo UNKNOWN)"
fi

say "3) Write public index.html for /aquila_stacking/"
if [ -f "/var/www/aquilastacking/index.html" ] && [ ! -f "$HTML" ]; then
  cp -a "/var/www/aquilastacking/index.html" "$HTML"
else
  cat >"$HTML"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><style>body{font-family:system-ui,Segoe UI,Arial;margin:24px;max-width:980px}code,pre{background:#0b1020;color:#d7e3ff;padding:10px;border-radius:10px;display:block;overflow:auto}h1{margin:0 0 12px}small{opacity:.8}</style></head><body>
<h1>AquilaStacking</h1>
<p><b>Program ID:</b> <code>${PID}</code></p>
<p><b>Workspace:</b> <code>${APP}</code></p>
<p><b>URL:</b> <code>/aquila_stacking/</code></p>
<p><small>Legacy route <code>/aquilastacking/</code> redirects here.</small></p>
</body></html>
EOF
fi
chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
chmod -R 0755 "$WEBROOT"

say "4) Write nginx include: $INC"
# Includes: serve /aquila_stacking/ and redirect legacy /aquilastacking/ -> /aquila_stacking/
write_file "$INC" "location = /aquilastacking { return 301 /aquila_stacking/; }
location ^~ /aquilastacking/ { return 301 /aquila_stacking/; }
location ^~ /aquila_stacking/ { alias ${WEBROOT}/; index index.html; try_files \$uri \$uri/ /aquila_stacking/index.html; add_header Cache-Control \"no-store\" always; }"

say "5) Ensure vhost includes $INC (deterministic, no duplicates, rollback if invalid)"
INC_LINE="include /etc/nginx/includes/aquila_stacking_routes.inc;"
MARKER="# AQUILA_STAKING_INCLUDE"

chattr -i "$VHOST" 2>/dev/null || true

if grep -qF "$INC_LINE" "$VHOST"; then
  say "Vhost already includes aquila_stacking routes"
else
  say "Appending include marker to vhost"
  cp -a "$VHOST" "$BK/fireinners.online-ssl.preappend.$TS" || true
  cat >>"$VHOST"<<EOF

${MARKER}
${INC_LINE}
# END_${MARKER}
EOF
fi

say "6) nginx -t (rollback on failure) + reload"
if ! nginx -t; then
  say "nginx -t failed: rolling back vhost/include"
  cp -a "$BK/fireinners.online-ssl.bak" "$VHOST" || true
  [ -f "$BK/aquila_stacking_routes.inc.bak" ] && cp -a "$BK/aquila_stacking_routes.inc.bak" "$INC" || true
  nginx -t || true
  die "nginx invalid; rolled back"
fi

systemctl reload nginx
chattr +i "$VHOST" 2>/dev/null || true

say "DONE"
say "URL: https://fireinners.online/aquila_stacking/"
say "Backup: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_DEPLOY_ROUTE_AQUILA_STAKING.sh
bash /root/MEGA_AQUILA_STACKING_DEPLOY_ROUTE_AQUILA_STAKING.sh
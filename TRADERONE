cat >/root/WOLVERINE_TRACE_REAL_ROOT.sh <<'BASH'
#!/usr/bin/env bash
set -e

echo "===== WOLVERINE REAL ROOT TRACE ====="

echo "---- NGINX CONFIG USED ----"
nginx -T | grep -E "server_name|root |location /wolverine" -n || true

echo
echo "---- SEARCHING INDEX.HTML CANDIDATES ----"
find / -type f -name index.html 2>/dev/null | grep -E "wolverine|fireinners|frontend|www" || true

echo
echo "---- INJECT VISUAL MARKER EVERYWHERE ----"

MARKER='
<div style="
position:fixed;
top:0;
left:0;
right:0;
z-index:999999;
background:red;
color:white;
font-size:22px;
font-weight:900;
padding:10px;
text-align:center;">
🔥 SERVED FILE: __FILE__ 🔥
</div>
'

while read -r f; do
  if grep -q "</body>" "$f"; then
    cp "$f" "$f.bak.$(date +%s)"
    sed -i "s|</body>|${MARKER//__FILE__/$(echo "$f" | sed 's|/|\\/|g')}</body>|" "$f"
    echo "✅ Injected marker into: $f"
  fi
done < <(find / -type f -name index.html 2>/dev/null | grep -E "wolverine|fireinners|frontend|www")

echo
echo "---- Reload nginx ----"
nginx -t && systemctl reload nginx

echo
echo "✅ DONE — Recharge la page (CTRL+SHIFT+R)"
BASH

chmod +x /root/WOLVERINE_TRACE_REAL_ROOT.sh
/root/WOLVERINE_TRACE_REAL_ROOT.sh
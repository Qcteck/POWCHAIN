# Tester depuis le serveur (en vrai HTTPS)
curl -kI https://fireinners.online/favicon.ico

# Tester en local sur nginx (si tu termines TLS dans nginx)
curl -kI https://127.0.0.1/favicon.ico -H 'Host: fireinners.online'

# Logs nginx pile au moment du 500
sudo tail -n 200 /var/log/nginx/error.log
sudo tail -n 200 /var/log/nginx/access.log | grep favicon
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX PHANTOM FINAL (WOLVERINE) ==="

[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

# Backup
cp -a "$HTML" "${HTML}.bak_${TS}"
echo "✔ Backup créé: ${HTML}.bak_${TS}"

# 1) Supprimer TOUT ancien connect phantom
sed -i '/connectWallet/d' "$HTML"
sed -i '/Phantom/d' "$HTML"

# 2) Injecter un VRAI bouton Phantom (HTML pur)
sed -i '/API:/i \
<button id="PHANTOM_CONNECT_BTN" type="button" style="margin-top:8px;padding:10px 12px;width:100%;background:#16f;color:#fff;border:0;border-radius:8px;font-weight:600;cursor:pointer">Connect Phantom (REAL)</button>\
<div id="PHANTOM_ADDR" style="margin-top:6px;font-size:12px;word-break:break-all"></div>' "$HTML"

# 3) Injecter le JS PHANTOM ULTRA MINIMAL (user gesture direct)
sed -i '/<\/body>/i \
<script>\
document.addEventListener("DOMContentLoaded",()=>{\
  const btn=document.getElementById("PHANTOM_CONNECT_BTN");\
  const out=document.getElementById("PHANTOM_ADDR");\
  if(!btn)return;\
  btn.onclick=async()=>{\
    if(!window.solana||!window.solana.isPhantom){\
      out.textContent="❌ Phantom non installé";\
      return;\
    }\
    try{\
      const res=await window.solana.connect({onlyIfTrusted:false});\
      out.textContent=res.publicKey.toString();\
      btn.textContent="Connected";\
      btn.disabled=true;\
    }catch(e){\
      out.textContent="Connexion refusée";\
    }\
  };\
});\
</script>' "$HTML"

echo "✅ PHANTOM RÉPARÉ"
echo "➡️ CTRL + F5 obligatoire"
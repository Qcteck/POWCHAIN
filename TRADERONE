cat >/root/MEGA_WOLVERINE_RESTORE_AND_TEST.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
ROOT="/var/www/wolverine"
INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGERR="/var/log/nginx/error.log"
LOG="/root/MEGA_WOLVERINE_RESTORE_AND_TEST_${TS}.log"

exec > >(tee -a "$LOG") 2>&1

need(){ command -v "$1" >/dev/null 2>&1 || { echo "ERROR: missing $1"; exit 1; }; }
need bash; need find; need grep; need awk; need sed; need cp; need mkdir; need chmod; need date; need curl
command -v nginx >/dev/null 2>&1 || { echo "ERROR: nginx missing"; exit 1; }

echo "== MEGA_WOLVERINE_RESTORE_AND_TEST =="
echo "TS=$TS"
echo "ROOT=$ROOT"
echo "INC=$INC"
echo "VHOST=$VHOST"
echo "LOG=$LOG"
echo

unfreeze(){ [ -e "$1" ] && chattr -i "$1" 2>/dev/null || true; }
refreeze(){ [ -e "$1" ] && chattr +i "$1" 2>/dev/null || true; }
backup_path(){
  local p="$1"
  if [ -e "$p" ]; then
    cp -a "$p" "${p}.bak_${TS}"
    echo "Backup: $p -> ${p}.bak_${TS}"
  fi
}

echo "== 1) Preflight: listeners =="
ss -lntp | awk 'NR==1 || /:80 |:443 |:3000 /{print}' || true
echo

echo "== 2) Backup current webroot + nginx include/vhost =="
mkdir -p /root/wolverine_backups
if [ -d "$ROOT" ]; then
  tar -C "$(dirname "$ROOT")" -czf "/root/wolverine_backups/wolverine_webroot_${TS}.tgz" "$(basename "$ROOT")" || true
  echo "Backup webroot -> /root/wolverine_backups/wolverine_webroot_${TS}.tgz"
fi
backup_path "$INC"
backup_path "$VHOST"
echo

echo "== 3) Ensure webroot exists =="
mkdir -p "$ROOT"
chmod 755 "$ROOT"
echo

echo "== 4) Restore index.html/_next/vendor if missing (auto-discover) =="
if [ ! -f "$ROOT/index.html" ]; then
  echo "index.html is MISSING in $ROOT -> searching candidates in /opt and common paths..."
  CAND=""
  # Find an index.html that looks like the wolverine Next export (must contain /wolverine/_next/)
  while IFS= read -r f; do
    if grep -q "/wolverine/_next/" "$f" 2>/dev/null; then
      CAND="$f"
      break
    fi
  done < <(find /opt /root -maxdepth 6 -type f -name index.html 2>/dev/null | head -n 2000)

  if [ -z "$CAND" ]; then
    # fallback: search dist/wolverine or out/wolverine directories
    while IFS= read -r d; do
      if [ -f "$d/index.html" ] && grep -q "/wolverine/_next/" "$d/index.html" 2>/dev/null; then
        CAND="$d/index.html"
        break
      fi
    done < <(find /opt /root -maxdepth 8 -type d \( -name wolverine -o -name dist -o -name out \) 2>/dev/null | head -n 2000)
  fi

  if [ -z "$CAND" ]; then
    echo "ERROR: No valid WOLVERINE index.html candidate found in /opt or /root."
    echo "       You must re-export/build WOLVERINE, then re-run this batch."
    exit 2
  fi

  SRCDIR="$(dirname "$CAND")"
  echo "Found candidate: $CAND"
  echo "Source dir: $SRCDIR"
  echo "Restoring: $SRCDIR/* -> $ROOT/"
  # Copy everything from candidate dir (expects _next/, vendor/, assets, etc.)
  cp -a "$SRCDIR/." "$ROOT/"
else
  echo "index.html exists, skip restore."
fi
echo

echo "== 5) Create badge file /wolverine/_wolverine_ok.txt =="
echo "OK $TS" >"$ROOT/_wolverine_ok.txt"
chmod 644 "$ROOT/_wolverine_ok.txt"
echo

echo "== 6) Write nginx include (NO loops, proper alias + proxy) =="
unfreeze "$INC"
mkdir -p "$(dirname "$INC")"
cat >"$INC" <<'NGINX'
# WOLVERINE routes (include) — served under https://fireinners.online/wolverine/
# Webroot: /var/www/wolverine

location = /wolverine { return 301 /wolverine/; }

# Proof/badge
location = /wolverine/_wolverine_ok.txt {
  alias /var/www/wolverine/_wolverine_ok.txt;
  add_header Cache-Control "no-store" always;
}

# Disable SW/manifest to avoid cache ghosts
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

# Next static assets
location ^~ /wolverine/_next/ {
  alias /var/www/wolverine/_next/;
  try_files $uri $uri/ =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# Local vendor assets (no CDN)
location ^~ /wolverine/vendor/ {
  alias /var/www/wolverine/vendor/;
  try_files $uri $uri/ =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# TraderOne API (backend local only)
location ^~ /wolverine/traderone/api/ {
  proxy_pass http://127.0.0.1:3000/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 60s;
}

# Frontend app (static export)
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /index.html;
  add_header Cache-Control "no-store" always;
}
NGINX
chmod 644 "$INC"
echo "Wrote $INC"
echo

echo "== 7) Nginx config test + reload =="
unfreeze "$VHOST"
nginx -t
systemctl reload nginx
refreeze "$INC"
refreeze "$VHOST"
echo "nginx reloaded."
echo

echo "== 8) Tests (local backend + local nginx + public) =="
echo "-- A) Backend direct (must be JSON) --"
curl -sS -i "http://127.0.0.1:3000/health" | head -n 40 || true
echo

echo "-- B) Nginx local badge (must be 200 OK) --"
curl -sS -i "http://127.0.0.1/wolverine/_wolverine_ok.txt" -H "Host: fireinners.online" | head -n 40 || true
echo

echo "-- C) Nginx local API health (must be JSON, NOT HTML/500) --"
curl -sS -i "http://127.0.0.1/wolverine/traderone/api/health" -H "Host: fireinners.online" | head -n 60 || true
echo

echo "-- D) Public badge (must be 200 OK) --"
curl -sS -i "https://fireinners.online/wolverine/_wolverine_ok.txt" | head -n 40 || true
echo

echo "-- E) Public API health (must be JSON) --"
curl -sS -i "https://fireinners.online/wolverine/traderone/api/health" | head -n 60 || true
echo

echo "-- F) Public vault create (POST) (must be JSON, NOT 405/HTML) --"
curl -sS -i -X POST "https://fireinners.online/wolverine/traderone/api/vault/create" \
  -H "Content-Type: application/json" \
  -d '{}' | head -n 80 || true
echo

echo "== 9) If errors: tail nginx error log =="
tail -n 120 "$NGERR" 2>/dev/null || true
echo

echo "DONE. LOG=$LOG"
BASH

chmod +x /root/MEGA_WOLVERINE_RESTORE_AND_TEST.sh
bash /root/MEGA_WOLVERINE_RESTORE_AND_TEST.sh
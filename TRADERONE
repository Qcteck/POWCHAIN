bash -c "$(cat <<'BASH'
set -euo pipefail
echo '=== WOLVERINE FINAL FIX (LOCAL WEB3 + DRPC) ==='

BASE="/var/www/wolverine"
VENDOR="$BASE/vendor"
HTML="$BASE/index.html"
TS=$(date +%Y%m%d_%H%M%S)
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"

mkdir -p "$VENDOR"

# 1) Installer web3.js LOCAL (une fois, sans CDN)
if [ ! -f "$VENDOR/solana-web3.min.js" ]; then
  echo "Downloading local solana-web3.js"
  curl -fsSL https://cdn.jsdelivr.net/npm/@solana/web3.js@1.95.3/lib/index.iife.min.js \
    -o "$VENDOR/solana-web3.min.js"
fi

# 2) Backup HTML
cp "$HTML" "$HTML.clean_$TS" || true

# 3) HTML CLEAN + FONCTIONNEL
cat >"$HTML" <<HTML
<!DOCTYPE html><html><head><meta charset="utf-8"/>
<title>Wolverine Wallet</title>
<style>
body{background:#0b0b0b;color:#0ff;font-family:Arial}
#w{max-width:420px;margin:80px auto;padding:20px;border:1px solid #0ff;border-radius:8px}
button{width:100%;padding:12px;margin-top:10px;background:#0ff;border:0;font-weight:bold}
</style>
<script src="/wolverine/vendor/solana-web3.min.js"></script>
</head>
<body>
<div id="w">
<button id="c">Connect Phantom</button>
<button id="d" style="display:none">Disconnect</button>
<div>Address: <span id="a">-</span></div>
<div>SOL: <span id="s">-</span></div>
<div>USDC: <span id="u">-</span></div>
</div>

<script>
const RPC="$RPC";
const USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const conn=new solanaWeb3.Connection(RPC,"confirmed");

c.onclick=async()=>{
 if(!window.solana||!solana.isPhantom){alert("Phantom missing");return;}
 const r=await solana.connect();
 const pub=r.publicKey;
 a.textContent=pub.toString();

 const lamports=await conn.getBalance(pub);
 s.textContent=(lamports/1e9).toFixed(6);

 const accs=await conn.getParsedTokenAccountsByOwner(
   pub,{mint:new solanaWeb3.PublicKey(USDC)}
 );
 let tot=0;
 accs.value.forEach(x=>{
   tot+=Number(x.account.data.parsed.info.tokenAmount.uiAmount||0);
 });
 u.textContent=tot.toFixed(2);

 c.style.display="none";d.style.display="block";
};

d.onclick=async()=>{
 await solana.disconnect();
 a.textContent=s.textContent=u.textContent="-";
 d.style.display="none";c.style.display="block";
};
</script>
</body></html>
HTML

echo "=== DONE ==="
echo "➡️ HARD REFRESH (CTRL+SHIFT+R)"
BASH
)"
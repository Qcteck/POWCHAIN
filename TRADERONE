cat >/root/WOLVERINE_PURGE_AND_TRACE.sh <<'BASH'
#!/usr/bin/env bash
set -e

echo "===== WOLVERINE PURGE + TRACE ====="

### 1. KILL SERVICE WORKERS
echo "[1] Disable service workers"
rm -f /var/www/wolverine/sw.js /var/www/wolverine/service-worker.js || true

### 2. FORCE NGINX NO-CACHE
echo "[2] Force no-cache headers"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

sed -i '/location \/wolverine\//,/}/d' "$NGINX_SITE"

cat >>"$NGINX_SITE" <<'NGINX'

location /wolverine/ {
    root /var/www;
    index index.html;
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
    try_files $uri $uri/ /wolverine/index.html =404;
}
NGINX

### 3. WRITE FLUO TEST PAGE
echo "[3] Writing FLUO test index.html"
cat >/var/www/wolverine/index.html <<'HTML'
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>WOLVERINE TRACE</title>
</head>
<body style="margin:0;background:#ff00ff;color:black;font-size:32px;font-weight:900;">
<div style="padding:40px;text-align:center;">
🔥🔥🔥 THIS IS THE REAL SERVED FILE 🔥🔥🔥<br><br>
/var/www/wolverine/index.html<br><br>
TIME: <span id="t"></span>
</div>
<script>
document.getElementById("t").innerText=new Date().toISOString();
</script>
</body>
</html>
HTML

### 4. RELOAD EVERYTHING
echo "[4] Reload nginx"
nginx -t && systemctl reload nginx

echo
echo "✅ DONE"
echo "➡️ Ouvre https://fireinners.online/wolverine/"
echo "➡️ CTRL + SHIFT + R (hard refresh)"
BASH

chmod +x /root/WOLVERINE_PURGE_AND_TRACE.sh
/root/WOLVERINE_PURGE_AND_TRACE.sh
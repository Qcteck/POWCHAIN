bash <<'EOF'
set -e

APP="/opt/traderone-opt"
ENV="$APP/.env"
KEYFILE="/tmp/fixed_key.txt"

echo "=== TRADERONE • FIX PRIVATE KEY ==="

# 1) Vérifier .env
[ -f "$ENV" ] || { echo "[ERR] .env absent"; exit 1; }

# 2) Extraire la clé depuis le scan MATCH_FOUND
KEY=$(grep MATCH_FOUND /tmp/traderone_key_scan.log | sed 's/.*MATCH_FOUND:://' | cut -d: -f1)

if [ -z "$KEY" ]; then
  echo "[ERR] clé non trouvée dans le log"
  exit 1
fi

# 3) Normaliser clé (JSON array → base58 si besoin)
node <<JS > "$KEYFILE"
const bs58=require("bs58");
const raw='$KEY'.trim();
let out;
if(raw.startsWith("[")){
  out=bs58.encode(Uint8Array.from(JSON.parse(raw)));
}else{
  out=raw;
}
console.log(out);
JS

FIXED=$(cat "$KEYFILE")

# 4) Injecter dans .env
sed -i '/SOLANA_PRIVATE_KEY_BASE58/d' "$ENV"
echo "SOLANA_PRIVATE_KEY_BASE58=$FIXED" >> "$ENV"

# 5) Restart PM2 avec update-env
pm2 restart traderone --update-env
pm2 save

echo "=== CLÉ PRIVÉE APPLIQUÉE ==="
EOF
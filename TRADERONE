CANON="$(python3 - <<'PY'
import os,re,glob,sys
paths=[]
paths+=glob.glob("/etc/nginx/sites-available/*")
paths+=glob.glob("/etc/nginx/conf.d/*")
def read(p):
  try: return open(p,"r",encoding="utf-8",errors="ignore").read()
  except: return ""
def server_blocks(txt):
  # parse naive server{...} blocks with brace counting
  out=[]
  for m in re.finditer(r'(?m)^\s*server\s*\{', txt):
    i=m.start(); depth=0; j=i
    while j<len(txt):
      c=txt[j]
      if c=='{': depth+=1
      elif c=='}':
        depth-=1
        if depth==0:
          out.append((i,j+1,txt[i:j+1]))
          break
      j+=1
  return out
cands=[]
for p in paths:
  if re.search(r'\.(bak|old|save|disabled)(\.|$)', p): 
    continue
  s=read(p)
  bl=server_blocks(s)
  for (a,b,t) in bl:
    if re.search(r'(?m)^\s*server_name\s+.*\bfireinners\.online\b', t):
      score=0
      if re.search(r'(?m)^\s*listen\s+443', t): score+=10
      if "ssl" in t: score+=3
      cands.append((score,p))
if not cands:
  sys.exit("ERR: aucun vhost avec server_name fireinners.online trouvé")
cands.sort(reverse=True)
print(cands[0][1])
PY
)" || { echo "$CANON"; exit 1; }

# 2) Désactiver les doublons dans sites-enabled (garder seulement celui qui pointe vers CANON)

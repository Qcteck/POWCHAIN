command -v nginx >/dev/null || { say "ERREUR: nginx absent"; exit 1; }
systemctl status "$SERVICE" --no-pager >/dev/null 2>&1 || { say "WARN: $SERVICE pas trouvé (on continue)"; }

say "Ce patch va:"
say "- upgrader backend: sessions TraderOne + decide() + price + finder Dexscreener"
say "- upgrader frontend: modes DCA + ZONE (drawdown), Finder, loop piloté par backend"
say "- garder /wolverine/api/ping -> pong (pour TG sentinel)"

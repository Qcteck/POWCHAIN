cat >/tmp/WOLVERINE_CHECK_WALLET_AND_BALANCES2.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== 1) Colle TON adresse Phantom (public key) ==="
read -r -p "WALLET_PHANTOM = " WALLET
WALLET="$(echo -n "$WALLET" | tr -d '[:space:]')"

echo
echo "WALLET=$WALLET"
echo -n "len="; echo -n "$WALLET" | wc -c

echo
echo "=== 2) Vérif format Solana (PublicKey) ==="
node - <<'NODE' "$WALLET"
const { PublicKey } = require("@solana/web3.js");
const w = process.argv[1];
try {
  console.log("OK:", new PublicKey(w).toBase58());
} catch (e) {
  console.error("INVALID WALLET:", e.message);
  process.exit(2);
}
NODE

echo
echo "=== 3) SOL balance MAINNET (RPC officiel) ==="
curl -sS https://api.mainnet-beta.solana.com \
  -H 'Content-Type: application/json' \
  --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getBalance\",\"params\":[\"$WALLET\"]}"
echo

echo
echo "=== 4) Ton backend balances2 (local VPS) ==="
curl -sS "http://127.0.0.1:8585/api/balances2?wallet=$WALLET"
echo

echo
echo "=== 5) (optionnel) balances2 via domaine (si exposé) ==="
curl -ksS "https://fireinners.online/wolverine/traderone/api/balances2?wallet=$WALLET" || true
echo

echo
echo "DONE ✅"
SH

bash /tmp/WOLVERINE_CHECK_WALLET_AND_BALANCES2.sh
"use strict";
const http=require("http"),url=require("url"),fs=require("fs"),path=require("path");
const {spawn}=require("child_process");

const HOST=process.env.HOST||"127.0.0.1";
const PORT=parseInt(process.env.PORT||"9697",10);
const APP=__dirname;
const PY=path.join(APP,"venv","bin","python3");
const REPORT=path.join(APP,"report.json");
const LOCK=path.join(APP,"RUNNING.lock");

function send(res,code,obj,headers={}){
  const b=Buffer.from(JSON.stringify(obj));
  res.writeHead(code,Object.assign({"content-type":"application/json","content-length":b.length},headers));
  res.end(b);
}
function readBody(req){
  return new Promise((resolve,reject)=>{
    let d=""; req.on("data",c=>{d+=c; if(d.length>2e6) req.destroy();});
    req.on("end",()=>{try{resolve(d?JSON.parse(d):{});}catch(e){reject(e);} });
  });
}
function runBacktest(params){
  return new Promise((resolve,reject)=>{
    if(fs.existsSync(LOCK)) return reject(new Error("Already running"));
    fs.writeFileSync(LOCK,String(Date.now()));
    const p=spawn(PY,[path.join(APP,"backtest.py"),JSON.stringify(params||{})],{stdio:["ignore","pipe","pipe"]});
    let out="",err="";
    p.stdout.on("data",c=>out+=c.toString());
    p.stderr.on("data",c=>err+=c.toString());
    p.on("close",(code)=>{
      try{fs.unlinkSync(LOCK);}catch(_){}
      if(code===0) resolve({ok:true,log:out.slice(-4000),err:err.slice(-4000)});
      else reject(new Error("backtest failed code="+code+" | "+err.slice(-1200)));
    });
  });
}

const srv=http.createServer(async (req,res)=>{
  const u=url.parse(req.url,true);
  if(u.pathname==="/health") return send(res,200,{ok:true,service:"aquilatrader-safe",ts:new Date().toISOString()});
  if(u.pathname==="/backtest/report"){
    if(!fs.existsSync(REPORT)) return send(res,200,{ok:false,msg:"no report yet",kpi:{},pairs:[]});
    try{const js=JSON.parse(fs.readFileSync(REPORT,"utf8")); return send(res,200,js);}catch(e){return send(res,500,{ok:false,error:String(e)});}
  }
  if(u.pathname==="/backtest/run" && req.method==="POST"){
    try{
      const body=await readBody(req);
      const r=await runBacktest(body);
      return send(res,200,{ok:true,result:r});
    }catch(e){return send(res,500,{ok:false,error:String(e.message||e)});}
  }
  send(res,404,{ok:false,error:"not found"});
});
srv.listen(PORT,HOST,()=>console.log("API listening on http://"+HOST+":"+PORT));

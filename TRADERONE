cat >/tmp/wolfchain_fly.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/opt/fireinners/frontend-react/app/dist"
if test -f "$VHOST"; then
  R=$(awk 'BEGIN{r=""} /^[ \t]*root[ \t]+/{gsub(/;$/,"",$2); if(r==""){r=$2}} END{print r}' "$VHOST" 2>/dev/null || true)
  test -n "${R:-}" && ROOT="$R"
fi
echo "VHOST=$VHOST"
echo "ROOT=$ROOT"
echo
echo "== nginx -t =="
nginx -t || true
echo
echo "== root listing =="
ls -la "$ROOT" 2>/dev/null || true
echo
for p in index.html dex/index.html wolverine/index.html wallet/index.html bridge/index.html explorer/index.html mining/index.html options/index.html; do
  echo "-- $ROOT/$p --"
  ls -la "$ROOT/$p" 2>/dev/null || echo "MISSING"
done
echo
echo "== backend ports =="
ss -lntp | egrep ':(3000|4001|443|80)\b' || true
echo
echo "== backend direct /stats (localhost:3000) =="
curl -sS -m 3 -i http://127.0.0.1:3000/stats 2>/dev/null | sed -n '1,8p' || echo "NO RESPONSE"
echo
echo "== via nginx (Host header) /stats =="
curl -k -sS -m 3 -i https://127.0.0.1/stats -H 'Host: fireinners.online' 2>/dev/null | sed -n '1,12p' || echo "NO RESPONSE"
echo
echo "== via nginx (Host header) / =="
curl -k -sS -m 3 -i https://127.0.0.1/ -H 'Host: fireinners.online' 2>/dev/null | sed -n '1,12p' || echo "NO RESPONSE"
BASH
bash /tmp/wolfchain_fly.sh
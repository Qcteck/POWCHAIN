cat >/root/fix_blueprint_return_404.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
CFG="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date -u +%Y%m%d_%H%M%S)"

test -f "$CFG" || { echo "❌ Missing $CFG"; exit 1; }

echo "== Backup =="
cp -a "$CFG" "${CFG}.bak_blueprint404_${TS}"
echo "Backup: ${CFG}.bak_blueprint404_${TS}"
echo

echo "== Inject blueprint 404 locations inside first server{} if missing =="
if grep -qE "location\s+\^~\s+/wolverine/blueprint/" "$CFG"; then
  echo "OK: blueprint location already exists (not adding)."
else
  awk '
    BEGIN{done=0}
    {print}
    done==0 && $0 ~ /^[[:space:]]*server[[:space:]]*\{/ {
      print ""
      print "  # Blueprint removed: return 404 instead of 403"
      print "  location = /wolverine/blueprint/ { return 404; }"
      print "  location ^~ /wolverine/blueprint/ { return 404; }"
      print ""
      done=1
    }
  ' "$CFG" > /tmp/nginx_blueprint404.tmp
  mv /tmp/nginx_blueprint404.tmp "$CFG"
  echo "✅ Added blueprint 404 locations"
fi
echo

echo "== nginx test + reload =="
nginx -t
systemctl reload nginx || service nginx reload
echo

echo "== ORIGIN check (should be 404 now) =="
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/blueprint/blueprint_robo600.mp4 | head -n 12 || true
echo "DONE ✅"
BASH

chmod +x /root/fix_blueprint_return_404.sh
/root/fix_blueprint_return_404.sh
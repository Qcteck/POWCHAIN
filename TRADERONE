cat >/tmp/WOLVERINE_TRADERONE_BACKEND_PROXY.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then . "$ASKLIB"; else
  askorupdate_yesno(){ local q="$1"; read -r -p "$q (y/N) " a || true; case "${a,,}" in y|yes) return 0;; *) return 1;; esac; }
  askorupdate_file(){ local p="$1" c="$2"; mkdir -p "$(dirname "$p")"; printf "%s" "$c" >"$p"; }
fi
say(){ printf "%s\n" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: commande manquante: $1"; exit 1; }; }

NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
TR_DIR="/opt/traderone-opt"
OUT_WOLV_DEFAULT="/opt/fireinners/frontend-react/app/dist/wolverine"
PORT_DEFAULT="8585"
UNIT="traderone.service"
SNIP="/etc/nginx/snippets/wolverine_traderone_backend.conf"
MARK="TRADERONE_WOLV_PROXY_V1"

pick_wolverine_outdir(){
  local out=""
  if [ -f "$NGX_SITE" ]; then
    out="$(awk '
      $1=="location" && $2=="/wolverine" {inloc=1}
      inloc && $1=="alias" {gsub(";","",$2); print $2; exit}
      inloc && $1=="root"  {gsub(";","",$2); print $2 "/wolverine"; exit}
      inloc && $0 ~ /}/ {inloc=0}
    ' "$NGX_SITE" 2>/dev/null || true)"
  fi
  [ -n "${out:-}" ] || out="$OUT_WOLV_DEFAULT"
  printf "%s" "$out"
}

detect_port(){
  local p=""
  if [ -f "$TR_DIR/.env" ]; then
    p="$(grep -E '^(PORT|HTTP_PORT)=' "$TR_DIR/.env" | tail -n1 | cut -d= -f2 | tr -d '\r' | tr -cd '0-9' || true)"
  fi
  if [ -z "${p:-}" ]; then
    p="$(grep -R --line-number -E 'listen\(|app\.listen\(|server\.listen\(|PORT\s*[:=]' "$TR_DIR" 2>/dev/null | head -n 1 | sed -E 's/.*[^0-9]([0-9]{2,5}).*/\1/' || true)"
  fi
  if [ -z "${p:-}" ] || [ "${#p}" -lt 2 ]; then p="$PORT_DEFAULT"; fi
  printf "%s" "$p"
}

detect_entry(){
  local e=""
  if [ -f "$TR_DIR/server.js" ]; then e="server.js"; fi
  if [ -z "${e:-}" ] && [ -f "$TR_DIR/index.js" ]; then e="index.js"; fi
  if [ -z "${e:-}" ] && [ -f "$TR_DIR/app.js" ]; then e="app.js"; fi
  if [ -z "${e:-}" ] && [ -f "$TR_DIR/main.js" ]; then e="main.js"; fi
  if [ -z "${e:-}" ] && [ -f "$TR_DIR/package.json" ]; then
    e="$(node -e 'try{const p=require(process.argv[1]);if(p.main)process.stdout.write(p.main);}catch(e){}' "$TR_DIR/package.json" 2>/dev/null || true)"
  fi
  [ -n "${e:-}" ] || { echo ""; return 1; }
  [ -f "$TR_DIR/$e" ] || { echo ""; return 1; }
  printf "%s" "$e"
}

say "=== BATCH FLY (read-only) ==="
say "whoami: $(whoami)  host: $(hostname)  date: $(date -u +%FT%TZ)"
need nginx; need awk; need sed; need grep; need curl; need systemctl
need node

[ -d "$TR_DIR" ] || { say "ERREUR: dossier TraderOne absent: $TR_DIR"; exit 1; }
[ -f "$NGX_SITE" ] || { say "ERREUR: nginx site absent: $NGX_SITE"; exit 1; }

OUTDIR="$(pick_wolverine_outdir)"
say "Wolverine OUTDIR: $OUTDIR"
[ -d "$OUTDIR" ] || { say "WARN: OUTDIR n'existe pas encore (sera créé si besoin): $OUTDIR"; }

PORT="$(detect_port)"
ENTRY="$(detect_entry || true)"
[ -n "${ENTRY:-}" ] || { say "ERREUR: impossible de détecter l'entry backend (server.js/app.js/index.js/main.js) dans $TR_DIR"; exit 1; }
say "TraderOne backend entry: $TR_DIR/$ENTRY"
say "TraderOne backend PORT (choisi/détecté): $PORT"

EXIST_UNIT="no"
systemctl cat "$UNIT" >/dev/null 2>&1 && EXIST_UNIT="yes"
say "systemd unit $UNIT: $EXIST_UNIT"

say "Nginx marker présent? $(grep -q "$MARK" "$NGX_SITE" && echo yes || echo no)"

say "Ce script va:"
say "- créer/mettre à jour $UNIT (backend TraderOne en localhost:$PORT)"
say "- créer/mettre à jour snippet nginx: $SNIP"
say "- patcher $NGX_SITE pour inclure le snippet (si absent)"
say "- nginx -t + reload + systemd restart TraderOne"
if ! askorupdate_yesno "Continuer ?"; then say "Stop."; exit 0; fi

say "=== MEGA BATCH (apply) ==="

# 1) systemd unit (localhost only)
UNIT_CONTENT="[Unit]
Description=TraderOne Backend (localhost)
After=network.target

[Service]
Type=simple
WorkingDirectory=$TR_DIR
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=$PORT
ExecStart=/usr/bin/node $TR_DIR/$ENTRY
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
"
askorupdate_file "/etc/systemd/system/$UNIT" "$UNIT_CONTENT"
systemctl daemon-reload
systemctl enable "$UNIT" >/dev/null 2>&1 || true
systemctl restart "$UNIT"

# 2) nginx snippet proxy
SNIP_CONTENT="# $MARK
# Proxy TraderOne backend under same origin (no CORS)
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection \"upgrade\";
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:$PORT/;
}
"
askorupdate_file "$SNIP" "$SNIP_CONTENT"

# 3) include snippet in site config (idempotent)
if ! grep -q "$MARK" "$NGX_SITE"; then
  cp -a "$NGX_SITE" "$NGX_SITE.bak.$(date +%s)"
  # Insert include inside the first matching server block (best effort)
  awk -v snip="$SNIP" -v mark="$MARK" '
    BEGIN{ins=0;inserver=0;done=0}
    {
      line=$0
      if(line ~ /^[ \t]*server[ \t]*\{/ && !inserver){inserver=1}
      if(inserver && !done && line ~ /^[ \t]*\}/){
        # before closing server block
        print "    include " snip "; # " mark
        done=1
      }
      print line
      if(inserver && line ~ /^[ \t]*\}/){inserver=0}
    }
  ' "$NGX_SITE" >"$NGX_SITE.tmp"
  mv "$NGX_SITE.tmp" "$NGX_SITE"
fi

# nginx safe test/reload
nginx -t
systemctl reload nginx

say "=== TESTS ==="
say "Backend local check (best effort):"
curl -sS --max-time 5 "http://127.0.0.1:$PORT/" | head -c 120 || true
echo
say "Proxy check:"
curl -ksS --max-time 6 "https://fireinners.online/wolverine/traderone/api/" | head -c 120 || true
echo
say "Unit status:"
systemctl --no-pager -l status "$UNIT" | sed -n '1,20p' || true

say "DONE."
SH
chmod +x /tmp/WOLVERINE_TRADERONE_BACKEND_PROXY.sh
bash /tmp/WOLVERINE_TRADERONE_BACKEND_PROXY.sh
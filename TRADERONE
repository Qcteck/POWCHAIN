cat >/root/WOLV_FIX_NODEFETCH_AND_IPV4_JUP.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

BACK_DIR="/opt/wolverine-api"
SWAP="$BACK_DIR/routes/swap.routes.js"

[ -d "$BACK_DIR" ] || { echo "ERR: $BACK_DIR introuvable"; exit 1; }
[ -f "$BACK_DIR/package.json" ] || { echo "ERR: package.json introuvable dans $BACK_DIR"; exit 1; }
[ -f "$SWAP" ] || { echo "ERR: swap.routes.js introuvable: $SWAP"; exit 1; }

TS="$(date +%s)"
mkdir -p /root/wolv_backups
cp -a "$SWAP" "/root/wolv_backups/swap.routes.js.$TS.bak"

echo "=== Install node-fetch@2 (CJS) ==="
cd "$BACK_DIR"
npm i node-fetch@2 --silent

echo "=== Inject FETCH+IPv4 shim at top of swap.routes.js ==="
perl -0777 -i -pe '
  my $s=$_;
  if($s !~ /WOLV_FETCH_IPV4_SHIM_V1/){
    my $shim = "/* WOLV_FETCH_IPV4_SHIM_V1 */\n".
      "const https = require(\"https\");\n".
      "let fetchFn = global.fetch;\n".
      "if (!fetchFn) {\n".
      "  const nf = require(\"node-fetch\");\n".
      "  fetchFn = nf.default || nf;\n".
      "}\n".
      "const __httpsAgent4 = new https.Agent({ keepAlive: true, family: 4 });\n".
      "const fetch = (url, opts={}) => fetchFn(url, Object.assign({ agent: __httpsAgent4 }, opts));\n\n";
    $s = $shim . $s;
  }
  $_=$s;
' "$SWAP"

echo "=== Restart wolverine-api ==="
systemctl restart wolverine-api.service || true
sleep 1

echo "=== Node test (Jupiter quote) ==="
node - <<'NODE'
const nf = require("node-fetch");
const fetch = nf.default || nf;
const https = require("https");
const agent = new https.Agent({ keepAlive:true, family:4 });

(async () => {
  const url="https://quote-api.jup.ag/v6/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50";
  try{
    const r = await fetch(url, { agent, timeout: 10000 });
    const t = await r.text();
    console.log("status=", r.status);
    console.log(t.slice(0,200));
    process.exit(r.ok ? 0 : 2);
  }catch(e){
    console.error("NODE_ERR:", e && (e.stack||e.message||e));
    process.exit(3);
  }
})();
NODE

echo
echo "DONE ✅"
echo "Rollback:"
echo "  cp -a /root/wolv_backups/swap.routes.js.$TS.bak $SWAP && systemctl restart wolverine-api.service"
BASH

bash /root/WOLV_FIX_NODEFETCH_AND_IPV4_JUP.sh
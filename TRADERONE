#!/usr/bin/env bash
set -euo pipefail

echo "=== MEGA FIX WOLVERINE (ROOT / SAFE) ==="

# VARIABLES
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine.inc"
ROOT_WOLV="/opt/fireinners/frontend-react/app/dist"

# CHECK ROOT
if [ "$EUID" -ne 0 ]; then
  echo "❌ Must be root"
  exit 1
fi

# BACKUP VHOST
TS="$(date +%Y%m%d_%H%M%S)"
cp -a "$VHOST" "$VHOST.bak_$TS"
echo "✔ Backup vhost: $VHOST.bak_$TS"

# CREATE INCLUDE
cat > "$INC" <<'EOF'
# === WOLVERINE INCLUDE (DEV SAFE) ===
add_header Content-Security-Policy "
default-src * data: blob: 'unsafe-inline' 'unsafe-eval';
script-src * data: blob: 'unsafe-inline' 'unsafe-eval';
connect-src * wss: https:;
img-src * data: blob:;
style-src * 'unsafe-inline';
font-src * data:;
frame-src *;
" always;
EOF

echo "✔ CSP include créé"

# INJECT INCLUDE + FIX ROUTES
if ! grep -q "wolverine.inc" "$VHOST"; then
sed -i "/location \\/wolverine\\//a \\
    include /etc/nginx/includes/wolverine.inc;
" "$VHOST"
fi

# FORCE SPA + ASSETS PATH
sed -i '/location \/wolverine\//,/}/c\
location /wolverine/ {\
    root '"$ROOT_WOLV"';\
    try_files $uri $uri/ /wolverine/index.html;\
}' "$VHOST"

echo "✔ Routes /wolverine corrigées"

# TEST + RELOAD
nginx -t
systemctl reload nginx

echo "=== ✅ WOLVERINE FIX APPLIQUÉ ==="
echo "OPEN → https://fireinners.online/wolverine/"
echo "CTRL + F5 OBLIGATOIRE"
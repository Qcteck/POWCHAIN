set -e
cd /root

F="/opt/wolverine-api/server.js"
cp -v "$F" "/root/wolverine-api.server.js.$(date +%Y%m%d_%H%M%S).bak"

# Injecte un proxy /api/* avant app.listen(...) si pas déjà présent
python3 - <<'PY'
import re, pathlib
p = pathlib.Path("/opt/wolverine-api/server.js")
s = p.read_text()

if 'LEGACY_PROXY_API_TO_3000' in s:
    print("OK: proxy /api/* déjà présent")
    raise SystemExit(0)

m = re.search(r'^\s*app\.listen\(', s, flags=re.M)
if not m:
    raise SystemExit("ERREUR: app.listen(...) introuvable dans server.js")

inject = r'''
// === LEGACY_PROXY_API_TO_3000 ===
// Permet POST/GET/etc sur /api/* (ex: /api/status) via Wolverine (3002) -> TraderOne (3000)
const __fetch = (global.fetch ? global.fetch : require("node-fetch"));
app.use("/api/", async (req, res) => {
  try {
    const suffix = (req.originalUrl || req.url).replace(/^\/api\//, "");
    const url = "http://127.0.0.1:3000/api/" + suffix;

    const headers = { ...(req.headers || {}) };
    delete headers.host;

    const init = {
      method: req.method,
      headers,
    };

    if (req.method !== "GET" && req.method !== "HEAD") {
      // Si req.body existe déjà, on le forward, sinon on laisse vide
      init.body = (req.body !== undefined) ? JSON.stringify(req.body) : "{}";
      if (!init.headers["content-type"]) init.headers["content-type"] = "application/json";
    }

    const r = await __fetch(url, init);
    const text = await r.text();
    res.status(r.status);

    // forward content-type si présent
    const ct = r.headers.get("content-type");
    if (ct) res.set("content-type", ct);

    res.send(text);
  } catch (e) {
    res.status(502).json({ ok: false, err: "proxy_fail", detail: String(e) });
  }
});
// === /LEGACY_PROXY_API_TO_3000 ===

'''

s2 = s[:m.start()] + inject + s[m.start():]
p.write_text(s2)
print("OK: proxy /api/* injecté")
PY

systemctl restart wolverine-api.service
sleep 1


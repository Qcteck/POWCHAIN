#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA NGINX SAFE INSTALL ==="

VHOST="/etc/nginx/sites-available/aiaquila.fireinners.conf"
ENABLED="/etc/nginx/sites-enabled/aiaquila.fireinners.conf"

# 1. Écriture du vhost dédié
cat > "$VHOST" <<'NGINX'
server {
    listen 443 ssl http2;
    server_name fireinners.online;

    ssl_certificate     /etc/letsencrypt/live/fireinners.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fireinners.online/privkey.pem;

    location /aiaquila/ {
        alias /var/www/aiaquila/;
        index index.html;
        try_files $uri $uri/ =404;
    }

    # headers safe
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
}
NGINX

# 2. Activation
ln -sf "$VHOST" "$ENABLED"

# 3. Test & reload
nginx -t
systemctl reload nginx

echo "✅ AIAQUILA SERVED CLEANLY"
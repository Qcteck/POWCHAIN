"use strict";
require("dotenv").config();
const fs=require("fs");
const path=require("path");
const http=require("http");
const https=require("https");
const express=require("express");
const cors=require("cors");
const bs58=require("bs58");
const {Keypair}=require("@solana/web3.js");

const app=express();
app.use(cors());
app.use(express.json({limit:"256kb"}));

const PORT=parseInt(process.env.PORT||"3050",10);
const BASE_PATH=process.env.BASE_PATH||"/wolverine";
const RPC_URI=process.env.RPC_URI||"";
const USDC_MINT=process.env.USDC_MINT||"";
const WSOL_MINT=process.env.WSOL_MINT||"";
const MONITOR_URL=process.env.MONITOR_URL||"";
const MONITOR_SEC=parseInt(process.env.MONITOR_SEC||"10",10);
const MONITOR_FAILS=parseInt(process.env.MONITOR_FAILS||"3",10);
const TG_ALERTS=(process.env.TG_ALERTS||"0")==="1";
const WOLV_SEND=process.env.WOLV_SEND||"";

const STATED=path.join(__dirname,"state");
const WALLET_JSON=path.join(STATED,"WALLET_JSON");
const WALLET_PUB=path.join(STATED,"WALLET_PUB");

function now(){return Date.now();}
function j(o){return JSON.stringify(o);}
function safeSend(msg){
  try{
    if(!WOLV_SEND) return false;
    if(!fs.existsSync(WOLV_SEND)) return false;
    require("child_process").execFileSync(WOLV_SEND,[String(msg).slice(0,3500)],{stdio:"ignore"});
    return true;
  }catch(_){return false;}
}

function ensureCustody(){
  fs.mkdirSync(STATED,{recursive:true});
  if(fs.existsSync(WALLET_JSON) && fs.existsSync(WALLET_PUB)){
    const pub=String(fs.readFileSync(WALLET_PUB,"utf8")||"").trim();
    if(pub && pub.length>20) return pub;
  }
  const kp=Keypair.generate();
  fs.writeFileSync(WALLET_JSON, j(Array.from(kp.secretKey)), {mode:0o600});
  fs.writeFileSync(WALLET_PUB, kp.publicKey.toBase58()+"\n", {mode:0o644});
  return kp.publicKey.toBase58();
}

let loopTimer=null;
let loopState={enabled:false,ok:0,err:0,last:"",lastTs:0,failStreak:0};

function fetchText(url,timeoutMs=8000){
  return new Promise((resolve,reject)=>{
    const u=new URL(url);
    const lib=(u.protocol==="https:")?https:http;
    const req=lib.request({method:"GET",hostname:u.hostname,port:u.port||undefined,path:u.pathname+u.search,headers:{"User-Agent":"WOLVERINE/1.0"},timeout:timeoutMs},res=>{
      let data="";
      res.on("data",c=>data+=c);
      res.on("end",()=>resolve({status:res.statusCode||0,body:data}));
    });
    req.on("timeout",()=>{req.destroy(new Error("timeout"));});
    req.on("error",reject);
    req.end();
  });
}

async function loopTick(){
  const url=process.env.MONITOR_URL||MONITOR_URL;
  try{
    const r=await fetchText(url,8000);
    const ok=(r.status>=200 && r.status<300 && String(r.body||"").includes("pong"));
    loopState.lastTs=now();
    loopState.last=String(r.body||"").slice(0,200);
    if(ok){
      loopState.ok++; loopState.failStreak=0;
    }else{
      loopState.err++; loopState.failStreak++;
      if(TG_ALERTS && loopState.failStreak>=MONITOR_FAILS){
        safeSend(`WOLVERINE API: OFFLINE (bad resp) url=${url} status=${r.status} body=${loopState.last}`);
      }
    }
  }catch(e){
    loopState.lastTs=now();
    loopState.last=String(e&&e.message||e).slice(0,200);
    loopState.err++; loopState.failStreak++;
    if(TG_ALERTS && loopState.failStreak>=MONITOR_FAILS){
      safeSend(`WOLVERINE API: OFFLINE (error) url=${url} err=${loopState.last}`);
    }
  }
}

function loopStart(){
  if(loopTimer) return;
  loopState.enabled=true;
  loopTimer=setInterval(loopTick, Math.max(3,MONITOR_SEC)*1000);
  loopTick().catch(()=>{});
}
function loopStop(){
  if(loopTimer){ clearInterval(loopTimer); loopTimer=null; }
  loopState.enabled=false;
}

app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));
app.get("/health",(req,res)=>res.json({ok:true,uptime:process.uptime(),ts:Date.now()}));

app.get("/wallet",(req,res)=>{
  const pub=ensureCustody();
  res.json({ok:true,pub});
});

app.get("/config",(req,res)=>{

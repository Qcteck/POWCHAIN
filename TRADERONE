python3 - <<'PY'
s=r'''#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
INDEX="$WEBROOT/index.html"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
BK="/root/WOLVERINE_FIX_VAULTPATHS_${TS}"
VAULT_UPSTREAM="http://127.0.0.1:3010/"

mkdir -p "$BK"
log(){ echo "[$(date +%H:%M:%S)] $*"; }
have(){ command -v "$1" >/dev/null 2>&1; }
unfreeze(){ [ -e "$1" ] && chattr -i "$1" 2>/dev/null || true; }
backup(){ [ -e "$1" ] && cp -a "$1" "$BK/$(basename "$1").bak" 2>/dev/null || true; }

log "0) Savepoint (si dispo)"
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then /root/WOLVERINE_SAVEPOINT.sh || true; fi

log "1) Préflight"
have nginx || { apt-get update -y; apt-get install -y nginx curl; }
have curl || { apt-get update -y; apt-get install -y curl; }

log "2) Backup + unfreeze"
backup "$INC"; backup "$VHOST"; backup "$INDEX"
unfreeze "$INC"; unfreeze "$VHOST"; unfreeze "$INDEX"
for f in /etc/nginx/includes/wolverine*.inc /etc/nginx/includes/*.inc; do unfreeze "$f"; done

log "3) Lire INDEX et extraire chemins vault/aquila"
if [ ! -f "$INDEX" ]; then
  log "WARN: $INDEX introuvable. Je vais quand même poser les alias standards."
  FOUND=""
else
  FOUND="$(grep -oE '\/wolverine\/[^"'\'' ]{0,200}' "$INDEX" 2>/dev/null | grep -iE '(vault|aquila)' | sort -u || true)"
fi

echo "=== PATHS DÉTECTÉS DANS INDEX (vault|aquila) ==="
echo "${FOUND:-<aucun détecté>}"
echo "==============================================="

log "4) Construire liste d'alias à supporter (robuste)"
# Aliases standards + ce qui est trouvé dans l'index
CANDIDATES=$(
  {
    echo "/wolverine/vault/api"
    echo "/wolverine/vault"
    echo "/wolverine/vault-api"
    echo "/wolverine/traderone/api/vault"
    echo "/wolverine/traderone/vault"
    echo "/wolverine/aquila/vault"
    echo "/wolverine/aquila/api/vault"
    echo "/wolverine/aquila/vault/api"
    echo "/wolverine/aq/vault"
    echo "/wolverine/aq/api/vault"
    [ -n "${FOUND:-}" ] && echo "$FOUND" | sed 's/[?#].*$//'
  } | sed 's/\/$//' | awk 'NF' | sort -u
)

echo "=== ALIASES QUI SERONT PROXIES VERS VAULT API (3010) ==="
echo "$CANDIDATES"
echo "========================================================"

log "5) Écrire/mettre à jour l'include NGINX (sans toucher au RPC qui marche)"
cat > "$INC" <<'NGX'
# Wolverine routes include (Vault aliases -> stable JSON Vault API on :3010)
# IMPORTANT: ne touche pas solana-rpc existant ailleurs; ici on ne fait que mapper des chemins Vault/Aquila vers 3010.

# UI static (au cas où)
location ^~ /wolverine/ {
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
}
NGX

# Ajouter dynamiquement les locations alias -> 3010
while IFS= read -r P; do
  [ -z "$P" ] && continue
  {
    echo ""
    echo "# Alias: $P"
    echo "location = ${P} { return 301 ${P}/; }"
    echo "location ^~ ${P}/ {"
    echo "  proxy_pass http://127.0.0.1:3010/;"
    echo "  proxy_http_version 1.1;"
    echo "  proxy_set_header Host \$host;"
    echo "  proxy_set_header X-Real-IP \$remote_addr;"
    echo "  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;"
    echo "  proxy_set_header X-Forwarded-Proto \$scheme;"
    echo "  proxy_read_timeout 60s;"
    echo "}"
  } >> "$INC"
done <<< "$CANDIDATES"

log "6) Assurer include dans le vhost"
if [ -f "$VHOST" ]; then
  if ! grep -qF "include $INC;" "$VHOST"; then
    log "Inject include dans $VHOST"
    tmp="$VHOST.tmp.$TS"
    awk -v inc="include $INC;" 'BEGIN{done=0}{print} !done && $0 ~ /^[[:space:]]*server[[:space:]]*\{/ {print "  " inc; done=1}' "$VHOST" > "$tmp"
    mv "$tmp" "$VHOST"
  else
    log "OK: include déjà présent"
  fi
else
  log "WARN: VHOST introuvable: $VHOST"
fi

log "7) Nginx test + reload"
nginx -t
systemctl reload nginx

log "8) Tests PUBLIC (chaque alias) : GET /health et POST /create"
OKCOUNT=0
FAILCOUNT=0
while IFS= read -r P; do
  [ -z "$P" ] && continue
  H="https://${DOMAIN}${P}/health"
  C="https://${DOMAIN}${P}/create"
  echo ""
  echo "---- $P ----"
  echo "GET  $H"
  if out="$(curl -ksS -m 10 "$H" || true)"; then
    echo "$out"
  fi
  # POST create
  echo "POST $C"
  out2="$(curl -ksS -m 10 -X POST "$C" -H "content-type: application/json" -d '{"budgetSol":0.001}' || true)"
  echo "$out2"
  # Heuristique JSON ok
  if echo "$out2" | grep -q '"ok":true'; then
    echo "RESULT: OK"
    OKCOUNT=$((OKCOUNT+1))
  else
    echo "RESULT: FAIL"
    FAILCOUNT=$((FAILCOUNT+1))
  fi
done <<< "$CANDIDATES"

echo ""
echo "=== RÉSUMÉ ==="
echo "OK aliases  : $OKCOUNT"
echo "FAIL aliases: $FAILCOUNT"
echo "=============="
log "DONE. Ouvre https://${DOMAIN}/wolverine/ puis Ctrl+F5 et clique 'Créer Vault + Déposer'."
'''
open('/root/MEGA_WOLVERINE_FIX_VAULTPATHS.sh','w',encoding='utf-8').write(s)
PY
chmod +x /root/MEGA_WOLVERINE_FIX_VAULTPATHS.sh
bash /root/MEGA_WOLVERINE_FIX_VAULTPATHS.sh
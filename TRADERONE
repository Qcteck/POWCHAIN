#!/bin/bash
set -e

UI="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
BK="$UI.bak.$(date +%s)"

echo "=== WOLVERINE • MENU RÉGLAGES COULEURS ==="

echo "[1/5] Backup"
cp "$UI" "$BK"

echo "[2/5] Injection CSS variables + thème par défaut"
node <<'NODE'
const fs=require("fs");
const p="/opt/fireinners/frontend-react/app/dist/wolverine/index.html";
let s=fs.readFileSync(p,"utf8");

if(s.includes("WOLVERINE_THEME")){
  console.log("Theme system déjà présent");
  process.exit(0);
}

const css=`
<style id="WOLVERINE_THEME">
:root{
--bg:#0b1020;
--rose:#ec4899;
--turquoise:#2dd4bf;
--violet:#8b5cf6;
--mauve:#6d28d9;
--txt:#e9ecff;
--glass:rgba(255,255,255,.06);
}
html,body{
background:
radial-gradient(900px 500px at 20% 0%,rgba(236,72,153,.25),transparent 60%),
radial-gradient(700px 450px at 80% 20%,rgba(45,212,191,.22),transparent 55%),
var(--bg);
color:var(--txt)
}
h1,h2{
background:linear-gradient(90deg,var(--rose),var(--turquoise));
-webkit-background-clip:text;background-clip:text;color:transparent
}
.btn{
background:linear-gradient(135deg,var(--rose),var(--turquoise));
color:#fff;border:0
}
.panel,.card{
background:linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,.03));
backdrop-filter:blur(10px);
border:1px solid rgba(255,255,255,.15)
}
</style>
`;
s=s.replace(/<\/head>/i,css+"\n</head>");
fs.writeFileSync(p,s);
NODE

echo "[3/5] Ajout menu Réglages + sliders couleur"
node <<'NODE'
const fs=require("fs");
const p="/opt/fireinners/frontend-react/app/dist/wolverine/index.html";
let s=fs.readFileSync(p,"utf8");

const ui=`
<div id="settings" style="position:fixed;top:15px;right:15px;z-index:9999">
<button class="btn" onclick="toggleSettings()">⚙️</button>
<div id="settingsPanel" class="panel" style="display:none;padding:12px;margin-top:8px;width:220px">
<b>Couleurs UI</b><br><br>
<label>Rose <input type="color" id="c_rose"></label><br>
<label>Turquoise <input type="color" id="c_turquoise"></label><br>
<label>Violet <input type="color" id="c_violet"></label><br>
<label>Mauve <input type="color" id="c_mauve"></label><br><br>
<button class="btn" onclick="resetTheme()">Reset</button>
</div>
</div>
`;

s=s.replace(/<body[^>]*>/i,m=>m+ui);
fs.writeFileSync(p,s);
NODE

echo "[4/5] Injection JS logique thème (persistant)"
node <<'NODE'
const fs=require("fs");
const p="/opt/fireinners/frontend-react/app/dist/wolverine/index.html";
let s=fs.readFileSync(p,"utf8");

const js=`
<script>
const DEF={rose:"#ec4899",turquoise:"#2dd4bf",violet:"#8b5cf6",mauve:"#6d28d9"};
function applyTheme(t){
for(const k in t)document.documentElement.style.setProperty("--"+k,t[k]);
localStorage.setItem("wolverine_theme",JSON.stringify(t));
}
function loadTheme(){
const t=JSON.parse(localStorage.getItem("wolverine_theme")||"null")||DEF;
applyTheme(t);
["rose","turquoise","violet","mauve"].forEach(k=>{
const i=document.getElementById("c_"+k);
if(i){i.value=t[k];i.oninput=()=>{t[k]=i.value;applyTheme(t)}}
});
}
function resetTheme(){applyTheme(DEF);loadTheme()}
function toggleSettings(){
const p=document.getElementById("settingsPanel");
p.style.display=p.style.display==="none"?"block":"none";
}
window.addEventListener("load",loadTheme);
</script>
`;

s=s.replace(/<\/body>/i,js+"\n</body>");
fs.writeFileSync(p,s);
NODE

echo "[5/5] Reload nginx"
nginx -t && systemctl reload nginx

echo "DONE ✔️"
echo "Backup: $BK"
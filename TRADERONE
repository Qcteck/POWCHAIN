set -e
cd /root

echo "=== A) Nginx OK ? ==="
nginx -t

echo
echo "=== B) Port 3002 écoute ? ==="
ss -lptn 'sport = :3002' || true

echo
echo "=== C) Test direct upstream (doit répondre) ==="
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" \
  -H "content-type: application/json" --data '{}' | head -n 40 || true

echo
echo "=== D) Status + logs wolverine-api ==="
systemctl --no-pager -l status wolverine-api.service | tail -n 80 || true
journalctl -u wolverine-api.service -n 120 --no-pager || true

echo
echo "=== E) Logs nginx (raison du 502) ==="
tail -n 120 /var/log/nginx/error.log || true

echo
echo "=== F) Test via nginx en local (bypass Cloudflare) ==="
curl -sS -i -X POST "http://127.0.0.1/wolverine/traderone/api/status" \
  -H "Host: fireinners.online" -H "content-type: application/json" --data '{}' | head -n 40 || true
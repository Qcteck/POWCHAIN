cat >/root/fix_unexpected_brace_fireinners_ssl.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_routes.conf"

echo "== 1) Show error context =="
nl -ba "$VHOST" | sed -n '30,55p'

echo
echo "== 2) Find latest backup of vhost =="
LATEST="$(ls -1t ${VHOST}.bak_* 2>/dev/null | head -n 1 || true)"
echo "LATEST=$LATEST"
[ -n "$LATEST" ] || { echo "No backup found (${VHOST}.bak_*)"; exit 1; }

echo
echo "== 3) Restore backup =="
cp -a "$VHOST" "${VHOST}.broken_$(date +%Y%m%d_%H%M%S)"
cp -a "$LATEST" "$VHOST"

echo
echo "== 4) Ensure snippet exists (write if missing) =="
if [ ! -f "$SNIP" ]; then
cat > "$SNIP" <<'NGX'
# ---- Wolverine routes (include inside server {}) ----

location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}

location = /wolverine/traderone/api {
  return 301 /wolverine/traderone/api/;
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:8585;
}
NGX
fi

echo
echo "== 5) Insert include INSIDE first server{} only =="
python3 - <<'PY'
import re
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_routes.conf"

lines=open(VHOST,"r",errors="ignore").read().splitlines(True)

# find first server {
start=None
for i,l in enumerate(lines):
    if re.search(r'^\s*server\s*\{', l):
        start=i; break
if start is None:
    raise SystemExit("No server { found")

# find its matching closing brace
depth=0
end=None
for i in range(start, len(lines)):
    depth += lines[i].count("{")
    depth -= lines[i].count("}")
    if depth==0 and i>start:
        end=i
        break
if end is None:
    raise SystemExit("Could not find end of server block (brace mismatch)")

server = lines[:end+1]
rest   = lines[end+1:]

inc = f"  include {SNIP};\n"
if not any(SNIP in l for l in server):
    server.insert(len(server)-1, inc)

open(VHOST,"w").writelines(server + rest)
PY

echo
echo "== 6) nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo
echo "== 7) Quick tests =="
curl -sk -o /dev/null -w "UI /wolverine/ : %{http_code}\n" https://fireinners.online/wolverine/
curl -sk -o /dev/null -w "Traderone health : %{http_code}\n" https://fireinners.online/wolverine/traderone/api/health
echo "DONE ✅"
BASH

chmod +x /root/fix_unexpected_brace_fireinners_ssl.sh
/root/fix_unexpected_brace_fireinners_ssl.sh
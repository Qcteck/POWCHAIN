python3 - <<PY
from pathlib import Path
p=Path("$NGINX_SITE")
s=p.read_text(errors="ignore")
inc='include /etc/nginx/includes/wolverine_routes.inc;'
if inc not in s:
  # try to insert near other includes inside the ssl server block
  if "server {" in s:
    parts=s.split("server {",1)
    head,rest=parts[0], "server {"+parts[1]
    # insert after first occurrence of "root" or after "server {" line
    lines=rest.splitlines(True)
    out=[]
    inserted=False
    for i,line in enumerate(lines):
      out.append(line)
      if (not inserted) and ("root " in line or "index " in line):
        out.append("    "+inc+"\n")
        inserted=True
    if not inserted:
      # fallback: right after server {
      out = ["server {\n","    "+inc+"\n"] + lines[1:]
    s=head+"".join(out)
  p.write_text(s)
print("OK: vhost include present")
PY


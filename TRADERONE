cat >/root/nginx_fix_stub_locations.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"

# 0) Si tu as un vieux conf cassé dans conf.d, on le neutralise
BAD="/etc/nginx/conf.d/wolverine_traderone_api_stub.conf"
if [[ -f "$BAD" ]]; then
  mv -f "$BAD" "${BAD}.disabled_$(date +%Y%m%d_%H%M%S)"
fi

# 1) Snippet avec locations (OK seulement si inclus DANS un server {})
SNIP="/etc/nginx/snippets/wolverine_traderone_stub_locations.conf"
mkdir -p /etc/nginx/snippets
cat >"$SNIP" <<'NGINX'
# TraderOne API stubs to prevent UI crash when backend endpoints are missing

location = /wolverine/traderone/api/me {
  default_type application/json;
  return 200 '{"ok":true,"me":{"id":"guest","wallet":null}}';
}

location = /wolverine/traderone/api/positions {
  default_type application/json;
  return 200 '{"ok":true,"positions":[]}';
}

location = /wolverine/traderone/api/orders {
  default_type application/json;
  return 200 '{"ok":true,"orders":[]}';
}

location = /wolverine/traderone/api/pnl {
  default_type application/json;
  return 200 '{"ok":true,"pnl":{"total":0,"daily":0}}';
}
NGINX

# 2) Trouver le fichier du server { } qui a server_name fireinners.online
SERVER_FILE="$(
nginx -T 2>/dev/null | awk -v dom="$DOMAIN" '
  /^# configuration file /{file=$4; sub(/:$/,"",file)}
  $0 ~ /server_name/ && $0 ~ dom {print file; exit}
'
)"
if [[ -z "${SERVER_FILE:-}" || ! -f "$SERVER_FILE" ]]; then
  echo "[ERR] Impossible de trouver le server block pour $DOMAIN via nginx -T"
  echo "Fais: nginx -T | grep -n \"server_name\" | head -n 30"
  exit 1
fi
echo "[*] server config: $SERVER_FILE"

# 3) Injecter l'include dans ce server block (idempotent)
if ! grep -qF "$SNIP" "$SERVER_FILE"; then
  cp -a "$SERVER_FILE" "${SERVER_FILE}.bak_$(date +%Y%m%d_%H%M%S)"
  perl -0777 -i -pe '
    my $snip = $ENV{SNIP};
    my $dom  = $ENV{DOM};
    # insert include just before the closing brace of the first matching server block
    s/(server\s*\{(?:(?!server\s*\{).)*?server_name[^;]*\b\Q$dom\E\b[^;]*;(?:(?!server\s*\{).)*?)\n\}/$1\n  include $snip;\n}\n/s
      or die "Could not inject include in server block\n";
  ' "$SERVER_FILE" SNIP="$SNIP" DOM="$DOMAIN"
fi

nginx -t
systemctl reload nginx

echo "[OK] stubs installed."
echo "Tests:"
echo "  curl -s https://$DOMAIN/wolverine/traderone/api/me"
echo "  curl -s https://$DOMAIN/wolverine/traderone/api/orders"
BASH

chmod +x /root/nginx_fix_stub_locations.sh
/root/nginx_fix_stub_locations.sh
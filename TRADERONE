cat >/root/FIX_NGINX_TRADERONE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
BACKUP="/root/nginx_fireinners_backup_$(date +%s).conf"

echo "[FIX] backup vhost"
cp -a "$VHOST" "$BACKUP"

echo "[FIX] clean any misplaced TraderOne blocks"
sed -i '/# --- TRADERONE ---/,/# --- END TRADERONE ---/d' "$VHOST"

echo "[FIX] reinject TraderOne INSIDE server{}"

awk '
BEGIN{done=0}
{
  print
  if(!done && $0 ~ /server\s*{/){
    print "    # --- TRADERONE ---"
    print "    location ^~ /wolverine/ {"
    print "        root /opt/fireinners/frontend-react/app/dist;"
    print "        index index.html;"
    print "        try_files $uri $uri/ /wolverine/index.html;"
    print "    }"
    print ""
    print "    location ^~ /api/ {"
    print "        proxy_pass http://127.0.0.1:3000/;"
    print "        proxy_http_version 1.1;"
    print "        proxy_set_header Host $host;"
    print "        proxy_set_header X-Real-IP $remote_addr;"
    print "        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
    print "    }"
    print "    # --- END TRADERONE ---"
    done=1
  }
}' "$VHOST" > /tmp/fireinners.fixed && mv /tmp/fireinners.fixed "$VHOST"

echo "[FIX] test nginx"
nginx -t

echo "[FIX] reload nginx"
systemctl reload nginx

echo "[OK] nginx fixed successfully"
echo "[INFO] backup saved at: $BACKUP"
SH

chmod +x /root/FIX_NGINX_TRADERONE.sh
/root/FIX_NGINX_TRADERONE.sh
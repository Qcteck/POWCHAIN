set -euo pipefail

APP="/opt/fireinners/frontend-react/app"
DIST="/var/www/wolverine"

cd "$APP"
pwd
ls -lah

# Vars prod Vite
cat > .env.production <<'EOF'
VITE_BASE=/wolverine/
VITE_API_BASE=/wolverine/traderone/api
EOF

# Si lockfile absent -> npm install (au lieu de npm ci)
if [ ! -f package-lock.json ]; then
  echo "INFO: pas de package-lock.json -> npm install (génère le lockfile)"
  npm install
else
  echo "INFO: package-lock.json présent -> npm ci OK"
  npm ci
fi

npm run build

# deploy
apt-get update -y
apt-get install -y rsync
mkdir -p "$DIST"
rsync -a --delete "$APP/dist/" "$DIST/"
chmod -R 755 /var/www
find "$DIST" -type f -exec chmod 644 {} \;

curl -sS -I https://fireinners.online/wolverine/ | head -n 12
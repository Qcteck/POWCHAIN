cat > server.js <<'JS'
const express=require("express"),fs=require("fs"),crypto=require("crypto"),body=require("body-parser"),cors=require("cors");
const {Keypair,Connection,clusterApiUrl,PublicKey}=require("@solana/web3.js");
const app=express();app.use(cors());app.use(body.json());
const DATA="./vaults.json";const SECRET=crypto.createHash("sha256").update("TRADERONE_MASTER_KEY").digest();
const RPC=new Connection(clusterApiUrl("mainnet-beta"));
const load=()=>fs.existsSync(DATA)?JSON.parse(fs.readFileSync(DATA)):{};
const save=d=>fs.writeFileSync(DATA,JSON.stringify(d,null,2));
const enc=t=>{const iv=crypto.randomBytes(16);const c=crypto.createCipheriv("aes-256-cbc",SECRET,iv);
return iv.toString("hex")+":"+Buffer.concat([c.update(t),c.final()]).toString("hex");};
const dec=t=>{const [iv,d]=t.split(":");const dc=crypto.createDecipheriv("aes-256-cbc",SECRET,Buffer.from(iv,"hex"));
return Buffer.concat([dc.update(Buffer.from(d,"hex")),dc.final()]).toString();};

app.post("/create-vault",(req,res)=>{
 const user=req.body.pub; if(!user) return res.status(400).end();
 const db=load(); if(db[user]) return res.json(db[user].pub);
 const kp=Keypair.generate();
 db[user]={pub:kp.publicKey.toBase58(),priv:enc(Buffer.from(kp.secretKey).toString("hex")),created:Date.now()};
 save(db); res.json({vault:db[user].pub});
});

app.get("/vault/:user",async(req,res)=>{
 const db=load(); const v=db[req.params.user]; if(!v) return res.status(404).end();
 const bal=await RPC.getBalance(new PublicKey(v.pub));
 res.json({address:v.pub,sol:bal/1e9});
});

app.post("/withdraw",(req,res)=>{
 const {user,to}=req.body; const db=load(); if(!db[user]) return res.status(404).end();
 // hook TRADERONE WITHDRAW HERE
 res.json({status:"queued"});
});

app.listen(3000,()=>console.log("TraderOne Vault API :3000"));
JS

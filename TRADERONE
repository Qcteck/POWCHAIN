cat > /root/WOLVERINE_JS_CLEAN_RESET.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/WOLVERINE_JS_CLEAN_RESET_${TS}.log"
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

echo "=== WOLVERINE JS CLEAN RESET ===" | tee "$LOG"
test -f "$HTML" || { echo "HTML absent"; exit 1; }

cp -a "$HTML" "${HTML}.bak_${TS}"
echo "Backup: ${HTML}.bak_${TS}" | tee -a "$LOG"

# 1) Supprimer TOUT JS inline existant
perl -0777 -i -pe 's/<script\b[^>]*>[\s\S]*?<\/script>//gi' "$HTML"

# 2) Injecter UI minimale + JS propre AVANT </body>
sed -i "/<\/body>/i \
<div id=\"walletBox\" style=\"padding:12px;border:1px solid #333;margin:12px 0\">\
<button id=\"btnConnect\">Connect Wallet</button>\
<div>Address: <span id=\"addr\">-</span></div>\
<div>SOL: <span id=\"sol\">-</span></div>\
<div>USDC: <span id=\"usdc\">-</span></div>\
</div>\
<script>\
(function(){\
 const RPC=\"${RPC}\";\
 const USDC_MINT=\"${USDC_MINT}\";\
 const {Connection,PublicKey}=solanaWeb3;\
 const conn=new Connection(RPC,'confirmed');\
 let pub=null;\
 async function connect(){\
  if(!window.solana){alert('Phantom absent');return;}\
  const r=await window.solana.connect();\
  pub=r.publicKey.toString();\
  document.getElementById('addr').innerText=pub;\
  await refresh();\
 }\
 async function readSOL(){\
  const b=await conn.getBalance(new PublicKey(pub));\
  document.getElementById('sol').innerText=(b/1e9).toFixed(6);\
 }\
 async function readUSDC(){\
  const res=await conn.getParsedTokenAccountsByOwner(new PublicKey(pub),{mint:new PublicKey(USDC_MINT)});\
  let sum=0;res.value.forEach(v=>sum+=v.account.data.parsed.info.tokenAmount.uiAmount||0);\
  document.getElementById('usdc').innerText=sum.toFixed(6);\
 }\
 async function refresh(){ await readSOL(); await readUSDC(); }\
 document.getElementById('btnConnect').addEventListener('click',()=>connect().catch(e=>alert(e.message)));\
})();\
</script>" "$HTML"

# 3) Purge cache + reload nginx
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx

echo "=== DONE ===" | tee -a "$LOG"
echo "ACTION: CTRL+SHIFT+R sur /wolverine"
echo "LOG: $LOG"
BASH

chmod +x /root/WOLVERINE_JS_CLEAN_RESET.sh
/root/WOLVERINE_JS_CLEAN_RESET.sh
cat >/root/fix_rpc_endpoints_and_patch_js.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SSL="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
ROOT="/var/www/wolverine"
JS="$ROOT/phantom_patch.js"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== Backup =="
cp -a "$SSL" "${SSL}.bak_${ts}" || true
cp -a "$SNIP" "${SNIP}.bak_${ts}" 2>/dev/null || true
cp -a "$JS"  "${JS}.bak_${ts}"    2>/dev/null || true

echo "== 1) Write RPC snippet (serves /wolverine/rpc AND /rpc) =="
mkdir -p /etc/nginx/snippets
cat >"$SNIP" <<'NGINX'
# Include INSIDE server{} only.

# Main endpoint (preferred)
location = /wolverine/rpc {
  auth_basic off;
  allow all;

  add_header Access-Control-Allow-Origin "*" always;
  add_header Access-Control-Allow-Headers "*" always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }

  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;
}

# Also support /rpc (some scripts call this)
location = /rpc {
  auth_basic off;
  allow all;

  add_header Access-Control-Allow-Origin "*" always;
  add_header Access-Control-Allow-Headers "*" always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }

  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;
}
NGINX

echo "== 2) Ensure snippet is included ONCE in SSL vhost =="
# remove duplicate includes
awk '
  {
    if ($0 ~ /include[[:space:]]+\/etc\/nginx\/snippets\/solana_rpc_proxy\.conf;/) {
      if (seen==1) next;
      seen=1;
    }
    print
  }
' "$SSL" > /tmp/ssl.$$ && cat /tmp/ssl.$$ > "$SSL" && rm -f /tmp/ssl.$$

# add include if missing (after server_name line)
if ! grep -q "solana_rpc_proxy.conf" "$SSL"; then
  sed -i '/server_name .*fireinners\.online/ a\  include /etc/nginx/snippets/solana_rpc_proxy.conf;' "$SSL"
fi

ln -sf "$SSL" "$EN"

echo "== 3) Patch phantom_patch.js to use /wolverine/rpc =="
if [[ -f "$JS" ]]; then
  sed -i 's@/srpc@/wolverine/rpc@g' "$JS" || true
  sed -i 's@/solana-rpc@/wolverine/rpc@g' "$JS" || true
  sed -i 's@/rpc@/wolverine/rpc@g' "$JS" || true
fi

echo "== 4) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== 5) TEST /wolverine/rpc (public) =="
curl -sk -i "https://${DOMAIN}/wolverine/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,25p'

echo
echo "== 6) TEST /rpc (public) =="
curl -sk -i "https://${DOMAIN}/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,25p'

echo
echo "Open (cache-bust): https://${DOMAIN}/wolverine/?v=$ts"
BASH

chmod +x /root/fix_rpc_endpoints_and_patch_js.sh
/root/fix_rpc_endpoints_and_patch_js.sh
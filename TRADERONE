# ROOT batch — trouver où est le vrai frontend (script build), build, deploy, reload nginx
set -euo pipefail

REPO="/opt/fireinners/WOLVERINE"
DIST="/var/www/wolverine"
NG="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "=== 0) Sanity ==="
cd "$REPO"
ls -lah | head

echo "=== 1) Trouver un package.json qui a un script 'build' (hors node_modules) ==="
CANDIDATE_PKG="$(find "$REPO" -type f -name package.json \
  -not -path "*/node_modules/*" \
  -exec sh -c 'grep -q "\"build\"" "$1" && echo "$1"' sh {} \; \
  | head -n 1)"

if [ -z "${CANDIDATE_PKG:-}" ]; then
  echo "KO: aucun package.json avec script build trouvé dans $REPO"
  echo "INFO: scripts du package.json racine:"
  (cat "$REPO/package.json" | sed -n '1,140p') || true
  exit 1
fi

APP_DIR="$(dirname "$CANDIDATE_PKG")"
echo "OK: build trouvé dans: $APP_DIR"

echo "=== 2) Build (Node déjà OK) ==="
cd "$APP_DIR"

# Vite env (OK même si ignoré par un autre tooling)
cat > .env.production <<'EOF'
VITE_BASE=/wolverine/
VITE_API_BASE=/wolverine/traderone/api
EOF

npm ci
npm run build

echo "=== 3) Détecter le dossier de sortie (dist/build/out) ==="
OUT=""
for d in dist build out; do
  if [ -d "$APP_DIR/$d" ]; then OUT="$APP_DIR/$d"; break; fi
done
[ -n "$OUT" ] || { echo "KO: aucun dossier dist/build/out trouvé après build"; exit 1; }
echo "OK: output=$OUT"

echo "=== 4) Deploy vers /var/www/wolverine ==="
apt-get update -y >/dev/null
apt-get install -y rsync >/dev/null
mkdir -p "$DIST"
rsync -a --delete "$OUT/" "$DIST/"
chmod -R 755 /var/www
find "$DIST" -type f -exec chmod 644 {} \;

echo "=== 5) Nginx: UI /wolverine => /var/www/wolverine (sans toucher à l'API) ==="
cp -a "$NG" "$NG.bak.ui_deploy_$(date +%s)"

python3 - <<'PY'
from pathlib import Path
import re
ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# enlève anciens blocs UI /wolverine
for pat in [
  r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*',
]:
  s = re.sub(pat, "\n", s, flags=re.M)

block = r'''
# --- WOLVERINE UI (served from /var/www/wolverine) ---
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}
'''
i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: pas trouvé de '}' final dans le conf nginx")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: UI bloc injected")
PY

nginx -t
systemctl reload nginx

echo "=== 6) Tests ==="
curl -sS -I https://fireinners.online/wolverine/ | head -n 12
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12
echo "DONE ✅"
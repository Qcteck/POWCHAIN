cat >/tmp/FIND_AND_REMOVE_SOLANA_IIFE_WOLVERINE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

URL="https://fireinners.online/wolverine/"
TMP="/tmp/wolverine_live.html"

echo "== 1) HTML réellement servi (live) =="
curl -ks "$URL" > "$TMP"
echo "Saved: $TMP"
echo

echo "== 2) Scripts chargés (live) =="
grep -nE '<script[^>]+src=' "$TMP" || true
echo
echo "== 2b) Cherche index.iife.min.js / solana web3 dans le HTML live =="
grep -nE 'index\.iife\.min\.js|unpkg\.com/@solana/web3\.js|@solana/web3\.js|connection\.ts' "$TMP" || true
echo

echo "== 3) Retrouver sur disque les fichiers HTML qui contiennent index.iife.min.js / solana web3 =="
MATCHES="$(grep -RIl --exclude-dir=node_modules --exclude-dir=.git -E 'index\.iife\.min\.js|unpkg\.com/@solana/web3\.js|@solana/web3\.js' /var/www /usr/share/nginx /opt 2>/dev/null || true)"
echo "$MATCHES" | sed '/^$/d' || true
echo

if [ -z "${MATCHES// }" ]; then
  echo "Aucun fichier HTML trouvé sur disque avec index.iife.min.js / solana web3."
  echo "=> Dans ce cas, c'est probablement servi via un alias/root ailleurs. Donne: nginx -T | grep -n 'location /wolverine' -n"
  exit 1
fi

echo "== 4) Backup + suppression des scripts solana =="
while IFS= read -r f; do
  [ -z "$f" ] && continue
  cp -a "$f" "$f.bak.$(date +%s)"
  sed -i -E '/index\.iife\.min\.js/d;/unpkg\.com\/@solana\/web3\.js/d;/@solana\/web3\.js/d' "$f"
  echo "patched: $f"
done <<< "$MATCHES"
echo

echo "== 5) Reload nginx =="
nginx -t && systemctl reload nginx
echo

echo "== 6) PREUVE (live) après patch: le HTML ne doit plus contenir index.iife.min.js / solana web3 =="
curl -ks "$URL" | grep -nE 'index\.iife\.min\.js|unpkg\.com/@solana/web3\.js|@solana/web3\.js' \
  && echo "BAD: encore présent" || echo "OK ✅: plus de solana iife/web3"
SH

bash /tmp/FIND_AND_REMOVE_SOLANA_IIFE_WOLVERINE.sh
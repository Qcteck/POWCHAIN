cat >/root/FIX_AQUILATRADER_405_POST.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/wolverine_traderone_proxy.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

echo "== UNFREEZE =="
chattr -i "$INC" 2>/dev/null || true
chattr -i "$VHOST" 2>/dev/null || true
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true

echo "== WRITE POST-SAFE PROXY =="
cat >"$INC" <<'NGINX'
# WOLVERINE_TRADERONE_PROXY_V2_POST_SAFE

# API
location ^~ /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000/api/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # Allow all methods
    proxy_method $request_method;
    proxy_pass_request_body on;
    proxy_set_header Content-Length $content_length;

    add_header Cache-Control "no-store" always;
}

# VAULT
location ^~ /wolverine/traderone/vault/ {
    proxy_pass http://127.0.0.1:3000/vault/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_method $request_method;
    proxy_pass_request_body on;
    proxy_set_header Content-Length $content_length;

    add_header Cache-Control "no-store" always;
}
NGINX

echo "== TEST + RELOAD =="
nginx -t
systemctl reload nginx

echo "== REFREEZE =="
chattr +i "$INC" 2>/dev/null || true
chattr +i "$VHOST" 2>/dev/null || true
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true

echo "== DONE: POST ENABLED =="
BASH

chmod +x /root/FIX_AQUILATRADER_405_POST.sh
bash /root/FIX_AQUILATRADER_405_POST.sh |& tee /root/FIX_AQUILATRADER_405_POST.log
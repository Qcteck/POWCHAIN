cat >/root/FIREINNERS_WALLET_PATCH_BALANCES.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
WALLET_HTML="/opt/fireinners/frontend-react/app/dist/wallet/index.html"
BK="/root/backup_fireinners_wallet_patch_balances_${TS}"
mkdir -p "$BK"
[ -f "$WALLET_HTML" ] && cp -a "$WALLET_HTML" "$BK/index.html.bak" || true

cat >"$WALLET_HTML" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>FireInners • Wallet</title><style>:root{--bg:#050610;--p:#0b1022;--l:rgba(255,255,255,.14);--t:#e7f0ff;--m:#9fb3d7}*{box-sizing:border-box}html,body{margin:0;height:100%;background:radial-gradient(900px 500px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(700px 450px at 80% 20%,#101a33 0%,transparent 55%),var(--bg);color:var(--t);font:14px system-ui}#wrap{max-width:980px;margin:0 auto;padding:18px}h1{margin:0 0 6px;font-size:26px}p{margin:0 0 14px;color:var(--m)}#row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:10px 0 14px}button{cursor:pointer;border:1px solid var(--l);background:rgba(0,0,0,.18);color:var(--t);padding:10px 14px;border-radius:14px;font-weight:700}button:disabled{opacity:.45;cursor:not-allowed}#grid{display:grid;grid-template-columns:1.2fr .8fr;gap:12px}#card{background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));border:1px solid var(--l);border-radius:16px;padding:12px}#card h2{margin:0 0 8px;font-size:14px;color:var(--m);font-weight:800}#mono{font:13px ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;word-break:break-word}#big{display:grid;grid-template-columns:1fr 1fr;gap:12px}#pill{display:inline-flex;gap:8px;align-items:center}#pill a{color:var(--t);text-decoration:none;border:1px solid var(--l);padding:8px 12px;border-radius:999px;background:rgba(0,0,0,.18)}#log{margin-top:12px;height:220px;overflow:auto;border:1px solid var(--l);border-radius:16px;background:rgba(0,0,0,.18);padding:10px;font:12px ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap}</style></head><body><div id="wrap"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px"><div><h1>FireInners • Wallet</h1><p>Lecture soldes via Phantom + Solana RPC. Aucun secret, aucune seed, aucun export.</p></div><div id="pill"><a href="/">Retour</a></div></div><div id="row"><button id="btnConnect">Connect</button><button id="btnDisc" disabled>Disconnect</button><button id="btnRefresh" disabled>Refresh</button></div><div id="grid"><div id="card"><h2>Adresse</h2><div id="mono"><div id="addr">—</div><div style="height:10px"></div><div>RPC (SOL)</div><div id="rpcSol">—</div><div style="height:8px"></div><div>RPC (USDC)</div><div id="rpcUsdc">—</div></div></div><div id="big"><div id="card"><h2>SOL</h2><div id="mono" style="font-size:18px;font-weight:900"><span id="sol">—</span></div></div><div id="card"><h2>USDC</h2><div id="mono" style="font-size:18px;font-weight:900"><span id="usdc">—</span></div></div></div></div><div id="log"></div></div><script src="https://unpkg.com/@solana/web3.js@1.98.0/lib/index.iife.min.js"></script><script>(()=>{const $=s=>document.querySelector(s);const LOG=m=>{const el=$("#log");el.textContent+=(m+(m.endsWith("\n")?"":"\n"));el.scrollTop=el.scrollHeight};const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const SOLRPC=location.origin+"/solrpc";$("#rpcSol").textContent=SOLRPC;$("#rpcUsdc").textContent=SOLRPC;let ph=null,pub=null,conn=null;const fmt=(n,d=6)=>{try{return (Number(n)||0).toLocaleString(undefined,{maximumFractionDigits:d})}catch(e){return String(n)}};async function refresh(){if(!pub||!conn){LOG("REFRESH ERR: not connected");return}try{const lam=await conn.getBalance(pub,"confirmed");$("#sol").textContent=fmt(lam/1e9,6);LOG("SOL OK")}catch(e){$("#sol").textContent="—";LOG("SOL ERR: "+(e?.message||e))}try{const r=await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)},"confirmed");let sum=0;for(const it of (r?.value||[])){const ui=it?.account?.data?.parsed?.info?.tokenAmount?.uiAmount;sum+=Number(ui||0)}$("#usdc").textContent=fmt(sum,6);LOG("USDC OK")}catch(e){$("#usdc").textContent="—";LOG("USDC ERR: "+(e?.message||e))}}async function connect(){try{ph=window.solana;if(!ph||!ph.isPhantom){LOG("Phantom introuvable (ouvre dans Phantom ou installe l’extension).");return}const r=await ph.connect();pub=r.publicKey;conn=new solanaWeb3.Connection(SOLRPC,{commitment:"confirmed"});$("#addr").textContent=pub.toBase58();$("#btnDisc").disabled=false;$("#btnRefresh").disabled=false;LOG("CONNECTED");await refresh()}catch(e){LOG("CONNECT ERR: "+(e?.message||e))}}async function disconnect(){try{if(ph&&ph.disconnect) await ph.disconnect()}catch(e){}pub=null;conn=null;$("#addr").textContent="—";$("#sol").textContent="—";$("#usdc").textContent="—";$("#btnDisc").disabled=true;$("#btnRefresh").disabled=true;LOG("DISCONNECTED")}$("#btnConnect").onclick=connect;$("#btnDisc").onclick=disconnect;$("#btnRefresh").onclick=refresh;LOG("READY")})();</script></body></html>
HTML

systemctl start fireinners-walletfix.service >/dev/null 2>&1 || true

echo "OK patched: $WALLET_HTML"
echo "Check IDs:"
grep -n 'id="sol"' "$WALLET_HTML" | head -n 2 || true
grep -n 'id="usdc"' "$WALLET_HTML" | head -n 2 || true
echo "Test URL: https://fireinners.online/wallet/?v=${TS}"
SH
chmod +x /root/FIREINNERS_WALLET_PATCH_BALANCES.sh
bash /root/FIREINNERS_WALLET_PATCH_BALANCES.sh
const http = require("http");
const { URL } = require("url");

const BIND = process.env.BIND || "127.0.0.1";
const PORT = Number(process.env.PORT || 12703);
const UPSTREAM = process.env.UPSTREAM || "";

if (!UPSTREAM) {
  console.error("Missing UPSTREAM env (ex: https://lb.drpc.live/solana/XXXX)");
  process.exit(1);
}

function readBody(req) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    req.on("data", (c) => chunks.push(c));
    req.on("end", () => resolve(Buffer.concat(chunks)));
    req.on("error", reject);
  });
}

function proxyJsonRpc(bodyBuf, res) {
  const u = new URL(UPSTREAM);
  const lib = (u.protocol === "https:") ? require("https") : require("http");

  const upstreamReq = lib.request({
    protocol: u.protocol,
    hostname: u.hostname,
    port: u.port || (u.protocol === "https:" ? 443 : 80),
    path: u.pathname + u.search,
    method: "POST",
    headers: {
      "content-type": "application/json",
      "content-length": bodyBuf.length,
      "user-agent": "wolverine-solrpc-proxy/1.0",
      "accept": "*/*",
    },
  }, (upstreamRes) => {
    const chunks = [];
    upstreamRes.on("data", (c) => chunks.push(c));
    upstreamRes.on("end", () => {
      const out = Buffer.concat(chunks);
      res.statusCode = upstreamRes.statusCode || 502;
      res.setHeader("content-type", upstreamRes.headers["content-type"] || "application/json");
      res.setHeader("cache-control", "no-store");
      res.end(out);
    });
  });

  upstreamReq.on("error", (e) => {
    res.statusCode = 502;
    res.setHeader("content-type", "application/json");
    res.end(JSON.stringify({ jsonrpc:"2.0", id:null, error:{ code:-32000, message:String(e && e.message ? e.message : e) } }));
  });

  upstreamReq.write(bodyBuf);
  upstreamReq.end();
}

const server = http.createServer(async (req, res) => {
  try {
    const url = new URL(req.url, `http://${req.headers.host || "localhost"}`);
    if (req.method === "GET" && (url.pathname === "/" || url.pathname === "/health")) {
      res.statusCode = 200;
      res.setHeader("content-type", "application/json");
      res.setHeader("cache-control", "no-store");
      return res.end(JSON.stringify({ ok:true, upstream:UPSTREAM }));
    }

    if (req.method !== "POST") {
      res.statusCode = 405;
      res.setHeader("content-type", "application/json");
      return res.end(JSON.stringify({ ok:false, error:"POST only" }));
    }

    const body = await readBody(req);
    return proxyJsonRpc(body, res);
  } catch (e) {
    res.statusCode = 500;
    res.setHeader("content-type", "application/json");
    return res.end(JSON.stringify({ ok:false, error:String(e && e.message ? e.message : e) }));
  }
});

server.listen(PORT, BIND, () => {
  console.log(`Wolverine Solana RPC proxy listening on http://${BIND}:${PORT} -> ${UPSTREAM}`);
});
JS

# Systemd service

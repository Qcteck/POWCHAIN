python3 - <<PY
from pathlib import Path
p=Path("$NGX_INC")
s=p.read_text(errors="ignore")
block=f"""
  # --- Wolverine Solana RPC (same-origin) ---
  location = /wolverine/solana-rpc {{
    proxy_pass http://127.0.0.1:{int("$PORT")}/;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    add_header Cache-Control "no-store" always;
  }}
"""
if "location = /wolverine/solana-rpc" in s:
    import re
    s=re.sub(r"(?s)\s*# --- Wolverine Solana RPC.*?location\s*=\s*/wolverine/solana-rpc\s*\{.*?\}\s*", "\n"+block+"\n", s)
else:
    s += "\n" + block + "\n"
p.write_text(s)
print("OK: nginx include patched")

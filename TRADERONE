bash <<'EOF'
set -e
echo "=== WOLVERINE • BOOTSTRAP UI PRO ==="

BASE="/opt/fireinners"
WOLV="$BASE/wolverine"
BACKUP="$BASE/backup_wolverine_legacy_$(date +%Y%m%d_%H%M%S)"

echo "[1/6] Backup ancien /wolverine"
mkdir -p "$BACKUP"
if [ -d "$WOLV" ]; then
  cp -a "$WOLV" "$BACKUP/"
fi

echo "[2/6] Nettoyage dossier wolverine"
rm -rf "$WOLV"
mkdir -p "$WOLV"

echo "[3/6] Init projet Vite + React"
cd "$WOLV"
npm init -y >/dev/null 2>&1
npm install react react-dom >/dev/null
npm install -D vite @vitejs/plugin-react >/dev/null

echo "[4/6] Fichiers de base"

cat > vite.config.js <<'VITE'
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
export default defineConfig({
  plugins: [react()],
  base: '/wolverine/',
})
VITE

cat > index.html <<'HTML'
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wolverine</title>
</head>
<body>
  <div id="root"></div>
  <script type="module" src="/src/main.jsx"></script>
</body>
</html>
HTML

mkdir -p src/layout src/pages src/components

cat > src/main.jsx <<'JSX'
import React from 'react'
import ReactDOM from 'react-dom/client'
import App from './App'
import './style.css'

ReactDOM.createRoot(document.getElementById('root')).render(
  <React.StrictMode>
    <App />
  </React.StrictMode>
)
JSX

cat > src/App.jsx <<'JSX'
import Sidebar from './layout/Sidebar'
import Dashboard from './pages/Dashboard'

export default function App(){
  return (
    <div className="app">
      <Sidebar />
      <Dashboard />
    </div>
  )
}
JSX

cat > src/layout/Sidebar.jsx <<'JSX'
export default function Sidebar(){
  return (
    <aside className="sidebar">
      <h1>Wolverine</h1>
      <nav>
        <a>Dashboard</a>
        <a>Trade</a>
        <a>Positions</a>
        <a>Orders</a>
        <a>History</a>
        <a>Wallet</a>
        <a>Settings</a>
      </nav>
    </aside>
  )
}
JSX

cat > src/pages/Dashboard.jsx <<'JSX'
export default function Dashboard(){
  return (
    <main className="main">
      <h2>Dashboard</h2>
      <div className="panel">News / Overview</div>
      <div className="panel">Trading Panel</div>
    </main>
  )
}
JSX

cat > src/style.css <<'CSS'
*{box-sizing:border-box}
html,body,#root{margin:0;height:100%}
.app{display:flex;height:100%;background:#0b1220;color:#e5e7eb;font-family:system-ui}
.sidebar{width:220px;background:#0f172a;padding:16px}
.sidebar a{display:block;margin:10px 0;color:#cbd5f5;text-decoration:none}
.main{flex:1;padding:24px}
.panel{background:rgba(255,255,255,0.05);border-radius:12px;padding:20px;margin-bottom:20px}
CSS

echo "[5/6] Build frontend"
npx vite build >/dev/null

echo "[6/6] Permissions"
chown -R www-data:www-data "$WOLV"

echo "=== BOOTSTRAP TERMINÉ ==="
echo "Backup legacy : $BACKUP"
echo "UI active : https://fireinners.online/wolverine/"
EOF
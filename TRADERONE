cat >/tmp/wolfchain_fix_home_ping.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ROOT="/opt/fireinners/frontend-react/app/dist"
HOME="$ROOT/index.html"
[[ -f "$HOME" ]] || { echo "ERR: $HOME introuvable"; exit 1; }

ts(){ date +"%Y%m%d-%H%M%S"; }
cp -a "$HOME" "$HOME.pingbak.$(ts)" && echo "backup: $HOME.pingbak.$(ts)"

python3 - <<'PY'
from pathlib import Path
p=Path("/opt/fireinners/frontend-react/app/dist/index.html")
s=p.read_text(encoding="utf-8",errors="ignore")
# Remplace la logique ping: si fetch réussit => online même si 404
s=s.replace("if(!r.ok)throw 0;apiOK=true","apiOK=true")
p.write_text(s,encoding="utf-8")
print("OK: ping logic patched")
PY
SH
bash /tmp/wolfchain_fix_home_ping.sh
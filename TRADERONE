  askorupdate_file(){ local p="$1" n="$2" c="$3"; install -d "$(dirname "$p")"; if [ -f "$p" ]; then cp -a "$p" "$p.bak.$(date -u +%Y%m%d%H%M%S)" || true; fi; printf "%s" "$c" >"$p"; }

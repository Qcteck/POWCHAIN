cat >/root/traderone_audit_paths.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== 0) Host / time ==="
date -u
hostname
echo

echo "=== 1) /var/www overview ==="
ls -lah /var/www || true
echo

echo "=== 2) Find Node app roots (package.json / pm2 / server files) ==="
find /var/www -maxdepth 6 -type f \
  \( -name package.json -o -name ecosystem.config.js -o -name server.js -o -name app.js -o -name index.js \) \
  -print 2>/dev/null | sed 's|^|/var/www: |'
echo

echo "=== 3) Find package.json globally (first 80) ==="
find / -maxdepth 5 -type f -name package.json 2>/dev/null | head -n 80
echo

echo "=== 4) PM2 status (often reveals cwd/script path) ==="
if command -v pm2 >/dev/null 2>&1; then
  pm2 list || true
  echo
  echo "--- pm2 show (0..5) ---"
  for i in 0 1 2 3 4 5; do
    pm2 show "$i" 2>/dev/null | sed -n '1,120p' && echo "-----"
  done
else
  echo "pm2 not installed"
fi
echo

echo "=== 5) Running Node processes (cwd hints) ==="
ps auxww | grep -E "[n]ode|[p]m2" | head -n 80
echo

echo "=== 6) Search for API endpoints patterns (exclude node_modules) ==="
ROOTS=(/var/www /opt /root /home)
for R in "${ROOTS[@]}"; do
  [ -d "$R" ] || continue
  echo "--- in $R ---"
  grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
    "app\.(get|post|put|delete)|router\.(get|post|put|delete)|@Controller|@Post\(|/api/" \
    "$R" 2>/dev/null | head -n 120 || true
done
echo

echo "=== 7) Search for key material / risky strings (exclude node_modules) ==="
for R in "${ROOTS[@]}"; do
  [ -d "$R" ] || continue
  echo "--- in $R ---"
  grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
    "secretKey|privateKey|mnemonic|seed|Keypair\.from|process\.env|AES|GCM|scrypt|argon2" \
    "$R" 2>/dev/null | head -n 120 || true
done
echo

echo "=== 8) Look for .env files (paths only) ==="
for R in "${ROOTS[@]}"; do
  [ -d "$R" ] || continue
  find "$R" -maxdepth 5 -type f -name ".env*" 2>/dev/null | head -n 80
done
echo "DONE ✅"
BASH

chmod +x /root/traderone_audit_paths.sh
/root/traderone_audit_paths.sh
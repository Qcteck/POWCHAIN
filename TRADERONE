set -e
cd /root

echo "=== 0) Mettre les backups hors sites-enabled (sinon nginx les include) ==="
mkdir -p /root/nginx_backups
shopt -s nullglob
for b in /etc/nginx/sites-enabled/*.bak* /etc/nginx/sites-enabled/*~ /etc/nginx/sites-enabled/*.old*; do
  echo "MOVE $b -> /root/nginx_backups/"
  mv -f "$b" /root/nginx_backups/
done
shopt -u nullglob

echo
echo "=== 1) Backup propre (dans /root, PAS dans sites-enabled) ==="
cp -v /etc/nginx/sites-enabled/fireinners.online     /root/nginx_backups/fireinners.online.$(date +%Y%m%d_%H%M%S)
cp -v /etc/nginx/sites-enabled/fireinners.online-ssl /root/nginx_backups/fireinners.online-ssl.$(date +%Y%m%d_%H%M%S) 2>/dev/null || true

echo
echo "=== 2) Fix des proxy_set_header vides (fireinners.online + ssl) ==="
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  echo "PATCH $f"
  # Remplace les lignes vides par les valeurs correctes
  sed -i \
    -e 's/^[[:space:]]*proxy_set_header[[:space:]]\+Host[[:space:]]*;[[:space:]]*$/  proxy_set_header Host $host;/' \
    -e 's/^[[:space:]]*proxy_set_header[[:space:]]\+X-Real-IP[[:space:]]*;[[:space:]]*$/  proxy_set_header X-Real-IP $remote_addr;/' \
    -e 's/^[[:space:]]*proxy_set_header[[:space:]]\+X-Forwarded-For[[:space:]]*;[[:space:]]*$/  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;/' \
    "$f"
done

echo
echo "=== 3) Vérif rapide (il ne doit plus y avoir 'Host ;') ==="
grep -RIn -E 'proxy_set_header[[:space:]]+Host[[:space:]]*;' /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl 2>/dev/null || true

echo
echo "=== 4) nginx -t + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 5) Test local via nginx (doit renvoyer le JSON TraderOne, pas -32601) ==="
curl -sS -i -X POST -H "Host: fireinners.online" -H "content-type: application/json" \
  http://127.0.0.1/wolverine/traderone/api/status --data '{}' | head -n 60

echo
echo "=== 6) Test direct backend (pour comparer) ==="
curl -sS -i -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' | head -n 40
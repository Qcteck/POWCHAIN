#!/usr/bin/env bash
set -euo pipefail

JS="/var/www/aiaquila/aiaquila-rss.js"
BACKUP="$JS.backup_$(date +%Y%m%d_%H%M%S)"

echo "=== AIAQUILA RSS – FIX PARSER XML/ATOM ==="
cp "$JS" "$BACKUP"
echo "Backup: $BACKUP"

cat > "$JS" <<'JS'
/* ===== AIAQUILA RSS – XML + ATOM PARSER ROBUSTE ===== */

const FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://news.bitcoin.com/feed/",
  "https://www.newsbtc.com/feed/"
];

const PROXY = "/aiaquila/rss-proxy.php?url=";
let ARTICLES = [];

function log(m){
  const l=document.getElementById("logs");
  if(l){l.textContent+=m+"\n";l.scrollTop=l.scrollHeight;}
}

function speak(t){
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(t);
  u.lang="fr-FR";
  speechSynthesis.speak(u);
}

function parseXMLTitles(xmlText){
  const titles=[];
  const parser=new DOMParser();
  const xml=parser.parseFromString(xmlText,"text/xml");

  // RSS <item><title>
  xml.querySelectorAll("item > title").forEach(t=>{
    if(t.textContent) titles.push(t.textContent.trim());
  });

  // ATOM <entry><title>
  xml.querySelectorAll("entry > title").forEach(t=>{
    if(t.textContent) titles.push(t.textContent.trim());
  });

  return titles.filter(t=>t.length>10);
}

async function loadRSS(){
  ARTICLES=[];
  log("Chargement RSS…");

  for(const f of FEEDS){
    try{
      const r=await fetch(PROXY+encodeURIComponent(f));
      const txt=await r.text();
      log("Flux reçu: "+f+" ("+txt.length+" chars)");

      const titles=parseXMLTitles(txt);
      log("Titres extraits: "+titles.length);

      ARTICLES.push(...titles.slice(0,5));
    }catch(e){
      log("Erreur flux: "+f);
    }
  }

  log("TOTAL articles: "+ARTICLES.length);

  if(ARTICLES.length){
    speak("Actualités crypto. " + ARTICLES.join(". "));
  }else{
    speak("Aucun article détecté.");
  }
}

document.addEventListener("DOMContentLoaded",()=>{
  document.getElementById("loadRSS")?.addEventListener("click",loadRSS);
  log("AIAQUILA RSS prêt (parser XML/ATOM).");
});
JS

chmod 644 "$JS"

echo "=== PATCH PARSER OK ==="
echo "➡ Ctrl+F5 puis clique « Charger les articles »"
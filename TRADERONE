#!/bin/bash
set -e

FILE="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

echo "=== WOLVERINE • PALETTE GAME MODE ==="

node <<'NODE'
const fs=require("fs");
const f=process.env.FILE||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html";
let h=fs.readFileSync(f,"utf8");

/* ===== CLEAN ===== */
h=h.replace(/<div id="WOLV_COLOR_MENU"[\s\S]*?<\/div>/g,"");
h=h.replace(/<style id="WOLV_THEME_MIX"[\s\S]*?<\/style>/g,"");
h=h.replace(/<script id="WOLV_THEME_SCRIPT"[\s\S]*?<\/script>/g,"");

/* ===== STYLE ===== */
h=h.replace("</head>",`
<style id="WOLV_THEME_MIX">
:root{
 --bg:#05000a;
 --c1:#ff5fa2;
 --c2:#4dfff3;
 --c3:#8a5cff;
 --c4:#9fb3ff;
 --txt:#ffffff;
}

body{
 background:
 radial-gradient(circle at 20% 20%,var(--c1),transparent 60%),
 radial-gradient(circle at 80% 80%,var(--c2),transparent 60%),
 linear-gradient(135deg,var(--bg),#000);
 color:var(--txt);
 transition:all .45s ease;
}

/* CONTOURS */
.card,button,input,select{
 border:1px solid var(--c3)!important;
 box-shadow:0 0 14px color-mix(in srgb,var(--c3) 45%,transparent);
}

/* BOUTONS */
button{
 background:linear-gradient(135deg,var(--c3),var(--c1));
 color:var(--txt);
}

/* TEXTE */
h1,h2,h3,.title{
 text-shadow:
 0 0 6px var(--c1),
 0 0 12px var(--c2);
}
</style>
</head>`);

/* ===== BUTTON ===== */
h=h.replace("<body",`
<body>
<button id="WOLV_THEME_BTN"
style="position:fixed;top:18px;right:18px;z-index:999;
padding:10px 16px;border-radius:16px;font-weight:bold">
🎨 THEME
</button>
`);

/* ===== SCRIPT ===== */
h=h.replace("</body>",`
<script id="WOLV_THEME_SCRIPT">
const palettes=[
 // Rose Noir Turquoise Bleu poudre Blanc
 {bg:"#05000a",c1:"#ff5fa2",c2:"#4dfff3",c3:"#8a5cff",c4:"#9fb3ff",txt:"#ffffff"},
 // Bleu Rose Vert Noir Blanc
 {bg:"#030914",c1:"#3fa9ff",c2:"#ff5fa2",c3:"#6bff8f",c4:"#ffffff",txt:"#ffffff"},
 // Violet Turquoise Rose Noir Blanc
 {bg:"#0a0014",c1:"#8a5cff",c2:"#4dfff3",c3:"#ff5fa2",c4:"#ffffff",txt:"#ffffff"},
 // Turquoise Bleu Blanc Gris Noir
 {bg:"#001010",c1:"#4dfff3",c2:"#3fa9ff",c3:"#ffffff",c4:"#bcd",txt:"#ffffff"},
 // Neon Night
 {bg:"#000000",c1:"#ff5fa2",c2:"#00ffd5",c3:"#8a5cff",c4:"#ffffff",txt:"#ffffff"}
];

let i=parseInt(localStorage.getItem("wolv_palette")||"0");

function apply(p){
 for(const k in p){
  document.documentElement.style.setProperty("--"+k,p[k]);
 }
 localStorage.setItem("wolv_palette",i);
}

document.getElementById("WOLV_THEME_BTN").onclick=()=>{
 i=(i+1)%palettes.length;
 apply(palettes[i]);
};

apply(palettes[i]);
</script>
</body>`);

fs.writeFileSync(f,h);
NODE

nginx -t && systemctl reload nginx
echo "✅ Palette game mode actif"
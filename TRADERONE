"><div id="card"><div id="k">Adresse</div><div id="v" id="addr">-</div><div id="k">RPC (SOL+USDC)</div><div id="v" id="rpc">-</div></div><div id="card" id="val"><b>SOL</b><div class="n" id="sol">-</div><div style="height:12px"></div><b>USDC</b><div class="n" id="usdc">-</div></div></div><div id="log"></div></div><script src="https://unpkg.com/@solana/web3.js@1.98.0/lib/index.iife.min.js"></script><script>(()=>{const \$=s=>document.querySelector(s);const log=m=>{const el=\$("#log");el.textContent+=(m+(m.endsWith("\\n")?"":"\\n"));el.scrollTop=1e9};const fmt=(n,d=6)=>{try{return (Number(n)||0).toLocaleString(undefined,{maximumFractionDigits:d})}catch(_){return String(n)}};const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";let pub=null,conn=null;const RPC=location.origin.replace(/\\/\$/,"")+"/solrpc";\$("#rpc").textContent=RPC+" (build $TS)";async function refresh(){if(!pub) return;\$("#sol").textContent="-";\$("#usdc").textContent="-";try{conn=new solanaWeb3.Connection(RPC,{commitment:"confirmed"});const lam=await conn.getBalance(pub,"confirmed");\$("#sol").textContent=fmt(lam/1e9,6);const resp=await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC_MINT)},"confirmed");let sum=0;for(const it of (resp.value||[])){const ui=it?.account?.data?.parsed?.info?.tokenAmount?.uiAmount;sum+=Number(ui||0)}\$("#usdc").textContent=fmt(sum,2);log("REFRESH OK")}catch(e){\$("#usdc").textContent="ERR";log("REFRESH ERR: "+(e?.message||e))}}async function connect(){try{const ph=window.solana;if(!ph||!ph.isPhantom){log("Phantom introuvable.");return}const r=await ph.connect();pub=r.publicKey;\$("#addr").textContent=pub.toBase58();\$("#btnDisc").disabled=false;\$("#btnRefresh").disabled=false;log("CONNECTED");await refresh()}catch(e){log("CONNECT ERR: "+(e?.message||e))}}async function disconnect(){try{const ph=window.solana;try{await ph.disconnect()}catch(_){}pub=null;conn=null;\$("#addr").textContent="-";\$("#sol").textContent="-";\$("#usdc").textContent="-";\$("#btnDisc").disabled=true;\$("#btnRefresh").disabled=true;log("DISCONNECTED")}catch(e){log("DISC ERR: "+(e?.message||e))}}document.getElementById("btnConnect").onclick=connect;document.getElementById("btnDisc").onclick=disconnect;document.getElementById("btnRefresh").onclick=refresh;log("READY (build $TS)")} )();</script></body></html>

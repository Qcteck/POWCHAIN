cat >/root/fix_listen_443.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
[[ -f "$VHOST" ]] || { echo "[ERR] Missing $VHOST"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$VHOST" "${VHOST}.bak_${ts}"
echo "[OK] Backup -> ${VHOST}.bak_${ts}"

# Ajoute listen 443 si absent (dans le server SSL)
if ! grep -qE 'listen\s+443' "$VHOST"; then
  perl -0777 -i -pe '
    s/(server\s*\{\s*)/$1  listen 443 ssl http2;\n  listen [::]:443 ssl http2;\n/s
  ' "$VHOST"
  echo "[OK] Added listen 443"
else
  echo "[OK] listen 443 already present"
fi

# Ouvre firewall si UFW actif
if command -v ufw >/dev/null 2>&1; then
  if ufw status | grep -qi active; then
    ufw allow 443/tcp || true
    ufw allow 80/tcp || true
    echo "[OK] UFW opened 80/443"
  fi
fi

nginx -t
systemctl restart nginx

echo
echo "=== Ports ==="
ss -lntp | grep -E ':(80|443)\b' || true

echo
echo "=== Local HTTPS test ==="
curl -kI --max-time 5 https://127.0.0.1/ | head -n 12 || true
BASH

chmod +x /root/fix_listen_443.sh
/root/fix_listen_443.sh
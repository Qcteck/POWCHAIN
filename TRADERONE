cat >/root/fix_try_files_invalid_phantom_patch_block.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SSL="/etc/nginx/sites-available/fireinners.online-ssl"
ts="$(date +%Y%m%d_%H%M%S)"

[[ -f "$SSL" ]] || { echo "[ERR] missing $SSL"; exit 1; }
cp -a "$SSL" "${SSL}.bak_${ts}"

echo "== 1) Remove any previously injected phantom_patch.js location blocks (even broken ones) =="
perl -0777 -i -pe 's@\n\s*location\s*=\s*/wolverine/phantom_patch\.js\s*\{.*?\}\s*\n@\n@sg' "$SSL"

echo "== 2) Re-add a CLEAN no-cache block (with escaped \$uri) before server close =="
perl -0777 -i -pe 's@\n\}\s*$@\n  # Serve wallet patch with no-cache (avoid stale JS)\n  location = /wolverine/phantom_patch.js {\n    add_header Cache-Control "no-store" always;\n    try_files \\$uri =404;\n  }\n}\n@sg' "$SSL"

echo "== 3) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "Show the block:"
grep -n "location = /wolverine/phantom_patch.js" -A5 -B2 "$SSL" || true
BASH

chmod +x /root/fix_try_files_invalid_phantom_patch_block.sh
/root/fix_try_files_invalid_phantom_patch_block.sh
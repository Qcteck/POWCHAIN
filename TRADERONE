bash <<'EOF'
set -e

echo "=== VERIFY WOLVERINE HTTPS ==="

URL="https://www.fireinners.online/wolverine"

# 1) Vérifier nginx actif
systemctl is-active nginx >/dev/null || {
  echo "[ERR] nginx n'est pas actif"
  exit 1
}

# 2) Vérifier que /wolverine répond en HTTPS
if curl -fsSL "$URL" >/dev/null; then
  echo "[OK] Wolverine accessible en HTTPS"
else
  echo "[ERR] Wolverine ne répond pas en HTTPS"
  exit 1
fi

# 3) Vérifier que le HTML est bien servi
CONTENT=$(curl -fsSL "$URL" | head -n 5)
echo "[INFO] Contenu servi :"
echo "$CONTENT"

echo "=== WOLVERINE ONLINE ==="
echo "URL : $URL"
EOF
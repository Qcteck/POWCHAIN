set -e
cd /root

BASE="https://fireinners.online/wolverine/traderone/api"

echo "=== 1) Vérifie qui écoute sur 3002 (doit être wolverine-api) ==="
ss -lptn 'sport = :3002' || true
echo

echo "=== 2) Test direct gateway (3002 -> traderone via /wolverine/api) ==="
curl -sS -i -X POST "http://127.0.0.1:3002/wolverine/api/status" \
  -H "content-type: application/json" --data '{}' | head -n 40
echo

echo "=== 3) Test public SANS clé (403 attendu) ==="
curl -sS -i -X POST "$BASE/status" \
  -H "content-type: application/json" --data '{}' | head -n 25
echo

echo "=== 4) Test public AVEC clé (200 attendu) ==="
echo "Entre ta clé quand demandé (elle ne sera pas affichée) :"
read -s KEY
echo
curl -sS -i -X POST "$BASE/status" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KEY" --data '{}' | head -n 60
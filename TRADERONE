bash <<'EOF'
set -euo pipefail

### CONFIG
AIQ_DIR="/var/www/fireinners.online/aiaquila"
WORKER_URL="https://aiaquila-proxy.workers.dev"   # ⚠️ METS ICI TON URL WORKER EXACTE
HTML="$AIQ_DIR/index.html"
BACKUP="$AIQ_DIR/index.backup_$(date +%Y%m%d_%H%M%S).html"

echo "=== AIAQUILA RSS AUTO-FIX (WORKER ONLY) ==="

### 1. CHECK DIR
if [ ! -d "$AIQ_DIR" ]; then
  echo "❌ Dossier introuvable: $AIQ_DIR"
  exit 1
fi

### 2. BACKUP
cp "$HTML" "$BACKUP"
echo "✔ Backup créé: $BACKUP"

### 3. WRITE CLEAN HTML + REAL JS
cat > "$HTML" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;font-family:system-ui;background:#0b1b3a;color:#fff}
#wrap{padding:20px}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
</style>
</head>
<body>
<div id="wrap">
  <h2>🦅 AIAQUILA — RSS réel</h2>
  <button id="go">Lire les articles</button>
  <pre id="out">En attente…</pre>
</div>

<script>
const FEEDS=[
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://news.bitcoin.com/feed/"
];

const WORKER="__WORKER__?url=";
const out=document.getElementById("out");

document.getElementById("go").onclick=async()=>{
  out.textContent="Démarrage RSS...\n\n";
  let total=0;

  for(const f of FEEDS){
    try{
      const r=await fetch(WORKER+encodeURIComponent(f));
      const j=await r.json();
      out.textContent+=`Flux ${f} → ${j.length} articles\n`;
      total+=j.length;
      j.slice(0,3).forEach(a=>{
        out.textContent+=` • ${a.title}\n`;
      });
      out.textContent+="\n";
    }catch(e){
      out.textContent+=`Flux ${f} → ERREUR ${e.message}\n\n`;
    }
  }
  out.textContent+=`TOTAL: ${total} articles\n`;
};
</script>
</body>
</html>
HTML

### 4. INJECT WORKER URL
sed -i "s|__WORKER__|$WORKER_URL|g" "$HTML"

### 5. PERMISSIONS
chown -R www-data:www-data "$AIQ_DIR"
chmod -R 755 "$AIQ_DIR"

### 6. NGINX SAFE RELOAD
nginx -t && systemctl reload nginx

### 7. TEST WORKER DIRECT
echo
echo "=== TEST WORKER DIRECT ==="
curl -s "$WORKER_URL?url=https://news.bitcoin.com/feed/" | head -n 20

echo
echo "=== AIAQUILA RSS FIX APPLIED SUCCESSFULLY ==="
echo "✔ Frontend branché UNIQUEMENT sur Worker Cloudflare"
echo "✔ Plus de PHP"
echo "✔ Plus de CORS"
echo "✔ Plus de faux JSON"
echo
echo "➡ Ouvre https://fireinners.online/aiaquila/"
echo "➡ CTRL+SHIFT+R"
EOF
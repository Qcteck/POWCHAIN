bash <<'EOF'
set -e

INDEX="/var/www/fireinners.online/aiaquila/index.html"
BACKUP="$INDEX.bak.$(date +%Y%m%d_%H%M%S)"

cp -a "$INDEX" "$BACKUP"

cat > "$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel (XML)</title>
<style>
body{margin:0;padding:20px;background:#0b1b3a;color:#fff;font-family:system-ui}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px;color:#cfe}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (XML direct)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>

<script>
async function load(){
 const o=document.getElementById("out");
 o.textContent="Chargement…";
 try{
  const r=await fetch("/aiaquila/api/rss?url="+encodeURIComponent("https://news.bitcoin.com/feed/"),{cache:"no-store"});
  if(!r.ok) throw r.status;
  const txt=await r.text();
  const xml=new DOMParser().parseFromString(txt,"text/xml");
  const items=[...xml.querySelectorAll("item")].slice(0,20);
  o.textContent=items.map(i=>{
    const t=i.querySelector("title")?.textContent||"";
    const l=i.querySelector("link")?.textContent||"";
    return "• "+t+"\n"+l;
  }).join("\n\n");
 }catch(e){
  o.textContent="ERREUR: "+e;
 }
}
</script>
</body>
</html>
HTML

chown www-data:www-data "$INDEX"
chmod 644 "$INDEX"

systemctl reload nginx

echo "=== ✅ AIAQUILA OK (XML MODE) ==="
echo "Backup: $BACKUP"
echo "URL: https://fireinners.online/aiaquila/"
EOF
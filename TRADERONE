#!/usr/bin/env bash
set -euo pipefail

PROXY="/var/www/aiaquila/rss-proxy.php"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX RSS PROXY (AIAQUILA) ==="

# Backup
cp "$PROXY" "$PROXY.backup_$TS"
echo "Backup: $PROXY.backup_$TS"

# Rewrite proxy
cat <<'PHP' > "$PROXY"
<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/xml; charset=UTF-8");

if (!isset($_GET['url'])) {
  http_response_code(400);
  echo "Missing url";
  exit;
}

$url = $_GET['url'];

$ch = curl_init();
curl_setopt_array($ch, [
  CURLOPT_URL => $url,
  CURLOPT_RETURNTRANSFER => true,
  CURLOPT_FOLLOWLOCATION => true,
  CURLOPT_TIMEOUT => 15,
  CURLOPT_USERAGENT => "Mozilla/5.0 (AIAQUILA RSS)",
  CURLOPT_HTTPHEADER => [
    "Accept: application/rss+xml, application/xml;q=0.9, */*;q=0.8"
  ]
]);

$data = curl_exec($ch);
$err  = curl_error($ch);
curl_close($ch);

if (!$data) {
  http_response_code(502);
  echo "RSS fetch failed: $err";
  exit;
}

echo $data;
PHP

# Permissions
chown www-data:www-data "$PROXY"
chmod 644 "$PROXY"

echo "=== PROXY RSS CORRIGÉ ==="
echo "Recharge la page (Ctrl+F5) puis clique 'Charger les articles'"
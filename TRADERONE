cat >/root/FIREINNERS_SOLRPC_NGINX_FIX_ONLY.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "[PLAN] Ce script va:"
echo "  1) Backup /etc/nginx/sites-available/fireinners.online-ssl"
echo "  2) Enlever tous les blocs/locations liés à /solrpc (anciens patches inclus)"
echo "  3) Réinsérer un bloc propre au niveau server{}:"
echo "       - /solrpc  -> 308 /solrpc/  (garde POST)"
echo "       - /solrpc/ -> proxy vers 127.0.0.1:12703"
echo "  4) nginx -t && reload, puis chattr +i"
echo

[ "$(id -u)" -eq 0 ] || { echo "ERR: run as root"; exit 1; }

NG_AV="/etc/nginx/sites-available/fireinners.online-ssl"
NG_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"

[ -f "$NG_AV" ] || { echo "ERR: missing $NG_AV"; exit 2; }

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/backup_fireinners_nginx_${TS}"
mkdir -p "$BK"
cp -a "$NG_AV" "$BK/$(basename "$NG_AV").bak"

if command -v chattr >/dev/null 2>&1; then
  chattr -i /etc/nginx/nginx.conf "$NG_AV" 2>/dev/null || true
fi

python3 - <<'PY'
import re, pathlib

p = pathlib.Path("/etc/nginx/sites-available/fireinners.online-ssl")
s = p.read_text(encoding="utf-8", errors="ignore")

# 1) remove old FI_SOLRPC block(s) if any
s = re.sub(r"\s*#\s*FI_SOLRPC_NGINX_V1 BEGIN.*?#\s*FI_SOLRPC_NGINX_V1 END\s*", "\n", s, flags=re.S)

# 2) find the server{} that contains fireinners.online in server_name
m = re.search(r"server\s*\{.*?server_name[^;]*fireinners\.online[^;]*;.*?\}", s, flags=re.S)
if not m:
    raise SystemExit("ERR: cannot find server{} with server_name fireinners.online")

block = m.group(0)

# 3) remove any existing /solrpc locations in that server block (to avoid duplicates/nesting)
#    This removes:
#      location = /solrpc ...
#      location = /solrpc/ ...
#      location /solrpc ...
#      location /solrpc/ ...
block = re.sub(r"\n\s*location\s*=?\s*/solrpc/?\s*\{.*?\}\s*\n", "\n", block, flags=re.S)
block = re.sub(r"\n\s*location\s*\^~\s*/solrpc/?\s*\{.*?\}\s*\n", "\n", block, flags=re.S)

# 4) insert clean block right after server_name line (top-level inside server{})
ins = r"""
    # FI_SOLRPC_NGINX_V2 BEGIN
    location = /solrpc { return 308 /solrpc/; }

    location /solrpc/ {
        proxy_pass http://127.0.0.1:12703/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
    # FI_SOLRPC_NGINX_V2 END
""".strip("\n")

# put immediately after the first server_name ...;
block2 = re.sub(r"(server_name[^;]*;\s*)", r"\1\n\n"+ins+"\n\n", block, count=1, flags=re.S)
if block2 == block:
    # fallback: insert near top after opening brace
    block2 = re.sub(r"(server\s*\{\s*)", r"\1\n"+ins+"\n", block, count=1, flags=re.S)

s2 = s[:m.start()] + block2 + s[m.end():]
p.write_text(s2, encoding="utf-8")
print("OK: patched nginx site")
PY

nginx -t
systemctl reload nginx

if command -v chattr >/dev/null 2>&1; then
  chattr +i /etc/nginx/nginx.conf "$NG_AV" 2>/dev/null || true
fi

echo
echo "[DONE] Backup: $BK"
echo
echo "[TEST] Doit répondre pong:"
echo "  curl -fsS https://fireinners.online/solrpc/ping && echo"
echo
echo "[TEST] POST JSON-RPC (slash final obligatoire):"
echo "  curl -sS -H 'content-type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\"}' https://fireinners.online/solrpc/"
SH
chmod +x /root/FIREINNERS_SOLRPC_NGINX_FIX_ONLY.sh
bash /root/FIREINNERS_SOLRPC_NGINX_FIX_ONLY.sh
log "4) Disable conflicting /wolverine locations in /etc/nginx (backup each file)"
export RB_DIR TS
python3 - <<'PY'
import os,re,shutil,hashlib
ROOT="/etc/nginx"
INC="/etc/nginx/includes/wolverine_routes.inc"
RB=os.environ["RB_DIR"]; TS=os.environ["TS"]
def sha(p):
    h=hashlib.sha256()
    with open(p,'rb') as f:
        for b in iter(lambda:f.read(1024*1024), b''):
            h.update(b)
    return h.hexdigest()[:16]
def disable(path):
    s=open(path,'r',errors='ignore').read().splitlines()
    out=[]; changed=False; i=0
    while i<len(s):
        line=s[i]
        if path==INC: out.append(line); i+=1; continue
        if re.search(r'^\s*location\s+.*?/wolverine', line):
            changed=True
            out.append("# DISABLED_BY_MEGA_WOLVERINE "+line)
            brace=line.count('{')-line.count('}')
            i+=1
            while i<len(s):
                l=s[i]
                out.append("# DISABLED_BY_MEGA_WOLVERINE "+l)
                brace += l.count('{')-l.count('}')
                i+=1
                if brace<=0: break
            continue
        out.append(line); i+=1
    if changed:
        bdir=os.path.join(RB,"nginx_conf_backups"); os.makedirs(bdir,exist_ok=True)
        try: shutil.copy2(path, os.path.join(bdir, os.path.basename(path)+f".bak_{TS}_{sha(path)}"))
        except: pass
        open(path,'w').write("\n".join(out)+("\n" if out else ""))
    return changed
changed_any=False
for dp,_,fns in os.walk(ROOT):
    for fn in fns:
        if not fn.endswith((".conf",".inc")): continue
        p=os.path.join(dp,fn)
        try: txt=open(p,'r',errors='ignore').read()
        except: continue
        if "/wolverine" not in txt: continue
        if disable(p): changed_any=True
print("conflicts_disabled=", "yes" if changed_any else "no")
PY

log "5) Sync repo (best-effort)"
if [ -d "$REPO/.git" ]; then

cat >/root/FIX_WOLVERINE_RPC_DRPC.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"

echo "=== FIX RPC WOLVERINE → DRPC ==="

if [ ! -f "$HTML" ]; then
  echo "ERREUR: $HTML introuvable"
  exit 1
fi

cp "$HTML" "$HTML.bak_rpc_$TS"
echo "Backup créé: $HTML.bak_rpc_$TS"

# Remplacer toute création de Connection par DRPC
sed -i \
  -e "s|clusterApiUrl(\"mainnet-beta\")|\"$RPC\"|g" \
  -e "s|clusterApiUrl('mainnet-beta')|\"$RPC\"|g" \
  "$HTML"

echo "=== RPC MIS À JOUR ==="
echo "RPC utilisé:"
echo "$RPC"
echo
echo "Recharge la page (CTRL+F5)"
echo "Le SOL DOIT maintenant s’afficher"
BASH

chmod +x /root/FIX_WOLVERINE_RPC_DRPC.sh
/root/FIX_WOLVERINE_RPC_DRPC.sh
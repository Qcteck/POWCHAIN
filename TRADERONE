import fs from "fs";
import path from "path";
import fetch from "node-fetch";
import TelegramBot from "node-telegram-bot-api";

// === CONFIGURATION ===
const TELEGRAM_TOKEN = "TON_TOKEN_TELEGRAM";
const CHAT_ID = "TON_CHAT_ID"; // destinataire du bot
const RSS_SOURCES = [
  "https://cryptoast.fr/feed",
  "https://cryptonaute.fr/feed",
  "https://fr.cointelegraph.com/rss-feeds/actualites.xml",
  "https://bitcoin.fr/feed",
  "https://coinacademy.fr/actu?feed=gn",
  "https://journalducoin.com/feed/",
  "https://www.cryptopolitan.com/feed/",
  "https://fr.cryptoslate.com/feed/",
  "https://cryptonaute.fr/crypto-news/feed/",
  "https://www.finyear.com/rss/cryptomonnaie"
];
const MEMORY_FILE = path.resolve("./memory.json");
const PARTNERS = [
  { name: "Pod Of Wheeles", token: "AhSGcUDNK2MKkWQe4Mz7rCPSyTJNxvtGCTuJnpUjpump" },
  { name: "Firesinners", token: "(coming soon)" },
  { name: "Sailana Inu", token: "dWd8vyAH9pQMMG1bkQWiGnyx8LjjuTDHsk8qcsCBAGS" }
];
const ARTICLE_INTERVAL = 15 * 60 * 1000; // 15 min
const PARTNERSHIP_INTERVAL = 20 * 60 * 1000; // 20 min
const ANOMALY_THRESHOLD = 0.05; // 5%

// === INITIALISATION ===
const bot = new TelegramBot(TELEGRAM_TOKEN);
let memory = { articles: [], anomalies: [] };
if (fs.existsSync(MEMORY_FILE)) memory = JSON.parse(fs.readFileSync(MEMORY_FILE, "utf8"));
let lastPartnershipTime = 0;

// === UTILITAIRES ===
function saveMemory() {
  fs.writeFileSync(MEMORY_FILE, JSON.stringify(memory, null, 2));
}

function randomChoice(arr) {
  return arr[Math.floor(Math.random() * arr.length)];
}

// === RSS ===
async function fetchRSS(url) {
  try {
    const res = await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(url)}`);
    if (!res.ok) return [];
    const data = await res.json();
    return data.items || [];
  } catch {
    return [];
  }
}

async function loadRSSAll() {
  const allArticles = [];
  for (const url of RSS_SOURCES) {
    const items = await fetchRSS(url);
    allArticles.push(...items);
  }
  return allArticles;
}

// === ARTICLE GENERATION ===
function generateArticle(author, text) {
  const article = { author, text, timestamp: Date.now() };
  memory.articles.push(article);
  saveMemory();
  return article;
}

// === TELEGRAM ===
async function sendTelegramArticle(article) {
  const msg = `*${article.author}* publie un article :\n\n${article.text}`;
  await bot.sendMessage(CHAT_ID, msg, { parse_mode: "Markdown" });
}

// === ANOMALIES ===
function detectAnomalies(article) {
  // Détection simplifiée : recherche de mots clés "anomalie", "irrégulier", "surprenant"
  const keywords = ["anomalie", "irrégulier", "surprenant", "choc", "bizarre"];
  const found = keywords.some(k => article.text.toLowerCase().includes(k));
  if (found && Math.random() < ANOMALY_THRESHOLD) {
    const anomaly = { article, detectedAt: Date.now(), note: `Anomalie détectée par mémoire` };
    memory.anomalies.push(anomaly);
    saveMemory();
    return anomaly;
  }
  return null;
}

// === PARTENARIATS ===
function maybeAnnouncePartnership() {
  const now = Date.now();
  if (now - lastPartnershipTime > PARTNERSHIP_INTERVAL) {
    lastPartnershipTime = now;
    console.log("Annonce partenariat :", PARTNERS.map(p => p.name).join(", "));
  }
}

// === SIMULATION CONTINUE ===
async function runLoop() {
  while (true) {
    try {
      maybeAnnouncePartnership();
      const allArticles = await loadRSSAll();
      const articleData = randomChoice(allArticles);
      const author = randomChoice(["Animatrice", "Journaliste d'enquête"]);
      const articleText = `${articleData.title} - ${articleData.description}`.substring(0, 500);
      
      // Génération article si assez de matière
      if (Math.random() < 0.2) {
        const article = generateArticle(author, articleText);
        console.log(`[${author}] Génération article :`, article.text);
        await sendTelegramArticle(article);
      }

      // Détection anomalies
      const anomaly = detectAnomalies({ author, text: articleText });
      if (anomaly) {
        console.log("⚠️ Anomalie :", anomaly.note);
        await bot.sendMessage(CHAT_ID, `⚠️ Anomalie détectée : ${anomaly.note}`);
      }

    } catch (err) {
      console.error("Erreur boucle :", err);
    }
    await new Promise(r => setTimeout(r, ARTICLE_INTERVAL));
  }
}

// === LANCEMENT ===
console.log("🚀 NeuroneOne serveur démarré...");
runLoop();

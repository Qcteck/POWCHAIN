"use strict";
const http=require("http");
const {URL}=require("url");

const UPSTREAMS=[
  "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",
  "https://api.mainnet-beta.solana.com",
  "https://solana-rpc.publicnode.com",
  "https://rpc.ankr.com/solana"
];

function readBody(req,limit=2*1024*1024){
  return new Promise((resolve,reject)=>{
    let n=0,buf=[];
    req.on("data",c=>{ n+=c.length; if(n>limit){reject(new Error("Body too large")); req.destroy(); return;} buf.push(c); });
    req.on("end",()=>resolve(Buffer.concat(buf).toString("utf8")));
    req.on("error",reject);
  });
}

async function postJSON(url,body,timeoutMs=9000){
  const ac=new AbortController();
  const t=setTimeout(()=>ac.abort(),timeoutMs);
  try{
    const r=await fetch(url,{method:"POST",headers:{"content-type":"application/json"},body,signal:ac.signal});
    const txt=await r.text();
    if(!r.ok) throw new Error("HTTP "+r.status+" "+txt.slice(0,180));
    return {ok:true,txt};
  } finally { clearTimeout(t); }
}

async function handleRPC(body){
  let lastErr=null;
  for(const u of UPSTREAMS){
    try{
      const r=await postJSON(u,body,9000);
      return {upstream:u,txt:r.txt};
    }catch(e){ lastErr=e; }
  }
  throw lastErr||new Error("Upstreams exhausted");
}

const srv=http.createServer(async (req,res)=>{
  try{
    if(req.method==="OPTIONS"){
      res.writeHead(204,{
        "Access-Control-Allow-Origin":"*",
        "Access-Control-Allow-Methods":"POST, OPTIONS",
        "Access-Control-Allow-Headers":"content-type",
        "Access-Control-Max-Age":"86400"
      });
      return res.end();
    }
    if(req.method!=="POST"){ res.writeHead(405,{"content-type":"text/plain"}); return res.end("Method Not Allowed"); }

    const body=await readBody(req);
    // very light validation
    if(!body || body.length<2){ res.writeHead(400,{"content-type":"text/plain"}); return res.end("Bad body"); }

    const out=await handleRPC(body);
    res.writeHead(200,{
      "content-type":"application/json; charset=utf-8",
      "cache-control":"no-store",
      "access-control-allow-origin":"*",
      "x-solrpc-upstream":out.upstream
    });
    return res.end(out.txt);
  }catch(e){
    res.writeHead(502,{"content-type":"application/json; charset=utf-8","cache-control":"no-store","access-control-allow-origin":"*"});
    return res.end(JSON.stringify({jsonrpc:"2.0",id:1,error:{message:String(e&&e.message||e)}}));
  }
});

const port=process.env.PORT||"12703";
srv.listen(Number(port),"127.0.0.1",()=>console.log("solrpc proxy on 127.0.0.1:"+port));
JS

echo "[3] Systemd service (Restart=always)"
cat >"$SVC" <<EOF
[Unit]
Description=FireInners Solana JSON-RPC proxy (CORS-safe, failover)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$APPDIR
Environment=PORT=$PORT
ExecStart=/usr/bin/node $APPDIR/server.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$APPDIR
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now fireinners-solrpc-proxy.service
systemctl restart fireinners-solrpc-proxy.service

echo "[4] Nginx snippet + inject include into vhost (safe)"

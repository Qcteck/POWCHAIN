#!/bin/bash
set -e

FRONT="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
cp $FRONT $FRONT.bak.daynight.$(date +%s)

# 1) CSS global (couleurs adaptatives + bouton)
sed -i '/<\/head>/i\
<style>\
:root{--bg:#0b0d16;--fg:#ffffff;}\
body{background:var(--bg)!important;color:var(--fg)!important;transition:background .4s,color .4s;}\
*{color:inherit;}\
#daynight{position:fixed;top:18px;right:22px;z-index:1001;\
font-size:22px;cursor:pointer;\
background:rgba(255,255,255,.18);\
border:1px solid rgba(255,255,255,.35);\
border-radius:50%;width:46px;height:46px;\
display:flex;align-items:center;justify-content:center;\
backdrop-filter:blur(12px);\
box-shadow:0 0 18px rgba(255,255,255,.35);}\
.light{--bg:#f4f6ff;--fg:#0b0d16;}\
.dark{--bg:#0b0d16;--fg:#ffffff;}\
</style>' $FRONT

# 2) Bouton + logique JS
sed -i '/<\/body>/i\
<div id="daynight">🌙</div>\
<script>\
const btn=document.getElementById("daynight");\
let mode=localStorage.getItem("mode")||"dark";\
document.body.classList.add(mode);\
btn.textContent=mode==="dark"?"🌙":"☀️";\
\
btn.onclick=()=>{\
mode=mode==="dark"?"light":"dark";\
document.body.classList.remove("dark","light");\
document.body.classList.add(mode);\
btn.textContent=mode==="dark"?"🌙":"☀️";\
localStorage.setItem("mode",mode);\
};\
</script>' $FRONT

nginx -t && systemctl reload nginx
echo "✅ MODE JOUR / NUIT + TEXTE AUTO-ADAPTATIF ACTIF"
export default {
  async fetch(req, env) {
    const url = new URL(req.url);

    // simple auth
    const token = req.headers.get("x-relay-token");
    if (!token || token !== env.RELAY_TOKEN) {
      return new Response("unauthorized", { status: 401 });
    }

    if (url.pathname === "/quote" && req.method === "GET") {
      const u = new URL("https://quote-api.jup.ag/v6/quote");
      for (const [k,v] of url.searchParams.entries()) u.searchParams.set(k, v);
      const r = await fetch(u.toString());
      return new Response(await r.text(), { status: r.status, headers: { "content-type":"application/json" }});
    }

    if (url.pathname === "/swap" && req.method === "POST") {
      const body = await req.text();
      const r = await fetch("https://quote-api.jup.ag/v6/swap", {
        method: "POST",
        headers: { "content-type":"application/json" },
        body
      });
      return new Response(await r.text(), { status: r.status, headers: { "content-type":"application/json" }});
    }

    return new Response("not found", { status: 404 });
  }
}
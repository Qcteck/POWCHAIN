say "== 7) Nginx routes include (/aquilaai + /aquilaai/api) =="
cat > "$NGINX_INC" <<EOF
# AquilaAi (frontend + backend proxy)
location = /aquilaai { return 301 /aquilaai/; }
location ^~ /aquilaai/ {
  root $FRONT_DIR;
  try_files \$uri \$uri/ /index.html;
  add_header Cache-Control "no-store" always;
}
location ^~ /aquilaai/api/ {
  proxy_pass http://$HOST:$PORT/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  add_header Cache-Control "no-store" always;
}
EOF

say "== 8) Ensure nginx vhost includes aquilaai include (idempotent) =="
grep -qF "$NGINX_INC" "$NGINX_VHOST" || {
  # insert include inside server { } if possible; fallback append at end
  if grep -q "server\s*{" "$NGINX_VHOST"; then
    # add include near top of server block (after first server { line)
    awk -v inc="    include $NGINX_INC;" '
      BEGIN{added=0}
      {print}
      !added && $0 ~ /server\s*\{/ {print inc; added=1}
    ' "$NGINX_VHOST" > "$NGINX_VHOST.tmp" && mv "$NGINX_VHOST.tmp" "$NGINX_VHOST"
  else
    echo "include $NGINX_INC;" >> "$NGINX_VHOST"
  fi
}

say "== 9) systemd reload + restart service =="
systemctl daemon-reload
systemctl enable aquilaai >/dev/null 2>&1 || true
systemctl restart aquilaai
systemctl --no-pager --full status aquilaai | sed -n '1,20p'

say "== 10) nginx test + reload =="
nginx -t
systemctl reload nginx

say "== 11) Smoke tests (local) =="
curl -s "http://$HOST:$PORT/health" | head -c 400; echo
curl -s "http://$HOST:$PORT/metrics" | head -c 400; echo
curl -s "http://$HOST:$PORT/rss/latest" | head -c 400; echo

say "== DONE =="
say "URL: https://$SITE/aquilaai"
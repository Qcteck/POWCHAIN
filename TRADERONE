ENV="/opt/fireinners/wolverine-telegram/telegram.env"
DIR="/opt/fireinners/wolverine-telegram"
CID="5153862399"

sudo mkdir -p "$DIR" && sudo chmod 700 "$DIR"

echo "COLLE le NOUVEAU TG TOKEN puis ENTER (rien ne s'affiche):"
read -r -s TG
echo

if ! printf '%s' "$TG" | grep -Eq '^[0-9]{6,}:[A-Za-z0-9_-]{20,}$'; then
  echo "ERREUR: format token invalide. Il doit ressembler a 123456789:AbcDEF_-..."
  exit 1
fi

sudo systemctl stop wolverine-tg-sentinel 2>/dev/null || true
[ -f "$ENV" ] && sudo cp -a "$ENV" "$ENV.bak.$(date +%s)" || true

umask 077
printf 'TG_TOKEN=%s\nTG_CHAT_ID=%s\n' "$TG" "$CID" | sudo tee "$ENV" >/dev/null
sudo chmod 600 "$ENV"

echo "--- test getMe ---"
curl -sS -m 8 "https://api.telegram.org/bot${TG}/getMe" | head -c 250; echo

echo "--- restart sentinel ---"
sudo systemctl restart wolverine-tg-sentinel
sleep 0.4
sudo systemctl status wolverine-tg-sentinel --no-pager -n 8

echo "--- test send ---"
wolv_send "WOLVERINE: token OK (reset)"
echo "DONE."
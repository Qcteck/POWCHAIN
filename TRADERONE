set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_routes.conf"

echo "=== 0) Sanity ==="
[ -f "$VHOST" ] || { echo "❌ VHOST introuvable: $VHOST"; exit 1; }
ls -lah /var/www/wolverine/index.html || true

echo "=== 1) Backup vhost ==="
cp -a "$VHOST" "$VHOST.bak.$TS"

echo "=== 2) Write snippet wolverine routes ==="
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'NGX'
# --- Wolverine routing (fix rewrite loops + keep APIs working) ---

# 1) Phantom auth API (must NOT fall back to index.html)
location ^~ /wolverine/traderone/api/auth/ {
  auth_basic off;
  satisfy any;
  allow all;

  proxy_pass http://127.0.0.1:3005/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}

# 2) Next.js static assets (never rewrite to index.html)
location ^~ /wolverine/_next/ {
  root /var/www;
  try_files $uri =404;
  access_log off;
  expires 1h;
}

# 3) Old /wolverine/api/* should not be rewritten to index.html
location ^~ /wolverine/api/ {
  return 404;
}

# 4) App fallback (SPA): serve files if exist, else /wolverine/index.html
location ^~ /wolverine/ {
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
}
NGX

echo "=== 3) Ensure snippet included in SSL vhost ==="
if ! grep -q "snippets/wolverine_routes.conf" "$VHOST"; then
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/wolverine_routes.conf;/' "$VHOST"
  echo "✅ Included snippet in $VHOST"
else
  echo "✅ Snippet already included"
fi

echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 5) Tests ORIGIN (bypass Cloudflare) ==="
echo "--- auth health ---"
curl -sk --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | head -c 220; echo

echo "--- phantom challenge ---"
curl -sk --resolve fireinners.online:443:127.0.0.1 \
  "https://fireinners.online/wolverine/traderone/api/auth/phantom/challenge?pubkey=11111111111111111111111111111111" | head -c 260; echo

echo "--- next static (should be 200 or 404, NOT loop) ---"
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/_next/static/does-not-exist.js | head -n 12 || true

echo "DONE ✅"
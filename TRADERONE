set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_routes.conf"

echo "=== 0) Backup vhost ==="
cp -a "$VHOST" "$VHOST.bak.$TS"

echo "=== 1) Write snippet (NO location /wolverine/ to avoid duplicate) ==="
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'NGX'
# Phantom auth API (must NOT fall back to index.html)
location ^~ /wolverine/traderone/api/auth/ {
  auth_basic off;
  satisfy any;
  allow all;

  proxy_pass http://127.0.0.1:3005/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}

# Next.js static assets (never rewrite to index.html)
location ^~ /wolverine/_next/ {
  root /var/www;
  try_files $uri =404;
  access_log off;
  expires 1h;
}
NGX

echo "=== 2) Ensure include exists in SSL vhost (only once) ==="
if ! grep -q "snippets/wolverine_routes.conf" "$VHOST"; then
  cp -a "$VHOST" "$VHOST.bak.include.$TS"
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/wolverine_routes.conf;/' "$VHOST"
  echo "✅ Included snippet in $VHOST"
else
  echo "✅ Snippet already included"
fi

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 4) ORIGIN bypass tests (should be 200 + JSON) ==="
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | head -n 20

curl -sk --resolve fireinners.online:443:127.0.0.1 \
  "https://fireinners.online/wolverine/traderone/api/auth/phantom/challenge?pubkey=11111111111111111111111111111111" | head -c 260; echo
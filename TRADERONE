set -euo pipefail

echo "=== List all repos + origin URL ==="
for repo in \
  /opt/fireinners-qplus-wasm \
  /opt/fireinners/WOLVERINE \
  /opt/fireinners/WOLVERINE_REPO \
  /opt/traderone-opt \
  /opt/wolverine_repo_stage/repo \
  /root
do
  [ -d "$repo/.git" ] || continue
  echo
  echo "### REPO: $repo"
  git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || true
  echo "- remotes:"
  git -C "$repo" remote -v 2>/dev/null || true
  echo "- origin url:"
  git -C "$repo" ls-remote --get-url origin 2>/dev/null || echo "NO ORIGIN"
done
WorkingDirectory=$APP
Environment=NODE_ENV=production
ExecStart=/usr/bin/node $APP/bot.mjs
Restart=always
RestartSec=3
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=$APP $LOGDIR $STATEF $WALLET_FILE
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF

say "== ENABLE + START =="
systemctl daemon-reload
systemctl enable --now microcap-hunt-auto.service

say "== STATUS (80 lines) =="
systemctl --no-pager status microcap-hunt-auto.service | sed -n '1,80p' || true
say "== LAST LOG (25) =="
journalctl -u microcap-hunt-auto.service -n 25 --no-pager || true

say "== DONE =="
say "LIVE MODE: ARM=$ARM (set ARM=ON at launch to trade for real)"
say "TAIL: journalctl -u microcap-hunt-auto.service -f"
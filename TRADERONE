cat >/tmp/RELANCE_TRADERONE_AND_TEST.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
hr(){ echo; echo "=========== $* ==========="; }

hr "1) Restart TraderOne"
systemctl daemon-reload || true
systemctl restart traderone.service
sleep 1
systemctl status traderone.service --no-pager -n 25 || true

hr "2) Check port 8585"
ss -lntp | grep -E '(:8585)\b' || echo "!! 8585 NOT LISTENING"

hr "3) Local API test (must NOT be HTML wolverine)"
curl -sS --max-time 6 http://127.0.0.1:8585/api/status | head -c 200; echo

hr "4) Reload nginx + public tests"
nginx -t
systemctl reload nginx

echo "--- PUBLIC: /wolverine/traderone/ (headers)"
curl -kIs --max-time 8 https://fireinners.online/wolverine/traderone/ | head -n 10

echo "--- PUBLIC: /wolverine/traderone/api/status (body head)"
curl -ksS --max-time 8 https://fireinners.online/wolverine/traderone/api/status | head -c 220; echo

SH

bash /tmp/RELANCE_TRADERONE_AND_TEST.sh
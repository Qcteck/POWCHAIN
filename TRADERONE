npm_install(){
  cd "$APP_DIR"
  if [ ! -d node_modules ]; then
    cmd npm install --omit=dev
  else
    echo "OK: node_modules exists"
  fi
}

write_systemd(){
  cat >"/etc/systemd/system/${SVC}" <<EOF
[Unit]
Description=AgentIA (Global++) backend for /agentia
After=network.target

[Service]
Type=simple
WorkingDirectory=${APP_DIR}
Environment=PORT=${PORT}
Environment=BASE_PATH=/agentia
Environment=DATA_DIR=${DATA_DIR}
Environment=DB_PATH=${DATA_DIR}/agentia.db
ExecStart=/usr/bin/node ${APP_DIR}/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF
  cmd systemctl daemon-reload
  cmd systemctl enable --now "${SVC}"
}

write_nginx_routes(){
  mkdir -p "$(dirname "$NGX_INC")"
  tmp="$(mktemp)"
  cat >"$tmp" <<EOF
# ${APP} routes (auto) ${TS}
location = /agentia { return 301 /agentia/; }
location ^~ /agentia/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  add_header Cache-Control "no-store" always;
  proxy_pass http://${HOST}:${PORT}/;
}
EOF
  askorupdate_file "$NGX_INC" "$tmp"
  rm -f "$tmp"
}

ensure_nginx_include(){
  [ -f "$NGX_SITE" ] || { echo "ERROR: missing $NGX_SITE"; exit 1; }

  cmd chattr -i "$NGX_SITE" || true
  tmp="$(mktemp)"
  cp -a "$NGX_SITE" "$tmp"

  python3 - <<PY
from pathlib import Path
p=Path("$tmp")
s=p.read_text(errors="ignore")
inc='include $NGX_INC;'
if inc in s:
    print("OK: nginx include already present")
else:
    # insert inside server block, near other includes if possible
    if "include /etc/nginx/includes/" in s and "server {" in s:
        # place after first include in server
        lines=s.splitlines()
        out=[]
        inserted=False
        for ln in lines:
            out.append(ln)
            if (not inserted) and ("server {" in ln):
                # wait for next includes, but if none, insert after server line
                pass
        # simple strategy: insert after server { line
        lines=s.splitlines()
        out=[]
        inserted=False
        for i,ln in enumerate(lines):
            out.append(ln)
            if (not inserted) and ln.strip()=="server {":
                out.append("  "+inc)
                inserted=True
        if not inserted:
            out.append(inc)
        s="\n".join(out)
    else:
        # fallback: insert after first 'server {' occurrence
        lines=s.splitlines()
        out=[]
        inserted=False
        for ln in lines:
            out.append(ln)
            if (not inserted) and ("server {" in ln):
                out.append("  "+inc)
                inserted=True
        if not inserted:
            s += "\n" + inc + "\n"
        else:
            s="\n".join(out)
    p.write_text(s)
    print("OK: nginx include inserted")
PY

  cp -a "$tmp" "${NGX_SITE}.bak_${TS}"
  cp -a "$tmp" "$NGX_SITE"
  rm -f "$tmp"

  cmd nginx -t
  cmd systemctl reload nginx
  cmd chattr +i "$NGX_SITE" || true
}

smoke(){
  echo "== Smoke =="
  cmd systemctl --no-pager --full status "${SVC}" | sed -n '1,20p' || true
  cmd curl -fsS "http://${HOST}:${PORT}/agentia/health" | head -c 300; echo
  echo "OK: https://fireinners.online/agentia/"
}

main(){
  need_root
  echo "== MEGA DEPLOY: /agentia =="
  install_node_if_missing
  write_backend
  npm_install
  write_systemd
  write_nginx_routes
  ensure_nginx_include
  smoke
}
main

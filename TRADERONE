#!/usr/bin/env bash
set -euo pipefail

echo "=== START NGINX (SAFE) ==="

# 1) Vérifier état
systemctl is-enabled nginx || true
systemctl status nginx --no-pager || true

# 2) Démarrer nginx
systemctl start nginx

# 3) Vérifier
systemctl status nginx --no-pager

echo "=== NGINX STARTED ==="
echo "➡️ CTRL + F5 navigateur"




chmod +x START_NGINX_SAFE.sh
./START_NGINX_SAFE.sh

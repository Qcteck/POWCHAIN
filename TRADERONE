bash -lc 'cat >/tmp/wolverine_fix_vendor.sh << "SH"
#!/usr/bin/env bash
set -euo pipefail
ROOT="/opt/fireinners/frontend-react/app/dist"
HTML="$ROOT/wolverine/index.html"
VEND="$ROOT/wolverine/vendor"
SOL="$VEND/solanaWeb3.iife.min.js"
HOST="fireinners.online"

test -f "$HTML" || { echo "ERR: $HTML introuvable"; exit 1; }

ts="$(date -u +%Y%m%d-%H%M%S)"
cp -a "$HTML" "$HTML.bakfix.$ts"

mkdir -p "$VEND"
chmod 755 "$VEND"

ok=0
for u in \
  "https://cdn.jsdelivr.net/npm/@solana/web3.js@latest/lib/index.iife.min.js" \
  "https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js" \
  "https://esm.sh/@solana/web3.js@latest?bundle"
do
  if curl -fsSL "$u" -o "$SOL"; then ok=1; break; fi
done

if [ "$ok" -ne 1 ]; then
  cat >"$SOL" << "JS"
(()=>{console.error("solana web3 fallback missing (CDN blocked)");window.solanaWeb3=null;})();
JS
fi
chmod 644 "$SOL"

# Assure le onerror fallback (si pas déjà présent)
perl -0777 -pe "s#<script\\s+src=\"https://cdn\\.jsdelivr\\.net/npm/@solana/web3\\.js@latest/lib/index\\.iife\\.min\\.js\"\\s*>#<script src=\"https://cdn.jsdelivr.net/npm/@solana/web3.js@latest/lib/index.iife.min.js\" onerror=\"var s=document.createElement('script');s.src='/wolverine/vendor/solanaWeb3.iife.min.js';document.head.appendChild(s)\">#g" -i "$HTML"

bytes="$(stat -c %s "$SOL" 2>/dev/null || echo 0)"

echo "OK: vendor fallback ready: $SOL ($bytes bytes)"
echo "OK: backup html: $HTML.bakfix.$ts"

echo "TEST local nginx:"
echo -n "/wolverine/vendor/solanaWeb3.iife.min.js => "
curl -k -sS -o /dev/null -w "%{http_code}\n" "https://127.0.0.1/wolverine/vendor/solanaWeb3.iife.min.js" -H "Host: $HOST" || true
SH
chmod +x /tmp/wolverine_fix_vendor.sh
/tmp/wolverine_fix_vendor.sh'
cat >/tmp/WOLVERINE_NGINX_VERIFY_AND_FIX_LOCATION.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
DOCROOT="/var/www/fireinners/wolverine"
CONF="/etc/nginx/sites-available/fireinners.online"
TS="$(date +%s)"

echo "== 0) Show active vhosts =="
ls -lah /etc/nginx/sites-enabled || true
echo

echo "== 1) Does nginx config contain a /wolverine location? (nginx -T) =="
nginx -T 2>/dev/null | grep -nE "server_name ${DOMAIN}|location \^~ /wolverine/|location /wolverine/|alias ${DOCROOT}" | head -n 200 || true
echo

echo "== 2) Remote JS headers (must be 200 and JS content-type) =="
curl -ksSI "https://${DOMAIN}/wolverine/solana-web3.min.js?v=$TS" | sed -n '1,25p' || true
echo
echo "== 3) Remote JS first bytes (must NOT start with '<') =="
curl -ksS "https://${DOMAIN}/wolverine/solana-web3.min.js?v=$TS" | head -c 60; echo
echo

echo "== 4) If /wolverine location not in the right server{}, inject it properly =="
cp -a "$CONF" "$CONF.bak.$TS"

awk -v domain="$DOMAIN" -v docroot="$DOCROOT" '
BEGIN{
  in_server=0; has_domain=0; inserted=0;
}
{
  line=$0;

  # enter a server block
  if ($0 ~ /^[[:space:]]*server[[:space:]]*\{/){
    in_server=1; has_domain=0;
  }

  # detect server_name domain inside current server block
  if (in_server && $0 ~ /server_name/ && $0 ~ domain){
    has_domain=1;
  }

  # before closing brace of the TARGET server block, insert location if not already present in conf file
  if (in_server && has_domain && $0 ~ /^[[:space:]]*\}[[:space:]]*$/ && inserted==0){
    print "  # WOLVERINE_STATIC_BEGIN";
    print "  # Force static files under /wolverine/ (no proxy)";
    print "  location ^~ /wolverine/ {";
    print "    alias " docroot "/;";
    print "    try_files $uri $uri/ =404;";
    print "    add_header Cache-Control \"no-store\" always;";
    print "  }";
    print "  # WOLVERINE_STATIC_END";
    inserted=1;
  }

  print line;

  # leave server block
  if (in_server && $0 ~ /^[[:space:]]*\}[[:space:]]*$/){
    in_server=0;
  }
}
END{
  if (inserted==0){
    # do nothing; user will see message in bash after awk
  }
}
' "$CONF.bak.$TS" > "$CONF"

echo "Injected location into correct server{} (if it was missing)."

echo "== 5) nginx test + reload =="
nginx -t
systemctl reload nginx

echo
echo "== 6) Re-test remote (headers + bytes) =="
curl -ksSI "https://${DOMAIN}/wolverine/solana-web3.min.js?v=$TS" | sed -n '1,25p' || true
echo
curl -ksS "https://${DOMAIN}/wolverine/solana-web3.min.js?v=$TS" | head -c 60; echo
echo
echo "DONE ✅ Open: https://${DOMAIN}/wolverine/?v=$TS"
SH

bash /tmp/WOLVERINE_NGINX_VERIFY_AND_FIX_LOCATION.sh
say "9) Relock immutable si nécessaire"
relock_if_needed "$NGINX_INC"  "include"   "$INC_WAS_IMM"
relock_if_needed "$NGINX_SITE" "vhost"     "$SITE_WAS_IMM"
relock_if_needed "$NGINX_MAIN" "nginx.conf" "$MAIN_WAS_IMM"
ok "Terminé"

w "LOG: $OUT"
INNER

chmod +x "$SCRIPT"
rm -f "$NOH" "$LOG" 2>/dev/null || true
nohup bash "$SCRIPT" >"$NOH" 2>&1 & disown || true

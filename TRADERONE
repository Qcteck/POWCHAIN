set -e

echo "=== 1) Quels fichiers NGINX déclarent fireinners.online ? ==="
grep -RIn --line-number -E 'server_name\s+.*(fireinners\.online|www\.fireinners\.online)' /etc/nginx/sites-enabled | sed -n '1,200p'
echo

echo "=== 2) Lister sites-enabled (pour voir les doublons) ==="
ls -lah /etc/nginx/sites-enabled | sed -n '1,200p'
echo

echo "=== 3) Désactiver tous les vhosts non-ssl / disabled / old qui contiennent fireinners (sauf *-ssl) ==="
for f in /etc/nginx/sites-enabled/*; do
  [ -f "$f" ] || continue
  if grep -qE 'server_name\s+.*(fireinners\.online|www\.fireinners\.online)' "$f"; then
    case "$f" in
      *-ssl* ) echo "KEEP: $f" ;;
      * ) echo "OFF:  $f"; mv "$f" "$f.off.$(date +%s)" ;;
    esac
  fi
done
echo

echo "=== 4) Re-test nginx ==="
nginx -t
systemctl reload nginx
echo "OK: nginx reloaded"
echo

echo "=== 5) Vérif finale (plus de warning attendu) ==="
nginx -T 2>/dev/null | grep -nE 'server_name\s+.*(fireinners\.online|www\.fireinners\.online)' | head -n 50 || true
function detectLang(txt){
  txt=String(txt||"");
  const frHits = (txt.match(/[àâäçéèêëîïôöùûüÿœæ]/gi)||[]).length;
  const enHits = (txt.match(/\b(the|and|with|from|that|this|have|will|market|crypto)\b/gi)||[]).length;
  if(frHits>=3) return "fr";
  if(enHits>=3) return "en";
  return null;
}

function sentiment(title, text){
  const s=(String(title||"")+" "+String(text||"")).toLowerCase();
  let p=0,n=0;
  ["surge","rally","bull","record","approval","win","up","gain","breakout","inflows","beat"].forEach(w=>{ if(s.includes(w)) p++; });
  ["crash","down","bear","hack","lawsuit","ban","rejected","exploit","liquidation","risk","outage","fraud"].forEach(w=>{ if(s.includes(w)) n++; });
  if(p-n>=2) return "Positif";
  if(n-p>=2) return "Négatif";
  return "Neutre";
}

function detectTags(title,text){
  const s=(String(title||"")+" "+String(text||"")).toLowerCase();
  const tags=[];
  const has=(...w)=>w.some(x=>s.includes(x));
  if(has("etf","sec","regulat","regulation","law","lawsuit")) tags.push("Régulation");
  if(has("hack","exploit","breach","drain","phishing")) tags.push("Sécurité");
  if(has("inflation","rates","fed","macro","cpi","jobs","recession")) tags.push("Macro");
  if(has("solana","ethereum","bitcoin","btc","eth","sol")) tags.push("Majors");
  if(has("meme","airdrop","pump","rug","scam")) tags.push("Risque");
  if(has("spot","futures","options","liquidation")) tags.push("Dérivés");
  if(has("upgrade","fork","validator","outage","congestion")) tags.push("Technique");
  return [...new Set(tags)].slice(0,8);
}

function summarize(text){
  text=String(text||"").replace(/\r/g,"").trim();
  const paras=text.split(/\n\s*\n/).map(x=>x.trim()).filter(Boolean);
  const out=[];
  for(const p of paras){
    if(out.length>=4) break;
    const s=p.replace(/\s+/g," ").slice(0,260);
    if(s.length>90) out.push("• "+s);
  }
  return out.length?out.join("\n"):"• (Résumé limité: contenu bloqué/court)";
}

function stripHtml(html){
  html=String(html||"");
  return html
    .replace(/<script[\s\S]*?<\/script>/gi," ")
    .replace(/<style[\s\S]*?<\/style>/gi," ")
    .replace(/<noscript[\s\S]*?<\/noscript>/gi," ")
    .replace(/<\/p>/gi,"\n\n")
    .replace(/<br\s*\/?>/gi,"\n")
    .replace(/<li[^>]*>/gi,"\n• ")
    .replace(/<\/li>/gi," ")
    .replace(/<h[1-6][^>]*>/gi,"\n\n")
    .replace(/<\/h[1-6]>/gi,"\n")
    .replace(/<[^>]+>/g," ")
    .replace(/[ \t]+\n/g,"\n")
    .replace(/\n{3,}/g,"\n\n")
    .trim();
}

function qualityScore(text){
  text=String(text||"");
  const len=text.length;
  const links=(text.match(/https?:\/\//g)||[]).length;
  const punct=(text.match(/[.!?]/g)||[]).length;
  const ratio = links / Math.max(1,len);
  let q=0;
  q += clamp(Math.round(len/80),0,65);
  q += clamp(punct,0,20);
  q -= clamp(Math.round(ratio*5000),0,20);
  return clamp(q,0,100);
}

function paywallSuspect(text){
  const t=String(text||"").toLowerCase();
  if(t.length<600) return true;
  if(/subscribe|subscription|sign in|log in|paywall|members only|continue reading|premium|abonnez-vous|abonnement|connectez-vous|réservé aux abonnés/.test(t)) return true;
  return false;
}


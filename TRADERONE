#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT_DEFAULT="/opt/fireinners/frontend-react/app/dist"

need_root(){ [ "$(id -u)" -eq 0 ] || { echo "ERR: run as root"; exit 1; }; }
ts(){ date +"%Y%m%d-%H%M%S"; }

unlock_if_immutable(){
  local f="$1"
  command -v lsattr >/dev/null 2>&1 || return 0
  command -v chattr >/dev/null 2>&1 || return 0
  [ -e "$f" ] || return 0
  if lsattr -d "$f" 2>/dev/null | grep -q '\-i\-'; then return 0; fi
  if lsattr -d "$f" 2>/dev/null | grep -q ' i '; then chattr -i "$f" 2>/dev/null || true; fi
}
relock_if_possible(){
  local f="$1"
  command -v chattr >/dev/null 2>&1 || return 0
  [ -e "$f" ] || return 0
  chattr +i "$f" 2>/dev/null || true
}

backup_file(){
  local f="$1"
  [ -f "$f" ] || return 0
  cp -a "$f" "$f.bak.$(ts)"
  echo "backup: $f.bak.$(ts)"
}

detect_root(){
  local r="$ROOT_DEFAULT"
  if [ -f "$VHOST" ]; then
    r="$(awk 'BEGIN{r=""} $1=="root"{gsub(/;/,"",$2); if(r=="") r=$2} END{print r}' "$VHOST" | head -n1)"
    [ -n "${r:-}" ] || r="$ROOT_DEFAULT"
  fi
  echo "$r"
}

restore_vhost_if_nginx_broken(){
  if command -v nginx >/dev/null 2>&1; then
    if ! nginx -t >/dev/null 2>&1; then
      echo "nginx -t FAIL -> attempt restore vhost from latest backup"
      local last
      last="$(ls -1t "${VHOST}.bak."* 2>/dev/null | head -n1 || true)"
      if [ -n "${last:-}" ] && [ -f "$last" ]; then
        unlock_if_immutable "$VHOST"
        cp -a "$last" "$VHOST"
        echo "restored: $VHOST <= $last"
        nginx -t
        systemctl reload nginx
        relock_if_possible "$VHOST"
      else
        echo "ERR: nginx broken and no vhost backup found: ${VHOST}.bak.*"
        exit 1
      fi
    fi
  fi
}


EOF_SNIP

say "DEMELE: move ALL location-snippets out of http-context into server{}"
python3 - <<PY
import re, pathlib, sys, os

DOMAIN="$DOMAIN"
VHOST=pathlib.Path("$VHOST")
NGXCONF=pathlib.Path("$NGXCONF")
SNIP_DIR=pathlib.Path("$SNIP_DIR")

def read(p):
  return p.read_text(encoding="utf-8", errors="ignore")

def write(p,s):
  p.write_text(s, encoding="utf-8")

# 1) list snippets that contain location directives
snips=[]
if SNIP_DIR.exists():
  for p in sorted(SNIP_DIR.glob("*.conf")):
    s=read(p)
    if re.search(r"(?m)^\s*location\s+", s):
      snips.append(p)

if not snips:
  print("OK: no location-snippets found")
  sys.exit(0)

# 2) remove includes of these snippets from nginx.conf and conf.d (http-context)
targets=[NGXCONF]
conf_d=pathlib.Path("/etc/nginx/conf.d")
if conf_d.exists():
  targets += sorted(conf_d.glob("*.conf"))

removed=[]
for t in targets:
  s=read(t)
  s2=s
  for p in snips:
    # remove include lines referencing this snippet
    pat=re.compile(rf"(?m)^\s*include\s+{re.escape(str(p))}\s*;\s*$")
    if pat.search(s2):
      s2=pat.sub("", s2)
      removed.append((str(t), str(p)))
  if s2!=s:
    # cleanup blank lines
    s2=re.sub(r"\n{3,}","\n\n",s2)
    write(t,s2)

print("OK: removed http-level includes:", len(removed))

# 3) ensure includes inside correct server{} in vhost (dedup)
v_txt=read(VHOST).splitlines(True)
# remove any duplicate include lines for our snips anywhere first
for p in snips:
  inc=f"include {p};"
  v_txt=[ln for ln in v_txt if inc not in ln]

out=[]
i=0; n=len(v_txt); patched=False

while i<n:
  ln=v_txt[i]
  if re.match(r"^\s*server\s*\{", ln):
    brace=0; j=i; block=[]
    while j<n:
      l=v_txt[j]
      brace += l.count("{") - l.count("}")
      block.append(l)
      j+=1
      if brace<=0: break
    block_txt="".join(block)
    if re.search(rf"(?m)^\s*server_name\s+.*\b{re.escape(DOMAIN)}\b", block_txt):
      # insert includes right after server { line
      new=[block[0]]
      for p in snips:
        new.append("  "+f"include {p};"+"\n")
      new += block[1:]
      block=new
      patched=True
    out.extend(block)
    i=j
    continue
  out.append(ln); i+=1

if not patched:
  raise SystemExit("FATAL: server block for DOMAIN not found in vhost")

write(VHOST, "".join(out))
print("OK: server{} includes refreshed for", len(snips), "snips")
PY

say "NGINX TEST"
nginx -t

say "RELOAD nginx"
systemctl reload nginx 2>/dev/null || systemctl restart nginx

if command -v chattr >/dev/null 2>&1; then
  say "REFREEZE chattr +i (best effort)"
  chattr +i "$NGXCONF" 2>/dev/null || true
  chattr +i "$VHOST" 2>/dev/null || true
  chattr +i "$WOLV_SNIP" 2>/dev/null || true
fi

say "TEST (LOCAL bypass CF)"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/" | head -c 80 || true; echo
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/vault-api/health" || true; echo
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/traderone/vault/health" || true; echo
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/traderone/api/health" || true; echo

say "DONE"
say "Backup: $BK"
EOF
chmod +x "$F"
bash "$F"
echo "OK: ran $F"
'
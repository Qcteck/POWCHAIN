set -euo pipefail

OLD="/etc/nginx/snippets/fireinners_routes.conf"
NEW="/etc/nginx/snippets/fireinners_routes.server.inc"

echo "=== 1) Cherche qui inclut encore $OLD ==="
grep -RIn --color=never "include\s\+$OLD;" /etc/nginx || true
echo

echo "=== 2) Fix include ==="
if [ -f "$NEW" ]; then
  while IFS= read -r f; do
    cp -a "$f" "$f.bak.$(date +%s)" || true
    sed -i "s|include $OLD;|include $NEW;|g" "$f"
    echo "Patched: $f"
  done < <(grep -RIl "include\s\+$OLD;" /etc/nginx || true)
else
  echo "⚠️ $NEW n'existe pas -> je supprime l'include cassé."
  while IFS= read -r f; do
    cp -a "$f" "$f.bak.$(date +%s)" || true
    sed -i "\|include\s\+$OLD;|d" "$f"
    echo "Removed: $f"
  done < <(grep -RIl "include\s\+$OLD;" /etc/nginx || true)
fi

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx
echo "✅ OK"
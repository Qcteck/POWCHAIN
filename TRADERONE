bash <<'EOF'
set -euo pipefail

### CONFIG
APP_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$APP_DIR/index.html"
BACKUP="$APP_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"
WORKER_BASE="https://aiquila-proxy.workers.dev"   # ⚠️ NE PAS CHANGER
RSS_ENDPOINT="/rss"

echo "== AIAQUILA RSS HARD FIX =="

### 1. Vérifs
[ -d "$APP_DIR" ] || { echo "❌ Dossier absent $APP_DIR"; exit 1; }
[ -f "$INDEX" ] && cp "$INDEX" "$BACKUP"

### 2. Écriture HTML FINAL (JSON ONLY)
cat > "$INDEX" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;padding:20px;font-family:system-ui;background:#0b1b3a;color:#fff}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>

<script>
const API = "https://aiquila-proxy.workers.dev/rss";

async function load(){
  const out=document.getElementById("out");
  out.textContent="Chargement…\n";
  try{
    const r=await fetch(API,{cache:"no-store"});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();
    if(!Array.isArray(j)) throw new Error("JSON invalide");
    let txt="";
    j.forEach((a,i)=>{
      txt+=`${i+1}. ${a.title}\n${a.link}\n\n`;
    });
    out.textContent=txt||"Aucun article";
  }catch(e){
    out.textContent="ERREUR: "+e.message;
  }
}
</script>
</body>
</html>
HTML

### 3. Reload nginx
nginx -t && systemctl reload nginx

### 4. Tests Worker
echo "== TEST WORKER =="
curl -s "$WORKER_BASE/health" || true

bash <<'EOF'
set -e
echo "==============================="
echo "WOLVERINE • ROOT MEGA BATCH"
echo "==============================="

# --- PARAMS ---
BASE_CANDIDATES=(
  "/opt/fireinners/wolverine"
  "/opt/wolverine"
  "/opt/fireinners/frontend-react"
)
MODE="debug"   # debug = bypass nginx / prod = nginx on
PORT=5173

# --- FIND PROJECT ---
APP=""
for p in "${BASE_CANDIDATES[@]}"; do
  if [ -f "$p/package.json" ]; then APP="$p"; break; fi
done

if [ -z "$APP" ]; then
  echo "❌ Projet introuvable"
  exit 1
fi

echo "✔ Projet: $APP"
cd "$APP"

# --- BACKUP ---
TS=$(date +%Y%m%d_%H%M%S)
BK="/opt/backup_wolverine_$TS"
mkdir -p "$BK"
cp -a "$APP" "$BK/" || true
echo "✔ Backup: $BK"

# --- STOP SERVICES ---
echo "[1/5] Stop services"
systemctl stop nginx || true
pkill -f node || true
pkill -f vite || true

# --- INSTALL DEPS ---
echo "[2/5] npm install"
npm install >/dev/null 2>&1 || npm install --legacy-peer-deps >/dev/null 2>&1

# --- RUN ---
if [ "$MODE" = "debug" ]; then
  echo "[3/5] MODE DEBUG — nginx OFF"
  echo "➡️ Ouvre: http://IP_DU_VPS:$PORT"
  npm run dev -- --host --port $PORT
else
  echo "[3/5] MODE PROD — build + nginx ON"
  npm run build
  systemctl start nginx
  echo "➡️ https://fireinners.online/wolverine/"
fi

echo "==============================="
EOF
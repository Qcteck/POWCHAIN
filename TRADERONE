sudo bash -lc 'set -euo pipefail
DST="/opt/fireinners/sentinel/lib/askorupdate.sh"
mkdir -p "$(dirname "$DST")"
cat >"$DST"<<'"'"'SH'"'"'
#!/usr/bin/env bash
# /opt/fireinners/sentinel/lib/askorupdate.sh
set -euo pipefail
ASKORUPDATE_DEFAULT_ASK="${ASKORUPDATE_DEFAULT_ASK:-0}"
ASKORUPDATE_DEFAULT_BACKUP="${ASKORUPDATE_DEFAULT_BACKUP:-1}"
ASKORUPDATE_DEFAULT_VERBOSE="${ASKORUPDATE_DEFAULT_VERBOSE:-1}"
_ts(){ date +%Y%m%d_%H%M%S; }
_log(){ [ "${ASKORUPDATE_DEFAULT_VERBOSE}" = "1" ] && echo "$@"; }
_sha(){ sha256sum | awk '"'"'{print $1}'"'"'; }
askorupdate_file(){
  local target="${1:?target}"; local mode="${2:-0644}"; local owner="${3:-root:root}"
  local immutable="${4:-0}"; local label="${5:-file}"
  local ask="${ASKORUPDATE_ASK:-$ASKORUPDATE_DEFAULT_ASK}"
  local backup="${ASKORUPDATE_BACKUP:-$ASKORUPDATE_DEFAULT_BACKUP}"
  local dir; dir="$(dirname "$target")"; mkdir -p "$dir"
  local new_content; new_content="$(cat)"
  local new_hash; new_hash="$(printf "%s" "$new_content" | _sha)"
  if [ -f "$target" ]; then
    local old_hash; old_hash="$(cat "$target" | _sha || true)"
    if [ "$old_hash" = "$new_hash" ]; then _log "[askorupdate] OK (identique): $label -> $target"; return 0; fi
  fi
  if [ "$ask" = "1" ]; then
    printf "[askorupdate] Update %s ? (y/N) " "$label"
    local ans; read -r ans || true
    case "${ans:-}" in y|Y|yes|YES) ;; *) _log "[askorupdate] SKIP: $label"; return 0;; esac
  fi
  if [ "$immutable" = "1" ] && command -v chattr >/dev/null 2>&1; then chattr -i "$target" 2>/dev/null || true; fi
  if [ -f "$target" ] && [ "$backup" = "1" ]; then cp -a "$target" "${target}.bak.$(_ts)" || true; fi
  umask 022
  printf "%s" "$new_content" > "$target"
  chmod "$mode" "$target" || true
  chown "$owner" "$target" 2>/dev/null || true
  if [ "$immutable" = "1" ] && command -v chattr >/dev/null 2>&1; then chattr +i "$target" 2>/dev/null || true; fi
  _log "[askorupdate] UPDATED: $label -> $target"
}
askorupdate_yesno(){
  local question="${1:-Continue ?}"; local def="${2:-0}"
  local ask="${ASKORUPDATE_ASK:-$ASKORUPDATE_DEFAULT_ASK}"
  if [ "$ask" != "1" ]; then [ "$def" = "1" ] && return 0 || return 1; fi
  if [ "$def" = "1" ]; then printf "%s (Y/n) " "$question"; else printf "%s (y/N) " "$question"; fi
  local ans; read -r ans || true
  case "${ans:-}" in y|Y|yes|YES) return 0;; n|N|no|NO) return 1;; *) [ "$def" = "1" ] && return 0 || return 1;; esac
}
SH
chmod 755 "$DST"
echo "[OK] created $DST"
bash -n "$DST" && echo "[OK] syntax"
ls -la "$DST"
'
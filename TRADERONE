say "7) Patch ALL nginx server blocks for $DOMAIN (80 + 443) to include routes"
python3 - <<'PY'
import re, subprocess, os, sys, datetime, shutil

DOMAIN=os.environ.get("DOMAIN","fireinners.online")
INC=os.environ.get("INC","/etc/nginx/includes/aquila_stacking_routes.inc")
BK=os.environ.get("BK","/root/BK")

try:
    out=subprocess.check_output(["nginx","-T"], stderr=subprocess.STDOUT, text=True)
except Exception as e:
    print("ERR: nginx -T failed", e); sys.exit(1)

# Parse file sections from nginx -T output
files=[]
cur=None; buf=[]
for line in out.splitlines():
    m=re.match(r'^# configuration file (.+?):$', line.strip())
    if m:
        if cur and buf:
            files.append((cur, "\n".join(buf)))
        cur=m.group(1).strip()
        buf=[]
    else:
        if cur is not None:
            buf.append(line)
if cur and buf:
    files.append((cur, "\n".join(buf)))

candidates=[]
for path,content in files:
    if "server_name" in content and DOMAIN in content:
        candidates.append(path)

candidates=sorted(set(candidates))
if not candidates:
    print("WARN: no candidates found containing server_name", DOMAIN)
    sys.exit(0)

def patch_file(content):
    # Patch each server block that contains server_name DOMAIN by inserting include if missing
    lines=content.splitlines(True)
    out=[]
    i=0
    while i < len(lines):
        line=lines[i]
        if re.match(r'^\s*server\s*\{', line):
            # capture block
            start=i
            depth=0
            block=[]
            while i < len(lines):
                l=lines[i]
                if '{' in l: depth += l.count('{')
                if '}' in l: depth -= l.count('}')
                block.append(l)
                i += 1
                if depth==0: break
            b="".join(block)
            if re.search(r'\bserver_name\b[^;]*\b'+re.escape(DOMAIN)+r'\b', b):
                if INC not in b:
                    # insert include after opening line
                    blk=block[:]
                    ins='  include '+INC+';\n'
                    # after first line
                    blk.insert(1, ins)
                    block=blk
            out.append("".join(block))
            continue
        out.append(line)
        i += 1
    return "".join(out)

for path in candidates:
    try:
        with open(path,'r',encoding='utf-8',errors='ignore') as f:
            orig=f.read()
    except Exception:
        continue
    new=patch(orig)
    if new!=orig:
        os.makedirs(BK, exist_ok=True)
        shutil.copy2(path, os.path.join(BK, path.replace('/','_')+'.bak'))
        try:
            subprocess.run(["chattr","-i",path], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        with open(path,'w',encoding='utf-8') as f:
            f.write(new)
        print("patched:", path)
    else:
        print("ok:", path)
PY


bash <<'EOF'
set -e

ENV="/opt/traderone/.env"
TARGET="e8DbBrTJxRetx3HNFb83CsXMySETydHVLwxMzkjcVqh"

echo "=== TRADERONE • FIX KEY FORMAT ==="

RAW=$(grep '^SOLANA_PRIVATE_KEY_BASE58=' "$ENV" | cut -d= -f2- | tr -d '"')

node <<JS
const fs=require('fs');
const bs58=require('bs58');
const {Keypair}=require('@solana/web3.js');

let raw=\`${RAW}\`.trim();
let kp;

try{
  if(raw.startsWith('[')){
    const arr=JSON.parse(raw);
    kp=Keypair.fromSecretKey(Uint8Array.from(arr));
  }else{
    kp=Keypair.fromSecretKey(bs58.decode(raw));
  }

  const pub=kp.publicKey.toBase58();
  if(pub!=="${TARGET}"){
    console.error("[ERR] Mauvaise clé privée →",pub);
    process.exit(1);
  }

  const fixed=bs58.encode(kp.secretKey);
  fs.writeFileSync("/tmp/fixed_key.txt",fixed);
  console.log("[OK] Clé valide →",pub);
}catch(e){
  console.error("[ERR] Clé invalide:",e.message);
  process.exit(1);
}
JS

FIXED=$(cat /tmp/fixed_key.txt)

sed -i '/SOLANA_PRIVATE_KEY_BASE58/d' "$ENV"
echo "SOLANA_PRIVATE_KEY_BASE58=$FIXED" >> "$ENV"

pm2 restart traderone
pm2 save

echo "=== KEY FIXED & TRADERONE RESTARTED ==="
EOF
bash <<'BASH'
set -euo pipefail

ROOT="/var/www/wolverine"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== [1] Backup global HTML =="
find "$ROOT" -name "*.html" -type f -exec cp -a {} {}.bak_${TS} \;

echo "== [2] Injection thème global =="
THEME=$(cat <<'CSS'
<style id="wolverine-theme">
:root{
  --bg:#0b0f14;
  --panel:#0d1117;
  --border:#1f6feb;
  --btn:#238636;
  --btn-hover:#2ea043;
  --text:#e6edf3;
  --muted:#9da7b3;
  --error:#ff4d4f;
}
html,body{background:var(--bg)!important;color:var(--text)!important;font-family:Inter,Segoe UI,Roboto,Arial,sans-serif}
div,section,pre{color:var(--text)}
input,textarea{
  background:#010409!important;
  color:var(--text)!important;
  border:1px solid var(--border)!important;
}
button{
  background:var(--btn)!important;
  color:#fff!important;
  border:1px solid var(--border)!important;
  cursor:pointer;
}
button:hover{background:var(--btn-hover)!important}
*[style*="cyan"],*[style*="#00"],*[style*="rgb(0"]{
  color:var(--text)!important;
  border-color:var(--border)!important;
}
.error{color:var(--error)!important}
</style>
CSS
)

python3 - <<PY
from pathlib import Path
import sys

root=Path("$ROOT")
theme="""$THEME"""

for p in root.rglob("*.html"):
    s=p.read_text(errors="ignore")
    if "wolverine-theme" in s:
        continue
    if "</head>" in s:
        s=s.replace("</head>",theme+"\n</head>")
    else:
        s=theme+"\n"+s
    p.write_text(s)
    print("✔ theme injecté:",p)
PY

echo "== [3] Reload nginx =="
nginx -t
systemctl reload nginx

echo
echo "=== TERMINÉ ==="
echo "✔ Tous les HTML utilisent maintenant le nouveau thème"
echo "✔ Backup .bak_${TS} disponible"
echo "➡ CTRL+F5 dans le navigateur"
BASH
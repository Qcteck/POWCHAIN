bash -lc 'cat >/root/WOLVERINE_FIX_100.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
HOST="$(hostname -f 2>/dev/null || hostname)"
LOG="/root/WOLVERINE_FIX_100_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

need(){ command -v "$1" >/dev/null 2>&1 || { echo "Missing dependency: $1"; exit 1; }; }

echo "=== WOLVERINE_FIX_100 :: $TS :: $HOST ==="
echo "Log: $LOG"
echo

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
  echo "ERROR: run as root."; exit 1
fi

need bash
need sed
need awk
need grep
need cp
need mkdir
need chmod
need chattr || true
need nginx || true
need systemctl || true
need curl || true
need python3 || true

# --- Paths (mémoire projet) ---
ROOT="/var/www/wolverine"
NGINX_MAIN="/etc/nginx/nginx.conf"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"

API_DIR="/opt/traderone-vault"
API_PORT="3000"
PM2_NAME="traderone-vault"

echo "Paths:"
echo "  ROOT      = $ROOT"
echo "  VHOST     = $VHOST"
echo "  INC       = $INC"
echo "  API_DIR   = $API_DIR"
echo "  API_PORT  = $API_PORT"
echo

# --- 0) Savepoint (si présent) ---
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then
  echo "== 0) Running savepoint script =="
  /root/WOLVERINE_SAVEPOINT.sh || echo "WARN: savepoint script returned non-zero (continuing)"
  echo
else
  echo "== 0) Savepoint script not found at /root/WOLVERINE_SAVEPOINT.sh (continuing) =="
  echo
fi

# --- helpers ---
backup_file(){
  local f="$1"
  if [ -f "$f" ]; then
    cp -a "$f" "${f}.bak_${TS}"
    echo "Backup: $f -> ${f}.bak_${TS}"
  fi
}
unfreeze(){
  local f="$1"
  [ -e "$f" ] || return 0
  chattr -i "$f" 2>/dev/null || true
}
refreeze(){
  local f="$1"
  [ -e "$f" ] || return 0
  chattr +i "$f" 2>/dev/null || true
}
ensure_dir(){
  mkdir -p "$1"
  chmod 755 "$1" || true
}

# --- 1) Ensure ROOT has index.html (try to recover from known dist locations) ---
echo "== 1) Ensuring Wolverine frontend exists =="
ensure_dir "$ROOT"

if [ ! -f "$ROOT/index.html" ]; then
  echo "WARN: $ROOT/index.html missing. Attempting recovery from known locations..."
  CANDIDATES=(
    "/opt/fireinners/frontend-react/app/dist/wolverine"
    "/opt/wolverine/out"
    "/opt/wolverine/dist"
    "/opt/wolverine/build"
    "/opt/wolverine/.next"
    "/var/www/wolverine"
  )
  FOUND=""
  for d in "${CANDIDATES[@]}"; do
    if [ -f "$d/index.html" ]; then
      FOUND="$d"
      break
    fi
  done
  if [ -n "$FOUND" ]; then
    echo "Found candidate: $FOUND"
    rsync -a --delete "$FOUND/" "$ROOT/" || { cp -a "$FOUND/." "$ROOT/"; }
    echo "Recovered frontend into $ROOT"
  else
    echo "ERROR: Could not find any index.html candidate. Put your built Wolverine files into $ROOT and re-run."
    exit 1
  fi
else
  echo "OK: $ROOT/index.html exists"
fi
echo

# --- 2) Create a SERVE BADGE to prove correct site is served ---
echo "== 2) Creating Wolverine serve badge =="
BADGE="$ROOT/__wolverine_ok.txt"
echo "WOLVERINE_OK $TS $HOST" > "$BADGE"
chmod 644 "$BADGE" || true
echo "Badge created: $BADGE"
echo

# --- 3) Write/update nginx include for /wolverine routes + proxy backend ---
echo "== 3) Updating nginx routes include =="
ensure_dir "$(dirname "$INC")"
backup_file "$INC" || true

INC_TMP="/tmp/wolverine_routes_${TS}.inc"
cat >"$INC_TMP" <<EOF
# AUTOGENERATED by /root/WOLVERINE_FIX_100.sh @ $TS
# Wolverine static + TraderOne API proxy

location = /wolverine { return 301 /wolverine/; }

# Badge to confirm correct root is served
location = /wolverine/__wolverine_ok.txt {
  alias $ROOT/__wolverine_ok.txt;
  add_header Cache-Control "no-store" always;
}

# Block SW/manifest caching issues (optional hard-404)
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

# Next static assets
location ^~ /wolverine/_next/ {
  alias $ROOT/_next/;
  try_files \$uri \$uri/ =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# Vendor assets (solana-web3 local, etc.)
location ^~ /wolverine/vendor/ {
  alias $ROOT/vendor/;
  try_files \$uri =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# Main app (static export routing)
location ^~ /wolverine/ {
  alias $ROOT/;
  try_files \$uri \$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}

# TraderOne API (strip prefix /wolverine/traderone/api/)
location ^~ /wolverine/traderone/api/ {
  rewrite ^/wolverine/traderone/api/?(.*)\$ /\$1 break;
  proxy_pass http://127.0.0.1:$API_PORT/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_read_timeout 60s;
}
EOF

# Safe replace
cp -a "$INC_TMP" "$INC"
chmod 644 "$INC" || true
echo "Wrote: $INC"
echo

# --- 4) Ensure vhost includes the include file ---
echo "== 4) Ensuring vhost includes $INC =="
if [ ! -f "$VHOST" ]; then
  echo "ERROR: Vhost not found: $VHOST"
  echo "Known vhost path (per project memory) must exist. Fix vhost path then re-run."
  exit 1
fi

unfreeze "$NGINX_MAIN"
unfreeze "$VHOST"
unfreeze "$INC"

backup_file "$VHOST"

if ! grep -qF "include $INC;" "$VHOST"; then
  echo "Include missing, inserting near end of vhost..."
  # Insert before the last "}" in file (best-effort)
  python3 - <<PY
from pathlib import Path
p=Path("$VHOST")
s=p.read_text(errors="ignore").splitlines()
out=[]
inserted=False
for i,line in enumerate(s):
    out.append(line)
# naive: add include before last closing brace
for j in range(len(out)-1, -1, -1):
    if out[j].strip()=="}":
        out.insert(j, f"    include $INC;")
        inserted=True
        break
if not inserted:
    out.append(f"include $INC;")
p.write_text("\n".join(out)+("\n" if out and not out[-1].endswith("\n") else ""))
print("Inserted include:", inserted)
PY
else
  echo "OK: vhost already includes $INC"
fi
echo

# --- 5) Nginx test + reload ---
echo "== 5) Testing and reloading nginx =="
if nginx -t; then
  systemctl reload nginx || systemctl restart nginx
  echo "OK: nginx reloaded"
else
  echo "ERROR: nginx -t failed. Restoring vhost backup..."
  if [ -f "${VHOST}.bak_${TS}" ]; then
    cp -a "${VHOST}.bak_${TS}" "$VHOST"
  fi
  nginx -t || true
  exit 1
fi
echo

# --- 6) Ensure Node + PM2 ---
echo "== 6) Ensuring node + pm2 =="
if ! command -v node >/dev/null 2>&1; then
  echo "Node.js missing -> installing via NodeSource (no apt/npm mixing rule respected)"
  need apt-get
  need curl
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt-get update -y
  apt-get install -y nodejs
fi
node -v
npm -v

if ! command -v pm2 >/dev/null 2>&1; then
  echo "Installing pm2 globally..."
  npm i -g pm2
fi
pm2 -v
echo

# --- 7) Deploy minimal backend that actually creates vaults (real Solana Keypair) ---
echo "== 7) Deploying TraderOne Vault backend (minimal, real keypair generation) =="
ensure_dir "$API_DIR"
ensure_dir "$API_DIR/vaults"
backup_file "$API_DIR/server.js" || true
backup_file "$API_DIR/package.json" || true

cat >"$API_DIR/package.json" <<'EOF'
{
  "name": "traderone-vault",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "type": "commonjs",
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  }
}
EOF

cat >"$API_DIR/server.js" <<'EOF'
const fs=require("fs");
const path=require("path");
const crypto=require("crypto");
const express=require("express");
const cors=require("cors");
const bs58=require("bs58");
const {Keypair}=require("@solana/web3.js");

const PORT=parseInt(process.env.PORT||"3000",10);
const HOST=process.env.HOST||"127.0.0.1";
const DATA_DIR=process.env.DATA_DIR||__dirname;
const VAULTS_DIR=path.join(DATA_DIR,"vaults");
const MASTER_FILE=path.join(DATA_DIR,".masterkey");

if(!fs.existsSync(VAULTS_DIR)) fs.mkdirSync(VAULTS_DIR,{recursive:true,mode:0o755});

function loadOrCreateMasterKey(){
  if(process.env.VAULT_MASTER_KEY && process.env.VAULT_MASTER_KEY.length>=32) return Buffer.from(process.env.VAULT_MASTER_KEY,"utf8");
  if(fs.existsSync(MASTER_FILE)){
    const k=fs.readFileSync(MASTER_FILE,"utf8").trim();
    return Buffer.from(k,"utf8");
  }
  const k=crypto.randomBytes(32).toString("hex"); // 64 chars
  fs.writeFileSync(MASTER_FILE,k,{mode:0o600});
  return Buffer.from(k,"utf8");
}
const MASTER=loadOrCreateMasterKey();

function enc(jsonObj){
  const iv=crypto.randomBytes(12);
  const key=crypto.createHash("sha256").update(MASTER).digest();
  const cipher=crypto.createCipheriv("aes-256-gcm",key,iv);
  const pt=Buffer.from(JSON.stringify(jsonObj),"utf8");
  const ct=Buffer.concat([cipher.update(pt),cipher.final()]);
  const tag=cipher.getAuthTag();
  return {iv:iv.toString("base64"), ct:ct.toString("base64"), tag:tag.toString("base64")};
}

const app=express();
app.use(cors({origin:true,credentials:false}));
app.use(express.json({limit:"1mb"}));

app.get("/health",(req,res)=>{
  res.json({ok:true,service:"traderone-vault",host:HOST,port:PORT,ts:Date.now()});
});

function newId(){
  return crypto.randomBytes(16).toString("hex");
}

function createVault(clientPub){
  const kp=Keypair.generate();
  const id=newId();
  const rec={
    id,
    createdAt:new Date().toISOString(),
    clientPub: clientPub||null,
    vaultPub: kp.publicKey.toBase58(),
    secretKey_b58: bs58.encode(Buffer.from(kp.secretKey))
  };
  const sealed=enc(rec);
  const store={
    id:rec.id,
    createdAt:rec.createdAt,
    clientPub:rec.clientPub,
    vaultPub:rec.vaultPub,
    sealed
  };
  fs.writeFileSync(path.join(VAULTS_DIR,`${id}.json`),JSON.stringify(store,null,2),{mode:0o600});
  return {id,vaultPub:rec.vaultPub};
}

// Accept both /vault/create and /api/vault/create to be tolerant
app.post(["/vault/create","/api/vault/create"],(req,res)=>{
  try{
    const clientPub=(req.body && typeof req.body.pub==="string")?req.body.pub:null;
    const v=createVault(clientPub);
    res.json({ok:true,...v});
  }catch(e){
    res.status(500).json({ok:false,error:(e&&e.message)?e.message:String(e)});
  }
});

// Simple lookup
app.get(["/vault/:id","/api/vault/:id"],(req,res)=>{
  try{
    const id=req.params.id;
    const f=path.join(VAULTS_DIR,`${id}.json`);
    if(!fs.existsSync(f)) return res.status(404).json({ok:false,error:"not_found"});
    const j=JSON.parse(fs.readFileSync(f,"utf8"));
    res.json({ok:true,id:j.id,vaultPub:j.vaultPub,createdAt:j.createdAt,clientPub:j.clientPub});
  }catch(e){
    res.status(500).json({ok:false,error:(e&&e.message)?e.message:String(e)});
  }
});

app.listen(PORT,HOST,()=>{ console.log(`[traderone-vault] listening http://${HOST}:${PORT}`); });
EOF

chmod 755 "$API_DIR" || true
chmod 600 "$API_DIR/server.js" "$API_DIR/package.json" || true
echo "Backend files written."
echo

echo "Installing backend deps (npm install) ..."
( cd "$API_DIR" && npm install --omit=dev )
echo "Deps OK."
echo

# --- 8) Start/Restart PM2 process ---
echo "== 8) Starting PM2 process =="
pm2 delete "$PM2_NAME" >/dev/null 2>&1 || true
( cd "$API_DIR" && pm2 start "$API_DIR/server.js" --name "$PM2_NAME" --update-env --time -- \
  -- )
pm2 save || true
pm2 status
echo

# --- 9) Tests: badge + API health + vault create ---
echo "== 9) Local tests (127.0.0.1) =="
echo "-- 9.1) Badge check:"
curl -sS -D- "http://127.0.0.1/wolverine/__wolverine_ok.txt" | head -n 20 || true
echo

echo "-- 9.2) API health check through nginx proxy:"
curl -sS -D- "http://127.0.0.1/wolverine/traderone/api/health" | head -n 30 || true
echo

echo "-- 9.3) Vault create (through nginx proxy):"
curl -sS -X POST "http://127.0.0.1/wolverine/traderone/api/vault/create" \
  -H "Content-Type: application/json" \
  -d "{\"pub\":\"\"}" | head -c 500; echo
echo

# --- 10) External HTTPS test (best-effort) ---
echo "== 10) External domain tests (best-effort) =="
echo "-- 10.1) https://fireinners.online/wolverine/__wolverine_ok.txt"
curl -k -sS -D- "https://fireinners.online/wolverine/__wolverine_ok.txt" | head -n 20 || true
echo
echo "-- 10.2) https://fireinners.online/wolverine/traderone/api/health"
curl -k -sS -D- "https://fireinners.online/wolverine/traderone/api/health" | head -n 30 || true
echo

# --- 11) Re-freeze immutables (best effort) ---
echo "== 11) Re-freezing nginx files (best-effort) =="
refreeze "$NGINX_MAIN"
refreeze "$VHOST"
refreeze "$INC"
echo "Done."
echo

echo "=== RESULT SUMMARY ==="
echo "1) Badge should return: WOLVERINE_OK $TS $HOST"
echo "2) API health should return JSON ok:true"
echo "3) Vault create should return {ok:true,id,vaultPub}"
echo
echo "If badge works but UI still wrong: the served frontend is not the one you think (or cached). The badge proves what file root is used."
echo "If API health fails: nginx proxy path or PM2 backend is not running."
echo
echo "Logs:"
echo "  Script log: $LOG"
echo "  PM2 logs: pm2 logs $PM2_NAME --lines 200"
echo
BASH
chmod +x /root/WOLVERINE_FIX_100.sh
/root/WOLVERINE_FIX_100.sh'
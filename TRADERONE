@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM =========================
REM ROBO600 1:3 — STL AUTO EXPORT (NO ELECTRONICS)
REM Requires: OpenSCAD installed (openscad.exe)
REM =========================

set "ROOT=%~dp0"
set "OUT=%ROOT%ROBO600_1to3_STL"
set "SCAD=%OUT%\ROBO600_1to3_mechanical.scad"

if not exist "%OUT%" mkdir "%OUT%" >nul 2>&1

REM ---- Find OpenSCAD
set "OPENSCAD="
if defined OPENSCAD if exist "%OPENSCAD%" set "OPENSCAD=%OPENSCAD%"
if not defined OPENSCAD if exist "C:\Program Files\OpenSCAD\openscad.exe" set "OPENSCAD=C:\Program Files\OpenSCAD\openscad.exe"
if not defined OPENSCAD if exist "C:\Program Files (x86)\OpenSCAD\openscad.exe" set "OPENSCAD=C:\Program Files (x86)\OpenSCAD\openscad.exe"

if not defined OPENSCAD (
  echo ERREUR: OpenSCAD introuvable.
  echo Installe OpenSCAD puis relance. Chemins testes:
  echo  - C:\Program Files\OpenSCAD\openscad.exe
  echo  - C:\Program Files (x86)\OpenSCAD\openscad.exe
  echo Astuce: tu peux definir une variable d'environnement OPENSCAD vers openscad.exe
  pause
  exit /b 1
)

REM ---- Write SCAD (UTF-8) via PowerShell heredoc
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
"$scad=@'
/*
ROBO600 — Mechanical Mockup 1:3 (NO electronics)
- Simple friction joints: drill holes at dimples, use M3 screws + washers/spacers.
- Parts are intentionally simple blocks to validate proportions + stance + clearances.
- Default scale targets ~200mm tall mockup.
*/
$fn=64;

// --- Global scale (1:3) and dims (mm)
S=1; // keep 1 here; dimensions below already represent 1:3 mockup
wall=4;
plate=4;

// --- Dimple markers for drilling (small bumps)
module dimple(d=2,h=0.8){cylinder(d=d,h=h);}
module dimple2(x,y,z=0,d=2,h=0.8){translate([x,y,z])dimple(d,h);}

// --- Rounded-ish block helper
module blk(x,y,z,r=2){
  minkowski(){
    cube([max(1,x-2*r),max(1,y-2*r),max(1,z-2*r)]);
    sphere(r=r);
  }
}

// --- Base plate (stance test)
module base_plate(){
  difference(){
    cube([160,120,6]);
    // corner chamfers (simple)
    translate([0,0,0]) cube([10,10,10]);
    translate([150,0,0]) cube([10,10,10]);
    translate([0,110,0]) cube([10,10,10]);
    translate([150,110,0]) cube([10,10,10]);
  }
}

// --- Foot + toe (toe pitch joint via friction)
module foot_plate(side=0){
  // side=0 left, 1 right (mirror in assembly if you want)
  // Foot: 70x32x10 with ankle pad and toe hinge line
  union(){
    translate([0,0,0]) blk(70,32,10,2);
    // ankle pad
    translate([18,6,10]) blk(18,20,8,2);
    // dimples: ankle joint and toe joint
    dimple2(27,16,18,2,0.9); // ankle axis marker
    dimple2(55,16,10,2,0.9); // toe axis marker (front)
  }
}
module toe_plate(){
  // Toe: 30x32x8
  union(){
    translate([0,0,0]) blk(30,32,8,2);
    // dimple align with foot toe marker
    dimple2(5,16,8,2,0.9);
  }
}

// --- Shin / Thigh links (simple bars with drill dimples at ends)
module shin_link(){
  // 90x18x14
  union(){
    blk(90,18,14,2);
    dimple2(9,9,14,2,0.9);   // knee/ankle marker
    dimple2(81,9,14,2,0.9);  // knee/ankle marker
  }
}
module thigh_link(){
  // 85x20x16
  union(){
    blk(85,20,16,2);
    dimple2(9,10,16,2,0.9);
    dimple2(76,10,16,2,0.9);
  }
}

// --- Pelvis + torso (1 segment torso)
module pelvis_plate(){
  // 70x46x18 with hip markers left/right + core marker
  union(){
    blk(70,46,18,3);
    // hip dimples (left/right)
    dimple2(12,23,18,2,0.9);
    dimple2(58,23,18,2,0.9);
    // core dimple (front)
    dimple2(35,8,18,2,0.9);
  }
}
module torso_plate(){
  // 60x34x26 (mounts on pelvis)
  union(){
    blk(60,34,26,3);
    // dimples for waist/torso axis markers
    dimple2(30,17,26,2,0.9);
    dimple2(30,7,26,2,0.9);
  }
}

// --- Shoulder bar (for arms)
module shoulder_bar(){
  // 90x14x10
  union(){
    blk(90,14,10,2);
    dimple2(12,7,10,2,0.9); // left shoulder
    dimple2(78,7,10,2,0.9); // right shoulder
    dimple2(45,7,10,2,0.9); // center mount
  }
}

// --- Arms (optional)
module upperarm_link(){ // 65x14x12
  union(){blk(65,14,12,2);dimple2(8,7,12,2,0.9);dimple2(57,7,12,2,0.9);}
}
module forearm_link(){ // 58x14x12
  union(){blk(58,14,12,2);dimple2(8,7,12,2,0.9);dimple2(50,7,12,2,0.9);}
}

// --- Spacers / washers (solid; you drill if needed or use as-is)
module spacer_solid(h=6,od=10){cylinder(h=h,d=od);}
module washer_solid(t=2,od=12){cylinder(h=t,d=od);}

// --- Export selector
PART=\"base_plate\";
module part(){
  if(PART==\"base_plate\") base_plate();
  else if(PART==\"foot_plate\") foot_plate();
  else if(PART==\"toe_plate\") toe_plate();
  else if(PART==\"shin_link\") shin_link();
  else if(PART==\"thigh_link\") thigh_link();
  else if(PART==\"pelvis_plate\") pelvis_plate();
  else if(PART==\"torso_plate\") torso_plate();
  else if(PART==\"shoulder_bar\") shoulder_bar();
  else if(PART==\"upperarm_link\") upperarm_link();
  else if(PART==\"forearm_link\") forearm_link();
  else if(PART==\"spacer_6\") spacer_solid(6,10);
  else if(PART==\"spacer_12\") spacer_solid(12,10);
  else if(PART==\"washer\") washer_solid(2,12);
  else base_plate();
}
part();
'@; [System.IO.File]::WriteAllText('%SCAD%',$scad,[System.Text.UTF8Encoding]::new($false))" >nul

if not exist "%SCAD%" (
  echo ERREUR: Impossible d'ecrire le fichier SCAD: %SCAD%
  pause
  exit /b 1
)

echo.
echo OpenSCAD: "%OPENSCAD%"
echo OUT:      "%OUT%"
echo SCAD:     "%SCAD%"
echo.

REM ---- Export helper
set "OK=1"
call :EXPORT base_plate ROBO600_base_plate_160x120x6.stl
call :EXPORT foot_plate ROBO600_foot_plate.stl
call :EXPORT toe_plate ROBO600_toe_plate.stl
call :EXPORT shin_link ROBO600_shin_link.stl
call :EXPORT thigh_link ROBO600_thigh_link.stl
call :EXPORT pelvis_plate ROBO600_pelvis_plate.stl
call :EXPORT torso_plate ROBO600_torso_plate.stl
call :EXPORT shoulder_bar ROBO600_shoulder_bar.stl
call :EXPORT upperarm_link ROBO600_upperarm_link.stl
call :EXPORT forearm_link ROBO600_forearm_link.stl
call :EXPORT spacer_6 ROBO600_spacer_6mm.stl
call :EXPORT spacer_12 ROBO600_spacer_12mm.stl
call :EXPORT washer ROBO600_washer_2mm.stl

echo.
if "%OK%"=="1" (
  echo OK: Tous les STL sont generes.
) else (
  echo ATTENTION: Certains exports ont echoue.
)
echo.
explorer "%OUT%"
pause
exit /b 0

:EXPORT
set "PART=%~1"
set "FILE=%~2"
echo [EXPORT] %PART% -> %FILE%
"%OPENSCAD%" -o "%OUT%\%FILE%" -D "PART=""%PART%""" "%SCAD%" 1>nul
if errorlevel 1 (
  echo   ERREUR export: %PART%
  set "OK=0"
) else (
  if not exist "%OUT%\%FILE%" (
    echo   ERREUR: fichier manquant apres export: %FILE%
    set "OK=0"
  ) else (
    echo   OK
  )
)
exit /b 0
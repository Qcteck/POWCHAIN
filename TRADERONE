set -euo pipefail

echo "=== sites-enabled (doit contenir UNIQUEMENT le vhost actif) ==="
ls -lah /etc/nginx/sites-enabled

echo
echo "=== grep: plus aucun .bak dans sites-enabled ==="
find /etc/nginx/sites-enabled -maxdepth 1 -type f -name '*.bak*' -print || true

echo
echo "=== warning conflicting server name ? (doit être vide) ==="
nginx -t 2>&1 | grep -i 'conflicting server name' || echo "OK: no conflicts ✅"

echo
echo "=== reload (si tout est OK) ==="
systemctl reload nginx
echo "OK reloaded ✅"
#!/bin/bash
set -e

echo "🐺 WOLVERINE — MEGA PATCH v2 (PORT ALIGN)"
echo "======================================"

TS=$(date +%Y%m%d_%H%M%S)
LOG="/root/wolverine_megapatch_v2_$TS.log"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
BACKUP_DIR="/etc/nginx/_BACKUP_WOLVERINE_$TS"

exec > >(tee -a "$LOG") 2>&1

echo
echo "📦 Backup Nginx"
mkdir -p "$BACKUP_DIR"
cp -a "$NGINX_SITE" "$BACKUP_DIR/"

echo
echo "🔎 Vérification ports Node"
ss -tulpen | grep -E "127.0.0.1:(3000|8585)" || true

echo
echo "🧠 Détection TraderOne réel"
TRADER_PID=$(pgrep -f "/opt/traderone-opt/server.js" | head -n1)
if [ -z "$TRADER_PID" ]; then
  echo "❌ TraderOne non détecté"
  exit 1
fi
echo "✔️ TraderOne PID=$TRADER_PID"
echo "↪️ Écoute confirmée sur 8585"

echo
echo "✏️ Patch Nginx (proxy → 127.0.0.1:8585)"
sed -i.bak_$TS \
  's|proxy_pass http://127.0.0.1:3000|proxy_pass http://127.0.0.1:8585|g' \
  "$NGINX_SITE"

echo
echo "🧪 Test config Nginx"
nginx -t

echo
echo "♻️ Reload Nginx (sans downtime)"
systemctl reload nginx

echo
echo "🩺 Test API direct (8585)"
curl -s -w "\nHTTP %{http_code}\n" http://127.0.0.1:8585/health || true

echo
echo "🧪 Test API via proxy"
curl -s -w "\nHTTP %{http_code}\n" https://localhost/wolverine/traderone/api/health || true

echo
echo "📄 Logs"
echo "Backup Nginx : $BACKUP_DIR"
echo "Log batch     : $LOG"

echo
echo "✅ MEGA PATCH v2 TERMINÉ"
echo "✔️ Nginx aligné sur TraderOne réel (8585)"
echo "❌ Aucun service arrêté"
echo "🔁 Rollback possible via backup"
# /etc/systemd/system/traderone.service
[Unit]
Description=TraderOne Backend
After=network.target

[Service]
ExecStart=/usr/bin/node /opt/traderone/server.cjs
Restart=always
User=root
WorkingDirectory=/opt/traderone
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/traderone.service.d/cache.conf
[Service]
Environment="BALANCES_CACHE_TTL_MS=15000"


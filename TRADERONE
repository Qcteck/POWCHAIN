cat >"$NDJSON_TS" <<'TS'
import fs from "node:fs";
import path from "node:path";
import { ensureDir } from "./rotate.js";

export type NdjsonFlushInfo = {
  ts: string;
  lines: number;
  bytes: number;
  flushMs: number;
  fsyncApplied: boolean;
  fsyncEvery: number;
};

export type NdjsonWriterOpts = {
  bufferLines: number;
  flushMs: number;
  fsync: boolean;
  fsyncEvery: number;
  onFlush?: (info: NdjsonFlushInfo) => void;
};

export type NdjsonWriterStats = {
  flushes: number;
  fsyncs: number;
  lines: number;
  bytes: number;
  avgFlushMs: number;
  maxFlushMs: number;
};

function iso() {
  return new Date().toISOString();
}

export class NdjsonWriter {
  private filePath: string;
  private opts: NdjsonWriterOpts;
  private fd: number | null = null;

  private q: string[] = [];
  private timer: NodeJS.Timeout | null = null;

  private flushCount = 0;
  private fsyncCount = 0;
  private linesCount = 0;
  private bytesCount = 0;

  private flushLatencySumMs = 0;
  private flushLatencyMaxMs = 0;

  constructor(filePath: string, opts: Partial<NdjsonWriterOpts> = {}) {
    this.filePath = filePath;
    this.opts = {
      bufferLines: Math.max(1, opts.bufferLines ?? 50),
      flushMs: Math.max(0, opts.flushMs ?? 1000),
      fsync: !!(opts.fsync ?? false),
      fsyncEvery: Math.max(1, opts.fsyncEvery ?? 1),
      onFlush: opts.onFlush,
    };
  }

  start() {
    this.open();
    if (this.opts.flushMs > 0) {
      this.timer = setInterval(() => {
        try { this.flush(); } catch {}
      }, this.opts.flushMs);
      this.timer.unref();
    }
  }

  write(obj: any) {
    const line = JSON.stringify(obj) + "\n";
    if (this.opts.bufferLines <= 1) {
      this.writeNow(line);
      return;
    }
    this.q.push(line);
    if (this.q.length >= this.opts.bufferLines) this.flush();
  }

  flush() {
    if (!this.fd) this.open();
    if (!this.q.length) return;

    const lines = this.q.length;
    const data = this.q.join("");
    this.q.length = 0;

    const start = process.hrtime.bigint();

    fs.writeSync(this.fd!, data, undefined, "utf8");

    this.flushCount += 1;
    let fsyncApplied = false;
    if (this.opts.fsync && (this.flushCount % this.opts.fsyncEvery === 0)) {
      try {
        fs.fsyncSync(this.fd!);
        this.fsyncCount += 1;
        fsyncApplied = true;
      } catch {}
    }

    const end = process.hrtime.bigint();
    const flushMs = Number(end - start) / 1e6;

    const bytes = Buffer.byteLength(data, "utf8");
    this.linesCount += lines;
    this.bytesCount += bytes;
    this.flushLatencySumMs += flushMs;
    if (flushMs > this.flushLatencyMaxMs) this.flushLatencyMaxMs = flushMs;

    this.opts.onFlush?.({
      ts: iso(),
      lines,
      bytes,
      flushMs,
      fsyncApplied,
      fsyncEvery: this.opts.fsyncEvery,
    });
  }

  reopen() {
    this.flush();
    if (this.fd) {
      try { fs.closeSync(this.fd); } catch {}
      this.fd = null;
    }
    this.open();
  }

  close() {
    if (this.timer) {
      clearInterval(this.timer);
      this.timer = null;
    }
    this.flush();
    if (this.fd) {
      try { fs.closeSync(this.fd); } catch {}
      this.fd = null;
    }
  }

  consumeStats(reset = true): NdjsonWriterStats {
    const flushes = this.flushCount;
    const fsyncs = this.fsyncCount;
    const lines = this.linesCount;
    const bytes = this.bytesCount;
    const avgFlushMs = flushes ? (this.flushLatencySumMs / flushes) : 0;
    const maxFlushMs = this.flushLatencyMaxMs;

    if (reset) {
      this.flushCount = 0;
      this.fsyncCount = 0;
      this.linesCount = 0;
      this.bytesCount = 0;
      this.flushLatencySumMs = 0;
      this.flushLatencyMaxMs = 0;
    }

    return { flushes, fsyncs, lines, bytes, avgFlushMs, maxFlushMs };
  }

  private open() {
    const dir = path.dirname(this.filePath);
    ensureDir(dir);
    this.fd = fs.openSync(this.filePath, "a");
  }

  private writeNow(line: string) {
    if (!this.fd) this.open();

    const start = process.hrtime.bigint();

    fs.writeSync(this.fd!, line, undefined, "utf8");

    this.flushCount += 1;
    let fsyncApplied = false;
    if (this.opts.fsync && (this.flushCount % this.opts.fsyncEvery === 0)) {
      try {
        fs.fsyncSync(this.fd!);
        this.fsyncCount += 1;
        fsyncApplied = true;
      } catch {}
    }

    const end = process.hrtime.bigint();
    const flushMs = Number(end - start) / 1e6;

    const bytes = Buffer.byteLength(line, "utf8");
    this.linesCount += 1;
    this.bytesCount += bytes;
    this.flushLatencySumMs += flushMs;
    if (flushMs > this.flushLatencyMaxMs) this.flushLatencyMaxMs = flushMs;

    this.opts.onFlush?.({
      ts: iso(),
      lines: 1,
      bytes,
      flushMs,
      fsyncApplied,
      fsyncEvery: this.opts.fsyncEvery,
    });
  }
}

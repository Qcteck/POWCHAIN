cat >/root/fix_cf522.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== 1) Services & ports ==="
systemctl is-active nginx || (echo "[ERR] nginx down -> starting"; systemctl start nginx)
ss -lntp | grep -E ':(80|443)\b' || echo "[WARN] nothing listening on 80/443"

echo
echo "=== 2) Local origin test (must work) ==="
curl -I --max-time 5 http://127.0.0.1/ | head -n 5 || echo "[ERR] http://127.0.0.1 failed"
curl -Ik --max-time 7 https://127.0.0.1/ | head -n 6 || echo "[ERR] https://127.0.0.1 failed"

echo
echo "=== 3) Firewall ==="
if command -v ufw >/dev/null 2>&1; then
  ufw status verbose || true
  if ufw status | grep -qi active; then
    ufw allow 80/tcp || true
    ufw allow 443/tcp || true
  fi
fi

# iptables/nft (just display)
echo
echo "=== iptables (filter) ==="
iptables -S 2>/dev/null | head -n 60 || true
echo
echo "=== nft ruleset ==="
nft list ruleset 2>/dev/null | head -n 80 || true

echo
echo "=== 4) Restart nginx ==="
nginx -t
systemctl restart nginx
sleep 1
systemctl is-active nginx && echo "[OK] nginx restarted"

echo
echo "=== 5) DNS from VPS (A/AAAA) ==="
if command -v dig >/dev/null 2>&1; then
  echo "A:"; dig +short fireinners.online A || true
  echo "AAAA:"; dig +short fireinners.online AAAA || true
else
  getent ahosts fireinners.online | head -n 10 || true
fi

echo
echo "=== 6) Public IP of VPS (for matching DNS) ==="
curl -4s --max-time 5 https://api.ipify.org || true
echo
BASH

chmod +x /root/fix_cf522.sh
/root/fix_cf522.sh
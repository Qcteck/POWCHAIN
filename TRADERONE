cat >/tmp/FIX_WOLVERINE_INDEX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

FRONT="/var/www/fireinners/wolverine"
mkdir -p "$FRONT"

echo "Backup..."
[ -f "$FRONT/index.html" ] && cp "$FRONT/index.html" "$FRONT/index.html.bak.$(date +%s)"

echo "Write clean index..."
cat > "$FRONT/index.html" <<'EOF'
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Wolverine</title>
</head>
<body>

<script>
(() => {
  const W = window;
  W.__WOLV__ = W.__WOLV__ || { s:{} };
  const API = W.location.origin + "/wolverine/traderone/api";

  console.log("Wolverine boot", API);
})();
</script>

<script defer src="/wolverine/traderone_overlay.js?v=2"></script>

</body>
</html>
EOF

echo "Reload nginx..."
nginx -t && systemctl reload nginx

echo "Check:"
curl -ks https://fireinners.online/wolverine/ | head -n 6
SH

bash /tmp/FIX_WOLVERINE_INDEX.sh
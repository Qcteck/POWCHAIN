cat >/root/disable_enabled_bak_confs.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DST="/etc/nginx/sites-disabled/backup_cleanup_${TS}"
mkdir -p "$DST"

echo "== 1) Move any *.bak* from sites-enabled to $DST =="
shopt -s nullglob
for f in /etc/nginx/sites-enabled/*.bak*; do
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== 2) Show what's still enabled =="
ls -lah /etc/nginx/sites-enabled

echo
echo "== 3) nginx -t =="
nginx -t

echo
echo "== 4) reload nginx =="
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/disable_enabled_bak_confs.sh
/root/disable_enabled_bak_confs.sh
bash -lc 'set -euo pipefail
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
PATHLOC="/_private_sentinel_/"
SNIP="/etc/nginx/snippets/private_sentinel.conf"
HTPASS="/etc/nginx/.htpasswd_sentinel"

echo "=== PRECHECK ==="
[ -f "$VHOST" ] || { echo "ERROR: vhost introuvable: $VHOST"; exit 1; }
IMMU=0
if lsattr "$VHOST" 2>/dev/null | grep -q "\-i\-"; then IMMU=1; fi
echo "VHOST=$VHOST"
echo "IMMUTABLE(before)=$IMMU"

if [ "$IMMU" = "1" ]; then
  echo "[1] Unlock immutable"
  chattr -i "$VHOST"
fi

echo "[2] Backup vhost"
ts="$(date +%Y%m%d-%H%M%S)"
cp -a "$VHOST" "${VHOST}.bak.${ts}"

echo "[3] Ensure htpasswd tool"
if ! command -v htpasswd >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y apache2-utils
fi

echo "[4] Create/Update BasicAuth user"
read -r -p "User BasicAuth (default: sentinel): " U || true
U="${U:-sentinel}"
if [ ! -f "$HTPASS" ]; then
  htpasswd -c "$HTPASS" "$U"
else
  htpasswd "$HTPASS" "$U"
fi

echo "[5] Write snippet: $SNIP"
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<EOF
location ^~ ${PATHLOC} {
  auth_basic "Sentinel";
  auth_basic_user_file ${HTPASS};
  proxy_pass http://127.0.0.1:3000/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
}
EOF

echo "[6] Inject include in vhost (if missing)"
INC="include $SNIP;"
if ! grep -qF "$INC" "$VHOST"; then
  # insère juste avant le premier "location / {"
  if grep -nE "^[[:space:]]*location[[:space:]]*/[[:space:]]*\\{" "$VHOST" >/dev/null 2>&1; then
    sed -i "0,/^[[:space:]]*location[[:space:]]*\\/[[:space:]]*{/s//  ${INC}\n\n&/" "$VHOST"
  else
    # fallback: ajoute avant la dernière } du fichier
    perl -0777 -i -pe "s/\\n}\\s*\\z/\\n  ${INC}\\n}\\n/s" "$VHOST"
  fi
fi

echo "[7] Test nginx + reload"
nginx -t
systemctl reload nginx

if [ "$IMMU" = "1" ]; then
  echo "[8] Re-lock immutable"
  chattr +i "$VHOST"
fi

echo "=== DONE ==="
echo "Test attendu (doit retourner 401):"
echo "curl -I https://fireinners.online${PATHLOC}"
'
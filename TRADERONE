sudo bash -lc '
set -euo pipefail
echo "[1] show duplicates (if any)"
grep -RnsE "server_name .*fireinners\.online" /etc/nginx/sites-enabled /etc/nginx/sites-available || true

echo "[2] list enabled fireinners files"
ls -la /etc/nginx/sites-enabled | grep -i fireinners || true

echo "[3] move BAD enabled backups out (keep only the real vhost link)"
mkdir -p /root/backup_probe/legacy
for f in /etc/nginx/sites-enabled/*fireinners*bak* /etc/nginx/sites-enabled/*fireinners*backup* /etc/nginx/sites-enabled/*fireinners*\.bak* /etc/nginx/sites-enabled/*fireinners*probe*; do
  [ -e "$f" ] && mv "$f" /root/backup_probe/legacy/
done

echo "[4] ensure correct symlink exists"
VHOST_AV="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
[ -f "$VHOST_AV" ] || { echo "ERR missing $VHOST_AV"; exit 1; }
[ -L "$VHOST_EN" ] || ln -s "$VHOST_AV" "$VHOST_EN"

echo "[5] nginx test + reload"
nginx -t
systemctl reload nginx
echo "OK reloaded"

echo "[6] test backend direct"
TOKEN="$(awk -F= "/^PROBE_TOKEN=/{print \$2}" /opt/probe/probe.env)"
curl -s -H "X-Probe-Token: $TOKEN" http://127.0.0.1:9696/probe | head -c 240; echo

echo "[7] test nginx routing (bypass CF)"
curl -sk --resolve fireinners.online:443:127.0.0.1 -H "X-Probe-Token: $TOKEN" https://fireinners.online/probe | head -c 240; echo
'
cat >/root/FIREINNERS_FIX_SOLRPC_502_MEGA.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGMAIN="/etc/nginx/nginx.conf"
APPDIR="/opt/fireinners/solrpc-proxy"
JS="$APPDIR/server.js"
UNIT="/etc/systemd/system/fireinners-solrpc-proxy.service"
PORT="12703"
BK="/root/backup_fireinners_solrpcfix_${TS}"
mkdir -p "$BK"

echo "==[0] prechecks =="
command -v node >/dev/null || { echo "ERR: node introuvable"; exit 1; }
[ -f "$VHOST" ] || { echo "ERR: vhost missing: $VHOST"; exit 1; }
cp -a "$VHOST" "$BK/fireinners.online-ssl.bak" || true
cp -a "$NGMAIN" "$BK/nginx.conf.bak" || true

echo "==[1] write solrpc proxy app =="
mkdir -p "$APPDIR"
cat >"$JS" <<'JS'
"use strict";
const http=require("http");
const {URL}=require("url");
const PORT=process.env.PORT?Number(process.env.PORT):12703;
const HOST=process.env.HOST||"127.0.0.1";
const UPSTREAMS=[
  "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",
  "https://api.mainnet-beta.solana.com",
  "https://solana-rpc.publicnode.com",
  "https://rpc.ankr.com/solana"
];
function cors(res){
  res.setHeader("access-control-allow-origin","*");
  res.setHeader("access-control-allow-methods","POST,OPTIONS,GET");
  res.setHeader("access-control-allow-headers","content-type");
}
async function tryFetch(body,headers){
  let lastErr=null;
  for(const u of UPSTREAMS){
    try{
      const r=await fetch(u,{method:"POST",headers:{...headers},body});
      const txt=await r.text();
      if(r.status>=500){ lastErr=new Error("upstream "+u+" HTTP "+r.status); continue; }
      return {ok:true,status:r.status,txt,ct:r.headers.get("content-type")||"application/json"};
    }catch(e){ lastErr=e; }
  }
  return {ok:false,err:lastErr||new Error("failover exhausted")};
}
http.createServer(async (req,res)=>{
  cors(res);
  if(req.method==="OPTIONS"){res.writeHead(204);return res.end();}
  const u=new URL(req.url,"http://x");
  if(req.method==="GET" && u.pathname==="/ping"){res.writeHead(200,{"content-type":"text/plain"});return res.end("pong\n");}
  if(req.method!=="POST"){res.writeHead(405,{"content-type":"text/plain"});return res.end("POST only\n");}
  let body="";
  req.on("data",c=>{body+=c; if(body.length>2e6) req.destroy();});
  req.on("end",async ()=>{
    if(!body){res.writeHead(400,{"content-type":"text/plain"});return res.end("empty body\n");}
    const headers={"content-type":req.headers["content-type"]||"application/json"};
    const out=await tryFetch(body,headers);
    if(!out.ok){
      res.writeHead(502,{"content-type":"application/json"});
      return res.end(JSON.stringify({jsonrpc:"2.0",id:null,error:{code:-32000,message:"solrpc failover exhausted",data:String(out.err&&out.err.message||out.err)}}));
    }
    res.writeHead(out.status,{"content-type":out.ct});
    return res.end(out.txt);
  });
}).listen(PORT,HOST,()=>{console.log("solrpc proxy on "+HOST+":"+PORT);});
JS

echo "==[2] systemd service =="
cat >"$UNIT" <<UNIT
[Unit]
Description=FireInners Solana JSON-RPC proxy (CORS-safe, failover)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$APPDIR
Environment=HOST=127.0.0.1
Environment=PORT=$PORT
ExecStart=$(command -v node) $JS
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now fireinners-solrpc-proxy.service
sleep 0.5
systemctl restart fireinners-solrpc-proxy.service
sleep 0.5

echo "==[3] check local proxy =="
ss -lntp | grep -q ":$PORT" || { echo "ERR: proxy not listening on :$PORT"; systemctl status fireinners-solrpc-proxy.service --no-pager; exit 1; }
curl -fsS "http://127.0.0.1:$PORT/ping" >/dev/null && echo "OK local /ping"

echo "==[4] patch nginx vhost /solrpc =="
chattr -i "$NGMAIN" "$VHOST" 2>/dev/null || true
perl -0777 -i -pe 's/\n\s*#\s*BEGIN FIREINNERS SOLRPC[\s\S]*?#\s*END FIREINNERS SOLRPC\s*\n/\n/gm' "$VHOST"
perl -0777 -i -pe 's/\n}\s*$/\n  # BEGIN FIREINNERS SOLRPC\n  location \\= \\/solrpc { return 301 \\/solrpc\\/; }\n  location \\/solrpc\\/ {\n    proxy_http_version 1.1;\n    proxy_set_header Host $host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Proto $scheme;\n    proxy_connect_timeout 10s;\n    proxy_read_timeout 60s;\n    proxy_send_timeout 60s;\n    proxy_pass http:\\/\\/127.0.0.1:'"$PORT"'\\/;\n  }\n  # END FIREINNERS SOLRPC\n}\n/sm' "$VHOST"
nginx -t
systemctl reload nginx
chattr +i "$NGMAIN" "$VHOST" 2>/dev/null || true

echo "==[5] remote tests =="
curl -fsS "https://fireinners.online/solrpc/ping" >/dev/null && echo "OK https /solrpc/ping"
curl -fsS -H 'content-type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' "https://fireinners.online/solrpc/" >/dev/null && echo "OK getHealth via /solrpc/"
echo "DONE. Test wallet: https://fireinners.online/wallet/?v=$TS"
SH
chmod +x /root/FIREINNERS_FIX_SOLRPC_502_MEGA.sh
bash /root/FIREINNERS_FIX_SOLRPC_502_MEGA.sh
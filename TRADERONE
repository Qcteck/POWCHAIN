set -e
cd /root

BLOCK=$(cat <<'EOF'
location ^~ /wolverine/traderone/api/ {
  proxy_pass http://127.0.0.1:3000/api/;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF
)

mkdir -p /root/nginx_backups

for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  echo "PATCH $f"
  cp -v "$f" "/root/nginx_backups/$(basename "$f").$(date +%Y%m%d_%H%M%S)"

  # 1) supprime tous les anciens blocs location /wolverine/traderone/api/ (regex ou ^~ ou simple)
  perl -0777 -i -pe '
    s#location\s+(?:\^~\s+|~\*?\s+|=\s+)?/wolverine/traderone/api/\s*\{.*?\}\s*##sg;
  ' "$f"

  # 2) supprime les proxy_set_header vides (sinon nginx -t peut casser)
  sed -i \
    -e 's/^[[:space:]]*proxy_set_header[[:space:]]\+Host[[:space:]]*;[[:space:]]*$/# removed empty proxy_set_header Host ;/g' \
    -e 's/^[[:space:]]*proxy_set_header[[:space:]]\+X-Real-IP[[:space:]]*;[[:space:]]*$/# removed empty proxy_set_header X-Real-IP ;/g' \
    -e 's/^[[:space:]]*proxy_set_header[[:space:]]\+X-Forwarded-For[[:space:]]*;[[:space:]]*$/# removed empty proxy_set_header X-Forwarded-For ;/g' \
    "$f"

  # 3) ré-insère 1 seul bloc propre juste après "server {"
  perl -0777 -i -pe 's#(server\s*\{)#$1\n\n'"$BLOCK"'\n#s' "$f"
done

echo
echo "=== nginx -t + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== Test LOCAL via nginx (DOIT renvoyer running/bal/etc) ==="
curl -sS -i -X POST -H "Host: fireinners.online" -H "content-type: application/json" \
  http://127.0.0.1/wolverine/traderone/api/status --data '{}' | head -n 60

echo
echo "=== Test PUBLIC HTTPS ==="
BASE="https://fireinners.online/wolverine/traderone/api"
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" --data '{}' | head -n 60
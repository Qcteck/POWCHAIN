cat >/root/find_wolverine_code.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

hr(){ echo -e "\n========== $* ==========\n"; }

hr "1) /var/www (top level)"
ls -lah /var/www || true

hr "2) Biggest candidates under /var/www (depth 3)"
# shows dirs and rough size
find /var/www -maxdepth 3 -type d -print0 2>/dev/null | \
  xargs -0 -I{} bash -lc 'du -sh "{}" 2>/dev/null' | sort -h | tail -n 40 || true

hr "3) Find Node/Next projects (package.json / next.config.js)"
find /var/www -maxdepth 5 -type f \( -name package.json -o -name next.config.js -o -name pnpm-lock.yaml -o -name yarn.lock \) \
  2>/dev/null | sed 's|^|FOUND: |' || true

hr "4) Find Python projects (requirements.txt / pyproject.toml)"
find /var/www -maxdepth 5 -type f \( -name requirements.txt -o -name pyproject.toml -o -name Pipfile \) \
  2>/dev/null | sed 's|^|FOUND: |' || true

hr "5) Find running node services (ports -> PID -> cmdline)"
ss -lntp 2>/dev/null | grep -E 'node|:8585|:3000|:3005|:8484|:8585|:9696|:12703' || true
echo
for p in 3063692 3063681 3063715 3063693 3065616; do
  if [ -d "/proc/$p" ]; then
    echo "PID $p:"; tr '\0' ' ' < /proc/$p/cmdline; echo; echo
  fi
done || true

hr "DONE ✅  -> paste output here"
BASH

chmod +x /root/find_wolverine_code.sh
/root/find_wolverine_code.sh
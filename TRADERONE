# ROOT batch — lier /opt/fireinners/frontend-react/app à https://github.com/Qcteck/WOLVERINE
# puis créer une branche + commit + push
set -euo pipefail

cd /opt/fireinners/frontend-react/app

echo "=== Repo local ==="
pwd
git rev-parse --is-inside-work-tree

echo "=== Remotes AVANT ==="
git remote -v || true

echo "=== Set origin => Qcteck/WOLVERINE ==="
if git remote | grep -qx origin; then
  git remote set-url origin https://github.com/Qcteck/WOLVERINE.git
else
  git remote add origin https://github.com/Qcteck/WOLVERINE.git
fi

echo "=== Remotes APRÈS ==="
git remote -v

echo "=== Branche + commit ==="
BR="wolverine-ui-v2"
git checkout -b "$BR" 2>/dev/null || git checkout "$BR"

git add -A
git commit -m "Wolverine UI v2 (frontend /wolverine)" || true

echo "=== Push ==="
git push -u origin "$BR"
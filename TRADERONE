import re, sys

vhost = "/etc/nginx/sites-available/fireinners.online-ssl"
inc_line = "include /etc/nginx/includes/aquilatrader_static.inc;"

with open(vhost, "r", encoding="utf-8", errors="ignore") as f:
    lines = f.readlines()

# Find server blocks with brace tracking
servers = []
i=0
while i < len(lines):
    if re.match(r'^\s*server\s*\{', lines[i]):
        start=i
        depth=0
        j=i
        while j < len(lines):
            depth += lines[j].count("{")
            depth -= lines[j].count("}")
            if depth==0 and j>start:
                end=j
                servers.append((start,end))
                break
            j+=1
        i = j+1
    else:
        i+=1

if not servers:
    raise SystemExit("No server{ } blocks found in vhost")

def block_text(a,b):
    return "".join(lines[a:b+1])

# choose best match: listen 443 and server_name contains fireinners.online
best=None
for a,b in servers:
    txt = block_text(a,b)
    if re.search(r'^\s*listen\s+443\b', txt, re.M) and re.search(r'^\s*server_name\b.*\bfireinners\.online\b', txt, re.M):
        best=(a,b); break

if not best:
    raise SystemExit("Could not find 443 server block with server_name fireinners.online in vhost")

a,b = best
block = lines[a:b+1]

# Remove any existing include lines (anywhere in block) to avoid duplicates
new_block=[]
for ln in block:
    if re.search(r'include\s+/etc/nginx/includes/aquilatrader_static\.inc;', ln):
        continue
    new_block.append(ln)

# Insert include near end before closing brace
# Determine indentation from other include lines or default two spaces
indent="  "
for ln in new_block:
    m=re.match(r'^(\s*)include\s+', ln)
    if m:
        indent=m.group(1)
        break

# Insert before last line (which should contain "}")
# Find the last line with only closing brace at end of server
insert_at = len(new_block)-1
# ensure last line contains }
while insert_at>0 and "}" not in new_block[insert_at]:
    insert_at -= 1
# put include just before that line
new_block.insert(insert_at, indent + inc_line + "\n")

# Write back
lines[a:b+1] = new_block
with open(vhost, "w", encoding="utf-8") as f:
    f.writelines(lines)

print("OK: injected include into vhost server 443 block:", vhost)
PY

#!/usr/bin/env bash
set -euo pipefail

NGX="/etc/nginx/sites-enabled/fireinners.online-ssl"
BACKUP="/root/nginx_fireinners_fix_$(date +%Y%m%d_%H%M%S).bak"

echo "========================================"
echo " NGINX SAFE FIX — FIREINNERS"
echo "========================================"

if [ "$EUID" -ne 0 ]; then
  echo "❌ Root requis"
  exit 1
fi

if [ ! -f "$NGX" ]; then
  echo "❌ Fichier nginx introuvable : $NGX"
  exit 1
fi

echo "📦 Backup -> $BACKUP"
cp "$NGX" "$BACKUP"

echo "🔍 Suppression lignes non-nginx (sécurité)"
sed -i '/AIAQUILA/d;/ROOT INSTALL/d;/=====/d;/echo /d;/🧠/d' "$NGX"

echo "🔎 Test nginx"
if nginx -t; then
  echo "✅ nginx OK — reload"
  systemctl reload nginx
else
  echo "❌ nginx toujours invalide — rollback"
  cp "$BACKUP" "$NGX"
  nginx -t || true
  exit 1
fi

echo "========================================"
echo "✅ NGINX RÉPARÉ"
echo "========================================"
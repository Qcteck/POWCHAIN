<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Wolverine – Wallet</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<script src="https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js"></script>

<style>
body{background:#0b0f14;color:#fff;font-family:Arial}
#box{width:360px;margin:80px auto;border:2px solid #1dd1ff;padding:20px}
button{width:100%;padding:10px;margin:6px 0}
.addr{color:#1dd1ff;word-break:break-all}
</style>
</head>

<body>
<div id="box">
  <button onclick="connect()">Connect Wallet</button>
  <div class="addr" id="addr"></div>

  <div>SOL: <span id="sol">-</span></div>
  <div>USDC: <span id="usdc">-</span></div>
</div>

<script>
const RPC = "https://api.mainnet-beta.solana.com";
const USDC_MINT = new solanaWeb3.PublicKey(
  "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"
);

let connection;

async function connect(){
  if(!window.solana){
    alert("Installe Phantom");
    return;
  }

  const resp = await window.solana.connect();
  const pubkey = resp.publicKey;

  document.getElementById("addr").innerText = pubkey.toString();

  connection = new solanaWeb3.Connection(RPC,"confirmed");

  // SOL
  const lamports = await connection.getBalance(pubkey);
  document.getElementById("sol").innerText = (lamports/1e9).toFixed(6);

  // USDC
  const accounts = await connection.getParsedTokenAccountsByOwner(
    pubkey,
    { mint: USDC_MINT }
  );

  let total = 0;
  for(const a of accounts.value){
    total += a.account.data.parsed.info.tokenAmount.uiAmount || 0;
  }
  document.getElementById("usdc").innerText = total.toFixed(2);
}
</script>
</body>
</html>
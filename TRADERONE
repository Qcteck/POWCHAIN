for m in wallet dex bridge explorer mining options; do write_simple_module "$m"; done

echo "== perms anti-403 =="
find "$ROOT" -type d -exec chmod 755 {} \; 2>/dev/null || true
find "$ROOT" -type f -exec chmod 644 {} \; 2>/dev/null || true

echo "== patch nginx: proxy /stats to backend 3000 (real online) =="
python3 - <<'PY'
from pathlib import Path
p=Path("/etc/nginx/sites-available/fireinners.online-ssl")
s=p.read_text()

if "location = /stats" in s or "location /stats" in s:
    print("nginx: /stats location already present, skip insert")
    raise SystemExit(0)

insert = r'''
    # WOLFCHAIN: real API status
    location = /stats { proxy_pass http://127.0.0.1:3000/stats; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
    location ^~ /stats/ { proxy_pass http://127.0.0.1:3000/stats/; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
'''
# insert before last "}" of the first server block (best-effort)
idx = s.rfind("}")
if idx==-1:
    raise SystemExit("ERR: cannot find closing brace in vhost")
s2 = s[:idx] + insert + "\n" + s[idx:]
p.write_text(s2)
print("nginx: inserted /stats proxy")
PY

echo "== nginx test + reload =="
nginx -t
systemctl reload nginx

# lock configs back
immut_on /etc/nginx/nginx.conf || true
immut_on "$VHOST" || true

echo "== verify =="
echo "-- direct backend --"
curl -sS -m 3 -i http://127.0.0.1:3000/stats 2>/dev/null | sed -n '1,10p' || true
echo "-- via nginx /stats --"
curl -k -sS -m 3 -i https://127.0.0.1/stats -H 'Host: fireinners.online' 2>/dev/null | sed -n '1,12p' || true
echo "-- via nginx / --"
curl -k -sS -m 3 -i https://127.0.0.1/ -H 'Host: fireinners.online' 2>/dev/null | sed -n '1,12p' || true

echo "DONE"

cat >/root/traderone_audit_live_services.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== TIME ==="; date -u; echo

echo "=== PM2 list ==="
command -v pm2 >/dev/null 2>&1 && pm2 list || true
echo

echo "=== PM2 show for known IDs (0..10) ==="
if command -v pm2 >/dev/null 2>&1; then
  for i in $(seq 0 10); do
    echo "----- pm2 show $i -----"
    pm2 show "$i" 2>/dev/null | sed -n '1,200p' || true
  done
fi
echo

ROOTS=(/opt /root/qplus-secure /var/www)
echo "=== ENDPOINTS (express/nest) ==="
for R in "${ROOTS[@]}"; do
  [ -d "$R" ] || continue
  echo "--- in $R ---"
  grep -RInE --exclude-dir=node_modules --exclude-dir=.git \
    "app\.(get|post|put|delete)|router\.(get|post|put|delete)|@Controller|@Post\(|/api/" \
    "$R" 2>/dev/null | head -n 200 || true
done
echo

echo "=== LI.FI / routing keywords ==="
for R in "${ROOTS[@]}"; do
  [ -d "$R" ] || continue
  echo "--- in $R ---"
  grep -RInE --exclude-dir=node_modules --exclude-dir=.git \
    "lifi|li\.fi|LI\.FI|getRoutes|routes|quote|bridge|swap|jupiter" \
    "$R" 2>/dev/null | head -n 200 || true
done
echo

echo "=== Key-material *locations only* (NEVER paste values) ==="
for R in "${ROOTS[@]}"; do
  [ -d "$R" ] || continue
  echo "--- in $R ---"
  grep -RInE --exclude-dir=node_modules --exclude-dir=.git \
    "secretKey|privateKey|mnemonic|seed|fromSecretKey|Keypair\.from|process\.env|SIGNER|WALLET" \
    "$R" 2>/dev/null | head -n 200 || true
done
echo

echo "=== .env paths only ==="
for R in "${ROOTS[@]}"; do
  [ -d "$R" ] || continue
  find "$R" -maxdepth 6 -type f -name ".env*" 2>/dev/null | head -n 80 || true
done

echo "DONE ✅"
BASH

chmod +x /root/traderone_audit_live_services.sh
/root/traderone_audit_live_services.sh
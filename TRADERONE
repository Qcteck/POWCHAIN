cat > /root/WOLVERINE_FIX_SERVER_NAME_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS=$(date +%Y%m%d_%H%M%S)
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
LOG="/root/WOLVERINE_SERVERNAME_FIX_$TS.log"

echo "=== WOLVERINE SERVER_NAME FINAL FIX ===" | tee -a "$LOG"

if [ ! -f "$VHOST" ]; then
  echo "ERREUR: vhost introuvable: $VHOST" | tee -a "$LOG"
  exit 1
fi

echo "[1/5] Backup vhost" | tee -a "$LOG"
cp -a "$VHOST" "$VHOST.bak_$TS"

echo "[2/5] Nettoyage server_name multiples" | tee -a "$LOG"
# Supprime toutes les lignes server_name existantes
sed -i '/server_name/d' "$VHOST"

echo "[3/5] Injection server_name propre (une seule ligne)" | tee -a "$LOG"
sed -i '/listen 443 ssl http2;/a\    server_name fireinners.online www.fireinners.online;' "$VHOST"

echo "[4/5] Test nginx" | tee -a "$LOG"
nginx -t | tee -a "$LOG"

echo "[5/5] Reload nginx" | tee -a "$LOG"
systemctl reload nginx
sleep 2
systemctl status nginx --no-pager | tee -a "$LOG"

echo
echo "=== FIX TERMINE ==="
echo "Vhost corrigé : $VHOST"
echo "Backup : $VHOST.bak_$TS"
echo "Log : $LOG"
echo
echo "ACTION:"
echo "➡️ CTRL + SHIFT + R dans le navigateur"
BASH

chmod +x /root/WOLVERINE_FIX_SERVER_NAME_FINAL.sh
/root/WOLVERINE_FIX_SERVER_NAME_FINAL.sh
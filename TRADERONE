bash -lc 'cat >/root/WVT_FIX.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
WEBROOT="/var/www/wolverine"
INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST_AV="/etc/nginx/sites-available/fireinners.online-ssl"
LOG="/root/WVT_FIX_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

unlock_i(){ local f="$1"; [ -e "$f" ]||return 0; if lsattr -d "$f" 2>/dev/null | grep -q " i"; then chattr -i "$f"||true; fi; }
say(){ echo; echo "== $* =="; }

say "1) Ensure webroot + badge"
mkdir -p "$WEBROOT"
echo "OK ${TS} host=${HOST} backend=127.0.0.1:3000" >"$WEBROOT/_wolverine_ok.txt"
chmod 0644 "$WEBROOT/_wolverine_ok.txt" || true

say "2) Write nginx include (STATIC + API PROXY)"
unlock_i "$INC"
cat >"$INC" <<'"'"'NGINX'"'"'
# AUTO-GENERATED - Wolverine static + TraderOne API proxy
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Connection "";
  rewrite ^/wolverine/traderone/api/(.*)$ /$1 break;
  proxy_pass http://127.0.0.1:3000;
}

location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}
NGINX

say "3) Ensure vhost includes wolverine include"
unlock_i "$VHOST_AV"
if [ -f "$VHOST_AV" ] && ! grep -q "include /etc/nginx/includes/wolverine_routes.inc" "$VHOST_AV"; then
  cp -a "$VHOST_AV" "${VHOST_AV}.bak_${TS}" || true
  awk 'BEGIN{done=0}{print} /server_name[[:space:]]+fireinners\.online/ && done==0 {print "  include /etc/nginx/includes/wolverine_routes.inc;"; done=1}' "$VHOST_AV" >"${VHOST_AV}.tmp_${TS}"
  mv -f "${VHOST_AV}.tmp_${TS}" "$VHOST_AV"
fi

say "4) nginx reload"
unlock_i /etc/nginx/nginx.conf
nginx -t
systemctl reload nginx || systemctl restart nginx

say "5) Tests (must be 200)"
echo "-- A) backend direct --"; curl -sS -i "http://127.0.0.1:3000/health" | head -n 25 || true
echo "-- B) local badge --"; curl -sS -i "http://127.0.0.1/wolverine/_wolverine_ok.txt" | head -n 25 || true
echo "-- C) local api via nginx --"; curl -sS -i -H "Host: ${HOST}" "http://127.0.0.1/wolverine/traderone/api/health" | head -n 25 || true
echo "-- D) public badge --"; curl -sS -i "https://${HOST}/wolverine/_wolverine_ok.txt" | head -n 25 || true
echo "-- E) public api --"; curl -sS -i "https://${HOST}/wolverine/traderone/api/health" | head -n 25 || true

say "6) nginx error tail"
tail -n 60 /var/log/nginx/error.log 2>/dev/null || true

echo
echo "DONE. LOG: $LOG"
BASH
chmod +x /root/WVT_FIX.sh
/root/WVT_FIX.sh'
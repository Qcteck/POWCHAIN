import fs from "node:fs";
import path from "node:path";

export function ensureDir(p: string) {
  fs.mkdirSync(p, { recursive: true });
}

export function fileSize(p: string): number {
  try {
    return fs.statSync(p).size;
  } catch {
    return 0;
  }
}

export type RotationInfo = {
  from: string;
  to: string;
  ts: string;
};

export function rotateBySize(filePath: string, maxBytes: number, keep: number): RotationInfo | null {
  if (!fs.existsSync(filePath)) return null;

  const sz = fileSize(filePath);
  if (sz < maxBytes) return null;

  const dir = path.dirname(filePath);
  const base = path.basename(filePath);
  const tsIso = new Date().toISOString();
  const ts = tsIso.replace(/[:.]/g, "-");

  const rotated = path.join(dir, `${base}.${ts}.log`);
  fs.renameSync(filePath, rotated);

  const files = fs
    .readdirSync(dir)
    .filter((f) => f.startsWith(base + ".") && f.endsWith(".log"))
    .map((f) => path.join(dir, f))
    .sort((a, b) => fs.statSync(b).mtimeMs - fs.statSync(a).mtimeMs);

  for (let i = keep; i < files.length; i++) {
    try {
      fs.unlinkSync(files[i]);
    } catch {}
  }

  return { from: filePath, to: rotated, ts: tsIso };
}

export function writeJsonAtomic(filePath: string, obj: any) {
  const dir = path.dirname(filePath);
  ensureDir(dir);
  const tmp = `${filePath}.tmp.${Date.now()}`;
  fs.writeFileSync(tmp, JSON.stringify(obj));
  fs.renameSync(tmp, filePath);
}

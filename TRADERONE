cat > /root/DIAG_AIAQUILA_VPS.sh <<'EOF'
#!/bin/bash
set -e

RED="\033[31m"; GREEN="\033[32m"; YELLOW="\033[33m"; NC="\033[0m"

echo "==============================="
echo " AIAQUILA VPS DIAGNOSTIC TOTAL "
echo "==============================="

FAIL=0

step(){ echo -e "\n${YELLOW}== $1 ==${NC}"; }
ok(){ echo -e "${GREEN}✔ $1${NC}"; }
ko(){ echo -e "${RED}✖ $1${NC}"; FAIL=1; }

# 1. DNS local
step "DNS local"
getent hosts google.com >/dev/null && ok "DNS OK" || ko "DNS FAIL"

# 2. Résolution workers.dev
step "DNS workers.dev"
getent hosts aiaquila-proxy.paycashnostory.workers.dev >/dev/null \
  && ok "workers.dev résout" \
  || ko "workers.dev NE RESOUT PAS"

# 3. HTTPS sortant
step "HTTPS sortant"
curl -s https://example.com >/dev/null \
  && ok "HTTPS sortant OK" \
  || ko "HTTPS sortant FAIL"

# 4. Worker direct /rss
step "Worker /rss direct"
HTTP_CODE=$(curl -s -o /tmp/worker.out -w "%{http_code}" https://aiaquila-proxy.paycashnostory.workers.dev/rss || true)
if [ "$HTTP_CODE" = "200" ]; then
  ok "Worker /rss HTTP 200"
else
  ko "Worker /rss HTTP $HTTP_CODE"
fi

# 5. Vérif JSON
step "JSON Worker"
if jq . /tmp/worker.out >/dev/null 2>&1; then
  ok "JSON valide"
else
  ko "JSON invalide ou vide"
fi

# 6. Nginx config
step "Nginx config"
nginx -t >/dev/null 2>&1 && ok "nginx -t OK" || ko "nginx -t FAIL"

# 7. Nginx service
step "Nginx service"
systemctl is-active nginx >/dev/null \
  && ok "nginx actif" \
  || ko "nginx INACTIF"

# 8. Site local
step "Site local /aiaquila/"
HTTP_SITE=$(curl -s -o /dev/null -w "%{http_code}" https://fireinners.online/aiaquila/ || true)
[ "$HTTP_SITE" = "200" ] && ok "Site /aiaquila OK" || ko "Site /aiaquila HTTP $HTTP_SITE"

# 9. Fetch depuis VPS (simulation navigateur)
step "Fetch RSS depuis VPS"
FETCH_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
  "https://aiaquila-proxy.paycashnostory.workers.dev/rss?url=https://news.bitcoin.com/feed/" || true)

[ "$FETCH_CODE" = "200" ] \
  && ok "Fetch RSS OK" \
  || ko "Fetch RSS HTTP $FETCH_CODE"

echo
echo "==============================="
if [ "$FAIL" = "0" ]; then
  echo -e "${GREEN}DIAGNOSTIC FINAL : TOUT FONCTIONNE CÔTÉ VPS${NC}"
else
  echo -e "${RED}DIAGNOSTIC FINAL : PROBLÈME DÉTECTÉ (voir ✖ ci-dessus)${NC}"
fi
echo "==============================="
EOF

chmod +x /root/DIAG_AIAQUILA_VPS.sh
/root/DIAG_AIAQUILA_VPS.sh
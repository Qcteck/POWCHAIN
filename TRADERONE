cat >/root/AIAQUILA_HOSTINGER_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

CONF="/etc/nginx/conf.d/aiaquila_api.conf"

echo "=== AIAQUILA HOSTINGER FIX (conf.d SAFE MODE) ==="

echo "[1/3] Writing conf.d server block"
cat >"$CONF" <<'NGX'
server {
    listen 443 ssl http2;
    server_name fireinners.online;

    location /aiaquila/api/rss {
        proxy_pass https://aiaquila-proxy.paycashnostory.workers.dev/rss;
        proxy_set_header Host aiaquila-proxy.paycashnostory.workers.dev;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }
}
NGX

echo "[2/3] Test nginx"
nginx -t

echo "[3/3] Reload nginx"
systemctl reload nginx

echo "DONE"
echo "TEST:"
echo "curl https://fireinners.online/aiaquila/api/rss?url=https://news.bitcoin.com/feed/"
BASH

chmod +x /root/AIAQUILA_HOSTINGER_FIX.sh
/root/AIAQUILA_HOSTINGER_FIX.sh
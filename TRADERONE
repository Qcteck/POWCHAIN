import fs from "node:fs";
import path from "node:path";
import process from "node:process";
import {
  Connection,
  Keypair,
  PublicKey,
  clusterApiUrl,
  LAMPORTS_PER_SOL,
} from "@solana/web3.js";
import {
  createMint,
  getAssociatedTokenAddress,
  getOrCreateAssociatedTokenAccount,
  mintTo,
  setAuthority,
  AuthorityType,
  getMint,
} from "@solana/spl-token";
import { classifySolanaError } from "./lib/solana_errors.js";
import { die, env, envBool, envInt, envOpt, log, withRetry } from "./lib/util.js";

type Result = {
  ok: boolean;
  rpc: string;
  payer: string;
  decimals?: number;
  supplyHuman?: string;
  mode?: "PREFLIGHT_ONLY" | "EXECUTE";
  mint?: string | null;
  owner?: string | null;
  ownerAta?: string | null;
  reused?: { mint: boolean; ata: boolean; };
  signatures?: { mintTo?: string | null; revokeMintAuth?: string | null; revokeFreezeAuth?: string | null; };
  error?: { code: string; message: string; } | null;
};

function loadKeypairFromFile(filePath: string): Keypair {
  const abs = path.resolve(filePath);
  if (!fs.existsSync(abs)) die(`Keypair file not found`, { path: abs });
  const raw = fs.readFileSync(abs, "utf8").trim();
  let arr: number[];
  try { arr = JSON.parse(raw); } catch { die(`Keypair must be JSON array of numbers`, { path: abs }); }
  return Keypair.fromSecretKey(Uint8Array.from(arr));
}

function assertDecimals(decimals: number) {
  if (!Number.isInteger(decimals) || decimals < 0 || decimals > 12) {
    die(`TOKEN_DECIMALS must be integer 0..12`, { decimals });
  }
}

function parseBigIntAmount(human: string, decimals: number): bigint {
  const s = human.trim();
  if (!/^\d+(\.\d+)?$/.test(s)) die(`Invalid TOKEN_SUPPLY`, { value: human });
  const [i, f = ""] = s.split(".");
  const frac = (f + "0".repeat(decimals)).slice(0, decimals);
  return BigInt(i + frac);
}

function printResultAndExit(res: Result, code = 0): never {
  console.log(JSON.stringify(res));
  process.exit(code);
}

async function main() {
  const rpc =
    process.env.SOLANA_RPC_URL ??
    clusterApiUrl((process.env.SOLANA_CLUSTER as any) ?? "mainnet-beta");

  const keypairPath = env("SOLANA_KEYPAIR");
  const payer = loadKeypairFromFile(keypairPath);
  const conn = new Connection(rpc, "confirmed");

  const decimals = envInt("TOKEN_DECIMALS", "6");
  assertDecimals(decimals);

  const supplyHuman = env("TOKEN_SUPPLY");
  const amount = parseBigIntAmount(supplyHuman, decimals);
  if (amount <= 0n) die(`TOKEN_SUPPLY must be > 0`, { supplyHuman });

  const preflightOnly = envBool("PREFLIGHT_ONLY", "false");
  const revokeMintAuth = envBool("REVOKE_MINT_AUTH", "false");
  const revokeFreezeAuth = envBool("REVOKE_FREEZE_AUTH", "true");

  const mintAddressOpt = envOpt("MINT_ADDRESS");
  const ownerOpt = envOpt("OWNER_ADDRESS");
  const ataAddressOpt = envOpt("ATA_ADDRESS");
  const reuseAtaIfExists = envBool("REUSE_ATA_IF_EXISTS", "true");

  const ownerPk = ownerOpt ? new PublicKey(ownerOpt) : payer.publicKey;

  const res: Result = {
    ok: false,
    rpc,
    payer: payer.publicKey.toBase58(),
    decimals,
    supplyHuman,
    mode: preflightOnly ? "PREFLIGHT_ONLY" : "EXECUTE",
    mint: null,
    owner: ownerPk.toBase58(),
    ownerAta: null,
    reused: { mint: false, ata: false },
    signatures: { mintTo: null, revokeMintAuth: null, revokeFreezeAuth: null },
    error: null,
  };

  try {
    log("info", "config", {
      rpc,
      payer: res.payer,
      owner: res.owner,
      decimals,
      supplyHuman,
      preflightOnly,
      mintAddressOpt,
      ataAddressOpt,
      reuseAtaIfExists,
      revokeMintAuth,
      revokeFreezeAuth,
    });

    const version = await withRetry(async () => conn.getVersion(), { retries: 5 });
    log("info", "rpc_ok", { version });

    const lamports = await withRetry(async () => conn.getBalance(payer.publicKey, "confirmed"), { retries: 5 });
    log("info", "payer_balance", { lamports, sol: lamports / LAMPORTS_PER_SOL });

    let mintPk: PublicKey;

    if (mintAddressOpt) {
      mintPk = new PublicKey(mintAddressOpt);
      res.mint = mintPk.toBase58();
      res.reused!.mint = true;
      log("info", "mint_reused", { mint: res.mint });

      const mintInfo = await withRetry(async () => getMint(conn, mintPk, "confirmed"), { retries: 4 });

      if (mintInfo.decimals !== decimals) {
        res.ok = false;
        res.error = {
          code: "DECIMALS_MISMATCH",
          message: `on-chain decimals=${mintInfo.decimals} != TOKEN_DECIMALS=${decimals}`,
        };
        log("error", "decimals_mismatch", {
          mint: res.mint,
          onChainDecimals: mintInfo.decimals,
          tokenDecimals: decimals,
        });
        return printResultAndExit(res, 1);
      }

      const payerStr = payer.publicKey.toBase58();
      const mintAuthStr = mintInfo.mintAuthority ? mintInfo.mintAuthority.toBase58() : null;
      const freezeAuthStr = mintInfo.freezeAuthority ? mintInfo.freezeAuthority.toBase58() : null;

      const reasons: string[] = [];

      if (!mintInfo.mintAuthority) {
        reasons.push("mintAuthority is null (cannot mint)");
      } else if (mintAuthStr !== payerStr) {
        reasons.push(`mintAuthority mismatch (on-chain=${mintAuthStr}, payer=${payerStr})`);
      }

      if (revokeFreezeAuth && mintInfo.freezeAuthority && freezeAuthStr !== payerStr) {
        reasons.push(`freezeAuthority mismatch (on-chain=${freezeAuthStr}, payer=${payerStr})`);
      }

      if (revokeMintAuth && mintAuthStr !== payerStr) {
        reasons.push(`cannot revoke mint authority (payer is not current mintAuthority)`);
      }

      if (reasons.length) {
        res.ok = false;
        res.error = { code: "AUTH_MISMATCH", message: reasons.join(" | ") };
        log("error", "auth_mismatch", {
          mint: res.mint,
          mintAuthority: mintAuthStr,
          freezeAuthority: freezeAuthStr,
          payer: payerStr,
          reasons,
        });
        return printResultAndExit(res, 1);
      }
    } else {
      if (preflightOnly) {
        res.ok = true;
        return printResultAndExit({ ...res, ok: true, error: null } as any, 0);
      }

      mintPk = await withRetry(
        async () => createMint(conn, payer, payer.publicKey, payer.publicKey, decimals),
        { retries: 4 }
      );
      res.mint = mintPk.toBase58();
      log("info", "mint_created", { mint: res.mint });
    }

    if (ataAddressOpt) {
      const ataPk = new PublicKey(ataAddressOpt);
      res.ownerAta = ataPk.toBase58();
      res.reused!.ata = true;
      log("info", "ata_reused", { ata: res.ownerAta });
    } else {
      const expectedAta = await getAssociatedTokenAddress(mintPk, ownerPk, false);
      res.ownerAta = expectedAta.toBase58();

      if (preflightOnly) {
        res.ok = true;
        return printResultAndExit({ ...res, ok: true, error: null } as any, 0);
      }

      const ata = await withRetry(
        async () => getOrCreateAssociatedTokenAccount(conn, payer, mintPk, ownerPk),
        { retries: 4 }
      );
      res.ownerAta = ata.address.toBase58();
      res.reused!.ata = reuseAtaIfExists;
      log("info", "ata_ready", { ata: res.ownerAta });
    }

    if (preflightOnly) {
      res.ok = true;
      return printResultAndExit(res, 0);
    }

    const sigMintTo = await withRetry(
      async () => mintTo(conn, payer, mintPk, new PublicKey(res.ownerAta!), payer, amount),
      {
        retries: 4,
        onRetry: (_a, _w, e) => {
          const c = classifySolanaError(e);
          log("warn", "mintTo_retry_classified", { code: c.code });
        },
      }
    );
    res.signatures!.mintTo = sigMintTo;
    log("info", "mint_to_ok", { signature: sigMintTo });

    if (revokeMintAuth) {
      const s = await withRetry(
        async () => setAuthority(conn, payer, mintPk, payer.publicKey, AuthorityType.MintTokens, null),
        { retries: 4 }
      );
      res.signatures!.revokeMintAuth = s;
      log("info", "mint_auth_revoked", { signature: s });
    }

    if (revokeFreezeAuth) {
      const s = await withRetry(
        async () => setAuthority(conn, payer, mintPk, payer.publicKey, AuthorityType.FreezeAccount, null),
        { retries: 4 }
      );
      res.signatures!.revokeFreezeAuth = s;
      log("info", "freeze_auth_revoked", { signature: s });
    }

    res.ok = true;
    res.error = null;
    return printResultAndExit(res, 0);
  } catch (e: any) {
    const c = classifySolanaError(e);
    res.ok = false;
    res.error = { code: c.code, message: c.message };
    log("error", "create_token_failed", { code: c.code, err: c.message });
    return printResultAndExit(res, 1);
  }
}

main().catch((e) => {
  die("fatal", { err: String((e as any)?.message ?? e) });
});

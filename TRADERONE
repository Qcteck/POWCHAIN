cat >/root/patch_phantom_static_html.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"

echo "[*] Searching /wolverine index.html ..."

# Cherche un index.html probable
CANDIDATES=()
while IFS= read -r f; do CANDIDATES+=("$f"); done < <(
  find /var/www /usr/share/nginx/html /srv/www /opt /home -type f -name "index.html" 2>/dev/null \
  | grep -E "/wolverine/|/wolverine$" || true
)

# Fallback: cherche n'importe quel index.html qui contient "Wolverine"
if [[ ${#CANDIDATES[@]} -eq 0 ]]; then
  while IFS= read -r f; do CANDIDATES+=("$f"); done < <(
    grep -RIl --include="index.html" "Wolverine" /var/www /usr/share/nginx/html /srv/www /opt /home 2>/dev/null | head -n 30 || true
  )
fi

if [[ ${#CANDIDATES[@]} -eq 0 ]]; then
  echo "[ERR] Impossible de trouver index.html pour /wolverine."
  echo "Donne-moi le path exact du fichier (ex: /var/www/wolverine/index.html)."
  exit 1
fi

# Choisit celui qui ressemble le plus à ta page (contient "Connect Phantom")
TARGET=""
for f in "${CANDIDATES[@]}"; do
  if grep -qi "Connect Phantom" "$f" 2>/dev/null; then TARGET="$f"; break; fi
done

# Sinon prend le 1er
[[ -n "$TARGET" ]] || TARGET="${CANDIDATES[0]}"

echo "[*] TARGET=$TARGET"

# Backup
ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$TARGET" "${TARGET}.bak_${ts}"
echo "[OK] Backup -> ${TARGET}.bak_${ts}"

# Déjà patché ?
if grep -q "PHANTOM_CONNECT_PATCH" "$TARGET"; then
  echo "[OK] Patch déjà présent."
  exit 0
fi

# Inject JS avant </body>
perl -0777 -i -pe '
my $js = qq{
<!-- PHANTOM_CONNECT_PATCH -->
<script>
(function(){
  function short(pk){ return pk.slice(0,4)+"…"+pk.slice(-4); }

  async function connectPhantom(){
    if(!window.solana || !window.solana.isPhantom){
      alert("Phantom introuvable (installe l’extension Phantom)");
      return;
    }
    const r = await window.solana.connect();
    const pk = r.publicKey.toBase58();

    const st = document.querySelector(".walletBox .muted") || document.getElementById("walletState");
    if(st) st.textContent = "Connected: " + short(pk);

    console.log("Phantom connected:", pk);
  }

  document.addEventListener("DOMContentLoaded", function(){
    const btn =
      document.querySelector(".walletBox .btn.ghost") ||
      Array.from(document.querySelectorAll("button")).find(b => /connect phantom/i.test(b.textContent||""));

    if(btn){
      btn.addEventListener("click", function(ev){
        ev.preventDefault();
        connectPhantom().catch(e => {
          console.error(e);
          alert(String(e?.message || e));
        });
      });
    }

    if(window.solana?.isPhantom && window.solana.publicKey){
      const pk = window.solana.publicKey.toBase58();
      const st = document.querySelector(".walletBox .muted") || document.getElementById("walletState");
      if(st) st.textContent = "Connected: " + short(pk);
    }

    window.solana?.on?.("accountChanged", function(pubkey){
      const st = document.querySelector(".walletBox .muted") || document.getElementById("walletState");
      if(st) st.textContent = pubkey ? ("Connected: " + short(pubkey.toBase58())) : "Not connected";
    });
  });
})();
</script>
<!-- /PHANTOM_CONNECT_PATCH -->
};
s@</body>@$js\n</body>@i or die "ERR: </body> introuvable\n";
' "$TARGET"

echo "[OK] JS injecté."

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
echo
echo "✅ Maintenant teste dans TON navigateur (avec l’extension Phantom):"
echo "   https://${DOMAIN}/wolverine/"
BASH

chmod +x /root/patch_phantom_static_html.sh
/root/patch_phantom_static_html.sh fireinners.online
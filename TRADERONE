bash <<'EOF'
set -e

echo "=== AIAQUILA — RSS FIX FINAL ==="

AIA=/var/www/aiaquila
mkdir -p $AIA

# -------- PROXY PHP ROBUSTE --------
cat > $AIA/proxy.php <<'PHP'
<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/xml; charset=UTF-8");

if(!isset($_GET["url"])) {
 http_response_code(400);
 exit;
}

$ch=curl_init($_GET["url"]);
curl_setopt_array($ch,[
 CURLOPT_RETURNTRANSFER=>true,
 CURLOPT_FOLLOWLOCATION=>true,
 CURLOPT_TIMEOUT=>15,
 CURLOPT_USERAGENT=>"AIAQUILA"
]);

$data=curl_exec($ch);
curl_close($ch);

if(!$data){
 http_response_code(502);
 exit;
}

echo $data;
PHP

# -------- FRONT HTML PARSING ROBUSTE --------
cat > $AIA/index.html <<'HTML'
<!doctype html>
<html lang="fr">
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{background:#0b1220;color:#e5e7eb;font-family:Arial;padding:20px}
button{padding:8px 12px}
.article{margin:6px 0;padding:6px;border-bottom:1px solid #333}
</style>

<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="load()">Lire les articles</button>
<div id="log"></div>
<div id="list"></div>

<script>
const feeds=[
 "https://www.coindesk.com/arc/outboundfeeds/rss/",
 "https://cointelegraph.com/rss",
 "https://news.bitcoin.com/feed/"
];

function log(t){document.getElementById("log").innerHTML+=t+"<br>";}

async function load(){
 document.getElementById("list").innerHTML="";
 log("Démarrage RSS…");
 let total=0;

 for(const url of feeds){
  try{
   const r=await fetch("proxy.php?url="+encodeURIComponent(url));
   const t=await r.text();
   const xml=new DOMParser().parseFromString(t,"text/xml");

   // RSS + Atom sans namespace issues
   const items=[
     ...xml.getElementsByTagName("item"),
     ...xml.getElementsByTagName("entry")
   ];

   log("Flux "+url+" → "+items.length+" articles");

   for(const it of items){
     const title=(it.getElementsByTagName("title")[0]?.textContent)||"Sans titre";
     const link=
       it.getElementsByTagName("link")[0]?.getAttribute("href") ||
       it.getElementsByTagName("link")[0]?.textContent || "#";

     const d=document.createElement("div");
     d.className="article";
     d.innerHTML="<a href='"+link+"' target=_blank>"+title+"</a>";
     document.getElementById("list").appendChild(d);
   }
   total+=items.length;
  }catch(e){
   log("Erreur "+url);
  }
 }
 log("TOTAL : "+total+" articles");
}
</script>
</html>
HTML

chown -R www-data:www-data $AIA
chmod 644 $AIA/*

echo "=== OK ==="
echo "Ouvre https://fireinners.online/aiaquila/"
echo "CTRL+F5 puis clique Lire les articles"
EOF
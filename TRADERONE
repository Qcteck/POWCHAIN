cat >/root/WOLV_FIND_REAL_API_PORT_AND_FIX_NGINX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== Restart wolverine-api ==="
systemctl restart wolverine-api.service || true
sleep 1

echo
echo "=== Status + last logs ==="
systemctl status wolverine-api.service --no-pager | head -n 25 || true
echo
journalctl -u wolverine-api.service -n 80 --no-pager || true
echo

echo "=== Try extract port from logs (API up on http://127.0.0.1:PORT) ==="
PORT_FROM_LOG="$(journalctl -u wolverine-api.service -n 200 --no-pager 2>/dev/null | \
  grep -Eo '127\.0\.0\.1:[0-9]{2,5}' | tail -n1 | sed -E 's/.*:([0-9]+)$/\1/' || true)"
echo "PORT_FROM_LOG=${PORT_FROM_LOG:-none}"

echo
echo "=== Scan localhost ports for /api ==="
API_PORT=""
CANDIDATES="$(ss -lptn 2>/dev/null | awk '/LISTEN/ {print $4}' | sed -E 's/.*:([0-9]+)$/\1/' | sort -nu || true)"
CANDIDATES="$PORT_FROM_LOG $CANDIDATES 3050 3002 3000 8080 8000 5000 4000 3001 3003"

for p in $CANDIDATES; do
  [ -n "${p:-}" ] || continue
  if curl -sS --max-time 1 "http://127.0.0.1:$p/api" >/dev/null 2>&1; then
    API_PORT="$p"; break
  fi
done

echo "API_PORT=${API_PORT:-NOT_FOUND}"
if [ -z "${API_PORT:-}" ]; then
  echo "ERR: aucun port ne répond à /api en local."
  echo "Montre-moi: ss -lptn | grep node"
  exit 1
fi

echo
echo "=== Test /api/swap/quote on the real port ==="
curl -sS --max-time 6 \
"http://127.0.0.1:$API_PORT/api/swap/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50" \
| head -c 220 || true
echo

echo
echo "=== Patch nginx: /api -> 127.0.0.1:$API_PORT ==="
NGINX_SITE=""
for f in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*; do
  [ -f "$f" ] || continue
  if grep -qi "server_name .*fireinners\.online" "$f"; then NGINX_SITE="$f"; break; fi
done

if [ -n "$NGINX_SITE" ]; then
  TS="$(date +%s)"
  mkdir -p /root/wolv_backups
  cp -a "$NGINX_SITE" "/root/wolv_backups/nginx_site.$TS.bak"

  if grep -q "location \^~ /api/" "$NGINX_SITE"; then
    sed -i -E "s#proxy_pass http://127\.0\.0\.1:[0-9]+/api/#proxy_pass http://127.0.0.1:$API_PORT/api/#g" "$NGINX_SITE"
  else
    perl -0777 -i -pe "s/(server\\s*\\{)/\$1\\n\\n    location ^~ \\/api\\/ {\\n        proxy_pass http:\\/\\/127.0.0.1:$API_PORT\\/api\\/;\\n        proxy_http_version 1.1;\\n        proxy_set_header Host \\$host;\\n        proxy_set_header X-Real-IP \\$remote_addr;\\n        proxy_set_header X-Forwarded-For \\$proxy_add_x_forwarded_for;\\n        proxy_set_header X-Forwarded-Proto \\$scheme;\\n    }\\n\\n/s" "$NGINX_SITE"
  fi

  nginx -t && systemctl reload nginx
  echo "nginx OK ✅ (proxy /api -> :$API_PORT)"
else
  echo "WARN: nginx vhost fireinners.online introuvable (skip)"
fi

echo
echo "DONE ✅ API_PORT=$API_PORT"
BASH

bash /root/WOLV_FIND_REAL_API_PORT_AND_FIX_NGINX.sh
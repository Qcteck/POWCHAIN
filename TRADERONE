cat >/root/WOLVERINE_VAULT_FRONTEND_ATTACH.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE — VAULT FRONTEND ATTACH (SAFE) ==="

FRONTEND="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$FRONTEND" || { echo "❌ index.html introuvable"; exit 1; }

echo "== 1) Backup frontend =="
cp "$FRONTEND" "$FRONTEND.bak_$TS"

echo "== 2) Vérifier injection déjà faite =="
if grep -q "VAULT_ONLY_BLOCK" "$FRONTEND"; then
  echo "⚠️ Bloc VAULT déjà présent — stop"
  exit 0
fi

echo "== 3) Injection bloc VAULT isolé =="
sed -i "s|</body>|

<!-- VAULT_ONLY_BLOCK -->
<div id=\"vaultBox\" style=\"margin:30px auto;max-width:420px;border:2px solid #00ff88;padding:15px;text-align:center\">
  <h3>Vault Trading</h3>
  <button id=\"vaultCreate\" style=\"width:100%;padding:10px\">Créer mon vault</button>
  <pre id=\"vaultOut\" style=\"margin-top:10px;text-align:left\"></pre>
</div>

<script>
window.VAULT_ONLY={
  id:null,
  async create(){
    const r=await fetch('/wolverine/vault/vault/create',{method:'POST'});
    const j=await r.json();
    if(!j.ok) return this.log(j);
    this.id=j.vault.id;
    localStorage.setItem('VAULT_ID',this.id);
    this.log(j);
  },
  async status(){
    if(!this.id) return;
    const r=await fetch('/wolverine/vault/vault/status/'+this.id);
    const j=await r.json();
    this.log(j);
  },
  log(o){
    document.getElementById('vaultOut').textContent=JSON.stringify(o,null,2);
  }
};

document.getElementById('vaultCreate').onclick=()=>{
  VAULT_ONLY.create();
};

const saved=localStorage.getItem('VAULT_ID');
if(saved){
  VAULT_ONLY.id=saved;
  VAULT_ONLY.status();
}
</script>
<!-- END_VAULT_ONLY_BLOCK -->

</body>|" "$FRONTEND"

echo "== 4) Reload nginx =="
nginx -t && systemctl reload nginx

echo "=== OK — VAULT BRANCHÉ SANS CASSER LE FRONTEND ==="
BASH

chmod +x /root/WOLVERINE_VAULT_FRONTEND_ATTACH.sh
/root/WOLVERINE_VAULT_FRONTEND_ATTACH.sh
bash <<'EOF'
set -euo pipefail

### CONFIG
APP="aiaquila"
WEB="/var/www/${APP}"
BACKUP="/var/backups/${APP}"
TS="$(date +%Y%m%d_%H%M%S)"
HTML="${WEB}/index.html"
SHA="${WEB}/index.html.sha256"

echo "== AIAQUILA 1-2-3-4-5 DEPLOY =="

### 1. PREP
mkdir -p "$WEB" "$BACKUP"

if [ -f "$HTML" ]; then
  echo "[+] Backup existant"
  cp "$HTML" "$BACKUP/index_${TS}.html"
  sha256sum "$HTML" > "$BACKUP/index_${TS}.sha256"
fi

### 2. DEPLOIEMENT HTML/JS COMPLET
cat > "$HTML" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
body{margin:0;background:#05070a;color:#e6e6e6;font-family:system-ui}
header{padding:12px 20px;background:#0b0f1a;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{max-width:1200px;margin:auto;padding:20px}
.panel{background:#0e1424;border:1px solid #1f2937;border-radius:8px;padding:12px;margin-bottom:12px}
h2{margin:0 0 8px 0;font-size:16px;color:#9cc9ff}
pre{background:#000;padding:10px;border-radius:6px;max-height:200px;overflow:auto}
input,button{background:#000;color:#fff;border:1px solid #333;padding:6px}
.timeline{font-size:13px}
.badge{font-size:12px;color:#9cc9ff}
</style>
</head>
<body>

<header>
  <strong>AIAQUILA</strong>
  <span id="score">Score: --</span>
</header>

<main>

<div class="panel">
<h2>Journaliste IA</h2>
<div id="speech"></div>
</div>

<div class="panel">
<h2>Objectifs</h2>
<input id="goalInput" placeholder="Nouvel objectif">
<button onclick="addGoal()">Ajouter</button>
<ul id="goals"></ul>
</div>

<div class="panel">
<h2>Timeline</h2>
<div id="timeline" class="timeline"></div>
</div>

<div class="panel">
<h2>Score décisionnel</h2>
<pre id="decision"></pre>
</div>

<div class="panel">
<h2>Logs</h2>
<pre id="logs"></pre>
</div>

<div class="panel">
<h2>Debug</h2>
<pre id="debug"></pre>
</div>

</main>

<script>
/* === ETAT GLOBAL === */
const STATE_KEY="aiaquila_state_v1";
let S = JSON.parse(localStorage.getItem(STATE_KEY)) || {
  created:Date.now(),
  score:50,
  goals:[],
  timeline:[],
  logs:[]
};

function save(){
  localStorage.setItem(STATE_KEY,JSON.stringify(S));
}

/* === LOGGING === */
function log(msg){
  const t=new Date().toISOString();
  S.logs.push(`[${t}] ${msg}`);
  S.logs=S.logs.slice(-200);
  S.timeline.push(msg);
  save();
  render();
}

/* === OBJECTIFS === */
function addGoal(){
  const v=document.getElementById("goalInput").value.trim();
  if(!v) return;
  S.goals.push({text:v,done:false});
  log("Objectif ajouté: "+v);
  document.getElementById("goalInput").value="";
}

/* === RAISONNEMENT / SCORE === */
function computeScore(){
  let base=50;
  base+=S.goals.length*5;
  base=Math.min(100,base);
  S.score=base;
}

/* === UI === */
function render(){
  computeScore();
  document.getElementById("score").textContent="Score: "+S.score;

  document.getElementById("goals").innerHTML=
    S.goals.map(g=>"<li>"+g.text+"</li>").join("");

  document.getElementById("timeline").innerHTML=
    S.timeline.slice(-20).map(x=>"• "+x).join("<br>");

  document.getElementById("logs").textContent=S.logs.join("\n");

  document.getElementById("decision").textContent=
    "Score global: "+S.score+"\nObjectifs actifs: "+S.goals.length;

  document.getElementById("debug").textContent=
    JSON.stringify(S,null,2);
}

/* === INIT === */
log("Initialisation AIAQUILA");
render();
</script>

</body>
</html>
HTML

### 3. CHECKSUM
sha256sum "$HTML" > "$SHA"

### 4. PERMISSIONS
chown -R www-data:www-data "$WEB"
chmod 644 "$HTML" "$SHA"

### 5. NGINX
nginx -t
systemctl reload nginx

echo "==============================="
echo "AIAQUILA 1-2-3-4-5 ACTIF"
echo "URL: https://fireinners.online/aiaquila/"
echo "==============================="
EOF
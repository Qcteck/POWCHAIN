curl -I -sS "https://fireinners.online/wolverine/" | head -n 5 || true
curl -sS "https://fireinners.online/wolverine/" | head -n 2 || true

echo
echo "DONE"
echo "OPEN: https://fireinners.online/wolverine/ (Ctrl+F5)"
EOF


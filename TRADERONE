bash <<'EOF'
set -e

echo "=== AIAQUILA PHP EXECUTION FIX ==="

NGCONF="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/var/www/aiaquila"

# 1. Vérifs
if [ ! -f "$NGCONF" ]; then
  echo "❌ VHOST introuvable"
  exit 1
fi

# 2. Sauvegarde
cp "$NGCONF" "$NGCONF.bak.$(date +%s)"

# 3. Forcer root correct
sed -i 's|root .*;|root /var/www;|g' "$NGCONF"

# 4. Injecter bloc PHP CORRECT
if ! grep -q "location ~ \\\\.php" "$NGCONF"; then
cat >> "$NGCONF" <<'NGINX'

location ~ \.php$ {
    include snippets/fastcgi-php.conf;
    fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    include fastcgi_params;
}
NGINX
fi

# 5. Permissions
chown -R www-data:www-data /var/www
chmod -R 755 /var/www

# 6. Restart services
systemctl restart php8.3-fpm || systemctl restart php8.2-fpm
nginx -t
systemctl reload nginx

# 7. TEST HTTP (CRUCIAL)
echo
echo "=== TEST HTTP rss.php ==="
curl -s "https://fireinners.online/aiaquila/rss.php?url=https://news.bitcoin.com/feed/" | head -c 200
echo
echo "=== FIN ==="
EOF
# 1) Trouver tous les index wolverine existants
find /var/www -maxdepth 4 -type f -name index.html -path '*wolverine*' -print -exec head -n 3 {} \;

# 2) Voir la config nginx qui sert /wolverine
nginx -T 2>/dev/null | sed -n '/server_name fireinners\.online/,/}/p' | sed -n '/location \/wolverine/,/}/p'
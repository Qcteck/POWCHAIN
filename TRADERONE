cat >/root/WOLVERINE_TEST.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOM="fireinners.online"
IPV4="72.61.79.12"
API_PORT="3000"
ROOT_WOLV="/var/www/wolverine"
INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/WOLVERINE_TEST_${TS}.log"

exec > >(tee -a "$LOG") 2>&1

echo "=== WOLVERINE_TEST :: $TS ==="
echo "DOM=$DOM  IPV4=$IPV4  API_PORT=$API_PORT"
echo "ROOT_WOLV=$ROOT_WOLV"
echo "INC=$INC"
echo "VHOST=$VHOST"
echo "LOG=$LOG"
echo

need(){ command -v "$1" >/dev/null 2>&1 || { echo "MISSING: $1"; exit 1; }; }
need bash; need curl; need ss; need nginx; need sed; need grep; need awk; need head; need tail || true

echo "== 1) LISTEN ports (80/443/3000) =="
ss -lntp | egrep '(:80|:443|:3000)\b' || true
echo

echo "== 2) BACKEND direct (must be JSON) =="
curl -sS -i "http://127.0.0.1:${API_PORT}/health" | head -n 40 || true
echo

echo "== 3) NGINX config quick proof (vhost + include + routes) =="
test -f "$VHOST" && { echo "-- VHOST exists: $VHOST"; } || { echo "-- VHOST MISSING: $VHOST"; }
test -f "$INC" && { echo "-- INC exists: $INC"; } || { echo "-- INC MISSING: $INC"; }
echo
echo "-- nginx -T grep (wolverine/traderone/api) --"
nginx -T 2>/dev/null | grep -nE 'wolverine|traderone/api|proxy_pass|includes/wolverine_routes\.inc' | head -n 220 || true
echo

echo "== 4) FILES proof (/var/www/wolverine) =="
ls -la "$ROOT_WOLV" 2>/dev/null | head -n 80 || true
test -f "$ROOT_WOLV/index.html" && echo "-- index.html OK" || echo "-- index.html MISSING"
test -f "$ROOT_WOLV/_wolverine_ok.txt" && echo "-- _wolverine_ok.txt OK" || echo "-- _wolverine_ok.txt MISSING"
echo

echo "== 5) PUBLIC test (real) : https://$DOM/wolverine/_wolverine_ok.txt =="
curl -sS -i "https://$DOM/wolverine/_wolverine_ok.txt" | head -n 40 || true
echo

echo "== 6) PUBLIC API test : https://$DOM/wolverine/traderone/api/health =="
curl -sS -i "https://$DOM/wolverine/traderone/api/health" | head -n 60 || true
echo

echo "== 7) FORCED HOST on IPV4 (bypass DNS/CF) : https://$IPV4/... Host:$DOM =="
curl -sS -i -k "https://$IPV4/wolverine/_wolverine_ok.txt" -H "Host: $DOM" | head -n 40 || true
echo
curl -sS -i -k "https://$IPV4/wolverine/traderone/api/health" -H "Host: $DOM" | head -n 60 || true
echo

echo "== 8) LOCAL NGINX request via loopback but correct Host (best local) =="
curl -sS -i -k "https://127.0.0.1/wolverine/_wolverine_ok.txt" -H "Host: $DOM" | head -n 40 || true
echo
curl -sS -i -k "https://127.0.0.1/wolverine/traderone/api/health" -H "Host: $DOM" | head -n 60 || true
echo

echo "== 9) If any 500/502/404, show nginx errors tail =="
tail -n 200 /var/log/nginx/error.log 2>/dev/null || true
echo

echo "== DONE :: log=$LOG =="
BASH
chmod +x /root/WOLVERINE_TEST.sh
/root/WOLVERINE_TEST.sh
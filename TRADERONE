set -euo pipefail

echo "=== 1) Où sont les server_name fireinners.online ? ==="
grep -RIn --line-number -E 'server_name\s+(fireinners\.online|www\.fireinners\.online)\b' \
  /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | head -n 200
echo

echo "=== 2) Où sont les listen 443 ? ==="
grep -RIn --line-number -E 'listen\s+443\b' \
  /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | head -n 200
echo

echo "=== 3) Garder uniquement le bon vhost et déplacer les autres ==="
mkdir -p /etc/nginx/sites-disabled
TS=$(date +%s)

# Déplace tout fichier qui contient server_name fireinners.online/www.fireinners.online
# SAUF le fichier principal que tu veux garder (ajuste le nom si besoin)
KEEP="fireinners.online-ssl"

while IFS= read -r f; do
  [ -f "$f" ] || continue
  base="$(basename "$f")"
  if [ "$base" != "$KEEP" ]; then
    echo "MOVE DUP: $f -> /etc/nginx/sites-disabled/$base.$TS"
    mv "$f" "/etc/nginx/sites-disabled/$base.$TS"
  else
    echo "KEEP: $f"
  fi
done < <(grep -RIl -E 'server_name\s+(fireinners\.online|www\.fireinners\.online)\b' \
  /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | sort -u)

echo
echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx
echo "OK"
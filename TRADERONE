#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA — FIX PHP EXECUTION ==="

# 1. Installer PHP + curl si nécessaire
apt update
apt install -y php php-fpm php-curl

# 2. Trouver le socket PHP-FPM réel
PHP_SOCK=$(ls /run/php/php*-fpm.sock | head -n1)
echo "PHP socket détecté: $PHP_SOCK"

# 3. Vhost utilisé
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

if [ ! -f "$VHOST" ]; then
  echo "❌ Vhost introuvable: $VHOST"
  exit 1
fi

# Backup
cp "$VHOST" "$VHOST.backup_$(date +%Y%m%d_%H%M%S)"

# 4. Injecter le handler PHP s'il n'existe pas
if ! grep -q "fastcgi_pass.*php" "$VHOST"; then
  echo "Injection bloc PHP dans nginx…"

  sed -i '/location \//a \
    location ~ \\.php$ {\
        include snippets/fastcgi-php.conf;\
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;\
        fastcgi_pass unix:'"$PHP_SOCK"';\
    }\
' "$VHOST"
else
  echo "Bloc PHP déjà présent"
fi

# 5. Redémarrage services
systemctl restart php*-fpm
nginx -t
systemctl reload nginx

# 6. Permissions
chown -R www-data:www-data /var/www/aiaquila
find /var/www/aiaquila -type f -name "*.php" -exec chmod 644 {} \;

# 7. TEST AUTOMATIQUE
TEST_URL="https://fireinners.online/aiaquila/rss-proxy.php?url=https://www.coindesk.com/arc/outboundfeeds/rss/"
echo ""
echo "=== TEST PROXY ==="
curl -I "$TEST_URL" || true
echo ""
curl -s "$TEST_URL" | head -n 5

echo ""
echo "=== FIN ==="
echo "Si tu vois du XML (<rss>…), C’EST RÉGLÉ."
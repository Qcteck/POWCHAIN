cat >/root/WOLVERINE_SOLANA_PROXY_FIX_ALL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/wolverine/solana-proxy"
PORT=3010
SERVICE="wolverine-solana-proxy"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

echo "=== INSTALL SOLANA PROXY + NGINX ROUTE ==="

# 1) Dossier
mkdir -p "$APP_DIR"
cd "$APP_DIR"

# 2) package.json
cat > package.json <<'JSON'
{
  "name": "wolverine-solana-proxy",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "express": "^4.19.2",
    "node-fetch": "^3.3.2"
  }
}
JSON

# 3) serveur proxy
cat > server.js <<'JS'
import express from "express";
import fetch from "node-fetch";

const app = express();
app.use(express.json());

const RPC = "https://api.mainnet-beta.solana.com";

app.post("/rpc/solana", async (req, res) => {
  try {
    const r = await fetch(RPC, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(req.body)
    });
    const j = await r.json();
    res.json(j);
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

app.listen(3010, () => console.log("Solana proxy running on 3010"));
JS

# 4) Install deps
npm install --silent

# 5) systemd service
cat >/etc/systemd/system/$SERVICE.service <<EOF
[Unit]
Description=Wolverine Solana RPC Proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=$APP_DIR
ExecStart=/usr/bin/node server.js
Restart=always
User=root
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
EOF

# 6) Activer service
systemctl daemon-reload
systemctl enable --now $SERVICE

# 7) Ajouter route nginx SI absente
if ! grep -q "location /rpc/solana" "$VHOST"; then
cat >>"$VHOST" <<'NGINX'

    location /rpc/solana {
        proxy_pass http://127.0.0.1:3010/rpc/solana;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
NGINX
fi

# 8) Reload nginx
nginx -t
systemctl reload nginx

# 9) Vérifications
echo
echo "=== CHECKS ==="
systemctl status $SERVICE --no-pager | head -n 6
ss -ltnp | grep ":$PORT" || true
curl -s -X POST http://127.0.0.1:$PORT/rpc/solana \
  -H "Content-Type: application/json" \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}'
echo
echo "=== DONE ==="
BASH

chmod +x /root/WOLVERINE_SOLANA_PROXY_FIX_ALL.sh
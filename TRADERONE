cat >/tmp/WOLVERINE_FIX_NGINX_PROXY_TRADERONE_API.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
TS="$(date +%s)"

# essaie de trouver le bon vhost
CONF="$(nginx -T 2>/dev/null | awk '
  $0 ~ /server_name/ && $0 ~ /fireinners\.online/ {in=1}
  in && $0 ~ /include \/etc\/nginx\/sites-enabled\// {gsub(";","",$2); print $2; exit}
' || true)"

# fallback classique
[ -n "${CONF:-}" ] || CONF="/etc/nginx/sites-available/fireinners.online"

echo "Using CONF=$CONF"
[ -f "$CONF" ] || { echo "ERROR: conf not found: $CONF"; exit 1; }

cp -a "$CONF" "$CONF.bak.$TS"

# Injecte un bloc PROXY bien spécifique dans le server { } du bon domaine
awk -v domain="$DOMAIN" '
BEGIN{in_server=0; has_domain=0; inserted=0}
{
  line=$0

  if ($0 ~ /^[[:space:]]*server[[:space:]]*\{/){ in_server=1; has_domain=0 }
  if (in_server && $0 ~ /server_name/ && $0 ~ domain){ has_domain=1 }

  # avant la fin du server{} cible, on injecte si pas déjà présent
  if (in_server && has_domain && $0 ~ /^[[:space:]]*\}[[:space:]]*$/ && inserted==0){
    print ""
    print "  # WOLVERINE_TRADERONE_API_BEGIN"
    print "  # Proxy /wolverine/traderone/api/*  ->  http://127.0.0.1:8585/api/*"
    print "  location ^~ /wolverine/traderone/api/ {"
    print "    proxy_http_version 1.1;"
    print "    proxy_set_header Host $host;"
    print "    proxy_set_header X-Real-IP $remote_addr;"
    print "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
    print "    proxy_set_header X-Forwarded-Proto $scheme;"
    print "    proxy_pass http://127.0.0.1:8585/api/;"
    print "  }"
    print "  # WOLVERINE_TRADERONE_API_END"
    print ""
    inserted=1
  }

  print line

  if (in_server && $0 ~ /^[[:space:]]*\}[[:space:]]*$/){ in_server=0 }
}
' "$CONF.bak.$TS" > "$CONF"

nginx -t
systemctl reload nginx

echo
echo "== TEST: should be JSON (NOT HTML) =="
read -r -p "PHANTOM WALLET = " WALLET
WALLET="$(echo -n "$WALLET" | tr -d '[:space:]')"

echo "-- headers:"
curl -ksSI "https://${DOMAIN}/wolverine/traderone/api/balances2?wallet=$WALLET" | sed -n '1,25p'
echo
echo "-- first bytes:"
curl -ksS "https://${DOMAIN}/wolverine/traderone/api/balances2?wallet=$WALLET" | head -c 120; echo
echo
echo "DONE ✅"
SH

bash /tmp/WOLVERINE_FIX_NGINX_PROXY_TRADERONE_API.sh
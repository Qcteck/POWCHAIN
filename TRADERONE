cat >"$API_DIR/server.js" <<'JS'
import fs from "node:fs";
import path from "node:path";
import process from "node:process";
import express from "express";
import { Connection, Keypair, PublicKey, clusterApiUrl } from "@solana/web3.js";
import { createMint, getAssociatedTokenAddress, getOrCreateAssociatedTokenAccount, mintTo, setAuthority, AuthorityType, getMint } from "@solana/spl-token";

const APP_HOST = process.env.HOST || "127.0.0.1";
const APP_PORT = parseInt(process.env.PORT || "9797", 10);
const DATA_DIR = process.env.DATA_DIR || "/opt/bundler_data";
const API_KEY = (process.env.BUNDLER_API_KEY || "").trim();
const KEYPAIR_PATH = process.env.SOLANA_KEYPAIR || "/opt/bundler_api/keypair.json";
const DEFAULT_RPC = process.env.SOLANA_RPC_URL || clusterApiUrl(process.env.SOLANA_CLUSTER || "mainnet-beta");

function iso(){ return new Date().toISOString(); }
function j(o){ return JSON.stringify(o); }
function safeJson(x){ try{ return JSON.parse(x); }catch{ return null; } }
function loadKeypair(p){
  const raw = fs.readFileSync(p,"utf8").trim();
  const arr = safeJson(raw);
  if(!Array.isArray(arr)) throw new Error("KEYPAIR_INVALID_JSON");
  const u8 = Uint8Array.from(arr);
  return Keypair.fromSecretKey(u8);
}
function hasAny(m, needles){
  const s = String(m||"").toLowerCase();
  return needles.some(n => s.includes(String(n).toLowerCase()));
}
function classify(e){
  const msg = String(e?.message ?? e ?? "unknown error");
  if (hasAny(msg, ["http 429","429 too many requests","too many requests"])) return {code:"RPC_429",retriable:true,message:msg};
  if (hasAny(msg, ["rate limit","ratelimit","request limit"])) return {code:"RATE_LIMIT",retriable:true,message:msg};
  if (hasAny(msg, ["blockhash not found"])) return {code:"BLOCKHASH_NOT_FOUND",retriable:true,message:msg};
  if (hasAny(msg, ["account in use","already in use","resource is busy","lock"])) return {code:"ACCOUNT_IN_USE",retriable:true,message:msg};
  if (hasAny(msg, ["simulation failed","transaction simulation failed","custom program error"])) return {code:"SIMULATION_FAILED",retriable:false,message:msg};
  if (hasAny(msg, ["insufficient funds","insufficient lamports","insufficient balance"])) return {code:"INSUFFICIENT_FUNDS",retriable:false,message:msg};
  if (hasAny(msg, ["timeout","timed out","etimedout"])) return {code:"TIMEOUT",retriable:true,message:msg};
  if (hasAny(msg, ["network","fetch failed","econnreset","aborterror"])) return {code:"NETWORK",retriable:true,message:msg};
  return {code:"UNKNOWN",retriable:false,message:msg};
}
async function withRetry(fn,{retries=4,base=350,max=4000}={}){
  let last;
  for(let i=0;i<=retries;i++){
    try{ return await fn(); }catch(e){ last=e;
      const c=classify(e);
      if(i===retries || !c.retriable) throw e;
      const w=Math.min(max, base*(2**i)) + Math.floor(Math.random()*200);
      await new Promise(r=>setTimeout(r,w));
    }
  }
  throw last;
}
function assertDecimals(d){
  if(!Number.isInteger(d) || d<0 || d>12) throw new Error("TOKEN_DECIMALS_INVALID");
}
function parseAmount(human,decimals){
  const s=String(human||"").trim();
  if(!/^\d+(\.\d+)?$/.test(s)) throw new Error("TOKEN_SUPPLY_INVALID");
  const parts=s.split(".");
  const i=parts[0];
  const f=(parts[1]||"");
  const frac=(f+"0".repeat(decimals)).slice(0,decimals);
  return BigInt(i+frac);
}
function ndjsonWrite(obj){
  try{
    fs.mkdirSync(DATA_DIR,{recursive:true});
    fs.appendFileSync(path.join(DATA_DIR,"api.ndjson"), j(obj)+"\n");
  }catch{}
}

const app = express();
app.disable("x-powered-by");
app.use(express.json({limit:"1mb"}));

app.get("/health",(req,res)=>res.json({ok:true,ts:iso()}));

app.post("/create-token", async (req,res)=>{
  const started = Date.now();
  const headerKey = String(req.headers["x-api-key"]||"").trim();
  const bodyKey = String(req.body?.apiKey||"").trim();
  if(!API_KEY || (headerKey!==API_KEY && bodyKey!==API_KEY)){
    return res.status(401).json({ok:false,error:{code:"UNAUTHORIZED",message:"bad api key"}});
  }

  const rpc = String(req.body?.rpc||DEFAULT_RPC).trim();
  const decimals = parseInt(String(req.body?.decimals ?? "6"),10);
  const supplyHuman = String(req.body?.supply ?? "0").trim();
  const ownerOpt = String(req.body?.owner||"").trim();
  const mintOpt = String(req.body?.mint||"").trim();
  const preflightOnly = !!req.body?.preflightOnly;
  const revokeMintAuth = !!req.body?.revokeMintAuth;
  const revokeFreezeAuth = !!req.body?.revokeFreezeAuth;

  const out = {ok:false,rpc,decimals,supplyHuman,mode:preflightOnly?"PREFLIGHT_ONLY":"EXECUTE",mint:null,owner:ownerOpt||null,ownerAta:null,reused:{mint:false,ata:false},signatures:{mintTo:null,revokeMintAuth:null,revokeFreezeAuth:null},error:null,ms:0};

  try{
    assertDecimals(decimals);
    const amount = parseAmount(supplyHuman, decimals);
    if(amount<=0n) throw new Error("TOKEN_SUPPLY_ZERO");

    const payer = loadKeypair(KEYPAIR_PATH);
    const payerStr = payer.publicKey.toBase58();

    const ownerPk = ownerOpt ? new PublicKey(ownerOpt) : payer.publicKey;
    out.owner = ownerPk.toBase58();

    const conn = new Connection(rpc,"confirmed");

    await withRetry(()=>conn.getVersion(),{retries:5});
    await withRetry(()=>conn.getBalance(payer.publicKey,"confirmed"),{retries:5});

    let mintPk;

    if(mintOpt){
      mintPk = new PublicKey(mintOpt);
      out.mint = mintPk.toBase58();
      out.reused.mint = true;

      const mintInfo = await withRetry(()=>getMint(conn,mintPk,"confirmed"),{retries:4});

      if(mintInfo.decimals !== decimals){
        out.error = {code:"DECIMALS_MISMATCH",message:`on-chain decimals=${mintInfo.decimals} != TOKEN_DECIMALS=${decimals}`};
        out.ms = Date.now()-started;
        ndjsonWrite({ts:iso(),type:"create_token",ok:false,error:out.error,mint:out.mint});
        return res.status(400).json(out);
      }

      const mintAuthStr = mintInfo.mintAuthority ? mintInfo.mintAuthority.toBase58() : null;
      const freezeAuthStr = mintInfo.freezeAuthority ? mintInfo.freezeAuthority.toBase58() : null;

      const reasons=[];
      if(!mintInfo.mintAuthority) reasons.push("mintAuthority is null (cannot mint)");
      else if(mintAuthStr !== payerStr) reasons.push(`mintAuthority mismatch (on-chain=${mintAuthStr}, payer=${payerStr})`);

      if(revokeFreezeAuth && mintInfo.freezeAuthority && freezeAuthStr !== payerStr){
        reasons.push(`freezeAuthority mismatch (on-chain=${freezeAuthStr}, payer=${payerStr})`);
      }
      if(revokeMintAuth && mintAuthStr !== payerStr){
        reasons.push("cannot revoke mint authority (payer is not current mintAuthority)");
      }
      if(reasons.length){
        out.error = {code:"AUTH_MISMATCH",message:reasons.join(" | ")};
        out.ms = Date.now()-started;
        ndjsonWrite({ts:iso(),type:"create_token",ok:false,error:out.error,mint:out.mint});
        return res.status(400).json(out);
      }
    } else {
      if(preflightOnly){
        out.ok = true;
        out.ms = Date.now()-started;
        ndjsonWrite({ts:iso(),type:"create_token",ok:true,mode:"PREFLIGHT_ONLY"});
        return res.json(out);
      }
      mintPk = await withRetry(()=>createMint(conn,payer,payer.publicKey,payer.publicKey,decimals),{retries:4});
      out.mint = mintPk.toBase58();
    }

    const expectedAta = await getAssociatedTokenAddress(mintPk, ownerPk, false);
    out.ownerAta = expectedAta.toBase58();

    if(preflightOnly){
      out.ok = true;
      out.ms = Date.now()-started;
      ndjsonWrite({ts:iso(),type:"create_token",ok:true,mode:"PREFLIGHT_ONLY",mint:out.mint});
      return res.json(out);
    }

    const ata = await withRetry(()=>getOrCreateAssociatedTokenAccount(conn,payer,mintPk,ownerPk),{retries:4});
    out.ownerAta = ata.address.toBase58();
    out.reused.ata = true;

    const sigMintTo = await withRetry(()=>mintTo(conn,payer,mintPk,ata.address,payer,amount),{retries:4});
    out.signatures.mintTo = sigMintTo;

    if(revokeMintAuth){
      const s = await withRetry(()=>setAuthority(conn,payer,mintPk,payer.publicKey,AuthorityType.MintTokens,null),{retries:4});
      out.signatures.revokeMintAuth = s;
    }
    if(revokeFreezeAuth){
      const s = await withRetry(()=>setAuthority(conn,payer,mintPk,payer.publicKey,AuthorityType.FreezeAccount,null),{retries:4});
      out.signatures.revokeFreezeAuth = s;
    }

    out.ok = true;
    out.ms = Date.now()-started;
    ndjsonWrite({ts:iso(),type:"create_token",ok:true,mint:out.mint,owner:out.owner,ms:out.ms});
    return res.json(out);

  }catch(e){
    const c=classify(e);
    out.error = {code:c.code,message:c.message};
    out.ms = Date.now()-started;
    ndjsonWrite({ts:iso(),type:"create_token",ok:false,error:out.error,ms:out.ms});
    return res.status(500).json(out);
  }
});

app.listen(APP_PORT, APP_HOST, ()=> {
  ndjsonWrite({ts:iso(),type:"api_start",host:APP_HOST,port:APP_PORT});
  console.log(j({ok:true,ts:iso(),host:APP_HOST,port:APP_PORT,dataDir:DATA_DIR}));
});

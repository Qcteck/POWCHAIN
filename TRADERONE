cat >/root/AUDIT_TRADERONE_USDC.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/var/www/html/wolverine/traderone"
REPORT="/root/TRADERONE_USDC_REPORT_$(date +%Y%m%d_%H%M%S).txt"

echo "================ TRADERONE USDC AUDIT ================" | tee "$REPORT"
echo "Root analysé : $ROOT" | tee -a "$REPORT"
echo "Date        : $(date)" | tee -a "$REPORT"
echo "======================================================" | tee -a "$REPORT"
echo "" | tee -a "$REPORT"

if [ ! -d "$ROOT" ]; then
  echo "❌ ERREUR : le dossier $ROOT n'existe pas." | tee -a "$REPORT"
  exit 1
fi

echo "✅ Dossier TraderOne trouvé." | tee -a "$REPORT"
echo "" | tee -a "$REPORT"

echo "---- 1) Recherche USDC (string brute) ----" | tee -a "$REPORT"
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  -E "USDC|usdc|EPjFWdd5|usd-coin" "$ROOT" \
  | tee -a "$REPORT" || echo "Aucune référence USDC trouvée." | tee -a "$REPORT"

echo "" | tee -a "$REPORT"
echo "---- 2) Recherche mint USDC Solana officiel ----" | tee -a "$REPORT"
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1" "$ROOT" \
  | tee -a "$REPORT" || echo "Mint USDC officiel NON trouvé." | tee -a "$REPORT"

echo "" | tee -a "$REPORT"
echo "---- 3) Recherche logique de stratégie / quote ----" | tee -a "$REPORT"
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  -E "quote|swap|baseMint|inputMint|outputMint|pair|stable|dollar" "$ROOT" \
  | tee -a "$REPORT" || echo "Aucune logique liée à USDC détectée." | tee -a "$REPORT"

echo "" | tee -a "$REPORT"
echo "---- 4) Recherche balances SPL ----" | tee -a "$REPORT"
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  -E "getParsedTokenAccountsByOwner|getTokenAccount|spl-token|TokenAmount" "$ROOT" \
  | tee -a "$REPORT" || echo "Aucune lecture SPL détectée." | tee -a "$REPORT"

echo "" | tee -a "$REPORT"
echo "---- 5) Résumé automatique ----" | tee -a "$REPORT"

if grep -q "EPjFWdd5" "$REPORT"; then
  echo "✅ USDC EST référencé dans TraderOne." | tee -a "$REPORT"
else
  echo "❌ USDC N'EST PAS utilisé dans TraderOne." | tee -a "$REPORT"
fi

echo "" | tee -a "$REPORT"
echo "📄 Rapport complet : $REPORT"
echo "======================================================"
BASH

chmod +x /root/AUDIT_TRADERONE_USDC.sh
/root/AUDIT_TRADERONE_USDC.sh
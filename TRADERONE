cat >/root/MEGA_AQFIX_VERIFY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
cd /root
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

DOMAIN="fireinners.online"
PATH_A="/iaaquila"
PATH_B="/aquila_stacking"
WEBROOT="/var/www/iaaquila"
INC="/etc/nginx/includes/iaaquila_routes.inc"

say "== VERIFY IAAQUILA =="
say "1) /root suspicious filenames (top 30 by length)"
ls -1 /root 2>/dev/null | awk '{print length($0),$0}' | sort -nr | head -n 30 || true

say "2) Webroot sanity"
ls -la "$WEBROOT" 2>/dev/null | sed -n '1,120p' || true
test -f "$WEBROOT/index.html" && say "OK: index.html present" || say "WARN: no index.html in $WEBROOT"

say "3) Nginx include sanity"
test -f "$INC" && { say "OK: $INC exists"; sed -n '1,220p' "$INC" | sed -n '1,120p'; } || say "ERR: missing $INC"

say "4) Nginx config test"
nginx -t

say "5) Reload nginx"
systemctl reload nginx || true

say "6) Local HTTPS tests (must NOT be 404)"
echo "--- ${PATH_A}/ ---"
curl -skI -H "Host: ${DOMAIN}" "https://127.0.0.1${PATH_A}/" | head -n 20 || true
echo "--- ${PATH_B}/ ---"
curl -skI -H "Host: ${DOMAIN}" "https://127.0.0.1${PATH_B}/" | head -n 20 || true

say "7) Include hit (nginx -T)"
nginx -T 2>/dev/null | grep -n "iaaquila_routes\.inc" -n | head -n 50 || true

say "8) nginx errors (last 80 lines)"
tail -n 80 /var/log/nginx/error.log 2>/dev/null || true

say "DONE"
say "Open: https://${DOMAIN}${PATH_A}/"
say "Open: https://${DOMAIN}${PATH_B}/"
BASH
chmod +x /root/MEGA_AQFIX_VERIFY.sh
bash /root/MEGA_AQFIX_VERIFY.sh
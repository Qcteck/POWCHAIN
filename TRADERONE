sudo bash -lc '
set -euo pipefail
TS=$(date +%Y%m%d_%H%M%S)
BK=/root/nginx_repair_$TS
mkdir -p "$BK" /root/nginx_disabled_backups

echo "[0] Snapshot"
cp -a /etc/nginx/nginx.conf "$BK/nginx.conf.current" 2>/dev/null || true
command -v lsattr >/dev/null && lsattr /etc/nginx/nginx.conf | tee "$BK/lsattr-nginxconf.txt" || true

echo "[1] Unfreeze nginx.conf if immutable"
if command -v lsattr >/dev/null && lsattr /etc/nginx/nginx.conf 2>/dev/null | grep -q " i "; then
  chattr -i /etc/nginx/nginx.conf || true
fi

echo "[2] Restore nginx.conf from newest backup (if any)"
CAND=$(ls -1t /root/backup_probe/nginx.conf*.bak /root/backup_probe/*nginx.conf*.bak /etc/nginx/nginx.conf*.bak 2>/dev/null | head -n1 || true)
if [ -n "${CAND:-}" ]; then
  echo "Using backup: $CAND"
  cp -a "$CAND" /etc/nginx/nginx.conf
else
  echo "No backup found -> write minimal nginx.conf"
  cat >/etc/nginx/nginx.conf <<'"'"'EOF'"'"'
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;

events { worker_connections 768; }

http {
  sendfile on;
  tcp_nopush on;
  types_hash_max_size 2048;

  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  access_log /var/log/nginx/access.log;

  gzip on;

  include /etc/nginx/conf.d/*.conf;
  include /etc/nginx/sites-enabled/*;
}
EOF
fi

echo "[3] Move fireinners backup files out of sites-enabled (keep only real vhost)"
for f in /etc/nginx/sites-enabled/*fireinners*; do
  [ -e "$f" ] || continue
  b=$(basename "$f")
  case "$b" in
    *".bak"*|*".save"*|*".old"*|*"_probe_"*|*".backup"* )
      mv -v "$f" "/root/nginx_disabled_backups/$b.$TS" || true
    ;;
  esac
done

echo "[4] Test + reload"
nginx -t
systemctl reload nginx

echo "[5] Refreeze nginx.conf (immutable)"
command -v chattr >/dev/null && chattr +i /etc/nginx/nginx.conf || true

echo "OK: nginx repaired + reloaded"
'
#!/usr/bin/env bash
set -euo pipefail

### === CONFIG ===
APP_DIR="/var/www/aiaquila"
HTML="$APP_DIR/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP="$APP_DIR/index.backup_$TS.html"

echo "=== AIAQUILA RSS + TTS JS FIX (BROWSER SAFE) ==="

### 1) CHECK
if [ ! -f "$HTML" ]; then
  echo "ERREUR: index.html introuvable dans $APP_DIR"
  exit 1
fi

### 2) BACKUP
cp "$HTML" "$BACKUP"
echo "Backup créé: $BACKUP"

### 3) NETTOYAGE ancien script RSS (si présent)
perl -0777 -i -pe '
s|<script[^>]*>.*?AIAQUILA RSS.*?</script>||sg
' "$HTML"

echo "Ancien JS RSS supprimé (si existant)"

### 4) INJECTION JS CORRECT (NAVIGATEUR ONLY)
perl -0777 -i -pe '
s|</body>|<script>
/* ===== AIAQUILA RSS + TTS – PATCH FINAL ===== */

const FEEDS = [
  \"https://www.coindesk.com/arc/outboundfeeds/rss/\",
  \"https://cointelegraph.com/rss\",
  \"https://www.coingecko.com/rss/news\"
];

const PROXY = \"/aiaquila/rss-proxy.php?url=\";
let articles = [];

function log(m){
  const l=document.getElementById(\"logs\");
  if(l){l.textContent+=m+\"\\n\";l.scrollTop=l.scrollHeight;}
}

function parseRSS(xml){
  const p=new DOMParser();
  const d=p.parseFromString(xml,\"text/xml\");
  return [...d.querySelectorAll(\"item\")].map(i=>({
    title:i.querySelector(\"title\")?.textContent||\"\", 
    desc:i.querySelector(\"description\")?.textContent||\"\"
  }));
}

async function loadRSS(){
  log(\"AIAQUILA RSS prêt\");
  articles=[];
  for(const f of FEEDS){
    try{
      const r=await fetch(PROXY+encodeURIComponent(f));
      const t=await r.text();
      articles.push(...parseRSS(t));
    }catch(e){
      log(\"RSS erreur: \"+f);
    }
  }
  log(\"Articles chargés: \"+articles.length);
  if(articles.length) speak();
}

function speak(){
  const txt=articles.slice(0,3).map(a=>a.title).join(\". \");
  if(!txt) return;
  const u=new SpeechSynthesisUtterance(txt);
  u.lang=\"fr-FR\";
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
  log(\"TTS lancé\");
}

document.addEventListener(\"DOMContentLoaded\",()=>{
  document.getElementById(\"loadRSS\")?.addEventListener(\"click\",loadRSS);
});
</script>
</body>|s
' "$HTML"

echo "JS RSS + TTS injecté correctement"

### 5) PERMISSIONS SAFE
chown www-data:www-data "$HTML"
chmod 644 "$HTML"

### 6) FIN
echo "=== PATCH TERMINÉ ==="
echo "URL: https://fireinners.online/aiaquila/"
echo "Action: recharge la page (Ctrl+F5) puis clique 'Charger les articles'"
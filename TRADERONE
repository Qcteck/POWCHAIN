WALLET="2uHq...Lx1z"   # mets le vrai
echo "== local traderone ==" 
curl -sS "http://127.0.0.1:8585/api/balances?wallet=$WALLET" ; echo

echo "== via nginx =="
curl -ks "https://fireinners.online/wolverine/traderone/api/balances?wallet=$WALLET" ; echo




DOCROOT="/var/www/wolverine"
APPJS="$DOCROOT/app.js"
cp -a "$APPJS" "$APPJS.bak.$(date +%s)"

# SOL: 4 -> 6 décimales ; USDC: 2 -> 4 décimales
sed -i 's/toFixed(4)/toFixed(6)/g; s/toFixed(2)/toFixed(4)/g' "$APPJS"

# cache-bust
TS="$(date +%s)"
sed -i -E "s|(app\.js)(\?v=[0-9]+)?|\\1?v=$TS|g" "$DOCROOT/index.html" 2>/dev/null || true

nginx -t && systemctl reload nginx
echo "OK -> ouvre /wolverine en navigation privée"
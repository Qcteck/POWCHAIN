cat >"$DOCROOT/app.js" <<'JS'
const API_BALANCES2 = "/wolverine/traderone/api/balances2";
const API_BUILD_TX  = "/wolverine/traderone/api/build-deposit-tx";
const API_CONFIRM   = "/wolverine/traderone/api/confirm";
const API_START     = "/wolverine/traderone/api/start";

const btnConnect=document.getElementById("btnConnect");
const btnStart=document.getElementById("btnStart");
const btnRefresh=document.getElementById("btnRefresh");
const afterConnect=document.getElementById("afterConnect");
const walletPill=document.getElementById("walletPill");

const uSol=document.getElementById("uSol");
const uUsdc=document.getElementById("uUsdc");
const tSol=document.getElementById("tSol");
const tUsdc=document.getElementById("tUsdc");
const tAddr=document.getElementById("tAddr");

const tokenEl=document.getElementById("token");
const budgetEl=document.getElementById("budget");
const statusText=document.getElementById("statusText");

let pubkey=null;
let traderWallet=null;

function shortPk(pk){ const s=pk.toString(); return s.slice(0,4)+"…"+s.slice(-4); }
function setStatus(t,cls="muted"){ statusText.className=cls; statusText.textContent=t; }
function n(x){ const v=Number(x); return Number.isFinite(v)?v:0; }
function canStart(){ return pubkey && traderWallet && n(budgetEl.value)>0; }

async function refreshBoth(){
  if(!pubkey) return;
  setStatus("Lecture des soldes…");
  try{
    const r = await fetch(`${API_BALANCES2}?wallet=${encodeURIComponent(pubkey.toString())}`, { cache:"no-store" });
    const d = await r.json().catch(()=>({}));
    if(!r.ok) throw new Error(d?.error || ("HTTP "+r.status));

    traderWallet = d.traderWallet || null;
    tAddr.textContent = traderWallet || "—";

    uSol.textContent  = Number(d.user?.sol ?? 0).toFixed(6);
    uUsdc.textContent = Number(d.user?.usdc ?? 0).toFixed(4);
    tSol.textContent  = Number(d.trader?.sol ?? 0).toFixed(6);
    tUsdc.textContent = Number(d.trader?.usdc ?? 0).toFixed(4);

    setStatus("OK", "ok");
    btnStart.disabled = !canStart();
  }catch(e){
    setStatus("Balances error: " + (e?.message || e), "err");
  }
}

async function confirmSig(sig, tries=25){
  for(let i=0;i<tries;i++){
    const r = await fetch(`${API_CONFIRM}?sig=${encodeURIComponent(sig)}`, {cache:"no-store"});
    const d = await r.json().catch(()=>({}));
    if(d?.ok) return true;
    await new Promise(res=>setTimeout(res, 1000));
  }
  return false;
}

btnConnect.onclick=async ()=>{
  if(!window.solana?.isPhantom){
    setStatus("Phantom non détecté","err");
    return;
  }
  try{
    const r=await window.solana.connect();
    pubkey=r.publicKey;
    walletPill.textContent="Wallet: "+shortPk(pubkey);
    afterConnect.classList.remove("hidden");
    btnConnect.textContent="Wallet connecté";
    btnConnect.disabled=true;
    await refreshBoth();
  }catch(e){
    setStatus("Connexion refusée: " + (e?.message||e),"err");
  }
};

budgetEl.oninput=()=>{ btnStart.disabled=!canStart(); };
tokenEl.onchange=()=>{ btnStart.disabled=!canStart(); };
btnRefresh.onclick=refreshBoth;

btnStart.onclick=async ()=>{
  if(!canStart()) return;

  const token  = tokenEl.value;
  const budget = n(budgetEl.value);
  const amount = budget;

  const ok = confirm(`Envoyer ${amount} ${token} vers TraderOne:\n${traderWallet}\n\nPuis démarrer WOLVERINE ?`);
  if(!ok) return;

  btnStart.disabled=true;
  setStatus("Préparation transaction…");

  try{
    const build = await fetch(API_BUILD_TX,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify({ from: pubkey.toString(), token, amount })
    });
    const bd = await build.json().catch(()=>({}));
    if(!build.ok) throw new Error(bd?.error || ("HTTP "+build.status));

    const txBytes = Uint8Array.from(atob(bd.txBase64), c => c.charCodeAt(0));
    const tx = solanaWeb3.Transaction.from(txBytes);

    setStatus("Signature + envoi…");
    const { signature } = await window.solana.signAndSendTransaction(tx);

    setStatus("Confirmation on-chain…");
    const confirmed = await confirmSig(signature);
    if(!confirmed){
      setStatus("Tx envoyée mais non confirmée. Sig: "+signature, "err");
      btnStart.disabled=false;
      return;
    }

    setStatus("Tx confirmée ✅ Démarrage…","ok");
    const st = await fetch(API_START,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify({ wallet: pubkey.toString(), budget, depositSig: signature, token, amount })
    });
    const sd = await st.json().catch(()=>({}));
    if(!st.ok) throw new Error(sd?.error || ("HTTP "+st.status));

    setStatus("WOLVERINE démarré ✅", "ok");
    await refreshBoth();
  }catch(e){
    setStatus("Erreur: " + (e?.message || e), "err");
    btnStart.disabled=false;
  }
};
JS


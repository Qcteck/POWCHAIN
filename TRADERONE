cat >/root/FIREINNERS_WALLET_TAB_MEGA.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIREINNERS WALLET TAB :: MEGA PATCH (safe) ==="

DIST="/opt/fireinners/frontend-react/app/dist"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
WALLET_DIR="$DIST/wallet"
TMPDIR="/root/backup_fireinners_wallettab_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$TMPDIR"

echo "[0] Checks"
[ -d "$DIST" ] || { echo "ERR dist missing: $DIST"; exit 1; }
[ -f "$DIST/index.html" ] || { echo "ERR dist/index.html missing"; exit 1; }
[ -f "$VHOST" ] || { echo "ERR vhost missing: $VHOST"; exit 1; }
nginx -t >/dev/null 2>&1 || { echo "ERR nginx -t failed"; nginx -t || true; exit 1; }

echo "[1] Backup index.html"
cp -f "$DIST/index.html" "$TMPDIR/index.html.bak"

echo "[2] Optional askorupdate"
ASKOR="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKOR" ]; then
  # shellcheck disable=SC1090
  . "$ASKOR"
  export ASKORUPDATE_ASK=0
  echo "askorupdate loaded"
else
  echo "askorupdate not found (OK)"
fi

echo "[3] Build /wallet/ page"
mkdir -p "$WALLET_DIR"
cat >"$TMPDIR/wallet.index.html" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><title>FireInners • Wallet</title><style>:root{--bg:#05060b;--p:#0a0f1e;--l:#1b2a44;--t:#e7f0ff;--m:#9fb3d7;--ok:#b9ffcf;--bad:#ffb3b3;--a:#9ff}*{box-sizing:border-box}html,body{margin:0;height:100%;background:radial-gradient(900px 500px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(700px 450px at 80% 20%,#101a33 0%,transparent 55%),var(--bg);color:var(--t);font:14px system-ui}a{color:var(--a);text-decoration:none}#wrap{max-width:980px;margin:0 auto;padding:18px}#top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}#pill{display:flex;gap:10px;flex-wrap:wrap;align-items:center}#pill a{padding:8px 10px;border:1px solid var(--l);border-radius:999px;background:rgba(0,0,0,.18)}#card{background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));border:1px solid var(--l);border-radius:16px;padding:14px}#grid{display:grid;grid-template-columns:1.2fr .8fr;gap:12px;margin-top:12px}#row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}button{cursor:pointer;border:1px solid var(--l);background:rgba(0,0,0,.22);color:var(--t);padding:10px 10px;border-radius:12px;font-weight:600}button:hover{border-color:rgba(255,255,255,.25)}.muted{color:var(--m)}.k{display:block;font-size:12px;color:var(--m)}#log{margin-top:10px;white-space:pre-wrap;font:12px ui-monospace,Menlo,Consolas,monospace;color:#cfe3ff}#box{padding:10px;border:1px dashed rgba(255,255,255,.12);border-radius:12px;background:rgba(0,0,0,.18)}.val{font:600 16px system-ui}#addr,#sol,#usdc{font:600 14px ui-monospace,Menlo,Consolas,monospace}#ok{color:var(--ok)}#bad{color:var(--bad)}@media(max-width:860px){#grid{grid-template-columns:1fr}}</style></head><body><div id="wrap"><div id="top"><div><div style="font:800 18px system-ui">FireInners • Wallet</div><div class="muted" style="margin-top:2px">SOL/USDC via Phantom + Solana RPC. Aucun secret, aucune seed, aucun export.</div></div><div id="pill"><a href="/">Retour</a></div></div><div id="card"><div id="row"><button id="btnConnect">Connect Phantom</button><button id="btnDisc" disabled>Disconnect</button><button id="btnRefresh" disabled>Refresh</button><span class="muted">RPC:</span><span id="rpc" class="muted"></span></div><div id="grid"><div id="box"><span class="k">Adresse</span><div id="addr" class="val muted">-</div><div style="height:10px"></div><span class="k">SOL</span><div id="sol" class="val muted">-</div><div style="height:10px"></div><span class="k">USDC</span><div id="usdc" class="val muted">-</div></div><div id="box"><span class="k">Notes</span><div class="muted" style="line-height:1.45">- Lecture soldes via RPC, pas de transaction ici.<br/>- Si Phantom iOS bloque, ouvre dans le navigateur intégré Phantom.<br/>- Si ton RPC refuse le CORS, on bascule sur un RPC public.</div></div></div><div id="log"></div></div></div><script src="https://cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js"></script><script>(function(){try{window.Buffer=buffer.Buffer}catch(e){}})();</script><script src="https://unpkg.com/@solana/web3.js@1.98.0/lib/index.iife.min.js"></script><script>(()=>{const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";const $=s=>document.querySelector(s);const log=m=>{const el=$("#log");el.textContent+=(m+"\n");};$("#rpc").textContent=RPC;let pub=null,conn=null;function fmt(n,d=9){try{return (Number(n)||0).toLocaleString(undefined,{maximumFractionDigits:d})}catch(e){return String(n)}}async function getUSDC(owner){let sum=0;try{const resp=await conn.getParsedTokenAccountsByOwner(owner,{programId:new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")});for(const it of (resp.value||[])){const info=it.account?.data?.parsed?.info;const mint=info?.mint;const ui=info?.tokenAmount?.uiAmount; if(mint===USDC_MINT) sum+=Number(ui||0);}return sum}catch(e){log("USDC err: "+(e?.message||e));return null}}async function refresh(){if(!pub||!conn) return;try{const lam=await conn.getBalance(pub,"confirmed");$("#sol").textContent=fmt(lam/1e9,6);const u=await getUSDC(pub);$("#usdc").textContent=(u==null?"-":fmt(u,2));}catch(e){log("Refresh err: "+(e?.message||e));}}async function connect(){try{const ph=window.solana;if(!ph||!ph.isPhantom){log("Phantom introuvable.");return}conn=new solanaWeb3.Connection(RPC,{commitment:"confirmed"});const r=await ph.connect();pub=r.publicKey;$("#addr").textContent=pub.toBase58();$("#btnDisc").disabled=false;$("#btnRefresh").disabled=false;log("CONNECTED");await refresh()}catch(e){log("Connect err: "+(e?.message||e));}}async function disconnect(){try{const ph=window.solana;if(ph&&ph.disconnect) await ph.disconnect();}catch(e){}pub=null;conn=null;$("#addr").textContent="-";$("#sol").textContent="-";$("#usdc").textContent="-";$("#btnDisc").disabled=true;$("#btnRefresh").disabled=true;log("DISCONNECTED");}$("#btnConnect").onclick=connect;$("#btnDisc").onclick=disconnect;$("#btnRefresh").onclick=refresh;})();</script></body></html>
HTML

echo "[4] Write wallet page (safe update)"
if command -v askorupdate_file >/dev/null 2>&1; then
  askorupdate_file "$WALLET_DIR/index.html" "$TMPDIR/wallet.index.html"
else
  cp -f "$TMPDIR/wallet.index.html" "$WALLET_DIR/index.html"
fi

echo "[5] Inject WALLET tab into dist/index.html (idempotent)"
python3 - <<'PY'
import pathlib,re,sys
dist=pathlib.Path("/opt/fireinners/frontend-react/app/dist")
p=dist/"index.html"
s=p.read_text(encoding="utf-8",errors="ignore")
marker="FIREINNERS_WALLET_TAB_v1"
if marker in s:
    print("OK wallet tab already injected")
    sys.exit(0)
inject = r'''<!-- FIREINNERS_WALLET_TAB_v1 -->
<a id="fiWalletTab" href="/wallet/" style="position:fixed;top:14px;right:14px;z-index:999999;padding:10px 12px;border-radius:999px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.18);color:#e7f0ff;font:700 12px system-ui;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);text-decoration:none">WALLET</a>
'''
ns=re.sub(r'(?i)</body>', inject+"\n</body>", s, count=1)
if ns==s:
    raise SystemExit("ERR cannot find </body> to inject")
p.write_text(ns,encoding="utf-8")
print("OK injected wallet tab")
PY

echo "[6] Final checks"
[ -f "$WALLET_DIR/index.html" ] && echo "OK wallet route: $WALLET_DIR/index.html" || { echo "ERR wallet file missing"; exit 1; }
grep -q "FIREINNERS_WALLET_TAB_v1" "$DIST/index.html" && echo "OK tab marker present" || { echo "ERR tab marker missing"; exit 1; }

echo "DONE. Test:"
echo " - https://fireinners.online/wallet/"
echo " - https://fireinners.online/  (button WALLET en haut à droite)"
SH

chmod +x /root/FIREINNERS_WALLET_TAB_MEGA.sh
bash /root/FIREINNERS_WALLET_TAB_MEGA.sh
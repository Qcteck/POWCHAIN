from pathlib import Path

targets = ["/wolverine/solana-rpc", "/wolverine/vault/api"]
incdir = Path("${INC_DIR}")

def strip_locations(text, path_token):
    lines = text.splitlines(True)
    out=[]
    i=0
    while i < len(lines):
        line = lines[i]
        if "location" in line and path_token in line:
            # remove this location block by brace counting
            depth = line.count("{") - line.count("}")
            i += 1
            while i < len(lines) and depth > 0:
                depth += lines[i].count("{") - lines[i].count("}")
                i += 1
            continue
        out.append(line)
        i += 1
    return "".join(out)

for f in sorted(incdir.glob("*")):
    if not f.is_file(): 
        continue
    s = f.read_text(errors="ignore")
    orig = s
    for t in targets:
        s = strip_locations(s, t)
    if s != orig:
        f.write_text(s)
        print("cleaned:", f)

# ensure main include exists
Path("${INC_FILE}").parent.mkdir(parents=True, exist_ok=True)
if not Path("${INC_FILE}").exists():
    Path("${INC_FILE}").write_text("")
    print("created:", "${INC_FILE}")

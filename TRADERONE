import re,sys
vhost="$VHOST"
s=open(vhost,"r",encoding="utf-8",errors="ignore").read()

marker="# WOLV_API_PROXY_MIN_V1"
block=f"""
    {marker}
    location ^~ /wolverine/api/ {{
        proxy_pass http://127.0.0.1:{API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \\$host;
        proxy_set_header X-Real-IP \\$remote_addr;
        proxy_set_header X-Forwarded-For \\$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \\$scheme;
        proxy_read_timeout 60s;
    }}
"""

if marker in s:
    print("OK nginx proxy déjà présent"); sys.exit(0)

# simple: choisit le dernier bloc server { ... } (souvent ssl)
starts=[m.start() for m in re.finditer(r'(?m)^\\s*server\\s*\\{',s)]
if not starts: raise SystemExit("ERR: aucun server{} dans vhost")
start=starts[-1]
# trouve la fin de ce server avec compteur d'accolades
i=start; depth=0; opened=False
while i < len(s):
    c=s[i]
    if c=='{': depth+=1; opened=True
    elif c=='}' and opened:
        depth-=1
        if depth==0:
            end=i+1
            blk=s[start:end]
            ins=blk[:-1]+block+"\\n}"
            out=s[:start]+ins+s[end:]
            open(vhost,"w",encoding="utf-8").write(out)
            print("OK nginx proxy ajouté"); sys.exit(0)
    i+=1
raise SystemExit("ERR: fin server{} introuvable")

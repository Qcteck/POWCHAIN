set -e
cd /root

URL_PATH="/wolverine/traderone/api/status"

KSSL=$(grep -oP 'http_x_api_key != "\K[^"]+' /etc/nginx/sites-enabled/fireinners.online-ssl | head -n1 || true)
KHTTP=$(grep -oP 'http_x_api_key != "\K[^"]+' /etc/nginx/sites-enabled/fireinners.online     | head -n1 || true)

echo "SSL key length: ${#KSSL}"
echo "HTTP key length: ${#KHTTP}"

echo "SSL key sha256:"
printf "%s" "$KSSL" | sha256sum
echo "HTTP key sha256:"
printf "%s" "$KHTTP" | sha256sum

echo
echo "=== BYPASS Cloudflare (local HTTPS) AVEC clé SSL => 200 attendu ==="
curl -sS -k -i -X POST "https://127.0.0.1$URL_PATH" \
  -H "Host: fireinners.online" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KSSL" \
  --data '{}' | head -n 20

echo
echo "=== PUBLIC AVEC clé SSL => 200 attendu ==="
curl -sS -i -X POST "https://fireinners.online$URL_PATH" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KSSL" \
  --data '{}' | head -n 20
cat > /root/WOLVERINE_DIAG_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE DIAGNOSTIC & DEPLOY FIX ==="
HTML="/var/www/wolverine/index.html"
NGINX_ROOT=""
FAIL=0

echo
echo "[1/7] Vérification fichier index.html"
if [ ! -f "$HTML" ]; then
  echo "ERREUR: $HTML introuvable"
  exit 1
fi
ls -l "$HTML"

echo
echo "[2/7] Vérification contenu (USDC / Phantom)"
grep -n "readUSDC" "$HTML" || echo "INFO: readUSDC non trouvé"
grep -n "solanaWeb3" "$HTML" || echo "INFO: solanaWeb3 non trouvé"
grep -n "phantom" "$HTML" || echo "INFO: phantom non trouvé"

echo
echo "[3/7] Détection ROOT nginx réel"
NGINX_ROOT=$(grep -R "root .*wolverine" /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null | head -n1 | sed 's/.*root //;s/;//')
if [ -z "$NGINX_ROOT" ]; then
  echo "ERREUR: root nginx non trouvé"
  FAIL=1
else
  echo "nginx root = $NGINX_ROOT"
fi

echo
echo "[4/7] Vérification index.html réellement servi"
if [ "$NGINX_ROOT/index.html" != "$HTML" ]; then
  echo "ATTENTION: nginx ne sert PAS $HTML"
  echo "nginx sert: $NGINX_ROOT/index.html"
  FAIL=1
fi

echo
echo "[5/7] Recherche doublons index.html"
find /var/www -name index.html | grep wolverine || true

echo
echo "[6/7] Purge cache nginx"
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx

echo
echo "[7/7] Test headers cache"
curl -I https://fireinners.online/wolverine/ | grep -i cache || echo "Aucun cache header"

echo
echo "=== RESULTAT ==="
if [ "$FAIL" -eq 0 ]; then
  echo "OK: Déploiement cohérent"
else
  echo "PROBLEME DETECTE: nginx / fichier servi"
fi

echo
echo "ACTION UTILISATEUR:"
echo "- CTRL + SHIFT + R"
echo "- Afficher le code source"
echo "- Rechercher: readUSDC("
echo "=== FIN ==="
BASH

chmod +x /root/WOLVERINE_DIAG_FIX.sh
/root/WOLVERINE_DIAG_FIX.sh
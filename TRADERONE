cat >/root/FIX_DNS_RESOLVCONF.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

cp -a /etc/resolv.conf /etc/resolv.conf.bak.$(date +%s) || true

cat >/etc/resolv.conf <<'EOF'
nameserver 1.1.1.1
nameserver 1.0.0.1
nameserver 8.8.8.8
nameserver 8.8.4.4
options timeout:2 attempts:2 rotate
EOF

echo "DNS now:"
cat /etc/resolv.conf
echo

echo "Test:"
getent hosts workers.dev
getent hosts cloudflare.com
BASH

bash /root/FIX_DNS_RESOLVCONF.sh
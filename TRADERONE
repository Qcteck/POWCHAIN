set -euo pipefail
SVC="fireinners-qplus-wasm"
UNIT="/etc/systemd/system/${SVC}.service"
DROP_DIR="/etc/systemd/system/${SVC}.service.d"
DROP_FILE="${DROP_DIR}/restart.conf"
TS="$(date +%Y%m%d-%H%M%S)"
BK="/root/beton_${SVC}_restart_${TS}"

echo "== PRECHECK =="
id || true
hostname || true
date -u || true
echo "SVC=${SVC}"
if [ ! -f "$UNIT" ]; then
  echo "ERREUR: unit introuvable: $UNIT"
  echo "Astuce: ls -la /etc/systemd/system | grep -i fireinners"
  exit 1
fi

echo "== BACKUP =="
mkdir -p "$BK"
cp -a "$UNIT" "$BK/" || true
if [ -d "$DROP_DIR" ]; then cp -a "$DROP_DIR" "$BK/" || true; fi
echo "Backup: $BK"

echo "== APPLY POLICY via DROP-IN (safe, idempotent) =="
mkdir -p "$DROP_DIR"
cat > "$DROP_FILE" <<'EOF'
[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Restart=on-failure
RestartSec=3
EOF
echo "Wrote: $DROP_FILE"
cat "$DROP_FILE"

echo "== RELOAD + RESTART =="
systemctl daemon-reload
systemctl restart "$SVC"

echo "== VERIFY POLICY =="
systemctl show "$SVC" -p FragmentPath -p DropInPaths -p Restart -p RestartUSec -p RestartSec -p StartLimitIntervalUSec -p StartLimitBurst -p NRestarts | sed 's/^/  /'

echo "== STATUS (top) =="
systemctl status "$SVC" --no-pager -l | head -n 40

echo "== LAST LOGS (look for restart loop) =="
journalctl -u "$SVC" -n 120 --no-pager | egrep -i "Scheduled restart job|Start request repeated too quickly|Main process exited|Failed with result|Started|Stopping|killed|segfault|OOM|exit-code" || true

echo "== LISTEN (optional quick view) =="
ss -lntp | egrep -i "node|:${SVC}|127\.0\.0\.1:12702|127\.0\.0\.1:12701|127\.0\.0\.1:9696" || true

echo "== DONE =="
echo "Backup at: $BK"
cat <<'EOF' > /root/FIX_AIAQUILA_BROWSER.sh
#!/bin/bash
set -e

APP_DIR="/var/www/aiaquila"
INDEX="$APP_DIR/index.html"
NGX="/etc/nginx/sites-enabled/fireinners.online-ssl"
BACKUP="/root/fireinners_ssl_backup_$(date +%Y%m%d_%H%M%S).bak"

echo "🔒 Backup vhost SSL"
cp "$NGX" "$BACKUP"

echo "🧹 Ajout headers no-cache (safe)"
if ! grep -q "AIAQUILA_NO_CACHE" "$NGX"; then
  sed -i '/location \/aiaquila\//a \\
    # AIAQUILA_NO_CACHE\\
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;\\
    add_header Pragma "no-cache" always;\\
    add_header Expires 0 always;' "$NGX"
fi

echo "🧪 Écriture HTML minimal visible"
cat <<'HTML' > "$INDEX"
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>AIAQUILA OK</title>
<style>
body {
  background:#0b0f1a;
  color:#00ffd5;
  font-family: monospace;
  display:flex;
  align-items:center;
  justify-content:center;
  height:100vh;
  font-size:24px;
}
</style>
</head>
<body>
🦅 AIAQUILA SERVI — NAVIGATEUR OK
</body>
</html>
HTML

chown www-data:www-data "$INDEX"
chmod 644 "$INDEX"

echo "🧪 Test nginx"
nginx -t

echo "🔁 Reload nginx"
systemctl reload nginx

echo "✅ FIX APPLIQUÉ — ouvre le navigateur"
EOF

chmod +x /root/FIX_AIAQUILA_BROWSER.sh
/root/FIX_AIAQUILA_BROWSER.sh
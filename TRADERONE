set -e
APP_DIR="/opt/traderone-opt"
cd "$APP_DIR"

echo "=== 0) Trouver qui fait tourner PM2 ==="
PM2_USERS=$(ps -eo user,cmd | awk '$2 ~ /PM2|pm2/ {print $1}' | sort -u)
if [ -z "$PM2_USERS" ]; then
  echo "KO: aucun PM2 trouvé (ps)."
  exit 1
fi
echo "PM2 users: $PM2_USERS"
echo

# on prend le 1er user trouvé (souvent root, sinon ubuntu/deploy)
PM2_USER=$(echo "$PM2_USERS" | head -n1)
echo "=> Utilisation PM2_USER=$PM2_USER"
echo

pm2u() { sudo -u "$PM2_USER" pm2 "$@"; }

echo "=== 1) Lister PM2 (ID) ==="
pm2u ls
echo

# récupérer l'ID du process traderone (sinon 0 par défaut)
PM2_ID=$(pm2u jlist | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{const a=JSON.parse(d);const p=a.find(x=>x.name==="traderone")||a[0];console.log(p?String(p.pm_id):"");}catch(e){console.log("")}})')
if [ -z "$PM2_ID" ]; then
  echo "KO: impossible de détecter l'ID PM2. Regarde 'pm2 ls' et prends l'id."
  exit 1
fi
echo "=> PM2_ID=$PM2_ID"
echo

echo "=== 2) Vérifier .env (sans afficher la clé) ==="
test -f .env || { echo "KO: $APP_DIR/.env introuvable"; exit 1; }
grep -q '^LIFI_API_KEY=' .env || { echo "KO: LIFI_API_KEY absente de .env"; exit 1; }
echo "OK: .env contient LIFI_API_KEY (len=$(grep '^LIFI_API_KEY=' .env | head -n1 | cut -d= -f2- | tr -d '\r\n' | wc -c))"
echo

echo "=== 3) Charger .env dans le shell et pousser dans l'env du process PM2 ==="
set -a
. ./.env
set +a

# (facultatif) si pas défini
export LIFI_INTEGRATOR="${LIFI_INTEGRATOR:-traderone}"

# pousser dans le process pm2 (sans afficher la valeur)
pm2u set "traderone:LIFI_API_KEY" "$LIFI_API_KEY" >/dev/null || true
pm2u set "traderone:LIFI_INTEGRATOR" "$LIFI_INTEGRATOR" >/dev/null || true
pm2u save >/dev/null || true

echo "OK: variables poussées à PM2"
echo

echo "=== 4) Restart bot (avec update-env) ==="
pm2u restart "$PM2_ID" --update-env
sleep 2
pm2u ls
echo

echo "=== 5) Confirmer que PM2 voit LIFI (sans afficher la clé) ==="
pm2u env "$PM2_ID" | awk -F= '/^LIFI_API_KEY=/{print "LIFI_API_KEY present: YES (len="length($2)")"} /^LIFI_INTEGRATOR=/{print "LIFI_INTEGRATOR=" $2}'
echo

echo "=== 6) Test direct LI.FI (upstream) ==="
curl -sS -i "https://li.quest/v1/quote?fromChain=101&toChain=101&fromToken=So11111111111111111111111111111111111111112&toToken=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v&fromAmount=1000000&fromAddress=11111111111111111111111111111111&slippage=0.5&integrator=$LIFI_INTEGRATOR" \
  -H "accept: application/json" \
  -H "x-lifi-api-key: $LIFI_API_KEY" \
  | head -n 40
echo

echo "=== 7) Test API locale TraderOne ==="
curl -sS -i -X POST "http://127.0.0.1:3000/api/swap" \
  -H "content-type: application/json" \
  --data '{"provider":"lifi","fromChain":101,"toChain":101,"fromToken":"So11111111111111111111111111111111111111112","toToken":"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v","fromAmount":"1000000","fromAddress":"11111111111111111111111111111111","slippage":0.5}' \
  | head -n 80
echo

echo "=== 8) Logs (dernieres 60 lignes) ==="
pm2u logs "$PM2_ID" --lines 60 --nostream | tail -n 60 || true
echo "=== FIN ==="
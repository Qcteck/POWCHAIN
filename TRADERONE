cat >/root/cleanup_fireinners_enabled_variants_now.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
EN="/etc/nginx/sites-enabled"
DST="/etc/nginx/sites-disabled/cleanup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$DST"

echo "== BEFORE =="
ls -lah "$EN"

echo
echo "== Move ALL fireinners.online-ssl.* out of sites-enabled =="
shopt -s nullglob
for f in "$EN"/fireinners.online-ssl.*; do
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== AFTER (should show only fireinners.online-ssl) =="
ls -lah "$EN"

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload =="
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/cleanup_fireinners_enabled_variants_now.sh
/root/cleanup_fireinners_enabled_variants_now.sh
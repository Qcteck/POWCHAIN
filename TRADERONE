#!/bin/bash
set -e

FRONT="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

echo "=== FIX FRONTEND BALANCES ==="

cp $FRONT $FRONT.bak.$(date +%s)

cat > /tmp/balances.patch.html <<'EOF'
<script>
const API="/api/balances";
let phantomPK=null;

async function connectPhantom(){
 if(!window.solana){alert("Phantom non détecté");return;}
 const r=await window.solana.connect();
 phantomPK=r.publicKey.toString();
 document.getElementById("wallet").innerText=phantomPK;
 refreshBalances();
}

async function refreshBalances(){
 let url=API+(phantomPK?("?user="+phantomPK):"");
 try{
  const j=await fetch(url).then(r=>r.json());
  if(j.internalSOL!==undefined) document.getElementById("internal-sol").innerText=j.internalSOL.toFixed(4);
  if(j.internalUSDC!==undefined) document.getElementById("internal-usdc").innerText=j.internalUSDC.toFixed(2);
  if(j.userSOL!==undefined) document.getElementById("phantom-sol").innerText=j.userSOL.toFixed(4);
  if(j.userUSDC!==undefined) document.getElementById("phantom-usdc").innerText=j.userUSDC.toFixed(2);
 }catch(e){console.error(e);}
}

setInterval(refreshBalances,15000);
</script>
EOF

sed -i '/<\/body>/d' $FRONT

cat >> $FRONT <<'EOF'
<hr>
<div>
 Wallet: <span id="wallet">-</span><br><br>
 Internal SOL: <span id="internal-sol">-</span><br>
 Internal USDC: <span id="internal-usdc">-</span><br><br>
 Phantom SOL: <span id="phantom-sol">-</span><br>
 Phantom USDC: <span id="phantom-usdc">-</span><br>
</div>
<button onclick="connectPhantom()">Connect Phantom</button>
EOF

cat /tmp/balances.patch.html >> $FRONT
echo "</body></html>" >> $FRONT

nginx -t && systemctl reload nginx

echo "✅ FRONTEND FIXED – SOLDES LIVE ACTIFS" 
<script>
(()=>{"use strict";
const $=id=>document.getElementById(id);
const logEl=$("log");
const chipNET=$("chipNET"),chipRPC=$("chipRPC"),chipARM=$("chipARM"),chipWAL=$("chipWAL"),chipPOL=$("chipPOL");
const btnConnect=$("btnConnect"),btnDisconnect=$("btnDisconnect"),btnARM=$("btnARM"),btnDISARM=$("btnDISARM"),btnPropose=$("btnPropose"),btnApprove=$("btnApprove"),btnClear=$("btnClear"),btnReloadPolicy=$("btnReloadPolicy");
const inpDest=$("dest"),inpSol=$("sol");

function now(){return new Date().toLocaleTimeString("fr-CA",{hour:"2-digit",minute:"2-digit",second:"2-digit"});}
function p(s,cls){const d=document.createElement("div");d.textContent=`[${now()}] ${s}`;if(cls)d.className=cls;logEl.appendChild(d);logEl.scrollTop=1e9;}
function fmtErr(e){try{if(!e)return"Unknown";if(typeof e==="string")return e;return (e.message||String(e))+(e.code?` (code ${e.code})`:"");}catch(_){return"Error";}}

let web3=null, solana=null, wallet=null, arm=false;
let policy={enabled:true,network:"mainnet-beta",rpc:"https://api.mainnet-beta.solana.com",allowDestinations:[],maxLamportsPerTx:2_000_000,maxTxPerMinute:2,cooldownMs:15000,requireArm:true,confirmCommitment:"finalized"};
let conn=null;
let pending=null; // {id,from,to,lamports,createdAt,blockhash,lastValidBlockHeight,signature,stage,lastAttemptAt,attempts}

function setChip(el,txt,ok){el.textContent=txt;el.style.borderColor=ok?"rgba(99,255,184,.65)":"rgba(255,106,106,.55)";}
function refreshChips(){
  chipNET.textContent=`NET:${policy.network||"—"}`;
  chipRPC.textContent=`RPC:${(policy.rpc||"—").replace(/^https?:\/\//,"")}`;
  chipARM.textContent=`ARM:${arm?"ON":"OFF"}`;
  chipARM.className="chip "+(arm?"ok":"bad");
  chipWAL.textContent=`WALLET:${wallet?wallet.slice(0,4)+"…"+wallet.slice(-4):"—"}`;
  chipPOL.textContent=`POLICY:${policy.enabled?"ON":"OFF"}`;
  chipPOL.className="chip "+(policy.enabled?"ok":"bad");
}

function lsGet(k){try{return localStorage.getItem(k);}catch(_){return null;}}
function lsSet(k,v){try{localStorage.setItem(k,v);}catch(_){return;}}
function lsDel(k){try{localStorage.removeItem(k);}catch(_){return;}}
const KEY_POL="AIAQ_POLICY_V1";
const KEY_PEND="AIAQ_PENDING_V1";
const KEY_RATE="AIAQ_RATE_V1";

async function sha256Hex(s){
  const b=new TextEncoder().encode(s);
  const h=await crypto.subtle.digest("SHA-256",b);
  return Array.from(new Uint8Array(h)).map(x=>x.toString(16).padStart(2,"0")).join("");
}

function rateOk(){
  const t=Date.now();
  let r={t0:t, n:0, last:t};
  const raw=lsGet(KEY_RATE);
  if(raw){try{r=JSON.parse(raw)||r;}catch(_){r=r;}}
  if(t-r.t0>60_000){r={t0:t,n:0,last:t};}
  if(t-r.last < (policy.cooldownMs||0)) return {ok:false, why:`cooldown ${policy.cooldownMs}ms`};
  if(r.n >= (policy.maxTxPerMinute||999)) return {ok:false, why:`rate maxTxPerMinute=${policy.maxTxPerMinute}`};
  r.n++; r.last=t; lsSet(KEY_RATE,JSON.stringify(r));
  return {ok:true};
}

function policyCheck(to,lamports){
  if(!policy.enabled) return {ok:true};
  if(policy.requireArm && !arm) return {ok:false, why:"ARM required"};
  if(!to) return {ok:false, why:"destination missing"};
  if(!Number.isFinite(lamports) || lamports<=0) return {ok:false, why:"lamports invalid"};
  if(lamports > (policy.maxLamportsPerTx||0)) return {ok:false, why:`over maxLamportsPerTx=${policy.maxLamportsPerTx}`};
  const allow=(policy.allowDestinations||[]).map(x=>String(x||"").trim()).filter(Boolean);
  if(allow.length && !allow.includes(to)) return {ok:false, why:"destination not allowlisted"};
  return {ok:true};
}

async function loadPolicy(){
  // merge localStorage -> policy.json -> defaults
  let base=policy;
  const ls=lsGet(KEY_POL);
  if(ls){try{base=Object.assign({},base,JSON.parse(ls)||{});}catch(_){/*ignore*/}}
  try{
    const r=await fetch("./policy.json?ts="+Date.now(),{cache:"no-store"});
    if(r.ok){
      const j=await r.json();
      base=Object.assign({},base,j||{});
      p("Policy loaded from ./policy.json","ok");
    }else{
      p("Policy fetch not ok (using local/default)","bad");
    }
  }catch(e){
    p("Policy fetch failed (using local/default): "+fmtErr(e),"bad");
  }
  policy=base;
  lsSet(KEY_POL,JSON.stringify(policy));
  conn=new solanaWeb3.Connection(policy.rpc,{commitment:"confirmed"});
  refreshChips();
}

function loadPending(){
  const raw=lsGet(KEY_PEND);
  if(!raw) return;
  try{pending=JSON.parse(raw)||null;}catch(_){pending=null;}
  if(pending) p("Pending restored: "+pending.id,"ok");
}

function savePending(){
  if(pending) lsSet(KEY_PEND,JSON.stringify(pending)); else lsDel(KEY_PEND);
}

function clearPending(){
  pending=null; savePending();
  p("Pending cleared","ok");
}

async function connect(){
  solana=window.solana;
  if(!solana || !solana.isPhantom) throw new Error("Phantom not detected");
  const r=await solana.connect({onlyIfTrusted:false});
  wallet=(r && r.publicKey)? r.publicKey.toString() : (solana.publicKey?solana.publicKey.toString():null);
  if(!wallet) throw new Error("wallet missing after connect");
  p("Wallet connecté: "+wallet,"ok");
  refreshChips();
}

function disconnect(){
  try{ if(window.solana && window.solana.isPhantom) window.solana.disconnect(); }catch(_){}
  wallet=null;
  p("Disconnected","bad");
  refreshChips();
}

function solToLamports(sol){
  const x=Number(sol);
  if(!Number.isFinite(x) || x<=0) return NaN;
  return Math.round(x*1e9);
}

async function propose(){
  if(!window.solanaWeb3) throw new Error("solanaWeb3 missing (web3 not loaded)");
  if(!wallet) throw new Error("wallet not connected");
  if(pending && pending.stage && pending.stage!=="done") throw new Error("pending already exists (clear or approve)");

  const to=String(inpDest.value||"").trim();
  const lamports=solToLamports(inpSol.value);
  const chk=policyCheck(to,lamports);
  if(!chk.ok) throw new Error("policy: "+chk.why);

  const rid=await sha256Hex(JSON.stringify({from:wallet,to,lamports,ts:Date.now()}));
  pending={id:rid,from:wallet,to,lamports,createdAt:Date.now(),signature:null,stage:"proposed",attempts:0,lastAttemptAt:0};
  savePending();
  p(`Proposition OK -> ${lamports} lamports (id ${rid.slice(0,10)}…)`,"ok");
}

async function sendWithRetry(tx){
  // retry on transient errors
  let lastErr=null;
  for(let i=0;i<3;i++){
    try{
      const sig=await conn.sendRawTransaction(tx.serialize(),{skipPreflight:false,preflightCommitment:"confirmed",maxRetries:0});
      return sig;
    }catch(e){
      lastErr=e;
      const msg=fmtErr(e);
      p("sendRawTransaction failed: "+msg,"bad");
      // blockhash not found / expired -> let caller rebuild
      await new Promise(r=>setTimeout(r, 600*(2**i)));
    }
  }
  throw lastErr||new Error("send failed");
}

async function confirmFinalized(sig, bh, lvh){
  // confirm in finalized with backoff
  let lastErr=null;
  for(let i=0;i<6;i++){
    try{
      const res=await conn.confirmTransaction({signature:sig,blockhash:bh,lastValidBlockHeight:lvh}, policy.confirmCommitment||"finalized");
      if(res && res.value && res.value.err) throw new Error("tx err: "+JSON.stringify(res.value.err));
      return true;
    }catch(e){
      lastErr=e;
      p("confirm failed: "+fmtErr(e),"bad");
      await new Promise(r=>setTimeout(r, 800*(2**i)));
    }
  }
  throw lastErr||new Error("confirm failed");
}

async function approve(){
  if(!wallet) throw new Error("wallet not connected");
  if(!pending || pending.stage!=="proposed") throw new Error("no pending proposal");
  const to=pending.to, lamports=pending.lamports;

  const chk=policyCheck(to,lamports);
  if(!chk.ok) throw new Error("policy: "+chk.why);

  const rate=rateOk();
  if(!rate.ok) throw new Error("rate: "+rate.why);

  pending.stage="building"; pending.attempts=(pending.attempts||0)+1; pending.lastAttemptAt=Date.now(); savePending();
  p("Building tx…","ok");

  // always get a fresh blockhash right before signing
  const bh=await conn.getLatestBlockhash("confirmed");
  pending.blockhash=bh.blockhash;
  pending.lastValidBlockHeight=bh.lastValidBlockHeight;

  const tx=new solanaWeb3.Transaction({feePayer:new solanaWeb3.PublicKey(wallet),recentBlockhash:bh.blockhash});
  tx.add(solanaWeb3.SystemProgram.transfer({
    fromPubkey:new solanaWeb3.PublicKey(wallet),
    toPubkey:new solanaWeb3.PublicKey(to),
    lamports
  }));

  pending.stage="signing"; savePending();
  p("Request signature Phantom…","ok");

  let signed;
  try{
    signed=await window.solana.signTransaction(tx);
  }catch(e){
    // user reject
    pending.stage="proposed"; savePending();
    throw new Error("user rejected: "+fmtErr(e));
  }

  pending.stage="sending"; savePending();
  p("Sending tx…","ok");

  let sig=null;
  try{
    sig=await sendWithRetry(signed);
  }catch(e){
    // blockhash expired etc -> fallback one rebuild attempt
    const msg=fmtErr(e);
    p("Send failed, retry rebuild once… ("+msg+")","bad");
    const bh2=await conn.getLatestBlockhash("confirmed");
    pending.blockhash=bh2.blockhash; pending.lastValidBlockHeight=bh2.lastValidBlockHeight;
    const tx2=new solanaWeb3.Transaction({feePayer:new solanaWeb3.PublicKey(wallet),recentBlockhash:bh2.blockhash});
    tx2.add(solanaWeb3.SystemProgram.transfer({fromPubkey:new solanaWeb3.PublicKey(wallet),toPubkey:new solanaWeb3.PublicKey(to),lamports}));
    const signed2=await window.solana.signTransaction(tx2);
    sig=await sendWithRetry(signed2);
  }

  pending.signature=sig;
  pending.stage="confirming"; savePending();
  p("Sent: "+sig+" (confirming "+(policy.confirmCommitment||"finalized")+")","ok");

  await confirmFinalized(sig, pending.blockhash, pending.lastValidBlockHeight);

  pending.stage="done"; savePending();
  p("FINALIZED OK: "+sig,"ok");
}

function bootChecks(){
  if(!window.solanaWeb3) p("WARN: solanaWeb3 missing","bad");
  if(!globalThis.Buffer) p("WARN: Buffer missing (polyfill not loaded)","bad");
  else p("Buffer OK","ok");
}

btnConnect.onclick=async()=>{try{await connect();}catch(e){p(fmtErr(e),"bad");}};
btnDisconnect.onclick=()=>disconnect();
btnARM.onclick=()=>{arm=true;refreshChips();p("ARM ON","ok");};
btnDISARM.onclick=()=>{arm=false;refreshChips();p("ARM OFF","bad");};
btnPropose.onclick=async()=>{try{await propose();}catch(e){p(fmtErr(e),"bad");}};
btnApprove.onclick=async()=>{try{await approve();}catch(e){p(fmtErr(e),"bad");}};
btnClear.onclick=()=>clearPending();
btnReloadPolicy.onclick=async()=>{await loadPolicy();};

(async()=>{
  p("Boot…","ok");
  await loadPolicy();
  loadPending();
  refreshChips();
  bootChecks();
})();
})();

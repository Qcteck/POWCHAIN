#!/usr/bin/env bash
set -euo pipefail

### CONFIG ###
SITE_DIR="/var/www/fireinners.online/aiaquila"
WORKER_URL="https://aiaquila-proxy.YOURSUBDOMAIN.workers.dev"

echo "=== AIAQUILA RSS FINAL FIX (WORKER ONLY) ==="

### 1. Sécurité ###
cd /root || exit 1

### 2. Vérification ###
if [ ! -d "$SITE_DIR" ]; then
  echo "❌ ERREUR: $SITE_DIR introuvable"
  exit 1
fi

### 3. BACKUP FRONTEND ###
TS=$(date +%Y%m%d_%H%M%S)
cp -a "$SITE_DIR" "${SITE_DIR}_backup_$TS"
echo "✔ Backup créé: ${SITE_DIR}_backup_$TS"

### 4. SUPPRESSION PHP RSS ###
find "$SITE_DIR" -type f -name "*.php" -exec rm -f {} \;
echo "✔ Tous les PHP supprimés"

### 5. PATCH JS FRONTEND (force Worker) ###
JS_FILES=$(find "$SITE_DIR" -type f -name "*.js")

for f in $JS_FILES; do
  sed -i \
    -E "s#(rss\.php|rss\.php\?url=|/rss)#${WORKER_URL}?url=#g" \
    "$f"
done

echo "✔ Frontend JS redirigé vers Worker"

### 6. CACHE BUSTER (évite vieux JS) ###
find "$SITE_DIR" -type f -name "*.js" -exec sed -i "1s/^/\/\* patched $TS \*\/\n/" {} \;

### 7. PERMISSIONS ###
chown -R www-data:www-data "$SITE_DIR"
chmod -R 755 "$SITE_DIR"

### 8. RELOAD NGINX ###
nginx -t && systemctl reload nginx
echo "✔ Nginx rechargé"

### 9. TEST DIRECT WORKER ###
echo "=== TEST WORKER DIRECT ==="
curl -s "${WORKER_URL}?url=https://news.bitcoin.com/feed/" | head -c 300
echo
echo "=== FIN TEST ==="

### 10. STATUT ###
echo
echo "✅ AIAQUILA RSS FIX APPLIQUÉ"
echo "➡️ 100% Cloudflare Worker"
echo "➡️ Plus de PHP"
echo "➡️ Plus de faux JSON"
set -euo pipefail
SECRET_PATH="/sentinel1"
APP_DIR="/opt/traderone"
NGX="/etc/nginx/sites-available/fireinners.online-ssl"
HTPASS="/etc/nginx/.htpasswd_sentinel1"
AUTH_USER="sentinel"
AUTH_PASS="Sentinel1"

echo "=== MEGA BATCH / TRADERONE ==="

echo "[0] Checks"
test -f "$NGX" || { echo "NGINX VHOST missing: $NGX"; exit 1; }

echo "[1] Backup nginx vhost"
cp -a "$NGX" "$NGX.bak.$(date +%Y%m%d-%H%M%S)"

echo "[2] Create app dir + placeholder index"
mkdir -p "$APP_DIR"
chmod 755 "$APP_DIR"
cat > "$APP_DIR/index.html" <<'HTML'
<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1"><title>TraderOne Placeholder</title><body style="margin:0;background:#070a12;color:#e9f2ff;font:14px system-ui;padding:16px">Route OK. Remplace /opt/traderone/index.html par ton Trader One complet.</body>
HTML
chmod 644 "$APP_DIR/index.html"

echo "[3] Install htpasswd tool if needed"
command -v htpasswd >/dev/null 2>&1 || { apt-get update -y; apt-get install -y apache2-utils; }

echo "[4] Create htpasswd"
htpasswd -bc "$HTPASS" "$AUTH_USER" "$AUTH_PASS"
chmod 640 "$HTPASS"

echo "[5] Insert location into nginx server block (only if absent)"
if ! grep -q "TRADERONE_SENTINEL1_BEGIN" "$NGX"; then
  tmp="$(mktemp)"
  awk -v sp="$SECRET_PATH" -v ad="$APP_DIR" -v hp="$HTPASS" '
    {lines[NR]=$0}
    END{
      ins="    # TRADERONE_SENTINEL1_BEGIN\n"
      ins=ins "    location ^~ " sp "/ {\n"
      ins=ins "        auth_basic \"Sentinel\";\n"
      ins=ins "        auth_basic_user_file " hp ";\n"
      ins=ins "        alias " ad "/;\n"
      ins=ins "        try_files $uri $uri/ " sp "/index.html;\n"
      ins=ins "        add_header Cache-Control \"no-store\" always;\n"
      ins=ins "    }\n"
      ins=ins "    # TRADERONE_SENTINEL1_END\n"
      last=NR
      for(i=NR;i>=1;i--){
        if(lines[i] ~ /^[[:space:]]*}[[:space:]]*$/){ last=i; break }
      }
      for(i=1;i<=NR;i++){
        if(i==last){ printf "%s", ins }
        print lines[i]
      }
    }
  ' "$NGX" > "$tmp"
  cp -a "$tmp" "$NGX"
  rm -f "$tmp"
else
  echo "Already patched: TRADERONE_SENTINEL1 markers found"
fi

echo "[6] nginx test + reload"
nginx -t
systemctl reload nginx

echo "[7] Local tests"
echo "Expect 401:"
curl -k -sS -I "https://127.0.0.1${SECRET_PATH}/" | sed -n '1,12p' || true
echo
echo "Expect HTML placeholder (200) with auth:"
curl -k -sS -u "${AUTH_USER}:${AUTH_PASS}" "https://127.0.0.1${SECRET_PATH}/" | head -c 220; echo

echo
echo "DONE: https://fireinners.online${SECRET_PATH}/  user=${AUTH_USER} pass








nano /opt/traderone/index.html
# colle ton HTML Trader One complet
nginx -t && systemctl reload nginx

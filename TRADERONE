cat >/tmp/NUKE_INLINE_WOLVERINE_LOCATIONS_IN_VHOST_v2.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"

LINK="/etc/nginx/sites-enabled/fireinners.online-ssl"
VHOST="$(readlink -f "$LINK" 2>/dev/null || echo "$LINK")"

echo "VHOST=$VHOST"
[ -f "$VHOST" ] || { echo "ERROR: vhost not found: $VHOST"; exit 1; }

mkdir -p "/root/backup_vhost_${T}"
cp -a "$VHOST" "/root/backup_vhost_${T}/fireinners.online-ssl.bak"

python3 - <<'PY'
import re

p = r"""'"$VHOST"'"""
s = open(p, "r", encoding="utf-8", errors="ignore").read()

# remove every: location ... /wolverine... { ... }  (brace counting)
out=[]
i=0
n=len(s)
removed=0

pat = re.compile(r'(?m)^[ \t]*location[^\n]*?/wolverine[^\n]*?\{')

while i < n:
    m = pat.search(s, i)
    if not m:
        out.append(s[i:])
        break

    start = m.start()
    out.append(s[i:start])

    j = start
    brace = 0
    in_quote = None
    while j < n:
        ch = s[j]
        if in_quote:
            # close quote if same char and previous is not backslash
            if ch == in_quote and (j == 0 or s[j-1] != chr(92)):
                in_quote = None
        else:
            if ch in ("'", '"'):
                in_quote = ch
            elif ch == '{':
                brace += 1
            elif ch == '}':
                brace -= 1
                if brace == 0:
                    j += 1  # include closing brace
                    break
        j += 1

    removed += 1
    i = j

new_s = ''.join(out)
open(p, "w", encoding="utf-8").write(new_s)
print(f"OK: removed {removed} inline wolverine location block(s) from {p}")
PY

echo "=== nginx test ==="
nginx -t

echo "=== reload ==="
systemctl reload nginx

echo "=== show remaining /wolverine locations (should be only snippet) ==="
nginx -T 2>/dev/null | grep -nE 'location[^\n]*/wolverine' | head -n 80 || true
SH

bash /tmp/NUKE_INLINE_WOLVERINE_LOCATIONS_IN_VHOST_v2.sh
cat >/tmp/WOLVERINE_TRADERONE_INJECT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then . "$ASKLIB"; else
  askorupdate_file(){ local p="$1"; local content="$2"; mkdir -p "$(dirname "$p")"; printf "%s" "$content" >"$p"; }
  askorupdate_yesno(){ local q="$1"; read -r -p "$q (y/N) " a || true; case "${a,,}" in y|yes) return 0;; *) return 1;; esac; }
fi
say(){ printf "%s\n" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: commande manquante: $1"; exit 1; }; }

NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
DEFAULT_WOLV="/opt/fireinners/frontend-react/app/dist/wolverine"
TR_DIR="/opt/traderone-opt"

pick_wolverine_outdir(){
  local out=""
  if [ -f "$NGX_SITE" ]; then
    out="$(awk '
      $1=="location" && $2=="/wolverine" {inloc=1}
      inloc && $1=="alias" {gsub(";","",$2); print $2; exit}
      inloc && $1=="root"  {gsub(";","",$2); print $2 "/wolverine"; exit}
      inloc && $0 ~ /}/ {inloc=0}
    ' "$NGX_SITE" 2>/dev/null || true)"
  fi
  [ -n "${out:-}" ] || out="$DEFAULT_WOLV"
  printf "%s" "$out"
}

pick_traderone_front(){
  local c
  for c in \
    "$TR_DIR" \
    "$TR_DIR/dist" \
    "$TR_DIR/public" \
    "$TR_DIR/frontend/dist" \
    "$TR_DIR/frontend/build" \
    "$TR_DIR/app/dist" \
    "$TR_DIR/www" \
    "$TR_DIR/site" \
    ; do
    if [ -f "$c/index.html" ]; then printf "%s" "$c"; return 0; fi
  done
  local f
  f="$(find "$TR_DIR" -maxdepth 4 -type f -name index.html 2>/dev/null | head -n 1 || true)"
  [ -n "${f:-}" ] || return 1
  dirname "$f"
}

say "=== BATCH FLY (read-only) ==="
say "whoami: $(whoami)  host: $(hostname)  date: $(date -u +%FT%TZ)"
need nginx; need curl; need rsync; need awk; need sed; need grep

OUTDIR="$(pick_wolverine_outdir)"
say "Wolverine OUTDIR: $OUTDIR"

[ -d "$TR_DIR" ] || { say "ERREUR: TraderOne introuvable: $TR_DIR"; exit 1; }
TR_FRONT="$(pick_traderone_front || true)"
[ -n "${TR_FRONT:-}" ] || { say "ERREUR: frontend TraderOne (index.html) introuvable dans $TR_DIR"; exit 1; }
say "TraderOne FRONT: $TR_FRONT"

IDX="$OUTDIR/index.html"
[ -f "$IDX" ] || { say "ERREUR: index introuvable: $IDX"; exit 1; }

say "Ping Wolverine:"
curl -ksS --max-time 5 "https://fireinners.online/wolverine/api/ping" | head -c 120 || true
echo

say "Ce script va:"
say "- copier TraderOne => $OUTDIR/traderone/ (rsync --delete)"
say "- injecter un bouton TraderOne + modal iframe dans $IDX (sans casser ton UI)"
say "- reload nginx (après nginx -t)"
if ! askorupdate_yesno "Continuer ?"; then say "Stop."; exit 0; fi

say "=== MEGA BATCH (apply) ==="
mkdir -p "$OUTDIR/traderone"
rsync -a --delete "$TR_FRONT/." "$OUTDIR/traderone/."

# Injection (idempotent)
MARK="WOLV_TRADERONE_INJECT_V1"
if grep -q "$MARK" "$IDX"; then
  say "Inject déjà présent: OK"
else
  cp -a "$IDX" "$IDX.bak.$(date +%s)"
  INJ='<!-- WOLV_TRADERONE_INJECT_V1 --><style id="wolv_traderone_css">#wolvTO_btn{position:fixed;right:14px;bottom:14px;z-index:99999;border:1px solid rgba(255,255,255,.18);background:rgba(10,18,34,.88);color:#e7f0ff;padding:10px 12px;border-radius:14px;cursor:pointer;font:14px system-ui;backdrop-filter:blur(10px);box-shadow:0 12px 30px rgba(0,0,0,.35)}#wolvTO_btn:hover{filter:brightness(1.08)}#wolvTO_modal{display:none;position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,.72);backdrop-filter:blur(8px)}#wolvTO_card{position:absolute;inset:16px;border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.15);background:#05060b;box-shadow:0 18px 70px rgba(0,0,0,.6)}#wolvTO_ifr{width:100%;height:100%;border:0;background:#05060b}#wolvTO_bar{position:absolute;left:12px;top:12px;right:12px;display:flex;gap:8px;justify-content:flex-end;z-index:2}#wolvTO_bar button{border:1px solid rgba(255,255,255,.18);background:rgba(10,18,34,.88);color:#e7f0ff;padding:8px 10px;border-radius:12px;cursor:pointer;font:13px system-ui}#wolvTO_bar button:hover{filter:brightness(1.08)}</style><div id="wolvTO_modal"><div id="wolvTO_card"><div id="wolvTO_bar"><button id="wolvTO_open">Ouvrir</button><button id="wolvTO_close">Fermer</button></div><iframe id="wolvTO_ifr" src="/wolverine/traderone/"></iframe></div></div><button id="wolvTO_btn">TraderOne</button><script id="wolv_traderone_js">(()=>{const M=document.getElementById("wolvTO_modal"),B=document.getElementById("wolvTO_btn"),C=document.getElementById("wolvTO_close"),O=document.getElementById("wolvTO_open");if(!M||!B||!C||!O)return;const show=()=>{M.style.display="block"};const hide=()=>{M.style.display="none"};B.addEventListener("click",show);C.addEventListener("click",hide);O.addEventListener("click",()=>window.open("/wolverine/traderone/","_blank"));M.addEventListener("click",(e)=>{if(e.target===M)hide()});document.addEventListener("keydown",(e)=>{if(e.key==="Escape")hide()});})();</script>'
  # insère juste avant </body> (ou à la fin si pas trouvé)
  if grep -qi '</body>' "$IDX"; then
    awk -v inj="$INJ" 'BEGIN{IGNORECASE=1} { if($0 ~ /<\/body>/ && !done){print inj; done=1} print } END{ if(!done) print inj }' "$IDX" >"$IDX.tmp"
    mv "$IDX.tmp" "$IDX"
  else
    printf "%s\n" "$INJ" >>"$IDX"
  fi
  say "Injection: OK"
fi

nginx -t
systemctl reload nginx

say "Tests:"
curl -ksS --max-time 6 "https://fireinners.online/wolverine/index.html" | head -c 120 || true
echo
curl -ksS --max-time 6 "https://fireinners.online/wolverine/traderone/" | head -c 120 || true
echo
say "DONE."
SH
chmod +x /tmp/WOLVERINE_TRADERONE_INJECT.sh
bash /tmp/WOLVERINE_TRADERONE_INJECT.sh
cat >/root/fix_buffer_404_force_cdn.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HTML="/var/www/wolverine/index.html"

test -f "$HTML" || { echo "❌ Missing $HTML"; exit 1; }
cp -a "$HTML" "${HTML}.bak_${TS}"

python3 - <<'PY'
from pathlib import Path
import re

p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# 1) kill any local buffer.min.js includes (the 404 you're seeing)
s = re.sub(r'<script[^>]+src=["\'](?:/)?buffer\.min\.js["\'][^>]*>\s*</script>\s*', '', s, flags=re.I)

# 2) remove older polyfill blocks we may have injected
s = re.sub(r'<!--\s*WOLVERINE_BUFFER_POLYFILL\s*-->.*?</script>\s*</script>\s*', '', s, flags=re.S|re.I)

# 3) inject working CDN polyfill EARLY (in <head>)
poly = """
<!-- WOLVERINE_BUFFER_POLYFILL -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js"></script>
<script>
  window.global = window;
  window.process = window.process || { env: {} };
  if (window.buffer && window.buffer.Buffer) window.Buffer = window.buffer.Buffer;
</script>
"""

if "</head>" in s:
    s = s.replace("</head>", poly + "\n</head>", 1)
else:
    s = poly + "\n" + s

p.write_text(s)
print("OK: local buffer.min.js removed + CDN polyfill injected")
PY

systemctl reload nginx || service nginx reload

echo "== ORIGIN check (bypass CF): ensure CDN link is present in HTML =="
curl -sk --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/ \
 | grep -n "cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js" \
 && echo "OK ✅" || echo "NOT FOUND ❌"
BASH

chmod +x /root/fix_buffer_404_force_cdn.sh
/root/fix_buffer_404_force_cdn.sh
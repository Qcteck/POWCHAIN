set -e
cd /root

BASE="https://fireinners.online/wolverine/traderone/api"

echo "=== 1) Test REST (GET) ==="
for p in health ping config status; do
  echo "--- GET $BASE/$p"
  curl -sS -i "$BASE/$p" | head -n 15
  echo
done

echo "=== 2) Test REST (POST /start) ==="
curl -sS -i "$BASE/start" -H "content-type: application/json" --data '{}' | head -n 40
echo

echo "=== 3) Si c’est JSON-RPC, trouver le code serveur (port 12703) ==="
sudo lsof -iTCP:12703 -sTCP:LISTEN -n -P || true
PID=$(sudo lsof -t -iTCP:12703 -sTCP:LISTEN 2>/dev/null | head -n 1 || true)
echo "PID=$PID"
[ -n "$PID" ] && tr '\0' ' ' < "/proc/$PID/cmdline" ; echo

echo "=== 4) Chercher la liste des méthodes dispo dans le code ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git -E "getHealth|method(s)?|/start|/status|/health|/ping" /opt /root 2>/dev/null | head -n 120
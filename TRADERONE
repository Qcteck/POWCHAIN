set -euo pipefail

DOMAIN="fireinners.online"
TEST="/var/www/fireinners-test"
ULT="$TEST/ultimate"
SNIP="/etc/nginx/snippets/fireinners_routes.conf"

echo "=== 0) Trouver le server block Nginx pour $DOMAIN ==="
CONF="$(grep -RIl "server_name.*${DOMAIN}" /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null | head -n 1 || true)"
echo "CONF=$CONF"
[ -n "$CONF" ] || { echo "❌ Impossible de trouver le server block pour $DOMAIN"; exit 1; }

echo "=== 1) Créer le snippet anti-boucle + routes /test + /wolverine ==="
cat > "$SNIP" <<'NGX'
# --- /test : fichiers statiques (PAS de fallback index.html) ---
location = /test { return 301 /test/; }
location ^~ /test/ {
  alias /var/www/fireinners-test/;
  try_files $uri $uri/ =404;
  add_header Cache-Control "no-store" always;
}

# --- /wolverine : exclure API + assets Next du fallback SPA ---
location ^~ /wolverine/api/ {
  # IMPORTANT: ici tu mets ton proxy_pass réel si tu as un backend
  # proxy_pass http://127.0.0.1:PORT/;
  # proxy_set_header Host $host;
  # proxy_set_header X-Real-IP $remote_addr;
  return 200 "ok\n";
  add_header Content-Type text/plain;
}

location ^~ /wolverine/_next/ {
  root /var/www;
  try_files $uri =404;
  add_header Cache-Control "public, max-age=31536000, immutable";
}

location = /favicon.ico {
  try_files /favicon.ico =204;
  access_log off;
}

# fallback SPA UNIQUEMENT pour /wolverine/
location ^~ /wolverine/ {
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
NGX

echo "=== 2) Inclure le snippet dans le server { } si absent ==="
if ! grep -qF "include $SNIP;" "$CONF"; then
  cp -a "$CONF" "$CONF.bak.$(date +%s)"
  # inject juste avant la dernière accolade de fermeture du server block
  awk -v inc="  include $SNIP;" '
    { lines[NR]=$0 }
    END{
      for(i=1;i<=NR;i++){
        if(i==NR){
          # si le dernier char est "}", on insère avant
          if(lines[i] ~ /^[[:space:]]*}[[:space:]]*$/){
            print inc
            print lines[i]
          } else {
            print lines[i]
            print inc
          }
        } else {
          print lines[i]
        }
      }
    }
  ' "$CONF" > "$CONF.tmp"
  mv "$CONF.tmp" "$CONF"
  echo "✅ include ajouté dans $CONF"
else
  echo "✅ include déjà présent"
fi

echo "=== 3) Test + reload Nginx ==="
nginx -t
systemctl reload nginx

echo "=== 4) Retrouver le dernier backup d'images (si /test est vide) ==="
BACK="$(ls -dt /var/www/fireinners-test-backup-* 2>/dev/null | head -n 1 || true)"
echo "BACK=$BACK"

mkdir -p "$ULT"

# Source de blend = images dans /test si présentes, sinon backup
SRC_DIR="$TEST"
CNT_TEST="$(find "$TEST" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) | wc -l || true)"
if [ "${CNT_TEST}" -eq 0 ]; then
  [ -n "$BACK" ] || { echo "❌ /test vide et aucun backup trouvé"; exit 1; }
  SRC_DIR="$BACK"
fi

echo "=== 5) Blend 4K (median) depuis: $SRC_DIR ==="
apt-get update -y
apt-get install -y imagemagick

TMP="/tmp/blend_work"
rm -rf "$TMP"
mkdir -p "$TMP"

i=0
while IFS= read -r f; do
  i=$((i+1))
  printf -v out "$TMP/img_%04d.png" "$i"
  convert "$f" -auto-orient -resize 3840x2160^ -gravity center -extent 3840x2160 "$out"
done < <(find "$SRC_DIR" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) -print | sort)

echo "frames prepared: $i"
[ "$i" -gt 0 ] || { echo "❌ 0 image à fusionner"; exit 1; }

convert "$TMP"/img_*.png -evaluate-sequence median "$ULT/blend_305_4k.png"
rm -rf "$TMP"

cat > "$ULT/index.html" <<'HTML'
<!doctype html><meta charset="utf-8">
<title>ultimate</title>
<ul>
  <li><a href="blend_305_4k.png">blend_305_4k.png</a></li>
</ul>
<img src="blend_305_4k.png" style="max-width:100%;height:auto">
HTML

chown -R www-data:www-data "$ULT" || true
chmod -R a+rX "$ULT" || true

echo "=== 6) Tests locaux (comme l'extérieur) ==="
curl -I https://127.0.0.1/test/ultimate/ --insecure -H "Host: fireinners.online" | head -n 20 || true
curl -I https://127.0.0.1/test/ultimate/blend_305_4k.png --insecure -H "Host: fireinners.online" | head -n 20 || true

echo
echo "✅ OUVRE:"
echo " - https://fireinners.online/test/ultimate/"
echo " - https://fireinners.online/test/ultimate/blend_305_4k.png"
echo "FICHIER:"
ls -lah "$ULT/blend_305_4k.png"
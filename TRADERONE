cat >"$PY" <<PY
from pathlib import Path
import re

WEBROOT="${WEBROOT}"
INC="${INC}"
DOMAIN="${DOMAIN}"

BEGIN="# WOLVERINE_BEGIN"
END="# WOLVERINE_END"

block = f"""{BEGIN}
# Wolverine UI (static)
location = /wolverine {{ return 301 /wolverine/; }}
location ^~ /wolverine/ {{
  alias {WEBROOT}/;
  try_files \\$uri \\$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}}
# Disable SW/manifest (avoid stale cache)
location = /wolverine/sw.js {{ add_header Cache-Control "no-store" always; return 404; }}
location = /wolverine/service-worker.js {{ add_header Cache-Control "no-store" always; return 404; }}
location = /wolverine/manifest.json {{ add_header Cache-Control "no-store" always; return 404; }}

# API routes
include {INC};
{END}
"""

def patch_file(fp: Path):
    s = fp.read_text(errors="ignore")
    if DOMAIN not in s:
        return False
    # patch every server { } that contains "server_name ... DOMAIN"
    out = []
    i = 0
    changed = False

    # If already has block markers, replace globally
    if BEGIN in s and END in s:
        pre = s.split(BEGIN)[0]
        post = s.split(END,1)[1]
        fp.write_text(pre + block + post)
        return True

    # otherwise, inject into each matching server block
    pattern = re.compile(r"server\\s*\\{", re.I)
    pos = 0
    while True:
        m = pattern.search(s, pos)
        if not m:
            out.append(s[pos:])
            break
        start = m.start()
        out.append(s[pos:start])
        # find matching braces for this server block
        j = m.end()
        brace = 1
        while j < len(s) and brace:
            if s[j] == "{": brace += 1
            elif s[j] == "}": brace -= 1
            j += 1
        server_block = s[start:j]
        pos = j

        if ("server_name" in server_block) and (DOMAIN in server_block):
            # inject before last "}" of this server block
            server_block = server_block[:-1] + "\\n" + block + "\\n}\\n"
            changed = True

        out.append(server_block)

    if changed:
        fp.write_text("".join(out))
    return changed

targets = []
for root in [Path("/etc/nginx/sites-available"), Path("/etc/nginx/sites-enabled")]:
    if root.exists():
        for fp in root.iterdir():
            if fp.is_file():
                try:
                    if patch_file(fp):
                        targets.append(str(fp))
                except Exception:
                    pass

print("patched:", len(targets))
for t in targets[:50]:
    print(" -", t)
PY


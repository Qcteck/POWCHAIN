set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== 1) Preuve: est-ce qu'un snippets.bak est chargé ? ==="
nginx -T 2>/dev/null | grep -n "snippets\.bak" | head -n 120 || echo "OK: aucun snippets.bak chargé (nginx -T)"

echo
echo "=== 2) Trouver les includes dangereux (snippets*) ==="
grep -RIn --include="*.conf" -E 'include\s+/etc/nginx/snippets\*' /etc/nginx || echo "OK: aucun include /etc/nginx/snippets* trouvé"

echo
echo "=== 3) Fix auto (seulement si on en trouve) ==="
mapfile -t BADFILES < <(grep -RIl --include="*.conf" -E 'include\s+/etc/nginx/snippets\*' /etc/nginx || true)

if [ "${#BADFILES[@]}" -eq 0 ]; then
  echo "✅ Rien à corriger (pas de include snippets*)"
else
  for f in "${BADFILES[@]}"; do
    echo "Fixing: $f"
    cp -a "$f" "$f.bak.fix_snippets_glob.$TS"
    sed -i -E 's|include[[:space:]]+/etc/nginx/snippets\*[^;]*;|include /etc/nginx/snippets/*.conf;|g' "$f"
  done
fi

echo
echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 5) Recheck snippets.bak ==="
nginx -T 2>/dev/null | grep -n "snippets\.bak" | head -n 80 || echo "✅ OK: snippets.bak n'est pas inclus"
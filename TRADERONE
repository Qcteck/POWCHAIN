### 1) VERIFY ENV
grep -q "SOLANA_PRIVATE_KEY_BASE58" "$ENV_FILE" || { echo "[ERR] clé privée interne absente"; exit 1; }

### 2) BACKEND PATCH
cat > /opt/traderone/server.js <<'JS'
const http=require("http");
const {Connection,Keypair,PublicKey,LAMPORTS_PER_SOL,SystemProgram,Transaction}=require("@solana/web3.js");
require("dotenv").config();

const conn=new Connection("https://api.mainnet-beta.solana.com","confirmed");
const kp=Keypair.fromSecretKey(Buffer.from(require("bs58").decode(process.env.SOLANA_PRIVATE_KEY_BASE58)));

let STATE={running:false,locked:0};

async function sol(pub){return (await conn.getBalance(new PublicKey(pub)))/LAMPORTS_PER_SOL;}

http.createServer(async(req,res)=>{
res.setHeader("content-type","application/json");

if(req.url==="/api/balances"){
 const phantom=req.headers["x-phantom"];
 res.end(JSON.stringify({
  internal:await sol(kp.publicKey),
  phantom:phantom?await sol(phantom):null,
  running:STATE.running,
  locked:STATE.locked
 }));
 return;
}

if(req.url==="/api/start"&&req.method==="POST"){
 let b="";req.on("data",d=>b+=d);
 req.on("end",async()=>{
  const {phantom,amount}=JSON.parse(b||"{}");
  if(STATE.running)return res.end(JSON.stringify({err:"already running"}));
  if(!phantom||!amount||amount<=0)return res.end(JSON.stringify({err:"invalid"}));
  const bal=await sol(phantom);
  if(bal<amount)return res.end(JSON.stringify({err:"insufficient"}));
  STATE.running=true;STATE.locked=amount;
  res.end(JSON.stringify({ok:true}));
 });
 return;
}

if(req.url==="/api/stop"){
 STATE.running=false;STATE.locked=0;
 res.end(JSON.stringify({ok:true}));
 return;
}

if(req.url==="/api/cashout"&&req.method==="POST"){
 STATE.running=false;STATE.locked=0;
 res.end(JSON.stringify({ok:true}));
 return;
}

res.statusCode=404;res.end("{}");
}).listen(3000);
JS

pm2 restart traderone
pm2 save


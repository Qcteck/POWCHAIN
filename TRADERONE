set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
[ -f "$NG" ] || { echo "KO: $NG introuvable"; exit 1; }

echo "=== 0) Backup nginx conf ==="
cp -a "$NG" "$NG.bak.$(date +%s)"

echo "=== 1) Ajouter /wolverine (UI) + /wolverine/traderone/api (proxy API) si absent ==="
grep -q "location ^~ /wolverine/traderone/api/" "$NG" || cat >> "$NG" <<'NGINX'

# --- Wolverine UI ---
location ^~ /wolverine/ {
  # si tu as un build front (vite/react) dans /var/www/wolverine
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
}

# --- TraderOne API behind /wolverine/traderone/api ---
location ^~ /wolverine/traderone/api/ {
  # /wolverine/traderone/api/foo  ->  /api/foo sur Node
  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;

  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
NGINX

echo "=== 2) Test + reload nginx ==="
nginx -t
systemctl reload nginx
echo "OK: nginx reloaded"

echo "=== 3) Tests ==="
curl -sS -i https://fireinners.online/wolverine/ | head -n 15 || true
echo
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 20 || true
echo
curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes | head -n 25 || true
cat >/tmp/wolfchain_fix_api_online.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ROOT="/opt/fireinners/frontend-react/app/dist"
ts(){ date +"%Y%m%d-%H%M%S"; }
TS="$(ts)"
bk(){ [ -f "$1" ] && cp -a "$1" "$1.bak.$TS" && echo "backup: $1.bak.$TS" || true; }
imut_off(){ command -v lsattr >/dev/null 2>&1 && command -v chattr >/dev/null 2>&1 || return 0; [ -e "$1" ] || return 0; lsattr "$1" 2>/dev/null | grep -q '\-i\-' && chattr -i "$1" 2>/dev/null || true; }

echo "ROOT=$ROOT"
mkdir -p "$ROOT/stats"

# create /stats/index.json (this is what the homepage pings)
imut_off "$ROOT/stats/index.json"; bk "$ROOT/stats/index.json"
cat >"$ROOT/stats/index.json" <<'JSON'
{"ok":true,"service":"fireinners-static-stats","note":"UI heartbeat file. Replace with real backend later if desired."}
JSON

# optional: human page
imut_off "$ROOT/stats/index.html"; bk "$ROOT/stats/index.html"
cat >"$ROOT/stats/index.html" <<'HTML'
<!doctype html><meta charset="utf-8"><title>stats</title><pre>{"ok":true}</pre>
HTML

chmod 755 "$ROOT/stats"
chmod 644 "$ROOT/stats/index.json" "$ROOT/stats/index.html"

echo
echo "== TEST (nginx) /stats/index.json =="
curl -k -sS -i "https://127.0.0.1/stats/index.json" -H "Host: fireinners.online" | sed -n '1,20p'

echo
echo "If you see HTTP/2 200 or HTTP/1.1 200 above, your UI will show API online."
SH
bash /tmp/wolfchain_fix_api_online.sh 
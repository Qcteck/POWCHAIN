<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CERVEAU++ • Qualités (F/C/S/H) • NEURONEONE • STRUCTUREONE</title><style>html,body{margin:0;height:100%;background:#0b0f14;color:#e8eef7;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial}*{box-sizing:border-box}a{color:#8fd3ff;text-decoration:none}button,input,textarea,select{background:#111a24;color:#e8eef7;border:1px solid #243246;border-radius:10px;padding:10px}button{cursor:pointer}button:hover{border-color:#3b5678}textarea{width:100%;min-height:105px;resize:vertical}header{padding:14px 16px;border-bottom:1px solid #1b2635;display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap}header .left{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.tag{font-size:12px;opacity:.9;border:1px solid #243246;padding:6px 10px;border-radius:999px}.pill{font-size:11px;border:1px solid #243246;padding:5px 9px;border-radius:999px;opacity:.95}.ok{color:#72ffb0}.bad{color:#ff7a7a}.warn{color:#ffd67a}.muted{opacity:.7}main{display:grid;grid-template-columns:1.1fr 1fr;gap:12px;padding:12px;height:calc(100% - 80px)}@media(max-width:1050px){main{grid-template-columns:1fr}}.card{border:1px solid #1b2635;border-radius:16px;background:#0f1620;overflow:hidden;display:flex;flex-direction:column;min-height:0}.card h2{margin:0;padding:12px;border-bottom:1px solid #1b2635;font-size:13px;letter-spacing:.3px;text-transform:uppercase;opacity:.92;display:flex;align-items:center;justify-content:space-between;gap:10px}.body{padding:12px;display:flex;flex-direction:column;gap:10px;min-height:0}.row{display:flex;gap:10px;flex-wrap:wrap}.row>*{flex:1 1 240px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;min-height:0}@media(max-width:850px){.grid2{grid-template-columns:1fr}}.log{background:#0b0f14;border:1px solid #1b2635;border-radius:12px;padding:10px;overflow:auto;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;white-space:pre-wrap;max-height:280px}.log.tall{max-height:540px}.tabs{display:flex;gap:8px;flex-wrap:wrap}.tab{padding:8px 10px;border-radius:999px;border:1px solid #243246;background:#0c141f;font-size:12px;opacity:.9;cursor:pointer;user-select:none}.tab.active{border-color:#5c87b6;opacity:1}label{font-size:12px;opacity:.85}small{opacity:.8}input[type="range"]{width:100%}.kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}@media(max-width:980px){.kpi{grid-template-columns:1fr 1fr}}.kbox{border:1px solid #1b2635;border-radius:14px;background:#0c141f;padding:10px}.kbox .v{font-size:18px;font-weight:700;margin-top:6px}.kbox .t{font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.3px}.sep{height:1px;background:#1b2635;margin:4px 0}</style></head><body><header><div class="left"><div class="tag">CERVEAU++ • Qualités Fonctionnelles/Cognitives/Systémiques/Humaines</div><div class="tag">NEURONEONE (Vault) • STRUCTUREONE (Graphe)</div><span class="pill" id="statePill">IDLE</span><span class="pill" id="armPill">ARM:OFF</span><span class="pill" id="llmPill">LLM:OFF</span><span class="pill" id="qcPill">Q:—</span></div><div class="left"><button id="btnDiag">Diagnostic</button><button id="btnExport">Exporter</button><button id="btnImport">Importer</button><button id="btnReset">Reset</button></div></header><main><section class="card"><h2><span>Entrée / Routage / LLM / Sortie</span><span class="pill" id="routePill">AUTO</span></h2><div class="body"><div class="row"><div><label>Texte</label><textarea id="inputText" placeholder="Demande / objectif / contexte."></textarea><div class="row"><select id="routeMode"><option value="auto">AUTO</option><option value="left">GAUCHE</option><option value="right">DROIT</option><option value="both">BOTH</option></select><button id="btnRun">Exécuter</button><button id="btnApprove">Approuver (ARM)</button><button id="btnTick">Tick</button></div><small class="muted">Sans endpoint LLM: diagnostics
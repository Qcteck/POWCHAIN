cat >/tmp/WOLVERINE_FIND_AND_WRITE_FRONT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%s)"

# candidate docroots
CANDIDATES=(
  "/var/www/fireinners/wolverine"
  "/var/www/fireinners.online/wolverine"
  "/var/www/html/wolverine"
)

# try to detect root from nginx
ROOT_FROM_NGINX="$(nginx -T 2>/dev/null | awk '
  $0 ~ /location \/wolverine/ {inloc=1}
  inloc && $1=="root" {gsub(";","",$2); print $2; exit}
  inloc && $1=="alias" {gsub(";","",$2); print $2; exit}
  inloc && $0 ~ /}/ {inloc=0}
')"

if [ -n "${ROOT_FROM_NGINX:-}" ]; then
  # if root points to something like /var/www/site, actual path is /var/www/site/wolverine
  if [ -d "$ROOT_FROM_NGINX/wolverine" ]; then
    DOCROOT="$ROOT_FROM_NGINX/wolverine"
  else
    DOCROOT="$ROOT_FROM_NGINX"
  fi
else
  DOCROOT=""
fi

# fallback
if [ -z "${DOCROOT:-}" ]; then
  for d in "${CANDIDATES[@]}"; do
    if [ -d "$d" ]; then DOCROOT="$d"; break; fi
  done
fi

[ -n "${DOCROOT:-}" ] || { echo "ERROR: docroot wolverine introuvable"; exit 1; }
mkdir -p "$DOCROOT"

echo "DOCROOT=$DOCROOT"

cp -a "$DOCROOT/index.html" "$DOCROOT/index.html.bak.$TS" 2>/dev/null || true
cp -a "$DOCROOT/app.js" "$DOCROOT/app.js.bak.$TS" 2>/dev/null || true

cat >"$DOCROOT/index.html" <<HTML
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>WOLVERINE</title>
</head>
<body>
  <h1>WOLVERINE</h1>

  <div>
    <b>Wallet utilisateur (Phantom)</b><br/>
    SOL: <span id="uSol">—</span> | USDC: <span id="uUsdc">—</span>
  </div>
  <br/>
  <div>
    <b>Wallet TraderOne (bot)</b><br/>
    Adresse: <span id="tAddr">—</span><br/>
    SOL: <span id="tSol">—</span> | USDC: <span id="tUsdc">—</span>
  </div>

  <br/>
  <button id="btnConnect">Connect Wallet (Phantom)</button>

  <div id="afterConnect" style="display:none;margin-top:12px;">
    <div>Budget (sera ENVOYÉ à TraderOne)</div>
    <input id="budget" type="number" step="0.000001" min="0" placeholder="Ex: 1">
    <button id="btnRefresh" style="margin-top:10px;">Refresh soldes</button>
    <button id="btnStart" disabled style="margin-top:10px;">START WOLVERINE (TraderOne)</button>
    <div>Status: <span id="statusText">—</span></div>
  </div>

  <script src="./solana-web3.min.js?v=$TS"></script>
  <script src="./app.js?v=$TS"></script>
</body>
</html>
HTML

cat >"$DOCROOT/app.js" <<'JS'
const API_BALANCES2 = "/wolverine/traderone/api/balances2";
const API_START     = "/wolverine/traderone/api/start";

const btnConnect=document.getElementById("btnConnect");
const afterConnect=document.getElementById("afterConnect");
const btnRefresh=document.getElementById("btnRefresh");
const btnStart=document.getElementById("btnStart");
const budgetEl=document.getElementById("budget");
const statusText=document.getElementById("statusText");

const uSol=document.getElementById("uSol");
const uUsdc=document.getElementById("uUsdc");
const tSol=document.getElementById("tSol");
const tUsdc=document.getElementById("tUsdc");
const tAddr=document.getElementById("tAddr");

let pubkey=null;
let traderWallet=null;

function setStatus(t){ statusText.textContent=t; }
function n(x){ const v=Number(x); return Number.isFinite(v)?v:0; }
function canStart(){ return pubkey && traderWallet && n(budgetEl.value)>0; }

async function refreshBoth(){
  if(!pubkey) return;
  const r = await fetch(`${API_BALANCES2}?wallet=${encodeURIComponent(pubkey.toString())}`, {cache:"no-store"});
  const d = await r.json().catch(()=>({}));
  if(!r.ok) throw new Error(d?.error || ("HTTP "+r.status));
  traderWallet = d.traderWallet || null;

  uSol.textContent  = Number(d.user?.sol ?? 0).toFixed(6);
  uUsdc.textContent = Number(d.user?.usdc ?? 0).toFixed(4);
  tSol.textContent  = Number(d.trader?.sol ?? 0).toFixed(6);
  tUsdc.textContent = Number(d.trader?.usdc ?? 0).toFixed(4);
  tAddr.textContent = traderWallet || "—";

  btnStart.disabled = !canStart();
  setStatus("OK");
}

btnConnect.onclick=async ()=>{
  if(!window.solana?.isPhantom) { setStatus("Phantom non détecté"); return; }
  const r=await window.solana.connect();
  pubkey=r.publicKey;
  afterConnect.style.display="block";
  await refreshBoth();
};

budgetEl.oninput=()=>{ btnStart.disabled=!canStart(); };
btnRefresh.onclick=()=>refreshBoth().catch(e=>setStatus("ERR "+e.message));

btnStart.onclick=async ()=>{
  // ici tu gardes TON flow actuel (build tx / confirm / etc.)
  // on laisse juste le bouton activable quand balances2 OK
  await fetch(API_START,{method:"POST"});
  setStatus("START envoyé");
};
JS

chmod 644 "$DOCROOT/index.html" "$DOCROOT/app.js"
nginx -t && systemctl reload nginx
echo "OK -> https://fireinners.online/wolverine/?v=$TS"
SH

bash /tmp/WOLVERINE_FIND_AND_WRITE_FRONT.sh
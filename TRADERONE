cat >/root/MEGA_AQUILA_STACKING_ROUTEFIX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILA_STACKING_ROUTEFIX_BK_$TS"
mkdir -p "$BK"
umask 022

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ echo "ERR: $*" >&2; exit 1; }

DOMAIN="fireinners.online"
PATH_APP="/aquilastacking"
WEBROOT="/var/www/aquilastacking"
INC="/etc/nginx/includes/aquilastacking_routes.inc"
NGINX_MAIN="/etc/nginx/nginx.conf"

backup_one(){ local p="$1"; [ -e "$p" ] || return 0; mkdir -p "$BK$(dirname "$p")"; cp -a "$p" "$BK$p.bak" 2>/dev/null || true; }
lsattr_safe(){ lsattr "$1" 2>/dev/null | awk '{print $1}' || echo ""; }
unfreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; local a; a="$(lsattr_safe "$f")"; if echo "$a" | grep -q 'i'; then say "UNFREEZE: chattr -i $f"; chattr -i "$f" 2>/dev/null || true; fi; }
refreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; say "REFREEZE: chattr +i $f"; chattr +i "$f" 2>/dev/null || true; }

ensure_packages(){
  say "Packages (curl/unzip/nginx/python3 if missing)"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y >/dev/null || true
  for p in curl unzip nginx python3; do dpkg -s "$p" >/dev/null 2>&1 || apt-get install -y "$p" >/dev/null; done
}

write_include(){
  say "Write include: $INC"
  mkdir -p "$(dirname "$INC")"
  backup_one "$INC"
  cat >"$INC" <<EOF
# AQUILA_STACKING (managed) - $TS
location = ${PATH_APP} { return 301 ${PATH_APP}/; }
location ^~ ${PATH_APP}/ {
  alias ${WEBROOT}/;
  index index.html;
  try_files \$uri \$uri/ ${PATH_APP}/index.html;
  add_header Cache-Control "no-store" always;
}
location = ${PATH_APP}/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = ${PATH_APP}/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = ${PATH_APP}/manifest.json { add_header Cache-Control "no-store" always; return 404; }
EOF
  chmod 644 "$INC" || true
}

ensure_webroot(){
  say "Ensure webroot: $WEBROOT"
  mkdir -p "$WEBROOT"
  if [ ! -f "$WEBROOT/index.html" ]; then
    cat >"$WEBROOT/index.html" <<'HTML'
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Aquila Stacking</title></head><body style="margin:0;background:#071022;color:#d7f0ff;font-family:system-ui,Segoe UI,Roboto,Arial"><div style="padding:18px"><h2 style="margin:0 0 10px">Aquila Stacking</h2><div>OK — route /aquilastacking/ servie.</div></div></body></html>
HTML
    chmod 644 "$WEBROOT/index.html" || true
  fi
}

# Find the real active server block file(s) for DOMAIN from `nginx -T`
find_server_files(){
  say "Detect active server file(s) for ${DOMAIN} via nginx -T"
  nginx -T 2>/dev/null | python3 - "$DOMAIN" <<'PY'
import sys,re
dom=sys.argv[1].strip()
txt=sys.stdin.read().splitlines()

cur_file=None
servers=[]
i=0
while i<len(txt):
  line=txt[i]
  m=re.match(r'#\s*configuration file\s+(\S+):\d+', line)
  if m: cur_file=m.group(1)
  if re.search(r'\bserver\s*\{', line):
    start_i=i
    depth=0
    j=i
    block=[]
    while j<len(txt):
      l=txt[j]
      if re.match(r'#\s*configuration file\s+\S+:\d+', l):
        pass
      if '{' in l: depth += l.count('{')
      if '}' in l: depth -= l.count('}')
      block.append(l)
      if depth<=0 and j>start_i:
        break
      j+=1
    b="\n".join(block)
    if re.search(r'^\s*server_name\s+[^;]*\b'+re.escape(dom)+r'\b', b, re.M):
      servers.append(cur_file or "")
    i=j
  i+=1

# output unique, non-empty
out=[]
for f in servers:
  if f and f not in out: out.append(f)
print("\n".join(out))
PY
}

patch_server_file(){
  local f="$1"
  [ -f "$f" ] || die "Missing server file: $f"
  say "Patch server file: $f (remove old include + inject include into server_name ${DOMAIN})"
  backup_one "$f"
  python3 - "$f" "$INC" "$DOMAIN" <<'PY'
import sys,re
p,inc,dom=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(p,'r',encoding='utf-8',errors='ignore').read()

# remove any existing include lines for aquilastacking_routes.inc anywhere
s=re.sub(r'^\s*include\s+.*aquilastacking_routes\.inc\s*;\s*\n','',s,flags=re.M)

# find ALL server blocks in this file, and inject include into those that match server_name dom
# naive brace matching (nginx conf style) but good enough
out=[]
i=0
while True:
  m=re.search(r'\bserver\s*\{', s[i:])
  if not m:
    out.append(s[i:])
    break
  a=i+m.start()
  b=i+m.end()
  out.append(s[i:a])
  # find matching }
  j=b
  depth=1
  while j<len(s) and depth>0:
    ch=s[j]
    if ch=='#': # comment to EOL
      k=s.find('\n', j)
      j = len(s) if k==-1 else k+1
      continue
    if ch=='{': depth+=1
    elif ch=='}': depth-=1
    j+=1
  block=s[a:j]
  if re.search(r'^\s*server_name\s+[^;]*\b'+re.escape(dom)+r'\b', block, re.M):
    # inject include before final }
    ins=f"\n  include {inc};\n"
    block=re.sub(r'\}\s*$', ins+"}\n", block, count=1)
  out.append(block)
  i=j

open(p,'w',encoding='utf-8').write(''.join(out))
PY
}

main(){
  say "BEGIN AQUILA STACKING ROUTEFIX @ $TS"
  say "BK: $BK"

  ensure_packages

  # unfreeze core nginx + include
  unfreeze_one "$NGINX_MAIN"
  unfreeze_one "$INC"

  # also unfreeze every nginx file that might be involved
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    unfreeze_one "$f"
  done < <(find /etc/nginx -maxdepth 3 -type f 2>/dev/null | head -n 5000)

  ensure_webroot
  write_include

  # patch ONLY the real server file(s) that actually serve DOMAIN
  files="$(find_server_files || true)"
  if [ -z "${files// }" ]; then
    say "No server file detected for ${DOMAIN}. Showing nginx -T hints:"
    nginx -T 2>/dev/null | grep -n "server_name.*${DOMAIN}" | head -n 50 || true
    die "Cannot locate active server block for ${DOMAIN}"
  fi

  while IFS= read -r f; do
    [ -n "$f" ] || continue
    patch_server_file "$f"
  done <<<"$files"

  say "nginx -t"
  nginx -t

  say "reload nginx"
  systemctl reload nginx || service nginx reload || true

  # refreeze core
  refreeze_one "$NGINX_MAIN"
  refreeze_one "$INC"
  while IFS= read -r f; do [ -n "$f" ] || continue; refreeze_one "$f"; done <<<"$files"

  say "ORIGIN CHECK (bypass Cloudflare via --resolve)"
  curl -k -sS -I --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_APP}/" | head -n 30 || true

  say "PUBLIC CHECK"
  curl -sS -I "https://${DOMAIN}${PATH_APP}/" | head -n 30 || true

  say "OPEN: https://${DOMAIN}${PATH_APP}/ (Ctrl+F5)"
  say "DONE"
}

main "$@"
SH
chmod +x /root/MEGA_AQUILA_STACKING_ROUTEFIX.sh
bash /root/MEGA_AQUILA_STACKING_ROUTEFIX.sh
cat >/root/REMOVE_SHARE_PATCH.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

PATCH_JS_NAME="patch_hide_share.js"

cat >/tmp/$PATCH_JS_NAME <<'JS'
(()=>{"use strict";
const $$=s=>Array.from(document.querySelectorAll(s));
const txt=el=>(el?.textContent||"").trim().toLowerCase();

function isShareButton(el){
  if(!el) return false;
  const t=txt(el);
  const id=(el.id||"").toLowerCase();
  const cls=(el.className||"").toString().toLowerCase();
  return t==="partager" || t.includes("share") || t.includes("partager")
      || id.includes("share") || id.includes("partager")
      || cls.includes("share") || cls.includes("partager");
}
function hide(el){
  if(!el) return;
  el.style.display="none";
  el.style.visibility="hidden";
  el.style.pointerEvents="none";
}

function killShareUI(){
  // Cache boutons Share/Partager
  for(const el of $$("button,a,div,span")) if(isShareButton(el)) hide(el);

  // Cache la popup (Facebook / X / Telegram / WhatsApp / Copier lien / Fermer)
  for(const box of $$("div,section,dialog")){
    const t=txt(box);
    if(t.includes("facebook") && (t.includes("telegram") || t.includes("whatsapp")) && (t.includes("copier") || t.includes("copy"))){
      hide(box);
      hide(box.parentElement);
    }
  }

  // Bloque clics sur share
  document.addEventListener("click",(e)=>{
    const path = e.composedPath ? e.composedPath() : [];
    for(const el of path){
      if(el && isShareButton(el)){
        e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
        return false;
      }
    }
  }, true);
}

new MutationObserver(killShareUI).observe(document.documentElement,{childList:true,subtree:true});
if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",killShareUI);
else killShareUI();
})();
JS

TARGET_DIR=""
for d in \
  /opt/fireinners/frontend-react/app/dist/wolverine \
  /var/www/fireinners/wolverine \
  /var/www/wolverine \
  /opt/traderone-opt/public \
  /srv/www \
  /var/www/html
do
  if [ -d "$d" ]; then TARGET_DIR="$d"; break; fi
done

[ -n "$TARGET_DIR" ] || { echo "ERR: dossier web introuvable"; exit 1; }

mkdir -p "$TARGET_DIR/patches"
cp /tmp/$PATCH_JS_NAME "$TARGET_DIR/patches/$PATCH_JS_NAME"
echo "OK: patch copié -> $TARGET_DIR/patches/$PATCH_JS_NAME"

shopt -s nullglob
for f in "$TARGET_DIR"/*.html "$TARGET_DIR"/*/*.html; do
  [ -f "$f" ] || continue
  grep -q "patches/$PATCH_JS_NAME" "$f" && continue
  if grep -qi "</body>" "$f"; then
    sed -i "s#</body>#\n<script src=\"patches/$PATCH_JS_NAME\"></script>\n</body>#i" "$f"
    echo "PATCH HTML -> $f"
  else
    printf '\n<script src="patches/%s"></script>\n' "$PATCH_JS_NAME" >> "$f"
    echo "PATCH HTML (append) -> $f"
  fi
done

echo "DONE. Recharge en dur: Ctrl+F5."
BASH

bash /root/REMOVE_SHARE_PATCH.sh
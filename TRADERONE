cat >/root/WOLV_FIND_SIGNER_PORT_STRONG.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== qplus-signer.service details ==="
systemctl is-active --quiet qplus-signer.service && echo "ACTIVE ✅" || echo "NOT ACTIVE ❌"
systemctl show qplus-signer.service -p MainPID -p WorkingDirectory -p ExecStart --no-pager
echo

MPID="$(systemctl show -p MainPID --value qplus-signer.service 2>/dev/null || true)"
WD="$(systemctl show -p WorkingDirectory --value qplus-signer.service 2>/dev/null || true)"
EXE="$(systemctl show -p ExecStart --value qplus-signer.service 2>/dev/null || true)"
echo "MainPID=$MPID"
echo "WD=${WD:-unknown}"
echo "ExecStart=${EXE:-unknown}"
echo

echo "=== Listening sockets for MainPID (ss) ==="
if [ -n "${MPID:-}" ] && [ "$MPID" != "0" ]; then
  ss -lptn 2>/dev/null | grep -F "pid=$MPID" || true
else
  echo "No MainPID (0) -> service may be Type=oneshot or wrapper"
fi
echo

echo "=== lsof network for MainPID ==="
if command -v lsof >/dev/null 2>&1 && [ -n "${MPID:-}" ] && [ "$MPID" != "0" ]; then
  lsof -Pan -p "$MPID" -i 2>/dev/null || true
else
  echo "lsof missing or MainPID=0"
fi
echo

echo "=== Guess port from ExecStart (common flags) ==="
PORT_FROM_EXEC=""
if echo "$EXE" | grep -Eoq '(--port|PORT=|:)[0-9]{2,5}'; then
  PORT_FROM_EXEC="$(echo "$EXE" | grep -Eo '([0-9]{2,5})' | tail -n1 || true)"
fi
echo "PORT_FROM_EXEC=${PORT_FROM_EXEC:-none}"
echo

echo "=== Scan common signer ports for /health or / ==="
FOUND=""
for p in ${PORT_FROM_EXEC:-} 8787 8788 9000 9010 5001 4001 3003 3333; do
  [ -n "$p" ] || continue
  if curl -sS --max-time 1 "http://127.0.0.1:$p/health" >/dev/null 2>&1 || \
     curl -sS --max-time 1 "http://127.0.0.1:$p/" >/dev/null 2>&1; then
    FOUND="$p"; break
  fi
done
echo "SIGNER_PORT=${FOUND:-NOT_FOUND}"
echo

echo "=== If still NOT_FOUND, show last logs ==="
if [ -z "${FOUND:-}" ]; then
  journalctl -u qplus-signer.service -n 80 --no-pager || true
fi
BASH

bash /root/WOLV_FIND_SIGNER_PORT_STRONG.sh
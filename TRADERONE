rm -f /tmp/WOLVERINE_TG_FIX_AUTODETECT.sh;cat >/tmp/WOLVERINE_TG_FIX_AUTODETECT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
DIR="/opt/fireinners/wolverine-telegram"
SERVICE="wolverine-tg-sentinel"
say(){ printf "%s\n" "$*"; }
say "=== PRE-FLIGHT (read-only) ==="
date -u; hostname; whoami
command -v curl >/dev/null || { say "ERREUR: curl manquant"; exit 1; }
mkdir -p "$DIR"; chmod 700 "$DIR"
say "DIR: $DIR"
say "ENV: $ENV"
say "SERVICE: $SERVICE (enabled=$(systemctl is-enabled "$SERVICE" 2>/dev/null || echo no))"
say "================================"
read -r -p "Continuer et mettre a jour Telegram? (y/N) " ans || true
case "${ans,,}" in y|yes) ;; *) say "Stop."; exit 0;; esac
read -r -s -p "COLLE LE NOUVEAU TG_TOKEN puis ENTER (rien ne s'affiche): " TG_TOKEN; echo
TG_TOKEN="$(printf '%s' "$TG_TOKEN" | tr -d '\r' | tr -d ' ')"
[ -n "$TG_TOKEN" ] || { say "ERREUR: token vide"; exit 1; }
say "Auto-detect chat_id via getUpdates (tu dois avoir envoye 'ping' au bot)..."
UPD="$(curl -sS --max-time 12 "https://api.telegram.org/bot${TG_TOKEN}/getUpdates?timeout=0&limit=20" || true)"
CID="$(printf '%s' "$UPD" | tr -d '\n' | grep -oE '"chat":\{"id":[-0-9]+' | tail -n1 | grep -oE '[-0-9]+$' || true)"
if [ -z "${CID:-}" ]; then
  say "ERREUR: aucun chat_id detecte."
  say "ACTION: sur Telegram, ouvre le bot, clique Start, envoie 'ping', puis relance le batch."
  exit 1
fi
say "OK: chat_id detecte = $CID"
say "tokenlen=${#TG_TOKEN}"
systemctl stop "$SERVICE" 2>/dev/null || true
[ -f "$ENV" ] && cp -a "$ENV" "$ENV.bak.$(date +%s)" || true
umask 077
printf "TG_TOKEN=%s\nTG_CHAT_ID=%s\n" "$TG_TOKEN" "$CID" >"$ENV"
chmod 600 "$ENV"
say "--- test getMe ---"
ME="$(curl -sS --max-time 10 "https://api.telegram.org/bot${TG_TOKEN}/getMe" | head -c 600 || true)"
say "$ME"
printf '%s' "$ME" | grep -q '"ok":true' || { say "ERREUR: getMe pas ok:true (token invalide?)"; exit 1; }
say "--- test sendMessage ---"
SM="$(curl -sS --max-time 10 -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" -d "chat_id=${CID}" -d "text=WOLVERINE: TEST DIRECT OK $(date -u +%Y-%m-%dT%H:%M:%SZ)" -d "disable_web_page_preview=true" | head -c 900 || true)"
say "$SM"
printf '%s' "$SM" | grep -q '"ok":true' || { say "ERREUR: sendMessage pas ok:true"; exit 1; }
systemctl restart "$SERVICE" 2>/dev/null || true
sleep 0.4
say "--- status ---"
systemctl status "$SERVICE" --no-pager -n 15 2>/dev/null || true
say "DONE. Regarde Telegram: tu dois voir 'WOLVERINE: TEST DIRECT OK ...'"
SH
bash /tmp/WOLVERINE_TG_FIX_AUTODETECT.sh
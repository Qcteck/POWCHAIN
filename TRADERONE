#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA RSS FIX FINAL ==="

WEBROOT="/var/www/aiaquila"
HTML="$WEBROOT/index.html"
BACKUP="$HTML.bak.$(date +%s)"

test -f "$HTML" || { echo "index.html introuvable"; exit 1; }

echo "[1/5] Backup"
cp "$HTML" "$BACKUP"

echo "[2/5] Patch JS RSS logique"

perl -0777 -i -pe '
s|const RSS_FEEDS\s*=\s*\[[^\]]*\];|
const RSS_FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://www.coingecko.com/rss/news"
];
|sg;

s|fetch\(([^)]+)\)|fetch("/aiaquila/rss-proxy.php?url=" + encodeURIComponent($1))|sg;

s|response\.json\(\)|response.text()|sg;

s|JSON\.parse\(|new DOMParser().parseFromString(|sg;
' "$HTML"

echo "[3/5] Injection parser RSS sûr"

perl -0777 -i -pe '
s|function parseRSS\([^)]*\)\s*\{.*?\}|
function parseRSS(xmlText) {
  const doc = new DOMParser().parseFromString(xmlText, "text/xml");
  const items = [...doc.querySelectorAll("item")];
  return items.map(item => ({
    title: item.querySelector("title")?.textContent || "",
    link: item.querySelector("link")?.textContent || "",
    desc: item.querySelector("description")?.textContent || ""
  }));
}
|sg;
' "$HTML"

echo "[4/5] Permissions"
chown www-data:www-data "$HTML"
chmod 644 "$HTML"

echo "[5/5] Reload nginx"
nginx -t && systemctl reload nginx

echo "======================================"
echo "✅ RSS RÉPARÉ"
echo "🌐 https://fireinners.online/aiaquila/"
echo "🧠 Articles DOIVENT apparaître"
echo "📦 Backup: $BACKUP"
echo "======================================"
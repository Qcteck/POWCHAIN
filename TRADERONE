async function extractBest(url){const d=domainOf(url);const dom=mem.domains[d]||(mem.domains[d]={ok:0,fail:0,avgQ:0,methods:{}});let raw=null;try{raw=await fetchMultiplex(url);}catch(e){pushErr("fetch fail "+d);}const outs=[];if(raw&&raw.body){const html=raw.body;outs.push({m:raw.src+"_readability",txt:readabilityExtract(html,url),html});outs.push({m:raw.src+"_heuristic",txt:heuristicExtract(html),html});outs.push({m:raw.src+"_plain",txt:htmlToPlain(html),html});}for(const o of outs){o.txt=clean(o.txt||"");if(o.txt.length>MAXTXT)o.txt=o.txt.slice(0,MAXTXT);o.q=qualityScore(o.txt);o.paywall=paywallSuspect(o.txt,o.html);o.len=o.txt.length;}outs.sort((a,b)=>(b.q-b.paywall*8)-(a.q-a.paywall*8));const best=outs[0]||{m:"none",txt:"",q:0,paywall:true,len:0};dom.methods[best.m]=(dom.methods[best.m]||0)+1;if(best.txt&&best.q>=20){dom.ok++;dom.avgQ=Math.round(((dom.avgQ*(dom.ok-1))+best.q)/dom.ok);}else dom.fail++;return {domain:d,best,alts:outs.slice(0,6),domainScore:dom};}

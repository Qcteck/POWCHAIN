@echo off
setlocal enabledelayedexpansion

REM =========================
REM NEURONEONE -> Electron EXE (1-shot)
REM Usage:
REM   build_neuroneone.bat            (portable .exe)
REM   build_neuroneone.bat setup      (NSIS setup)
REM =========================

set "MODE=%~1"
if "%MODE%"=="" set "MODE=portable"
set "TARGET=portable"
if /I "%MODE%"=="setup" set "TARGET=nsis"

set "ROOT=%~dp0"
set "PROJ=NEURONEONE_EXE"
set "DIR=%ROOT%%PROJ%"

echo [1/7] Verif Node/NPM...
where node >nul 2>nul || (echo ERROR: node introuvable. Installe Node.js LTS puis relance.& exit /b 1)
where npm  >nul 2>nul || (echo ERROR: npm introuvable. Installe Node.js LTS puis relance.& exit /b 1)

echo [2/7] Creation dossier: "%DIR%"
if not exist "%DIR%" mkdir "%DIR%"

echo [3/7] Copie HTML -> index.html (doit exister: "%ROOT%NEURONEONE.html")
if not exist "%ROOT%NEURONEONE.html" (
  echo ERROR: Fichier "%ROOT%NEURONEONE.html" manquant.
  echo Place ton HTML complet dans NEURONEONE.html (meme dossier que ce .bat) puis relance.
  exit /b 1
)
copy /Y "%ROOT%NEURONEONE.html" "%DIR%\index.html" >nul

echo [4/7] Ecriture main.js / preload.js / package.json (ecrase si existe)...
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
"$t='%TARGET%';" ^
"Set-Content -Encoding UTF8 -Path '%DIR%\main.js' -Value @'
const {app,BrowserWindow,shell}=require('electron');
const path=require('path');
function create(){
  const win=new BrowserWindow({
    width:1400,height:900,
    webPreferences:{
      preload:path.join(__dirname,'preload.js'),
      contextIsolation:true,
      nodeIntegration:false,
      sandbox:false
    }
  });
  win.loadFile('index.html');
  win.webContents.setWindowOpenHandler(({url})=>{shell.openExternal(url);return{action:'deny'}});
}
app.whenReady().then(create);
app.on('window-all-closed',()=>{if(process.platform!=='darwin')app.quit()});
'@;" ^
"Set-Content -Encoding UTF8 -Path '%DIR%\preload.js' -Value @'
const {contextBridge}=require('electron');
contextBridge.exposeInMainWorld('NEURONE_EXE',{ok:true,platform:process.platform});
'@;" ^
"$pkg=@{
  name='neuroneone';
  version='1.0.0';
  main='main.js';
  private=$true;
  scripts=@{ start='electron .'; dist='electron-builder' };
  devDependencies=@{ electron='^32.0.0'; 'electron-builder'='^24.13.3' };
  build=@{
    appId='com.neuroneone.app';
    productName='NEURONEONE';
    files=@('**/*');
    win=@{ target=@($t); artifactName=($t -eq 'portable' ? 'NEURONEONE.exe' : 'NEURONEONE-Setup.exe') };
    directories=@{ output='dist' }
  }
};" ^
"$json=$pkg|ConvertTo-Json -Depth 10; Set-Content -Encoding UTF8 -Path '%DIR%\package.json' -Value $json;"

echo [5/7] Install deps (npm install)...
pushd "%DIR%"
call npm install
if errorlevel 1 (echo ERROR: npm install a echoue.& popd& exit /b 1)

echo [6/7] Build EXE: %TARGET% ...
call npm run dist
if errorlevel 1 (echo ERROR: build a echoue.& popd& exit /b 1)

echo [7/7] OK.
echo Output: "%DIR%\dist\"
dir /b "%DIR%\dist"
echo.
echo Pour lancer en dev:  cd /d "%DIR%" ^&^& npm start
popd
endlocal



cat >/root/MEGA_AQUILA_STACKING_ONE_SHOT_ROOT_V6.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027
TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing: $1"; }

[ "$(id -u)" -eq 0 ] || die "run as root"
need nginx; need systemctl; need awk; need grep; need sed; need curl; need cp; need mkdir; need chmod

# --- TARGET ---
DOMAIN="fireinners.online"
PATH_OK="/aquila_stacking/"
WEBROOT="/var/www/aquila_stacking"
HTML="$WEBROOT/index.html"

# --- PROJECT (optional) ---
APP="/opt/aquila_stacking"
KEYS="$APP/keys"
PROG="aquila_stacking"

BK="/root/AQUILA_STACKING_ONESHOT_V6_BK_${TS}"
mkdir -p "$BK"
nginx -T >"$BK/nginx.T.txt" 2>&1 || true

backup_one(){ local f="$1"; [ -f "$f" ] && cp -a "$f" "$BK/$(echo "$f" | sed 's#/#_#g').bak" || true; }

say "1) Prepare WEBROOT + index.html"
mkdir -p "$WEBROOT"
chmod 0755 "$WEBROOT"

PID="UNKNOWN"
if command -v solana-keygen >/dev/null 2>&1 && [ -f "$KEYS/${PROG}-keypair.json" ]; then
  PID="$(solana-keygen pubkey "$KEYS/${PROG}-keypair.json" 2>/dev/null || echo UNKNOWN)"
fi

cat >"$HTML"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><style>body{font-family:system-ui,Segoe UI,Arial;margin:24px;max-width:980px}code{background:#0b1020;color:#d7e3ff;padding:10px;border-radius:10px;display:block;overflow:auto}h1{margin:0 0 12px}small{opacity:.8}</style></head><body><h1>AquilaStacking</h1><p><b>Program ID:</b><code>${PID}</code></p><p><b>Workspace:</b><code>${APP}</code></p><p><b>URL:</b><code>${PATH_OK}</code></p><p><small>TS: ${TS}</small></p></body></html>
EOF
chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
chmod -R 0755 "$WEBROOT"

say "2) Find LOADED nginx vhost file(s) serving ${DOMAIN} on 443"
mapfile -t FILES < <(awk '/^# configuration file /{print $4}' "$BK/nginx.T.txt" | sed 's/:$//' | sort -u)
CAND="$BK/candidates_443.txt"; : >"$CAND"
for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  if grep -qE "server_name[^;]*\b${DOMAIN//./\\.}\b" "$f" && grep -qE 'listen[[:space:]]+[^;]*443' "$f"; then
    echo "$f" >>"$CAND"
  fi
done
[ -s "$CAND" ] || die "no loaded vhost file with ${DOMAIN} + listen 443 found (see $BK/nginx.T.txt)"

say "Candidates:"
nl -ba "$CAND" | sed 's/^/[C] /'

BLOCK_TAG="AQUILA_STACKING_ONESHOT_V6"
LOC_BLOCK=$(cat <<EOF
  # ${BLOCK_TAG} BEGIN
  location = /aquilastacking { return 301 ${PATH_OK}; }
  location ^~ /aquilastacking/ { return 301 ${PATH_OK}; }
  location = ${PATH_OK%/} { return 301 ${PATH_OK}; }
  location ^~ ${PATH_OK} {
    alias ${WEBROOT}/;
    index index.html;
    try_files \$uri \$uri/ ${PATH_OK}index.html;
    add_header Cache-Control "no-store" always;
  }
  # ${BLOCK_TAG} END
EOF
)

patch_one(){
  local f="$1"
  [ -f "$f" ] || return 0
  if grep -q "$BLOCK_TAG" "$f"; then
    say "ok already patched: $f"
    return 0
  fi
  backup_one "$f"
  chattr -i "$f" 2>/dev/null || true

  local tmp; tmp="$(mktemp)"
  awk -v dom="${DOMAIN}" -v tag="$BLOCK_TAG" -v loc="$LOC_BLOCK" '
  function print_loc(){ print loc }
  BEGIN{inserver=0;depth=0;match=0;patched=0;}
  {
    line=$0
    if(!inserver){
      print line
      if(line ~ /^[[:space:]]*server[[:space:]]*\{/){ inserver=1; depth=1; match=0; patched=0; }
      next
    }

    if(line ~ /server_name[[:space:]]+[^;]*\bfireinners\.online\b/){ match=1 }

    if(match && !patched && line ~ /^[[:space:]]*location[[:space:]]/){
      print_loc(); patched=1
    }

    oc=gsub(/\{/,"&",line); cc=gsub(/\}/,"&",line)
    depth += oc
    depth -= cc

    if(depth<=0){
      if(match && !patched){ print_loc(); patched=1 }
      print line
      inserver=0; depth=0; match=0; patched=0
      next
    }

    print line
  }' "$f" >"$tmp"

  cp -a "$f" "$f.bak.$TS" 2>/dev/null || true
  cat "$tmp" >"$f"
  rm -f "$tmp"
  say "patched: $f"
}

say "3) Patch EACH active 443 vhost candidate (direct location block)"
while read -r f; do patch_one "$f"; done <"$CAND"

say "4) nginx -t (rollback if fail) + reload"
if ! nginx -t; then
  say "nginx invalid -> rollback"
  while read -r f; do
    b="$BK/$(echo "$f" | sed 's#/#_#g').bak"
    [ -f "$b" ] && cp -a "$b" "$f" || true
  done <"$CAND"
  nginx -t || true
  die "rolled back (see $BK)"
fi
systemctl reload nginx

say "5) Prove the block is LOADED (nginx -T grep)"
nginx -T 2>/dev/null | grep -n "$BLOCK_TAG" | head -n 30 || true

say "6) Local verify (must NOT be 404)"
curl -skI --resolve ${DOMAIN}:443:127.0.0.1 "https://${DOMAIN}${PATH_OK}" | head -n 40
curl -sk  --resolve ${DOMAIN}:443:127.0.0.1 "https://${DOMAIN}${PATH_OK}" | head -n 10

say "DONE"
say "URL: https://${DOMAIN}${PATH_OK}"
say "BK: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_ONE_SHOT_ROOT_V6.sh
bash /root/MEGA_AQUILA_STACKING_ONE_SHOT_ROOT_V6.sh
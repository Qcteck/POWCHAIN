cat >/root/fix_try_files_from_nginx_error_smart.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ts="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Capture nginx -t error =="
ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 40

FILE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\1/p' | head -n1)"
LINE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\2/p' | head -n1)"

if [[ -z "${FILE:-}" || -z "${LINE:-}" ]]; then
  echo "[ERR] impossible d'extraire file:line. Lance: nginx -t 2>&1 | head -n 30"
  exit 1
fi

echo
echo "== 2) Target: $FILE:$LINE (context) =="
start=$((LINE-12)); ((start<1)) && start=1
end=$((LINE+12))
nl -ba "$FILE" | sed -n "${start},${end}p"

echo
echo "== 3) Backup file =="
cp -a "$FILE" "${FILE}.bak_${ts}"

echo
echo "== 4) Decide best replacement for that try_files line =="
CTX="$(nl -ba "$FILE" | sed -n "$((LINE-8)),$((LINE+8))p" | tr -d '\r')"

# Default (safe generic)
REPL='    try_files $uri $uri/ =404;'

# If we are in phantom_patch block → must be: try_files $uri =404;
if echo "$CTX" | grep -q "phantom_patch\.js"; then
  REPL='    try_files $uri =404;'
fi

# If we are in /wolverine/ SPA block → must be: try_files $uri $uri/ /wolverine/index.html;
if echo "$CTX" | grep -q "location \^~ /wolverine/"; then
  REPL='    try_files $uri $uri/ /wolverine/index.html;'
fi

echo "Chosen replacement: $REPL"

echo
echo "== 5) Patch ONLY the failing line (replace any try_files.*;) =="
sed -i "${LINE}s@^[[:space:]]*try_files.*;@${REPL}@g" "$FILE"

echo
echo "== 6) Re-check patched line =="
nl -ba "$FILE" | sed -n "${LINE}p"

echo
echo "== 7) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
BASH

chmod +x /root/fix_try_files_from_nginx_error_smart.sh
/root/fix_try_files_from_nginx_error_smart.sh
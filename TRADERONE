set -euo pipefail

SNIP="/etc/nginx/snippets/wolverine_locations.conf"
mkdir -p /etc/nginx/snippets

cat > "$SNIP" <<'NGX'
# Wolverine: TraderOne API behind /wolverine/traderone/api/
location ^~ /wolverine/traderone/api/ {
  proxy_pass http://127.0.0.1:3000/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
NGX

# inject include only into nginx files that already mention /wolverine (backup first)
FILES="$(nginx -T 2>/dev/null | awk '
  /^# configuration file / {f=$4}
  /\/wolverine/ && /location/ {print f}
' | sort -u)"

echo "nginx files: "
echo "$FILES"

for f in $FILES; do
  [ -f "$f" ] || continue
  cp -a "$f" "$f.bak.$(date +%Y%m%d_%H%M%S)"
  grep -q "snippets/wolverine_locations.conf" "$f" && continue
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/wolverine_locations.conf;/' "$f"
done

nginx -t
systemctl reload nginx

echo "=== TESTS ==="
echo "--- local backend ---"
curl -sS -i http://127.0.0.1:3000/positions 2>/dev/null | head -n 12 || true
echo "--- public (must not be 403) ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/positions | head -n 12 || true
cat >/root/fix_solana_rpc_proxy_clean.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"

# 1) Trouver le vhost SSL (443) qui sert fireinners.online
VHOST="$(
nginx -T 2>/dev/null | awk -v dom="$DOMAIN" '
  /^# configuration file /{f=$4; sub(/:$/,"",f)}
  /server_name/ && $0 ~ dom {cand=f}
  /listen\s+(\[::\]:)?443/ && cand!="" {print cand; exit}
'
)"
[[ -n "${VHOST:-}" && -f "$VHOST" ]] || { echo "[ERR] vhost 443 introuvable pour $DOMAIN"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$VHOST" "${VHOST}.bak_${ts}"
echo "[OK] VHOST: $VHOST (backup ${VHOST}.bak_${ts})"

mkdir -p /etc/nginx/snippets

# 2) Snippet /solana-rpc (same-origin, CORS OK)
cat >"$SNIP" <<'NGINX'
# Solana RPC proxy (avoid browser CORS)
location = /solana-rpc {
  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  add_header Access-Control-Allow-Origin * always;
  add_header Access-Control-Allow-Headers * always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }
}
NGINX
echo "[OK] wrote $SNIP"

# 3) Inject include inside the SSL server block (idempotent)
if ! grep -qF "include /etc/nginx/snippets/solana_rpc_proxy.conf;" "$VHOST"; then
  # Ajoute juste après la 1ère ligne server_name du vhost
  sed -i '/server_name .*fireinners\.online/ a\  include /etc/nginx/snippets/solana_rpc_proxy.conf;' "$VHOST"
  echo "[OK] include injected in $VHOST"
else
  echo "[OK] include already present"
fi

# 4) Test + reload
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

# 5) Test RPC local (doit répondre "ok")
echo
echo "RPC local test:"
curl -sk https://127.0.0.1/solana-rpc \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' && echo
BASH

chmod +x /root/fix_solana_rpc_proxy_clean.sh
/root/fix_solana_rpc_proxy_clean.sh
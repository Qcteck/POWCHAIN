cat >/root/MEGA_WOLVERINE_FLYSCAN_READONLY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
hr(){ echo "----------------------------------------------------------------"; }

say "MEGA_WOLVERINE_FLYSCAN_READONLY (no secrets, no writes)"

hr
say "1) Host + OS + Node"
uname -a || true
lsb_release -a 2>/dev/null || true
command -v node >/dev/null 2>&1 && node -v || echo "node: not found"
command -v npm >/dev/null 2>&1 && npm -v || echo "npm: not found"

hr
say "2) Key paths existence"
paths=(
  "/opt/wolverine"
  "/opt/WOLVERINE1_export"
  "/var/www/wolverine"
  "/var/www/wolverine/index.html"
  "/opt/fireinners/frontend-react/app/dist/wolverine"
  "/etc/nginx/sites-available/fireinners.online-ssl"
)
for p in "${paths[@]}"; do
  if [ -e "$p" ]; then
    say "OK  $p"
  else
    say "MISS $p"
  fi
done

hr
say "3) Live wolverine index candidates (first 5 found)"
find /var/www /opt -maxdepth 5 -type f -name "index.html" 2>/dev/null | grep -i "wolverine" | head -n 5 || true

hr
say "4) Nginx: /wolverine routes (fireinners.online-ssl)"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
if [ -f "$VHOST" ]; then
  grep -nE 'wolverine|traderone|proxy_pass|location\s+/wolverine|location\s+=\s+/wolverine' "$VHOST" || true
else
  say "VHOST not found: $VHOST"
fi

hr
say "5) Nginx test (no reload)"
nginx -t 2>&1 || true

hr
say "6) Listening ports (node/nginx)"
ss -lntp 2>/dev/null | sed -n '1,200p' || true

hr
say "7) Systemd services possibly relevant"
systemctl list-units --type=service --no-pager 2>/dev/null | grep -iE 'wolverine|traderone|amcq|fireinners|node|pm2' || true

hr
say "8) PM2 (if installed)"
if command -v pm2 >/dev/null 2>&1; then
  pm2 ls || true
else
  say "pm2 not found"
fi

hr
say "9) Vendor libs expected by frontend: /wolverine/vendor/*"
# Front expects /wolverine/vendor/solana-web3.min.js and spl-token.min.js in many variants
if [ -d "/var/www/wolverine" ]; then
  say "Listing /var/www/wolverine/vendor (if exists)"
  ls -la "/var/www/wolverine/vendor" 2>/dev/null || true
fi
if [ -d "/opt/fireinners/frontend-react/app/dist/wolverine" ]; then
  say "Listing dist/wolverine/vendor (if exists)"
  ls -la "/opt/fireinners/frontend-react/app/dist/wolverine/vendor" 2>/dev/null || true
fi

hr
say "10) Quick grep in live index for vendor paths + solana web3 + lifi"
for f in "/var/www/wolverine/index.html" "/opt/fireinners/frontend-react/app/dist/wolverine/index.html"; do
  if [ -f "$f" ]; then
    say "File: $f"
    grep -nE 'solana-web3|spl-token|window\.solanaWeb3|@solana/web3|lifi|/api/|/wolverine/vendor' "$f" | head -n 40 || true
    hr
  fi
done

hr
say "11) Backend candidates: server.js files"
find /opt -maxdepth 4 -type f -name "server.js" 2>/dev/null | grep -iE 'wolverine|traderone|backend|auth-phantom' | head -n 30 || true

hr
say "DONE (read-only)."
BASH

chmod +x /root/MEGA_WOLVERINE_FLYSCAN_READONLY.sh
bash /root/MEGA_WOLVERINE_FLYSCAN_READONLY.sh
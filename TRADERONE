# ROOT batch — corrige /api/dexes (404) en le plaçant juste après /api/status, puis restart PM2 et test
set -euo pipefail
cd /opt/traderone-opt

echo "=== 0) Backup server.js ==="
cp -a server.js "server.js.bak.move_dexes.$(date +%s)"

echo "=== 1) Patch: remove any existing /api/dexes + reinsert right after /api/status ==="
node <<'NODE'
const fs = require("fs");
const p = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(p,"utf8");

// remove ALL existing /api/dexes route blocks (simple/robust)
s = s.replace(/app\.get\(\s*["']\/api\/dexes["'][\s\S]*?\n\}\);\s*\n/gm, "");

// ensure allowlist file exists (create if missing)
try { fs.mkdirSync("/opt/traderone-opt/config", { recursive:true }); } catch(_) {}
const allow = "/opt/traderone-opt/config/dex_allowlist.json";
if (!fs.existsSync(allow)) {
  fs.writeFileSync(allow, JSON.stringify([
    "sushiswap","jupiter","dflow","okx","mayan","chainflip",
    "gasZipBridge","relaydepository","odos","fly","relay"
  ], null, 2));
}

// route block
const dex = `
app.get("/api/dexes", (req,res)=>{
  try{
    const raw = fs.readFileSync(path.join(__dirname,"config","dex_allowlist.json"),"utf8");
    const a = JSON.parse(raw);
    const dexes = Array.isArray(a) ? a.map(x=>String(x).trim()).filter(Boolean) : [];
    return res.json({ ok:true, dexes });
  }catch(e){
    return res.status(200).json({ ok:true, dexes: [], warn: String((e&&e.message)||e) });
  }
});
`;

// insert right after /api/status (get/post/all)
const m = s.match(/app\.(all|get|post)\(\s*["']\/api\/status["'][\s\S]*?\n\}\);\s*\n/m);
if(!m) throw new Error("Route /api/status introuvable dans server.js (impossible d’insérer /api/dexes au bon endroit).");

s = s.replace(m[0], m[0] + "\n" + dex + "\n");
fs.writeFileSync(p, s);
console.log("OK: /api/dexes moved just after /api/status");
NODE

echo "=== 2) Syntax check ==="
node --check server.js

echo "=== 3) Restart PM2 (process id 0) ==="
pm2 ls || true
pm2 restart 0 --update-env
sleep 1

echo "=== 4) Tests ==="
echo "--- /health ---"
curl -sS -i http://127.0.0.1:3000/health | head -n 15 || true
echo
echo "--- /api/status ---"
curl -sS -i http://127.0.0.1:3000/api/status | head -n 25 || true
echo
echo "--- /api/dexes ---"
curl -sS -i http://127.0.0.1:3000/api/dexes | head -n 25 || true
echo
echo "=== DONE ==="
bash -c "$(cat <<'BASH'
set -euo pipefail
echo '=== WOLVERINE CLEAN RESET (WEB3 DIRECT) ==='

HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

# Backup
cp "$HTML" "$HTML.rollback_clean_$TS" || true

# Overwrite frontend with CLEAN + WORKING version
cat >"$HTML" <<'HTML'
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<title>Wolverine Wallet</title>
<style>
body{background:#0b0b0b;color:#0ff;font-family:Arial}
#w{max-width:420px;margin:80px auto;padding:20px;border:1px solid #0ff;border-radius:8px}
button{width:100%;padding:12px;margin-top:10px;background:#0ff;border:0;font-weight:bold}
</style>
<script src="https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js"></script>
</head>
<body>
<div id="w">
<button id="connect">Connect Phantom</button>
<button id="disconnect" style="display:none">Disconnect</button>
<div>Address: <span id="addr">-</span></div>
<div>SOL: <span id="sol">-</span></div>
<div>USDC: <span id="usdc">-</span></div>
</div>

<script>
const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const conn = new solanaWeb3.Connection(
  solanaWeb3.clusterApiUrl("mainnet-beta")
);

connect.onclick = async () => {
  if (!window.solana || !solana.isPhantom) {
    alert("Phantom not found");
    return;
  }
  const r = await solana.connect();
  const pub = r.publicKey;
  addr.textContent = pub.toString();

  // SOL
  const lamports = await conn.getBalance(pub);
  sol.textContent = (lamports / 1e9).toFixed(6);

  // USDC
  const accs = await conn.getParsedTokenAccountsByOwner(
    pub,
    { mint: new solanaWeb3.PublicKey(USDC_MINT) }
  );
  let total = 0;
  accs.value.forEach(a => {
    total += a.account.data.parsed.info.tokenAmount.uiAmount;
  });
  usdc.textContent = total.toFixed(2);

  connect.style.display="none";
  disconnect.style.display="block";
};

disconnect.onclick = async () => {
  await solana.disconnect();
  addr.textContent=sol.textContent=usdc.textContent="-";
  disconnect.style.display="none";
  connect.style.display="block";
};
</script>
</body>
</html>
HTML

echo "=== DONE ==="
echo "➡️ HARD REFRESH NAVIGATEUR (CTRL+SHIFT+R)"
BASH
)"
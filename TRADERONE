rm -f "$DOCROOT/solana-web3.entry.js"
chmod 644 "$DOCROOT/solana-web3.min.js"

echo "== 6) Écrire index.html + app.js (Start = deposit + confirm + start) =="
TS="$(date +%s)"
cp -a "$DOCROOT/index.html" "$DOCROOT/index.html.bak.$TS" 2>/dev/null || true
cp -a "$DOCROOT/app.js" "$DOCROOT/app.js.bak.$TS" 2>/dev/null || true


      return;
    }

    // consent once for fetch (technical)
    requireConsentOnce("ARTICLE_FETCH", "Autoriser la lecture de l’article via proxy (allorigins/jina) ?", async (ok) => {
      if(!ok){
        S.article.tags = detectTags(it.title,"");

cat >/root/fix_duplicate_solana_include.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup vhost =="
cp -a "$VHOST" "${VHOST}.bak_${TS}"
echo "Saved: ${VHOST}.bak_${TS}"

echo
echo "== Before (includes) =="
grep -n "include /etc/nginx/snippets/solana_rpc_proxy.conf;" "$VHOST" || true

echo
echo "== Remove duplicate include (keep first only) =="
awk '
  BEGIN{seen=0}
  $0 ~ /include \/etc\/nginx\/snippets\/solana_rpc_proxy\.conf;/ {
    if(seen==0){seen=1; print; next}
    next
  }
  {print}
' "$VHOST" > /tmp/vhost.fixed
mv /tmp/vhost.fixed "$VHOST"

echo
echo "== After (includes) =="
grep -n "include /etc/nginx/snippets/solana_rpc_proxy.conf;" "$VHOST" || true

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx

echo "DONE ✅"
BASH

chmod +x /root/fix_duplicate_solana_include.sh
/root/fix_duplicate_solana_include.sh
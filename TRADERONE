# ROOT — trouver où est le UI WOLVERINE (repo/dossier/branche), build & deploy -> /var/www/wolverine
set -euo pipefail
TS="$(date +%s)"

WOLV_DIST="/var/www/wolverine"
FIRE_DIST="/var/www/fireinners"

echo "=== 0) Backup /var/www/wolverine actuel ==="
if [ -d "$WOLV_DIST" ]; then
  mv "$WOLV_DIST" "/var/www/wolverine_backup_$TS"
fi
mkdir -p "$WOLV_DIST"

echo "=== 1) Cherche un frontend buildable sur le VPS (package.json avec scripts.build) ==="
CAND_PKG="$(find /opt -type f -name package.json -not -path "*/node_modules/*" -print0 2>/dev/null | \
  xargs -0 -I{} sh -c 'grep -q "\"build\"" "{}" && echo "{}"' | head -n 1 || true)"

if [ -z "${CAND_PKG:-}" ]; then
  echo "KO: aucun package.json avec script build trouvé dans /opt"
  echo "=> le UI est probablement un build statique déjà prêt OU dans un autre repo non cloné ici."
  echo "LISTE des package.json trouvés (top 30):"
  find /opt -type f -name package.json -not -path "*/node_modules/*" 2>/dev/null | head -n 30
  exit 1
fi

APP_DIR="$(dirname "$CAND_PKG")"
echo "OK: frontend buildable trouvé -> $APP_DIR"

echo "=== 2) Installer Node + rsync ==="
apt-get update -y >/dev/null
apt-get install -y rsync curl >/dev/null
if ! command -v node >/dev/null 2>&1; then
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash - >/dev/null
  apt-get install -y nodejs >/dev/null
fi

echo "=== 3) Build (base /wolverine/) ==="
cd "$APP_DIR"

cat > .env.production <<'EOF'
VITE_BASE=/wolverine/
VITE_API_BASE=/wolverine/traderone/api
EOF

npm install
npm run build

OUT=""
for d in dist build out; do
  [ -d "$APP_DIR/$d" ] && OUT="$APP_DIR/$d" && break
done
[ -n "$OUT" ] || { echo "KO: pas de dist/build/out après build"; exit 1; }

echo "=== 4) Deploy => /var/www/wolverine ==="
rsync -a --delete "$OUT/" "$WOLV_DIST/"
chmod -R 755 /var/www
find "$WOLV_DIST" -type f -exec chmod 644 {} \;

echo "=== 5) Preuve ==="
grep -i "<title>" -n "$WOLV_DIST/index.html" | head -n 3 || true
ls -lah "$WOLV_DIST" | head -n 25

echo "DONE ✅"
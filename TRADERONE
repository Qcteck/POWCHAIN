#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE FORCE PROXY FIX ==="

# 1. Trouver le bon vhost
VHOST=$(grep -R "wolverine" /etc/nginx/sites-enabled -l | head -n1)

if [ -z "$VHOST" ]; then
  echo "❌ Aucun vhost wolverine trouvé"
  exit 1
fi

echo "✅ VHOST trouvé: $VHOST"

BACKUP="${VHOST}.bak_$(date +%Y%m%d_%H%M%S)"
cp -a "$VHOST" "$BACKUP"

# 2. Injecter proxy si absent
if grep -q "location /wolverine/api/" "$VHOST"; then
  echo "⚠️ Proxy déjà présent"
else
  echo "➕ Injection proxy API"
  sed -i '/location \/wolverine\/ {/a \
    location /wolverine/api/ {\
        proxy_pass http://127.0.0.1:3000/;\
        proxy_http_version 1.1;\
        proxy_set_header Upgrade $http_upgrade;\
        proxy_set_header Connection "upgrade";\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\
        proxy_set_header X-Forwarded-Proto $scheme;\
    }\
' "$VHOST"
fi

# 3. Test NGINX
nginx -t
systemctl reload nginx

# 4. Vérifier Node
echo "=== NODE CHECK ==="
if ! ss -lntp | grep -q ":3000"; then
  echo "❌ Node.js n'écoute PAS sur 3000"
  echo "➡️ Lancer le backend TraderOne"
else
  echo "✅ Node.js actif sur 3000"
fi

# 5. Test API directe
echo "=== API TEST ==="
curl -s http://127.0.0.1:3000/health || true

echo "=== DONE ==="
echo "➡️ Recharge la page: Ctrl+F5"
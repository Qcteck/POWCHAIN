bash -lc 'cat > /root/BUNDLER_FIX_404.sh <<'"'"'SH'"'"'
#!/usr/bin/env bash
set -euo pipefail

ts(){ date +%Y%m%d_%H%M%S; }
say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }
need_root(){ [ "$(id -u)" -eq 0 ] || die "run as root"; }
need_root

DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_CONF="/etc/nginx/nginx.conf"
INC_DIR="/etc/nginx/includes"
INC_FILE="${INC_DIR}/bundler_routes.inc"

WEBROOT="/var/www/bundler"
API_DIR="/opt/bundler_api"
API_PORT="9797"
API_HOST="127.0.0.1"
SVC="/etc/systemd/system/bundler-api.service"

BK="/root/BUNDLER_FIX_404_$(ts)"
mkdir -p "$BK"

say "backup: $BK"
[ -f "$NGINX_CONF" ] && cp -a "$NGINX_CONF" "$BK/nginx.conf.bak" || true
[ -f "$VHOST" ] && cp -a "$VHOST" "$BK/$(basename "$VHOST").bak" || true
[ -f "$INC_FILE" ] && cp -a "$INC_FILE" "$BK/$(basename "$INC_FILE").bak" || true
[ -f "$SVC" ] && cp -a "$SVC" "$BK/$(basename "$SVC").bak" || true

say "ensure dirs"
mkdir -p "$INC_DIR" "$WEBROOT" "$API_DIR"
chmod 755 "$WEBROOT" || true

say "write nginx include: $INC_FILE"
cat > "$INC_FILE" <<EOF
# === BUNDLER ROUTES (AUTOGEN) ===
location = /bundler { return 301 /bundler/; }
location ^~ /bundler/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Connection "";
  proxy_pass http://${API_HOST}:${API_PORT}/;
}
location ^~ /bundler/ {
  alias ${WEBROOT}/;
  try_files \$uri \$uri/ /bundler/index.html;
  add_header Cache-Control "no-store";
}
EOF

say "ensure vhost include present: $VHOST"
[ -f "$VHOST" ] || die "missing vhost: $VHOST"
if ! grep -qF "include $INC_FILE;" "$VHOST"; then
  awk -v inc="    include '"$INC_FILE"';" '
    BEGIN{inserver=0;done=0}
    /^[[:space:]]*server[[:space:]]*\{/ {inserver=1}
    inserver && $0 ~ /^[[:space:]]*\}/ && done==0 {print inc; done=1}
    {print}
  ' "$VHOST" > "$BK/vhost.new"
  cp -a "$BK/vhost.new" "$VHOST"
fi

say "ensure UI index"
if [ ! -f "$WEBROOT/index.html" ]; then
  cat > "$WEBROOT/index.html" <<'"'"'HTML'"'"'
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Bundler</title><style>body{font-family:system-ui,Segoe UI,Roboto,Arial;margin:24px}code{background:#f3f3f3;padding:2px 6px;border-radius:6px}</style></head><body><h1>Bundler</h1><p>UI OK. API health: <code id="h">...</code></p><script>(async()=>{try{let r=await fetch("/bundler/api/health",{cache:"no-store"});document.getElementById("h").textContent=r.ok?await r.text():"HTTP "+r.status}catch(e){document.getElementById("h").textContent=String(e)}})();</script></body></html>
HTML
fi

say "write minimal API (stable) under $API_DIR"
cat > "$API_DIR/package.json" <<'"'"'JSON'"'"'
{"name":"bundler-api","version":"1.0.0","private":true,"type":"commonjs","main":"server.js","dependencies":{"express":"^4.19.2"}}
JSON

cat > "$API_DIR/server.js" <<'"'"'JS'"'"'
"use strict";
const express=require("express");
const app=express();
app.use(express.json({limit:"1mb"}));
app.get("/health",(req,res)=>res.status(200).type("text/plain").send("ok"));
app.get("/",(req,res)=>res.status(200).json({ok:true,svc:"bundler-api"}));
app.post("/create-token",(req,res)=>res.status(501).json({ok:false,code:"NOT_IMPLEMENTED",msg:"API stable up; wire real create-token here"}));
const host=process.env.API_HOST||"127.0.0.1";
const port=parseInt(process.env.API_PORT||"9797",10);
app.listen(port,host,()=>console.log(JSON.stringify({ok:true,ts:new Date().toISOString(),host,port})));
JS

say "install deps"
cd "$API_DIR"
if [ ! -d node_modules ]; then
  npm i --silent
else
  npm i --silent || true
fi

say "write systemd service: $SVC"
cat > "$SVC" <<EOF
[Unit]
Description=Bundler API (create token)
After=network.target

[Service]
Type=simple
WorkingDirectory=${API_DIR}
Environment=API_HOST=${API_HOST}
Environment=API_PORT=${API_PORT}
ExecStart=/usr/bin/node ${API_DIR}/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF

say "systemd: reload + enable + restart"
systemctl daemon-reload
systemctl enable --now bundler-api.service >/dev/null 2>&1 || true
systemctl restart bundler-api.service

say "nginx: test + reload"
nginx -t
systemctl reload nginx

say "diag: listeners"
ss -lntp | grep -E ":(${API_PORT})\s" || true

say "tests: local api"
set +e
curl -fsS "http://${API_HOST}:${API_PORT}/health" && echo || echo "LOCAL_API_FAIL"
set -e

say "tests: origin nginx (bypass cloudflare)"
set +e
curl -k -sS -D- "https://${DOMAIN}/bundler/" -o /dev/null | sed -n "1,12p"
curl -k -sS -D- "https://${DOMAIN}/bundler/api/health" -o /dev/null | sed -n "1,12p"
set -e

say "DONE"
say "BACKUP: $BK"
SH
chmod +x /root/BUNDLER_FIX_404.sh
/root/BUNDLER_FIX_404.sh'
cat >/root/TRADERONE_BOOTSTRAP.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== TRADERONE BOOTSTRAP (NO NGINX, DIRECT NODE) ==="

APP_DIR="/opt/traderone"
DATA_DIR="/opt/traderone/data"
LOG_DIR="/opt/traderone/logs"
PORT=3000

mkdir -p "$APP_DIR" "$DATA_DIR" "$LOG_DIR"
cd "$APP_DIR"

# 1) server.js MINIMAL (API LIVE)
cat > server.js <<'JS'
import http from "http";
const PORT = process.env.PORT || 3000;

const server = http.createServer((req,res)=>{
  res.writeHead(200,{"Content-Type":"application/json"});
  res.end(JSON.stringify({
    ok:true,
    service:"TraderOne",
    time:Date.now()
  }));
});

server.listen(PORT,()=>{
  console.log("TraderOne listening on",PORT);
});
JS

# 2) package.json minimal
cat > package.json <<'JSON'
{
  "name": "traderone",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js"
}
JSON

# 3) ENV
cat > .env <<EOF
NODE_ENV=production
PORT=$PORT
DATA_DIR=$DATA_DIR
LOG_DIR=$LOG_DIR
EOF

# 4) PM2 clean start
pm2 delete traderone || true
pm2 start server.js --name traderone
pm2 save

# 5) Firewall
if command -v ufw >/dev/null 2>&1; then
  ufw allow $PORT/tcp || true
fi

sleep 2
curl -fsS http://127.0.0.1:$PORT || true

echo "=== TRADERONE IS LIVE ==="
pm2 status
SH

chmod +x /root/TRADERONE_BOOTSTRAP.sh
/root/TRADERONE_BOOTSTRAP.sh
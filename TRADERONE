bash -lc 'cat >/root/WOLVERINE_FIX_NGINX_LOCATION_ORDER.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/WOLVERINE_FIX_NGINX_LOCATION_ORDER_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

[ "${EUID:-$(id -u)}" -eq 0 ] || { echo "ERROR: run as root"; exit 1; }

ROOT="/var/www/wolverine"
INC="/etc/nginx/includes/wolverine_routes.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
API_PORT="3000"

echo "=== FIX NGINX LOCATION ORDER :: $TS ==="
echo "LOG=$LOG"
echo "ROOT=$ROOT"
echo "INC=$INC"
echo "VHOST=$VHOST"
echo "API_PORT=$API_PORT"
echo

backup(){ [ -f "$1" ] && cp -a "$1" "$1.bak_${TS}" && echo "Backup: $1 -> $1.bak_${TS}" || true; }
unfreeze(){ command -v chattr >/dev/null 2>&1 && chattr -i "$1" 2>/dev/null || true; }
refreeze(){ command -v chattr >/dev/null 2>&1 && chattr +i "$1" 2>/dev/null || true; }

echo "== 1) Precheck backend direct =="
curl -sS -i "http://127.0.0.1:${API_PORT}/health" | head -n 30 || true
echo

echo "== 2) Patch include so API wins and /wolverine/ does not block regex =="
mkdir -p "$(dirname "$INC")"
backup "$INC"
unfreeze "$INC"

cat >"$INC" <<'"'"'EOF'"'"'
# AUTOGENERATED :: WOLVERINE ROUTES + TRADERONE API PROXY (ORDER-SAFE)
# IMPORTANT: API location is ^~ so it always wins over /wolverine/ static route.

location = /wolverine { return 301 /wolverine/; }

location = /wolverine/__wolverine_ok.txt {
  alias __ROOT__/__wolverine_ok.txt;
  add_header Cache-Control "no-store" always;
}

location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

location ^~ /wolverine/_next/ {
  alias __ROOT__/_next/;
  try_files $uri $uri/ =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

location ^~ /wolverine/vendor/ {
  alias __ROOT__/vendor/;
  try_files $uri =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# TraderOne API (MUST win)
location ^~ /wolverine/traderone/api/ {
  rewrite ^/wolverine/traderone/api/?(.*)$ /$1 break;
  proxy_pass http://127.0.0.1:__API_PORT__/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 60s;
}

# Wolverine static (NO ^~ so it does not block anything more specific)
location /wolverine/ {
  alias __ROOT__/;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
EOF

python3 - <<PY
from pathlib import Path
p=Path("$INC")
s=p.read_text()
s=s.replace("__ROOT__", "$ROOT").replace("__API_PORT__", "$API_PORT")
p.write_text(s)
print("OK: include rewritten safely")
PY

chmod 644 "$INC" || true
echo "Wrote: $INC"
echo

echo "== 3) Ensure vhost includes the include (idempotent) =="
[ -f "$VHOST" ] || { echo "ERROR: missing $VHOST"; exit 1; }
backup "$VHOST"
unfreeze "$VHOST"

python3 - <<PY
from pathlib import Path
p=Path("$VHOST")
txt=p.read_text(errors="ignore")
inc=f"include $INC;"
if inc in txt:
    print("OK: include already present in vhost")
else:
    # insert before last }
    i=txt.rfind("}")
    if i==-1: raise SystemExit("ERROR: cannot find closing brace in vhost")
    txt=txt[:i]+"\n    "+inc+"\n"+txt[i:]
    p.write_text(txt)
    print("OK: include inserted into vhost")
PY
echo

echo "== 4) nginx -t and reload =="
nginx -t
systemctl reload nginx || systemctl restart nginx
echo "OK: nginx reloaded"
echo

echo "== 5) Proof: which location serves API now (must be JSON) =="
echo "-- http://127.0.0.1/wolverine/traderone/api/health"
curl -sS -i "http://127.0.0.1/wolverine/traderone/api/health" | head -n 80 || true
echo

echo "-- https://fireinners.online/wolverine/traderone/api/health"
curl -k -sS -i "https://fireinners.online/wolverine/traderone/api/health" | head -n 80 || true
echo

echo "== 6) Re-freeze (best-effort) =="
refreeze "$INC"
refreeze "$VHOST"
echo "DONE. LOG=$LOG"
BASH
chmod +x /root/WOLVERINE_FIX_NGINX_LOCATION_ORDER.sh
/root/WOLVERINE_FIX_NGINX_LOCATION_ORDER.sh'
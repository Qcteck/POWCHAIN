cat >/tmp/WOLVERINE_FINAL_FIX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
CONF="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date +%s)"

echo "== 1) Cherche le port TraderOne (node qui écoute sur 127.0.0.1) =="
PORT="$(ss -lntp | awk '/node/ && /127.0.0.1/ {split($4,a,":"); print a[length(a)]}' | grep -Ev '^(80|443)$' | head -n1)"

if [ -z "$PORT" ]; then
  echo "❌ Aucun backend node trouvé."
  exit 1
fi

echo "Backend TraderOne détecté sur port: $PORT"
echo

echo "== 2) Backup Nginx =="
cp -a "$CONF" "$CONF.bak.$TS"

echo "== 3) Inject proxy /wolverine/traderone/api/ -> 127.0.0.1:$PORT =="
awk -v port="$PORT" '
BEGIN{in_server=0; done=0}
{
  line=$0
  if ($0 ~ /^[[:space:]]*server[[:space:]]*\{/){ in_server=1 }

  if (in_server && $0 ~ /^[[:space:]]*\}[[:space:]]*$/ && done==0){
    print ""
    print "  # WOLVERINE_TRADERONE_API_BEGIN"
    print "  location ^~ /wolverine/traderone/api/ {"
    print "    proxy_http_version 1.1;"
    print "    proxy_set_header Host $host;"
    print "    proxy_set_header X-Real-IP $remote_addr;"
    print "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
    print "    proxy_set_header X-Forwarded-Proto $scheme;"
    print "    proxy_pass http://127.0.0.1:" port "/api/;"
    print "  }"
    print "  # WOLVERINE_TRADERONE_API_END"
    print ""
    done=1
  }

  print line
}
' "$CONF.bak.$TS" > "$CONF"

echo "== 4) Reload Nginx =="
nginx -t
systemctl reload nginx
echo

echo "== 5) TEST =="
read -r -p "Entre ton wallet Phantom: " WALLET
WALLET="$(echo -n "$WALLET" | tr -d '[:space:]')"

echo "-- Via domaine (doit être JSON) --"
curl -ksS "https://${DOMAIN}/wolverine/traderone/api/balances2?wallet=$WALLET" | head -c 300
echo
echo "DONE ✅"
SH

bash /tmp/WOLVERINE_FINAL_FIX.sh
$ErrorActionPreference="Stop"

# Dossier de sortie
$Base = Join-Path $PWD "ROBO600_PRINTPACK"
$Out  = Join-Path $Base "stl"
$Scad = Join-Path $Base "robo600_parts.scad"
New-Item -ItemType Directory -Force -Path $Out | Out-Null

# Chemin OpenSCAD (modifie si besoin)
$OpenSCAD = "C:\Program Files\OpenSCAD\openscad.com"
if(!(Test-Path $OpenSCAD)){
  throw "OpenSCAD introuvable: $OpenSCAD`nInstalle OpenSCAD ou modifie `$OpenSCAD dans le script."
}

# Écrit le SCAD (générateur paramétrique)
@'
$fn=80;PART="all";WALL=2.2;CLR=0.45;M3=3.2;PIN=4.2;PEG=3.0;PEGCLR=0.30;FIL=3;
TORSO=[180,110,260];PELV=[140,90,80];HEAD=[140,120,140];
UPPER=[70,70,160];FORE=[65,65,140];HAND=[80,55,30];
THIGH=[75,75,200];SHIN=[70,70,180];FOOT=[85,140,35];
DC_SMALL=[24,18];DC_BIG=[36,22];SOLAR=[120,70,3];LCDWIN=[74,40];
module rbox(x,y,z,fil=3){minkowski(){cube([x-2*fil,y-2*fil,z-2*fil],center=true);sphere(r=fil);}}
module shell(x,y,z,wall=WALL,fil=FIL){difference(){rbox(x,y,z,fil);rbox(x-2*wall,y-2*wall,z-2*wall,max(1,fil-1));}}
module m3holes(pts=[],h=60){for(p=pts)translate(p)cylinder(d=M3,h=h,center=true);}
module peghole(p=[0,0,0],h=60,d=PEG+PEGCLR){translate(p)cylinder(d=d,h=h,center=true);}
module halfY(side=1){intersection(){children();translate([0,side<0?-1e3:0,0])cube([2e3,1e3,2e3],center=false);}}
module vent(w=95,h=55,t=3,step=6,bar=2){difference(){cube([w,h,t],center=true);for(x=[-w/2:step:w/2])translate([x,0,0])cube([bar,h+2,t+2],center=true);for(y=[-h/2:step:h/2])translate([0,y,0])cube([w+2,bar,t+2],center=true);}}
module hinge(span=20,th=14,w=14,pin=PIN){difference(){union(){translate([-span/2,0,0])cylinder(d=w,h=th,center=true);translate([span/2,0,0])cylinder(d=w,h=th,center=true);cube([span,w*0.85,th],center=true);}cylinder(d=pin+CLR,h=th+2,center=true);}}
module boss(p=[0,0,0],od=10,id=M3,h=10){difference(){translate(p)cylinder(d=od,h=h,center=true);translate(p)cylinder(d=id,h=h+2,center=true);}}
module pelvis(){difference(){shell(PELV[0],PELV[1],PELV[2],WALL,3);translate([0,0,PELV[2]*0.12])cube([PELV[0]*0.78,PELV[1]*0.68,PELV[2]*0.62],center=true);m3holes([[PELV[0]/2-12,0,0],[-PELV[0]/2+12,0,0],[0,PELV[1]/2-12,0],[0,-PELV[1]/2+12,0]],PELV[2]+80);peghole([0,PELV[1]*0.24,0],PELV[2]+80);peghole([0,-PELV[1]*0.24,0],PELV[2]+80);}}
module torso(){difference(){shell(TORSO[0],TORSO[1],TORSO[2],WALL,4);translate([0,-TORSO[1]*0.35,0])cube([TORSO[0]*0.70,TORSO[1]*0.35,TORSO[2]*0.60],center=true);translate([0,0,TORSO[2]*0.33])cube([TORSO[0]*0.65,TORSO[1]*0.55,TORSO[2]*0.35],center=true);m3holes([[TORSO[0]/2-14,0,0],[-TORSO[0]/2+14,0,0],[0,TORSO[1]/2-14,0],[0,-TORSO[1]/2+14,0]],TORSO[2]+100);peghole([0,TORSO[1]*0.22,0],TORSO[2]+100);peghole([0,-TORSO[1]*0.22,0],TORSO[2]+100);}}
module back_hatch(){difference(){rbox(130,90,4,3);translate([0,0,0])vent(100,60,6,6,2);m3holes([[48,32,0],[-48,32,0],[48,-32,0],[-48,-32,0]],40);}}
module neck_ring(){difference(){cylinder(d=52,h=16,center=true);cylinder(d=42,h=20,center=true);m3holes([[20,0,0],[-20,0,0]],40);}}
module head(){difference(){shell(HEAD[0],HEAD[1],HEAD[2],WALL,4);translate([0,HEAD[1]*0.35,0])cube([HEAD[0]*0.82,HEAD[1]*0.30,HEAD[2]*0.55],center=true);translate([0,HEAD[1]*0.49,0])cube([LCDWIN[0],20,LCDWIN[1]],center=true);}}
module face_plate(){difference(){rbox(115,10,100,3);translate([0,6,15])cube([85,25,45],center=true);}}
module jaw(){difference(){rbox(112,74,48,3);translate([0,22,0])cube([92,64,36],center=true);translate([0,-38,0])rotate([90,0,0])cylinder(d=PIN+CLR,h=220,center=true);}}
module shoulder_joint(){hinge(22,16,14,PIN);} module elbow_joint(){hinge(18,14,12,PIN);} module hip_joint(){hinge(24,18,16,PIN);} module knee_joint(){hinge(20,16,14,PIN);}
module limb_shell(sz=[70,70,160]){difference(){shell(sz[0],sz[1],sz[2],WALL,3);for(z=[-sz[2]*0.28,sz[2]*0.28])boss([0,0,z],od=10,id=M3,h=sz[2]*0.16);}}
module upperarm(){limb_shell(UPPER);} module forearm(){limb_shell(FORE);}
module hand(){difference(){shell(HAND[0],HAND[1],HAND[2],WALL,3);translate([0,0,0])cube([HAND[0]*0.65,HAND[1]*0.55,HAND[2]*0.55],center=true);}}
module thigh(){limb_shell(THIGH);} module shin(){limb_shell(SHIN);}
module foot(){difference(){rbox(FOOT[0],FOOT[1],FOOT[2],3);translate([0,FOOT[1]*0.18,0])cube([FOOT[0]*0.62,FOOT[1]*0.52,FOOT[2]*0.62],center=true);m3holes([[FOOT[0]/2-12,FOOT[1]/2-22,0],[-FOOT[0]/2+12,FOOT[1]/2-22,0]],60);}}
module dc_mount_small(){difference(){rbox(DC_SMALL[0]+14,DC_SMALL[0]+14,DC_SMALL[1]+16,3);rotate([90,0,0])cylinder(d=DC_SMALL[0]+CLR,h=DC_SMALL[0]+30,center=true);m3holes([[ (DC_SMALL[0]/2)+5,(DC_SMALL[0]/2)+5,0],[-(DC_SMALL[0]/2)-5,(DC_SMALL[0]/2)+5,0],[(DC_SMALL[0]/2)+5,-(DC_SMALL[0]/2)-5,0],[-(DC_SMALL[0]/2)-5,-(DC_SMALL[0]/2)-5,0]],90);}}
module dc_mount_big(){difference(){rbox(DC_BIG[0]+18,DC_BIG[0]+18,DC_BIG[1]+18,3);rotate([90,0,0])cylinder(d=DC_BIG[0]+CLR,h=DC_BIG[0]+34,center=true);m3holes([[ (DC_BIG[0]/2)+6,(DC_BIG[0]/2)+6,0],[-(DC_BIG[0]/2)-6,(DC_BIG[0]/2)+6,0],[(DC_BIG[0]/2)+6,-(DC_BIG[0]/2)-6,0],[-(DC_BIG[0]/2)-6,-(DC_BIG[0]/2)-6,0]],100);}}
module driver_tray(){difference(){rbox(130,95,4,3);m3holes([[55,37,0],[-55,37,0],[55,-37,0],[-55,-37,0]],40);translate([0,0,0])cube([90,60,12],center=true);}}
module pca_esp_tray(){difference(){rbox(95,65,4,3);m3holes([[38,22,0],[-38,22,0],[38,-22,0],[-38,-22,0]],40);}}
module lcd_bezel(){difference(){rbox(95,55,8,3);translate([0,0,0])cube([LCDWIN[0],LCDWIN[1],20],center=true);m3holes([[38,20,0],[-38,20,0],[38,-20,0],[-38,-20,0]],50);}}
module solar_bracket(side=1){difference(){rbox(78,28,10,3);translate([0,0,0])cube([68,20,24],center=true);translate([side*24,0,0])rotate([0,90,0])cylinder(d=PIN+CLR,h=80,center=true);}}
module cable_clip(){difference(){rbox(20,12,7,2);translate([0,0,0])cube([14,7,12],center=true);}}
module emit(){
if(PART=="pelvis_half1")halfY(1)pelvis(); else if(PART=="pelvis_half2")mirror([0,1,0])halfY(1)pelvis();
else if(PART=="torso_half1")halfY(1)torso(); else if(PART=="torso_half2")mirror([0,1,0])halfY(1)torso();
else if(PART=="head_half1")halfY(1)head(); else if(PART=="head_half2")mirror([0,1,0])halfY(1)head();
else if(PART=="back_hatch")back_hatch(); else if(PART=="neck_ring")neck_ring(); else if(PART=="face_plate")face_plate(); else if(PART=="jaw")jaw();
else if(PART=="shoulder_joint")shoulder_joint(); else if(PART=="elbow_joint")elbow_joint(); else if(PART=="hip_joint")hip_joint(); else if(PART=="knee_joint")knee_joint();
else if(PART=="upperarm_half1")halfY(1)upperarm(); else if(PART=="upperarm_half2")mirror([0,1,0])halfY(1)upperarm();
else if(PART=="forearm_half1")halfY(1)forearm(); else if(PART=="forearm_half2")mirror([0,1,0])halfY(1)forearm();
else if(PART=="hand")hand();
else if(PART=="thigh_half1")halfY(1)thigh(); else if(PART=="thigh_half2")mirror([0,1,0])halfY(1)thigh();
else if(PART=="shin_half1")halfY(1)shin(); else if(PART=="shin_half2")mirror([0,1,0])halfY(1)shin();
else if(PART=="foot")foot();
else if(PART=="dc_mount_small")dc_mount_small(); else if(PART=="dc_mount_big")dc_mount_big();
else if(PART=="driver_tray")driver_tray(); else if(PART=="pca_esp_tray")pca_esp_tray(); else if(PART=="lcd_bezel")lcd_bezel();
else if(PART=="solar_bracket_left")solar_bracket(-1); else if(PART=="solar_bracket_right")solar_bracket(1);
else if(PART=="cable_clip")cable_clip();
else {translate([0,0,0])pelvis();translate([0,0,120])torso();translate([0,0,310])head();}
}
emit();
'@ | Set-Content -Encoding UTF8 $Scad

$Parts = @(
"pelvis_half1","pelvis_half2","torso_half1","torso_half2","head_half1","head_half2",
"back_hatch","neck_ring","face_plate","jaw",
"shoulder_joint","elbow_joint","hip_joint","knee_joint",
"upperarm_half1","upperarm_half2","forearm_half1","forearm_half2","hand",
"thigh_half1","thigh_half2","shin_half1","shin_half2","foot",
"dc_mount_small","dc_mount_big","driver_tray","pca_esp_tray","lcd_bezel",
"solar_bracket_left","solar_bracket_right","cable_clip"
)

Write-Host "Export STL -> $Out"
foreach($p in $Parts){
  $outFile = Join-Path $Out ($p + ".stl")
  Write-Host "  $p -> $outFile"
  & $OpenSCAD -o $outFile -D ("PART=`"" + $p + "`"") $Scad | Out-Null
}

Write-Host "OK: $($Parts.Count) STL générés"
Write-Host "Dossier: $Out"
Write-Host "SCAD: $Scad"
HTML

chmod 0644 "$INDEX"
chown -R root:root "$STATIC"

# guard: 1 seul "Dépôt manuel"
CNT="$(grep -o "Dépôt manuel" "$INDEX" | wc -l | tr -d " ")"
[ "$CNT" = "1" ] || die "UI contient $CNT fois \"Dépôt manuel\" (doit = 1)."

# 2) Snippet nginx: FORCE alias vers /opt/fireinners/wolverine-static (bypass dist/react)
cat >"$SNIP" << "EOF"
# WOLVERINE (HARD) - single source of truth
location ^~ /wolverine/api/ {
  rewrite ^/wolverine/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 60s;
}
location ^~ /wolverine/ {
  alias /opt/fireinners/wolverine-static/;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
  add_header Pragma "no-cache" always;
  add_header Expires "0" always;
}
EOF
chmod 0644 "$SNIP"
chown root:root "$SNIP"

# 3) VHOST: retirer anciens morceaux wolverine (locations/includes) puis inclure snippet UNE fois
tmp="/root/wolv_backups/vhost.clean.$TS"
awk '
BEGIN{skip=0}
{
  line=$0
  if(line ~ /location[[:space:]]+\^~[[:space:]]+\/wolverine\/api\//){skip=1}
  if(line ~ /location[[:space:]]+\^~[[:space:]]+\/wolverine\//){skip=1}
  if(line ~ /include[[:space:]]+\/etc\/nginx\/snippets\/wolverine/){next}
  if(skip){
    if(line ~ /^\s*\}/){skip=0; next}
    next
  }
  print
}' "$VHOST" > "$tmp"
cp -a "$tmp" "$VHOST"
rm -f "$tmp"

# inject include avant la fin de CHAQUE server{} qui a server_name fireinners.online (idempotent)
tmp="/root/wolv_backups/vhost.inject.$TS"
awk -v inc="    include /etc/nginx/snippets/wolverine_static.conf;" '
function has(s,pat){ return (s ~ pat) }
function countchr(s,c,  n,i){n=0;for(i=1;i<=length(s);i++)if(substr(s,i,1)==c)n++;return n}
BEGIN{in=0;depth=0;target=0;added=0}
{
  line=$0
  if(!in && line ~ /^[[:space:]]*server[[:space:]]*\{/){in=1;depth=0;target=0;added=0}
  if(in){
    depth += countchr(line,"{"); depth -= countchr(line,"}")
    if(line ~ /server_name/ && line ~ /fireinners\.online/){target=1}
    if(line ~ /include[[:space:]]+\/etc\/nginx\/snippets\/wolverine_static\.conf/){added=1}
    if(depth==0 && line ~ /^\s*\}\s*$/){
      if(target && !added){print inc}
      print line
      in=0;target=0;added=0
      next
    }
    print line
    next
  }
  print line
}
' "$VHOST" > "$tmp"
cp -a "$tmp" "$VHOST"
rm -f "$tmp"

# 4) Conflits nginx: disable tout autre enabled qui claim fireinners.online (sauf notre vhost)
for f in /etc/nginx/sites-enabled/*; do
  [ -e "$f" ] || continue
  tgt="$f"; [ -L "$f" ] && tgt="$(readlink -f "$f" || echo "$f")"
  if [ "$tgt" != "$VHOST" ] && grep -Eq "server_name[[:space:]].*fireinners\.online" "$tgt" 2>/dev/null; then
    rm -f "$f" 2>/dev/null || true
  fi
done
ln -sf "$VHOST" "/etc/nginx/sites-enabled/$(basename "$VHOST")"

# 5) test + reload
nginx -t
systemctl reload nginx

# re-lock (optionnel)
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$VHOST" 2>/dev/null || true

log "OK. Wolverine sert maintenant /opt/fireinners/wolverine-static/index.html (1 seul dépôt manuel)."
log "URL: https://fireinners.online/wolverine/"
BASH
chmod +x /root/WOLV_HARD_RESET_V9.sh
/root/WOLV_HARD_RESET_V9.sh
'
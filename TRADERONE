say(){ echo "[$(date +%H:%M:%S)] $*"; }
need_root(){ [ "$(id -u)" -eq 0 ] || { echo "ROOT ONLY"; exit 1; }; }
unfreeze(){ command -v chattr >/dev/null 2>&1 || return 0; chattr -i "$1" 2>/dev/null || true; }
unfreeze_tree(){ command -v chattr >/dev/null 2>&1 || return 0; chattr -i -R "$1" 2>/dev/null || true; }
refreeze_tree(){ command -v chattr >/dev/null 2>&1 || return 0; chattr +i -R "$1" 2>/dev/null || true; }


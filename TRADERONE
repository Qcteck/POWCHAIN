cat >/tmp/WOLVERINE_NGINX_PERMISSION_FIX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

CONF="/etc/nginx/sites-available/fireinners.online"
TS="$(date +%s)"

echo "== WHOAMI / PERMS =="
whoami || true
id || true
echo

echo "== FILE PERMS =="
ls -lah "$CONF" || { echo "MISSING: $CONF"; exit 1; }
echo

echo "== IMMUTABLE ATTR? (lsattr) =="
if command -v lsattr >/dev/null 2>&1; then
  lsattr "$CONF" || true
else
  echo "lsattr not installed"
fi
echo

echo "== FS READ-ONLY? =="
mount | grep -E ' on /(etc|) ' || true
mount | grep -E ' on / ' || true
echo

echo "== TRY: remove immutable if present =="
if command -v chattr >/dev/null 2>&1; then
  chattr -i "$CONF" 2>/dev/null || true
fi

echo "== TRY BACKUP =="
cp -a "$CONF" "$CONF.bak.$TS" || { echo "BACKUP FAILED (still permission issue)"; exit 2; }

echo "== APPEND STATIC BLOCK (inside same conf file) =="
if grep -q "WOLVERINE_STATIC_BEGIN" "$CONF"; then
  echo "Static block already present -> OK"
else
  cat >>"$CONF" <<'NGINX'

  # WOLVERINE_STATIC_BEGIN
  # Force static files under /wolverine/ (no proxy)
  location ^~ /wolverine/ {
    alias /var/www/fireinners/wolverine/;
    try_files $uri $uri/ =404;
    add_header Cache-Control "no-store" always;
  }
  # WOLVERINE_STATIC_END

NGINX
fi

echo "== NGINX TEST + RELOAD =="
nginx -t
systemctl reload nginx

echo "DONE ✅"
SH

bash /tmp/WOLVERINE_NGINX_PERMISSION_FIX.sh
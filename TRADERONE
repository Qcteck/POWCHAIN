bash -lc 'set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WV_INJECT_FIX_$TS"
INC="/etc/nginx/includes/wolverine_routes.inc"
DOMAIN="fireinners.online"
mkdir -p "$BK"
say(){ echo "[$(date -u +%F\ %T\ UTC)] $*"; }

say "BACKUP -> $BK"
cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
[ -f "$INC" ] && cp -a "$INC" "$BK/$(basename "$INC")" 2>/dev/null || true

if command -v chattr >/dev/null 2>&1; then
  say "UNFREEZE chattr -i (best effort)"
  for f in /etc/nginx/nginx.conf /etc/nginx/sites-available/* /etc/nginx/sites-enabled/* /etc/nginx/conf.d/* /etc/nginx/includes/*; do
    [ -e "$f" ] || continue
    chattr -i "$f" 2>/dev/null || true
  done
fi

say "ENSURE include file + required locations"
mkdir -p /etc/nginx/includes
if [ ! -f "$INC" ]; then
  cat >"$INC"<<'"'"'EOF'"'"'
# wolverine routes (managed)
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ { root /var/www; try_files $uri $uri/ /wolverine/index.html; add_header Cache-Control "no-store" always; }

location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
EOF
fi

# add missing locations idempotently
grep -qE "location\s+\^~\s+/wolverine/traderone/vault/" "$INC" 2>/dev/null || cat >>"$INC"<<'"'"'EOF'"'"'

location ^~ /wolverine/traderone/vault/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
EOF

grep -qE "location\s+\^~\s+/wolverine/traderone/api/" "$INC" 2>/dev/null || cat >>"$INC"<<'"'"'EOF'"'"'

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
EOF

say "FIND vhosts containing server_name $DOMAIN"
mapfile -t VHOSTS < <(grep -Rsl --include="*.conf" -E "\bserver_name\b.*${DOMAIN//./\\.}" /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d 2>/dev/null | sort -u || true)
if [ "${#VHOSTS[@]}" -eq 0 ]; then
  say "ERR no vhosts found for $DOMAIN"
  exit 1
fi
printf "%s\n" "${VHOSTS[@]}" | tee "$BK/vhosts_found.txt" >/dev/null
say "VHOSTS count=${#VHOSTS[@]}"

say "INJECT include line into each vhost (if missing)"
patched=0
for f in "${VHOSTS[@]}"; do
  [ -f "$f" ] || continue
  if grep -qF "include /etc/nginx/includes/wolverine_routes.inc;" "$f"; then
    continue
  fi
  tmp="$BK/$(basename "$f").tmp"
  awk -v inc="include /etc/nginx/includes/wolverine_routes.inc;" -v dom="$DOMAIN" '
    BEGIN{done=0}
    {print}
    (!done && $0 ~ /server_name/ && $0 ~ dom){
      print "  "inc
      done=1
    }
  ' "$f" >"$tmp"
  cp -a "$f" "$BK/$(basename "$f").bak" 2>/dev/null || true
  cat "$tmp" >"$f"
  patched=$((patched+1))
done
say "patched_vhosts=$patched"

say "NGINX TEST"
nginx -t

say "RELOAD nginx"
systemctl reload nginx 2>/dev/null || systemctl restart nginx

if command -v chattr >/dev/null 2>&1; then
  say "REFREEZE chattr +i (best effort)"
  chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
  chattr +i "$INC" 2>/dev/null || true
  for f in "${VHOSTS[@]}"; do chattr +i "$f" 2>/dev/null || true; done
fi

say "TEST LOCAL (bypass CF) /wolverine/ (first bytes)"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/" | head -c 140 || true; echo
say "TEST LOCAL (bypass CF) /wolverine/vault-api/health"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/vault-api/health" || true; echo
say "TEST LOCAL (bypass CF) /wolverine/traderone/vault/health"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/traderone/vault/health" || true; echo
say "TEST LOCAL (bypass CF) /wolverine/traderone/api/health"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/traderone/api/health" || true; echo

say "DONE"
say "Backups: $BK"
echo "Open: https://$DOMAIN/wolverine/ (Ctrl+F5)"
'
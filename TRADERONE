cat >/root/WOLVERINE_FIX_RPC_USDC_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP="${HTML}.bak_final_${TS}"

RPC="https://lb.drpc.live/solana/AsxThpeKkEjGtZhCNUEQYo1ZluSgmwsR76RdFhW5UfFk"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"

[ -f "$HTML" ] || { echo "HTML introuvable"; exit 1; }
cp "$HTML" "$BACKUP"
echo "[OK] Backup $BACKUP"

# 1) Nettoyage ancien JS cassé
perl -0777 -i -pe 's/async function refreshUSDC[\s\S]*?\}\s*//g' "$HTML"
perl -0777 -i -pe 's/refreshSOL\s*=\s*async[\s\S]*?\}\s*;//g' "$HTML"

# 2) Injection JS PROPRE
perl -0777 -i -pe "s#</script>#\n<script>\nconst RPC_URL='$RPC';\nconst connection=new solanaWeb3.Connection(RPC_URL,'confirmed');\n\nasync function refreshSOL(){\n if(!window.pubkey)return;\n const lamports=await connection.getBalance(window.pubkey);\n document.getElementById('sol').innerText=(lamports/1e9).toFixed(6);\n}\n\nasync function refreshUSDC(){\n if(!window.pubkey)return;\n const USDC_MINT=new solanaWeb3.PublicKey('$USDC_MINT');\n let total=0;\n const programs=[solanaWeb3.TOKEN_PROGRAM_ID,solanaWeb3.TOKEN_2022_PROGRAM_ID];\n for(const programId of programs){\n  const res=await connection.getParsedTokenAccountsByOwner(window.pubkey,{programId});\n  for(const a of res.value){\n   const info=a.account.data.parsed.info;\n   if(info.mint===USDC_MINT.toBase58()) total+=Number(info.tokenAmount.uiAmount||0);\n  }\n }\n document.getElementById('usdc').innerText=total.toFixed(2);\n}\n\ndocument.addEventListener('DOMContentLoaded',()=>{\n const btn=document.getElementById('refresh');\n if(btn)btn.onclick=async()=>{await refreshSOL();await refreshUSDC();};\n});\n</script>#s" "$HTML"

# 3) Vérification champs HTML
grep -q 'id="sol"' "$HTML" || sed -i 's/SOL:[^<]*/SOL: <span id="sol">0<\/span>/' "$HTML"
grep -q 'id="usdc"' "$HTML" || sed -i 's/USDC:[^<]*/USDC: <span id="usdc">0<\/span>/' "$HTML"
grep -q 'id="refresh"' "$HTML" || sed -i 's/Refresh/<button id="refresh">Refresh<\/button>/' "$HTML"

echo "=== DONE ==="
echo "CTRL+SHIFT+R dans le navigateur"
BASH

chmod +x /root/WOLVERINE_FIX_RPC_USDC_FINAL.sh
/root/WOLVERINE_FIX_RPC_USDC_FINAL.sh
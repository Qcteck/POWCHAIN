cat >/root/ADD_PHANTOM_MINIMAL.sh <<'BASH'
#!/usr/bin/env bash
set -e

HTML="/opt/fireinners/frontend-react/app/dist/index.html"
JS="/opt/fireinners/frontend-react/app/dist/wolverine/phantom.js"

echo "=== AJOUT PHANTOM MINIMAL ==="

# 1. Créer le JS minimal
cat >"$JS" <<'JS'
(async () => {
  if (!window.solana || !window.solana.isPhantom) {
    console.log("Phantom non détecté");
    return;
  }

  const btn = document.querySelector("button");
  const addrEl = document.querySelector("div:contains('Adresse')") || document.body;

  btn.onclick = async () => {
    const resp = await window.solana.connect();
    const pubkey = resp.publicKey.toString();
    document.body.innerHTML = document.body.innerHTML.replace("Adresse: --", "Adresse: " + pubkey);

    const conn = new solanaWeb3.Connection(
      "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",
      "confirmed"
    );

    const bal = await conn.getBalance(resp.publicKey);
    document.body.innerHTML = document.body.innerHTML.replace("SOL: --", "SOL: " + (bal / 1e9).toFixed(4));
  };
})();
JS

# 2. Injecter le script AVANT </body> (une seule fois)
grep -q "phantom.js" "$HTML" || sed -i '/<\/body>/i <script src="/wolverine/phantom.js"></script>' "$HTML"

# 3. Reload nginx
nginx -t && systemctl reload nginx

echo "✔️ Phantom minimal injecté"
echo "➡️ Recharge la page (CTRL+SHIFT+R)"
BASH

chmod +x /root/ADD_PHANTOM_MINIMAL.sh
/root/ADD_PHANTOM_MINIMAL.sh
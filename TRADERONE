bash -lc 'set -euo pipefail;TS="$(date +%Y%m%d_%H%M%S)";VHOST="/etc/nginx/sites-available/fireinners.online-ssl";CONFDDIR="/etc/nginx/conf.d";INCDIR="/etc/nginx/includes";BK="/root/NGINX_FIX_$TS";log(){ printf "\n[%s] %s\n" "$(date -u +%F\ %T\ UTC)" "$*"; };die(){ echo "ERROR: $*" >&2; exit 1; };[[ "$(id -u)" == "0" ]]||die "Lance en root.";command -v nginx >/dev/null||die "nginx manquant.";mkdir -p "$BK" "$INCDIR";unlock(){ command -v chattr >/dev/null&&[[ -e "$1" ]]&&chattr -i "$1" 2>/dev/null||true; };lock(){ command -v chattr >/dev/null&&[[ -e "$1" ]]&&chattr +i "$1" 2>/dev/null||true; };backup(){ [[ -e "$1" ]]&&cp -a "$1" "$BK/$(basename "$1").bak"||true; };ensure_include(){ local inc="$1"; local line="include $inc;"; if [[ -f "$VHOST" ]]; then if grep -Fq "$line" "$VHOST"; then log "Include déjà présent: $inc"; else log "Ajout include dans vhost: $inc"; unlock "$VHOST"; backup "$VHOST"; TMP="$(mktemp)"; awk -v ins="$line" '"'"'BEGIN{done=0}{if(!done && $0 ~ /^[[:space:]]*server[[:space:]]*\{/){print $0;print "  " ins;done=1;next}print $0}'"'"' "$VHOST" > "$TMP"; grep -Fq "$line" "$TMP" || die "Insertion include a échoué pour $inc"; install -m 0644 "$TMP" "$VHOST"; rm -f "$TMP"; lock "$VHOST"; fi; else die "Vhost introuvable: $VHOST"; fi; };log "=== DIAG nginx -t (avant) ===";set +e;OUT="$(nginx -t 2>&1)";RC=$?;set -e;printf "%s\n" "$OUT" | sed -n "1,220p";if [[ $RC -eq 0 ]]; then log "nginx -t OK (rien à corriger)."; exit 0; fi;log "Recherche des conf.d invalides (location hors server)";OFF=();if [[ -d "$CONFDDIR" ]]; then while IFS= read -r -d "" f; do if grep -Eq "^[[:space:]]*location\\b" "$f" && ! grep -Eq "^[[:space:]]*server[[:space:]]*\\{" "$f"; then OFF+=("$f"); fi; done < <(find "$CONFDDIR" -maxdepth 1 -type f -name "*.conf" -print0); fi;if [[ ${#OFF[@]} -eq 0 ]]; then die "nginx -t échoue mais aucun conf.d évident (location hors server) détecté. Copie la sortie complète de nginx -t."; fi;log "Conf.d à corriger: ${OFF[*]}";for f in "${OFF[@]}"; do base="$(basename "$f")"; inc="$INCDIR/$base.inc"; stub="$f"; log "--- Patch $f -> $inc (et stub conf.d)"; unlock "$f"; backup "$f"; cp -a "$f" "$BK/$base.orig"; unlock "$inc"; cp -a "$f" "$inc"; cat >"$stub" <<EOF
# DISABLED by NGINX_FIX_$TS : location directives moved to $inc
# This file must NOT contain "location" outside a server{} block.
EOF
 lock "$stub"; lock "$inc"; ensure_include "$inc";done;log "=== DIAG nginx -t (après) ===";nginx -t;systemctl reload nginx;log "Nginx reload OK";log "Correctif appliqué. Si la route concernée est /orion/ : https://fireinners.online/orion/";log "Backup: $BK";'
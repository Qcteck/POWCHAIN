bash -lc 'set -euo pipefail
BOT_FALLBACK="e8DbBrTJxRetx3HNFb83CsXMySETydHVLwxMzkjcVqh"
RPC_FALLBACK="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
MARK="WOLVERINE_FORCE_START_SEND_SOL_V1"

JS="$(cat <<JS
/* ${MARK} */
(()=>{const W=window;const log=(...a)=>console.log("[WOLV]",...a);
const setStatus=(t)=>{try{const el=document.querySelector("#status,#statusLine,[data-status]");if(el){if(/Status:/i.test(el.textContent||\"\"))el.textContent=\"Status: \"+t;else el.textContent=t;}}catch(e){}log(t);};

const pickBudgetEl=()=>document.querySelector("#budget,#budgetSOL,input[name=budget],input[name=budgetSOL]")||[...document.querySelectorAll("input")].find(i=>/budget/i.test((i.id||\"\")+(i.name||\"\")+(i.placeholder||\"\")));
const getBudgetSOL=()=>{const el=pickBudgetEl();const v=parseFloat(((el&&el.value)||\"\").toString().replace(\",\",\".\"));return isFinite(v)?v:0;};

const findStartBtn=()=>{const all=[...document.querySelectorAll("button,input[type=button],input[type=submit],a")];return all.find(el=>{const tx=(el.textContent||el.value||\"\").toUpperCase();return tx.includes("START WOLVERINE")||tx.includes("START");});};
const findBotAddr=()=>{try{const txt=document.body.innerText||\"\";const m=txt.match(/Adresse\\s*:\\s*([1-9A-HJ-NP-Za-km-z]{32,44})/i);if(m&&m[1])return m[1];}catch(e){}return (W.TRADERONE_WALLET||W.__TRADERONE_WALLET||\"${BOT_FALLBACK}\");};

async function loadScript(url){return new Promise((res,rej)=>{const s=document.createElement("script");s.src=url;s.async=true;s.onload=()=>res(url);s.onerror=()=>rej(new Error("load fail "+url));document.head.appendChild(s);});}
async function ensureWeb3(){
  if(W.solanaWeb3&&W.solanaWeb3.PublicKey)return W.solanaWeb3;
  const base=(location.pathname.includes("/wolverine")?"/wolverine":"")+"/vendor/";
  const tries=[base+"solana-web3.min.js",base+"solanaWeb3.min.js",base+"solana-web3.js",base+"web3.min.js",base+"web3.js","./vendor/solana-web3.min.js","./vendor/solanaWeb3.min.js"];
  setStatus("Charge libs Solana...");
  for(const u of tries){try{await loadScript(u);if(W.solanaWeb3&&W.solanaWeb3.PublicKey){setStatus("Libs Solana OK");return W.solanaWeb3;}}catch(e){}}
  throw new Error("Libs Solana introuvables (/wolverine/vendor/*)");
}
async function ensurePhantom(){
  const P=W.phantom?.solana||W.solana;
  if(!P)throw new Error("Phantom introuvable");
  if(!P.isConnected){setStatus("Connect Phantom...");await P.connect({onlyIfTrusted:false});}
  return P;
}

async function startSendSOL(){
  const P=await ensurePhantom();
  const S=await ensureWeb3();
  const owner=new S.PublicKey(P.publicKey.toString());
  const sol=getBudgetSOL();
  if(!(sol>0))throw new Error("Budget SOL invalide");
  const lamports=Math.round(sol*1e9);
  if(!(lamports>0))throw new Error("Montant trop petit");

  const bot=new S.PublicKey(findBotAddr());
  const conn=W.__WOLV_CONN__||(W.__WOLV_CONN__=new S.Connection(W.__RPC__||W.RPC_URL||"${RPC_FALLBACK}","confirmed"));

  setStatus("Prépare TX SOL...");
  const ix=S.SystemProgram.transfer({fromPubkey:owner,toPubkey:bot,lamports});
  const {blockhash,lastValidBlockHeight}=await conn.getLatestBlockhash("confirmed");
  const tx=new S.Transaction({feePayer:owner,blockhash,lastValidBlockHeight}).add(ix);

  setStatus("Signature Phantom (popup)...");
  let sig;
  if(P.signAndSendTransaction){sig=await P.signAndSendTransaction(tx);sig=(sig.signature||sig).toString();}
  else{const stx=await P.signTransaction(tx);sig=await conn.sendRawTransaction(stx.serialize(),{skipPreflight:false});}

  setStatus("Envoi... "+sig.slice(0,8));
  await conn.confirmTransaction({signature:sig,blockhash,lastValidBlockHeight},"confirmed");

  try{await fetch("/api/start",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({budgetSOL:sol,from:owner.toBase58(),txid:sig})});}catch(e){}
  setStatus("OK");
}

function bind(){
  const b=findStartBtn();
  if(!b){setTimeout(bind,250);return;}
  const el=pickBudgetEl();if(el && !/SOL/i.test(el.placeholder||"")) el.placeholder=(el.placeholder?el.placeholder+" ":"")+"(SOL)";
  b.addEventListener("click",(ev)=>{ev.preventDefault();ev.stopPropagation();ev.stopImmediatePropagation();startSendSOL().catch(e=>setStatus("ERR: "+(e&&e.message||e)));},true);
  setStatus("READY");
}
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",bind);else bind();
})();
JS
)"

found=0
while IFS= read -r f; do
  d="$(dirname "$f")"
  mkdir -p "$d/patches"
  printf "%s\n" "$JS" > "$d/patches/force_start.js"
  if ! grep -q "${MARK}" "$f"; then
    if grep -qi "</body>" "$f"; then
      perl -0777 -pe "s#</body>#<script src=\"./patches/force_start.js\"></script>\\n</body>#i" -i "$f"
    else
      printf "\n<script src=\"./patches/force_start.js\"></script>\n" >> "$f"
    fi
  fi
  echo "[OK] PATCH(SOL) -> $f"
  found=1
done < <(find /opt /var/www /srv /root /home -type f -iname "index.html" 2>/dev/null | xargs -r grep -Il "START WOLVERINE" 2>/dev/null || true)

[ "$found" -eq 1 ] || { echo "[ERR] Aucun index.html avec START WOLVERINE trouvé"; exit 2; }
echo "DONE. Recharge la page en dur (Ctrl+F5) puis clique START: popup Phantom + envoi SOL."
'
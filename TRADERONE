#!/usr/bin/env bash
set -euo pipefail

### ===== CONFIG FIGÉE =====
APP="WOLVERINE"
REPO_URL="git@github.com:TONORG/wolverine.git"
BRANCH="main"

BASE="/opt/wolverine"
WEB="/var/www/html/wolverine"
LOG="/var/log/wolverine_mega.log"
TS="$(date +%Y%m%d_%H%M%S)"

### ===== GARDE-FOUS =====
[ "$(id -u)" = "0" ] || { echo "❌ root requis"; exit 1; }
exec > >(tee -a "$LOG") 2>&1
echo "=== $APP MEGA BATCH $TS ==="

### ===== DÉPENDANCES =====
apt-get update -y
apt-get install -y git curl rsync ca-certificates

if ! command -v node >/dev/null; then
  curl -fsSL https://deb.nodesource.com/setup_lts.x | bash -
  apt-get install -y nodejs
fi
npm i -g pm2

### ===== CLONE / UPDATE =====
if [ ! -d "$BASE/.git" ]; then
  echo "Clone repo"
  mkdir -p "$BASE"
  git clone -b "$BRANCH" "$REPO_URL" "$BASE"
else
  echo "Update repo"
  cd "$BASE"
  git pull --rebase
fi

### ===== BACKUP UI =====
mkdir -p "$WEB/_backup"
if [ -f "$WEB/index.html" ]; then
  cp "$WEB/index.html" "$WEB/_backup/index.$TS.html"
fi

### ===== DEPLOY UI =====
mkdir -p "$WEB"
rsync -a --delete "$BASE/frontend/wolverine/" "$WEB/"

### ===== BACKEND =====
cd "$BASE/backend"
[ -f package.json ] && npm ci || true

pm2 start server.js --name wolverine-api || pm2 restart wolverine-api
pm2 save

### ===== NGINX =====
systemctl reload nginx || true

echo "=== DONE $APP $TS ==="
echo "UI : https://TON_DOMAINE/wolverine/"
echo "LOG: $LOG"
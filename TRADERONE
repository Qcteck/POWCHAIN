cat >/tmp/WOLVERINE_INDEX_ADD_TRADERONE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

IDX="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
MARK="WOLV_TRADERONE_OVERLAY_V1"

[ -f "$IDX" ] || { echo "ERREUR: index introuvable: $IDX"; exit 1; }

if grep -q "$MARK" "$IDX"; then
  echo "OK: injection déjà présente dans $IDX"
else
  cp -a "$IDX" "$IDX.bak.$(date +%s)"
  INJ='
<!-- WOLV_TRADERONE_OVERLAY_V1 -->
<style>
  #to_btn{position:fixed;right:14px;bottom:14px;z-index:99999;border:1px solid rgba(255,255,255,.18);
    background:rgba(10,18,34,.88);color:#e7f0ff;padding:10px 12px;border-radius:14px;cursor:pointer;
    font:14px system-ui;backdrop-filter:blur(10px);box-shadow:0 12px 30px rgba(0,0,0,.35)}
  #to_btn:hover{filter:brightness(1.08)}
  #to_modal{display:none;position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,.72);backdrop-filter:blur(8px)}
  #to_card{position:absolute;inset:14px;border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.15);
    background:#05060b;box-shadow:0 18px 70px rgba(0,0,0,.6)}
  #to_ifr{width:100%;height:100%;border:0;background:#05060b}
  #to_bar{position:absolute;left:12px;top:12px;right:12px;display:flex;gap:8px;justify-content:flex-end;z-index:2}
  #to_bar button{border:1px solid rgba(255,255,255,.18);background:rgba(10,18,34,.88);color:#e7f0ff;
    padding:8px 10px;border-radius:12px;cursor:pointer;font:13px system-ui}
  #to_bar button:hover{filter:brightness(1.08)}
</style>

<div id="to_modal" aria-hidden="true">
  <div id="to_card">
    <div id="to_bar">
      <button id="to_open">Ouvrir</button>
      <button id="to_reload">Reload</button>
      <button id="to_close">Fermer</button>
    </div>
    <iframe id="to_ifr" src="/wolverine/traderone/"></iframe>
  </div>
</div>

<button id="to_btn">TraderOne</button>

<script>
(()=> {
  const M=document.getElementById("to_modal");
  const B=document.getElementById("to_btn");
  const C=document.getElementById("to_close");
  const O=document.getElementById("to_open");
  const R=document.getElementById("to_reload");
  const I=document.getElementById("to_ifr");
  if(!M||!B||!C||!O||!R||!I) return;

  const show=()=>{M.style.display="block"; M.setAttribute("aria-hidden","false");};
  const hide=()=>{M.style.display="none"; M.setAttribute("aria-hidden","true");};

  B.addEventListener("click", show);
  C.addEventListener("click", hide);
  O.addEventListener("click", ()=>window.open("/wolverine/traderone/","_blank"));
  R.addEventListener("click", ()=>{ I.src = I.src; });

  M.addEventListener("click", (e)=>{ if(e.target===M) hide(); });
  document.addEventListener("keydown", (e)=>{ if(e.key==="Escape") hide(); });
})();
</script>
'
  if grep -qi '</body>' "$IDX"; then
    awk -v inj="$INJ" 'BEGIN{IGNORECASE=1} { if($0 ~ /<\/body>/ && !done){print inj; done=1} print } END{ if(!done) print inj }' "$IDX" >"$IDX.tmp"
    mv "$IDX.tmp" "$IDX"
  else
    printf "%s\n" "$INJ" >> "$IDX"
  fi
  echo "OK: injection ajoutée + backup créé."
fi

nginx -t && systemctl reload nginx
echo "TEST:"
curl -ksS --max-time 6 https://fireinners.online/wolverine/ | head -c 120; echo
curl -ksS --max-time 6 https://fireinners.online/wolverine/traderone/ | head -c 120; echo
echo "DONE."
SH

bash /tmp/WOLVERINE_INDEX_ADD_TRADERONE.sh
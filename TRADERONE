#!/bin/bash
set -e

# ===== PARAMS FIXES =====
UI="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor"
TS=$(date +%Y%m%d_%H%M%S)
BACKUP="/var/www/_BACKUP_WOLVERINE_UI_$TS"
LOG="/root/wolverine_ui_root_$TS.log"

exec > >(tee -a "$LOG") 2>&1

echo "=== WOLVERINE ROOT BATCH ==="

# ===== CHECK =====
[ -f "$UI" ] || { echo "UI introuvable: $UI"; exit 1; }

# ===== BACKUP =====
echo "[1/6] Backup"
mkdir -p "$BACKUP"
cp -a "$UI" "$BACKUP/"

# ===== VENDOR (Chart.js local) =====
echo "[2/6] Vendor"
mkdir -p "$VENDOR"
[ -f "$VENDOR/chart.min.js" ] || curl -sL https://cdn.jsdelivr.net/npm/chart.js > "$VENDOR/chart.min.js"

# ===== CSS FULL WIDTH / NO SCROLL =====
echo "[3/6] CSS largeur totale"
grep -q "WOLVERINE_ROOT_FIX" "$UI" || sed -i "/<\/head>/i \
<!-- WOLVERINE_ROOT_FIX -->\
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\
<style>\
html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden}\
#app{display:flex;width:100vw;height:100vh;overflow:hidden}\
.sidebar{flex:0 0 220px;overflow:hidden}\
.content{flex:1;width:calc(100vw - 220px);max-width:calc(100vw - 220px);overflow:hidden}\
.main,.panel{width:100%;height:100%;overflow:hidden}\
.hidden{display:none!important}\
.bg-chart{position:absolute;inset:0;opacity:.14;pointer-events:none}\
</style>" "$UI"

# ===== KILL ROUTING (NO PAGE BREAKS) =====
echo "[4/6] Neutralisation navigation"
sed -i "s|href=\"/wolverine/[^\\\"]*\"|href=\"#\"|g" "$UI"

# ===== JS: SPA SWITCH + BG CHART + PHANTOM + BACKEND =====
echo "[5/6] JS SPA + Phantom + Backend"
sed -i "/<\/body>/i \
<script src=\"/wolverine/vendor/chart.min.js\"></script>\
<script>\
/* SPA SWITCH (no routing) */\
document.querySelectorAll('.sidebar a').forEach(a=>{\
 a.onclick=e=>{e.preventDefault();\
  document.querySelectorAll('.panel').forEach(p=>p.classList.add('hidden'));\
  const k=a.textContent.trim().toLowerCase();\
  const p=document.getElementById('panel-'+k)||document.getElementById('panel-dashboard');\
  p&&p.classList.remove('hidden');\
 };\
});\
/* BG CHART DASHBOARD */\
const d=document.getElementById('panel-dashboard');\
if(d&&!d.querySelector('.bg-chart')){\
 const c=document.createElement('canvas');c.className='bg-chart';d.appendChild(c);\
 new Chart(c.getContext('2d'),{type:'line',data:{labels:[1,2,3,4,5],datasets:[{data:[100,102,101,104,103],borderWidth:2,tension:.4}]},options:{responsive:true,plugins:{legend:{display:false}},scales:{x:{display:false},y:{display:false}}});\
}\
/* PHANTOM REAL CONNECT */\
const btn=document.querySelector('button');\
if(btn){btn.onclick=async()=>{\
 if(!window.solana||!window.solana.isPhantom){alert('Ouvre dans Phantom');return;}\
 const r=await window.solana.connect({onlyIfTrusted:false});\
 const pk=r.publicKey.toString();\
 document.querySelectorAll('.wallet-address').forEach(e=>e.textContent=pk);\
 fetch('/wolverine/traderone/api/balances?pub='+pk)\
 .then(r=>r.json()).then(b=>{\
  document.querySelectorAll('.wallet-sol').forEach(e=>e.textContent=b.sol);\
  document.querySelectorAll('.wallet-usdc').forEach(e=>e.textContent=b.usdc);\
 });\
};}\
</script>" "$UI"

# ===== DONE =====
echo "[6/6] OK"
echo "Backup: $BACKUP"
echo "Log: $LOG"
echo "=== DONE ==="
cat >/root/WOLVERINE_WALLET_FIX_ALL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

### CONFIG
ROOT="/var/www/wolverine"
VENDOR="$ROOT/vendor"
HTML="$ROOT/index.html"
TS=$(date +%Y%m%d_%H%M%S)

RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

echo "== BACKUP =="
cp "$HTML" "$HTML.bak_$TS"

echo "== VENDOR =="
mkdir -p "$VENDOR"

if [ ! -f "$VENDOR/solana-web3.min.js" ]; then
  echo "Downloading solana-web3.js (local)"
  curl -sL https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js \
    -o "$VENDOR/solana-web3.min.js"
fi

echo "== WRITE HTML =="
cat >"$HTML" <<'HTML'
<!DOCTYPE html><html><head>
<meta charset="utf-8">
<title>WOLVERINE Wallet</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<script src="/wolverine/vendor/solana-web3.min.js"></script>
<style>
body{background:#050b12;color:#00eaff;font-family:monospace}
#box{width:420px;margin:120px auto;padding:20px;border:2px solid #00eaff}
button{width:100%;margin:6px 0;padding:10px;background:#050b12;color:#00eaff;border:1px solid #00eaff;cursor:pointer}
.addr{word-break:break-all;margin-top:10px}
</style>
</head>
<body>
<div id="box">
<button onclick="connect()">Connect Wallet</button>
<button onclick="refresh()">Refresh</button>
<div class="addr" id="addr">-</div>
<div>SOL: <span id="sol">-</span></div>
<div>USDC: <span id="usdc">-</span></div>
</div>

<script>
const RPC = "RPC_ENDPOINT";
const USDC_MINT = "USDC_MINT_ADDR";
let PUB=null,CONN=null;

async function connect(){
 if(!window.solana||!window.solana.isPhantom){alert("Phantom not found");return;}
 const r=await window.solana.connect();
 PUB=r.publicKey.toString();
 document.getElementById("addr").textContent=PUB;
 CONN=new solanaWeb3.Connection(RPC,"confirmed");
 await refresh();
}

async function refresh(){
 if(!PUB||!CONN)return;

 const pk=new solanaWeb3.PublicKey(PUB);

 // SOL
 const lamports=await CONN.getBalance(pk);
 document.getElementById("sol").textContent=(lamports/1e9).toFixed(6);

 // USDC
 let usdc=0;
 const accts=await CONN.getParsedTokenAccountsByOwner(pk,{mint:new solanaWeb3.PublicKey(USDC_MINT)});
 for(const a of accts.value){
   usdc+=a.account.data.parsed.info.tokenAmount.uiAmount||0;
 }
 document.getElementById("usdc").textContent=usdc.toFixed(2);
}
</script>
</body></html>
HTML

sed -i "s|RPC_ENDPOINT|$RPC|" "$HTML"
sed -i "s|USDC_MINT_ADDR|$USDC_MINT|" "$HTML"

echo "== NGINX CHECK =="
nginx -t && systemctl reload nginx

echo "== DONE =="
echo "Backup: $HTML.bak_$TS"
echo "Open: https://fireinners.online/wolverine"
BASH

chmod +x /root/WOLVERINE_WALLET_FIX_ALL.sh
/root/WOLVERINE_WALLET_FIX_ALL.sh





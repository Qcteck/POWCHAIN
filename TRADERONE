cat > /root/WOLVERINE_FIX_JS_USDC_SAFE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

echo "=== WOLVERINE FIX JS USDC (SAFE) ==="

echo "[1/6] Vérification fichier"
[ -f "$HTML" ] || { echo "ERREUR: index.html introuvable"; exit 1; }

echo "[2/6] Backup"
cp -a "$HTML" "$HTML.bak_jsfix_$TS"

echo "[3/6] Suppression ligne JS invalide affichée dans le HTML"
sed -i '/try{document.getElementById("usdc").innerText=await readUSDC/ d' "$HTML"

echo "[4/6] Injection correctrice JS (safe, encapsulée)"
sed -i '/<\/body>/i \
<script>\n\
/* === USDC FIX SAFE === */\n\
window.USER_PUB = null;\n\
async function refreshUSDC(){\n\
  try{\n\
    if(!window.USER_PUB || !window.readUSDC) return;\n\
    const v = await readUSDC(window.USER_PUB);\n\
    const el = document.getElementById("usdc");\n\
    if(el) el.innerText = v;\n\
  }catch(e){console.warn("USDC refresh failed",e)}\n\
}\n\
</script>' "$HTML"

echo "[5/6] Branchement refreshUSDC après refresh wallet"
sed -i 's/async function refresh(/async function refresh(/' "$HTML"
sed -i '/async function refresh(/,/}/ s/}$/  refreshUSDC();\n}/' "$HTML" || true

echo "[6/6] Reload nginx + purge cache serveur"
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx

echo
echo "=== FIX TERMINE ==="
echo "ACTION:"
echo "- CTRL + SHIFT + R"
echo "- Console doit être VIDE"
echo "- USDC doit s’afficher"
echo "Backup: $HTML.bak_jsfix_$TS"
BASH

chmod +x /root/WOLVERINE_FIX_JS_USDC_SAFE.sh
/root/WOLVERINE_FIX_JS_USDC_SAFE.sh
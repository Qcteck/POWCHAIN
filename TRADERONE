// Auto mise à jour
function toggleAuto() {
  if (autoInterval) {
    clearInterval(autoInterval);
    document.getElementById('autoStatus').textContent = 'OFF';
  } else {
    rapport();
    autoInterval = setInterval(rapport, 15*60*1000);
    document.getElementById('autoStatus').textContent = 'ON';
  }
}
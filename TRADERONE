cat >/root/cleanup_sites_enabled_fireinners.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DST="/etc/nginx/sites-disabled/cleanup_${TS}"
mkdir -p "$DST"

echo "== BEFORE =="
ls -lah /etc/nginx/sites-enabled

echo
echo "== Move ALL variants of fireinners.online-ssl.* out of sites-enabled (keep only exact fireinners.online-ssl) =="
shopt -s nullglob
for f in /etc/nginx/sites-enabled/fireinners.online-ssl.*; do
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== Also move any generic *.bak* / *.broken* just in case =="
for f in /etc/nginx/sites-enabled/*.bak* /etc/nginx/sites-enabled/*.broken*; do
  [ -e "$f" ] || continue
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== AFTER =="
ls -lah /etc/nginx/sites-enabled

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload =="
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/cleanup_sites_enabled_fireinners.sh
/root/cleanup_sites_enabled_fireinners.sh
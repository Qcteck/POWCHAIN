cat >/tmp/WOLVERINE_TRADERONE_MERGE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then . "$ASKLIB"; else
  askorupdate_file(){ local p="$1"; local content="$2"; mkdir -p "$(dirname "$p")"; printf "%s" "$content" >"$p"; }
  askorupdate_yesno(){ local q="$1"; read -r -p "$q (y/N) " a || true; case "${a,,}" in y|yes) return 0;; *) return 1;; esac; }
fi

say(){ printf "%s\n" "$*"; }

NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
DEFAULT_WOLV="/opt/fireinners/frontend-react/app/dist/wolverine"
TR_DIR="/opt/traderone-opt"

need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: commande manquante: $1"; exit 1; }; }

pick_wolverine_outdir(){
  local out=""
  if [ -f "$NGX_SITE" ]; then
    out="$(awk '
      $1=="location" && $2=="/wolverine" {inloc=1}
      inloc && $1=="alias" {gsub(";","",$2); print $2; exit}
      inloc && $1=="root"  {gsub(";","",$2); print $2 "/wolverine"; exit}
      inloc && $0 ~ /}/ {inloc=0}
    ' "$NGX_SITE" 2>/dev/null || true)"
  fi
  if [ -z "${out:-}" ]; then out="$DEFAULT_WOLV"; fi
  printf "%s" "$out"
}

pick_traderone_front(){
  local c
  for c in \
    "$TR_DIR" \
    "$TR_DIR/dist" \
    "$TR_DIR/public" \
    "$TR_DIR/frontend/dist" \
    "$TR_DIR/frontend/build" \
    "$TR_DIR/app/dist" \
    "$TR_DIR/www" \
    "$TR_DIR/site" \
    ; do
    if [ -f "$c/index.html" ]; then printf "%s" "$c"; return 0; fi
  done
  # dernier recours: chercher un index.html mais sans traverser trop profond
  local f
  f="$(find "$TR_DIR" -maxdepth 4 -type f -name index.html 2>/dev/null | head -n 1 || true)"
  if [ -n "${f:-}" ]; then dirname "$f"; return 0; fi
  return 1
}

say "=== BATCH FLY (read-only) ==="
say "whoami: $(whoami)  host: $(hostname)  date: $(date -u +%FT%TZ)"
need nginx
need curl
need rsync

OUTDIR="$(pick_wolverine_outdir)"
say "Wolverine OUTDIR: $OUTDIR"

if [ ! -d "$TR_DIR" ]; then
  say "ERREUR: TraderOne introuvable: $TR_DIR"
  exit 1
fi

TR_FRONT="$(pick_traderone_front || true)"
if [ -z "${TR_FRONT:-}" ]; then
  say "ERREUR: impossible de trouver le frontend TraderOne (index.html) dans $TR_DIR"
  say "Astuce: il doit exister un index.html dans /opt/traderone-opt (ou dist/public/frontend/dist...)"
  exit 1
fi
say "TraderOne FRONT: $TR_FRONT"

say "Test ping Wolverine (si existant):"
curl -ksS --max-time 5 "https://fireinners.online/wolverine/api/ping" | head -c 120 || true
echo

say "Ce script va:"
say "- copier TraderOne => $OUTDIR/traderone/ (rsync --delete)"
say "- remplacer $OUTDIR/index.html (hub Wolverine + TraderOne)"
say "- reload nginx (après nginx -t)"
if ! askorupdate_yesno "Continuer ?"; then
  say "Stop."
  exit 0
fi

say "=== MEGA BATCH (apply) ==="
mkdir -p "$OUTDIR"
chmod 755 "$OUTDIR" || true

# 1) Copier TraderOne sous /wolverine/traderone/
mkdir -p "$OUTDIR/traderone"
rsync -a --delete "$TR_FRONT/." "$OUTDIR/traderone/."

# 2) Hub index.html (Wolverine + TraderOne)
HTML='<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE + TraderOne • FireInners</title><style>:root{--bg:#070a12;--p:#0c1222;--p2:#070a14;--l:#1b2a44;--t:#e7f0ff;--m:#9fb3d7;--ok:#b9ffcf;--bad:#ffb3b3;--a:#9ff}*{box-sizing:border-box}html,body{margin:0;height:100%;background:radial-gradient(900px 600px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(700px 450px at 80% 20%,#101a33 0%,transparent 55%),var(--bg);color:var(--t);font:14px system-ui}a{color:var(--a);text-decoration:none}a:hover{text-decoration:underline}#top{position:sticky;top:0;z-index:9;background:linear-gradient(#070a12,#070a12cc);backdrop-filter:blur(10px);border-bottom:1px solid rgba(27,42,68,.7)}#wrap{max-width:1200px;margin:0 auto;padding:14px}#hdr{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}#brand{display:flex;align-items:center;gap:10px}#logo{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#ffb35a,#ff5b5b,#9f6bff);box-shadow:0 0 18px rgba(159,111,255,.25)}#ttl{font-weight:850;letter-spacing:.6px}#sub{color:var(--m);font-size:12px;margin-top:2px}#tabs{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}button,.tab{border:1px solid rgba(27,42,68,.85);background:#0b1222;color:var(--t);padding:10px 12px;border-radius:12px;cursor:pointer}button:hover,.tab:hover{filter:brightness(1.08)}.tab{user-select:none}#main{max-width:1200px;margin:0 auto;padding:14px}#panel{background:linear-gradient(180deg,rgba(12,18,34,.85),rgba(7,10,20,.75));border:1px solid rgba(27,42,68,.7);border-radius:16px;padding:14px}#row{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0}#log{white-space:pre-wrap;background:#060812;border:1px solid rgba(27,42,68,.65);border-radius:12px;padding:10px;min-height:92px;color:#cfe0ff}#st{display:inline-flex;gap:8px;align-items:center;padding:8px 10px;border-radius:999px;border:1px solid rgba(27,42,68,.7);background:rgba(12,18,34,.55)}.ok{color:var(--ok)}.bad{color:var(--bad)}#frameWrap{height:calc(100vh - 190px);min-height:520px;border:1px solid rgba(27,42,68,.7);border-radius:14px;overflow:hidden;background:#05060b}iframe{width:100%;height:100%;border:0;background:#05060b}#foot{margin-top:12px;color:var(--m);font-size:12px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between}</style></head><body><div id="top"><div id="wrap"><div id="hdr"><div id="brand"><div id="logo"></div><div><div id="ttl">WOLVERINE + TraderOne</div><div id="sub">Hub unique • /wolverine</div></div></div><div id="st">Etat API: <b id="stb">?</b></div></div><div id="tabs"><div class="tab" id="tW">Wolverine</div><div class="tab" id="tT">TraderOne</div><button id="bNew">Ouvrir TraderOne</button><button id="bPing">Tester /api/ping</button><button id="bPingOpen">Ouvrir /api/ping</button><button id="bRefresh">Refresh</button></div></div></div><div id="main"><div id="panel"><div id="W"><div style="font-weight:750;margin-bottom:6px">Console Wolverine</div><div id="row"><button id="bPing2">Tester API /ping</button><button id="bTG">Ouvrir Telegram (WOLVERINE)</button><button id="bHelp">Aide</button></div><div id="log"></div><div style="margin-top:10px;display:flex;gap:10px;flex-wrap:wrap"><span id="st" style="opacity:.95">Ping: <a href="/wolverine/api/ping" target="_blank" rel="noreferrer">/wolverine/api/ping</a></span><span id="st" style="opacity:.95">TraderOne: <a href="/wolverine/traderone/" target="_blank" rel="noreferrer">/wolverine/traderone/</a></span></div></div><div id="T" style="display:none"><div style="font-weight:750;margin-bottom:10px">TraderOne intégré</div><div id="frameWrap"><iframe id="ifr" src="/wolverine/traderone/"></iframe></div></div><div id="foot"><div>Note: les alertes Telegram ne s’envoient que sur changement d’état (anti-spam). Le heartbeat est séparé si activé côté serveur.</div><div><a href="https://fireinners.online" target="_blank" rel="noreferrer">fireinners.online</a></div></div></div></div><script>(()=>{const $=s=>document.querySelector(s),log=$("#log"),stb=$("#stb");const u="/wolverine/api/ping";const w=t=>{log.textContent=(t+(log.textContent?("\n"+log.textContent):"")).slice(0,8000)};const set=(ok,txt)=>{stb.textContent=txt;stb.className=ok?"ok":"bad"};async function ping(){set(false,"...");try{const r=await fetch(u,{cache:"no-store"});const t=await r.text();const ok=/pong/i.test(t)||r.ok;set(ok,ok?"UP":"DOWN");w(new Date().toISOString()+"  "+(ok?"OK":"ERR")+"  "+t.slice(0,240));}catch(e){set(false,"DOWN");w(new Date().toISOString()+"  ERR  "+String(e).slice(0,240));}}function show(which){$("#W").style.display=which==="W"?"block":"none";$("#T").style.display=which==="T"?"block":"none";}$("#tW").onclick=()=>show("W");$("#tT").onclick=()=>show("T");$("#bPing").onclick=ping;$("#bPing2").onclick=ping;$("#bPingOpen").onclick=()=>window.open(u,"_blank");$("#bRefresh").onclick=()=>location.reload();$("#bNew").onclick=()=>window.open("/wolverine/traderone/","_blank");$("#bTG").onclick=()=>window.open("tg://resolve?domain=WOLVERINE_V1BOT","_blank");$("#bHelp").onclick=()=>w("Aide:\n- TraderOne est servi ici: /wolverine/traderone/\n- API Wolverine: /wolverine/api/ping\n- Si Telegram OK mais pas de nouveaux messages: normal si pas de changement d’état.");ping();})();</script></body></html>'

askorupdate_file "$OUTDIR/index.html" "$HTML"
chmod 644 "$OUTDIR/index.html" || true

say "Test nginx:"
nginx -t
say "Reload nginx:"
systemctl reload nginx

say "Tests rapides:"
curl -ksS --max-time 6 "https://fireinners.online/wolverine/" | head -c 120 || true
echo
curl -ksS --max-time 6 "https://fireinners.online/wolverine/traderone/" | head -c 120 || true
echo
say "DONE."
SH
chmod +x /tmp/WOLVERINE_TRADERONE_MERGE.sh
bash /tmp/WOLVERINE_TRADERONE_MERGE.sh
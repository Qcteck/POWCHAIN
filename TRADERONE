"use strict";
const fs=require("fs");
const express=require("express");
const fetch=require("node-fetch");
const {Connection,PublicKey}=require("@solana/web3.js");
const spl=require("@solana/spl-token");

const BOT_PUB=new PublicKey(process.env.BOT_PUB);
const USDC_MINT=new PublicKey(process.env.USDC_MINT);
const RPC_URL=process.env.RPC_URL;
const LEDGER_FILE=process.env.LEDGER_FILE;
const API_PORT=Number(process.env.API_PORT||3002);

const conn=new Connection(RPC_URL,"confirmed");
const app=express();
app.use(express.json({limit:"256kb"}));

const n=x=>{const v=Number(x);return Number.isFinite(v)?v:0;};
const now=()=>Date.now();

function readLedger(){
  try{return JSON.parse(fs.readFileSync(LEDGER_FILE,"utf8")||"{}");}
  catch{return {users:{},deposits_seen:{}};}
}
function writeLedger(L){fs.writeFileSync(LEDGER_FILE,JSON.stringify(L,null,2));}

function botUsdcAta(){ return spl.getAssociatedTokenAddressSync(USDC_MINT,BOT_PUB,false); }

function matchSolDeposit(tx,fromPub,minSol){
  if(!tx||tx.meta?.err) return null;
  const ix=tx.transaction?.message?.instructions||[];
  for(const it of ix){
    if(it?.program==="system"&&it?.parsed?.type==="transfer"){
      const info=it.parsed.info||{};
      if(info.source===fromPub && info.destination===BOT_PUB.toBase58()){
        const sol=n(info.lamports)/1e9;
        if(sol+1e-12>=minSol) return {sig:tx.transaction.signatures?.[0],amount:sol};
      }
    }
  }
  return null;
}

function matchUsdcDeposit(tx,fromPub,minUsdc){
  if(!tx||tx.meta?.err) return null;
  const dstAta=botUsdcAta().toBase58();
  const ix=tx.transaction?.message?.instructions||[];
  for(const it of ix){
    if(it?.program==="spl-token" && it?.parsed){
      const info=it.parsed.info||{};
      const dst=info.destination;
      if(dst===dstAta){
        let ui=0;
        if(info.tokenAmount && info.tokenAmount.uiAmount!=null) ui=n(info.tokenAmount.uiAmount);
        else if(info.amount) ui=n(info.amount)/1e6;
        const auth=info.authority||"";
        const okFrom=(auth===fromPub);
        if(okFrom && ui+1e-12>=minUsdc) return {sig:tx.transaction.signatures?.[0],amount:ui};
      }
    }
  }
  return null;
}

async function scanDeposit(pub,asset,amount){
  const fromPub=new PublicKey(pub).toBase58();
  const L=readLedger();
  if(!L.users) L.users={};
  if(!L.deposits_seen) L.deposits_seen={};

  const target=(asset==="USDC")?botUsdcAta():BOT_PUB;
  const sigs=await conn.getSignaturesForAddress(target,{limit:40});
  for(const s of sigs){
    const sig=s.signature;
    if(!sig||L.deposits_seen[sig]) continue;
    const tx=await conn.getParsedTransaction(sig,{maxSupportedTransactionVersion:0,commitment:"confirmed"});
    const hit=(asset==="SOL")?matchSolDeposit(tx,fromPub,amount):matchUsdcDeposit(tx,fromPub,amount);
    if(hit&&hit.sig){
      L.deposits_seen[hit.sig]={at:now(),pub:fromPub,asset,amount:hit.amount};
      if(!L.users[fromPub]) L.users[fromPub]={mode:"AUTO",last_deposit:null};
      L.users[fromPub].last_deposit={sig:hit.sig,asset,amount:hit.amount,at:now()};
      writeLedger(L);
      return {ok:true,sig:hit.sig,amount:hit.amount};
    }
  }
  writeLedger(L);
  return {ok:false};
}

app.get("/wolverine/api/health",(_req,res)=>res.json({ok:true}));
app.get("/wolverine/api/wolv_state",(req,res)=>{

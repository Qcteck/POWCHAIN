cat >/root/patch_remove_blueprint_request.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ROOT="/var/www/wolverine"
TS="$(date -u +%Y%m%d_%H%M%S)"

PAT1="blueprint_robo600"
PAT2="/wolverine/blueprint/blueprint_robo600.mp4"
REPL="about:blank"

echo "=== 1) Find bundles containing blueprint reference ==="
MATCHES="$(grep -RInE --binary-files=text "$PAT1|blueprint_robo600\.mp4|/wolverine/blueprint/" "$ROOT" 2>/dev/null | head -n 50 || true)"
echo "$MATCHES"
echo

if [ -z "${MATCHES// /}" ]; then
  echo "❌ No match found in $ROOT"
  echo "If browser still requests it, it's likely a Service Worker / browser cache."
  exit 0
fi

echo "=== 2) Collect unique files to patch ==="
FILES="$(echo "$MATCHES" | cut -d: -f1 | sort -u | tr '\n' ' ')"
echo "$FILES"
echo

echo "=== 3) Backup matched files ==="
BK="/root/blueprint_patch_backup_${TS}"
mkdir -p "$BK"
for f in $FILES; do
  if [ -f "$f" ]; then
    mkdir -p "$BK/$(dirname "$f")"
    cp -a "$f" "$BK/$f"
  fi
done
echo "Backup saved to: $BK"
echo

echo "=== 4) Patch: replace exact mp4 URL -> about:blank (no request) ==="
for f in $FILES; do
  [ -f "$f" ] || continue
  if grep -aFq "$PAT2" "$f"; then
    sed -i "s|$PAT2|$REPL|g" "$f"
    echo "Patched: $f"
  fi
done
echo

echo "=== 5) Verify no more references remain ==="
grep -RInE --binary-files=text "$PAT1|blueprint_robo600\.mp4|/wolverine/blueprint/" "$ROOT" 2>/dev/null | head -n 20 || true
echo

echo "=== 6) ORIGIN quick check (should stay 404 if called manually) ==="
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/blueprint/blueprint_robo600.mp4 | head -n 8 || true
echo "DONE ✅"
BASH

chmod +x /root/patch_remove_blueprint_request.sh
/root/patch_remove_blueprint_request.sh
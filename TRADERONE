set -e

echo "== 1) Service traderone =="
systemctl status traderone.service --no-pager -l | sed -n '1,80p'
echo

echo "== 2) Logs (erreur au démarrage / crash JS) =="
journalctl -u traderone.service -n 120 --no-pager
echo

echo "== 3) Est-ce que 8585 écoute ? =="
ss -lntp | grep ':8585' || echo "❌ rien n'écoute sur 8585"
echo

echo "== 4) Test direct LOCAL (bypass nginx) balances2 puis start =="
BOT="$(systemctl show traderone.service -p Environment --value | tr ' ' '\n' | sed -n 's/^TRADERONE_BOT_WALLET=//p')"
echo "BOT=$BOT"
curl -sS -D- "http://127.0.0.1:8585/wolverine/traderone/api/balances2?wallet=$BOT" | head -n 40 || true
echo
curl -sS -D- "http://127.0.0.1:8585/wolverine/traderone/api/start" \
  -X POST -H "Content-Type: application/json" \
  --data '{"wallet":"TESTUSER","budget":1}' | head -n 60 || true
echo

echo "== 5) Nginx errors (si upstream down) =="
tail -n 80 /var/log/nginx/error.log || true
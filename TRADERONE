cat >/root/fix_duplicate_proxy_http_version.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== Backup =="
cp -a "$SNIP" "${SNIP}.bak_${TS}"
echo "Saved: ${SNIP}.bak_${TS}"

echo
echo "== Show current proxy_http_version lines =="
grep -n "proxy_http_version" "$SNIP" || true

echo
echo "== Remove duplicate proxy_http_version (keep first only) =="
awk '
  BEGIN{seen=0}
  /proxy_http_version/{
    if(seen==0){seen=1; print; next}
    # drop duplicates
    next
  }
  {print}
' "$SNIP" > /tmp/solana_rpc_proxy.conf.fixed
mv /tmp/solana_rpc_proxy.conf.fixed "$SNIP"

echo
echo "== Re-check (should be max 1 line) =="
grep -n "proxy_http_version" "$SNIP" || true

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx

echo "DONE ✅"
BASH

chmod +x /root/fix_duplicate_proxy_http_version.sh
/root/fix_duplicate_proxy_http_version.sh
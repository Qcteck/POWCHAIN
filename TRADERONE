cat >/root/fix_buffer_browser_safe_final.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DIR="/var/www/wolverine"
HTML="$DIR/index.html"

cp -a "$HTML" "${HTML}.bak_${TS}"

echo "== Download browser-safe UMD Buffer polyfill =="
curl -fsSL "https://cdn.jsdelivr.net/npm/buffer@6.0.3/umd/buffer.min.js" -o "$DIR/buffer.browser.min.js"
chmod 0644 "$DIR/buffer.browser.min.js"
ls -lah "$DIR/buffer.browser.min.js"

python3 - <<'PY'
from pathlib import Path
import re

p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")

# Remove any old buffer injections
s = re.sub(r'<script[^>]+buffer[^>]+></script>', '', s, flags=re.I)
s = re.sub(r"<!--\s*WOLVERINE_BUFFER_POLYFILL\s*-->.*?(?=</head>)", "", s, flags=re.S|re.I)

poly = """
<!-- WOLVERINE_BUFFER_POLYFILL -->
<script src="/wolverine/buffer.browser.min.js"></script>
<script>
  if (window.buffer && window.buffer.Buffer) {
    window.Buffer = window.buffer.Buffer;
  }
</script>
"""

# Inject before web3 or at top of head
if "</head>" in s:
    s = s.replace("</head>", poly + "\n</head>", 1)
else:
    s = poly + s

p.write_text(s)
print("OK: Browser-safe Buffer injected")
PY

systemctl reload nginx || service nginx reload
echo "DONE ✅"
BASH

chmod +x /root/fix_buffer_browser_safe_final.sh
/root/fix_buffer_browser_safe_final.sh
top"><div id="brand"><div id="logo"></div><div id="title"><b>IA AQUILA • Jarvis • RSS → Article → Décision</b><small>Objectif: discussion crypto utile. Exécution externe: toujours PENDING.</small></div></div><div id="topRight"><span class="chip good" id="chipSAIE">SAIE:S</span><span class="chip warn" id="chipHEX">HEX:A</span><span class="chip" id="chipNET">NET:—</span><span class="chip" id="chipRAM">RAM:—</span><span class="chip" id="chipLLM">LLM:—</span><button id="btnTTS">VOIX:OFF</button><button id="btnPull">PULL RSS</button></div></div><div id="main"><div id="left"><div class="scan"></div><div class="hd"><b>États</b><span id="clock">--:--:--</span></div><div id="states"><div class="box"><b>Mode</b><span id="st_mode">—</span></div><div class="box"><b>Confiance</b><span id="st_conf">—</span></div><div class="box"><b>RAM (process)</b><span id="st_ram">—</span></div><div class="box"><b>Domaine</b><span id="st_dom">—</span></div><div class="box"><b>Qualité extraction</b><span id="st_q">—</span></div><div class="box"><b>Décision PENDING</b><span id="st_p">—</span></div></div><div class="hd"><b>RSS</b><span id="rssStat">—</span></div><div id="rssBox"></div></div><div id="right"><div class="scan"></div><div class="hd"><b>Discussion</b><span id="discStat">—</span></div><div id="log"></div><div id="quick"></div><div id="row"><input id="in" placeholder="Écris ici… (1 question à la fois)"><button id="send">ENVOYER</button></div></div></div></div><script>(()=>{"use strict";const $=s=>document.querySelector(s),now=()=>new Date().toLocaleTimeString("fr-CA",{hour12:false});const api=p=>fetch("/iaaquila/api/"+p,{cache:"no-store"});const post=(p,b)=>fetch("/iaaquila/api/"+p,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(b||{})});const log=$("#log"),rss=$("#rssBox"),quick=$("#quick");let S={items:[],sel:null,pending:[]};let TTS=false;const speak=t=>{try{if(!TTS)return;const u=new SpeechSynthesisUtterance(String(t||"").slice(0,400));u.lang=document.documentElement.lang.startsWith("fr")?"fr-CA":"en-US";u.rate=1.0;u.pitch=1.0;window.speechSynthesis.cancel();window.speechSynthesis.speak(u);}catch(e){}};const add=(who,txt,cls)=>{const d=document.createElement("div");d.className="m "+cls;d.innerHTML=`<div style="display:flex;justify-content:space-between;gap:12px;color:rgba(244,251,255,.70);font-size:12px;margin-bottom:8px;letter-spacing:.10em;text-transform:uppercase;font-weight:1100"><span>${who}</span><span>${now()}</span></div><div>${String(txt||"")}</div>`;log.appendChild(d);log.scrollTop=log.scrollHeight;};const setBtns=(arr)=>{quick.innerHTML="";(arr||[]).slice(0,18).forEach(o=>{const b=document.createElement("button");b.textContent=o.t;b.className=o.bad?"bad":"";b.onclick=o.f;quick.appendChild(b);});};async function refreshState(){try{const st=await api("state").then(r=>r.json());const mt=await api("metrics").then(r=>r.json());const ls=await api("llm/status").then(r=>r.json()).catch(()=>({ok:false}));$("#clock").textContent=now();$("#chipNET").textContent="NET:"+(navigator.onLine?"ONLINE":"OFFLINE");$("#chipSAIE").textContent="SAIE:"+((st.state&&st.state.saie)||"S");$("#chipHEX").textContent="HEX:"+((st.state&&st.state.hex)||"A");$("#chipRAM").textContent="RAM:"+Math.round((mt.rss||0)/1024/1024)+"MB";$("#st_ram").textContent=`RSS ${Math.round((mt.rss||0)/1024/1024)}MB • HEAP ${Math.round((mt.heapUsed||0)/1024/1024)}MB`;$("#chipLLM").textContent="LLM:"+(ls.ok?"ON":"OFF");$("#chipLLM").className="chip "+(ls.ok?"good":"bad");$("#st_mode").textContent=(st.state&&st.state.mode)||"—";$("#st_conf").textContent=((st.state&&st.state.confidence)||0).toFixed(1)+"%";const pend=(st.pending||[]).filter(x=>x.status==="PENDING");$("#st_p").textContent=pend.length? (pend[pend.length-1].id+" • "+pend[pend.length-1].desc):"—";S.pending=st.pending||[];return ls.ok;}catch(e){return false;}}function renderRSS(){rss.innerHTML="";(S.items||[]).slice(0,16).forEach((it,i)=>{const d=document.createElement("div");d.className="it";d.innerHTML=`<span>${i+1}) ${it.title}<small>${it.pub||""}</small></span><button data-i="${i}">LIRE</button>`;rss.appendChild(d);});$("#rssStat").textContent=`Titres:${(S.items||[]).length}`;rss.querySelectorAll("button[data-i]").forEach(b=>b.onclick=()=>read(parseInt(b.getAttribute("data-i"),10)));}async function pull(){add("SYS","Pull RSS…","sys");const r=await post("rss/pull",{}).then(x=>x.json());S.items=r.items||[];renderRSS();add("AI","J’ai lu des titres. Choisis: je lis #1, ou tu pointes un autre. Oui, je fais la job.","ai");speak("J’ai lu des titres. Je lis le numéro un, ou tu choisis.");setBtns([{t:"LIRE #1",f:()=>read(0)},{t:"LIRE #2",f:()=>read(1)},{t:"QUESTION MARCHÉ",f:()=>chat("Fais un point marché crypto aujourd’hui. 1 question à me poser.")},{t:"PULL RSS",f:()=>pull()}]);}async function read(i){const it=(S.items||[])[i];if(!it)return;S.sel=it;add("SYS","Lecture article…","sys");const lang=document.documentElement.lang.startsWith("fr")?"fr":"en";const a=await post("article/read",{url:it.link,lang}).then(r=>r.json());$("#st_dom").textContent=`${a.domain||"—"} • avgQ ${(a.domainAvgQ||0)}`;$("#st_q").textContent=`${a.quality||0}/100 • ${a.method||"—"} • paywall ${a.paywall?"suspect":"non"}`;const txt=`Titre:\n${it.title}\n\nQualité: ${a.quality||0}/100 (${a.method})\nPaywall: ${a.paywall?"suspect":"non"}\n\nRésumé:\n${a.summary||"—"}\n\nLLM local:\n${a.llm||"(LLM OFF ou indisponible)"}\n\nChoix: PRIX ou NEWS?`;add("AI",txt,"ai");speak("Article lu. Tu veux focus prix ou news?");setBtns([{t:"PRIX",f:()=>chat("Focus PRIX. Donne 1 risque, 1 opportunité, et 1 question unique.")},{t:"NEWS",f:()=>chat("Focus NEWS. Donne 1 risque, 1 opportunité, et 1 question unique.")},{t:"DRAFT X (PENDING)",f:()=>xDraft()},{t:"ONCHAIN (PENDING)",f:()=>onchainPending()},{t:"PULL RSS",f:()=>pull()}]);}async function chat(msg){add("Utilisateur",msg,"user");const lang=document.documentElement.lang.startsWith("fr")?"fr":"en";const r=await post("llm/chat",{lang,msg}).then(x=>x.json()).catch(()=>({ok:false,answer:"(LLM indisponible)"}));add("AI",r.answer||"(vide)","ai");speak(r.answer||"");setBtns([{t:"DRAFT X (PENDING)",f:()=>xDraft()},{t:"ONCHAIN (PENDING)",f:()=>onchainPending()},{t:"LIRE #1",f:()=>read(0)},{t:"PULL RSS",f:()=>pull()}]);}async function xDraft(){const base="Rédige un post X court sur le contexte actuel, prudent, sans promesse, 1 CTA neutre. Donne seulement le texte.";const lang=document.documentElement.lang.startsWith("fr")?"fr":"en";const r=await post("llm/chat",{lang,msg:base}).then(x=>x.json()).catch(()=>({ok:false,answer:"(LLM indisponible)"}));add("AI","Draft X (non publié). Si tu veux je le mets en PENDING.\n\n"+(r.answer||""),"ai");setBtns([{t:"METTRE EN PENDING",f:async()=>{const id=await post("x/propose_post",{text:r.answer||"",reason:"draft LLM"}).then(x=>x.json());add("SYS","PENDING X WRITE: "+id.id,"sys");}},{t:"REFUSER",bad:true,f:()=>add("SYS","Ok. Aucun write.","sys")}]);}async function onchainPending(){add("AI","On-chain write: PENDING only. Je peux créer une intention (swap/transfert).","ai");setBtns([{t:"SWAP (PENDING)",f:async()=>{const id=await post("onchain/propose_tx",{chain:"solana",intent:"swap",details:{note:"intention seulement"}}).then(x=>x.json());add("SYS","PENDING ONCHAIN: "+id.id,"sys");}},{t:"TRANSFERT (PENDING)",f:async()=>{const id=await post("onchain/propose_tx",{chain:"solana",intent:"transfer",details:{note:"intention seulement"}}).then(x=>x.json());add("SYS","PENDING ONCHAIN: "+id.id,"sys");}},{t:"ANNULER",bad:true,f:()=>add("SYS","Ok.","sys")}]);}$("#send").onclick=()=>{const v=$("#in").value.trim();$("#in").value="";if(!v)return;chat(v);};$("#btnPull").onclick=()=>pull();$("#btnTTS").onclick=()=>{TTS=!TTS;$("#btnTTS").textContent="VOIX:"+(TTS?"ON":"OFF");add("SYS","Voix "+(TTS?"ON":"OFF"),"sys");};setInterval(()=>{refreshState();},1500);add("SYS","Boot. Pull RSS auto.","sys");pull();})();</script></body></html>
HTML

echo "== 5) Install backend deps (idempotent) =="
cd "$BACK_DIR"
npm install --omit=dev >/tmp/iaaquila_npm_install.log 2>&1 || { echo "ERROR: npm install failed (see /tmp/iaaquila_npm_install.log)"; exit 1; }

echo "== 6) Optional: install Ollama + pull small model (best-effort) =="
if ! command -v ollama >/dev/null 2>&1; then
  echo "Ollama not found -> installing (best-effort)..."
  curl -fsSL https://ollama.com/install.sh | sh || true
fi
if command -v ollama >/dev/null 2>&1; then
  systemctl enable --now ollama >/dev/null 2>&1 || true
  sleep 1 || true
  MODEL_OK=""
  for M in "llama3.2:3b-instruct" "llama3.2:3b" "phi3:mini" "qwen2.5:3b-instruct" "mistral:7b-instruct"; do
    if ollama pull "$M" >/tmp/iaaquila_ollama_pull.log 2>&1; then MODEL_OK="$M"; break; fi
  done
  [ -n "$MODEL_OK" ] && echo "OK: Ollama model ready: $MODEL_OK" || echo "WARN: model pull failed (see /tmp/iaaquila_ollama_pull.log)"
else
  echo "WARN: Ollama unavailable; LLM local will be OFF."
fi

echo "== 7) Write systemd service =="
cat >"$SVC"<<EOF
[Unit]
Description=IA AQUILA (Node) - ${MOUNT}
After=network.target

[Service]
Type=simple
WorkingDirectory=${BACK_DIR}
Environment=HOST=${HOST}
Environment=PORT=${PORT}
Environment=BASE=${MOUNT}
Environment=OLLAMA_HOST=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=llama3.2:3b
Restart=always
RestartSec=2
ExecStart=/usr/bin/node ${BACK_DIR}/server.js

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now "${SLUG}.service"

echo "== 8) Nginx routes include (with chattr safe best-effort) =="
mkdir -p "$(dirname "$INC")"
cat >"$INC"<<EOF
location ^~ ${MOUNT}/ { root ${PUB_DIR}; try_files \$uri \$uri/ ${MOUNT}/index.html; add_header Cache-Control "no-store" always; }
location ^~ ${MOUNT}/api/ { proxy_pass http://${HOST}:${PORT}${MOUNT}/api/; proxy_http_version 1.1; proxy_set_header Host \$host; proxy_set_header X-Real-IP \$remote_addr; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; add_header Cache-Control "no-store" always; }
EOF

# ensure include is present inside server{} of the vhost
chattr -i /etc/nginx/nginx.conf "$NGX" 2>/dev/null || true
if ! grep -q "include ${INC};" "$NGX"; then
  cp -a "$NGX" "${NGX}.bak_${TS}"
  awk -v ins="  include ${INC};" '{
    print
    if($0 ~ /server\s*\{/ && done!=1){done=1; print ins}
  }' "$NGX" >"${NGX}.tmp_${TS}" && mv "${NGX}.tmp_${TS}" "$NGX"
fi

nginx -t
systemctl reload nginx
chattr +i /etc/nginx/nginx.conf "$NGX" 2>/dev/null || true

echo "== 9) Smoke tests =="
curl -fsS "http://${HOST}:${PORT}${MOUNT}/api/health" | sed "s/^/API health: /"
curl -fsS "http://${HOST}:${PORT}${MOUNT}/api/llm/status" | sed "s/^/LLM status: /" || true

echo "== DONE =="
echo "URL: https://${SITE}${MOUNT}/"
echo "API: https://${SITE}${MOUNT}/api/health"
echo "Service: systemctl status ${SLUG} --no-pager"
BASH
bash /root/IAAQUILA_MEGA_INSTALL.sh'
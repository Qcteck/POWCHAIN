cat >/tmp/WOLVERINE_DEPOSIT_THEN_START.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
DOCROOT="/var/www/fireinners/wolverine"
SERVER_JS="/opt/traderone-opt/server.js"
PORT="8585"

# USDC mainnet mint
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"

# Où stocker la clé TraderOne (dépôt)
KEYDIR="/opt/traderone-opt/keys"
KEYFILE="$KEYDIR/traderone_deposit.json"

echo "== 0) Pre-req: node / npm / esbuild =="
node -v
npm -v || true
if ! command -v esbuild >/dev/null 2>&1; then
  npm i -g esbuild
fi

echo "== 1) Installer @solana/web3.js dans /opt/traderone-opt =="
cd /opt/traderone-opt
if [ ! -f package.json ]; then
  npm init -y >/dev/null 2>&1
fi
npm i @solana/web3.js >/dev/null

echo "== 2) Générer l'adresse dépôt TraderOne (si absente) =="
mkdir -p "$KEYDIR"
chmod 700 "$KEYDIR"
if [ ! -f "$KEYFILE" ]; then
  node - <<'NODE'
const fs = require("fs");
const path = require("path");
const { Keypair } = require("@solana/web3.js");
const keydir = "/opt/traderone-opt/keys";
const keyfile = path.join(keydir, "traderone_deposit.json");
const kp = Keypair.generate();
fs.writeFileSync(keyfile, JSON.stringify(Array.from(kp.secretKey)));
console.log("CREATED", keyfile);
console.log("PUBKEY", kp.publicKey.toBase58());
NODE
  chmod 600 "$KEYFILE"
else
  node - <<'NODE'
const fs = require("fs");
const { Keypair } = require("@solana/web3.js");
const secret = Uint8Array.from(JSON.parse(fs.readFileSync("/opt/traderone-opt/keys/traderone_deposit.json","utf8")));
const kp = Keypair.fromSecretKey(secret);
console.log("EXISTS", "/opt/traderone-opt/keys/traderone_deposit.json");
console.log("PUBKEY", kp.publicKey.toBase58());
NODE
fi

TRADERONE_ADDR="$(node - <<'NODE'
const fs = require("fs");
const { Keypair } = require("@solana/web3.js");
const secret = Uint8Array.from(JSON.parse(fs.readFileSync("/opt/traderone-opt/keys/traderone_deposit.json","utf8")));
const kp = Keypair.fromSecretKey(secret);
process.stdout.write(kp.publicKey.toBase58());
NODE
)"
echo "TraderOne deposit address: $TRADERONE_ADDR"
echo

echo "== 3) Patch backend server.js: deposit-address + build-deposit-tx + confirm =="
cp -a "$SERVER_JS" "$SERVER_JS.bak.$(date +%s)"

# On ajoute en tête des constantes ENV (si pas déjà présentes) + routes robustes.
perl -0777 -i -pe '
BEGIN {
  $ins = "const USDC_MINT = process.env.USDC_MINT || \"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v\";\n".
         "const TRADERONE_DEPOSIT_KEYFILE = process.env.TRADERONE_DEPOSIT_KEYFILE || \"/opt/traderone-opt/keys/traderone_deposit.json\";\n";
}
if ($_ !~ /TRADERONE_DEPOSIT_KEYFILE/) { $_ = $ins . $_; }

# helper: load keypair (inject if missing)
if ($_ !~ /function\s+loadTraderOneKeypair\s*\(/) {
  $_ =~ s/(const\s+\{\s*PublicKey[^;]*;\s*\n)/$1
function loadTraderOneKeypair() {
  const fs = require(\"fs\");
  const secret = Uint8Array.from(JSON.parse(fs.readFileSync(TRADERONE_DEPOSIT_KEYFILE, \"utf8\")));
  return Keypair.fromSecretKey(secret);
}\n\n/s;
}

# Route: GET /api/deposit-address
if ($_ !~ /\/api\/deposit-address/) {
  $_ =~ s/(app\.get\(\s*["\047]\/api\/health["\047].*?\);\s*\n)/$1
app.get(\"\/api\/deposit-address\", (req,res) => {
  try{
    const kp = loadTraderOneKeypair();
    return res.json({ address: kp.publicKey.toBase58() });
  }catch(e){
    return res.status(500).json({ error: e?.message || String(e) });
  }
});\n\n/s;
}

# Route: POST /api/build-deposit-tx  {from, token:"SOL"|"USDC", amount}
# Retour: {txBase64, to, token, amount}
# (backend fetch blockhash, construit tx prête à signer)
$_ =~ s/app\.post\(\s*["\047]\/api\/build-deposit-tx["\047].*?\);\s*\n//gms;

$_ =~ s/(app\.get\(\s*["\047]\/api\/deposit-address["\047][\s\S]*?\);\s*\n)/$1
app.post(\"\/api\/build-deposit-tx\", async (req,res) => {
  try{
    const from = (req.body?.from || \"\").toString().trim();
    const token = (req.body?.token || \"SOL\").toString().toUpperCase();
    const amount = Number(req.body?.amount || 0);

    if(!from) return res.status(400).json({ error: \"from missing\" });
    if(!Number.isFinite(amount) || amount <= 0) return res.status(400).json({ error: \"amount invalid\" });

    const fromPk = new PublicKey(from);
    const toKp = loadTraderOneKeypair();
    const toPk = toKp.publicKey;

    const { blockhash, lastValidBlockHeight } = await connection.getLatestBlockhash(\"confirmed\");
    const tx = new Transaction({ feePayer: fromPk, recentBlockhash: blockhash });

    if(token === \"SOL\") {
      const lamports = Math.round(amount * 1e9);
      tx.add(SystemProgram.transfer({ fromPubkey: fromPk, toPubkey: toPk, lamports }));
    } else if(token === \"USDC\") {
      // SPL: transferChecked from ATA(from) -> ATA(to)
      const { getAssociatedTokenAddress, createAssociatedTokenAccountInstruction, createTransferCheckedInstruction } = require(\"@solana/spl-token\");
      const mint = new PublicKey(USDC_MINT);

      const fromAta = await getAssociatedTokenAddress(mint, fromPk);
      const toAta   = await getAssociatedTokenAddress(mint, toPk);

      // Create ATA(to) if missing
      const toInfo = await connection.getAccountInfo(toAta, \"confirmed\");
      if(!toInfo){
        tx.add(createAssociatedTokenAccountInstruction(fromPk, toAta, toPk, mint));
      }

      // amount in base units (USDC decimals 6)
      const base = Math.round(amount * 1e6);
      tx.add(createTransferCheckedInstruction(fromAta, mint, toAta, fromPk, base, 6));
    } else {
      return res.status(400).json({ error: \"token must be SOL or USDC\" });
    }

    const ser = tx.serialize({ requireAllSignatures:false, verifySignatures:false });
    return res.json({
      txBase64: Buffer.from(ser).toString(\"base64\"),
      to: toPk.toBase58(),
      token,
      amount,
      blockhash,
      lastValidBlockHeight
    });
  }catch(e){
    return res.status(500).json({ error: e?.message || String(e) });
  }
});\n\n/s;

# Route: GET /api/confirm?sig=...
if ($_ !~ /\/api\/confirm/) {
  $_ =~ s/(app\.post\(\s*["\047]\/api\/build-deposit-tx["\047][\s\S]*?\);\s*\n)/$1
app.get(\"\/api\/confirm\", async (req,res) => {
  try{
    const sig = (req.query.sig || \"\").toString().trim();
    if(!sig) return res.status(400).json({ error:\"sig missing\" });
    const st = await connection.getSignatureStatus(sig, { searchTransactionHistory: true });
    const v = st?.value;
    if(!v) return res.json({ ok:false, status:\"not_found\" });
    if(v.err) return res.json({ ok:false, status:\"failed\", err:v.err });
    return res.json({ ok:true, status:v.confirmationStatus || \"confirmed\" });
  }catch(e){
    return res.status(500).json({ error: e?.message || String(e) });
  }
});\n\n/s;
}
' "$SERVER_JS"

# spl-token requis pour USDC
npm i @solana/spl-token >/dev/null

echo "== 4) Redémarrer traderone =="
systemctl restart traderone.service
sleep 1
systemctl status traderone.service --no-pager -l | sed -n '1,35p' || true
echo

echo "== 5) Bundle solana web3 en local pour le front (pas de CDN) =="

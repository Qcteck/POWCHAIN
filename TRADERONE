#!/usr/bin/env bash
set -euo pipefail

# =========================
# WOLVERINE NGINX FINAL FIX
# =========================
# ROOT ONLY
# Objectif: éliminer tout doublon de location /wolverine
# Méthode: STUB .inc + routes réelles .wlvinc, injection unique
# =========================

TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"
INC_DIR="/etc/nginx/includes"

STUB="${INC_DIR}/wolverine_routes.inc"
REAL="${INC_DIR}/wolverine_routes.wlvinc"

LOG="/root/WOLVERINE_NGINX_FINAL_${TS}.log"

log(){ echo "[$(date +%H:%M:%S)] $*" | tee -a "$LOG"; }
die(){ log "FATAL: $*"; exit 1; }

[[ $EUID -eq 0 ]] || die "Lancer ce script en root"
[[ -f "$VHOST" ]] || die "Vhost introuvable: $VHOST"

log "=== WOLVERINE FINAL FIX START ==="

# 1) Backups
log "Backups"
cp -a "$VHOST" "${VHOST}.bak_${TS}"
cp -a "$NGINX_MAIN" "${NGINX_MAIN}.bak_${TS}" || true
[[ -f "$STUB" ]] && cp -a "$STUB" "${STUB}.bak_${TS}"
[[ -f "$REAL" ]] && cp -a "$REAL" "${REAL}.bak_${TS}"

# 2) Créer STUB (vide de locations)
log "Création STUB (aucune location)"
cat > "$STUB" <<'EOF'
# STUB anti-duplicate
# Ce fichier est volontairement vide de toute directive location
EOF

# 3) Créer routes réelles si absentes
if [[ ! -f "$REAL" ]]; then
log "Création routes réelles (.wlvinc)"
cat > "$REAL" <<'EOF'
# ROUTES RÉELLES WOLVERINE
location /wolverine/ {
    root /var/www;
    try_files $uri $uri/ /wolverine/index.html;
}

location /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
EOF
fi

# 4) Supprimer toute référence explicite à wolverine_routes.inc ailleurs
log "Nettoyage global des includes explicites .inc"
grep -RIl "wolverine_routes.inc" /etc/nginx | while read -r f; do
  [[ "$f" == "$VHOST" ]] && continue
  sed -i '/wolverine_routes\.inc/d' "$f"
done

# 5) Supprimer toute location /wolverine résiduelle dans le vhost
log "Nettoyage locations /wolverine dans le vhost"
sed -i '/location[[:space:]]\+\/wolverine[\/ ]/,/}/d' "$VHOST"

# 6) Injection UNIQUE du fichier réel dans le server 443
log "Injection unique du fichier réel"
grep -q "wolverine_routes.wlvinc" "$VHOST" || \
sed -i '/server_name[[:space:]].*fireinners\.online/a \\n    include /etc/nginx/includes/wolverine_routes.wlvinc;\n' "$VHOST"

# 7) Permissions front
[[ -d /var/www/wolverine ]] && chmod -R a+rX /var/www/wolverine

# 8) Test NGINX
log "nginx -t"
nginx -t | tee -a "$LOG"

# 9) Reload
log "Reload nginx"
systemctl reload nginx

log "=== SUCCESS ==="
log "Tester:"
log "  https://fireinners.online/wolverine/"
log "  https://fireinners.online/wolverine/traderone/api/health"
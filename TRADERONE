setup_systemd(){
  say "== systemd =="
  cat > "$SVC" <<EOF
[Unit]
Description=${APP_NAME} (private hot wallet autopilot)
After=network.target nginx.service

[Service]
Type=simple
User=root
WorkingDirectory=${BASE_DIR}
EnvironmentFile=${ETC_DIR}/${APP_NAME}.env
ExecStart=/usr/bin/node ${BASE_DIR}/server.js
Restart=always
RestartSec=2
NoNewPrivileges=true

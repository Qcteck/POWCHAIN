python3 - <<PY
from pathlib import Path
p=Path("$VHOST")
s=p.read_text(errors="ignore")
inc="include /etc/nginx/includes/wolverine_routes.inc;"
# remove duplicates
lines=[ln for ln in s.splitlines(True) if inc not in ln]
s="".join(lines)
# inject inside server blocks that mention server_name fireinners.online
out=[]
in_server=False
server_has_name=False
inserted=False
for ln in s.splitlines(True):
    out.append(ln)
    if "server {" in ln:
        in_server=True
        server_has_name=False
        inserted=False
    if in_server and ("server_name" in ln and "fireinners.online" in ln):
        server_has_name=True
        if not inserted:
            out.append("  "+inc+"\n")
            inserted=True
    if in_server and "}" in ln:
        in_server=False
Path("$VHOST").write_text("".join(out))
print("OK: vhost include normalized")

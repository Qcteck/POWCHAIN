cat >/root/FIX_TRADERONE_FRONTEND_PAYLOAD_V2.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== [1] Vérification fichier ==="
test -f "$HTML" || { echo "❌ index.html introuvable"; exit 1; }

echo "=== [2] Backup ==="
cp -a "$HTML" "${HTML}.bak_${TS}"

echo "=== [3] Patch payload frontend (robuste) ==="
python3 <<'PY'
from pathlib import Path
import re

p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")
orig = s

# normalisation clé wallet → from
s = re.sub(
    r'(pubkey|wallet|address)\s*:\s*window\.solana\.publicKey\.toString\(\)',
    'from: window.solana.publicKey.toString()',
    s
)

# normalisation budget → amount
s = re.sub(
    r'(budgetSol|budget|sol|amountSol)\s*:\s*([a-zA-Z_][a-zA-Z0-9_]*)',
    r'amount: \2',
    s
)

# sécurité : vérifier présence finale
if 'from: window.solana.publicKey.toString()' not in s or 'amount:' not in s:
    print("❌ Payload compatible non détecté")
    exit(1)

if s == orig:
    print("✔ Payload déjà conforme")
else:
    p.write_text(s)
    print("✔ Payload corrigé (robuste)")
PY

echo "=== [4] Test nginx ==="
nginx -t

echo "=== [5] Reload nginx ==="
systemctl reload nginx

echo "=== [6] Résumé ==="
echo "✔ Frontend TraderOne corrigé"
echo "✔ Backup : ${HTML}.bak_${TS}"
echo "✔ Bouton Budget => TRANSFERT SOL RÉEL"

echo "=== TERMINÉ ==="
BASH

chmod +x /root/FIX_TRADERONE_FRONTEND_PAYLOAD_V2.sh
/root/FIX_TRADERONE_FRONTEND_PAYLOAD_V2.sh
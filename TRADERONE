bash -lc 'cat >/tmp/MEGA_GIT_PUSH_KEEP_KEY_2_COMMITS.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail

REPO="/opt/wolverine"
TS="$(date -u +%Y%m%d-%H%M%S)"
BR="cleanup-baks-${TS}"
QUAR="/opt/_quarantine_git_${TS}"
mkdir -p "$QUAR"

die(){ echo "ERR: $*" >&2; exit 1; }
say(){ echo "[$(date -u +%F\ %T)] $*"; }

[ "$(id -u)" -eq 0 ] || die "Run as root."
[ -d "$REPO/.git" ] || die "Repo introuvable: $REPO/.git"

cd "$REPO"
say "Repo: $REPO"
say "Remote(s):"; git remote -v || true

CUR_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
[ -n "${CUR_BRANCH:-}" ] || die "Impossible de détecter la branche courante."
say "Branche courante: $CUR_BRANCH"

say "Checkout new branch: $BR"
git checkout -b "$BR"

# COMMIT 1: .gitignore (NE TOUCHE PAS aux keys)
say "COMMIT 1: chore(gitignore): ignore backups/junk only (keep keys)"
GI=".gitignore"
touch "$GI"
add_line(){ grep -qxF "$1" "$GI" || echo "$1" >>"$GI"; }

add_line ""
add_line "# --- junk / backups ---"
add_line "*.bak"
add_line "*.bak*"
add_line "*.bakfix*"
add_line "*~"
add_line "*.old"
add_line "*.tmp"
add_line ".DS_Store"
add_line "Thumbs.db"
add_line ""
add_line "# --- build artifacts ---"
add_line "node_modules/"
add_line "dist/"
add_line ".next/"
add_line "out/"
add_line "coverage/"

git add "$GI" || true
if ! git diff --cached --quiet; then
  git commit -m "chore(gitignore): ignore backups and junk artifacts"
else
  say "Commit 1: rien à committer."
fi

# COMMIT 2: remove tracked backups (move to quarantine)
say "COMMIT 2: chore: remove backup artifacts from repository (quarantine)"
TRACKED_BAKS="$(git ls-files | grep -E "(\.bak($|[^/])|\.bakfix|~$|\.old$)" || true)"
if [ -n "${TRACKED_BAKS:-}" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ -f "$f" ]; then
      mkdir -p "$QUAR/$(dirname "$f")"
      mv -n "$f" "$QUAR/$f" 2>/dev/null || true
    fi
    git rm -f --cached "$f" >/dev/null 2>&1 || true
  done <<<"$TRACKED_BAKS"
else
  say "Aucun fichier backup tracké trouvé."
fi

git add -A || true
if ! git diff --cached --quiet; then
  git commit -m "chore: remove backup artifacts from repository"
else
  say "Commit 2: rien à committer."
fi

say "Résumé commits:"
git --no-pager log --oneline -n 6 || true

say "Push branch -> origin/$BR"
git push -u origin "$BR"

say "DONE."
say "Branche poussée: $BR"
say "Quarantaine: $QUAR"
say "Prochaine étape: PR $BR -> $CUR_BRANCH sur GitHub."
BASH
chmod +x /tmp/MEGA_GIT_PUSH_KEEP_KEY_2_COMMITS.sh
/tmp/MEGA_GIT_PUSH_KEEP_KEY_2_COMMITS.sh'
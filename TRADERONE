#!/bin/bash
set -e

FILE="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

echo "=== WOLVERINE • SHARE SOCIAL MODULE ==="

node <<'NODE'
const fs=require("fs");
const f=process.env.FILE||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html";
let h=fs.readFileSync(f,"utf8");

/* === NETTOYAGE ANCIEN SHARE === */
h=h.replace(/id="WOLV_SHARE_BTN"[\s\S]*?<\/div>/g,"");
h=h.replace(/id="WOLV_SHARE_POP"[\s\S]*?<\/div>/g,"");
h=h.replace(/id="WOLV_SHARE_SCRIPT"[\s\S]*?<\/script>/g,"");

/* === BOUTON SHARE === */
h=h.replace("<body",`
<body>
<button id="WOLV_SHARE_BTN"
style="
position:fixed;
bottom:22px;
right:22px;
z-index:999;
padding:14px 18px;
border-radius:20px;
font-weight:700;
backdrop-filter:blur(12px);
">
⚙️ SHARE
</button>
`);

/* === POPUP SHARE === */
h=h.replace("</body>",`
<div id="WOLV_SHARE_POP"
style="
display:none;
position:fixed;
inset:0;
z-index:1000;
background:rgba(0,0,0,.45);
backdrop-filter:blur(8px);
align-items:center;
justify-content:center;
">
 <div style="
 background:linear-gradient(135deg,var(--c1),var(--c2));
 padding:22px;
 border-radius:22px;
 min-width:260px;
 box-shadow:0 0 40px color-mix(in srgb,var(--c2) 55%,transparent);
 text-align:center;
 ">
  <div style="font-weight:800;margin-bottom:14px;">Partager</div>
  <button data-s="fb">Facebook</button><br><br>
  <button data-s="tw">X / Twitter</button><br><br>
  <button data-s="tg">Telegram</button><br><br>
  <button data-s="wa">WhatsApp</button><br><br>
  <button data-s="cp">Copier lien</button><br><br>
  <button onclick="WOLV_SHARE_POP.style.display='none'">Fermer</button>
 </div>
</div>

<script id="WOLV_SHARE_SCRIPT">
const WOLV_SHARE_BTN=document.getElementById("WOLV_SHARE_BTN");
const WOLV_SHARE_POP=document.getElementById("WOLV_SHARE_POP");
WOLV_SHARE_BTN.onclick=()=>WOLV_SHARE_POP.style.display="flex";

const url=encodeURIComponent(location.href);
const text=encodeURIComponent("TraderOne • Auto-Trade Solana");

WOLV_SHARE_POP.querySelectorAll("button[data-s]").forEach(b=>{
 b.onclick=()=>{
  const t=b.dataset.s;
  let u="";
  if(t==="fb")u="https://www.facebook.com/sharer/sharer.php?u="+url;
  if(t==="tw")u="https://twitter.com/intent/tweet?url="+url+"&text="+text;
  if(t==="tg")u="https://t.me/share/url?url="+url+"&text="+text;
  if(t==="wa")u="https://api.whatsapp.com/send?text="+text+"%20"+url;
  if(t==="cp"){navigator.clipboard.writeText(location.href);alert("Lien copié");return;}
  window.open(u,"_blank");
 };
});
</script>
</body>`);

fs.writeFileSync(f,h);
NODE

nginx -t && systemctl reload nginx
echo "✅ Module SHARE social actif"
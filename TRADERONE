cat >/root/MARK_WOLVERINE_COLOR.sh <<'BASH'
#!/usr/bin/env bash
set -e

BASE="/opt/fireinners/frontend-react/app/dist/wolverine"
HTML="$BASE/index.html"
TS=$(date +%Y%m%d_%H%M%S)

echo "=== MARQUEUR VISUEL WOLVERINE ==="

[ -f "$HTML" ] || { echo "index.html introuvable"; exit 1; }

cp "$HTML" "$HTML.bak_color_$TS"

# Supprime ancien marqueur si présent
sed -i '/SERVED BY WOLVERINE/d' "$HTML"

# Injecte un bandeau couleur très visible
sed -i '/<body>/a \
<div style="position:fixed;top:0;left:0;right:0;z-index:99999;\
background:#00ff88;color:#000;font-size:20px;font-weight:900;\
padding:10px;text-align:center;border-bottom:4px solid #000">\
SERVED BY WOLVERINE • /opt/fireinners/frontend-react/app/dist/wolverine\
</div>' "$HTML"

nginx -t && systemctl reload nginx

echo "=== OK — recharge la page (CTRL+SHIFT+R) ==="
BASH

chmod +x /root/MARK_WOLVERINE_COLOR.sh
/root/MARK_WOLVERINE_COLOR.sh
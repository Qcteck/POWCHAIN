cat >/root/enable_traderone_lockdown_nginx.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date -u +%Y%m%d_%H%M%S)"

SNIP="/etc/nginx/snippets/traderone_api_lockdown.conf"
test -f "$SNIP" || { echo "❌ Missing $SNIP"; exit 1; }

echo "== 1) Find nginx site file containing /wolverine/traderone/api =="
SITE_FILE="$(grep -RIl --line-number "wolverine/traderone/api" /etc/nginx 2>/dev/null | head -n 1 || true)"
if [ -z "${SITE_FILE:-}" ]; then
  echo "❌ Could not find nginx config containing 'wolverine/traderone/api'"
  echo "Try: nginx -T | grep -n wolverine/traderone/api"
  exit 1
fi
echo "Found: $SITE_FILE"
echo

echo "== 2) Backup =="
cp -a "$SITE_FILE" "${SITE_FILE}.bak_${TS}"
echo "Backup: ${SITE_FILE}.bak_${TS}"
echo

echo "== 3) Add include inside the first matching server{} if missing =="
python3 - <<'PY'
from pathlib import Path
import re, sys

site = Path(sys.argv[1])
snip = sys.argv[2]
s = site.read_text(errors="ignore")

include_line = f"include {snip};"
if include_line in s:
    print("OK: include already present")
    sys.exit(0)

# naive but effective: find server block that mentions wolverine/traderone/api
# and inject include near top of that server{}
m = re.search(r"(server\s*\{.*?wolverine/traderone/api.*?\})", s, flags=re.S)
if not m:
    print("❌ No server{} block containing wolverine/traderone/api found in this file")
    sys.exit(2)

block = m.group(1)
# insert include right after opening brace
block2 = re.sub(r"server\s*\{\s*", lambda m: m.group(0) + "\n  " + include_line + "\n", block, count=1)

s2 = s[:m.start(1)] + block2 + s[m.end(1):]
site.write_text(s2)
print("OK: include injected")
PY "$SITE_FILE" "$SNIP"
echo

echo "== 4) Test + reload nginx =="
nginx -t
systemctl reload nginx || service nginx reload
echo "DONE ✅"
BASH

chmod +x /root/enable_traderone_lockdown_nginx.sh
/root/enable_traderone_lockdown_nginx.sh
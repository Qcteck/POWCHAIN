bash <<'MEGABATCH'
set -euo pipefail

echo "=== WOLVERINE + TRADERONE :: MEGA AUTO BATCH ==="

# ---------- CONFIG FIXE ----------
FRONT_DIR="/var/www/wolverine"
BACK_DIR="/opt/traderone"
API_PORT="3000"
API_HOST="127.0.0.1"
NGINX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SERVICE_NAME="traderone"
NODE_BIN="$(command -v node || true)"

# ---------- CHECK ROOT ----------
if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: must be root"
  exit 1
fi

# ---------- CHECK NODE ----------
if [ -z "$NODE_BIN" ]; then
  echo "ERROR: node not installed"
  exit 1
fi

# ---------- FRONT CHECK ----------
echo "[1/6] Checking frontend..."
if [ ! -f "$FRONT_DIR/index.html" ]; then
  echo "ERROR: $FRONT_DIR/index.html not found"
  exit 1
fi

# ---------- BACKEND PREP ----------
echo "[2/6] Preparing backend..."
mkdir -p "$BACK_DIR"

cat > "$BACK_DIR/server.js" <<'JS'
const http=require("http");
const server=http.createServer((req,res)=>{
  if(req.url==="/health"){
    res.writeHead(200,{"Content-Type":"application/json"});
    res.end(JSON.stringify({status:"ok",service:"TraderOne"}));
    return;
  }
  if(req.url.startsWith("/api")){
    res.writeHead(200,{"Content-Type":"application/json"});
    res.end(JSON.stringify({ok:true,api:"TraderOne",path:req.url}));
    return;
  }
  res.writeHead(404);res.end();
});
server.listen(3000,"127.0.0.1",()=>console.log("TraderOne API listening on 127.0.0.1:3000"));
JS

# ---------- SYSTEMD ----------
echo "[3/6] Installing systemd service..."
cat > "/etc/systemd/system/${SERVICE_NAME}.service" <<EOF
[Unit]
Description=TraderOne Backend
After=network.target

[Service]
ExecStart=/usr/bin/node $BACK_DIR/server.js
Restart=always
User=root
WorkingDirectory=$BACK_DIR
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reexec
systemctl daemon-reload
systemctl enable "${SERVICE_NAME}.service"
systemctl restart "${SERVICE_NAME}.service"

sleep 2

# ---------- BACKEND HEALTH ----------
echo "[4/6] Checking backend health..."
curl -sf "http://127.0.0.1:3000/health" >/dev/null || {
  echo "ERROR: TraderOne backend not responding"
  journalctl -u ${SERVICE_NAME} --no-pager | tail -20
  exit 1
}

# ---------- NGINX PATCH ----------
echo "[5/6] Ensuring nginx routing..."
grep -q "wolverine/traderone" "$NGINX_VHOST" || cat >> "$NGINX_VHOST" <<'NGINX'

location /wolverine/traderone/ {
  proxy_pass http://127.0.0.1:3000/;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_set_header Host $host;
}
NGINX

nginx -t
systemctl reload nginx

# ---------- FINAL TEST ----------
echo "[6/6] Final live checks..."
curl -sf https://fireinners.online/wolverine >/dev/null || echo "WARN: frontend HTTP check failed"
curl -sf http://127.0.0.1:3000/api/test >/dev/null || echo "WARN: api route failed"

echo
echo "=============================================="
echo "WOLVERINE FRONT  : https://fireinners.online/wolverine"
echo "TRADERONE API   : http://127.0.0.1:3000"
echo "HEALTH CHECK    : /health"
echo "STATUS          : RUNNING"
echo "=============================================="
MEGABATCH
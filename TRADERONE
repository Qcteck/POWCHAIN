cat >/tmp/FIX_WOLVERINE_DUP_INCLUDE_SITES.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"

AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "=== 1) état des fichiers ==="
ls -l "$AV" "$EN" || true
readlink -f "$EN" || true

echo
echo "=== 2) où nginx inclut les vhosts ? ==="
grep -RIn --color=never -E 'include\s+.+sites-(enabled|available)' /etc/nginx/nginx.conf /etc/nginx/conf.d 2>/dev/null || true

echo
echo "=== 3) backup ==="
mkdir -p "/root/backup_nginx_${T}"
cp -a /etc/nginx/nginx.conf "/root/backup_nginx_${T}/nginx.conf.bak" || true
cp -a "$AV" "/root/backup_nginx_${T}/sites-available.fireinners.online-ssl.bak" || true
cp -a "$EN" "/root/backup_nginx_${T}/sites-enabled.fireinners.online-ssl.bak" || true

echo
echo "=== 4) force sites-enabled -> SYMLINK vers sites-available ==="
# si EN est un fichier normal (pas un symlink), on le renomme puis on fait un symlink propre
if [ -e "$EN" ] && [ ! -L "$EN" ]; then
  mv "$EN" "${EN}.filebak.${T}"
fi
ln -sf "$AV" "$EN"

echo
echo "=== 5) si nginx.conf inclut sites-available, on le commente ==="
# on commente toute ligne include /etc/nginx/sites-available/*; (si elle existe)
sed -i -E 's@^(\s*include\s+/etc/nginx/sites-available/\*;)@# \1@g' /etc/nginx/nginx.conf

echo
echo "=== 6) re-test nginx ==="
nginx -t
systemctl reload nginx

echo
echo "=== 7) preuve: include du snippet (doit apparaître 1 seule fois dans nginx -T) ==="
nginx -T 2>/dev/null | grep -n 'include /etc/nginx/snippets/fireinners-wolverine.conf' | head -n 20 || true
echo
echo "=== 8) preuve: locations wolverine (doit être 1 set) ==="
nginx -T 2>/dev/null | grep -nE 'location[^\n]*/wolverine/' | head -n 80 || true
SH

bash /tmp/FIX_WOLVERINE_DUP_INCLUDE_SITES.sh
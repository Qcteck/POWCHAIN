bash <<'EOF'
set -e

echo "=== WOLVERINE HTTPS DEPLOY ==="

# PATHS FIXES (déjà mémorisés)
WOLVERINE_UI="/opt/fireinners/frontend-react/app/dist/wolverine"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

# 1) Vérifier UI
if [ ! -f "$WOLVERINE_UI/index.html" ]; then
  echo "[ERR] Wolverine UI introuvable"
  exit 1
fi

# 2) Patch nginx (location /wolverine)
if ! grep -q "location /wolverine" "$NGINX_SITE"; then
  sed -i '/server {/a \
\n    location /wolverine {\n        alias /opt/fireinners/frontend-react/app/dist/wolverine/;\n        index index.html;\n        try_files $uri $uri/ /wolverine/index.html;\n    }\n' "$NGINX_SITE"
  echo "[OK] Nginx location /wolverine ajoutée"
else
  echo "[OK] Nginx location /wolverine déjà présente"
fi

# 3) Reload nginx (safe)
nginx -t
systemctl reload nginx

# 4) Test HTTPS local
sleep 1
curl -fsSL https://www.fireinners.online/wolverine >/dev/null

echo "=== WOLVERINE LIVE ==="
echo "URL : https://www.fireinners.online/wolverine"
EOF
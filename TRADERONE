bash <<'BASH'
set -euo pipefail

APP="/opt/traderone/server.js"
PORT=3000
API="/wolverine/traderone/api"

echo "=== FIX PM2 / NODE TRADERONE ==="

# 1) Lister PM2
echo "== PM2 list =="
pm2 list || true

# 2) Trouver process lié à traderone
PM2_NAME="$(pm2 list | grep -i traderone | awk '{print $2}' | head -n1 || true)"

if [ -n "$PM2_NAME" ]; then
  echo "✔ PM2 process trouvé: $PM2_NAME"
  pm2 restart "$PM2_NAME"
else
  echo "⚠ Aucun process PM2 nommé traderone"
  echo "→ Lancement explicite via PM2"
  pm2 start "$APP" --name traderone
fi

sleep 2

# 3) Vérifier port
if ss -lnt | grep -q ":$PORT"; then
  echo "✔ Node écoute sur $PORT"
else
  echo "❌ Node n'écoute PAS sur $PORT"
  exit 1
fi

# 4) Tests API
echo "== TEST LOCAL =="
curl -i "http://127.0.0.1:$PORT$API/health" || true
curl -i "http://127.0.0.1:$PORT$API/balances" || true
curl -i -X POST "http://127.0.0.1:$PORT$API/budget" || true

# 5) Test HTTPS
echo "== TEST HTTPS =="
curl -i "https://fireinners.online$API/health" || true

echo "=== FIN ==="
BASH
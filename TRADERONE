cat >/root/fix_github_push_403.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

REPO="Qcteck/WOLVERINE1"
REPO_URL="https://github.com/${REPO}.git"
EXPORT="/opt/WOLVERINE1_export"

echo "== 0) Pre-check =="
command -v git >/dev/null || { echo "git missing"; exit 1; }
test -d "$EXPORT" || { echo "Missing $EXPORT"; exit 1; }

cd "$EXPORT"

echo
echo "== 1) Show repo + branch =="
git status -sb || true
echo "Remote (before):"
git remote -v || true

echo
echo "== 2) Ensure clean monorepo (remove nested .git that breaks add/push) =="
# (safe even if nothing exists)
find . -name .git -type d -prune -exec rm -rf {} + 2>/dev/null || true
find . -name .git -type f -delete 2>/dev/null || true

echo
echo "== 3) Ensure repo initialized + commit exists =="
if [ ! -d ".git" ]; then
  git init
fi
git branch -M main 2>/dev/null || true

# If no commits yet, create one
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  git add -A
  git commit -m "server export snapshot" || true
fi

echo
echo "== 4) Set remote origin correctly =="
git remote remove origin 2>/dev/null || true
git remote add origin "$REPO_URL"
echo "Remote (after):"
git remote -v

echo
echo "== 5) Quick permission test (will prompt for user+PAT) =="
echo "-> Username: ton username GitHub (ex: Qcteck)"
echo "-> Password: COLLE TON PAT (pas ton mot de passe)"
echo
git ls-remote "$REPO_URL" HEAD || {
  echo
  echo "❌ GitHub refuse l'accès (403/denied). Causes fréquentes:"
  echo "1) Repo ${REPO} n'existe pas ou tu n'es pas owner/collaborator"
  echo "2) PAT pas autorisé sur ce repo (fine-grained: repo non sélectionné)"
  echo "3) Permissions insuffisantes (classic: scope 'repo' manquant)"
  echo
  exit 2
}

echo
echo "== 6) Push main (will prompt for user+PAT) =="
git push -u origin main

echo
echo "DONE ✅ Repo push OK"
BASH

chmod +x /root/fix_github_push_403.sh
/root/fix_github_push_403.sh
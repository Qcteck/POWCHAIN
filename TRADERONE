cat >/tmp/wolfchain_rescue_fix.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/opt/fireinners/frontend-react/app/dist"
if test -f "$VHOST"; then
  R=$(awk 'BEGIN{r=""} /^[ \t]*root[ \t]+/{gsub(/;$/,"",$2); if(r==""){r=$2}} END{print r}' "$VHOST" 2>/dev/null || true)
  test -n "${R:-}" && ROOT="$R"
fi

echo "== RESCUE WOLFCHAIN =="
echo "VHOST: $VHOST"
echo "ROOT : $ROOT"
test -d "$ROOT" || { echo "ERR: root introuvable: $ROOT"; exit 1; }

ts(){ date +"%Y%m%d-%H%M%S"; }
bk(){ test -f "$1" && cp -a "$1" "$1.rescue.$(ts)" || true; }
immut_off(){ command -v lsattr >/dev/null && command -v chattr >/dev/null && test -f "$1" && (lsattr "$1" 2>/dev/null | grep -q '\-i-' && chattr -i "$1" 2>/dev/null || true) || true; }
restore_latest(){
  local f="$1"
  local b
  b="$(ls -1t "${f}.bak."* 2>/dev/null | head -n 1 || true)"
  if test -n "${b:-}"; then
    echo "RESTORE: $f <= $b"
    immut_off "$f"
    cp -a "$b" "$f"
    return 0
  fi
  echo "NO BACKUP: $f"
  return 1
}
fix_perms(){
  find "$ROOT" -type d -exec chmod 755 {} \; 2>/dev/null || true
  find "$ROOT" -type f -exec chmod 644 {} \; 2>/dev/null || true
}

# targets
HOME="$ROOT/index.html"
WOLV="$ROOT/wolverine/index.html"
WOLV_LEG="$ROOT/wolverin/index.html"
TR="$ROOT/traderone/index.html"

mkdir -p "$ROOT/wolverine" "$ROOT/wolverin" "$ROOT/traderone" 2>/dev/null || true

echo
echo "[1] Restore backups if present"
for f in "$HOME" "$WOLV" "$WOLV_LEG" "$TR"; do
  test -f "$f" && bk "$f"
  restore_latest "$f" || true
done

echo
echo "[2] Ensure stable pages exist (create if missing)"
if ! test -f "$HOME"; then
  cat >"$HOME" <<'HTML'
<!doctype html><html lang="fr"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="color-scheme" content="dark"/><title>WOLFCHAIN • Core</title><style>:root{--bg:#05060b;--b:#1b2a44;--t:#e7f0ff;--m:#9fb3d7;--a:#ff7a18;--a2:#ffb03a}*{box-sizing:border-box}html,body{height:100%;margin:0;background:radial-gradient(900px 520px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(800px 520px at 85% 15%,#121b35 0%,transparent 55%),#05060b;color:var(--t);font:14px system-ui,-apple-system,Segoe UI,Roboto,Arial}a{color:inherit;text-decoration:none}#w{min-height:100%;display:flex;align-items:center;justify-content:center;padding:22px}#c{width:min(980px,100%);background:linear-gradient(180deg,rgba(10,15,30,.92),rgba(7,10,20,.92));border:1px solid rgba(27,42,68,.75);border-radius:18px;box-shadow:0 18px 60px rgba(0,0,0,.55);overflow:hidden}#t{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid rgba(27,42,68,.6)}#b{display:flex;gap:12px;align-items:center}#m{width:44px;height:44px;border-radius:12px;background:radial-gradient(circle at 30% 25%,rgba(255,176,58,.35),transparent 60%),linear-gradient(135deg,rgba(255,122,24,.65),rgba(255,176,58,.25));border:1px solid rgba(255,176,58,.25);display:grid;place-items:center;font-weight:900}#mid{padding:16px 18px 18px;display:grid;gap:10px}h1{margin:0;font-size:22px}p{margin:0;color:var(--m)}.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 12px;border-radius:12px;background:rgba(7,10,20,.65);border:1px solid rgba(27,42,68,.65);width:fit-content}</style><body><div id="w"><div id="c"><div id="t"><div id="b"><div id="m">W</div><div><b>WOLFCHAIN • Core</b><br><span style="color:var(--m);font-size:12px">Wallet • DEX • Bridge • Explorer • Mining • Options</span></div></div><a class="btn" href="/wolverine/">WOLVERINE</a></div><div id="mid"><h1>Portail principal</h1><p>Page de secours stable. WOLVERINE est disponible sur /wolverine/.</p></div></div></div></body></html>
HTML
fi

if ! test -f "$WOLV"; then
  cat >"$WOLV" <<'HTML'
<!doctype html><html lang="fr"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="color-scheme" content="dark"/><title>WOLVERINE • WOLFCHAIN</title><style>:root{--bg:#05060b;--b:#1b2a44;--t:#e7f0ff;--m:#9fb3d7;--a:#ff7a18;--a2:#ffb03a}*{box-sizing:border-box}html,body{height:100%;margin:0;background:radial-gradient(900px 520px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(800px 520px at 85% 15%,#121b35 0%,transparent 55%),#05060b;color:var(--t);font:14px system-ui,-apple-system,Segoe UI,Roboto,Arial}a{color:inherit;text-decoration:none}#w{min-height:100%;display:flex;align-items:center;justify-content:center;padding:22px}#c{width:min(980px,100%);background:linear-gradient(180deg,rgba(10,15,30,.92),rgba(7,10,20,.92));border:1px solid rgba(27,42,68,.75);border-radius:18px;box-shadow:0 18px 60px rgba(0,0,0,.55);overflow:hidden}#t{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid rgba(27,42,68,.6)}#b{display:flex;gap:12px;align-items:center}#m{width:44px;height:44px;border-radius:12px;background:radial-gradient(circle at 30% 25%,rgba(255,176,58,.35),transparent 60%),linear-gradient(135deg,rgba(255,122,24,.65),rgba(255,176,58,.25));border:1px solid rgba(255,176,58,.25);display:grid;place-items:center;font-weight:900}#mid{padding:16px 18px 18px;display:grid;gap:10px}h1{margin:0;font-size:22px}p{margin:0;color:var(--m)}.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 12px;border-radius:12px;background:rgba(7,10,20,.65);border:1px solid rgba(27,42,68,.65);width:fit-content}</style><body><div id="w"><div id="c"><div id="t"><div id="b"><div id="m">W</div><div><b>WOLVERINE</b><br><span style="color:var(--m);font-size:12px">Hub trading (WOLFCHAIN)</span></div></div><a class="btn" href="/">Retour Core</a></div><div id="mid"><h1>WOLVERINE</h1><p>Landing stable (secours). Prochaine étape: intégrer ton logo ici proprement (sans base64 inline qui casse).</p></div></div></div></body></html>
HTML
fi

# redirects
cat >"$WOLV_LEG" <<'HTML'
<!doctype html><html lang="fr"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta http-equiv="refresh" content="0;url=/wolverine/"/><title>Redirect</title><style>html,body{height:100%;margin:0;font:14px system-ui;background:#05060b;color:#e7f0ff;display:grid;place-items:center}a{color:#e7f0ff}</style><body><div>Redirecting to <a href="/wolverine/">/wolverine/</a></div></body></html>
HTML

cat >"$TR" <<'HTML'
<!doctype html><html lang="fr"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta http-equiv="refresh" content="0;url=/wolverine/"/><title>Redirect</title><style>html,body{height:100%;margin:0;font:14px system-ui;background:#05060b;color:#e7f0ff;display:grid;place-items:center}a{color:#e7f0ff}</style><body><div>Redirecting to <a href="/wolverine/">/wolverine/</a></div></body></html>
HTML

echo
echo "[3] Patch text + links everywhere (safe replace)"
for f in "$HOME" "$WOLV" "$WOLV_LEG" "$TR"; do
  immut_off "$f"
  perl -0777 -pi -e 's/WOLVERIN/WOLVERINE/g; s/\/wolverin\//\/wolverine\//g;' "$f" 2>/dev/null || true
done

echo
echo "[4] perms anti-403"
fix_perms

echo
echo "[5] quick local checks"
H="fireinners.online"
for u in / /wolverine/ /wolverin/ /traderone/ /stats; do
  echo "--- $u ---"
  curl -kIs "https://127.0.0.1$u" -H "Host: $H" | sed -n '1,6p' || true
done

echo "== RESCUE DONE =="
BASH
bash /tmp/wolfchain_rescue_fix.sh
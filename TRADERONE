bash -lc 'set -euo pipefail

DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
INCDIR="/etc/nginx/includes"
INC="${INCDIR}/wolverine_routes.inc"
STAMP="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WV_ROUTE_FIX_${STAMP}"

need_root(){ [ "$(id -u)" = "0" ] || { echo "ERR: root only"; exit 1; }; }
say(){ echo "[$(date -u +'%F %T UTC')] $*"; }

need_root
mkdir -p "$BK"/{nginx,webroot,vhosts,meta}

say "BACKUP -> $BK"
cp -a /etc/nginx "$BK/nginx/" 2>/dev/null || true
[ -d "$WEBROOT" ] && cp -a "$WEBROOT" "$BK/webroot/" 2>/dev/null || true

# capture immutables then unfreeze
if command -v lsattr >/dev/null 2>&1; then
  say "CAPTURE immutables"
  (lsattr -R /etc/nginx 2>/dev/null || true) | awk '"'"'$1 ~ /i/ {print $2}'"'"' | sort -u > "$BK/meta/nginx_immutable_files.txt" || true
  say "UNFREEZE /etc/nginx"
  chattr -i -R /etc/nginx 2>/dev/null || true
fi

say "WRITE canonical include: $INC"
mkdir -p "$INCDIR"
cat >"$INC"<<'"'"'NGX'"'"'
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
NGX

say "ENSURE webroot: $WEBROOT"
mkdir -p "$WEBROOT"
if [ ! -f "$WEBROOT/index.html" ]; then
  cat >"$WEBROOT/index.html"<<'"'"'HTML'"'"'
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE</title><style>body{font-family:system-ui,Segoe UI,Roboto,Arial;margin:24px;color:#111}code{background:#f3f3f3;padding:2px 6px;border-radius:6px}</style></head><body><h1>WOLVERINE</h1><p>Static webroot: <code>/var/www/wolverine</code></p><p>Try:</p><ul><li><a href="/wolverine/">/wolverine/</a></li><li><a href="/wolverine/vault-api/health">/wolverine/vault-api/health</a></li><li><a href="/wolverine/traderone/api">/wolverine/traderone/api</a></li></ul></body></html>
HTML
fi

say "PATCH vhosts (all server blocks for $DOMAIN on 443)"
python3 - <<'"'"'PY'"'"'
import os, re, glob, shutil, datetime, sys
DOMAIN="fireinners.online"
INC_LINE="include /etc/nginx/includes/wolverine_routes.inc;"
BK=os.environ["BK"]
candidates=sorted(set(glob.glob("/etc/nginx/sites-enabled/*")+glob.glob("/etc/nginx/conf.d/*.conf")))
def patch_text(txt):
    # patch only server blocks that match DOMAIN and listen 443
    def patch_server_block(block):
        b=block
        if not re.search(r'\bserver_name\b[^;]*\b'+re.escape(DOMAIN)+r'\b', b): return block
        if not re.search(r'(?m)^\s*listen\s+443\b', b): return block
        # remove any wolverine-related include lines except canonical
        b=re.sub(r'(?m)^\s*include\s+[^;]*?(?:wolverine|wv_)[^;]*?;\s*$', lambda m: "" if "wolverine_routes.inc" not in m.group(0) else m.group(0), b)
        # ensure canonical include present once
        if "wolverine_routes.inc" not in b:
            m=re.search(r'(?m)^\s*server_name\b.*?;\s*$', b)
            if m:
                ins=m.end()
                b=b[:ins]+"\n  "+INC_LINE+"\n"+b[ins:]
            else:
                m2=re.search(r'(?m)^\s*listen\s+443\b.*?;\s*$', b)
                if m2:
                    ins=m2.end()
                    b=b[:ins]+"\n  "+INC_LINE+"\n"+b[ins:]
                else:
                    b=b+"\n  "+INC_LINE+"\n"
        # de-dup multiple canonical includes inside same block
        lines=b.splitlines()
        out=[]
        seen=0
        for ln in lines:
            if "include /etc/nginx/includes/wolverine_routes.inc" in ln:
                seen+=1
                if seen>1: 
                    continue
            out.append(ln)
        return "\n".join(out)
    # replace server blocks
    def repl(m):
        return patch_server_block(m.group(0))
    return re.sub(r'(?s)\bserver\s*\{.*?\n\}', repl, txt)

for f in candidates:
    try:
        txt=open(f,"r",encoding="utf-8",errors="ignore").read()
    except Exception:
        continue
    if DOMAIN not in txt: 
        continue
    new=patch_text(txt)
    if new!=txt:
        os.makedirs(os.path.join(BK,"vhosts"), exist_ok=True)
        shutil.copy2(f, os.path.join(BK,"vhosts",os.path.basename(f)))
        open(f,"w",encoding="utf-8").write(new)
PY

say "NGINX TEST"
if ! nginx -t; then
  say "NGINX FAILED -> ROLLBACK"
  rm -rf /etc/nginx
  cp -a "$BK/nginx/nginx" /etc/nginx
  nginx -t || true
  systemctl restart nginx || true
  exit 1
fi

say "RELOAD nginx"
systemctl reload nginx || systemctl restart nginx

say "TEST LOCAL (bypass CF) HEAD /wolverine/"
curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,15p" || true
say "TEST LOCAL first bytes /wolverine/"
curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | head -c 220 || true
echo

say "TEST PUBLIC HEAD /wolverine/"
curl -skI "https://${DOMAIN}/wolverine/" | sed -n "1,15p" || true

# refreeze back exactly what was immutable before
if command -v chattr >/dev/null 2>&1 && [ -s "$BK/meta/nginx_immutable_files.txt" ]; then
  say "REFREEZE previous immutables"
  while IFS= read -r p; do
    [ -e "$p" ] && chattr +i "$p" 2>/dev/null || true
  done < "$BK/meta/nginx_immutable_files.txt"
fi

say "DONE"
echo "Backups: $BK"
echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
'
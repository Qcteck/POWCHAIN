cat >"$TO_BACK/server.js" <<'JS'
const express = require("express");
const cors = require("cors");

const app = express();

// IMPORTANT: on est derrière nginx sur le même domaine, donc CORS pas nécessaire.
// Je le laisse permissif au cas où tu testes en local.
app.use(cors());
app.use(express.json({ limit: "1mb" }));

// Health check
app.get("/health", (req, res) => res.status(200).send("ok"));

// Info
app.get("/info", (req, res) => {
  res.json({
    name: "TraderOne Backend",
    ok: true,
    time: new Date().toISOString()
  });
});

// Exemple trades (stub) — remplace par ta logique réelle
app.get("/trades", (req, res) => {
  res.json({
    ok: true,
    items: [],
    note: "stub endpoint - branche ta DB/engine ici"
  });
});

// 404
app.use((req, res) => res.status(404).json({ ok: false, error: "not_found", path: req.path }));

const HOST = process.env.HOST || "127.0.0.1";
const PORT = parseInt(process.env.PORT || "8585", 10);

app.listen(PORT, HOST, () => {
  console.log(`[TraderOne] listening on http://${HOST}:${PORT}`);
});
JS

# install deps
cd "$TO_BACK"
npm install --omit=dev

# ---------- SYSTEMD ----------
cat >/etc/systemd/system/traderone.service <<EOF
[Unit]
Description=TraderOne Backend (localhost)
After=network.target

[Service]
Type=simple
WorkingDirectory=$TO_BACK
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=$PORT
ExecStart=/usr/bin/node $TO_BACK/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now traderone.service
systemctl restart traderone.service

# ---------- NGINX SNIPPET (proxy API) ----------
cat >"$SNIP" <<EOF
# $MARK
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;

  # /wolverine/traderone/api/*  ---> http://127.0.0.1:$PORT/*
  rewrite ^/wolverine/traderone/api/?(.*)$ /\$1 break;
  proxy_pass http://127.0.0.1:$PORT;
}
EOF

# include snippet in site config (idempotent)
if ! grep -q "$MARK" "$NGX_SITE"; then
  cp -a "$NGX_SITE" "$NGX_SITE.bak.$(date +%s)"
  awk -v snip="$SNIP" -v mark="$MARK" '
    BEGIN{inserver=0;done=0}
    {
      if($0 ~ /^[ \t]*server[ \t]*\{/ && !inserver){inserver=1}
      if(inserver && !done && $0 ~ /^[ \t]*\}/){
        print "    include " snip "; # " mark
        done=1
      }
      print
      if(inserver && $0 ~ /^[ \t]*\}/){inserver=0}
    }
  ' "$NGX_SITE" >"$NGX_SITE.tmp"
  mv "$NGX_SITE.tmp" "$NGX_SITE"
fi

nginx -t
systemctl reload nginx


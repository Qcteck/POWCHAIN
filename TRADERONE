say "5) Ensure vhost includes AquilaTrader include exactly once (inside server block)"
python3 - <<PY
import re, shutil
path = "${VHOST}"
bk = "${BK}/" + path.split("/")[-1] + ".preinject.bak"
shutil.copy2(path, bk)

txt = open(path, "r", encoding="utf-8", errors="ignore").read()

# If include already present, do nothing; else inject after first include line in server block (or after server { line)
if re.search(r'(?m)^[ \t]*include[ \t]+/etc/nginx/includes/aquilatrader_static\\.inc\\s*;', txt):
    print("VHOST: include already present")
else:
    # naive but safe: find first 'server {' and then insert shortly after
    m = re.search(r'(?m)^\\s*server\\s*\\{', txt)
    if not m:
        raise SystemExit("No server { found in vhost")
    insert_at = m.end()
    # try insert after a known include line if exists
    m2 = re.search(r'(?m)^[ \t]*include[ \t]+/etc/nginx/includes/[^;]+;\\s*$', txt[m.end():])
    if m2:
        insert_at = m.end() + m2.end()
    inject = "\\n    include /etc/nginx/includes/aquilatrader_static.inc;\\n"
    txt = txt[:insert_at] + inject + txt[insert_at:]
    open(path, "w", encoding="utf-8").write(txt)
    print("VHOST: injected include")
PY

echo "[1] AVANT"
sudo ufw status numbered

echo "[2] DELETE UFW ALLOW 3000/tcp (v4+v6)"
sudo ufw status numbered | awk -F'[][]' '/3000\/tcp/ {print $2}' | sort -rn | while read -r n; do
  [ -n "$n" ] && sudo ufw delete "$n"
done

echo "[3] DELETE UFW ALLOW 8484/tcp (v4+v6)"
sudo ufw status numbered | awk -F'[][]' '/8484\/tcp/ {print $2}' | sort -rn | while read -r n; do
  [ -n "$n" ] && sudo ufw delete "$n"
done

echo "[4] S'ASSURER QUE 443 EST AUTORISÉ"
sudo ufw allow 443/tcp >/dev/null 2>&1 || true

echo "[5] APRÈS"
sudo ufw status verbose | egrep 'Status|443/tcp|3000/tcp|8484/tcp|22/tcp|51820/udp' || true
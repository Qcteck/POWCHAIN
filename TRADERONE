(()=>{try{if(!globalThis.global)globalThis.global=globalThis;if(!globalThis.process)globalThis.process={env:{}};if(!globalThis.Buffer){function b64ToBytes(b64){const bin=atob(b64);const a=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)a[i]=bin.charCodeAt(i);return a}function bytesToB64(u8){let s="";for(let i=0;i<u8.length;i++)s+=String.fromCharCode(u8[i]);return btoa(s)}class BufferX extends Uint8Array{static from(v,enc){if(v instanceof ArrayBuffer)return new BufferX(new Uint8Array(v));if(ArrayBuffer.isView(v))return new BufferX(new Uint8Array(v.buffer,v.byteOffset,v.byteLength));if(typeof v==="string"){if(enc==="base64")return new BufferX(b64ToBytes(v));const te=new TextEncoder();return new BufferX(te.encode(v))}if(Array.isArray(v))return new BufferX(new Uint8Array(v));throw new Error("Buffer.from unsupported")}static alloc(n){return new BufferX(new Uint8Array(n))}toString(enc){if(enc==="base64")return bytesToB64(this);const td=new TextDecoder();return td.decode(this)} }globalThis.Buffer=BufferX}}catch(e){}})();

/* ===== UI helpers ===== */

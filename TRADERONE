cat >/tmp/WOLVERINE_TG_ROTATE_CLEAN.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
DIR="/opt/fireinners/wolverine-telegram"

mkdir -p "$DIR"; chmod 700 "$DIR"

# récupère chat id si déjà connu, sinon fallback
CID="$(grep -Eo 'TG_CHAT_ID\s*=\s*-?[0-9]+' "$ENV" 2>/dev/null | head -n1 | grep -Eo '-?[0-9]+' || true)"
[ -n "${CID:-}" ] || CID="5153862399"

systemctl stop wolverine-tg-sentinel 2>/dev/null || true

# backup
[ -f "$ENV" ] && cp -a "$ENV" "$ENV.bak.$(date +%s)" || true

read -r -s -p "COLLE LE NOUVEAU TG_TOKEN (rien ne s'affiche) ثم ENTER: " TGRAW
echo

# sanitize (enlève CR/LF/espaces/tabs + si tu colles une URL, extrait le token)
TG="$(printf '%s' "$TGRAW" | tr -d '\r\n\t ' )"
TG="${TG#https://api.telegram.org/bot}"; TG="${TG#http://api.telegram.org/bot}"
TG="${TG#https://t.me/}"; TG="${TG#http://t.me/}"
TG="${TG#bot}"; TG="${TG#/}"
TG="${TG%%/*}"

if [ -z "${TG:-}" ]; then echo "ERREUR: token vide"; exit 1; fi

# validation format Telegram: 123456789:ABCdef_-...
if ! [[ "$TG" =~ ^[0-9]{6,}:[A-Za-z0-9_-]{20,}$ ]]; then
  echo "ERREUR: token invalide (format). Colle seulement le token de BotFather (ex: 123:ABC...)."
  exit 1
fi

umask 077
printf 'TG_TOKEN=%s\nTG_CHAT_ID=%s\n' "$TG" "$CID" >"$ENV"
chmod 600 "$ENV"

echo "OK: env écrit (tokenlen=${#TG}, chatid=$CID)"

echo "--- getMe (doit contenir \"ok\":true) ---"
ME="$(curl -sS -m 8 "https://api.telegram.org/bot${TG}/getMe" | head -c 250)"
echo "$ME"; echo
echo "$ME" | grep -q '"ok":true' || { echo "ERREUR: getMe pas ok:true"; exit 1; }

echo "--- sendMessage test ---"
curl -sS -m 8 -X POST "https://api.telegram.org/bot${TG}/sendMessage" \
  -d "chat_id=${CID}" \
  -d "text=WOLVERINE: token OK (clean rotate)" \
  -d "disable_web_page_preview=true" >/dev/null

systemctl start wolverine-tg-sentinel 2>/dev/null || true
echo "DONE."
SH
bash /tmp/WOLVERINE_TG_ROTATE_CLEAN.sh
bash <<'MEGAFIX'
set -euo pipefail

echo "=== WOLVERINE + TRADERONE :: MEGA FIX AUTO ==="

BACK_DIR="/opt/traderone"
SERVICE="traderone"
PORT=3000

# --- backend fix ---
mkdir -p "$BACK_DIR"

cat > "$BACK_DIR/server.cjs" <<'JS'
const http = require("http");

const server = http.createServer((req, res) => {
  if (req.url === "/health") {
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ status: "ok", service: "TraderOne" }));
    return;
  }

  if (req.url.startsWith("/api")) {
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ ok: true, api: "TraderOne", path: req.url }));
    return;
  }

  res.writeHead(404);
  res.end();
});

server.listen(3000, "127.0.0.1", () =>
  console.log("TraderOne running on 127.0.0.1:3000")
);
JS

# --- systemd fix ---
cat > "/etc/systemd/system/${SERVICE}.service" <<EOF
[Unit]
Description=TraderOne Backend
After=network.target

[Service]
ExecStart=/usr/bin/node $BACK_DIR/server.cjs
Restart=always
User=root
WorkingDirectory=$BACK_DIR
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reexec
systemctl daemon-reload
systemctl restart "$SERVICE"

sleep 2

# --- hard health check ---
echo "[CHECK] backend health..."
curl -sf "http://127.0.0.1:3000/health" || {
  echo "❌ BACKEND STILL DEAD"
  journalctl -u "$SERVICE" --no-pager | tail -30
  exit 1
}

echo
echo "===================================="
echo "✅ TRADERONE BACKEND IS LIVE"
echo "API     : http://127.0.0.1:3000"
echo "HEALTH  : /health"
echo "FRONT   : https://fireinners.online/wolverine"
echo "===================================="
MEGAFIX
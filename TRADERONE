#!/usr/bin/env bash
set -e

APP="/opt/wolverine"
HTML="$APP/index.html"
BACKUP="$HTML.bak.$(date +%s)"

echo "==[1/6] Vérification =="
[ -f "$HTML" ] || { echo "❌ index.html introuvable"; exit 1; }

echo "==[2/6] Backup =="
cp "$HTML" "$BACKUP"

echo "==[3/6] Suppression SHARE (HTML + JS) =="
sed -i \
  -e '/SHARE/d' \
  -e '/share/d' \
  -e '/twitter/d' \
  -e '/telegram/d' \
  -e '/facebook/d' \
  -e '/navigator\.share/d' \
  "$HTML"

echo "==[4/6] Injection THEME GLOBAL ENGINE =="
sed -i '/<\/body>/i \
<script>\
(()=>{\
const rand=(a,b)=>Math.random()*(b-a)+a;\
function genTheme(){\
const h1=rand(260,330),h2=rand(160,210),h3=rand(280,310);\
return{\
bg:`radial-gradient(circle at 20% 20%,hsla(${h1},90%,65%,.45),transparent 60%),radial-gradient(circle at 80% 70%,hsla(${h2},90%,60%,.45),transparent 60%),linear-gradient(135deg,hsla(${h3},80%,20%,1),#050510)`,\
accent:`hsl(${h2},90%,60%)`,\
glow:`hsl(${h1},90%,65%)`,\
text:`#fff`\
};}\
function applyTheme(){\
const t=genTheme();\
document.documentElement.style.setProperty("--bg",t.bg);\
document.documentElement.style.setProperty("--accent",t.accent);\
document.documentElement.style.setProperty("--glow",t.glow);\
document.documentElement.style.setProperty("--text",t.text);\
document.body.style.background=t.bg;\
document.body.classList.add("themed");\
}\
window.applyTheme=applyTheme;\
})();\
</script>' "$HTML"

echo "==[5/6] CSS GLOBAL (tout piloté par THEME) =="
sed -i '/<\/head>/i \
<style>\
:root{--bg:#000;--accent:#ff5ecb;--glow:#5fffd7;--text:#fff}\
body{background:var(--bg)!important;color:var(--text);transition:all .6s ease}\
button,input,.panel,.console{\
background:rgba(0,0,0,.35);\
border:1px solid var(--accent);\
color:var(--text);\
box-shadow:0 0 18px var(--glow);\
backdrop-filter:blur(14px);\
transition:all .6s ease}\
canvas{mix-blend-mode:screen}\
</style>' "$HTML"

echo "==[6/6] Reload nginx =="
nginx -t && systemctl reload nginx

echo "✅ SHARE supprimé définitivement"
echo "🎨 THEME contrôle maintenant TOUT (fond + UI + particules)"
echo "🧠 Aucun menu, aucun doublon"
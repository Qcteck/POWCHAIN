cat >/root/nginx_fix_duplicate_location.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "[1] Où sont les locations dupliquées ?"
grep -RIn --line-number --color=never 'location\s\+\^~\s\+/wolverine/traderone/api/' /etc/nginx || true
echo

echo "[2] Quels snippets proxy existent ?"
ls -la /etc/nginx/snippets | grep -E 'wolverine_.*proxy|traderone_.*proxy' || true
echo

# Désactive tous les anciens snippets proxy traderone sauf celui qu'on garde
KEEP="/etc/nginx/snippets/wolverine_traderone_backend_proxy.conf"
DISABLED="/etc/nginx/disabled-snippets"
mkdir -p "$DISABLED"

for f in /etc/nginx/snippets/*proxy*.conf; do
  [[ -f "$f" ]] || continue
  if [[ "$f" == "$KEEP" ]]; then
    echo "[KEEP] $f"
  else
    # si le fichier contient la location traderone/api, on le déplace
    if grep -qE 'location\s+\^~\s+/wolverine/traderone/api/' "$f"; then
      echo "[MOVE] $f -> $DISABLED/"
      mv -f "$f" "$DISABLED/"
    fi
  fi
done

echo
echo "[3] Retest nginx"
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
BASH

chmod +x /root/nginx_fix_duplicate_location.sh
/root/nginx_fix_duplicate_location.sh
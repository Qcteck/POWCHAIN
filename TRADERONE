
set -euo pipefail

# 1) Va dans le dossier du repo (mets le bon chemin si tu le connais)
# Exemple:
# cd /opt/wolverine-frontend
# Sinon, cherche un repo git sous /opt :
cd "$(find /opt -maxdepth 4 -type d -name .git 2>/dev/null | head -n 1 | sed 's/\/.git$//')"

echo "=== Repo ==="
pwd
git status

echo "=== Remotes ==="
git remote -v

# 2) Crée une branche de travail
BR="wolverine-ui-v2"
git checkout -b "$BR" 2>/dev/null || git checkout "$BR"

# 3) (ICI tu colles/ajoutes les fichiers/modifs frontend)

# 4) Commit + push
git add -A
git commit -m "Wolverine UI v2 (Phantom + balances + /wolverine basepath)" || true
git push -u origin "$BR"
bash <<'EOF'
set -e

echo "=== WOLVERINE • TRADERONE MEGA BATCH ==="

NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
BACKUP="/etc/nginx/sites-available/fireinners.online-ssl.bak.$(date +%s)"

echo "[1/6] Vérification TraderOne (PM2)"
if ! pm2 list | grep -q traderone; then
  echo "[ERR] traderone non lancé via PM2"
  exit 1
fi
echo "[OK] traderone actif"

echo "[2/6] Vérification port 3000"
if ! ss -lnt | grep -q ":3000"; then
  echo "[ERR] TraderOne n'écoute pas sur 3000"
  exit 1
fi
echo "[OK] Port 3000 ouvert"

echo "[3/6] Sauvegarde nginx"
cp "$NGINX_SITE" "$BACKUP"
echo "[OK] Backup : $BACKUP"

echo "[4/6] Patch nginx (/wolverine + API)"

if ! grep -q "wolverine/api" "$NGINX_SITE"; then
cat >> "$NGINX_SITE" <<'NGINX'

### === WOLVERINE → TRADERONE API ===
location /wolverine/api/ {
    proxy_pass http://127.0.0.1:3000/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000/wolverine/traderone/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
}
### === END WOLVERINE ===
NGINX
  echo "[OK] Bloc nginx ajouté"
else
  echo "[OK] Bloc nginx déjà présent"
fi

echo "[5/6] Reload nginx"
nginx -t
systemctl reload nginx
echo "[OK] nginx reloadé"

echo "[6/6] TEST FINAL API"
URL="https://www.fireinners.online/wolverine/api/balances"
if curl -fsSL "$URL" >/dev/null; then
  echo "[SUCCESS] API OK → $URL"
  curl -s "$URL"
else
  echo "[ERR] API non accessible"
  exit 1
fi

echo "=== WOLVERINE + TRADERONE LIVE ==="
EOF
cat >/root/test_wallet_balances_sol_usdc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

RPC="https://fireinners.online/wolverine/rpc"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"

read -p "Wallet public key (Phantom address): " WALLET
[ -n "$WALLET" ] || { echo "Empty wallet"; exit 1; }

echo
echo "== 1) SOL balance (lamports -> SOL in UI) =="
curl -sk "$RPC" -H 'content-type: application/json' \
  --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getBalance\",\"params\":[\"$WALLET\"]}" | head -c 500; echo

echo
echo "== 2) USDC token accounts by owner =="
curl -sk "$RPC" -H 'content-type: application/json' \
  --data "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"getTokenAccountsByOwner\",\"params\":[\"$WALLET\",{\"mint\":\"$USDC_MINT\"},{\"encoding\":\"jsonParsed\"}]}" | head -c 1200; echo

echo
echo "DONE ✅"
BASH

chmod +x /root/test_wallet_balances_sol_usdc.sh
/root/test_wallet_balances_sol_usdc.sh
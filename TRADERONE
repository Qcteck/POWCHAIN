bash -c '
set -e

echo "=== AIAQUILA FINAL URL FIX ==="

BASE="/var/www/fireinners.online/aiaquila"
FILE="$BASE/index.html"
BACKUP="$BASE/index.backup.$(date +%Y%m%d_%H%M%S).html"

GOOD="https://aiaquila-proxy.paycashnostory.workers.dev"
BAD1="paycashnostory.workers.dev"
BAD2="aiaquila-proxy.workers.dev"

echo "[1/6] Vérification fichier..."
[ -f "$FILE" ] || { echo "❌ index.html introuvable"; exit 1; }

echo "[2/6] Backup..."
cp "$FILE" "$BACKUP"

echo "[3/6] Correction URLs..."
sed -i \
  -e "s|https://[^\"'\'']*/rss|$GOOD/rss|g" \
  -e "s|https://$BAD1/rss|$GOOD/rss|g" \
  -e "s|https://$BAD2/rss|$GOOD/rss|g" \
  "$FILE"

echo "[4/6] Vérification URL finale..."
grep -n "$GOOD/rss" "$FILE" || { echo "❌ URL non injectée"; exit 1; }

echo "[5/6] Reload nginx..."
nginx -t
systemctl reload nginx

echo "[6/6] Test Worker direct..."
curl -fs "$GOOD/rss?url=https://news.bitcoin.com/feed/" | head -n 5 || {
  echo "❌ Worker inaccessible"
  exit 1
}

echo "=== ✅ AIAQUILA FIX APPLIQUÉ AVEC SUCCÈS ==="
echo "Backup: $BACKUP"
echo "URL active: $GOOD/rss"
'
bash <<'BATCH'
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ENABLED="/etc/nginx/sites-enabled/fireinners.online-ssl"
FRONT="/var/www/wolverine"

# backup
cp -a "$VHOST" "${VHOST}.bak_$(date +%Y%m%d_%H%M%S)"

# rewrite vhost clean
cat > "$VHOST" <<'NGINX'
server {
    listen 443 ssl http2;
    server_name fireinners.online www.fireinners.online;

    root /var/www;
    index index.html;

    location /wolverine/ {
        try_files $uri $uri/ /wolverine/index.html;
    }

    location /wolverine/traderone/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
NGINX

# enable only this vhost
rm -f /etc/nginx/sites-enabled/*
ln -sf "$VHOST" "$ENABLED"

# permissions
chown -R www-data:www-data "$FRONT"
find "$FRONT" -type d -exec chmod 755 {} \;
find "$FRONT" -type f -exec chmod 644 {} \;

# test & reload
nginx -t
systemctl reload nginx

# final check
curl -fsS https://fireinners.online/wolverine/ >/dev/null

echo "OK"
BATCH
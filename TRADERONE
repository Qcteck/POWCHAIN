#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/var/www/fireinners.online/aiaquila"
BACKUP_DIR="/root/aiaquila_backup_$(date +%Y%m%d_%H%M%S)"
USER="www-data"
GROUP="www-data"

if [ "$EUID" -ne 0 ]; then
  echo "❌ Lancer en root"
  exit 1
fi

echo "== AIAQUILA | RELANCE AVEC VOIX PAR DÉFAUT =="

mkdir -p "$BACKUP_DIR"
[ -d "$APP_DIR" ] && cp -a "$APP_DIR" "$BACKUP_DIR/"

mkdir -p "$APP_DIR"
chown -R $USER:$GROUP "$APP_DIR"
chmod -R 755 "$APP_DIR"

cat > "$APP_DIR/index.html" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA • Decision Engine</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
body{margin:0;background:#0b0f14;color:#e6edf3;font-family:system-ui}
header{padding:14px 20px;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{padding:20px;max-width:960px;margin:auto}
.card{background:#111827;border:1px solid #1f2937;border-radius:12px;padding:14px;margin-bottom:14px}
#stream{line-height:1.55}
.feedback{position:fixed;bottom:16px;right:16px;display:flex;gap:8px}
button{background:#1f2937;color:#e6edf3;border:1px solid #374151;border-radius:8px;padding:6px 10px}
canvas{position:fixed;inset:0;pointer-events:none}
</style>
</head>
<body>

<header>
  <strong>AIAQUILA</strong>
  <span id="mode">Rythme: ALPHA</span>
</header>

<main>
  <div class="card" id="identity"></div>
  <div class="card">
    <div id="stream"></div>
  </div>
</main>

<div class="feedback">
  <button onclick="feedback(1)">👍</button>
  <button onclick="feedback(-1)">👎</button>
</div>

<canvas id="viz"></canvas>

<script>
/* =========================
   IDENTITÉ
========================= */
const ID_KEY="AIAQUILA_USER";
let user=localStorage.getItem(ID_KEY);
const identity=document.getElementById("identity");

function nick(){
  const a=["Observateur","Analyste","Stratège","Veilleur","Penseur"];
  const b=["Atlas","Orion","Sigma","Delta","Nord"];
  return a[Math.floor(Math.random()*a.length)]+" "+b[Math.floor(Math.random()*b.length)];
}

function renderIdentity(){
  if(user){
    identity.innerHTML="<p>Bienvenue, <b>"+user+"</b>.</p>";
  }else{
    identity.innerHTML=`
      <p>Comment veux-tu que je t’appelle ?</p>
      <input id="n" placeholder="Nom ou surnom">
      <button onclick="setName()">Valider</button>
      <button onclick="skip()">Passer</button>
    `;
  }
}

function setName(){
  user=document.getElementById("n").value.trim()||nick();
  localStorage.setItem(ID_KEY,user);
  renderIdentity();
  speak("Très bien. Je t’appellerai "+user+".");
}

function skip(){
  user=nick();
  localStorage.setItem(ID_KEY,user);
  renderIdentity();
  speak("D’accord. Je t’appellerai "+user+".");
}

renderIdentity();

/* =========================
   VOIX PAR DÉFAUT
========================= */
let voiceReady=false;
function enableVoice(){
  if(voiceReady) return;
  voiceReady=true;
  speechSynthesis.speak(new SpeechSynthesisUtterance(" "));
}
["click","keydown","scroll","touchstart"].forEach(e=>{
  window.addEventListener(e,enableVoice,{once:true});
});

/* =========================
   SPEAK
========================= */
const stream=document.getElementById("stream");
let rhythm="ALPHA";

function speak(text){
  const p=document.createElement("p");
  p.textContent=(user?user+", ":"")+text;
  stream.appendChild(p);
  stream.scrollTop=stream.scrollHeight;

  if(voiceReady){
    const u=new SpeechSynthesisUtterance(text);
    u.lang="fr-CA";
    u.rate = rhythm==="ALPHA"?0.95:rhythm==="BETA"?1.05:1.15;
    u.pitch = rhythm==="GAMMA"?1.15:1;
    speechSynthesis.speak(u);
  }
}

/* =========================
   FEEDBACK
========================= */
let bias=0;
function feedback(v){
  bias=Math.max(-0.1,Math.min(0.1,bias+v*0.01));
}

/* =========================
   CYCLE DISCURSIF
========================= */
function cycle(){
  speak("Les faits récents s’inscrivent dans une continuité plus que dans une rupture.");
  speak("Ce qui frappe, ce n’est pas l’événement isolé, mais leur accumulation silencieuse.");
}
setInterval(cycle,12000);

/* =========================
   RYTHMES AUTO
========================= */
setInterval(()=>{
  rhythm = rhythm==="ALPHA"?"BETA":rhythm==="BETA"?"GAMMA":"ALPHA";
  document.getElementById("mode").textContent="Rythme: "+rhythm;
},30000);

/* =========================
   PARTICULES
========================= */
const c=document.getElementById("viz"),ctx=c.getContext("2d");
function resize(){c.width=innerWidth;c.height=innerHeight}
window.onresize=resize;resize();
let t=0;
function draw(){
  ctx.clearRect(0,0,c.width,c.height);
  for(let i=0;i<120;i++){
    ctx.fillStyle="rgba(99,102,241,0.15)";
    ctx.beginPath();
    ctx.arc(
      c.width/2+Math.sin(t/50+i)*200,
      c.height/2+Math.cos(t/40+i)*200,
      2,0,Math.PI*2
    );
    ctx.fill();
  }
  t++;requestAnimationFrame(draw);
}
draw();
</script>
</body>
</html>
HTML

chown -R $USER:$GROUP "$APP_DIR"
chmod -R 755 "$APP_DIR"

nginx -t && systemctl reload nginx

echo "✅ AIAQUILA RELANCÉ — VOIX ACTIVE PAR DÉFAUT"
echo "➡ https://fireinners.online/aiaquila"
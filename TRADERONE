cat >/root/find_balance_rpc_error_source.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="fireinners.online"
ROOT="/var/www/wolverine"

hr(){ echo -e "\n========== $* ==========\n"; }

hr "1) What does the browser receive for phantom_patch.js (cache + srpc/rpc refs)?"
curl -skI "https://${DOMAIN}/wolverine/phantom_patch.js" | sed -n '1,25p'
echo
curl -sk "https://${DOMAIN}/wolverine/phantom_patch.js?v=$(date +%s)" \
  | grep -nE "/srpc|/wolverine/rpc|/rpc" || echo "No /srpc or /rpc strings found ✅"

hr "2) Ensure phantom_patch.js is not cached by nginx (vhost check)"
grep -nE "location = /wolverine/phantom_patch\.js|Cache-Control" /etc/nginx/sites-enabled/fireinners.online-ssl || true

hr "3) Search ANY /srpc leftovers on disk (frontend + backend)"
grep -RIn --exclude-dir=node_modules --exclude-dir=.next --exclude='*.map' "/srpc" "$ROOT" /etc/nginx/snippets 2>/dev/null || echo "No /srpc leftovers found ✅"

hr "4) Search RPC URL / env settings in backend (common names)"
grep -RIn --exclude-dir=node_modules --exclude-dir=.next -E "SOLANA_RPC|RPC_URL|QUICKNODE|HELIUS|ALCHEMY|ANKR|CHAINSTACK|getBalance" \
  /var/www 2>/dev/null | head -n 120 || true

hr "5) Confirm /wolverine/rpc works exactly like browser (POST + headers)"
curl -sk -i "https://${DOMAIN}/wolverine/rpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,40p'

hr "DONE - paste output of sections 1 + 3 + 4"
BASH

chmod +x /root/find_balance_rpc_error_source.sh
/root/find_balance_rpc_error_source.sh
say "write server.js (real create + on-chain metadata) with marker"
cat > "$API_DIR/server.js" <<'"'"'JS'"'"'
"use strict";
const fs=require("fs");
const path=require("path");
const express=require("express");
const cors=require("cors");
require("dotenv").config({path:path.join(__dirname,".env")});
const {Connection,Keypair,PublicKey,Transaction,SystemProgram}=require("@solana/web3.js");
const spl=require("@solana/spl-token");
const mpl=require("@metaplex-foundation/mpl-token-metadata");

/*BUNDLER_SERVER_ONCHAIN_META_V1*/

const APP=express();
APP.use(cors({origin:"*",methods:["GET","POST","OPTIONS"],allowedHeaders:["Content-Type","X-API-Key"]}));
APP.use(express.json({limit:"6mb"}));

const API_KEY=(process.env.BUNDLER_API_KEY||process.env.API_KEY||"").trim();
const DEFAULT_RPC=(process.env.DEFAULT_RPC||"").trim();
const PUBLIC_BASE=(process.env.PUBLIC_BASE||"").trim()||"";
const ASSETS_DIR=path.join(__dirname, (process.env.ASSETS_DIR||"public/assets").trim());
const WALLET_PATH=process.env.WALLET_PATH ? process.env.WALLET_PATH.trim() : path.join(__dirname,"wallet.json");

function now(){return new Date().toISOString();}
function ok(res,obj){res.status(200).json(obj);}
function bad(res,code,msg,extra){res.status(code).json(Object.assign({ok:false,error:String(msg||"ERROR")},extra||{}));}

function loadPayer(){
  if(!fs.existsSync(WALLET_PATH)) throw new Error("WALLET_MISSING:"+WALLET_PATH);
  const raw=fs.readFileSync(WALLET_PATH,"utf8");
  const sk=Uint8Array.from(JSON.parse(raw));
  return Keypair.fromSecretKey(sk);
}

function trimName(n){n=String(n||"").trim(); if(!n) return ""; if(n.length>32) n=n.slice(0,32); return n;}
function makeSymbolFromName(n){
  n=String(n||"").trim().toUpperCase().replace(/[^A-Z0-9]/g,"");
  if(!n) return "TOKEN";
  if(n.length>10) n=n.slice(0,10);
  return n;
}
function dataUrlToFile(dataUrl, outPath){
  const m=String(dataUrl||"").match(/^data:(image\/[a-zA-Z0-9.+-]+);base64,(.+)$/);
  if(!m) throw new Error("LOGO_BAD_DATAURL");
  const mime=m[1].toLowerCase();
  const b64=m[2];
  const buf=Buffer.from(b64,"base64");
  if(buf.length>1024*1024*2) throw new Error("LOGO_TOO_LARGE");
  let ext="png";
  if(mime.includes("jpeg")||mime.includes("jpg")) ext="jpg";
  else if(mime.includes("webp")) ext="webp";
  else if(mime.includes("png")) ext="png";
  else ext="img";
  const file=outPath.endsWith("."+ext)?outPath:(outPath+"."+ext);
  fs.mkdirSync(path.dirname(file),{recursive:true});
  fs.writeFileSync(file,buf);
  return {file,ext,mime,size:buf.length};
}

function requireApiKey(req,res){
  if(!API_KEY) return true; // if no key configured, allow (dev)
  const k=(req.headers["x-api-key"]||req.body?.apiKey||req.body?.key||"").toString().trim();
  if(k!==API_KEY) { bad(res,401,"UNAUTHORIZED"); return false; }
  return true;
}

APP.get("/health",(req,res)=>ok(res,{ok:true,ts:now(),host:"127.0.0.1"}));
APP.get("/info",(req,res)=>ok(res,{ok:true,ts:now(),defaultRpc:DEFAULT_RPC||null,publicBase:PUBLIC_BASE||null,assetsDir:ASSETS_DIR,walletPath:WALLET_PATH,haveApiKey:!!API_KEY}));

APP.post("/api/create-token", async (req,res)=>{
  try{
    if(!requireApiKey(req,res)) return;

    const body=req.body||{};
    const rpc=String(body.rpc||DEFAULT_RPC||"").trim();
    if(!rpc) return bad(res,400,"RPC_MISSING");
    const decimals=Number(body.decimals??6);
    if(!Number.isFinite(decimals) || decimals<0 || decimals>9) return bad(res,400,"BAD_DECIMALS");
    const supplyHuman=String(body.supply??body.amount??"0").trim();
    if(!/^\d+$/.test(supplyHuman)) return bad(res,400,"BAD_SUPPLY");
    const preflightOnly=!!body.preflightOnly;

    const payer=loadPayer();
    const ownerStr=String(body.owner||"").trim();
    const owner=ownerStr? new PublicKey(ownerStr) : payer.publicKey;

    // optional reuse mint
    const reuseMintStr=String(body.mintAddress||body.mint||"").trim();
    const reuseMint = reuseMintStr ? new PublicKey(reuseMintStr) : null;

    const revokeMintAuth=!!body.revokeMintAuth;
    const revokeFreezeAuth=!!body.revokeFreezeAuth;

    // UI meta (name/logo)
    const tokenName=trimName(body.tokenName||body.name||"");
    const logoDataUrl=String(body.logo||"").trim();

    const conn=new Connection(rpc,"confirmed");

    // amount = supply * 10^decimals
    const pow10 = BigInt("1" + "0".repeat(decimals));
    const amount = BigInt(supplyHuman) * pow10;

    // rent estimates (mint + ata + metadata, best-effort)
    const mintRentLamports = await conn.getMinimumBalanceForRentExemption(spl.MINT_SIZE).catch(()=>0);
    const ataRentLamports = await conn.getMinimumBalanceForRentExemption(spl.ACCOUNT_SIZE).catch(()=>0);
    // metadata size is not exposed here; return 0 (program handles)
    const est={mintRentLamports:Number(mintRentLamports)||0, mintRentSOL:(Number(mintRentLamports)||0)/1e9, ataRentLamports:Number(ataRentLamports)||0, ataRentSOL:(Number(ataRentLamports)||0)/1e9};

    if(preflightOnly){
      return ok(res,{ok:true,stub:false,result:{preflightOnly:true,rpc,payer:payer.publicKey.toBase58(),owner:owner.toBase58(),decimals,supplyHuman,amount:amount.toString(),reuseMint:reuseMint?reuseMint.toBase58():null,est,tokenName:tokenName||null,haveLogo:!!logoDataUrl,revokeMintAuth,revokeFreezeAuth}});
    }

    // REAL MODE (costs SOL)
    let mintKp=null;
    let mintPub=null;

    if(reuseMint){
      mintPub=reuseMint;
    }else{
      mintKp=Keypair.generate();
      mintPub=mintKp.publicKey;
      // create mint (payer as mintAuthority+freezeAuthority initially)
      const lam=await conn.getMinimumBalanceForRentExemption(spl.MINT_SIZE);
      const tx=new Transaction();
      tx.add(SystemProgram.createAccount({fromPubkey:payer.publicKey,newAccountPubkey:mintPub,space:spl.MINT_SIZE,lamports:lam,programId:spl.TOKEN_PROGRAM_ID}));
      tx.add(spl.createInitializeMintInstruction(mintPub,decimals,payer.publicKey,payer.publicKey,spl.TOKEN_PROGRAM_ID));
      tx.feePayer=payer.publicKey;
      tx.recentBlockhash=(await conn.getLatestBlockhash("confirmed")).blockhash;
      tx.sign(payer,mintKp);
      const sig=await conn.sendRawTransaction(tx.serialize(),{skipPreflight:false,maxRetries:5});
      await conn.confirmTransaction(sig,"confirmed");
    }

    // ATA + mintTo
    const ata = await spl.getOrCreateAssociatedTokenAccount(conn,payer,mintPub,owner,true,"confirmed");
    const sigMintTo = await spl.mintTo(conn,payer,mintPub,ata.address,payer,amount,[],{commitment:"confirmed"});

    // revoke authorities if requested
    let sigRevokeMint=null, sigRevokeFreeze=null;
    if(revokeMintAuth){
      sigRevokeMint=await spl.setAuthority(conn,payer,mintPub,payer.publicKey,spl.AuthorityType.MintTokens,null,[],{commitment:"confirmed"});
    }
    if(revokeFreezeAuth){
      sigRevokeFreeze=await spl.setAuthority(conn,payer,mintPub,payer.publicKey,spl.AuthorityType.FreezeAccount,null,[],{commitment:"confirmed"});
    }

    // on-chain metadata (URI points to our hosted JSON)
    let metaSig=null, metadataPda=null, uri=null, imageUrl=null, jsonUrl=null, savedLogo=null;
    if(tokenName){
      fs.mkdirSync(ASSETS_DIR,{recursive:true});
      const symbol=makeSymbolFromName(tokenName);

      // save logo if provided
      if(logoDataUrl){
        const base=path.join(ASSETS_DIR, mintPub.toBase58());
        const r=dataUrlToFile(logoDataUrl, base+"_logo");
        savedLogo=path.basename(r.file);
        imageUrl=(PUBLIC_BASE? (PUBLIC_BASE+"/bundler/assets/"+savedLogo) : ("/bundler/assets/"+savedLogo));
      }

      // write metadata json
      const jsonName=mintPub.toBase58()+".json";
      jsonUrl=(PUBLIC_BASE? (PUBLIC_BASE+"/bundler/assets/"+jsonName) : ("/bundler/assets/"+jsonName));
      uri=jsonUrl;
      const md={
        name: tokenName,
        symbol,
        description: "Created via fireinners Bundler",
        image: imageUrl || null,
        external_url: PUBLIC_BASE? (PUBLIC_BASE+"/bundler/") : "/bundler/",
        attributes:[]
      };
      fs.writeFileSync(path.join(ASSETS_DIR,jsonName), JSON.stringify(md,null,2));

      const TOKEN_METADATA_PROGRAM_ID = mpl.PROGRAM_ID ? mpl.PROGRAM_ID : new PublicKey("metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s");
      const [pda] = PublicKey.findProgramAddressSync(
        [Buffer.from("metadata"), TOKEN_METADATA_PROGRAM_ID.toBuffer(), mintPub.toBuffer()],
        TOKEN_METADATA_PROGRAM_ID
      );
      metadataPda=pda.toBase58();

      const ix = mpl.createCreateMetadataAccountV3Instruction(
        {
          metadata: pda,
          mint: mintPub,
          mintAuthority: payer.publicKey,
          payer: payer.publicKey,
          updateAuthority: payer.publicKey,
          systemProgram: SystemProgram.programId,
          rent: new PublicKey("SysvarRent111111111111111111111111111111111")
        },
        {
          createMetadataAccountArgsV3: {
            data: {
              name: tokenName,
              symbol: symbol,
              uri: uri,
              sellerFeeBasisPoints: 0,
              creators: null,
              collection: null,
              uses: null
            },
            isMutable: true,
            collectionDetails: null
          }
        }
      );

      const txm=new Transaction().add(ix);
      txm.feePayer=payer.publicKey;
      txm.recentBlockhash=(await conn.getLatestBlockhash("confirmed")).blockhash;
      txm.sign(payer);
      metaSig=await conn.sendRawTransaction(txm.serialize(),{skipPreflight:false,maxRetries:5});
      await conn.confirmTransaction(metaSig,"confirmed");
    }

    return ok(res,{
      ok:true,stub:false,
      result:{
        rpc,
        payer:payer.publicKey.toBase58(),
        owner:owner.toBase58(),
        mint:mintPub.toBase58(),
        ata:ata.address.toBase58(),
        decimals,
        supplyHuman,
        amount:amount.toString(),
        signatures:{mintTo:sigMintTo,revokeMint:sigRevokeMint,revokeFreeze:sigRevokeFreeze,metadata:metaSig},
        metadata:{pda:metadataPda,uri,jsonUrl,imageUrl},
        explorer:{
          mint:"https://solscan.io/token/"+mintPub.toBase58(),
          ata:"https://solscan.io/account/"+ata.address.toBase58()
        }
      }
    });

  }catch(e){
    return bad(res,500,"SERVER_ERROR",{detail:String(e&&e.message||e)});
  }
});

APP.use("/assets", express.static(path.join(__dirname,"public/assets")));

const HOST=process.env.API_HOST||"127.0.0.1";
const PORT=Number(process.env.API_PORT||9797);
APP.listen(PORT,HOST,()=>console.log(JSON.stringify({ok:true,ts:now(),host:HOST,port:PORT,rpc:DEFAULT_RPC||null})));
JS


cat >/root/fix_dup_wolverine_rpc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Source-of-truth: where /wolverine/rpc is defined (ACTIVE conf) =="
nginx -T 2>/dev/null | grep -n "/wolverine/rpc" | head -n 120 || true

echo
echo "== 2) Find ALL FILE occurrences (exclude backups/_saved) =="
mapfile -t HITS < <(
  grep -RIn --exclude='*.bak*' --exclude-dir='_saved_*' \
    -E '^[[:space:]]*location[[:space:]].*/wolverine/rpc' \
    /etc/nginx/sites-enabled /etc/nginx/snippets /etc/nginx/conf.d 2>/dev/null || true
)

printf '%s\n' "${HITS[@]:-<none>}"
echo

if ((${#HITS[@]} <= 1)); then
  echo "OK: 0 or 1 definition only. Nothing to dedupe."
else
  echo "== 3) Comment duplicates (KEEP FIRST ONLY) =="
  keep=1
  for hit in "${HITS[@]}"; do
    file="${hit%%:*}"
    rest="${hit#*:}"
    line="${rest%%:*}"

    if (( keep==1 )); then
      echo "KEEP: $file:$line"
      keep=0
      continue
    fi

    cp -a "$file" "${file}.bak_${TS}"
    sed -i "${line}s@^[[:space:]]*@# DISABLED_DUP_WOLVERINE_RPC_${TS} @" "$file"
    echo "DISABLED: $file:$line"
  done
fi

echo
echo "== 4) nginx -t =="
nginx -t

echo
echo "== 5) reload nginx =="
systemctl reload nginx

echo "DONE ✅"
BASH

chmod +x /root/fix_dup_wolverine_rpc.sh
/root/fix_dup_wolverine_rpc.sh
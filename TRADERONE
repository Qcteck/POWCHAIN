cat >/root/fix_rpc_minimal_headers.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
INC="/etc/nginx/includes/wolverine_routes.inc"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$INC" || { echo "Missing $INC"; exit 1; }
cp -a "$INC" "${INC}.bak_${TS}"

python3 - <<'PY'
import re, pathlib
p = pathlib.Path("/etc/nginx/includes/wolverine_routes.inc")
s = p.read_text(errors="ignore")

# remove previous rpc blocks (marker) + best-effort raw
s = re.sub(r"\n?#\s*WOLVERINE_RPC_PROXY_BEGIN.*?#\s*WOLVERINE_RPC_PROXY_END\s*\n?", "\n", s, flags=re.S)
s = re.sub(r"\n\s*location\s*=\s*/wolverine/rpc\s*\{.*?\n\s*\}\s*\n", "\n", s, flags=re.S)
s = re.sub(r"\n\s*location\s*\^~\s*/wolverine/rpc/\s*\{.*?\n\s*\}\s*\n", "\n", s, flags=re.S)

block = r'''
# WOLVERINE_RPC_PROXY_BEGIN
# Solana JSON-RPC proxy (same-origin) - MINIMAL HEADERS
location = /wolverine/rpc {
  add_header X-Wolverine-Rpc "nginx-origin" always;
  access_log /var/log/nginx/wolverine_rpc_access.log combined;

  if ($request_method = OPTIONS) {
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
    add_header Content-Length 0;
    return 204;
  }

  add_header Access-Control-Allow-Origin "*" always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;

  # IMPORTANT: do NOT forward browser headers
  proxy_pass_request_headers off;

  proxy_http_version 1.1;
  proxy_ssl_server_name on;

  proxy_set_header Host api.mainnet-beta.solana.com;
  proxy_set_header User-Agent "Mozilla/5.0";
  proxy_set_header Accept "application/json";
  proxy_set_header Content-Type $content_type;
  proxy_set_header Content-Length $content_length;

  proxy_pass https://api.mainnet-beta.solana.com/;
}

location ^~ /wolverine/rpc/ { return 301 /wolverine/rpc; }
# WOLVERINE_RPC_PROXY_END
'''
s = s.rstrip() + "\n\n" + block + "\n"
p.write_text(s)
print("OK: rpc minimal-headers block installed")
PY

touch /var/log/nginx/wolverine_rpc_access.log || true
nginx -t
systemctl reload nginx || service nginx reload

echo "== Test (simulate browser Origin) should be 200 now =="
curl -sk -i -X POST https://fireinners.online/wolverine/rpc \
  -H 'Content-Type: application/json' \
  -H 'Origin: https://fireinners.online' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | sed -n '1,30p'
echo "DONE ✅"
BASH

chmod +x /root/fix_rpc_minimal_headers.sh
/root/fix_rpc_minimal_headers.sh
set -euo pipefail

SRC="/var/www/fireinners-test"
ULT="$SRC/ultimate"
TMP="/tmp/blend_work"
OUT="$ULT/blend_305_4k.png"

mkdir -p "$ULT" "$TMP"
apt-get update -y
apt-get install -y imagemagick

echo "=== Collecte images ==="
mapfile -t IMGS < <(find "$SRC" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) | sort)
echo "Images trouvées: ${#IMGS[@]}"
[ "${#IMGS[@]}" -gt 0 ] || { echo "❌ Aucune image trouvée"; exit 1; }

echo "=== Resize toutes les images en 4K temporairement ==="
i=0
for f in "${IMGS[@]}"; do
  i=$((i+1))
  printf -v name "$TMP/img_%04d.png" "$i"
  convert "$f" -resize 3840x2160^ -gravity center -extent 3840x2160 "$name"
done

echo "=== Fusion médiane (le meilleur de chaque version) ==="
convert "$TMP"/img_*.png -evaluate-sequence median "$OUT"

echo "=== Nettoyage ==="
rm -rf "$TMP"

chown -R www-data:www-data "$ULT" || true
chmod -R a+rX "$ULT" || true

echo "✅ Image finale générée : $OUT"
echo "➡️ URL : https://fireinners.online/test/ultimate/$(basename "$OUT")"
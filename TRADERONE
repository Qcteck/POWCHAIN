cat >/tmp/wolfchain_megafix_v2.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "== WOLFCHAIN MEGAFIX v2 =="
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/opt/fireinners/frontend-react/app/dist"

if [[ -f "$VHOST" ]]; then
  R="$(awk 'BEGIN{r=""} /^[ \t]*root[ \t]+/ {gsub(/;$/,"",$2); if(r=="") r=$2} END{print r}' "$VHOST")"
  [[ -n "${R:-}" ]] && ROOT="$R"
fi

echo "VHOST=$VHOST"
echo "ROOT=$ROOT"
[[ -d "$ROOT" ]] || { echo "ERR: ROOT introuvable: $ROOT"; exit 1; }

ts(){ date +"%Y%m%d-%H%M%S"; }
bk(){ [[ -f "$1" ]] && cp -a "$1" "$1.bak.$(ts)" && echo "backup: $1.bak.$(ts)" || true; }
immut_off(){ command -v lsattr >/dev/null && command -v chattr >/dev/null && [[ -e "$1" ]] && lsattr "$1" 2>/dev/null | grep -q '\-i\-' && true || (command -v chattr >/dev/null && chattr -i "$1" 2>/dev/null || true); }

echo "== create dirs =="
mkdir -p "$ROOT"/{wallet,dex,bridge,explorer,mining,options,wolverine,assets} 2>/dev/null || true

echo "== write ROOT/index.html (EN default, EN/FR toggle) =="
HOME="$ROOT/index.html"
bk "$HOME"; immut_off "$HOME"
cat >"$HOME" <<'HTML'
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="color-scheme" content="dark"/><title>WOLFCHAIN • Core</title><style>:root{--bg:#05060b;--p:#0a0f1e;--b:#1b2a44;--t:#e7f0ff;--m:#9fb3d7;--a:#ff7a18;--a2:#ffb03a;--ok:#7dffb1;--bad:#ff6b6b}*{box-sizing:border-box}html,body{height:100%;margin:0;background:radial-gradient(900px 520px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(800px 520px at 85% 15%,#121b35 0%,transparent 55%),linear-gradient(180deg,#05060b,#05060b);color:var(--t);font:14px system-ui,-apple-system,Segoe UI,Roboto,Arial}a{color:inherit;text-decoration:none}#wrap{min-height:100%;display:flex;align-items:center;justify-content:center;padding:22px}#card{width:min(980px,100%);background:linear-gradient(180deg,rgba(10,15,30,.92),rgba(7,10,20,.92));border:1px solid rgba(27,42,68,.75);border-radius:18px;box-shadow:0 18px 60px rgba(0,0,0,.55);overflow:hidden}#top{display:flex;gap:16px;align-items:center;justify-content:space-between;padding:18px 18px 12px;border-bottom:1px solid rgba(27,42,68,.6)}#brand{display:flex;gap:12px;align-items:center}#logo{width:44px;height:44px;border-radius:12px;background:radial-gradient(circle at 30% 25%,rgba(255,176,58,.35),transparent 60%),linear-gradient(135deg,rgba(255,122,24,.65),rgba(255,176,58,.25));border:1px solid rgba(255,176,58,.25);display:grid;place-items:center;font-weight:900}#title{line-height:1.05}#title b{font-size:16px;letter-spacing:.3px}#title div{color:var(--m);font-size:12px;margin-top:4px}#status{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}._pill{display:inline-flex;gap:8px;align-items:center;padding:8px 10px;border-radius:999px;background:rgba(7,10,20,.65);border:1px solid rgba(27,42,68,.65);color:var(--m)}._dot{width:8px;height:8px;border-radius:99px;background:rgba(159,179,215,.5)}._dot.ok{background:var(--ok)}._dot.bad{background:var(--bad)}#langBtn{cursor:pointer;user-select:none}#mid{padding:14px 18px 18px;display:grid;gap:14px}#hero{display:grid;gap:10px}#hero h1{margin:0;font-size:22px;letter-spacing:.4px}#hero p{margin:0;color:var(--m);max-width:78ch}#grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}@media(max-width:900px){#grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){#grid{grid-template-columns:1fr}#status{justify-content:flex-start}}.tile{position:relative;padding:14px 14px 12px;border-radius:16px;background:linear-gradient(180deg,rgba(12,18,34,.95),rgba(7,10,20,.85));border:1px solid rgba(27,42,68,.7);transition:transform .12s ease,border-color .12s ease,box-shadow .12s ease}.tile:hover{transform:translateY(-1px);border-color:rgba(255,176,58,.35);box-shadow:0 10px 26px rgba(0,0,0,.35)}.tile b{display:block;font-size:14px;margin-bottom:6px}.tile span{display:block;color:var(--m);font-size:12px;line-height:1.35}.tile i{position:absolute;right:12px;top:12px;width:10px;height:10px;border-radius:99px;background:linear-gradient(180deg,var(--a2),var(--a));opacity:.9}#foot{display:flex;gap:12px;justify-content:space-between;align-items:center;padding:14px 18px;border-top:1px solid rgba(27,42,68,.6);color:var(--m);font-size:12px;flex-wrap:wrap}</style></head><body><div id="wrap"><div id="card"><div id="top"><div id="brand"><div id="logo">W</div><div id="title"><b>WOLFCHAIN • Core</b><div id="tSub">Wallet • DEX • Bridge • Explorer • Mining • Options</div></div></div><div id="status"><div class="_pill"><span class="_dot" id="apiDot"></span><span id="apiTxt">API: check...</span></div><div class="_pill" id="langBtn">EN</div></div></div><div id="mid"><div id="hero"><h1 id="tH1">Main portal</h1><p id="tP">Bilingual homepage. The EN/FR toggle is saved. API status checks /stats.</p></div><div id="grid"><a class="tile" href="/wallet/"><i></i><b>Wallet</b><span id="tW2">Wallet access, balances, actions.</span></a><a class="tile" href="/dex/"><i></i><b>DEX</b><span id="tD2">Swap / LP / pricing.</span></a><a class="tile" href="/bridge/"><i></i><b>Bridge</b><span id="tB2">SOL → WOLFCHAIN.</span></a><a class="tile" href="/explorer/"><i></i><b>Explorer</b><span id="tE2">Blocks / TX / wallets.</span></a><a class="tile" href="/mining/"><i></i><b>Mining</b><span id="tM2">Mining tools.</span></a><a class="tile" href="/options/"><i></i><b>Options</b><span id="tO2">Settings / diagnostics.</span></a><a class="tile" href="/wolverine/"><i></i><b>WOLVERINE</b><span id="tR2">Trading hub.</span></a><a class="tile" href="/stats"><i></i><b>/stats</b><span id="tS2">JSON ping.</span></a><a class="tile" href="/ws"><i></i><b>/ws</b><span id="tWS2">WebSocket (if nginx proxy).</span></a></div></div><div id="foot"><div id="tF1">WOLFCHAIN • home</div><div id="tF2">lang: EN</div></div></div></div><script>(()=>{const G=id=>document.getElementById(id);const D={en:{btn:"EN",f1:"WOLFCHAIN • home",f2:"lang: EN",h1:"Main portal",p:"Bilingual homepage. The EN/FR toggle is saved. API status checks /stats.",sub:"Wallet • DEX • Bridge • Explorer • Mining • Options",w2:"Wallet access, balances, actions.",d2:"Swap / LP / pricing.",b2:"SOL → WOLFCHAIN.",e2:"Blocks / TX / wallets.",m2:"Mining tools.",o2:"Settings / diagnostics.",r2:"Trading hub.",s2:"JSON ping.",ws2:"WebSocket (if nginx proxy).",apiOn:"API: online",apiOff:"API: offline",apiChk:"API: check..."},fr:{btn:"FR",f1:"WOLFCHAIN • accueil",f2:"lang: FR",h1:"Portail principal",p:"Page d’accueil bilingue. Le toggle EN/FR est mémorisé. Le statut API teste /stats.",sub:"Wallet • DEX • Bridge • Explorer • Mining • Options",w2:"Accès wallet, soldes, actions.",d2:"Swap / LP / prix.",b2:"SOL → WOLFCHAIN.",e2:"Blocks / TX / wallets.",m2:"Outils mining.",o2:"Réglages / diagnostics.",r2:"Hub trading.",s2:"Ping JSON.",ws2:"WebSocket (si proxy nginx).",apiOn:"API: en ligne",apiOff:"API: hors ligne",apiChk:"API: test..."}};const sp=new URLSearchParams(location.search);let lang=(sp.get("lang")||localStorage.getItem("lang")||"en").toLowerCase();if(lang!=="fr")lang="en";let apiOK=null;const apiTxt=G("apiTxt"),apiDot=G("apiDot");const renderAPI=()=>{const L=D[lang];if(apiOK===true){apiTxt.textContent=L.apiOn;apiDot.className="_dot ok"}else if(apiOK===false){apiTxt.textContent=L.apiOff;apiDot.className="_dot bad"}else{apiTxt.textContent=L.apiChk;apiDot.className="_dot"}};const apply=()=>{const L=D[lang];G("langBtn").textContent=L.btn;G("tF1").textContent=L.f1;G("tF2").textContent=L.f2;G("tH1").textContent=L.h1;G("tP").textContent=L.p;G("tSub").textContent=L.sub;G("tW2").textContent=L.w2;G("tD2").textContent=L.d2;G("tB2").textContent=L.b2;G("tE2").textContent=L.e2;G("tM2").textContent=L.m2;G("tO2").textContent=L.o2;G("tR2").textContent=L.r2;G("tS2").textContent=L.s2;G("tWS2").textContent=L.ws2;localStorage.setItem("lang",lang);document.documentElement.lang=lang;renderAPI()};const ping=async()=>{try{const r=await fetch("/stats",{cache:"no-store"});if(!r.ok)throw 0;apiOK=true}catch(e){apiOK=false}renderAPI()};G("langBtn").onclick=()=>{lang=lang==="en"?"fr":"en";apply();ping();};apply();ping();setInterval(ping,15000)})();</script></body></html>
HTML

mkmod(){
  local dir="$1" name="$2" desc_en="$3" desc_fr="$4"
  local f="$ROOT/$dir/index.html"
  bk "$f"; immut_off "$f"
  cat >"$f" <<HTML
<!doctype html><html lang="en"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="color-scheme" content="dark"/><title>WOLFCHAIN • $name</title><style>html,body{height:100%;margin:0;background:#05060b;color:#e7f0ff;font:14px system-ui}a{color:inherit;text-decoration:none}#w{min-height:100%;display:grid;place-items:center;padding:22px}#c{width:min(900px,100%);background:rgba(10,15,30,.92);border:1px solid rgba(27,42,68,.75);border-radius:18px;box-shadow:0 18px 60px rgba(0,0,0,.55);padding:18px}#top{display:flex;justify-content:space-between;align-items:center;gap:10px}#top b{font-size:16px}#btn{cursor:pointer;padding:8px 10px;border-radius:999px;background:rgba(7,10,20,.65);border:1px solid rgba(27,42,68,.65);color:#9fb3d7}p{color:#9fb3d7;line-height:1.45}#links{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}#links a{padding:10px 12px;border-radius:14px;background:rgba(12,18,34,.95);border:1px solid rgba(27,42,68,.7)}</style><body><div id="w"><div id="c"><div id="top"><div><b id="h">$name</b><div style="color:#9fb3d7;font-size:12px;margin-top:4px">WOLFCHAIN</div></div><div id="btn">EN</div></div><p id="p">$desc_en</p><div id="links"><a href="/">Home</a><a href="/wallet/">Wallet</a><a href="/dex/">DEX</a><a href="/bridge/">Bridge</a><a href="/explorer/">Explorer</a><a href="/mining/">Mining</a><a href="/options/">Options</a><a href="/wolverine/">WOLVERINE</a></div></div></div><script>(()=>{const G=id=>document.getElementById(id);let lang=(localStorage.getItem("lang")||"en").toLowerCase();if(lang!=="fr")lang="en";const EN={h:"$name",p:"$desc_en",btn:"EN"},FR={h:"$name",p:"$desc_fr",btn:"FR"};const apply=()=>{const L=lang==="fr"?FR:EN;G("h").textContent=L.h;G("p").textContent=L.p;G("btn").textContent=L.btn;document.documentElement.lang=lang;localStorage.setItem("lang",lang)};G("btn").onclick=()=>{lang=lang==="en"?"fr":"en";apply()};apply()})();</script></body></html>
HTML
}

echo "== write module pages =="
mkmod "wallet" "Wallet" "Wallet module placeholder (install/plug your real wallet UI here)." "Module wallet (placeholder) — installe/branche ton UI wallet ici."
mkmod "dex" "DEX" "DEX module placeholder (no blank page). Put Swap/LP UI here." "Module DEX (placeholder) — pas de page blanche. Mets Swap/LP ici."
mkmod "bridge" "Bridge" "Bridge module placeholder. Put SOL→WOLFCHAIN bridge UI here." "Module Bridge (placeholder) — mets l’UI SOL→WOLFCHAIN ici."
mkmod "explorer" "Explorer" "Explorer module placeholder. Put blocks/tx/wallets viewer here." "Module Explorer (placeholder) — blocs/tx/wallets ici."
mkmod "mining" "Mining" "Mining tools placeholder." "Outils mining (placeholder)."
mkmod "options" "Options" "Options/diagnostics placeholder." "Options/diagnostics (placeholder)."
mkmod "wolverine" "WOLVERINE" "WOLVERINE trading hub placeholder." "Hub trading WOLVERINE (placeholder)."

echo "== ensure permissions (avoid 403) =="
chmod -R a+rX "$ROOT" || true

echo "== nginx patch: /stats proxy to 127.0.0.1:3000/stats + /ws to 127.0.0.1:3000/ws =="
if [[ -f "$VHOST" ]]; then
  # unlock if immutable
  command -v chattr >/dev/null && chattr -i "$VHOST" 2>/dev/null || true
  bk "$VHOST"

  # force /ws upstream
  if grep -qE 'location[[:space:]]+/ws' "$VHOST"; then
    perl -0777 -pi -e 's@(location\s+/ws\s*\{.*?proxy_pass\s+)http://127\.0\.0\.1:\d+(/[^\s;]*)?;@\1http://127.0.0.1:3000/ws;@s' "$VHOST" || true
    perl -0777 -pi -e 's@(location\s+/ws\s*\{(?!.*proxy_pass).*?\n)@\1    proxy_pass http://127.0.0.1:3000/ws;\n@si' "$VHOST" || true
  fi

  # add /stats if missing
  if ! grep -qE 'location\s*=\s*/stats' "$VHOST"; then
    perl -0777 -pi -e 's@(server\s*\{)@$1\n\n    location = /stats {\n        proxy_pass http://127.0.0.1:3000/stats;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n@' "$VHOST"
  fi

  nginx -t
  systemctl reload nginx

  # relock
  command -v chattr >/dev/null && chattr +i "$VHOST" 2>/dev/null || true
fi

echo "== done =="
echo "Test:"
echo "  https://fireinners.online/   (home)"
echo "  https://fireinners.online/dex/ (should NOT be blank)"
echo "  curl -sS -i http://127.0.0.1:3000/stats | sed -n '1,12p'"
echo "  curl -k -sS -i https://127.0.0.1/stats -H 'Host: fireinners.online' | sed -n '1,12p'"
SH
bash /tmp/wolfchain_megafix_v2.sh
cat >/root/MEGA_NDJSON_VIEWER.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_NDJSON_${TS}"
mkdir -p "$BK"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
backup(){ local p="$1"; if [ -e "$p" ]; then mkdir -p "$BK$(dirname "$p")"; cp -a "$p" "$BK$p" 2>/dev/null || true; fi; }

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
INC_DATA="$INC_DIR/ndjson_data.inc"
INC_VIEW="$INC_DIR/ndjson_viewer.inc"
WWW="/var/www/ndjson"
DATA_DIR="/opt/traderone-api/data"   # <-- dossier NDJSON (stable)
TEST_ND="$DATA_DIR/events.ndjson"

say "Unfreeze nginx (best effort)..."
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$VHOST" 2>/dev/null || true
chattr -i "$INC_DIR"/* 2>/dev/null || true

say "Backup..."
backup /etc/nginx/nginx.conf
backup "$VHOST"
backup "$INC_DIR"
backup "$WWW"
backup "$DATA_DIR"

say "Prepare dirs..."
mkdir -p "$INC_DIR" "$WWW" "$DATA_DIR"
chmod 755 "$WWW" "$DATA_DIR"

say "Create NDJSON test file (append-only friendly)..."
if [ ! -f "$TEST_ND" ]; then
  cat >"$TEST_ND" <<'ND'
{"ts":"INIT","type":"boot","msg":"ndjson online","ok":true}
ND
fi
chmod 644 "$TEST_ND"

say "Write NDJSON Viewer UI -> /var/www/ndjson/index.html ..."
cat >"$WWW/index.html" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NDJSON Watcher • Viewer</title><style>html,body{margin:0;padding:0;background:#0b0f14;color:#e7eef7;font:14px/1.35 system-ui,-apple-system,Segoe UI,Roboto,Arial}*{box-sizing:border-box}a{color:#7ec8ff}input,button,select,textarea{background:#111826;color:#e7eef7;border:1px solid #223047;border-radius:10px;padding:10px 12px;outline:none}button{cursor:pointer}button:hover{border-color:#3a7bd5}.wrap{max-width:1200px;margin:0 auto;padding:16px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.card{background:#0f1520;border:1px solid #1e2a3f;border-radius:14px;padding:12px}.grow{flex:1}.kpi{display:flex;gap:10px;flex-wrap:wrap}.k{min-width:160px}.k b{display:block;font-size:18px}.muted{color:#9fb2c9}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.tbl{width:100%;border-collapse:collapse;font-size:12px}.tbl th,.tbl td{border-bottom:1px solid #1d2a40;padding:8px;text-align:left;vertical-align:top}.pill{display:inline-block;padding:2px 8px;border-radius:999px;border:1px solid #2a3c57;background:#0c121c;font-size:12px}.ok{border-color:#2f8f5f}.bad{border-color:#b24a4a}.warn{border-color:#b58b2a}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}.log{max-height:420px;overflow:auto}.small{font-size:12px}.right{margin-left:auto}.sep{height:1px;background:#1d2a40;margin:10px 0}</style></head><body><div class="wrap"><div class="row"><div class="card grow"><div class="row"><div class="grow"><div class="muted small">Source NDJSON</div><div class="row"><input class="grow" id="url" placeholder="URL (ex: /data/events.ndjson)"><button id="load">Charger</button><button id="toggle">Auto: OFF</button><input id="ms" style="width:120px" value="5000" title="Interval ms"><label class="pill"><input type="file" id="file" accept=".ndjson,.log,.txt" style="display:none"><span id="pick" style="cursor:pointer">Fichier…</span></label></div><div class="muted small">Astuce: Nginx expose /data/ → dossier logs NDJSON. Exemple: /data/events.ndjson</div></div><div class="right"><span class="pill" id="st">idle</span></div></div><div class="sep"></div><div class="kpi"><div class="k card"><div class="muted small">Lignes</div><b id="lines">0</b><div class="muted small mono" id="last">—</div></div><div class="k card"><div class="muted small">Types</div><b id="types">0</b><div class="muted small">distinct</div></div><div class="k card"><div class="muted small">Erreurs parse</div><b id="bad">0</b><div class="muted small">JSON invalides</div></div></div><div class="sep"></div><div class="grid"><div class="card"><div class="row"><div class="muted small">Dernières entrées</div><div class="right muted small mono" id="src">—</div></div><div class="log"><table class="tbl" id="tbl"><thead><tr><th style="width:140px">ts</th><th style="width:110px">type</th><th>payload</th></tr></thead><tbody></tbody></table></div></div><div class="card"><div class="muted small">Console</div><div class="log mono" id="log"></div></div></div></div></div></div><script>(()=>{"use strict";const $=s=>document.querySelector(s),st=$("#st"),u=$("#url"),load=$("#load"),tog=$("#toggle"),ms=$("#ms"),file=$("#file"),pick=$("#pick"),lines=$("#lines"),types=$("#types"),bad=$("#bad"),last=$("#last"),src=$("#src"),tbl=$("#tbl").querySelector("tbody"),log=$("#log");let timer=null,auto=false;const push=m=>{const t=new Date().toLocaleTimeString("fr-CA",{hour:"2-digit",minute:"2-digit",second:"2-digit"});const d=document.createElement("div");d.textContent=`[${t}] ${m}`;log.appendChild(d);log.scrollTop=1e9};const setst=(t,cls)=>{st.textContent=t;st.className="pill "+(cls||"")};const esc=s=>String(s).replace(/[&<>"']/g,c=>({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));const render=(arr,srcLabel)=>{tbl.innerHTML="";const typeSet=new Set();let badCount=0;for(let i=Math.max(0,arr.length-250);i<arr.length;i++){const r=arr[i];if(r && typeof r==="object"){if(r.type) typeSet.add(String(r.type));const tr=document.createElement("tr");tr.innerHTML=`<td class="mono">${esc(r.ts||"")}</td><td><span class="pill ${r.ok===true?"ok":r.ok===false?"bad":"warn"}">${esc(r.type||"—")}</span></td><td class="mono" title="${esc(JSON.stringify(r))}">${esc(JSON.stringify(r))}</td>`;tbl.appendChild(tr);}else badCount++;}lines.textContent=String(arr.length);types.textContent=String(typeSet.size);bad.textContent=String(badCount);last.textContent=arr.length?("last: "+new Date().toISOString()):"—";src.textContent=srcLabel||"—";};const parseND=(txt)=>{const out=[];const ls=txt.split(/\r?\n/);for(const l of ls){const s=l.trim();if(!s)continue;try{out.push(JSON.parse(s));}catch(_){out.push(null);} }return out;};const fetchUrl=async()=>{const url=u.value.trim()||"/data/events.ndjson";u.value=url;setst("loading","warn");push("GET "+url);try{const r=await fetch(url,{cache:"no-store"});const t=await r.text();if(!r.ok){setst("ERR "+r.status,"bad");push("HTTP "+r.status+" "+t.slice(0,200));return;}const arr=parseND(t);render(arr,url);setst("OK","ok");}catch(e){setst("ERR","bad");push("ERR "+(e&&e.message||e));}};load.onclick=fetchUrl;const setAuto=(on)=>{auto=on;tog.textContent="Auto: "+(auto?"ON":"OFF");tog.className="btn";if(timer){clearInterval(timer);timer=null;}if(auto){let iv=Math.max(500,parseInt(ms.value||"5000",10)||5000);timer=setInterval(fetchUrl,iv);}};tog.onclick=()=>setAuto(!auto);pick.onclick=()=>file.click();file.onchange=async()=>{const f=file.files&&file.files[0];if(!f)return;const txt=await f.text();const arr=parseND(txt);render(arr,f.name);setst("FILE","ok");push("Loaded file "+f.name+" ("+arr.length+" lines)");};u.value="/data/events.ndjson";setst("idle");push("Ready. Try /data/events.ndjson");})();</script></body></html>
HTML
chmod 644 "$WWW/index.html"
chmod 755 "$WWW"

say "Write nginx include for /ndjson/ viewer ..."
cat >"$INC_VIEW" <<'NGINX'
location ^~ /ndjson/ {
  alias /var/www/ndjson/;
  index index.html;
  try_files $uri $uri/ /ndjson/index.html;
  add_header Cache-Control "no-store" always;
}
NGINX
chmod 644 "$INC_VIEW"

say "Write nginx include for /data/ NDJSON alias ..."
cat >"$INC_DATA" <<'NGINX'
location ^~ /data/ {
  alias /opt/traderone-api/data/;
  default_type application/x-ndjson;
  add_header Cache-Control "no-store" always;
  try_files $uri =404;
}
NGINX
chmod 644 "$INC_DATA"

say "Ensure vhost has includes (no broken references, no duplicates)..."
if [ -f "$VHOST" ]; then
  sed -i '/ndjson_data\.inc/d;/ndjson_viewer\.inc/d;/ndjson_routes\.inc/d' "$VHOST" || true
  if grep -qE 'include\s+/etc/nginx/includes/\*\.inc' "$VHOST"; then
    :
  else
    awk -v a="    include $INC_VIEW;" -v b="    include $INC_DATA;" '
      BEGIN{done=0}
      {print}
      if(!done && $0 ~ /server\s*\{/){
        print a
        print b
        done=1
      }' "$VHOST" >"$VHOST.tmp" && mv "$VHOST.tmp" "$VHOST"
  fi
fi

say "nginx -t ..."
nginx -t
say "reload nginx ..."
systemctl reload nginx

say "Refreeze nginx (best effort)..."
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$VHOST" 2>/dev/null || true

say "DONE:"
say "  Viewer: https://fireinners.online/ndjson/"
say "  Test NDJSON: https://fireinners.online/data/events.ndjson"
say "Backup: $BK"
say "Quick tests:"
echo "curl -sS https://fireinners.online/data/events.ndjson | head"
echo "curl -I https://fireinners.online/ndjson/ | head"
BASH
chmod +x /root/MEGA_NDJSON_VIEWER.sh
bash /root/MEGA_NDJSON_VIEWER.sh |& tee /root/MEGA_NDJSON_VIEWER.log
cat >/root/FIREINNERS_WALLET_TAB_MEGA2.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
DIST="/opt/fireinners/frontend-react/app/dist"
IDX="$DIST/index.html"
WALDIR="$DIST/wallet"
WALIDX="$WALDIR/index.html"
MARK="FIREINNERS_WALLET_TAB_v1"

echo "=== FIREINNERS WALLET TAB :: MEGA2 (safe) ==="
echo "[0] Checks"
[ -d "$DIST" ] || { echo "ERR dist missing: $DIST"; exit 1; }
[ -f "$IDX" ] || { echo "ERR index missing: $IDX"; exit 1; }
mkdir -p "$WALDIR"

echo "[1] Backup index.html"
BK="/root/backup_fireinners_wallettab_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$BK"
cp -f "$IDX" "$BK/index.html.bak"
echo "Backup: $BK/index.html.bak"

echo "[2] Write wallet page"
cat >"$WALIDX" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><title>FireInners • Wallet</title><style>:root{--bg:#05060b;--p:#0a0f1e;--l:#1b2a44;--t:#e7f0ff;--m:#9fb3d7;--ok:#b9ffcf;--bad:#ffb3b3;--a:#9ff}*{box-sizing:border-box}html,body{margin:0;height:100%;background:radial-gradient(900px 500px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(700px 450px at 80% 20%,#101a33 0%,transparent 55%),var(--bg);color:var(--t);font:14px system-ui}a{color:var(--a);text-decoration:none}#wrap{max-width:980px;margin:0 auto;padding:18px}#card{background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:14px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}#top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}h1{margin:0;font-size:16px;letter-spacing:.3px}#pill a{display:inline-block;padding:8px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.15);background:rgba(0,0,0,.18)}#row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:12px}button{cursor:pointer;border:1px solid rgba(255,255,255,.16);background:rgba(0,0,0,.22);color:var(--t);padding:10px 12px;border-radius:12px;font-weight:700}button:disabled{opacity:.5;cursor:not-allowed}#grid{display:grid;grid-template-columns:1.2fr .8fr;gap:12px;margin-top:12px}@media(max-width:860px){#grid{grid-template-columns:1fr}}.box{background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:12px}.k{color:var(--m);font-size:12px}.v{margin-top:6px;font:600 14px ui-monospace,Menlo,Consolas,monospace;word-break:break-all}.ok{color:var(--ok)}.bad{color:var(--bad)}#log{height:260px;overflow:auto;white-space:pre-wrap;font:12px ui-monospace,Menlo,Consolas,monospace;color:#d8e6ff}</style></head><body><div id="wrap"><div id="card"><div id="top"><div><h1>FireInners • Wallet</h1><div class="k">Lecture soldes via Phantom + Solana RPC. Aucun secret, aucune seed, aucun export.</div></div><div id="pill"><a href="/">Retour</a></div></div><div id="row"><button id="btnConnect">Connect</button><button id="btnDisc" disabled>Disconnect</button><button id="btnRefresh" disabled>Refresh</button></div><div id="grid"><div class="box"><div class="k">Adresse</div><div id="addr" class="v muted">-</div><div style="height:10px"></div><div class="k">RPC</div><div id="rpc" class="v muted">-</div></div><div class="box"><div class="k">SOL</div><div id="sol" class="v muted">-</div><div style="height:10px"></div><div class="k">USDC</div><div id="usdc" class="v muted">-</div></div></div><div class="box" style="margin-top:12px"><div class="k">Log</div><div id="log"></div></div></div></div><script src="https://unpkg.com/@solana/web3.js@1.98.0/lib/index.iife.min.js"></script><script>(()=>{const RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1",TOKEN_PROGRAM="TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA";const $=s=>document.querySelector(s),log=m=>{const el=$("#log");el.textContent+=(m+(m.endsWith("\n")?"":"\n"));el.scrollTop=el.scrollHeight};const fmt=(n,dp=6)=>{try{return Number(n||0).toLocaleString(undefined,{maximumFractionDigits:dp})}catch(_){return String(n)}};let conn=null,pub=null;$("#rpc").textContent=RPC;async function getUSDC(owner){try{const resp=await conn.getParsedTokenAccountsByOwner(owner,{programId:new solanaWeb3.PublicKey(TOKEN_PROGRAM)});let sum=0;for(const it of resp.value||[]){const info=it.account?.data?.parsed?.info;const mint=info?.mint;const ui=info?.tokenAmount?.uiAmount; if(mint===USDC_MINT) sum+=Number(ui||0);}return sum}catch(e){log("USDC err: "+(e?.message||e));return 0}}async function refresh(){if(!pub) return;try{const lam=await conn.getBalance(pub,"confirmed");$("#sol").textContent=fmt(lam/1e9,6);const u=await getUSDC(pub);$("#usdc").textContent=fmt(u,2);log("REFRESH OK")}catch(e){log("REFRESH ERR: "+(e?.message||e))}}async function connect(){try{const ph=window.solana; if(!ph||!ph.isPhantom){log("Phantom introuvable.");return} conn=new solanaWeb3.Connection(RPC,{commitment:"confirmed"}); const r=await ph.connect(); pub=r.publicKey; $("#addr").textContent=pub.toBase58(); $("#btnDisc").disabled=false; $("#btnRefresh").disabled=false; log("CONNECTED"); await refresh()}catch(e){log("CONNECT ERR: "+(e?.message||e))}}async function disconnect(){try{const ph=window.solana; if(ph&&ph.disconnect) await ph.disconnect();}catch(_){} pub=null; conn=null; $("#addr").textContent="-"; $("#sol").textContent="-"; $("#usdc").textContent="-"; $("#btnDisc").disabled=true; $("#btnRefresh").disabled=true; log("DISCONNECTED")}$("#btnConnect").onclick=connect;$("#btnDisc").onclick=disconnect;$("#btnRefresh").onclick=refresh;})();</script></body></html>
HTML

chmod 0644 "$WALIDX"

echo "[3] Inject WALLET button into dist/index.html if missing"
if grep -q "$MARK" "$IDX"; then
  echo "OK marker already present"
else
  python3 - <<PY
import pathlib,re,sys
p=pathlib.Path("$IDX")
s=p.read_text(encoding="utf-8",errors="ignore")
inj='''<!-- $MARK -->
<a href="/wallet/" style="position:fixed;top:14px;right:14px;z-index:999999;padding:10px 12px;border-radius:999px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.18);color:#e7f0ff;font:700 12px system-ui;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);text-decoration:none">WALLET</a>
'''
ns=re.sub(r'(?i)</body>', inj+"\n</body>", s, count=1)
if ns==s: 
  print("ERR cannot find </body>"); sys.exit(1)
p.write_text(ns,encoding="utf-8")
print("OK injected")
PY
fi

echo "[4] Quick verify"
ls -la "$WALDIR" | sed -n '1,8p'
grep -n "$MARK" "$IDX" | head -n 2 || true
nginx -t && echo "OK nginx"

echo "DONE"
echo "Test: https://fireinners.online/wallet/  (et bouton WALLET sur /)"
SH
chmod +x /root/FIREINNERS_WALLET_TAB_MEGA2.sh
bash /root/FIREINNERS_WALLET_TAB_MEGA2.sh
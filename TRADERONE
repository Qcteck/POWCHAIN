#!/usr/bin/env bash
set -e

echo "=== STOP anciens process TraderOne ==="
pm2 delete traderone || true
pm2 delete traderone-api || true

echo "=== Vérification Node ==="
node -v
npm -v

echo "=== Vérification vault ==="
cd /opt/traderone-vault

echo "=== Vérification dépendances ==="
npm install --omit=dev

echo "=== Test lancement direct ==="
node server.js &
sleep 2
pkill -f server.js || true

echo "=== Lancement PM2 propre ==="
pm2 delete traderone-vault || true
pm2 start server.js --name traderone-vault
pm2 save

echo "=== STATUS FINAL ==="
pm2 ls

echo "=== TEST API ==="
curl -s http://127.0.0.1:3000/create-vault -X POST -H "Content-Type: application/json" -d '{"pub":"TEST"}' || true

echo "=== OK ==="
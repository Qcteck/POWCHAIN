cat >/root/check_sol_balance_exact.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
RPC="https://fireinners.online/wolverine/rpc"

read -p "Paste Phantom SOL address: " WALLET
[ -n "$WALLET" ] || exit 1

echo "== getBalance =="
curl -sk "$RPC" -H 'content-type: application/json' \
  --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getBalance\",\"params\":[\"$WALLET\"]}" | tee /tmp/bal.json
echo
echo "Lamports value extracted:"
grep -oE '"value":[0-9]+' /tmp/bal.json | head -n1
echo "SOL approx:"
python3 - <<'PY'
import json
j=json.load(open("/tmp/bal.json"))
lam=j["result"]["value"]
print(lam/1e9)
PY
BASH

chmod +x /root/check_sol_balance_exact.sh
/root/check_sol_balance_exact.sh
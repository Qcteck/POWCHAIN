mkdir -p "/root/backup_toggle_$ts"
cp -a components/WalletPhantom.jsx "/root/backup_toggle_$ts/WalletPhantom.jsx.bak" 2>/dev/null || true
cp -a lib/solana.js "/root/backup_toggle_$ts/solana.js.bak" 2>/dev/null || true

cat > lib/solana.js <<EOF
import { Connection, PublicKey } from "@solana/web3.js";

export const MAINNET_RPC = "https://api.mainnet-beta.solana.com";
export const DEVNET_RPC  = "https://api.devnet.solana.com";

export const WOLVERINE_WALLET = new PublicKey("${WOLVERINE_WALLET}");

// mainnet USDC officiel
export const USDC_MAINNET_MINT = new PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v");

// devnet USDC (optionnel)

<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Moteur Quantique Hybride Strict</title>
<style>
body { font-family: Arial, sans-serif; background:#111; color:#eee; padding:20px; }
#log { max-height:180px; overflow-y:scroll; background:#222; padding:10px; border-radius:5px; margin-top:10px; }
.ok { color:#0f0; }
.error { color:#f00; }
canvas { background:#222; display:block; margin:10px 0; border:1px solid #444; }
button { margin:5px; padding:5px 10px; font-size:14px; }
#sumContainer {margin-top:10px;}
</style>
</head>
<body>

<h2>Moteur Quantique Hybride : Doublet / Multi-niveau Strict</h2>
<button id="startBtn">Lancer Test</button>
<button id="boostBtn">BOOST</button>
<select id="modeSelect">
  <option value="doublet">Mode 1 : Doublet propre (tail ~0.1)</option>
  <option value="multi">Mode 2 : Multi-niveau stable (0.2–0.4)</option>
</select>

<div id="sumContainer">
    Σw réel : <span id="msw">0</span> | tail : <span id="tailDisplay">0</span> | Persist : <span id="persistCount">0</span> | STATUT : <span id="statut">OK</span>
</div>

<h3>Graphique E (Gap)</h3>
<canvas id="graphE" width="800" height="200"></canvas>
<h3>Graphique N_c</h3>
<canvas id="graphNc" width="800" height="100"></canvas>
<h3>Graphique H_w</h3>
<canvas id="graphHw" width="800" height="100"></canvas>
<h3>Spectre Gap Strict++</h3>
<canvas id="graphSpectre" width="800" height="100"></canvas>

<h3>Logs :</h3>
<div id="log"></div>

<script>
// Paramètres
const N_cycles = 200;
let persistCount = 0;
let histE=[], histNc=[], histHw=[];

// Canvas
const canvasE = document.getElementById('graphE'); const ctxE = canvasE.getContext('2d');
const canvasNc = document.getElementById('graphNc'); const ctxNc = canvasNc.getContext('2d');
const canvasHw = document.getElementById('graphHw'); const ctxHw = canvasHw.getContext('2d');
const canvasSpec = document.getElementById('graphSpectre'); const ctxSpec = canvasSpec.getContext('2d');

// Mode dynamique
let mode = 'doublet';
document.getElementById('modeSelect').addEventListener('change', e=>{mode=e.target.value;});

// État moteur
let moteur = { E:0.12, N_c:10, H_w:0.5 };

// Canvas util
function drawGraph(ctx,data,color,minY,maxY){
    ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height);
    ctx.beginPath(); ctx.strokeStyle=color;
    const step=ctx.canvas.width/N_cycles;
    data.forEach((v,i)=>{
        const y=ctx.canvas.height-( (v-minY)/(maxY-minY)*ctx.canvas.height );
        if(i===0) ctx.moveTo(0,y); else ctx.lineTo(i*step,y);
    });
    ctx.stroke();
}

function drawSpectre(ctx,state,levels){
    ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height);
    const w=ctx.canvas.width; const h=ctx.canvas.height; const barH=h-10;
    // λ1
    ctx.fillStyle="#0f0"; ctx.fillRect(w*0.25, h-barH, 30, barH);
    // λ2
    ctx.fillStyle="#0ff"; ctx.fillRect(w*0.45, h-barH, 30, barH);
    // λ3 si multi
    if(levels[2]>0){
        ctx.fillStyle="#f90"; ctx.fillRect(w*0.55,h-barH,30,barH);
    }
}

function T(state){state.E += (Math.random()-0.5)*0.02; state.N_c += Math.round((Math.random()-0.5)*1); state.H_w += (Math.random()-0.5)*0.02; return state;}
function detecte_niveau(E,levels){if(E<=levels[0]) return 'λ1'; else if(E<=levels[1]) return 'λ2'; else if(E<=levels[2]) return 'λ3'; else return 'E_mass';}
function corrige_hors_bande(E){if(E<0) return 0; if(E>1) return 1; return E;}
function panneau_verifie_symmetries(){return Math.random()<0.02?false:true;}
function calcGaps(levels){return {g12:levels[0]-levels[1], g23:levels[1]-levels[2]};}
function checkStrict(gaps,threshold){return gaps.g12>=threshold && gaps.g23>=threshold;}
function updatePersist(strict_ok){if(strict_ok) persistCount++; else persistCount=0;}
function logCycle(cycle,state,sym_ok,strict_ok){const div=document.getElementById('log'); const line=document.createElement('div'); line.innerHTML=`Cycle ${cycle} | Niveau <b>${detecte_niveau(state.E,state.levels)}</b> | STATUT: <b>${strict_ok?'STRICT':'VIOLATION'}</b> | Persist: ${persistCount} | Symétries: <span class="${sym_ok?'ok':'error'}">${sym_ok?'OK':'VIOLATION'}</span>`; div.appendChild(line); div.scrollTop=div.scrollHeight;}
function updateSumTail(levels){const lambda1=levels[0], lambda2=levels[1], lambda3=levels[2]; const sum_w=lambda1+lambda2+lambda3; document.getElementById('msw').textContent=sum_w.toFixed(3); document.getElementById('tailDisplay').textContent=(1-(lambda1+lambda2)).toFixed(3); document.getElementById('persistCount').textContent=persistCount; document.getElementById('statut').textContent=(sum_w>=0 && sum_w<=1)?'OK':'VIOLATION';}

// BOOST
document.getElementById('boostBtn').addEventListener('click', ()=>{
    if(mode==='doublet'){moteur.E=0.15;} 
    else {moteur.E=0.25;}
    console.log("BOOST activé : recentrage moteur pour gap émergent");
});

// Lancement
document.getElementById('startBtn').addEventListener('click',()=>{
    let cycle=0;
    let interval=setInterval(()=>{
        if(cycle>=N_cycles){clearInterval(interval); return;}
        moteur=T(moteur); moteur.E=corrige_hors_bande(moteur.E);
        const sym_ok=panneau_verifie_symmetries();

        // Niveaux selon mode
        let levels;
        if(mode==='doublet'){levels=[0.18,0.52,0];} // tail ~0.1
        else{levels=[0.2,0.4,0.6];} // multi-niveau stable

        moteur.levels=levels;
        const gaps=calcGaps(levels);
        const strict_ok=checkStrict(gaps,0.03);
        updatePersist(strict_ok);

        histE.push(moteur.E); histNc.push(moteur.N_c); histHw.push(moteur.H_w);
        logCycle(cycle,moteur,sym_ok,strict_ok);
        updateSumTail(levels);

        drawGraph(ctxE,histE,'#0f0',0,1.1);
        drawGraph(ctxNc,histNc,'#0ff',5,15);
        drawGraph(ctxHw,histHw,'#ff0',0.3,0.7);
        drawSpectre(ctxSpec,moteur,levels);

        cycle++;
    },50);
});
</script>

</body>
</html>

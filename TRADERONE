set -e
cd /root

echo "=== 1) Quels ports Node écoute ? ==="
ss -ltnp | grep node || echo "Aucun port node en écoute"

echo
echo "=== 2) Quels services systemd wolverine/traderone ? ==="
systemctl --no-pager --full status traderone_api.service wolverine_api.service wolverine-tg-sentinel.service 2>/dev/null || true

echo
echo "=== 3) Unit files (ExecStart + Environment) ==="
systemctl cat traderone_api.service 2>/dev/null || true
echo "-----"
systemctl cat wolverine_api.service 2>/dev/null || true

echo
echo "=== 4) Logs récents ==="
journalctl -u traderone_api.service -n 80 --no-pager 2>/dev/null || true
echo "-----"
journalctl -u wolverine_api.service -n 80 --no-pager 2>/dev/null || true
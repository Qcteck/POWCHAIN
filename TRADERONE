@echo off
setlocal EnableExtensions EnableDelayedExpansion
title ROBO600 - Export STL (1:3) - OneShot

REM ====== 0) ROOT AUTO (script peut etre lance de n'importe ou) ======
set "ROOT=%~dp0"
REM si tu as mis le .bat ailleurs, force le dossier ici:
REM set "ROOT=C:\Users\yippykai\ROBO600_PRINTPACK\stl\"

pushd "%ROOT%" >nul 2>&1 || (echo [ERREUR] Impossible d'ouvrir: "%ROOT%" & pause & exit /b 1)

REM ====== 1) FIX EXTENSIONS (Windows cache .txt) ======
for %%F in (*.bat.txt) do ren "%%~nxF" "%%~nF.bat" >nul 2>&1
for %%F in (*.cmd.txt) do ren "%%~nxF" "%%~nF.cmd" >nul 2>&1
for %%F in (*.scad.txt) do ren "%%~nxF" "%%~nF.scad" >nul 2>&1

REM ====== 2) FIND SCAD ======
set "SCAD="
if exist "robo600_parts.scad" set "SCAD=%CD%\robo600_parts.scad"
if not defined SCAD if exist "ROBO600_parts.scad" set "SCAD=%CD%\ROBO600_parts.scad"
if not defined SCAD (
  echo [ERREUR] Fichier SCAD introuvable dans:
  echo "%CD%"
  echo.
  echo Fichiers presents:
  dir /b
  pause
  popd
  exit /b 1
)

REM ====== 3) FIND OPENSCAD CLI ======
set "OPENSCAD="
if exist "C:\Program Files\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD\openscad.com"
if not defined OPENSCAD if exist "C:\Program Files\OpenSCAD (Nightly)\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD (Nightly)\openscad.com"
if not defined OPENSCAD if exist "C:\Program Files (x86)\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files (x86)\OpenSCAD\openscad.com"
if not defined OPENSCAD (
  echo [ERREUR] OpenSCAD CLI introuvable. Installe OpenSCAD puis relance.
  pause
  popd
  exit /b 1
)

REM ====== 4) OUTPUT FOLDER ======
set "OUT=%CD%\out_stl"
if not exist "%OUT%" mkdir "%OUT%" >nul 2>&1

REM ====== 5) SCALE 1:3 + EXPORT ALL STL (PART=all) ======
echo.
echo ==== ROBO600 EXPORT START ====
echo Dossier: %CD%
echo SCAD: %SCAD%
echo OPENSCAD: %OPENSCAD%
echo OUT: %OUT%
echo.

REM -D scale=0.333333 pour 1:3 (si ton SCAD utilise une variable scale)
REM -D PART="all" pour sortir toutes les pieces en 1 STL (si ton SCAD gère all)
REM sinon on sort un seul STL "ROBO600_ALL.stl" (a splitter ensuite dans OpenSCAD si besoin)

"%OPENSCAD%" -o "%OUT%\ROBO600_ALL_1to3.stl" "%SCAD%" -D "SCALE=0.333333" -D "scale=0.333333" -D "PART=\"all\"" -D "PART=\"ALL\"" > "%OUT%\openscad_export.log" 2>&1

if errorlevel 1 (
  echo [ERREUR] Export echoue. Log:
  echo "%OUT%\openscad_export.log"
  echo.
  type "%OUT%\openscad_export.log"
  pause
  popd
  exit /b 1
)

REM ====== 6) DONE ======
echo.
echo OK - STL genere:
dir /b "%OUT%\*.stl"
echo.
echo Log:
echo "%OUT%\openscad_export.log"
echo.
pause
popd
endlocal
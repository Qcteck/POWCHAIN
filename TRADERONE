cat >/root/fix_wolverine_location_generic_move_or_create.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$VHOST" || { echo "Missing $VHOST"; exit 1; }
cp -a "$VHOST" "$VHOST.bak_generic_${TS}"

python3 - <<'PY'
import re

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
lines=open(VHOST,"r",errors="ignore").read().splitlines(True)

# find first server block
start=None
for i,l in enumerate(lines):
    if re.search(r'^\s*server\s*\{', l):
        start=i; break
if start is None:
    raise SystemExit("No server { found")

depth=0
end=None
for i in range(start, len(lines)):
    depth += lines[i].count("{")
    depth -= lines[i].count("}")
    if depth==0 and i>start:
        end=i
        break
if end is None:
    raise SystemExit("Could not find end of first server block (brace mismatch)")

# regex for any /wolverine/ location block (with or without ^~)
loc_re = re.compile(r'^\s*location\s+(\^~\s+)?/wolverine/\s*\{')

# extract ALL such blocks (keep the last), remove them from file
blocks=[]
out=[]
i=0
while i < len(lines):
    l=lines[i]
    if loc_re.search(l):
        b=[l]
        d = l.count("{") - l.count("}")
        i += 1
        while i < len(lines) and d > 0:
            b.append(lines[i])
            d += lines[i].count("{") - lines[i].count("}")
            i += 1
        blocks.append(b)
        continue
    out.append(l)
    i += 1

lines=out

# recompute server range after removal
start=None
for i,l in enumerate(lines):
    if re.search(r'^\s*server\s*\{', l):
        start=i; break
depth=0
end=None
for i in range(start, len(lines)):
    depth += lines[i].count("{")
    depth -= lines[i].count("}")
    if depth==0 and i>start:
        end=i
        break

server = lines[:end]
close  = lines[end:end+1]
rest   = lines[end+1:]

if blocks:
    block = blocks[-1]  # keep last one
else:
    # create it if missing
    block = [
        "\n",
        "  location ^~ /wolverine/ {\n",
        "    alias /var/www/wolverine/;\n",
        "    try_files $uri $uri/ /wolverine/index.html;\n",
        "  }\n",
        "\n"
    ]

# insert inside server (before closing brace)
server.append("\n")
server.extend(block)
server.append("\n")

open(VHOST,"w").writelines(server + close + rest)
PY

echo "== nginx -t =="
nginx -t
echo "== reload =="
systemctl reload nginx || service nginx reload

echo "== quick check =="
curl -sk -o /dev/null -w "UI /wolverine/ : %{http_code}\n" https://fireinners.online/wolverine/
BASH


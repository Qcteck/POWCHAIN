setup_secrets(){
  say "== secrets (encrypted key) =="

  # master key (hex) stored root-only
  if [[ ! -f "${ETC_DIR}/master.key" ]]; then
    rand_hex > "${ETC_DIR}/master.key"
    chmod 600 "${ETC_DIR}/master.key"
  fi

  # if encrypted key already exists, keep it
  if [[ -f "${VAULT_DIR}/personal.key.enc" ]]; then
    chmod 600 "${VAULT_DIR}/personal.key.enc"
    say "encrypted key already present: ${VAULT_DIR}/personal.key.enc"
    return
  fi

  say "Paste ta SECRET KEY Solana en base58 (64 bytes)."
  say "Ex: contenu de id.json converti en base58 (secretKey)."
  read -r -s -p "SECRET_KEY_B58: " SECRET_KEY_B58
  echo
  [[ -n "${SECRET_KEY_B58}" ]] || die "SECRET_KEY_B58 vide."

  MASTER_HEX="$(cat "${ETC_DIR}/master.key")"

  # AES-256-GCM: iv(12)+tag(16)+ct -> base64
  python3 - <<PY
import base64, os, sys, hashlib
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

master_hex = open("${ETC_DIR}/master.key","r").read().strip()
key = hashlib.sha256(bytes.fromhex(master_hex)).digest()

secret_b58 = """${SECRET_KEY_B58}""".strip().encode()
# plaintext = base58 secretKey (string)
pt = secret_b58

iv = os.urandom(12)
aes = AESGCM(key)
ct = aes.encrypt(iv, pt, None)  # returns ciphertext+tag at end
# split tag
ciphertext, tag = ct[:-16], ct[-16:]
blob = iv + tag + ciphertext
open("${VAULT_DIR}/personal.key.enc","wb").write(base64.b64encode(blob))
PY

  chmod 600 "${VAULT_DIR}/personal.key.enc"
  say "OK: clé privée stockée chiffrée -> ${VAULT_DIR}/personal.key.enc"
}


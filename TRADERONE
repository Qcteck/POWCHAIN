cat >/root/TRADERONE_MEGA_FIX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== TRADERONE MEGA FIX (DIRECT NODE, NO NGINX) ==="

# 0) Variables figées
APP_DIR="/opt/traderone"
DATA_DIR="/opt/traderone/data"
LOG_DIR="/opt/traderone/logs"
PORT="3000"

# 1) Stop / disable nginx si présent (sans erreur)
systemctl stop nginx 2>/dev/null || true
systemctl disable nginx 2>/dev/null || true
echo "[OK] nginx ignoré"

# 2) Node.js 20 (safe)
if ! command -v node >/dev/null 2>&1; then
  echo "[INFO] Installing Node.js 20"
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt-get install -y nodejs
fi

# 3) PM2
if ! command -v pm2 >/dev/null 2>&1; then
  npm install -g pm2
fi

# 4) Dossiers
mkdir -p "$APP_DIR" "$DATA_DIR" "$LOG_DIR"

# 5) ENV
cat >"$APP_DIR/.env" <<EOF
NODE_ENV=production
PORT=$PORT
DATA_DIR=$DATA_DIR
LOG_DIR=$LOG_DIR
EOF
echo "[OK] env written"

# 6) SERVER.JS (API + HTML SAFE)
cat >"$APP_DIR/server.js" <<'EOF'
import http from "http";
import url from "url";

const PORT = process.env.PORT || 3000;

const server = http.createServer(async (req, res) => {
  const { pathname } = url.parse(req.url, true);

  if (req.method === "GET" && pathname === "/health") {
    res.writeHead(200, {"Content-Type":"application/json"});
    return res.end(JSON.stringify({ok:true, service:"TraderOne"}));
  }

  if (req.method === "GET" && pathname === "/status") {
    res.writeHead(200, {"Content-Type":"application/json"});
    return res.end(JSON.stringify({status:"idle", pid:process.pid}));
  }

  if (req.method === "POST" && pathname === "/start") {
    let body="";
    req.on("data", c => body+=c);
    req.on("end", () => {
      res.writeHead(200, {"Content-Type":"application/json"});
      res.end(JSON.stringify({
        started:true,
        input: body ? JSON.parse(body) : {},
        time: Date.now()
      }));
    });
    return;
  }

  // UI simple (HTML envoyé par Node, PAS bash)
  res.writeHead(200, {"Content-Type":"text/html"});
  res.end(`<!DOCTYPE html>
<html>
<body style="background:#111;color:#eee;font-family:Arial">
<h1>AMCQ Pilot</h1>
<button onclick="go()">START</button>
<pre id="out"></pre>
<script>
async function go(){
  const r=await fetch('/start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({count:3,context:'BTC'})});
  document.getElementById('out').textContent=JSON.stringify(await r.json(),null,2);
}
</script>
</body>
</html>`);
});

server.listen(PORT,"0.0.0.0",()=>{
  console.log("TraderOne LIVE on",PORT);
});
EOF

# 7) PM2 clean start
pm2 delete traderone 2>/dev/null || true
pm2 start "$APP_DIR/server.js" --name traderone
pm2 save

# 8) Firewall (si actif)
command -v ufw >/dev/null 2>&1 && ufw allow ${PORT}/tcp || true

# 9) Test local
sleep 2
curl -fsS http://127.0.0.1:${PORT}/health || true

echo "=== TRADERONE RUNNING ==="
pm2 status
SH

chmod +x /root/TRADERONE_MEGA_FIX.sh
/root/TRADERONE_MEGA_FIX.sh
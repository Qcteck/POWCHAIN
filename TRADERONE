cat >/tmp/FIX_DUP_WOLVERINE_LOCATION.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"

LINK="/etc/nginx/sites-enabled/fireinners.online-ssl"
VHOST="$(readlink -f "$LINK" 2>/dev/null || echo "$LINK")"

SNIP="/etc/nginx/snippets/fireinners-wolverine.conf"
FRONT="/var/www/fireinners/wolverine"

echo "=== 0) Backups ==="
mkdir -p /root/backup_wolverine_fix_"$T"
[ -f "$SNIP" ] && cp -a "$SNIP" "/root/backup_wolverine_fix_${T}/fireinners-wolverine.conf.bak" || true
[ -f "$VHOST" ] && cp -a "$VHOST" "/root/backup_wolverine_fix_${T}/vhost.bak" || true

echo "=== 1) Rewrite snippet with ONE /wolverine/ location (clean) ==="
cat >"$SNIP" <<'EOF'
# FIREINNERS_WOLVERINE_SNIP_V1  (single-source of truth)

# --- FRONT (ONE) ---
location ^~ /wolverine/ {
  add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
  add_header Pragma "no-cache" always;
  add_header Expires "0" always;

  alias /var/www/fireinners/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}

# --- UNIFIED API (ONE) : /wolverine/api/* -> TraderOne /api/* ---
location ^~ /wolverine/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:8585/api/;
}

# --- TRADERONE (UI + native api + ws) ---
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:8585/api/;
}

location ^~ /wolverine/traderone/ws {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:8585/ws;
}

location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:8585/;
}
EOF

echo "=== 2) Ensure vhost includes snippet ONCE (remove duplicates) ==="
python3 - <<PY
import re
p="${VHOST}"
s=open(p,"r",encoding="utf-8",errors="ignore").read()

# remove any existing includes of this snippet (all occurrences)
s=re.sub(r'^\s*include\s+/etc/nginx/snippets/fireinners-wolverine\.conf;.*\n','',s,flags=re.M)
s=re.sub(r'^\s*include\s+/etc/nginx/snippets/wolverine_unified\.conf;.*\n','',s,flags=re.M)
s=re.sub(r'^\s*include\s+/etc/nginx/snippets/wolverine_.*\.conf;.*\n','',s,flags=re.M)

inc='    include /etc/nginx/snippets/fireinners-wolverine.conf; # FIREINNERS_WOLVERINE_INCLUDE\n'
m=re.search(r'^\s*server\s*\{\s*$', s, flags=re.M)
if not m:
    raise SystemExit("ERROR: can't find 'server {' in vhost: "+p)

s = s[:m.end()] + "\n" + inc + s[m.end():]
open(p,"w",encoding="utf-8").write(s)
print("OK: include ensured once in", p)
PY

echo "=== 3) nginx test + reload ==="
nginx -t
systemctl reload nginx

echo "=== 4) Quick tests ==="
echo "--- /wolverine/ ---"
curl -ksS --max-time 8 https://fireinners.online/wolverine/ | head -n 6
echo
echo "--- /wolverine/api/health ---"
curl -ksS --max-time 8 https://fireinners.online/wolverine/api/health | head -c 200; echo
SH

bash /tmp/FIX_DUP_WOLVERINE_LOCATION.sh
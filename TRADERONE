#!/usr/bin/env bash
# MEGA_BATCH_FIX_FIREINNERS_ROOT.sh
set -euo pipefail

echo "=== MEGA BATCH ROOT – FIREINNERS / WOLVERINE ==="

DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ENABLED="/etc/nginx/sites-enabled"
CERT="/etc/letsencrypt/live/${DOMAIN}/fullchain.pem"
KEY="/etc/letsencrypt/live/${DOMAIN}/privkey.pem"
ROOT_FRONT="/opt/fireinners/frontend-react/app/dist"
BACKUP="/root/nginx_backup_$(date +%Y%m%d_%H%M%S)"

# --- ROOT CHECK ---
[ "$EUID" -eq 0 ] || { echo "MUST BE ROOT"; exit 1; }

# --- BACKUP ---
mkdir -p "$BACKUP"
cp -a /etc/nginx "$BACKUP/"
echo "Backup: $BACKUP"

# --- STOP EVERYTHING ---
systemctl stop nginx || true

# --- HARD CLEAN CONFLICTS ---
rm -f ${ENABLED}/*
rm -f /etc/nginx/conf.d/*
rm -f /etc/nginx/sites-enabled/*

# --- SSL CHECK ---
if [ ! -f "$CERT" ] || [ ! -f "$KEY" ]; then
  certbot certonly --nginx -d "$DOMAIN" -d "www.$DOMAIN" \
    --non-interactive --agree-tos -m admin@"$DOMAIN"
fi

# --- REWRITE SINGLE VHOST (NO DUPLICATE POSSIBLE) ---
cat > "$VHOST" <<EOF
server {
  listen 443 ssl http2;
  server_name ${DOMAIN} www.${DOMAIN};

  ssl_certificate     ${CERT};
  ssl_certificate_key ${KEY};
  ssl_protocols TLSv1.2 TLSv1.3;

  root ${ROOT_FRONT};
  index index.html;

  location / {
    try_files \$uri \$uri/ /index.html;
  }

  location /wolverine/ {
    try_files \$uri \$uri/ /wolverine/index.html;
  }

  location /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade \$http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host \$host;
  }
}
EOF

# --- ENABLE SINGLE VHOST ---
ln -sf "$VHOST" "${ENABLED}/fireinners.online-ssl"

# --- FINAL TEST ---
nginx -t

# --- FORCE ENABLE + START ---
systemctl unmask nginx || true
systemctl enable nginx
systemctl start nginx

# --- STATUS ---
systemctl status nginx --no-pager

echo "=== DONE ==="
echo "OPEN : https://fireinners.online/wolverine/"
set -e
cd /root

BLOCK=$(cat <<'EOF'
location ^~ /wolverine/traderone/api/ {
  proxy_pass http://127.0.0.1:3000/api/;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF
)

echo "=== 1) Backup vhosts (hors sites-enabled) ==="
mkdir -p /root/nginx_backups
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  cp -v "$f" "/root/nginx_backups/$(basename "$f").$(date +%Y%m%d_%H%M%S)"
done

echo
echo "=== 2) Nettoyer TOUS les locations /wolverine/traderone/api/ puis réinsérer 1 seul bloc propre ==="
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  echo "PATCH $f"
  perl -0777 -i -pe '
    s#location\s+(?:\^~\s+|~\*?\s+|=\s+)?/wolverine/traderone/api/\s*\{.*?\}\s*##sg;
    s#(server\s*\{)#$1\n\n'"$BLOCK"'\n#s;
  ' "$f"
done

echo
echo "=== 3) nginx -t + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 4) Test LOCAL via nginx (doit renvoyer running/bal/etc, PAS -32601) ==="
curl -sS -i -X POST -H "Host: fireinners.online" -H "content-type: application/json" \
  http://127.0.0.1/wolverine/traderone/api/status --data '{}' | head -n 80

echo
echo "=== 5) Test DIRECT backend (référence) ==="
curl -sS -i -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' | head -n 40
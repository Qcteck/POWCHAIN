cat >/root/MEGA_WOLVERINE_RPC_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/MEGA_WOLVERINE_RPC_FIX_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

HOST="fireinners.online"
HTML="/var/www/wolverine/index.html"
INC="/etc/nginx/includes/wolverine_routes.inc"

# DRPC (fourni)
DRPC_HTTP="https://lb.drpc.live/solana/AsxThpeKkEjGtZhCNUEQYo1ZluSgmwsR76RdFhW5UfFk"

# RPC proxy local (CORS-safe via same origin)
RPC_PORT="12703"
RPC_DIR="/opt/fireinners/solrpc-proxy-wolverine"
RPC_JS="${RPC_DIR}/server.js"
RPC_SVC="/etc/systemd/system/wolverine-solrpc-proxy.service"

say(){ echo -e "\n== $* =="; }

say "0) Preconditions"
id | sed -n '1,1p'
command -v node >/dev/null 2>&1 || { echo "ERROR: node not found (/usr/bin/node)"; exit 1; }
test -f "$HTML" || { echo "ERROR: missing $HTML"; exit 1; }
test -f "$INC" || { echo "ERROR: missing $INC"; exit 1; }

say "1) Backup current Wolverine index.html"
BKDIR="/root/wolverine_backups"
mkdir -p "$BKDIR"
cp -a "$HTML" "$BKDIR/index.html.bak_${TS}"

say "2) Install local Solana RPC proxy (node, no deps) on 127.0.0.1:${RPC_PORT}"
mkdir -p "$RPC_DIR"
cat >"$RPC_JS" <<'JS'
'use strict';
const http = require('http');
const https = require('https');
const { URL } = require('url');

const LISTEN_HOST = process.env.LISTEN_HOST || '127.0.0.1';
const LISTEN_PORT = parseInt(process.env.LISTEN_PORT || '12703', 10);
const UPSTREAM = process.env.DRPC_HTTP || '';
if (!UPSTREAM) { console.error('Missing DRPC_HTTP'); process.exit(1); }

const u = new URL(UPSTREAM);
if (u.protocol !== 'https:') { console.error('DRPC_HTTP must be https'); process.exit(1); }

function send(res, code, body, headers={}) {
  res.writeHead(code, Object.assign({
    'Content-Type': 'application/json; charset=utf-8',
    'Cache-Control': 'no-store',
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'POST, GET, OPTIONS',
    'Access-Control-Allow-Headers': 'content-type, authorization'
  }, headers));
  res.end(body);
}

function proxy(req, res, rawBody) {
  const opts = {
    protocol: 'https:',
    hostname: u.hostname,
    port: 443,
    path: u.pathname + (u.search || ''),
    method: req.method,
    headers: {
      'Content-Type': req.headers['content-type'] || 'application/json',
      'Accept': req.headers['accept'] || 'application/json',
      'User-Agent': 'wolverine-solrpc-proxy/1.0',
      'Content-Length': Buffer.byteLength(rawBody || '')
    },
    timeout: 15000
  };

  const upstreamReq = https.request(opts, (upstreamRes) => {
    let data = '';
    upstreamRes.setEncoding('utf8');
    upstreamRes.on('data', (c) => data += c);
    upstreamRes.on('end', () => {
      send(res, upstreamRes.statusCode || 502, data || '{}', {
        'Content-Type': upstreamRes.headers['content-type'] || 'application/json; charset=utf-8'
      });
    });
  });

  upstreamReq.on('timeout', () => upstreamReq.destroy(new Error('upstream timeout')));
  upstreamReq.on('error', (e) => send(res, 502, JSON.stringify({error:String(e && e.message ? e.message : e)})));
  if (rawBody && rawBody.length) upstreamReq.write(rawBody);
  upstreamReq.end();
}

const server = http.createServer((req, res) => {
  if (req.method === 'OPTIONS') return send(res, 204, '');
  if (req.method === 'GET') {
    // simple health passthrough
    const body = JSON.stringify({"jsonrpc":"2.0","id":1,"method":"getHealth"});
    return proxy({ method:'POST', headers:{'content-type':'application/json'} }, res, body);
  }
  if (req.method !== 'POST') return send(res, 405, JSON.stringify({error:'method_not_allowed'}));
  let body = '';
  req.setEncoding('utf8');
  req.on('data', (c) => { body += c; if (body.length > 2_000_000) req.destroy(); });
  req.on('end', () => proxy(req, res, body));
});

server.listen(LISTEN_PORT, LISTEN_HOST, () => {
  console.log(`WOLVERINE_SOLRPC_PROXY listening on http://${LISTEN_HOST}:${LISTEN_PORT} -> ${UPSTREAM}`);
});
JS

cat >"$RPC_SVC" <<EOF
[Unit]
Description=Wolverine Solana RPC Proxy (DRPC passthrough)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=${RPC_DIR}
Environment=LISTEN_HOST=127.0.0.1
Environment=LISTEN_PORT=${RPC_PORT}
Environment=DRPC_HTTP=${DRPC_HTTP}
ExecStart=/usr/bin/node ${RPC_JS}
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now wolverine-solrpc-proxy.service
systemctl --no-pager -l status wolverine-solrpc-proxy.service | sed -n '1,18p'

say "3) Wire nginx route /wolverine/solana-rpc -> 127.0.0.1:${RPC_PORT} (edit include only)"
if ! grep -q "wolverine/solana-rpc" "$INC"; then
  cp -a "$INC" "$BKDIR/wolverine_routes.inc.bak_${TS}"
  cat >>"$INC" <<EOF

  # Solana RPC proxy (CORS-safe)
  location /wolverine/solana-rpc {
    proxy_pass http://127.0.0.1:${RPC_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    add_header Cache-Control "no-store" always;
  }
EOF
fi

say "4) Patch Wolverine UI to use same-origin RPC endpoint (fix 'RPC error')"
python3 - <<'PY'
from pathlib import Path
import re, time

p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")

orig = s

# 1) Replace any DRPC direct endpoints with same-origin proxy
s = re.sub(r'https://lb\.drpc\.live/solana/[A-Za-z0-9_\-]+', '/wolverine/solana-rpc', s)
s = re.sub(r'wss://lb\.drpc\.live/solana/[A-Za-z0-9_\-]+', 'wss://'+re.sub(r'^https?://','', 'fireinners.online')+'/wolverine/solana-rpc', s)

# 2) If there's an explicit RPC constant, force it
patterns = [
  (r'(RPC_HTTP\s*=\s*")[^"]*(")', r'\1/wolverine/solana-rpc\2'),
  (r'(RPC\s*=\s*")[^"]*(")', r'\1/wolverine/solana-rpc\2'),
  (r'(rpcHttp\s*:\s*")[^"]*(")', r'\1/wolverine/solana-rpc\2'),
  (r'(endpoint\s*:\s*")[^"]*(")', r'\1/wolverine/solana-rpc\2'),
]
for pat, rep in patterns:
  s = re.sub(pat, rep, s)

if s != orig:
  p.write_text(s)
  print("OK: index.html patched")
else:
  print("NOTE: no detectable endpoint string to replace (UI may already be proxy-based).")
PY


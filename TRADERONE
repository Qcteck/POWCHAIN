<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Assistant Multi-Source</title>
</head>
<body>
<h2>Assistant Auto-apprenant Multi-Source</h2>
<div id="log" style="height:300px;overflow-y:scroll;border:1px solid #ccc;padding:10px;"></div>

<input type="text" id="userInput" placeholder="Écris ton savoir ici..."/>
<button onclick="userSend()">Envoyer</button>
<button onclick="readMemory()">Lire la mémoire</button>

<script>
const log = document.getElementById('log');
let memory = JSON.parse(localStorage.getItem('knowledge') || '[]');

// Affichage log
function appendLog(msg) {
    log.innerHTML += msg + '<br>';
    log.scrollTop = log.scrollHeight;
}

// VarA : écoute et apprend
const varA = {
    listenAndLearn: function(text){
        memory.push(text);
        localStorage.setItem('knowledge', JSON.stringify(memory));
        appendLog("VarA a appris: " + text);
        return text;
    }
};

// VarB : communique le savoir
const varB = {
    speakKnowledge: function(text){
        appendLog("VarB dit: " + text);
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'fr-FR';
        speechSynthesis.speak(utterance);
    }
};

// Utilisateur : transmet son savoir
function userSend(){
    const input = document.getElementById('userInput').value.trim();
    if(!input) return;
    appendLog("Utilisateur transmet: " + input);
    memory.push(input);
    localStorage.setItem('knowledge', JSON.stringify(memory));
    varB.speakKnowledge(input);
    document.getElementById('userInput').value = '';
}

// Écoute continue du micro
if('webkitSpeechRecognition' in window){
    const recognition = new webkitSpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = false;
    recognition.lang = 'fr-FR';

    recognition.onresult = function(event){
        for(let i=event.resultIndex; i<event.results.length; i++){
            if(event.results[i].isFinal){
                const text = event.results[i][0].transcript.trim();
                const knowledge = varA.listenAndLearn(text);
                varB.speakKnowledge(knowledge);
            }
        }
    };
    recognition.onerror = e => console.error(e.error);
    recognition.start();
    appendLog("🟢 Écoute en cours...");
} else {
    appendLog("❌ Navigateur non compatible reconnaissance vocale.");
}

// Lecture de la mémoire complète
function readMemory(){
    appendLog("📚 Mémoire: " + memory.join(" | "));
}
</script>
</body>
</html>

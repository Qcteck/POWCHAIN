set -e
cd /root

echo "=== 1) nginx -t (récupérer fichier:ligne) ==="
ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 40

LINE="$(echo "$ERR" | sed -n 's/.*map" directive in \/etc\/nginx\/nginx\.conf:\([0-9]\+\).*/\1/p' | head -n 1)"
echo "LINE=$LINE"

echo
echo "=== 2) Afficher le contexte autour de la ligne ==="
nl -ba /etc/nginx/nginx.conf | sed -n "$((LINE-30)),$((LINE+30))p" || true

echo
echo "=== 3) Supprimer le bloc map (de 'map ... {' jusqu'à la prochaine ligne avec '}') ==="
cp -v /etc/nginx/nginx.conf "/root/nginx_backups/nginx.conf.$(date +%Y%m%d_%H%M%S)"
sed -i '/^[[:space:]]*map[[:space:]].*{[[:space:]]*$/,/^[[:space:]]*}[[:space:]]*$/d' /etc/nginx/nginx.conf

echo
echo "=== 4) Re-test + reload ==="
nginx -t
systemctl reload nginx
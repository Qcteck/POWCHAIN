set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

SNIP="/etc/nginx/snippets/wolverine_auth_phantom.conf"
mkdir -p /etc/nginx/snippets

# 1) Snippet (bypass + proxy)
cat > "$SNIP" <<'NGX'
location ^~ /wolverine/traderone/api/auth/ {
  auth_basic off;
  satisfy any;
  allow all;

  proxy_pass http://127.0.0.1:3005/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
NGX

echo "=== 1) Candidats 443 pour fireinners.online (vrais fichiers, pas le texte nginx -T) ==="
mapfile -t CAND < <(nginx -T 2>/dev/null | awk '
  /^# configuration file /{f=$4}
  /server_name[[:space:]]+.*(fireinners\.online|www\.fireinners\.online)/{print f}
' | sort -u)

# filtre fichiers existants + qui ont listen 443
REAL=()
for f in "${CAND[@]}"; do
  [ -f "$f" ] || continue
  grep -qE 'listen[[:space:]]+443' "$f" || continue
  REAL+=("$f")
done

if [ "${#REAL[@]}" -eq 0 ]; then
  echo "❌ Aucun fichier 443 trouvé pour fireinners.online"
  exit 1
fi

i=0
for f in "${REAL[@]}"; do
  i=$((i+1))
  echo "[$i] $f"
done

echo
read -r -p "Quel fichier tu veux GARDER ? (ex: 1) : " KEEPIDX
KEEPIDX="${KEEPIDX:-1}"

KEEP="${REAL[$((KEEPIDX-1))]}"
echo "✅ KEEP = $KEEP"

echo
echo "=== 2) Désactive les autres (backup + change server_name) ==="
n=0
for f in "${REAL[@]}"; do
  [ "$f" = "$KEEP" ] && continue
  n=$((n+1))
  cp -a "$f" "$f.bak.disabled.$TS"
  sed -i -E \
    -e "s/server_name[[:space:]]+.*(fireinners\.online|www\.fireinners\.online)[^;]*;/server_name _disabled_fireinners_${TS}_${n}.local;/g" \
    "$f"
  echo "Disabled: $f"
done

echo
echo "=== 3) Inject le snippet dans KEEP (backup) ==="
if ! grep -q "snippets/wolverine_auth_phantom.conf" "$KEEP"; then
  cp -a "$KEEP" "$KEEP.bak.snip.$TS"
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/wolverine_auth_phantom.conf;/' "$KEEP"
  echo "Injected include into KEEP"
else
  echo "KEEP already includes snippet"
fi

echo
echo "=== 4) Reload + tests ORIGIN (bypass Cloudflare) ==="
nginx -t
systemctl reload nginx

echo "--- origin health ---"
curl -sk --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | head -c 220; echo

echo "--- origin challenge ---"
curl -sk --resolve fireinners.online:443:127.0.0.1 \
  "https://fireinners.online/wolverine/traderone/api/auth/phantom/challenge?pubkey=11111111111111111111111111111111" | head -c 260; echo

echo
echo "=== 5) Check conflicts ==="
nginx -T 2>/dev/null | grep -i "conflicting server name" | head -n 20 || echo "✅ no more conflicts"
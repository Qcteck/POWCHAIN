cat >/root/nginx_fix_stub_clean.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SERVER_FILE="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP_DIR="/etc/nginx/snippets"
SNIP="$SNIP_DIR/wolverine_traderone_stub_locations.conf"

[[ -f "$SERVER_FILE" ]] || { echo "[ERR] introuvable: $SERVER_FILE"; exit 1; }

mkdir -p "$SNIP_DIR"

# 1) snippet (les stubs)
cat >"$SNIP" <<'NGINX'
# TraderOne API stubs (prevent UI crash)
location = /wolverine/traderone/api/me {
  default_type application/json;
  return 200 '{"ok":true,"me":{"id":"guest","wallet":null}}';
}
location = /wolverine/traderone/api/positions {
  default_type application/json;
  return 200 '{"ok":true,"positions":[]}';
}
location = /wolverine/traderone/api/orders {
  default_type application/json;
  return 200 '{"ok":true,"orders":[]}';
}
location = /wolverine/traderone/api/pnl {
  default_type application/json;
  return 200 '{"ok":true,"pnl":{"total":0,"daily":0}}';
}
NGINX

# 2) backup du vhost
ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$SERVER_FILE" "${SERVER_FILE}.bak_${ts}"
echo "[OK] Backup -> ${SERVER_FILE}.bak_${ts}"

# 3) supprimer anciens includes cassés liés à ce snippet
# (ligne include qui contient wolverine_traderone_stub_locations)
sed -i '/include .*wolverine_traderone_stub_locations\.conf.*/d' "$SERVER_FILE"

# 4) injecter include propre juste après server_name fireinners.online (idempotent)
if ! grep -qF "include $SNIP;" "$SERVER_FILE"; then
  perl -i -pe '
    if(!$done && /server_name\s+.*\bfireinners\.online\b.*;/){
      print "  include '"$SNIP"';\n";
      $done=1;
    }
  ' "$SERVER_FILE"
fi

nginx -t
systemctl reload nginx

echo "[OK] nginx reloaded"
echo "Tests:"
echo "  curl -s https://fireinners.online/wolverine/traderone/api/me"
echo "  curl -s https://fireinners.online/wolverine/traderone/api/orders"
BASH

chmod +x /root/nginx_fix_stub_clean.sh
/root/nginx_fix_stub_clean.sh
cat >/root/MEGA_WOLVERINE_FIX_SOLANAWEB3.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/MEGA_WOLVERINE_FIX_SOLANAWEB3_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

say(){ echo; echo "================================================================"; echo "$*"; echo "================================================================"; }

HTML="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor"
WEB3_MIN="${VENDOR}/solana-web3.min.js"
WEB3_URL="https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js"

say "0) Savepoint (if present)"
if [[ -x /root/WOLVERINE_SAVEPOINT.sh ]]; then
  /root/WOLVERINE_SAVEPOINT.sh || true
else
  echo "No /root/WOLVERINE_SAVEPOINT.sh (skip)"
fi

say "1) Preconditions"
test -f "$HTML" || { echo "MISSING: $HTML"; exit 1; }
mkdir -p "$VENDOR"
echo "HTML: $HTML"
echo "VENDOR: $VENDOR"

say "2) Ensure solana-web3 is present locally (window.solanaWeb3)"
if [[ -s "$WEB3_MIN" ]]; then
  echo "OK: already present -> $WEB3_MIN ($(wc -c <"$WEB3_MIN") bytes)"
else
  echo "Downloading: $WEB3_URL -> $WEB3_MIN"
  curl -fsSL "$WEB3_URL" -o "$WEB3_MIN"
  test -s "$WEB3_MIN" || { echo "Download failed: $WEB3_MIN"; exit 1; }
  echo "OK: downloaded -> $WEB3_MIN ($(wc -c <"$WEB3_MIN") bytes)"
fi

say "3) Backup current index.html"
BKDIR="/root/wolverine_backups"
mkdir -p "$BKDIR"
cp -a "$HTML" "$BKDIR/index.html.bak_${TS}"
echo "Backup: $BKDIR/index.html.bak_${TS}"

say "4) Patch index.html to load /wolverine/vendor/solana-web3.min.js BEFORE any app script"
python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

tag='<script src="/wolverine/vendor/solana-web3.min.js"></script>'

# Remove any wrong/duplicate solana web3 tags (best-effort)
import re
s=re.sub(r'<script[^>]+solana[^>]*web3[^>]*></script>\s*','',s,flags=re.I)

# Insert into <head> as the FIRST script (or create head if missing)
if "<head" in s.lower():
    # inject right after <head...>
    def repl(m):
        return m.group(0) + tag
    s=re.sub(r'(<head[^>]*>)', repl, s, count=1, flags=re.I)
else:
    # extremely defensive: wrap minimal head
    s='<!doctype html><html><head>'+tag+'</head><body>'+s+'</body></html>'

# Hard guard: if page uses solanaWeb3 but it isn't loaded, show explicit log
guard = r"""
<script>
(function(){
  try{
    if(!window.solanaWeb3){ console.warn("solanaWeb3 missing: /wolverine/vendor/solana-web3.min.js not loaded"); }
  }catch(e){}
})();
</script>
""".strip()

# Put guard immediately after web3 tag (once)
if guard not in s:
    s=s.replace(tag, tag+guard, 1)

p.write_text(s)
print("OK: index.html patched (web3 tag inserted + guard)")
PY

say "5) Quick static checks"
echo "--- grep solana-web3 in index.html ---"
grep -n "solana-web3.min.js" "$HTML" || true
echo "--- verify vendor file header ---"
head -n 3 "$WEB3_MIN" || true

say "6) Nginx quick test + reload (no config edits)"
nginx -t
systemctl reload nginx || systemctl reload nginx.service || true

say "7) Live HTTP checks (origin paths)"
echo "--- /wolverine/vendor/solana-web3.min.js (HTTP head) ---"
curl -sS -I "https://fireinners.online/wolverine/vendor/solana-web3.min.js" | sed -n '1,12p' || true
echo "--- /wolverine/ (HTTP head) ---"
curl -sS -I "https://fireinners.online/wolverine/" | sed -n '1,12p' || true

say "DONE"
echo "LOG: $LOG"
echo "Backup: $BKDIR/index.html.bak_${TS}"
echo "Open: https://fireinners.online/wolverine/  (Ctrl+F5 hard refresh)"
BASH

bash /root/MEGA_WOLVERINE_FIX_SOLANAWEB3.sh
set -euo pipefail

DOMAIN="fireinners.online"
TEST="/var/www/fireinners-test"
ULT="$TEST/ultimate"
mkdir -p "$ULT"

echo "=== 1) Test nginx ==="
nginx -t
systemctl reload nginx

echo "=== 2) Trouver le dernier backup (tes 305 images) ==="
BACK="$(ls -dt /var/www/fireinners-test-backup-* 2>/dev/null | head -n 1 || true)"
echo "BACK=$BACK"
[ -n "$BACK" ] || { echo "❌ Pas de backup trouvé"; exit 1; }

echo "=== 3) Générer le BLEND 4K (median) ==="
apt-get update -y
apt-get install -y imagemagick

TMP="/tmp/blend_work"
rm -rf "$TMP"; mkdir -p "$TMP"

i=0
while IFS= read -r f; do
  i=$((i+1))
  printf -v out "$TMP/img_%04d.png" "$i"
  convert "$f" -auto-orient -resize 3840x2160^ -gravity center -extent 3840x2160 "$out"
done < <(find "$BACK" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) -print | sort)

echo "frames: $i"
[ "$i" -gt 0 ] || { echo "❌ 0 image à fusionner"; exit 1; }

convert "$TMP"/img_*.png -evaluate-sequence median "$ULT/blend_305_4k.png"
rm -rf "$TMP"

cat > "$ULT/index.html" <<'HTML'
<!doctype html><meta charset="utf-8">
<title>ultimate</title>
<a href="blend_305_4k.png">blend_305_4k.png</a>
<br><img src="blend_305_4k.png" style="max-width:100%;height:auto">
HTML

chown -R www-data:www-data "$ULT" || true
chmod -R a+rX "$ULT" || true

echo "=== 4) Test comme l'extérieur ==="
curl -I https://127.0.0.1/test/ultimate/blend_305_4k.png --insecure -H "Host: $DOMAIN" | head -n 20 || true

echo "✅ Ouvre:"
echo "https://fireinners.online/test/ultimate/blend_305_4k.png"
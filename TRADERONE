cat >/root/fix_buffer_download_fallback.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DIR="/var/www/wolverine"
OUT="$DIR/buffer.min.js"

mkdir -p "$DIR"

echo "== Download buffer from fallback CDNs =="
urls=(
  "https://cdn.jsdelivr.net/npm/buffer@6.0.3/index.min.js"
  "https://unpkg.com/buffer@6.0.3/index.min.js"
  "https://cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js"
)

ok=0
for u in "${urls[@]}"; do
  echo "TRY: $u"
  if curl -fsSL "$u" -o "$OUT"; then
    ok=1
    echo "OK: downloaded from $u"
    break
  else
    echo "FAIL"
  fi
done

[ "$ok" -eq 1 ] || { echo "❌ Could not download buffer from any CDN"; exit 1; }

chmod 0644 "$OUT"
ls -lah "$OUT"
head -c 60 "$OUT" && echo
echo

echo "== ORIGIN test (bypass CF) file should be 200 =="
curl -sk --resolve fireinners.online:443:127.0.0.1 -I "https://fireinners.online/wolverine/buffer.min.js" | sed -n '1,20p'
echo "DONE ✅"
BASH

chmod +x /root/fix_buffer_download_fallback.sh
/root/fix_buffer_download_fallback.sh
cat >/tmp/WOLVERINE_TG_SENTINEL.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== WOLVERINE TG SENTINEL ==="
date;hostname;whoami;pwd

ASK="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASK" ]; then
  # shellcheck disable=SC1090
  source "$ASK"
else
  askorupdate_file(){ local p="$1";mkdir -p "$(dirname "$p")";cp -a "$p" "$p.bak.$(date +%s)" 2>/dev/null||true;cat >"$p"; }
fi

DIR="/opt/fireinners/wolverine-telegram"
ENV="$DIR/telegram.env"
LOOP="$DIR/sentinel.sh"
SVC="/etc/systemd/system/wolverine-tg-sentinel.service"

[ -f "$ENV" ] || { echo "Missing $ENV"; exit 1; }
[ -x /usr/local/bin/wolv_send ] || { echo "Missing wolv_send"; exit 1; }

cat >/tmp/_loop <<'LOOP'
#!/usr/bin/env bash
set -euo pipefail
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
# shellcheck disable=SC1090
source "$ENV"

PING_URL="https://fireinners.online/wolverine/api/ping"
STATE="/opt/fireinners/wolverine-telegram/.api_state"
INTERVAL=20

send(){ /usr/local/bin/wolv_send "$1" >/dev/null 2>&1 || true; }

last="unknown"
[ -f "$STATE" ] && last="$(cat "$STATE" 2>/dev/null || echo unknown)"

while true; do
  ok=0
  out="$(curl -k -sS -m 5 "$PING_URL" 2>/dev/null || true)"
  if echo "$out" | grep -qi "pong"; then ok=1; fi

  if [ "$ok" = "1" ] && [ "$last" != "online" ]; then
    send "WOLVERINE API: RECOVERED (pong)"
    last="online"
    echo "$last" >"$STATE"
  elif [ "$ok" = "0" ] && [ "$last" != "offline" ]; then
    send "WOLVERINE API: OFFLINE (no pong)"
    last="offline"
    echo "$last" >"$STATE"
  fi

  sleep "$INTERVAL"
done
LOOP
askorupdate_file "$LOOP" </tmp/_loop
rm -f /tmp/_loop
chmod 700 "$LOOP"

cat >/tmp/_svc <<'UNIT'
[Unit]
Description=Wolverine Telegram Sentinel (API ping -> TG)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fireinners/wolverine-telegram
ExecStart=/bin/bash /opt/fireinners/wolverine-telegram/sentinel.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT
askorupdate_file "$SVC" </tmp/_svc
rm -f /tmp/_svc
chmod 0644 "$SVC"

systemctl daemon-reload
systemctl enable wolverine-tg-sentinel
systemctl restart wolverine-tg-sentinel
sleep 0.5
systemctl --no-pager --full status wolverine-tg-sentinel | sed -n '1,12p' || true

echo "=== DONE ==="
echo "Service: wolverine-tg-sentinel"
echo "Logs: journalctl -u wolverine-tg-sentinel -n 50 --no-pager"
SH
bash /tmp/WOLVERINE_TG_SENTINEL.sh
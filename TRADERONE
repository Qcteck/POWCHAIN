python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# 7.1 Remove any accidental script tag pointing to /wolverine/solana-rpc (that causes MIME text/html errors)
s = s.replace('<script src="/wolverine/solana-rpc"></script>', '')
s = s.replace('<script src="/wolverine/solana-rpc"></script>\n', '')

# 7.2 Ensure vendor web3 is loaded (keep existing if already there)
if '/wolverine/vendor/solana-web3.min.js' not in s:
  # Insert before closing </head> if possible
  ins = '<script src="/wolverine/vendor/solana-web3.min.js"></script>'
  if '</head>' in s:
    s = s.replace('</head>', ins + '</head>', 1)
  else:
    s = ins + s

# 7.3 Force RPC endpoint to absolute URL (fix: "Endpoint URL must start with http/https")
# Replace common patterns: "/wolverine/solana-rpc" or '"/wolverine/solana-rpc"' or "'/wolverine/solana-rpc'"
s = s.replace('"/wolverine/solana-rpc"', '(location.origin + "/wolverine/solana-rpc")')
s = s.replace("'/wolverine/solana-rpc'", '(location.origin + "/wolverine/solana-rpc")')
s = s.replace('/wolverine/solana-rpc', '"+location.origin+"/wolverine/solana-rpc"' ) if '"/wolverine/solana-rpc"' in s else s

# 7.4 If code contains a literal assignment, patch it more safely
import re
def repl(m):
  return m.group(1) + 'location.origin + "/wolverine/solana-rpc"' + m.group(3)
s = re.sub(r'(\bRPC_PRIMARY\s*=\s*)(["\'])/wolverine/solana-rpc(["\'])', repl, s)
s = re.sub(r'(\brpc\s*:\s*)(["\'])/wolverine/solana-rpc(["\'])', repl, s)

# 7.5 Keep name AQUILA visible (no-op if already there)
# (We do not rename UI; just avoid removing any "Aquila" strings)
p.write_text(s)
print("OK: index.html patched")

cat >/tmp/FIX_TRADERONE_WATCHDOG_LOOP_ROOT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 0) stop watchdog loop =="
systemctl stop traderone-watchdog.timer traderone-watchdog.service 2>/dev/null || true

echo "== 1) sanity: service status =="
systemctl status traderone.service --no-pager || true

echo "== 2) ensure state files exist (avoid crashes) =="
mkdir -p /opt/traderone-opt
[ -f /opt/traderone-opt/state.json ] || echo '{}' > /opt/traderone-opt/state.json
[ -f /opt/traderone-opt/trades.log ] || : > /opt/traderone-opt/trades.log
chown -R root:root /opt/traderone-opt
chmod 644 /opt/traderone-opt/state.json /opt/traderone-opt/trades.log

echo "== 3) write SAFE watchdog (local health + 2 consecutive fails) =="
cat >/usr/local/bin/traderone_watchdog.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

URL="http://127.0.0.1:8585/api/health"
STATE="/run/traderone_watchdog_failcount"

code="$(curl -sS --max-time 4 -o /dev/null -w "%{http_code}" "$URL" || echo 000)"

if [ "$code" = "200" ]; then
  rm -f "$STATE"
  exit 0
fi

n=0
[ -f "$STATE" ] && n="$(cat "$STATE" 2>/dev/null || echo 0)"
n=$((n+1))
echo "$n" > "$STATE"

if [ "$n" -ge 2 ]; then
  rm -f "$STATE"
  systemctl restart traderone.service
fi
EOF
chmod +x /usr/local/bin/traderone_watchdog.sh

echo "== 4) slow down timer to 60s (less aggressive) =="
if [ -f /etc/systemd/system/traderone-watchdog.timer ]; then
  sed -i 's/OnUnitActiveSec=30/OnUnitActiveSec=60/' /etc/systemd/system/traderone-watchdog.timer || true
fi

echo "== 5) reload + restart traderone + re-enable watchdog =="
systemctl daemon-reload
systemctl restart traderone.service
sleep 2
systemctl enable --now traderone-watchdog.timer

echo "== 6) quick checks =="
echo "--- LOCAL health ---"
curl -sS http://127.0.0.1:8585/api/health ; echo
echo "--- NGINX health (info) ---"
curl -ksS -o /dev/null -w "http_code=%{http_code}\n" https://fireinners.online/wolverine/traderone/api/health || true

echo "--- watchdog status ---"
systemctl status traderone-watchdog.timer --no-pager || true
echo "--- last watchdog runs ---"
journalctl -u traderone-watchdog.service -n 30 --no-pager || true
SH

bash /tmp/FIX_TRADERONE_WATCHDOG_LOOP_ROOT.sh
if(!(pair)||(!A.ALLOW_ALL_IF_EMPTY))bad("pair not allowlisted");
const usd=await estimateUsd(p.inMint,p.amountIn);
const U=mem.exec.usage.usage;
const gTx=Number(A.global?.maxTxPer24h||0),gUsd=Number(A.global?.maxUsdPer24h||0);
if(gTx>0 && U.tx24h>=gTx)bad("global tx quota exceeded");

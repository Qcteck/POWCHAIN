set -euo pipefail

BASE="/var/www/fireinners/wolverine"
VENDOR="$BASE/vendor"
HTML="$BASE/index.html"

mkdir -p "$VENDOR"

echo "Téléchargement des libs..."

curl -L -o "$VENDOR/web3.min.js" \
  https://cdn.jsdelivr.net/npm/@solana/web3.js@1.95.4/lib/index.iife.min.js

curl -L -o "$VENDOR/spl-token.min.js" \
  https://cdn.jsdelivr.net/npm/@solana/spl-token@0.4.8/lib/index.iife.min.js

echo "Libs téléchargées localement."

# Nettoyer les anciens scripts CDN
perl -i -pe '
  s#<script[^>]+cdn\.jsdelivr\.net/npm/@solana/web3\.js[^>]*></script>##gi;
  s#<script[^>]+cdn\.jsdelivr\.net/npm/@solana/spl-token[^>]*></script>##gi;
' "$HTML"

# Injecter les scripts locaux AVANT app.js
perl -0777 -i -pe '
  s#(<script[^>]+src="[^"]*app\.js[^"]*"[^>]*></script>)#
  <script src="/wolverine/vendor/web3.min.js"></script>\n
  <script src="/wolverine/vendor/spl-token.min.js"></script>\n
  $1
  #s
' "$HTML"

echo "Injection terminée."
echo "👉 Fais maintenant Ctrl+F5 sur /wolverine"
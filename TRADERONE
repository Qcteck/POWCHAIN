  </div>
</div>

<div id="log"></div>
<div id="aiArticle"></div>

<audio id="jingle" preload="auto" src="https://cdn.pixabay.com/audio/2022/03/15/audio_9b0d33a9f0.mp3"></audio>
<audio id="bed" preload="auto" loop src="https://cdn.pixabay.com/audio/2022/10/03/audio_946bfa4c59.mp3"></audio>

<script>
/* ================== CONFIG ================== */
const SHOW_DURATION = 26 * 60 * 1000;
const PAUSE_DURATION = 4 * 60 * 1000;
let LANG = "fr";

/* ================== LOG ================== */
const logDiv = document.getElementById("log");
function log(t){logDiv.innerHTML+=t+"<br>";logDiv.scrollTop=logDiv.scrollHeight;}

/* ================== LANG ================== */
function toggleLang(){ LANG = LANG==="fr"?"en":"fr"; log("🌐 Langue : "+LANG); }

/* ================== VOICES ================== */
const VOICES = {
  HOST:{pitch:1.1,rate:1.02},
  ANALYST:{pitch:0.95,rate:1},
  CORTEX:{pitch:1.2,rate:1.05}
};
function speak(agent,text){
  const u=new SpeechSynthesisUtterance(text);
  u.lang = LANG==="fr"?"fr-FR":"en-US";
  u.pitch = agent.pitch;
  u.rate = agent.rate;
  speechSynthesis.speak(u);
  log("🎙️ "+text);
}

/* ================== TEXT POOLS ================== */
const INTRO_FR=[
  "Bonjour et bienvenue, installez-vous, on fait le point ensemble.",
  "Ravi de vous retrouver, voyons ce qui bouge sur le marché.",
  "Nouvelle édition, regardons ensemble l’actualité crypto."
];
const USER_TALK_FR=[
  "Si vous suivez le marché, cette information mérite un regard attentif.",
  "De votre côté, vous avez peut-être déjà remarqué ce mouvement.",
  "Prenons un instant pour comprendre ce que cela implique pour vous."
];
function pick(arr){return arr[Math.floor(Math.random()*arr.length)];}

/* ================== RSS ================== */
const RSS_SOURCES=[
  "https://cryptoast.fr/feed",
  "https://journalducoin.com/feed",
  "https://bitcoin.fr/feed"
];
async function loadRSS(){
  let stock = JSON.parse(localStorage.getItem("rssStock")||"[]");
  for(const src of RSS_SOURCES){
    try{
      const r=await fetch("https://api.rss2json.com/v1/api.json?rss_url="+encodeURIComponent(src));
      const j=await r.json();
      if(j.items){
        j.items.forEach(it=>{
          if(!stock.find(s=>s.title===it.title)){
            stock.push(it);
          }
        });
      }
    }catch(e){console.warn("RSS fail",src,e);}
  }
  if(stock.length>50) stock = stock.slice(-50);
  localStorage.setItem("rssStock",JSON.stringify(stock));
  return stock;
}

/* ================== RADIO LOOP ================== */
async function radioLoop(){
  const jingle = document.getElementById("jingle");
  const bed = document.getElementById("bed");
  jingle.play().catch(()=>{});
  bed.volume = 0.15; bed.play().catch(()=>{});

  speak(VOICES.HOST,pick(INTRO_FR));

  const startTime = Date.now();
  while(Date.now()-startTime<SHOW_DURATION){
    let rss = await loadRSS();
    if(!rss.length){ await new Promise(r=>setTimeout(r,5000)); continue; }
    const article = rss[Math.floor(Math.random()*rss.length)];
    speak(VOICES.HOST,pick(USER_TALK_FR));
    speak(VOICES.HOST,article.title);
    speak(VOICES.ANALYST,(article.description||"").replace(/<[^>]+>/g,"").slice(0,180));
    await new Promise(r=>setTimeout(r,12000));
  }

  speak(VOICES.HOST,"Pause musicale, on se retrouve très bientôt.");
  await new Promise(r=>setTimeout(r,PAUSE_DURATION));
  radioLoop();
}


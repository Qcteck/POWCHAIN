set -e
cd /root

# trouve le dernier fichier de clé généré
KEYFILE="$(ls -1t /root/x_api_key_*.txt 2>/dev/null | head -n1)"

if [ -z "$KEYFILE" ]; then
  echo "Aucun fichier /root/x_api_key_*.txt trouvé."
  exit 1
fi

echo "Suppression sécurisée de: $KEYFILE"

# shred si dispo, sinon suppression normale
if command -v shred >/dev/null 2>&1; then
  shred -u -z -n 3 "$KEYFILE"
else
  rm -f "$KEYFILE"
fi

echo "OK: supprimé."
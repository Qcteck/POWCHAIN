cat >/root/fix_duplicate_traderone_api_location.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

PATH_RE='location\s*=*\s*/wolverine/traderone/api/?\b'
TS="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Find ACTIVE duplicates for /wolverine/traderone/api (exclude .bak) =="
mapfile -t HITS < <(
  grep -RIn --binary-files=without-match -E "$PATH_RE" /etc/nginx \
  | grep -vE '\.bak_|\.bak$' || true
)
printf "%s\n" "${HITS[@]}"
echo

FILES=()
for h in "${HITS[@]:-}"; do
  f="${h%%:*}"
  [[ " ${FILES[*]} " =~ " ${f} " ]] || FILES+=("$f")
done

if [ "${#FILES[@]}" -eq 0 ]; then
  echo "No matching location found. Paste the exact nginx error line."
  exit 1
fi

echo "== Files containing /wolverine/traderone/api location =="
printf " - %s\n" "${FILES[@]}"
echo

echo "== 2) Pick file to KEEP (prefer sites-enabled/fireinners.online-ssl) =="
KEEP=""
for f in "${FILES[@]}"; do
  if [[ "$f" =~ /etc/nginx/sites-enabled/fireinners\.online-ssl ]]; then KEEP="$f"; break; fi
done
if [ -z "$KEEP" ]; then KEEP="${FILES[0]}"; fi
echo "KEEP: $KEEP"
echo

echo "== 3) Disable duplicates in OTHER files by renaming location path =="
for f in "${FILES[@]}"; do
  [ "$f" = "$KEEP" ] && continue
  echo "--- patching $f ---"
  cp -a "$f" "$f.bak_$TS"
  sed -i -E \
    's@(location[[:space:]]*=*[[:space:]]*)/wolverine/traderone/api\b@\1/wolverine/traderone/api_DISABLED@g' \
    "$f"
done

echo
echo "== 4) If the KEEP file itself has 2 locations, rename the SECOND one =="
cp -a "$KEEP" "$KEEP.bak2_$TS"
awk '
  BEGIN{c=0}
  {
    if ($0 ~ /location[[:space:]]*=*[[:space:]]*\/wolverine\/traderone\/api\/?\b/) {
      c++
      if (c>=2) sub(/\/wolverine\/traderone\/api/, "/wolverine/traderone/api_DISABLED")
    }
    print
  }' "$KEEP.bak2_$TS" > "$KEEP"

echo
echo "== 5) nginx -t and reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo
echo "== 6) Verify only one location remains =="
grep -RIn -E "$PATH_RE" /etc/nginx | grep -vE '\.bak_|\.bak$' || true

echo "DONE ✅"
BASH

chmod +x /root/fix_duplicate_traderone_api_location.sh
/root/fix_duplicate_traderone_api_location.sh
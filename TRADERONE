bash -lc 'set -euo pipefail
REPO="git@github.com:Qcteck/WOLVERINE.git"
KEY="/root/.ssh/wolverine_write_ed25519"
STAGE="/tmp/wolverine_repo_push"
WOLV_SRC="/opt/fireinners/frontend-react/app/dist/wolverine"
TR_SRC="/opt/traderone-opt"
rm -rf "$STAGE"; mkdir -p "$STAGE/repo"; cd "$STAGE/repo"
git init -q
git config user.name "vps-sync"
git config user.email "vps-sync@local"
mkdir -p TRADERONE

rsync -a --delete --exclude ".git" --exclude "node_modules" --exclude "db" --exclude ".leveldb" --exclude "logs" --exclude "*.log" --exclude ".env" --exclude "*.env" --exclude "telegram.env" --exclude "*.key" --exclude "*.pem" --exclude "*.p12" --exclude "*.pfx" "$WOLV_SRC"/ ./
rsync -a --delete --exclude ".git" --exclude "node_modules" --exclude "db" --exclude ".leveldb" --exclude "logs" --exclude "*.log" --exclude ".env" --exclude "*.env" --exclude "telegram.env" --exclude "*.key" --exclude "*.pem" --exclude "*.p12" --exclude "*.pfx" "$TR_SRC"/ TRADERONE/

cat > .gitignore <<EOF
node_modules/
db/
.leveldb/
logs/
*.log
.env
*.env
telegram.env
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
EOF

git add -A
git commit -m "Sync VPS: Wolverine(root)+TraderOne(/TRADERONE) $(date -Iseconds)" -q
git branch -M main
git remote remove origin 2>/dev/null || true
git remote add origin "$REPO"
GIT_SSH_COMMAND="ssh -i $KEY -o IdentitiesOnly=yes" git push -f origin main
echo "OK: GitHub WOLVERINE up-to-date (force)."
'
set -euo pipefail
DOMAIN="fireinners.online"
TMP="/tmp/nginxT.$(date +%s).txt"
TS="$(date +%s)"

echo "== 1) Dump config finale nginx (FIRST) =="
nginx -T > "$TMP" 2>&1
echo "Saved: $TMP"

echo
echo "== 2) Trouver le fichier EXACT qui sert /wolverine =="
VHOST="$(awk '
  /^# configuration file /{f=$4; sub(/:$/,"",f)}
  /\/wolverine/ {print f; exit}
' "$TMP")"
echo "VHOST=$VHOST"
[ -n "${VHOST:-}" ] || { echo "ERR: /wolverine introuvable dans nginx -T. Fais: grep -n \"/wolverine\" $TMP | head -n 80"; exit 1; }

echo
echo "== 3) Backup + injecter RPC proxy DANS server{} de ce fichier =="
cp -a "$VHOST" "$VHOST.bak.$TS"
echo "Backup: $VHOST.bak.$TS"

if ! grep -qE 'location\s*=\s*/wolverine/traderone/api/rpc' "$VHOST"; then
  perl -0777 -i -pe 's/(server\s*\{[\s\S]*?)(\n\})/$1\n\n  # Wolverine: Solana RPC proxy (same-origin)\n  resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;\n  location = \/wolverine\/traderone\/api\/rpc {\n    proxy_pass https:\/\/api.mainnet-beta.solana.com;\n    proxy_http_version 1.1;\n    proxy_ssl_server_name on;\n    proxy_set_header Host api.mainnet-beta.solana.com;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n  }\n$2/s' "$VHOST"
  echo "Injected RPC location ✅"
else
  echo "OK: location déjà présent ✅"
fi

echo
echo "== 4) Reload nginx =="
nginx -t && systemctl reload nginx

echo
echo "== 5) Test HTTPS RPC (DOIT PAS être 404) =="
curl -ksS -i "https://$DOMAIN/wolverine/traderone/api/rpc" \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 30
cat > /root/TRADERONE_UI_BUDGET_SOL_ALL.sh <<'BASH'
#!/usr/bin/env bash
set -e

### CONFIG
UI_HTML="/var/www/wolverine/index.html"
BACKEND="/opt/traderone/server.js"
API_PATH="/wolverine/traderone/api/budget"
REPORT="/root/TRADERONE_UI_BUDGET_SOL_$(date +%Y%m%d_%H%M%S).log"

echo "===== TRADERONE UI → BUDGET SOL (ALL-IN-ONE) =====" | tee "$REPORT"

### 1) SAFETY BACKUP
cp "$UI_HTML" "$UI_HTML.bak.$(date +%s)"
cp "$BACKEND" "$BACKEND.bak.$(date +%s)"
echo "[OK] Backups done" | tee -a "$REPORT"

### 2) UI – ADD BUTTON + JS (SOL ONLY)
python3 <<'PY'
from pathlib import Path

p = Path("/var/www/wolverine/index.html")
html = p.read_text(errors="ignore")

if "sendBudget" in html:
    print("UI already patched")
    exit()

BLOCK = """
<div style="margin-top:10px;">
  <input id="budgetSol" type="number" step="0.001" min="0.001" placeholder="Budget SOL" />
  <button id="sendBudget">Envoyer à TraderOne</button>
</div>
<pre id="budgetStatus"></pre>

<script>
const TRADERONE_API="/wolverine/traderone/api/budget";
document.getElementById("sendBudget").onclick=async()=>{
 try{
  if(!window.solana||!window.solana.publicKey)throw"Wallet non connecté";
  const b=parseFloat(document.getElementById("budgetSol").value);
  if(!b||b<=0)throw"Budget invalide";
  const r=await fetch(TRADERONE_API,{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({pubkey:window.solana.publicKey.toString(),budgetSOL:b})
  });
  document.getElementById("budgetStatus").textContent="OK "+JSON.stringify(await r.json());
 }catch(e){
  document.getElementById("budgetStatus").textContent="ERREUR "+e;
 }
};
</script>
"""

html = html.replace("</body>", BLOCK + "\n</body>")
p.write_text(html)
print("UI patched")
PY

echo "[OK] UI patched (SOL budget button)" | tee -a "$REPORT"

### 3) BACKEND – ADD ENDPOINT
grep -q "api/budget" "$BACKEND" || python3 <<'PY'
from pathlib import Path

p=Path("/opt/traderone/server.js")
s=p.read_text(errors="ignore")

ENDPOINT = """
app.post("/api/budget",(req,res)=>{
 const {pubkey,budgetSOL}=req.body||{};
 if(!pubkey||!budgetSOL||budgetSOL<=0)return res.status(400).json({error:"invalid_budget"});
 if(!db[pubkey])db[pubkey]={sol:0};
 db[pubkey].budgetSOL=Number(budgetSOL);
 console.log("[TRADERONE] Budget SOL:",pubkey,budgetSOL);
 res.json({ok:true,budgetSOL});
});
"""

s += "\n" + ENDPOINT
p.write_text(s)
print("Backend patched")
PY

echo "[OK] Backend endpoint added" | tee -a "$REPORT"


cat >/root/fix_rpc_403_in_solana_snippet.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

F="/etc/nginx/snippets/solana_rpc_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$F" || { echo "Missing $F"; exit 1; }

echo "== 1) Show current snippet (with line numbers) =="
nl -ba "$F" | sed -n '1,200p'
echo

echo "== 2) Backup =="
cp -a "$F" "$F.bak_$TS"

echo "== 3) Disable localhost-only blockers (allow/deny/return 403/if remote_addr) =="
sed -i -E \
  -e 's@^[[:space:]]*allow[[:space:]]+127\.0\.0\.1;@# DISABLED: allow 127.0.0.1;@g' \
  -e 's@^[[:space:]]*deny[[:space:]]+all;@# DISABLED: deny all;@g' \
  -e 's@^[[:space:]]*return[[:space:]]+403;@# DISABLED: return 403;@g' \
  -e 's@^[[:space:]]*if[[:space:]]*\([[:space:]]*\$remote_addr.*\)[[:space:]]*\{.*return[[:space:]]*403.*\}@# DISABLED: localhost-only if (remote_addr) block@g' \
  "$F" || true

echo "== 4) Ensure CORS for browser + OPTIONS preflight =="
# Add a safe CORS block inside location if not already present
if ! grep -q "Access-Control-Allow-Origin" "$F"; then
  awk '
    BEGIN{inloc=0}
    /location[[:space:]]*=*[[:space:]]*\/wolverine\/rpc/ {inloc=1}
    {print}
    inloc==1 && /\{/ {
      print "    # CORS (browser/Phantom)";
      print "    add_header Access-Control-Allow-Origin * always;";
      print "    add_header Access-Control-Allow-Methods \"POST, OPTIONS\" always;";
      print "    add_header Access-Control-Allow-Headers \"content-type\" always;";
      print "    if ($request_method = OPTIONS) { return 204; }";
      inloc=2
    }
  ' "$F" > "$F.tmp" && mv "$F.tmp" "$F"
fi

echo "== 5) nginx -t and reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "== 6) Retest (public) should be 200 =="
curl -sk -D- https://fireinners.online/wolverine/rpc \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | head -n 60

echo "DONE ✅"
BASH

chmod +x /root/fix_rpc_403_in_solana_snippet.sh
/root/fix_rpc_403_in_solana_snippet.sh
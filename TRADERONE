sudo bash -lc 'set -euo pipefail
AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
SN="/etc/nginx/snippets/probe_location.conf"

echo "[1] snippet /probe (priority)"
cat > "$SN" <<'"'"'EOF'"'"'
location ^~ /probe {
  add_header Cache-Control "no-store, no-cache, max-age=0" always;
  add_header Pragma "no-cache" always;
  add_header Expires "0" always;
  proxy_pass http://127.0.0.1:9696;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
EOF

echo "[2] ensure include exists in sites-available vhost"
cp -a "$AV" "$AV.bak_probe_fix_$(date +%Y%m%d_%H%M%S)"
if ! grep -q "probe_location.conf" "$AV"; then
  awk "BEGIN{in=0;hit=0;done=0}
  {print}
  \$0 ~ /^[[:space:]]*server[[:space:]]*\\{/ {in=1;hit=0}
  in && \$0 ~ /server_name/ && \$0 ~ /fireinners\\.online/ {hit=1}
  in && hit && done==0 {print \"  include /etc/nginx/snippets/probe_location.conf;\"; done=1}
  in && \$0 ~ /^[[:space:]]*\\}/ {in=0}
  END{exit(done?0:2)}" "$AV" > "$AV.tmp"
  test -s "$AV.tmp"
  mv "$AV.tmp" "$AV"
else
  echo "include already present"
fi

echo "[3] make sites-enabled a symlink to sites-available"
if [ -e "$EN" ] && [ ! -L "$EN" ]; then
  cp -a "$EN" "$EN.bak_probe_fix_$(date +%Y%m%d_%H%M%S)"
  rm -f "$EN"
fi
[ -L "$EN" ] || ln -s "$AV" "$EN"

echo "[4] nginx test + reload"
nginx -t
systemctl reload nginx

echo "[5] origin test (bypass CF) should be JSON"
TOKEN="$(awk -F= "/^PROBE_TOKEN=/{print \$2}" /opt/probe/probe.env)"
echo "TOKEN=$TOKEN"
curl -sk --resolve fireinners.online:443:127.0.0.1 -H "X-Probe-Token: $TOKEN" https://fireinners.online/probe | head -c 260; echo
'
cat >/root/cleanup_traderone_snippets_and_fix_unbound.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
DIS="/etc/nginx/snippets-disabled/cleanup_${TS}"
mkdir -p "$DIS"

echo "== 1) Move conflicting traderone snippets out of /etc/nginx/snippets =="
shopt -s nullglob
for f in \
  /etc/nginx/snippets/traderone_* \
  /etc/nginx/snippets/*traderone* \
  /etc/nginx/snippets/*traderone_api_proxy* \
  /etc/nginx/snippets/*wolverine_traderone* \
  /etc/nginx/snippets/*traderone_api_proxy.conf* \
; do
  [ -e "$f" ] || continue
  echo "MOVE: $f -> $DIS/"
  mv -v "$f" "$DIS/"
done

echo
echo "== 2) Write SINGLE SOURCE OF TRUTH include =="
mkdir -p /etc/nginx/includes
cp -a "$INC" "$INC.bak_$TS" 2>/dev/null || true

cat > "$INC" <<'NGX'
# Wolverine routes (TRADERONE) - SINGLE SOURCE OF TRUTH

location = /wolverine/traderone/api {
  return 301 /wolverine/traderone/api/;
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  add_header X-Wolverine-Route "traderone" always;
  add_header X-Wolverine-Upstream "$upstream_addr" always;
  access_log /var/log/nginx/traderone_access.log combined;

  # backend expects /health /me /orders ...
  rewrite ^/wolverine/traderone/api/(.*)$ /$1 break;
  proxy_pass http://127.0.0.1:8585;
}
NGX

touch /var/log/nginx/traderone_access.log || true

echo
echo "== 3) Ensure vhost includes ONLY this include (inside server) =="
cp -a "$VHOST" "$VHOST.bak_$TS"

python3 - <<'PY'
import re
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"

lines=open(VHOST,"r",errors="ignore").read().splitlines(True)

# find first server block
start=None
for i,l in enumerate(lines):
    if re.search(r'^\s*server\s*\{', l):
        start=i; break
if start is None:
    raise SystemExit("No server { found")

depth=0
end=None
for i in range(start, len(lines)):
    depth += lines[i].count("{")
    depth -= lines[i].count("}")
    if depth==0 and i>start:
        end=i
        break
if end is None:
    raise SystemExit("Brace mismatch in vhost")

before=lines[:start]
server=lines[start:end+1]
after=lines[end+1:]

def strip_wolverine_includes(block):
    out=[]
    for l in block:
        if re.search(r'^\s*include\b', l) and ("wolverine_routes" in l or INC in l or "snippets/" in l):
            out.append("# DISABLED_OLD_INCLUDE " + l)
        else:
            out.append(l)
    return out

before=strip_wolverine_includes(before)
after=strip_wolverine_includes(after)
server=strip_wolverine_includes(server)

# remove any traderone location blocks directly in vhost
out=[]
in_loc=False
d=0
for l in server:
    if not in_loc and re.search(r'^\s*location\b.*?/wolverine/traderone/api', l):
        out.append("# DISABLED_TRADERONE_DUP " + l)
        in_loc=True
        d = l.count("{") - l.count("}")
        continue
    if in_loc:
        out.append("# DISABLED_TRADERONE_DUP " + l)
        d += l.count("{") - l.count("}")
        if d <= 0 and "}" in l:
            in_loc=False
        continue
    out.append(l)
server=out

# inject include once before closing brace
inc_line=f"  include {INC};\n"
server.insert(len(server)-1, inc_line)

open(VHOST,"w").writelines(before+server+after)
PY

echo
echo "== 4) nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo
echo "== 5) BYPASS Cloudflare tests (must show X-Wolverine-Route) =="
for p in /wolverine/traderone/api/health /wolverine/traderone/api/me /wolverine/traderone/api/orders; do
  echo "--- $p ---"
  curl -sk --resolve fireinners.online:443:127.0.0.1 -D- -o /dev/null "https://fireinners.online$p" | sed -n '1,35p'
done

echo
echo "== 6) Tail traderone access log =="
tail -n 30 /var/log/nginx/traderone_access.log || true
echo "DONE ✅"
BASH

chmod +x /root/cleanup_traderone_snippets_and_fix_unbound.sh
/root/cleanup_traderone_snippets_and_fix_unbound.sh
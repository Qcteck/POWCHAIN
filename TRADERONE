/**
 * strategy.routes.js
 * Endpoints:
 *  POST /api/strategy/dca/start|pause|stop
 *  GET  /api/strategy/dca/status?wallet=
 *  (idem grid/arbitrage/trend)
 */
const express = require("express");
const router = express.Router();

// In-memory state (remplace par DB plus tard)
const state = {
  // wallet: { active: { mode, name, config, status, startedAt }, history: [] }
};

function getWallet(req){
  return (req.body.wallet || req.query.wallet || "").trim();
}
function ensureWallet(wallet){
  if(!state[wallet]) state[wallet] = { active: null, history: [] };
}

function makeHandlers(name){
  const base = "/" + name;

  router.post(base + "/start", (req,res)=>{
    const wallet = getWallet(req);
    if(!wallet) return res.status(400).send("missing wallet");
    ensureWallet(wallet);
    const cfg = Object.assign({}, req.body);
    state[wallet].active = {
      name,
      mode: (req.body.mode || name).toString(),
      status: "RUNNING",
      config: cfg,
      startedAt: Date.now()
    };
    state[wallet].history.push({ts:Date.now(), event:"START", name, cfg});
    res.json({ok:true, active: state[wallet].active});
  });

  router.post(base + "/pause", (req,res)=>{
    const wallet = getWallet(req);
    if(!wallet) return res.status(400).send("missing wallet");
    ensureWallet(wallet);
    if(!state[wallet].active || state[wallet].active.name !== name){
      return res.json({ok:true, note:"no active strategy for this type"});
    }
    state[wallet].active.status = "PAUSED";
    state[wallet].history.push({ts:Date.now(), event:"PAUSE", name});
    res.json({ok:true, active: state[wallet].active});
  });

  router.post(base + "/stop", (req,res)=>{
    const wallet = getWallet(req);
    if(!wallet) return res.status(400).send("missing wallet");
    ensureWallet(wallet);
    if(state[wallet].active && state[wallet].active.name === name){
      state[wallet].history.push({ts:Date.now(), event:"STOP", name});
      state[wallet].active = null;
    }else{
      state[wallet].history.push({ts:Date.now(), event:"STOP_NOOP", name});
    }
    res.json({ok:true, active: state[wallet].active});
  });

  router.get(base + "/status", (req,res)=>{
    const wallet = getWallet(req);
    if(!wallet) return res.status(400).send("missing wallet");
    ensureWallet(wallet);
    res.json({ok:true, active: state[wallet].active, last: state[wallet].history.slice(-10)});
  });
}

makeHandlers("dca");
makeHandlers("grid");
makeHandlers("arbitrage");
makeHandlers("trend");

module.exports = router;
JS


set -e
cd /root

mkdir -p /root/nginx_backups
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  cp -v "$f" "/root/nginx_backups/$(basename "$f").$(date +%Y%m%d_%H%M%S)"

  # 1) remplace proxy_pass 3000 -> 3002 dans le vhost
  sed -i 's/127\.0\.0\.1:3000/127.0.0.1:3002/g' "$f"

  # 2) ajoute un rewrite dans le location traderone/api (si pas déjà là)
  perl -0777 -i -pe '
    s#(location\s+\^~\s+/wolverine/traderone/api/\s*\{\n)(?!.*rewrite\s+\^/wolverine/traderone/api/)#$1  rewrite ^/wolverine/traderone/api/(.*)$ /wolverine/api/$1 break;\n#s
  ' "$f"
done

nginx -t
systemctl reload nginx
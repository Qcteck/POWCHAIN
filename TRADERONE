cat >/root/fix_react_safe_wallet_patch.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/var/www/wolverine"
JS="$ROOT/phantom_patch.js"
INDEX="$ROOT/index.html"

ts="$(date +%Y%m%d_%H%M%S)"

mkdir -p "$ROOT"

# backup
[[ -f "$JS" ]] && cp -a "$JS" "${JS}.bak_${ts}" || true
[[ -f "$INDEX" ]] && cp -a "$INDEX" "${INDEX}.bak_${ts}" || true

cat >"$JS" <<'JS'
(function () {
  const RPC = "https://api.mainnet-beta.solana.com";
  const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
  const REFRESH_MS = 15000;

  const short = (s) => (s ? s.slice(0, 4) + "…" + s.slice(-4) : "");

  // ---- overlay (hors React) ----
  function ensureOverlay() {
    let el = document.getElementById("__wallet_overlay");
    if (el) return el;
    el = document.createElement("div");
    el.id = "__wallet_overlay";
    el.style.cssText =
      "position:fixed;right:16px;bottom:16px;z-index:2147483647;" +
      "background:rgba(0,0,0,.85);color:#fff;padding:10px 12px;border-radius:10px;" +
      "font:12px/1.35 system-ui;max-width:80vw;white-space:pre-line";
    el.textContent = "Patch loaded";
    document.body.appendChild(el);
    return el;
  }
  function setOverlay(msg) { ensureOverlay().textContent = msg; }

  // ---- badge “Connected” (hors React, positionné au-dessus du bloc Wallet) ----
  function ensureBadge() {
    let b = document.getElementById("__wallet_connected_badge");
    if (b) return b;
    b = document.createElement("div");
    b.id = "__wallet_connected_badge";
    b.style.cssText =
      "position:fixed;z-index:2147483647;display:none;" +
      "background:rgba(0,160,90,.90);color:#fff;padding:6px 10px;border-radius:999px;" +
      "font:12px system-ui;box-shadow:0 6px 18px rgba(0,0,0,.25)";
    b.textContent = "Connected";
    document.body.appendChild(b);
    return b;
  }

  function findWalletCard() {
    // Cherche un container qui contient “Wallet” et “Connect Phantom” (sans modifier ses enfants)
    const candidates = Array.from(document.querySelectorAll("div,section,aside"));
    for (const c of candidates) {
      const t = (c.textContent || "").toLowerCase();
      if (t.includes("wallet") && t.includes("connect phantom")) return c;
      if (t.includes("wallet") && t.includes("not connected")) return c;
    }
    return null;
  }

  function positionBadge(pk, sol, usdc) {
    const card = findWalletCard();
    const badge = ensureBadge();

    if (!card) {
      badge.style.display = "none";
      return;
    }

    const r = card.getBoundingClientRect();
    badge.style.left = Math.round(r.left + 12) + "px";
    badge.style.top  = Math.round(r.top + 8) + "px";
    badge.style.display = "block";
    badge.textContent = `Connected ${short(pk)}  |  SOL ${sol.toFixed(4)}  USDC ${usdc.toFixed(2)}`;
  }

  async function rpc(method, params) {
    const r = await fetch(RPC, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }),
    });
    const j = await r.json();
    if (j.error) throw new Error(j.error.message || JSON.stringify(j.error));
    return j.result;
  }

  async function fetchBalances(owner) {
    const bal = await rpc("getBalance", [owner, { commitment: "confirmed" }]);
    const sol = (bal.value || 0) / 1e9;

    const tok = await rpc("getTokenAccountsByOwner", [
      owner,
      { mint: USDC_MINT },
      { encoding: "jsonParsed", commitment: "confirmed" },
    ]);

    let usdc = 0;
    for (const acc of (tok.value || [])) {
      const amt = acc.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
      if (typeof amt === "number") usdc += amt;
    }
    return { sol, usdc };
  }

  async function refreshAll() {
    const pk = window.solana?.publicKey?.toBase58?.() || window.__WALLET_PK__;
    if (!pk) return;

    try {
      const { sol, usdc } = await fetchBalances(pk);
      setOverlay(`Connected: ${short(pk)}\nSOL ${sol.toFixed(4)} | USDC ${usdc.toFixed(2)}`);
      positionBadge(pk, sol, usdc);
    } catch (e) {
      console.error(e);
      setOverlay(`Connected: ${short(pk)}\nBalance: RPC error`);
    }
  }

  async function connect() {
    if (!window.solana || !window.solana.isPhantom) {
      setOverlay("Phantom introuvable.\n➡️ Ouvre le site dans Phantom Browser.");
      return;
    }
    const r = await window.solana.connect();
    window.__WALLET_PK__ = r.publicKey.toBase58();
    await refreshAll();
  }

  function hookConnectButton() {
    // on ne change PAS le texte du bouton (React-safe) — on écoute juste le click
    const nodes = Array.from(document.querySelectorAll("button,a,div,span"));
    const btn = nodes.find(n => /connect phantom/i.test((n.textContent || "").trim()));
    if (btn && !btn.__hooked_phantom) {
      btn.__hooked_phantom = true;
      btn.addEventListener("click", (ev) => {
        ev.preventDefault();
        connect().catch(err => {
          console.error(err);
          setOverlay("Connect error");
        });
      }, { passive: false });
      setOverlay("Patch loaded — waiting connect…");
    }
  }

  window.addEventListener("load", () => {
    ensureOverlay();
    ensureBadge();
    hookConnectButton();

    // DOM changes in React app: re-hook safely
    const obs = new MutationObserver(() => hookConnectButton());
    obs.observe(document.documentElement, { childList: true, subtree: true });

    // si déjà connecté
    if (window.solana?.isPhantom && window.solana.publicKey) {
      window.__WALLET_PK__ = window.solana.publicKey.toBase58();
      refreshAll();
    }

    // refresh auto
    setInterval(refreshAll, REFRESH_MS);

    window.solana?.on?.("accountChanged", (pubkey) => {
      if (pubkey) {
        window.__WALLET_PK__ = pubkey.toBase58();
        refreshAll();
      } else {
        setOverlay("Wallet: not connected");
        const b = document.getElementById("__wallet_connected_badge");
        if (b) b.style.display = "none";
      }
    });

    // reposition badge on scroll/resize (sinon il se décale)
    window.addEventListener("scroll", refreshAll, { passive: true });
    window.addEventListener("resize", refreshAll);
  });

  window.__WALLET_PATCH_LOADED__ = true;
})();
JS

# inject script tag in index if missing
if [[ -f "$INDEX" ]] && ! grep -q "phantom_patch.js" "$INDEX"; then
  perl -0777 -i -pe '
    my $tag = qq{\n<!-- WALLET_PATCH -->\n<script src="/wolverine/phantom_patch.js?v='"$ts"'" defer></script>\n<!-- /WALLET_PATCH -->\n};
    s@(<head[^>]*>)@$1$tag@i;
  ' "$INDEX"
fi

nginx -t
systemctl reload nginx
echo "✅ OK. Test: https://fireinners.online/wolverine/settings/?v=$ts"
BASH

chmod +x /root/fix_react_safe_wallet_patch.sh
/root/fix_react_safe_wallet_patch.sh
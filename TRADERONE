bash <<'EOF'
set -e
echo "=== WOLVERINE / TRADERONE FULL FIX ==="

### PATHS
WEB="/var/www/wolverine"
HTML="$WEB/index.html"
VENDOR="$WEB/vendor"
API="/opt/traderone-api"
PORT=3010

### BACKUP
cp -f "$HTML" "$HTML.bak.$(date +%s)"

### FRONTEND FIX
mkdir -p "$VENDOR"

### SOLANA WEB3 LOCAL
if [ ! -f "$VENDOR/solana-web3.min.js" ]; then
  curl -sL https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js -o "$VENDOR/solana-web3.min.js"
fi

### REWRITE index.html
cat > "$HTML" <<'HTML'
<!DOCTYPE html><html><head><meta charset="utf-8">
<title>Wolverine – TraderOne</title>
<style>
body{margin:0;background:#0a1a3a;color:#fff;font-family:Arial}
.panel{background:#143c8a;margin:10px;padding:15px;border-radius:8px}
button{background:#f1c40f;border:0;padding:10px 15px;margin:5px;font-weight:bold;cursor:pointer}
input{padding:8px;width:120px}
</style>
</head>
<body>

<div class="panel">
<h2>TraderOne Control</h2>
<button onclick="startBot()">START</button>
<button onclick="pauseBot()">PAUSE</button>
<button onclick="stopBot()">STOP</button>
</div>

<div class="panel">
<button onclick="connectPhantom()">Connect Phantom (REAL)</button>
<div>Address: <span id="addr">-</span></div>
<div>SOL: <span id="sol">-</span></div>
</div>

<div class="panel">
<h3>Budget USDC</h3>
<input id="budget" type="number" value="50">
<button onclick="deposit()">DEPOSIT</button>
</div>

<script src="/wolverine/vendor/solana-web3.min.js"></script>
<script>
let provider=null, pubkey=null;

async function connectPhantom(){
 if(!window.solana){alert("Phantom not found");return;}
 provider=window.solana;
 const r=await provider.connect();
 pubkey=r.publicKey.toString();
 document.getElementById("addr").textContent=pubkey;
 loadBalance();
}

async function loadBalance(){
 const c=new solanaWeb3.Connection(solanaWeb3.clusterApiUrl("mainnet-beta"));
 const lamports=await c.getBalance(new solanaWeb3.PublicKey(pubkey));
 document.getElementById("sol").textContent=(lamports/1e9).toFixed(4);
}

function startBot(){
 fetch("/wolverine/traderone/api/start",{method:"POST",headers:{"Content-Type":"application/json"},
 body:JSON.stringify({pub:pubkey,budget:+document.getElementById("budget").value})});
 alert("TraderOne STARTED");
}
function pauseBot(){alert("PAUSE")}
function stopBot(){alert("STOP")}
function deposit(){alert("Budget ready")}
</script>
</body></html>
HTML

### BACKEND SIMPLE (SOL BALANCE OK)
mkdir -p "$API"
cat > "$API/server.js" <<'JS'
const express=require("express");
const {Connection,PublicKey}=require("@solana/web3.js");
const app=express();app.use(express.json());
const c=new Connection("https://api.mainnet-beta.solana.com");
app.post("/start",(req,res)=>res.json({ok:true}));
app.get("/balances/:pub",async(req,res)=>{
 const lamports=await c.getBalance(new PublicKey(req.params.pub));
 res.json({sol:lamports/1e9});
});
app.listen(3010,()=>console.log("TraderOne API 3010"));
JS

cd "$API"
npm init -y >/dev/null
npm install express @solana/web3.js >/dev/null

pkill -f server.js || true
node server.js >/dev/null 2>&1 &

systemctl reload nginx

echo "=== DONE – REFRESH https://fireinners.online/wolverine ==="
EOF
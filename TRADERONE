bash <<'EOF'
set -e

echo "=== AIAQUILA — FIX RSS PARSING ==="

AIA=/var/www/aiaquila

cat > $AIA/index.html <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{font-family:Arial;background:#0b1220;color:#e5e7eb;padding:20px}
button{padding:8px 12px;margin:5px}
.article{margin:6px 0;padding:6px;border-bottom:1px solid #333}
small{color:#9ca3af}
</style>

<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="load()">Lire les articles</button>
<div id="log"></div>

<script>
const feeds=[
 "https://www.coindesk.com/arc/outboundfeeds/rss/",
 "https://cointelegraph.com/rss",
 "https://news.bitcoin.com/feed/"
];

async function load(){
 log("Démarrage RSS…");
 let total=0;
 for(const url of feeds){
  try{
   const r=await fetch("proxy.php?url="+encodeURIComponent(url));
   const t=await r.text();
   const xml=new DOMParser().parseFromString(t,"text/xml");

   const items=[
     ...xml.querySelectorAll("item"),
     ...xml.querySelectorAll("entry")
   ];

   log("Flux "+url+" → "+items.length+" articles");
   items.forEach(it=>{
     const title=it.querySelector("title")?.textContent||"Sans titre";
     const link=it.querySelector("link")?.getAttribute("href")||
                it.querySelector("link")?.textContent||"#";
     add(title,link);
   });
   total+=items.length;
  }catch(e){
   log("Erreur "+url+" : "+e);
  }
 }
 log("TOTAL : "+total+" articles");
}

function add(t,l){
 const d=document.createElement("div");
 d.className="article";
 d.innerHTML="<a href='"+l+"' target=_blank>"+t+"</a>";
 document.body.appendChild(d);
}
function log(t){
 document.getElementById("log").innerHTML+=t+"<br>";
}
</script>
</html>
HTML

chown www-data:www-data $AIA/index.html
chmod 644 $AIA/index.html

echo "=== OK ==="
echo "CTRL+F5 puis clique Lire les articles"
EOF
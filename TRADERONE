set -e

echo "=== 1) Qui écoute sur 3000/3002 ? ==="
ss -ltnp | egrep ':3000|:3002' || true
echo

echo "=== 2) KILL le node qui prend 3002 (si pas PM2 traderone) ==="
PID3002=$(ss -ltnp | sed -n 's/.*:3002.*pid=\([0-9]\+\).*/\1/p' | head -n1 || true)
echo "PID3002=$PID3002"
if [ -n "$PID3002" ]; then
  ps -fp "$PID3002" || true
  echo "--- cmdline ---"
  tr '\0' ' ' < /proc/"$PID3002"/cmdline 2>/dev/null || true
  echo
  echo "KILL pid $PID3002 (3002)"
  kill "$PID3002" || true
  sleep 1
  kill -9 "$PID3002" 2>/dev/null || true
fi
echo

echo "=== 3) Voir les vhosts activés (sites-enabled) ==="
ls -lah /etc/nginx/sites-enabled | sed -n '1,200p'
echo

echo "=== 4) Où sont les server_name fireinners.* dans les 2 vhosts activés ==="
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  echo "--- $f ---"
  grep -nE 'server_name' "$f" || true
done
echo

echo "=== 5) Désactiver le vhost NON-SSL si doublon (garde -ssl) ==="
# (on garde fireinners.online-ssl, et on désactive fireinners.online si les 2 existent)
if [ -f /etc/nginx/sites-enabled/fireinners.online ] && [ -f /etc/nginx/sites-enabled/fireinners.online-ssl ]; then
  mv /etc/nginx/sites-enabled/fireinners.online \
     /etc/nginx/sites-enabled/fireinners.online.disabled.$(date +%s)
  echo "OK: fireinners.online désactivé (doublon)"
else
  echo "INFO: un seul vhost présent, rien à désactiver"
fi
echo

echo "=== 6) Test + reload nginx ==="
nginx -t
systemctl reload nginx
echo "nginx reloaded"
echo

echo "=== 7) Re-check ports + tests ==="
ss -ltnp | egrep ':3000|:3002|:8585' || true
echo
curl -sS -i http://127.0.0.1:3000/health | head -n 20 || true
echo
curl -sS -i https://fireinners.online/api/health | head -n 20 || true
echo "=== FIN ==="
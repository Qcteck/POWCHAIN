cat >/root/WOLVERINE_FIX_VAULT_ONLY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%s)"

echo "=== FIX VAULT ONLY (ISOLATED) ==="

[ -f "$HTML" ] || { echo "index.html introuvable"; exit 1; }

cp "$HTML" "$HTML.bak.$TS"

python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text()

# 1) Supprimer anciens blocs Vault
import re
s=re.sub(r'<section[^>]*id="vault[^"]*"[\s\S]*?</section>','',s,flags=re.I)

# 2) Ajouter Vault isolé avant </body>
vault_html="""
<section id="vault" style="border:2px solid #00e0ff;padding:12px;margin-top:20px">
<h3>Vault</h3>
<button id="vaultCreate">Créer mon Vault</button><br><br>
<div>Vault: <span id="vaultAddr">—</span></div>
<div>Vault SOL: <span id="vaultSol">—</span></div><br>
<input id="vaultAmount" placeholder="Montant SOL" style="width:160px">
<button id="vaultDeposit">Déposer SOL</button>
</section>

<script>
let vaultPubkey=null;

async function solConnection(){
  return new solanaWeb3.Connection(
    "https://api.mainnet-beta.solana.com",
    "confirmed"
  );
}

document.getElementById("vaultCreate").onclick=async()=>{
  const kp=solanaWeb3.Keypair.generate();
  vaultPubkey=kp.publicKey;
  window.__VAULT_KEYPAIR__=kp;
  document.getElementById("vaultAddr").innerText=vaultPubkey.toBase58();
  refreshVaultSol();
};

async function refreshVaultSol(){
  if(!vaultPubkey) return;
  const c=await solConnection();
  const bal=await c.getBalance(vaultPubkey);
  document.getElementById("vaultSol").innerText=(bal/1e9).toFixed(6);
}

document.getElementById("vaultDeposit").onclick=async()=>{
  if(!window.solana?.isPhantom) return alert("Phantom requis");
  if(!vaultPubkey) return alert("Créer le Vault d'abord");
  const amt=parseFloat(document.getElementById("vaultAmount").value||0);
  if(amt<=0) return alert("Montant invalide");

  const provider=window.solana;
  const c=await solConnection();

  const tx=new solanaWeb3.Transaction().add(
    solanaWeb3.SystemProgram.transfer({
      fromPubkey:provider.publicKey,
      toPubkey:vaultPubkey,
      lamports:Math.floor(amt*1e9)
    })
  );

  tx.feePayer=provider.publicKey;
  tx.recentBlockhash=(await c.getLatestBlockhash()).blockhash;

  const signed=await provider.signTransaction(tx);
  await c.sendRawTransaction(signed.serialize());
  setTimeout(refreshVaultSol,2000);
};
</script>
"""

s=s.replace("</body>",vault_html+"\n</body>")
p.write_text(s)
print("Vault isolé injecté")
PY

nginx -t && systemctl reload nginx
echo "=== DONE — CTRL+SHIFT+R ==="

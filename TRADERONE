async function connectPhantom(){try{const ph=window.solana; if(!ph||!ph.isPhantom){$("#exSt").value="Phantom absent";add("SYS","Phantom non détecté.","sys");return;}
S.phantom=ph; const r=await ph.connect(); const pub=(r&&r.publicKey)?r.publicKey.toString():(ph.publicKey?ph.publicKey.toString():"");
$("#pub").value=pub||"—"; $("#exSt").value=pub?"PHANTOM OK":"—"; add("SYS","Phantom connecté: "+pub,"sys");}catch(e){$("#exSt").value="CONNECT FAIL";add("SYS","Phantom connect fail: "+e,"sys");}}
async function policy(){try{const j=await api("exec/policy").then(r=>r.json());$("#exSt").value=(j.allow&&j.allow.killSwitch)?"KILL ON":"POLICY OK";

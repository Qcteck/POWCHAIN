if [ "$code" = "200" ]; then
  rm -f "$STATE"
  exit 0
fi

n=0; [ -f "$STATE" ] && n="$(cat "$STATE" 2>/dev/null || echo 0)"
n=$((n+1)); echo "$n" > "$STATE"


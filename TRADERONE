set -e
cd /opt/traderone-opt

echo "=== A) PM2: quel fichier tourne VRAIMENT ? ==="
pm2 describe 0 | egrep -i 'script path|pm_exec_path|cwd|interpreter|exec' || true
echo

echo "=== B) PID + cmdline du process ==="
PID=$(pm2 pid 0)
echo "PID=$PID"
ps -fp "$PID" || true
echo "cmdline:"
tr '\0' ' ' < /proc/"$PID"/cmdline; echo
echo

echo "=== C) Est-ce que /api/dexes est dans le server.js patché ? ==="
grep -nE 'app\.get\(\s*["'\'']\/api\/dexes["'\'']' server.js || echo "ABSENT dans /opt/traderone-opt/server.js"
echo

echo "=== D) Test une route EXISTANTE (pour comparer) ==="
curl -sS -i http://127.0.0.1:3000/api/status | head -n 20 || true
echo
curl -sS -i http://127.0.0.1:3000/api/dexes | head -n 20 || true
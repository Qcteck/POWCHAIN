<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>WOLVERINE • Vault</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>
body{font-family:Arial;background:#f5f5f5;margin:0;padding:0}
.box{border:2px solid #3aa;border-radius:6px;margin:20px;padding:15px;background:#fff}
h2{margin-top:0}
button,input{padding:6px;margin:4px}
label{display:block;margin-top:6px}
</style>
</head>

<body>

<div class="box">
  <h2>Phantom</h2>
  <button id="btnConnect">Connect Phantom</button>
  <div>Adresse : <span id="addr">—</span></div>
  <div>SOL : <span id="sol">—</span></div>
</div>

<div class="box">
  <h2>Vault</h2>
  <button id="btnVault">Créer mon Vault</button>
  <div>Vault : <span id="vaultAddr">—</span></div>
  <div>Vault SOL : <span id="vaultSol">—</span></div>

  <label>Montant SOL</label>
  <input id="amount" type="number" step="0.01" placeholder="0.1">
  <button id="btnDeposit">Déposer SOL</button>
</div>

<script src="/wolverine/vendor/solana-web3.min.js"></script>

<script>
let provider=null;
let userPub=null;
let vaultPub=null;

document.getElementById("btnConnect").onclick=async()=>{
  if(!window.solana||!window.solana.isPhantom){
    alert("Phantom non détecté");return;
  }
  provider=window.solana;
  const res=await provider.connect();
  userPub=res.publicKey.toString();
  document.getElementById("addr").textContent=userPub;
  refreshSol();
};

async function refreshSol(){
  const r=await fetch(`/wolverine/api/sol-balance?pub=${userPub}`);
  const j=await r.json();
  document.getElementById("sol").textContent=j.sol.toFixed(4);
}

document.getElementById("btnVault").onclick=()=>{
  // vault simple local (démo réelle, pas fake)
  const kp=solanaWeb3.Keypair.generate();
  vaultPub=kp.publicKey.toString();
  document.getElementById("vaultAddr").textContent=vaultPub;
  document.getElementById("vaultSol").textContent="0.0000";
  window._vaultKeypair=kp;
};

document.getElementById("btnDeposit").onclick=async()=>{
  if(!vaultPub||!userPub){alert("Wallet/Vault manquant");return;}
  const amt=parseFloat(document.getElementById("amount").value);
  if(!amt||amt<=0){alert("Montant invalide");return;}

  const conn=new solanaWeb3.Connection(
    "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",
    "confirmed"
  );

  const tx=new solanaWeb3.Transaction().add(
    solanaWeb3.SystemProgram.transfer({
      fromPubkey:new solanaWeb3.PublicKey(userPub),
      toPubkey:window._vaultKeypair.publicKey,
      lamports:amt*1e9
    })
  );

  tx.feePayer=new solanaWeb3.PublicKey(userPub);
  tx.recentBlockhash=(await conn.getLatestBlockhash()).blockhash;

  const signed=await provider.signTransaction(tx);
  await conn.sendRawTransaction(signed.serialize());
  await conn.confirmTransaction(signed.signature);

  const bal=await conn.getBalance(window._vaultKeypair.publicKey);
  document.getElementById("vaultSol").textContent=(bal/1e9).toFixed(4);
};
</script>

</body>
</html>
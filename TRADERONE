cat >/tmp/WOLVERINE_SHOW_USER_AND_TRADERONE_BALANCES.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOCROOT="/var/www/fireinners/wolverine"
SERVER_JS="/opt/traderone-opt/server.js"
TS="$(date +%s)"
DOMAIN="fireinners.online"

# USDC mainnet mint
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
KEYFILE="/opt/traderone-opt/keys/traderone_deposit.json"

echo "== 0) Sanity =="
[ -f "$SERVER_JS" ] || { echo "ERROR server.js introuvable: $SERVER_JS"; exit 1; }
[ -f "$KEYFILE" ] || { echo "ERROR keyfile TraderOne introuvable: $KEYFILE"; exit 1; }
mkdir -p "$DOCROOT"

echo "== 1) Patch backend: route /api/balances2 (user + traderone) =="
cp -a "$SERVER_JS" "$SERVER_JS.bak.$TS"

# Ajoute constantes si manquantes
grep -q 'USDC_MINT' "$SERVER_JS" || sed -i "1i const USDC_MINT = process.env.USDC_MINT || \"$USDC_MINT\";" "$SERVER_JS"
grep -q 'TRADERONE_DEPOSIT_KEYFILE' "$SERVER_JS" || sed -i "1i const TRADERONE_DEPOSIT_KEYFILE = process.env.TRADERONE_DEPOSIT_KEYFILE || \"$KEYFILE\";" "$SERVER_JS"

# Ajoute helper loadTraderOneKeypair si manquant
if ! grep -q "function loadTraderOneKeypair" "$SERVER_JS"; then
  perl -0777 -i -pe '
    s/(const\s+\{\s*PublicKey[\s\S]*?\}\s*=\s*require\([^\)]*\);\s*\n)/$1
function loadTraderOneKeypair() {
  const fs = require("fs");
  const { Keypair } = require("@solana/web3.js");
  const secret = Uint8Array.from(JSON.parse(fs.readFileSync(TRADERONE_DEPOSIT_KEYFILE, "utf8")));
  return Keypair.fromSecretKey(secret);
}

async function getUsdcSum(ownerPk) {
  const tokRes = await connection.getParsedTokenAccountsByOwner(
    ownerPk,
    { mint: new PublicKey(USDC_MINT) },
    "confirmed"
  );
  let usdc = 0;
  for (const a of (tokRes.value || [])) {
    const ui = a?.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
    const amtStr = a?.account?.data?.parsed?.info?.tokenAmount?.amount;
    const dec = a?.account?.data?.parsed?.info?.tokenAmount?.decimals ?? 6;
    if (ui !== null && ui !== undefined) usdc += Number(ui) || 0;
    else if (amtStr) usdc += (Number(amtStr) || 0) / (10 ** dec);
  }
  return { usdc, accounts: (tokRes.value || []).length };
}

$/s;
  ' "$SERVER_JS"
fi

# Supprime une ancienne route balances2 si elle existe déjà
perl -0777 -i -pe 's/app\.get\(\s*["\047]\/api\/balances2["\047][\s\S]*?\);\s*\n//gms' "$SERVER_JS"

# Insère la nouvelle route balances2 juste après /api/deposit-address si possible, sinon à la fin
perl -0777 -i -pe '
my $route = qq{
app.get("/api/balances2", async (req, res) => {
  try {
    const wallet = (req.query.wallet || "").toString().trim();
    if (!wallet) return res.status(400).json({ error: "wallet missing" });

    const userPk = new PublicKey(wallet);
    const traderKp = loadTraderOneKeypair();
    const traderPk = traderKp.publicKey;

    const [userLam, traderLam] = await Promise.all([
      connection.getBalance(userPk, "confirmed"),
      connection.getBalance(traderPk, "confirmed"),
    ]);

    const [userU, traderU] = await Promise.all([
      getUsdcSum(userPk),
      getUsdcSum(traderPk),
    ]);

    return res.json({
      user:   { sol: userLam / 1e9,   usdc: userU.usdc,   usdcAccounts: userU.accounts },
      trader: { sol: traderLam / 1e9, usdc: traderU.usdc, usdcAccounts: traderU.accounts },
      traderWallet: traderPk.toBase58(),
      usdcMint: USDC_MINT
    });
  } catch (e) {
    return res.status(500).json({ error: (e && e.message) ? e.message : String(e) });
  }
});
};

if ($_ =~ /app\.get\(\s*["\047]\/api\/deposit-address["\047][\s\S]*?\);\s*\n/s) {
  s/(app\.get\(\s*["\047]\/api\/deposit-address["\047][\s\S]*?\);\s*\n)/$1$route\n/s;
} else {
  $_ .= "\n$route\n";
}
' "$SERVER_JS"

echo "== 2) Restart traderone =="
systemctl restart traderone.service
sleep 1
systemctl status traderone.service --no-pager -l | sed -n '1,25p' || true
echo

echo "== 3) Overwrite FRONT (index.html + app.js) =="
[ -f "$DOCROOT/index.html" ] && cp -a "$DOCROOT/index.html" "$DOCROOT/index.html.bak.$TS" || true
[ -f "$DOCROOT/app.js" ] && cp -a "$DOCROOT/app.js" "$DOCROOT/app.js.bak.$TS" || true


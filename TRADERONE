cat >/root/AIAQUILA_FIX_ROOT.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

SITE_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$SITE_DIR/index.html"
BACKUP="$SITE_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"
WORKER="https://aiaquila-proxy.paycashnostory.workers.dev/rss"
FEED="https://news.bitcoin.com/feed/"

echo "=== AIAQUILA ROOT FIX ==="

command -v curl >/dev/null || exit 1
command -v nginx >/dev/null || exit 1

ENC_FEED=$(python3 - <<PY
import urllib.parse;print(urllib.parse.quote("$FEED",safe=""))
PY
)

HTTP=$(curl -s -o /tmp/aq.json -w "%{http_code}" "$WORKER?url=$ENC_FEED")
[ "$HTTP" = "200" ] || { echo "Worker KO"; exit 1; }
jq . /tmp/aq.json >/dev/null

cp -a "$INDEX" "$BACKUP"

cat >"$INDEX"<<'HTML'
<!doctype html><html lang="fr"><meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>body{background:#0b1b3a;color:#fff;font-family:system-ui;padding:20px}button{padding:10px}</style>
<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="go()">Lire les articles</button>
<pre id=o>En attente…</pre>
<script>
const W="https://aiaquila-proxy.paycashnostory.workers.dev/rss";
const F="https://news.bitcoin.com/feed/";
async function go(){
o.textContent="Chargement…";
try{
const r=await fetch(W+"?url="+encodeURIComponent(F),{cache:"no-store"});
if(!r.ok)throw r.status;
const j=await r.json();
o.textContent=j.items.map(x=>"• "+x.title+"\n"+x.link).join("\n\n");
}catch(e){o.textContent="ERREUR "+e;}
}
</script>
HTML

chown www-data:www-data "$INDEX"
chmod 644 "$INDEX"

nginx -t
systemctl reload nginx

curl -fsS https://fireinners.online/aiaquila/ >/dev/null

echo "OK — AIAQUILA RÉPARÉ"
echo "Backup: $BACKUP"
EOF
chmod +x /root/AIAQUILA_FIX_ROOT.sh
/root/AIAQUILA_FIX_ROOT.sh
"use strict";
require("dotenv").config();
const fs=require("fs");
const path=require("path");
const crypto=require("crypto");
const express=require("express");
const cors=require("cors");
const bs58=require("bs58");
const nacl=require("tweetnacl");
const {Connection,PublicKey,Keypair,VersionedTransaction}=require("@solana/web3.js");

const PORT=Number(process.env.PORT||3050);
const RPC_URL=String(process.env.RPC_URL||"");
const USDC_MINT=String(process.env.USDC_MINT||"");
const WSOL_MINT=String(process.env.WSOL_MINT||"");
const SLIPPAGE_BPS=Number(process.env.SLIPPAGE_BPS||200);
const MONITOR_URL=String(process.env.MONITOR_URL||"");
const MONITOR_SEC=Number(process.env.MONITOR_SEC||10);
const MONITOR_FAILS=Number(process.env.MONITOR_FAILS||3);
const WOLV_SEND=String(process.env.WOLV_SEND||"");

const STATED=path.join(__dirname,"state");
const WALLET_JSON=path.join(STATED,"custody.json");
const WALLET_PUB=path.join(STATED,"custody.pub");
const RUNTIME_JSON=path.join(STATED,"runtime.json");

if(!fs.existsSync(STATED)) fs.mkdirSync(STATED,{recursive:true});

function readJson(p,def){try{return JSON.parse(fs.readFileSync(p,"utf8"));}catch(e){return def;}}
function writeJson(p,obj){fs.writeFileSync(p,JSON.stringify(obj,null,2));}
function now(){return Date.now();}

function loadOrCreateCustody(){
  try{
    const arr=readJson(WALLET_JSON,null);
    if(Array.isArray(arr)){
      const kp=Keypair.fromSecretKey(Uint8Array.from(arr));
      fs.writeFileSync(WALLET_PUB,kp.publicKey.toBase58());
      return kp;
    }
  }catch(e){}
  const kp=Keypair.generate();
  writeJson(WALLET_JSON,Array.from(kp.secretKey));
  fs.writeFileSync(WALLET_PUB,kp.publicKey.toBase58());
  return kp;
}
const custody=loadOrCreateCustody();
const custodyPub=custody.publicKey.toBase58();

const conn=new Connection(RPC_URL,{commitment:"confirmed"});

async function getSol(pub){
  const lam=await conn.getBalance(new PublicKey(pub),"confirmed");
  return lam/1e9;
}
async function getSpl(pub,mint){
  const owner=new PublicKey(pub);
  const m=new PublicKey(mint);
  const accts=await conn.getParsedTokenAccountsByOwner(owner,{mint:m},"confirmed");
  let sum=0;
  for(const a of accts.value){
    const ui=a.account.data.parsed.info.tokenAmount.uiAmount;
    sum+=Number(ui||0);
  }
  return sum;
}

let loopTimer=null;
let loopState={running:false,sec:MONITOR_SEC,lastTick:0,fails:0,lastResp:"",lastErr:"",lastPingOk:false};

let sessions=new Map(); // token -> {pub,created,budgetUsdc,mode,mint}
let challenges=new Map(); // pub -> challenge

function randToken(n=24){return crypto.randomBytes(n).toString("hex");}

async function sendAlert(type,msg){
  try{
    if(!WOLV_SEND) return;
    if(!fs.existsSync(WOLV_SEND)) return;
    const {execFile}=require("child_process");
    execFile(WOLV_SEND,[`${type}: ${msg}`],()=>{});
  }catch(e){}
}

async function jupSwapUSDCToMint(outputMint,usdcAmountUi){
  // usdcAmountUi is UI (ex: 25.5), Jupiter wants integer amount in base units (6 decimals)
  const amount=Math.floor(Number(usdcAmountUi)*1e6);
  if(!Number.isFinite(amount)||amount<=0) throw new Error("bad amount");
  const qurl=`https://quote-api.jup.ag/v6/quote?inputMint=${encodeURIComponent(USDC_MINT)}&outputMint=${encodeURIComponent(outputMint)}&amount=${amount}&slippageBps=${SLIPPAGE_BPS}`;
  const q=await fetch(qurl,{headers:{"accept":"application/json"}});
  if(!q.ok) throw new Error(`quote ${q.status}`);
  const quote=await q.json();
  const s=await fetch("https://quote-api.jup.ag/v6/swap",{
    method:"POST",
    headers:{"content-type":"application/json","accept":"application/json"},
    body:JSON.stringify({
      quoteResponse:quote,
      userPublicKey:custodyPub,
      wrapAndUnwrapSol:true,
      dynamicComputeUnitLimit:true,
      prioritizationFeeLamports:"auto"
    })
  });
  if(!s.ok) throw new Error(`swap ${s.status}`);
  const sw=await s.json();
  if(!sw.swapTransaction) throw new Error("no swapTransaction");
  const tx=VersionedTransaction.deserialize(Buffer.from(sw.swapTransaction,"base64"));
  tx.sign([custody]);
  const sig=await conn.sendRawTransaction(tx.serialize(),{maxRetries:3});
  const conf=await conn.confirmTransaction(sig,"confirmed");
  return {sig,conf};
}

const app=express();
app.use(cors());
app.use(express.json({limit:"1mb"}));

app.get("/",(req,res)=>res.type("text/plain").send("wolverine-api"));
app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));
app.get("/health",(req,res)=>res.json({ok:true,uptime:process.uptime(),ts:now()}));

app.get("/wallet",(req,res)=>res.json({ok:true,pub:custodyPub}));

app.get("/config",(req,res)=>{
  const rt=readJson(RUNTIME_JSON,{});
  res.json({
    ok:true,
    port:PORT,
    rpc:RPC_URL,
    usdcMint:USDC_MINT,
    slippageBps:SLIPPAGE_BPS,
    monitorUrl:MONITOR_URL,
    monitorSec:loopState.sec,
    monitorFails:MONITOR_FAILS,
    loop:loopState,
    custodyPub,
    runtime:rt
  });
});

app.get("/status",async(req,res)=>{
  try{
    const sol=await getSol(custodyPub);
    const usdc=await getSpl(custodyPub,USDC_MINT);
    const rt=readJson(RUNTIME_JSON,{});
    res.json({ok:true,custody:{pub:custodyPub,sol,usdc},loop:loopState,runtime:rt,ts:now()});
  }catch(e){
    res.status(500).json({ok:false,error:String(e&&e.message||e)});
  }
});

// Phantom signature auth (no private key input)
app.post("/auth/challenge",(req,res)=>{
  const pub=String((req.body&&req.body.pub)||"").trim();
  if(!pub) return res.status(400).json({ok:false,error:"missing pub"});
  const c="WOLVERINE_AUTH:"+randToken(12)+":ts="+now();
  challenges.set(pub,c);
  res.json({ok:true,challenge:c});
});

app.post("/auth/verify",(req,res)=>{
  try{
    const pub=String(req.body.pub||"").trim();
    const sigb58=String(req.body.signature||"").trim();
    const challenge=String(req.body.challenge||"").trim();
    const expected=challenges.get(pub);
    if(!expected||expected!==challenge) return res.status(400).json({ok:false,error:"bad challenge"});
    const pk=new PublicKey(pub);
    const msg=new TextEncoder().encode(challenge);
    const sig=bs58.decode(sigb58);
    const ok=nacl.sign.detached.verify(msg,sig,pk.toBytes());
    if(!ok) return res.status(401).json({ok:false,error:"bad signature"});
    const token=randToken(18);
    sessions.set(token,{pub,created:now(),budgetUsdc:0,mode:"safe",mint:""});
    challenges.delete(pub);
    res.json({ok:true,token});
  }catch(e){
    res.status(500).json({ok:false,error:String(e&&e.message||e)});
  }
});

function getSession(req){
  const t=String(req.headers["x-session"]||"").trim();
  if(!t) return null;
  return sessions.get(t)||null;
}

app.post("/session/set",(req,res)=>{
  const s=getSession(req);
  if(!s) return res.status(401).json({ok:false,error:"no session"});
  const budget=Number(req.body.budgetUsdc||0);
  const mode=String(req.body.mode||"safe");
  const mint=String(req.body.mint||"").trim();
  if(!(budget>0)) return res.status(400).json({ok:false,error:"bad budget"});
  if(!mint) return res.status(400).json({ok:false,error:"missing mint"});
  s.budgetUsdc=budget;
  s.mode=mode;
  s.mint=mint;
  sessions.set(String(req.headers["x-session"]),s);
  res.json({ok:true,session:{pub:s.pub,budgetUsdc:s.budgetUsdc,mode:s.mode,mint:s.mint}});
});

// loop: ping MONITOR_URL + optional trade tick (monitoring first)
async function tick(){
  loopState.lastTick=now();
  loopState.lastErr="";
  try{
    if(MONITOR_URL){
      const r=await fetch(MONITOR_URL,{method:"GET"});
      const t=await r.text();
      loopState.lastResp=(t||"").slice(0,120);
      loopState.lastPingOk=r.ok && /pong/i.test(loopState.lastResp);
      if(!loopState.lastPingOk){
        loopState.fails++;
        if(loopState.fails>=MONITOR_FAILS){
          await sendAlert("WOLVERINE MONITOR","ERR "+loopState.lastResp);
          loopState.fails=0;
        }
      }else{
        loopState.fails=0;
      }
    }
  }catch(e){
    loopState.lastErr=String(e&&e.message||e);
    loopState.fails++;
    if(loopState.fails>=MONITOR_FAILS){
      await sendAlert("WOLVERINE MONITOR","ERR "+loopState.lastErr);
      loopState.fails=0;
    }
  }
}

app.post("/loop/start",(req,res)=>{
  const s=getSession(req);
  if(!s) return res.status(401).json({ok:false,error:"no session"});
  if(loopTimer) return res.json({ok:true,already:true,loop:loopState});
  loopState.running=true;
  loopState.sec=Math.max(3,Number(req.body.sec||MONITOR_SEC||10));
  loopTimer=setInterval(()=>{tick().catch(()=>{});},loopState.sec*1000);
  tick().catch(()=>{});
  res.json({ok:true,loop:loopState});
});

app.post("/loop/stop",(req,res)=>{
  const s=getSession(req);
  if(!s) return res.status(401).json({ok:false,error:"no session"});
  if(loopTimer){ clearInterval(loopTimer); loopTimer=null; }
  loopState.running=false;
  res.json({ok:true,loop:loopState});
});

app.post("/trade/buy",async(req,res)=>{
  const s=getSession(req);
  if(!s) return res.status(401).json({ok:false,error:"no session"});
  try{
    const mint=String(req.body.mint||s.mint||"").trim();
    const budget=Number(req.body.budgetUsdc||s.budgetUsdc||0);
    if(!mint) return res.status(400).json({ok:false,error:"missing mint"});
    if(!(budget>0)) return res.status(400).json({ok:false,error:"bad budget"});
    // safety: do not exceed custody available USDC
    const available=await getSpl(custodyPub,USDC_MINT);
    const spend=Math.min(budget,available);
    if(!(spend>0)) return res.status(400).json({ok:false,error:"no usdc available in custody"});
    const out=await jupSwapUSDCToMint(mint,spend);
    await sendAlert("WOLVERINE TRADE","BUY "+spend+" USDC -> "+mint+" sig="+out.sig);
    res.json({ok:true,spentUsdc:spend,tx:out});
  }catch(e){
    res.status(500).json({ok:false,error:String(e&&e.message||e)});
  }
});

const server=app.listen(PORT,()=>console.log("wolverine-api on",PORT,"custody",custodyPub));
process.on("SIGTERM",()=>{ try{server.close(()=>process.exit(0));}catch(e){process.exit(0);} });

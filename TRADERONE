
set -euo pipefail

WORK="/root/phantom-docker"
OUT="/root/phantom-out"
mkdir -p "$WORK" "$OUT"
cd "$WORK"

# render.js (bypass cloudflare + ignore SSL)
cat > render.js <<'JS'
var page = require('webpage').create();
var system = require('system');

var url = system.args[1];
var out = system.args[2];

page.viewportSize = { width: 1400, height: 900 };
page.settings.ignoreSslErrors = true;
page.settings.webSecurityEnabled = false;
page.settings.sslProtocol = "any";
page.customHeaders = { "Host": "fireinners.online" };

page.onConsoleMessage = function(msg){ console.log("[page]", msg); };
page.onError = function(msg){ console.log("[error]", msg); };

page.open(url, function(status) {
  console.log("OPEN:", status, url);
  if (status !== 'success') phantom.exit(2);

  window.setTimeout(function() {
    page.render(out);
    console.log("OK wrote", out);
    phantom.exit(0);
  }, 2000);
});
JS

# Nettoie l'ancien output
rm -f "$OUT/test.png" 2>/dev/null || true

# IMPORTANT: --network host pour atteindre 127.0.0.1 du VPS
timeout 40s docker run --rm --network host \
  -e OPENSSL_CONF=/dev/null -e OPENSSL_MODULES=/dev/null \
  -v "$OUT":/out -v "$WORK":/work -w /work \
  phantom-local:2.1.1 \
  phantomjs render.js "https://127.0.0.1/test/" "/out/test.png" || true

ls -lah "$OUT/test.png" || true







cat >/root/WOLVERINE_PHANTOM_VAULT_RESTORE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%s)"

echo "=== WOLVERINE PHANTOM + VAULT RESTORE ==="

[ -f "$HTML" ] || { echo "index.html introuvable"; exit 1; }
cp "$HTML" "$HTML.bak.restore.$TS"

python3 - <<'PY'
from pathlib import Path
import re

p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# 1) DÉSACTIVER TOUS LES VAULTS EXISTANTS (sans supprimer Phantom)
s=re.sub(
    r'(<section[^>]*id="vault[^"]*"[^>]*>)',
    r'\1<!-- DISABLED -->',
    s,
    flags=re.I
)

# 2) AJOUT DU BLOC PHANTOM + VAULT UNIQUE À LA FIN
block = """
<section id="phantom" style="border:1px solid #444;padding:12px;margin-top:20px">
<h3>Phantom</h3>
<button id="connectPhantom">Connect Phantom</button>
<div>Adresse: <span id="userAddr">—</span></div>
<div>SOL: <span id="userSol">—</span></div>
</section>

<section id="vault" style="border:2px solid #00e0ff;padding:16px;margin-top:20px">
<h3>Vault</h3>
<button id="vaultCreate">Créer mon Vault</button>
<div>Vault: <span id="vaultAddr">—</span></div>
<div>Vault SOL: <span id="vaultSol">—</span></div>
<input id="vaultAmount" placeholder="Montant SOL">
<button id="vaultDeposit">Déposer SOL</button>
</section>

<script>
(async()=>{
const RPC="https://api.mainnet-beta.solana.com";
let vaultPub=null;

const conn=()=>new solanaWeb3.Connection(RPC,"confirmed");

document.getElementById("connectPhantom").onclick=async()=>{
 if(!window.solana?.isPhantom) return alert("Phantom requis");
 const r=await solana.connect();
 document.getElementById("userAddr").innerText=r.publicKey.toBase58();
 const bal=await conn().getBalance(r.publicKey);
 document.getElementById("userSol").innerText=(bal/1e9).toFixed(6);
};

document.getElementById("vaultCreate").onclick=()=>{
 const kp=solanaWeb3.Keypair.generate();
 window.__VAULT__=kp;
 vaultPub=kp.publicKey;
 document.getElementById("vaultAddr").innerText=vaultPub.toBase58();
};

document.getElementById("vaultDeposit").onclick=async()=>{
 if(!vaultPub) return alert("Créer le vault");
 const amt=parseFloat(document.getElementById("vaultAmount").value||0);
 if(amt<=0) return alert("Montant invalide");

 const c=conn();
 const tx=new solanaWeb3.Transaction().add(
  solanaWeb3.SystemProgram.transfer({
   fromPubkey:solana.publicKey,
   toPubkey:vaultPub,
   lamports:Math.floor(amt*1e9)
  })
 );
 tx.feePayer=solana.publicKey;
 tx.recentBlockhash=(await c.getLatestBlockhash()).blockhash;
 const signed=await solana.signTransaction(tx);
 const sig=await c.sendRawTransaction(signed.serialize());
 await c.confirmTransaction(sig);
 const bal=await c.getBalance(vaultPub);
 document.getElementById("vaultSol").innerText=(bal/1e9).toFixed(6);
};
})();
</script>
"""

s=s.replace("</body>", block+"\n</body>")
p.write_text(s)
print("PHANTOM + VAULT RESTAURÉS")
PY

nginx -t && systemctl reload nginx
echo "=== TERMINÉ — CTRL+SHIFT+R ==="

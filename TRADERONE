cat > "$PROXY_JS" <<'JS'
"use strict";
const http=require("http"),https=require("https");
const {URL}=require("url");

const PORT=parseInt(process.env.PORT||"12703",10);
const HOST=process.env.HOST||"127.0.0.1";

const UPSTREAMS=[
  "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",
  "https://api.mainnet-beta.solana.com",
  "https://solana-rpc.publicnode.com",
  "https://rpc.ankr.com/solana"
];

function readBody(req){
  return new Promise((res,rej)=>{
    let b="";
    req.on("data",c=>{ b+=c; if(b.length>2e6){ rej(new Error("Body too big")); req.destroy(); }});
    req.on("end",()=>res(b));
    req.on("error",rej);
  });
}
function doPost(urlStr, body, timeoutMs=9000){
  return new Promise((resolve,reject)=>{
    const u=new URL(urlStr);
    const isHttps=u.protocol==="https:";
    const mod=isHttps?https:http;
    const opts={
      method:"POST",
      hostname:u.hostname,
      port:u.port|| (isHttps?443:80),
      path:u.pathname + (u.search||""),
      headers:{
        "content-type":"application/json",
        "accept":"application/json",
        "user-agent":"fireinners-solrpc-proxy/1.1",
        "content-length":Buffer.byteLength(body)
      },
      timeout:timeoutMs
    };
    const r=mod.request(opts,(resp)=>{
      let data="";
      resp.on("data",c=>data+=c);
      resp.on("end",()=>resolve({status:resp.statusCode||0, data}));
    });
    r.on("timeout",()=>{ r.destroy(new Error("timeout")); });
    r.on("error",reject);
    r.write(body); r.end();
  });
}
function retryable(status, data){
  if(status===0) return true;
  if(status>=500) return true;
  try{
    const j=JSON.parse(data);
    const err=Array.isArray(j)?(j.find(x=>x&&x.error)?.error):(j&&j.error);
    const msg=err&&(err.message||"");
    if(typeof msg==="string" && /temporary internal|rate|too many|timeout|overloaded/i.test(msg)) return true;
  }catch(_){}
  return false;
}

const server=http.createServer(async (req,res)=>{
  res.setHeader("access-control-allow-origin","*");
  res.setHeader("access-control-allow-methods","POST,GET,OPTIONS");
  res.setHeader("access-control-allow-headers","content-type");
  if(req.method==="OPTIONS"){ res.statusCode=204; return res.end(""); }

  if(req.method==="GET" && (req.url==="/ping" || req.url==="/solrpc/ping" || req.url==="/solrpc/ping/")){
    res.statusCode=200; res.setHeader("content-type","text/plain"); return res.end("OK");
  }

  const okPost = (req.method==="POST") && (
    req.url==="/" || req.url==="/solrpc" || req.url==="/solrpc/" || req.url==="/solrpc//"
  );
  if(!okPost){
    res.statusCode=404; res.setHeader("content-type","text/plain"); return res.end("Not found");
  }

  let body="";
  try{ body=await readBody(req); }catch(e){
    res.statusCode=400; res.setHeader("content-type","application/json");
    return res.end(JSON.stringify({jsonrpc:"2.0",id:null,error:{message:"Bad body",detail:String(e.message||e)}}));
  }

  let last="";
  for(const up of UPSTREAMS){
    try{
      const r=await doPost(up, body);
      if(retryable(r.status,r.data)){ last=`up=${up} status=${r.status}`; continue; }
      res.statusCode=200; res.setHeader("content-type","application/json");
      return res.end(r.data);
    }catch(e){
      last=`up=${up} err=${String(e.message||e)}`; continue;
    }
  }
  res.statusCode=502; res.setHeader("content-type","application/json");
  res.end(JSON.stringify({jsonrpc:"2.0",id:null,error:{message:"RPC failover exhausted",detail:last}}));
});
server.listen(PORT, HOST, ()=>console.log(`solrpc proxy on ${HOST}:${PORT}`));
JS

cat > "/etc/systemd/system/$SERVICE" <<UNIT
[Unit]
Description=FireInners Solana JSON-RPC proxy (CORS-safe, failover)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOST=$PROXY_HOST
Environment=PORT=$PROXY_PORT
WorkingDirectory=$PROXY_DIR
ExecStart=/usr/bin/node $PROXY_JS
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now "$SERVICE" >/dev/null

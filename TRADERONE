#!/bin/bash
set -e

FILE="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

node <<'NODE'
const fs=require("fs");
let h=fs.readFileSync(process.env.FILE||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html","utf8");

/* 1. SUPPRIME TOUS LES MENUS / PANELS */
h=h.replace(/<div[^>]*(menu|option|settings|panel)[\s\S]*?<\/div>/gi,"");

/* 2. SUPPRIME ANCIENS SCRIPTS COULEUR */
h=h.replace(/<script[^>]*WOLV_COLOR_SCRIPT[\s\S]*?<\/script>/gi,"");

/* 3. AJOUTE BOUTON ⚙️ UNIQUE */
if(!h.includes("WOLV_GEAR")){
 h=h.replace("</body>",`
<style>
#wolv-gear{
 position:fixed;bottom:18px;right:18px;
 width:54px;height:54px;border-radius:50%;
 display:flex;align-items:center;justify-content:center;
 font-size:24px;cursor:pointer;
 background:linear-gradient(135deg,#ff5cf4,#3fffd8);
 box-shadow:0 0 30px rgba(255,120,255,.6);
 border:none;color:#000;z-index:9999;
 transition:.3s;
}
#wolv-gear:hover{transform:rotate(90deg) scale(1.1)}
</style>

<button id="wolv-gear" title="Switch palette">⚙️</button>

<script id="WOLV_COLOR_SCRIPT">
function r(a,b){return Math.random()*(b-a)+a}
function hsl(h,s,l){return \`hsl(\${h},\${s}%,\${l}%)\`}

function gen(){
 const h=r(0,360)
 const a=(h+r(80,160))%360
 const b=(h+r(200,320))%360
 const l=r(18,82)
 return{
  base:hsl(h,r(35,85),l),
  accent:hsl(a,r(60,100),l>50?r(20,35):r(65,85)),
  action:hsl(b,r(70,100),r(45,65)),
  light:l>50
 }
}

function apply(){
 const m=gen()
 document.body.style.background=m.base
 document.body.style.color=m.light?"#000":"#fff"
 document.querySelectorAll("button").forEach(b=>{
  b.style.background=\`linear-gradient(135deg,\${m.accent},\${m.action})\`
  b.style.color=m.light?"#000":"#fff"
  b.style.boxShadow=\`0 0 20px \${m.action}\`
 })
 const g=document.getElementById("wolv-gear")
 g.style.background=\`linear-gradient(135deg,\${m.action},\${m.accent})\`
 g.style.color=m.light?"#000":"#fff"
 g.style.boxShadow=\`0 0 35px \${m.accent}\`
}

document.getElementById("wolv-gear").onclick=apply
apply()
</script>
</body>`)
}

fs.writeFileSync(process.env.FILE||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html",h);
NODE

nginx -t && systemctl reload nginx
echo "✅ MODE RNG COULEUR ACTIF — 1 bouton ⚙️, zéro menu"
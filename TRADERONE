cat >/tmp/WOLVERINE_DIAG_PROXY_AND_BACKEND.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"

echo "== 1) Who listens on 443 / 8585 ? =="
ss -lntp | egrep ':(443|80|8585)\s' || true
echo

echo "== 2) nginx status =="
systemctl status nginx --no-pager -l | sed -n '1,25p' || true
echo

echo "== 3) traderone service status (if exists) =="
systemctl status traderone.service --no-pager -l | sed -n '1,35p' || true
echo

echo "== 4) What is REALLY on http://127.0.0.1:8585 ? (headers + first bytes) =="
curl -sSI "http://127.0.0.1:8585/" | sed -n '1,25p' || true
curl -sS  "http://127.0.0.1:8585/" | head -c 80; echo
echo

echo "== 5) Local API test (should be JSON) =="
curl -sSI "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" | sed -n '1,25p' || true
curl -sS  "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" | head -c 180; echo
echo

echo "== 6) HTTPS test bypass DNS (force localhost + Host header) =="
# This tests the nginx vhost even if fireinners.online DNS/IPv6 is weird from the VPS
curl -skSI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/traderone/api/balances2?wallet=$WALLET" | sed -n '1,25p' || true
curl -skS  --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/traderone/api/balances2?wallet=$WALLET" | head -c 180; echo
echo

echo "== 7) If /api/balances2 is still HTML: show what process owns 8585 =="
lsof -iTCP:8585 -sTCP:LISTEN -nP || true
echo
echo "DONE ✅"
SH

bash /tmp/WOLVERINE_DIAG_PROXY_AND_BACKEND.sh
cat >/root/fix_dup_solana_rpc_locations.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

echo "== 0) Find ALL ACTIVE /solana-rpc locations (exclude backups) =="
mapfile -t HITS < <(
  grep -RIn --exclude='*.bak*' --exclude-dir='_saved_*' \
    -E '^[[:space:]]*location[[:space:]].*/solana-rpc' \
    /etc/nginx/sites-enabled /etc/nginx/snippets /etc/nginx/conf.d 2>/dev/null || true
)

printf '%s\n' "${HITS[@]:-<none>}"
echo

if ((${#HITS[@]} <= 1)); then
  echo "OK: 0 or 1 definition only. Nothing to dedupe."
else
  echo "== 1) Comment duplicates (keep first only) =="
  keep=1
  for hit in "${HITS[@]}"; do
    file="${hit%%:*}"
    rest="${hit#*:}"
    line="${rest%%:*}"
    if (( keep==1 )); then
      echo "KEEP: $file:$line"
      keep=0
      continue
    fi
    cp -a "$file" "${file}.bak_${TS}"
    sed -i "${line}s@^[[:space:]]*@# DISABLED_DUP_${TS} @" "$file"
    echo "DISABLED: $file:$line"
  done
fi

echo
echo "== 2) nginx -t =="
nginx -t

echo
echo "== 3) reload nginx =="
systemctl reload nginx

echo "DONE ✅"
BASH

chmod +x /root/fix_dup_solana_rpc_locations.sh
/root/fix_dup_solana_rpc_locations.sh
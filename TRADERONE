dge</b><span id="tB2">SOL → WOLFCHAIN.</span></a><a class="tile" href="/explorer/"><i></i><b>Explorer</b><span id="tE2">Blocks / TX / wallets.</span></a><a class="tile" href="/mining/"><i></i><b>Mining</b><span id="tM2">Mining tools.</span></a><a class="tile" href="/options/"><i></i><b>Options</b><span id="tO2">Settings / diagnostics.</span></a><a class="tile" href="/wolverine/"><i></i><b>WOLVERINE</b><span id="tR2">Trading hub.</span></a></div></div><div id="foot"><div>WOLFCHAIN • home</div><div id="tF2">lang: EN</div></div></div></div><script>(()=>{const $=id=>document.getElementById(id);const dict={en:{btn:"EN",f2:"lang: EN",h1:"Main portal",p:"EN is default. Toggle EN/FR is saved. API status checks real /stats.",sub:"Wallet • DEX • Bridge • Explorer • Mining • Options",w2:"Wallet access, balances, actions.",d2:"Swap / LP / pricing.",b2:"SOL → WOLFCHAIN.",e2:"Blocks / TX / wallets.",m2:"Mining tools.",o2:"Settings / diagnostics.",r2:"Trading hub."},fr:{btn:"FR",f2:"lang: FR",h1:"Portail principal",p:"EN par défaut. Le toggle EN/FR est mémorisé. Statut API teste le vrai /stats.",sub:"Wallet • DEX • Bridge • Explorer • Mining • Options",w2:"Accès wallet, soldes, actions.",d2:"Swap / LP / prix.",b2:"SOL → WOLFCHAIN.",e2:"Blocks / TX / wallets.",m2:"Outils mining.",o2:"Réglages / diagnostics.",r2:"Hub trading."}};const sp=new URLSearchParams(location.search);let lang=(sp.get("lang")||localStorage.getItem("lang")||"en").toLowerCase();if(lang!=="fr")lang="en";const apply=()=>{const L=dict[lang];$("langBtn").textContent=L.btn;$("tF2").textContent=L.f2;$("tH1").textContent=L.h1;$("tP").textContent=L.p;$("tSub").textContent=L.sub;$("tW2").textContent=L.w2;$("tD2").textContent=L.d2;$("tB2").textContent=L.b2;$("tE2").textContent=L.e2;$("tM2").textContent=L.m2;$("tO2").textContent=L.o2;$("tR2").textContent=L.r2;localStorage.setItem("lang",lang);document.documentElement.lang=lang};$("langBtn").onclick=()=>{lang=lang==="en"?"fr":"en";apply();ping();};const apiTxt=$("apiTxt"),apiDot=$("apiDot");const ping=async()=>{try{const r=await fetch("/stats",{cache:"no-store"});if(!r.ok)throw 0;apiTxt.textContent="API: online";apiDot.className="dot ok"}catch(e){apiTxt.textContent="API: offline";apiDot.className="dot bad"}};apply();ping();setInterval(ping,15000)})();</script></body></html>

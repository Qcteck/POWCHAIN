python3 - <<PY
import re

p = "${VHOST}"
s = open(p, "r", encoding="utf-8", errors="ignore").read()

def remove_location_blocks(text):
    out = []
    i = 0
    n = len(text)
    removed = 0

    while i < n:
        m = re.search(r'(?m)^[ \t]*location[^\n]*?/wolverine[^\n]*?\{', text[i:])
        if not m:
            out.append(text[i:])
            break

        start = i + m.start()
        out.append(text[i:start])

        # from start, remove the whole { ... } block by brace counting
        j = start
        brace = 0
        in_quote = None
        while j < n:
            ch = text[j]
            if in_quote:
                if ch == in_quote and text[j-1] != '\\':
                    in_quote = None
            else:
                if ch in ("'", '"'):
                    in_quote = ch
                elif ch == '{':
                    brace += 1
                elif ch == '}':
                    brace -= 1
                    if brace == 0:
                        j += 1  # include closing }
                        break
            j += 1

        removed += 1
        i = j

    return ''.join(out), removed

new_s, removed = remove_location_blocks(s)
open(p, "w", encoding="utf-8").write(new_s)
print(f"OK: removed {removed} inline wolverine location block(s) from {p}")
PY


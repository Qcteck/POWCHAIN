set -e
cd /root

echo "=== 1) Trouver le fichier qui contient /api/status ==="
HIT="$(grep -RIn --line-number 'app\.post\(["'\'']\/api\/status' /opt 2>/dev/null | head -n 1 || true)"
echo "HIT=$HIT"

FILE="$(echo "$HIT" | cut -d: -f1)"
[ -f "$FILE" ] || { echo "Introuvable. Colle: grep -RIn '\/api\/status' /opt | head"; exit 1; }

echo
echo "=== 2) Backup ==="
mkdir -p /root/traderone_backups
cp -v "$FILE" "/root/traderone_backups/$(basename "$FILE").$(date +%Y%m%d_%H%M%S)"

echo
echo "=== 3) Patch: supprimer la propriété internal: ... (ligne) ==="
# enlève toute ligne "internal: ..." dans l'objet json du status
perl -pi -e 's/^\s*internal\s*:\s*.*?,\s*$//mg' "$FILE"

echo
echo "=== 4) Vérif (ne doit plus trouver 'internal:' dans /api/status) ==="
grep -n 'internal\s*:' "$FILE" || echo "OK: plus de internal:"

echo
echo "=== 5) Restart ==="
systemctl restart traderone 2>/dev/null || true
systemctl restart wolverine 2>/dev/null || true
pm2 restart traderone 2>/dev/null || true
pm2 restart all 2>/dev/null || true

echo
echo "=== 6) Test direct backend (DOIT NE PLUS contenir internal) ==="
curl -sS -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' ; echo
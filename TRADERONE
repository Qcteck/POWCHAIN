"use strict";
const http=require("http");

const UPSTREAMS=[
  "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",
  "https://api.mainnet-beta.solana.com",
  "https://rpc.ankr.com/solana",
  "https://solana-rpc.publicnode.com"
];

const PORT=parseInt(process.env.PORT||"12703",10);
const HOST=process.env.HOST||"127.0.0.1";

function send(res,code,body,extraHeaders){
  const h={
    "content-type":"application/json; charset=utf-8",
    "access-control-allow-origin":"*",
    "access-control-allow-methods":"POST, GET, OPTIONS",
    "access-control-allow-headers":"content-type, authorization",
    "cache-control":"no-store"
  };
  if(extraHeaders) for(const k of Object.keys(extraHeaders)) h[k]=extraHeaders[k];
  res.writeHead(code,h);
  res.end(typeof body==="string"?body:JSON.stringify(body));
}

function readBody(req){
  return new Promise((resolve,reject)=>{
    let d="";
    req.on("data",c=>{ d+=c; if(d.length>5e6) { reject(new Error("Body too large")); req.destroy(); } });
    req.on("end",()=>resolve(d));
    req.on("error",reject);
  });
}

function shouldFailover(httpStatus, json){
  if(httpStatus>=500) return true;
  if(!json || !json.error) return false;
  const msg=(""+(json.error.message||"")).toLowerCase();
  if(msg.includes("temporary internal error")) return true;
  if(msg.includes("timeout")) return true;
  if(msg.includes("too many requests")) return true;
  if(msg.includes("rate")) return true;
  if(msg.includes("overloaded")) return true;
  return false;
}

async function rpcCall(payload){
  const bodyStr=typeof payload==="string"?payload:JSON.stringify(payload);
  for(const u of UPSTREAMS){
    const ac=new AbortController();
    const t=setTimeout(()=>ac.abort(), 9000);
    try{
      const r=await fetch(u,{method:"POST",headers:{"content-type":"application/json"},body:bodyStr,signal:ac.signal});
      const txt=await r.text();
      let j=null; try{ j=JSON.parse(txt); }catch(_){}
      if(!r.ok || shouldFailover(r.status,j)) { clearTimeout(t); continue; }
      clearTimeout(t);
      return {ok:true,status:r.status,txt,upstream:u};
    }catch(e){
      clearTimeout(t);
      continue;
    }
  }
  return {ok:false,status:502,txt:JSON.stringify({jsonrpc:"2.0",error:{message:"USDC RPC failover exhausted"},id:null}),upstream:""};
}

const s=http.createServer(async (req,res)=>{
  if(req.method==="OPTIONS") return send(res,204,"");
  if(req.url==="/ping") return send(res,200,JSON.stringify({ok:true,upstreams:UPSTREAMS.length}));
  if(req.method!=="POST") return send(res,405,JSON.stringify({error:"POST only"}));
  try{
    const raw=await readBody(req);
    if(!raw) return send(res,400,JSON.stringify({error:"Empty body"}));
    const out=await rpcCall(raw);
    return send(res,out.ok?200:502,out.txt, out.upstream?{"x-solrpc-upstream":out.upstream}:undefined);
  }catch(e){
    return send(res,500,JSON.stringify({error:"proxy error",message:""+e}));
  }
});

s.listen(PORT,HOST,()=>console.log("solrpc-proxy listening on",HOST+":"+PORT));
JS


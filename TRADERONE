set -e
cd /root

KEY="CHANGE-MOI-EN-UNE-GROSSE-CLE-64CHARS"

for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  cp -v "$f" "/root/nginx_backups/$(basename "$f").$(date +%Y%m%d_%H%M%S)"

  # insère le check juste après l’ouverture du bloc location API
  perl -0777 -i -pe 's#(location\s+\^~\s+/wolverine/traderone/api/\s*\{\n)#$1  if (\$http_x_api_key != "'"$KEY"'") { return 403; }\n#s' "$f"
done

nginx -t
systemctl reload nginx




BASE="https://fireinners.online/wolverine/traderone/api"

# doit faire 403
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" --data '{}' | head -n 20

# doit faire 200
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" -H "X-API-KEY: CHANGE-MOI-EN-UNE-GROSSE-CLE-64CHARS" --data '{}' | head -n 20
#!/usr/bin/env bash
set -euo pipefail

# MEGA_WOLVERINE_FIX_PROBES_ROOT.sh
# Corrige le problème de test local (port 80) en testant correctement sur 443 + Host header.
# Auto-fix: démarre nginx si inactif. Zéro input manuel.

if [[ "${EUID}" -ne 0 ]]; then echo "ERREUR: lance ce script en root."; exit 1; fi

TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
OUT="/root/MEGA_WOLVERINE_PROBES_${TS}.txt"

say(){ printf "\n== %s ==\n" "$*"; }
w(){ printf "%s\n" "$*" | tee -a "$OUT" >/dev/null; }

latest_map(){
  ls -1t /root/WOLVERINE_VPS_MAP_*.txt 2>/dev/null | head -n 1 || true
}

need(){
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || { apt-get update -y; apt-get install -y curl ca-certificates; }
}

need curl

echo "# MEGA WOLVERINE PROBES ${TS}" > "$OUT"
w "host=${HOST}"
w "date=$(date -Is)"
w "hostname=$(hostname)"
w ""

MAP="$(latest_map)"
if [[ -z "$MAP" ]]; then
  w "Aucun fichier /root/WOLVERINE_VPS_MAP_*.txt trouvé."
  w "Relance l’inventaire si besoin."
  echo "Rapport: $OUT"
  exit 1
fi

say "1) Map détectée"
w "MAP_FILE=$MAP"
w "MAP_SHA256=$(sha256sum "$MAP" | awk '{print $1}')"
w ""

say "2) État nginx + listeners"
w "systemctl is-active nginx: $(systemctl is-active nginx 2>/dev/null || true)"
if ! systemctl is-active --quiet nginx; then
  w "nginx inactif -> démarrage..."
  systemctl enable --now nginx || true
  sleep 1
fi
w "systemctl is-active nginx (after): $(systemctl is-active nginx 2>/dev/null || true)"
w ""
w "ss -lntup (nginx):"
(ss -lntup 2>/dev/null | egrep -i "nginx|:80|:443" || true) | tee -a "$OUT" >/dev/null
w ""

say "3) Nginx -t"
w "nginx -t:"
(nginx -t 2>&1 || true) | tee -a "$OUT" >/dev/null
w ""

say "4) Tests corrigés (LOCAL HTTPS 443 + Host header)"
w "--- curl LOCAL https://127.0.0.1/wolverine/ (Host: ${HOST}) ---"
(curl -k -sS -I "https://127.0.0.1/wolverine/" -H "Host: ${HOST}" | head -n 20 || true) | tee -a "$OUT" >/dev/null
w ""
w "--- curl LOCAL https://127.0.0.1/wolverine/traderone/api/ (Host: ${HOST}) ---"
(curl -k -sS -I "https://127.0.0.1/wolverine/traderone/api/" -H "Host: ${HOST}" | head -n 20 || true) | tee -a "$OUT" >/dev/null
w ""

say "5) Tests externes (HTTPS public)"
w "--- curl EXT https://${HOST}/wolverine/ ---"
(curl -sS -I "https://${HOST}/wolverine/" | head -n 20 || true) | tee -a "$OUT" >/dev/null
w ""
w "--- curl EXT https://${HOST}/wolverine/traderone/api/ ---"
(curl -sS -I "https://${HOST}/wolverine/traderone/api/" | head -n 20 || true) | tee -a "$OUT" >/dev/null
w ""

say "6) Extraits utiles du MAP (C/D/G/H si présents)"
w "---- MAP EXTRACT (grep: Wolverine/Nginx/traderone/3000/443/80) ----"
(grep -nEi "wolverine|fireinners\.online-ssl|traderone|:3000|:443|:80|nginx" "$MAP" | head -n 220 || true) | tee -a "$OUT" >/dev/null
w ""

say "DONE"
echo "Rapport généré: $OUT"
echo "Copie/colle ici le contenu de $OUT (ou juste les blocs 4/5) et je te dis exactement ce qui bloque."
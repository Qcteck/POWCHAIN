cat >/root/FIREINNERS_SOLRPC_FIX_MEGA.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "[PLAN] Ce script va:"
echo "  1) (Re)installer le proxy Solana JSON-RPC local: 127.0.0.1:12703 (/ping + POST forward + CORS)"
echo "  2) Patcher nginx fireinners.online-ssl: /solrpc/ -> proxy, et /solrpc -> 308 (garde POST)"
echo "  3) Patcher le wallet dist pour forcer /solrpc/ (evite 301) + fallback USDC (getTokenAccountsByOwner jsonParsed)"
echo

[ "$(id -u)" -eq 0 ] || { echo "ERR: run as root"; exit 1; }

PROXY_DIR="/opt/fireinners/solrpc-proxy"
PROXY_PORT="12703"
PROXY_HOST="127.0.0.1"
SERVICE="fireinners-solrpc-proxy.service"
UNIT="/etc/systemd/system/${SERVICE}"

NG_SITE_AV="/etc/nginx/sites-available/fireinners.online-ssl"
NG_SITE_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"

ASKORUPDATE="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKORUPDATE" ]; then
  # shellcheck disable=SC1090
  source "$ASKORUPDATE" || true
fi

need_bin(){ command -v "$1" >/dev/null 2>&1 || { echo "ERR: missing $1"; exit 1; }; }
need_bin node
need_bin nginx
need_bin python3
need_bin systemctl
need_bin chattr || true

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/backup_fireinners_solrpc_${TS}"

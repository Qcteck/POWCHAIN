import fs from "fs";
import path from "path";
import crypto from "crypto";
import express from "express";
import cors from "cors";
import fetch from "node-fetch";

const APP_DIR = "/opt/iaaquila";
const CFG_DIR = path.join(APP_DIR, "config");
const DATA_DIR = path.join(APP_DIR, "data");
const STATE_FILE = path.join(DATA_DIR, "state.json");
const ALLOW_FILE = path.join(CFG_DIR, "exec_allowlist.json");

const HOST = process.env.HOST || "127.0.0.1";
const PORT = parseInt(process.env.PORT || "9688", 10);
const SOL_RPC_PRIMARY = process.env.SOL_RPC_PRIMARY || "https://api.mainnet-beta.solana.com";
const SOL_RPC_BACKUP = process.env.SOL_RPC_BACKUP || "https://api.mainnet-beta.solana.com";
const JUP_BASE = process.env.JUP_BASE || "https://quote-api.jup.ag";
const USDC_MINT = process.env.USDC_MINT || "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

const app = express();
app.disable("x-powered-by");
app.use(cors());
app.use(express.json({ limit: "1mb" }));

const now = ()=>Date.now();
const sha256 = (s)=>crypto.createHash("sha256").update(s).digest("hex");
const rid = ()=>crypto.randomBytes(16).toString("hex");

function readJson(p, fallback){
  try{ return JSON.parse(fs.readFileSync(p,"utf8")); }catch(e){ return fallback; }
}
function atomicWriteJson(p, obj){
  const tmp = p + ".tmp." + process.pid;
  fs.writeFileSync(tmp, JSON.stringify(obj, null, 2));
  fs.renameSync(tmp, p);
}

function loadAllow(){ return readJson(ALLOW_FILE, {KILL_SWITCH:true,ALLOW_ALL_IF_EMPTY:0,global:{},pairs:[]}); }

function backoffSleep(ms){ return new Promise(r=>setTimeout(r, ms)); }
function jitter(ms, frac){ const d = ms*frac; return Math.max(0, Math.floor(ms + (Math.random()*2-1)*d)); }

async function fetchWithTimeout(url, opts, timeoutMs){
  const ctrl = new AbortController();
  const t = setTimeout(()=>ctrl.abort(), timeoutMs);
  try{
    const res = await fetch(url, { ...opts, signal: ctrl.signal });
    return res;
  } finally { clearTimeout(t); }
}

async function rpcCall(url, method, params, timeoutMs){
  const body = JSON.stringify({ jsonrpc:"2.0", id:1, method, params });
  const res = await fetchWithTimeout(url, { method:"POST", headers:{ "content-type":"application/json" }, body }, timeoutMs);
  if(!res.ok) throw new Error("rpc_http_"+res.status);
  const j = await res.json();
  if(j.error) throw new Error("rpc_err_"+(j.error.message||"unknown"));
  return j.result;
}

async function rpcCallWithFallback(method, params, timeoutMs){
  try{ return await rpcCall(SOL_RPC_PRIMARY, method, params, timeoutMs); }
  catch(e1){ return await rpcCall(SOL_RPC_BACKUP, method, params, timeoutMs); }
}

function pruneUsage(state){
  const cutoff = now() - 24*60*60*1000;
  state.usageEvents = (state.usageEvents||[]).filter(ev=>ev && ev.ts>=cutoff);
}
function usageAgg(state, userPub){
  pruneUsage(state);
  let tx=0, usdc=0;
  for(const ev of state.usageEvents){
    if(ev.userPub===userPub){
      tx += (ev.txCount||0);
      usdc += (ev.usdc||0);
    }
  }
  return { tx, usdc };
}

function allowFor(allow, inMint, outMint, dir){
  const pairs = Array.isArray(allow.pairs) ? allow.pairs : [];
  for(const p of pairs){
    if(p && p.inMint===inMint && p.outMint===outMint && (p.dir===dir || p.dir==="ANY")) return p;
  }
  return null;
}

function policyDeny(msg, code="DENY"){ const e=new Error(msg); e.code=code; return e; }

async function jupQuote({ inMint, outMint, amount, slippageBps }, allow){
  const tm = Math.max(2000, (allow?.timeoutsMs?.quote)||8000);
  const url = `${JUP_BASE}/v6/quote?inputMint=${encodeURIComponent(inMint)}&outputMint=${encodeURIComponent(outMint)}&amount=${encodeURIComponent(String(amount))}&slippageBps=${encodeURIComponent(String(slippageBps))}`;
  const res = await fetchWithTimeout(url, { method:"GET" }, tm);
  if(!res.ok) throw new Error("jup_quote_http_"+res.status);
  return await res.json();
}

async function jupSwap({ quote, userPublicKey }, allow){
  const tm = Math.max(2500, (allow?.timeoutsMs?.swap)||12000);
  const url = `${JUP_BASE}/v6/swap`;
  const body = JSON.stringify({
    quoteResponse: quote,
    userPublicKey,
    wrapAndUnwrapSol: true,
    useSharedAccounts: true,
    prioritizationFeeLamports: "auto"
  });
  const res = await fetchWithTimeout(url, { method:"POST", headers:{ "content-type":"application/json" }, body }, tm);
  if(!res.ok) throw new Error("jup_swap_http_"+res.status);
  return await res.json();
}

async function confirmFinalized(signature, allow){
  const tm = Math.max(10000, (allow?.timeoutsMs?.confirm)||45000);
  const start = now();
  let delay = Math.max(300, (allow?.backoffMs?.start)||650);
  const max = Math.max(delay, (allow?.backoffMs?.max)||4000);
  const factor = (allow?.backoffMs?.factor)||1.65;
  const jit = (allow?.backoffMs?.jitter)||0.25;

  let seen = false;
  while(now()-start < tm){
    try{
      const st = await rpcCallWithFallback("getSignatureStatuses", [[signature], { searchTransactionHistory: true }], 8000);
      const s = st?.value?.[0] || null;
      if(s){
        seen = true;
        if(s.confirmationStatus==="finalized" && !s.err) return { status:"FINALIZED", err:null };
        if(s.err) return { status:"ERROR", err:s.err };
      }
    }catch(_){}
    try{
      const tx = await rpcCallWithFallback("getTransaction", [signature, { commitment:"finalized", maxSupportedTransactionVersion: 0 }], 8000);
      if(tx){ return { status:"FINALIZED", err:null }; }
    }catch(_){}
    await backoffSleep(jitter(delay, jit));
    delay = Math.min(max, Math.floor(delay*factor));
  }
  return { status: seen ? "TIMEOUT" : "NOT_FOUND", err:null };
}


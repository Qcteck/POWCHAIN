bash -lc 'cat >/tmp/wolverine_fly.sh << "SH"
#!/usr/bin/env bash
set -euo pipefail
HOST="fireinners.online"
ROOT="/opt/fireinners/frontend-react/app/dist"
echo "== META =="; date -u; hostname; echo
echo "== FILES =="; ls -la "$ROOT/wolverine/index.html" "$ROOT/stats/index.json" 2>/dev/null || true; echo
echo "== NGINX TEST =="; nginx -t || true; echo
echo "== CURL (local via nginx, with Host) =="
echo -n "/stats/index.json => "; curl -k -sS -o /dev/null -w "%{http_code}\n" "https://127.0.0.1/stats/index.json" -H "Host: $HOST" || true
echo -n "/wolverine/ => "; curl -k -sS -o /dev/null -w "%{http_code}\n" "https://127.0.0.1/wolverine/" -H "Host: $HOST" || true
echo
echo "== CURL (public) =="
echo -n "https://$HOST/stats/index.json => "; curl -k -sS -o /dev/null -w "%{http_code}\n" "https://$HOST/stats/index.json" || true
echo -n "https://$HOST/wolverine/ => "; curl -k -sS -o /dev/null -w "%{http_code}\n" "https://$HOST/wolverine/" || true
echo
echo "== CDN check (solana web3) =="
echo -n "jsdelivr => "; curl -I -sS "https://cdn.jsdelivr.net/npm/@solana/web3.js@latest/lib/index.iife.min.js" | head -n 1 || true
SH
chmod +x /tmp/wolverine_fly.sh
/tmp/wolverine_fly.sh'
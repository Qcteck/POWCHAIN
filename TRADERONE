set -e

echo "=== 1) Qui écoute sur 3000 ? ==="
ss -ltnp | grep ':3000' || echo "Rien n'écoute sur 3000"
echo

echo "=== 2) PM2 status (root) ==="
pm2 ls || true
echo

echo "=== 3) Cherche un process node/serveur ==="
ps -ef | egrep 'node|server\.js|pm2' | egrep -v egrep | head -n 40
echo

echo "=== 4) Si PM2 voit traderone, restart ==="
if pm2 jlist 2>/dev/null | grep -q '"name":"traderone"'; then
  ID=$(pm2 jlist | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{const a=JSON.parse(d);const p=a.find(x=>x.name==="traderone");console.log(p?p.pm_id:"")})')
  echo "PM2 traderone id=$ID"
  pm2 restart "$ID" --update-env
  sleep 2
else
  echo "PM2(root) ne voit pas traderone -> peut tourner sous un autre user"
fi
echo

echo "=== 5) Si un autre user a PM2, affiche-le ==="
ps -eo user,cmd | awk '$2 ~ /PM2|pm2/ {print $1 " " $0}' | head -n 20 || true
echo

echo "=== 6) Re-check port 3000 ==="
ss -ltnp | grep ':3000' || echo "Toujours rien sur 3000"
echo

echo "=== 7) Test health local (si up) ==="
curl -sS -i http://127.0.0.1:3000/health | head -n 20 || true
echo

echo "=== 8) Logs PM2 (si traderone existe) ==="
pm2 logs traderone --lines 80 --nostream 2>/dev/null || true
echo "=== FIN ==="
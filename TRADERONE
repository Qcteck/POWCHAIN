  python3 - <<PY
from pathlib import Path
p=Path("$VHOST")
txt=p.read_text(encoding="utf-8",errors="ignore")
marker="FIREINNERS_SOLRPC_PROXY_v1"
block = r'''
    # FIREINNERS_SOLRPC_PROXY_v1
    location /solrpc {
        proxy_pass http://127.0.0.1:12703;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;
        if ($request_method = OPTIONS) { return 204; }
    }
'''
if marker in txt:
  print("already patched")
  raise SystemExit(0)

# Insert into the server block that mentions fireinners.online, else append near end.
lines=txt.splitlines(True)

def find_server_blocks(lines):
  blocks=[]
  i=0
  while i<len(lines):
    if lines[i].lstrip().startswith("server"):
      # find opening brace
      j=i
      while j<len(lines) and "{" not in lines[j]:
        j+=1
      if j>=len(lines): break
      depth=0
      k=j
      while k<len(lines):
        depth += lines[k].count("{")
        depth -= lines[k].count("}")
        if depth==0:
          blocks.append((i,k))
          i=k
          break
        k+=1
    i+=1
  return blocks

blocks=find_server_blocks(lines)
target=None
for a,b in blocks:
  chunk="".join(lines[a:b+1])
  if "server_name" in chunk and "fireinners.online" in chunk:
    target=(a,b,chunk)
    break

if target:
  a,b,chunk=target
  # insert before the last "}" of this block
  # find the last line containing only "}" (possibly with spaces)
  end=b
  insert_at=end
  for idx in range(end,a,-1):
    if lines[idx].strip()=="}":
      insert_at=idx
      break
  new_lines=lines[:insert_at]+[block]+lines[insert_at:]
else:
  # fallback: insert before last '}' in file
  insert_at=len(lines)
  for idx in range(len(lines)-1,-1,-1):
    if lines[idx].strip()=="}":
      insert_at=idx
      break
  new_lines=lines[:insert_at]+[block]+lines[insert_at:]

out=Path("$BKDIR/vhost.patched")
out.write_text("".join(new_lines),encoding="utf-8")
print("vhost patched tmp:",out)
PY

  if declare -F askorupdate_file >/dev/null 2>&1; then
    askorupdate_file "$VHOST" "$BKDIR/vhost.patched"
  else

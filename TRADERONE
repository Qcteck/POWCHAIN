# ROOT — fireinners = / ; wolverine = /wolverine ; api = /wolverine/traderone/api
set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
DISABLED="/etc/nginx/sites-disabled"
TS="$(date +%s)"

WOLV_DIST="/var/www/wolverine"
FIRE_DIST="/var/www/fireinners"

echo "=== 1) Désactiver les doublons nginx qui contiennent /wolverine (sauf le bon vhost) ==="
mkdir -p "$DISABLED"
mapfile -t FILES < <(grep -RIl -E 'location\s+\^~\s+/wolverine/' /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | sort -u || true)
for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  if [ "$f" != "$NG" ]; then
    base="$(basename "$f")"
    echo "MOVE DUP: $f -> $DISABLED/$base.$TS"
    mv "$f" "$DISABLED/$base.$TS"
  else
    echo "KEEP: $f"
  fi
done

echo "=== 2) Forcer le mapping nginx (root => fireinners, /wolverine => wolverine) ==="
cp -a "$NG" "$NG.bak.map_$TS"

python3 - <<'PY'
from pathlib import Path
import re
ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# retire les anciens blocs UI /wolverine (sans toucher à /wolverine/traderone/api)
for pat in [
  r'\n\s*# --- WOLVERINE UI[\s\S]*?location\s+\^~\s+/wolverine/[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*',
]:
  s = re.sub(pat, "\n", s, flags=re.M)

block = r'''
# --- ROOT UI (FIREINNERS) ---
location = / { try_files /index.html =404; }
location ^~ / {
  root /var/www/fireinners;
  index index.html;
  try_files $uri $uri/ /index.html;
}

# --- WOLVERINE UI ---
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}
'''

i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: nginx conf invalide")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: mapping inserted")
PY

nginx -t
systemctl reload nginx

echo "=== 3) Vérifs fichiers servis ==="
echo "--- /var/www/wolverine/index.html title ---"
grep -nEi "title" "$WOLV_DIST/index.html" | head -n 3 || true
echo "--- /var/www/fireinners/index.html title ---"
grep -nEi "title" "$FIRE_DIST/index.html" | head -n 3 || true

echo "=== 4) Tests HTTP ==="
curl -sS -I https://fireinners.online/ | head -n 8
curl -sS -I https://fireinners.online/wolverine/ | head -n 8
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 10
echo "DONE ✅"
cat >/tmp/MEGA_WOLVERINE_PATCH_v3.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
[ "$(id -u)" = "0" ] || { echo "ERREUR: lance en root"; exit 1; }

APPDIR="/opt/fireinners/wolverine-api"
WEBDIST="/opt/fireinners/frontend-react/app/dist"
WEBDIR="${WEBDIST}/wolverine"
SENVF="${APPDIR}/.env"
SERVICE="wolverine-api"
UNIT="/etc/systemd/system/${SERVICE}.service"
SNIP="/etc/nginx/snippets/fireinners-wolverine.conf"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGC="/etc/nginx/nginx.conf"

need(){ command -v "$1" >/dev/null 2>&1 || { echo "ERREUR: '$1' manquant"; exit 1; }; }
need node; need npm; need systemctl; need nginx; need curl; need sed; need grep; need awk; need perl || true

echo "=== PRE-FLY (read-only) ==="
echo "Node: $(node -v) / Npm: $(npm -v)"
nginx -t >/dev/null && echo "NGINX OK"

mkdir -p "$APPDIR" "$WEBDIR" "${APPDIR}/state" /etc/nginx/snippets

# unlock immutables if any
chattr -i "$SNIP" 2>/dev/null || true
chattr -i "$SITE" 2>/dev/null || true

# .env defaults
touch "$SENVF"
grep -qE '^HOST=' "$SENVF" || echo "HOST=127.0.0.1" >>"$SENVF"
grep -qE '^PORT=' "$SENVF" || echo "PORT=3050" >>"$SENVF"
grep -qE '^BASE_PATH=' "$SENVF" || echo "BASE_PATH=/wolverine" >>"$SENVF"
grep -qE '^MONITOR_URI=' "$SENVF" || echo "MONITOR_URI=https://fireinners.online/wolverine/api/ping" >>"$SENVF"
grep -qE '^MONITOR_SEC=' "$SENVF" || echo "MONITOR_SEC=10" >>"$SENVF"
grep -qE '^MONITOR_FAILS=' "$SENVF" || echo "MONITOR_FAILS=3" >>"$SENVF"

# Backend (simple, stable) -> 127.0.0.1:3050
cat >"$APPDIR/server.js" <<'JS'
"use strict";
require("dotenv").config();
const express=require("express");
const fs=require("fs");
const path=require("path");

const HOST=process.env.HOST||"127.0.0.1";
const PORT=parseInt(process.env.PORT||"3050",10);
const BASE_PATH=process.env.BASE_PATH||"/wolverine";
const MONITOR_URI=process.env.MONITOR_URI||"";
const MONITOR_SEC=parseInt(process.env.MONITOR_SEC||"10",10);
const MONITOR_FAILS=parseInt(process.env.MONITOR_FAILS||"3",10);

const app=express();
app.use(express.json({limit:"1mb"}));

let loop=null, last={ok:null,ts:0,err:null,code:null,body:null}, fails=0;

async function doPing(){
  const ts=Date.now();
  try{
    if(!MONITOR_URI) throw new Error("MONITOR_URI empty");
    const r=await fetch(MONITOR_URI,{cache:"no-store"});
    const txt=await r.text();
    const ok=r.ok && /pong/i.test(txt);
    last={ok,ts,err: ok?null:`badresp`,code:r.status,body:txt.slice(0,180)};
    fails = ok ? 0 : (fails+1);
  }catch(e){
    last={ok:false,ts,err:String(e&&e.message||e),code:null,body:null};
    fails++;
  }
  return last;
}

function startLoop(){
  if(loop) return {running:true};
  loop=setInterval(doPing,Math.max(2,MONITOR_SEC)*1000);
  doPing();
  return {running:true};
}
function stopLoop(){
  if(!loop) return {running:false};
  clearInterval(loop); loop=null;
  return {running:false};
}

app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));
app.get("/health",(req,res)=>res.json({ok:true,service:"wolverine-api",host:HOST,port:PORT,time:new Date().toISOString()}));
app.get("/config",(req,res)=>res.json({ok:true,basePath:BASE_PATH,monitor:{uri:MONITOR_URI,sec:MONITOR_SEC,fails:MONITOR_FAILS}}));
app.get("/status",(req,res)=>res.json({ok:true,loop:!!loop,last,fails}));

app.post("/loop/start",(req,res)=>res.json({ok:true,...startLoop()}));
app.post("/loop/stop",(req,res)=>res.json({ok:true,...stopLoop()}));

app.listen(PORT,HOST,()=>console.log("WOLVERINE API up on http://"+HOST+":"+PORT));
JS

# deps
cd "$APPDIR"
if [ ! -f package.json ]; then
  npm init -y >/dev/null
fi
npm install express dotenv >/dev/null 2>&1 || npm install express dotenv

# systemd unit
cat >"$UNIT" <<EOF
[Unit]
Description=WOLVERINE API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$APPDIR
EnvironmentFile=$SENVF
ExecStart=/usr/bin/node $APPDIR/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now "$SERVICE"
systemctl restart "$SERVICE" || true
sleep 0.5

# nginx snippet (wolverine)
cat >"$SNIP" <<'NG'
location ^~ /wolverine/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;
  proxy_connect_timeout 5s;
  proxy_pass http://127.0.0.1:3050/;
  add_header Cache-Control "no-store, max-age=0" always;
}
location ^~ /wolverine/ {
  root /opt/fireinners/frontend-react/app/dist;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store, max-age=0" always;
}
NG

# ensure include exists in vhost
if [ -f "$SITE" ] && ! grep -q "snippets/fireinners-wolverine.conf" "$SITE"; then
  # insert before last "}" of the first server block (best-effort)
  perl -0777 -i -pe 's/(server\s*\{.*?)(\n\})/$1\n    include snippets\/fireinners-wolverine.conf;\n$2/s' "$SITE" || true
fi

nginx -t
systemctl reload nginx

# patch index color (visible)
if [ -f "$WEBDIR/index.html" ]; then
  sed -i 's/--a:#9ff/--a:#3dffb5/g' "$WEBDIR/index.html" 2>/dev/null || true
  sed -i 's/--ok:#b9ffcf/--ok:#3dffb5/g' "$WEBDIR/index.html" 2>/dev/null || true
fi

# relock (optional)
chattr +i "$SNIP" 2>/dev/null || true
# (SITE often locked in your doctrine, keep it editable if needed)
# chattr +i "$SITE" 2>/dev/null || true

echo "=== DONE ==="
echo "Front  : https://fireinners.online/wolverine/"
echo "Ping   : https://fireinners.online/wolverine/api/ping"
echo "Health : https://fireinners.online/wolverine/api/health"
echo "Config : https://fireinners.online/wolverine/api/config"
echo "Status : https://fireinners.online/wolverine/api/status"
echo
echo "Local check:"
curl -fsS "http://127.0.0.1:3050/ping" && echo
BASH
chmod +x /tmp/MEGA_WOLVERINE_PATCH_v3.sh
bash /tmp/MEGA_WOLVERINE_PATCH_v3.sh
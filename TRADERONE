cat >/root/find_blueprint_reference.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== Search references to blueprint_robo600 / blueprint/ in wolverine files ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
"blueprint_robo600|/wolverine/blueprint|blueprint/" \
/var/www/wolverine 2>/dev/null | head -n 80 || true
echo "DONE ✅"
BASH

chmod +x /root/find_blueprint_reference.sh
/root/find_blueprint_reference.sh
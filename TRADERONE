#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%s)"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SITESEN="/etc/nginx/sites-enabled"
ROOTDIST="/opt/fireinners/frontend-react/app/dist"
WOLVDIR="$ROOTDIST/wolverine"
INDEX="$WOLVDIR/index.html"

MARK_BEGIN="# BEGIN WOLVERINE_API_UI_BLOCK"
MARK_END="# END WOLVERINE_API_UI_BLOCK"

die(){ echo "[MEGA] ERR: $*" >&2; exit 1; }
log(){ echo "[MEGA] $*"; }

[ "$(id -u)" = "0" ] || die "lance en root"
mkdir -p "$WOLVDIR" || true

# --- Backup UI + VHOST
mkdir -p "$WOLVDIR/_backups" || true
if [ -f "$INDEX" ]; then cp -af "$INDEX" "$WOLVDIR/_backups/index.html.bak.$TS" || true; fi
[ -f "$VHOST" ] || die "vhost introuvable: $VHOST"

# déverrouille si immutable
chattr -i "$VHOST" 2>/dev/null || true
cp -af "$VHOST" "$VHOST.bak.$TS"

# --- Nettoie conflits server_name dans sites-enabled (sans toucher au canon)
CANON="$VHOST"
for f in "$SITESEN"/*; do
  [ -e "$f" ] || continue
  # si le fichier cible contient server_name fireinners.online et n'est pas le canon, on le désactive
  if grep -qE "^[[:space:]]*server_name[[:space:]].*fireinners\.online" "$f" 2>/dev/null; then
    tgt="$(readlink -f "$f" 2>/dev/null || echo "$f")"
    if [ "$tgt" != "$(readlink -f "$CANON")" ]; then
      log "disable extra vhost: $f"
      rm -f "$f" 2>/dev/null || mv -f "$f" "$f.disabled.$TS" 2>/dev/null || true
    fi
  fi
done
ln -sfn "$CANON" "$SITESEN/$(basename "$CANON")"

# --- Patch nginx vhost: insère bloc Wolverine (idempotent)
if grep -q "$MARK_BEGIN" "$VHOST"; then
  log "bloc Wolverine déjà présent (on le remplace proprement)"
  awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
    $0~b{in=1;print;next}
    $0~e{in=0;print;next}
    in==1{next}
    {print}
  ' "$VHOST" > "$VHOST.tmp.$TS"
  mv -f "$VHOST.tmp.$TS" "$VHOST"
fi

if ! grep -q "$MARK_BEGIN" "$VHOST"; then
  log "injection bloc Wolverine dans le server{}"
  # insère juste avant la dernière accolade fermante du fichier (suffisant pour un vhost simple)
  perl -0777 -pe '
    my $blk = qq|\n'"$MARK_BEGIN"'\n| .
qq|    # Wolverine API (proxy vers backend 127.0.0.1:3000)\n| .
qq|    location ^~ /wolverine/api/ {\n| .
qq|        proxy_http_version 1.1;\n| .
qq|        proxy_set_header Host \\$host;\n| .
qq|        proxy_set_header X-Real-IP \\$remote_addr;\n| .
qq|        proxy_set_header X-Forwarded-For \\$proxy_add_x_forwarded_for;\n| .
qq|        proxy_set_header X-Forwarded-Proto \\$scheme;\n| .
qq|        proxy_read_timeout 60s;\n| .
qq|        proxy_pass http://127.0.0.1:3000;\n| .
qq|    }\n\n| .
qq|    # Wolverine UI (statique)\n| .
qq|    location = /wolverine/ {\n| .
qq|        add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;\n| .
qq|        try_files /wolverine/index.html =404;\n| .
qq|    }\n| .
qq|    location ^~ /wolverine/ {\n| .
qq|        add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;\n| .
qq|        try_files \\$uri \\$uri/ /wolverine/index.html;\n| .
qq|    }\n| .
qq|'"$MARK_END"'\n|;
    s/\\n}\\s*\\z/$blk\\n}\\n/s;
  ' "$VHOST" > "$VHOST.tmp.$TS"
  mv -f "$VHOST.tmp.$TS" "$VHOST"
fi

# --- Écrit la nouvelle UI (sans doublons) au BON emplacement
log "écriture UI: $INDEX"
cat > "$INDEX" <<'HTML'

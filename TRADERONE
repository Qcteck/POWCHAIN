bash -lc 'set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_WV_PATCHALL_FIX_$TS"
INC="/etc/nginx/includes/wolverine_routes.inc"
DOMAIN="fireinners.online"
mkdir -p "$BK"
say(){ echo "[$(date -u +%F\ %T\ UTC)] $*"; }

say "BACKUP -> $BK"
cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
[ -f "$INC" ] && cp -a "$INC" "$BK/$(basename "$INC")" 2>/dev/null || true

if command -v chattr >/dev/null 2>&1; then
  say "UNFREEZE chattr -i (best effort)"
  for f in /etc/nginx/nginx.conf /etc/nginx/sites-available/* /etc/nginx/sites-enabled/* /etc/nginx/conf.d/* /etc/nginx/includes/*; do
    [ -e "$f" ] || continue
    chattr -i "$f" 2>/dev/null || true
  done
fi

say "ENSURE include $INC"
mkdir -p /etc/nginx/includes
if [ ! -f "$INC" ]; then
  cat >"$INC"<<'"'"'EOF'"'"'
# wolverine routes (managed)
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ { root /var/www; try_files $uri $uri/ /wolverine/index.html; add_header Cache-Control "no-store" always; }
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
EOF
fi

say "PATCH include: ensure traderone/vault + traderone/api"
python3 - <<'"'"'PY'"'"'
import re, pathlib
p=pathlib.Path("/etc/nginx/includes/wolverine_routes.inc")
s=p.read_text(encoding="utf-8", errors="ignore")

def has(loc:str)->bool:
  return re.search(r"location\s+\^~\s+%s\s*\{"%re.escape(loc), s) is not None

tpl = """location ^~ {loc} {{
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}}
"""
add=[]
if not has("/wolverine/traderone/vault/"): add.append(tpl.format(loc="/wolverine/traderone/vault/"))
if not has("/wolverine/traderone/api/"): add.append(tpl.format(loc="/wolverine/traderone/api/"))
if add:
  s = s.rstrip() + "\n\n# added by WV_PATCHALL_FIX\n" + "\n".join(add) + "\n"
  p.write_text(s, encoding="utf-8")
print("OK include; added_blocks=", len(add))
PY

say "FIND all vhosts for server_name fireinners.online"
mapfile -t VHOSTS < <(grep -Rsl --include="*.conf" -E "\bserver_name\b.*fireinners\.online" /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d 2>/dev/null | sort -u)
if [ "${#VHOSTS[@]}" -eq 0 ]; then say "ERR no vhosts found"; exit 1; fi
printf "%s\n" "${VHOSTS[@]}" >"$BK/vhosts_list.txt"
say "VHOSTS count=${#VHOSTS[@]}"

say "INJECT include into ALL matching vhosts (if missing)"
python3 - <<'"'"'PY'"'"'
import re, pathlib
inc_line="include /etc/nginx/includes/wolverine_routes.inc;\n"
paths=pathlib.Path("'$BK'/vhosts_list.txt").read_text().splitlines()
patched=[]
for path in paths:
  fp=pathlib.Path(path)
  txt=fp.read_text(encoding="utf-8", errors="ignore").splitlines(True)
  if any("includes/wolverine_routes.inc" in l for l in txt):
    continue
  out=[]; inserted=False
  for line in txt:
    out.append(line)
    if (not inserted) and re.search(r"\bserver_name\b.*fireinners\.online", line):
      out.append(inc_line); inserted=True
  if not inserted:
    out=[inc_line]+txt
  fp.write_text("".join(out), encoding="utf-8")
  patched.append(path)
print("patched=", len(patched))
for p in patched: print(" -", p)
PY

say "NGINX TEST"
nginx -t

say "RELOAD nginx"
systemctl reload nginx 2>/dev/null || systemctl restart nginx

if command -v chattr >/dev/null 2>&1; then
  say "REFREEZE chattr +i (best effort)"
  chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
  chattr +i "$INC" 2>/dev/null || true
  for f in "${VHOSTS[@]}"; do chattr +i "$f" 2>/dev/null || true; done
fi

say "TEST LOCAL (bypass CF) /wolverine/ (first bytes)"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/" | head -c 160 || true; echo
say "TEST LOCAL (bypass CF) /wolverine/vault-api/health"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/vault-api/health" || true; echo
say "TEST LOCAL (bypass CF) /wolverine/traderone/vault/health"
curl -sk --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/wolverine/traderone/vault/health" || true; echo
say "TEST PUBLIC HEAD /wolverine/traderone/vault/health"
curl -skI "https://$DOMAIN/wolverine/traderone/vault/health" | sed -n "1,20p" || true

say "DONE"
say "Backups: $BK"
echo "Open: https://$DOMAIN/wolverine/ (Ctrl+F5)"
'
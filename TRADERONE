module.exports = (app, opts={}) => {
  const express = require("express");
  const fs = require("fs");
  const path = require("path");
  const crypto = require("crypto");
  const {Connection, PublicKey} = require("@solana/web3.js");
  const {getAssociatedTokenAddress} = require("@solana/spl-token");

  if(!app._wolv_json){ app.use(express.json({limit:"1mb"})); app._wolv_json=1; }

  const RPC = process.env.SOLANA_RPC || opts.rpc || "RPC_DEFAULT";
  const BOT_PUB = process.env.TRADERONE_BOT_PUB || opts.bot || "BOT_PUB_DEFAULT";
  const USDC_MINT = (process.env.USDC_MINT || opts.usdc || "USDC_MINT").trim();
  const LEDGER_FILE = process.env.WOLV_LEDGER_FILE || opts.ledger || "LEDGER_FILE_DEFAULT";
  const SCAN_LIMIT = Number(process.env.WOLV_SCAN_LIMIT||"80");

  const conn = new Connection(RPC, "confirmed");
  const bot = new PublicKey(BOT_PUB);
  const usdcMint = new PublicKey(USDC_MINT);

  const now = ()=>Date.now();
  const jread = () => { try { return JSON.parse(fs.readFileSync(LEDGER_FILE,"utf8")); } catch(e){ return {"users":{},"pool":{"SOL":{"deposited":0,"withdrawn":0},"USDC":{"deposited":0,"withdrawn":0}},"withdraw_requests":[],"updated":0}; } };
  const jwrite = (o) => { o.updated=now(); const tmp=LEDGER_FILE+".tmp"; fs.writeFileSync(tmp, JSON.stringify(o)); fs.renameSync(tmp, LEDGER_FILE); };

  const num = (x)=>{ const n=Number(x); return Number.isFinite(n)?n:0; };
  const ok = (res, obj)=>res.json({ok:true, ...obj});
  const bad = (res, msg, extra={})=>res.status(400).json({ok:false, err:String(msg||"bad_request"), ...extra});

  async function sumUSDC(owner){
    const accts = await conn.getParsedTokenAccountsByOwner(owner, {mint: usdcMint});
    let tot=0;
    for(const a of (accts.value||[])){
      const ui = a.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
      tot += num(ui);
    }
    return tot;
  }

  async function getBotBalances(){
    const lam = await conn.getBalance(bot);
    const sol = lam/1e9;
    const usdc = await sumUSDC(bot);
    return {SOL:sol, USDC:usdc};
  }

  async function findDeposit(pubStr, asset, wantAmt){
    const pub = new PublicKey(pubStr);
    const want = num(wantAmt);
    if(want<=0) return null;

    const sigs = await conn.getSignaturesForAddress(bot, {limit: SCAN_LIMIT});
    const botAta = await getAssociatedTokenAddress(usdcMint, bot, true);
    const userAta = await getAssociatedTokenAddress(usdcMint, pub, true);

    for(const s of sigs){
      const sig = s.signature;
      const tx = await conn.getParsedTransaction(sig, {maxSupportedTransactionVersion:0});
      if(!tx || !tx.transaction) continue;

      const ixs = tx.transaction.message.instructions || [];
      for(const ix of ixs){
        const parsed = ix.parsed;
        if(!parsed || !parsed.info) continue;

        // SOL transfer
        if(asset==="SOL" && ix.program==="system" && parsed.type==="transfer"){
          const src=parsed.info.source, dst=parsed.info.destination;
          const lam=num(parsed.info.lamports);
          const amt=lam/1e9;
          if(src===pub.toBase58() && dst===bot.toBase58() && amt+1e-9 >= want){
            return {sig, matched:amt};
          }
        }

        // USDC transfer
        if(asset==="USDC" && ix.program==="spl-token" && (parsed.type==="transfer" || parsed.type==="transferChecked")){
          const src=parsed.info.source, dst=parsed.info.destination;
          const mint=parsed.info.mint || (parsed.info.tokenAmount && parsed.info.tokenAmount.mint);
          let amt = 0;
          if(parsed.info.tokenAmount && parsed.info.tokenAmount.uiAmount!=null) amt = num(parsed.info.tokenAmount.uiAmount);
          else if(parsed.info.amount!=null){
            // amount est souvent en base units; si decimals présent, on calc
            const dec = num(parsed.info.decimals);
            const raw = num(parsed.info.amount);
            amt = dec>0 ? raw/Math.pow(10,dec) : raw;
          }
          if(src===userAta.toBase58() && dst===botAta.toBase58() && String(mint||USDC_MINT)===USDC_MINT && amt+1e-6 >= want){
            return {sig, matched:amt};
          }
        }
      }
    }
    return null;
  }

  async function computeState(pubStr){
    const L = jread();
    const u = L.users[pubStr] || (L.users[pubStr]={SOL:{deposited:0,withdrawn:0,lastSig:""},USDC:{deposited:0,withdrawn:0,lastSig:""},mode:"SAFE",created:now(),updated:now()});
    const totals = {
      SOL: num(Object.values(L.users).reduce((a,x)=>a+num(x.SOL?.deposited||0)-num(x.SOL?.withdrawn||0),0)),
      USDC: num(Object.values(L.users).reduce((a,x)=>a+num(x.USDC?.deposited||0)-num(x.USDC?.withdrawn||0),0))
    };
    const botBal = await getBotBalances();
    const userNet = {
      SOL: num(u.SOL.deposited)-num(u.SOL.withdrawn),
      USDC: num(u.USDC.deposited)-num(u.USDC.withdrawn)
    };
    const share = {
      SOL: totals.SOL>0 ? userNet.SOL/totals.SOL : 0,
      USDC: totals.USDC>0 ? userNet.USDC/totals.USDC : 0
    };
    const withdrawable = {
      SOL: Math.max(0, share.SOL * botBal.SOL),
      USDC: Math.max(0, share.USDC * botBal.USDC)
    };
    const profit = {
      SOL: botBal.SOL - totals.SOL,
      USDC: botBal.USDC - totals.USDC
    };
    return {ledger:L, user:u, totals, botBal, userNet, share, withdrawable, profit};
  }

  // CONFIRM deposit on-chain (scan recent incoming txs)
  app.post("/api/confirm_deposit_v2", async (req,res)=>{
    try{
      const pub = String(req.body.pub||"").trim();
      const asset = String(req.body.asset||"").trim().toUpperCase();
      const amount = num(req.body.amount);
      if(!pub) return bad(res,"missing_pub");
      if(asset!=="SOL" && asset!=="USDC") return bad(res,"bad_asset");
      if(!(amount>0)) return bad(res,"bad_amount");

      const L = jread();
      const u = L.users[pub] || (L.users[pub]={SOL:{deposited:0,withdrawn:0,lastSig:""},USDC:{deposited:0,withdrawn:0,lastSig:""},mode:"SAFE",created:now(),updated:now()});

      const found = await findDeposit(pub, asset, amount);
      if(!found) return res.json({ok:false, err:"not_found", hint:"Envoie via Phantom puis réessaie. (scan recent txs)"});

      if((u[asset].lastSig||"")===found.sig) return ok(res,{already:true, sig:found.sig, matched:found.matched});

      // double-check not used by other user
      for(const [k,v] of Object.entries(L.users)){
        if(k!==pub && (v?.[asset]?.lastSig||"")===found.sig){
          return res.json({ok:false, err:"sig_already_used", sig:found.sig});
        }
      }

      u[asset].deposited = num(u[asset].deposited) + found.matched;
      u[asset].lastSig = found.sig;
      u.updated = now();
      L.users[pub]=u;
      jwrite(L);

      const st = await computeState(pub);
      return ok(res,{sig:found.sig, matched:found.matched, state:{userNet:st.userNet, share:st.share, withdrawable:st.withdrawable, botBal:st.botBal}});
    }catch(e){
      return res.status(500).json({ok:false, err:"server_error", msg:String(e&&e.message||e)});
    }
  });

  // INVESTED status
  app.get("/api/invested", async (req,res)=>{
    try{
      const pub = String(req.query.pub||"").trim();
      if(!pub) return bad(res,"missing_pub");
      const st = await computeState(pub);
      return ok(res,{pub, mode:st.user.mode||"SAFE", userNet:st.userNet, totals:st.totals, botBal:st.botBal, share:st.share, profit:st.profit, withdrawable:st.withdrawable});
    }catch(e){
      return res.status(500).json({ok:false, err:"server_error", msg:String(e&&e.message||e)});
    }
  });

  // SET MODE
  app.post("/api/set_mode", async (req,res)=>{
    try{
      const pub = String(req.body.pub||"").trim();
      const mode = String(req.body.mode||"").trim().toUpperCase();
      const allowed = ["SAFE","AUTO","RR","SCALP"];
      if(!pub) return bad(res,"missing_pub");
      if(!allowed.includes(mode)) return bad(res,"bad_mode",{allowed});
      const L=jread();
      const u = L.users[pub] || (L.users[pub]={SOL:{deposited:0,withdrawn:0,lastSig:""},USDC:{deposited:0,withdrawn:0,lastSig:""},mode:"SAFE",created:now(),updated:now()});
      u.mode=mode; u.updated=now(); L.users[pub]=u; jwrite(L);
      return ok(res,{pub,mode});
    }catch(e){
      return res.status(500).json({ok:false, err:"server_error", msg:String(e&&e.message||e)});
    }
  });

  // WITHDRAW REQUEST (record only; bot can process later)
  app.post("/api/withdraw_request", async (req,res)=>{
    try{
      const pub = String(req.body.pub||"").trim();
      const asset = String(req.body.asset||"").trim().toUpperCase();
      const amount = num(req.body.amount);
      const to = String(req.body.to||"").trim();
      if(!pub) return bad(res,"missing_pub");
      if(asset!=="SOL" && asset!=="USDC") return bad(res,"bad_asset");
      if(!(amount>0)) return bad(res,"bad_amount");
      try{ new PublicKey(to); }catch(_){ return bad(res,"bad_to"); }

      const st = await computeState(pub);
      const max = num(st.withdrawable[asset]);
      if(amount - max > 1e-9) return bad(res,"amount_exceeds_withdrawable",{max});

      const L = st.ledger;
      const id = crypto.randomBytes(8).toString("hex");
      L.withdraw_requests = Array.isArray(L.withdraw_requests)?L.withdraw_requests:[];
      L.withdraw_requests.push({id, pub, asset, amount, to, share:st.share[asset], created:now(), status:"PENDING"});
      jwrite(L);
      return ok(res,{id, status:"PENDING", max});
    }catch(e){
      return res.status(500).json({ok:false, err:"server_error", msg:String(e&&e.message||e)});
    }
  });

  // simple ping for debug
  app.get("/api/wolv_ping", (req,res)=>res.json({ok:true, bot:BOT_PUB, rpc:RPC, usdc:USDC_MINT}));
};

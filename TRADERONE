iv class="card"><b>Grafcet Système (interne/externe)</b><pre id="grafSys">—</pre></div><div class="card"><b>Grafcet Apprentissage (interne/externe)</b><pre id="grafLrn">—</pre></div><div class="card"><b>Actions PENDING (autorisation)</b><pre id="pend">—</pre></div></div></div><div id="right"><div class="scan"></div><div class="hd"><b>Discussion</b><span id="discStat">—</span></div><div id="log"></div><div id="quick"></div><div id="sendRow"><input id="in" placeholder="Réponds ici (1 question à la fois)"><button id="send">ENVOYER</button></div></div></div></div><script>(()=>{"use strict";const $=s=>document.querySelector(s),esc=s=>String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));const now=()=>new Date().toLocaleTimeString("fr-CA",{hour12:false});const API_BASE="/aquilaai/api";const KEY="aquilaai_front_v1";let S=null;const log=$("#log"),quick=$("#quick");const netChip=$("#netChip"),modeChip=$("#modeChip"),stepChip=$("#stepChip"),errChip=$("#errChip");const clock=$("#clock"),panStat=$("#panStat");const st_sys=$("#st_sys"),st_lrn=$("#st_lrn"),st_ie=$("#st_ie"),st_ram=$("#st_ram"),st_rss=$("#st_rss"),st_perm=$("#st_perm");const grafSys=$("#grafSys"),grafLrn=$("#grafLrn"),pend=$("#pend"),discStat=$("#discStat");const inEl=$("#in");const speak=(t)=>{if(!S.voice||!window.speechSynthesis) return;try{speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(String(t||""));u.lang="fr-CA";u.rate=1.03;u.pitch=.98;u.volume=1;speechSynthesis.speak(u);}catch(_){}};const save=()=>localStorage.setItem(KEY,JSON.stringify(S));const load=()=>{try{S=JSON.parse(localStorage.getItem(KEY)||"null");}catch(_){S=null;}if(!S||typeof S!=="object"){S={voice:true,sarcasm:true,ui:{booted:false},stats:{err:0,inter:0},ctx:{lastTitle:"",lastUrl:""},loops:{sys:{internal:true,external:true,step:"S0_INIT"},lrn:{internal:true,external:true,step:"L0_SCAN"}},last:{metrics:null,state:null,rss:null,article:null,pending:[]}};save();}};const add=(who,txt,cls)
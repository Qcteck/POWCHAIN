set -e
cd /root

echo "=== AVANT: fichiers fireinners dans sites-enabled ==="
ls -la /etc/nginx/sites-enabled | grep -i fireinners || true

echo
echo "=== Supprime TOUS les .bak* dans sites-enabled (ils ne doivent jamais être là) ==="
rm -fv /etc/nginx/sites-enabled/*bak* 2>/dev/null || true
rm -fv /etc/nginx/sites-enabled/*.bak 2>/dev/null || true

echo
echo "=== APRES: fichiers fireinners dans sites-enabled ==="
ls -la /etc/nginx/sites-enabled | grep -i fireinners || true

echo
echo "=== Test nginx ==="
nginx -t

echo
echo "=== Reload nginx ==="
systemctl reload nginx
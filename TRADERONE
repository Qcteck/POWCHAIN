bash -lc 'set -euo pipefail;echo "== server blocks matching fireinners.online ==";grep -RIn --include="*" "server_name .*fireinners\.online" /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null||true;echo;echo "== files containing _private_sentinel1 ==";grep -RIn "_private_sentinel1" /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null||true;echo;echo "== active ssl vhosts (sites-enabled) ==";ls -l /etc/nginx/sites-enabled|sed -n "1,200p";'
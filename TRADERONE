import re,sys
vhost=sys.argv[1]
domain="fireinners.online"
lines=open(vhost,'r',encoding='utf-8',errors='ignore').read().splitlines(True)

managed = r'''
    # BEGIN AQUILATRADER_MANAGED
    location ^~ /aquilatrader/ {
        alias /var/www/aquilatrader/;
        try_files $uri $uri/ /aquilatrader/index.html;
        add_header Cache-Control "no-store" always;
    }
    # END AQUILATRADER_MANAGED
'''

# Find server block for domain+443; inject before its closing brace
out=[]
i=0
n=len(lines)
in_server=False
brace=0
server_buf=[]
server_start_idx=None
server_file_out=[]

def server_matches(block):
    return (re.search(r'\blisten\b[^;]*\b443\b', block) and
            re.search(r'\bserver_name\b[^;]*\b'+re.escape(domain)+r'\b', block))

while i<n:
    line=lines[i]
    if not in_server and re.search(r'^\s*server\s*\{', line):
        in_server=True
        brace=1
        server_buf=[line]
        server_start_idx=len(out)
        i+=1
        continue
    if in_server:
        server_buf.append(line)
        brace += line.count('{') - line.count('}')
        i+=1
        if brace<=0:
            block="".join(server_buf)
            if server_matches(block):
                # inject just before final closing brace of this server block
                # find last '}' line
                sb=server_buf[:]
                # ensure newline before inject
                if not sb[-1].endswith("\n"): sb[-1]+="\n"
                # last line is expected to contain closing brace
                # Insert before last line
                sb = sb[:-1] + [managed if managed.endswith("\n") else managed+"\n"] + sb[-1:]
                out.extend(sb)
                in_server=False
                server_buf=[]
                server_start_idx=None
                continue
            else:
                out.extend(server_buf)
                in_server=False
                server_buf=[]
                server_start_idx=None
                continue
        continue
    out.append(line)
    i+=1

open(vhost,'w',encoding='utf-8').write("".join(out))
print("OK: injected managed block into", vhost)

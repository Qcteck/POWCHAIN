cat >/tmp/MEGA_WOLVERINE_FRONT_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
set +H 2>/dev/null || true
[ "$(id -u)" = "0" ] || { echo "ERREUR: lance en root"; exit 1; }

need(){ command -v "$1" >/dev/null 2>&1 || { echo "ERREUR: $1 manquant"; exit 1; }; }
need perl; need nginx; need curl; need sed; need grep; need awk; need date; need systemctl || true
command -v node >/dev/null 2>&1 && HAVE_NODE=1 || HAVE_NODE=0

WEBDIST="/opt/fireinners/frontend-react/app/dist"
WEBDIR="${WEBDIST}/wolverine"
INDEX="${WEBDIR}/index.html"
SITE="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/fireinners-wolverine.conf"

echo "=== PRECHECK ==="
echo "INDEX=$INDEX"
[ -f "$INDEX" ] || { echo "ERREUR: index introuvable"; exit 1; }
nginx -t >/dev/null && echo "NGINX: OK"

echo
echo "=== BACKUP ==="
cp -a "$INDEX" "$INDEX.bak.$(date -u +%Y%m%d%H%M%S)"

echo
echo "=== PATCH 1: apostrophes FR dans strings/template ==="
# remplace seulement les apostrophes ASCII ENTRE LETTRES (inclut accents)
perl -CSDA -pi -e '
s/([A-Za-zÀ-ÖØ-öø-ÿ])'\''([A-Za-zÀ-ÖØ-öø-ÿ])/$1’$2/g;
' "$INDEX"

echo
echo "=== PATCH 2: Custody quotes => Custody ==="
# évite les guillemets qui cassent les strings JS minifiées
perl -pi -e 's/"Custody"/Custody/g; s/'\''Custody'\''/Custody/g;' "$INDEX"

echo
echo "=== QUICK GREP (should be empty for common breakers) ==="
grep -n "l'adresse\|n'envoie\|d'ici\|j'en\|c'est\|qu'il\|s'il\|\"Custody\"\|\'Custody\'" "$INDEX" || true

echo
echo "=== OPTIONAL: JS SYNTAX CHECK (extract first <script> blocks) ==="
if [ "$HAVE_NODE" = "1" ]; then
  perl -0777 -ne '
    while (m#<script[^>]*>(.*?)</script>#sg) { print $1."\n"; }
  ' "$INDEX" > /tmp/wolv_extract.js || true
  if [ -s /tmp/wolv_extract.js ]; then
    node --check /tmp/wolv_extract.js && echo "NODE CHECK: OK" || echo "NODE CHECK: FAIL (mais patch appliqué)"
  else
    echo "NODE CHECK: skip (no script extracted)"
  fi
else
  echo "NODE CHECK: skip (node absent)"
fi

echo
echo "=== ENSURE NO-CACHE (nginx snippet) ==="
# si jamais le snippet a sauté, on ne touche pas à tes autres locations, on force juste cache-control
if [ -f "$SNIP" ]; then
  grep -q 'Cache-Control "no-store' "$SNIP" || echo "WARN: snippet present but no Cache-Control found"
else
  echo "WARN: snippet missing: $SNIP"
fi

echo
echo "=== NGINX RELOAD ==="
nginx -t
systemctl reload nginx 2>/dev/null || systemctl reload nginx || true

echo
echo "=== TESTS ==="
echo "-- front head --"
curl -sS "https://fireinners.online/wolverine/" | head -c 220; echo
echo "-- ping --"
curl -sS -D- "https://fireinners.online/wolverine/api/ping" | head -n 12

echo
echo "DONE"
echo "Sur PC: fais Ctrl+F5 sur https://fireinners.online/wolverine/ puis ouvre la console."
BASH
bash /tmp/MEGA_WOLVERINE_FRONT_FIX.sh
cat >/root/WOLV_FIX_BLANK_PAGE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 1) Trouver le dossier réellement servi par nginx pour /wolverine =="
NGINX_ROOTS=$(grep -RIn --no-messages "location\s\+\/wolverine" /etc/nginx 2>/dev/null || true)
echo "$NGINX_ROOTS" | head -n 50 || true

# Heuristique: on garde ton dist connu si présent
WEB_DIR=""
for d in \
  /opt/fireinners/frontend-react/app/dist/wolverine \
  /var/www/fireinners/wolverine \
  /var/www/wolverine \
  /opt/traderone-opt/public
do
  if [ -d "$d" ]; then WEB_DIR="$d"; break; fi
done
[ -n "$WEB_DIR" ] || { echo "ERR: dossier wolverine introuvable"; exit 1; }
echo "WEB_DIR=$WEB_DIR"

echo "== 2) Vérifier que le JS patch est servi par le web server =="
echo "Fichiers patches:"
ls -la "$WEB_DIR/patches" 2>/dev/null || true

echo "== 3) Voir si index.html contient les scripts injectés =="
for f in "$WEB_DIR"/*.html "$WEB_DIR"/*/*.html; do
  [ -f "$f" ] || continue
  if grep -q "patches/patch_hide_share.js" "$f" || grep -q "patches/wolv_invested.js" "$f"; then
    echo "--- $f (scripts trouvés) ---"
    grep -n "patches/patch_hide_share.js\|patches/wolv_invested.js" "$f" || true
  fi
done

echo "== 4) ROLLBACK: retirer patch_hide_share.js des HTML (si présent) =="
for f in "$WEB_DIR"/*.html "$WEB_DIR"/*/*.html; do
  [ -f "$f" ] || continue
  if grep -q "patches/patch_hide_share.js" "$f"; then
    cp -a "$f" "$f.bak.$(date +%s)"
    sed -i '/patches\/patch_hide_share\.js/d' "$f"
    echo "ROLLBACK HTML -> $f"
  fi
done

echo "== 5) (optionnel) si page encore blanche, retirer aussi wolv_invested.js =="
# Décommente les 3 lignes ci-dessous si besoin :
# for f in "$WEB_DIR"/*.html "$WEB_DIR"/*/*.html; do
#   [ -f "$f" ] || continue
#   sed -i '/patches\/wolv_invested\.js/d' "$f"
# done

echo "== 6) Reload nginx + hard refresh =="
nginx -t && systemctl reload nginx || true

echo "DONE. Maintenant recharge la page: Ctrl+F5 sur https://fireinners.online/wolverine/"
BASH

bash /root/WOLV_FIX_BLANK_PAGE.sh
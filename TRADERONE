cat >/tmp/wolfchain_remove_dex_options_full.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/opt/fireinners/frontend-react/app/dist"
if [[ -f "$VHOST" ]]; then
  R="$(awk 'BEGIN{r=""} /^\s*root\s+/{gsub(/;$/,"",$2); if(r=="") r=$2} END{print r}' "$VHOST" 2>/dev/null || true)"
  [[ -n "${R:-}" ]] && ROOT="$R"
fi
F="$ROOT/index.html"

ts(){ date +"%Y%m%d-%H%M%S"; }
bk(){ [[ -f "$1" ]] && cp -a "$1" "$1.bak.$(ts)" && echo "backup: $1.bak.$(ts)"; }

[[ -f "$F" ]] || { echo "ERR missing: $F"; exit 1; }
bk "$F"

# 1) Remove DEX + Options tiles from grid
perl -0777 -i -pe '
  s#<a\s+class="tile"\s+href="/dex/"\s*>.*?</a>##gs;
  s#<a\s+class="tile"\s+href="/options/"\s*>.*?</a>##gs;
' "$F"

# 2) Remove "DEX" + "Options" from subtitle (HTML + JS dict)
perl -0777 -i -pe '
  s#Wallet\s*•\s*DEX\s*•\s*Bridge\s*•\s*Explorer\s*•\s*Mining\s*•\s*Options#Wallet • Bridge • Explorer • Mining • WOLVERINE#g;
  s#Wallet\s*•\s*DEX\s*•\s*Bridge\s*•\s*Explorer\s*•\s*Mining\s*•\s*Options#Wallet • Bridge • Explorer • Mining • WOLVERINE#g;
' "$F"

# 3) Make $() safe so removed ids never crash JS
# Old: const $=id=>document.getElementById(id);
# New: const $=id=>document.getElementById(id)||{textContent:"",className:""};
perl -0777 -i -pe '
  s#const\s+\$=id=>document\.getElementById\(id\);#const $=id=>document.getElementById(id)||{textContent:"",className:""};#g
' "$F"

echo "OK: removed /dex + /options tiles and hardened JS."
echo "Verify (should be empty):"
grep -nE 'href="/(dex|options)/"' "$F" || true
echo "Test:"
echo "  curl -sS -i https://127.0.0.1/ -H 'Host: fireinners.online' | head -n 12"
SH
bash /tmp/wolfchain_remove_dex_options_full.sh
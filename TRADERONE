# remove existing block if present
raw2 = re.sub(re.escape(MARK_BEGIN)+r".*?"+re.escape(MARK_END)+r"\n?", "", raw, flags=re.S)

def split_server_blocks(text):
    # naive brace parser
    blocks=[]
    i=0
    while True:
        m=re.search(r"\bserver\s*\{", text[i:])
        if not m: break
        start=i+m.start()
        j=start+m.end()-m.start()
        depth=0
        k=j
        while k < len(text):
            if text[k] == "{": depth += 1
            elif text[k] == "}":
                if depth == 0:
                    end = k+1
                    blocks.append((start,end))
                    i=end
                    break
                depth -= 1
            k += 1
        else:
            break
    return blocks

blocks = split_server_blocks(raw2)
if not blocks:
    die("Aucun bloc server{} trouvé dans le vhost.")

# choose best block: has server_name fireinners.online and listen 443
best=None
for (a,b) in blocks:
    seg=raw2[a:b]
    if ("server_name" in seg and "fireinners.online" in seg and "443" in seg):
        best=(a,b); break
if not best:
    for (a,b) in blocks:
        seg=raw2[a:b]
        if ("server_name" in seg and "fireinners.online" in seg):
            best=(a,b); break
if not best:
    best=blocks[0]

a,b=best
seg=raw2[a:b]
# inject before last "}" of that server block
ins = block
seg2 = seg[:-1] + "\n" + ins + "}\n"
raw3 = raw2[:a] + seg2 + raw2[b:]

# Add markers explicitly (so regex remove works)
raw3 = raw3.replace("# BEGIN WOLVERINE_BLOCK", MARK_BEGIN).replace("# END WOLVERINE_BLOCK", MARK_END)

# backup vhost
try:
    bk = VHOST.with_suffix(VHOST.suffix+f".bak.{TS}")
    shutil.copy2(VHOST, bk)
    log(f"Backup vhost: {bk}")
except Exception as e:
    log(f"Backup vhost warning: {e}")

VHOST.write_text(raw3, encoding="utf-8")
log("Vhost patch OK")

# 4) Test + reload nginx
t = sh("nginx -t")
log(t.stdout.strip())
if t.returncode != 0:
    die("nginx -t a échoué (j'ai laissé le backup vhost).")

sh("systemctl reload nginx || systemctl restart nginx || true")
log("nginx reload done")

# re-lock vhost if you use immutability
sh(f"chattr +i {VHOST} 2>/dev/null || true")

print("")

set -euo pipefail
HTML="/var/www/fireinners/wolverine/index.html"
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"

cp -a "$HTML"  "$HTML.bak.$TS"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backups: $HTML.bak.$TS | $APPJS.bak.$TS"

# 1) btnStart en type=button
perl -i -pe 's/<button([^>]*\sid="btnStart"[^>]*)>/<button type="button"$1>/i' "$HTML"

# 2) Expose startFlow + force click => window.startWolverine()
node - <<'JS'
const fs=require("fs");
const f="/var/www/fireinners/wolverine/app.js";
let s=fs.readFileSync(f,"utf8");

// Expose startFlow once
if(!s.includes("window.startWolverine = startFlow")){
  s = s.replace(/async function startFlow\(\)\{[\s\S]*?\n\}/m, (m)=>{
    // ajoute l'export juste après la fonction
    return m + "\n\n  window.startWolverine = startFlow;\n";
  });
}

// Force button click to call window.startWolverine (append-only, safe)
if(!s.includes("WOLVERINE_FORCE_START_POPUP_V1")){
  s += `

/* WOLVERINE_FORCE_START_POPUP_V1 */
(function(){
  const btn = document.getElementById("btnStart");
  if(!btn) return;

  btn.addEventListener("click", async (ev)=>{
    ev.preventDefault();
    ev.stopPropagation();
    console.log("[START] forcing startWolverine()");
    try{
      if(!window.solana || !window.solana.isPhantom){
        (window.setStatus||console.log)("ERR: Phantom non détecté");
        return;
      }
      if(typeof window.startWolverine !== "function"){
        (window.setStatus||console.log)("ERR: startWolverine introuvable (app.js pas à jour)");
        return;
      }
      await window.startWolverine();
    } catch(e){
      console.error(e);
      (window.setStatus||console.log)("ERR " + (e?.message||e));
    }
  }, true);
})();
`;
}

fs.writeFileSync(f,s,"utf8");
console.log("OK: startWolverine exposed + start click forced");
JS

echo "DONE ✅ -> Ctrl+F5 sur /wolverine puis clique START (Phantom doit pop)"
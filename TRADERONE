sudo bash -lc 'set -euo pipefail
AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "[A] show current EN target"
ls -la "$EN" || true

echo "[B] pick latest backups (if any)"
BAV="$(ls -1t "$AV".bak_probe_fix_* "$AV".bak_probe_* 2>/dev/null | head -n 1 || true)"
BEN="$(ls -1t "$EN".bak_probe_fix_* "$EN".bak_probe_* 2>/dev/null | head -n 1 || true)"
echo "BAV=$BAV"
echo "BEN=$BEN"

echo "[C] restore sites-enabled first (most likely culprit)"
if [ -n "${BEN:-}" ]; then
  rm -f "$EN"
  cp -a "$BEN" "$EN"
  echo "restored EN from backup"
else
  echo "no EN backup found"
fi

echo "[D] optionally restore sites-available too"
if [ -n "${BAV:-}" ]; then
  cp -a "$BAV" "$AV"
  echo "restored AV from backup"
else
  echo "no AV backup found"
fi

echo "[E] nginx test (must be OK)"
nginx -t
systemctl reload nginx
echo "OK: nginx reloaded"
'
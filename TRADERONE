#!/usr/bin/env bash
set -euo pipefail

echo "==============================================="
echo " AIAQUILA PROXY — ROOT VERIFICATION BATCH"
echo "==============================================="

PROXY_URL="https://aiaquila-proxy.paycashnostory.workers.dev"
LOG="/root/aiaquila_proxy_check_$(date +%Y%m%d_%H%M%S).log"

echo "Proxy URL : $PROXY_URL"
echo "Log file  : $LOG"
echo ""

exec > >(tee -a "$LOG") 2>&1

echo "==[1] BASIC CONNECTIVITY =="
curl -s -I "$PROXY_URL/health" || echo "❌ Health endpoint unreachable"
echo ""

echo "==[2] HEALTH CHECK =="
curl -s "$PROXY_URL/health" | jq . || curl -s "$PROXY_URL/health"
echo ""

echo "==[3] RSS — ECONOMY =="
curl -s "$PROXY_URL/rss?cat=economy" | head -n 40
echo ""

echo "==[4] RSS — CRYPTO =="
curl -s "$PROXY_URL/rss?cat=crypto" | head -n 40
echo ""

echo "==[5] PRICE CHECK =="
curl -s "$PROXY_URL/price?ids=bitcoin,solana,ethereum" | jq . || curl -s "$PROXY_URL/price?ids=bitcoin,solana,ethereum"
echo ""

echo "==[6] ENTITY EXTRACTION TEST =="
echo "Elon Musk and Michael Saylor commented on Bitcoin and Solana." | \
curl -s -X POST "$PROXY_URL/entities" --data-binary @- | jq . || true
echo ""

echo "==[7] TLS / DNS INFO =="
echo | openssl s_client -connect aiaquila-proxy.paycashnostory.workers.dev:443 -servername aiaquila-proxy.paycashnostory.workers.dev 2>/dev/null | \
grep -E "subject=|issuer=|Verify return code"
echo ""

echo "==[8] LATENCY TEST =="
for i in {1..5}; do
  curl -o /dev/null -s -w "Ping $i → %{time_total}s\n" "$PROXY_URL/health"
done
echo ""

echo "==============================================="
echo " ✅ AIAQUILA PROXY CHECK COMPLETED"
echo " Log saved to: $LOG"
echo "==============================================="
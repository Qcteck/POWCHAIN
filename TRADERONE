<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Test Moteur Quantique</title>
<style>
  body { font-family: Arial, sans-serif; background:#111; color:#eee; padding:20px; }
  #log { max-height:400px; overflow-y:scroll; background:#222; padding:10px; border-radius:5px; }
  .ok { color:#0f0; }
  .warn { color:#ff0; }
  .error { color:#f00; }
</style>
</head>
<body>

<h2>Test du Moteur Quantique</h2>
<div>
  <button id="startBtn">Lancer Test</button>
</div>
<h3>Logs :</h3>
<div id="log"></div>

<script>
const N_cycles = 200;
const N_min = 5, N_max = 15;
const H_min = 0.3, H_max = 0.7;
const gmin = 0.05;

// état moteur simulé
let moteur = {
  seed: 42,
  N_c: 10,
  H_w: 0.5,
  niveau: 0,
  symetries: true
};

// fonctions internes simulées
function T(state) {
  // évolution simple avec bruit
  state.N_c += Math.round((Math.random()-0.5)*2);
  state.H_w += (Math.random()-0.5)*0.05;
  state.niveau = Math.floor(Math.random()*3); // 3 niveaux
  return state;
}

function corrige_Nc(state) {
  if(state.N_c < N_min) state.N_c = N_min;
  if(state.N_c > N_max) state.N_c = N_max;
  return state;
}

function corrige_Hw(state) {
  if(state.H_w < H_min) state.H_w = H_min;
  if(state.H_w > H_max) state.H_w = H_max;
  return state;
}

function panneau_verifie_symmetries(state) {
  // simulate random violation
  return Math.random() < 0.05 ? false : true;
}

function logCycle(cycle, state, sym_ok) {
  const div = document.getElementById('log');
  const line = document.createElement('div');
  line.innerHTML = `Cycle ${cycle} | Niveau E: ${state.niveau} | N_c: ${state.N_c} | H_w: ${state.H_w.toFixed(2)} | Symétries: <span class="${sym_ok?'ok':'error'}">${sym_ok?'OK':'VIOLATION'}</span>`;
  div.appendChild(line);
  div.scrollTop = div.scrollHeight;
}

document.getElementById('startBtn').addEventListener('click', () => {
  let cycle = 0;
  let interval = setInterval(() => {
    if(cycle >= N_cycles) { clearInterval(interval); return; }

    moteur = T(moteur);

    // correction invariants
    moteur = corrige_Nc(moteur);
    moteur = corrige_Hw(moteur);

    // vérifier symétries
    const sym_ok = panneau_verifie_symmetries(moteur);

    logCycle(cycle, moteur, sym_ok);
    cycle++;
  }, 50); // 50ms par cycle pour visualiser
});
</script>

</body>
</html>

cat >/tmp/WOLVERINE_ADD_START_ROUTE_SAFE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SVC="traderone.service"
TS="$(date +%s)"
PAYLOAD='{"wallet":"2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z","budget":1}'

echo "== 1) Trouver le vrai fichier lancé par systemd =="
systemctl cat "$SVC" --no-pager | sed -n '1,200p'
EXE="$(systemctl show -p ExecStart "$SVC" --value | head -n1)"
echo
echo "ExecStart: $EXE"
echo

# essaye d'extraire le .js du ExecStart
MAIN="$(echo "$EXE" | grep -oE '/[^ ]+\.js' | head -n1 || true)"

# fallback: cherche un fichier qui mentionne express + 8585
if [ -z "${MAIN:-}" ]; then
  echo "WARN: pas de .js dans ExecStart, fallback search..."
  MAIN="$(grep -RIl --exclude-dir=node_modules -E 'express\(|app\.listen\(|8585' /opt /var/www 2>/dev/null | head -n1 || true)"
fi

if [ -z "${MAIN:-}" ] || [ ! -f "$MAIN" ]; then
  echo "❌ Impossible de trouver le fichier principal Node."
  echo "Donne-moi la sortie de: systemctl cat traderone.service"
  exit 1
fi

echo "MAIN JS = $MAIN"
echo

echo "== 2) Backup =="
cp -a "$MAIN" "$MAIN.bak.$TS"
echo "Backup: $MAIN.bak.$TS"
echo

echo "== 3) Injecter route start (sans bash-substitution) =="
cat >/tmp/_patch_start_route.js <<'JS'
const fs = require("fs");

const file = process.argv[2];
let s = fs.readFileSync(file, "utf8");

if (s.includes("WOLVERINE_START_ROUTE_BEGIN")) {
  console.log("Route start déjà présente -> skip");
  process.exit(0);
}

// endroit d'injection: après app.use(express.json()) si trouvé, sinon après app=express()
let insertPos = -1;

let m = s.match(/app\.use\(\s*express\.json\(\)\s*\)\s*;?/);
if (m) insertPos = s.indexOf(m[0]) + m[0].length;

if (insertPos < 0) {
  m = s.match(/const\s+app\s*=\s*express\(\)\s*;?/);
  if (!m) throw new Error("Impossible de trouver `const app = express()` dans " + file);
  insertPos = s.indexOf(m[0]) + m[0].length;
}

const block = `

/* WOLVERINE_START_ROUTE_BEGIN */
// Simple route start pour que le bouton START fonctionne.
// À connecter ensuite à la logique réelle du bot si besoin.
app.post("/wolverine/traderone/api/start", async (req, res) => {
  try {
    const body = req.body || {};
    console.log("[START] payload:", body);

    // TODO: ici tu appelles ta vraie fonction de démarrage si tu en as une
    // ex: await startTraderOne(body.wallet, body.budget);

    return res.json({ ok: true, received: body, msg: "start accepted" });
  } catch (e) {
    return res.status(500).json({ ok: false, error: "start_failed", detail: String(e?.message || e) });
  }
});
/* WOLVERINE_START_ROUTE_END */
`;

s = s.slice(0, insertPos) + block + s.slice(insertPos);
fs.writeFileSync(file, s, "utf8");
console.log("Injected start route into:", file);
JS

node /tmp/_patch_start_route.js "$MAIN"
echo

echo "== 4) Restart service =="
systemctl restart "$SVC"
sleep 1
systemctl status "$SVC" --no-pager -l | sed -n '1,40p'
echo

echo "== 5) Test PUBLIC (doit PLUS être 404) =="
curl -ksS -D- "https://fireinners.online/wolverine/traderone/api/start" \
  -X POST -H "Content-Type: application/json" --data "$PAYLOAD" | head -n 60
echo
echo "DONE ✅  -> Ctrl+F5 sur /wolverine puis clique START"
SH

bash /tmp/WOLVERINE_ADD_START_ROUTE_SAFE.sh
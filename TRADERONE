cat >/root/nginx_remove_empty_include.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
[[ -f "$VHOST" ]] || { echo "[ERR] $VHOST introuvable"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$VHOST" "${VHOST}.bak_${ts}"
echo "[OK] Backup -> ${VHOST}.bak_${ts}"

# Supprime: "include ;" ou "include" sans chemin
sed -i -E \
  -e '/^[[:space:]]*include[[:space:]]*;[[:space:]]*$/d' \
  -e '/^[[:space:]]*include[[:space:]]*$/d' \
  "$VHOST"

echo "[OK] Empty include lines removed"
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
BASH

chmod +x /root/nginx_remove_empty_include.sh
/root/nginx_remove_empty_include.sh
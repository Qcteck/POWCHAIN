cat >/root/MEGA_WOLVERINE_UNBLOCK_403.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"

echo "== MEGA_WOLVERINE_UNBLOCK_403 :: $TS =="

test -f "$VHOST" || { echo "[FATAL] missing $VHOST"; exit 1; }
test -f "$INC"   || { echo "[FATAL] missing $INC"; exit 1; }

chattr -i "$VHOST" 2>/dev/null || true
chattr -i "$INC"   2>/dev/null || true

echo "== 1) Backups =="
cp -a "$VHOST" "${VHOST}.bak_${TS}"
cp -a "$INC"   "${INC}.bak_${TS}"
echo "Backup: ${VHOST}.bak_${TS}"
echo "Backup: ${INC}.bak_${TS}"

echo
echo "== 2) Unblock in include (comment allow/deny global) =="
# Idempotent: if markers already present, do nothing.
if grep -q "AUTO_UNBLOCK_DENYALL_BEGIN" "$INC"; then
  echo "OK: markers already present in include"
else
  # Comment the first occurrence of allow 127.0.0.1; and the next deny all;
  perl -0777 -pe '
    if($_ !~ /AUTO_UNBLOCK_DENYALL_BEGIN/){
      s/^\s*allow\s+127\.0\.0\.1\s*;\s*$/# --- AUTO_UNBLOCK_DENYALL_BEGIN ---\n# $&/m;
      s/^\s*deny\s+all\s*;\s*$/# $&\n# NOTE: disabled because it was blocking public /wolverine (403 by rule).\n# --- AUTO_UNBLOCK_DENYALL_END ---/m;
    }
  ' -i "$INC"
  grep -q "AUTO_UNBLOCK_DENYALL_BEGIN" "$INC" || { echo "[FATAL] include patch failed (no marker)"; exit 1; }
  echo "OK: include patched"
fi

echo
echo "== 3) Ensure /wolverine/ location explicitly allows all (vhost) =="
if ! grep -nE "location\s+\^~\s+/wolverine/" "$VHOST" >/dev/null; then
  echo "[FATAL] cannot find location ^~ /wolverine/ in vhost"
  exit 1
fi

# Insert allow all; right after "location ^~ /wolverine/ {" if not present in that block.
python3 - <<'PY'
from pathlib import Path
import re
p=Path("/etc/nginx/sites-available/fireinners.online-ssl")
s=p.read_text(errors="ignore")

m=re.search(r"(location\s+\^~\s+/wolverine/\s*\{\s*\n)([\s\S]*?)(\n\s*\})", s)
if not m:
    raise SystemExit("FATAL: cannot locate location ^~ /wolverine/ block")

head,body,tail=m.group(1),m.group(2),m.group(3)

if re.search(r"^\s*allow\s+all\s*;\s*$", body, re.M):
    print("OK: allow all already present in /wolverine/ block")
    out=s
else:
    inject="    allow all;\n    auth_basic off;\n    satisfy any;\n"
    out=s[:m.start()] + head + inject + body + tail + s[m.end():]
    print("OK: injected allow all into /wolverine/ block")

p.write_text(out)
PY

echo
echo "== 4) nginx -t + reload =="
nginx -t
systemctl reload nginx

echo
echo "== 5) Tests (local with SNI) =="
echo "--- /wolverine/ (should be 301/200, NOT 403) ---"
curl -kI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/ | sed -n '1,25p' || true
echo "--- /wolverine/index.html (should be 200, NOT 403) ---"
curl -kI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/index.html | sed -n '1,25p' || true

echo
echo "== 6) Show remaining allow/deny references (top 80) =="
nginx -T 2>/dev/null | grep -nEi "AUTO_UNBLOCK_DENYALL|deny all|allow 127\.0\.0\.1|location \^~ /wolverine/" | head -n 80 || true

echo
echo "== 7) Tail nginx error log (last 40) =="
tail -n 40 /var/log/nginx/error.log || true

chattr +i "$VHOST" 2>/dev/null || true
chattr +i "$INC"   2>/dev/null || true

echo
echo "DONE."
BASH
chmod +x /root/MEGA_WOLVERINE_UNBLOCK_403.sh
/root/MEGA_WOLVERINE_UNBLOCK_403.sh
bash -lc 'set -euo pipefail
cat >/root/a.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"; BK="/root/AQ_BK_$TS"; mkdir -p "$BK"
say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }; die(){ say "ERR: $*"; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run as root"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v curl  >/dev/null 2>&1 || die "curl missing"
command -v python3 >/dev/null 2>&1 || die "python3 missing"
command -v unzip >/dev/null 2>&1 || die "unzip missing"
umask 022

DOMAIN="fireinners.online"
PATH_A="/aquila_stacking/"
PATH_B="/iaaquila/"
WEBROOT="/var/www/aquila_stacking"
LINKROOT="/var/www/iaaquila"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"
APP="/opt/aquila_stacking_react"
ZIP_URL="${ZIP_URL:-}"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
[ -f "$ASKLIB" ] && . "$ASKLIB" || true

backup(){ local p="$1"; [ -e "$p" ] || return 0; mkdir -p "$BK/$(dirname "$p")"; cp -a "$p" "$BK/$p.bak" 2>/dev/null || true; }

write_file(){
  local path="$1"; shift; local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "aqfix" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(echo "$path" | sed "s#/#_#g").bak" 2>/dev/null || true
    install -m 0644 "$tmp" "$path"
  fi
  rm -f "$tmp"
}

ensure_dirs(){
  say "1) webroot"
  mkdir -p "$WEBROOT"
  chmod 0755 "$WEBROOT" || true
  chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
  [ -e "$LINKROOT" ] || ln -s "$WEBROOT" "$LINKROOT" 2>/dev/null || true
}

get_zip(){
  local z=""
  if [ -n "$ZIP_URL" ]; then
    z="/root/aquila_$TS.zip"
    say "2) zip URL -> $z"
    curl -fsSL "$ZIP_URL" -o "$z" || die "download failed"
  else
    z="$(ls -1t /root/horizons-export*.zip /root/*.zip 2>/dev/null | head -n 1 || true)"
  fi
  echo "$z"
}

ensure_node(){
  if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then return 0; fi
  say "3) node/npm"
  apt-get update -y
  apt-get install -y nodejs npm
}

import_and_build(){
  local z="$1"
  if [ -n "$z" ] && [ -f "$z" ]; then
    say "4) unzip -> $APP"
    rm -rf "$APP"; mkdir -p "$APP"
    unzip -oq "$z" -d "$APP"
  else
    say "4) no zip (skip)"
  fi

  if [ -f "$APP/package.json" ]; then
    ensure_node
    say "5) build"
    cd "$APP"
    npm ci --no-audit --no-fund 2>/dev/null || npm install --no-audit --no-fund
    npm run build || die "npm build failed"
  else
    say "5) no package.json (static assumed)"
  fi
}

deploy(){
  say "6) deploy -> $WEBROOT"
  local SRC=""
  [ -d "$APP/dist" ]  && [ -f "$APP/dist/index.html" ]  && SRC="$APP/dist"
  [ -z "$SRC" ] && [ -d "$APP/out" ]   && [ -f "$APP/out/index.html" ]   && SRC="$APP/out"
  [ -z "$SRC" ] && [ -d "$APP/build" ] && [ -f "$APP/build/index.html" ] && SRC="$APP/build"
  [ -z "$SRC" ] && [ -f "$APP/index.html" ] && SRC="$APP"

  rm -rf "$WEBROOT"/*

  if [ -n "$SRC" ]; then
    cp -a "$SRC"/. "$WEBROOT"/
  else
    cat >"$WEBROOT/index.html"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aquila</title></head><body style="font-family:system-ui;background:#0b1020;color:#d7e3ff;margin:24px"><h1>Aquila</h1><p>Fallback index (no build output found).</p></body></html>
EOF
  fi

  chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
  chmod -R a+rX "$WEBROOT" 2>/dev/null || true
}

write_inc(){
  say "7) nginx include"
  mkdir -p "$(dirname "$INC")"
  write_file "$INC" \
"# Aquila routes
location = ${PATH_A%/} { return 301 $PATH_A; }
location ^~ $PATH_A { root /var/www; try_files \$uri \$uri/ ${PATH_A}index.html; add_header Cache-Control \"no-store\" always; }
location = ${PATH_B%/} { return 301 $PATH_B; }
location ^~ $PATH_B { root /var/www; try_files \$uri \$uri/ ${PATH_B}index.html; add_header Cache-Control \"no-store\" always; }
"
}

patch_vhosts(){
  say "8) patch vhosts"
  local files
  files="$(grep -RIl --exclude='"'"'*.dpkg-*'"'"' --exclude='"'"'*.bak'"'"' -E "server_name[[:space:]].*\\b${DOMAIN}\\b" /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d 2>/dev/null || true)"
  [ -n "$files" ] || { say "   WARN: no vhost matched server_name $DOMAIN"; return 0; }

  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$f" ] || continue
    backup "$f"
    grep -qF "$INC" "$f" && { say "   ok: $f"; continue; }
    python3 - "$f" "$DOMAIN" "$INC" <<'"'"'PY'"'"'
import re,sys
p,dom,inc=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(p,'r',encoding='utf-8',errors='ignore').read()
def patch(block):
  if inc in block: return block, False
  if not re.search(r'\blisten\b[^;]*\b443\b', block): return block, False
  if not re.search(r'\bserver_name\b[^;]*\b'+re.escape(dom)+r'\b', block): return block, False
  lines=block.splitlines()
  ins=None
  for i,l in enumerate(lines):
    if re.search(r'\bserver_name\b', l):
      ins=i+1; break
  if ins is None: ins=1
  lines.insert(ins, "    include %s;"%inc)
  return "\n".join(lines), True
out=[]; changed=False; pos=0
for m in re.finditer(r'server\s*\{', s):
  start=m.start()
  out.append(s[pos:start])
  i=start; depth=0
  while i < len(s):
    c=s[i]
    if c=='{': depth+=1
    elif c=='}':
      depth-=1
      if depth==0:
        end=i+1
        b=s[start:end]
        nb,ch=patch(b)
        out.append(nb)
        changed=changed or ch
        pos=end
        break
    i+=1
new="".join(out)+s[pos:]
if changed: open(p,'w',encoding='utf-8').write(new)
PY
    grep -qF "$INC" "$f" && say "   patched: $f" || say "   WARN not patched: $f"
  done <<<"$files"
}

reload_test(){
  say "9) nginx -t + reload"
  nginx -t
  systemctl reload nginx

  say "10) local tests (must NOT be 404)"
  echo "--- $PATH_A ---"; curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_A" | head -n 12 || true
  echo "--- $PATH_B ---"; curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_B" | head -n 12 || true
  echo "--- include hit ---"; nginx -T 2>/dev/null | grep -n "aquila_stacking_routes" -n | head -n 20 || true
}

main(){
  say "BEGIN AQ @ $TS"
  ensure_dirs
  Z="$(get_zip)"
  import_and_build "$Z"
  deploy
  write_inc
  patch_vhosts
  reload_test
  say "DONE"
  say "BK: $BK"
  say "Open: https://$DOMAIN$PATH_A"
  say "Open: https://$DOMAIN$PATH_B"
}
main
BASH
chmod 755 /root/a.sh
bash /root/a.sh'
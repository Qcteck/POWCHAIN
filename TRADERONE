set -euo pipefail
echo "=== 1) Direct NGINX (bypass) via 127.0.0.1 + Host ==="
curl -I https://127.0.0.1/test/ --insecure -H "Host: fireinners.online" | sed -n '1,20p'

echo
echo "=== 2) Via Internet (passe par Cloudflare si actif) ==="
curl -I https://fireinners.online/test/ | sed -n '1,30p'

echo
echo "=== 3) Regarde si c'est Cloudflare (headers) ==="
curl -I https://fireinners.online/test/ | egrep -i 'HTTP/|server:|cf-|ray|location|cache-control|content-type' || true
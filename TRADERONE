# 1) PID qui écoute vraiment sur 8484
LPID=$(ss -lntp | sed -n 's/.*:8484 .*pid=\([0-9]\+\).*/\1/p' | head -n1)
echo "LISTEN_PID=$LPID"

# 2) Tue tous les signer.js (on repart clean)
pkill -f 'node .*qplus-secure/signer\.js' || true
sleep 1

# 3) Relance UNE SEULE fois (temporaire) pour vérifier
nohup node /root/qplus-secure/signer.js >/var/log/qplus-signer.log 2>&1 &
sleep 1

# 4) Check: doit montrer 1 seul signer.js + 127.0.0.1:8484
pgrep -af 'node .*qplus-secure/signer\.js' || true
ss -lntp | egrep ':(8484|3000)\b|:443\b'
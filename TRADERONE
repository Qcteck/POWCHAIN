# ROOT batch — lock nginx sur la VALEUR EXACTE (clé saisie en caché)
set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.lock_exact_$(date +%s)"

echo -n "Colle la clé (entrée cachée) puis Enter: "
read -rs KEY
echo
export KEY
[ -n "${KEY:-}" ] || { echo "KO: clé vide"; exit 1; }

python3 - <<'PY'
from pathlib import Path
import os, re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s  = ng.read_text()
KEY = os.environ["KEY"]

# remplace check "vide" OU check != "..." existant
s2 = re.sub(
  r'if\s*\(\s*\$http_x_api_key\s*=\s*""\s*\)\s*\{\s*return\s+403;\s*\}',
  f'if ($http_x_api_key != "{KEY}") {{ return 403; }}',
  s
)
s2 = re.sub(
  r'if\s*\(\s*\$http_x_api_key\s*!=\s*"[^"]*"\s*\)\s*\{\s*return\s+403;\s*\}',
  f'if ($http_x_api_key != "{KEY}") {{ return 403; }}',
  s2
)


5006997c-b718-4e26-b2f5-6c44d5e5b8ca.385fea30-3e51-4f73-95eb-3dc49a32bde1


if s2 == s:
  raise SystemExit("KO: aucun check X-API-KEY trouvé à remplacer dans nginx.")
ng.write_text(s2)
print("OK: nginx locked (key not printed)")
PY

nginx -t
systemctl reload nginx

echo "--- /health (200 sans clé) ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 6

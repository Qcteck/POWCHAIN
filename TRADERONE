cat >/root/nginx_disable_backups_and_fix_include.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DISABLED="/etc/nginx/disabled-sites"
mkdir -p "$DISABLED"

echo "[*] Moving backup/temporary vhost files out of /etc/nginx/sites-enabled ..."
shopt -s nullglob
for f in /etc/nginx/sites-enabled/*bak* /etc/nginx/sites-enabled/*.tmp /etc/nginx/sites-enabled/*~; do
  echo "  -> $f"
  mv -f "$f" "$DISABLED"/
done
shopt -u nullglob

echo "[*] Removing empty include lines (include ; / include) in remaining enabled vhosts..."
for f in /etc/nginx/sites-enabled/*; do
  [[ -f "$f" ]] || continue
  cp -a "$f" "$f.bak_fix_$(date +%Y%m%d_%H%M%S)"
  sed -i -E \
    -e '/^[[:space:]]*include[[:space:]]*;[[:space:]]*$/d' \
    -e '/^[[:space:]]*include[[:space:]]*$/d' \
    "$f"
done

echo "[*] nginx -t ..."
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "Check what is loaded now:"
ls -la /etc/nginx/sites-enabled
echo
echo "Backups moved to: $DISABLED"
BASH

chmod +x /root/nginx_disable_backups_and_fix_include.sh
/root/nginx_disable_backups_and_fix_include.sh
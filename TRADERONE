bash <<'NGINX_UNIFY'
set -euo pipefail

echo "=== NGINX :: FIREINNERS UNIFICATION ==="

SITES_AVAIL="/etc/nginx/sites-available"
SITES_ENABLED="/etc/nginx/sites-enabled"
OFFICIAL="fireinners.online-ssl"

# --- sanity ---
test -f "$SITES_AVAIL/$OFFICIAL" || {
  echo "ERROR: official vhost $OFFICIAL not found"
  exit 1
}

# --- disable all fireinners vhosts except official ---
echo "[1/4] Disabling duplicate fireinners vhosts..."
for f in "$SITES_ENABLED"/*; do
  name="$(basename "$f")"
  if [[ "$name" == *fireinners* ]] && [[ "$name" != "$OFFICIAL" ]]; then
    echo " - disabling $name"
    rm -f "$f"
  fi
done

# --- ensure official enabled ---
ln -sf "$SITES_AVAIL/$OFFICIAL" "$SITES_ENABLED/$OFFICIAL"

# --- ensure wolverine location exists ---
grep -q "location /wolverine/" "$SITES_AVAIL/$OFFICIAL" || sed -i "/server {/a \
\n  location /wolverine/ {\n\
    root /var/www;\n\
    index index.html;\n\
    try_files \$uri \$uri/ /wolverine/index.html;\n\
  }\n" "$SITES_AVAIL/$OFFICIAL"

# --- test & reload ---
echo "[2/4] Testing nginx..."
nginx -t

echo "[3/4] Reloading nginx..."
systemctl reload nginx

sleep 1

# --- final test ---
echo "[4/4] Live test..."
CODE=$(curl -s -o /dev/null -w "%{http_code}" https://fireinners.online/wolverine/)
if [ "$CODE" != "200" ]; then
  echo "❌ STILL FAILING (HTTP $CODE)"
  exit 1
fi

echo
echo "======================================"
echo "✅ NGINX CLEAN"
echo "✅ SINGLE SERVER BLOCK ACTIVE"
echo "✅ WOLVERINE LIVE"
echo "URL : https://fireinners.online/wolverine"
echo "======================================"
NGINX_UNIFY
async function loadPolicy(){const pol=await readJSON(POLICY_PATH,null);if(!pol)throw new Error("missing_policy");return pol;}
async function loadState(){const st=await readJSON(STATE_PATH,null);if(st)return st;const init={pending:{},usage:{},audit:[]};await writeJSONAtomic(STATE_PATH,init);return init;}
function auditPush(st,msg){st.audit.push({ts:now(),msg});if(st.audit.length>1000)st.audit=st.audit.slice(-1000);}
function withTimeout(ms,p){let to;const t=new Promise((_,rej)=>to=setTimeout(()=>rej(new Error("timeout")),ms));return Promise.race([p.finally(()=>clearTimeout(to)),t]);}
async function rpcCall(url,method,params){const body={jsonrpc:"2.0",id:1,method,params};const res=await withTimeout(8000,fetch(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body)}));if(!res.ok)throw new Error("rpc_http_"+res.status);const j=await res.json();if(j.error)throw new Error("rpc_"+(j.error.message||"error"));return j.result;}

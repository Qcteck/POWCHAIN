#!/usr/bin/env bash
set -euo pipefail

NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX NGINX CSP FOR WOLVERINE ==="

[ -f "$NGINX_SITE" ] || { echo "❌ vhost nginx introuvable"; exit 1; }

# Backup
cp -a "$NGINX_SITE" "${NGINX_SITE}.bak_${TS}"
echo "✔ Backup créé: ${NGINX_SITE}.bak_${TS}"

# Inject CSP OFF for /wolverine
sed -i '/location \/wolverine/{
n
a \
        add_header Content-Security-Policy "default-src * data: blob: '\''unsafe-inline'\'' '\''unsafe-eval'\'';" always;
}' "$NGINX_SITE"

echo "✔ CSP désactivée pour /wolverine"

# Test + reload
nginx -t
systemctl reload nginx

echo "✅ NGINX RELOAD OK"
echo "➡️ CTRL + F5 obligatoire"
#!/usr/bin/env bash
set -e

UI="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
BACKUP="$UI.bak.$(date +%s)"

echo "=== TRADERONE DASHBOARD PATCH (SOLDES + PROFIT) ==="

echo "[1/5] Backup UI"
cp "$UI" "$BACKUP"

echo "[2/5] Écriture nouvelle UI"
cat > "$UI" <<'EOF'
<!doctype html>
<html lang="fr">
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>TraderOne</title>
<style>
body{margin:0;background:#0b1020;color:#fff;font-family:system-ui}
#c{max-width:900px;margin:30px auto;padding:20px}
button,input{padding:10px 14px;border-radius:10px;border:0;margin:6px}
input{width:100%}
.stat{margin:6px 0}
.ok{color:#9ff}
.bad{color:#ff9f9f}
</style>

<div id="c">
<h1>TraderOne</h1>

<button id="con">Connect Phantom</button>
<div class="stat">Wallet: <span id="addr">-</span></div>

<hr/>

<div class="stat">Internal SOL: <b id="int">-</b></div>
<div class="stat">Phantom SOL: <b id="pha">-</b></div>
<div class="stat">Budget initial: <b id="bud">-</b></div>
<div class="stat">Profit total: <b id="pnl">-</b></div>

<hr/>

<input id="amt" placeholder="Budget SOL"/>
<button id="start">Start</button>
<button id="stop">Stop</button>
<button id="cash">Cash-out</button>

<pre id="log"></pre>
</div>

<script src="/wolverine/vendor/web3.min.js"></script>
<script>
const log=t=>logEl.textContent+=t+"\\n";
const logEl=document.querySelector("#log");
let pub=null,startBudget=0;

async function getBalances(){
  const r=await fetch("/wolverine/api/balances?user="+(pub||""));
  const j=await r.json();
  int.textContent=j.internalSOL?.toFixed(4)+" SOL";
  pha.textContent=j.phantomSOL?j.phantomSOL.toFixed(4)+" SOL":"-";
  bud.textContent=startBudget?startBudget+" SOL":"-";
  if(startBudget && j.phantomSOL){
    const p=((j.phantomSOL-startBudget)/startBudget)*100;
    pnl.textContent=p.toFixed(2)+" %";
    pnl.className=p>=0?"ok":"bad";
  }
}

con.onclick=async()=>{
  if(!window.solana)return alert("Install Phantom");
  const r=await solana.connect();
  pub=r.publicKey.toString();
  addr.textContent=pub;
  getBalances();
};

start.onclick=async()=>{
  const amt=+document.querySelector("#amt").value;
  if(!pub||!amt)return alert("Connect + budget");
  startBudget=amt;
  await fetch("/wolverine/api/start",{method:"POST",headers:{'content-type':'application/json'},body:JSON.stringify({amount:amt})});
  getBalances();
};

stop.onclick=async()=>{await fetch("/wolverine/api/stop",{method:"POST"});};
cash.onclick=async()=>{await fetch("/wolverine/api/cashout",{method:"POST"});};

setInterval(getBalances,5000);
</script>
</html>
EOF

echo "[3/5] Reload nginx"
nginx -t && systemctl reload nginx

echo "[4/5] Test API"
curl -s https://www.fireinners.online/wolverine/api/balances || true

echo "[5/5] DONE"
echo "URL: https://www.fireinners.online/wolverine"
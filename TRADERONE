
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>CryptoNews POD OF WHEELS — Live IA</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
body{margin:0;padding:10px;font-family:Arial;background:#0f172a;color:#e5e7eb}
h2{color:#38bdf8}
#log{height:260px;overflow:auto;border:1px solid #334155;padding:8px;background:#020617}
.articleBox{border:1px solid #334155;padding:10px;margin-top:10px;background:#1e293b}
table{width:100%;border-collapse:collapse;margin-top:8px}
th,td{border:1px solid #334155;padding:6px;text-align:left}
th{background:#020617}
#chartContainer{height:260px;margin-top:15px}
</style>
</head>

<body>
<h2>🎙 CryptoNews POD OF WHEELS — Émission Autonome</h2>

<div id="log"></div>

<div id="liveArticle" class="articleBox"></div>

<table>
<thead>
<tr><th>Critère</th><th>Valeur</th></tr>
</thead>
<tbody id="articleTable"></tbody>
</table>

<div id="chartContainer">
<canvas id="memoryChart"></canvas>
</div>

<script>
/* ================= VOIX UNIQUE ================= */
let SINGLE_VOICE=null;
speechSynthesis.onvoiceschanged=()=>{
  SINGLE_VOICE=speechSynthesis.getVoices().find(v=>v.lang==="fr-FR")||speechSynthesis.getVoices()[0];
};

/* ================= AGENTS ================= */
const AGENTS={
 PRESENTATEUR:{name:"Présentatrice",pitch:1.1,rate:1},
 ANALYSTE:{name:"Analyste",pitch:1.0,rate:1.05},
 STRATEGE:{name:"Stratège",pitch:0.95,rate:1.1},
 OBSERVATEUR:{name:"Observateur",pitch:1.05,rate:0.95}
};

const log=document.getElementById("log");

/* ================= SPEAK ================= */
async function speak(agent,text){
 const u=new SpeechSynthesisUtterance(text);
 u.lang="fr-FR";
 u.voice=SINGLE_VOICE;
 u.pitch=agent.pitch;
 u.rate=agent.rate;
 speechSynthesis.speak(u);
 log.innerHTML+=`<b>${agent.name} :</b> ${text}<br>`;
 log.scrollTop=log.scrollHeight;
 await new Promise(r=>u.onend=r);
}

/* ================= RSS + CACHE ================= */
const RSS_SOURCES=[
 "https://cryptoast.fr/feed",
 "https://cryptonaute.fr/feed",
 "https://fr.cointelegraph.com/rss-feeds/actualites.xml",
 "https://bitcoin.fr/feed",
 "https://journalducoin.com/feed/"
];

const LS_KEY="RSS_CACHE";
let cachedRSS=JSON.parse(localStorage.getItem(LS_KEY)||"[]");
let lastRead={};

async function loadRSS(force=false){
 if(cachedRSS.length&&!force) return cachedRSS;
 let all=[];
 for(const f of RSS_SOURCES){
  try{
   const r=await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(f)}`);
   const d=await r.json();
   if(d.items) all.push(...d.items);
  }catch{}
 }
 if(!all.length) all=[{title:"Marché calme",description:"Aucune donnée disponible."}];
 cachedRSS=all;
 localStorage.setItem(LS_KEY,JSON.stringify(all));
 return all;
}

function pickArticle(list){
 for(const a of list){
  if(!lastRead[a.title]){
   lastRead[a.title]=Date.now();
   return a;
  }
 }
 return list[Math.floor(Math.random()*list.length)];
}

/* ================= TABLE ARTICLE ================= */
function renderTable(){
 const rows=[
  ["Tendance",Math.random()>0.5?"Haussière":"Neutre"],
  ["Volatilité",["Faible","Moyenne","Élevée"][Math.floor(Math.random()*3)]],
  ["Impact estimé",Math.floor(Math.random()*100)+" %"],
  ["Confiance IA",Math.floor(Math.random()*30+65)+" %"]
 ];
 const tbody=document.getElementById("articleTable");
 tbody.innerHTML="";
 rows.forEach(r=>{
  const tr=document.createElement("tr");
  tr.innerHTML=`<td>${r[0]}</td><td>${r[1]}</td>`;
  tbody.appendChild(tr);
 });
}

/* ================= GRAPH ================= */
let mem=Array(10).fill(50);
const ctx=document.getElementById("memoryChart").getContext("2d");
const chart=new Chart(ctx,{
 type:"line",
 data:{labels:mem.map((_,i)=>i+1),
 datasets:[{label:"Mémoire IA",data:mem,borderColor:"#38bdf8",fill:false}]},
 options:{responsive:true,maintainAspectRatio:false}
});
setInterval(()=>{
 mem.push(Math.random()*100);mem.shift();
 chart.data.datasets[0].data=mem;
 chart.update();
},5000);

/* ================= ÉMISSION ================= */
const REACTIONS=[
 "Cela confirme une dynamique en place.",
 "On observe une continuité logique.",
 "Le contexte reste à surveiller.",
 "Positionnement cohérent à ce stade."
];

async function startShow(){
 const articles=await loadRSS();
 for(const a of articles){
  document.getElementById("liveArticle").textContent=a.title+"\n\n"+a.description;
  await speak(AGENTS.PRESENTATEUR,a.title+". "+a.description);
  await speak(AGENTS.ANALYSTE,REACTIONS[Math.floor(Math.random()*REACTIONS.length)]);
  await speak(AGENTS.STRATEGE,REACTIONS[Math.floor(Math.random()*REACTIONS.length)]);
  if(Math.random()<0.4) await speak(AGENTS.OBSERVATEUR,REACTIONS[Math.floor(Math.random()*REACTIONS.length)]);
  renderTable();
  await new Promise(r=>setTimeout(r,4000));
 }
 await speak(AGENTS.PRESENTATEUR,"Fin du journal. Sources utilisées issues de la presse crypto francophone.");
}

/* ================= LOOP 24/7 ================= */
async function loop(){
 while(true){
  await startShow();
  await new Promise(r=>setTimeout(r,4*60*1000));
 }
}
window.onload=loop;
</script>

</body>
</html>

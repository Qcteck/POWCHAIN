set -e
cd /root

URL_PATH="/wolverine/traderone/api/status"

# récupère la clé effective depuis le vhost SSL (sans l'afficher)
KEY=$(grep -oP 'http_x_api_key != "\K[^"]+' /etc/nginx/sites-enabled/fireinners.online-ssl | head -n1)

echo "=== Test AVEC clé (attendu 200) sur fireinners.online ==="
curl -sS -i -X POST "https://fireinners.online$URL_PATH" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KEY" \
  --data '{}' | head -n 20

echo
echo "=== Test AVEC clé (attendu 200) sur www.fireinners.online ==="
curl -sS -i -X POST "https://www.fireinners.online$URL_PATH" \
  -H "content-type: application/json" \
  -H "X-API-KEY: $KEY" \
  --data '{}' | head -n 20

echo
echo "=== Test SANS clé (attendu 403) ==="
curl -sS -i -X POST "https://fireinners.online$URL_PATH" \
  -H "content-type: application/json" \
  --data '{}' | head -n 12
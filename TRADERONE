cat > /root/WOLVERINE_FIX_RPC_AND_ROOT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/WOLVERINE_FIX_RPC_ROOT_${TS}.log"
HTML="/var/www/wolverine/index.html"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

RPC_CANON="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"

echo "=== WOLVERINE FIX RPC + ROOT (AVANT JS) ===" | tee "$LOG"

### 1) VÉRIFICATION FICHIER SERVI
echo "[1/6] Vérification fichier HTML servi" | tee -a "$LOG"
test -f "$HTML" || { echo "ERREUR: $HTML absent"; exit 1; }
cp -a "$HTML" "${HTML}.bak_${TS}"

### 2) FORÇAGE RPC SOLANA DANS LE HTML (UNIQUE)
echo "[2/6] Forçage RPC Solana canonique" | tee -a "$LOG"
sed -i \
  -E "s#https://[^\"']*solana[^\"']*#${RPC_CANON}#g" \
  "$HTML"

grep -n "$RPC_CANON" "$HTML" | tee -a "$LOG" || {
  echo "ERREUR RPC non injecté"; exit 1;
}

### 3) FORÇAGE ROOT NGINX (AUCUNE AMBIGUÏTÉ)
echo "[3/6] Forçage root nginx" | tee -a "$LOG"
cp -a "$VHOST" "${VHOST}.bak_${TS}"

sed -i \
  -E 's#root[[:space:]]+[^;]+;#root /var/www/wolverine;#g' \
  "$VHOST"

grep -n "root /var/www/wolverine;" "$VHOST" | tee -a "$LOG" || {
  echo "ERREUR root nginx non forcé"; exit 1;
}

### 4) SUPPRESSION CACHE NGINX
echo "[4/6] Purge cache nginx" | tee -a "$LOG"
rm -rf /var/cache/nginx/* || true

### 5) TEST + RELOAD NGINX
echo "[5/6] Test + reload nginx" | tee -a "$LOG"
nginx -t
systemctl reload nginx

### 6) TEST HTTP LOCAL
echo "[6/6] Test HTTP local (doit répondre)" | tee -a "$LOG"
curl -I http://127.0.0.1 | tee -a "$LOG" || true

echo "=== FIX TERMINÉ ===" | tee -a "$LOG"
echo "ACTION: CTRL + SHIFT + R sur /wolverine" | tee -a "$LOG"
echo "Backup HTML : ${HTML}.bak_${TS}" | tee -a "$LOG"
echo "Backup VHOST: ${VHOST}.bak_${TS}" | tee -a "$LOG"
echo "LOG: $LOG" | tee -a "$LOG"
BASH

chmod +x /root/WOLVERINE_FIX_RPC_AND_ROOT.sh
/root/WOLVERINE_FIX_RPC_AND_ROOT.sh
cat >/tmp/WOLVERINE_8585_NOT_LISTENING_DIAG.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SVC="traderone.service"
TARGET="/opt/traderone-opt/server.js"

echo "== 1) Status + 50 logs systemd =="
systemctl status "$SVC" --no-pager -l | sed -n '1,60p' || true
echo
journalctl -u "$SVC" -n 50 --no-pager || true
echo

echo "== 2) Qui écoute sur 8585 / 9696 ? (ss) =="
ss -lntp | egrep ':(8585|9696)\s' || true
echo

echo "== 3) Le node du service écoute où ? (lsof sur PID principal) =="
PID="$(systemctl show -p MainPID --value "$SVC" 2>/dev/null || true)"
echo "MainPID=$PID"
if [ -n "${PID:-}" ] && [ "$PID" != "0" ]; then
  lsof -p "$PID" -a -iTCP -sTCP:LISTEN -nP || true
fi
echo

echo "== 4) Vérifie dans server.js quel port est utilisé =="
echo "--- grep listen/PORT in $TARGET"
grep -nE 'listen\(|process\.env\.PORT|PORT[[:space:]]*=' "$TARGET" || true
echo

echo "== 5) Test direct sur 9696 (au cas où c est ça maintenant) =="
curl -sS -D- "http://127.0.0.1:9696/api/health" | head -c 200 || true
echo
SH

bash /tmp/WOLVERINE_8585_NOT_LISTENING_DIAG.sh
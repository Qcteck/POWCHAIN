set -e
cd /root

KEY="CHANGE-MOI-EN-UNE-GROSSE-CLE-64CHARS"

mkdir -p /root/nginx_backups
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  cp -v "$f" "/root/nginx_backups/$(basename "$f").$(date +%Y%m%d_%H%M%S)"

  # 1) supprime la ligne invalide "if ( = 0) { ... }"
  sed -i -E '/^[[:space:]]*if[[:space:]]*\([[:space:]]*=[[:space:]]*0[[:space:]]*\)[[:space:]]*\{[[:space:]]*return[[:space:]]+403;[[:space:]]*\}[[:space:]]*$/d' "$f"

  # 2) supprime toutes les lignes if ($http_x_api_key != ...) (on les remet propres après)
  sed -i -E '/^[[:space:]]*if[[:space:]]*\(\$http_x_api_key[[:space:]]*!=[[:space:]]*".*"\)[[:space:]]*\{[[:space:]]*return[[:space:]]+403;[[:space:]]*\}[[:space:]]*$/d' "$f"

  # 3) ré-injecte UN SEUL check juste après l’ouverture du location traderone
  perl -0777 -i -pe 's#(location\s+\^~\s+/wolverine/traderone/api/\s*\{\n)#$1  if (\$http_x_api_key != "'"$KEY"'") { return 403; }\n#s' "$f"
done

nginx -t
systemctl reload nginx
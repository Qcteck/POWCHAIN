app.post("/wolverine/api/claim",async(req,res)=>{
  try{
    const owner=String(res.body?.owner||req.body?.owner||"").trim();
    const sig=String(req.body?.sig||"").trim();
    if(!owner||!sig) return res.status(400).json({ok:false,error:"missing_owner_or_sig"});
    const u=getUser(owner);
    if(u.lastClaimSig===sig) return res.json({ok:true,dup:true,user:u});
    const {solToBot,usdcToBot}=await parseClaimTx(sig,owner);
    if(usdcToBot>0n) u.credit_usdc=(BigInt(u.credit_usdc||0)+usdcToBot).toString();
    if(solToBot>0n) u.credit_sol=(BigInt(u.credit_sol||0)+solToBot).toString();
    u.lastClaimSig=sig;
    saveState();
    tg(`WOLVERINE: DEPOSIT OK owner ${owner.slice(0,6)}… usdc ${baseUnitsToUi(usdcToBot,6)} sol ${Number(solToBot)/LAMPORTS_PER_SOL}`);
    res.json({ok:true,credited:{usdc:usdcToBot.toString(),sol:solToBot.toString()},user:u});
  }catch(e){res.status(500).json({ok:false,error:String(e&&e.message||e)})}
});

app.post("/wolverine/api/start",async(req,res)=>{
  try{
    const owner=String(req.body?.owner||"").trim();
    const mode=String(req.body?.mode||"dca_sol_safe").trim();
    const intervalSec=Math.max(10,+(req.body?.intervalSec||30));
    const tokenMint=String(req.body?.tokenMint||"").trim();
    if(!owner) return res.status(400).json({ok:false,error:"missing_owner"});
    const u=getUser(owner);
    if(BigInt(u.credit_usdc||0)===0n && BigInt(u.credit_sol||0)===0n) return res.status(400).json({ok:false,error:"no_credit"});
    // stop previous
    for(const [k,t] of loops){clearTimeout(t);loops.delete(k)}
    state.engine={running:true,mode,intervalSec,owner:b58(owner),tokenMint,lastTick:0,lastTx:"",startedAt:Date.now()};
    saveState();
    tg(`WOLVERINE: START owner ${owner.slice(0,6)}… mode ${mode} interval ${intervalSec}s`);
    tick(owner).catch(()=>{});
    res.json({ok:true,engine:state.engine});
  }catch(e){res.status(500).json({ok:false,error:String(e&&e.message||e)})}
});

app.post("/wolverine/api/stop",(req,res)=>{
  try{
    for(const [k,t] of loops){clearTimeout(t);loops.delete(k)}
    state.engine.running=false;
    saveState();
    tg(`WOLVERINE: STOP`);
    res.json({ok:true,engine:state.engine});
  }catch(e){res.status(500).json({ok:false,error:String(e&&e.message||e)})}
});

app.post("/wolverine/api/withdraw",async(req,res)=>{
  try{
    const owner=String(req.body?.owner||"").trim();
    const token=String(req.body?.token||"USDC").trim().toUpperCase();
    const amount=String(req.body?.amount||"0").trim(); // UI amount
    if(!owner) return res.status(400).json({ok:false,error:"missing_owner"});
    const u=getUser(owner);
    const toPk=new PublicKey(owner);
    if(token==="SOL"){
      const lamports=uiToBaseUnits(amount,9);
      if(lamports<=0n) return res.status(400).json({ok:false,error:"bad_amount"});
      const credit=BigInt(u.credit_sol||0);
      if(credit<lamports) return res.status(400).json({ok:false,error:"insufficient_credit"});
      const sig=await sendSol(toPk,lamports);
      u.credit_sol=(credit-lamports).toString();
      saveState();
      tg(`WOLVERINE: WITHDRAW SOL ${Number(lamports)/LAMPORTS_PER_SOL} to ${owner.slice(0,6)}… tx ${sig}`);
      return res.json({ok:true,sig});
    }else{
      const amt=uiToBaseUnits(amount,6);
      if(amt<=0n) return res.status(400).json({ok:false,error:"bad_amount"});
      const credit=BigInt(u.credit_usdc||0);
      if(credit<amt) return res.status(400).json({ok:false,error:"insufficient_credit"});
      const sig=await sendUsdc(toPk,amt);
      u.credit_usdc=(credit-amt).toString();
      saveState();
      tg(`WOLVERINE: WITHDRAW USDC ${baseUnitsToUi(amt,6)} to ${owner.slice(0,6)}… tx ${sig}`);
      return res.json({ok:true,sig});
    }
  }catch(e){res.status(500).json({ok:false,error:String(e&&e.message||e)})}
});


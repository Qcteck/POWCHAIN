# ROOT — Visual compare for all /wolverine/_index_versions/v*.html
set -euo pipefail

UI="/var/www/wolverine"
DIR="$UI/_index_versions"

[ -d "$DIR" ] || { echo "❌ missing: $DIR"; exit 1; }

# build list.js from v*.html
ls -1 "$DIR"/v*.html 2>/dev/null | xargs -n1 basename > /tmp/_vps_versions.txt
COUNT="$(wc -l < /tmp/_vps_versions.txt | tr -d ' ')"
[ "$COUNT" -gt 0 ] || { echo "❌ no v*.html found in $DIR"; exit 2; }

# 1) Side-by-side compare (3 iframes)
cat > "$DIR/compare.html" <<'HTML'
<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Wolverine – Visual Compare</title>
<style>
  body{margin:0;font-family:system-ui;background:#0b0b0b;color:#fff}
  .top{position:sticky;top:0;z-index:9;background:#111;padding:10px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  select,button,input{padding:6px 10px}
  a{color:#9cf}
  .grid{display:grid;grid-template-columns:repeat(3,minmax(320px,1fr));gap:10px;padding:10px}
  .card{background:#151515;border:1px solid #2a2a2a;border-radius:10px;overflow:hidden}
  .meta{padding:8px;font-size:12px;opacity:.9;display:flex;justify-content:space-between;gap:10px}
  iframe{width:100%;height:72vh;border:0;background:#fff}
  @media (max-width: 1100px){ .grid{grid-template-columns:1fr} iframe{height:55vh} }
</style>

<div class="top">
  <b>Visual Compare</b>
  <span id="count" style="opacity:.8;font-size:12px"></span>
  <div style="flex:1"></div>

  <span style="opacity:.8;font-size:12px">Rotate(s)</span>
  <input id="delay" type="number" value="10" min="1" style="width:70px">
  <button id="rot">Start rotate</button>

  <a href="./viewer.html">Slideshow</a>
  <a href="./grid.html">Grid</a>
</div>

<div class="grid">
  <div class="card">
    <div class="meta"><span>A</span><select id="a"></select></div>
    <iframe id="fa"></iframe>
    <div class="meta"><span id="la"></span><a id="oa" target="_blank">Open</a></div>
  </div>
  <div class="card">
    <div class="meta"><span>B</span><select id="b"></select></div>
    <iframe id="fb"></iframe>
    <div class="meta"><span id="lb"></span><a id="ob" target="_blank">Open</a></div>
  </div>
  <div class="card">
    <div class="meta"><span>C</span><select id="c"></select></div>
    <iframe id="fc"></iframe>
    <div class="meta"><span id="lc"></span><a id="oc" target="_blank">Open</a></div>
  </div>
</div>

<script>
let list=[], t=null, rotating=false, idx=0;

function fill(sel){
  sel.innerHTML = list.map(v=>`<option value="${v}">${v}</option>`).join("");
}

function setFrame(which, v){
  document.getElementById("f"+which).src = v;
  document.getElementById("l"+which).textContent = v;
  const o=document.getElementById("o"+which);
  o.href=v; o.textContent="Open";
}

function bind(sel, which){
  sel.onchange=()=>setFrame(which, sel.value);
}

function startRotate(){
  stopRotate();
  const ms = Math.max(1, Number(delay.value||10))*1000;
  t=setInterval(()=>{
    idx = (idx+1) % list.length;
    a.value = list[idx];
    b.value = list[(idx+1)%list.length];
    c.value = list[(idx+2)%list.length];
    setFrame("a", a.value);
    setFrame("b", b.value);
    setFrame("c", c.value);
  }, ms);
}
function stopRotate(){ if(t) clearInterval(t); t=null; }

rot.onclick=()=>{
  rotating=!rotating;
  rot.textContent = rotating ? "Stop rotate" : "Start rotate";
  if(rotating) startRotate(); else stopRotate();
};

fetch("./list.json").then(r=>r.json()).then(j=>{
  list = j.map(x=>x.file).filter(f=>/^v\d+\.html$/.test(f));
  count.textContent = list.length+" versions";
  fill(a); fill(b); fill(c);
  // default: first 3
  a.value=list[0]; b.value=list[1]||list[0]; c.value=list[2]||list[0];
  bind(a,"a"); bind(b,"b"); bind(c,"c");
  setFrame("a", a.value); setFrame("b", b.value); setFrame("c", c.value);
});
</script>
HTML

# 2) Make sure list.json exists (create if missing)
if [ ! -f "$DIR/list.json" ]; then
  python3 - <<'PY' "$DIR"
import os, json, time
d=os.sys.argv[1]
files=sorted([f for f in os.listdir(d) if f.startswith("v") and f.endswith(".html")])
items=[]
for f in files:
  p=os.path.join(d,f)
  st=os.stat(p)
  items.append({"file":f,"mtime_iso":time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(st.st_mtime)),"size":st.st_size})
open(os.path.join(d,"list.json"),"w").write(json.dumps(items,indent=2))
print("list.json created:", len(items))
PY
fi

chown -R www-data:www-data "$DIR" 2>/dev/null || true
chmod -R a+rX "$DIR" || true

nginx -t && systemctl reload nginx

echo "✅ OPEN:"
echo "https://fireinners.online/wolverine/_index_versions/compare.html"
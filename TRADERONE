cat >/tmp/WOLVERINE_TG_ROTATE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
[ -f "$ENV" ] || { echo "Missing $ENV"; exit 1; }

read -r -s -p "NOUVEAU TG_TOKEN = " NEW
echo
[ -n "${NEW:-}" ] || { echo "token vide"; exit 1; }

# Load existing chat id
# shellcheck disable=SC1090
source "$ENV"
CID="${TG_CHAT_ID:-}"
[ -n "${CID:-}" ] || { echo "TG_CHAT_ID missing in $ENV"; exit 1; }

umask 077
cat >"$ENV" <<EOF
TG_TOKEN=${NEW}
TG_CHAT_ID=${CID}
EOF
chmod 600 "$ENV"

systemctl restart wolverine-tg-sentinel
sleep 0.4

# Send test
/usr/local/bin/wolv_send "WOLVERINE: token rotated OK"
echo "OK."
SH
bash /tmp/WOLVERINE_TG_ROTATE.sh
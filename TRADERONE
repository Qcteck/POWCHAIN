set -euo pipefail
DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-enabled/fireinners"
SNIP="/etc/nginx/snippets/wolv_rpc_proxy.conf"
TS="$(date +%s)"

echo "== 1) Show nginx error (file:line) =="
nginx -t 2>&1 | tail -n 30 || true

echo "== 2) Restore last backup of vhost (if exists) =="
LAST_BAK="$(ls -1t ${VHOST}.bak.* 2>/dev/null | head -n 1 || true)"
if [ -n "${LAST_BAK:-}" ]; then
  cp -a "$VHOST" "$VHOST.bad.$TS"
  cp -a "$LAST_BAK" "$VHOST"
  echo "Restored: $LAST_BAK -> $VHOST (saved broken as $VHOST.bad.$TS)"
else
  echo "No backup found for $VHOST (continuing without restore)"
fi

echo "== 3) Write CLEAN nginx snippet (note the \\$ escapes) =="
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'EOF'
# Wolverine: Solana RPC proxy (same-origin)
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  add_header X-Wolv-RPC "1" always;

  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
}
EOF

echo "== 4) Ensure snippet is INCLUDED inside server{} of $VHOST =="
if ! grep -qF "include $SNIP;" "$VHOST"; then
  cp -a "$VHOST" "$VHOST.bak.$TS"

  # inject include before first server{} closing brace
  perl -0777 -i -pe 's/(server\s*\{[\s\S]*?)(\n\})/$1\n\n  include \/etc\/nginx\/snippets\/wolv_rpc_proxy\.conf;\n$2/s' "$VHOST"
  echo "Injected include into $VHOST"
else
  echo "OK: include already present"
fi

echo "== 5) nginx test + reload =="
nginx -t
systemctl reload nginx

echo "== 6) TEST (must NOT be 404, must contain X-Wolv-RPC: 1) =="
curl -ksS -i "https://$DOMAIN/wolverine/traderone/api/rpc" \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 40
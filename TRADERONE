set -e

# 1) Backup du vhost
cp -v /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online.bak.$(date +%Y%m%d_%H%M%S)

# 2) Remplace le proxy_pass (IMPORTANT: on enlève le path et on met le bon port)
sed -i 's#proxy_pass http://127.0.0.1:3000/wolverine/traderone/api/#proxy_pass http://127.0.0.1:12703#' /etc/nginx/sites-enabled/fireinners.online
sed -i 's#proxy_pass http://127.0.0.1:3000;#proxy_pass http://127.0.0.1:12703;#' /etc/nginx/sites-enabled/fireinners.online

# 3) Vérifie la config + reload
nginx -t
systemctl reload nginx

# 4) Test via domaine (OPTIONS passe souvent même quand POST demande un body)
curl -i -X OPTIONS https://fireinners.online/wolverine/traderone/api/ | head -n 20
<!doctype html><html lang="fr"><head><meta charset="utf-8"><title>AQUILA • Frontend Only • Real Sign</title><meta name="viewport" content="width=device-width,initial-scale=1"><style>html,body{margin:0;padding:0;background:#05070b;color:#e6ebff;font-family:system-ui}#app{display:grid;grid-template-columns:300px 1fr;height:100vh}aside{background:#0a0f1c;border-right:1px solid #1b2450;padding:14px;overflow:auto}main{padding:14px;overflow:auto}h1,h2,h3{margin:.4em 0}button,input,select{background:#0e1633;color:#e6ebff;border:1px solid #2b3cff;padding:6px;border-radius:4px}button{cursor:pointer}.ok{border-color:#3cff9e;color:#b7ffe1}.warn{border-color:#ff4d4d;color:#ffb3b3}.card{border:1px solid #1b2450;border-radius:6px;padding:10px;margin-bottom:10px;background:#070c18}.log{font-family:ui-monospace,monospace;font-size:12px;white-space:pre-wrap}.small{font-size:12px;opacity:.85}.sep{height:1px;background:#1b2450;margin:8px 0}.row{display:flex;gap:8px;flex-wrap:wrap}.pill{display:inline-block;padding:2px 8px;border:1px solid #1b2450;border-radius:999px;font-size:12px;opacity:.9}</style></head><body><div id="app"><aside><h2>AQUILA</h2><div class="small">Frontend only • Signature réelle Phantom • RPC fallback</div><div class="sep"></div><div class="card"><h3>Wallet</h3><div id="wallet" class="small">Déconnecté</div><div class="row"><button id="connect" class="ok">Connect Phantom</button><button id="disconnect" class="warn">Disconnect</button></div></div><div class="card"><h3>Réseau</h3><div class="small">RPC primaire:</div><input id="rpc1" placeholder="RPC primaire"><div class="small" style="margin-top:6px">RPC backup:</div><input id="rpc2" placeholder="RPC backup"><div class="row" style="margin-top:8px"><button id="rpcTest">Test RPC</button><span id="rpcStatus" class="pill">—</span></div></div><div class="card"><h3>État</h3><div>ARM: <b id="arm"></b></div><div>Cycle: <b id="cycle"></b></div><div>Mode exécution: <b id="modeLabel"></b></div><div class="row" style="margin-top:8px"><button id="armBtn" class="ok">ARM</button><button id="disarmBtn" class="warn">DISARM</button></div><div class="sep"></div><div class="row"><select id="mode"><option value="DIRECT">DIRECT (Phantom → RPC)</option><option value="SERVER">SERVER (/iaaquila/exec)</option></select></div><div class="small" style="margin-top:6px">Kill-switch: <b id="kill"></b></div><div class="row" style="margin-top:6px"><button id="killOn" class="warn">KILL ON</button><button id="killOff" class="ok">KILL OFF</button></div></div><div class="card"><h3>Objectifs</h3><div id="goals" class="small"></div><div class="row" style="margin-top:8px"><input id="goalInput" placeholder="Nouvel objectif" style="flex:1"><button id="addGoal">Ajouter</button></div></div><div class="card"><h3>Règles</h3><div class="small">• ARM requis<br>• Validation humaine<br>• 1 action par cycle<br>• Signature utilisateur<br>• Confirm <b>finalized</b> + timeouts/backoff</div></div></aside><main><h2>Console AQUILA</h2><div class="card"><h3>Observation</h3><div id="obs" class="log"></div></div><div class="card"><h3>Proposition on-chain</h3><div id="prop" class="log"></div><div class="row" style="margin-top:8px"><button id="approve" class="ok">APPROUVER & EXÉCUTER</button><button id="reject" class="warn">REJETER</button></div><div class="small" style="margin-top:8px">Astuce: si tu veux des échanges (swap), branche le mode SERVER sur un module /exec/swap (allowlist+quota+pendingId).</div></div><div class="card"><h3>Audit</h3><div id="audit" class="log"></div></div></main></div><script src="/iaaquila/vendor/solana-web3.min.js"></script><script>(function(){const S=window.solanaWeb3;if(!S){document.body.innerHTML='<div style="padding:18px;font-family:system-ui;color:#fff;background:#05070b">ERREUR: solana-web3.min.js introuvable. Place-le dans <code>/var/www/iaaquila/vendor/</code> et sers-le via Nginx.</div>';return;}const KEY="AQUILA_REAL_V2";const now=()=>Date.now();const load=()=>{try{return JSON.parse(localStorage.getItem(KEY)||"null")}catch(e){return null}};const save=d=>localStorage.setItem(KEY,JSON.stringify(d));let DB=load()||{arm:false,kill:false,cycle:0,mode:"DIRECT",rpc1:"https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",rpc2:"https://api.mainnet-beta.solana.com",goals:["Protection trésorerie"],obs:[],audit:[],pending:null};save(DB);const $=id=>document.getElementById(id);const ui={wallet:$("wallet"),arm:$("arm"),cycle:$("cycle"),goals:$("goals"),obs:$("obs"),prop:$("prop"),audit:$("audit"),rpc1:$("rpc1"),rpc2:$("rpc2"),rpcStatus:$("rpcStatus"),mode:$("mode"),modeLabel:$("modeLabel"),kill:$("kill")};const logObs=t=>{DB.obs.push(`[${new Date().toLocaleTimeString()}][OBS] ${t}`);if(DB.obs.length>200)DB.obs.splice(0,DB.obs.length-200);save(DB)};const logAudit=t=>{DB.audit.push(`[${new Date().toLocaleTimeString()}][AUDIT] ${t}`);if(DB.audit.length>400)DB.audit.splice(0,DB.audit.length-400);save(DB);render()};const sha256=async(str)=>{const enc=new TextEncoder().encode(str);const buf=await crypto.subtle.digest("SHA-256",enc);return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,"0")).join("")};function render(){ui.arm.textContent=DB.arm?"ON":"OFF";ui.kill.textContent=DB.kill?"ON":"OFF";ui.cycle.textContent=String(DB.cycle);ui.goals.innerHTML=DB.goals.map(g=>"• "+g).join("<br>");ui.obs.textContent=DB.obs.slice(-10).join("\n");ui.audit.textContent=DB.audit.slice(-20).join("\n");ui.rpc1.value=DB.rpc1;ui.rpc2.value=DB.rpc2;ui.mode.value=DB.mode;ui.modeLabel.textContent=DB.mode;ui.prop.textContent=DB.pending?JSON.stringify(DB.pending,null,2):"(aucune proposition)";}render();let provider=null,pubkey=null;async function connect(){if(!window.solana){alert("Phantom requis");return;}provider=window.solana;const r=await provider.connect();pubkey=r.publicKey.toString();ui.wallet.textContent=pubkey;logAudit("Wallet connecté");}async function disconnect(){try{if(provider&&provider.isConnected)await provider.disconnect()}catch(e){}provider=null;pubkey=null;ui.wallet.textContent="Déconnecté";logAudit("Wallet déconnecté");}async function pickConnection(){const test=async(url)=>{try{const c=new S.Connection(url,"confirmed");await c.getLatestBlockhash("confirmed");return c}catch(e){return null}};let c=await test(DB.rpc1);if(c){ui.rpcStatus.textContent="RPC1 OK";return c}c=await test(DB.rpc2);if(c){ui.rpcStatus.textContent="RPC2 OK";return c}ui.rpcStatus.textContent="RPC DOWN";throw new Error("No RPC available")}async function rpcTest(){DB.rpc1=ui.rpc1.value.trim()||DB.rpc1;DB.rpc2=ui.rpc2.value.trim()||DB.rpc2;save(DB);try{await pickConnection();logAudit("RPC test OK")}catch(e){logAudit("RPC test FAIL: "+(e&&e.message?e.message:e))}render()}$("connect").onclick=connect;$("disconnect").onclick=disconnect;$("rpcTest").onclick=rpcTest;$("armBtn").onclick=()=>{DB.arm=true;save(DB);logAudit("ARM activé")};$("disarmBtn").onclick=()=>{DB.arm=false;save(DB);logAudit("DISARM")};$("killOn").onclick=()=>{DB.kill=true;save(DB);logAudit("KILL SWITCH ON")};$("killOff").onclick=()=>{DB.kill=false;save(DB);logAudit("KILL SWITCH OFF")};$("addGoal").onclick=()=>{const v=$("goalInput").value.trim();if(v){DB.goals.push(v);$("goalInput").value="";save(DB);logAudit("Objectif ajouté: "+v)}};ui.mode.onchange=()=>{DB.mode=ui.mode.value;save(DB);logAudit("Mode="+DB.mode)};const DESTINATION_DEFAULT="11111111111111111111111111111111";const LAMPORTS_DEFAULT=1000;const ONE_PER_CYCLE=true;const LOOP_MS=6000;async function propose(){if(!DB.arm||DB.kill)return;DB.cycle++;const dest=DESTINATION_DEFAULT;const lamports=LAMPORTS_DEFAULT;const payload={kind:"TRANSFER",dest,lamports,mode:DB.mode,cycle:DB.cycle,createdAt:now(),rule:{armRequired:true,humanApproval:true,onePerCycle:true}};const hash=await sha256(JSON.stringify(payload));DB.pending={id:hash.slice(0,16),hash,payload,status:"PROPOSED"};save(DB);logObs(`Proposition créée (cycle=${DB.cycle}) → TRANSFER ${lamports} lamports → ${dest}`);render()}async function confirmFinalized(conn,sig,timeoutMs){const start=now();let delay=800;while(now()-start<timeoutMs){try{const st=await conn.getSignatureStatuses([sig],{searchTransactionHistory:true});const v=st&&st.value&&st.value[0];if(v){if(v.err){return{state:"FAILED",detail:JSON.stringify(v.err)}}const cs=v.confirmationStatus||"";if(cs==="finalized")return{state:"FINALIZED"};if(cs==="confirmed")return{state:"CONFIRMED"}}}catch(e){}await new Promise(r=>setTimeout(r,delay));delay=Math.min(Math.floor(delay*1.35),5000)}return{state:"TIMEOUT"}}async function execDirect(){if(!DB.pending)throw new Error("No pending");if(!DB.arm)throw new Error("ARM required");if(DB.kill)throw new Error("KILL SWITCH ON");if(!provider||!pubkey)throw new Error("Wallet required");const conn=await pickConnection();const {payload}=DB.pending;const from=new S.PublicKey(pubkey);const to=new S.PublicKey(payload.dest);const tx=new S.Transaction().add(S.SystemProgram.transfer({fromPubkey:from,toPubkey:to,lamports:payload.lamports}));tx.feePayer=from;const bh=await conn.getLatestBlockhash("confirmed");tx.recentBlockhash=bh.blockhash;DB.pending.status="SIGNING";save(DB);render();const signed=await provider.signTransaction(tx);DB.pending.status="SENDING";save(DB);render();const sig=await conn.sendRawTransaction(signed.serialize(),{skipPreflight:false,maxRetries:3});DB.pending.status="SENT";DB.pending.sig=sig;save(DB);render();logAudit("TX sent: "+sig);const res=await confirmFinalized(conn,sig,30000);DB.pending.status=res.state;save(DB);render();logAudit("TX status: "+res.state+(res.detail?(" "+res.detail):""));if(res.state==="FINALIZED"||res.state==="CONFIRMED"){DB.pending=null;save(DB);render()}}async function execServer(){if(!DB.pending)throw new Error("No pending");if(!DB.arm)throw new Error("ARM required");if(DB.kill)throw new Error("KILL SWITCH ON");if(!provider||!pubkey)throw new Error("Wallet required");const base="/iaaquila";const p=DB.pending;DB.pending.status="SERVER_PREP";save(DB);render();const r1=await fetch(base+"/exec/prepare",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({pendingId:p.id,hash:p.hash,payload:p.payload,from:pubkey})});if(!r1.ok)throw new Error("SERVER prepare failed");const j1=await r1.json();if(!j1||!j1.txBase64)throw new Error("SERVER no txBase64");const raw=Uint8Array.from(atob(j1.txBase64),c=>c.charCodeAt(0));let tx=S.Transaction.from(raw);DB.pending.status="SERVER_SIGNING";save(DB);render();const signed=await provider.signTransaction(tx);DB.pending.status="SERVER_SENDING";save(DB);render();const sig=await fetch(base+"/exec/commit",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({pendingId:p.id,hash:p.hash,signedTxBase64:btoa(String.fromCharCode.apply(null,signed.serialize())),from:pubkey})}).then(r=>r.json());DB.pending.status="SERVER_DONE";DB.pending.sig=(sig&&sig.sig)||"(no sig)";save(DB);render();logAudit("SERVER commit: "+DB.pending.sig)}$("approve").onclick=async()=>{try{if(!DB.pending)return alert("Aucune proposition");if(ONE_PER_CYCLE&&DB.pending._doneCycle===DB.cycle)return alert("Déjà exécuté ce cycle");DB.pending.status="APPROVED";save(DB);render();logAudit("Proposition approuvée");if(DB.mode==="DIRECT")await execDirect();else await execServer();}catch(e){logAudit("EXEC ERROR: "+(e&&e.message?e.message:e));}};$("reject").onclick=()=>{if(DB.pending){logAudit("Proposition rejetée");DB.pending=null;save(DB);render();}};setInterval(()=>{propose().catch(()=>{})},LOOP_MS);})();</script></body></html>
cat >/root/WV_FIX_VAULT_301.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/WV_BK_VAULT301_${TS}"
mkdir -p "$BK"
say(){ printf "\n[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
backup(){ local f="$1"; [ -e "$f" ] || return 0; mkdir -p "$BK$(dirname "$f")"; cp -a "$f" "$BK$f"; }
unfreeze(){ local f="$1"; [ -e "$f" ] || return 0; chattr -i "$f" 2>/dev/null || true; }

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SEN="/etc/nginx/sites-enabled/fireinners.online-ssl"
INC="/etc/nginx/includes/wv_vault_api.inc"
VAULT_PORT="8787"
HOST="fireinners.online"

say "0) Savepoint (si dispo)"
[ -x /root/WOLVERINE_SAVEPOINT.sh ] && /root/WOLVERINE_SAVEPOINT.sh || true

say "1) Backup + unfreeze"
for f in "$VHOST" "$SEN" "$INC"; do backup "$f"; unfreeze "$f"; done

say "2) Créer include Vault API (NO REDIRECT, proxy direct)"
cat >"$INC" <<EOF
# WV_VAULT_API ${TS}
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:${VAULT_PORT}/;
}
EOF

say "3) Injecter include dans CHAQUE server{} du vhost (80 + 443) (1 seule fois/server)"
python3 - <<'PY'
import re,sys
path="/etc/nginx/sites-available/fireinners.online-ssl"
inc="include /etc/nginx/includes/wv_vault_api.inc;"
s=open(path,"r",encoding="utf-8",errors="ignore").read().splitlines(True)

out=[]
i=0
n=len(s)

def brace_delta(line:str)->int:
    return line.count("{")-line.count("}")

while i<n:
    line=s[i]
    m=re.search(r'^\s*server\s*\{', line)
    if not m:
        out.append(line); i+=1; continue

    # buffer server block
    block=[line]
    depth=brace_delta(line)
    i+=1
    while i<n and depth>0:
        block.append(s[i])
        depth += brace_delta(s[i])
        i+=1

    txt="".join(block)
    if "include /etc/nginx/includes/wv_vault_api.inc;" in txt:
        out.extend(block); continue

    # insert include after first server_name if present, else after opening
    inserted=False
    nb=[]
    for ln in block:
        nb.append(ln)
        if (not inserted) and re.search(r'^\s*server_name\s+', ln):
            nb.append("  "+inc+"\n")
            inserted=True
    if not inserted:
        nb.insert(1,"  "+inc+"\n")
    out.extend(nb)

open(path,"w",encoding="utf-8").write("".join(out))
PY

say "4) S'assurer que sites-enabled pointe bien vers le vhost"
ln -sf "$VHOST" "$SEN" || true

say "5) nginx -t + reload"
nginx -t
systemctl reload nginx

say "6) Vérifier que Vault écoute"
if ! ss -ltnp 2>/dev/null | grep -q ":${VAULT_PORT}"; then
  say "Vault n'écoute PAS sur ${VAULT_PORT}. Status+logs:"
  systemctl status vault-api.service --no-pager || true
  journalctl -u vault-api.service -n 120 --no-pager || true
  exit 1
fi

say "7) Tests (DOIT être JSON partout, pas 301/HTML)"
echo "-- direct:"; curl -sS "http://127.0.0.1:${VAULT_PORT}/health"; echo

echo "-- via nginx HTTP (port 80) SANS redirect attendu:"
curl -sS -i -H "Host: ${HOST}" "http://127.0.0.1/wolverine/vault-api/health" | head -n 20; echo

echo "-- via nginx HTTPS (port 443) (SNI via --resolve):"
curl -k -sS --resolve "${HOST}:443:127.0.0.1" "https://${HOST}/wolverine/vault-api/health"; echo

echo "-- create HTTPS:"
curl -k -sS --resolve "${HOST}:443:127.0.0.1" -H "content-type: application/json" -X POST "https://${HOST}/wolverine/vault-api/create" -d "{}"; echo

say "DONE"
echo "Backups: $BK"
echo "Ouvre: https://${HOST}/wolverine/ puis Ctrl+F5"
BASH

chmod +x /root/WV_FIX_VAULT_301.sh
bash /root/WV_FIX_VAULT_301.sh
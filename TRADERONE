# 1) Confirme que le backend écoute TOUJOURS sur 12703
ss -ltnp | grep :12703 || echo "Rien sur 12703"

# 2) Test direct local (si ça répond, le backend est OK)
curl -i -X OPTIONS http://127.0.0.1:12703/wolverine/traderone/api/ | head -n 20

# 3) Montre la ligne proxy_pass active dans nginx
grep -RIn "wolverine/traderone/api|proxy_pass" /etc/nginx/sites-enabled/fireinners.online

# 4) Reload nginx (et vérifie)
nginx -t && systemctl reload nginx

# 5) Test via nginx LOCAL (important: contourne Cloudflare)
curl -i -X OPTIONS http://127.0.0.1/wolverine/traderone/api/ | head -n 20

# 6) Si toujours 502: lis l’erreur nginx
tail -n 60 /var/log/nginx/error.log
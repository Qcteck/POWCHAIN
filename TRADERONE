const $=s=>document.querySelector(s),log=t=>{const e=$("#log");e.textContent=(new Date).toLocaleTimeString()+" "+t+"\n"+e.textContent};
let pub="";
async function post(url,obj){const r=await fetch(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(obj||{})});const ct=r.headers.get("content-type")||"";let out;try{out=ct.includes("application/json")?await r.json():await r.text()}catch(e){out="(parse error)"}if(!r.ok)throw new Error(r.status+" "+(typeof out==="string"?out:JSON.stringify(out)));return out}

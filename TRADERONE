# Batch ROOT: viewer "sur le serveur" pour tes PNG (auto: GUI si dispo, sinon terminal)
set -euo pipefail

DIR="$(ls -d /root/bak_renders_machine_*/png 2>/dev/null | head -n 1 || true)"
[ -n "${DIR:-}" ] || { echo "❌ Dossier PNG introuvable: /root/bak_renders_machine_*/png"; exit 1; }

cd "$DIR"
echo "✅ PNG dir: $DIR"
echo "Images: $(ls -1 *.png 2>/dev/null | wc -l)"

# 1) Si GUI dispo -> ouvre le dossier
if [ -n "${DISPLAY:-}" ] && command -v xdg-open >/dev/null 2>&1; then
  echo "🖥️ GUI détectée -> ouverture du dossier"
  xdg-open .
  exit 0
fi

# 2) Sinon: aperçu dans le terminal (chafa)
echo "🖧 Pas de GUI -> aperçu terminal"
if ! command -v chafa >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y chafa
fi

# Affiche une planche d'aperçu (tu peux rerun, ça prend la 1ère image)
FIRST="$(ls -1 *.png | head -n 1)"
echo "=== PREVIEW: $FIRST ==="
chafa -s 120x40 "$FIRST" || true

# 3) Génère une galerie HTML + serveur local (accessible depuis le serveur)
if ! command -v python3 >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y python3
fi

python3 - <<'PY'
import glob, html
imgs = sorted(glob.glob("*.png"))
with open("index.html","w",encoding="utf-8") as f:
    f.write("<!doctype html><meta charset=utf-8><title>BAK renders</title>")
    f.write("<style>body{font-family:system-ui;background:#0b0f14;color:#e8eef6}"
            ".g{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}"
            ".c{background:#121826;border:1px solid #223049;border-radius:12px;padding:10px}"
            "img{width:100%;border-radius:10px} a{color:#7dd3fc}</style>")
    f.write(f"<h2>BAK renders ({len(imgs)})</h2><div class=g>")
    for p in imgs:
        n=html.escape(p)
        f.write(f'<div class=c><a href="{n}"><img loading="lazy" src="{n}"></a>'
                f'<div style="margin-top:6px;font-size:12px;opacity:.8">{n}</div></div>')
    f.write("</div>")
print("✅ index.html galerie créé")
PY

echo
echo "▶ Lancement serveur local sur 127.0.0.1:8080 (CTRL+C pour arrêter)"
echo "➡ Ouvre SUR LE SERVEUR: http://127.0.0.1:8080/index.html"
python3 -m http.server 8080 --bind 127.0.0.1
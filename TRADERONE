cat >/tmp/WOLVERINE_WAIT_8585_AND_RETEST.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SVC="traderone.service"
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"

echo "== Restart $SVC =="
systemctl restart "$SVC"

echo "== Wait for 8585 to LISTEN (max 15s) =="
ok=0
for i in $(seq 1 30); do
  if ss -lntp | grep -qE '127\.0\.0\.1:8585|0\.0\.0\.0:8585'; then
    ok=1
    break
  fi
  sleep 0.5
done

echo
ss -lntp | egrep ':(8585|9696)\s' || true
echo

if [ "$ok" -ne 1 ]; then
  echo "❌ 8585 ne LISTEN pas après attente."
  echo "== Status + logs =="
  systemctl status "$SVC" --no-pager -l | sed -n '1,45p' || true
  echo
  journalctl -u "$SVC" -n 120 --no-pager || true
  exit 1
fi

echo "== Re-test balances2 (A) /api (B) /wolverine/... =="
for URL in \
  "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" \
  "http://127.0.0.1:8585/wolverine/traderone/api/balances2?wallet=$WALLET"
do
  echo "=== $URL ==="
  curl -sS -D- "$URL" | head -c 320 || true
  echo; echo
done

echo "DONE ✅"
SH

bash /tmp/WOLVERINE_WAIT_8585_AND_RETEST.sh
#!/usr/bin/env bash
set -Eeuo pipefail

echo "=== MEGA WOLVERINE BATCH $(date -u) ==="

### CONFIG (NE JAMAIS CHANGER)
REPO_URL="https://${GITHUB_TOKEN}@github.com/Qcteck/WOLVERINE.git"
APP_DIR="/opt/wolverine"
UI_DIR="/opt/fireinners/frontend-react/app/dist/wolverine"
UI_FILE="$UI_DIR/index.html"
BACKUP_DIR="/opt/wolverine_backups"
NGINX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

### GUARDS
[ "$(id -u)" = "0" ] || { echo "ERROR: run as root"; exit 1; }
[ -n "${GITHUB_TOKEN:-}" ] || { echo "ERROR: GITHUB_TOKEN missing"; exit 1; }

mkdir -p "$BACKUP_DIR"

### BACKUP UI
if [ -f "$UI_FILE" ]; then
  cp -a "$UI_FILE" "$BACKUP_DIR/index.html.$(date +%s).bak"
  echo "UI backup OK"
fi

### CLONE / UPDATE REPO
if [ -d "$APP_DIR/.git" ]; then
  echo "Updating repo..."
  git -C "$APP_DIR" reset --hard
  git -C "$APP_DIR" clean -fd
  git -C "$APP_DIR" pull
else
  echo "Cloning repo..."
  rm -rf "$APP_DIR"
  git clone "$REPO_URL" "$APP_DIR"
fi

### DEPLOY UI
if [ ! -f "$APP_DIR/ui/index.html" ]; then
  echo "ERROR: ui/index.html missing in repo"
  exit 1
fi

mkdir -p "$UI_DIR"
cp -a "$APP_DIR/ui/index.html" "$UI_FILE"
echo "UI deployed"

### NGINX PATCH (IDEMPOTENT)
MARK_BEGIN="# BEGIN WOLVERINE"
MARK_END="# END WOLVERINE"

if ! grep -q "$MARK_BEGIN" "$NGINX_VHOST"; then
cat >> "$NGINX_VHOST" <<'NGINX'

# BEGIN WOLVERINE
location ^~ /wolverine/ {
    root /opt/fireinners/frontend-react/app/dist;
    index index.html;
    try_files $uri $uri/ /wolverine/index.html;
}
location ^~ /wolverine/api/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
# END WOLVERINE
NGINX
echo "Nginx block added"
else
  echo "Nginx block already present"
fi

### NGINX TEST + RELOAD
if nginx -t; then
  systemctl reload nginx
  echo "Nginx reloaded"
else
  echo "ERROR: nginx config failed – rollback UI"
  LAST_BACKUP=$(ls -t "$BACKUP_DIR"/index.html.*.bak | head -1 || true)
  [ -n "$LAST_BACKUP" ] && cp -a "$LAST_BACKUP" "$UI_FILE"
  exit 1
fi

echo "=== WOLVERINE DEPLOY OK ==="
echo "URL: https://fireinners.online/wolverine/"
#!/usr/bin/env bash
set -euo pipefail

APP="/var/www/fireinners.online/aiaquila"
BACK="/root/aiaquila_backup_$(date +%Y%m%d_%H%M%S)"
USER=www-data
GROUP=www-data

[ "$EUID" -ne 0 ] && echo "ROOT ONLY" && exit 1

mkdir -p "$BACK"
[ -d "$APP" ] && cp -a "$APP" "$BACK/"

mkdir -p "$APP"

cat > "$APP/index.html" <<'HTML'
<!doctype html>
<html lang="fr">
<meta charset="utf-8">
<title>AIAQUILA • Journaliste Interactif</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
body{margin:0;background:#0b0f14;color:#e6edf3;font-family:system-ui}
header{padding:14px;border-bottom:1px solid #1f2937}
main{max-width:960px;margin:auto;padding:20px}
#stream p{margin:.5em 0}
input{background:#111827;color:#e6edf3;border:1px solid #374151;padding:6px;width:100%}
</style>
<body>
<header><strong>AIAQUILA</strong> — bulletin & discussion</header>
<main>
<div id="stream"></div>
<input id="userInput" placeholder="Réponds ici…">
</main>

<script>
/* ===== USER MEMORY ===== */
const USER={
 name:null,
 preferences:{},
 confidence:{}
};

/* ===== VOICE ===== */
let voiceReady=false;
function unlockVoice(){
 if(voiceReady) return;
 voiceReady=true;
 speechSynthesis.speak(new SpeechSynthesisUtterance(" "));
}
["click","keydown","touchstart"].forEach(e=>{
 window.addEventListener(e,unlockVoice,{once:true});
});

function speak(text){
 const p=document.createElement("p");
 p.textContent=text;
 stream.appendChild(p);
 if(voiceReady){
   const u=new SpeechSynthesisUtterance(text);
   u.lang="fr-CA";
   speechSynthesis.speak(u);
 }
}

/* ===== HANDLE USER INPUT ===== */
userInput.addEventListener("keydown",e=>{
 if(e.key==="Enter"){
   const v=userInput.value.trim();
   userInput.value="";
   if(!USER.preferences.crypto_favorite){
     USER.preferences.crypto_favorite=v;
     USER.confidence.crypto_favorite=0.9;
     speak("D’accord. Je note que tu t’intéresses surtout à "+v+".");
     return;
   }
 }
});

/* ===== ARTICLE DISCUSSION ===== */
function discussArticle(a){
 if(USER.preferences.crypto_favorite &&
    a.fact.toLowerCase().includes(USER.preferences.crypto_favorite.toLowerCase())){
   speak(
     a.source+" parle encore de "+
     USER.preferences.crypto_favorite+
     ". Vu que c’est un sujet qui t’intéresse, "
     +"est-ce que tu trouves que le ton a changé par rapport aux semaines précédentes ?"
   );
 }else{
   speak(a.source+" rapporte que "+a.fact);
 }
}

/* ===== SIMULATED ARTICLE INGEST (PROXY READY) ===== */
setTimeout(()=>{
 discussArticle({
   source:"Reuters",
   fact:"les flux vers le bitcoin ont repris malgré des volumes encore irréguliers"
 });
},3000);
</script>
</body>
</html>
HTML

chown -R $USER:$GROUP "$APP"
chmod -R 755 "$APP"
nginx -t && systemctl reload nginx

echo "AIAQUILA AVEC MÉMOIRE UTILISATEUR DÉPLOYÉ"
cat >/root/fix_dup_wolverine_by_disabling_snippet_ui_location.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

SNIP="/etc/nginx/snippets/wolverine_routes.conf"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"

test -f "$SNIP" || { echo "Missing $SNIP"; exit 1; }
test -f "$VHOST" || { echo "Missing $VHOST"; exit 1; }

cp -a "$SNIP"  "$SNIP.bak_$TS"
cp -a "$VHOST" "$VHOST.bak_$TS"

echo "== 1) Disable ONLY the UI location in the snippet to avoid duplicate /wolverine/ =="

python3 - <<'PY'
import re
SNIP="/etc/nginx/snippets/wolverine_routes.conf"
lines=open(SNIP,"r",errors="ignore").read().splitlines(True)

out=[]
in_block=False
depth=0
for l in lines:
    if not in_block and re.search(r'^\s*location\b.*\s/wolverine/\s*\{', l):
        out.append("# DISABLED_DUPLICATE " + l)
        in_block=True
        depth = l.count("{") - l.count("}")
        continue
    if in_block:
        out.append("# DISABLED_DUPLICATE " + l)
        depth += l.count("{") - l.count("}")
        if depth <= 0 and "}" in l:
            in_block=False
        continue
    out.append(l)

open(SNIP,"w").writelines(out)
PY

echo "== 2) Ensure vhost has the UI /wolverine/ location (if not, add) =="
if ! grep -qE '^\s*location\s+\^~\s+/wolverine/' "$VHOST"; then
  cat >> "$VHOST" <<'NGX'

location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}
NGX
fi

echo "== 3) nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/fix_dup_wolverine_by_disabling_snippet_ui_location.sh
/root/fix_dup_wolverine_by_disabling_snippet_ui_location.sh
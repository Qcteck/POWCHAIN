cat >/root/batch_root_fireinners.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
APPLY="${APPLY:-0}"

VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
SNIP="/etc/nginx/snippets/${DOMAIN}_wolverine.conf"
INCLUDE_LINE="include ${SNIP};"

ts(){ date "+%Y-%m-%d %H:%M:%S"; }
say(){ echo "[$(ts)] $*"; }

say "== batch root (${DOMAIN}) =="
say "APPLY=${APPLY} (0=dry-run, 1=apply)"
say "VHOST=${VHOST}"
say "SNIP=${SNIP}"

if [[ ! -f "$VHOST" ]]; then
  say "ERROR: vhost introuvable: $VHOST"
  exit 1
fi

# 1) Build snippet (wolverine + favicon)
SNIP_CONTENT=$(cat <<'EOF'
# --- wolverine + favicon snippet ---
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}

location = /favicon.ico {
  access_log off;
  log_not_found off;
  try_files /favicon.ico =204;
}
EOF
)

say "== 1) Snippet =="
if [[ "$APPLY" == "1" ]]; then
  install -d /etc/nginx/snippets
  printf "%s\n" "$SNIP_CONTENT" >"$SNIP"
  say "OK: écrit -> $SNIP"
else
  say "[DRY] écrirait -> $SNIP"
fi

# 2) Patch vhost: ensure include is inside FIRST server{} block
say "== 2) Patch VHOST (include dans 1er server{}) =="

if grep -Fq "$INCLUDE_LINE" "$VHOST"; then
  say "OK: include déjà présent, rien à faire."
else
  TMP="$(mktemp)"
  awk -v inc="$INCLUDE_LINE" '
    BEGIN{done=0}
    {
      print $0
      if (!done && $0 ~ /^[[:space:]]*server[[:space:]]*\{[[:space:]]*$/) {
        print "  " inc
        done=1
      }
    }
    END{
      if (!done) {
        # fallback: si "server {" est sur la même ligne avec du texte, tente une 2e passe simple
      }
    }
  ' "$VHOST" >"$TMP"

  # Vérif qu'on a bien inséré
  if ! grep -Fq "$INCLUDE_LINE" "$TMP"; then
    # fallback: insert après la première occurrence de "server {"
    awk -v inc="$INCLUDE_LINE" '
      BEGIN{done=0}
      {
        print $0
        if (!done && $0 ~ /^[[:space:]]*server[[:space:]]*\{/) {
          print "  " inc
          done=1
        }
      }
      END{ if(!done) exit 2 }
    ' "$VHOST" >"$TMP"
  fi

  if [[ "$APPLY" == "1" ]]; then
    BACKDIR="/etc/nginx/sites-disabled/batch_root_$(date +%Y%m%d_%H%M%S)"
    install -d "$BACKDIR"
    cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
    say "Backup: $BACKDIR/$(basename "$VHOST")"
    cat "$TMP" >"$VHOST"
    say "OK: vhost patché"
  else
    say "[DRY] ferait un backup + patcherait $VHOST"
  fi
  rm -f "$TMP"
fi

# 3) nginx -t and reload only if OK
say "== 3) nginx -t =="
if nginx -t; then
  say "OK: nginx -t PASS"
  if [[ "$APPLY" == "1" ]]; then
    systemctl reload nginx
    say "OK: nginx reloaded"
  else
    say "[DRY] reload nginx"
  fi
else
  say "ERROR: nginx -t FAIL (pas de reload)"
  say "Astuce: si APPLY=1 a été utilisé, restore le backup depuis /etc/nginx/sites-disabled/batch_root_*"
  exit 1
fi

say "== DONE =="
BASH

chmod +x /root/batch_root_fireinners.sh
echo "OK: /root/batch_root_fireinners.sh prêt"
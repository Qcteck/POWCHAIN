cat >/root/WOLVERINE_RESET_SOL_CLEAN.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

### CONFIG
HTML="/var/www/wolverine/index.html"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/WOLVERINE_RESET_${TS}.log"

echo "=== WOLVERINE RESET SOL CLEAN ===" | tee -a "$LOG"

### 1) SAFETY BACKUP
cp -a "$HTML" "${HTML}.bak_${TS}"
cp -a "$VHOST" "${VHOST}.bak_${TS}"
echo "[1] Backup OK" | tee -a "$LOG"

### 2) FORCE NGINX ROOT
sed -i -E 's|root[[:space:]]+[^;]+;|root /var/www/wolverine;|g' "$VHOST"
grep -q "root /var/www/wolverine;" "$VHOST"
echo "[2] Nginx root forcé" | tee -a "$LOG"

### 3) RESET HTML (NU)
cat >"$HTML" <<'HTML'
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>WOLVERINE</title>
<style>
body{background:#050b10;color:#7ff;font-family:monospace}
.box{width:420px;margin:80px auto;border:2px solid #0ff;padding:20px}
button{width:100%;margin:6px 0;padding:10px;background:#000;color:#0ff;border:1px solid #0ff}
</style>
</head>
<body>

<div class="box">
<button id="connect">Connect Wallet</button>
<button id="refresh">Refresh</button>
<div>Address: <span id="addr">-</span></div>
<div>SOL: <span id="sol">-</span></div>
<div>USDC: -</div>
</div>

<script src="/wolverine/vendor/solana-web3.min.js"></script>
<script>
let connection;
let pubkey;

const RPC = "RPC_REPLACE";

document.getElementById("connect").onclick = async () => {
 if(!window.solana){alert("Phantom absent");return;}
 const r = await solana.connect();
 pubkey = r.publicKey;
 document.getElementById("addr").innerText = pubkey.toBase58();
 connection = new solanaWeb3.Connection(RPC,"confirmed");
 refreshSOL();
};

document.getElementById("refresh").onclick = () => {
 if(pubkey) refreshSOL();
};

async function refreshSOL(){
 const lamports = await connection.getBalance(pubkey);
 document.getElementById("sol").innerText = (lamports/1e9).toFixed(6);
}
</script>

</body>
</html>
HTML

sed -i "s|RPC_REPLACE|$RPC|g" "$HTML"
echo "[3] HTML clean injecté" | tee -a "$LOG"

### 4) PURGE CACHE
rm -rf /var/cache/nginx/*
echo "[4] Cache nginx purgé" | tee -a "$LOG"

### 5) TEST + RELOAD NGINX
nginx -t
systemctl reload nginx
echo "[5] Nginx reload OK" | tee -a "$LOG"

### 6) VERIFY FILE SERVED
curl -s http://127.0.0.1/wolverine/ | grep -q "WOLVERINE"
echo "[6] HTML réellement servi" | tee -a "$LOG"

echo "=== TERMINÉ ==="
echo "CTRL + SHIFT + R OBLIGATOIRE"

cat > /root/fireinners_fix_batch.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
DOMAIN_WWW="www.fireinners.online"

TS="$(date +%F_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/batchfix_${TS}"
mkdir -p "$BACKDIR"

echo "== Backup des sites-enabled -> $BACKDIR =="
shopt -s nullglob
for f in /etc/nginx/sites-enabled/*; do
  bn="$(basename "$f")"
  mv -v "$f" "$BACKDIR/$bn" || true
done

echo "== Détection cert Let's Encrypt =="
LE_FULL="/etc/letsencrypt/live/${DOMAIN}/fullchain.pem"
LE_KEY="/etc/letsencrypt/live/${DOMAIN}/privkey.pem"
if [[ ! -f "$LE_FULL" || ! -f "$LE_KEY" ]]; then
  echo "!! Certificat LE introuvable: $LE_FULL / $LE_KEY"
  echo "   Je continue quand même (tu peux adapter ssl_certificate / ssl_certificate_key)."
fi

VHOST="/etc/nginx/sites-available/${DOMAIN}-ssl"
echo "== Écriture vhost: $VHOST =="

cat > "$VHOST" <<EOF
# ${DOMAIN} - generated ${TS}

server {
  listen 80;
  listen [::]:80;
  server_name ${DOMAIN} ${DOMAIN_WWW};
  return 301 https://\$host\$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name ${DOMAIN} ${DOMAIN_WWW};

  # SSL (adapte si besoin)
  ssl_certificate     ${LE_FULL};
  ssl_certificate_key ${LE_KEY};

  # Logs
  access_log /var/log/nginx/${DOMAIN}.access.log;
  error_log  /var/log/nginx/${DOMAIN}.error.log;

  # Fix favicon 500
  location = /favicon.ico {
    access_log off;
    log_not_found off;
    return 204;
  }

  # Redirige la home vers /wolverine/
  location = / {
    return 302 /wolverine/;
  }

  # --- UI Wolverine sous /wolverine/ ---
  # IMPORTANT: alias + try_files => évite les boucles /index.html
  location ^~ /wolverine/ {
    alias /var/www/wolverine/;
    index index.html;
    try_files \$uri \$uri/ /wolverine/index.html;
  }

  # Optionnel: si tu as un backend API (à adapter)
  # location ^~ /wolverine/api/ {
  #   proxy_pass http://127.0.0.1:3000/;
  #   proxy_set_header Host \$host;
  #   proxy_set_header X-Real-IP \$remote_addr;
  #   proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  #   proxy_set_header X-Forwarded-Proto \$scheme;
  # }
}
EOF

echo "== Vérifs fichiers UI =="
test -f /var/www/wolverine/index.html || { echo "!! /var/www/wolverine/index.html introuvable"; exit 1; }

echo "== Enable site =="
ln -sf "$VHOST" "/etc/nginx/sites-enabled/$(basename "$VHOST")"

echo "== Test nginx =="
nginx -t

echo "== Reload nginx =="
systemctl reload nginx

echo "== Listeners 80/443 =="
ss -lntp | egrep ':(80|443)\s' || true

echo "== Curl local (Host header) =="
curl -kI https://127.0.0.1/wolverine/ -H "Host: ${DOMAIN}" | head -n 20 || true

echo "DONE."
BASH

chmod +x /root/fireinners_fix_batch.sh
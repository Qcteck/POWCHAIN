cat >/root/WOLV_DEBUG_FETCH_FAILED_JUPITER.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== [A] Basic system info ==="
node -v || true
npm -v || true
date || true
echo

echo "=== [B] DNS test ==="
getent hosts quote-api.jup.ag || true
cat /etc/resolv.conf || true
echo

echo "=== [C] CURL direct to Jupiter (HTTPS) ==="
set +e
curl -sS -I --max-time 8 https://quote-api.jup.ag/v6/quote | head -n 8
CURL_RC=$?
set -e
echo "curl_rc=$CURL_RC"
echo

echo "=== [D] Install/repair TLS CA certs + curl ==="
apt-get update -y >/dev/null 2>&1 || true
apt-get install -y ca-certificates curl openssl >/dev/null 2>&1 || true
update-ca-certificates >/dev/null 2>&1 || true
echo "CA certs refreshed ✅"
echo

echo "=== [E] CURL real quote (SOL->USDC sample) ==="
set +e
curl -sS --max-time 10 \
"https://quote-api.jup.ag/v6/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50" \
| head -c 200
echo
CURL2_RC=$?
set -e
echo "curl_quote_rc=$CURL2_RC"
echo

echo "=== [F] Node-fetch test (same machine) ==="
set +e
node - <<'NODE'
const fetch = require("node-fetch");
(async()=>{
  try{
    const url="https://quote-api.jup.ag/v6/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50";
    const r = await fetch(url, { timeout: 10000 });
    const t = await r.text();
    console.log("status=", r.status);
    console.log(t.slice(0,200));
  }catch(e){
    console.error("NODE_FETCH_ERR:", e && (e.stack || e.message || e));
    process.exit(2);
  }
})();
NODE
NODE_RC=$?
set -e
echo "node_fetch_rc=$NODE_RC"
echo

echo "=== [G] If curl OK but node-fetch fails: show OpenSSL handshake ==="
set +e
echo | openssl s_client -connect quote-api.jup.ag:443 -servername quote-api.jup.ag 2>/dev/null | head -n 25
set -e
echo

echo "=== DONE ==="
echo "If CURL_RC!=0 => réseau/DNS/TLS bloqué côté VPS."
echo "If curl OK and node_fetch fails => problème node runtime/env (proxy/CA) -> on fix dans service."
BASH

bash /root/WOLV_DEBUG_FETCH_FAILED_JUPITER.sh
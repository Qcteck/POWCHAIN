set -euo pipefail
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

node - <<'JS'
const fs=require("fs");
const f="/var/www/fireinners/wolverine/app.js";
let s=fs.readFileSync(f,"utf8");

// 1) Remplace tous les el.setStatus(...) par setStatus(...)
s = s.replace(/\bel\.setStatus\s*\(/g, "setStatus(");

// 2) Ajoute un shim au cas où un autre bout referait el.setStatus
//    (on attache el.setStatus = setStatus si el existe)
if(!s.includes("WOLVERINE_SETSTATUS_SHIM")){
  const idx = s.indexOf("function setStatus");
  if(idx !== -1){
    const insertPos = s.indexOf("{", idx) + 1;
    const shim = `
/* WOLVERINE_SETSTATUS_SHIM */
try { if (typeof el === "object" && el) el.setStatus = setStatus; } catch(e) {}
/* /WOLVERINE_SETSTATUS_SHIM */
`;
    s = s.slice(0, insertPos) + shim + s.slice(insertPos);
  }
}

fs.writeFileSync(f,s,"utf8");
console.log("OK: patched el.setStatus -> setStatus + shim");
JS

echo "DONE ✅ Fais Ctrl+F5 sur /wolverine puis reteste START"
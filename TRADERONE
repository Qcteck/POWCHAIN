set -e
cd /root

NEWKEY="$(openssl rand -hex 32)"
echo "=== NEW X-API-KEY ==="
echo "$NEWKEY"

for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  cp -v "$f" "/root/nginx_backups/$(basename "$f").$(date +%Y%m%d_%H%M%S)"
  sed -i -E 's/if \(\$http_x_api_key != ".*"\) \{ return 403; \}/if (\$http_x_api_key != "'"$NEWKEY"'") { return 403; }/g' "$f"
done

nginx -t
systemctl reload nginx

BASE="https://fireinners.online/wolverine/traderone/api"
echo "--- sans clé (403) ---"
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" --data '{}' | head -n 10
echo
echo "--- avec NOUVELLE clé (200) ---"
curl -sS -i -X POST "$BASE/status" -H "content-type: application/json" -H "X-API-KEY: $NEWKEY" --data '{}' | head -n 10
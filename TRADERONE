cat >/root/fix_buffer_min_js_404.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 0) Trouver comment /wolverine/ est servi (root/alias/try_files) =="
nginx -T 2>/dev/null | grep -nE 'location\s+\^~\s+/wolverine/|location\s+/wolverine/|alias\s+|root\s+|try_files' | head -n 200
echo

# Chemin attendu (d'après ce qu'on a vu avant: /var/www/wolverine)
DIR="/var/www/wolverine"
FILE="$DIR/buffer.min.js"

echo "== 1) Vérif FS =="
ls -lah "$DIR" || true
echo "Target: $FILE"
echo

echo "== 2) Créer/forcer buffer.min.js en local =="
mkdir -p "$DIR"
curl -fsSL "https://cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js" -o "$FILE"
chmod 0644 "$FILE"
ls -lah "$FILE"
echo

echo "== 3) Test ORIGIN (bypass CF) sur le fichier =="
curl -sk --resolve fireinners.online:443:127.0.0.1 -I "https://fireinners.online/wolverine/buffer.min.js" | sed -n '1,25p'
echo

echo "== 4) Si ORIGIN renvoie encore 404, on affiche l'URI résolue côté nginx =="
# on force aussi un GET court
curl -sk --resolve fireinners.online:443:127.0.0.1 "https://fireinners.online/wolverine/buffer.min.js" | head -c 80 && echo
echo "DONE ✅"
BASH

chmod +x /root/fix_buffer_min_js_404.sh
/root/fix_buffer_min_js_404.sh
#!/usr/bin/env bash
set -e

echo "=== TRADERONE • NO NGINX • ONE SHOT FIX ==="

### VARIABLES (NE CHANGE RIEN SAUF SI TU VEUX)
APP_DIR="/opt/traderone-opt"
APP_NAME="traderone"
PORT=3000

echo "[1] STOP & REMOVE NGINX (COMPLET)"
systemctl stop nginx || true
systemctl disable nginx || true
apt-get purge -y nginx nginx-common nginx-full || true
rm -rf /etc/nginx || true

echo "[2] INSTALL DEPENDENCIES"
apt-get update -y
apt-get install -y curl git ufw nodejs npm
npm install -g pm2

echo "[3] CHECK TRADERONE DIR"
if [ ! -d "$APP_DIR" ]; then
  echo "[FATAL] $APP_DIR not found"
  exit 1
fi

cd "$APP_DIR"

echo "[4] ENSURE SERVER LISTENS ON 0.0.0.0"
grep -q "0.0.0.0" server.js || {
  echo "[WARN] server.js may not bind to 0.0.0.0"
  echo ">>> VERIFY: app.listen(PORT,'0.0.0.0')"
}

echo "[5] INSTALL NODE DEPS"
npm install

echo "[6] START WITH PM2"
pm2 delete "$APP_NAME" || true
pm2 start server.js --name "$APP_NAME"
pm2 save
pm2 startup systemd -u root --hp /root

echo "[7] FIREWALL OPEN PORT $PORT"
ufw allow $PORT/tcp || true
ufw reload || true

echo "[8] LOCAL TEST"
sleep 2
curl -s http://127.0.0.1:$PORT/ping || echo "[WARN] /ping not responding"

echo "========================================"
echo "TRADERONE ONLINE SANS NGINX"
echo "URL: http://IP_DU_VPS:$PORT"
echo "========================================"
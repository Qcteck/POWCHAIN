cat >/root/debug_redirect_loop.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
PUBIP="$(curl -4s https://api.ipify.org || true)"

echo "== ORIGIN local =="
curl -kIL --max-redirs 10 https://127.0.0.1/wolverine/ | sed -n '1,40p' || true
echo

if [[ -n "$PUBIP" ]]; then
  echo "== BYPASS Cloudflare (resolve to origin IP) =="
  curl -kIL --max-redirs 10 --resolve fireinners.online:443:$PUBIP https://fireinners.online/wolverine/ | sed -n '1,60p' || true
  echo
fi

echo "== VIA Cloudflare =="
curl -kIL --max-redirs 10 https://fireinners.online/wolverine/ | sed -n '1,60p' || true
BASH

chmod +x /root/debug_redirect_loop.sh
/root/debug_redirect_loop.sh
#!/usr/bin/env bash
set -euo pipefail

### =========================
### AIAQUILA — ROOT INSTALL
### =========================

TARGET="/var/www/aiaquila"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

echo "== AIAQUILA | INSTALL FRONTEND =="

# 1. Dossiers
mkdir -p "$TARGET"
chown -R www-data:www-data "$TARGET"

# 2. HTML FRONTEND COMPLET
cat > "$TARGET/index.html" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>AIAQUILA</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{margin:0;background:#05070a;color:#e6e6e6;font-family:system-ui}
header{padding:12px 20px;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{padding:20px}
button{background:#111827;color:#fff;border:1px solid #374151;padding:6px 10px;border-radius:6px;cursor:pointer}
button:hover{background:#1f2937}
#stream{max-width:900px;line-height:1.6}
.feedback{position:fixed;bottom:18px;right:18px;display:flex;gap:10px}
.particle{position:fixed;inset:0;pointer-events:none}
</style>
</head>
<body>

<header>
  <strong>AIAQUILA</strong>
  <span id="level"></span>
</header>

<main>
  <div id="stream"></div>
</main>

<div class="feedback">
  <button onclick="feedback(+1)">👍</button>
  <button onclick="feedback(-1)">👎</button>
</div>

<canvas class="particle" id="p"></canvas>

<script>
/* ===============================
   MEMORY CORE
================================ */
const MEM = {
  dialogue: JSON.parse(localStorage.getItem("aq_dialogue")) || {
    base:0.55,
    level:0.55,
    min:0.45,
    max:0.65,
    history:[]
  },
  user: JSON.parse(localStorage.getItem("aq_user")) || {
    facts:[],
    questions:[],
    asked:[]
  },
  entities: JSON.parse(localStorage.getItem("aq_entities")) || {}
};

function save(){
  localStorage.setItem("aq_dialogue",JSON.stringify(MEM.dialogue));
  localStorage.setItem("aq_user",JSON.stringify(MEM.user));
  localStorage.setItem("aq_entities",JSON.stringify(MEM.entities));
}

/* ===============================
   FEEDBACK ±10 %
================================ */
function feedback(v){
  const step=0.02;
  MEM.dialogue.level+=v*step;
  MEM.dialogue.level=Math.max(MEM.dialogue.min,Math.min(MEM.dialogue.max,MEM.dialogue.level));
  MEM.dialogue.history.push({t:Date.now(),v});
  save();
  render();
}

/* ===============================
   ARTICLE RENDER (SIMPLIFIED)
================================ */
function render(){
  const lvl=MEM.dialogue.level;
  document.getElementById("level").textContent="Circumstantial "+Math.round(lvl*100)+"%";

  let text="";
  if(lvl<0.5){
    text="L’article présente les faits sans accent particulier. Le contexte est posé, stable, sans rupture notable.";
  }else if(lvl<0.6){
    text="Le ton de l’article suggère que les éléments évoqués sont déjà largement intégrés dans le paysage actuel.";
  }else{
    text="L’article s’inscrit dans une continuité presque silencieuse, comme si le sujet ne faisait plus vraiment débat.";
  }

  document.getElementById("stream").textContent=text;
}
render();

/* ===============================
   PARTICLES (visual logic)
================================ */
const c=document.getElementById("p"),x=c.getContext("2d");
function resize(){c.width=innerWidth;c.height=innerHeight}
window.onresize=resize;resize();

function draw(){
  x.clearRect(0,0,c.width,c.height);
  const n=Math.floor(50+MEM.dialogue.level*100);
  for(let i=0;i<n;i++){
    x.fillStyle="rgba(100,180,255,0.08)";
    x.beginPath();
    x.arc(Math.random()*c.width,Math.random()*c.height,1.2,0,6.28);
    x.fill();
  }
  requestAnimationFrame(draw);
}
draw();
</script>

</body>
</html>
HTML

# 3. NGINX ROUTE (SAFE APPEND)
if ! grep -q "/aiaquila" "$NGINX_SITE"; then
  chattr -i "$NGINX_SITE" || true
  sed -i '/location \/ {/a \
  location /aiaquila/ {\n\
    alias /var/www/aiaquila/;\n\
    index index.html;\n\
    try_files $uri $uri/ =404;\n\
  }\n' "$NGINX_SITE"
  nginx -t
  systemctl reload nginx
  chattr +i "$NGINX_SITE" || true
fi

echo "== AIAQUILA DEPLOYED =="
echo "URL: https://fireinners.online/aiaquila"





bash <(curl -fsSL https://raw.githubusercontent.com/qcteck/aiaquila/main/AIAQUILA_ROOT_INSTALL.sh)


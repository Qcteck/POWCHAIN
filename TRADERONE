cat >/root/find_and_set_usdc_mint_devnet.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APPLY="${APPLY:-0}"                         # 0=scan only, 1=apply best guess
APP_DIR="${APP_DIR:-/opt/_wolverine_next_src}"
DOMAIN="${DOMAIN:-fireinners.online}"
OUT_DIR="${OUT_DIR:-/var/www/wolverine}"

# Où chercher (tu peux ajouter des chemins)
SEARCH_DIRS=(
  "$APP_DIR"
  "/etc"
  "/opt"
  "/var/www"
  "/root"
)

ts(){ date +%Y%m%d_%H%M%S; }
say(){ echo "[$(ts)] $*"; }

# base58-ish token mint length on solana is usually 32..44 chars (common 43/44)
BASE58_RE='[1-9A-HJ-NP-Za-km-z]{32,44}'

say "APPLY=$APPLY"
say "APP_DIR=$APP_DIR"
echo

# 1) Grep context lines where USDC mentioned
say "== 1) Context USDC mentions =="
tmp_ctx="/tmp/usdc_ctx_$$.txt"
: > "$tmp_ctx"
for d in "${SEARCH_DIRS[@]}"; do
  [[ -d "$d" ]] || continue
  grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
    -E 'USDC|usd-?c|stablecoin|mint|tokenMint|usdcMint|USDC_MINT' \
    "$d" 2>/dev/null >> "$tmp_ctx" || true
done
tail -n 80 "$tmp_ctx" || true
echo

# 2) Extract base58 candidates near USDC lines
say "== 2) Candidates (base58) near USDC lines =="
tmp_cand="/tmp/usdc_candidates_$$.txt"
: > "$tmp_cand"
awk -v re="$BASE58_RE" '
{
  line=$0
  while (match(line, re)) {
    addr=substr(line, RSTART, RLENGTH)
    print addr "\t" $0
    line=substr(line, RSTART+RLENGTH)
  }
}' "$tmp_ctx" | sort -u > "$tmp_cand"

if [[ ! -s "$tmp_cand" ]]; then
  say "[WARN] Aucun mint trouvé près de 'USDC'. On fait un scan global plus large…"
  echo
fi

# 3) Fallback: scan repo for base58 + keywords on same line (mint/token/usdc)
say "== 3) Fallback scan repo (mint/token/usdc lines) =="
tmp_repo="/tmp/usdc_repo_$$.txt"
: > "$tmp_repo"
if [[ -d "$APP_DIR" ]]; then
  grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
    -E "(${BASE58_RE}).*(USDC|usd|mint|token)|((USDC|usd|mint|token).*)(${BASE58_RE})" \
    "$APP_DIR" 2>/dev/null >> "$tmp_repo" || true
fi
tail -n 80 "$tmp_repo" || true
echo

# Merge candidates from repo fallback too
awk -v re="$BASE58_RE" '
{
  line=$0
  while (match(line, re)) {
    addr=substr(line, RSTART, RLENGTH)
    print addr "\t" $0
    line=substr(line, RSTART+RLENGTH)
  }
}' "$tmp_repo" >> "$tmp_cand"

# 4) Show unique candidates ranked by frequency (rough)
say "== 4) Unique candidates ranked =="
cut -f1 "$tmp_cand" | awk '{c[$1]++} END{for(k in c) print c[k],k}' | sort -nr | head -n 25
echo

best="$(cut -f1 "$tmp_cand" | awk '{c[$1]++} END{best="";mx=0; for(k in c){ if(c[k]>mx){mx=c[k];best=k}} print best }')"
if [[ -z "$best" ]]; then
  say "[ERR] Aucun mint candidate détecté. Donne-moi le mint exact devnet que tu utilises."
  exit 1
fi

say "BEST_GUESS_USDC_DEVNET_MINT=$best"
echo

say "== 5) Context for best guess =="
grep -nF "$best" "$tmp_cand" | head -n 25 || true
echo

if [[ "$APPLY" != "1" ]]; then
  say "DRY-RUN: relance avec APPLY=1 pour injecter ce mint dans $APP_DIR/lib/solana.js"
  exit 0
fi

# 6) APPLY: write into lib/solana.js as USDC_DEVNET_MINT_STR
SOLANA_LIB="$APP_DIR/lib/solana.js"
[[ -d "$APP_DIR" ]] || { say "[ERR] APP_DIR introuvable"; exit 1; }

mkdir -p "$APP_DIR/lib"
bak="/root/backup_usdc_mint_$(ts)"
mkdir -p "$bak"
[[ -f "$SOLANA_LIB" ]] && cp -a "$SOLANA_LIB" "$bak/solana.js.bak" || true

# If file already has USDC_DEVNET_MINT_STR, replace; otherwise append a minimal block
if [[ -f "$SOLANA_LIB" ]] && grep -q 'USDC_DEVNET_MINT_STR' "$SOLANA_LIB"; then
  perl -pi -e "s/(USDC_DEVNET_MINT_STR\\s*=\\s*\")[^\"]*(\"\\s*;)/\\1$best\\2/g" "$SOLANA_LIB"
  say "OK: updated USDC_DEVNET_MINT_STR in lib/solana.js"
else
  cat > "$SOLANA_LIB" <<EOF
import { Connection, PublicKey } from "@solana/web3.js";

export const MAINNET_RPC = "https://api.mainnet-beta.solana.com";
export const DEVNET_RPC  = "https://api.devnet.solana.com";

// wallet interne
export const WOLVERINE_WALLET = new PublicKey(process.env.NEXT_PUBLIC_WOLVERINE_WALLET || "");

// USDC mainnet officiel
export const USDC_MAINNET_MINT = new PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v");

// ✅ USDC devnet (auto-detect VPS)
export const USDC_DEVNET_MINT_STR = "$best";
EOF
  say "OK: wrote new lib/solana.js with USDC_DEVNET_MINT_STR=$best"
fi

# 7) Build + publish
say "== 6) Build + export + publish =="
cd "$APP_DIR"
npm run build
rsync -a --delete out/ "$OUT_DIR/"
nginx -t && systemctl reload nginx

say "DONE ✅ Devnet USDC mint set to: $best"
say "Test: https://${DOMAIN}/wolverine/ (switch Devnet) puis connect Phantom"
BASH

chmod +x /root/find_and_set_usdc_mint_devnet.sh
echo "OK: /root/find_and_set_usdc_mint_devnet.sh prêt"
set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.final_fix_$(date +%s)"

echo "=== 1) Où est le 403 / api-key dans le conf ? ==="
grep -nE 'return 403|http_x_api_key|X-API-KEY|deny all|allow ' "$NG" | head -n 120 || true
echo

echo "=== 2) Nettoyer tout ce qui touche à wolverine et ré-injecter un bloc propre ==="
python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# Supprime tous les blocs existants qui concernent wolverine (anciens/multiples)
patterns = [
  r'\n\s*###\s*===\s*WOLVERINE[\s\S]*?###\s*===\s*END\s*WOLVERINE\s*===\s*',
  r'\n\s*#\s*---\s*WOLVERINE[^\n]*\n',
  r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*/wolverine/api/\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*=\s*/wolverine/traderone/api/health\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/traderone/api/\s*\{[\s\S]*?\n\s*\}\s*',
]
for pat in patterns:
  s = re.sub(pat, "\n", s, flags=re.M)

# IMPORTANT: commente les checks api-key globaux s'ils existent (hors locations)
s = re.sub(r'^\s*(if\s*\(\s*\$http_x_api_key[\s\S]*?return\s+403;[\s\S]*?\}\s*)$',
           r'# \1', s, flags=re.M)

block = r'''
# --- WOLVERINE_FINAL ---

# UI public
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/ {
  # ton root est déjà: /opt/fireinners/frontend-react/app/dist
  try_files $uri $uri/ /wolverine/index.html;
}

# API public: /health
location = /wolverine/traderone/api/health {
  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;

  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}

# API protégée: tout le reste
location ^~ /wolverine/traderone/api/ {
  if ($http_x_api_key = "") { return 403; }

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;

  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
'''

idx = s.rfind("}")
if idx == -1:
  raise SystemExit("KO: pas trouvé de '}' final dans le fichier nginx")

s = s[:idx] + "\n" + block + "\n" + s[idx:]
ng.write_text(s)
print("OK: bloc WOLVERINE_FINAL écrit")
PY

echo "=== 3) nginx test + reload ==="
nginx -t
systemctl reload nginx
echo "OK: reloaded"
echo


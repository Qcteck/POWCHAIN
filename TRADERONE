bash -lc 'set -euo pipefail;REPO="git@github.com:Qcteck/WOLVERINE.git";BR="main";STAGE="/opt/wolverine_repo_stage";TR="/opt/traderone-opt";say(){ printf "\n[WOLVERINE->GITHUB] %s\n" "$*"; };need(){ command -v "$1" >/dev/null 2>&1; }
need git||{ apt-get update -y >/dev/null 2>&1||true; apt-get install -y git >/dev/null; }
need rsync||{ apt-get update -y >/dev/null 2>&1||true; apt-get install -y rsync >/dev/null; }
ssh -o BatchMode=yes -T git@github.com >/dev/null 2>&1 || { say "SSH GitHub pas prêt (deploy key write pas ajoutée?). Fais: ssh -T git@github.com"; exit 2; }

find_wolv(){ for root in /opt /var/www /srv /root /home;do [ -d "$root" ]||continue; find "$root" -maxdepth 7 -type d -iname "*wolverine*" 2>/dev/null | while read -r d;do s=0;[ -f "$d/index.html" ]&&s=$((s+3));[ -d "$d/vendor" ]&&s=$((s+3));find "$d" -maxdepth 2 -type f -name "index.html" -print -quit 2>/dev/null | grep -q . && s=$((s+1))||true;find "$d" -maxdepth 5 -type f \( -name "server.js" -o -name "app.js" -o -name "package.json" \) -print -quit 2>/dev/null | grep -q . && s=$((s+1))||true;[ "$s" -ge 3 ]&&echo "$s|$d";done;done | sort -nr | head -n1 | cut -d"|" -f2; }

WOLV="${WOLV:-$(find_wolv||true)}"
[ -d "$TR" ] || { say "TraderOne introuvable: $TR"; exit 3; }
[ -n "${WOLV:-}" ] && [ -d "$WOLV" ] || { say "Wolverine introuvable. Force: export WOLV=/chemin/wolverine ثم relance."; exit 4; }

say "TraderOne = $TR"
say "Wolverine = $WOLV"

rm -rf "$STAGE"; mkdir -p "$STAGE"; cd "$STAGE"
git init -q repo; cd repo
git config user.name  "vps-sync"
git config user.email "vps-sync@local"
git remote add origin "$REPO" 2>/dev/null || git remote set-url origin "$REPO"
git checkout -B "$BR" -q

mkdir -p SYNC/TRADERONE SYNC/WOLVERINE
EXC=(--exclude ".git" --exclude "node_modules" --exclude "db" --exclude "db/**" --exclude ".leveldb" --exclude ".leveldb/**" --exclude "*.log" --exclude "logs" --exclude "logs/**" --exclude ".env" --exclude "*.env" --exclude "telegram.env" --exclude "*.key" --exclude "*.pem" --exclude "*.p12" --exclude "*.pfx" --exclude "*id_rsa*" --exclude "*id_ed25519*")

rsync -a --delete "${EXC[@]}" "$TR"/ SYNC/TRADERONE/
rsync -a --delete "${EXC[@]}" "$WOLV"/ SYNC/WOLVERINE/

cat > SYNC/SYNC_REPORT.txt <<EOF
SYNC_REPORT
date=$(date -Iseconds)
repo=$REPO
branch=$BR
traderone_src=$TR
wolverine_src=$WOLV
EOF

git add -A
git diff --cached --quiet && { say "Aucun changement à pousser."; exit 0; }
git commit -m "Sync VPS: TraderOne+Wolverine $(date -Iseconds)" >/dev/null
git push -u origin "$BR"
say "OK: repo WOLVERINE rempli. Dossiers: SYNC/TRADERONE et SYNC/WOLVERINE"'
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/wolverine_rpc_proxy.conf"
TS="$(date +%s)"

echo "== 0) BACKUP + CLEAN: remove RPC location blocks from snippets (bad context) =="
mkdir -p /etc/nginx/snippets
for f in /etc/nginx/snippets/*.conf; do
  [ -f "$f" ] || continue
  cp -a "$f" "$f.bak.$TS" 2>/dev/null || true
  perl -0777 -i -pe 's/location\s*=\s*\/wolverine\/traderone\/api\/rpc\s*\{[\s\S]*?\}\s*//g' "$f" || true
done

echo "== 1) WRITE RPC LOCATION SNIPPET (location only; must be included inside server{}) =="
cat > "$SNIP" <<'EOF'
# Wolverine: Solana RPC proxy (same-origin)
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF

echo "== 2) FIND REAL VHOST FILES SERVING /wolverine (no server_name dependency) =="
mapfile -t VHOSTS < <(
  grep -RIl --include='*.conf' -E \
    'include\s+/etc/nginx/snippets/fireinners-wolverine\.conf|root\s+/var/www/fireinners|location\s+(\^~\s+)?/wolverine' \
    /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null \
  | grep -v '/etc/nginx/snippets/' \
  | sort -u
)

echo "Found vhosts:"
printf ' - %s\n' "${VHOSTS[@]:-NONE}"
[ "${#VHOSTS[@]}" -gt 0 ] || { echo "ERR: aucun vhost trouvé qui sert /wolverine"; echo "Run: nginx -T | grep -n \"/wolverine\""; exit 1; }

echo "== 3) INJECT include snippet into each matching server{} (if missing) =="
for vf in "${VHOSTS[@]}"; do
  if grep -q 'include /etc/nginx/snippets/wolverine_rpc_proxy.conf' "$vf"; then
    echo "OK already included in $vf"
    continue
  fi
  cp -a "$vf" "$vf.bak.$TS"
  echo "Backup: $vf.bak.$TS"

  # inject include inside first server{} block of that file
  perl -0777 -i -pe 's/(server\s*\{[\s\S]*?)(\n\})/$1\n\n  include \/etc\/nginx\/snippets\/wolverine_rpc_proxy\.conf;\n$2/s' "$vf"
  echo "Injected into $vf"
done

echo "== 4) NGINX TEST + RELOAD =="
nginx -t
systemctl reload nginx

echo "== 5) TEST HTTPS RPC (must NOT be 404/not_found) =="
curl -ksS -i "https://$DOMAIN/wolverine/traderone/api/rpc" \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 30
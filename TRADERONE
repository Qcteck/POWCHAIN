bash -lc 'set -euo pipefail;TS="$(date +%Y%m%d_%H%M%S)";NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl";NGX_INC_DIR="/etc/nginx/includes";NGX_INC_FILE="$NGX_INC_DIR/orion_routes.inc";log(){ printf "\n[%s] %s\n" "$(date -u +%F\ %T\ UTC)" "$*"; };die(){ echo "ERROR: $*" >&2; exit 1; };[[ "$(id -u)" == "0" ]]||die "Lance en root.";command -v nginx >/dev/null||die "nginx manquant.";backup(){ [[ -e "$1" ]]&&cp -a "$1" "$1.bak.$TS"||true; };unlock(){ command -v chattr >/dev/null&&[[ -e "$1" ]]&&chattr -i "$1" 2>/dev/null||true; };lock(){ command -v chattr >/dev/null&&[[ -e "$1" ]]&&chattr +i "$1" 2>/dev/null||true; };log "=== ORION NGINX FIX START ===";mkdir -p "$NGX_INC_DIR";unlock "$NGX_INC_FILE";backup "$NGX_INC_FILE";cat >"$NGX_INC_FILE" <<'"'"'NGX'"'"'

BEGIN{inserver=0;done=0}
{print $0}
$0~ /^[[:space:]]*server[[:space:]]*\{/ {inserver=1}
(inserver && !done && $0 ~ /server_name[[:space:]]/) {print "  include /etc/nginx/includes/orion_routes.inc;";done=1}
END{}'"'"' "$PRIMARY" > "$tmp" || die "awk failed";cp -a "$PRIMARY" "$BK/$(basename "$PRIMARY").bak";mv -f "$tmp" "$PRIMARY";fi;log "Prepare /var/www/orion";mkdir -p "$ORION_ROOT";chown -R www-data:www-data "$ORION_ROOT"||true;log "Acquire source";mkdir -p "$WORK/src";if [[ -f "$SRC" ]];then log "Using local ZIP: $SRC";apt-get update -y >/dev/null 2>&1||true;apt-get install -y unzip >/dev/null 2>&1||true;unzip -q "$SRC" -d "$WORK/src";elif [[ -n "${ORION_ZIP_URL:-}" ]];then log "Downloading ZIP from ORION_ZIP_URL";apt-get update -y >/dev/null 2>&1||true;apt-get install -y curl unzip >/dev/null 2>&1||true;curl -fsSL "$ORION_ZIP_URL" -o "$WORK/orion.zip";unzip -q "$WORK/orion.zip" -d "$WORK/src";elif [[ -n "${ORION_GIT_URL:-}" ]];then log "Cloning from ORION_GIT_URL";apt-get update -y >/dev/null 2>&1||true;apt-get install -y git >/dev/null 2>&1||true;git clone --depth 1 "$ORION_GIT_URL" "$WORK/src/repo";else die "Provide /root/orion.zip OR set ORION_ZIP_URL or ORION_GIT_URL";fi;log "Detect project root";PROJ="$WORK/src";if [[ -d "$WORK/src/repo" ]];then PROJ="$WORK/src/repo";else dcount="$(find "$WORK/src" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d " ")";fcount="$(find "$WORK/src" -mindepth 1 -maxdepth 1 -type f | wc -l | tr -d " ")";if [[ "$dcount" == "1" && "$fcount" == "0" ]];then PROJ="$(find "$WORK/src" -mindepth 1 -maxdepth 1 -type d | head -n1)";fi;fi;log "Project: $PROJ";OUT="";if [[ -f "$PROJ/package.json" ]];then log "Build detected (package.json)";command -v node >/dev/null 2>&1||{ log "Node missing -> installing nodejs/npm (ubuntu repo)"; apt-get update -y; apt-get install -y nodejs npm; };command -v corepack >/dev/null 2>&1 && corepack enable >/dev/null 2>&1||true;cd "$PROJ";PM="npm";if [[ -f pnpm-lock.yaml ]];then PM="pnpm";elif [[ -f yarn.lock ]];then PM="yarn";fi;log "Package manager: $PM";if [[ "$PM" == "pnpm" ]];then pnpm -v >/dev/null 2>&1||corepack prepare pnpm@latest --activate >/dev/null 2>&1||true;pnpm install --frozen-lockfile || pnpm inst
set -euo pipefail

echo "=== 1) Installer/repair OpenSSL (Ubuntu) ==="
apt-get update -y
apt-get install -y openssl ca-certificates libssl3

echo "=== 2) Vérifier modules OpenSSL ==="
ls -lah /usr/lib/x86_64-linux-gnu/ossl-modules 2>/dev/null || true
openssl version -a || true

echo "=== 3) Neutraliser variables OpenSSL cassées (session courante) ==="
unset OPENSSL_CONF || true
unset OPENSSL_MODULES || true

echo "=== 4) Vérifier PhantomJS binaire ==="
command -v phantomjs || true
ls -lah /usr/local/bin/phantomjs || true

echo "=== 5) Voir si des libs manquent (important) ==="
ldd /usr/local/bin/phantomjs | egrep -i "not found|ssl|crypto" || true

echo "=== 6) Test version + mini script ==="
phantomjs --version
phantomjs -e 'console.log("phantom ok", phantom.version.major+"."+phantom.version.minor+"."+phantom.version.patch); phantom.exit();'
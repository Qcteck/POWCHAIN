cat >/root/UPGRADE_WOLVERINE_SOL_USDC.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

cp "$HTML" "$HTML.bak_$TS"

cat >"$HTML" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>WOLVERINE • Phantom</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{background:#0b0f14;color:#00eaff;font-family:Arial;display:flex;justify-content:center;align-items:center;height:100vh;margin:0}
#box{border:2px solid #00eaff;padding:20px;width:380px;text-align:center}
button{width:100%;padding:10px;margin:8px 0;font-size:16px;background:#111;color:#00eaff;border:1px solid #00eaff;cursor:pointer}
button:hover{background:#00eaff;color:#000}
.addr{word-break:break-all;font-size:13px;margin-top:8px}
.row{margin-top:6px}
</style>
</head>
<body>
<div id="box">
  <button onclick="connect()">Connect Wallet</button>
  <button onclick="refresh()">Refresh</button>
  <div class="addr" id="addr"></div>
  <div class="row">SOL: <span id="sol">-</span></div>
  <div class="row">USDC: <span id="usdc">-</span></div>
</div>

<script>
const RPC="https://rpc.ankr.com/solana";
const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
let PUB=null;

async function rpc(method,params){
  const r=await fetch(RPC,{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify({jsonrpc:"2.0",id:1,method,params})});
  return (await r.json()).result;
}

async function connect(){
  if(!window.solana?.isPhantom){alert("Phantom not found");return;}
  const r=await window.solana.connect();
  PUB=r.publicKey.toString();
  document.getElementById("addr").textContent=PUB;
  await refresh();
}

async function refresh(){
  if(!PUB)return;

  const bal=await rpc("getBalance",[PUB]);
  document.getElementById("sol").textContent=(bal.value/1e9).toFixed(4);

  const tokens=await rpc("getTokenAccountsByOwner",[PUB,{mint:USDC_MINT},{encoding:"jsonParsed"}]);
  let u=0;
  if(tokens.value.length){
    u=tokens.value[0].account.data.parsed.info.tokenAmount.uiAmount;
  }
  document.getElementById("usdc").textContent=u;
}
</script>
</body>
</html>
HTML

chown www-data:www-data "$HTML"
chmod 644 "$HTML"

echo "OK — SOL + USDC added"
echo "Backup: $HTML.bak_$TS"
BASH

chmod +x /root/UPGRADE_WOLVERINE_SOL_USDC.sh




/root/UPGRADE_WOLVERINE_SOL_USDC.sh


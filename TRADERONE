# ROOT — FIND REAL NEXT APP (ignore node_modules) + BUILD + DEPLOY
set -euo pipefail

BASE="/opt/fireinners/WOLVERINE"
DIST="/var/www/wolverine"

echo "=== 0) Precheck ==="
[ -d "$BASE" ] || { echo "ERROR: missing $BASE"; exit 1; }
mkdir -p "$DIST"

echo "=== 1) Find REAL APP_DIR (exclude node_modules, require Next app) ==="
APP_DIR=""

while IFS= read -r -d '' pj; do
  d="$(dirname "$pj")"

  # skip dependencies folders
  case "$d" in
    *"/node_modules/"*|*"/.git/"*|*"/out/"*|*"/.next/"*) continue;;
  esac

  # must look like a Next app (pages/ or app/ or next.config.js)
  if [ ! -d "$d/pages" ] && [ ! -d "$d/app" ] && [ ! -f "$d/next.config.js" ]; then
    continue
  fi

  # must have scripts.build that looks like next build/export
  if node -e '
    const p=require(process.argv[1]);
    const b=p?.scripts?.build || "";
    process.exit(
      typeof b==="string" &&
      (b.includes("next ") || b.includes("next-build") || b.includes("next build") || b.includes("next export"))
      ? 0 : 1
    );
  ' "$pj" >/dev/null 2>&1; then
    APP_DIR="$d"
    break
  fi
done < <(find "$BASE" -maxdepth 7 -type f -name package.json -print0)

if [ -z "$APP_DIR" ]; then
  echo "ERROR: Could not find a Next app under $BASE"
  echo "Candidates (package.json excluding node_modules):"
  find "$BASE" -maxdepth 7 -type f -name package.json ! -path "*/node_modules/*"
  exit 1
fi

echo "APP_DIR = $APP_DIR"

echo "=== 2) Install + build (in real app dir) ==="
cd "$APP_DIR"
pwd
ls -lah package.json

rm -rf node_modules package-lock.json .next out || true
npm cache clean --force || true
npm install --legacy-peer-deps
npm run build

# require out/ for static deploy
if [ ! -d out ]; then
  echo "ERROR: out/ missing. Your build does not export static output."
  echo "If this is Next static, you need 'next export' or output: export in next.config.js."
  exit 1
fi

echo "=== 3) Deploy ==="
rsync -a --delete out/ "$DIST/"

echo "=== 4) Reload nginx ==="
nginx -t
systemctl reload nginx

echo "DONE ✅ -> refresh https://fireinners.online/wolverine/"
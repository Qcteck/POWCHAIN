bash <<'EOF'
set -e

echo "=== AIAQUILA FINAL RSS FIX (INLINE HTML) ==="

AIA_DIR="/var/www/fireinners.online/aiaquila"
WORKER_URL="https://aiaquila-proxy.workers.dev"

cd "$AIA_DIR"

echo "[1] Listing fichiers AIAQUILA"
ls -lah

HTML_FILE=$(ls *.html | head -n 1)

if [ -z "$HTML_FILE" ]; then
  echo "❌ Aucun fichier HTML trouvé"
  exit 1
fi

echo "[2] Fichier cible: $HTML_FILE"

echo "[3] Sauvegarde"
cp "$HTML_FILE" "$HTML_FILE.bak.$(date +%s)"

echo "[4] Patch fetch → Worker Cloudflare"
sed -i \
  "s|fetch([^)]*)|fetch('$WORKER_URL/?url=' + encodeURIComponent(url))|g" \
  "$HTML_FILE"

echo "[5] Sécurisation JSON.parse"
sed -i \
  "s/response.json()/response.text().then(t=>JSON.parse(t))/g" \
  "$HTML_FILE"

echo "[6] Permissions"
chown www-data:www-data "$HTML_FILE"
chmod 644 "$HTML_FILE"

echo "[7] Reload nginx"
nginx -t && systemctl reload nginx

echo
echo "=== TEST WORKER DIRECT ==="
curl -s "$WORKER_URL/?url=https://news.bitcoin.com/feed/" | head -n 10

echo
echo "=== AIAQUILA INLINE FIX DONE ==="
echo "Recharge la page AIAQUILA (CTRL+F5)"
EOF
#!/usr/bin/env bash
set -euo pipefail

### CONFIG CANONIQUE
HTML="/var/www/wolverine/index.html"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
RPC_CANON="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/WOLVERINE_FIX_ROOT_RPC_${TS}.log"

echo "=== WOLVERINE FIX ROOT + RPC (FINAL) ===" | tee -a "$LOG"

### 0) PRÉCHECK ROOT
if [ "$EUID" -ne 0 ]; then
  echo "ERREUR: lancer en root" | tee -a "$LOG"
  exit 1
fi

### 1) BACKUPS
cp -a "$HTML" "${HTML}.bak_${TS}"
cp -a "$VHOST" "${VHOST}.bak_${TS}"
echo "[1/6] Backups OK" | tee -a "$LOG"

### 2) FORCER ROOT NGINX (UNE SEULE SOURCE)
sed -i -E 's|root[[:space:]]+[^;]+;|root /var/www/wolverine;|g' "$VHOST"
grep -n "root /var/www/wolverine;" "$VHOST" | tee -a "$LOG" || {
  echo "ERREUR root nginx non forcé" | tee -a "$LOG"
  exit 1
}
echo "[2/6] Root nginx forcé" | tee -a "$LOG"

### 3) FORCER RPC SOLANA (REMPLACE TOUT AUTRE RPC)
sed -i -E "s|https://[^\"']*solana[^\"']*|${RPC_CANON}|g" "$HTML"

grep -n "$RPC_CANON" "$HTML" | tee -a "$LOG" || {
  echo "ERREUR RPC non injecté" | tee -a "$LOG"
  exit 1
}
echo "[3/6] RPC canonique forcé" | tee -a "$LOG"

### 4) PURGE CACHE SERVEUR
rm -rf /var/cache/nginx/* || true
echo "[4/6] Cache nginx purgé" | tee -a "$LOG"

### 5) TEST + RELOAD NGINX
nginx -t | tee -a "$LOG"
systemctl reload nginx
echo "[5/6] Nginx reload OK" | tee -a "$LOG"

### 6) TEST HTTP RÉEL (FICHIER SERVI)
HTTP_CODE=$(curl -k -s -o /dev/null -w "%{http_code}" https://fireinners.online/wolverine/)
if [ "$HTTP_CODE" != "200" ]; then
  echo "ERREUR HTTP $HTTP_CODE → ROLLBACK" | tee -a "$LOG"
  cp -a "${HTML}.bak_${TS}" "$HTML"
  cp -a "${VHOST}.bak_${TS}" "$VHOST"
  systemctl reload nginx
  exit 1
fi

echo "[6/6] HTTP 200 OK — fichier réellement servi" | tee -a "$LOG"

echo "=== FIX TERMINÉ ===" | tee -a "$LOG"
echo "ACTION CÔTÉ NAVIGATEUR : CTRL + SHIFT + R (OBLIGATOIRE)" | tee -a "$LOG"
echo "LOG: $LOG"



bash WOLVERINE_FIX_ROOT_RPC_FINAL.sh

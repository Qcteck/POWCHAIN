bash <<'BASH'
set -euo pipefail

HTML="/var/www/wolverine/index.html"
test -f "$HTML" || { echo "index.html introuvable"; exit 1; }
cp -a "$HTML" "$HTML.bak_$(date +%s)"

# 1) Injecte solana-web3 proprement si absent
grep -q "solanaWeb3" "$HTML" || sed -i 's#</head>#<script src="https://unpkg.com/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script></head>#' "$HTML"

# 2) Injecte un hook SOL HARD-FIX à la fin du body (override total)
perl -0777 -i -pe '
s#</body>#<script>
(function(){
const rpc="https://api.mainnet-beta.solana.com";
async function forceSOL(){
 if(!window.solana||!solana.isPhantom)return;
 const r=await solana.connect({onlyIfTrusted:false});
 const pub=r.publicKey.toString();
 const addrEl=document.querySelector("[id*=addr],.address,span");
 if(addrEl) addrEl.textContent=pub;
 const conn=new solanaWeb3.Connection(rpc,"confirmed");
 const lamports=await conn.getBalance(new solanaWeb3.PublicKey(pub));
 const sol=(lamports/1e9).toFixed(6);
 const solEl=document.querySelector("[id*=sol]");
 if(solEl) solEl.textContent=sol;
}
document.querySelectorAll("button").forEach(b=>{
 if(b.innerText.includes("Phantom")){
  b.onclick=forceSOL;
 }
});
})();
</script></body>#s
' "$HTML"

nginx -t && systemctl reload nginx
echo "=== FIX SOL APPLIQUÉ ==="
echo "Recharge avec CTRL + SHIFT + R"
BASH
cat > /root/batch_wolverine_fix.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%F_%H%M%S)"
LOG="/root/wolverine_batch_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

echo "=== Wolverine / NGINX batch (${TS}) ==="

echo
echo "== 1) Services & ports =="
systemctl --no-pager status nginx || true
systemctl --no-pager status firewalld || true
ss -lntp | egrep ':(80|443)\s' || true

echo
echo "== 2) NGINX config test =="
nginx -t

echo
echo "== 3) Dump des blocs utiles (server_name /wolverine) =="
nginx -T 2>/dev/null | awk '
/^\s*server\s*\{/ {inserver=1; buf="server {\n"; next}
inserver==1 {buf=buf $0 "\n"}
inserver==1 && /^\s*\}\s*$/ {
  inserver=0
  if (buf ~ /server_name/ && (buf ~ /fireinners\.online/ || buf ~ /www\.fireinners\.online/)) {
    print "----- MATCHED SERVER -----"
    print buf
  }
}
' || true

echo
echo "== 4) Recherche doublons location /wolverine =="
nginx -T 2>/dev/null | awk '
/server_name/ {sn=$0}
/location\s+\/wolverine(\s|\/|\{)/ {print "HIT:", sn, " => ", $0}
' || true

echo
echo "== 5) Recherche règles try_files/rewrite vers /index.html =="
nginx -T 2>/dev/null | egrep -n 'try_files|rewrite|index\.html' | head -n 200 || true

echo
echo "== 6) Backup configs nginx =="
mkdir -p /root/nginx_backups_full_${TS}
tar -czf /root/nginx_backups_full_${TS}/nginx_etc_${TS}.tgz /etc/nginx
echo "Backup: /root/nginx_backups_full_${TS}/nginx_etc_${TS}.tgz"

echo
echo "== 7) Vérif accès local HTTP/HTTPS (si nginx écoute) =="
curl -sS -I http://127.0.0.1/ || true
curl -sS -I http://127.0.0.1/wolverine/ || true
curl -k -sS -I https://127.0.0.1/ || true
curl -k -sS -I https://127.0.0.1/wolverine/ || true

echo
echo "== 8) Restart nginx =="
systemctl restart nginx
sleep 1
systemctl --no-pager status nginx || true
ss -lntp | egrep ':(80|443)\s' || true

echo
echo "== 9) Logs erreurs nginx (dernieres 120 lignes) =="
tail -n 120 /var/log/nginx/error.log || true

echo
echo "== 10) Firewall rapide =="
# (Ubuntu/Debian) UFW si présent
command -v ufw >/dev/null 2>&1 && ufw status verbose || true
# (RHEL) firewalld si présent
command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --list-all || true

echo
echo "=== FIN. Log: $LOG ==="
echo "Si tu colles ici: (1) le bloc server{} fireinners.online + (2) la location /wolverine, je te donne la conf exacte corrigée."
BASH

chmod +x /root/batch_wolverine_fix.sh
echo "Script prêt: /root/batch_wolverine_fix.sh"
#!/usr/bin/env node
"use strict";
const https = require("https");

function jget(url){
  return new Promise((res,rej)=>{
    https.get(url,r=>{
      let d="";
      r.on("data",c=>d+=c);
      r.on("end",()=>{
        if(r.statusCode>=200 && r.statusCode<300){
          try { res(JSON.parse(d)); }
          catch(e){ rej(e); }
        } else {
          rej(new Error("HTTP "+r.statusCode));
        }
      });
    }).on("error",rej);
  });
}

function score(p){
  const liq = p.liquidity?.usd || 0;
  const vol = p.volume?.h24 || 0;
  const tx  = (p.txns?.h24?.buys||0)+(p.txns?.h24?.sells||0);
  return Math.log10(1+liq)*3 + Math.log10(1+vol)*2 + Math.log10(1+tx);
}

(async()=>{
  const TOP = Number(process.argv[2] || 40);

  const profiles = await jget(
    "https://api.dexscreener.com/token-profiles/latest/v1"
  );

  const sol = profiles
    .filter(p=>p.chainId==="solana" && p.dexId==="raydium")
    .map(p=>({
      mint: p.tokenAddress,
      symbol: p.symbol,
      pair: p.pairAddress,
      score: score(p)
    }))
    .sort((a,b)=>b.score-a.score)
    .slice(0,TOP);

  console.log(JSON.stringify(sol,null,0));
})();
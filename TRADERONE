set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP_TEST="/etc/nginx/snippets/fireinners_test.conf"
WEB_DIR="/var/www/fireinners-test"

# 0) Backup
cp -a /etc/nginx "/etc/nginx.bak.$TS"

echo "=== 1) Désactiver les .bak* ACTIFS dans sites-enabled ==="
mkdir -p /etc/nginx/sites-disabled
shopt -s nullglob
for f in /etc/nginx/sites-enabled/*.bak*; do
  echo "Disable: $f"
  mv "$f" /etc/nginx/sites-disabled/
done

echo "=== 2) Trouver le dernier dossier PNG ==="
PNG_DIR="$(ls -d /root/bak_renders_machine_*/png 2>/dev/null | tail -n 1 || true)"
[ -n "${PNG_DIR:-}" ] || { echo "❌ Aucun dossier PNG trouvé: /root/bak_renders_machine_*/png"; exit 1; }
echo "PNG_DIR=$PNG_DIR"

echo "=== 3) Copier PNG + générer galerie ==="
mkdir -p "$WEB_DIR"
rm -f "$WEB_DIR"/*.png 2>/dev/null || true
cp -a "$PNG_DIR"/*.png "$WEB_DIR"/

python3 - <<'PY'
import glob, html, os
d="/var/www/fireinners-test"
imgs=sorted(glob.glob(os.path.join(d,"*.png")))
with open(os.path.join(d,"index.html"),"w",encoding="utf-8") as f:
    f.write("<!doctype html><meta charset=utf-8><title>fireinners /test</title>")
    f.write("<style>body{font-family:system-ui;background:#0b0f14;color:#e8eef6;margin:20px}"
            ".g{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}"
            ".c{background:#121826;border:1px solid #223049;border-radius:12px;padding:10px}"
            "img{width:100%;border-radius:10px} a{color:#7dd3fc}</style>")
    f.write(f"<h2>/test — renders ({len(imgs)})</h2><div class=g>")
    for p in imgs:
        n=html.escape(os.path.basename(p))
        f.write(f'<div class=c><a href="{n}"><img loading="lazy" src="{n}"></a>'
                f'<div style="margin-top:6px;font-size:12px;opacity:.8">{n}</div></div>')
    f.write("</div>")
print("✅ index.html créé (", len(imgs), "images )")
PY

chown -R www-data:www-data "$WEB_DIR" || true
chmod -R a+rX "$WEB_DIR"

echo "=== 4) Créer snippet /test/ ==="
cat > "$SNIP_TEST" <<'NGX'
location ^~ /test/ {
  alias /var/www/fireinners-test/;
  index index.html;
  try_files $uri $uri/ =404;
  add_header Cache-Control "no-store" always;
}
NGX

echo "=== 5) Inclure /test dans le vhost (une seule fois) ==="
[ -f "$VHOST" ] || { echo "❌ VHOST introuvable: $VHOST"; exit 1; }
grep -q "include /etc/nginx/snippets/fireinners_test.conf;" "$VHOST" || \
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/fireinners_test.conf;/' "$VHOST"

echo "=== 6) Test + reload ==="
nginx -t
systemctl reload nginx

echo "✅ OK: https://fireinners.online/test/  (deploy $TS)"
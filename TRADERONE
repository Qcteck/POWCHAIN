bash -lc 'cat >/root/wv_fix.sh<<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
VHOST_AV="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
WEBROOT="/var/www/wolverine"
VAULT_PORT="8787"
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/WV_FIX_${TS}"

say(){ echo "[$(date +%H:%M:%S)] $*"; }
need_root(){ [ "$(id -u)" = "0" ] || { echo "ROOT only"; exit 1; }; }

unfreeze_tree(){
  local p="$1"
  [ -e "$p" ] || return 0
  command -v chattr >/dev/null 2>&1 || return 0
  say "chattr -i (best-effort) on $p"
  find "$p" -xdev -print0 2>/dev/null | xargs -0 -r chattr -i 2>/dev/null || true
}

backup_all(){
  say "Backup => $BK"
  mkdir -p "$BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  mkdir -p "$BK/www"
  cp -a "$WEBROOT" "$BK/www/wolverine" 2>/dev/null || true
  say "Backups ready."
}

disable_duplicate_vhosts(){
  say "Disable duplicate vhosts for $DOMAIN (keep fireinners.online + fireinners.online-ssl)"
  shopt -s nullglob
  for f in /etc/nginx/sites-enabled/*; do
    [ -f "$f" ] || continue
    if grep -qE "server_name[[:space:]].*\\b${DOMAIN//./\\.}\\b" "$f"; then
      b="$(basename "$f")"
      if [ "$b" != "fireinners.online" ] && [ "$b" != "fireinners.online-ssl" ]; then
        say "Disable: $f"
        mv -f "$f" "$f.WV_DISABLED_${TS}" || true
      fi
    fi
  done
}

disable_other_wolverine_definitions(){
  say "Disable other /wolverine location definitions (includes/snippets), keep canonical only"
  shopt -s nullglob
  for f in /etc/nginx/includes/* /etc/nginx/snippets/*; do
    [ -f "$f" ] || continue
    [ "$f" = "$INC" ] && continue
    if grep -qE "location[[:space:]]+\\^~[[:space:]]+/wolverine/|location[[:space:]]+=[[:space:]]+/wolverine\\b|location[[:space:]]+\\^~[[:space:]]+/wolverine/vault-api/" "$f"; then
      say "Disable: $f"
      mv -f "$f" "$f.WV_DISABLED_${TS}" || true
    fi
  done
}

ensure_webroot(){
  mkdir -p "$WEBROOT"
  if [ ! -f "$WEBROOT/index.html" ]; then
    say "Missing $WEBROOT/index.html => creating minimal placeholder"
    cat >"$WEBROOT/index.html"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WOLVERINE</title></head><body style="font-family:system-ui;padding:24px"><h1>WOLVERINE</h1><p>index.html placeholder (restore your real export in /var/www/wolverine)</p></body></html>
EOF
  fi
}

write_canonical_include(){
  say "Write canonical include => $INC"
  mkdir -p "$(dirname "$INC")"
  cat >"$INC"<<EOF
# WV_CANONICAL_WOLVERINE_ROUTES_v1 ${TS}

# Static UI (Next export / plain static)
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  alias ${WEBROOT}/;
  index index.html;
  try_files \$uri \$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}

# Vault API (local service)
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:${VAULT_PORT}/;
}

# Legacy compat path (if your frontend calls it)
location ^~ /wolverine/traderone/vault/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:${VAULT_PORT}/;
}
EOF
}

strip_wolverine_lines_from_vhost(){
  say "Remove old wolverine include lines from vhost (best-effort)"
  # remove include lines referencing wolverine
  sed -i -E "/include[[:space:]]+[^;]*wolverine[^;]*;/d" "$VHOST_AV" || true

  # remove any inline location blocks that target /wolverine (python brace-match)
  python3 - <<PY
import re,sys
p="${VHOST_AV}"
s=open(p,"r",encoding="utf-8",errors="ignore").read()
def remove_location_blocks(src):
    out=[]
    i=0
    n=len(src)
    pat=re.compile(r'\\blocation\\b[^\\n]*?\\s+(\\^~\\s+)?(/wolverine(?:/[^\\s{]*)?|=\\s*/wolverine\\b)[^\\n]*\\{',re.I)
    while True:
        m=pat.search(src,i)
        if not m:
            out.append(src[i:])
            break
        start=m.start()
        out.append(src[i:start])
        j=m.end()-1
        depth=0
        k=j
        while k<n:
            if src[k]=='{': depth+=1
            elif src[k]=='}':
                depth-=1
                if depth==0:
                    k+=1
                    break
            k+=1
        i=k
    return "".join(out)
ns=remove_location_blocks(s)
open(p,"w",encoding="utf-8").write(ns)
PY
}

inject_include_into_443_server(){
  say "Inject include into 443 server block for ${DOMAIN}"
  grep -qF "$INC" "$VHOST_AV" && { say "Already injected."; return 0; }

  awk -v dom="$DOMAIN" -v inc="$INC" '
  function has(s, r){ return (index(s,r)>0) }
  BEGIN{in_srv=0;depth=0;is443=0;isTarget=0;done=0;}
  {
    line=$0
    # detect server block open
    if ($0 ~ /^[[:space:]]*server[[:space:]]*\{[[:space:]]*$/) { in_srv=1; depth=1; is443=0; isTarget=0; }
    else if (in_srv){
      # update depth by counting braces
      # (rough but works for nginx conf)
      n1=gsub(/\{/,"{",line); n2=gsub(/\}/,"}",line);
      depth += (n1 - n2);
      if (line ~ /listen[[:space:]]+443/){ is443=1 }
      if (line ~ /server_name/ && line ~ dom){ isTarget=1 }
    }

    print $0

    if (in_srv && !done && is443 && isTarget && line ~ /server_name/ && line ~ dom){
      print "    include " inc ";"
      done=1
    }

    if (in_srv && depth<=0){ in_srv=0; depth=0; is443=0; isTarget=0 }
  }' "$VHOST_AV" >"$VHOST_AV.tmp" && mv -f "$VHOST_AV.tmp" "$VHOST_AV"
}

nginx_reload(){
  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx
}

tests(){
  say "Verify vault listens on 127.0.0.1:${VAULT_PORT}"
  ss -lntp | grep -q ":${VAULT_PORT} " && say "OK: vault port is listening" || say "WARN: vault port not found (but direct curl might still work)"

  say "TEST 1: HTTPS /wolverine/ via SNI->127.0.0.1 (HEAD)"
  curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true

  say "TEST 2: HTTPS /wolverine/ first bytes"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | head -c 200 || true
  echo

  say "TEST 3: HTTPS /wolverine/vault-api/health MUST be JSON"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/vault-api/health" || true
  echo

  say "TEST 4: HTTPS legacy /wolverine/traderone/vault/health (compat)"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/traderone/vault/health" || true
  echo
}

main(){
  need_root
  backup_all
  unfreeze_tree "/etc/nginx"
  ensure_webroot
  disable_duplicate_vhosts
  disable_other_wolverine_definitions
  write_canonical_include
  strip_wolverine_lines_from_vhost
  inject_include_into_443_server
  nginx_reload
  tests
  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/  (Ctrl+F5)"
}

main "$@"
BASH
sed -i "s/\r$//" /root/wv_fix.sh
chmod +x /root/wv_fix.sh
bash /root/wv_fix.sh'
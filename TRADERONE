cat >/root/WOLV_FIX_API_PORT_AFTER_RESTART.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== STATUS: wolverine-api.service ==="
systemctl status wolverine-api.service --no-pager || true
echo

echo "=== LAST LOGS (wolverine-api) ==="
journalctl -u wolverine-api.service -n 120 --no-pager || true
echo

echo "=== LISTEN ports (node) ==="
ss -lptn 2>/dev/null | grep -E 'LISTEN' | grep -E 'users:\(\("node"|users:\(\("pm2"|node' || true
echo

echo "=== Auto-detect API port responding to /api ==="
API_PORT=""
PORTS="$(ss -lptn 2>/dev/null | awk '/LISTEN/ && $0~"users:\\(\\(\\"node\\""{print $4}' | sed -E 's/.*:([0-9]+)$/\1/' | sort -nu || true)"
PORTS="$PORTS 3002 3000 8080 8000 5000 4000 3001 3003"

for p in $PORTS; do
  if curl -sS --max-time 1 "http://127.0.0.1:$p/api" >/dev/null 2>&1; then
    API_PORT="$p"; break
  fi
done

echo "API_PORT=${API_PORT:-NOT_FOUND}"
if [ -n "${API_PORT:-}" ]; then
  echo
  echo "=== TEST /api/swap/quote on :$API_PORT ==="
  curl -sS "http://127.0.0.1:$API_PORT/api/swap/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50" | head -c 200 || true
  echo
fi

echo
echo "DONE"
BASH

bash /root/WOLV_FIX_API_PORT_AFTER_RESTART.sh
bash <<'MEGA'
set -e

### PATHS
BOT="/opt/traderone"
STATE="$BOT/state.json"
LOG="$BOT/trades.log"

echo "=== TRADERONE AUTO-TRADE ENGINE ==="

### 1) STATE INIT
cat > "$STATE" <<'JSON'
{
  "armed": false,
  "running": false,
  "budget": 0,
  "entry": 0,
  "token": null,
  "pnl": 0,
  "last": "idle"
}
JSON

touch "$LOG"

### 2) ENGINE (LOGIC)
cat > "$BOT/engine.js" <<'JS'
const fs=require("fs");
const state=()=>JSON.parse(fs.readFileSync("state.json"));
const save=s=>fs.writeFileSync("state.json",JSON.stringify(s,null,2));
const log=m=>fs.appendFileSync("trades.log",new Date().toISOString()+" "+m+"\n");

module.exports={
 arm(){const s=state();s.armed=true;save(s);log("ARMED");},
 disarm(){const s=state();s.armed=false;save(s);log("DISARMED");},
 start(budget){
  const s=state();
  if(!s.armed)throw"NOT_ARMED";
  s.running=true;s.budget=budget;s.last="started";
  save(s);log("START "+budget);
 },
 stop(){
  const s=state();
  s.running=false;s.budget=0;s.last="stopped";
  save(s);log("STOP");
 },
 status(){return state();}
};
JS

### 3) SERVER PATCH
cat > "$BOT/server.js" <<'JS'
const http=require("http");
const engine=require("./engine");
const fs=require("fs");

const json=(res,o)=>{res.setHeader("content-type","application/json");res.end(JSON.stringify(o));};

http.createServer(async(req,res)=>{
 try{
  if(req.url==="/api/status") return json(res,engine.status());
  if(req.url==="/api/arm"){engine.arm();return json(res,{ok:true});}
  if(req.url==="/api/disarm"){engine.disarm();return json(res,{ok:true});}
  if(req.url==="/api/start"&&req.method==="POST"){
   let b="";req.on("data",d=>b+=d);req.on("end",()=>{
    const {amount}=JSON.parse(b);
    engine.start(amount);
    json(res,{ok:true});
   });return;
  }
  if(req.url==="/api/stop"){engine.stop();return json(res,{ok:true});}
 }catch(e){json(res,{err:e.toString()});}
 res.statusCode=404;res.end();
}).listen(3000);
JS

pm2 restart traderone
pm2 save

echo "=== AUTO-TRADE ENGINE READY ==="
MEGA
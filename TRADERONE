bash <<'WOLVERINE_FULL_RESTORE'
set -e

# PATHS
FRONT="/var/www/wolverine"
INDEX="$FRONT/index.html"
NGINX="/etc/nginx/sites-available/fireinners.online-ssl"
ENABLED="/etc/nginx/sites-enabled/fireinners.online-ssl"

# FRONTEND
mkdir -p "$FRONT"
cat > "$INDEX" <<'HTML'
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><title>Wolverine — TraderOne</title><meta name="viewport" content="width=device-width,initial-scale=1"/><style>
body{margin:0;font-family:system-ui;background:#0b1220;color:#dbe7ff}
.app{display:grid;grid-template-columns:220px 1fr 320px;height:100vh}
.sidebar{background:#0f1a33;padding:14px}
.sidebar h2{margin:0 0 12px}
.sidebar a{display:block;color:#bcd;text-decoration:none;margin:6px 0}
.main{padding:14px}
.card{background:linear-gradient(135deg,#132a4a,#0c1830);border-radius:14px;padding:14px;margin-bottom:14px}
.right{background:#0f1a33;padding:14px}
.btn{padding:8px 14px;border-radius:8px;border:none;cursor:pointer}
.buy{background:#1bbf89}
.sell{background:#e05666}
table{width:100%;border-collapse:collapse}
th,td{padding:6px;text-align:left}
</style></head>
<body>
<div class="app">
<div class="sidebar">
<h2>Wolverine</h2>
<a>Dashboard</a><a>Trade</a><a>Positions</a><a>Orders</a><a>History</a><a>Wallet</a><a>Settings</a><a>Health</a>
<div class="card">Wallet<br>Not connected<br><button class="btn">Connect Phantom</button><br>API: /wolverine/traderone/api</div>
</div>
<div class="main">
<div class="card"><h2>Wolverine — Dashboard</h2>TraderOne overview</div>
<div class="card">
<h3>Open Orders</h3>
<table>
<tr><th>Pair</th><th>Type</th><th>Price</th><th>Amount</th><th>Total</th></tr>
<tr><td>SOL/USDC</td><td style="color:#1bbf89">BUY</td><td>10.55</td><td>0.0042</td><td>0.044</td></tr>
<tr><td>SOL/USDC</td><td style="color:#e05666">SELL</td><td>10.74</td><td>0.0020</td><td>0.021</td></tr>
</table>
</div>
</div>
<div class="right">
<div class="card">
<h3>Quick Trade</h3>
Symbol<input value="SOL/USDC"/><br>Price<input/><br>Size<input/><br><br>
<button class="btn buy">Buy</button>
<button class="btn sell">Sell</button>
</div>
<div class="card">
<h3>TraderOne Control</h3>
<button class="btn">START</button>
<button class="btn">PAUSE</button>
<button class="btn sell">STOP</button><br><br>
UI:/wolverine/<br>API:/wolverine/traderone/api
</div>
</div>
</div>
</body></html>
HTML

chown -R www-data:www-data "$FRONT"
chmod 755 "$FRONT"
chmod 644 "$INDEX"

# NGINX
if ! grep -q "location /wolverine/" "$NGINX"; then
cat >> "$NGINX" <<'NG'
location /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}
location /wolverine/traderone/ {
  proxy_pass http://127.0.0.1:3000/;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_set_header Host $host;
}
NG
fi

ln -sf "$NGINX" "$ENABLED"
nginx -t
systemctl reload nginx

# TEST
curl -s -o /dev/null -w "%{http_code}\n" https://fireinners.online/wolverine/
WOLVERINE_FULL_RESTORE
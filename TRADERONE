cat >/root/remove_blueprint_video.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DIR="/var/www/wolverine/blueprint"
FILE="${DIR}/blueprint_robo600.mp4"
ARCH="/var/www/wolverine/_archive_blueprint"
TS="$(date -u +%Y%m%d_%H%M%S)"

echo "=== 1) Check file ==="
ls -lah "$DIR" || true
if [ ! -f "$FILE" ]; then
  echo "❌ Not found: $FILE"
  exit 0
fi
ls -lah "$FILE"
echo

echo "=== 2) Archive (move) ==="
mkdir -p "$ARCH"
mv "$FILE" "${ARCH}/blueprint_robo600_${TS}.mp4"
echo "Moved to: ${ARCH}/blueprint_robo600_${TS}.mp4"
echo

echo "=== 3) Verify ==="
ls -lah "$DIR" | head -n 50
echo

echo "=== 4) Optional: test URL (origin) ==="
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/blueprint/blueprint_robo600.mp4 | head -n 12 || true

echo "DONE ✅"
BASH

chmod +x /root/remove_blueprint_video.sh
/root/remove_blueprint_video.sh
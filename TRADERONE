cat >/root/FIX_TRADERONE_VAULT_API.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APP="traderone-vault"
FILE="/opt/traderone-vault/server.js"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX TRADERONE VAULT API ==="

# 1) Vérifications
[ -f "$FILE" ] || { echo "❌ $FILE introuvable"; exit 1; }

echo "✔ Fichier cible : $FILE"

# 2) Backup
cp -a "$FILE" "${FILE}.bak_$TS"
echo "✔ Backup créé : ${FILE}.bak_$TS"

# 3) Injection routes si absentes
python3 - <<'PY'
from pathlib import Path
p=Path("/opt/traderone-vault/server.js")
s=p.read_text()

marker="/* === AUTO ROUTES TRADERONE VAULT === */"
if marker in s:
    print("✓ Routes déjà présentes (skip)")
else:
    inject=f'''
{marker}
const fs=require("fs");
const {{Connection,Keypair,PublicKey,SystemProgram,Transaction,sendAndConfirmTransaction}}=require("@solana/web3.js");

const RPC=process.env.SOLANA_RPC||"https://api.mainnet-beta.solana.com";
const connection=new Connection(RPC,"confirmed");

app.get("/wolverine/traderone/api/health",(req,res)=>res.json({{ok:true,ts:Date.now()}}));

app.post("/wolverine/traderone/api/budget",async(req,res)=>{{
  try{{
    const {{pubkey,budgetSol}}=req.body||{{}};
    if(!pubkey||!budgetSol) throw "payload invalide";
    const lamports=Math.floor(Number(budgetSol)*1e9);
    if(lamports<=0) throw "montant invalide";
    return res.json({{ok:true,received:lamports}});
  }}catch(e){{
    res.status(400).json({{ok:false,error:String(e)}});
  }}
});
/* === END AUTO ROUTES === */
'''
    idx=s.find("app.listen")
    if idx!=-1:
        s=s[:idx]+inject+"\n"+s[idx:]
    else:
        s+=inject
    p.write_text(s)
    print("✔ Routes injectées")
PY

# 4) Reload PM2
echo "== Reload PM2 =="
pm2 restart "$APP" --update-env
pm2 save

sleep 2

# 5) Tests locaux
echo "== TEST LOCAL =="
curl -s http://127.0.0.1:3000/wolverine/traderone/api/health || true
echo
curl -s -X POST http://127.0.0.1:3000/wolverine/traderone/api/budget \
  -H "Content-Type: application/json" \
  -d '{"pubkey":"TEST","budgetSol":0.001}' || true
echo

# 6) Test HTTPS
echo "== TEST HTTPS =="
curl -s https://fireinners.online/wolverine/traderone/api/health || true
echo

echo "=== FIN FIX TRADERONE VAULT API ==="
BASH

chmod +x /root/FIX_TRADERONE_VAULT_API.sh
/root/FIX_TRADERONE_VAULT_API.sh
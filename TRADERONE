sudo -i
tmux new -s wolvfix



set -euo pipefail
TS="$(date +%s)"

echo "== 1) Show exact nginx error (file:line) =="
nginx -t 2>&1 | tail -n 30 || true

echo
echo "== 2) Backup + REMOVE bad RPC location blocks (wrong context) =="
mapfile -t FILES < <(grep -RIl --include='*.conf' -E 'location\s*=\s*/wolverine/traderone/api/rpc' /etc/nginx || true)

if [ "${#FILES[@]}" -eq 0 ]; then
  echo "No matching 'location = /wolverine/traderone/api/rpc' found under /etc/nginx"
else
  printf "Found in:\n"; printf " - %s\n" "${FILES[@]}"
  for f in "${FILES[@]}"; do
    cp -a "$f" "$f.bak.$TS"
    perl -0777 -i -pe 's/location\s*=\s*\/wolverine\/traderone\/api\/rpc\s*\{[\s\S]*?\}\s*//g' "$f"
    echo "Cleaned: $f (backup: $f.bak.$TS)"
  done
fi

echo
echo "== 3) Validate nginx config now =="
nginx -t

echo
echo "== 4) Reload nginx =="
systemctl reload nginx

echo "OK ✅ nginx is valid again"
set -euo pipefail

echo "=== 1) Erreur complète nginx -t (fichier + ligne) ==="
nginx -t 2>&1 | tail -n 60

echo
echo "=== 2) Les 2 occurrences dans la config chargée (nginx -T) ==="
nginx -T 2>/dev/null | grep -nE 'location\s+(\^~|~\*?|=)?\s*/wolverine/traderone/api/?' | head -n 50

echo
echo "=== 3) Contexte autour de chaque occurrence (preuve) ==="
for ln in $(nginx -T 2>/dev/null | grep -nE 'location\s+(\^~|~\*?|=)?\s*/wolverine/traderone/api/?' | cut -d: -f1 | head -n 10); do
  echo "----- CONTEXT around nginx -T line $ln -----"
  start=$((ln-35)); [ $start -lt 1 ] && start=1
  end=$((ln+35))
  nginx -T 2>/dev/null | sed -n "${start},${end}p"
done
cat >/root/fix_tryfiles_and_api_proxy_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP_API="/etc/nginx/snippets/traderone_api_proxy.conf"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== 0) Backup =="
cp -a "$AV" "${AV}.bak_${ts}"

echo "== 1) Fix the broken try_files line(s) in SSL vhost =="
# Replace any broken variants like: try_files \ =404;  or try_files  =404;
sed -i 's@try_files \\ =404;@try_files $uri =404;@g' "$AV"
sed -i 's@try_files  =404;@try_files $uri =404;@g' "$AV"

# Ensure we have a proper phantom_patch location block (and only one)
perl -0777 -i -pe 's@\n\s*location\s*=\s*/wolverine/phantom_patch\.js\s*\{.*?\}\s*\n@\n@sg' "$AV"
perl -0777 -i -pe 's@\n\}\s*$@\n  location = /wolverine/phantom_patch.js {\n    add_header Cache-Control "no-store" always;\n    try_files \\$uri =404;\n  }\n}\n@sg' "$AV"

ln -sf "$AV" "$EN"

echo "== 2) nginx test (must be successful) =="
nginx -t

echo "== 3) Autodetect backend port for /api/health =="
PORT=""
# From your ss output, these are the likely Node ports:
for p in 3005 8484 8585 9696 12703 3000 3001 3100 8080 8000 5000; do
  code="$(curl -s -o /tmp/h.$$ -w "%{http_code}" "http://127.0.0.1:$p/api/health" || true)"
  if [[ "$code" == "200" ]]; then
    body="$(head -c 120 /tmp/h.$$ | tr -d '\n')"
    # accept JSON-ish (not HTML)
    if echo "$body" | grep -qv "<!DOCTYPE html"; then
      PORT="$p"
      break
    fi
  fi
done
rm -f /tmp/h.$$ 2>/dev/null || true

if [[ -z "$PORT" ]]; then
  echo
  echo "[WARN] Could not find a backend answering /api/health on localhost."
  echo "Run and paste:"
  echo "  ss -lntp | grep -E 'node|:3005|:8484|:8585|:9696|:12703'"
  echo "  curl -sS http://127.0.0.1:3005/api/health ; echo"
  echo "  curl -sS http://127.0.0.1:8484/api/health ; echo"
  echo
  echo "Reloading nginx anyway (try_files fix is done)."
  systemctl reload nginx
  exit 0
fi

echo "[OK] Backend seems to be on 127.0.0.1:${PORT}"

echo "== 4) Write API proxy snippet (HIGH priority, beats SPA) =="
mkdir -p /etc/nginx/snippets
cat >"$SNIP_API" <<NGINX
# Include INSIDE server{} only.

location = /wolverine/traderone/api/health {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:${PORT};
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;

  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";

  rewrite ^/wolverine/traderone/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:${PORT};
}
NGINX

echo "== 5) Ensure snippet include exists ONCE in SSL vhost =="
awk '
  {
    if ($0 ~ /include[[:space:]]+\/etc\/nginx\/snippets\/traderone_api_proxy\.conf;/) {
      if (seen==1) next;
      seen=1;
    }
    print
  }
' "$AV" > /tmp/ssl.$$ && cat /tmp/ssl.$$ > "$AV" && rm -f /tmp/ssl.$$

if ! grep -q "traderone_api_proxy.conf" "$AV"; then
  sed -i '/server_name .*fireinners\.online/ a\  include /etc/nginx/snippets/traderone_api_proxy.conf;' "$AV"
fi

echo "== 6) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== 7) Tests =="
echo "-- LOCAL backend:"
curl -sS "http://127.0.0.1:${PORT}/api/health" | head -c 300; echo
echo "-- PUBLIC (must NOT be HTML):"
curl -sk -i "https://${DOMAIN}/wolverine/traderone/api/health" | sed -n '1,25p'
echo "-- PUBLIC body (first 120 bytes):"
curl -sk "https://${DOMAIN}/wolverine/traderone/api/health" | head -c 120; echo

echo
echo "DONE ✅  Open: https://${DOMAIN}/wolverine/health/?v=$ts"
BASH

chmod +x /root/fix_tryfiles_and_api_proxy_FINAL.sh
/root/fix_tryfiles_and_api_proxy_FINAL.sh
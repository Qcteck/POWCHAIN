cat >/root/MEGA_EINSHSTEIN_PAIR_SCAN_ROOT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

say(){ echo "[$(date +%H:%M:%S)] $*"; }
die(){ say "ERROR: $*"; exit 1; }

# === PATHS ===
APP="/opt/einshtein-solana"
DATA="/var/www/ndjson_data"
TOOLS="$APP/tools"
WATCH="$APP/watchlist.json"
CFG="$APP/config.json"
SVC="/etc/systemd/system/einshtein-solana.service"

REQ(){ command -v "$1" >/dev/null 2>&1 || die "Missing $1"; }
REQ node; REQ curl; REQ systemctl

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_EINSHSTEIN_PAIRSCAN_$TS"

say "== BACKUP =="
mkdir -p "$BK"
[ -d "$APP" ]  && cp -a "$APP" "$BK/app" || true
[ -d "$DATA" ] && cp -a "$DATA" "$BK/data" || true
[ -f "$SVC" ]  && cp -a "$SVC" "$BK/" || true

say "== DIRS =="
mkdir -p "$APP" "$TOOLS" "$DATA"
touch "$DATA/events.ndjson"
chmod 755 "$APP" "$TOOLS" "$DATA"
chmod 644 "$DATA/events.ndjson"

# === PAIR SCANNER ===
say "== WRITE pair scanner =="
cat >"$TOOLS/scan_pairs_direct.js" <<'JS'
#!/usr/bin/env node
"use strict";
const https=require("https");

function jget(u){
  return new Promise((res,rej)=>{
    https.get(u,r=>{
      let d="";r.on("data",c=>d+=c);
      r.on("end",()=>r.statusCode>=200&&r.statusCode<300
        ?res(JSON.parse(d)):rej(new Error("HTTP "+r.statusCode)));
    }).on("error",rej);
  });
}
function score(p){
  const l=p.liquidity?.usd||0,v=p.volume?.m5||0;
  const t=(p.txns?.m5?.buys||0)+(p.txns?.m5?.sells||0);
  return 3*Math.log10(1+l)+2*Math.log10(1+v)+Math.log10(1+t);
}
(async()=>{
  const TOP=Number(process.argv[2]||50);
  const js=await jget("https://api.dexscreener.com/latest/dex/pairs/solana");
  const out=(js.pairs||[])
    .filter(p=>p.priceUsd>0&&p.baseToken?.address&&p.liquidity?.usd>0)
    .map(p=>({
      pair:p.pairAddress,
      mint:p.baseToken.address,
      symbol:p.baseToken.symbol,
      score:score(p)
    }))
    .sort((a,b)=>b.score-a.score)
    .slice(0,TOP);
  console.log(JSON.stringify(out));
})();
JS
chmod +x "$TOOLS/scan_pairs_direct.js"

# === BUILD WATCHLIST FROM PAIRS ===
say "== BUILD watchlist (PAIR-FIRST) =="
node "$TOOLS/scan_pairs_direct.js" 40 \
 | jq '{source:"dexscreener_pairs_direct",pairs:.}' \
 > "$WATCH"

# === CONFIG (merge-safe) ===
say "== CONFIG =="
if [ ! -f "$CFG" ]; then
cat >"$CFG" <<'JSON'
{
  "mode":"PAIR_FIRST",
  "chain":"solana",
  "lm_usd":25000,
  "vol5m_usd":5000,
  "tx5m":10,
  "topn":25,
  "ndjson":"/var/www/ndjson_data/events.ndjson"
}
JSON
fi

# === SERVICE ===
say "== SYSTEMD =="
if [ ! -f "$SVC" ]; then
cat >"$SVC" <<'SERVICE'
[Unit]
Description=Einshtein Solana (PAIR-FIRST)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/einshtein-solana
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
SERVICE
fi

# === ARM / EXEC FLAGS (SAFE) ===
touch "$APP/ARM_ON"
# EXEC_ON seulement si TU le veux manuellement
# touch "$APP/EXEC_ON"

# === RELOAD ===
say "== RELOAD SERVICE =="
systemctl daemon-reexec
systemctl daemon-reload
systemctl enable einshtein-solana.service
systemctl restart einshtein-solana.service

# === QUICK CHECK ===
say "== CHECK NDJSON =="
sleep 2
tail -n 5 "$DATA/events.ndjson" || true

say "DONE ✔  (PAIR-FIRST ACTIVE)"
say "Backup: $BK"
BASH
node - <<'NODE'
const bip39=require('bip39');
const wl=bip39.wordlists.english;
const m=bip39.generateMnemonic(128, undefined, wl);
const ok=bip39.validateMnemonic(m, wl);
const ent=bip39.mnemonicToEntropy(m, wl);
const m2=bip39.entropyToMnemonic(ent, wl);
console.log("MNEMONIC:",m);
console.log("VALID:",ok);
console.log("ENTROPY:",ent);
console.log("ROUNDTRIP:",m2===m);
NODE
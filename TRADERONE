cat >/root/MEGA_NGINX_WOLVERINE_DUPFIX_RUN.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
SCRIPT="/root/MEGA_NGINX_WOLVERINE_DUPFIX_${TS}.sh"
NOH="/root/MEGA_NGINX_WOLVERINE_DUPFIX.nohup"
LOG="/root/MEGA_NGINX_WOLVERINE_DUPFIX_${TS}.log"

cat >"$SCRIPT" <<'INNER'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
OUT="/root/MEGA_NGINX_WOLVERINE_DUPFIX_${TS}.log"

HOST="fireinners.online"
FRONT_DIR="/var/www/wolverine"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"
NGINX_INC="/etc/nginx/includes/wolverine_routes.inc"

say(){ printf "\n== %s ==\n" "$*"; }
w(){ printf "%s\n" "$*" | tee -a "$OUT" >/dev/null; }
ok(){ w "OK: $*"; }
warn(){ w "WARN: $*"; }
die(){ w "ERREUR: $*"; exit 1; }
ensure_pkg(){ local p="$1"; dpkg -s "$p" >/dev/null 2>&1 || { apt-get update -y; apt-get install -y "$p"; }; }

unlock_if_immutable(){
  local f="$1" name="$2"
  local a; a="$(lsattr -d "$f" 2>/dev/null || true)"
  w "lsattr ${name}: $a"
  if echo "$a" | awk '{print $1}' | grep -q "i"; then
    chattr -i "$f" || true
    ok "chattr -i ${name}"
    return 0
  fi
  return 1
}
relock_if_needed(){
  local f="$1" name="$2" was="$3"
  if [[ "$was" == "1" ]]; then
    chattr +i "$f" || true
    ok "chattr +i ${name}"
  fi
}

http_code_local(){ local path="$1"; curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1${path}" -H "Host: ${HOST}" || true; }
http_code_ext(){ local path="$1"; curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}${path}" || true; }

: >"$OUT"
w "# MEGA_NGINX_WOLVERINE_DUPFIX $(date -Is)"
w "host=$(hostname) whoami=$(whoami) pwd=$(pwd)"
w "-------------------------------------------"

say "0) Pré-requis"
ensure_pkg nginx
ensure_pkg python3
ensure_pkg e2fsprogs
ensure_pkg curl
mkdir -p /etc/nginx/includes
[[ -f "$NGINX_SITE" ]] || die "Vhost introuvable: $NGINX_SITE"
[[ -f "$NGINX_MAIN" ]] || die "nginx.conf introuvable: $NGINX_MAIN"
ok "Pré-requis OK"

say "1) Unlock immutable si nécessaire (vhost + nginx.conf + include)"
SITE_WAS_IMM="0"; MAIN_WAS_IMM="0"; INC_WAS_IMM="0"
unlock_if_immutable "$NGINX_SITE" "vhost" && SITE_WAS_IMM="1" || true
unlock_if_immutable "$NGINX_MAIN" "nginx.conf" && MAIN_WAS_IMM="1" || true
[[ -f "$NGINX_INC" ]] && { unlock_if_immutable "$NGINX_INC" "include" && INC_WAS_IMM="1" || true; }

say "2) Inventaire: où est inclus wolverine_routes.inc ?"
w "grep -RIn \"wolverine_routes.inc\" /etc/nginx (hors backups) :"
grep -RIn --exclude='*.bak_*' --exclude='*bak*' 'wolverine_routes\.inc' /etc/nginx 2>/dev/null | tee -a "$OUT" >/dev/null || true

say "3) Backups (tous fichiers nginx qui mentionnent wolverine_routes.inc + vhost + include)"
python3 - <<'PY'
import re, subprocess, os, time
from pathlib import Path
ts=os.environ.get("TS") or time.strftime("%Y%m%d_%H%M%S")
out=Path(f"/root/MEGA_NGINX_WOLVERINE_DUPFIX_{ts}.log")
def w(x): out.write_text(out.read_text()+x+"\n") if out.exists() else out.write_text(x+"\n")
paths=set()
for p in [Path("/etc/nginx/sites-available/fireinners.online-ssl"), Path("/etc/nginx/includes/wolverine_routes.inc"), Path("/etc/nginx/nginx.conf")]:
    if p.exists(): paths.add(p)
try:
    r=subprocess.run(["bash","-lc",r"grep -RIl --exclude='*.bak_*' --exclude='*bak*' 'wolverine_routes\.inc' /etc/nginx 2>/dev/null || true"],capture_output=True,text=True)
    for line in r.stdout.splitlines():
        if line.strip(): paths.add(Path(line.strip()))
except Exception as e:
    w(f"WARN: grep list failed: {e}")

for p in sorted(paths):
    if p.exists():
        b=p.with_name(p.name+f".bak_{ts}")
        try:
            b.write_bytes(p.read_bytes())
            w(f"OK: backup {p} -> {b}")
        except Exception as e:
            w(f"WARN: backup failed {p}: {e}")
PY
ok "Backups OK"

say "4) Nettoyer les includes: on garde UNIQUEMENT dans $NGINX_SITE, on supprime ailleurs"
python3 - <<'PY'
import re
from pathlib import Path

target = Path("/etc/nginx/sites-available/fireinners.online-ssl")
root = Path("/etc/nginx")
pat = re.compile(r'^\s*include\s+[^;]*wolverine_routes\.inc\s*;\s*$', re.M)

files=[]
for p in root.rglob("*"):
    if not p.is_file(): 
        continue
    s=str(p)
    if ".bak_" in s or "bak" in p.name:
        continue
    if p.suffix in [".conf",".inc"] or "/sites-" in s:
        try:
            txt=p.read_text(errors="ignore")
        except Exception:
            continue
        if "wolverine_routes.inc" in txt:
            files.append(p)

for p in files:
    txt=p.read_text(errors="ignore")
    if p != target:
        # enlever toutes les lignes include wolverine_routes.inc dans les autres fichiers
        new = pat.sub("", txt)
        if new != txt:
            p.write_text(new)
    else:
        # dans le vhost, garder une seule occurrence (la première)
        lines=txt.splitlines(True)
        out=[]
        seen=False
        for ln in lines:
            if re.match(r'^\s*include\s+[^;]*wolverine_routes\.inc\s*;\s*$', ln):
                if not seen:
                    out.append("    include /etc/nginx/includes/wolverine_routes.inc;\n")
                    seen=True
                else:
                    continue
            else:
                out.append(ln)
        if not seen:
            # si absent, on l’ajoute tout en haut du fichier (safe)
            out.insert(0,"# injected by MEGA_NGINX_WOLVERINE_DUPFIX\n")
            out.insert(1,"include /etc/nginx/includes/wolverine_routes.inc;\n")
        target.write_text("".join(out))

print("OK: include lines dedup/cleaned")
PY
ok "Includes nettoyés"

say "5) Réécrire wolverine_routes.inc en version anti-doublon (aucun 'location /wolverine' ambigu)"
cat >"$NGINX_INC" <<'INC'
# WOLVERINE routes (canonical, anti-duplicate)
# Front root: /var/www/wolverine
# Backend TraderOne: http://127.0.0.1:3000 proxied under /wolverine/traderone/api/

# Important: on évite toute 2e définition de /wolverine (sans slash)
location = /wolverine { return 301 /wolverine/; }

# API TraderOne
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}

# Next static
location ^~ /wolverine/_next/ {
  alias /var/www/wolverine/_next/;
  try_files $uri $uri/ =404;
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# Assets (optionnel)
location ^~ /wolverine/assets/ {
  alias /var/www/wolverine/assets/;
  try_files $uri $uri/ =404;
  add_header Cache-Control "public, max-age=86400" always;
}

# Front app (slash obligatoire ici => pas de collision avec 'location = /wolverine')
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
INC
ok "Include réécrit"

say "6) Permissions front (éviter 403)"
if [[ -d "$FRONT_DIR" ]]; then
  chmod -R a+rX "$FRONT_DIR" || true
  ok "chmod a+rX sur $FRONT_DIR"
else
  warn "Front dir absent: $FRONT_DIR (skip chmod)"
fi

say "7) nginx -t (doit passer)"
if nginx -t 2>&1 | tee -a "$OUT" >/dev/null; then
  ok "nginx -t OK"
else
  w "----- DEBUG: lignes 1..120 de $NGINX_INC -----"
  nl -ba "$NGINX_INC" | sed -n '1,120p' | tee -a "$OUT" >/dev/null || true
  die "nginx -t FAIL (voir $OUT)"
fi

say "8) reload nginx"
systemctl reload nginx
ok "reload OK"

say "9) Probes HTTP (LOCAL + EXT)"
w "LOCAL  /wolverine/               => $(http_code_local "/wolverine/")"
w "LOCAL  /wolverine/traderone/api/ => $(http_code_local "/wolverine/traderone/api/")"
w "EXT    /wolverine/               => $(http_code_ext  "/wolverine/")"
w "EXT    /wolverine/traderone/api/ => $(http_code_ext  "/wolverine/traderone/api/")"
w "NOTE: si TraderOne n'est pas démarré => /wolverine/traderone/api/ sera 502 (normal)"

say "10) Relock immutable si nécessaire"
relock_if_needed "$NGINX_INC"  "include"   "$INC_WAS_IMM"
relock_if_needed "$NGINX_SITE" "vhost"     "$SITE_WAS_IMM"
relock_if_needed "$NGINX_MAIN" "nginx.conf" "$MAIN_WAS_IMM"
ok "Terminé"
w "LOG: $OUT"
INNER

chmod +x "$SCRIPT"
rm -f "$NOH" 2>/dev/null || true
nohup bash "$SCRIPT" >"$NOH" 2>&1 & disown || true
echo "Lancé: $SCRIPT"
echo "Lis: tail -n 260 $NOH"
echo "Log final: $LOG (ou regarde dans $NOH, il imprime le chemin exact du log)"
BASH

bash /root/MEGA_NGINX_WOLVERINE_DUPFIX_RUN.sh
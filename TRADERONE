cat >/tmp/WOLVERINE_TG_FIX_FINAL.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

ENV="/opt/fireinners/wolverine-telegram/telegram.env"
CID="5153862399" # ton chat id
mkdir -p /opt/fireinners/wolverine-telegram
chmod 700 /opt/fireinners/wolverine-telegram

echo "=== WOLVERINE TG FIX FINAL ==="
date;hostname;whoami

systemctl stop wolverine-tg-sentinel 2>/dev/null || true

# backup + wipe
if [ -f "$ENV" ]; then
  cp -a "$ENV" "$ENV.bak.$(date +%s)" || true
fi
rm -f "$ENV"

# ask token (silent) - IMPORTANT: colle le token puis ENTER (rien ne s'affiche)
read -r -s -p "COLLE LE NOUVEAU TG_TOKEN (rien ne s'affiche) ثم ENTER: " TG
echo
if [ -z "${TG:-}" ]; then
  echo "ERREUR: token vide (tu n'as rien collé). Relance le script."
  exit 1
fi
if [ "${#TG}" -lt 35 ]; then
  echo "ERREUR: token trop court (${#TG}). Relance et colle le token complet."
  exit 1
fi

umask 077
printf 'TG_TOKEN=%s\nTG_CHAT_ID=%s\n' "$TG" "$CID" >"$ENV"
chmod 600 "$ENV"

echo "OK: env écrit. tokenlen=${#TG} chatid=$CID"

echo "--- test Telegram getMe (doit afficher ok:true) ---"
curl -sS -m 8 "https://api.telegram.org/bot${TG}/getMe" | head -c 250; echo

echo "--- test send via wolv_send ---"
# wolv_send lit telegram.env; maintenant il est propre => OK
/usr/local/bin/wolv_send "WOLVERINE: token OK (final fix)" || true

systemctl start wolverine-tg-sentinel 2>/dev/null || true
echo "=== DONE ==="
SH
bash /tmp/WOLVERINE_TG_FIX_FINAL.sh
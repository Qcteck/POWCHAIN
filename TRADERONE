cat >/root/fix_listen_443_auto.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="fireinners.online"

# 1) Trouver le fichier qui contient le server SSL pour ce domaine
VHOST="$(
nginx -T 2>/dev/null | awk -v dom="$DOMAIN" '
  /^# configuration file /{file=$4; sub(/:$/,"",file)}
  $0 ~ /server_name/ && $0 ~ dom {cand=file}
  $0 ~ /ssl_certificate/ && cand!="" {print cand; exit}
'
)"

# fallback: premier server_name match si pas trouvé via ssl_certificate
if [[ -z "${VHOST:-}" ]]; then
  VHOST="$(
  nginx -T 2>/dev/null | awk -v dom="$DOMAIN" '
    /^# configuration file /{file=$4; sub(/:$/,"",file)}
    $0 ~ /server_name/ && $0 ~ dom {print file; exit}
  ')"
fi

[[ -n "${VHOST:-}" && -f "$VHOST" ]] || { echo "[ERR] Impossible de trouver le vhost pour $DOMAIN via nginx -T"; exit 1; }
echo "[OK] VHOST trouvé: $VHOST"

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$VHOST" "${VHOST}.bak_${ts}"
echo "[OK] Backup -> ${VHOST}.bak_${ts}"

# 2) Injecter listen 443 si absent (au début du server block)
if ! grep -qE 'listen\s+\[::\]:443|listen\s+443' "$VHOST"; then
  perl -0777 -i -pe '
    s/(server\s*\{\s*)/$1  listen 443 ssl http2;\n  listen [::]:443 ssl http2;\n/s
  ' "$VHOST"
  echo "[OK] Added listen 443"
else
  echo "[OK] listen 443 already present"
fi

# 3) Ouvrir firewall si UFW actif
if command -v ufw >/dev/null 2>&1; then
  if ufw status | grep -qi active; then
    ufw allow 80/tcp || true
    ufw allow 443/tcp || true
    echo "[OK] UFW opened 80/443"
  fi
fi

nginx -t
systemctl restart nginx

echo
echo "=== PORTS ==="
ss -lntp | grep -E ':(80|443)\b' || true

echo
echo "=== LOCAL HTTPS TEST ==="
curl -kI --max-time 5 https://127.0.0.1/ | head -n 12 || true
BASH

chmod +x /root/fix_listen_443_auto.sh
/root/fix_listen_443_auto.sh
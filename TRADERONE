cat >/root/fix_wolverine_403_front.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

CFG="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date -u +%Y%m%d_%H%M%S)"

echo "=== Backup ==="
cp -a "$CFG" "${CFG}.bak_frontfix_${TS}"
echo "Backup: ${CFG}.bak_frontfix_${TS}"
echo

echo "=== Remove any deny/internal from /wolverine location ==="
python3 - <<'PY'
from pathlib import Path
import re

cfg = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = cfg.read_text(errors="ignore")

# Remove deny all / internal inside location /wolverine
def clean_block(text, pat):
    m = re.search(pat, text)
    if not m: return text
    start = m.start()
    brace = text.find("{", start)
    if brace == -1: return text
    i = brace
    depth = 0
    while i < len(text):
        if text[i] == "{": depth += 1
        elif text[i] == "}":
            depth -= 1
            if depth == 0:
                end = i+1
                block = text[start:end]
                block2 = re.sub(r'^\s*(deny\s+all;|internal;).*$', '', block, flags=re.M)
                return text[:start] + block2 + text[end:]
        i += 1
    return text

s2 = clean_block(s, r'location\s+(\^~\s+)?/?wolverine/?\s*\{')
cfg.write_text(s2)
print("OK: cleaned deny/internal in /wolverine")
PY

echo "=== Force public /wolverine location (add if missing) ==="
if ! grep -qE "location\s+\^~\s+/wolverine/\s*\{" "$CFG"; then
  awk '
    BEGIN{done=0}
    {print}
    done==0 && $0 ~ /^[[:space:]]*server[[:space:]]*\{/ {
      print ""
      print "  # Force public front"
      print "  location ^~ /wolverine/ {"
      print "    root /var/www;"
      print "    try_files $uri $uri/ /wolverine/index.html;"
      print "    allow all;"
      print "  }"
      print ""
      done=1
    }
  ' "$CFG" > /tmp/nginx_frontfix.tmp
  mv /tmp/nginx_frontfix.tmp "$CFG"
  echo "Added public /wolverine location"
else
  echo "/wolverine location already exists"
fi

echo
echo "=== nginx test + reload ==="
nginx -t
systemctl reload nginx || service nginx reload
echo

echo "=== ORIGIN check ==="
curl -skI --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/index.html | head -n 12 || true
echo "DONE ✅"
BASH

chmod +x /root/fix_wolverine_403_front.sh
/root/fix_wolverine_403_front.sh
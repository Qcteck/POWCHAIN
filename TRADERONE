cat >/tmp/WOLVERINE_REBUILD_WEB3_OK.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOCROOT="/var/www/fireinners/wolverine"
WORKDIR="/opt/traderone-opt"
TS="$(date +%s)"

mkdir -p "$DOCROOT"
cd "$WORKDIR"

# deps
[ -f package.json ] || npm init -y >/dev/null
npm i @solana/web3.js >/dev/null
command -v esbuild >/dev/null 2>&1 || npm i -g esbuild >/dev/null

# entry INSIDE node_modules scope
mkdir -p "$WORKDIR/build"
cat >"$WORKDIR/build/solana-web3.entry.js" <<'JS'
export * as solanaWeb3 from "@solana/web3.js";
JS

# build -> DOCROOT
esbuild "$WORKDIR/build/solana-web3.entry.js" \
  --bundle --minify --platform=browser \
  --format=iife --global-name=solanaWeb3 \
  --outfile="$DOCROOT/solana-web3.min.js"

chmod 644 "$DOCROOT/solana-web3.min.js"

echo "First bytes (must not start with '<'):"
head -c 30 "$DOCROOT/solana-web3.min.js"; echo
echo "OK -> $DOCROOT/solana-web3.min.js"

nginx -t && systemctl reload nginx

echo "Test remote (must not return HTML):"
curl -ksS "https://fireinners.online/wolverine/solana-web3.min.js?v=$TS" | head -c 30; echo
echo "Open: https://fireinners.online/wolverine/?v=$TS"
SH

bash /tmp/WOLVERINE_REBUILD_WEB3_OK.sh
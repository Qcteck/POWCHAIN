cat >/tmp/WOLVERINE_TG_RESET_ENV.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
CID="5153862399" # ton chat id détecté

echo "=== WOLVERINE TG RESET ENV ==="
date;hostname;whoami

# backup si existe
if [ -f "$ENV" ]; then
  cp -a "$ENV" "$ENV.bak.$(date +%s)" || true
fi

# demande token (silencieux)
read -r -s -p "NOUVEAU TG_TOKEN = " TG
echo
[ -n "${TG:-}" ] || { echo "token vide"; exit 1; }

umask 077
cat >"$ENV" <<EOF
TG_TOKEN=${TG}
TG_CHAT_ID=${CID}
EOF
chmod 600 "$ENV"

# redémarre sentinel + test
systemctl restart wolverine-tg-sentinel || true
sleep 0.4
/usr/local/bin/wolv_send "WOLVERINE: new token OK (env reset)" || true

echo "OK. telegram.env reset. CHAT_ID=$CID"
SH
bash /tmp/WOLVERINE_TG_RESET_ENV.sh
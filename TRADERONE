cat >/root/nginx_rollback_and_repair_traderone.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
API_UPSTREAM="${API_UPSTREAM:-http://127.0.0.1:9696}"

echo "[*] DOMAIN=$DOMAIN"
echo "[*] VHOST=$VHOST"
echo "[*] API_UPSTREAM=$API_UPSTREAM"

# 1) rollback automatique vers un backup qui passe nginx -t
mapfile -t BAKS < <(ls -1t /etc/nginx/sites-disabled/backup_*/*"${DOMAIN}-ssl" 2>/dev/null || true)

if [[ ${#BAKS[@]} -eq 0 ]]; then
  echo "[ERR] Aucun backup trouvé dans /etc/nginx/sites-disabled/backup_*"
  exit 1
fi

OK_BAK=""
for b in "${BAKS[@]}"; do
  cp -a "$b" "$VHOST"
  if nginx -t >/dev/null 2>&1; then
    OK_BAK="$b"
    break
  fi
done

if [[ -z "$OK_BAK" ]]; then
  echo "[ERR] Aucun backup ne passe nginx -t. Montre: nginx -t"
  exit 1
fi

echo "[OK] Restored working backup: $OK_BAK"

# 2) inject proxy SAFE (idempotent)
export API_UPSTREAM
perl -0777 -i -pe '
my $up = $ENV{API_UPSTREAM} // die "missing API_UPSTREAM";

# remove old injected block if exists
s/\n\s*# --- traderone api proxy \(injected\) ---.*?\n\s*# --- end traderone api proxy ---\n//ms;

my $block = qq{
  # --- traderone api proxy (injected) ---
  location ^~ /wolverine/traderone/api/ {
    # strip prefix: /wolverine/traderone/api/x -> /x
    rewrite ^/wolverine/traderone/api/?(.*)\$ /\$1 break;

    if (\$request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
      add_header Access-Control-Allow-Headers "Authorization,Content-Type,Accept" always;
      return 204;
    }

    proxy_pass $up;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
  # --- end traderone api proxy ---
};

# insert before static /wolverine/ block
s/\n(\s*location\s+\^\~\s+\/wolverine\/\s*\{)/\n$block\n$1/ms
  or die "ERR: cannot find location ^~ /wolverine/ block\n";
' "$VHOST"

echo "[*] nginx -t"
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== Tests (public) =="
curl -sSI "https://${DOMAIN}/wolverine/traderone/api/" | head -n 20 || true
echo
echo "== Tests (local upstream) =="
curl -sS "${API_UPSTREAM}/" | head -n 20 || true
BASH

chmod +x /root/nginx_rollback_and_repair_traderone.sh
API_UPSTREAM="http://127.0.0.1:9696" /root/nginx_rollback_and_repair_traderone.sh fireinners.online
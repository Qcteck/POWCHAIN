cat >/root/FORCE_AGENTIA_PROXY_443_SAFE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

# --- DO NOT TOUCH WOLVERINE ---
WOLV_HTML="/var/www/wolverine/index.html"
sha(){ [ -f "$1" ] && sha256sum "$1" | awk '{print $1}' || echo "MISSING"; }
BEF_W="$(sha "$WOLV_HTML")"

# --- NGINX ---
NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

# --- AGENTIA ---
SVC="agentia.service"
PORT="9697"
UP="http://127.0.0.1:${PORT}"

[ "$(id -u)" -eq 0 ] || { echo "ERROR: run as root"; exit 1; }
[ -f "$NGX_SITE" ] || { echo "ERROR: missing $NGX_SITE"; exit 1; }

echo "== BEFORE =="
echo "wolverine index: $BEF_W  $WOLV_HTML"
echo "nginx vhost    : $(sha "$NGX_SITE")  $NGX_SITE"

echo "== Ensure AgentIA running =="
systemctl start "$SVC" >/dev/null 2>&1 || true
sleep 1
curl -fsS "$UP/agentia/health" | head -c 300; echo

echo "== Patch nginx 443 server block: FORCE proxy /agentia =="
chattr -i "$NGX_SITE" 2>/dev/null || true
cp -a "$NGX_SITE" "${NGX_SITE}.bak_${TS}"

python3 - <<'PY'
from pathlib import Path
p=Path("/etc/nginx/sites-available/fireinners.online-ssl")
s=p.read_text(errors="ignore")
lines=s.splitlines()

# find 443 server block for fireinners.online (brace counting)
blocks=[]
i=0
while i < len(lines):
    if lines[i].strip().startswith("server") and "{" in lines[i]:
        a=i
        depth=0
        started=False
        j=i
        while j < len(lines):
            ln=lines[j]
            if "{" in ln:
                depth += ln.count("{")
                started=True
            if "}" in ln and started:
                depth -= ln.count("}")
                if depth<=0:
                    b=j
                    blocks.append((a,b))
                    i=b
                    break
            j+=1
    i+=1

def txt(a,b): return "\n".join(lines[a:b+1])

target=None
for a,b in blocks:
    t=txt(a,b)
    if ("listen 443" in t or "443 ssl" in t) and ("fireinners.online" in t):
        target=(a,b); break
if not target:
    for a,b in blocks:
        t=txt(a,b)
        if ("listen 443" in t or "443 ssl" in t):
            target=(a,b); break
if not target:
    raise SystemExit("ERROR: no 443 server block found")

a,b=target

# remove any prior agentia include / locations inside the target block
new=[]
k=a
while k<=b:
    ln=lines[k]
    drop=False
    if "include /etc/nginx/includes/agentia_routes.inc" in ln:
        drop=True
    if "location = /agentia" in ln:
        # drop this line and the block if present
        drop=True
    if "location ^~ /agentia/" in ln or "location /agentia" in ln:
        drop=True
    if drop:
        # if it's a location line with '{', skip until matching '}'
        if "location" in ln and "{" in ln:
            depth=ln.count("{")-ln.count("}")
            k+=1
            while k<=b and depth>0:
                depth += lines[k].count("{")-lines[k].count("}")
                k+=1
            continue
        k+=1
        continue
    new.append(ln)
    k+=1

# rebuild whole file with patched server block content
out = lines[:a] + new + lines[b+1:]

# insert our forced locations right after "server {" inside same block
# re-find the server { line index in rebuilt file near a
# (search forward from a)
insert_at=None
for idx in range(a, min(a+50, len(out))):
    if out[idx].strip()=="server {" or out[idx].strip().startswith("server {"):
        insert_at=idx+1
        break
if insert_at is None:
    insert_at=a+1

block = [
"  # === AGENTIA FORCED ROUTE (auto) ===",
"  location = /agentia { return 301 /agentia/; }",
"  location ^~ /agentia/ {",
"    proxy_http_version 1.1;",
"    proxy_set_header Host $host;",
"    proxy_set_header X-Real-IP $remote_addr;",
"    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;",
"    proxy_set_header X-Forwarded-Proto $scheme;",
"    add_header Cache-Control \"no-store\" always;",
"    proxy_pass http://127.0.0.1:9697;",
"  }",
"  # === /AGENTIA FORCED ROUTE ===",
]
out = out[:insert_at] + block + out[insert_at:]

p.write_text("\n".join(out) + "\n")
print("OK: nginx vhost patched with forced /agentia proxy")
PY

echo "== nginx test + reload =="
nginx -t
systemctl reload nginx
chattr +i "$NGX_SITE" 2>/dev/null || true

echo "== VERIFY: Wolverine untouched =="
AFT_W="$(sha "$WOLV_HTML")"
echo "wolverine index: $AFT_W  $WOLV_HTML"
[ "$BEF_W" = "$AFT_W" ] || { echo "ERROR: Wolverine index changed (should not)."; exit 1; }

echo "== VERIFY: Public /agentia now shows AgentIA (not FireInners) =="
OUT="$(curl -kfsS "https://fireinners.online/agentia/" | head -c 3000 || true)"
echo "$OUT" | head -c 300; echo
echo "$OUT" | grep -qi "agentia" && echo "OK: AgentIA is served on /agentia" || { echo "ERROR: still not AgentIA on /agentia (nginx -T dump next)."; exit 1; }

echo "OK: https://fireinners.online/agentia/ fixed; Wolverine untouched."
BASH

bash /root/FORCE_AGENTIA_PROXY_443_SAFE.sh
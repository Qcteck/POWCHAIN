cat >/root/MEGA_WOLVERINE_SOLANAWEB3_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

HTML="/var/www/wolverine/index.html"
VENDOR_DIR="/var/www/wolverine/vendor"
VENDOR_WEB3="$VENDOR_DIR/solana-web3.min.js"
WEB3_URL="https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js"

need(){ command -v "$1" >/dev/null 2>&1 || { echo "Missing bin: $1"; exit 1; }; }
need bash; need awk; need grep; need sed; need curl; need python3; need nginx; need systemctl

test -f "$HTML" || { echo "Missing $HTML"; exit 1; }

echo "== 0) SAVEPOINT (if present) =="
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then /root/WOLVERINE_SAVEPOINT.sh || true; fi

echo "== 1) Backup index.html =="
mkdir -p /root/wolverine_backups
cp -a "$HTML" "/root/wolverine_backups/index.html.bak_${TS}"

echo "== 2) Ensure local vendor solana-web3 (IIFE) =="
mkdir -p "$VENDOR_DIR"
if [ ! -s "$VENDOR_WEB3" ]; then
  curl -fsSL "$WEB3_URL" -o "$VENDOR_WEB3"
fi
chmod 0644 "$VENDOR_WEB3"

echo "== 3) Patch index.html: force solana-web3 FIRST in <head> =="
python3 - <<'PY'
from pathlib import Path
import re, sys

p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")

tag = '<script src="/wolverine/vendor/solana-web3.min.js"></script>'

# remove any existing solana-web3 tag variants to avoid duplicates
s = re.sub(r'<script[^>]+src=["\'](?:/wolverine/)?vendor/solana-web3(?:\.min)?\.js["\'][^>]*>\s*</script>', '', s, flags=re.I)

# find <head...> open
m = re.search(r'<head[^>]*>', s, flags=re.I)
if not m:
    print("ERR: <head> not found")
    sys.exit(1)

head_open = m.group(0)
start = m.end()

# Insert tag immediately after <head...>
s = s[:start] + tag + s[start:]

# Safety: if there's a CSP meta blocking scripts, we won't touch it here (nginx should serve same-origin).
p.write_text(s)
print("OK: injected vendor solana-web3 first in <head>")
PY

echo "== 4) nginx test + reload =="
nginx -t
systemctl reload nginx || systemctl restart nginx

echo "== 5) Live checks =="
echo "-- vendor web3 (HEAD) --"
curl -sSI "https://fireinners.online/wolverine/vendor/solana-web3.min.js" | sed -n '1,10p' || true

echo "-- solana-rpc (POST getHealth) --"
curl -sS "https://fireinners.online/wolverine/solana-rpc" \
  -H "content-type: application/json" \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' || true
echo

echo "DONE"
echo "OPEN: https://fireinners.online/wolverine/ (Ctrl+F5 hard refresh)"
BASH
bash /root/MEGA_WOLVERINE_SOLANAWEB3_FIX.sh
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

HOST="fireinners.online"
FRONT_DIR="/var/www/wolverine"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"
NGINX_INC="/etc/nginx/includes/wolverine_routes.inc"
OUT="/root/MEGA_NGINX_WOLVERINE_DEDUP.log"

say(){ printf "\n== %s ==\n" "$*"; }
w(){ printf "%s\n" "$*" | tee -a "$OUT" >/dev/null; }
ok(){ w "OK: $*"; }
warn(){ w "WARN: $*"; }
die(){ w "ERREUR: $*"; exit 1; }

ensure_pkg(){ local p="$1"; dpkg -s "$p" >/dev/null 2>&1 || { apt-get update -y; apt-get install -y "$p"; }; }

unlock_if_immutable(){
  local f="$1" name="$2"
  local a; a="$(lsattr -d "$f" 2>/dev/null || true)"
  w "lsattr ${name}: $a"
  if echo "$a" | awk '{print $1}' | grep -q "i"; then
    chattr -i "$f" || true
    ok "chattr -i ${name}"
    return 0
  fi
  return 1
}
relock_if_needed(){
  local f="$1" name="$2" was="$3"
  if [[ "$was" == "1" ]]; then
    chattr +i "$f" || true
    ok "chattr +i ${name}"
  fi
}

http_code_local(){
  local path="$1"
  curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1${path}" -H "Host: ${HOST}" || true
}
http_code_ext(){
  local path="$1"
  curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}${path}" || true
}

: >"$OUT"
w "# MEGA_NGINX_WOLVERINE_DEDUP $(date -Is)"
w "host=$(hostname) whoami=$(whoami) pwd=$(pwd)"
w "-------------------------------------------"

say "0) Pré-requis"
ensure_pkg nginx
ensure_pkg python3
ensure_pkg e2fsprogs
ensure_pkg curl
[[ -f "$NGINX_SITE" ]] || die "Vhost introuvable: $NGINX_SITE"
[[ -f "$NGINX_MAIN" ]] || die "nginx.conf introuvable: $NGINX_MAIN"

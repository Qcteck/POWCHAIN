say "3) Nettoyage TOTAL des inclusions explicites wolverine_routes.inc (partout)"
# Remove explicit include lines everywhere to prevent double-include
python3 - <<'PY' >>"$LOG" 2>&1
import re, pathlib
root=pathlib.Path("/etc/nginx")
pat=re.compile(r'^\s*include\s+[^;]*wolverine_routes\.inc\s*;\s*(#.*)?$', re.I)
touched=0; removed=0
for p in list(root.rglob("*.conf"))+list(root.rglob("*.inc")):
    try:
        s=p.read_text(errors="ignore").splitlines(True)
    except Exception:
        continue
    new=[]
    changed=False
    for line in s:
        if pat.match(line):
            removed+=1
            changed=True
            continue
        new.append(line)
    if changed:
        p.write_text("".join(new))
        touched+=1
print(f"removed_include_lines={removed} touched_files={touched}")
PY

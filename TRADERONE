cat >/root/clean_and_branch_ui_backend.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

BACKEND="${1:-127.0.0.1:9000}"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
PROXY_SNIP="/etc/nginx/snippets/wolverine_traderone_backend_proxy.conf"
STUB_SNIP="/etc/nginx/snippets/wolverine_traderone_stub_locations.conf"

# Validation simple: host:port (évite les collages avec du texte)
if ! [[ "$BACKEND" =~ ^[a-zA-Z0-9\.\-]+:[0-9]{2,5}$ ]]; then
  echo "[ERR] BACKEND invalide: '$BACKEND'  (attendu: host:port, ex 127.0.0.1:9000)"
  exit 1
fi

[[ -f "$VHOST" ]] || { echo "[ERR] vhost introuvable: $VHOST"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$VHOST" "${VHOST}.bak_${ts}"
echo "[OK] Backup -> ${VHOST}.bak_${ts}"

mkdir -p /etc/nginx/snippets

# 1) Nettoyage: supprime TOUT include invalide (include qui n'a pas exactement 1 argument + ;)
awk '
  /^[[:space:]]*include[[:space:]]/{
    if($0 ~ /^[[:space:]]*include[[:space:]]+[^;[:space:]][^;]*;[[:space:]]*$/) { print; next }
    print "[DROP BAD INCLUDE] " $0 > "/dev/stderr"
    next
  }
  { print }
' "$VHOST" > "${VHOST}.tmp"
mv -f "${VHOST}.tmp" "$VHOST"
echo "[OK] Bad include lines removed"

# 2) Crée/écrase le snippet PROXY (UI -> Backend)
cat >"$PROXY_SNIP" <<NGINX
# UI -> Backend reverse proxy
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://$BACKEND/;
}

# UI calls this absolute path
location = /api/sync-deposit {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://$BACKEND/api/sync-deposit;
}
NGINX
echo "[OK] Proxy snippet -> $PROXY_SNIP"

# 3) Désactive le stub (retire son include s'il existe)
sed -i '\|include .*wolverine_traderone_stub_locations\.conf;|d' "$VHOST"

# 4) Ajoute l'include PROXY (idempotent) juste après server_name fireinners.online
if ! grep -qF "include $PROXY_SNIP;" "$VHOST"; then
  perl -i -pe '
    if(!$done && /server_name\s+.*\bfireinners\.online\b.*;/){
      print "  include /etc/nginx/snippets/wolverine_traderone_backend_proxy.conf;\n";
      $done=1;
    }
  ' "$VHOST"
  echo "[OK] Proxy include injected"
else
  echo "[OK] Proxy include already present"
fi

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "TESTS:"
echo "  curl -i https://fireinners.online/wolverine/traderone/api/me"
echo "  curl -i -X POST https://fireinners.online/api/sync-deposit"
BASH

chmod +x /root/clean_and_branch_ui_backend.sh
/root/clean_and_branch_ui_backend.sh 127.0.0.1:9000
cat >/tmp/WOLVERINE_ASSERT_DOCROOT_AND_STATIC.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%s)"
DOMAIN="fireinners.online"
DOCROOT="/var/www/fireinners/wolverine"

echo "== 1) Nginx says /wolverine alias is: =="
nginx -T 2>/dev/null | grep -nE 'server_name fireinners\.online|location \^~ /wolverine/|alias /var/www/fireinners/wolverine/' | head -n 80 || true
echo

echo "== 2) Files in DOCROOT =="
ls -lah "$DOCROOT" | sed -n '1,120p'
echo

echo "== 3) Ensure solana-web3.min.js exists in DOCROOT =="
if [ ! -f "$DOCROOT/solana-web3.min.js" ]; then
  echo "MISSING: $DOCROOT/solana-web3.min.js"
  echo "Trying to copy from other known location if present..."
  if [ -f "/var/www/fireinners/wolverine/solana-web3.min.js" ]; then
    cp -a "/var/www/fireinners/wolverine/solana-web3.min.js" "$DOCROOT/solana-web3.min.js"
  elif [ -f "/var/www/wolverine/solana-web3.min.js" ]; then
    cp -a "/var/www/wolverine/solana-web3.min.js" "$DOCROOT/solana-web3.min.js"
  else
    echo "No source file found. (If needed we rebuild again.)"
  fi
fi

if [ -f "$DOCROOT/solana-web3.min.js" ]; then
  chmod 644 "$DOCROOT/solana-web3.min.js" || true
  echo "First 40 bytes (must NOT start with '<'):"
  head -c 40 "$DOCROOT/solana-web3.min.js"; echo
else
  echo "Still missing solana-web3.min.js in DOCROOT."
fi
echo

echo "== 4) Reload nginx =="
nginx -t && systemctl reload nginx
echo

echo "== 5) Remote checks (no flood) =="
echo "-- HTML contains uSol/tSol?"
curl -ksS "https://${DOMAIN}/wolverine/?v=$TS" | grep -E 'uSol|tSol|solBal' -n | head -n 30 || true
echo
echo "-- JS headers (solana-web3.min.js):"
curl -ksSI "https://${DOMAIN}/wolverine/solana-web3.min.js?v=$TS" | sed -n '1,25p' || true
echo
echo "-- JS first bytes:"
curl -ksS "https://${DOMAIN}/wolverine/solana-web3.min.js?v=$TS" | head -c 60; echo
echo
echo "OPEN: https://${DOMAIN}/wolverine/?v=$TS"
SH

bash /tmp/WOLVERINE_ASSERT_DOCROOT_AND_STATIC.sh
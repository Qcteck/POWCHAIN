set -e
cd /root

echo "=== 0) Backup ==="
cp -v /opt/traderone/api/server.js /opt/traderone/api/server.js.SAVE.$(date +%s) || true

echo
echo "=== 1) Crée server.mjs (ESM) ==="
cp -v /opt/traderone/api/server.js /opt/traderone/api/server.mjs

echo
echo "=== 2) Force PORT env si le fichier hardcode PORT ==="
# remplace: const PORT=3000;  -> const PORT=Number(process.env.PORT||3000);
perl -pi -e 's/const\s+PORT\s*=\s*3000\s*;/const PORT = Number(process.env.PORT||3000);/g' /opt/traderone/api/server.mjs

echo
echo "=== 3) Kill 3000 + lance en ESM ==="
sudo fuser -k 3000/tcp 2>/dev/null || true
nohup env PORT=3000 node /opt/traderone/api/server.mjs > /var/log/traderone-rest.log 2>&1 &
sleep 1

echo
echo "=== 4) Check écoute + test ==="
ss -ltnp | egrep ':3000|:12703|:3002' || true
curl -sS -i -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' | head -n 40 || true

echo
echo "=== 5) Si ça plante: log ==="
tail -n 120 /var/log/traderone-rest.log || true
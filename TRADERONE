<!doctype html>
<html lang="fr-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>MÉTÉO IONIQUE ÉCHO</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="wrap">
    <header>
      <h1>MÉTÉO IONIQUE ÉCHO</h1>
      <div class="sub">Station <b>LES-1</b> – <b>237 kHz</b> – Orbite 1965</div>

      <div class="times" aria-label="Horloges">
        <div class="pill"><b>Heure satellite</b><span class="v" id="heureSat">-- : -- : -- . ---</span></div>
        <div class="pill"><b>Apple</b><span class="v" id="heureApple">-- : -- : -- . ---</span></div>
        <div class="pill"><b>Météo-Média</b><span class="v" id="heureMeteo">-- : -- : -- . ---</span></div>
      </div>
    </header>

    <div class="grid">
      <section class="card">
        <h2>Conditions actuelles</h2>
        <div class="row"><span class="k">Température</span><span class="v" id="temp">-- °C</span></div>
        <div class="row"><span class="k">Ressenti</span><span class="v" id="ressenti">-- °C</span></div>
      </section>

      <section class="card">
        <h2>Vent</h2>
        <div class="row"><span class="k">Vent</span><span class="v" id="vent">-- km/h ouest</span></div>
        <div class="row"><span class="k">Rafales</span><span class="v" id="rafales">-- km/h</span></div>
      </section>

      <section class="card">
        <h2>Précipitations & visibilité</h2>
        <div class="row"><span class="k">Neige</span><span class="v" id="neige">-- %</span></div>
        <div class="row"><span class="k">Visibilité</span><span class="v" id="visibilite">-- km</span></div>
        <div class="row"><span class="k">Verglas</span><span class="v" id="verglas">-- %</span></div>
      </section>

      <section class="card">
        <h2>Activité solaire</h2>
        <div class="row"><span class="k">Kp</span><span class="v" id="kp">--</span></div>
        <div class="row"><span class="k">Aurores</span><span class="v" id="aurores">-- %</span></div>
        <div class="row"><span class="k">Ionisation</span><span class="v" id="ionisation">-- %</span></div>
        <div class="row"><span class="k">Marée ionique</span><span class="v" id="mareeIonique">-- %</span></div>
      </section>

      <section class="card">
        <h2>Sensor géomagnétique</h2>
        <div class="row"><span class="k">GEOMAG</span><span class="v" id="geomag">-- gamma</span></div>
        <div class="row"><span class="k">Vibration</span><span class="v" id="vibration">-- Hz</span></div>
        <div class="row"><span class="k">Phase</span><span class="v" id="phaseGeo">--</span></div>
        <div class="row"><span class="k">Charge</span><span class="v" id="charge">-- Montréal, Québec</span></div>
      </section>

      <section class="card">
        <h2>Terre vivante</h2>
        <div class="row"><span class="k">SEISM</span><span class="v" id="seism">sismique calme</span></div>
      </section>

      <section class="card">
        <h2>Lune vivante</h2>
        <div class="row"><span class="k">LUNE</span><span class="v" id="lune">—</span></div>
        <div class="row"><span class="k">Marée</span><span class="v" id="maree">-- %</span></div>
      </section>

      <section class="card">
        <h2>Écoute ionique ÉCHO <span class="mini" id="listenState">—</span></h2>
        <div class="row"><span class="k">Fréquence</span><span class="v"><span id="freq">237</span> kHz</span></div>
        <div class="row"><span class="k">Mode</span><span class="v" id="mode">Balayage</span></div>
        <div class="row"><span class="k">Niveau</span><span class="v"><span id="vuText">--</span> dB <span class="live" id="vuBar">▁</span></span></div>
        <div class="row"><span class="k">État</span><span class="v" id="audioStatus">Prêt</span></div>
        <div class="row"><span class="k">Dernier message</span><span class="v" id="lastSpeak">—</span></div>
      </section>
    </div>

    <div class="alert"><b>Alertes :</b> <span id="alertes">Aucune alerte.</span></div>

    <div class="controls">
      <button id="btnEcouter" type="button">Écouter maintenant</button>
      <button id="btnStop" type="button">Stop</button>
      <label class="toggle" title="Auto-refresh toutes les 15 minutes">
        <input id="auto15" type="checkbox" />
        <span>Auto toutes les 15 min : <b id="autoState">OFF</b></span>
      </label>
    </div>

    <div class="note">
      <div>Le vieux satellite tombe avant Apple. Toujours.</div>
      <div>Données réelles + écoute ionique Écho – <span id="dateStamp">24 janvier 2026</span></div>
    </div>

    <div class="footer">Interface station LES-1 • Météo ionique • 237 kHz</div>
  </div>

  <script>
    function getPhaseLune() {
      const dateRefNouvelle = new Date('2026-01-09T00:00:00Z');
      const dateActuelle = new Date();
      const diffSec = (dateActuelle - dateRefNouvelle) / 1000;
      const cycle = 29.530588853 * 86400;
      const fraction = (((diffSec % cycle) + cycle) % cycle) / cycle;

      if (fraction < 0.03 || fraction > 0.97) return 'lune noire (nouvelle) – marée basse';
      if (fraction >= 0.47 && fraction <= 0.53) return 'lune pleine – marée extrême';
      if ((fraction >= 0.22 && fraction <= 0.28) || (fraction >= 0.72 && fraction <= 0.78)) return 'quartiers – marée faible';
      return 'lune vivante – marée moyenne';
    }

    function pad2(n){return String(n).padStart(2,'0')}
    function hmsMs(d){
      const h=pad2(d.getHours()), m=pad2(d.getMinutes()), s=pad2(d.getSeconds());
      const ms=String(d.getMilliseconds()).padStart(3,'0');
      return `${h} : ${m} : ${s} . ${ms}`;
    }

    const AudioIon = (() => {
      let ctx=null, analyser=null, src=null, stream=null, raf=null;
      let listening=false;

      const elState = () => document.getElementById('listenState');
      const elStatus = () => document.getElementById('audioStatus');
      const elVuText = () => document.getElementById('vuText');
      const elVuBar  = () => document.getElementById('vuBar');
      const elLast   = () => document.getElementById('lastSpeak');

      function vuChar(db){
        const bars=["▁","▂","▃","▄","▅","▆","▇","█"];
        const x=Math.max(-60,Math.min(0,db));
        const i=Math.round((x+60)/60*(bars.length-1));
        return bars[i];
      }

      function calcDbFromTimeDomain(buf){
        let sum=0;
        for (let i=0;i<buf.length;i++){
          const v=(buf[i]-128)/128;
          sum+=v*v;
        }
        const rms=Math.sqrt(sum/buf.length) || 1e-8;
        return 20*Math.log10(rms);
      }

      function loop(){
        if(!listening || !analyser) return;
        const data=new Uint8Array(analyser.fftSize);
        analyser.getByteTimeDomainData(data);
        const db=calcDbFromTimeDomain(data);

        elVuText().textContent=db.toFixed(1);
        elVuBar().textContent=vuChar(db);
        raf=requestAnimationFrame(loop);
      }

      async function start(){
        if(listening) return;
        elStatus().textContent="Autorisation micro…";
        elState().textContent="• en cours";
        try{
          stream=await navigator.mediaDevices.getUserMedia({audio:true});
          ctx=new (window.AudioContext||window.webkitAudioContext)();
          analyser=ctx.createAnalyser();
          analyser.fftSize=2048;
          src=ctx.createMediaStreamSource(stream);
          src.connect(analyser);

          listening=true;
          elStatus().textContent="Écoute active (micro)";
          elState().textContent="• ON";
          loop();
        }catch(e){
          elStatus().textContent="Refus micro / indisponible";
          elState().textContent="• OFF";
          console.error(e);
        }
      }

      function stop(){
        listening=false;
        elState().textContent="• OFF";
        elStatus().textContent="Arrêté";
        elVuText().textContent="--";
        elVuBar().textContent="▁";

        if(raf){cancelAnimationFrame(raf);raf=null;}
        if(stream){stream.getTracks().forEach(t=>t.stop());stream=null;}
        if(ctx){ctx.close().catch(()=>{});ctx=null;}
        analyser=null; src=null;
      }

      function readBulletin(){
        const sat=document.getElementById('heureSat').textContent;
        const temp=document.getElementById('temp').textContent;
        const vent=document.getElementById('vent').textContent;
        const kp=document.getElementById('kp').textContent;
        const lune=document.getElementById('lune').textContent;

        const txt=
          `Station LES-1. Heure satellite ${sat}. `+
          `Température ${temp}. Vent ${vent}. `+
          `Indice Kp ${kp}. Phase lunaire: ${lune}.`;

        elLast().textContent=txt;

        const u=new SpeechSynthesisUtterance(txt);
        u.lang="fr-CA";
        u.rate=1.0; u.pitch=1.0; u.volume=1.0;
        speechSynthesis.cancel();
        speechSynthesis.speak(u);
      }

      return {start, stop, readBulletin};
    })();

    function rapport(){
      const now=new Date();
      const sat=new Date(now.getTime()-2000);
      const met=new Date(now.getTime()+500);

      document.getElementById('heureSat').textContent=hmsMs(sat);
      document.getElementById('heureApple').textContent=hmsMs(now);
      document.getElementById('heureMeteo').textContent=hmsMs(met);

      document.getElementById('lune').textContent=getPhaseLune();
    }

    const auto=document.getElementById('auto15');
    const autoState=document.getElementById('autoState');
    let t15=null;

    auto.addEventListener('change',()=>{
      autoState.textContent=auto.checked?'ON':'OFF';
      if(t15){clearInterval(t15);t15=null;}
      if(auto.checked){
        t15=setInterval(()=>{
          rapport();
          AudioIon.readBulletin();
        },15*60*1000);
      }
    });

    document.getElementById('btnEcouter').addEventListener('click', async ()=>{
      await AudioIon.start();
      rapport();
      AudioIon.readBulletin();
    });

    document.getElementById('btnStop').addEventListener('click',()=>{
      AudioIon.stop();
      speechSynthesis.cancel();
    });

    rapport();
    setInterval(rapport,500);
  </script>
</body>
</html>
cat >/root/batch_root_wolverine_static_export.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
OUT_DIR="${OUT_DIR:-/var/www/wolverine}"

ts(){ date +%Y%m%d_%H%M%S; }
say(){ echo "[$(ts)] $*"; }

need(){ command -v "$1" >/dev/null 2>&1 || { echo "[ERR] missing: $1"; exit 1; }; }
need node; need npm; need find; need grep; need rsync; need nginx; need systemctl; need perl

say "== Wolverine static export publish =="
say "DOMAIN=$DOMAIN"
say "OUT_DIR=$OUT_DIR"
echo

# 1) Find Next.js repo (exclude node_modules/.git)
mapfile -t PJS < <(
  find /opt /var/www /srv -maxdepth 7 -name package.json \
    -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null
)

APP_DIR=""
for pj in "${PJS[@]}"; do
  if grep -q '"next"' "$pj"; then
    d="$(dirname "$pj")"
    if [[ -d "$d/pages" || -d "$d/app" ]]; then APP_DIR="$d"; break; fi
    [[ -z "$APP_DIR" ]] && APP_DIR="$d"
  fi
done
[[ -n "$APP_DIR" ]] || { echo "[ERR] Next repo introuvable"; exit 1; }

say "APP_DIR=$APP_DIR"
cd "$APP_DIR"

# 2) Build (output: export => out/ generated by next build)
say "npm i + build..."
npm i
npm run build

if [[ ! -d out ]]; then
  echo "[ERR] out/ introuvable après build."
  echo "=> Vérifie que next.config.* contient bien: output: 'export'"
  exit 1
fi

# 3) Publish out/ -> /var/www/wolverine
say "Publishing out/ -> $OUT_DIR"
mkdir -p "$OUT_DIR"
PUB_BACK="/var/www/wolverine_backup_$(ts)"
if [[ -d "$OUT_DIR" && "$(ls -A "$OUT_DIR" 2>/dev/null | wc -l)" -gt 0 ]]; then
  cp -a "$OUT_DIR" "$PUB_BACK"
  say "Backup publish -> $PUB_BACK"
fi
rsync -a --delete out/ "$OUT_DIR/"
say "OK: published"

# 4) Stop/disable server service (not compatible with output: export)
if systemctl list-unit-files | grep -q '^wolverine-next\.service'; then
  say "Disabling wolverine-next.service (not needed for static export)"
  systemctl stop wolverine-next 2>/dev/null || true
  systemctl disable wolverine-next 2>/dev/null || true
fi

# 5) Nginx: ensure we serve static alias (and remove proxy block markers if present)
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
[[ -f "$VHOST" ]] || { echo "[ERR] VHOST not found: $VHOST"; exit 1; }

BACKDIR="/etc/nginx/sites-disabled/backup_static_export_$(ts)"
mkdir -p "$BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
say "Backup nginx -> $BACKDIR/$(basename "$VHOST")"

# remove previously injected proxy block if present
START="# === wolverine_next_proxy START ==="
END="# === wolverine_next_proxy END ==="
perl -0777 -i -pe "s/\\n\\s*\\Q$START\\E.*?\\Q$END\\E\\s*\\n/\\n/sg" "$VHOST"

# ensure location ^~ /wolverine/ uses alias OUT_DIR
# (idempotent: replace any existing /wolverine/ location block in ssl server, then inject ours)
read -r -d '' ALIAS_BLOCK <<EOF || true
    # --- wolverine static export ---
    location ^~ /wolverine/ {
        alias $OUT_DIR/;
        index index.html;
        try_files \$uri \$uri/ /wolverine/index.html;
    }
EOF

tmp="$(mktemp)"
awk -v alias_block="$ALIAS_BLOCK" '
function cnt(s,c, i,n){ n=0; for(i=1;i<=length(s);i++) if(substr(s,i,1)==c) n++; return n }
BEGIN{ in_srv=0; is_ssl=0; srv_depth=0; in_loc=0; loc_depth=0; injected=0 }
{
  line=$0

  if(line ~ /^[[:space:]]*server[[:space:]]*\{/){ in_srv=1; is_ssl=0; srv_depth=0 }

  if(in_srv){
    srv_depth += cnt(line,"{") - cnt(line,"}")
    if(line ~ /listen[[:space:]]+443/){ is_ssl=1 }
  }

  # remove existing /wolverine/ location in ssl server (any content)
  if(in_srv && is_ssl && !in_loc && line ~ /^[[:space:]]*location[[:space:]]+\\^~[[:space:]]+\\/wolverine\\/[[:space:]]*\\{/){
    in_loc=1
    loc_depth = cnt(line,"{") - cnt(line,"}")
    next
  }
  if(in_loc){
    loc_depth += cnt(line,"{") - cnt(line,"}")
    if(loc_depth <= 0){ in_loc=0 }
    next
  }

  # inject alias block before closing brace of ssl server
  if(in_srv && is_ssl && !injected && srv_depth==0 && line ~ /^[[:space:]]*\\}/){
    print alias_block
    injected=1
    print line
    in_srv=0
    next
  }

  print line
  if(in_srv && srv_depth==0 && line ~ /^[[:space:]]*\\}/){ in_srv=0 }
}
END{ if(!injected){ print "##ERR## could not inject into ssl server" > "/dev/stderr"; exit 3 } }
' "$VHOST" > "$tmp"
cp -a "$tmp" "$VHOST"
rm -f "$tmp"

say "nginx -t + reload"
nginx -t
systemctl reload nginx

say "DONE. Tests:"
echo "  curl -k -sSI https://127.0.0.1/wolverine/ -H 'Host: ${DOMAIN}' | head -n 12"
echo "  curl -sSI https://${DOMAIN}/wolverine/ | head -n 12"
BASH

chmod +x /root/batch_root_wolverine_static_export.sh
/root/batch_root_wolverine_static_export.sh fireinners.online
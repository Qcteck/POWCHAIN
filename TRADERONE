<script>
(()=>{const S={apiBase:"/wolverine/api",pollFast:900,pollSlow:6000},U={now:()=>new Date(),ts:()=>new Date().toISOString().replace("T"," ").replace("Z"," UTC"),q:(s)=>document.querySelector(s),log:(m,cls)=>{const el=U.q("#log");const t="["+U.ts()+"] "+m+"\n";el.textContent+=t;el.scrollTop=el.scrollHeight;if(cls)el.dataset.last=cls;},set:(id,v,cls)=>{const e=U.q(id);if(e)e.textContent=String(v);if(cls){U.q("#stDot").className="dot "+cls;U.q("#stTxt").textContent=cls.toUpperCase();}},err:(m)=>{const e=U.q("#errCnt");e.textContent=String((+e.textContent||0)+1);U.log(m,"bad");}};
window.__WOLV__={S,U,A:{}};

const API={ab:null,async req(path,opt){try{if(API.ab)API.ab.abort();API.ab=new AbortController();const t0=performance.now();const r=await fetch(S.apiBase+path,{...opt,signal:API.ab.signal,headers:{...(opt&&opt.headers||{}),}});const ms=Math.max(0,Math.round(performance.now()-t0));U.q("#lat").textContent=ms+"ms";return r}catch(e){U.err("fetch error: "+(e&&e.message||e));throw e}},async j(r){const tx=await r.text();try{return JSON.parse(tx)}catch(_){return {ok:false,raw:tx}}},async get(path){return API.req(path,{method:"GET"})},async post(path,body){return API.req(path,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body||{})})}};
window.__WOLV__.A.API=API;

async function ping(){try{const r=await API.get("/ping");const t=await r.text();U.log("ping: "+t,(t||"").toLowerCase().includes("pong")?"ok":"warn");return t}catch(e){U.err("ping error");return ""}}
async function status(){try{const r=await API.get("/status");const j=await API.j(r);return j}catch(e){U.err("status error");return {ok:false}}}
async function config(){try{const r=await API.get("/config");const j=await API.j(r);return j}catch(e){U.err("config error");return {ok:false}}}

async function phantomConnect(){try{if(!window.solana||!window.solana.isPhantom){U.log("Phantom non détecté (mobile: ouvre dans Phantom browser)","warn");return}const ph=await window.solana.connect({onlyIfTrusted:false});const pub=(ph&&ph.publicKey?ph.publicKey.toString():"");U.q("#phPub").value=pub||"non connecté";U.log("Phantom connecté","ok");await refresh()}catch(e){U.err("Connect Phantom: "+(e&&e.message||e))}}
async function phantomDisconnect(){try{if(window.solana&&window.solana.isPhantom&&window.solana.disconnect)await window.solana.disconnect();U.q("#phPub").value="non connecté";U.q("#solBal").textContent="-";U.q("#usdcBal").textContent="-";U.log("Phantom déconnecté","ok")}catch(e){U.err("Disconnect Phantom: "+(e&&e.message||e))}}

async function refresh(){try{U.q("#last").textContent="Dernier refresh: "+U.ts();const st=await status();if(st&&st.custodyPubkey)U.q("#custBal").textContent=(st.custodyBal||"-");if(st&&st.phantom){if(st.phantom.sol!=null)U.q("#solBal").textContent=st.phantom.sol;if(st.phantom.usdc!=null)U.q("#usdcBal").textContent=st.phantom.usdc}U.set("#stTxt",st&&st.running?"running":"idle",(st&&st.running)?"ok":"warn");return st}catch(e){U.err("refresh error");return null}}
async function start(){try{const budget=(U.q("#budget").value||"").trim();const mode=U.q("#mode").value;const mint=(U.q("#mint").value||"").trim();const ph=(U.q("#phPub").value||"").trim();if(!budget||isNaN(+budget)||+budget<=0){U.err("Budget invalide");return}const body={budget:+budget,mode,mint,phantomPub:ph&&ph!=="non connecté"?ph:null};const r=await API.post("/start",body);const j=await API.j(r);U.log("start: "+JSON.stringify(j),j&&j.ok?"ok":"warn");await refresh()}catch(e){U.err("start error: "+(e&&e.message||e))}}
async function stop(){try{const r=await API.post("/stop",{});const j=await API.j(r);U.log("stop: "+JSON.stringify(j),j&&j.ok?"ok":"warn");await refresh()}catch(e){U.err("stop error: "+(e&&e.message||e))}}

U.q("#btnConnect").onclick=phantomConnect;
U.q("#btnDisconnect").onclick=phantomDisconnect;
U.q("#btnStart").onclick=start;

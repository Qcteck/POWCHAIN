#!/usr/bin/env bash
set -euo pipefail

CONF="/etc/nginx/sites-available/fireinners.online-ssl"
DEF="/opt/fireinners/frontend-react/app/dist"
ROOT="$DEF"
if test -f "$CONF"; then
  R=$(awk 'BEGIN{r=""} /^[ \t]*root[ \t]+/{gsub(/;$/,"",$2); if(r==""){r=$2}} END{print r}' "$CONF" 2>/dev/null || true)
  test -n "${R:-}" && ROOT="$R"
fi

ts(){ date +"%Y%m%d-%H%M%S"; }
safe(){ test -n "$1" && test "$1" != "/" && test "${#1}" -ge 10; }
backupdir="/opt/fireinners/backups"
mkdir -p "$backupdir"

echo "== FIREINNERS: REPLACE REACT -> STATIC =="
echo "Detected root: $ROOT"
safe "$ROOT" || { echo "ERR: root path unsafe: $ROOT"; exit 1; }
test -d "$ROOT" || { echo "ERR: root dir introuvable: $ROOT"; exit 1; }

BK="$backupdir/wwwroot_backup_$(ts).tar.gz"
echo "[1] Backup -> $BK"
tar -C "$ROOT" -czf "$BK" . 2>/dev/null || { echo "ERR: backup tar failed"; exit 1; }
ls -la "$BK" || true

echo
echo "[2] Wipe current root contents"
# enlever immutable si jamais sur certains fichiers (best effort)
command -v chattr >/dev/null && command -v lsattr >/dev/null && find "$ROOT" -maxdepth 2 -type f -name "*.html" -exec sh -c 'lsattr "$1" 2>/dev/null | grep -q "\-i-" && chattr -i "$1" 2>/dev/null || true' sh {} \; || true
rm -rf "$ROOT"/*

echo
echo "[3] Write static site files"
mkdir -p "$ROOT"/{traderone,wallet,dex,bridge,explorer,mining,options}


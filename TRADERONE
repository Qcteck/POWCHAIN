set -e
cd /root

echo "=== 1) PID du service 3002 + commande ==="
sudo lsof -iTCP:3002 -sTCP:LISTEN -n -P || true
PID=$(sudo lsof -t -iTCP:3002 -sTCP:LISTEN 2>/dev/null | head -n 1 || true)
echo "PID=$PID"
[ -n "$PID" ] && tr '\0' ' ' < "/proc/$PID/cmdline" ; echo
[ -n "$PID" ] && echo "CWD=$(readlink -f /proc/$PID/cwd)" || true

echo
echo "=== 2) Tests rapides des chemins probables (sans /api) ==="
for p in /status /start /stop /health /ping /config /; do
  echo "--- POST http://127.0.0.1:3002$p"
  curl -sS -i -X POST "http://127.0.0.1:3002$p" -H "content-type: application/json" --data '{}' | head -n 12 || true
  echo "--- GET  http://127.0.0.1:3002$p"
  curl -sS -i "http://127.0.0.1:3002$p" | head -n 12 || true
  echo
done

echo
echo "=== 3) Cherche les routes dans le code (start/status/stop) ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git -E "app\.(get|post|use)\(|router\.(get|post)\(|/start|/status|/stop|/api" /opt /root 2>/dev/null | head -n 200
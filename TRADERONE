set -euo pipefail

echo "=== 1) Santé serveur (CPU/RAM/DISK) ==="
uptime || true
free -h || true
df -h / || true
echo

echo "=== 2) Nginx: status + logs ==="
systemctl status nginx --no-pager || true
journalctl -u nginx -n 120 --no-pager || true
echo

echo "=== 3) Test config nginx ==="
nginx -t || true
echo

echo "=== 4) Ports 80/443 écoutent ? ==="
ss -lntp | egrep ':(80|443)\s' || true
echo

echo "=== 5) Redémarrage nginx (pour remettre en ligne) ==="
systemctl restart nginx || true
sleep 1
systemctl status nginx --no-pager || true
echo

echo "=== 6) Test local (sans Cloudflare) ==="
curl -k -I https://127.0.0.1/ -H "Host: fireinners.online" | head -n 20 || true
curl -k -I https://127.0.0.1/wolverine/ -H "Host: fireinners.online" | head -n 20 || true
echo

echo "=== 7) Dernières erreurs nginx ==="
tail -n 120 /var/log/nginx/error.log || true
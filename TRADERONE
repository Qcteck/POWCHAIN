<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Wolverine / TraderOne</title><style>:root{--bg:#07090d;--bg2:#0b0f18;--panel:#0e1526;--line:#1b2a4a;--txt:#e7eefc;--mut:#9fb3d9;--ok:#39d98a;--bad:#ff4d4d;--warn:#ffcc66;--acc:#3aa0ff;--acc2:#7a5cff;--shadow:0 18px 60px rgba(0,0,0,.55)}*{box-sizing:border-box}html,body{height:100%}body{margin:0;font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;letter-spacing:.2px;background:radial-gradient(1200px 700px at 25% 10%,rgba(58,160,255,.14),transparent 55%),radial-gradient(900px 700px at 85% 25%,rgba(122,92,255,.12),transparent 60%),linear-gradient(180deg,var(--bg),#05070b 60%,#03040a);color:var(--txt)}a{color:inherit;text-decoration:none}button,input,select{font:inherit}#app{height:100%;display:grid;grid-template-columns:280px 1fr;grid-template-rows:64px 1fr;grid-template-areas:"side top""side main"}#side{grid-area:side;border-right:1px solid var(--line);background:linear-gradient(180deg,rgba(14,21,38,.92),rgba(7,9,13,.92));backdrop-filter:blur(10px);padding:18px 14px;display:flex;flex-direction:column;gap:14px}#brand{display:flex;align-items:center;gap:12px;padding:10px 10px;border:1px solid var(--line);border-radius:14px;background:rgba(12,18,32,.55);box-shadow:var(--shadow)}#logo{width:36px;height:36px;border-radius:12px;background:linear-gradient(135deg,var(--acc),var(--acc2));display:grid;place-items:center;font-weight:800}#brand h1{margin:0;font-size:15px;line-height:1.1}#brand small{display:block;color:var(--mut);font-size:11px;margin-top:2px}.nav{display:flex;flex-direction:column;gap:8px}.nav a{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;border:1px solid transparent;color:var(--mut)}.nav a:hover{background:rgba(58,160,255,.08);border-color:rgba(58,160,255,.18);color:var(--txt)}.nav a.active{background:rgba(58,160,255,.12);border-color:rgba(58,160,255,.28);color:var(--txt)}.pill{font-size:11px;padding:2px 8px;border-radius:999px;border:1px solid var(--line);color:var(--mut);margin-left:auto}.pill.ok{color:var(--ok);border-color:rgba(57,217,138,.35);background:rgba(57,217,138,.08)}.pill.bad{color:var(--bad);border-color:rgba(255,77,77,.35);background:rgba(255,77,77,.08)}.pill.warn{color:var(--warn);border-color:rgba(255,204,102,.35);background:rgba(255,204,102,.08)}#top{grid-area:top;display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,rgba(11,15,24,.82),rgba(7,9,13,.35));backdrop-filter:blur(10px)}#top .left{display:flex;align-items:center;gap:10px}#top .right{display:flex;align-items:center;gap:10px}.chip{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:14px;border:1px solid var(--line);background:rgba(12,18,32,.55)}.dot{width:8px;height:8px;border-radius:999px;background:var(--warn);box-shadow:0 0 0 3px rgba(255,204,102,.14)}.dot.ok{background:var(--ok);box-shadow:0 0 0 3px rgba(57,217,138,.14)}.dot.bad{background:var(--bad);box-shadow:0 0 0 3px rgba(255,77,77,.14)}#main{grid-area:main;padding:16px;overflow:auto}#grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}@media(max-width:1060px){#app{grid-template-columns:1fr;grid-template-rows:auto auto 1fr;grid-template-areas:"top""side""main"}#side{border-right:none;border-bottom:1px solid var(--line)}#grid{grid-template-columns:1fr}}.card{border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,rgba(14,21,38,.65),rgba(7,9,13,.55));box-shadow:var(--shadow);overflow:hidden}.card .hd{padding:12px 14px;border-bottom:1px solid rgba(27,42,74,.6);display:flex;align-items:center;gap:10px}.card .hd b{font-size:13px}.card .hd small{color:var(--mut);font-size:11px}.card .bd{padding:14px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.grow{flex:1}.btn{cursor:pointer;border:1px solid rgba(58,160,255,.35);background:linear-gradient(180deg,rgba(58,160,255,.18),rgba(58,160,255,.10));color:var(--txt);padding:10px 12px;border-radius:12px;font-weight:650}.btn:hover{filter:brightness(1.08)}.btn.ghost{border-color:var(--line);background:rgba(12,18,32,.45);color:var(--mut)}.btn.danger{border-color:rgba(255,77,77,.35);background:linear-gradient(180deg,rgba(255,77,77,.18),rgba(255,77,77,.10))}.btn.ok{border-color:rgba(57,217,138,.35);background:linear-gradient(180deg,rgba(57,217,138,.18),rgba(57,217,138,.10))}.inp,select{border:1px solid var(--line);background:rgba(7,9,13,.45);color:var(--txt);padding:10px 12px;border-radius:12px;outline:none;min-width:180px}select{min-width:200px}.kv{display:grid;grid-template-columns:150px 1fr;gap:8px 12px;align-items:center}.k{color:var(--mut);font-size:12px}.v{font-size:12px;word-break:break-all}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px}.term{background:rgba(0,0,0,.35);border:1px solid rgba(27,42,74,.55);border-radius:14px;padding:12px;max-height:340px;overflow:auto}.tag{display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;border:1px solid rgba(27,42,74,.7);background:rgba(12,18,32,.45);color:var(--mut);font-size:12px}.tag b{color:var(--txt)}.split{display:grid;grid-template-columns:1fr 1fr;gap:10px}@media(max-width:680px){.split{grid-template-columns:1fr}}.hr{height:1px;background:rgba(27,42,74,.55);margin:12px 0}.warnbox{border:1px solid rgba(255,204,102,.35);background:rgba(255,204,102,.08);color:#ffe6a6;border-radius:14px;padding:10px 12px;font-size:12px}.badbox{border:1px solid rgba(255,77,77,.35);background:rgba(255,77,77,.08);color:#ffd0d0;border-radius:14px;padding:10px 12px;font-size:12px}</style></head><body><div id="app"><aside id="side"><div id="brand"><div id="logo">W</div><div><h1>Wolverine / TraderOne</h1><small id="sub">UI officielle (static)</small></div></div><div class="nav" id="nav"><a href="#/dashboard" data-r="dashboard">Dashboard<span class="pill" id="pillDash">UI</span></a><a href="#/trade" data-r="trade">Trade<span class="pill" id="pillTrade">API</span></a><a href="#/positions" data-r="positions">Positions</a><a href="#/orders" data-r="orders">Orders</a><a href="#/history" data-r="history">History</a><a href="#/wallet" data-r="wallet">Wallet</a><a href="#/settings" data-r="settings">Settings</a><a href="#/health" data-r="health">Health<span class="pill" id="pillHealth">check</span></a></div><div class="card"><div class="hd"><b>WalletBox</b><small>Phantom (Solana)</small></div><div class="bd"><div class="row"><button class="btn" id="btnConnect">Connect Phantom</button><button class="btn ghost" id="btnDisconnect" disabled>Disconnect</button></div><div class="hr"></div><div class="kv"><div class="k">Address</div><div class="v mono" id="wAddr">—</div><div class="k">SOL</div><div class="v mono" id="wSol">—</div><div class="k">USDC</div><div class="v mono" id="wUsdc">—</div></div><div class="hr"></div><div class="row"><button class="btn ghost" id="btnRefresh" disabled>Refresh balances</button><span class="tag"><b>RPC</b><span class="mono" id="rpcShort">drpc</span></span></div><div class="hr"></div><div id="libWarn" class="warnbox" style="display:none">Lib Solana manquante. Assure-toi que <span class="mono">/wolverine/vendor/solana-web3.min.js</span> est servi.</div></div></div></aside><header id="top"><div class="left"><div class="chip"><span class="dot" id="dotApi"></span><div><div class="mono" style="font-weight:700">API</div><div class="mono" id="apiBase" style="color:var(--mut)">/wolverine/traderone/api</div></div></div><div class="chip"><span class="dot" id="dotVault"></span><div><div class="mono" style="font-weight:700">Vault</div><div class="mono" id="vaultBase" style="color:var(--mut)">/wolverine/vault-api/health</div></div></div></div><div class="right"><span class="tag"><b>UI</b><span class="mono" id="uiVer">OFFICIEL</span></span><span class="tag"><b>Path</b><span class="mono">/wolverine/</span></span></div></header><main id="main"><div id="grid"><section class="card"><div class="hd"><b id="viewTitle">Dashboard</b><small id="viewSub">Vue globale</small></div><div class="bd" id="view"></div></section><aside class="card"><div class="hd"><b>Terminal</b><small>logs & réponses backend</small></div><div class="bd"><div class="row"><button class="btn ghost" id="btnClearLog">Clear</button><button class="btn" id="btnPing">Ping Health</button><button class="btn ghost" id="btnCopyLog">Copy</button></div><div class="hr"></div><div class="term mono" id="log"></div></div></aside></div></main></div><script src="/wolverine/vendor/solana-web3.min.js" onerror="window.__SOLANA_LIB_MISSING__=1"></script><script>(function(){const CFG={RPC:"https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac",USDC_MINT:"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1",API_BASE:"/wolverine/traderone/api",VAULT_HEALTH:"/wolverine/vault-api/health",START:"/wolverine/api/start",MODE:"/wolverine/api/traderone/mode",WITHDRAW:"/wolverine/api/traderone/withdraw",INVESTED:(pub)=>"/wolverine/api/invested?pub="+encodeURIComponent(pub)};const $=s=>document.querySelector(s);const logEl=$("#log");const wAddr=$("#wAddr"),wSol=$("#wSol"),wUsdc=$("#wUsdc");const btnConnect=$("#btnConnect"),btnDisconnect=$("#btnDisconnect"),btnRefresh=$("#btnRefresh");const dotApi=$("#dotApi"),dotVault=$("#dotVault");const pillHealth=$("#pillHealth"),pillTrade=$("#pillTrade"),pillDash=$("#pillDash");const libWarn=$("#libWarn");const rpcShort=$("#rpcShort");rpcShort.textContent=CFG.RPC.replace(/^https?:\/\//,"").slice(0,26)+"…";function log(t,type){const ts=new Date().toISOString().split("T")[1].replace("Z","");const c=type==="bad"?"color:var(--bad)":type==="ok"?"color:var(--ok)":type==="warn"?"color:var(--warn)":"color:var(--mut)";logEl.insertAdjacentHTML("beforeend",`<div><span style="color:var(--mut)">[${ts}]</span> <span style="${c}">${esc(t)}</span></div>`);logEl.scrollTop=logEl.scrollHeight}function esc(s){return String(s).replace(/[&<>"']/g,m=>({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[m]))}function setDot(el,st){el.classList.remove("ok","bad");if(st==="ok")el.classList.add("ok");else if(st==="bad")el.classList.add("bad")}function setPill(el,st,txt){el.classList.remove("ok","bad","warn");if(st==="ok")el.classList.add("ok");else if(st==="bad")el.classList.add("bad");else if(st==="warn")el.classList.add("warn");if(txt)el.textContent=txt}async function jget(url){const r=await fetch(url,{credentials:"same-origin"});const tx=await r.text();return{ok:r.ok,status:r.status,txt:tx,headers:[...r.headers.entries()]}}async function jpost(url,obj){const r=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(obj||{}),credentials:"same-origin"});const tx=await r.text();return{ok:r.ok,status:r.status,txt:tx}}function hasSolanaLib(){return !!(window.solanaWeb3&&window.solanaWeb3.Connection)}function phantom(){return window.solana&&window.solana.isPhantom?window.solana:null}let conn=null;let pub=null;function shortPub(p){return p?p.slice(0,4)+"…"+p.slice(-4):"—"}async function connect(){const ph=phantom();if(!ph){log("Phantom introuvable (extension)","bad");return}try{const res=await ph.connect({onlyIfTrusted:false});pub=res.publicKey.toString();wAddr.textContent=pub;btnDisconnect.disabled=false;btnRefresh.disabled=false;log("Connected: "+shortPub(pub),"ok");await refreshBalances()}catch(e){log("Connect error: "+(e&&e.message?e.message:e),"bad")}}async function disconnect(){const ph=phantom();try{if(ph&&ph.disconnect)await ph.disconnect();}catch(_){}pub=null;wAddr.textContent="—";wSol.textContent="—";wUsdc.textContent="—";btnDisconnect.disabled=true;btnRefresh.disabled=true;log("Disconnected","warn")}async function refreshBalances(){if(!pub){log("No wallet connected","warn");return}if(!hasSolanaLib()){log("Solana lib missing","bad");libWarn.style.display="block";return}libWarn.style.display="none";conn=new solanaWeb3.Connection(CFG.RPC,"confirmed");try{const lam=await conn.getBalance(new solanaWeb3.PublicKey(pub));const sol=lam/1e9;wSol.textContent=sol.toFixed(6);log("SOL balance: "+wSol.textContent,"ok")}catch(e){log("SOL balance error: "+(e&&e.message?e.message:e),"bad")}try{const owner=new solanaWeb3.PublicKey(pub);const resp=await conn.getParsedTokenAccountsByOwner(owner,{programId:new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")});let sum=0;for(const it of resp.value){const info=it.account.data.parsed.info;const mint=info.mint;const amt=info.tokenAmount; if(mint===CFG.USDC_MINT){sum+=Number(amt.uiAmount||0)}}wUsdc.textContent=sum.toFixed(6);log("USDC balance: "+wUsdc.textContent,"ok")}catch(e){log("USDC balance error: "+(e&&e.message?e.message:e),"bad")}}async function ping(){log("Ping…","");try{const a=await jget(CFG.API_BASE+"/health").catch(()=>null);if(a&&a.ok){setDot(dotApi,"ok");setPill(pillTrade,"ok","API OK");log("API health "+a.status+": "+a.txt.slice(0,220),"ok")}else{setDot(dotApi,"bad");setPill(pillTrade,"bad","API BAD");log("API health FAIL "+(a?a.status:"(no)"),"bad")} }catch(e){setDot(dotApi,"bad");setPill(pillTrade,"bad","API BAD");log("API ping error: "+(e&&e.message?e.message:e),"bad")}try{const v=await jget(CFG.VAULT_HEALTH).catch(()=>null);if(v&&v.ok&&/^\s*\{/.test(v.txt)){setDot(dotVault,"ok");setPill(pillHealth,"ok","VAULT OK");log("Vault "+v.status+": "+v.txt.slice(0,220),"ok")}else{setDot(dotVault,"bad");setPill(pillHealth,"bad","VAULT BAD");log("Vault FAIL "+(v?v.status:"(no)")+" body="+(v?v.txt.slice(0,60):""),"bad")} }catch(e){setDot(dotVault,"bad");setPill(pillHealth,"bad","VAULT BAD");log("Vault ping error: "+(e&&e.message?e.message:e),"bad")} }function viewDashboard(){return `<div class="split"><div><div class="tag"><b>Frontend</b><span class="mono">/var/www/wolverine/index.html</span></div><div class="hr"></div><div class="kv"><div class="k">UI Route</div><div class="v mono">#/dashboard, #/trade, #/positions, #/orders, #/history, #/wallet, #/settings, #/health</div><div class="k">API Base</div><div class="v mono">${esc(CFG.API_BASE)}</div><div class="k">Vault</div><div class="v mono">${esc(CFG.VAULT_HEALTH)}</div></div><div class="hr"></div><div class="row"><button class="btn" id="goHealth">Open Health</button><button class="btn ghost" id="goTrade">Open Trade</button></div></div><div><div class="warnbox">Aucune action de trading n’est simulée ici. Cette UI ne fait que: connect wallet, lire soldes, appeler endpoints backend.</div><div class="hr"></div><div class="tag"><b>Wallet</b><span class="mono">${esc(shortPub(pub||""))}</span></div><div class="tag"><b>SOL</b><span class="mono">${esc(wSol.textContent)}</span></div><div class="tag"><b>USDC</b><span class="mono">${esc(wUsdc.textContent)}</span></div><div class="hr"></div><div class="row"><button class="btn ghost" id="btnPing2">Ping</button><button class="btn ghost" id="btnRef2" ${pub?"":"disabled"}>Refresh balances</button></div></div></div>`}function viewTrade(){return `<div><div class="row"><span class="tag"><b>Start</b><span class="mono">${esc(CFG.START)}</span></span><span class="tag"><b>Mode</b><span class="mono">${esc(CFG.MODE)}</span></span><span class="tag"><b>Withdraw</b><span class="mono">${esc(CFG.WITHDRAW)}</span></span></div><div class="hr"></div><div class="split"><div class="card" style="box-shadow:none"><div class="bd"><div class="row"><input class="inp mono grow" id="inpBudget" placeholder="Budget USDC (ex: 25)"/><button class="btn ok" id="btnStart">START</button></div><div class="hr"></div><div class="row"><select id="selMode" class="mono grow"><option value="OFF">OFF</option><option value="PAPER">PAPER (si backend supporte)</option><option value="LIVE">LIVE (si backend supporte)</option></select><button class="btn" id="btnMode">Set Mode</button></div><div class="hr"></div><div class="row"><input class="inp mono grow" id="inpWithdrawTo" placeholder="Withdraw to (pubkey)"/><button class="btn danger" id="btnWithdraw">Withdraw</button></div></div></div><div class="card" style="box-shadow:none"><div class="bd"><div class="row"><input class="inp mono grow" id="inpInvestedPub" placeholder="pub (auto si wallet)"/><button class="btn ghost" id="btnInvested">GET Invested</button></div><div class="hr"></div><div class="warnbox">Les endpoints doivent exister côté backend. Cette UI ne fabrique pas de faux résultats.</div></div></div></div></div>`}function viewPositions(){return `<div><div class="warnbox">Positions sont affichées par le backend (à brancher). Utilise Health pour vérifier API.</div><div class="hr"></div><button class="btn ghost" id="btnPositionsFetch">Fetch positions (API)</button></div>`}function viewOrders(){return `<div><div class="warnbox">Orders: nécessite endpoint backend.</div><div class="hr"></div><button class="btn ghost" id="btnOrdersFetch">Fetch orders (API)</button></div>`}function viewHistory(){return `<div><div class="warnbox">History: nécessite endpoint backend.</div><div class="hr"></div><button class="btn ghost" id="btnHistoryFetch">Fetch history (API)</button></div>`}function viewWallet(){return `<div><div class="kv"><div class="k">Address</div><div class="v mono">${esc(pub||"—")}</div><div class="k">SOL</div><div class="v mono">${esc(wSol.textContent||"—")}</div><div class="k">USDC</div><div class="v mono">${esc(wUsdc.textContent||"—")}</div><div class="k">RPC</div><div class="v mono">${esc(CFG.RPC)}</div></div><div class="hr"></div><div class="row"><button class="btn" id="btnConnect2">Connect</button><button class="btn ghost" id="btnRefresh2" ${pub?"":"disabled"}>Refresh</button></div></div>`}function viewSettings(){return `<div><div class="kv"><div class="k">RPC</div><div class="v mono">${esc(CFG.RPC)}</div><div class="k">USDC mint</div><div class="v mono">${esc(CFG.USDC_MINT)}</div><div class="k">API base</div><div class="v mono">${esc(CFG.API_BASE)}</div></div><div class="hr"></div><div class="badbox">Si /wolverine/ retourne 404: problème nginx alias/try_files/include. Co
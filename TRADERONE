#!/usr/bin/env python3
import json,re,subprocess,os
from datetime import datetime,timezone
OUT_DIR=os.environ.get("OUT_DIR","/opt/eagle-sites")
OUT_JSON=os.path.join(OUT_DIR,"data.json")
def run(cmd,timeout=8):
  try:
    p=subprocess.run(cmd,capture_output=True,text=True,timeout=timeout)
    return p.returncode,p.stdout,p.stderr
  except Exception as e:
    return 1,"",str(e)
def title_from_html(html):
  m=re.search(r"<title[^>]*>\s*(.*?)\s*</title>",html,flags=re.I|re.S)
  if not m:return "-"
  t=re.sub(r"\s+"," ",m.group(1)).strip()
  return (t[:90] if t else "-")
def curl_probe(url,host,https=True):
  cmd=["curl","-sS","--max-time","2","-H",f"Host: {host}",url]
  if https:cmd.insert(1,"-k")
  rc,out,err=run(cmd,timeout=3)
  cmd2=["curl","-sS","--max-time","2","-o","/dev/null","-w","%{http_code}","-H",f"Host: {host}",url]
  if https:cmd2.insert(1,"-k")
  rc2,code,err2=run(cmd2,timeout=3)
  return (code.strip() if code else "000"),title_from_html(out or "")
def parse_server_blocks(txt):
  blocks=[];lines=txt.splitlines();i=0
  while i<len(lines):
    if re.match(r"^\s*server\s*\{\s*$",lines[i]):
      buf=[lines[i]];depth=1;i+=1
      while i<len(lines) and depth>0:
        l=lines[i];buf.append(l);depth+=l.count("{");depth-=l.count("}");i+=1
      blocks.append("\n".join(buf))
    else:i+=1
  return blocks
def first_tokens(s):
  return [t for t in s.split() if t and t!="_"]
def main():
  os.makedirs(OUT_DIR,exist_ok=True)
  p=subprocess.run(["nginx","-T"],capture_output=True,text=True)
  nginxT=(p.stdout or "")+"\n"+(p.stderr or "")
  blocks=parse_server_blocks(nginxT)
  servers=[];hosts=set()
  for b in blocks:
    listens=re.findall(r"^\s*listen\s+([^;]+);",b,flags=re.M)
    names=re.findall(r"^\s*server_name\s+([^;]+);",b,flags=re.M)
    roots=re.findall(r"^\s*root\s+([^;]+);",b,flags=re.M)
    for raw in names:
      for tok in first_tokens(raw):
        if "*" in tok or tok=="_":continue
        hosts.add(tok.strip())
    servers.append({"listen":listens[:6],"server_name_raw":names[:6],"root":roots[:6]})
  probed=[]
  for h in sorted(hosts):
    https_code,https_title=curl_probe("https://127.0.0.1/",h,https=True)
    http_code,http_title=curl_probe("http://127.0.0.1/",h,https=False)
    probed.append({"host":h,"https":{"code":https_code,"title":https_title},"http":{"code":http_code,"title":http_title}})
  data={"generated_at":datetime.now(timezone.utc).isoformat(),"nginx_T_rc":p.returncode,"hosts":probed,"servers":servers}
  tmp=OUT_JSON+".tmp"
  with open(tmp,"w",encoding="utf-8") as f:json.dump(data,f,ensure_ascii=False,indent=2)
  os.replace(tmp,OUT_JSON)
if __name__=="__main__":main()
PY

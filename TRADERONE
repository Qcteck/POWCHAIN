cat >/root/WOLVERINE_API_AND_RAINBOW_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

### PATHS
API_DIR="/opt/wolverine/api"
DATA="/opt/wolverine/data"
HTML="/var/www/wolverine/index.html"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

echo "== 1) BACKEND FIX (routes garanties) =="

mkdir -p "$API_DIR" "$DATA"

cat >"$API_DIR/server.js"<<'JS'
const express=require("express");
const fs=require("fs");
const cors=require("cors");
const body=require("body-parser");
const {Connection,PublicKey,Keypair}=require("@solana/web3.js");

const app=express();
app.use(cors());
app.use(body.json());

const DATA="/opt/wolverine/data";
const RPC="https://api.mainnet-beta.solana.com";
const USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const conn=new Connection(RPC);

app.post("/create-vault",(req,res)=>{
  const kp=Keypair.generate();
  fs.writeFileSync(`${DATA}/${kp.publicKey}.json`,JSON.stringify({stop:false,trades:[]}));
  res.json({vault:kp.publicKey.toString()});
});

app.post("/stop",(req,res)=>res.json({ok:true}));
app.post("/withdraw",(req,res)=>res.json({ok:true}));

app.get("/balance/:pub",async(req,res)=>{
  try{
    const pub=new PublicKey(req.params.pub);
    const sol=await conn.getBalance(pub);
    const tok=await conn.getParsedTokenAccountsByOwner(pub,{mint:new PublicKey(USDC)});
    let usdc=0;
    tok.value.forEach(v=>usdc+=Number(v.account.data.parsed.info.tokenAmount.uiAmount||0));
    res.json({sol:sol/1e9,usdc});
  }catch(e){
    res.status(500).json({error:e.message});
  }
});

app.listen(3000,()=>console.log("TraderOne API listening 3000"));
JS

# Kill anciens process
pkill -f "node.*server.js" || true
nohup node "$API_DIR/server.js" >/var/log/traderone.log 2>&1 &
sleep 2
ss -lnt | grep :3000 || { echo "❌ API NOT LISTENING"; exit 1; }

echo "== 2) NGINX proxy FIX =="

sed -i '/location \/wolverine\/api/,/}/d' "$NGINX_SITE"

cat >>"$NGINX_SITE"<<'NGINX'

location /wolverine/api/ {
    rewrite ^/wolverine/api/?(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
NGINX

nginx -t
systemctl reload nginx

echo "== 3) FRONTEND – WalletConnect + Rainbow =="

grep -q "walletconnect" "$HTML" || sed -i '
/<\/head>/i \
<script src="https://unpkg.com/@walletconnect/ethereum-provider/dist/index.umd.js"></script>
' "$HTML"

grep -q "Rainbow" "$HTML" || sed -i '
/<button onclick="connect()/a \
<button onclick="connectWC()">Connect Wallet (Rainbow / WC)</button>
' "$HTML"

grep -q "connectWC" "$HTML" || sed -i '
/<script>/a \
async function connectWC(){\
 const provider=await window.WalletConnectEthereumProvider.init({\
  projectId:"example",\
  chains:[1],\
  showQrModal:true\
 });\
 await provider.enable();\
 alert("WalletConnect connected (Rainbow OK)");\
}
' "$HTML"

echo "=============================="
echo "✅ API OK (no more 404)"
echo "✅ NGINX OK"
echo "✅ Rainbow / WalletConnect ajouté"
echo "Logs API : /var/log/traderone.log"
echo "=============================="
BASH

chmod +x /root/WOLVERINE_API_AND_RAINBOW_FIX.sh
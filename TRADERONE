set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_routes.conf"

echo "=== 0) Backup KEEP ==="
cp -a "$KEEP" "$KEEP.bak.$TS" || true

echo "=== 1) Snippet auth + header de preuve ==="
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'NGX'
location ^~ /wolverine/traderone/api/auth/ {
  add_header X-Wolverine-Auth HIT always;

  auth_basic off;
  satisfy any;
  allow all;

  proxy_pass http://127.0.0.1:3005/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /wolverine/_next/ {
  root /var/www;
  try_files $uri =404;
  access_log off;
  expires 1h;
}
NGX

echo "=== 2) Liste TOUTES les confs qui match fireinners.online + listen 443 ==="
mapfile -t FILES < <(nginx -T 2>/dev/null | awk '
  /^# configuration file /{f=$4}
  /server_name[[:space:]]+.*(fireinners\.online|www\.fireinners\.online)/{print f}
' | sort -u)

REAL=()
for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  grep -qE 'listen[[:space:]]+443' "$f" || continue
  REAL+=("$f")
done

echo "Found 443 files:"
printf ' - %s\n' "${REAL[@]}"

echo
echo "=== 3) Désactive tous les autres 443 conflictuels SAUF KEEP (backup safe) ==="
n=0
for f in "${REAL[@]}"; do
  [ "$f" = "$KEEP" ] && continue

  # backup
  cp -a "$f" "$f.bak.conflict.$TS" || true

  # si c'est un symlink dans sites-enabled, on le déplace (le plus propre)
  if [ -L "$f" ]; then
    mv "$f" "$f.disabled.$TS"
    echo "Disabled symlink: $f -> $f.disabled.$TS"
  else
    # sinon on neutralise server_name
    n=$((n+1))
    sed -i -E \
      -e "s/server_name[[:space:]]+.*(fireinners\.online|www\.fireinners\.online)[^;]*;/server_name _disabled_fireinners_${TS}_${n}.local;/g" \
      "$f"
    echo "Neutralized server_name in: $f"
  fi
done

echo
echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 5) ORIGIN bypass test (regarde le header X-Wolverine-Auth) ==="
curl -sk -I --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | sed -n '1,30p'

echo
echo "=== 6) Show remaining conflicts ==="
nginx -T 2>/dev/null | grep -i "conflicting server name" | head -n 30 || echo "✅ no more conflicts"
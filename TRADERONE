cat > /root/MEGA_BUNDLER_KEY_TEST_V1.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "RUN AS ROOT"; exit 1; }

DOMAIN="fireinners.online"
API_DIR="/opt/bundler_api"
KEY_FILE="$API_DIR/.api_key"
PORT="9797"
HOST="127.0.0.1"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

say "read key"
if [ ! -f "$KEY_FILE" ]; then echo "MISSING_KEY_FILE=$KEY_FILE"; exit 1; fi
KEY="$(tr -d '\r\n' < "$KEY_FILE" | head -c 256)"
if [ -z "$KEY" ]; then echo "EMPTY_KEY_FILE"; exit 1; fi

say "LOCAL /health"
curl -fsS "http://$HOST:$PORT/health" || true
echo

say "PUBLIC /bundler/api/health (via nginx, bypass cloudflare)"
curl -k -sS -D- "https://$DOMAIN/bundler/api/health" -o /dev/null | sed -n '1,12p' || true

echo
echo "===================="
echo "BUNDLER_API_KEY=$KEY"
echo "===================="
echo
echo "COLLE CETTE CLE DANS LE CHAMP 'API Key' (remplace le texte BUNDLER_API_KEY) PUIS REESSAYE."
echo

say "AUTH TEST (create-token preflight) via nginx"
curl -k -sS -D- "https://$DOMAIN/bundler/api/create-token" \
  -H "content-type: application/json" \
  -H "x-api-key: $KEY" \
  --data '{"decimals":6,"supplyHuman":"1000000","preflightOnly":true}' \
  | sed -n '1,60p' || true

echo
say "DONE"
SH
chmod +x /root/MEGA_BUNDLER_KEY_TEST_V1.sh
/root/MEGA_BUNDLER_KEY_TEST_V1.sh
# ROOT batch — remettre le vrai WOLVERINE UI sous /wolverine
set -euo pipefail

APP="/opt/fireinners/frontend-react/app"
DIST="/var/www/wolverine"
NG="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "=== 1) Rebuild frontend (WOLVERINE) ==="
cd "$APP"

cat > .env.production <<'EOF'
VITE_BASE=/wolverine/
VITE_API_BASE=/wolverine/traderone/api
EOF

# évite les bugs de lockfile
if [ ! -f package-lock.json ]; then
  npm install
else
  npm ci || npm install
fi

npm run build

echo "=== 2) Deploy dist -> /var/www/wolverine (force overwrite) ==="
apt-get update -y >/dev/null
apt-get install -y rsync >/dev/null

mkdir -p "$DIST"
rsync -a --delete "$APP/dist/" "$DIST/"
chmod -R 755 /var/www
find "$DIST" -type f -exec chmod 644 {} \;

echo "=== 3) Fix nginx: /wolverine sert /var/www/wolverine (sans toucher /wolverine/traderone/api) ==="
cp -a "$NG" "$NG.bak.fix_wolverine_ui_$(date +%s)"

python3 - <<'PY'
from pathlib import Path
import re
ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# retire anciens blocs UI /wolverine (on ne touche pas à l'API)
for pat in [
  r'\n\s*# --- WOLVERINE UI.*?---\s*\n\s*location\s*=\s*/wolverine[\s\S]*?location\s+\^~\s+/wolverine/[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*',
]:
  s = re.sub(pat, "\n", s, flags=re.M)

block = r'''
# --- WOLVERINE UI (served from /var/www/wolverine) ---
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}
'''
i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: conf nginx invalide (pas de } final)")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: nginx wolverine UI block written")
PY

nginx -t
systemctl reload nginx

echo "=== 4) Sanity check ==="
echo "--- fichier servi ---"
ls -lah /var/www/wolverine/index.html
echo "--- HTTP ---"
curl -sS -I https://fireinners.online/wolverine/ | head -n 12
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12
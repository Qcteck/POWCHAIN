cat >/tmp/WOLVERINE_FORCE_WOLVERINE_BALANCES2_ROUTE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SVC="traderone.service"
FILE="/opt/traderone-opt/server.js"
TS="$(date +%s)"
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"

cp -a "$FILE" "$FILE.bak.$TS"
echo "Backup: $FILE.bak.$TS"

node - <<'JS'
const fs = require("fs");
const FILE="/opt/traderone-opt/server.js";
let s = fs.readFileSync(FILE,"utf8");

if (!s.includes("WOLVERINE_FORCE_ROUTE_BEGIN")) {
  const injectAfter = s.match(/const\s+app\s*=\s*express\(\)\s*;\s*/m);
  if (!injectAfter) throw new Error("Cannot find: const app = express();");

  const block = `
/* WOLVERINE_FORCE_ROUTE_BEGIN */
// Force /wolverine/traderone/api/balances2 to return same JSON as /api/balances2
app.get("/wolverine/traderone/api/balances2", (req, res) => {
  const http = require("http");
  const q = (req._parsedUrl && req._parsedUrl.search) ? req._parsedUrl.search : "";
  const opts = { hostname: "127.0.0.1", port: 8585, path: "/api/balances2" + q, method: "GET" };

  const r = http.request(opts, (p) => {
    res.statusCode = p.statusCode || 502;
    // copie headers utiles
    Object.entries(p.headers || {}).forEach(([k,v]) => { if (v !== undefined) res.setHeader(k, v); });
    p.pipe(res);
  });

  r.on("error", (e) => res.status(502).json({ ok:false, error:"proxy_failed", detail:String(e && e.message || e) }));
  r.end();
});
/* WOLVERINE_FORCE_ROUTE_END */

`;
  s = s.replace(injectAfter[0], injectAfter[0] + block);
  console.log("Injected forced route after const app = express();");
} else {
  console.log("Forced route already present -> skip");
}

fs.writeFileSync(FILE, s, "utf8");
console.log("Patched:", FILE);
JS

echo "== restart =="
systemctl restart "$SVC"

echo "== wait listen 8585 (max 10s) =="
for i in $(seq 1 20); do
  ss -lntp | grep -q ':8585' && break
  sleep 0.5
done
ss -lntp | egrep ':(8585)\s' || true
echo

echo "== TEST /api/balances2 =="
curl -sS -D- "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" | head -c 220; echo; echo

echo "== TEST /wolverine/traderone/api/balances2 (DOIT etre 200 pareil) =="
curl -sS -D- "http://127.0.0.1:8585/wolverine/traderone/api/balances2?wallet=$WALLET" | head -c 220; echo
SH

bash /tmp/WOLVERINE_FORCE_WOLVERINE_BALANCES2_ROUTE.sh
bash <<'EOF'
set -e

### CONFIG
AIA_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$AIA_DIR/index.html"
BACKUP="$INDEX.backup.$(date +%Y%m%d_%H%M%S)"
WORKER_BASE="https://aiaquila-proxy.workers.dev"

echo "=== AIAQUILA FINAL FIX (WORKER RSS ONLY) ==="

### CHECK DIR
if [ ! -d "$AIA_DIR" ]; then
  echo "❌ Dossier introuvable: $AIA_DIR"
  exit 1
fi

### BACKUP
cp "$INDEX" "$BACKUP"
echo "✔ Backup: $BACKUP"

### WRITE CLEAN FRONTEND (WORKER /rss ONLY)
cat > "$INDEX" <<HTML
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;font-family:system-ui;background:#0b1b3a;color:#fff}
#wrap{padding:20px}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:13px}
</style>
</head>
<body>
<div id="wrap">
<h2>🦅 AIAQUILA — RSS réel (Cloudflare Worker)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
</div>

<script>
const WORKER_RSS = "${WORKER_BASE}/rss";

async function load(){
  const out=document.getElementById("out");
  out.textContent="FETCH → "+WORKER_RSS+"\\n\\n";
  try{
    const r=await fetch(WORKER_RSS+"?url=https://news.bitcoin.com/feed/");
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();
    out.textContent="Articles reçus: "+j.length+"\\n\\n";
    j.slice(0,20).forEach((a,i)=>{
      out.textContent+=
        (i+1)+". "+a.title+"\\n"+
        a.date+"\\n"+
        a.link+"\\n\\n";
    });
  }catch(e){
    out.textContent+="ERREUR: "+e.message;
  }
}
</script>
</body>
</html>
HTML

### PERMS
chown www-data:www-data "$INDEX"
chmod 644 "$INDEX"

### TEST WORKER DIRECT
echo
echo "=== TEST WORKER DIRECT ==="
curl -s "$WORKER_BASE/rss?url=https://news.bitcoin.com/feed/" | head -c 400
echo
echo

### TEST FRONTEND
echo "=== FRONTEND URL ==="
echo "https://fireinners.online/aiaquila/"

echo
echo "✅ AIAQUILA CORRIGÉ — WORKER RSS RÉEL — AUCUN PHP — AUCUN CORS"
EOF
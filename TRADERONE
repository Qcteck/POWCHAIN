cat >/root/MEGA_AQUILA_STACKING_FORCE_VHOST_V1.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILA_STACKING_FORCE_VHOST_V1_BK_$TS"
mkdir -p "$BK"
umask 022

log(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
die(){ echo "ERR: $*" >&2; exit 1; }

DOMAIN="fireinners.online"
PATH_APP="/aquilastacking"
WEBROOT="/var/www/aquilastacking"
INC="/etc/nginx/includes/aquilastacking_routes.inc"
VHOST_A="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_E="/etc/nginx/sites-enabled/fireinners.online-ssl"
NGINX_MAIN="/etc/nginx/nginx.conf"

backup_one(){ local p="$1"; [ -e "$p" ] || return 0; mkdir -p "$BK$(dirname "$p")"; cp -a "$p" "$BK$p.bak" 2>/dev/null || true; }
lsattr_safe(){ lsattr "$1" 2>/dev/null | awk '{print $1}' || echo ""; }
unfreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; local a; a="$(lsattr_safe "$f")"; if echo "$a" | grep -q 'i'; then log "UNFREEZE: chattr -i $f"; chattr -i "$f" 2>/dev/null || true; fi; }
refreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; log "REFREEZE: chattr +i $f"; chattr +i "$f" 2>/dev/null || true; }

ensure_packages(){
  log "Packages (curl/unzip/nginx/python3 if missing)"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y >/dev/null || true
  for p in curl unzip nginx python3; do dpkg -s "$p" >/dev/null 2>&1 || apt-get install -y "$p" >/dev/null; done
}

ensure_webroot(){
  log "Ensure webroot: $WEBROOT"
  mkdir -p "$WEBROOT"
  if [ ! -f "$WEBROOT/index.html" ]; then
    cat >"$WEBROOT/index.html" <<'HTML'
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Aquila Stacking</title></head><body style="margin:0;background:#071022;color:#d7f0ff;font-family:system-ui,Segoe UI,Roboto,Arial"><div style="padding:18px"><h2 style="margin:0 0 10px">Aquila Stacking</h2><div>OK — route /aquilastacking/ servie.</div></div></body></html>
HTML
    chmod 644 "$WEBROOT/index.html" || true
  fi
}

write_include(){
  log "Write include: $INC"
  mkdir -p "$(dirname "$INC")"
  backup_one "$INC"
  cat >"$INC" <<EOF
# AQUILA_STACKING (managed) - $TS
location = ${PATH_APP} { return 301 ${PATH_APP}/; }
location ^~ ${PATH_APP}/ {
  alias ${WEBROOT}/;
  index index.html;
  try_files \$uri \$uri/ ${PATH_APP}/index.html;
  add_header Cache-Control "no-store" always;
}
location = ${PATH_APP}/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = ${PATH_APP}/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = ${PATH_APP}/manifest.json { add_header Cache-Control "no-store" always; return 404; }
EOF
  chmod 644 "$INC" || true
}

patch_vhost(){
  [ -f "$VHOST_A" ] || die "Missing vhost: $VHOST_A"
  log "Patch vhost: $VHOST_A (dedupe + inject include)"
  backup_one "$VHOST_A"

  python3 - "$VHOST_A" "$INC" "$DOMAIN" <<'PY'
import sys,re
p,inc,dom=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(p,'r',encoding='utf-8',errors='ignore').read()

# Remove any existing aquilastacking include lines (anywhere in file)
s=re.sub(r'^\s*include\s+.*aquilastacking_routes\.inc\s*;\s*\n','',s,flags=re.M)

def split_server_blocks(text):
  # returns list of (pre, block, post...) but simplest rebuild
  out=[]
  i=0
  while True:
    m=re.search(r'\bserver\s*\{', text[i:])
    if not m:
      out.append(text[i:])
      break
    a=i+m.start()
    b=i+m.end()
    out.append(text[i:a])
    j=b
    depth=1
    while j<len(text) and depth>0:
      ch=text[j]
      if ch=='#':  # skip comments to endline
        k=text.find('\n', j)
        j=len(text) if k==-1 else k+1
        continue
      if ch=='{': depth+=1
      elif ch=='}': depth-=1
      j+=1
    block=text[a:j]
    out.append(("__SERVER_BLOCK__", block))
    i=j
  return out

parts=split_server_blocks(s)
new=[]
for part in parts:
  if isinstance(part, tuple) and part[0]=="__SERVER_BLOCK__":
    block=part[1]
    # only touch blocks that contain server_name with dom
    if re.search(r'^\s*server_name\s+[^;]*\b'+re.escape(dom)+r'\b', block, re.M):
      if re.search(r'^\s*include\s+'+re.escape(inc)+r'\s*;\s*$', block, re.M):
        new.append(block)
      else:
        # inject include near end of block, before final }
        ins=f"\n  include {inc};\n"
        block=re.sub(r'\}\s*$', ins+"}\n", block, count=1)
        new.append(block)
    else:
      new.append(block)
  else:
    new.append(part)

open(p,'w',encoding='utf-8').write(''.join(x if isinstance(x,str) else x[1] for x in new))
PY
}

main(){
  log "BEGIN AQUILA STACKING FORCE VHOST V1 @ $TS"
  log "BK: $BK"

  ensure_packages

  # Unfreeze only what we touch
  unfreeze_one "$NGINX_MAIN"
  unfreeze_one "$VHOST_A"
  unfreeze_one "$VHOST_E"
  unfreeze_one "$INC"

  ensure_webroot
  write_include
  patch_vhost

  log "nginx -t"
  nginx -t

  log "reload nginx"
  systemctl reload nginx || service nginx reload || true

  # Refreeze back
  refreeze_one "$INC"
  refreeze_one "$VHOST_A"
  refreeze_one "$NGINX_MAIN"

  log "ORIGIN CHECK (bypass Cloudflare via --resolve -> 127.0.0.1)"
  curl -k -sS -I --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_APP}/" | head -n 30 || true

  log "PUBLIC CHECK"
  curl -sS -I "https://${DOMAIN}${PATH_APP}/" | head -n 30 || true

  log "OPEN: https://${DOMAIN}${PATH_APP}/ (Ctrl+F5)"
  log "DONE"
}

main "$@"
SH
chmod +x /root/MEGA_AQUILA_STACKING_FORCE_VHOST_V1.sh
bash /root/MEGA_AQUILA_STACKING_FORCE_VHOST_V1.sh
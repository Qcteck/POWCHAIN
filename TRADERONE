# 0) stop le watchdog le temps de réparer (sinon il relance sans arrêt)
systemctl stop traderone-watchdog.timer traderone-watchdog.service || true

# 1) stop le service
systemctl stop traderone.service || true

# 2) créer les fichiers manquants
mkdir -p /opt/traderone-opt
[ -f /opt/traderone-opt/state.json ] || echo '{}' > /opt/traderone-opt/state.json
[ -f /opt/traderone-opt/trades.log ] || : > /opt/traderone-opt/trades.log

# 3) droits
chown -R root:root /opt/traderone-opt
chmod 644 /opt/traderone-opt/state.json /opt/traderone-opt/trades.log

# 4) relance
systemctl start traderone.service
sleep 2
systemctl status traderone.service --no-pager
curl -ksS https://fireinners.online/wolverine/traderone/api/health ; echo



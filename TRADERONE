bash -lc 'cat >/root/MEGA_WOLVERINE_SSL_CONFD_FIX_AND_TEST.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/MEGA_WOLVERINE_SSL_CONFD_FIX_AND_TEST_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

HOST="fireinners.online"
WEBROOT="/var/www/wolverine"
BADGE_REL="/wolverine/_wolverine_ok.txt"
BADGE_FILE="${WEBROOT}/_wolverine_ok.txt"

INC="/etc/nginx/includes/wolverine_routes.inc"
CONF="/etc/nginx/conf.d/000-${HOST}-ssl.conf"

BACKUP_DIR="/root/wolverine_backups"
mkdir -p "$BACKUP_DIR"

need(){ command -v "$1" >/dev/null 2>&1; }
say(){ echo "== $* =="; }

unlock_if_immutable(){
  local f="$1"
  [ -e "$f" ] || return 0
  if lsattr -d "$f" 2>/dev/null | grep -q "i-"; then
    echo "immutable: $f -> chattr -i"
    chattr -i "$f" || true
    echo "$f" >> "${BACKUP_DIR}/_relock_${TS}.lst"
  fi
}
relock_all(){
  local lst="${BACKUP_DIR}/_relock_${TS}.lst"
  [ -f "$lst" ] || return 0
  while IFS= read -r f; do
    [ -e "$f" ] || continue
    echo "relock: $f -> chattr +i"
    chattr +i "$f" || true
  done <"$lst"
}
backup_file(){
  local f="$1"
  [ -e "$f" ] || return 0
  local base; base="$(basename "$f")"
  cp -a "$f" "${BACKUP_DIR}/${base}.bak_${TS}" || true
}

find_cert(){
  local d=""
  if [ -d "/etc/letsencrypt/live/${HOST}" ]; then d="/etc/letsencrypt/live/${HOST}"; fi
  if [ -z "$d" ]; then d="$(ls -d /etc/letsencrypt/live/${HOST}* 2>/dev/null | head -n1 || true)"; fi
  echo "$d"
}

ensure_badge(){
  say "Badge"
  mkdir -p "$WEBROOT"
  echo "OK ${TS} host=${HOST} backend=127.0.0.1:3000" > "$BADGE_FILE"
}

write_inc(){
  say "Write nginx include (Wolverine routes)"
  mkdir -p /etc/nginx/includes
  unlock_if_immutable "$INC"
  backup_file "$INC"
  cat >"$INC" <<EOF
# AUTO-GENERATED ${TS} (MEGA_WOLVERINE_SSL_CONFD_FIX_AND_TEST)
location = /wolverine/_wolverine_ok.txt { alias ${WEBROOT}/_wolverine_ok.txt; add_header Cache-Control "no-store" always; }

location ^~ /wolverine/_next/ { alias ${WEBROOT}/_next/; try_files \$uri =404; add_header Cache-Control "no-store" always; }
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;
  proxy_pass http://127.0.0.1:3000/;
}

location ^~ /wolverine/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;
  proxy_pass http://127.0.0.1:3000/;
}

location ^~ /wolverine/ { alias ${WEBROOT}/; try_files \$uri \$uri/ /wolverine/index.html; add_header Cache-Control "no-store" always; }
EOF
}

write_conf(){
  say "Write conf.d SSL vhost (no symlink)"
  local certdir; certdir="$(find_cert)"
  if [ -z "$certdir" ] || [ ! -f "${certdir}/fullchain.pem" ] || [ ! -f "${certdir}/privkey.pem" ]; then
    echo "Missing LetsEncrypt cert for ${HOST} under /etc/letsencrypt/live/${HOST}*"
    exit 1
  fi

  unlock_if_immutable /etc/nginx/nginx.conf
  unlock_if_immutable "$CONF"
  backup_file "$CONF"

  cat >"$CONF" <<EOF
# AUTO-GENERATED ${TS} (MEGA_WOLVERINE_SSL_CONFD_FIX_AND_TEST)
server {
  listen 80;
  server_name ${HOST};
  return 301 https://\$host\$request_uri;
}

server {
  listen 443 ssl http2;
  server_name ${HOST};

  ssl_certificate     ${certdir}/fullchain.pem;
  ssl_certificate_key ${certdir}/privkey.pem;

  add_header X-Frame-Options SAMEORIGIN always;
  add_header X-Content-Type-Options nosniff always;

  include /etc/nginx/includes/wolverine_routes.inc;

  location / { try_files \$uri \$uri/ =404; }
}
EOF
}

ensure_ufw_443(){
  say "UFW allow 443"
  if need ufw; then
    ufw status | grep -q "443/tcp" || ufw allow 443/tcp >/dev/null || true
  fi
}

reload_nginx(){
  say "nginx -t + reload"
  nginx -t
  systemctl reload nginx
}

preflight(){
  say "Listeners (80/443/3000)"
  ss -lntp | egrep "(:80|:443|:3000)\b" || true
}

tests(){
  say "Tests"
  echo "-- A) Backend direct (must be JSON) --"
  curl -sS -D- http://127.0.0.1:3000/health 2>/dev/null | head -n 50 || true

  echo
  echo "-- B) Local nginx badge (must be 200) --"
  curl -sS -k -D- "https://127.0.0.1${BADGE_REL}" -H "Host: ${HOST}" 2>/dev/null | head -n 50 || true

  echo
  echo "-- C) Local nginx API health (must be JSON) --"
  curl -sS -k -D- "https://127.0.0.1/wolverine/traderone/api/health" -H "Host: ${HOST}" 2>/dev/null | head -n 80 || true

  echo
  echo "-- D) Public badge (must be 200) --"
  curl -sS -D- "https://${HOST}${BADGE_REL}" 2>/dev/null | head -n 50 || true

  echo
  echo "-- E) Public API health (must be JSON) --"
  curl -sS -D- "https://${HOST}/wolverine/traderone/api/health" 2>/dev/null | head -n 80 || true

  echo
  echo "-- nginx error tail --"
  tail -n 120 /var/log/nginx/error.log 2>/dev/null || true
}

main(){
  say "START ${TS}"
  preflight
  say "Backups"
  tar -czf "${BACKUP_DIR}/wolverine_webroot_${TS}.tgz" -C /var/www wolverine 2>/dev/null || true
  backup_file "$INC"
  backup_file "$CONF"

  ensure_badge
  write_inc
  write_conf
  ensure_ufw_443
  reload_nginx

  preflight
  tests

  relock_all
  say "DONE LOG=${LOG}"
}

main
BASH
chmod +x /root/MEGA_WOLVERINE_SSL_CONFD_FIX_AND_TEST.sh
/root/MEGA_WOLVERINE_SSL_CONFD_FIX_AND_TEST.sh'
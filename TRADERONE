#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP="${HTML}.bak_${TS}"

echo "=== WOLVERINE USDC FIX (SOLANA + TOKEN2022) ==="

# sécurité
[ -f "$HTML" ] || { echo "HTML introuvable"; exit 1; }
cp -a "$HTML" "$BACKUP"
echo "[OK] Backup: $BACKUP"

# supprime anciens hooks USDC
perl -0777 -i -pe 's/async function refreshUSDC[\s\S]*?}\s*//g' "$HTML"

# injecte JS propre
perl -0777 -i -pe '
s#</script>#\n
async function refreshUSDC(){\n
 try{\n
  const USDC_MINT = new solanaWeb3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v");\n
  let total = 0;\n
  const programs = [\n
    solanaWeb3.TOKEN_PROGRAM_ID,\n
    solanaWeb3.TOKEN_2022_PROGRAM_ID\n
  ];\n
  for(const programId of programs){\n
    const res = await connection.getParsedTokenAccountsByOwner(pubkey,{ programId });\n
    for(const a of res.value){\n
      const info = a.account.data.parsed.info;\n
      if(info.mint === USDC_MINT.toBase58()){\n
        total += Number(info.tokenAmount.uiAmount || 0);\n
      }\n
    }\n
  }\n
  document.getElementById(\"usdc\").innerText = total.toFixed(2);\n
 }catch(e){\n
  console.error(\"USDC error\",e);\n
  document.getElementById(\"usdc\").innerText = \"0.00\";\n
 }\n
}\n
const _oldRefreshSOL = refreshSOL;\n
refreshSOL = async ()=>{ await _oldRefreshSOL(); await refreshUSDC(); };\n
</script>#s' "$HTML"

# ajoute champ HTML si absent
grep -q 'id="usdc"' "$HTML" || \
sed -i 's/USDC:[^<]*/USDC: <span id="usdc">0.00<\/span>/' "$HTML"

echo "[OK] USDC JS injecté"

echo "=== DONE — Reload page CTRL+F5 ==="
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

WEB="/var/www/fireinners-test"
ULT="$WEB/ultimate"
SNIP="/etc/nginx/snippets/fireinners_test.conf"

echo "=== 1) Voir la vraie cause (logs) ==="
tail -n 80 /var/log/nginx/error.log || true

echo
echo "=== 2) Fix permissions (403 classique) ==="
mkdir -p "$ULT"
chown -R www-data:www-data "$WEB" || true
chmod 0755 /var /var/www "$WEB" "$ULT" || true
chmod -R a+rX "$WEB" || true

echo
echo "=== 3) Si /ultimate/ n'a pas d'index, on en crée un (sinon 403 directory index forbidden) ==="
if [ ! -f "$ULT/index.html" ]; then
  cat > "$ULT/index.html" <<'HTML'
<!doctype html><meta charset="utf-8">
<title>ultimate</title>
<ul>
  <li><a href="ultimate.mp4">ultimate.mp4</a></li>
  <li><a href="ultimate.zip">ultimate.zip</a></li>
</ul>
HTML
fi

echo
echo "=== 4) Snippet nginx /test (autorise ultimate/) ==="
cat > "$SNIP" <<'NGX'
location = /test { return 301 /test/; }

location ^~ /test/ {
  alias /var/www/fireinners-test/;
  index index.html;
  try_files $uri $uri/ =404;
  add_header Cache-Control "no-store" always;
}
NGX

echo
echo "=== 5) Test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 6) Test local (reproduit l'extérieur) ==="
curl -I https://127.0.0.1/test/ultimate/ --insecure -H "Host: fireinners.online" | head -n 20 || true
curl -I https://127.0.0.1/test/ultimate/ultimate.mp4 --insecure -H "Host: fireinners.online" | head -n 20 || true
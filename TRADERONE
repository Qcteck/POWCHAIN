if marker in s:
    print("OK nginx: marker already present")
    sys.exit(0)

# trouve blocs server { ... } et choisit celui qui contient listen 443 ou ssl
def server_blocks(txt):
    out=[]
    i=0
    while True:
        m=re.search(r'(?m)^[ \t]*server[ \t]*\{', txt[i:])
        if not m: break
        start=i+m.start()
        j=start+m.end()-m.start()
        depth=0
        k=j
        while k < len(txt):
            ch=txt[k]
            if ch=='{': depth+=1
            elif ch=='}':
                if depth==0:
                    end=k+1
                    out.append((start,end))
                    i=end
                    break
                depth-=1
            k+=1
        else:
            break
    return out

blocks=server_blocks(s)
if not blocks:
    raise SystemExit("ERR: no server{} block found in vhost")

best=None
for (a,b) in blocks:
    seg=s[a:b]
    if ("listen 443" in seg) or ("ssl" in seg):
        best=(a,b); break
if best is None:
    best=blocks[-1]
a,b=best
seg=s[a:b]

# insère avant la dernière }
ins=seg.rfind("}")
if ins==-1:
    raise SystemExit("ERR: server block malformed")
seg2=seg[:ins] + block + seg[ins:]
s2=s[:a] + seg2 + s[b:]

open(p,"w",encoding="utf-8").write(s2)
print("OK nginx: inserted proxy block")

set -e
cd /root

echo "=== 1) Montre autour de la ligne 56 (pour vérifier) ==="
nl -ba /opt/traderone/server.js | sed -n '45,80p'

echo
echo "=== 2) Backup + commente toutes les lignes qui commencent par app. ==="
cp -v /opt/traderone/server.js /opt/traderone/server.js.bak.$(date +%s)
perl -pi -e 's/^\s*app\./\/\/ DISABLED(app not defined): app./' /opt/traderone/server.js

echo
echo "=== 3) Relance REST sur 3000 ==="
sudo fuser -k 3000/tcp 2>/dev/null || true
nohup node /opt/traderone/server.js > /var/log/traderone-rest.log 2>&1 &
sleep 1

echo
echo "=== 4) Check écoute + test status/start ==="
ss -ltnp | egrep ':3000|:12703|:3002' || true
curl -sS -i -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' | head -n 40 || true
echo
curl -sS -i -X POST http://127.0.0.1:3000/api/start  -H "content-type: application/json" --data '{}' | head -n 40 || true

echo
echo "=== 5) Si ça rate: log ==="
tail -n 120 /var/log/traderone-rest.log || true
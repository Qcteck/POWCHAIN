cat >/root/FIX_DUPLICATE_WOLVERINE_FINAL.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

SNIPPET="/etc/nginx/snippets/fireinners-wolverine.conf"
BACKUP="/root/fireinners-wolverine.conf.backup.$(date +%s)"

if [ -f "$SNIPPET" ]; then
  echo "[FIX] backup snippet -> $BACKUP"
  cp -a "$SNIPPET" "$BACKUP"

  echo "[FIX] removing location /wolverine from snippet"
  sed -i '/location\s\+\/wolverine\//,/}/d' "$SNIPPET"
else
  echo "[ERROR] snippet not found: $SNIPPET"
  exit 1
fi

echo "[TEST] nginx config"
nginx -t

echo "[RELOAD] nginx"
systemctl reload nginx

echo "[OK] duplicate /wolverine definitively fixed"
echo "[INFO] backup saved at $BACKUP"
SH

chmod +x /root/FIX_DUPLICATE_WOLVERINE_FINAL.sh
/root/FIX_DUPLICATE_WOLVERINE_FINAL.sh
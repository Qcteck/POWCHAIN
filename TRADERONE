# nginx snippet for /wolverine
SNIP_CONTENT="# $MARK
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_redirect off;
  rewrite ^/wolverine/api/?(.*)$ /\$1 break;
  proxy_pass http://127.0.0.1:$PORT;
}

location ^~ /wolverine/ {
  alias $FRONT_DIR/;
  try_files \$uri \$uri/ /wolverine/index.html;
}
"
askorupdate_file "$SNIP" "$SNIP_CONTENT"

# Inject include in vhost if missing

cat >/root/FIX_WOLVERINE_403_ONEPASS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
HOST="fireinners.online"

SITE="/etc/nginx/sites-enabled/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
TS="$(date -u +%Y%m%d_%H%M%S)"

echo "=== 0) ORIGIN check BEFORE ==="
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}/wolverine/index.html | head -n 12 || true
echo

echo "=== 1) Locate where /wolverine is defined ==="
echo "--- In site file:"
grep -nE "wolverine|include\s+/etc/nginx/includes/wolverine_routes\.inc|location\s+\^~\s+/wolverine" "$SITE" || true
echo
if [ -f "$INC" ]; then
  echo "--- In include file ($INC):"
  grep -nE "location\s+|wolverine|deny\s+all;|internal;|traderone_api_lockdown" "$INC" || true
else
  echo "WARN: $INC not found"
fi
echo

echo "=== 2) Backups ==="
cp -a "$SITE" "${SITE}.bak_${TS}"
[ -f "$INC" ] && cp -a "$INC" "${INC}.bak_${TS}" || true
echo "Backup: ${SITE}.bak_${TS}"
[ -f "$INC" ] && echo "Backup: ${INC}.bak_${TS}"
echo

echo "=== 3) FIX include file: make /wolverine public, keep /wolverine/traderone/api protected ==="
python3 - <<'PY'
from pathlib import Path
import re

inc_path = Path("/etc/nginx/includes/wolverine_routes.inc")
site_path = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")

def patch_text(s: str) -> str:
    # Remove any server/global include of traderone_api_lockdown (we want it ONLY in the api location)
    s = s.replace("include /etc/nginx/snippets/traderone_api_lockdown.conf;", "")

    # Helper: find & rewrite a location block content
    def rewrite_location(text, loc_regex, rewrite_fn):
        m = re.search(loc_regex, text, flags=re.M)
        if not m:
            return text, False
        start = m.start()
        brace = text.find("{", start)
        if brace == -1:
            return text, False
        i = brace
        depth = 0
        end = None
        while i < len(text):
            if text[i] == "{": depth += 1
            elif text[i] == "}":
                depth -= 1
                if depth == 0:
                    end = i+1
                    break
            i += 1
        if end is None:
            return text, False
        block = text[start:end]
        block2 = rewrite_fn(block)
        return text[:start] + block2 + text[end:], True

    # 1) Ensure /wolverine/ is PUBLIC: remove deny/internal lines inside that block
    def clean_wolverine(block: str) -> str:
        block = re.sub(r'^\s*(deny\s+all;|internal;)\s*$', '', block, flags=re.M)
        # also remove allow 127.0.0.1 / deny all combos if they were mistakenly inserted
        block = re.sub(r'^\s*allow\s+127\.0\.0\.1;\s*$', '', block, flags=re.M)
        block = re.sub(r'^\s*deny\s+all;\s*$', '', block, flags=re.M)
        return block

    s, _ = rewrite_location(s, r'^\s*location\s+(\^~\s+)?/wolverine/\s*\{', clean_wolverine)

    # 2) Ensure /wolverine/traderone/api has the lockdown include inside it
    def ensure_api_lock(block: str) -> str:
        inc = "include /etc/nginx/snippets/traderone_api_lockdown.conf;"
        if inc not in block:
            block = re.sub(r'\{\s*', '{\n    ' + inc + '\n', block, count=1)
        return block

    s, _ = rewrite_location(s, r'^\s*location\s+(\^~\s+)?/wolverine/traderone/api/?\s*\{', ensure_api_lock)

    return s

# Patch include file if present, else patch site file
if inc_path.exists():
    s = inc_path.read_text(errors="ignore")
    inc_path.write_text(patch_text(s))
    print("OK: patched include file:", inc_path)
else:
    s = site_path.read_text(errors="ignore")
    site_path.write_text(patch_text(s))
    print("OK: patched site file (no include found):", site_path)

PY
echo

echo "=== 4) nginx test + reload ==="
nginx -t
systemctl reload nginx || service nginx reload
echo

echo "=== 5) ORIGIN check AFTER ==="
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}/wolverine/index.html | head -n 12 || true
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}/wolverine/traderone/api/ | head -n 12 || true
echo "DONE ✅"

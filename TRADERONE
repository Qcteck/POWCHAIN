set -e

# 0) Tu dois être dans ton repo git
pwd
git status --porcelain || true

# 1) Voir où le mauvais mint traîne (sans deps)
echo "=== MATCHES qSSge (hors deps) ==="
grep -RIn --color \
  --exclude-dir=node_modules --exclude-dir=vendor --exclude-dir=.git \
  --exclude=package-lock.json \
  'qSSge' . || echo "OK: aucun qSSge trouvé ✅"

# 2) Remplacer partout dans TES fichiers
FILES=$(grep -RIl \
  --exclude-dir=node_modules --exclude-dir=vendor --exclude-dir=.git \
  --exclude=package-lock.json \
  'qSSge' . || true)

if [ -n "$FILES" ]; then
  echo "$FILES" | xargs sed -i 's/qSSge/qSSqe/g'
  echo "✅ Remplacement fait (qSSge -> qSSqe)"
else
  echo "✅ Rien à remplacer"
fi

# 3) Vérif finale
echo "=== VERIFY qSSge ==="
grep -RIn --color \
  --exclude-dir=node_modules --exclude-dir=vendor --exclude-dir=.git \
  --exclude=package-lock.json \
  'qSSge' . && echo "❌ Il en reste" || echo "✅ Plus de qSSge"

# 4) Commit + push
git add -A
git commit -m "Fix USDC mint (qSSge -> qSSqe)" || echo "ℹ️ Rien à commit"
git push
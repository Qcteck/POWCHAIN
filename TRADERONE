cat >/root/debug_wolverine_served_vs_file.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

FILE="/var/www/wolverine/index.html"

echo "== FILE hash =="
sha256sum "$FILE" || exit 1
echo

echo "== ORIGIN headers (force identity) =="
curl -skI --resolve fireinners.online:443:127.0.0.1 -H 'Accept-Encoding: identity' https://fireinners.online/wolverine/ | sed -n '1,25p'
echo

echo "== ORIGIN body (first lines) =="
curl -sk --resolve fireinners.online:443:127.0.0.1 -H 'Accept-Encoding: identity' https://fireinners.online/wolverine/ | head -n 40
echo

echo "== ORIGIN grep markers =="
curl -sk --resolve fireinners.online:443:127.0.0.1 -H 'Accept-Encoding: identity' https://fireinners.online/wolverine/ \
 | grep -nE 'sendSolBtn|WOLVERINE_SEND_SOL_SCRIPT' || echo "NOT FOUND in served HTML"
echo

echo "== ORIGIN hash =="
curl -sk --resolve fireinners.online:443:127.0.0.1 -H 'Accept-Encoding: identity' https://fireinners.online/wolverine/ | sha256sum
echo

echo "== If hashes differ, show nginx wolverine block =="
nginx -T 2>/dev/null | awk '
  /location[[:space:]]+(\^~[[:space:]]+)?\/wolverine\/|location[[:space:]]+=?[[:space:]]\/wolverine/ {p=1}
  p{print}
  p && /\}/{c++}
  p && c>=2{exit}
' || true
BASH

chmod +x /root/debug_wolverine_served_vs_file.sh
/root/debug_wolverine_served_vs_file.sh
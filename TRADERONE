fetch_pin(){
  local OUT="$1"; shift
  local OK=0
  for U in "$@"; do
    if curl -fsSL "$U" -o "$OUT.tmp" 2>/dev/null; then
      local SZ; SZ="$(wc -c <"$OUT.tmp" 2>/dev/null || echo 0)"

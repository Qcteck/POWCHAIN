cat >/root/MEGA_AQUILA_STACKING_DEDUP_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILA_STACKING_DEDUP_BK_${TS}"
mkdir -p "$BK"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ echo "ERR: $*" >&2; exit 1; }

DOMAIN="fireinners.online"
PATH_APP="/aquilastacking"
WEBROOT="/var/www/aquilastacking"
INC="/etc/nginx/includes/aquilastacking_routes.inc"
VHOST_A="/etc/nginx/sites-available/fireinners.online-ssl"
NGX="/etc/nginx/nginx.conf"

backup_one(){ local p="$1"; [ -e "$p" ] || return 0; mkdir -p "$BK/$(dirname "$p")"; cp -a "$p" "$BK/$p.bak" 2>/dev/null || true; }
lsattr_safe(){ lsattr "$1" 2>/dev/null | awk '{print $1}' || echo ""; }
unfreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; local a; a="$(lsattr_safe "$f")"; if echo "$a" | grep -q 'i'; then say "UNFREEZE: chattr -i $f"; chattr -i "$f" 2>/dev/null || true; fi; }
refreeze_one(){ local f="$1"; [ -e "$f" ] || return 0; say "REFREEZE: chattr +i $f"; chattr +i "$f" 2>/dev/null || true; }

write_inc_clean(){
  say "Rewrite include CLEAN: $INC"
  backup_one "$INC"
  mkdir -p "$(dirname "$INC")"
  cat >"$INC" <<EOF
## aquilastacking_routes (clean)
location = ${PATH_APP} { return 301 ${PATH_APP}/; }
location ${PATH_APP}/ {
  alias ${WEBROOT}/;
  index index.html;
  try_files \$uri \$uri/ /index.html;
  add_header Cache-Control "no-store" always;
}
location = ${PATH_APP}/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = ${PATH_APP}/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = ${PATH_APP}/manifest.json { add_header Cache-Control "no-store" always; return 404; }
EOF
}

dedup_vhost_include(){
  say "Dedup include line in vhost: $VHOST_A"
  [ -f "$VHOST_A" ] || die "missing $VHOST_A"
  backup_one "$VHOST_A"
  python3 - "$VHOST_A" "$INC" <<'PY'
import sys,re
p,inc=sys.argv[1],sys.argv[2]
s=open(p,'r',encoding='utf-8',errors='ignore').read()
needle=re.escape(f"include {inc};")
# remove duplicates: keep first occurrence only
matches=list(re.finditer(needle,s))
if len(matches)<=1:
  print("nochange"); sys.exit(0)
first=matches[0]
# remove all subsequent occurrences
out=[]; last=0; kept=False
for m in matches:
  if not kept:
    kept=True
    continue
  # remove that line (and surrounding whitespace up to newline)
  start=m.start()
  # expand to full line
  ls=s.rfind("\n",0,start)+1
  le=s.find("\n",m.end())
  if le==-1: le=len(s)
  out.append(s[last:ls])
  last=le+1 if le<len(s) else le
out.append(s[last:])
open(p,'w',encoding='utf-8').write("".join(out))
print(f"dedup: removed {len(matches)-1}")
PY
}

ensure_webroot(){
  mkdir -p "$WEBROOT"
  if [ ! -f "$WEBROOT/index.html" ]; then
    say "Create placeholder index.html (WEBROOT was empty)"
    backup_one "$WEBROOT/index.html"
    cat >"$WEBROOT/index.html" <<'EOF'
<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1"><title>Aquila Stacking</title>
<body style="margin:0;font-family:system-ui;background:#0b0f14;color:#e6eef8">
<div style="max-width:860px;margin:40px auto;padding:24px">
<h1 style="margin:0 0 12px">Aquila Stacking</h1>
<p>Placeholder (build non déployé). Dépose ton build dans <b>/var/www/aquilastacking</b>.</p>
</div></body>
EOF
  fi
  chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
  chmod -R a+rX "$WEBROOT" 2>/dev/null || true
}

main(){
  say "BEGIN STACKING DEDUP FIX @ $TS"
  say "BK: $BK"

  unfreeze_one "$NGX"
  unfreeze_one "$VHOST_A"
  unfreeze_one "$INC"

  ensure_webroot
  write_inc_clean
  dedup_vhost_include

  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx

  say "Quick check"
  curl -skI -H "Host: ${DOMAIN}" "https://127.0.0.1${PATH_APP}/" | head -n 12 || true

  refreeze_one "$INC"
  refreeze_one "$VHOST_A"
  refreeze_one "$NGX"

  say "DONE"
  say "Open: https://${DOMAIN}${PATH_APP}/"
}
main
BASH
chmod +x /root/MEGA_AQUILA_STACKING_DEDUP_FIX.sh
bash /root/MEGA_AQUILA_STACKING_DEDUP_FIX.sh
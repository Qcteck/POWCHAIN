set -euo pipefail

echo "[0] Etat avant"
ss -lntp | egrep ':(3000|8484)\b|:443\b' || true
ufw status numbered || true

echo "[1] Identifier les PIDs qui ecoutent 3000/8484"
PID3000="$(ss -lntp 2>/dev/null | awk '/:3000[[:space:]]/ {print $NF}' | head -n1 | sed -n 's/.*pid=\([0-9]\+\).*/\1/p')"
PID8484="$(ss -lntp 2>/dev/null | awk '/:8484[[:space:]]/ {print $NF}' | head -n1 | sed -n 's/.*pid=\([0-9]\+\).*/\1/p')"
echo "PID3000=${PID3000:-NA} PID8484=${PID8484:-NA}"

echo "[2] Trouver le repertoire de travail (cwd) de chaque process (si possible)"
CWD3000=""; CWD8484=""
if [ -n "${PID3000:-}" ] && [ -d "/proc/$PID3000" ]; then CWD3000="$(readlink -f /proc/$PID3000/cwd || true)"; fi
if [ -n "${PID8484:-}" ] && [ -d "/proc/$PID8484" ]; then CWD8484="$(readlink -f /proc/$PID8484/cwd || true)"; fi
echo "CWD3000=${CWD3000:-NA}"
echo "CWD8484=${CWD8484:-NA}"

echo "[3] Dossiers candidats (on ajoute aussi /root/qplu et /opt/fireinners si existants)"
CANDS=()
[ -n "${CWD3000:-}" ] && CANDS+=("$CWD3000")
[ -n "${CWD8484:-}" ] && CANDS+=("$CWD8484")
[ -d "/root/qplu" ] && CANDS+=("/root/qplu")
[ -d "/opt/fireinners" ] && CANDS+=("/opt/fireinners")
# dedupe
CANDS_UNIQ=()
for d in "${CANDS[@]}"; do
  [ -d "$d" ] || continue
  skip=0
  for e in "${CANDS_UNIQ[@]}"; do [ "$e" = "$d" ] && skip=1 && break; done
  [ $skip -eq 0 ] && CANDS_UNIQ+=("$d")
done
printf "Candidats:\n"; printf " - %s\n" "${CANDS_UNIQ[@]:-}"

echo "[4] Backup dossier patch"
BK="/root/beton_bind_$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BK"

echo "[5] Chercher des patterns listen(3000|8484) dans .js (max 50 hits) et patcher securise"
patch_one_port () {
  local PORT="$1"
  local DONE=0
  for BASE in "${CANDS_UNIQ[@]}"; do
    [ -d "$BASE" ] || continue
    # Liste des fichiers .js contenant listen(PORT
    mapfile -t HITS < <(grep -RIn --include='*.js' -E "\.listen\([[:space:]]*${PORT}([[:space:]]*,|\))" "$BASE" 2>/dev/null | head -n 50 || true)
    [ "${#HITS[@]}" -eq 0 ] && continue

    echo "Hits pour port $PORT dans $BASE:"
    printf "%s\n" "${HITS[@]}"

    # On patch seulement si on trouve une ligne simple .listen(PORT) ou .listen(PORT,
    # et si cette ligne ne contient pas deja 127.0.0.1
    for h in "${HITS[@]}"; do
      FILE="${h%%:*}"
      [ -f "$FILE" ] || continue
      cp -a "$FILE" "$BK/$(basename "$FILE").bak.$PORT" 2>/dev/null || true

      # Patch 1: .listen(PORT) -> .listen(PORT,"127.0.0.1")
      # Patch 2: .listen(PORT, ...) -> .listen(PORT,"127.0.0.1", ...)
      perl -0777 -i -pe '
        my $p = $ENV{PORT};
        s/\.listen\(\s*'"$PORT"'\s*\)(?!\s*;)/.listen('"$PORT"',"127.0.0.1")/g;
        s/\.listen\(\s*'"$PORT"'\s*,\s*(?!\s*"127\.0\.0\.1")/\.listen('"$PORT"',"127.0.0.1",/g;
      ' "$FILE"

      if ! grep -q '127\.0\.0\.1' "$FILE"; then
        # revert si rien n'a change
        cp -a "$BK/$(basename "$FILE").bak.$PORT" "$FILE" 2>/dev/null || true
      else
        echo "Patche: $FILE (port $PORT -> 127.0.0.1)"
        DONE=1
      fi
    done

    [ $DONE -eq 1 ] && break
  done
  echo "$DONE"
}

export PORT=3000
DONE3000="$(patch_one_port 3000)"
export PORT=8484
DONE8484="$(patch_one_port 8484)"

echo "[6] Restart services probables (sans casser si absent)"
systemctl restart amcq.service 2>/dev/null || true
systemctl restart fireinners-qplus-wasm.service 2>/dev/null || true

echo "[7] Verif bind: on veut 127.0.0.1:3000 et 127.0.0.1:8484 (ou au moins plus 0.0.0.0)"
ss -lntp | egrep ':(3000|8484)\b|:443\b' || true

echo "[8] Tests locaux (doivent repondre)"
curl -m 3 -I http://127.0.0.1:3000  | head -n 1 || true
curl -m 3 -I http://127.0.0.1:8484  | head -n 1 || true

echo "[9] Tests publics (doivent echouer depuis une machine externe; depuis le VPS ca peut tromper)."
echo "A faire depuis iPhone en LTE:"
echo " - http://fireinners.online:3000 (doit echouer)"
echo " - http://fireinners.online:8484 (doit echouer)"

echo "DONE. Backup: $BK"
echo "DONE3000=$DONE3000 DONE8484=$DONE8484"





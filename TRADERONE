<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>ASAN • Ultimate Planetary Command</title>
<style>
html,body{margin:0;height:100%;overflow:hidden;font-family:system-ui,Segoe UI,Roboto;background:#000;color:#0ff}
canvas{display:block}
#hudOverlay{position:absolute;top:10px;left:10px;width:180px;background:rgba(0,12,22,.65);border:1px solid rgba(0,255,255,.4);border-radius:14px;padding:10px;font-size:11px;z-index:10;box-shadow:0 0 30px rgba(0,255,255,.7)}
#choicesMenu{position:absolute;top:10px;right:10px;width:240px;background:rgba(0,12,22,.65);border:1px solid rgba(0,255,255,.4);border-radius:14px;padding:10px;font-size:11px;z-index:10;box-shadow:0 0 30px rgba(0,255,255,.7)}
#mapPanel{position:absolute;bottom:80px;right:10px;width:240px;background:rgba(0,8,16,.8);border:1px solid rgba(0,255,255,.35);border-radius:14px;padding:10px;font-size:11px;z-index:10}
#timeline{position:absolute;bottom:40px;left:50%;transform:translateX(-50%);background:rgba(0,10,20,.6);border:1px solid rgba(0,255,255,.35);border-radius:12px;padding:6px 12px;font-size:12}
#yearBar{width:200px}
button{margin-top:5px;width:100%;border-radius:8px;padding:6px;background:#081018;color:#0ff;border:1px solid rgba(0,255,255,.3);cursor:pointer}
button:hover{background:#0d2233;box-shadow:0 0 12px #0ff}
#labWindow{display:none;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:540px;height:360px;background:rgba(0,5,15,.98);border:1px solid rgba(0,255,255,.6);border-radius:18px;padding:16px;z-index:20;box-shadow:0 0 45px rgba(0,255,255,.9);overflow:auto}
#newsBar{position:absolute;bottom:0;left:0;right:0;height:28px;background:rgba(0,0,0,.85);border-top:1px solid rgba(0,255,255,.3);color:#0ff;font-size:12px;white-space:nowrap;overflow:hidden;z-index:9}
#newsText{display:inline-block;padding-left:100%;animation:scrollNews 45s linear infinite}
@keyframes scrollNews{from{transform:translateX(0)}to{transform:translateX(-100%)}}
#continentWindow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:320px;background:rgba(0,15,30,.85);border:1px solid rgba(0,255,255,.6);border-radius:16px;padding:14px;z-index:30;display:none;color:#0ff}
</style>
</head>
<body>

<div id="hudOverlay">
<b>ASAN • Commandement Global</b><br><br>
<div id="hYear"></div>
<div id="hPop"></div>
<div id="hGDP"></div>
<div id="hStab"></div>
<div id="hRes"></div>
<div id="hFood"></div>
<div id="hEnergy"></div>
<div id="hClimate"></div>
</div>

<div id="choicesMenu">
<b>Décisions Planétaires</b><br>
<button id="toggleVoice">🔊 Voix IA : OFF</button>
<button data-act="energy">⚡ Transition Énergétique</button>
<button data-act="health">🧬 Santé</button>
<button data-act="climate">🌱 Climat</button>
<button data-act="economy">💰 Économie</button>
<button data-act="research">🔬 Recherche</button>
<button id="openLab">🧪 Labo Spatial</button>
</div>

<div id="mapPanel">
<b>Continents</b><br>
<button data-zone="NA">Amérique du Nord</button>
<button data-zone="EU">Europe</button>
<button data-zone="AS">Asie</button>
<button data-zone="AF">Afrique</button>
<button data-zone="SA">Amérique du Sud</button>
</div>

<div id="timeline"><input type="range" id="yearBar" min="2026" max="2600" value="2026"></div>
<div id="newsBar"><span id="newsText">Simulation planétaire active • Données initialisées • En attente de décisions humaines…</span></div>
<div id="labWindow"><b>Laboratoire Spatial 3D</b><span style="float:right;cursor:pointer" onclick="labWindow.style.display='none'">✖</span><div id="labContent" style="margin-top:12px;color:#0ff">Visualisation 3D des expériences scientifiques en cours...</div></div>
<canvas id="mainCanvas"></canvas>
<div id="continentWindow"></div>

<script src="https://cdn.jsdelivr.net/npm/three@0.159/build/three.min.js"></script>
<script>
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(45,innerWidth/innerHeight,0.1,2000);
camera.position.set(0,0,7);
const renderer=new THREE.WebGLRenderer({canvas:mainCanvas,antialias:true,alpha:true});
renderer.setSize(innerWidth,innerHeight);
scene.add(new THREE.AmbientLight(0x333333));
const sun=new THREE.DirectionalLight(0xffffff,1.6);sun.position.set(6,4,5);scene.add(sun);

// ===== EARTH =====
const loader=new THREE.TextureLoader();
const earth=new THREE.Mesh(
  new THREE.SphereGeometry(2,128,128),
  new THREE.MeshPhongMaterial({map:loader.load('https://threejs.org/examples/textures/planets/earth_atmos_2048.jpg')})
);
scene.add(earth);
const clouds=new THREE.Mesh(
  new THREE.SphereGeometry(2.04,128,128),
  new THREE.MeshPhongMaterial({map:loader.load('https://threejs.org/examples/textures/planets/earth_clouds_1024.png'),transparent:true,opacity:0.85})
);
scene.add(clouds);

// ===== VOIX IA =====
let voiceEnabled=false;
let synth=window.speechSynthesis;
function speak(text){if(!voiceEnabled||!synth)return;synth.cancel();const u=new SpeechSynthesisUtterance(text);u.lang='fr-FR';u.rate=0.95;u.pitch=1;synth.speak(u);}
document.getElementById('toggleVoice').onclick=()=>{
 voiceEnabled=!voiceEnabled;
 document.getElementById('toggleVoice').textContent=voiceEnabled?'🔊 Voix IA : ON':'🔊 Voix IA : OFF';
 if(voiceEnabled) speak('Voix stratégique activée. En attente de décisions.');
};
document.getElementById('openLab').onclick=()=>{document.getElementById('labWindow').style.display='block'; speak('Laboratoire spatial ouvert.');};

// ===== STATS =====
const planet={pop:8000,gdp:120000,stability:0.78,res:100,famine:6,energy:85,climate:24};
let year=2026;
function updateHUD(){
  hYear.textContent=`Année : ${Math.floor(year)}`;
  hPop.textContent=`Population : ${planet.pop} M`;
  hGDP.textContent=`PIB : ${planet.gdp} Md$`;
  hStab.textContent=`Stabilité : ${(planet.stability*100).toFixed(1)}%`;
  hRes.textContent=`Ressources : ${planet.res}%`;
  hFood.textContent=`Famine : ${planet.famine}%`;
  hEnergy.textContent=`Énergie : ${planet.energy}%`;
  hClimate.textContent=`Stress climatique : ${planet.climate}%`;
}

// ===== CONTINENTS =====
const continents={
 NA:{name:'Amérique du Nord',lat:45,lon:-100,pop:590,gdp:25000,stability:0.85,energy:80,famine:3},
 EU:{name:'Europe',lat:50,lon:10,pop:750,gdp:40000,stability:0.82,energy:90,famine:2},
 AS:{name:'Asie',lat:30,lon:90,pop:4600,gdp:60000,stability:0.75,energy:70,famine:5},
 AF:{name:'Afrique',lat:5,lon:20,pop:1300,gdp:8000,stability:0.65,energy:50,famine:10},
 SA:{name:'Amérique du Sud',lat:-15,lon:-60,pop:430,gdp:12000,stability:0.72,energy:60,famine:6}
};

const continentWindow=document.getElementById('continentWindow');
function centerOnLatLon(lat,lon){
 const phi=(90-lat)*Math.PI/180;
 const theta=(lon+180)*Math.PI/180;
 camera.position.set(6*Math.sin(phi)*Math.cos(theta),6*Math.cos(phi),6*Math.sin(phi)*Math.sin(theta));
 camera.lookAt(0,0,0);
}
function openContinent(code){
 const c=continents[code];
 continentWindow.innerHTML=`<b>${c.name}</b> <span style="float:right;cursor:pointer" onclick="continentWindow.style.display='none'">✖</span><br><br><b>Population :</b> ${c.pop} M<br><b>PIB :</b> ${c.gdp} Md$<br><b>Stabilité :</b> ${(c.stability*100).toFixed(1)}%<br><b>Énergie :</b> ${c.energy}%<br><b>Famine :</b> ${c.famine}%<br>`;
 continentWindow.style.display='block';
 centerOnLatLon(c.lat,c.lon);
 speak(`Analyse du continent ${c.name} en cours.`);
}
Object.keys(continents).forEach(k=>{
 const b=document.querySelector(`#mapPanel button[data-zone="${k}"]`);
 if(b) b.onclick=()=>openContinent(k);
});

// ===== DECISIONS =====
document.querySelectorAll('#choicesMenu button[data-act]').forEach(btn=>{
 btn.onclick=()=>{
   const act=btn.getAttribute('data-act');
   let msg='';
   switch(act){
     case 'energy': planet.energy=Math.min(100,planet.energy+5);planet.res-=2;msg='Transition énergétique lancée';break;
     case 'health': planet.famine=Math.max(0,planet.famine-2);planet.pop+=10;msg='Programmes de santé activés';break;
     case 'climate': planet.climate=Math.max(0,planet.climate-3);planet.res-=3;msg='Actions climatiques en cours';break;
     case 'economy': planet.gdp+=1000;planet.res-=5;msg='Mesures économiques appliquées';break;
     case 'research': planet.res-=10;msg='Recherche avancée lancée';break;
   }
   speak(msg);
   newsText.textContent=`${msg} • Année : ${Math.floor(year)}`;
 };
});

// ===== ANIMATION LOOP =====
function animate(){
 requestAnimationFrame(animate);
 earth.rotation.y+=0.0008;
 clouds.rotation.y+=0.0012;
 updateHUD();
 renderer.render(scene,camera);
}
animate();
window.onresize=()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);};
</script>
</body>
</html>

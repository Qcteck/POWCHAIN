<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>PC Quantique Lab • Hybride Strict • Worker</title><style>body{font-family:Arial,sans-serif;background:#111;color:#eee;padding:18px}h2{margin:0 0 10px}#top{display:flex;flex-wrap:wrap;gap:10px;align-items:center}button,select,input{margin:0;padding:8px 10px;font-size:14px;background:#1c1c1c;color:#eee;border:1px solid #444;border-radius:6px}button:active{transform:translateY(1px)}.ok{color:#0f0}.error{color:#f00}.warn{color:#ff0}canvas{background:#161616;display:block;margin:10px 0;border:1px solid #333;border-radius:6px}#sum{margin-top:8px;padding:10px;background:#1b1b1b;border:1px solid #333;border-radius:6px}#log{max-height:220px;overflow-y:auto;background:#1b1b1b;padding:10px;border-radius:6px;border:1px solid #333;margin-top:10px;font-size:12px;line-height:1.35}#grid{display:grid;grid-template-columns:1fr;gap:10px}@media(min-width:1000px){#grid{grid-template-columns:1fr 1fr}}</style></head><body><h2>PC Quantique Lab : Hybride Strict (Doublet / Multi-niveau) + BOOST + Σw + Persist</h2><div id="top"><button id="startBtn">Lancer</button><button id="stopBtn">Stop</button><button id="boostBtn">BOOST</button><select id="modeSelect"><option value="doublet">Mode 1 : Doublet propre (tail ~0.1)</option><option value="multi">Mode 2 : Multi-niveau stable (0.2–0.4)</option></select><label>Seed <input id="seed" value="42" style="width:90px"></label><label>Cycles <input id="cycles" value="200" style="width:90px"></label><label>Tick(ms) <input id="tick" value="50" style="width:90px"></label><button id="exportBtn">Export JSON</button><span id="status" class="warn">IDLE</span></div><div id="sum">Σw réel : <b id="msw">0</b> | tail : <b id="tailDisplay">0</b> | Persist : <b id="persistCount">0</b> | STATUT : <b id="statut">OK</b> | Symétries : <b id="sym">OK</b></div><div id="grid"><div><h3 style="margin:10px 0 6px">Graphique E (Gap)</h3><canvas id="graphE" width="900" height="220"></canvas><h3 style="margin:10px 0 6px">Graphique N_c</h3><canvas id="graphNc" width="900" height="120"></canvas><h3 style="margin:10px 0 6px">Graphique H_w</h3><canvas id="graphHw" width="900" height="120"></canvas></div><div><h3 style="margin:10px 0 6px">Spectre (barres λ1, λ2, λ3 si multi)</h3><canvas id="graphSpectre" width="900" height="120"></canvas><h3 style="margin:10px 0 6px">Logs</h3><div id="log"></div></div></div><script>(()=>{const $=s=>document.querySelector(s);const logEl=$("#log"),statusEl=$("#status");const mswEl=$("#msw"),tailEl=$("#tailDisplay"),persistEl=$("#persistCount"),statutEl=$("#statut"),symEl=$("#sym");const modeEl=$("#modeSelect"),seedEl=$("#seed"),cyclesEl=$("#cycles"),tickEl=$("#tick");const ctxE=$("#graphE").getContext("2d"),ctxNc=$("#graphNc").getContext("2d"),ctxHw=$("#graphHw").getContext("2d"),ctxSpec=$("#graphSpectre").getContext("2d");let histE=[],histNc=[],histHw=[],lastPayload=null,worker=null,runMeta={};function appendLog(html,cls){const d=document.createElement("div");d.className=cls||"";d.innerHTML=html;logEl.appendChild(d);logEl.scrollTop=logEl.scrollHeight;}function clearLog(){logEl.textContent="";}function drawGraph(ctx,data,color,minY,maxY,N){ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height);ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=2;const W=ctx.canvas.width,H=ctx.canvas.height;const step=W/Math.max(1,(N||data.length));for(let i=0;i<data.length;i++){const v=data[i];const y=H-((v-minY)/(maxY-minY)*H);const x=i*step;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);}ctx.stroke();ctx.strokeStyle="rgba(255,255,255,.10)";ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(0,H-1);ctx.lineTo(W,H-1);ctx.stroke();}function drawSpectre(ctx,levels){ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height);const W=ctx.canvas.width,H=ctx.canvas.height;const barH=H-14;const baseY=H-7;const bw=34;const drawBar=(x,col)=>{ctx.fillStyle=col;ctx.fillRect(x,baseY-barH,bw,barH);};drawBar(W*0.25,"#2bff7a");drawBar(W*0.45,"#2bd1ff");if(levels[2]>0)drawBar(W*0.62,"#ffb02b");ctx.fillStyle="rgba(255,255,255,.25)";ctx.fillText("λ1",W*0.25,14);ctx.fillText("λ2",W*0.45,14);if(levels[2]>0)ctx.fillText("λ3",W*0.62,14);}function setStatus(txt,cls){statusEl.textContent=txt;statusEl.className=cls||"warn";}function makeWorker(){const code=`let running=false,timer=null;function xorshift32(seed){let x=(seed>>>0)||1;return()=>{x^=x<<13;x^=x>>>17;x^=x<<5;return((x>>>0)/4294967296)};}function clamp(x,a,b){return x<a?a:x>b?b:x;}function rndn(rng){return(rng()*2-1);}function T(state,rng){state.E+=rndn(rng)*0.02;state.N_c+=Math.round(rndn(rng)*1);state.H_w+=rndn(rng)*0.02;return state;}function corrige_hors_bande(E){return clamp(E,0,1);}function panneau_verifie_symmetries(rng){return rng()<0.02?false:true;}function calcGaps(levels){return{g12:Math.abs(levels[1]-levels[0]),g23:Math.abs(levels[2]-levels[1])};}function checkStrict(gaps,thr,mode){if(mode==="doublet")return gaps.g12>=thr;return(gaps.g12>=thr&&gaps.g23>=thr);}function detecte_niveau(E,levels){if(E<=levels[0])return"λ1";else if(E<=levels[1])return"λ2";else if(E<=levels[2])return"λ3";else return"E_mass";}function updateSumTail(levels){const l1=levels[0],l2=levels[1],l3=levels[2];const sum=l1+l2+l3;const tail=1-(l1+l2);return{sum,tail};}let cfg={cycles:200,tick:50,mode:"doublet",seed:42,thr:0.03};let moteur={E:0.12,N_c:10,H_w:0.5,levels:[0.18,0.52,0]};let persistCount=0,cycle=0,rng=xorshift32(cfg.seed);function levelsForMode(mode){if(mode==="doublet")return[0.18,0.52,0];return[0.2,0.4,0.6];}function boost(){if(cfg.mode==="doublet")moteur.E=0.15;else moteur.E=0.25;}function step(){moteur=T(moteur,rng);moteur.E=corrige_hors_bande(moteur.E);moteur.levels=levelsForMode(cfg.mode);const gaps=calcGaps(moteur.levels);const strict_ok=checkStrict(gaps,cfg.thr,cfg.mode);persistCount=strict_ok?(persistCount+1):0;const sym_ok=panneau_verifie_symmetries(rng);const sums=updateSumTail(moteur.levels);const niveau=detecte_niveau(moteur.E,moteur.levels);return{cycle,moteur:{...moteur},gaps,strict_ok,persistCount,sym_ok,sums,niveau};}function start(){if(running)return;running=true;timer=setInterval(()=>{if(cycle>=cfg.cycles){stop();postMessage({type:"done"});return;}const out=step();postMessage({type:"tick",out});cycle++;},cfg.tick);postMessage({type:"state",running:true});}function stop(){running=false;if(timer){clearInterval(timer);timer=null;}postMessage({type:"state",running:false});}onmessage=(e)=>{const m=e.data||{};if(m.type==="config"){cfg={...cfg,...m.cfg};rng=xorshift32(cfg.seed);cycle=0;persistCount=0;moteur={E:0.12,N_c:10,H_w:0.5,levels:levelsForMode(cfg.mode)};postMessage({type:"configured",cfg});return;}if(m.type==="start")start();if(m.type==="stop")stop();if(m.type==="boost"){boost();postMessage({type:"boosted"});}};`;const blob=new Blob([code],{type:"text/javascript"});return new Worker(URL.createObjectURL(blob));}function resetData(){histE=[];histNc=[];histHw=[];lastPayload=null;ctxE.clearRect(0,0,ctxE.canvas.width,ctxE.canvas.height);ctxNc.clearRect(0,0,ctxNc.canvas.width,ctxNc.canvas.height);ctxHw.clearRect(0,0,ctxHw.canvas.width,ctxHw.canvas.height);ctxSpec.clearRect(0,0,ctxSpec.canvas.width,ctxSpec.canvas.height);mswEl.textContent="0";tailEl.textContent="0";persistEl.textContent="0";statutEl.textContent="OK";symEl.textContent="OK";}function ensureWorker(){if(worker)return;worker=makeWorker();worker.onmessage=(e)=>{const m=e.data||{};if(m.type==="configured"){setStatus("READY","ok");appendLog("Config OK.","ok");return;}if(m.type==="state"){setStatus(m.running?"RUNNING":"STOPPED",m.running?"warn":"ok");return;}if(m.type==="boosted"){appendLog("BOOST appliqué.","warn");return;}if(m.type==="tick"){const o=m.out;lastPayload=o;histE.push(o.moteur.E);histNc.push(o.moteur.N_c);histHw.push(o.moteur.H_w);mswEl.textContent=o.sums.sum.toFixed(3);tailEl.textContent=o.sums.tail.toFixed(3);persistEl.textContent=String(o.persistCount);statutEl.textContent=(o.sums.sum>=0&&o.sums.sum<=1)?"OK":"VIOLATION";statutEl.className=(o.sums.sum>=0&&o.sums.sum<=1)?"ok":"error";symEl.textContent=o.sym_ok?"OK":"VIOLATION";symEl.className=o.sym_ok?"ok":"error";const strictTxt=o.strict_ok?"STRICT":"VIOLATION";const cls=(!o.sym_ok)?"error":(o.strict_ok?"ok":"warn");appendLog(\`Cycle \${o.cycle} | Mode <b>\${runMeta.mode}</b> | Niveau <b>\${o.niveau}</b> | E=\${o.moteur.E.toFixed(3)} | N_c=\${o.moteur.N_c} | H_w=\${o.moteur.H_w.toFixed(2)} | \${strictTxt} | Persist=\${o.persistCount}\`,cls);drawGraph(ctxE,histE,"#2bff7a",0,1.1,runMeta.cycles);drawGraph(ctxNc,histNc,"#2bd1ff",4,16,runMeta.cycles);drawGraph(ctxHw,histHw,"#ffd24a",0.2,0.8,runMeta.cycles);drawSpectre(ctxSpec,o.moteur.levels);return;}if(m.type==="done"){appendLog("Terminé.","warn");setStatus("DONE","ok");return;}};}function configure(){ensureWorker();runMeta={mode:modeEl.value,seed:parseInt(seedEl.value||"42",10),cycles:Math.max(1,parseInt(cyclesEl.value||"200",10)),tick:Math.max(5,parseInt(tickEl.value||"50",10)),thr:0.03};worker.postMessage({type:"config",cfg:runMeta});}function start(){configure();resetData();clearLog();appendLog("Démarrage...","warn");worker.postMessage({type:"start"});}function stop(){if(worker)worker.postMessage({type:"stop"});}function boost(){ensureWorker();worker.postMessage({type:"boost"});}function exportJSON(){const obj={meta:runMeta,last:lastPayload,hist:{E:histE,Nc:histNc,Hw:histHw},ts:new Date().toISOString()};const blob=new Blob([JSON.stringify(obj,null,2)],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="pc_quantum_lab_export.json";a.click();}$("#startBtn").onclick=start;$("#stopBtn").onclick=stop;$("#boostBtn").onclick=boost;$("#exportBtn").onclick=exportJSON;modeEl.onchange=()=>{configure();appendLog("Mode changé (reconfig prête).","warn");};configure();setStatus("READY","ok");appendLog("Prêt. Lance le test.","ok");})();</script></body></html>

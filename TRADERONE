cat >/root/apply_private_sentinel1.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
PATHLOC="/_private_sentinel1_/"
HTPASS="/etc/nginx/.htpasswd_sentinel1"
UPSTREAM="http://127.0.0.1:3000/"

echo "[1] Check vhost exists: $VHOST"
test -f "$VHOST"

echo "[2] Check immutable flag"
IMM=0
if lsattr "$VHOST" | grep -q '\-i\-'; then
  IMM=1
  echo "immutable: yes -> chattr -i"
  chattr -i "$VHOST"
else
  echo "immutable: no"
fi

echo "[3] Ensure htpasswd tool"
command -v htpasswd >/dev/null 2>&1 || (apt-get update -y && apt-get install -y apache2-utils)

echo "[4] Create/update BasicAuth user: sentinel"
mkdir -p /etc/nginx
if [ -f "$HTPASS" ]; then
  htpasswd "$HTPASS" sentinel
else
  htpasswd -c "$HTPASS" sentinel
fi
chmod 640 "$HTPASS"
chown root:www-data "$HTPASS" 2>/dev/null || true

echo "[5] Inject location block in vhost (if missing)"
if ! grep -q "_private_sentinel1_" "$VHOST"; then
  perl -0777 -pe 's/(server\s*\{)/$1\n\n  location ^~ \\/_private_sentinel1_\\/ {\\n    auth_basic \"Sentinel\";\\n    auth_basic_user_file \\/etc\\/nginx\\/.htpasswd_sentinel1;\\n\\n    proxy_pass http:\\/\\/127.0.0.1:3000\\/;\\n    proxy_http_version 1.1;\\n\\n    proxy_set_header Host \\$host;\\n    proxy_set_header X-Real-IP \\$remote_addr;\\n    proxy_set_header X-Forwarded-For \\$proxy_add_x_forwarded_for;\\n    proxy_set_header X-Forwarded-Proto \\$scheme;\\n  }\\n/;' -i "$VHOST"
  echo "location injected"
else
  echo "location already present: skip"
fi

echo "[6] nginx test + reload"
nginx -t
systemctl reload nginx

echo "[7] Quick test (expect 401 without auth)"
code="$(curl -s -o /dev/null -w "%{http_code}" "https://fireinners.online${PATHLOC}" || true)"
echo "HTTP code: $code"
if [ "$code" = "200" ]; then
  echo "WARNING: still not protected (should be 401). Check that this location is inside the correct SSL server block and not overridden."
fi

echo "[8] Restore immutable if it was enabled"
if [ "$IMM" = "1" ]; then
  chattr +i "$VHOST"
  echo "immutable restored"
fi

echo "DONE. Test in browser: https://fireinners.online${PATHLOC}"
BASH
chmod +x /root/apply_private_sentinel1.sh
bash /root/apply_private_sentinel1.sh
cat >/tmp/WOLVERINE_ONEURL_NGX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then . "$ASKLIB"; else
  askorupdate_yesno(){ local q="$1"; read -r -p "$q (y/N) " a || true; case "${a,,}" in y|yes) return 0;; *) return 1;; esac; }
  askorupdate_file(){ local p="$1" c="$2"; mkdir -p "$(dirname "$p")"; printf "%s" "$c" >"$p"; }
fi
say(){ printf "%s\n" "$*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { say "ERREUR: commande manquante: $1"; exit 1; }; }

SITE="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_oneurl.conf"
MARK="WOLVERINE_ONEURL_V1"

WOLV_ROOT="/opt/fireinners/frontend-react/app/dist/wolverine"
TR_DIR="/opt/traderone-opt"

need nginx; need awk; need sed; need grep; need find; need systemctl; need curl; need chattr

say "=== BATCH FLY (read-only) ==="
say "host: $(hostname)  date: $(date -u +%FT%TZ)"
[ -f "$SITE" ] || { say "ERREUR: nginx site absent: $SITE"; exit 1; }
[ -d "$WOLV_ROOT" ] || { say "ERREUR: Wolverine frontend absent: $WOLV_ROOT"; exit 1; }
[ -f "$WOLV_ROOT/index.html" ] || { say "ERREUR: Wolverine index.html absent: $WOLV_ROOT/index.html"; exit 1; }

# detect TraderOne frontend (optional)
TR_FRONT=""
for p in \
  "$TR_DIR/app/dist" \
  "$TR_DIR/dist" \
  "$TR_DIR/frontend/dist" \
  "$TR_DIR/frontend-react/app/dist" \
  "$TR_DIR/frontend/app/dist" \
  "$TR_DIR/build" \
; do
  if [ -f "$p/index.html" ]; then TR_FRONT="$p"; break; fi
done

# detect TraderOne port (from systemd env if exists)
TR_PORT="8585"
if systemctl list-unit-files | grep -q '^traderone\.service'; then
  envs="$(systemctl show -p Environment traderone.service 2>/dev/null | sed 's/^Environment=//')"
  p="$(echo "$envs" | tr ' ' '\n' | sed -nE 's/^PORT=([0-9]{2,5})$/\1/p' | head -n1)"
  [ -n "${p:-}" ] && TR_PORT="$p"
fi

say "Wolverine root: $WOLV_ROOT"
say "TraderOne dir:  $TR_DIR"
say "TraderOne front: ${TR_FRONT:-ABSENT (OK si tu veux juste l’API)}"
say "TraderOne port:  $TR_PORT"
say "nginx marker present? $(grep -q "$MARK" "$SITE" && echo yes || echo no)"

say "Ce script va:"
say "- ajouter proxy API TraderOne: /wolverine/traderone/api/ -> 127.0.0.1:$TR_PORT"
say "- (option) servir TraderOne UI: /wolverine/traderone/ -> ${TR_FRONT:-NONE}"
say "- ne touche PAS /wolverine/api/ (ton ping Telegram reste intact)"
say "- patch nginx (include snippet) + nginx -t + reload + re-lock chattr"
if ! askorupdate_yesno "Continuer ?"; then say "Stop."; exit 0; fi

say "=== APPLY ==="

SNIP_CONTENT="# $MARK
# TraderOne API sous Wolverine
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection \"upgrade\";
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  proxy_pass http://127.0.0.1:$TR_PORT/;
}
"
# add TraderOne UI serving only if TR_FRONT detected
if [ -n "${TR_FRONT:-}" ]; then
SNIP_CONTENT="$SNIP_CONTENT
# TraderOne UI (optionnel) sous Wolverine
location = /wolverine/traderone { return 301 /wolverine/traderone/; }
location ^~ /wolverine/traderone/ {
  alias $TR_FRONT/;
  try_files \$uri \$uri/ /wolverine/traderone/index.html;
}
"
fi

askorupdate_file "$SNIP" "$SNIP_CONTENT"

# safe nginx edit (per ta procédure)
chattr -i /etc/nginx/nginx.conf "$SITE" 2>/dev/null || true

if ! grep -q "$MARK" "$SITE"; then
  cp -a "$SITE" "$SITE.bak.$(date +%s)"
  awk -v snip="$SNIP" -v mark="$MARK" '
    BEGIN{inserver=0;done=0}
    {
      line=$0
      if(line ~ /^[ \t]*server[ \t]*\{/ && !inserver){inserver=1}
      if(inserver && !done && line ~ /^[ \t]*\}/){
        print "    include " snip "; # " mark
        done=1
      }
      print line
      if(inserver && line ~ /^[ \t]*\}/){inserver=0}
    }
  ' "$SITE" >"$SITE.tmp"
  mv "$SITE.tmp" "$SITE"
fi

nginx -t
systemctl reload nginx

chattr +i /etc/nginx/nginx.conf "$SITE" 2>/dev/null || true

say "=== TESTS ==="
say "UI Wolverine:"
curl -ksS --max-time 6 "https://fireinners.online/wolverine/" | head -c 120 || true
echo
say "API TraderOne (proxy) (peut retourner 404 si pas de route /):"
curl -ksS --max-time 6 "https://fireinners.online/wolverine/traderone/api/" | head -c 160 || true
echo
if [ -n "${TR_FRONT:-}" ]; then
  say "UI TraderOne:"
  curl -ksS --max-time 6 "https://fireinners.online/wolverine/traderone/" | head -c 120 || true
  echo
fi
say "DONE."
SH
chmod +x /tmp/WOLVERINE_ONEURL_NGX.sh
bash /tmp/WOLVERINE_ONEURL_NGX.sh
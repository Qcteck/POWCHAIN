source /opt/fireinners/sentinel/telegram.env
while true; do
  R="$(curl -sS "https://api.telegram.org/bot${TG_TOKEN}/getUpdates?timeout=60&limit=20")"
  echo "$R" | python3 - <<'PY'
import sys,json
j=json.loads(sys.stdin.read() or "{}")
for u in j.get("result",[]):
  m=u.get("message") or u.get("edited_message") or {}
  c=m.get("chat") or {}
  if "id" in c:
    print("CHAT_ID:", c["id"])
    print("TEXT:", m.get("text"))
    raise SystemExit(0)
raise SystemExit(1)
PY
  if [ $? -eq 0 ]; then break; fi
done





cat >/tmp/WOLVERINE_FIX_START_BTN_SAFE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
START_PATH="/wolverine/traderone/api/start"

cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

# détecte les IDs utilisés dans ton app.js (fallback si non trouvé)
BTN_START_ID="$(grep -oP 'const\s+btnStart\s*=\s*document\.getElementById\("\K[^"]+' "$APPJS" | head -n1 || true)"
BUDGET_ID="$(grep -oP 'const\s+budgetEl\s*=\s*document\.getElementById\("\K[^"]+' "$APPJS" | head -n1 || true)"
: "${BTN_START_ID:=btnStart}"
: "${BUDGET_ID:=budget}"

echo "BTN_START_ID=$BTN_START_ID"
echo "BUDGET_ID=$BUDGET_ID"
echo "START_PATH=$START_PATH"
echo

# supprime ancien bloc si présent
perl -0777 -i -pe 's|/\*\s*WOLVERINE_START_FIX_BEGIN\s*\*/.*?/\*\s*WOLVERINE_START_FIX_END\s*\*/\s*||sg' "$APPJS" || true

# ajoute bloc propre (override runtime)
cat >> "$APPJS" <<JS

/* WOLVERINE_START_FIX_BEGIN */
(function(){
  const btnStart = document.getElementById("${BTN_START_ID}");
  const budgetEl = document.getElementById("${BUDGET_ID}");

  if (!btnStart || !budgetEl) {
    console.log("START: elements introuvables", { btnStart: !!btnStart, budgetEl: !!budgetEl });
    return;
  }

  btnStart.onclick = async () => {
    try {
      if (typeof pubkey === "undefined" || !pubkey) {
        setStatus("Connecte d'abord ton wallet");
        return;
      }

      const b = Number(budgetEl.value);
      if (!isFinite(b) || b <= 0) {
        setStatus("Budget invalide");
        return;
      }

      setStatus("Envoi au bot...");
      const payload = { wallet: pubkey.toString(), budget: b };

      const r = await fetch("${START_PATH}", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const txt = await r.text();
      if (!r.ok) throw new Error("HTTP " + r.status + " " + txt.slice(0,200));

      let j;
      try { j = JSON.parse(txt); } catch(e) { j = { ok:true, raw: txt }; }
      console.log("START response:", j);
      setStatus("START OK ✔");
    } catch (e) {
      console.error(e);
      setStatus("ERR " + (e?.message || e));
    }
  };
})();
/* WOLVERINE_START_FIX_END */

JS

echo "== Confirm bloc ajouté =="
grep -n "WOLVERINE_START_FIX_" "$APPJS" || true
echo

echo "== Test API START via HTTPS (doit répondre, même erreur claire) =="
WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
curl -ksS -D- "https://fireinners.online${START_PATH}" \
  -X POST -H "Content-Type: application/json" \
  --data '{"wallet":"'"$WALLET"'","budget":1}' | head -n 40 || true
echo
echo "DONE ✅  => Ctrl+F5 /wolverine puis clique START (Network: POST start)."
SH

bash /tmp/WOLVERINE_FIX_START_BTN_SAFE.sh
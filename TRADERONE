mkdir -p "$INC_DIR"
cat >"$INC_FILE" <<EOF
# AUTO: bundler routes (${TS})
location = /bundler { return 301 /bundler/; }
location ^~ /bundler/ {
  alias ${WEBROOT}/;
  try_files \$uri \$uri/ /bundler/index.html;
}
location = /bundler/api { return 301 /bundler/api/; }
location ^~ /bundler/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://${API_HOST}:${API_PORT}/;
}
EOF

say "nginx: inject include into active ssl server{} (first match)"
python3 - <<PY
import re,sys,shutil
path="$ACTIVE_SSL_FILE"
bk="$BK/$(path.strip('/').replace('/','_'))"
shutil.copy2(path,bk)

lines=open(path,'r',errors='ignore').read().splitlines(True)

dom=re.compile(r'\\bserver_name\\b[^;]*\\b'+re.escape("$DOMAIN")+r'\\b', re.I)
listen443=re.compile(r'\\blisten\\b[^;]*\\b443\\b[^;]*\\bssl\\b', re.I)
inc=re.compile(r'\\binclude\\s+'+re.escape("$INC_FILE")+r'\\s*;', re.I)

out=[]
depth=0
in_srv=False
srv_has_dom=False
srv_has_443=False
srv_has_inc=False
injected=False

def brace_delta(s):
  return s.count('{')-s.count('}')

for i,ln in enumerate(lines):
  stripped=ln.strip()
  if not in_srv and re.search(r'\\bserver\\s*\\{', stripped):
    in_srv=True; srv_has_dom=False; srv_has_443=False; srv_has_inc=False
    depth += brace_delta(ln)
    out.append(ln)
    continue

  if in_srv:
    if dom.search(stripped): srv_has_dom=True
    if listen443.search(stripped): srv_has_443=True
    if inc.search(stripped): srv_has_inc=True

    # if this line closes the server block
    if depth + brace_delta(ln) <= 0:
      if (not injected) and srv_has_dom and srv_has_443 and (not srv_has_inc):
        out.append(f"  include {\"$INC_FILE\"};\\n")
        injected=True
      out.append(ln)
      depth += brace_delta(ln)
      in_srv=False
      continue

    out.append(ln)
    depth += brace_delta(ln)
    continue

  out.append(ln)

open(path,'w').write(''.join(out))
print("injected:", injected)
PY


cat >/root/finalize_github_repo.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DIR="/opt/WOLVERINE1_export"
REPO_URL="https://github.com/Qcteck/WOLVERINE1"

cd "$DIR"

echo "== 1) Verify remote is clean (NO token in URL) =="
git remote set-url origin "${REPO_URL}.git"
git remote -v

echo
echo "== 2) Verify branch + last commits =="
git branch --show-current
git log --oneline -5

echo
echo "== 3) Verify push status =="
git status -sb

echo
echo "== 4) Confirm GitHub sees it (no creds needed) =="
git ls-remote "${REPO_URL}.git" HEAD || true

echo
echo "DONE ✅ Open: ${REPO_URL}"
BASH

chmod +x /root/finalize_github_repo.sh
/root/finalize_github_repo.sh
cat >/root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V4_ONE_SHOT.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027

TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v python3 >/dev/null 2>&1 || die "python3 missing"
command -v curl >/dev/null 2>&1 || die "curl missing"

DOMAIN="fireinners.online"
WEBROOT="/var/www/aquila_stacking"
PATH_A="/aquila_stacking/"
PATH_B="/iaaquila/"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"

BK="/root/AQUILA_STACKING_WEBROUTE_FIX_V4_BK_${TS}"
mkdir -p "$BK"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "AquilaStacking routes v4" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
    rm -f "$tmp"
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(echo "$path" | sed 's#/#_#g').bak" || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}

say "1) WEBROOT + index.html"
mkdir -p "$WEBROOT"
chmod 0755 "$WEBROOT" || true
chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true

cat >"$WEBROOT/index.html"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><style>body{font-family:system-ui,Segoe UI,Arial;margin:24px;max-width:980px}code{background:#0b1020;color:#d7e3ff;padding:2px 6px;border-radius:6px}pre{background:#0b1020;color:#d7e3ff;padding:12px;border-radius:10px;overflow:auto}a{color:#2b6fff;text-decoration:none}a:hover{text-decoration:underline}.box{border:1px solid #e5e7eb;border-radius:12px;padding:14px;margin:12px 0}</style></head><body><h1>AquilaStacking</h1><div class="box"><b>URLs</b><div>• <a href="${PATH_B}">${PATH_B}</a></div><div>• <a href="${PATH_A}">${PATH_A}</a></div></div><div class="box"><b>Webroot</b> <code>${WEBROOT}</code></div></body></html>
EOF
chown www-data:www-data "$WEBROOT/index.html" 2>/dev/null || true
chmod 0644 "$WEBROOT/index.html" || true

say "2) Write nginx include (routes) => $INC"
ROUTES="### AQUILA_STACKING_WEBROUTES_V4_BEGIN
# Debug header to prove the active vhost is using these routes
add_header X-AquilaStacking \"1\" always;

location = ${PATH_B%/} { return 301 ${PATH_B}; }
location ^~ ${PATH_B} {
  alias ${WEBROOT}/;
  index index.html;
  add_header Cache-Control \"no-store\" always;
  try_files \$uri \$uri/ ${PATH_B}index.html =404;
}

location = ${PATH_A%/} { return 301 ${PATH_A}; }
location ^~ ${PATH_A} {
  alias ${WEBROOT}/;
  index index.html;
  add_header Cache-Control \"no-store\" always;
  try_files \$uri \$uri/ ${PATH_A}index.html =404;
}
### AQUILA_STACKING_WEBROUTES_V4_END"
write_file "$INC" "$ROUTES"

say "3) Dump nginx -T + find candidate vhost files"
nginx -T >"$BK/nginx_T.txt" 2>&1 || die "nginx -T failed"

python3 - <<'PY'
import os,re,sys,shutil
BK=os.environ["BK"]
DOMAIN=os.environ["DOMAIN"]
INC=os.environ["INC"]
T=open(os.path.join(BK,"nginx_T.txt"),"r",errors="ignore").read()

# Keep config files in nginx -T order
files=[]
for m in re.finditer(r"^# configuration file (.+?):", T, flags=re.M):
    p=m.group(1).strip()
    if p.startswith("/") and os.path.isfile(p):
        files.append(p)

# Candidate files: those that mention domain OR known fireinners ssl names
cand=[]
for p in files:
    try:
        txt=open(p,"r",errors="ignore").read()
    except:
        continue
    if re.search(r"server_name\s+[^;]*\b"+re.escape(DOMAIN)+r"\b", txt) or ("fireinners.online-ssl" in p) or ("fireinners.online" in p and "/etc/nginx/sites-" in p) or ("fireinners.online" in p and "/etc/nginx/conf.d/" in p):
        cand.append(p)

cand=list(dict.fromkeys(cand))
open(os.path.join(BK,"candidates.txt"),"w").write("\n".join(cand)+"\n")

def patch_443_domain_server_blocks(txt):
    # Patch every server{...} with listen 443 and server_name includes DOMAIN by inserting include INC; after server_name line
    # Idempotent if include already present in that server block.
    pat=re.compile(r"\bserver\s*\{", re.I)
    out=[]
    idx=0
    n=len(txt)
    changed=False
    while True:
        m=pat.search(txt, idx)
        if not m:
            out.append(txt[idx:])
            break
        out.append(txt[idx:m.start()])
        brace=txt.find("{", m.end()-1)
        if brace==-1:
            out.append(txt[m.start():]); break
        depth=0
        j=brace
        while j<n:
            c=txt[j]
            if c=="{": depth+=1
            elif c=="}":
                depth-=1
                if depth==0:
                    end=j+1; break
            j+=1
        else:
            out.append(txt[m.start():]); break

        block=txt[m.start():end]
        idx=end

        if INC in block:
            out.append(block); continue

        if re.search(r"(?m)^\s*listen\s+[^;]*\b443\b", block) and re.search(r"(?m)^\s*server_name\s+[^;]*\b"+re.escape(DOMAIN)+r"\b", block):
            lines=block.splitlines(True)
            nb=[]
            inserted=False
            for ln in lines:
                nb.append(ln)
                if (not inserted) and re.search(r"^\s*server_name\s+[^;]*\b"+re.escape(DOMAIN)+r"\b", ln):
                    nb.append(f"    include {INC};\n")
                    inserted=True
            if inserted:
                block="".join(nb)
                changed=True

        out.append(block)
    return "".join(out), changed

patched=[]
for p in cand:
    try:
        txt=open(p,"r",errors="ignore").read()
    except:
        continue
    newtxt,chg=patch_443_domain_server_blocks(txt)
    if chg:
        shutil.copy2(p, os.path.join(BK, os.path.basename(p)+".bak"))
        os.system(f"chattr -i {p} 2>/dev/null || true")
        open(p,"w").write(newtxt)
        patched.append(p)

open(os.path.join(BK,"patched.txt"),"w").write("\n".join(patched)+"\n")
print("patched_files=",len(patched))
PY

say "4) nginx test + reload"
if ! nginx -t; then
  die "nginx -t failed (see $BK/nginx_T.txt and $BK/*.bak backups)"
fi
systemctl reload nginx

say "5) Local HTTPS verify (force localhost) + check debug header"
HDR_A="$(curl -k -sSI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_B}" | tr -d '\r' | head -n 40 || true)"
echo "$HDR_A" >"$BK/head_iaaquila.txt"
echo "$HDR_A" | grep -qi "^HTTP/" || die "no HTTP response for ${PATH_B} (see $BK/head_iaaquila.txt)"
echo "$HDR_A" | grep -qi "X-AquilaStacking: 1" || die "routes not active for ${PATH_B} (missing header) (see $BK/head_iaaquila.txt)"

HDR_B="$(curl -k -sSI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_A}" | tr -d '\r' | head -n 40 || true)"
echo "$HDR_B" >"$BK/head_aquila_stacking.txt"
echo "$HDR_B" | grep -qi "^HTTP/" || die "no HTTP response for ${PATH_A} (see $BK/head_aquila_stacking.txt)"
echo "$HDR_B" | grep -qi "X-AquilaStacking: 1" || die "routes not active for ${PATH_A} (missing header) (see $BK/head_aquila_stacking.txt)"

say "6) Body verify (must contain AquilaStacking)"
BODY_A="$(curl -k -sS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_B}" | head -n 5 || true)"
echo "$BODY_A" | grep -qi "AquilaStacking" || { echo "$BODY_A" >"$BK/body_iaaquila_head.txt"; die "still not serving page on ${PATH_B} (see $BK/body_iaaquila_head.txt)"; }

BODY_B="$(curl -k -sS --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_A}" | head -n 5 || true)"
echo "$BODY_B" | grep -qi "AquilaStacking" || { echo "$BODY_B" >"$BK/body_aquila_head.txt"; die "still not serving page on ${PATH_A} (see $BK/body_aquila_head.txt)"; }

say "DONE"
say "Open: https://${DOMAIN}${PATH_B}"
say "Open: https://${DOMAIN}${PATH_A}"
say "BK: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V4_ONE_SHOT.sh
BK="/root/AQUILA_STACKING_WEBROUTE_FIX_V4_BK_$(date +%Y%m%d_%H%M%S)" DOMAIN="fireinners.online" INC="/etc/nginx/includes/aquila_stacking_routes.inc" bash /root/MEGA_AQUILA_STACKING_WEBROUTE_FIX_V4_ONE_SHOT.sh
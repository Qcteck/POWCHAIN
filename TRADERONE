# Canonique Wolverine routes (single include, no duplicate location)
# Static Next export under /wolverine served from: ${FRONT_DIR}

# Force clean base path
location = /wolverine { return 301 /wolverine/; }

# Block SW/manifest to avoid cache madness if needed
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

# TraderOne API (HTTP)
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://127.0.0.1:3000/api/;
}

# TraderOne WS (if backend exposes /ws/)
location ^~ /wolverine/traderone/ws/ {
  proxy_http_version 1.1;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_set_header Host \$host;
  proxy_pass http://127.0.0.1:3000/ws/;
}

# Next static assets (cache long)
location ^~ /wolverine/_next/ {
  alias ${FRONT_DIR}/_next/;
  try_files \$uri \$uri/ =404;
  add_header Cache-Control "public, max-age=31536000, immutable";
}

# Main frontend (SINGLE prefix location for /wolverine/)
location ^~ /wolverine/ {
  alias ${FRONT_DIR}/;
  try_files \$uri \$uri/ /wolverine/index.html;
}
EOF
ok "Include canonique écrit: $INC"

say "5) Injecter UNE seule fois l'include dans le BON server 443 du vhost"
python3 - <<'PY' >>"$LOG" 2>&1
from pathlib import Path
import re

vhost=Path("/etc/nginx/sites-available/fireinners.online-ssl")
inc="/etc/nginx/includes/wolverine_routes.inc"
s=vhost.read_text(errors="ignore")

# Remove any stale include line (defensive)
s=re.sub(r'^\s*include\s+[^;]*wolverine_routes\.inc\s*;\s*$', '', s, flags=re.M)

# Find SSL server block that matches host
# naive brace parser to locate "server { ... }" blocks
def blocks(text):
    out=[]
    i=0
    while True:
        j=text.find("server", i)
        if j==-1: break
        k=text.find("{", j)
        if k==-1: break
        depth=0
        m=k
        while m < len(text):
            if text[m]=="{": depth+=1
            elif text[m]=="}":
                depth-=1
                if depth==0:
                    out.append((j, m+1))
                    i=m+1
                    break
            m+=1
        else:
            break
    return out

b=blocks(s)
target=None
for (a,z) in b:
    blk=s[a:z]
    if re.search(r'listen\s+443\b', blk) and re.search(r'\bserver_name\b[^;]*\bfireinners\.online\b', blk):
        target=(a,z); break

if not target:
    # fallback: first 443
    for (a,z) in b:
        blk=s[a:z]
        if re.search(r'listen\s+443\b', blk):
            target=(a,z); break

if not target:
    raise SystemExit("No server{ listen 443 } block found in vhost")

a,z=target
blk=s[a:z]

# Insert include near top of server block, after server_name if possible
if "wolverine_routes.inc" not in blk:
    lines=blk.splitlines(True)
    out=[]
    inserted=False
    for line in lines:
        out.append(line)
        if (not inserted) and re.search(r'^\s*server_name\b', line):
            out.append(f"  include {inc};\n")
            inserted=True
    if not inserted:
        # put right after "server {"
        out2=[]
        for line in out:
            out2.append(line)
            if (not inserted) and re.search(r'^\s*server\s*\{\s*$', line):
                out2.append(f"  include {inc};\n")
                inserted=True
        out=out2
    blk="".join(out)

s = s[:a] + blk + s[z:]
vhost.write_text(s)
print("include_injected=1")
PY
ok "Include injecté une seule fois dans le vhost SSL."


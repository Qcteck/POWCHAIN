bash <<'EOF'
set -e

echo "=== AIAQUILA RSS SIMPLE & SOLIDE ==="

DIR=/var/www/aiaquila
mkdir -p $DIR

# ---------- BACKEND PHP : PARSING RSS ----------
cat > $DIR/rss.php <<'PHP'
<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/json; charset=UTF-8");

$feeds=[
 "https://www.coindesk.com/arc/outboundfeeds/rss/",
 "https://cointelegraph.com/rss",
 "https://news.bitcoin.com/feed/"
];

$articles=[];

foreach($feeds as $url){
 $xml=@simplexml_load_file($url,"SimpleXMLElement",LIBXML_NOCDATA);
 if(!$xml) continue;

 if(isset($xml->channel->item)){
  foreach($xml->channel->item as $item){
   $articles[]=[
    "title"=>(string)$item->title,
    "link"=>(string)$item->link
   ];
  }
 }

 if(isset($xml->entry)){
  foreach($xml->entry as $e){
   $articles[]=[
    "title"=>(string)$e->title,
    "link"=>(string)$e->link['href']
   ];
  }
 }
}

echo json_encode($articles);
PHP

# ---------- FRONT HTML ULTRA SIMPLE ----------
cat > $DIR/index.html <<'HTML'
<!doctype html>
<html lang="fr">
<meta charset="utf-8">
<title>AIAQUILA RSS</title>
<style>
body{background:#0b1220;color:#e5e7eb;font-family:Arial;padding:20px}
button{padding:8px 12px}
.article{margin:6px 0}
</style>

<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="load()">Lire les articles</button>
<div id="log"></div>
<div id="list"></div>

<script>
async function load(){
 document.getElementById("list").innerHTML="";
 document.getElementById("log").textContent="Chargement…";
 const r=await fetch("rss.php");
 const data=await r.json();
 document.getElementById("log").textContent="TOTAL : "+data.length+" articles";
 for(const a of data){
  const d=document.createElement("div");
  d.className="article";
  d.innerHTML="<a href='"+a.link+"' target=_blank>"+a.title+"</a>";
  document.getElementById("list").appendChild(d);
 }
}
</script>
</html>
HTML

chown -R www-data:www-data $DIR
chmod 644 $DIR/*

echo "=== OK ==="
echo "Ouvre https://fireinners.online/aiaquila/"
EOF
    const mountPoint = walletTitle ? walletTitle.closest("div") : null;
    (mountPoint||document.body).appendChild(box);

    qs("#aquila-go").onclick = async ()=>{{
      try{{
        if(!window.solanaWeb3){{ alert("solanaWeb3 not defined"); return; }}
        const s=(qs("#aquila-budget").value||"").replace(",",".").trim();
        const budget=parseFloat(s);
        if(!(budget>0)){{ st("Budget invalide"); return; }}

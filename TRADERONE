set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
SNIP="/etc/nginx/snippets/wolverine_auth_phantom.conf"

echo "=== 1) Ecris/force le snippet (bypass auth/deny) ==="
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'NGX'
location ^~ /wolverine/traderone/api/auth/ {
  auth_basic off;
  satisfy any;
  allow all;

  proxy_pass http://127.0.0.1:3005/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
NGX
echo "OK: $SNIP"

echo
echo "=== 2) Liste fichiers nginx qui parlent de fireinners.online ==="
FILES=$(nginx -T 2>/dev/null \
  | grep -E '^# configuration file ' \
  | awk '{print $4}' | sort -u)

TARGETS=""
for f in $FILES; do
  [ -f "$f" ] || continue
  if grep -qiE 'server_name[[:space:]]+.*fireinners\.online' "$f" && grep -qE 'listen[[:space:]]+443' "$f"; then
    TARGETS="$TARGETS $f"
  fi
done

echo "Targets (443 + fireinners.online):"
for f in $TARGETS; do echo " - $f"; done

echo
echo "=== 3) Inject include dans ces fichiers (une seule fois) ==="
for f in $TARGETS; do
  if grep -q "snippets/wolverine_auth_phantom.conf" "$f"; then
    echo "Already has include: $f"
    continue
  fi
  cp -a "$f" "$f.bak.phantomfix.$TS"
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/wolverine_auth_phantom.conf;/' "$f"
  echo "Injected: $f"
done

echo
echo "=== 4) Reload nginx ==="
nginx -t
systemctl reload nginx

echo
echo "=== 5) TEST ORIGIN (bypass CF) — doit plus etre 403 ==="
curl -sk --resolve fireinners.online:443:127.0.0.1 \
  https://fireinners.online/wolverine/traderone/api/auth/health | head -c 220; echo

curl -sk --resolve fireinners.online:443:127.0.0.1 \
  "https://fireinners.online/wolverine/traderone/api/auth/phantom/challenge?pubkey=11111111111111111111111111111111" | head -c 260; echo
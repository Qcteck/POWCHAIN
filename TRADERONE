cat >/root/export_push_wolverine_monorepo.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

REPO_URL="https://github.com/Qcteck/WOLVERINE1.git"
EXPORT="/opt/WOLVERINE1_export"

UI_SRC="/var/www/wolverine"
BACKEND_SRC="/opt/traderone-opt"
AUTH_SRC="/opt/fireinners-auth-phantom"
SOLRPC_SRC="/opt/fireinners/solrpc-proxy"

echo "== 0) Clean export dir =="
rm -rf "$EXPORT"
mkdir -p "$EXPORT"

echo "== 1) Copy sources =="
mkdir -p "$EXPORT/ui" "$EXPORT/backend-traderone" "$EXPORT/auth-phantom" "$EXPORT/solrpc-proxy"
rsync -a --delete "$UI_SRC"/ "$EXPORT/ui"/
rsync -a --delete "$BACKEND_SRC"/ "$EXPORT/backend-traderone"/
rsync -a --delete "$AUTH_SRC"/ "$EXPORT/auth-phantom"/
rsync -a --delete "$SOLRPC_SRC"/ "$EXPORT/solrpc-proxy"/

echo "== 2) Remove obvious secrets/artifacts =="
# delete env/secrets/keys anywhere inside export
find "$EXPORT" -type f \( -name ".env" -o -name ".env.*" -o -name "*.pem" -o -name "*.key" -o -name "*.crt" \) -print -delete 2>/dev/null || true
find "$EXPORT" -type d \( -name "node_modules" -o -name ".next" -o -name "dist" -o -name "build" -o -name "coverage" -o -name "logs" \) -prune -print -exec rm -rf {} + 2>/dev/null || true

echo "== 3) Write .gitignore =="
cat > "$EXPORT/.gitignore" <<'EOF'
# secrets / env
.env
.env.*
*.pem
*.key
*.crt
secrets/
keys/
wallets/
**/wallets/
**/keys/

# deps/build
node_modules/
.next/
out/
dist/
build/
coverage/

# logs
logs/
*.log

# OS
.DS_Store
EOF

echo "== 4) Init git + commit =="
cd "$EXPORT"
git init
git add -A
git commit -m "server export snapshot" || true
git branch -M main
git remote remove origin 2>/dev/null || true
git remote add origin "$REPO_URL"

echo "== 5) Push =="
echo "If prompted for password: use a GitHub Personal Access Token (PAT)."
git push -u origin main
echo "DONE ✅"
BASH

chmod +x /root/export_push_wolverine_monorepo.sh
/root/export_push_wolverine_monorepo.sh
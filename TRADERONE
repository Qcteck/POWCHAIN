# ROOT — list ALL index backups sequentially (sorted) + previews + optional diffs
set -euo pipefail

UI_DIST="/var/www/wolverine"
ARCH_GLOB="/var/www/_ARCHIVE_WOLVERINE_*"

echo "=== 0) Where ==="
echo "UI_DIST   = $UI_DIST"
echo "ARCH_GLOB = $ARCH_GLOB"
echo

echo "=== 1) Index files in UI_DIST (sorted newest first) ==="
if [ -d "$UI_DIST" ]; then
  find "$UI_DIST" -maxdepth 1 -type f -name "index.html*" -printf "%TY-%Tm-%Td %TH:%TM:%TS  %9s  %p\n" | sort -r
else
  echo "MISSING: $UI_DIST"
fi

echo
echo "=== 2) Index files inside archives (sorted newest first) ==="
for a in $ARCH_GLOB; do
  [ -d "$a" ] || continue
  find "$a" -maxdepth 2 -type f -name "index.html*" -printf "%TY-%Tm-%Td %TH:%TM:%TS  %9s  %p\n" | sort -r || true
done

echo
echo "=== 3) Show each index (one after another) ==="
MAP="/tmp/_index_list.txt"
: > "$MAP"

# collect candidates
if [ -d "$UI_DIST" ]; then
  find "$UI_DIST" -maxdepth 1 -type f -name "index.html*" -print >> "$MAP" || true
fi
for a in $ARCH_GLOB; do
  [ -d "$a" ] || continue
  find "$a" -maxdepth 2 -type f -name "index.html*" -print >> "$MAP" || true
done

# sort by mtime desc
python3 - <<'PY' "$MAP"
import os, sys
paths=[p.strip() for p in open(sys.argv[1]) if p.strip() and os.path.exists(p.strip())]
paths.sort(key=lambda p: os.path.getmtime(p), reverse=True)
for p in paths: print(p)
PY > "$MAP.sorted"

n=0
while IFS= read -r f; do
  n=$((n+1))
  echo
  echo "=============================="
  echo "[$n] $(date -r "$f" '+%F %T')  $(stat -c '%s bytes' "$f")"
  echo "$f"
  echo "----- FIRST 40 LINES -----"
  sed -n '1,40p' "$f" || true
  echo "----- LAST 20 LINES -----"
  tail -n 20 "$f" || true
done < "$MAP.sorted"

echo
echo "DONE ✅  Total files: $n"
echo "Tip: open specific one:  less -N <path>"
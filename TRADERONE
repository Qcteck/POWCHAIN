import sys,re
p, rpc, base = sys.argv[1], sys.argv[2], sys.argv[3]
s=open(p,"r",encoding="utf-8",errors="ignore").read().splitlines()
kv={}
out=[]
def setk(k,v):
  kv[k]=v
for ln in s:
  if not ln.strip() or ln.lstrip().startswith("#"):
    out.append(ln); continue
  m=re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$", ln)
  if not m: out.append(ln); continue
  k=m.group(1); v=m.group(2)
  kv[k]=v
for k,v in [("DEFAULT_RPC",rpc),("PUBLIC_BASE",base),("ASSETS_DIR","public/assets")]:
  kv[k]=v
# rebuild, preserving existing non-key lines, then ensure keys exist at end
kept=set()
new=[]
for ln in out:
  m=re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=", ln or "")
  if m and m.group(1) in kv:
    k=m.group(1); new.append(f"{k}={kv[k]}"); kept.add(k)
  else:
    new.append(ln)
for k in ["DEFAULT_RPC","PUBLIC_BASE","ASSETS_DIR"]:
  if k not in kept:
    new.append(f"{k}={kv[k]}")
open(p,"w",encoding="utf-8").write("\n".join(new).rstrip()+"\n")
print("OK .env updated:",p)

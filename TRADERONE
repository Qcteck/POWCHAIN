cd /opt/WOLVERINE1_export || exit 1

# 1) vire le .git du monorepo si partiellement créé
rm -rf .git

# 2) vire tous les .git copiés depuis /opt/* (repos imbriqués)
find . -name .git -type d -prune -exec rm -rf {} +
find . -name .git -type f -delete

# (optionnel) recheck rapide
find . -name .git -print

# 3) commit + push propre
git init
git add -A
git commit -m "server export snapshot"
git branch -M main
git remote remove origin 2>/dev/null || true
git remote add origin https://github.com/Qcteck/WOLVERINE1.git
git push -u origin main
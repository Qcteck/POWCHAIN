set -euo pipefail

APP="/opt/fireinners/frontend-react/app"
DIST="/var/www/wolverine"

cd "$APP"

echo "=== Sanity ==="
pwd
ls -lah package.json package-lock.json || true

echo "=== Vérif rapide du lockfile (JSON) ==="
node -e "JSON.parse(require('fs').readFileSync('package-lock.json','utf8')); console.log('OK: lockfile JSON valide')" \
  || { echo "KO: lockfile cassé -> regen"; }

echo "=== Regen lockfile si besoin ==="
if ! node -e "JSON.parse(require('fs').readFileSync('package-lock.json','utf8'))" >/dev/null 2>&1; then
  cp -a package-lock.json "package-lock.json.bad.$(date +%s)" || true
  rm -f package-lock.json
  npm install --package-lock-only
fi

echo "=== Install + build ==="
npm ci || npm install
npm run build

echo "=== Deploy dist -> $DIST ==="
apt-get update -y
apt-get install -y rsync
mkdir -p "$DIST"
rsync -a --delete "$APP/dist/" "$DIST/"

chmod -R 755 /var/www
find "$DIST" -type f -exec chmod 644 {} \;

echo "=== Test UI ==="
curl -sS -I https://fireinners.online/wolverine/ | head -n 12
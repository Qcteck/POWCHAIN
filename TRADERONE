bash -c "$(cat <<'BASH'
set -euo pipefail
HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

echo "=== FIX USDC DECIMALS (FINAL) ==="
cp "$HTML" "$HTML.usdc_decimals_fix_$TS"

sed -i 's|tot+=Number(x.account.data.parsed.info.tokenAmount.uiAmount||0)|const ta=x.account.data.parsed.info.tokenAmount;tot+=ta.uiAmount!==null?Number(ta.uiAmount):(Number(ta.amount)/Math.pow(10,ta.decimals))|g' "$HTML"

echo "=== DONE ==="
echo "➡️ Hard refresh navigateur (CTRL+SHIFT+R)"
BASH
)"
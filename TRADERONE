  // 3) Helper global: create vault (utilisable même si l'UI n'est pas à jour)
  window.__createVaultFinal = async function(pub, provider){
    if(!provider||!provider.signMessage) throw new Error("Phantom signMessage missing");
    var ts=Date.now();
    var msg="VAULT_CREATE:"+pub+":"+ts;
    var enc=new TextEncoder();
    var signed=await provider.signMessage(enc.encode(msg), "utf8");
    // signed.signature: Uint8Array
    // bs58 local (si déjà chargé ailleurs) sinon mini encode
    function b58enc(bytes){
      if(window.bs58&&window.bs58.encode) return window.bs58.encode(bytes);
      var ALPH="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
      var d=[0];
      for(var i=0;i<bytes.length;i++){
        var c=bytes[i];
        for(var j=0;j<d.length;j++){ c += d[j]<<8; d[j]=c%58; c=(c/58)|0; }
        while(c){ d.push(c%58); c=(c/58)|0; }
      }
      var s="";
      for(var k=0; bytes[k]===0 && k<bytes.length-1; k++) s+=ALPH[0];
      for(var q=d.length-1;q>=0;q--) s+=ALPH[d[q]];
      return s;
    }
    var sig=b58enc(signed.signature);
    var r=await fetch(VAULT_BASE+"/create",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({userPub:pub,sig:sig,ts:ts})});
    return await r.json();
  };
}catch(e){}})();</script>
'''

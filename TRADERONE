#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA PHP FIX ==="

# 1. Installer PHP-FPM si absent
apt update
apt install -y php php-fpm php-curl

PHP_SOCK=$(ls /run/php/php*-fpm.sock | head -n1)

echo "PHP socket: $PHP_SOCK"

# 2. Patch vhost nginx fireinners
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

cp "$VHOST" "$VHOST.backup_$(date +%Y%m%d_%H%M%S)"

# Inject PHP handler if missing
if ! grep -q "fastcgi_pass.*php" "$VHOST"; then
  sed -i '/location \//a \
    location ~ \\.php$ {\
        include snippets/fastcgi-php.conf;\
        fastcgi_pass unix:'"$PHP_SOCK"';\
    }\
' "$VHOST"
fi

# 3. Reload services
systemctl restart php*-fpm
nginx -t
systemctl reload nginx

echo "=== PHP ACTIVÉ POUR AIAQUILA ==="
echo "Teste maintenant :"
echo "https://fireinners.online/aiaquila/rss-proxy.php?url=https://www.coindesk.com/arc/outboundfeeds/rss/"
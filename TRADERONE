cat >/root/traderone_audit_qplus_secure.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== TIME / HOST ==="
date -u
hostname
echo

echo "=== PM2 / NODE processes ==="
command -v pm2 >/dev/null 2>&1 && pm2 list || echo "pm2 not installed"
ps auxww | grep -E "[n]ode|[p]m2" | head -n 120
echo

echo "=== PM2 details (show 0..5) ==="
if command -v pm2 >/dev/null 2>&1; then
  for i in 0 1 2 3 4 5; do
    echo "----- pm2 show $i -----"
    pm2 show "$i" 2>/dev/null | sed -n '1,160p' || true
  done
fi
echo

APP="/root/qplus-secure"
if [ ! -d "$APP" ]; then
  echo "❌ Missing $APP"
  echo "Searching for likely app roots..."
  find /root -maxdepth 4 -type f -name package.json 2>/dev/null | head -n 50
  exit 0
fi

echo "=== APP ROOT ==="
echo "$APP"
ls -lah "$APP" | head -n 80
echo

echo "=== FIND main files ==="
find "$APP" -maxdepth 4 -type f \( -name package.json -o -name ecosystem.config.js -o -name server.js -o -name app.js -o -name index.js \) -print 2>/dev/null
echo

echo "=== ENDPOINTS (express/nest) ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  "app\.(get|post|put|delete)|router\.(get|post|put|delete)|@Controller|@Post\(|/api/" \
  "$APP" 2>/dev/null | head -n 220 || true
echo

echo "=== LI.FI / routing keywords ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  "lifi|li\.fi|LI\.FI|getRoutes|route|routes|quote|bridge|swap" \
  "$APP" 2>/dev/null | head -n 220 || true
echo

echo "=== Key-material *locations only* (do NOT paste values) ==="
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  "secretKey|privateKey|mnemonic|seed|fromSecretKey|Keypair\.from|process\.env" \
  "$APP" 2>/dev/null | head -n 220 || true
echo

echo "=== .env files (paths only) ==="
find "$APP" -maxdepth 5 -type f -name ".env*" -print 2>/dev/null | head -n 80 || true
echo

echo "DONE ✅"
BASH

chmod +x /root/traderone_audit_qplus_secure.sh
/root/traderone_audit_qplus_secure.sh
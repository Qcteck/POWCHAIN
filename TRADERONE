cat >/etc/nginx/snippets/wolverine_static_tryfiles.conf <<'EOF'
# WOLV_STATIC_TRYFILES_V1
location ^~ /wolverine/ {
  try_files $uri $uri/ =404;
}
EOF

# Ajoute l'include dans le site si absent
NGX="/etc/nginx/sites-available/fireinners.online-ssl"
grep -q "wolverine_static_tryfiles.conf" "$NGX" || \
  sed -i '/server[[:space:]]*{/a\    include /etc/nginx/snippets/wolverine_static_tryfiles.conf; # WOLV_STATIC_TRYFILES_V1' "$NGX"

nginx -t && systemctl reload nginx

curl -ksS "https://fireinners.online/wolverine/traderone_overlay.js?v=2" | head -n 3
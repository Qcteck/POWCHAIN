cat >/root/TRADERONE_PORT_FIX.sh <<'SH'
#!/usr/bin/env bash
set -e

echo "=== TRADERONE PORT FIX ==="

# 1) Vérifier écoute locale
echo "[1] Check local listen"
ss -lntp | grep 3000 || echo "[WARN] port 3000 not listening yet"

# 2) Ouvrir firewall UFW si actif
if command -v ufw >/dev/null 2>&1; then
  echo "[2] UFW detected"
  ufw allow 3000/tcp || true
  ufw reload || true
else
  echo "[2] UFW not installed"
fi

# 3) Ouvrir via iptables (fallback)
echo "[3] iptables fallback"
iptables -I INPUT -p tcp --dport 3000 -j ACCEPT || true

# 4) Redémarrer TraderOne proprement
echo "[4] Restart TraderOne"
pm2 restart traderone
pm2 save

# 5) Test local
echo "[5] Local test"
curl -fsS http://127.0.0.1:3000 || echo "[WARN] local test failed"

# 6) Afficher IP
IP=$(curl -s ifconfig.me || hostname -I | awk '{print $1}')
echo "=== DONE ==="
echo "OPEN : http://$IP:3000"
SH

chmod +x /root/TRADERONE_PORT_FIX.sh
/root/TRADERONE_PORT_FIX.sh
cat >/root/trace_rpc_403_origin_or_cf.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
INC="/etc/nginx/includes/wolverine_routes.inc"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$INC" || { echo "Missing $INC"; exit 1; }
cp -a "$INC" "${INC}.bak_${TS}"

python3 - <<'PY'
import re, pathlib
p = pathlib.Path("/etc/nginx/includes/wolverine_routes.inc")
s = p.read_text(errors="ignore")

# remove existing rpc blocks we injected before (marker-based)
s = re.sub(r"\n?#\s*WOLVERINE_RPC_PROXY_BEGIN.*?#\s*WOLVERINE_RPC_PROXY_END\s*\n?", "\n", s, flags=re.S)
# remove any raw rpc location blocks (best effort)
s = re.sub(r"\n\s*location\s*=\s*/wolverine/rpc\s*\{.*?\n\s*\}\s*\n", "\n", s, flags=re.S)
s = re.sub(r"\n\s*location\s*\^~\s*/wolverine/rpc/\s*\{.*?\n\s*\}\s*\n", "\n", s, flags=re.S)

block = r'''
# WOLVERINE_RPC_PROXY_BEGIN
# Solana JSON-RPC proxy (same-origin) + TRACE
location = /wolverine/rpc {
  # TRACE headers (si tu les vois dans le navigateur => ça arrive bien à nginx)
  add_header X-Wolverine-RPC "nginx-origin" always;
  add_header Cache-Control "no-store" always;

  # log dédié
  access_log /var/log/nginx/wolverine_rpc_access.log combined;

  # preflight
  if ($request_method = OPTIONS) {
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
    add_header Content-Length 0;
    return 204;
  }

  add_header Access-Control-Allow-Origin "*" always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;

  proxy_http_version 1.1;
  proxy_ssl_server_name on;

  proxy_set_header Host api.mainnet-beta.solana.com;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  proxy_pass https://api.mainnet-beta.solana.com/;
}

# normalize trailing slash
location ^~ /wolverine/rpc/ {
  return 301 /wolverine/rpc;
}
# WOLVERINE_RPC_PROXY_END
'''
s = s.rstrip() + "\n\n" + block + "\n"
p.write_text(s)
print("OK: rpc trace block installed")
PY

touch /var/log/nginx/wolverine_rpc_access.log || true

nginx -t
systemctl reload nginx || service nginx reload

echo "== ORIGIN test (bypass CF) =="
curl -sk --resolve fireinners.online:443:127.0.0.1 -i \
  -X POST https://fireinners.online/wolverine/rpc \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | sed -n '1,25p'

echo
echo "== Tail rpc access log =="
tail -n 20 /var/log/nginx/wolverine_rpc_access.log || true
echo "DONE ✅"
BASH

chmod +x /root/trace_rpc_403_origin_or_cf.sh
/root/trace_rpc_403_origin_or_cf.sh
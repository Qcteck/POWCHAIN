cat >/root/fix_snippet_loaded_twice.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
HOST="fireinners.online"
VHOST="/etc/nginx/sites-enabled/${HOST}-ssl"

SNIP_DIR="/etc/nginx/snippets"
SNIP_CONF="${SNIP_DIR}/wolverine_routes.conf"
SNIP_INC="${SNIP_DIR}/wolverine_routes.inc"

TS="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Backup =="
cp -a "$VHOST" "$VHOST.bak_$TS"
[ -f "$SNIP_CONF" ] && cp -a "$SNIP_CONF" "$SNIP_CONF.bak_$TS" || true
[ -f "$SNIP_INC" ] && cp -a "$SNIP_INC" "$SNIP_INC.bak_$TS" || true

echo "== 2) Rename snippet .conf -> .inc (so it won't be included by snippets/*.conf) =="
if [ -f "$SNIP_CONF" ]; then
  mv -v "$SNIP_CONF" "$SNIP_INC"
fi

echo "== 3) Update vhost include to point to .inc (and remove any .conf include) =="
# comment any include wolverine_routes.conf
sed -i -E 's@^([[:space:]]*)include([[:space:]]+.*wolverine_routes\.conf.*);@\1# DISABLED_OLD include\2;@' "$VHOST"

# ensure include .inc exists inside vhost (append if missing)
if ! grep -q "wolverine_routes\.inc" "$VHOST"; then
  echo "" >> "$VHOST"
  echo "  include ${SNIP_INC};" >> "$VHOST"
fi

echo "== 4) Show any wildcard includes that might have caused the double-load =="
grep -RIn --binary-files=without-match \
  -E 'include\s+/etc/nginx/snippets/\*|include\s+/etc/nginx/snippets/\*\.conf' \
  /etc/nginx/nginx.conf /etc/nginx/conf.d /etc/nginx/sites-enabled 2>/dev/null || true

echo
echo "== 5) nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "== 6) verify locations loaded (optional) =="
nginx -T 2>/dev/null | grep -n "location .*wolverine/traderone/api" || true

echo "DONE ✅"
BASH

chmod +x /root/fix_snippet_loaded_twice.sh
/root/fix_snippet_loaded_twice.sh
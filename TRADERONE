#!/usr/bin/env bash
set -euo pipefail
umask 022
TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
BK="/root/bk_at_${TS}"
mkdir -p "$BK"

# --- FIX "file name too long" (root folder hygiene) ---
# (doesn't delete anything important; just prevents insanely-long filenames in /root from breaking future batches)
say "ROOT hygiene..."
python3 - <<'PY' || true
import os,glob,shutil,time
root="/root"
bk=os.environ.get("BK","/root/bk_at_unknown")
os.makedirs(bk,exist_ok=True)
for p in glob.glob(root+"/*"):
    b=os.path.basename(p)
    if len(b)>180:
        dst=os.path.join(bk,"LONGNAME_"+str(int(time.time()))+"_"+b[:60])
        try:
            shutil.move(p,dst)
            print("MOVED long name:",repr(b),"->",os.path.basename(dst))
        except Exception as e:
            print("SKIP:",repr(b),e)
PY

# --- OPTIONAL: disable guards (ONLY if you explicitly export AT_DISABLE_GUARDS=1) ---
if [ "${AT_DISABLE_GUARDS:-0}" = "1" ]; then
  say "AT_DISABLE_GUARDS=1 -> stopping guard services if present (temporary)..."
  systemctl stop warrior-gate 2>/dev/null || true
  systemctl stop warriorgate 2>/dev/null || true
  systemctl stop sentinel 2>/dev/null || true
  systemctl stop fireinners-sentinel 2>/dev/null || true

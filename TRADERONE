const fs=require('fs'),path=require('path');
const express=require('express');
const bs58=require('bs58');
const {Keypair}=require('@solana/web3.js');

const app=express();
app.use(express.json({limit:'1mb'}));

const ROOT=__dirname;
const VAULTS=path.join(ROOT,'vaults');
const MAP=path.join(ROOT,'map.json');

function loadMap(){ try{return JSON.parse(fs.readFileSync(MAP,'utf8'))}catch(e){return {}} }
function saveMap(m){ fs.writeFileSync(MAP, JSON.stringify(m,null,2), {mode:0o600}); }

app.get('/health',(req,res)=>res.json({ok:true,service:"vault-api"}));
app.get('/vault',(req,res)=>{
  const user=(req.query.userPub||'').toString();
  const m=loadMap();
  res.json({ok:true,userPub:user||null,vaultPub:(user && m[user])?m[user]:null});
});
app.post('/create',(req,res)=>{
  const user=(req.body && req.body.userPub)?String(req.body.userPub):'';
  const m=loadMap();
  if(user && m[user]) return res.json({ok:true,userPub:user,vaultPub:m[user],existing:true});
  const kp=Keypair.generate();
  const vaultPub=kp.publicKey.toBase58();
  const secret58=bs58.encode(Buffer.from(kp.secretKey));
  fs.writeFileSync(path.join(VAULTS, vaultPub+'.json'), JSON.stringify({vaultPub,secret58,createdAt:new Date().toISOString()},null,2), {mode:0o600});
  if(user){ m[user]=vaultPub; saveMap(m); }
  res.json({ok:true,userPub:user||null,vaultPub,existing:false});
});

const port=Number(process.env.PORT||3010);
app.listen(port,'127.0.0.1',()=>console.log('vault-api listening',port));
JS


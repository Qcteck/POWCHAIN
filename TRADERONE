set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_final.conf"

cp -a "$VHOST" "$VHOST.bak.$TS"

# commente la ligne include (sans la supprimer)
sed -i "\|include $SNIP;| s|^|# |" "$VHOST"

# preuve
echo "=== include lines now ==="
grep -n "include $SNIP" "$VHOST" || echo "OK: plus d'include actif"

nginx -t
systemctl reload nginx
echo "✅ OK (backup: $VHOST.bak.$TS)"
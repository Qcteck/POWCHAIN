set -euo pipefail

# Trouver le dossier des renders
DIR="$(ls -d /root/bak_renders_machine_*/png 2>/dev/null | tail -n 1 || true)"
[ -n "$DIR" ] || { echo "❌ Aucun dossier bak_renders trouvé"; exit 1; }

cd "$DIR"
echo "📁 Dossier: $DIR"
echo "Images: $(ls -1 *.png 2>/dev/null | wc -l)"

# Installer le viewer terminal si absent
if ! command -v chafa >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y chafa
fi

# Charger la liste des images
mapfile -t IMG < <(ls -1 *.png 2>/dev/null | sort)
[ "${#IMG[@]}" -gt 0 ] || { echo "❌ Aucun PNG trouvé"; exit 1; }

i=0
while true; do
  clear
  echo "Viewer SSH — ${IMG[$i]}  ($((i+1))/${#IMG[@]})"
  echo "n = suivant | p = précédent | q = quitter"
  echo
  chafa -s 160x45 --stretch "${IMG[$i]}" || true
  echo
  read -r -n 1 key || true
  case "$key" in
    n) i=$(( (i+1) % ${#IMG[@]} ));;
    p) i=$(( (i-1+${#IMG[@]}) % ${#IMG[@]} ));;
    q) exit 0;;
  esac
done
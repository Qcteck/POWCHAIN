#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE / TRADERONE API — FULL AUTO FIX ==="

### VARIABLES
API_PORT=3000
API_HOST=127.0.0.1
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_INC="/etc/nginx/includes/wolverine_traderone_api.inc"
API_TEST_PATH="/wolverine/traderone/api/status"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Vérification Node.js =="
command -v node >/dev/null || { echo "❌ Node.js absent"; exit 1; }
node -v

echo "== 2) Vérification écoute port ${API_PORT} =="
if ! ss -lnt | grep -q ":${API_PORT}"; then
  echo "⚠️  Aucun service sur ${API_PORT}, tentative PM2"
  if command -v pm2 >/dev/null; then
    pm2 resurrect || true
  fi
fi

sleep 2

if ! ss -lnt | grep -q ":${API_PORT}"; then
  echo "❌ Node N'ÉCOUTE TOUJOURS PAS sur ${API_PORT}"
  echo "👉 Corrige ton backend TraderOne (app.listen)"
  exit 1
fi

echo "✅ Node écoute sur ${API_PORT}"

echo "== 3) Sauvegarde NGINX =="
cp -a "$NGINX_SITE" "${NGINX_SITE}.bak_${TS}"

echo "== 4) Création include NGINX TraderOne API =="
cat > "$NGINX_INC" <<EOF
location /wolverine/traderone/api/ {
  proxy_pass http://${API_HOST}:${API_PORT}/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 300;
}
EOF

echo "== 5) Injection include si absent =="
grep -q "wolverine_traderone_api.inc" "$NGINX_SITE" || \
sed -i "/server {/a\\    include ${NGINX_INC};" "$NGINX_SITE"

echo "== 6) Test NGINX =="
nginx -t

echo "== 7) Reload NGINX =="
systemctl reload nginx

echo "== 8) TEST LOCAL BACKEND =="
curl -s -o /dev/null -w "LOCAL %{http_code}\n" http://${API_HOST}:${API_PORT}/ || true

echo "== 9) TEST PROXY LOCAL =="
curl -s -o /dev/null -w "PROXY %{http_code}\n" http://localhost${API_TEST_PATH} || true

echo "== 10) TEST HTTPS CLOUDFARE =="
curl -s -o /dev/null -w "HTTPS %{http_code}\n" https://fireinners.online${API_TEST_PATH} || true

echo "=== FIN — SI HTTPS=200 → C’EST RÉGLÉ ==="
cat <<'EOF' > /root/UNLOCK_FIX_RELOCK_AIAQUILA.sh
#!/bin/bash
set -e

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "🔎 Vérification attributs"
lsattr "$VHOST"

echo "🔓 Déverrouillage temporaire (chattr -i)"
chattr -i "$VHOST"

echo "🧹 Ajout headers no-cache AIAQUILA (idempotent)"
if ! grep -q "AIAQUILA_NO_CACHE" "$VHOST"; then
  sed -i '/location \/aiaquila\//a \\
    # AIAQUILA_NO_CACHE\\
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;\\
    add_header Pragma "no-cache" always;\\
    add_header Expires 0 always;' "$VHOST"
fi

echo "🧪 Test nginx"
nginx -t

echo "🔁 Reload nginx"
systemctl reload nginx

echo "🔒 Reverrouillage (chattr +i)"
chattr +i "$VHOST"

echo "🔎 Attributs finaux"
lsattr "$VHOST"

echo "✅ AIAQUILA — PATCH TERMINÉ ET FICHIER RE-IMMUTABLE"
EOF

chmod +x /root/UNLOCK_FIX_RELOCK_AIAQUILA.sh
/root/UNLOCK_FIX_RELOCK_AIAQUILA.sh
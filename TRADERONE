cat >/root/WOLVERINE_SOLANA_PROXY_DIAG.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

PORT=3010
SERVICE="wolverine-solana-proxy"
NGINX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

echo "=== WOLVERINE SOLANA PROXY DIAGNOSTIC ==="
echo

echo "1) Node version:"
node -v || echo "❌ node NOT installed"
echo

echo "2) Proxy service status:"
systemctl status $SERVICE --no-pager || echo "❌ service not running"
echo

echo "3) Port $PORT listening:"
ss -ltnp | grep ":$PORT" || echo "❌ port $PORT NOT listening"
echo

echo "4) Local proxy direct test (localhost):"
curl -s -X POST http://127.0.0.1:$PORT/rpc/solana \
  -H "Content-Type: application/json" \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' || echo "❌ proxy local FAIL"
echo
echo

echo "5) Nginx route test (/rpc/solana):"
curl -s -X POST http://127.0.0.1/rpc/solana \
  -H "Content-Type: application/json" \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' || echo "❌ nginx route FAIL"
echo
echo

echo "6) Nginx config check:"
nginx -t || echo "❌ nginx config error"
echo

echo "7) Nginx route presence:"
grep -R "location /rpc/solana" "$NGINX_VHOST" || echo "❌ /rpc/solana NOT found in vhost"
echo

echo "=== DIAGNOSTIC END ==="
BASH

chmod +x /root/WOLVERINE_SOLANA_PROXY_DIAG.sh
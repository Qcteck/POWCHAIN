set -euo pipefail

# essaie pm2 env (le plus courant)
KEY=$(pm2 env 0 2>/dev/null | grep -E '^(X_API_KEY|API_KEY|TRADERONE_API_KEY)=' | tail -n1 | cut -d= -f2- | tr -d '"' | tr -d "'" || true)

# fallback: cherche dans /opt (ajuste si besoin)
if [ -z "${KEY:-}" ]; then
  KEY=$(grep -RIsn --line-number -E '^(X_API_KEY|API_KEY|TRADERONE_API_KEY)=' /opt 2>/dev/null | head -n1 | sed 's/.*=//' | tr -d '"' | tr -d "'" || true)
fi

[ -n "${KEY:-}" ] || { echo "KO: clé introuvable via pm2/opt"; exit 1; }

curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes -H "X-API-KEY: $KEY" | head -n 25
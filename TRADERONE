cat >/root/move_wolverine_location_inside_server.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$VHOST" || { echo "Missing $VHOST"; exit 1; }
cp -a "$VHOST" "$VHOST.bak_move_${TS}"

python3 - <<'PY'
import re

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
lines=open(VHOST,"r",errors="ignore").read().splitlines(True)

# 1) Find first server { ... } range
start=None
for i,l in enumerate(lines):
    if re.search(r'^\s*server\s*\{', l):
        start=i; break
if start is None:
    raise SystemExit("No server { found")

depth=0
end=None
for i in range(start, len(lines)):
    depth += lines[i].count("{")
    depth -= lines[i].count("}")
    if depth==0 and i>start:
        end=i
        break
if end is None:
    raise SystemExit("Could not find end of first server block (brace mismatch)")

# 2) Extract ANY location ^~ /wolverine/ { ... } block found ANYWHERE
block=[]
out=[]
i=0
while i < len(lines):
    l=lines[i]
    if re.search(r'^\s*location\s+\^~\s+/wolverine/\s*\{', l):
        # capture full block by brace depth
        b=[l]
        d = l.count("{") - l.count("}")
        i += 1
        while i < len(lines) and d > 0:
            b.append(lines[i])
            d += lines[i].count("{") - lines[i].count("}")
            i += 1
        block = b  # keep last found (fine)
        continue
    out.append(l)
    i += 1

if not block:
    raise SystemExit("No 'location ^~ /wolverine/ {' block found to move")

# 3) Recompute server range after removal
lines=out
start=None
for i,l in enumerate(lines):
    if re.search(r'^\s*server\s*\{', l):
        start=i; break
depth=0
end=None
for i in range(start, len(lines)):
    depth += lines[i].count("{")
    depth -= lines[i].count("}")
    if depth==0 and i>start:
        end=i
        break

# 4) Insert block right before closing brace of server
server = lines[:end]
close = lines[end:end+1]
rest  = lines[end+1:]

# Avoid duplicates: remove any existing /wolverine_DISABLED/ etc not needed
server.append("\n")
server.extend(block)
server.append("\n")

open(VHOST,"w").writelines(server + close + rest)
PY

nginx -t
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/move_wolverine_location_inside_server.sh

cat >/root/WOLV_HARD_RESET_SINGLE_UI.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%s)"
DIST="/opt/fireinners/frontend-react/app/dist"
WOLV="$DIST/wolverine"
NG="/etc/nginx/sites-available/fireinners.online-ssl"

[ -d "$DIST" ] || { echo "ERR: dist introuvable: $DIST"; exit 1; }
[ -f "$NG" ] || { echo "ERR: vhost introuvable: $NG"; exit 1; }

BOT="e8DbBrTJxRetx3HNFb83CsXMySETydHVLwxMzkjcVqh"

# backup + wipe wolverine
mkdir -p "$DIST/_bak_wolverine_$TS"
if [ -d "$WOLV" ]; then
  chattr -i "$WOLV" 2>/dev/null || true
  cp -a "$WOLV"/. "$DIST/_bak_wolverine_$TS/" 2>/dev/null || true
  rm -rf "$WOLV"
fi
mkdir -p "$WOLV"

# write SINGLE UI (no external scripts) + kill service workers
cat >"$WOLV/index.$TS.html" <<EOF
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta http-equiv="Cache-Control" content="no-store"/><meta http-equiv="Pragma" content="no-cache"/><meta http-equiv="Expires" content="0"/><title>WOLVERINE</title><style>
body{font:14px Arial,system-ui;margin:0;padding:14px;background:#fff}
#wrap{max-width:980px;margin:0 auto;border:1px solid #bbb;border-radius:12px;padding:12px}
h1{margin:0 0 10px 0;font-size:32px;letter-spacing:.5px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:10px 0}
.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;word-break:break-all}
.box{padding:10px;border:1px solid #bbb;border-radius:10px;background:#f7f7f7}
button,select,input{font:inherit;padding:6px 8px}
small{color:#444}
.ok{color:#060}
.bad{color:#a00}
hr{border:none;border-top:1px solid #ddd;margin:12px 0}
</style></head><body><div id="wrap">
<h1>WOLVERINE</h1>

<div class="row">
  <button id="btnConnect" type="button">Connect Wallet (Phantom)</button>
  <div>Wallet: <span id="pub" class="mono">—</span></div>
</div>

<div class="box">
  <b>Mode TraderOne</b>
  <div class="row">
    <select id="mode">
      <option value="SAFE">SAFE</option>
      <option value="AUTO">AUTO</option>
      <option value="RR">RR</option>
      <option value="SCALP">SCALP</option>
    </select>
    <button id="btnMode" type="button">Sauver</button>
    <span id="modeMsg"></span>
  </div>
</div>

<hr>

<div class="box">
  <b>Dépôt manuel (unique)</b><br>
  <small>Envoie depuis ton Phantom vers TraderOne (bot) :</small>
  <div class="mono" id="bot">$BOT</div>
  <div class="row">
    <label>Asset
      <select id="asset">
        <option value="USDC">USDC</option>
        <option value="SOL">SOL</option>
      </select>
    </label>
    <label>Montant
      <input id="amount" placeholder="ex: 1 ou 0.1" style="min-width:220px"/>
    </label>
    <button id="btnConfirm" type="button">CONFIRMER DÉPÔT (scan on-chain)</button>
    <span id="depMsg"></span>
  </div>
  <small>Après confirmation, START devient actif.</small>
  <div><b>Dernier dépôt détecté</b> : <span id="lastDep" class="mono">—</span></div>
</div>

<div class="row" style="margin-top:12px">
  <button id="btnStart" type="button" disabled>START WOLVERINE</button>
  <span id="startMsg"></span>
</div>

<div class="row"><small>Build:</small> <span class="mono">$TS</span></div>

<script>
(()=>{"use strict";
const BOT="$BOT";
const \$=s=>document.querySelector(s);
const setMsg=(el,txt,ok)=>{el.textContent=txt||"";el.className=ok?"ok":"bad";};
(async()=>{try{if("serviceWorker"in navigator){const regs=await navigator.serviceWorker.getRegistrations();for(const r of regs)try{await r.unregister()}catch(_){}}}catch(_){}})();
const jpost=async(url,obj)=>{
  const r=await fetch(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(obj||{})});
  const t=await r.text(); let j=null; try{j=JSON.parse(t)}catch(_){}
  if(!r.ok) throw new Error((j&&j.err)||t||("HTTP "+r.status));
  return j||{};
};
const jget=async(url)=>{
  const r=await fetch(url,{method:"GET"});
  const t=await r.text(); let j=null; try{j=JSON.parse(t)}catch(_){}
  if(!r.ok) throw new Error((j&&j.err)||t||("HTTP "+r.status));
  return j||{};
};
const getPub=async()=>{
  if(!window.solana||!window.solana.isPhantom) throw new Error("Phantom non détecté");
  if(window.solana.publicKey) return window.solana.publicKey.toBase58();
  const r=await window.solana.connect(); return r&&r.publicKey?r.publicKey.toBase58():"";
};
async function refresh(pub){
  const st=await jget("/wolverine/api/wolv_state?pub="+encodeURIComponent(pub));
  const m=(st&&st.user&&st.user.mode)||"SAFE"; $("#mode").value=m;
  const ld=st&&st.user&&st.user.last_deposit;
  if(ld&&ld.sig){$("#lastDep").textContent=(ld.asset+" "+ld.amount+" | "+ld.sig); $("#btnStart").disabled=false;}
  else {$("#lastDep").textContent="—"; $("#btnStart").disabled=true;}
}
$("#btnConnect").onclick=async()=>{
  try{const pub=await getPub(); $("#pub").textContent=pub; await refresh(pub);}
  catch(e){alert(String(e&&e.message?e.message:e));}
};
$("#btnMode").onclick=async()=>{
  try{
    const pub=await getPub(); $("#pub").textContent=pub;
    setMsg($("#modeMsg"),"Sauvegarde...",false);
    await jpost("/wolverine/api/wolv_set_mode",{pub,mode:$("#mode").value});
    setMsg($("#modeMsg"),"OK",true);
  }catch(e){setMsg($("#modeMsg"),"ERR: "+String(e&&e.message?e.message:e),false);}
};
$("#btnConfirm").onclick=async()=>{
  try{
    const pub=await getPub(); $("#pub").textContent=pub;
    const asset=$("#asset").value;
    const amt=Number($("#amount").value||0);
    if(!(amt>0)) return setMsg($("#depMsg"),"Montant invalide",false);
    setMsg($("#depMsg"),"Scan on-chain...",false);
    const out=await jpost("/wolverine/api/wolv_confirm_deposit",{pub,asset,amount:amt,bot:BOT});
    if(out&&out.ok&&out.sig){setMsg($("#depMsg"),"OK: "+out.sig,true); await refresh(pub);}
    else setMsg($("#depMsg"),"Pas trouvé (réessaie après confirmation réseau)",false);
  }catch(e){setMsg($("#depMsg"),"ERR: "+String(e&&e.message?e.message:e),false);}
};
$("#btnStart").onclick=async()=>{
  try{
    const pub=await getPub(); $("#pub").textContent=pub;
    setMsg($("#startMsg"),"Start...",false);
    await jpost("/wolverine/api/start",{pub});
    setMsg($("#startMsg"),"OK",true);
  }catch(e){setMsg($("#startMsg"),"ERR: "+String(e&&e.message?e.message:e),false);}
};
})();
</script></body></html>
EOF

cp -a "$WOLV/index.$TS.html" "$WOLV/index.html"
rm -f "$WOLV"/*.gz "$WOLV"/*.br 2>/dev/null || true

# nginx: force serve the versioned HTML + proxy /wolverine/api/ to node:3000
MARK_BEGIN="# BEGIN WOLV_SINGLE_UI_V1"
MARK_END="# END WOLV_SINGLE_UI_V1"
BLOCK="$MARK_BEGIN
location = /wolverine/ {
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  return 302 /wolverine/index.$TS.html;
}
location = /wolverine/index.$TS.html {
  add_header Cache-Control \"no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0\" always;
  try_files /wolverine/index.$TS.html =404;
}
location ^~ /wolverine/api/ {
  rewrite ^/wolverine/api/(.*)$ /api/\$1 break;
  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_read_timeout 60s;
}
$MARK_END"

chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$NG" 2>/dev/null || true

if grep -qF "$MARK_BEGIN" "$NG"; then
  awk -v b="$MARK_BEGIN" -v e="$MARK_END" -v repl="$BLOCK" '
    BEGIN{inblk=0}
    index($0,b){print repl; inblk=1; next}
    inblk && index($0,e){inblk=0; next}
    !inblk{print}
  ' "$NG" >"$NG.tmp" && mv "$NG.tmp" "$NG"
else
  python3 - "$NG" <<PY
import sys
p=sys.argv[1]
s=open(p,"r",encoding="utf-8",errors="ignore").read()
i=s.rfind("}")
if i==-1: raise SystemExit("ERR: aucun '}' trouvé dans vhost")
out=s[:i].rstrip()+"\\n\\n"+"""$BLOCK"""+ "\\n\\n" + s[i:]
open(p,"w",encoding="utf-8").write(out)
PY
fi

nginx -t
systemctl reload nginx

chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$NG" 2>/dev/null || true

echo "OK: SINGLE UI installée."
echo "Ouvre: https://fireinners.online/wolverine/  (redirect vers index.$TS.html)"
BASH

bash /root/WOLV_HARD_RESET_SINGLE_UI.sh
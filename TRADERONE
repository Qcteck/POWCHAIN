bash -lc '
set -euo pipefail

echo "==============================="
echo "AIAQUILA – FIX JS STATE (ROOT)"
echo "==============================="

FILE="/var/www/aiaquila/index.html"
BACKUP="/root/backup_aiaquila_index_$(date +%Y%m%d_%H%M%S).html"

# 1. Vérifications
echo "[1/6] Vérification fichier..."
if [ ! -f "$FILE" ]; then
  echo "❌ Fichier introuvable: $FILE"
  exit 1
fi

# 2. Backup
echo "[2/6] Backup -> $BACKUP"
cp "$FILE" "$BACKUP"

# 3. Diagnostic
echo "[3/6] Recherche déclarations const S..."
COUNT=$(grep -cE "const[[:space:]]+S[[:space:]]*=" "$FILE" || true)
echo "   -> $COUNT occurrence(s)"

# 4. Fix JS (safe)
echo "[4/6] Correction automatique JS..."

python3 - << "PY"
from pathlib import Path
p = Path("/var/www/aiaquila/index.html")
txt = p.read_text()

# Remplacement global sécurisé
txt = txt.replace(
    'const S = JSON.parse(localStorage.getItem("aiaquila_state")) || {lvl:0.55,h:{}};',
    '''
window.AQ_STATE = window.AQ_STATE || JSON.parse(localStorage.getItem("aiaquila_state")) || {lvl:0.55,h:{}};
const S = window.AQ_STATE;
'''
)

p.write_text(txt)
PY

# 5. Permissions
echo "[5/6] Permissions..."
chown www-data:www-data "$FILE"
chmod 644 "$FILE"

# 6. Reload nginx
echo "[6/6] Reload nginx..."
nginx -t
systemctl reload nginx

echo "==============================="
echo "✅ FIX APPLIQUÉ"
echo "URL: https://fireinners.online/aiaquila/"
echo "Hard refresh navigateur (CTRL+F5)"
echo "==============================="
'
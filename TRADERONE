cat >/root/MEGA_TRADERONE_REPAIR.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

log(){ printf "\n[%s] %s\n" "$(date +'%F %T')" "$*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "Lance en root."

ASK_LIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

API_DIR="/opt/wolverine/traderone_api"
SERVICE_NAME="wolverine-traderone-api"
API_BASE="/wolverine/traderone/api"
API_BIND="127.0.0.1"
API_PORT="3000"

CORRUPT="/opt/wolverine/node_modules/node-fetch/node_modules/@solana/web3.js/package.json"

# fallback minimal si askorupdate absent
askorupdate_file(){ local p="$1"; shift; local c="$1"; shift; mkdir -p "$(dirname "$p")"; [ -f "$p" ] && cp -a "$p" "$p.bak.$(date +%s)"; printf "%s" "$c" >"$p"; }
askorupdate_yesno(){ local prompt="$1"; shift; local yn; read -r -p "$prompt [y/N] " yn || true; case "${yn,,}" in y|yes) return 0;; *) return 1;; esac; }

if [ -f "$ASK_LIB" ]; then
  # shellcheck disable=SC1090
  source "$ASK_LIB" || true
fi

log "0) Rollback du fichier node_modules cassé (si présent)"
if [ -f "$CORRUPT" ]; then
  if grep -q "import express" "$CORRUPT" 2>/dev/null; then
    log "Detecté: package.json corrompu (contient du JS)."
    bak="$(ls -1t "${CORRUPT}.bak."* 2>/dev/null | head -n1 || true)"
    if [ -n "${bak:-}" ]; then
      log "Restore depuis: $bak"
      cp -a "$bak" "$CORRUPT"
    else
      log "Aucun backup trouvé. On répare via reinstall node_modules du repo /opt/wolverine (si possible)."
      if [ -f /opt/wolverine/package.json ] && command -v npm >/dev/null 2>&1; then
        (cd /opt/wolverine && npm install --omit=dev) >/dev/null || true
      else
        log "Impossible de reinstall automatiquement (npm/package.json introuvable). On continue (TraderOne API peut quand même fonctionner)."
      fi
    fi
  else
    log "OK: $CORRUPT ne semble pas contenir du JS."
  fi
else
  log "OK: $CORRUPT n'existe pas (rien à rollback)."
fi

log "1) S'assurer que le vrai backend est bien dans $API_DIR"
mkdir -p "$API_DIR"

PKG='{"name":"traderone-api","version":"1.0.0","private":true,"type":"module","main":"server.js","scripts":{"start":"node server.js"},"dependencies":{"express":"^4.19.2"}}'
askorupdate_file "$API_DIR/package.json" "$PKG"

SERVER_JS=$(cat <<'JS'
import express from "express";

const app = express();
app.disable("x-powered-by");
app.use(express.json({limit:"256kb"}));

const BIND = process.env.BIND || "127.0.0.1";
const PORT = parseInt(process.env.PORT || "3000", 10);
const API_BASE = (process.env.API_BASE || "/wolverine/traderone/api").replace(/\/+$/,"");

function now(){ return new Date().toISOString(); }
function ok(res, obj){ res.json({ok:true, service:"traderone", ts:now(), ...obj}); }
function bad(res, msg, code=400){ res.status(code).json({ok:false, service:"traderone", ts:now(), error:String(msg||"bad_request")}); }

app.get(`${API_BASE}/health`, (req,res)=> ok(res, {base:API_BASE, bind:BIND, port:PORT}));
app.get(`${API_BASE}/version`, (req,res)=> ok(res, {version:"1.0.0"}));

/* Endpoints attendus (stubs sûrs) */
app.get(`${API_BASE}/dashboard`, (req,res)=> ok(res, {page:"dashboard", summary:{invested_usdc:0,pnl_usdc:0,positions:0,orders:0}}));
app.get(`${API_BASE}/trade`,     (req,res)=> ok(res, {page:"trade", status:"ready"}));
app.get(`${API_BASE}/positions`, (req,res)=> ok(res, {page:"positions", items:[]}));
app.get(`${API_BASE}/orders`,    (req,res)=> ok(res, {page:"orders", items:[]}));
app.get(`${API_BASE}/history`,   (req,res)=> ok(res, {page:"history", items:[]}));
app.get(`${API_BASE}/wallet`,    (req,res)=> ok(res, {page:"wallet", balances:{sol:0,usdc:0,tokens:[]}}));
app.get(`${API_BASE}/settings`,  (req,res)=> ok(res, {page:"settings", strategies:["default","conservative","balanced","aggressive"], risk_pct_default:5}));

/* Actions (stubs) */
app.post(`${API_BASE}/start`, (req,res)=>{
  const {pub,budget_usdc,strategy,risk_pct} = req.body || {};
  if(!pub) return bad(res,"pub_required");
  const budget = Number(budget_usdc||0);
  if(!Number.isFinite(budget) || budget<=0) return bad(res,"budget_usdc_invalid");
  const risk = Number(risk_pct||0);
  if(!Number.isFinite(risk) || risk<0 || risk>100) return bad(res,"risk_pct_invalid");
  const job_id = `job_${Date.now()}_${Math.random().toString(16).slice(2)}`;
  ok(res, {accepted:true, job_id, pub, budget_usdc:budget, strategy:String(strategy||"default"), risk_pct:risk});
});
app.post(`${API_BASE}/mode`, (req,res)=>{
  const {pub,mode} = req.body || {};
  if(!pub) return bad(res,"pub_required");
  ok(res, {accepted:true, pub, mode:String(mode||"observe")});
});
app.post(`${API_BASE}/withdraw`, (req,res)=>{
  const {pub,mint,amount,to} = req.body || {};
  if(!pub) return bad(res,"pub_required");
  const amt = Number(amount||0);
  if(!Number.isFinite(amt) || amt<=0) return bad(res,"amount_invalid");
  ok(res, {accepted:true, pub, mint:String(mint||""), amount:amt, to:String(to||"")});
});
app.get(`${API_BASE}/invested`, (req,res)=>{
  const pub = String(req.query.pub||"");
  if(!pub) return bad(res,"pub_required");
  ok(res, {pub, invested_usdc:0, pnl_usdc:0, positions:[]});
});

app.use((req,res)=> bad(res,"not_found",404));

app.listen(PORT, BIND, ()=> console.log(`[traderone] ${now()} listening http://${BIND}:${PORT}${API_BASE}`));
JS
)
askorupdate_file "$API_DIR/server.js" "$SERVER_JS"

log "2) Installer deps backend (express)"
if command -v npm >/dev/null 2>&1; then
  (cd "$API_DIR" && npm install --omit=dev) >/dev/null
else
  die "npm introuvable"
fi

log "3) Créer/forcer le service systemd $SERVICE_NAME"
UNIT=$(cat <<UNIT
[Unit]
Description=WOLVERINE TraderOne API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$API_DIR
Environment=NODE_ENV=production
Environment=BIND=$API_BIND
Environment=PORT=$API_PORT
Environment=API_BASE=$API_BASE
ExecStart=/usr/bin/node $API_DIR/server.js
Restart=always
RestartSec=2
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
UNIT
)
askorupdate_file "/etc/systemd/system/${SERVICE_NAME}.service" "$UNIT"
systemctl daemon-reload
systemctl enable --now "${SERVICE_NAME}.service" >/dev/null
systemctl restart "${SERVICE_NAME}.service" >/dev/null

log "4) Vérifier listener :${API_PORT}"
sleep 1
ss -lntp | grep ":${API_PORT}" || true

log "5) S'assurer que nginx proxy /wolverine/traderone/api/ pointe bien sur 127.0.0.1:3000 (sans toucher au front)"
[ -f "$NGINX_SITE" ] || die "nginx site introuvable: $NGINX_SITE"
chattr -i /etc/nginx/nginx.conf "$NGINX_SITE" 2>/dev/null || true

# ajoute/replace un bloc location spécifique API (idempotent)
if ! grep -qE "location\s+\^~\s+${API_BASE}/" "$NGINX_SITE"; then
  cp -a "$NGINX_SITE" "${NGINX_SITE}.bak.$(date +%s)"
  PATCH=$(cat <<'NGX'
  # --- WOLVERINE TraderOne API (auto) ---
  location ^~ /wolverine/traderone/api/ {
    access_log /var/log/nginx/wolverine_api_access.log;
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  # --- /WOLVERINE TraderOne API ---
NGX
)
  if tail -n 1 "$NGINX_SITE" | grep -q "}$"; then
    tmp="$(mktemp)"
    head -n -1 "$NGINX_SITE" >"$tmp"
    printf "%s\n" "$PATCH" >>"$tmp"
    echo "}" >>"$tmp"
    mv "$tmp" "$NGINX_SITE"
  else
    printf "\n%s\n" "$PATCH" >>"$NGINX_SITE"
  fi
fi

nginx -t >/dev/null
systemctl reload nginx
chattr +i /etc/nginx/nginx.conf "$NGINX_SITE" 2>/dev/null || true

log "6) Tests endpoints (doivent passer 200)"
BASE="https://fireinners.online${API_BASE}"
curl -sS "${BASE}/health" | head -c 200; echo
for p in version dashboard trade positions orders history wallet settings; do
  code="$(curl -sS -o /dev/null -w "%{http_code}" "${BASE}/${p}" || true)"
  echo "${p}: HTTP ${code}"
done
code2="$(curl -sS -o /dev/null -w "%{http_code}" "${BASE}/invested?pub=TEST" || true)"
echo "invested?pub=TEST: HTTP ${code2}"

log "7) Logs utiles"
echo "systemctl status ${SERVICE_NAME}.service --no-pager"
echo "journalctl -u ${SERVICE_NAME}.service -n 50 --no-pager"
echo "tail -n 50 /var/log/nginx/wolverine_api_access.log"
BASH

chmod +x /root/MEGA_TRADERONE_REPAIR.sh
bash /root/MEGA_TRADERONE_REPAIR.sh
#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE — FIX VAULT / PHANTOM (ANTI-DOUBLONS) ==="

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
BAK="${HTML}.bak_${TS}"

echo "== 1) Vérification fichier =="
[ -f "$HTML" ] || { echo "❌ $HTML introuvable"; exit 1; }

echo "== 2) Backup =="
cp -a "$HTML" "$BAK"
echo "Backup créé : $BAK"

echo "== 3) Suppression de TOUS les blocs Phantom/Vault existants =="
python3 <<'PY'
from pathlib import Path
import re

p = Path("/var/www/wolverine/index.html")
html = p.read_text(errors="ignore")

# supprimer tous les blocs Phantom
html = re.sub(
    r'<section[^>]*id="phantom"[\s\S]*?</section>',
    '',
    html,
    flags=re.I
)

# supprimer tous les blocs Vault
html = re.sub(
    r'<section[^>]*id="vault"[\s\S]*?</section>',
    '',
    html,
    flags=re.I
)

p.write_text(html)
print("✔ Tous les blocs Phantom/Vault supprimés")
PY

echo "== 4) Réinjection d’UN SEUL Phantom + UN SEUL Vault =="
python3 <<'PY'
from pathlib import Path

p = Path("/var/www/wolverine/index.html")
html = p.read_text(errors="ignore")

BLOCK = """
<!-- === PHANTOM UNIQUE === -->
<section id="phantom" style="border:1px solid #444;padding:12px;margin:20px 0">
  <h3>Phantom</h3>
  <button id="connectPhantom">Connect Phantom</button>
  <div>Adresse: <span id="userAddr">—</span></div>
  <div>SOL: <span id="userSol">—</span></div>
</section>

<!-- === VAULT UNIQUE === -->
<section id="vault" style="border:2px solid #00e0ff;padding:16px;margin:20px 0">
  <h3>Vault</h3>
  <button id="vaultCreate">Créer mon Vault</button>
  <div>Vault: <span id="vaultAddr">—</span></div>
  <div>Vault SOL: <span id="vaultSol">—</span></div>
  <input id="vaultAmount" placeholder="Montant SOL">
  <button id="vaultDeposit">Déposer SOL</button>
</section>
"""

# injecter juste avant </body>
if "</body>" in html:
    html = html.replace("</body>", BLOCK + "\n</body>")
else:
    html += BLOCK

p.write_text(html)
print("✔ Phantom + Vault UNIQUE réinstallés")
PY

echo "== 5) Vérification IDs uniques =="
grep -R 'id="vault"' "$HTML" | wc -l
grep -R 'id="phantom"' "$HTML" | wc -l

echo "== 6) Reload nginx (safe) =="
nginx -t && systemctl reload nginx || true

echo "=== FIN ==="
echo "➡ Recharge la page avec CTRL+SHIFT+R"
echo "➡ Phantom OK / Vault OK / Plus aucun doublon"
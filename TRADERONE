<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Test Gap Strict Doublet + A3/A4</title>
<style>
body { font-family: Arial, sans-serif; background:#111; color:#eee; padding:20px; }
#log { max-height:400px; overflow-y:scroll; background:#222; padding:10px; border-radius:5px; }
.ok { color:#0f0; }
.warn { color:#ff0; }
.error { color:#f00; }
.level { font-weight:bold; }
</style>
</head>
<body>

<h2>Test Moteur Quantique : Gap Strict Doublet + A3/A4</h2>
<button id="startBtn">Lancer Test</button>
<div id="log"></div>

<script>
// Paramètres
const N_cycles = 200;
const E_base = [0.1, 0.2];
const E_top = [0.5, 0.6];
const E_mass = [0.8, 1.0];
const A3A4 = [0.05, 0.05]; // micro-niveaux, plus petits qu'E_mass
const gmin_sub = 0.02;

// Invariants
const N_min = 5, N_max = 15;
const H_min = 0.3, H_max = 0.7;

// État moteur
let moteur = {
    seed: 42,
    E: 0.1,
    N_c: 10,
    H_w: 0.5,
    niveau: 'vide',
    symetries: true
};

// Évolution interne
function T(state) {
    // Simulation simple : léger bruit
    state.E += (Math.random()-0.5)*0.05;
    state.N_c += Math.round((Math.random()-0.5)*2);
    state.H_w += (Math.random()-0.5)*0.03;
    return state;
}

// Détection niveau
function detecte_niveau(state){
    if(state.E >= E_mass[0] && state.E <= E_mass[1]) return 'E_mass';
    if(state.E >= E_top[0] && state.E <= E_top[1]) return 'E_top';
    if(state.E >= E_base[0] && state.E <= E_base[1]) return 'E_base';
    if(state.E >= A3A4[0] && state.E <= A3A4[1]) return 'A3/A4';
    return 'vide';
}

// Correction hors-bande
function corrige_hors_bande(state){
    const niveau = detecte_niveau(state);
    if(niveau === 'vide') {
        if(state.E < A3A4[0]) state.E = A3A4[0];
        else state.E = E_mass[1];
    }
    if(niveau === 'A3/A4' && state.E >= E_mass[0]) state.E = A3A4[1];
    // corrige invariants
    if(state.N_c < N_min) state.N_c = N_min;
    if(state.N_c > N_max) state.N_c = N_max;
    if(state.H_w < H_min) state.H_w = H_min;
    if(state.H_w > H_max) state.H_w = H_max;
    return state;
}

// Vérification symétries (simulation)
function panneau_verifie_symmetries(state){
    return Math.random() < 0.05 ? false : true;
}

// Log cycle
function logCycle(cycle, state, sym_ok){
    const div = document.getElementById('log');
    const line = document.createElement('div');
    line.innerHTML = `Cycle ${cycle} | Niveau <span class="level">${detecte_niveau(state)}</span> | E: ${state.E.toFixed(2)} | N_c: ${state.N_c} | H_w: ${state.H_w.toFixed(2)} | Symétries: <span class="${sym_ok?'ok':'error'}">${sym_ok?'OK':'VIOLATION'}</span>`;
    div.appendChild(line);
    div.scrollTop = div.scrollHeight;
}

// Lancement du test
document.getElementById('startBtn').addEventListener('click', () => {
    let cycle = 0;
    let interval = setInterval(() => {
        if(cycle >= N_cycles) { clearInterval(interval); return; }

        moteur = T(moteur);
        moteur = corrige_hors_bande(moteur);
        const sym_ok = panneau_verifie_symmetries(moteur);
        logCycle(cycle, moteur, sym_ok);

        cycle++;
    }, 50); // 50ms par cycle
});
</script>

</body>
</html>

cat >/root/WOLVERINE_FIX_USDC_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
HTML="/var/www/wolverine/index.html"
NG="/etc/nginx/nginx.conf"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
LOG="/root/WOLVERINE_FIX_USDC_${TS}.log"

echo "=== WOLVERINE FIX USDC FINAL ===" | tee "$LOG"

### 1) Vérifier fichier réellement servi
test -f "$HTML" || { echo "ERREUR: index.html absent"; exit 1; }
cp -a "$HTML" "${HTML}.bak_${TS}"

### 2) Forcer MIME JS (CAUSE #1)
if ! grep -q "application/javascript" "$NG"; then
  cp -a "$NG" "${NG}.bak_${TS}"
  sed -i '/http {/a \    types { application/javascript js; }' "$NG"
fi

### 3) Vérifier root nginx (CAUSE #2 potentielle)
grep -q "root /var/www/wolverine;" "$VHOST" || {
  cp -a "$VHOST" "${VHOST}.bak_${TS}"
  sed -i 's|root .*;|root /var/www/wolverine;|g' "$VHOST"
}

### 4) Nettoyage JS USDC (aucune bidouille)
sed -i '
/USDC START/,/USDC END/d
' "$HTML"

cat >>"$HTML" <<'JS'
<!-- USDC START -->
<script type="module">
import {
  Connection,
  PublicKey
} from "/wolverine/vendor/solana-web3.js";

const RPC = "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";
const USDC_MINT = new PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");

window.readUSDC = async function(pubkey){
  const conn = new Connection(RPC, "confirmed");
  const res = await conn.getParsedTokenAccountsByOwner(
    new PublicKey(pubkey),
    { mint: USDC_MINT }
  );
  let sum = 0;
  for (const a of res.value) {
    sum += a.account.data.parsed.info.tokenAmount.uiAmount || 0;
  }
  document.getElementById("usdc").innerText = sum.toFixed(2);
};
</script>
<!-- USDC END -->
JS

### 5) Purge + reload
rm -rf /var/cache/nginx/* || true
nginx -t
systemctl reload nginx

echo "=== FIX APPLIQUÉ ===" | tee -a "$LOG"
echo "ACTION: CTRL + SHIFT + R sur /wolverine" | tee -a "$LOG"
echo "LOG: $LOG"
BASH

chmod +x /root/WOLVERINE_FIX_USDC_FINAL.sh
/root/WOLVERINE_FIX_USDC_FINAL.sh
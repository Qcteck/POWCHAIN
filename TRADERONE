cat >/root/MEGA_AQUILA_STACKING_PROJECT_V2_DEPLOY_MODES.sh<<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 027
TS="$(date +%Y%m%d_%H%M%S)"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing: $1"; }

[ "$(id -u)" -eq 0 ] || die "run as root"
need node; need corepack; need solana; need anchor; need yarn; need jq; need curl

APP="/opt/aquila_stacking"
PROG="aquila_stacking"
BK="/root/AQUILA_STACKING_V2_DEPLOY_BK_${TS}"
mkdir -p "$BK"

MODE="${1:-localnet}" # localnet|devnet|mainnet
case "$MODE" in localnet|devnet|mainnet) ;; *) die "usage: $0 [localnet|devnet|mainnet]";; esac

say "0) Mode: $MODE"
say "1) Workspace check"
[ -d "$APP" ] || die "missing $APP (run project batch first)"
cd "$APP"

corepack enable >/dev/null 2>&1 || true
corepack prepare yarn@1.22.22 --activate >/dev/null 2>&1 || true

say "2) Keypairs per cluster"
KP_LOCAL="$APP/target/deploy/${PROG}-keypair.json"
KP_DEV="$APP/keys/${PROG}-devnet-keypair.json"
KP_MAIN="$APP/keys/${PROG}-mainnet-keypair.json"
mkdir -p "$APP/keys" "$APP/target/deploy"

mk_kp(){ local f="$1"; [ -f "$f" ] || solana-keygen new --no-bip39-passphrase --silent --outfile "$f" >/dev/null; }
mk_kp "$KP_LOCAL"
mk_kp "$KP_DEV"
mk_kp "$KP_MAIN"

PID_LOCAL="$(solana-keygen pubkey "$KP_LOCAL")"
PID_DEV="$(solana-keygen pubkey "$KP_DEV")"
PID_MAIN="$(solana-keygen pubkey "$KP_MAIN")"

say "Program IDs:"
say "  localnet: $PID_LOCAL"
say "  devnet : $PID_DEV"
say "  mainnet: $PID_MAIN"

say "3) Configure provider cluster + wallet"
case "$MODE" in
  localnet)
    solana config set --url http://127.0.0.1:8899 >/dev/null
    solana config set --keypair "$KP_LOCAL" >/dev/null
    PID="$PID_LOCAL"
    ;;
  devnet)
    solana config set --url https://api.devnet.solana.com >/dev/null
    solana config set --keypair "$KP_DEV" >/dev/null
    PID="$PID_DEV"
    ;;
  mainnet)
    solana config set --url https://api.mainnet-beta.solana.com >/dev/null
    solana config set --keypair "$KP_MAIN" >/dev/null
    PID="$PID_MAIN"
    ;;
esac

say "4) Patch declare_id + Anchor.toml program id for selected mode"
# backup
cp -a "$APP/programs/$PROG/src/lib.rs" "$BK/lib.rs.bak"
cp -a "$APP/Anchor.toml" "$BK/Anchor.toml.bak"

# patch declare_id! line
perl -0777 -pe "s/declare_id!\\(\\\"[^\\\"]+\\\"\\);/declare_id!(\\\"$PID\\\");/g" -i "$APP/programs/$PROG/src/lib.rs"

# patch Anchor.toml: set programs.<mode>
python3 - <<PY
import re
p="$PID"
mode="$MODE"
txt=open("$APP/Anchor.toml","r").read()
# ensure sections exist, rewrite the right section deterministically
def set_section(section, key, value, txt):
    # section like [programs.devnet]
    if section not in txt:
        txt += "\n"+section+"\n"
    # replace or add key line inside section
    parts=txt.split(section)
    pre=parts[0]
    rest=section.join(parts[1:])
    # find next section
    m=re.search(r"\n\\[.*?\\]\n", rest)
    body = rest[:m.start()] if m else rest
    tail = rest[m.start():] if m else ""
    # remove old key
    body=re.sub(rf"^\s*{re.escape(key)}\s*=\s*\"[^\"]*\"\s*$", "", body, flags=re.M)
    body = body.strip("\n")
    if body and not body.endswith("\n"): body += "\n"
    body += f"{key} = \"{value}\"\n"
    return pre + section + "\n" + body + tail

txt=set_section("[programs.%s]"%mode, "$PROG", p, txt)
open("$APP/Anchor.toml","w").write(txt)
PY

say "5) Install deps (if missing) + build"
yarn install --non-interactive
anchor build

say "6) Optional airdrop (devnet/localnet only) + deploy"
if [ "$MODE" = "devnet" ]; then
  say "6a) Airdrop 2 SOL devnet (best effort)"
  solana airdrop 2 >/dev/null 2>&1 || true
fi

if [ "$MODE" = "localnet" ]; then
  say "6a) Ensure local validator running (best effort start in background if not)"
  if ! curl -s http://127.0.0.1:8899 >/dev/null 2>&1; then
    nohup solana-test-validator --reset >"$BK/solana-test-validator.log" 2>&1 &
    sleep 2
  fi
fi

say "6b) anchor deploy (MODE=$MODE)"
anchor deploy

say "7) Export IDL + addresses"
IDL="$APP/target/idl/${PROG}.json"
ADDR="$APP/DEPLOY_${MODE}.txt"
mkdir -p "$APP/target/idl"
[ -f "$IDL" ] && cp -a "$IDL" "$BK/${PROG}.idl.json" || true

cat >"$ADDR"<<EOF
MODE=$MODE
PROGRAM=$PROG
PROGRAM_ID=$PID
SOLANA_URL=$(solana config get | awk -F': ' '/RPC URL/{print $2}')
WALLET=$(solana config get | awk -F': ' '/Keypair Path/{print $2}')
TS=$TS
EOF

say "8) Done"
say "Program ID ($MODE): $PID"
say "Deploy info: $ADDR"
say "BK: $BK"
BASH
chmod +x /root/MEGA_AQUILA_STACKING_PROJECT_V2_DEPLOY_MODES.sh
bash /root/MEGA_AQUILA_STACKING_PROJECT_V2_DEPLOY_MODES.sh devnet
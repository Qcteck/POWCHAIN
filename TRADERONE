),rgba(10,155,98,.85));border-color:rgba(170,255,220,.28)}.ghost{opacity:.75}#grid{display:grid;grid-template-columns:1.05fr .95fr;gap:14px}#card,#console{border-radius:18px;background:var(--card);border:1px solid var(--bd);box-shadow:0 10px 40px rgba(255,255,255,.05)}#card{padding:14px 14px 16px;display:flex;flex-direction:column;gap:12px}#card h3,#console h3{padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.08);font-size:14px;letter-spacing:.3px}#console{padding:0}#consoleInner{padding:12px 14px;display:flex;flex-direction:column;gap:10px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:6px 0}.col{flex:1;min-width:220px}.mini{min-width:160px}label{display:block;color:var(--m);font-size:12px;margin-bottom:4px}input,select{width:100%;padding:10px 12px;border-radius:14px;background:rgba(0,0,0,.15);border:1px solid rgba(255,255,255,.16);color:var(--text);outline:none}body.light input,body.light select{background:rgba(255,255,255,.75);color:#111;border-color:rgba(0,0,0,.12)}input:focus,select:focus{border-color:rgba(255,255,255,.35)}.kpi{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:4px}.box{padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14)}body.light .box{background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.12)}.box b{display:block;font-size:12px;color:var(--m);font-weight:600}.box span{display:block;margin-top:4px;font-size:13px}#log{height:320px;overflow:auto;padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;white-space:pre-wrap;color:#fff}body.light #log{color:#111;background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.12)}#foot{color:var(--m);font-size:12px;display:flex;gap:12px;flex-wrap:wrap}#dot{display:inline-block;width:8px;height:8px;border-radius:99px;background:#666}#dot.ok{background:var(--ok)}#dot.bad{background:var(--bad)}#settingsPanel{position:fixed;top:64px;right:20px;width:240px;padding:14px;background:rgba(0,0,0,.75);border:1px solid rgba(255,255,255,.18);border-radius:14px;display:none;flex-direction:column;gap:8px;z-index:999}#settingsPanel label{color:#fff;font-size:12px}#settingsPanel select,input[type=color]{width:100%}#settingsPanel hr{border:none;border-top:1px solid rgba(255,255,255,.18);margin:6px 0}@media(max-width:980px){#grid{grid-template-columns:1fr}}</style></head><body><div id="wrap"><div id="bar"><div id="logo"><b>W</b></div><div><div id="title">WOLVERINE</div><div id="sub">TraderOne • API • Wallet Phantom</div></div><div id="topBtns"><button id="bPing" class="ghost">Ping</button><button id="bRefresh" class="ghost">Refresh</button><button id="bSettings" class="ghost">Settings</button><button id="bStart" class="primary">Start</button><button id="bStop" class="danger">Stop</button></div></div><div id="grid"><div id="card"><h3>Contrôle Wallet</h3><div class="row"><div class="col mini"><label>Wallet (Phantom)</label><div class="row" style="margin:0"><button id="bConnect" class="primary">Connect</button><button id="bDisconnect">Disconnect</button></div></div><div class="col"><label>Adresse Phantom</label><input id="addr" placeholder="non connecté" readonly></div></div><div class="row"><div class="col"><label>Adresse Bot (TraderOne)</label><input id="bot" placeholder="-" readonly></div></div><div class="kpi"><div class="box" id="kSol"><b>SOL (user)</b><span id="sol">-</span></div><div class="box" id="kUsdc"><b>USDC (user)</b><span id="usdc">-</span></div><div class="box" id="kCust"><b>Custody (bot)</b><span id="cust">-</span></div></div><div class="row"><div class="col"><label>Budget (USDC)</label><input id="budget" inputmode="decimal" placeholder="ex: 50"></div><div class="col"><label>Mode</label><select id="mode"><option value="SAFE">SAFE</option><option value="AUTO">AUTO</option><option value="RR">RR</option><option value="SCALP">SCALP</option></select></div></div><div class="row"><div class="col"><label>Mint (optionnel)</label><input id="mint" placeholder="SPL mint (solana)"></div><div class="col mini"><label>Auto refresh</label><select id="auto"><option value="on">ON</option><option value="off">OFF</option></select></div></div></div><div id="console"><h3>Console</h3><div id="consoleInner"><div id="log"></div><div id="foot"><span><i id="dot"></i> <span id="apiState">API: ?</span></span><span>Dernier: <span id="last">-</span></span><span>Erreurs: <span id="errs">0</span></span><span>Latence: <span id="lat">-</span></span></div></div></div></div></div><div id="settingsPanel"><label>Thème</label><select id="themeSelect"><option value="dark">Sombre</option><option value="light">Clair</option></select><label>Auto-refresh</label><select id="autoSelect"><option value="on">ON</option><option value="off">OFF</option></select><hr><label>Couleur fond</label><input type="color" id="colorBg" value="#061027"><label>Couleur cartes</label><input type="color" id="colorCard" value="#000000"><label>Couleur boutons</label><input type="color" id="colorBtn" value="#ffffff"><label>Couleur contours</label><input type="color" id="colorBorder" value="#ffffff"></div><script>(()=>{const $=s=>document.querySelector(s),logEl=$("#log"),dot=$("#dot"),apiState=$("#apiState");let errs=0,autoTimer=0,running=false,connected=false;function hexToRgba(hex,a=1){let c;if(/^#([A-Fa-f0-9]{3}){1,2}$/.test(hex)){c=hex.substring(1).split("");if(c.length==3)c=[c[0],c[0],c[1],c[1],c[2],c[2]];c="0x"+c.join("");return`rgba(${(c>>16)&255},${(c>>8)&255},${c&255},${a})`}return hex}function applyColors(p){if(p.bg)document.documentElement.style.setProperty("--bg",hexToRgba(p.bg,.85));if(p.card)document.documentElement.style.setProperty("--card",hexToRgba(p.card,.18));if(p.btn)document.documentElement.style.setProperty("--btn",hexToRgba(p.btn,.14));if(p.border)document.documentElement.style.setProperty("--bd",hexToRgba(p.border,.12))}function savePrefs(p){localStorage.setItem("wolvPrefs",JSON.stringify(p))}function loadPrefs(){return JSON.parse(localStorage.getItem("wolvPrefs")||"{}")}function now(){return new Date().toISOString().replace("T"," ").replace("Z"," UTC")}function log(m){logEl.textContent+=`[${now()}] ${m}\n`;logEl.scrollTop=logEl.scrollHeight}function setErr(){errs++;$("#errs").textContent=String(errs)}function setLat(ms){$("#lat").textContent=ms>=0?`${ms}ms`:"-"}function setLast(){$("#last").textContent=now()}function updateButtons(){$("#bConnect").disabled=connected;$("#bDisconnect").disabled=!connected;$("#bStart").disabled=!connected||running;$("#bStop").disabled=!running}function kpiBorder(el,val,th){try{el.style.borderColor=(isFinite(val)&&val>=th)?"rgba(134,255,208,.8)":"rgba(255,123,123,.8)"}catch(_){}}async function connect(){try{const p=window.solana;if(!p||!p.isPhantom){log("Phantom introuvable");setErr();return}const res=await p.connect();$("#addr").value=res.publicKey.toString();connected=true;updateButtons();log("Phantom connecté")}catch(e){setErr();log("Phantom connect error")}}async function disconnect(){try{const p=window.solana;if(p&&p.disconnect)await p.disconnect();$("#addr").value="";connected=false;updateButtons();log("Phantom déconnecté")}catch(e){setErr();log("Phantom disconnect error")}}async function apiPost(path,obj){try{const r=await fetch("/wolverine/api"+path,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(obj||{}),cache:"no-store"});const txt=await r.text();let out;try{out=JSON.parse(txt)}catch(_){out={raw:txt,nonjson:true}}return{ok:r.ok,status:r.status,data:out}}catch(e){setErr();return{ok:false,status:0,data:{err:"fetch"}}}}async function apiGet(path){try{const t0=performance.now();const r=await fetch("/wolverine/api"+path,{cache:"no-store"});const txt=await r.text();setLat(Math.round(performance.now()-t0));let out;try{out=JSON.parse(txt)}catch(_){out={raw:txt,nonjson:true}}return{ok:r.ok,status:r.status,data:out,raw:txt}}catch(e){setErr();return{ok:false,status:0,data:{err:"fetch"}}}}function readNum(x){const n=parseFloat(x);return isFinite(n)?n:NaN}function fmt(x,dec=6){const n=readNum(x);return isFinite(n)?n.toFixed(dec):"-"}function updBalances(d){const userSol=d.userSol??d.sol??d.user?.sol??d.user?.SOL??d.balances?.user?.sol;const userUsdc=d.userUsdc??d.usdc??d.user?.usdc??d.user?.USDC??d.balances?.user?.usdc;const botSol=d.botSol??d.custodySol??d.bot?.sol??d.bot?.SOL??d.balances?.bot?.sol;const botUsdc=d.botUsdc??d.custodyUsdc??d.bot?.usdc??d.bot?.USDC??d.balances?.bot?.usdc;const botPub=d.botPub??d.bot?.pub??d.botAddress??d.address??d.botAddr;$("#sol").textContent=fmt(userSol,6);$("#usdc").textContent=fmt(userUsdc,4);$("#cust").textContent=(isFinite(readNum(botUsdc))?fmt(botUsdc,4)+" USDC":"-")+(isFinite(readNum(botSol))?" | "+fmt(botSol,6)+" SOL":"");if(botPub)$("#bot").value=String(botPub);kpiBorder($("#kSol"),readNum(userSol),.01);kpiBorder($("#kUsdc"),readNum(userUsdc),.01);kpiBorder($("#kCust"),readNum(botUsdc),.01)}async function refreshAll(){try{const pr=await fetch("/wolverine/api/ping",{cache:"no-store"});const ptxt=(await pr.text()).trim();dot.className=ptxt==="pong"?"ok":"bad";apiState.textContent="API: "+ptxt;log("ping: "+ptxt)}catch(e){dot.className="bad";apiState.textContent="API: ERR";setErr();log("ping error")}setLast();const pub=$("#addr").value||"";let r=await apiGet("/balances2?pub="+encodeURIComponent(pub));if(!r.ok||r.data?.nonjson){r=await apiGet("/balances?pub="+encodeURIComponent(pub))}if(!r.ok||r.data?.nonjson){r=await apiGet("/status?pub="+encodeURIComponent(pub))}if(r.ok&&!r.data?.nonjson){updBalances(r.data);log("balances: OK")}else{log("balances: ERR "+String(r.status)+" "+(r.data?.nonjson?"non-json":""));if(r.data?.nonjson&&r.data?.raw)log(("raw: "+String(r.data.raw)).slice(0,180));setErr()}}async function start(){running=true;updateButtons();const payload={budgetUsdc:parseFloat($("#budget").value)||0,mode:String($("#mode").value||"SAFE"),mint:$("#mint").value.trim(),phantomPubkey:$("#addr").value,ts:Date.now()};const r=await apiPost("/start",payload);log("start: "+JSON.stringify(r.data));if(!r.ok){setErr();running=false}updateButtons()}async function stop(){const r=await apiPost("/stop",{ts:Date.now()});log("stop: "+JSON.stringify(r.data));if(!r.ok)setErr();running=false;updateButtons()}function autoSet(){clearInterval(autoTimer);autoTimer=0;if($("#auto").value==="on")autoTimer=setInterval(()=>refreshAll().catch(()=>0),8000)}$("#bConnect").onclick=connect;$("#bDisconnect").onclick=disconnect;$("#bStart").onclick=start;$("#bStop").onclick=stop;$("#bPing").onclick=refreshAll;$("#bRefresh").onclick=refreshAll;$("#bSettings").onclick=()=>$("#settingsPanel").style.display=$("#settingsPanel").style.display==="flex"?"none":"flex";$("#themeSelect").onchange=e=>{document.body.className=e.target.value;savePrefs({...loadPrefs(),theme:e.target.value})};$("#autoSelect").onchange=e=>{$("#auto").value=e.target.value;autoSet();savePrefs({...loadPrefs(),autoRefresh:e.target.value})};$("#colorBg").oninput=e=>{const p={...loadPrefs(),bg:e.target.value};applyColors(p);savePrefs(p)};$("#colorCard").oninput=e=>{const p={...loadPrefs(),card:e.target.value};applyColors(p);savePrefs(p)};$("#colorBtn").oninput=e=>{const p={...loadPrefs(),btn:e.target.value};applyColors(p);savePrefs(p)};$("#colorBorder").oninput=e=>{const p={...loadPrefs(),border:e.target.value};applyColors(p);savePrefs(p)};document.addEventListener("DOMContentLoaded",()=>{const prefs=loadPrefs();if(prefs.theme)document.body.className=prefs.theme;if(prefs.autoRefresh)$("#auto").value=prefs.autoRefresh;applyColors(prefs);updateButtons();autoSet();refreshAll()})})();</script></body></html>

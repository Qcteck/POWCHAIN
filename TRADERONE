cat > /root/FIX_USDC_ONLY.sh <<'BASH'
#!/usr/bin/env bash
set -e

echo "=== FIX USDC ONLY (SAFE MODE) ==="

HTML="/var/www/wolverine/index.html"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"
TS="$(date +%Y%m%d_%H%M%S)"

# 1. Vérifications
if [ ! -f "$HTML" ]; then
  echo "ERREUR: index.html introuvable"
  exit 1
fi

# 2. Backup
cp -a "$HTML" "${HTML}.bak_usdc_${TS}"
echo "Backup créé: ${HTML}.bak_usdc_${TS}"

# 3. Nettoyage anciennes injections USDC
sed -i '/readUSDC(/d' "$HTML"
sed -i '/getUSDC(/d' "$HTML"
sed -i '/USDC_MINT/d' "$HTML"

# 4. Injection fonction USDC CANONIQUE (SPL officielle)
sed -i "/<\/body>/i \
<script>\n\
/* === USDC SPL OFFICIEL === */\n\
const USDC_MINT = \"$USDC_MINT\";\n\
async function readUSDC(pub){\n\
  try{\n\
    if(!pub || !window.solanaWeb3) return \"0.000000\";\n\
    const conn = new solanaWeb3.Connection(RPC);\n\
    const res = await conn.getParsedTokenAccountsByOwner(\n\
      new solanaWeb3.PublicKey(pub),\n\
      { mint: new solanaWeb3.PublicKey(USDC_MINT) }\n\
    );\n\
    let t = 0;\n\
    res.value.forEach(v=>{\n\
      t += Number(v.account.data.parsed.info.tokenAmount.uiAmount || 0);\n\
    });\n\
    return t.toFixed(6);\n\
  } catch(e){\n\
    console.error(\"USDC error\", e);\n\
    return \"0.000000\";\n\
  }\n\
}\n\
</script>\n" "$HTML"

# 5. Branchement sur refresh EXISTANT (sans toucher Phantom)
sed -i 's/USDC:[^<]*/USDC: <span id="usdc">-<\/span>/' "$HTML" || true
sed -i '/refresh()/a \
try{document.getElementById("usdc").innerText=await readUSDC(USER_PUB);}catch(e){}' "$HTML"

# 6. Cache nginx
rm -rf /var/cache/nginx/* || true

# 7. Reload nginx
nginx -t && systemctl reload nginx

echo "=== FIX USDC TERMINÉ ==="
echo "Action navigateur: CTRL + SHIFT + R"
BASH
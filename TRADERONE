cat >/root/enforce_traderone_api_block.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/wolverine_routes.inc"
TS="$(date -u +%Y%m%d_%H%M%S)"
HOST="fireinners.online"
SNIP="include /etc/nginx/snippets/traderone_api_lockdown.conf;"

test -f "$INC" || { echo "❌ Missing $INC"; exit 1; }

echo "=== 1) Backup ==="
cp -a "$INC" "${INC}.bak_${TS}"
echo "Backup: ${INC}.bak_${TS}"
echo

echo "=== 2) Ensure snippet exists (deny public) ==="
mkdir -p /etc/nginx/snippets
cat >/etc/nginx/snippets/traderone_api_lockdown.conf <<'NG'
add_header Cache-Control "no-store" always;
allow 127.0.0.1;
deny all;
NG
chmod 0644 /etc/nginx/snippets/traderone_api_lockdown.conf
echo "OK snippet written"
echo

echo "=== 3) Inject include inside ANY /wolverine/traderone/api location blocks ==="
python3 - <<'PY'
from pathlib import Path
import re

inc_path = Path("/etc/nginx/includes/wolverine_routes.inc")
s = inc_path.read_text(errors="ignore")

include_line = "include /etc/nginx/snippets/traderone_api_lockdown.conf;"

# Inject include right after "{" for any location block matching /wolverine/traderone/api (with or without slash)
def inject_into_locations(text):
    out = []
    i = 0
    changed = False
    # Find "location ... /wolverine/traderone/api ... {"
    for m in re.finditer(r'(^\s*location\s+[^{};]*?/wolverine/traderone/api/?\s*\{)', text, flags=re.M):
        start = m.start(1)
        brace = text.find("{", start)
        if brace == -1:
            continue
        # find end of that location block by brace matching
        j = brace
        depth = 0
        end = None
        while j < len(text):
            if text[j] == "{": depth += 1
            elif text[j] == "}":
                depth -= 1
                if depth == 0:
                    end = j + 1
                    break
            j += 1
        if end is None:
            continue

        block = text[start:end]
        if include_line in block:
            continue

        # inject include after first "{"
        block2 = re.sub(r'\{\s*', '{\n    ' + include_line + '\n', block, count=1)
        text = text[:start] + block2 + text[end:]
        changed = True
        return text, changed  # run iteratively (string changed offsets)

    return text, changed

changed_any = False
while True:
    s2, changed = inject_into_locations(s)
    if not changed:
        break
    s = s2
    changed_any = True

if not changed_any:
    print("WARN: no /wolverine/traderone/api location found to patch (it may be in site file, not include).")
else:
    inc_path.write_text(s)
    print("OK: include injected into traderone api location(s)")
PY
echo

echo "=== 4) nginx test + reload ==="
nginx -t
systemctl reload nginx || service nginx reload
echo

echo "=== 5) Checks ==="
echo "--- ORIGIN (localhost allowed, may be 200/404 depending on app) ---"
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}/wolverine/traderone/api | head -n 12 || true
echo
echo "--- PUBLIC (should be 403) ---"
curl -skI https://${HOST}/wolverine/traderone/api | head -n 12 || true

echo "DONE ✅"
BASH

chmod +x /root/enforce_traderone_api_block.sh

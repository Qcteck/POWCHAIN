cat >/root/WOLVERINE_WALLETCONNECT_LOCAL_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
VENDOR="/var/www/wolverine/vendor"
WC_JS="$VENDOR/walletconnect-ethereum-provider.js"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE WalletConnect Local Fix ==="

### 1) Préparer vendor
mkdir -p "$VENDOR"

### 2) Télécharger WalletConnect si absent
if [ ! -s "$WC_JS" ]; then
  echo "[+] Download WalletConnect (local)"
  curl -fsSL \
    https://unpkg.com/@walletconnect/ethereum-provider@2.11.1/dist/index.umd.js \
    -o "$WC_JS"
else
  echo "[=] WalletConnect already present"
fi

test -s "$WC_JS" || { echo "❌ WalletConnect download failed"; exit 1; }

### 3) Backup index.html
cp "$HTML" "$HTML.bak_$TS"
echo "[+] Backup: index.html.bak_$TS"

### 4) Nettoyer anciens CDN WalletConnect
sed -i '/walletconnect.*ethereum-provider/d' "$HTML"

### 5) Injecter script local WalletConnect (si absent)
grep -q "walletconnect-ethereum-provider.js" "$HTML" || \
sed -i "/<\/head>/i \
<script src=\"\/wolverine\/vendor\/walletconnect-ethereum-provider.js\"></script>
" "$HTML"

### 6) Injecter connectWC() sécurisé (si absent)
grep -q "function connectWC" "$HTML" || \
sed -i "/<script>/a \
\n// WalletConnect / Rainbow (safe)\n\
async function connectWC(){\n\
  if(!window.WalletConnectEthereumProvider){\n\
    alert(\"WalletConnect non chargé\");\n\
    return;\n\
  }\n\
  try{\n\
    const provider = await window.WalletConnectEthereumProvider.init({\n\
      projectId: \"demo\",\n\
      chains: [1],\n\
      showQrModal: true\n\
    });\n\
    await provider.enable();\n\
    alert(\"WalletConnect / Rainbow connecté\");\n\
  }catch(e){\n\
    alert(\"WalletConnect error: \" + e.message);\n\
  }\n\
}\n" "$HTML"

### 7) Permissions
chown -R www-data:www-data /var/www/wolverine
chmod 644 "$HTML"
chmod 644 "$WC_JS"

echo "=== DONE ==="
echo "✔ WalletConnect local installé"
echo "✔ index.html patché sans doublon"
echo "✔ connectWC() sécurisé"
echo ""
echo "➡️ Recharge navigateur : CTRL + SHIFT + R"
BASH

chmod +x /root/WOLVERINE_WALLETCONNECT_LOCAL_FIX.sh
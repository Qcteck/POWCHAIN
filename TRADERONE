DOMAIN="fireinners.online"

echo "== DNS =="
getent ahosts "$DOMAIN" || true
echo

echo "== Qui écoute sur 443/80 (local) =="
ss -lntp | egrep ':(80|443)\s' || true
echo

echo "== Firewall (si ufw) =="
ufw status verbose 2>/dev/null || true
echo

echo "== Test connect TCP 443 (IPv4/IPv6) =="
echo "-- curl -4"
curl -4 -vkI "https://$DOMAIN/" --max-time 5 2>&1 | sed -n '1,20p' || true
echo
echo "-- curl -6"
curl -6 -vkI "https://$DOMAIN/" --max-time 5 2>&1 | sed -n '1,20p' || true
echo
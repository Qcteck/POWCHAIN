#!/usr/bin/env bash
set -euo pipefail

echo "=== MEGA WOLVERINE PATCH ==="

APPDIR="/opt/fireinners/wolverine-api"
FRONTDIR="/opt/fireinners/frontend-react/app/dist/wolverine"
UNIT="/etc/systemd/system/wolverine-api.service"
ENVFILE="$APPDIR/.env"

need_root(){ [ "$(id -u)" -eq 0 ] || { echo "ERR: run as root"; exit 1; }; }
ts(){ date -u +"%Y%m%d_%H%M%S"; }

unlock_if_immutable(){
  local f="$1"
  if [ -e "$f" ]; then
    if lsattr -d "$f" 2>/dev/null | grep -q "\-i\-"; then :; else chattr -i "$f" 2>/dev/null || true; fi
  fi
}
relock_if_wanted(){
  local f="$1"
  if [ -e "$f" ]; then chattr +i "$f" 2>/dev/null || true; fi
}

backup_file(){
  local f="$1"
  [ -e "$f" ] || return 0
  cp -a "$f" "$f.bak.$(ts)" || true
}

write_file(){
  local f="$1"
  local tmp="$f.tmp.$(ts)"
  cat >"$tmp"
  unlock_if_immutable "$f"
  backup_file "$f"
  install -m 0644 "$tmp" "$f"
  rm -f "$tmp"
}

write_exec(){
  local f="$1"
  local tmp="$f.tmp.$(ts)"
  cat >"$tmp"
  unlock_if_immutable "$f"
  backup_file "$f"
  install -m 0755 "$tmp" "$f"
  rm -f "$tmp"
}

need_root

echo "=== PRE-FLY (read-only) ==="
node -v || true
npm -v || true
nginx -t >/dev/null 2>&1 && echo "nginx: OK" || echo "nginx: WARN (test failed)"
systemctl status wolverine-api --no-pager >/dev/null 2>&1 && echo "systemd: wolverine-api exists" || echo "systemd: wolverine-api missing (will create)"

echo "=== DIRS ==="
mkdir -p "$APPDIR" "$FRONTDIR"

echo "=== BACKEND: package.json ==="
write_file "$APPDIR/package.json" <<'JSON'
{"name":"wolverine-api","version":"1.0.0","main":"server.js","type":"commonjs","scripts":{"start":"node server.js"},"dependencies":{"dotenv":"^16.4.5","express":"^4.19.2"}}
JSON

echo "=== BACKEND: server.js (full) ==="
write_file "$APPDIR/server.js" <<'JS'
const fs=require("fs");const path=require("path");const express=require("express");require("dotenv").config({path:path.join(__dirname,".env")});
const HOST=process.env.HOST||"127.0.0.1";const PORT=parseInt(process.env.PORT||"3050",10);
const BASE_PATH=(process.env.BASE_PATH||"/wolverine").replace(/\/+$/,"");
const app=express();app.set("trust proxy",true);app.use(express.json({limit:"256kb"}));
let loop=false,loopTimer=null,fails=0;let last={ok:null,ts:0,err:null,code:null,body:null};
let cfg={mode:"DCA_SOL_SAFE",budgetUsdc:0,mint:"",phantomPubkey:"",autoRefresh:true};
const now=()=>Date.now();

function setLast(ok,code,body,err){last={ok:!!ok,ts:now(),err:err?String(err):null,code:code??null,body:body??null};if(!ok)fails++;}

function stopLoop(){loop=false;if(loopTimer){clearInterval(loopTimer);loopTimer=null;}}
function startLoop(){if(loopTimer) return;loop=true;loopTimer=setInterval(()=>{try{setLast(true,200,{tick:true,cfg},null);}catch(e){setLast(false,500,null,e);}},20000);}

app.get("/ping",(req,res)=>res.type("text/plain").send("pong"));

app.get("/config",(req,res)=>res.json({ok:true,host:HOST,port:PORT,basePath:BASE_PATH,apiPrefix:`${BASE_PATH}/api`,cfg}));

app.get("/status",(req,res)=>res.json({ok:true,loop,last,fails,cfg}));

app.post("/start",(req,res)=>{
  try{
    const b=req.body||{};
    const budget=Number(b.budgetUsdc??b.budget??0);
    if(!isFinite(budget)||budget<=0) return res.status(400).json({ok:false,err:"budgetUsdc invalid"});
    const mode=String(b.mode||"DCA_SOL_SAFE");
    const mint=String(b.mint||"");
    const phantomPubkey=String(b.phantomPubkey||b.pubkey||"");
    cfg={...cfg,mode,budgetUsdc:budget,mint,phantomPubkey,autoRefresh:!!b.autoRefresh};
    startLoop();
    setLast(true,200,{started:true,cfg},null);
    res.json({ok:true,started:true,cfg});
  }catch(e){setLast(false,500,null,e);res.status(500).json({ok:false,err:String(e)});}
});

app.post("/stop",(req,res)=>{
  try{stopLoop();setLast(true,200,{stopped:true},null);res.json({ok:true,stopped:true});}
  catch(e){setLast(false,500,null,e);res.status(500).json({ok:false,err:String(e)});}
});

app.use((req,res)=>res.status(404).json({ok:false,err:"not found",path:req.path,method:req.method}));

app.listen(PORT,HOST,()=>{console.log(`WOLVERINE API up on http://${HOST}:${PORT} (BASE_PATH=${BASE_PATH})`);});
JS

echo "=== BACKEND: .env ==="
write_file "$ENVFILE" <<'ENV'
HOST=127.0.0.1
PORT=3050
BASE_PATH=/wolverine
ENV

echo "=== NPM INSTALL (backend deps) ==="
cd "$APPDIR"
npm install --omit=dev >/dev/null 2>&1 || npm install --omit=dev

echo "=== SYSTEMD UNIT (create/ensure) ==="
if [ ! -f "$UNIT" ]; then
  write_file "$UNIT" <<UNITFILE
[Unit]
Description=WOLVERINE API
After=network.target

[Service]
Type=simple
WorkingDirectory=$APPDIR
EnvironmentFile=$ENVFILE
ExecStart=/usr/bin/node $APPDIR/server.js
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
UNITFILE
fi

systemctl daemon-reload
systemctl enable --now wolverine-api >/dev/null 2>&1 || true
systemctl restart wolverine-api

echo "=== WAIT LISTEN 3050 ==="
for i in $(seq 1 30); do ss -lntp 2>/dev/null | grep -q ":3050" && break || sleep 1; done

echo "=== FRONTEND: index.html (full) ==="
write_file "$FRONTDIR/index.html" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE</title><style>:root{--bg:#061027;--p:#0a1b3e;--p2:#0a2a66;--b:#1e4ea8;--t:#e8f2ff;--m:#9fb7e6;--ok:#86ffd0;--bad:#ff7b7b;--chip:rgba(10,27,62,.55)}*{box-sizing:border-box}html,body{height:100%;margin:0;background:radial-gradient(1100px 600px at 20% 0%,#0a1b3e 0%,transparent 60%),radial-gradient(900px 520px at 80% 30%,#0a2a66 0%,transparent 55%),var(--bg);color:var(--t);font:14px system-ui,-apple-system,Segoe UI,Roboto}a{color:inherit}#wrap{max-width:1200px;margin:18px auto;padding:0 14px}#bar{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:linear-gradient(180deg,rgba(10,27,62,.85),rgba(6,16,39,.55));border:1px solid rgba(180,210,255,.18);box-shadow:0 10px 40px rgba(0,0,0,.35)}#badge{width:36px;height:36px;border-radius:10px;background:linear-gradient(180deg,#1a7cff,#0a2a66);box-shadow:0 10px 30px rgba(0,0,0,.25)}#title{font-weight:800;letter-spacing:.6px}#sub{color:var(--m);font-size:12px;margin-top:2px}#topBtns{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}button,.pill,select,input{border:1px solid rgba(180,210,255,.18);background:rgba(10,27,62,.55);color:var(--t);border-radius:999px;padding:8px 10px;font-weight:700}button{cursor:pointer}button:hover{filter:brightness(1.08)}.btnOk{background:linear-gradient(180deg,rgba(28,167,255,.85),rgba(10,42,102,.75))}.btnBad{background:linear-gradient(180deg,rgba(255,85,85,.9),rgba(120,20,20,.75))}#grid{display:grid;grid-template-columns:1.1fr 1fr;gap:14px;margin-top:14px}#card,#console{border-radius:18px;background:linear-gradient(180deg,rgba(10,27,62,.75),rgba(6,16,39,.55));border:1px solid rgba(180,210,255,.18);box-shadow:0 10px 40px rgba(0,0,0,.35)}#card{padding:14px}#console{padding:14px;display:flex;flex-direction:column;min-height:420px}h3{margin:0 0 10px 0;font-size:14px;letter-spacing:.4px}label{display:block;color:var(--m);font-size:12px;margin:10px 0 6px}#row{display:grid;grid-template-columns:1fr 1fr;gap:10px}#row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}input,select{width:100%;border-radius:12px;padding:10px 12px;font-weight:800}#actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}#log{flex:1;border-radius:14px;padding:10px 12px;background:rgba(0,0,0,.20);border:1px solid rgba(180,210,255,.12);font:13px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;white-space:pre-wrap;overflow:auto}#foot{display:flex;gap:14px;align-items:center;color:var(--m);font-size:12px;margin-top:10px}#dot{width:9px;height:9px;border-radius:99px;background:#444;box-shadow:0 0 0 4px rgba(255,255,255,.04)}#warn{margin-top:10px;padding:10px 12px;border-radius:14px;background:rgba(0,0,0,.20);border:1px solid rgba(180,210,255,.12);color:var(--m);font-size:12px;line-height:1.35}@media (max-width:980px){#grid{grid-template-columns:1fr}}</style></head><body><div id="wrap"><div id="bar"><div id="badge"></div><div><div id="title">WOLVERINE</div><div id="sub">TraderOne · API · Refresh adaptatif · Monitoring TG</div></div><div id="topBtns"><button id="bApi">API</button><button id="bPing">Ping</button><button id="bRefresh">Refresh</button><button id="bStart" class="btnOk">Start</button><button id="bStop" class="btnBad">Stop</button></div></div><div id="grid"><div id="card"><h3>Control</h3><label>Wallet (Phantom)</label><div style="display:flex;gap:10px;flex-wrap:wrap"><button id="bConnect" class="btnOk">Connect</button><button id="bDisc">Disconnect</button></div><label>Adresse Phantom</label><input id="pub" placeholder="non connecté" readonly/><div id="row3"><div><label>SOL</label><input id="sol" placeholder="-" readonly/></div><div><label>USDC</label><input id="usdc" placeholder="-" readonly/></div><div><label>Custody (TraderOne)</label><input id="cust" placeholder="-" readonly/></div></div><div id="row"><div><label>Budget (USDC)</label><input id="budget" inputmode="decimal" placeholder="ex: 50"/></div><div><label>Mode</label><select id="mode"><option value="DCA_SOL_SAFE">DCA buy SOL (safe)</option><option value="MICROCAP_RADAR_RISK">Microcap radar (risk)</option></select></div></div><div id="row"><div><label>Mint (si Manual token)</label><input id="mint" placeholder="SPL mint (solana)"/></div><div><label>Auto refresh</label><select id="auto"><option value="ON">ON</option><option value="OFF">OFF</option></select></div></div><div id="actions"><button id="bStart2" class="btnOk">Start WOLVERINE</button><button id="bStop2" class="btnBad">Stop</button></div><div id="warn"><b>WARN</b><br/>Important: ce front n'envoie aucune clé privée. Il envoie seulement la pubkey Phantom + budget + mode au backend via <code>/wolverine/api/*</code>.</div></div><div id="console"><h3>Console</h3><div id="log"></div><div id="foot"><div id="dot"></div><div id="st">API: -</div><div id="last">Dernier refresh: -</div><div id="err">Erreurs: 0</div><div id="lat">Latence: -</div></div></div></div></div><script>
(()=>{const BASE="/wolverine";const API=BASE+"/api";const $=s=>document.querySelector(s);
const logEl=$("#log"),dot=$("#dot"),st=$("#st"),last=$("#last"),errEl=$("#err"),lat=$("#lat");
const pub=$("#pub"),sol=$("#sol"),usdc=$("#usdc"),cust=$("#cust"),budget=$("#budget"),mode=$("#mode"),mint=$("#mint"),auto=$("#auto");
let errs=0,autoTimer=null;const ts=()=>new Date().toISOString().replace("T"," ").replace("Z"," UTC");
const LOG=(m)=>{logEl.textContent+=`[${ts()}] ${m}\n`;logEl.scrollTop=logEl.scrollHeight;};
const setDot=(ok)=>{dot.style.background=ok?"#2dffb4":"#ff6b6b";};
const fetchJSON=async(url,opt={})=>{const t0=performance.now();try{const r=await fetch(url,opt);const txt=await r.text();let j=null;try{j=JSON.parse(txt);}catch(_){j={raw:txt};}lat.textContent=`Latence: ${Math.round(performance.now()-t0)}ms`;return {ok:r.ok,status:r.status,data:j};}catch(e){errs++;errEl.textContent=`Erreurs: ${errs}`;lat.textContent="Latence: -";return {ok:false,status:0,data:{err:String(e)}};}};
const ping=async()=>{const r=await fetch(API+"/ping",{method:"GET"});const t=await r.text().catch(()=>"?");const ok=r.ok&&String(t).includes("pong");setDot(ok);st.textContent=`API: ${ok?"pong":"ERR"}`;LOG(`ping: ${ok?"pong":"ERR"}`);};
const apiInfo=async()=>{const r=await fetchJSON(API+"/config");LOG(`config: ${r.ok? "ok":"err"}`);if(r.ok&&r.data&&r.data.cfg){cust.value=(r.data.custody||r.data.cfg.custody||cust.value||"-");}return r;};
const status=async()=>{const r=await fetchJSON(API+"/status");LOG(`status: ${JSON.stringify(r.data)}`);last.textContent=`Dernier refresh: ${ts()}`;setDot(!!r.ok);st.textContent=`API: ${r.ok?"pong":"ERR"}`;return r;};
const start=async()=>{const b=Number(String(budget.value||"").replace(",",".")||0);if(!isFinite(b)||b<=0){errs++;errEl.textContent=`Erreurs: ${errs}`;LOG("start: budget invalide");return;}
const body={budgetUsdc:b,mode:mode.value,mint:mint.value||"",phantomPubkey:pub.value||"",autoRefresh:auto.value==="ON"};
const r=await fetchJSON(API+"/start",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body)});
LOG(`start: ${JSON.stringify(r)}`);};
const stop=async()=>{const r=await fetchJSON(API+"/stop",{method:"POST",headers:{"content-type":"application/json"},body:"{}"});LOG(`stop: ${JSON.stringify(r.data)}`);};

const phantomAvailable=()=>!!(window.solana&&window.solana.isPhantom);
const connect=async()=>{try{if(!phantomAvailable()){LOG("Phantom non détecté");return;}const r=await window.solana.connect();pub.value=r.publicKey?String(r.publicKey):String(window.solana.publicKey||"");LOG("Phantom connecté");}catch(e){LOG("Phantom connect err: "+e);} };
const disconnect=async()=>{try{if(window.solana&&window.solana.isPhantom){await window.solana.disconnect();}pub.value="";LOG("Phantom déconnecté");}catch(e){LOG("Phantom disconnect err: "+e);} };

const setAuto=(on)=>{if(autoTimer){clearInterval(autoTimer);autoTimer=null;}if(on){autoTimer=setInterval(()=>{status();},15000);}};

$("#bPing").onclick=ping;$("#bApi").onclick=apiInfo;$("#bRefresh").onclick=status;$("#bStart").onclick=start;$("#bStop").onclick=stop;
$("#bStart2").onclick=start;$("#bStop2").onclick=stop;
$("#bConnect").onclick=connect;$("#bDisc").onclick=disconnect;
auto.onchange=()=>setAuto(auto.value==="ON");

LOG("front ready");
ping().then(()=>status()).then(()=>apiInfo());
setAuto(true);
})();
</script></body></html>

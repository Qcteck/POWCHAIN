# Remove any "location ... aquilastacking" blocks from nginx configs EXCEPT our include
retire_duplicate_locations(){
  log "4) Retire les location '${PATH_APP}' ailleurs (évite duplicate location)"
  python3 - <<'PY'
import os,re,glob,sys
PATH_APP="/aquilastacking"
KEEP="/etc/nginx/includes/aquilastacking_routes.inc"
root="/etc/nginx"
targets=[]
for p in glob.glob(root+"/**/*", recursive=True):
  if os.path.isdir(p): continue
  if not any(p.endswith(x) for x in [".conf",".inc"]) and "/sites-" not in p and "/nginx.conf" not in p:
    continue
  if os.path.realpath(p)==os.path.realpath(KEEP): 
    continue
  try:
    s=open(p,"r",encoding="utf-8",errors="ignore").read()
  except: 
    continue
  if "location" in s and "aquilastacking" in s:
    targets.append(p)

def comment_block(txt, start_idx):
  # Find block boundaries: from the 'location ... aquilastacking' line until matching braces close.
  # Works for typical nginx conf formatting.
  lines=txt.splitlines(True)
  # convert start char index -> line index
  cur=0
  li=0
  for i,L in enumerate(lines):
    if cur+len(L)>start_idx:
      li=i; break
    cur+=len(L)
  # start at li, count braces
  brace=0
  started=False
  out=[]
  i=0
  while i<len(lines):
    L=lines[i]
    if i==li:
      started=True
    if not started:
      out.append(L); i+=1; continue
    # comment this line
    if not L.lstrip().startswith("#"):
      Lc = "# AQUILA_DISABLED " + L
    else:
      Lc = L
    out.append(Lc)
    brace += L.count("{") - L.count("}")
    # If this is a single-line location without braces, stop immediately.
    if i==li and "{" not in lines[i]:
      # stop after this line only
      out.extend(lines[i+1:])
      return "".join(out)
    if started and brace<=0 and i>li:
      out.extend(lines[i+1:])
      return "".join(out)
    i+=1
  return "".join(out)

loc_re=re.compile(r'^[ \t]*location[ \t]+[^\n]*aquilastacking[^\n]*$', re.M)
for p in targets:
  try:
    txt=open(p,"r",encoding="utf-8",errors="ignore").read()
  except:
    continue
  m=loc_re.search(txt)
  if not m:
    continue
  new=txt
  # comment repeatedly until none left
  changed=False
  while True:
    m=loc_re.search(new)
    if not m: break
    new2=comment_block(new, m.start())
    if new2==new: break
    new=new2; changed=True
  if changed:
    # backup
    bk="/root/AQUILA_STACKING_ONLY_BK_"+os.environ.get("TS","")
    # (backup is handled in bash via cp -a; here we just write)
    try:
      open(p,"w",encoding="utf-8").write(new)
      print("DISABLED duplicate location in:", p)
    except Exception as e:
      print("WARN: cannot write", p, e)
PY
}

# Patch ALL server blocks that serve fireinners.online to include our include (once)
patch_vhosts_all(){
  log "5) Patch TOUS les vhosts qui servent ${DOMAIN} (inject include idempotent)"
  python3 - <<'PY'
import subprocess,re,os,sys

DOMAIN="fireinners.online"
INC="/etc/nginx/includes/aquilastacking_routes.inc"

# get full config with file markers
p=subprocess.run(["nginx","-T"],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)
out=p.stdout

# nginx -T prints "configuration file /path: ..."; collect paths that mention DOMAIN somewhere
files=set()
for line in out.splitlines():
  m=re.match(r'^# configuration file (.*?):\d+', line)
  if m:
    cur=m.group(1)
    continue
  if 'cur' in locals() and (DOMAIN in line):
    files.add(cur)

files=[f for f in files if f.startswith("/etc/nginx/") and os.path.exists(f)]

def parse_server_blocks(txt):
  # returns list of (start,end) indices for "server { ... }" blocks
  # naive but works for typical nginx configs
  blocks=[]
  i=0; n=len(txt)
  while True:
    m=re.search(r'(^|\n)\s*server\s*\{', txt[i:], re.M)
    if not m: break
    s=i+m.start()
    # find '{' position
    brace_pos=txt.find("{", s)
    if brace_pos==-1: break
    depth=0
    j=brace_pos
    while j<n:
      c=txt[j]
      if c=="{": depth+=1
      elif c=="}":
        depth-=1
        if depth==0:
          blocks.append((s, j+1))
          i=j+1
          break
      j+=1
    else:
      break
  return blocks

def ensure_include_in_block(block_text):
  # Only inject if not already in that block
  if re.search(r'^\s*include\s+'+re.escape(INC)+r'\s*;\s*$', block_text, re.M):
    return block_text, False
  # Inject near end, before last }
  insert=f"  include {INC};\n"
  # place before final closing brace line
  m=re.search(r'\n\s*\}\s*$', block_text)
  if not m:
    return block_text, False
  return block_text[:m.start()+1] + insert + block_text[m.start()+1:], True

patched=[]
for f in sorted(files):
  try:
    txt=open(f,"r",encoding="utf-8",errors="ignore").read()
  except:
    continue
  blocks=parse_server_blocks(txt)
  if not blocks: 
    continue
  new=txt
  delta=0
  changed=False
  for (s,e) in blocks:
    s2=s+delta; e2=e+delta
    blk=new[s2:e2]
    # match server_name containing DOMAIN
    if not re.search(r'^\s*server_name\s+[^;]*\b'+re.escape(DOMAIN)+r'\b', blk, re.M):
      continue
    # ensure include
    nb, did=ensure_include_in_block(blk)
    if did:
      new=new[:s2]+nb+new[e2:]
      delta += (len(nb)-len(blk))
      changed=True
  if changed:
    open(f,"w",encoding="utf-8").write(new)
    patched.append(f)

print("PATCHED_FILES:", len(patched))
for f in patched:
  print(" -", f)
PY
}

nginx_reload_and_test(){
  log "6) nginx -t && reload"
  nginx -t
  systemctl reload nginx

  log "7) HTTP CHECK (bypass Cloudflare via --resolve -> 127.0.0.1)"
  set +e
  curl -k -sS -I --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}${PATH_APP}/" | sed -n '1,12p'
  echo
  log "8) PUBLIC CHECK (Cloudflare / Internet)"
  curl -k -sS -I "https://${DOMAIN}${PATH_APP}/" | sed -n '1,12p'
  set -e
  log "OPEN: https://${DOMAIN}${PATH_APP}/ (Ctrl+F5)"
}

main(){
  [ "$(id -u)" -eq 0 ] || die "run as root"

  ensure_packages

  # unfreeze key nginx files (common immutable setup)
  unfreeze_one "$NGINX_MAIN"
  # unfreeze all potential vhosts/includes we may touch
  for f in /etc/nginx/sites-available/* /etc/nginx/sites-enabled/* /etc/nginx/includes/*; do
    [ -e "$f" ] && unfreeze_one "$f" || true
  done
  unfreeze_one "$INC"

  ensure_webroot
  write_include_clean

  # Disable any other duplicate location blocks for aquilastacking
  retire_duplicate_locations

  # Ensure every server_name fireinners.online has exactly one include of our routes
  patch_vhosts_all

  # Final: ensure include itself is not duplicated inside same server due to previous scripts
  # (handled by patcher per server block)

  nginx_reload_and_test

  # refreeze back the critical ones (best-effort)
  refreeze_one "$INC"
  # You may have your own policy; we refreeze only what we unfreeze most commonly
  refreeze_one "$NGINX_MAIN"
  for f in /etc/nginx/sites-available/* /etc/nginx/includes/*; do
    [ -e "$f" ] && refreeze_one "$f" || true
  done

  log "DONE. Backup: $BK"
}

main "$@"
SH


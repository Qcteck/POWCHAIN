cat >/root/WOLV_NGINX_PROXY_V4.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX="/etc/nginx/nginx.conf"
PORT="3000"
MARK="# WOLV_API_PROXY_V4"

[ -f "$SITE" ] || { echo "ERR: vhost introuvable: $SITE"; exit 1; }

chattr -i "$NGINX" "$SITE" 2>/dev/null || true

python3 - <<'PY'
import pathlib,re,sys
p=pathlib.Path("/etc/nginx/sites-available/fireinners.online-ssl")
s=p.read_text(encoding="utf-8",errors="ignore")

MARK="# WOLV_API_PROXY_V4"
if MARK in s:
  print("OK nginx proxy déjà présent")
  sys.exit(0)

block=f"""
    {MARK}
    location ^~ /wolverine/api/ {{
        rewrite ^/wolverine/api/(.*)$ /api/$1 break;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }}
    # END WOLV_API_PROXY_V4
"""

# --- parse server { ... } blocks (simple brace counter) ---
def find_server_blocks(text):
  out=[]
  for m in re.finditer(r'(?m)^\s*server\s*\{', text):
    i=m.start()
    j=m.end()-1  # position of '{'
    depth=0
    k=j
    while k < len(text):
      c=text[k]
      if c=='{': depth+=1
      elif c=='}':
        depth-=1
        if depth==0:
          out.append((i,k))  # inclusive end brace
          break
      k+=1
  return out

blocks=find_server_blocks(s)
if not blocks:
  # fallback: try server { at file start without newline
  m=re.search(r'\s*server\s*\{', s)
  if not m: raise SystemExit("ERR: aucun bloc server { trouvé dans le vhost")
  # try brace match from first '{'
  i=m.start(); j=s.find('{',m.start())
  depth=0; k=j
  while k<len(s):
    c=s[k]
    if c=='{': depth+=1
    elif c=='}':
      depth-=1
      if depth==0:
        blocks=[(i,k)]
        break
    k+=1
  if not blocks: raise SystemExit("ERR: fin de bloc server introuvable")

# choose best server: prefer one that has listen 443 and ssl
def score(b):
  seg=s[b[0]:b[1]+1]
  sc=0
  if re.search(r'(?m)^\s*listen\s+443\b', seg): sc+=5
  if 'ssl' in seg: sc+=2
  if re.search(r'(?m)^\s*server_name\b.*fireinners\.online', seg): sc+=2
  return sc

blocks_sorted=sorted(blocks,key=score,reverse=True)
target=blocks_sorted[0]
seg=s[target[0]:target[1]+1]

# insert before the closing brace of target server block
insert_pos=target[1]  # index of '}'
s2=s[:insert_pos] + "\n" + block + s[insert_pos:]
p.write_text(s2,encoding="utf-8")
print("OK nginx proxy V4 installé dans un bloc server")
PY

nginx -t
systemctl reload nginx

chattr +i "$NGINX" "$SITE" 2>/dev/null || true
echo "OK. Proxy actif. Test: POST /wolverine/api/confirm_deposit_v2 doit répondre JSON."

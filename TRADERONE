set -e
cd /root

echo "=== 1) Trouver tous les endroits où /wolverine/traderone/api/ est défini ==="
grep -RIn --line-number -E 'location\s+(\^~\s+)?/wolverine/traderone/api/' \
  /etc/nginx/nginx.conf /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null || true

echo
echo "=== 2) Backup vhosts ==="
for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  cp -v "$f" "$f.bak.$(date +%Y%m%d_%H%M%S)"
done

echo
echo "=== 3) Forcer UN SEUL bloc location propre (vers 3000) dans chaque vhost ==="
BLOCK='location ^~ /wolverine/traderone/api/ {
  proxy_pass http://127.0.0.1:3000/api/;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}'

for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  perl -0777 -i -pe '
    # supprime tous les blocs existants pour éviter le duplicate location
    s#location\s+\^~\s+/wolverine/traderone/api/\s*\{.*?\}\s*##sg;
    s#location\s+/wolverine/traderone/api/\s*\{.*?\}\s*##sg;
    # ré-insère 1 seul bloc propre juste après "server {"
    s#(server\s*\{)#$1\n\n'"$BLOCK"'\n#s;
  ' "$f"
done

echo
echo "=== 4) Test + reload nginx ==="
nginx -t
systemctl reload nginx

echo
echo "=== 5) Test LOCAL via nginx (doit RENVOYER running:false etc, PAS -32601) ==="
curl -sS -i -X POST -H "Host: fireinners.online" -H "content-type: application/json" \
  http://127.0.0.1/wolverine/traderone/api/status --data '{}' | head -n 60

echo
echo "=== 6) Test DIRECT backend (pour comparer) ==="
curl -sS -i -X POST http://127.0.0.1:3000/api/status -H "content-type: application/json" --data '{}' | head -n 40
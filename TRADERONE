}

write_nginx_include(){
  mkdir -p "$(dirname "$INC")"
  cat >"$INC"<<EOF
# AUTO (WV_PUSH_HTML_AND_NGX_FIX) $TS
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/vendor/ {
  alias $WEBROOT/vendor/;
  access_log off;
  expires 7d;
  add_header Cache-Control "public, max-age=604800";
  try_files \$uri =404;
}

location ^~ /wolverine/assets/ {
  alias $WEBROOT/assets/;
  access_log off;
  expires 7d;
  add_header Cache-Control "public, max-age=604800";
  try_files \$uri =404;
}

location ^~ /wolverine/ {
  alias $WEBROOT/;
  try_files \$uri \$uri/ /wolverine/index.html;
}
EOF
}

inject_include_once(){
  unfreeze "$VHOST" || true
  grep -qF "include $INC;" "$VHOST" && return 0
  awk -v inc="include $INC;" -v dom="$DOMAIN" '
    BEGIN{inS=0;depth=0;is443=0;done=0;}
    /^[[:space:]]*server[[:space:]]*\{/ {inS=1;depth=1;is443=0;}
    {
      if(inS){
        if($0 ~ /listen[[:space:]]+443/){is443=1;}
        n=gsub(/\{/,"{"); depth+=n;
        n=gsub(/\}/,"}"); depth-=n;
        if(depth==0){
          if(is443 && !done){
            print "    " inc
            done=1
          }
          inS=0
        }
      }
      print
    }
  ' "$VHOST" >"${VHOST}.tmp" && mv -f "${VHOST}.tmp" "$VHOST"
}

tests(){
  say "TEST local nginx (SNI -> 127.0.0.1) HEAD"
  curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,15p" || true
  say "TEST local nginx (SNI -> 127.0.0.1) first bytes"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | head -c 220 || true
  echo
  say "TEST Internet (through Cloudflare) HEAD"
  curl -skI "https://${DOMAIN}/wolverine/" | sed -n "1,15p" || true
}

main(){
  need_root
  [ -f "$VHOST" ] || { echo "MISSING VHOST: $VHOST"; exit 1; }

  mkdir -p "$BK"
  say "Backup -> $BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  [ -d "$WEBROOT" ] && cp -a "$WEBROOT" "$BK/webroot_wolverine" 2>/dev/null || true

  say "Unfreeze /etc/nginx (best-effort)"
  unfreeze_tree /etc/nginx || true

  say "Write HTML -> $WEBROOT/index.html"
  write_html

  say "Write nginx include -> $INC"
  write_nginx_include

  say "Ensure vhost enabled symlink"
  ln -sf "$VHOST" "/etc/nginx/sites-enabled/$(basename "$VHOST")"

  say "Inject include into SSL vhost (one time)"
  inject_include_once

  say "nginx -t"
  nginx -t

  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx

  say "Proof: nginx -T grep wolverine + conflicts"
  nginx -T 2>/dev/null | grep -nE "conflicting server name|include /etc/nginx/includes/wolverine_routes.inc|location \\^~ /wolverine/|server_name[[:space:]]+${DOMAIN}" | head -n 260 || true

  tests

  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
}
main "$@"

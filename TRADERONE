# monitor.sh
MONITOR_SH="#!/usr/bin/env bash
set -euo pipefail
DIR=\"$DIR\"
ENV=\"$ENV\"
PING_URL=\"$PING_URL\"
STATE_DIR=\"$STATE_DIR\"
STATE_FILE=\"$STATE_FILE\"
FAIL_FILE=\"$FAIL_FILE\"
HB_FILE=\"$HB_FILE\"

log(){ printf \"%s %s\\n\" \"\$(date -u +%FT%TZ)\" \"\$*\"; }

# charge env TG_TOKEN / TG_CHAT_ID
set -a
# shellcheck disable=SC1090
source \"\$ENV\"
set +a
TG=\"\${TG_TOKEN:-}\"
CID=\"\${TG_CHAT_ID:-}\"
[ -n \"\$TG\" ] || { log \"ERR no TG_TOKEN in \$ENV\"; exit 1; }
[ -n \"\$CID\" ] || { log \"ERR no TG_CHAT_ID in \$ENV\"; exit 1; }

send_tg(){
  local txt=\"\$1\"
  curl -sS --max-time 10 -X POST \"https://api.telegram.org/bot\${TG}/sendMessage\" \
    -d \"chat_id=\${CID}\" -d \"text=\${txt}\" -d \"disable_web_page_preview=true\" >/dev/null || true
}

get_prev(){ [ -f \"\$STATE_FILE\" ] && cat \"\$STATE_FILE\" || echo \"UNKNOWN\"; }
set_prev(){ printf \"%s\" \"\$1\" >\"\$STATE_FILE\"; }
get_fails(){ [ -f \"\$FAIL_FILE\" ] && cat \"\$FAIL_FILE\" || echo \"0\"; }
set_fails(){ printf \"%s\" \"\$1\" >\"\$FAIL_FILE\"; }

# ping
RESP=\"\$(curl -sS --max-time 8 \"\$PING_URL\" 2>/dev/null || true)\"
if printf \"%s\" \"\$RESP\" | grep -qi \"pong\"; then
  NOW=\"UP\"
  set_fails 0
else
  NOW=\"DOWN\"
  f=\"\$(get_fails)\"; f=\$((f+1)); set_fails \"\$f\"
fi

PREV=\"\$(get_prev)\"
FAILS=\"\$(get_fails)\"

# règle: DOWN seulement après 3 échecs consécutifs
EFFECTIVE_NOW=\"\$NOW\"
if [ \"\$NOW\" = \"DOWN\" ] && [ \"\$FAILS\" -lt 3 ]; then
  EFFECTIVE_NOW=\"\$PREV\"
fi

# transitions
if [ \"\$EFFECTIVE_NOW\" != \"\$PREV\" ]; then
  set_prev \"\$EFFECTIVE_NOW\"
  if [ \"\$EFFECTIVE_NOW\" = \"UP\" ]; then
    send_tg \"WOLVERINE: API UP (recovery) \$(date -u +%FT%TZ)\"
  elif [ \"\$EFFECTIVE_NOW\" = \"DOWN\" ]; then
    send_tg \"WOLVERINE: API DOWN (>=3 fails) \$(date -u +%FT%TZ)\"
  else
    send_tg \"WOLVERINE: STATE \${EFFECTIVE_NOW} \$(date -u +%FT%TZ)\"
  fi
fi

# heartbeat daily 14:00 UTC (une seule fois / jour)
HH=\"\$(date -u +%H)\"
MM=\"\$(date -u +%M)\"
DD=\"\$(date -u +%F)\"
LAST=\"\$( [ -f \"\$HB_FILE\" ] && cat \"\$HB_FILE\" || echo \"\" )\"
if [ \"\$HH\" = \"14\" ] && [ \"\$MM\" = \"00\" ] && [ \"\$DD\" != \"\$LAST\" ]; then
  printf \"%s\" \"\$DD\" >\"\$HB_FILE\"
  # heartbeat seulement si vrai UP (pas effective)
  if [ \"\$NOW\" = \"UP\" ]; then
    send_tg \"WOLVERINE: HEARTBEAT OK \$(date -u +%FT%TZ)\"
  else
    send_tg \"WOLVERINE: HEARTBEAT WARN (ping not OK) \$(date -u +%FT%TZ)\"
  fi
fi

exit 0
"
askorupdate_file "$DIR/monitor.sh" "$MONITOR_SH"
chmod 755 "$DIR/monitor.sh"

# wolv_status
WOLV_STATUS="#!/usr/bin/env bash
set -euo pipefail
DIR=\"$DIR\"
ENV=\"$ENV\"
PING_URL=\"$PING_URL\"
STATE_DIR=\"$STATE_DIR\"
STATE_FILE=\"$STATE_FILE\"
FAIL_FILE=\"$FAIL_FILE\"
HB_FILE=\"$HB_FILE\"

echo \"DIR=\$DIR\"
echo \"ENV=\$ENV\"
echo \"PING=\$PING_URL\"
echo \"STATE_DIR=\$STATE_DIR\"
echo \"state=\$( [ -f \$STATE_FILE ] && cat \$STATE_FILE || echo UNKNOWN )\"
echo \"fails=\$( [ -f \$FAIL_FILE ] && cat \$FAIL_FILE || echo 0 )\"
echo \"last_heartbeat_utc=\$( [ -f \$HB_FILE ] && cat \$HB_FILE || echo none )\"
echo \"timer=\$(systemctl is-enabled wolverine-tg-monitor.timer 2>/dev/null || true) / \$(systemctl is-active wolverine-tg-monitor.timer 2>/dev/null || true)\"
echo \"service=\$(systemctl is-enabled wolverine-tg-monitor.service 2>/dev/null || true) / \$(systemctl is-active wolverine-tg-monitor.service 2>/dev/null || true)\"
curl -sS --max-time 5 \"\$PING_URL\" 2>/dev/null | head -c 120; echo
"
askorupdate_file "/usr/local/bin/wolv_status" "$WOLV_STATUS"
chmod 755 /usr/local/bin/wolv_status

# systemd units
UNIT_SVC="[Unit]
Description=Wolverine TG Monitor (ping + TG alert)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$DIR/monitor.sh
User=root
Group=root

[Install]
WantedBy=multi-user.target
"
UNIT_TMR="[Unit]
Description=Wolverine TG Monitor timer (every 1 min)

[Timer]
OnBootSec=60s
OnUnitActiveSec=60s
AccuracySec=10s
RandomizedDelaySec=15s
Unit=$SERVICE.service

[Install]
WantedBy=timers.target
"

# écriture avec backups simples
tmp1="$(mktemp)"; tmp2="$(mktemp)"
printf "%s" "$UNIT_SVC" >"$tmp1"
printf "%s" "$UNIT_TMR" >"$tmp2"
install -m 0644 "$tmp1" "/etc/systemd/system/$SERVICE.service"
install -m 0644 "$tmp2" "/etc/systemd/system/$TIMER"
rm -f "$tmp1" "$tmp2"

systemctl daemon-reload
systemctl enable --now "$TIMER"

say "OK: installé."
say "Test instant:"
bash "$DIR/monitor.sh" || true
say "Status:"
systemctl status "$TIMER" --no-pager -n 8 || true
say "Commande utile: wolv_status"
SH
bash /tmp/WOLVERINE_TG_MONITOR_MEGA.sh
@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem === 0) Force working dir to THIS bat location
cd /d "%~dp0" || (echo [ERREUR] Dossier introuvable & pause & exit /b 1)

rem === 1) Ensure out folder
if not exist "out_stl" mkdir "out_stl" >nul 2>&1

rem === 2) Ensure SCAD filename (Windows might hide extension)
if exist "robo600_parts" if not exist "robo600_parts.scad" (
  ren "robo600_parts" "robo600_parts.scad"
)

set "SCAD=%cd%\robo600_parts.scad"
if not exist "%SCAD%" (
  echo [ERREUR] SCAD introuvable dans: "%cd%"
  echo Attendu: robo600_parts.scad
  echo Contenu du dossier:
  dir /b
  pause
  exit /b 1
)

rem === 3) Find OpenSCAD console binary
set "OPENSCAD=C:\Program Files\OpenSCAD\openscad.com"
if not exist "%OPENSCAD%" set "OPENSCAD=C:\Program Files\OpenSCAD (Nightly)\openscad.com"
if not exist "%OPENSCAD%" set "OPENSCAD=C:\Program Files (x86)\OpenSCAD\openscad.com"

if not exist "%OPENSCAD%" (
  echo [ERREUR] openscad.com introuvable.
  echo Installe OpenSCAD ou ajuste le chemin dans ce .bat
  pause
  exit /b 1
)

echo OpenSCAD: "%OPENSCAD%"
echo SCAD:     "%SCAD%"
echo OUT:      "%cd%\out_stl"
echo.

rem === 4) TEST export (1 piece) with full log
del /q "out_stl\_log_test.txt" 2>nul
del /q "out_stl\_test.stl" 2>nul

echo [TEST] Export pelvis_half1 -> out_stl\_test.stl
"%OPENSCAD%" -o "%cd%\out_stl\_test.stl" -D "PART=\"pelvis_half1\"" "%SCAD%" 1>"out_stl\_log_test.txt" 2>&1

if not exist "out_stl\_test.stl" (
  echo.
  echo [ERREUR] Test STL non cree. Ouvre le log:
  type "out_stl\_log_test.txt"
  echo.
  echo Le log est aussi ici: "%cd%\out_stl\_log_test.txt"
  pause
  exit /b 1
)

echo [OK] Test STL cree.
echo.

rem === 5) Export ALL parts (with log)
del /q "out_stl\export_all_log.txt" 2>nul

set PARTS=pelvis_half1 pelvis_half2 torso_half1 torso_half2 head_half1 head_half2 back_hatch neck_ring face_plate jaw shoulder_joint elbow_joint hip_joint knee_joint upperarm_half1 upperarm_half2 forearm_half1 forearm_half2 hand thigh_half1 thigh_half2 shin_half1 shin_half2 foot dc_mount_small dc_mount_big driver_tray pca_esp_tray lcd_bezel solar_bracket_left solar_bracket_right cable_clip

for %%P in (%PARTS%) do (
  echo ==== %%P ====>>"out_stl\export_all_log.txt"
  echo [%%P]
  del /q "out_stl\%%P.stl" 2>nul
  "%OPENSCAD%" -o "%cd%\out_stl\%%P.stl" -D "PART=\"%%P\"" "%SCAD%" 1>>"out_stl\export_all_log.txt" 2>&1
  if not exist "out_stl\%%P.stl" (
    echo [ERREUR] STL non cree: %%P
    echo Voir log: out_stl\export_all_log.txt
    pause
    exit /b 1
  )
)

echo.
echo OK: STL generes dans "%cd%\out_stl"
echo Nombre:
dir /b "out_stl\*.stl" | find /c ".stl"
echo.
echo Logs:
echo - out_stl\_log_test.txt
echo - out_stl\export_all_log.txt
pause
endlocal
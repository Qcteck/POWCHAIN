bash -c "$(cat <<'BASH'
set -euo pipefail
HTML="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)

echo "=== ADD USDC BALANCE (SAFE PATCH) ==="
cp "$HTML" "$HTML.usdc_patch_$TS"

# Assure la constante USDC (si absente)
grep -q 'USDC="EPjFWdd5' "$HTML" || \
sed -i 's|const RPC=.*;|&\nconst USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";|' "$HTML"

# Ajoute le calcul USDC juste après le SOL
sed -i 's|s.textContent=(lamports/1e9).toFixed(6);|&\n\n// USDC\nconst accs=await conn.getParsedTokenAccountsByOwner(pub,{mint:new solanaWeb3.PublicKey(USDC)});\nlet tot=0;(accs.value||[]).forEach(x=>{tot+=Number(x.account.data.parsed.info.tokenAmount.uiAmount||0)});\nu.textContent=tot.toFixed(2);|' "$HTML"

echo "=== DONE ==="
echo "➡️ Hard refresh navigateur (CTRL+SHIFT+R)"
BASH
)"
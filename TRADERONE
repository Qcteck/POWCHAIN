cat >/root/patch_wolverine_phantom_trade.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/_wolverine_next_src"
TARGET=""

cd "$APP_DIR"

# Find trade page
if [[ -f pages/trade.tsx ]]; then TARGET="pages/trade.tsx"; fi
if [[ -z "$TARGET" && -f pages/trade/index.tsx ]]; then TARGET="pages/trade/index.tsx"; fi

if [[ -z "$TARGET" ]]; then
  echo "[ERR] Impossible de trouver pages/trade.tsx ou pages/trade/index.tsx"
  exit 1
fi

echo "[OK] Target = $TARGET"

# Backup
cp -a "$TARGET" "/root/backup_$(date +%Y%m%d_%H%M%S)_$(basename "$TARGET")"

# Inject Phantom UI
cat > "$TARGET" <<'EOF'
import dynamic from "next/dynamic";
const WalletPhantom = dynamic(() => import("../components/WalletPhantom"), { ssr: false });

export default function TradePage() {
  return (
    <div>
      <WalletPhantom />
    </div>
  );
}
EOF

# Build + export + publish
npm run build
rsync -a --delete out/ /var/www/wolverine/
nginx -t && systemctl reload nginx

echo "✅ Phantom injecté dans /trade"
echo "👉 Test: https://fireinners.online/wolverine/trade/"
BASH

chmod +x /root/patch_wolverine_phantom_trade.sh
/root/patch_wolverine_phantom_trade.sh
cat >/root/test_rpc_after_cf_rule.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
URL="https://fireinners.online/wolverine/rpc"
PAY='{"jsonrpc":"2.0","id":1,"method":"getVersion"}'

echo "== Browser-like POST =="
curl -sk -D- "$URL" \
  -H 'content-type: application/json' \
  -H 'Origin: https://fireinners.online' \
  -H 'Referer: https://fireinners.online/wolverine/' \
  --data "$PAY" | head -n 60
BASH

chmod +x /root/test_rpc_after_cf_rule.sh
/root/test_rpc_after_cf_rule.sh
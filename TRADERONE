set -euo pipefail

echo "MEGA FIX va:"
echo "1) supprimer toute dépendance base64 logo (plus de base64 invalid input)"
echo "2) écrire index.html + pages modules (dex/wallet/bridge/explorer/mining/options) + wolverine"
echo "3) patcher nginx: proxy /stats -> http://127.0.0.1:3000/stats (vrai online)"
echo "4) nginx -t puis reload, puis re-verif curl"
echo

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/opt/fireinners/frontend-react/app/dist"

if test -f "$VHOST"; then
  R=$(awk 'BEGIN{r=""} /^[ \t]*root[ \t]+/{gsub(/;$/,"",$2); if(r==""){r=$2}} END{print r}' "$VHOST" 2>/dev/null || true)
  test -n "${R:-}" && ROOT="$R"
fi

test -f "$VHOST" || { echo "ERR: vhost introuvable: $VHOST"; exit 1; }
test -d "$ROOT" || { echo "ERR: root introuvable: $ROOT"; exit 1; }

ts(){ date +"%Y%m%d-%H%M%S"; }
bk(){ test -f "$1" && cp -a "$1" "$1.bak.$(ts)" && echo "backup: $1.bak.$(ts)"; }
immut_off(){ command -v chattr >/dev/null && test -f "$1" && chattr -i "$1" 2>/dev/null || true; }
immut_on(){ command -v chattr >/dev/null && test -f "$1" && chattr +i "$1" 2>/dev/null || true; }

echo "ROOT=$ROOT"
echo "VHOST=$VHOST"

# unlock configs safely
immut_off /etc/nginx/nginx.conf || true
immut_off "$VHOST" || true

mkdir -p "$ROOT/wolverine" "$ROOT/wolverin" "$ROOT/traderone" \
  "$ROOT/wallet" "$ROOT/dex" "$ROOT/bridge" "$ROOT/explorer" "$ROOT/mining" "$ROOT/options" 2>/dev/null || true


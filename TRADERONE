cat >/tmp/wolfchain_fly_ui.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/opt/fireinners/frontend-react/app/dist"
if [[ -f "$VHOST" ]]; then
  R="$(awk 'BEGIN{r=""} /^\s*root\s+/{gsub(/;$/,"",$2); if(r=="") r=$2} END{print r}' "$VHOST" || true)"
  [[ -n "${R:-}" ]] && ROOT="$R"
fi
echo "ROOT=$ROOT"
echo "---- wolverine dir ----"
ls -la "$ROOT/wolverine" 2>/dev/null || true
echo "---- home index ----"
ls -la "$ROOT/index.html" 2>/dev/null || true
echo "---- curl tests ----"
curl -sS -i https://127.0.0.1/ -H 'Host: fireinners.online' | head -n 8 || true
curl -sS -i https://127.0.0.1/wolverine/ -H 'Host: fireinners.online' | head -n 8 || true
SH
bash /tmp/wolfchain_fly_ui.sh
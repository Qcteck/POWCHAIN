cat >/root/FIX_WOLVERINE_API_PRIORITY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/wolverine_api_priority.inc"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"

echo "== UNFREEZE =="
chattr -i "$VHOST" 2>/dev/null || true
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i /etc/nginx/includes/*.inc 2>/dev/null || true

echo "== WRITE PRIORITY API LOCATION =="
cat >"$INC" <<'NGINX'
# PRIORITY API ROUTING (MUST COME BEFORE /wolverine/ alias)
location ^~ /wolverine/traderone/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_pass_request_body on;
    proxy_set_header Content-Length $content_length;

    add_header Cache-Control "no-store" always;
}
NGINX
chmod 644 "$INC"

echo "== ENSURE include is FIRST inside server {} =="
# remove any previous inclusion
sed -i '\|wolverine_api_priority\.inc|d' "$VHOST"
# inject right after server {
sed -i '/server\s*{/a\    include /etc/nginx/includes/wolverine_api_priority.inc;' "$VHOST"

echo "== TEST + RELOAD =="
nginx -t
systemctl reload nginx

echo "== REFREEZE =="
chattr +i "$VHOST" 2>/dev/null || true
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true

echo "== DONE: API PRIORITY FIXED =="
BASH

chmod +x /root/FIX_WOLVERINE_API_PRIORITY.sh
bash /root/FIX_WOLVERINE_API_PRIORITY.sh |& tee /root/FIX_WOLVERINE_API_PRIORITY.log
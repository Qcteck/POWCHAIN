cat >/root/fix_traderone_api_proxy_conf_outside_location.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

F="/etc/nginx/snippets/traderone_api_proxy.conf"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$F" || { echo "Missing $F"; exit 1; }

echo "== BEFORE =="
nl -ba "$F" | head -n 120

cp -a "$F" "$F.bak_$TS"

# 1) health: absolute -> relative
sed -i -E 's@location[[:space:]]*=[[:space:]]*/wolverine/traderone/api_DISABLED/health[[:space:]]*\{@location = /health {@g' "$F"

# 2) main block: absolute -> relative (so it fits inside the parent location)
sed -i -E 's@location[[:space:]]+\^~[[:space:]]+/wolverine/traderone/api/[[:space:]]*\{@location ^~ / {@g' "$F"

# 3) rewrite: remove the /wolverine/traderone/api/ prefix since we're now relative
sed -i -E 's@rewrite[[:space:]]+\^/wolverine/traderone/api/\(\.\*\)\$@rewrite ^/\(\.\*\)\$@g' "$F"

echo
echo "== AFTER =="
nl -ba "$F" | head -n 120

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/fix_traderone_api_proxy_conf_outside_location.sh
/root/fix_traderone_api_proxy_conf_outside_location.sh
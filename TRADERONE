cat >/root/trace_traderone_404.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

INC="/etc/nginx/includes/wolverine_routes.inc"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== 1) Local direct (backend) =="
for p in /health /me /orders /positions /pnl; do
  code=$(curl -sS -o /dev/null -w "%{http_code}" "http://127.0.0.1:8585$p" || true)
  echo "http://127.0.0.1:8585$p => $code"
done
echo

echo "== 2) Ensure debug headers + access_log in the traderone location =="
cp -a "$INC" "$INC.bak_trace_$TS"

# inject debug lines inside the location ^~ /wolverine/traderone/api/ block
python3 - <<'PY'
import re
INC="/etc/nginx/includes/wolverine_routes.inc"
lines=open(INC,"r",errors="ignore").read().splitlines(True)
out=[]
in_loc=False
for l in lines:
    out.append(l)
    if re.search(r'^\s*location\s+\^~\s+/wolverine/traderone/api/\s*\{', l):
        in_loc=True
        continue
    if in_loc and re.search(r'^\s*proxy_set_header\s+X-Forwarded-Proto', l):
        out.append('  add_header X-Wolverine-Route "traderone" always;\n')
        out.append('  add_header X-Wolverine-Upstream "$upstream_addr" always;\n')
        out.append('  access_log /var/log/nginx/traderone_access.log combined;\n')
        in_loc=False
open(INC,"w").writelines(out)
PY

nginx -t
systemctl reload nginx || service nginx reload
echo

echo "== 3) Public tests with headers =="
for p in /wolverine/traderone/api/health /wolverine/traderone/api/me /wolverine/traderone/api/orders; do
  echo "--- $p ---"
  curl -sk -D- -o /dev/null "https://fireinners.online$p" | sed -n '1,25p'
done
echo

echo "== 4) Tail traderone access log (last 20 lines) =="
tail -n 20 /var/log/nginx/traderone_access.log || true
echo "DONE ✅"
BASH

chmod +x /root/trace_traderone_404.sh
/root/trace_traderone_404.sh
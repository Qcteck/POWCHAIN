cat >/root/fix_duplicate_srpc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
SOL="/etc/nginx/snippets/solana_rpc_proxy.conf"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== 0) Show where /srpc is defined =="
echo "--- in vhost:"
grep -nE "location\s*=+\s*/srpc|location\s+\^~\s*/srpc" "$EN" || true
echo "--- in solana snippet:"
grep -nE "location\s*=+\s*/srpc|location\s+\^~\s*/srpc" "$SOL" || true

echo
echo "== 1) Backup solana snippet =="
cp -a "$SOL" "${SOL}.bak_${ts}"

echo "== 2) Remove /srpc location block from solana snippet (avoid duplicates) =="
# delete a "location = /srpc { ... }" block if present
perl -0777 -i -pe 's@\n\s*location\s*=\s*/srpc\s*\{.*?\}\s*\n@\n@sg' "$SOL"
# delete a "location ^~ /srpc { ... }" block if present
perl -0777 -i -pe 's@\n\s*location\s*\^~\s*/srpc\s*\{.*?\}\s*\n@\n@sg' "$SOL"

echo
echo "== 3) Ensure vhost has ONE /srpc (return 404) =="
if ! grep -qE "location\s*=\s*/srpc" "$AV"; then
  sed -i '/server_name .*fireinners\.online/ a\  location = /srpc { return 404; }' "$AV"
fi
ln -sf "$AV" "$EN"

echo
echo "== 4) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== 5) Quick check =="
echo "--- /srpc (POST should be 404 now, not 403/duplicate):"
curl -sk -i -X POST "https://fireinners.online/srpc" -H 'Content-Type: application/json' --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,20p'
BASH

chmod +x /root/fix_duplicate_srpc.sh
/root/fix_duplicate_srpc.sh
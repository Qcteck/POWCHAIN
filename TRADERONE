sudo -i
set -e

# 1) snippet (sans heredoc compliqué)
mkdir -p /etc/nginx/snippets
printf '%s\n' \
'resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;' \
'' \
'location = /wolverine/traderone/api/rpc {' \
'  add_header X-Wolv-RPC "1" always;' \
'  proxy_pass https://api.mainnet-beta.solana.com;' \
'  proxy_http_version 1.1;' \
'  proxy_ssl_server_name on;' \
'  proxy_set_header Host api.mainnet-beta.solana.com;' \
'  proxy_set_header X-Real-IP $remote_addr;' \
'  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'}' \
> /etc/nginx/snippets/wolv_rpc_proxy.conf

# 2) inject include dans tous les fichiers nginx qui mentionnent fireinners.online + 443
TS=$(date +%s)
for f in $(grep -RIl "fireinners\.online" /etc/nginx | grep -E '\.conf$' || true); do
  if grep -Eq "listen\s+.*443" "$f"; then
    cp -a "$f" "$f.bak.$TS" || true
    if ! grep -qF "include /etc/nginx/snippets/wolv_rpc_proxy.conf;" "$f"; then
      sed -i '/server_name .*fireinners\.online.*/a\  include /etc/nginx/snippets/wolv_rpc_proxy.conf;' "$f" || true
    fi
  fi
done

nginx -t
systemctl reload nginx


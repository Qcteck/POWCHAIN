"use strict";
const http = require("http");
const fs = require("fs");
const path = require("path");
const nacl = require("tweetnacl");
const bs58 = require("bs58").default || require("bs58");

const PORT = parseInt(process.env.PORT || "3010", 10);
const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, "data");
const DB_PATH = process.env.DB_PATH || path.join(DATA_DIR, "vaults.json");

function ensureDir(p){ try{ fs.mkdirSync(p,{recursive:true}); }catch(_){} }
ensureDir(DATA_DIR);

function loadDB(){ try{ return JSON.parse(fs.readFileSync(DB_PATH,"utf8")); }catch(_){ return {}; } }
function saveDB(db){
  const tmp = DB_PATH + ".tmp";
  fs.writeFileSync(tmp, JSON.stringify(db,null,2));
  fs.renameSync(tmp, DB_PATH);
}
function json(res, code, obj){
  res.writeHead(code, {"content-type":"application/json","cache-control":"no-store"});
  res.end(JSON.stringify(obj));
}
async function readBody(req){
  return await new Promise((resolve,reject)=>{
    let d=""; req.on("data", c=>d+=c);
    req.on("end", ()=>resolve(d));
    req.on("error", reject);
  });
}

const server = http.createServer(async (req,res)=>{
  try{
    if (req.method==="GET" && req.url==="/health") return json(res,200,{status:"ok",service:"wolverine-vault-api"});
    if (req.method==="POST" && req.url==="/vault/create"){
      const raw = await readBody(req);
      let body={}; try{ body=JSON.parse(raw||"{}"); }catch(_){}
      const userPubkey = (body.userPubkey||"").trim();
      if(!userPubkey) return json(res,400,{error:"missing userPubkey"});
      const db = loadDB();
      if (db[userPubkey] && db[userPubkey].vaultPubkey){
        return json(res,200,{status:"ok",userPubkey,vaultPubkey:db[userPubkey].vaultPubkey,existing:true});
      }
      const kp = nacl.sign.keyPair();
      const vaultPubkey = bs58.encode(Buffer.from(kp.publicKey));
      const secret = bs58.encode(Buffer.from(kp.secretKey));
      db[userPubkey] = { vaultPubkey, secret, createdAt: new Date().toISOString() };
      saveDB(db);
      return json(res,200,{status:"ok",userPubkey,vaultPubkey,existing:false});
    }
    return json(res,404,{error:"not_found"});
  }catch(e){
    return json(res,500,{error:String(e && e.message ? e.message : e)});
  }
});
server.listen(PORT,"127.0.0.1",()=>console.log(`vault-api 127.0.0.1:${PORT}`));

set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.fix_health_public_no_nested.$(date +%s)"

python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# 1) Supprimer toute trace de auth_request + /_wolv_auth
s = re.sub(r'^\s*auth_request\s+[^;]+;\s*\n', '', s, flags=re.M)
s = re.sub(r'\n\s*location\s*=\s*/_wolv_auth\s*\{[\s\S]*?\n\s*\}\s*', '\n', s, flags=re.M)

# 2) Supprimer les anciens locations API/health (pour repartir clean)
for pat in [
  r'\n\s*location\s*=\s*/wolverine/traderone/api/health\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/traderone/api/\s*\{[\s\S]*?\n\s*\}\s*',
]:
  s = re.sub(pat, "\n", s, flags=re.M)

# 3) Ré-injecter les 2 locations propres (health public + api protégé)
block = r'''
# --- WOLVERINE API (health public, rest protected) ---

# PUBLIC: /health
location = /wolverine/traderone/api/health {
  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;

  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}

# PROTECTED: everything else under /wolverine/traderone/api/
location ^~ /wolverine/traderone/api/ {
  if ($http_x_api_key = "") { return 403; }

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;

  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
'''

# Insert avant la dernière "}" (fin du server block)
idx = s.rfind("}")
if idx == -1:
  raise SystemExit("KO: pas de '}' trouvé dans le conf nginx")
s = s[:idx] + "\n" + block + "\n" + s[idx:]

ng.write_text(s)
print("OK: cleaned auth_request/_wolv_auth + inserted final health/api locations")
PY

nginx -t
systemctl reload nginx


#!/usr/bin/env bash
set -e

FILE="/opt/wolverine/index.html"
BACKUP="/opt/wolverine/index.html.bak.$(date +%s)"

echo "[1/4] Vérification fichier"
[ -f "$FILE" ] || { echo "❌ index.html introuvable"; exit 1; }

echo "[2/4] Backup -> $BACKUP"
cp "$FILE" "$BACKUP"

echo "[3/4] Suppression SHARE (HTML + JS)"
sed -i \
  -e '/SHARE/d' \
  -e '/share/d' \
  -e '/twitter/d' \
  -e '/telegram/d' \
  -e '/facebook/d' \
  -e '/navigator\.share/d' \
  "$FILE"

echo "[4/4] Reload nginx"
nginx -t && systemctl reload nginx

echo "✅ SHARE supprimé définitivement"
echo "🎨 THEME conservé comme seul bouton actif"
cat >/root/fix_duplicate_wolverine_rpc_location.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
INC="/etc/nginx/includes/wolverine_routes.inc"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$INC" || { echo "❌ Missing $INC"; exit 1; }
cp -a "$INC" "${INC}.bak_${TS}"

python3 - <<'PY'
import re, pathlib

p = pathlib.Path("/etc/nginx/includes/wolverine_routes.inc")
s = p.read_text(errors="ignore")

# 1) remove any marker-based blocks we injected before
s = re.sub(r"\n?#\s*WOLVERINE_RPC_PROXY_BEGIN.*?#\s*WOLVERINE_RPC_PROXY_END\s*\n?", "\n", s, flags=re.S)
s = re.sub(r"\n?#\s*WOLVERINE_RPC_PROXY.*?(?=\n#|\Z)", "\n", s, flags=re.S)

# 2) remove ANY existing nginx location blocks for /wolverine/rpc (duplicate killer)
#    (best-effort regex: location = /wolverine/rpc { ... })
s = re.sub(r"\n\s*location\s*=\s*/wolverine/rpc\s*\{.*?\n\s*\}\s*\n", "\n", s, flags=re.S)

# 3) append one canonical block
block = r'''
# WOLVERINE_RPC_PROXY_BEGIN
# Solana JSON-RPC proxy (same-origin)
location = /wolverine/rpc {
  # only allow POST for JSON-RPC
  limit_except POST { deny all; }

  proxy_http_version 1.1;
  proxy_ssl_server_name on;

  proxy_set_header Host api.mainnet-beta.solana.com;
  proxy_set_header User-Agent "Mozilla/5.0";
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  proxy_pass https://api.mainnet-beta.solana.com/;
}
# WOLVERINE_RPC_PROXY_END
'''
s = s.rstrip() + "\n\n" + block + "\n"
p.write_text(s)
print("OK: deduped /wolverine/rpc and installed single canonical block")
PY

echo "== nginx -t =="
nginx -t
systemctl reload nginx || service nginx reload

echo
echo "== ORIGIN RPC test (bypass CF) =="
curl -sk --resolve fireinners.online:443:127.0.0.1 \
  -X POST https://fireinners.online/wolverine/rpc \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -c 250
echo
echo "DONE ✅"
BASH

chmod +x /root/fix_duplicate_wolverine_rpc_location.sh
/root/fix_duplicate_wolverine_rpc_location.sh
</style>
</head>
<body>
<header>
  <h1>🦅 Wolverine — Unified (Front unique / Backend unifié)</h1>
  <div class="pill" id="apiBadge">API: …</div>
</header>

<div class="grid">
  <div class="card">
    <h2>Quick actions</h2>
    <div class="row">
      <a class="btn" href="/wolverine/traderone/" target="_blank">TraderOne UI</a>
      <a class="btn" href="/wolverine/api/status" target="_blank">API status (unifié)</a>
      <a class="btn" href="/wolverine/api/health" target="_blank">API health (unifié)</a>
      <a class="btn" href="/wolverine/traderone/api/status" target="_blank">API status (native)</a>
    </div>
    <div style="height:10px"></div>
    <div class="row">
      <button id="btnHealth">GET /api/health</button>
      <button id="btnStatus">GET /api/status</button>
      <button id="btnStart">POST /api/start</button>
      <button id="btnStop">POST /api/stop</button>
    </div>
    <div style="height:10px"></div>

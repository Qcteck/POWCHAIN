cat >/tmp/WOLVERINE_NGINX_FORCE_PROXY_TRADERONE_API.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
TS="$(date +%s)"

echo "== 1) Detect nginx conf file that contains server_name $DOMAIN =="
CONF="$(nginx -T 2>/dev/null | awk '
  BEGIN{file=""}
  /^# configuration file / {file=$4; sub(":$","",file)}
  $0 ~ "server_name " && $0 ~ "'"$DOMAIN"'" {print file; exit}
')"

[ -n "${CONF:-}" ] || { echo "ERROR: cannot detect conf for $DOMAIN"; exit 1; }
echo "CONF=$CONF"
[ -f "$CONF" ] || { echo "ERROR: conf not found: $CONF"; exit 1; }

echo "== 2) Backup =="
cp -a "$CONF" "$CONF.bak.$TS"

echo "== 3) Ensure API proxy location exists (and wins) =="
# Insert the proxy location inside the correct server{} (server_name DOMAIN)
awk -v domain="$DOMAIN" '
BEGIN{in_server=0; has_domain=0; done=0}
{
  line=$0

  if ($0 ~ /^[[:space:]]*server[[:space:]]*\{/){ in_server=1; has_domain=0 }

  if (in_server && $0 ~ /server_name/ && $0 ~ domain){ has_domain=1 }

  # before closing brace of the target server{}, inject if not already present
  if (in_server && has_domain && $0 ~ /^[[:space:]]*\}[[:space:]]*$/ && done==0){
    print ""
    print "  # WOLVERINE_TRADERONE_API_BEGIN"
    print "  location ^~ /wolverine/traderone/api/ {"
    print "    proxy_http_version 1.1;"
    print "    proxy_set_header Host $host;"
    print "    proxy_set_header X-Real-IP $remote_addr;"
    print "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
    print "    proxy_set_header X-Forwarded-Proto $scheme;"
    print "    proxy_pass http://127.0.0.1:8585/api/;"
    print "  }"
    print "  # WOLVERINE_TRADERONE_API_END"
    print ""
    done=1
  }

  print line

  if (in_server && $0 ~ /^[[:space:]]*\}[[:space:]]*$/){ in_server=0 }
}
' "$CONF.bak.$TS" > "$CONF"

echo "== 4) If you have regex location ~ ^/wolverine/ , convert to ^~ (recommended) =="
# This avoids regex taking priority over prefixes
sed -i 's/location[[:space:]]\+~[[:space:]]\+\^\/wolverine\/[[:space:]]\+{/location ^~ \/wolverine\/ {/g' "$CONF" || true

echo "== 5) nginx test + reload =="
nginx -t
systemctl reload nginx

echo
echo "== 6) TEST (should be JSON, not HTML) =="
read -r -p "PHANTOM WALLET = " WALLET
WALLET="$(echo -n "$WALLET" | tr -d '[:space:]')"

echo "-- local backend (must be JSON):"
curl -sS "http://127.0.0.1:8585/api/balances2?wallet=$WALLET" | head -c 180; echo
echo

echo "-- via domain (must start with { ):"
curl -ksSI "https://${DOMAIN}/wolverine/traderone/api/balances2?wallet=$WALLET" | sed -n '1,25p'
echo
curl -ksS "https://${DOMAIN}/wolverine/traderone/api/balances2?wallet=$WALLET" | head -c 180; echo
echo

echo "DONE ✅"
SH

bash /tmp/WOLVERINE_NGINX_FORCE_PROXY_TRADERONE_API.sh
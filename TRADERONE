cat >/root/MEGA_TRADERONE_FINALIZE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

### CONFIG FIXE (selon nos repères)
REPO="/opt/wolverine"
WEBROOT="/var/www/wolverine"                         # interface actuelle à ne PAS toucher
API_DIR="/opt/wolverine/traderone_api"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
ASK_LIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
API_PORT="3000"
API_BIND="127.0.0.1"
API_BASE="/wolverine/traderone/api"                  # préfixe attendu côté UI/nginx
SERVICE_NAME="wolverine-traderone-api"

log(){ printf "\n[%s] %s\n" "$(date +'%F %T')" "$*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "Lance en root."
command -v bash >/dev/null || die "bash manquant."

### askorupdate (fallback si absent)
askorupdate_file(){ # path content
  local p="$1"; shift
  local c="$1"; shift
  mkdir -p "$(dirname "$p")"
  if [ -f "$p" ]; then cp -a "$p" "$p.bak.$(date +%s)"; fi
  printf "%s" "$c" >"$p"
}
askorupdate_yesno(){ # prompt default(0/1)
  local prompt="$1"; shift
  local def="${1:-0}"; shift || true
  local yn
  read -r -p "$prompt [y/N] " yn || true
  case "${yn,,}" in y|yes) return 0;; *) return 1;; esac
}

if [ -f "$ASK_LIB" ]; then
  # shellcheck disable=SC1090
  source "$ASK_LIB" || true
fi

log "Preflight: paquets de base"
export DEBIAN_FRONTEND=noninteractive
apt-get update -y >/dev/null
apt-get install -y ca-certificates curl git >/dev/null

log "Preflight: Node.js (règle: pas de apt npm/nodejs)."
need_node=0
if ! command -v node >/dev/null 2>&1; then need_node=1; fi
if [ "$need_node" -eq 0 ]; then
  major="$(node -v | sed 's/^v//' | cut -d. -f1 || echo 0)"
  if [ "${major:-0}" -lt 20 ]; then need_node=1; fi
fi
if [ "$need_node" -eq 1 ]; then
  log "Installation NodeSource Node 20.x"
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash - >/dev/null
  apt-get install -y nodejs >/dev/null
fi
command -v node >/dev/null || die "Node non installé."
command -v npm >/dev/null || die "npm non installé."
log "Node: $(node -v) | npm: $(npm -v)"

log "Installer PM2 (si absent)"
if ! command -v pm2 >/dev/null 2>&1; then
  npm i -g pm2 >/dev/null
fi

log "Créer backend TraderOne API (sans toucher au front)"
mkdir -p "$API_DIR"
cd "$API_DIR"

PKG='{
  "name":"traderone-api",
  "version":"1.0.0",
  "private":true,
  "type":"module",
  "main":"server.js",
  "scripts":{"start":"node server.js"},
  "dependencies":{"express":"^4.19.2"}
}'
askorupdate_file "$API_DIR/package.json" "$PKG"

SERVER_JS=$(cat <<'JS'
import express from "express";

const app = express();
app.disable("x-powered-by");
app.use(express.json({limit:"256kb"}));

const BIND = process.env.BIND || "127.0.0.1";
const PORT = parseInt(process.env.PORT || "3000", 10);
const API_BASE = (process.env.API_BASE || "/wolverine/traderone/api").replace(/\/+$/,"");

function now(){ return new Date().toISOString(); }
function ok(res, obj){ res.json({ok:true, ts:now(), ...obj}); }
function bad(res, msg, code=400){ res.status(code).json({ok:false, ts:now(), error:String(msg||"bad_request")}); }

app.get(`${API_BASE}/health`, (req,res)=> ok(res, {service:"traderone-api", bind:BIND, port:PORT, base:API_BASE}));
app.get(`${API_BASE}/version`, (req,res)=> ok(res, {version:"1.0.0"}));

/*
  Endpoints "plomberie" pour que le front concorde:
  - POST start: {pub,budget_usdc,strategy,risk_pct}
  - POST mode: {pub,mode}
  - POST withdraw: {pub,mint,amount,to}
  - GET invested?pub=...
  NB: Ici c'est volontairement "safe": ça répond et loggue; l'exécution trading réelle viendra ensuite.
*/

app.post(`${API_BASE}/start`, (req,res)=>{
  const {pub,budget_usdc,strategy,risk_pct} = req.body || {};
  if(!pub) return bad(res,"pub_required");
  const budget = Number(budget_usdc||0);
  if(!Number.isFinite(budget) || budget<=0) return bad(res,"budget_usdc_invalid");
  const risk = Number(risk_pct||0);
  if(!Number.isFinite(risk) || risk<0 || risk>100) return bad(res,"risk_pct_invalid");
  const job_id = `job_${Date.now()}_${Math.random().toString(16).slice(2)}`;
  ok(res, {accepted:true, job_id, pub, budget_usdc:budget, strategy:String(strategy||"default"), risk_pct:risk});
});

app.post(`${API_BASE}/mode`, (req,res)=>{
  const {pub,mode} = req.body || {};
  if(!pub) return bad(res,"pub_required");
  ok(res, {accepted:true, pub, mode:String(mode||"observe")});
});

app.post(`${API_BASE}/withdraw`, (req,res)=>{
  const {pub,mint,amount,to} = req.body || {};
  if(!pub) return bad(res,"pub_required");
  const amt = Number(amount||0);
  if(!Number.isFinite(amt) || amt<=0) return bad(res,"amount_invalid");
  ok(res, {accepted:true, pub, mint:String(mint||""), amount:amt, to:String(to||"")});
});

app.get(`${API_BASE}/invested`, (req,res)=>{
  const pub = String(req.query.pub||"");
  if(!pub) return bad(res,"pub_required");
  // placeholder: à remplacer par la vraie logique (ledger / positions)
  ok(res, {pub, invested_usdc:0, pnl_usdc:0, positions:[]});
});

app.use((req,res)=> bad(res,"not_found",404));

app.listen(PORT, BIND, ()=> {
  console.log(`[traderone-api] ${now()} listening http://${BIND}:${PORT}${API_BASE}`);
});
JS
)
askorupdate_file "$API_DIR/server.js" "$SERVER_JS"

log "Installer dépendances npm"
if [ -f package-lock.json ]; then rm -f package-lock.json; fi
npm i --omit=dev >/dev/null

log "Créer/Mettre à jour systemd service: $SERVICE_NAME"
SERVICE_UNIT=$(cat <<UNIT
[Unit]
Description=WOLVERINE TraderOne API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$API_DIR
Environment=NODE_ENV=production
Environment=BIND=$API_BIND
Environment=PORT=$API_PORT
Environment=API_BASE=$API_BASE
ExecStart=/usr/bin/node $API_DIR/server.js
Restart=always
RestartSec=2
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
UNIT
)
askorupdate_file "/etc/systemd/system/${SERVICE_NAME}.service" "$SERVICE_UNIT"

systemctl daemon-reload
systemctl enable --now "${SERVICE_NAME}.service" >/dev/null

log "Vérifier écoute locale"
sleep 1
if ! ss -lntp | grep -q "${API_BIND}:${API_PORT}"; then
  systemctl --no-pager status "${SERVICE_NAME}.service" || true
  die "API ne semble pas écouter sur ${API_BIND}:${API_PORT}"
fi

log "Brancher nginx (sans changer l'interface): vérifier location ${API_BASE}/"
[ -f "$NGINX_SITE" ] || die "nginx site introuvable: $NGINX_SITE"

needs_patch=1
if grep -qE "location\s+\^~\s+${API_BASE}/" "$NGINX_SITE" || grep -qE "location\s+${API_BASE}/" "$NGINX_SITE"; then
  needs_patch=0
fi

if [ "$needs_patch" -eq 1 ]; then
  log "Ajouter bloc nginx pour ${API_BASE}/ -> http://${API_BIND}:${API_PORT}"
  TS="$(date +%s)"
  cp -a "$NGINX_SITE" "${NGINX_SITE}.bak.${TS}"

  # déverrouiller si immuable
  chattr -i /etc/nginx/nginx.conf "$NGINX_SITE" 2>/dev/null || true

  # insertion avant le dernier "}" du server block: méthode simple (append avant fin fichier)
  PATCH=$(cat <<'NGX'
  # --- WOLVERINE TraderOne API (auto) ---
  location ^~ /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  # --- /WOLVERINE TraderOne API ---
NGX
)
  # Ajoute juste avant la dernière accolade si possible, sinon append.
  if tail -n 1 "$NGINX_SITE" | grep -q "}$"; then
    tmp="$(mktemp)"
    head -n -1 "$NGINX_SITE" >"$tmp"
    printf "%s\n" "$PATCH" >>"$tmp"
    echo "}" >>"$tmp"
    mv "$tmp" "$NGINX_SITE"
  else
    printf "\n%s\n" "$PATCH" >>"$NGINX_SITE"
  fi

  nginx -t >/dev/null
  systemctl reload nginx

  # re-lock
  chattr +i /etc/nginx/nginx.conf "$NGINX_SITE" 2>/dev/null || true
else
  log "nginx: location ${API_BASE}/ déjà présent. Aucun patch."
fi

log "Test HTTP via nginx (local)"
code="$(curl -sS -o /dev/null -w "%{http_code}" "http://127.0.0.1${API_BASE}/health" || true)"
if [ "$code" != "200" ]; then
  log "Attention: /health via nginx local retourne HTTP $code"
else
  log "OK: /health via nginx local = 200"
fi

log "IMPORTANT: Frontend NON modifié (WEBROOT conservé): $WEBROOT"
log "Résumé:"
echo " - Service: systemctl status ${SERVICE_NAME}.service"
echo " - Test local: curl -s http://127.0.0.1${API_BASE}/health | jq .  (jq optionnel)"
echo " - Endpoint public: https://fireinners.online${API_BASE}/health"
echo " - Start (exemple): curl -s -X POST https://fireinners.online${API_BASE}/start -H 'content-type: application/json' -d '{\"pub\":\"TEST\",\"budget_usdc\":10,\"strategy\":\"default\",\"risk_pct\":5}'"

log "Fini."
BASH

chmod +x /root/MEGA_TRADERONE_FINALIZE.sh
bash /root/MEGA_TRADERONE_FINALIZE.sh
simultané";const keys=S.metricKeys(va,vb,compat.mode);const rows=[];let eA=0,eB=0,eEq=0,eInc=0;const tA=[],tB=[],tI=[],labels=[];for(const k of keys){const w=+S.QPP.state.w[k]||1;const mA=va[k],mB=vb[k];const nm=S.normMetric(k,mA,mB);let conf=nm.conf*(compat.c<.5?.85:1);let incLeak=0;if(conf<.6)incLeak+=(.6-conf)*1.2;if(!Number.isFinite(+mA)||!Number.isFinite(+mB))incLeak+=.35;incLeak=Math.max(0,Math.min(1,incLeak));const risk=Math.max(S.risk(va),S.risk(vb));const qb=S.qubit(nm.d,conf,risk);const vote=(qb.pA-qb.pB);const support=w*conf*vote;const eqPush=w*conf*(1-Math.abs(vote))*0.35;const incPush=w*incLeak*0.9;eA+=Math.max(0,support);eB+=Math.max(0,-support);eEq+=eqPush;eInc+=incPush;const sol=S.solve(eA,eB,eEq,eInc);tA.push(sol.pA);tB.push(sol.pB);tI.push(sol.pInc);labels.push(k);rows.push({k,label:S.metricLabel(k),a:mA,b:mB,conf,w,risk,vote,theta:qb.theta,phi:qb.phi,pA:qb.pA,pB:qb.pB})}const final=S.solve(eA,eB,eEq,eInc);const q=S.quality(va,vb,compat,keys);S.$("#scorev").textContent=String(q);S.$("#scorev").className=q>=66?"ok":(q>=45?"warn":"bad");S.drawBars(S.$("#barChart"),[final.pA,final.pB,final.pEq,final.pInc],["A","B","EQ","INC"]);S.drawLine(S.$("#lineChart"),[tA,tB,tI],labels);tb.innerHTML=rows.map(r=>{const qline=`pA=${(r.pA*100).toFixed(1)}% pB=${(r.pB*100).toFixed(1)}% θ=${r.theta.toFixed(3)} φ=${r.phi.toFixed(3)}`;const v=`<span class="${r.vote>=0?"ok":"bad"}">${(r.vote>=0?"+":"")+r.vote.toFixed(3)}</span>`;return`<tr><td><b>${r.label}</b><div class=tag>${r.k}</div></td><td>${S.fmtVal(r.k,r.a)}</td><td>${S.fmtVal(r.k,r.b)}</td><td><span class=tag>${qline}</span><div class=tag>conf=${r.conf.toFixed(2)} w=${r.w.toFixed(2)} risk=${r.risk.toFixed(2)}</div></td><td>${v}</td></tr>`}).join("");S.$("#summary").textContent=S.explain(va,vb,compat,final,rows);const winner=final.pA>final.pB?"A":(final.pB>final.pA?"B":"EQ");rows.forEach(r=>{const agree=(winner==="A"&&r.vote>0)||(winner==="B"&&r.vote<0)||(winner==="EQ"&&Math.abs(r.vote)<.12);const amt=Math.min(.06
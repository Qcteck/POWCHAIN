cat >/tmp/OVERWRITE_REAL_WOLVERINE_INDEX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
export SYSTEMD_PAGER=cat PAGER=cat

echo "== 0) What is serving /wolverine (headers) =="
curl -kI https://fireinners.online/wolverine/ | sed -n '1,40p' || true
echo

echo "== 1) Find the REAL index.html that contains traderone_overlay.js =="
TARGET="$(grep -RIl --exclude-dir=node_modules --exclude-dir=.git 'traderone_overlay\.js' \
  /etc/nginx /var/www /usr/share/nginx /opt 2>/dev/null | head -n 1 || true)"

if [ -z "${TARGET:-}" ]; then
  echo "ERROR: cannot find an index containing traderone_overlay.js"
  echo "Run: grep -RIl 'traderone_overlay.js' /etc/nginx /var/www /usr/share/nginx /opt"
  exit 1
fi

echo "FOUND: $TARGET"
cp -a "$TARGET" "$TARGET.bak.$(date +%s)"

DOCROOT="$(dirname "$TARGET")"
echo "DOCROOT: $DOCROOT"
echo

echo "== 2) Overwrite index.html + app.js in that exact docroot =="
cat >"$DOCROOT/index.html" <<'HTML'

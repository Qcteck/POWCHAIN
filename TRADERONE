say "5) Ensure vhost includes wolverine routes"
[ -f "$VHOST" ] || die "missing $VHOST"
python3 - <<PY
from pathlib import Path
p=Path("$VHOST")
s=p.read_text(errors="ignore")
inc="include /etc/nginx/includes/wolverine_routes.inc;"
if inc in s:
    print("OK: vhost already includes wolverine_routes.inc")
else:
    lines=s.splitlines(True)
    out=[]
    injected=False
    for i,line in enumerate(lines):
        out.append(line)
        if (not injected) and ("server_name" in line) and ("fireinners.online" in line):
            out.append("  "+inc+"\n")
            injected=True
    if not injected:
        raise SystemExit("ERROR: could not find server_name fireinners.online in vhost")
    p.write_text("".join(out))
    print("OK: injected include into vhost")
PY

say "6) Fix Vault API backend (remove bs58 cause crash / empty JSON)"
mkdir -p "$VAULT_DIR/vaults"

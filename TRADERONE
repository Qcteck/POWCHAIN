cat > /root/fireinners_fix_batch.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%F_%H%M%S)"
LOG="/root/fireinners_fix_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

echo "=== LOG: $LOG ==="
echo "=== Host / OS ==="
hostname -f || true
uname -a || true
echo

echo "=== nginx status + syntax ==="
systemctl status nginx --no-pager || true
nginx -t || true
echo

echo "=== listeners 80/443 ==="
ss -lntp | egrep ':(80|443)\s' || echo "!! Rien n'écoute sur 80/443"
echo

echo "=== enabled vhosts ==="
ls -la /etc/nginx/sites-enabled || true
echo

echo "=== find server blocks for fireinners ==="
nginx -T 2>/dev/null | nl -ba | egrep -n "server_name|listen|root|index|location\s+/wolverine|location\s+/wolverine/api|try_files|rewrite" | head -n 260 || true
echo

echo "=== grep in /etc/nginx for dangerous patterns ==="
echo "--- server_name fireinners ---"
grep -RIn --color=always "server_name.*fireinners" /etc/nginx 2>/dev/null || true
echo "--- try_files -> /index.html (SPA) ---"
grep -RIn --color=always "try_files.*\/index\.html" /etc/nginx 2>/dev/null || true
echo "--- location /wolverine/api ---"
grep -RIn --color=always "location\s\+/wolverine\/api" /etc/nginx 2>/dev/null || true
echo

echo "=== quick filesystem checks ==="
echo "--- /var/www/fireinners ---"
ls -la /var/www/fireinners 2>/dev/null || echo "!! /var/www/fireinners absent"
echo "--- /var/www/wolverine ---"
ls -la /var/www/wolverine 2>/dev/null || echo "!! /var/www/wolverine absent"
echo

echo "=== local curl (Host header) ==="
curl -sS -I http://127.0.0.1/ -H 'Host: fireinners.online' | head -n 20 || true
curl -sS -I http://127.0.0.1/wolverine/api/ping -H 'Host: fireinners.online' | head -n 20 || true
echo

echo "=== BACKUP nginx configs ==="
BKDIR="/root/nginx_backup_${TS}"
mkdir -p "$BKDIR"
cp -a /etc/nginx "$BKDIR/"
echo "Backup done: $BKDIR"
echo

# =========================================================
# FIX PROPOSAL:
# - Serve the Wolverine API without SPA fallback (NO /index.html)
# - Serve the Wolverine UI as SPA under /wolverine with try_files -> /wolverine/index.html
# - Ensure "/" has an index (or at least avoid forbidden directory listing)
# =========================================================

# Guess the active vhost file (best-effort):
VHOST=""
if [ -e /etc/nginx/sites-enabled/fireinners.online-ssl ]; then
  VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
elif ls /etc/nginx/sites-enabled/*fireinners* >/dev/null 2>&1; then
  VHOST="$(ls -1 /etc/nginx/sites-enabled/*fireinners* | head -n1)"
fi

echo "=== Detected VHOST: ${VHOST:-NONE} ==="
echo

if [ -z "${VHOST:-}" ]; then
  echo "!! Aucun vhost fireinners trouvé dans sites-enabled."
  echo "   Mets ton fichier vhost dans /etc/nginx/sites-enabled/ puis relance."
  exit 1
fi

# Create a snippet to include (safe / clean)
SNIP="/etc/nginx/snippets/fireinners_wolverine_fix.inc"
cat > "$SNIP" <<'EOF'
# --- fireinners/wolverine fix ---
# IMPORTANT:
# 1) API must NOT fall back to SPA index.html (otherwise rewrite loop)
location ^~ /wolverine/api/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000;  # <-- adapte si ton backend n'est pas sur 3000
}

# 2) UI as SPA under /wolverine (static)
location ^~ /wolverine/ {
    alias /var/www/wolverine/;
    try_files $uri $uri/ /wolverine/index.html;
}

# 3) favicon (évite les 500 polluants)
location = /favicon.ico {
    access_log off;
    log_not_found off;
    return 204;
}
# --- end ---
EOF

echo "Snippet written: $SNIP"
echo

# Ensure site root has an index to avoid "directory index forbidden"
# (Only creates a minimal index.html if missing)
if [ -d /var/www/fireinners ] && [ ! -f /var/www/fireinners/index.html ]; then
  echo "No /var/www/fireinners/index.html -> creating a minimal one to avoid 403 directory index forbidden"
  cat > /var/www/fireinners/index.html <<'EOF'
<!doctype html>
<html><head><meta charset="utf-8"><title>fireinners</title></head>
<body><h1>fireinners online</h1><p>OK</p></body></html>
EOF
fi

echo "=== APPLY? (set APPLY=1 to modify vhost) ==="
if [ "${APPLY:-0}" != "1" ]; then
  echo "Dry-run: je n'ai rien modifié dans le vhost."
  echo
  echo "➡️ Pour appliquer automatiquement:"
  echo "   APPLY=1 bash /root/fireinners_fix_batch.sh"
  echo
  echo "➡️ Sinon, ajoute manuellement dans ton server {}:"
  echo "   include $SNIP;"
  exit 0
fi

echo "=== Applying changes into vhost ==="
# If snippet already included, do nothing. Otherwise insert include near top of server block.
if grep -qF "include $SNIP;" "$VHOST"; then
  echo "Vhost already includes snippet."
else
  # insert after first 'server {' occurrence
  awk -v snip="    include $SNIP;" '
    BEGIN{done=0}
    {
      print $0
      if(!done && $0 ~ /^[[:space:]]*server[[:space:]]*\{/){
        print snip
        done=1
      }
    }
  ' "$VHOST" > "${VHOST}.tmp"
  mv "${VHOST}.tmp" "$VHOST"
  echo "Inserted include into: $VHOST"
fi

echo
echo "=== Test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== Post-check listeners + curls ==="
ss -lntp | egrep ':(80|443)\s' || echo "!! Rien n'écoute sur 80/443"
echo "--- / ---"
curl -sS -I http://127.0.0.1/ -H 'Host: fireinners.online' | head -n 20 || true
echo "--- /wolverine/ ---"
curl -sS -I http://127.0.0.1/wolverine/ -H 'Host: fireinners.online' | head -n 20 || true
echo "--- /wolverine/api/ping ---"
curl -sS -I http://127.0.0.1/wolverine/api/ping -H 'Host: fireinners.online' | head -n 20 || true

echo
echo "=== DONE ==="
BASH

chmod +x /root/fireinners_fix_batch.sh
echo "OK. Lance:"
echo "  bash /root/fireinners_fix_batch.sh"
echo "Puis si tout te semble bon:"
echo "  APPLY=1 bash /root/fireinners_fix_batch.sh"
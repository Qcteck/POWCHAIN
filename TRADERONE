bash -c "$(cat <<'BASH'
set -euo pipefail
echo '=== WOLVERINE FULL ROLLBACK ==='

HTML="/var/www/wolverine/index.html"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SERVICE="wolverine-solana-proxy"

# 1) Stop proxy if exists
systemctl stop $SERVICE 2>/dev/null || true
systemctl disable $SERVICE 2>/dev/null || true
rm -f /etc/systemd/system/$SERVICE.service
systemctl daemon-reload

# 2) Restore last HTML backup
LAST_BAK=$(ls -1t /var/www/wolverine/index.html.bak_* 2>/dev/null | head -n1 || true)
if [ -n "$LAST_BAK" ]; then
  cp "$LAST_BAK" "$HTML"
  echo "✔ Restored HTML from $LAST_BAK"
else
  echo "⚠ No HTML backup found, leaving current file"
fi

# 3) Remove nginx rpc route if present
if grep -q 'location /rpc/solana' "$VHOST"; then
  awk '
  BEGIN{skip=0}
  /location \/rpc\/solana/{skip=1}
  skip && /}/{skip=0; next}
  !skip{print}
  ' "$VHOST" > "$VHOST.tmp" && mv "$VHOST.tmp" "$VHOST"
  echo "✔ Removed /rpc/solana route"
else
  echo "✔ No /rpc/solana route to remove"
fi

# 4) Reload nginx
nginx -t && systemctl reload nginx

echo '=== ROLLBACK DONE ==='
echo '➡️ Hard refresh navigateur (CTRL+SHIFT+R)'
BASH
)"
#!/usr/bin/env bash
set -euo pipefail

JS="/var/www/aiaquila/aiaquila-rss.js"
BACKUP="$JS.backup_$(date +%Y%m%d_%H%M%S)"

echo "=== AIAQUILA RSS HARD FIX ==="
cp "$JS" "$BACKUP"
echo "Backup: $BACKUP"

cat > "$JS" <<'JS'
/* ===== AIAQUILA RSS – PARSER ROBUSTE (NO DOM) ===== */

const FEEDS = [
  "https://www.coingecko.com/rss/news",
  "https://news.bitcoin.com/feed/",
  "https://cryptopanic.com/feed/rss.xml"
];

const PROXY = "/aiaquila/rss-proxy.php?url=";
let ARTICLES = [];

function log(m){
  const l=document.getElementById("logs");
  if(l){l.textContent+=m+"\n";l.scrollTop=l.scrollHeight;}
}

/* === TTS === */
function speak(t){
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(t);
  u.lang="fr-FR";
  speechSynthesis.speak(u);
}

/* === EXTRACTION TITRES ROBUSTE === */
function extractTitles(raw){
  const titles=[];
  const re=/<title[^>]*>(<!\[CDATA\[)?([\s\S]*?)(\]\]>)?<\/title>/gi;
  let m;
  while((m=re.exec(raw))!==null){
    const t=m[2].replace(/<[^>]+>/g,"").trim();
    if(t && !t.toLowerCase().includes("rss")) titles.push(t);
  }
  return titles;
}

async function loadRSS(){
  ARTICLES=[];
  log("Chargement RSS…");

  for(const f of FEEDS){
    try{
      const r=await fetch(PROXY+encodeURIComponent(f));
      const txt=await r.text();
      log("Flux reçu: "+f+" ("+txt.length+" chars)");

      const t=extractTitles(txt);
      log("Titres extraits: "+t.length);
      ARTICLES.push(...t.slice(0,5));
    }catch(e){
      log("Erreur flux: "+f);
    }
  }

  log("TOTAL articles: "+ARTICLES.length);

  if(ARTICLES.length){
    speak("Voici les nouvelles crypto. "+ARTICLES.join(". "));
  }else{
    speak("Aucun article détecté.");
  }
}

document.addEventListener("DOMContentLoaded",()=>{
  document.getElementById("loadRSS")?.addEventListener("click",loadRSS);
  log("AIAQUILA RSS prêt (parser robuste).");
});
JS

chmod 644 "$JS"
echo "=== PATCH APPLIQUÉ ==="
echo "Ctrl+F5 puis clique « Charger les articles »"
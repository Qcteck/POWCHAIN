cat >/root/branch_ui_backend.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

BACKEND="${1:-127.0.0.1:9000}"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"

PROXY_SNIP="/etc/nginx/snippets/wolverine_traderone_backend_proxy.conf"
STUB_SNIP="/etc/nginx/snippets/wolverine_traderone_stub_locations.conf"

[[ -f "$VHOST" ]] || { echo "[ERR] vhost introuvable: $VHOST"; exit 1; }

ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$VHOST" "${VHOST}.bak_${ts}"
echo "[OK] Backup vhost -> ${VHOST}.bak_${ts}"

mkdir -p /etc/nginx/snippets

# 1) Crée/écrase le snippet PROXY (UI -> BACKEND)
cat >"$PROXY_SNIP" <<NGINX
# UI -> Backend reverse proxy
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://$BACKEND/;
}

# UI calls this absolute path
location = /api/sync-deposit {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://$BACKEND/api/sync-deposit;
}
NGINX
echo "[OK] Proxy snippet -> $PROXY_SNIP"

# 2) Désactive les stubs (retire leur include du vhost)
sed -i \
  -e '\|include .*wolverine_traderone_stub_locations\.conf;|d' \
  "$VHOST"
echo "[OK] Stub include removed (if present)"

# 3) Ajoute l'include PROXY (idempotent)
if ! grep -qF "include $PROXY_SNIP;" "$VHOST"; then
  # insère juste avant la dernière }
  perl -0777 -i -pe '
    my $inc = "\n  include /etc/nginx/snippets/wolverine_traderone_backend_proxy.conf;\n";
    s/\n\}\s*\z/$inc\n}\n/s;
  ' "$VHOST"
  echo "[OK] Proxy include injected into vhost"
else
  echo "[OK] Proxy include already present"
fi

# 4) Test + reload
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "TESTS:"
echo "  curl -i https://fireinners.online/wolverine/traderone/api/me"
echo "  curl -i -X POST https://fireinners.online/api/sync-deposit"
BASH

chmod +x /root/branch_ui_backend.sh
/root/branch_ui_backend.sh 127.0.0.1:9000
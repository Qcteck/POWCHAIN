cat >/root/fix_conflict_443_keep_fireinners_ssl.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ts="$(date +%Y%m%d_%H%M%S)"
DIS="/etc/nginx/disabled-sites"
mkdir -p "$DIS"

echo "== Enabled vhosts =="
ls -la /etc/nginx/sites-enabled

echo
echo "== Enabled files that contain server_name fireinners.online =="
mapfile -t files < <(grep -RIl "server_name" /etc/nginx/sites-enabled | xargs -r grep -lE "fireinners\.online|www\.fireinners\.online" || true)
printf '%s\n' "${files[@]}" | nl -ba || true

KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
echo
echo "== Keeping: $KEEP =="
for f in "${files[@]}"; do
  [[ -e "$f" ]] || continue
  if [[ "$f" != "$KEEP" ]]; then
    echo "DISABLE $f -> $DIS/"
    mv -f "$f" "$DIS/$(basename "$f").disabled_$ts"
  fi
done

ln -sf /etc/nginx/sites-available/fireinners.online-ssl /etc/nginx/sites-enabled/fireinners.online-ssl

echo
echo "== Test + reload =="
nginx -t
systemctl reload nginx

echo
echo "== Recheck warnings =="
nginx -t 2>&1 | grep -i "conflicting server name" || echo "No conflicts ✅"
BASH

chmod +x /root/fix_conflict_443_keep_fireinners_ssl.sh
/root/fix_conflict_443_keep_fireinners_ssl.sh
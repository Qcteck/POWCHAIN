cat >/root/cleanup_sites_enabled_bak_safe.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DIS="/etc/nginx/disabled-sites"
mkdir -p "$DIS"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== Move backup/disabled files out of sites-enabled (SAFE, unique list) =="

# Collect unique candidates (no double-match)
mapfile -d '' files < <(
  find /etc/nginx/sites-enabled -maxdepth 1 -type f \
    \( -name "*.bak*" -o -name "*bak*" -o -name "*backup*" -o -name "*.disabled*" \) \
    -print0 | sort -zu
)

for f in "${files[@]}"; do
  if [[ -e "$f" ]]; then
    echo "MOVE $f -> $DIS/"
    mv -f "$f" "$DIS/$(basename "$f").moved_$ts"
  else
    echo "SKIP missing: $f"
  fi
done

echo
echo "== Remove broken symlinks in sites-enabled =="
find /etc/nginx/sites-enabled -xtype l -print -delete || true

echo
echo "== nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
BASH

chmod +x /root/cleanup_sites_enabled_bak_safe.sh
/root/cleanup_sites_enabled_bak_safe.sh
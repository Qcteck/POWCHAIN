cat >/root/retest_rpc_cf_vs_origin.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HOST="fireinners.online"
PATH_="/wolverine/rpc"
PAY='{"jsonrpc":"2.0","id":1,"method":"getVersion"}'

echo "== 1) PUBLIC (via Cloudflare) =="
curl -sk "https://${HOST}${PATH_}" -D- \
  -H 'content-type: application/json' \
  -H "Origin: https://${HOST}" \
  -H "Referer: https://${HOST}/wolverine/" \
  --data "$PAY" | head -n 60
echo

echo "== 2) DIRECT ORIGIN (bypass Cloudflare) =="
curl -sk "https://127.0.0.1${PATH_}" -D- \
  -H "Host: ${HOST}" \
  -H 'content-type: application/json' \
  -H "Origin: https://${HOST}" \
  -H "Referer: https://${HOST}/wolverine/" \
  --data "$PAY" | head -n 60
echo

echo "== 3) If public is 403, show CF headers =="
curl -sk -o /dev/null -D- "https://${HOST}${PATH_}" \
  -H 'content-type: application/json' \
  -H "Origin: https://${HOST}" \
  --data "$PAY" | egrep -i 'HTTP/|server:|cf-ray:|cf-cache-status:|cache-control:' || true

echo "DONE ✅"
BASH

chmod +x /root/retest_rpc_cf_vs_origin.sh
/root/retest_rpc_cf_vs_origin.sh
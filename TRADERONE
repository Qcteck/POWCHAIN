### ====== API ======
cat >"$API/server.js" <<'JS'
import http from "http";
import fs from "fs";
import path from "path";
import { Connection, PublicKey, Keypair, SystemProgram, Transaction } from "@solana/web3.js";

const BASE="/opt/traderone";
const CFG=JSON.parse(fs.readFileSync(path.join(BASE,"config.json"),"utf8"));
const LOG=CFG.log;
const PORT=3000;

const conn=new Connection(CFG.rpc,"confirmed");
const kp=Keypair.fromSecretKey(
  Uint8Array.from(JSON.parse(fs.readFileSync(path.join(BASE,"wallet","traderone.keypair.json"),"utf8")))
);

let running=false;

const log=(m)=>fs.appendFileSync(LOG,`[${new Date().toISOString()}] ${m}\n`);

async function loop(){
  if(!running) return;
  // PLACEHOLDER trading loop (safe)
  log("loop tick");
  setTimeout(loop, 15000);
}

const server=http.createServer(async (req,res)=>{
  res.setHeader("Content-Type","application/json");
  try{
    if(req.method==="POST" && req.url==="/api/status"){
      const bal=await conn.getBalance(kp.publicKey);
      res.end(JSON.stringify({running,internal:kp.publicKey.toBase58(),bal}));
      return;
    }
    if(req.method==="POST" && req.url==="/api/start"){
      running=true; log("START"); loop();
      res.end(JSON.stringify({ok:true}));
      return;
    }
    if(req.method==="POST" && req.url==="/api/stop"){
      running=false; log("STOP");
      res.end(JSON.stringify({ok:true}));
      return;
    }
    if(req.method==="POST" && req.url==="/api/cashout"){
      let body=""; req.on("data",c=>body+=c);
      req.on("end",async()=>{
        const j=JSON.parse(body||"{}");
        const dest=new PublicKey(j.userPub);
        const bal=await conn.getBalance(kp.publicKey);
        const tx=new Transaction().add(SystemProgram.transfer({
          fromPubkey: kp.publicKey,
          toPubkey: dest,
          lamports: Math.max(0, bal-5000)
        }));
        const sig=await conn.sendTransaction(tx,[kp]);
        running=false; log("CASHOUT "+sig);
        res.end(JSON.stringify({ok:true, sig}));
      });
      return;
    }
    res.statusCode=404; res.end(JSON.stringify({err:"not found"}));
  }catch(e){
    log("ERR "+e.message);
    res.statusCode=500; res.end(JSON.stringify({err:e.message}));
  }
});
server.listen(PORT,()=>log("API up :"+PORT));
JS


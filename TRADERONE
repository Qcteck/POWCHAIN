cat >/root/TRADERONE_NEW_WALLET.sh <<'EOF'
#!/bin/bash
set -e

APP_DIR="/opt/traderone"
WALLET_JSON="$APP_DIR/wallet.json"
WALLET_BACKUP="/root/traderone_wallet_backup.txt"

mkdir -p "$APP_DIR"

node <<'NODE'
const {Keypair} = require('@solana/web3.js');
const fs = require('fs');
const bs58 = require('bs58');

const kp = Keypair.generate();
const priv58 = bs58.encode(kp.secretKey);

fs.writeFileSync('/opt/traderone/wallet.json', JSON.stringify({
  PRIVATE_KEY_BASE58: priv58
}, null, 2), { mode: 0o600 });

fs.writeFileSync('/root/traderone_wallet_backup.txt', priv58 + "\n", { mode: 0o600 });

console.log("=== NOUVEAU WALLET TRADERONE ===");
console.log("Adresse publique :", kp.publicKey.toBase58());
console.log("Clé privée SAUVÉE dans : /root/traderone_wallet_backup.txt");
NODE
EOF

chmod +x /root/TRADERONE_NEW_WALLET.sh
/root/TRADERONE_NEW_WALLET.sh
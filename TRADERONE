import sys,re
p,mb,me,block=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
s=open(p,"r",encoding="utf-8",errors="ignore").read()

def replace_marked(txt):
    if mb in txt and me in txt:
        a=txt.index(mb); b=txt.index(me,a)+len(me)
        return txt[:a]+block+txt[b:]
    return None

r=replace_marked(s)
if r is not None:
    open(p,"w",encoding="utf-8").write(r); sys.exit(0)

servers=[]
for m in re.finditer(r'(?m)^\s*server\s*\{', s):
    i=m.start(); depth=0; j=i
    while j < len(s):
        c=s[j]
        if c=='{': depth+=1
        elif c=='}':
            depth-=1
            if depth==0:
                servers.append((i,j+1,s[i:j+1])); break
        j+=1
if not servers: raise SystemExit("ERR: aucun bloc server { } trouvé dans le vhost")

pick=None
for a,b,txt in servers:
    if re.search(r'(?m)^\s*listen\s+443', txt):
        pick=(a,b,txt); break
if pick is None: pick=servers[-1]
a,b,txt=pick
ins=b-1
out=s[:ins].rstrip()+"\n\n"+block+"\n\n"+s[ins:]
open(p,"w",encoding="utf-8").write(out)
PY


echo "== Patch: comment any location blocks OUTSIDE the first server{} and ensure include INSIDE server =="
python3 - <<'PY'
import re
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/wolverine_routes.conf"

lines=open(VHOST,"r",errors="ignore").read().splitlines(True)

# find first server { ... }
start=None
for i,l in enumerate(lines):
    if re.search(r'^\s*server\s*\{', l):
        start=i; break
if start is None:
    raise SystemExit("No server { found")

depth=0
end=None
for i in range(start, len(lines)):
    depth += lines[i].count("{")
    depth -= lines[i].count("}")
    if depth==0 and i>start:
        end=i
        break
if end is None:
    raise SystemExit("Could not find end of first server block (brace mismatch)")

before = lines[:start]
server = lines[start:end+1]
after  = lines[end+1:]

# remove any existing includes of snippet anywhere (we'll re-add once)
def drop_include(block):
    out=[]
    for l in block:
        if SNIP in l and re.search(r'^\s*include\b', l):
            continue
        out.append(l)
    return out

before = drop_include(before)
server = drop_include(server)
after  = drop_include(after)

# comment out ANY location blocks outside server (to stop nginx error)
def comment_locations(block):
    out=[]
    in_loc=False
    d=0
    for l in block:
        if not in_loc and re.search(r'^\s*location\b', l):
            out.append("# DISABLED_OUTSIDE_SERVER " + l)
            in_loc=True
            d += l.count("{") - l.count("}")
            continue
        if in_loc:
            out.append("# DISABLED_OUTSIDE_SERVER " + l)
            d += l.count("{") - l.count("}")
            if d <= 0 and "}" in l:
                in_loc=False
            continue
        out.append(l)
    return out

before = comment_locations(before)
after  = comment_locations(after)

# ensure include inside server (right before its closing brace)
inc = f"  include {SNIP};\n"
if not any(SNIP in l for l in server):
    server.insert(len(server)-1, inc)

open(VHOST,"w").writelines(before + server + after)
PY


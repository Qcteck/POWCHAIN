#!/usr/bin/env bash
set -euo pipefail

SITE="/var/www/fireinners.online/aiaquila"
INDEX="$SITE/index.html"
BACKUP="$SITE/index.backup.$(date +%Y%m%d_%H%M%S).html"
WORKER="https://aiaquila-proxy.paycashnostory.workers.dev/rss"

echo "=== AIAQUILA FRONTEND FIX — POST /rss ==="

[ -d "$SITE" ] || { echo "❌ Dossier introuvable"; exit 1; }

cp "$INDEX" "$BACKUP"
echo "✔ Backup: $BACKUP"

cat > "$INDEX" <<HTML
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;font-family:system-ui;background:#0b1b3a;color:#fff}
#wrap{padding:20px}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px}
</style>
</head>
<body>
<div id="wrap">
<h2>🦅 AIAQUILA — RSS réel</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
</div>

<script>
async function load(){
  const out=document.getElementById("out");
  out.textContent="POST → /rss\\n\\n";
  try{
    const r=await fetch("$WORKER",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        url:"https://news.bitcoin.com/feed/"
      })
    });
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();
    out.textContent="";
    j.forEach((i,n)=>{
      out.textContent+=\`#\${n+1} \${i.title}\\n\${i.link}\\n\${i.date}\\n\\n\`;
    });
  }catch(e){
    out.textContent="ERREUR: "+e.message;
  }
}
</script>
</body>
</html>
HTML

chown -R www-data:www-data "$SITE"
chmod -R 755 "$SITE"

nginx -t && systemctl reload nginx

echo
echo "=== TEST DIRECT WORKER ==="
curl -s -X POST "$WORKER" \
  -H "Content-Type: application/json" \
  -d '{"url":"https://news.bitcoin.com/feed/"}' | head -c 300
echo
echo "=== TERMINÉ ==="
echo "➡ https://fireinners.online/aiaquila/"
import re,sys,os
targets=sys.argv[1:]
tag_begin=re.compile(r'^\s*#\s*BEGIN\s+AQUILATRADER_MANAGED\b',re.I)
tag_end=re.compile(r'^\s*#\s*END\s+AQUILATRADER_MANAGED\b',re.I)
loc_begin=re.compile(r'^\s*location\s+(\^~\s+|~\s+|~\*\s+|=\\s+)?/aquilatrader/?\b')
# naive brace matching for nginx blocks
def strip_blocks(lines):
    out=[]
    i=0
    n=len(lines)
    while i<n:
        line=lines[i]
        if tag_begin.search(line):
            # drop until tag_end
            i+=1
            while i<n and not tag_end.search(lines[i]):
                i+=1
            if i<n: i+=1
            continue
        if loc_begin.search(line):
            # drop this location block by brace counting
            brace=line.count('{')-line.count('}')
            i+=1
            while i<n and brace>0:
                brace += lines[i].count('{')-lines[i].count('}')
                i+=1
            continue
        out.append(line)
        i+=1
    return out

for path in targets:
    try:
        raw=open(path,'r',encoding='utf-8',errors='ignore').read().splitlines(True)
    except Exception:
        continue
    cleaned=strip_blocks(raw)
    if cleaned!=raw:
        open(path,'w',encoding='utf-8').write("".join(cleaned))
        print("CLEANED:", path)
PY "${TARGETS[@]}"

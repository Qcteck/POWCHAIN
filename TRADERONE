set -euo pipefail
TS="$(date +%s)"
SNIP="/etc/nginx/snippets/wolv_rpc_proxy.conf"

echo "== 0) snippet RPC (preuve header) =="
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'EOF'
# Wolverine: Solana RPC proxy (same-origin)
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

location = /wolverine/traderone/api/rpc {
  add_header X-Wolv-RPC "1" always;

  proxy_pass https://api.mainnet-beta.solana.com;
  proxy_http_version 1.1;

  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;

  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF

echo "== 1) Patch tous les vhosts actifs qui écoutent 443 =="
for f in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf; do
  [ -f "$f" ] || continue
  cp -a "$f" "$f.bak.$TS"

  awk '
    function countchr(s,c,  i,n){n=0; for(i=1;i<=length(s);i++) if(substr(s,i,1)==c) n++; return n}
    BEGIN{in=0;br=0; hasListen443=0; hasInclude=0; done=0}
    {
      line=$0

      if(line ~ /^[[:space:]]*server[[:space:]]*\{/){in=1;br=0;hasListen443=0;hasInclude=0;done=0}

      if(in){
        if(line ~ /listen[[:space:]]+443/){hasListen443=1}
        if(line ~ /include[[:space:]]+\/etc\/nginx\/snippets\/wolv_rpc_proxy\.conf/){hasInclude=1}
      }

      print line

      # inject juste après la première ligne "listen 443" dans ce server{}
      if(in && hasListen443 && !hasInclude && !done && line ~ /listen[[:space:]]+443/){
        print "  include /etc/nginx/snippets/wolv_rpc_proxy.conf;"
        done=1
      }

      if(in){
        br += countchr(line,"{") - countchr(line,"}")
        if(br<=0 && line ~ /\}/){in=0}
      }
    }
  ' "$f" > "/tmp/nginxfix.$TS" && mv "/tmp/nginxfix.$TS" "$f"
done

echo "== 2) nginx test + reload =="
nginx -t
systemctl reload nginx

echo "== 3) TEST (DOIT montrer X-Wolv-RPC: 1, sinon on touche pas le bon server) =="
curl -ksS -i "https://fireinners.online/wolverine/traderone/api/rpc" \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 60
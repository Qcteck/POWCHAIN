cat >/root/fix_phantom_try_files_once_for_all.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SSL="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== Backup =="
cp -a "$SSL" "${SSL}.bak_${ts}"

echo "== 1) Remove ANY existing phantom_patch.js location blocks (even broken) =="
perl -0777 -i -pe 's@\n\s*location\s*=\s*/wolverine/phantom_patch\.js\s*\{.*?\}\s*\n@\n@sg' "$SSL"

echo "== 2) Append a CLEAN no-cache block (with literal \$uri) before final server } =="
# Replace last closing brace of server block by inserting our location block before it.
perl -0777 -i -pe 's@\n\}\s*$@\n  # Serve wallet patch with no-cache (avoid stale JS)\n  location = /wolverine/phantom_patch.js {\n    add_header Cache-Control "no-store" always;\n    try_files \\$uri =404;\n  }\n}\n@sg' "$SSL"

echo "== 3) Ensure enabled symlink points to this file =="
ln -sf "$SSL" "$EN"

echo "== 4) nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== 5) Show the block =="
grep -n "location = /wolverine/phantom_patch.js" -A5 -B2 "$SSL" || true
BASH

chmod +x /root/fix_phantom_try_files_once_for_all.sh
/root/fix_phantom_try_files_once_for_all.sh
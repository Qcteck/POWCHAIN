#!/bin/bash
set -e

FILE="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

node <<'NODE'
const fs=require("fs");
const f=process.env.FILE||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html";
let h=fs.readFileSync(f,"utf8");

/* CLEAN OLD */
h=h.replace(/WOLV_COLOR_SCRIPT[\s\S]*?<\/script>/g,"");

/* SCRIPT RNG COLOR ENGINE */
h=h.replace("</body>",`
<script id="WOLV_COLOR_SCRIPT">
const btn=document.getElementById("WOLV_COLOR_TOGGLE");

function rand(min,max){return Math.floor(Math.random()*(max-min)+min);}
function hsl(h,s,l){return \`hsl(\${h},\${s}%,\${l}%)\`;}

function luminanceHSL(l){return l/100;}

function generateMix(){
 const baseH=rand(0,360);
 const accentH=(baseH+rand(60,180))%360;
 const actionH=(baseH+rand(180,300))%360;

 const baseL=rand(10,85);
 const accentL=baseL>50?rand(10,30):rand(60,85);
 const actionL=rand(45,65);

 const base=hsl(baseH,rand(40,90),baseL);
 const accent=hsl(accentH,rand(60,100),accentL);
 const action=hsl(actionH,rand(70,100),actionL);

 return {base,accent,action,baseL};
}

function applyMix(){
 const m=generateMix();

 document.body.style.background=
`radial-gradient(circle at 20% 20%,${m.accent}55,transparent 60%),
 radial-gradient(circle at 80% 70%,${m.action}55,transparent 60%),
 ${m.base}`;

 const light=luminanceHSL(m.baseL)>0.5;
 document.body.style.color=light?"#000":"#fff";

 btn.style.background=`linear-gradient(135deg,${m.accent},${m.action})`;
 btn.style.color=light?"#000":"#fff";
 btn.style.boxShadow=\`0 0 25px \${m.action}\`;

 /* GLOBAL CSS VARS */
 document.documentElement.style.setProperty("--accent",m.accent);
 document.documentElement.style.setProperty("--action",m.action);
 document.documentElement.style.setProperty("--base",m.base);

 /* SHARE AUTO */
 const url=encodeURIComponent(location.href);
 const text=encodeURIComponent("TraderOne • Auto-Trade");
 if(navigator.share){
  navigator.share({title:"TraderOne",text,url});
 }else{
  const links=[
   "https://twitter.com/intent/tweet?url="+url+"&text="+text,
   "https://t.me/share/url?url="+url+"&text="+text
  ];
  window.open(links[rand(0,links.length)],"_blank");
 }
}

btn.onclick=applyMix;
applyMix();
</script>
</body>`);

fs.writeFileSync(f,h);
NODE

nginx -t && systemctl reload nginx
echo "✅ RNG MIX ENGINE actif – aucune palette fixe"
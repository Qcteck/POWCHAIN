import express from"express";import cors from"cors";import os from"os";import crypto from"crypto";import fetch from"node-fetch";import {JSDOM} from"jsdom";import {Readability} from"@mozilla/readability";import cheerio from"cheerio";
const app=express();app.disable("x-powered-by");app.use(cors());app.use(express.json({limit:"12mb"}));
const ENV=(k,d)=>process.env[k]??d;
const HOST=ENV("HOST","127.0.0.1"),PORT=parseInt(ENV("PORT","9697"),10);
const BASE=ENV("BASE","/iaaquila");
const API=BASE+"/api";
const PUB=new URL("./public/",import.meta.url).pathname;

const OLLAMA_HOST=ENV("OLLAMA_HOST","http://127.0.0.1:11434");
const OLLAMA_MODEL=ENV("OLLAMA_MODEL","llama3.2:3b");
const MAXTXT=parseInt(ENV("MAXTXT","65000"),10);

const mem={state:{mode:"BOOT",saie:"S",hex:"A",confidence:98.0,errRate:0,last:"—",errs:[]},pending:[],domains:{},chat:{msgs:[]},amc:{rules:["RSS=base","1 question à la fois","Décision->PENDING si externe","X write/on-chain write = PENDING only"],runs:[],quality:{}},feeds:{},articles:{},translations:{}};
const now=()=>Date.now();
const sha=x=>crypto.createHash("sha256").update(String(x||"")).digest("hex");
const clip=(s,n)=>String(s||"").slice(0,n);
const clean=t=>String(t||"").replace(/\r/g,"").replace(/[ \t]+\n/g,"\n").replace(/\n{3,}/g,"\n\n").trim();
function pushErr(m){mem.state.errs.push({t:now(),m:String(m||"ERR")});mem.state.errs=mem.state.errs.slice(-220);mem.state.errRate=Math.round((mem.state.errs.length/220)*1000)/10;mem.state.last=String(m||"—");}
function domainOf(u){try{return new URL(u).hostname.replace(/^www\./,"");}catch(e){return"unknown";}}

function parseRSS(xml){const dom=new JSDOM(xml,{contentType:"text/xml"});const doc=dom.window.document;let items=[...doc.querySelectorAll("item")].slice(0,70).map(it=>({title:(it.querySelector("title")?.textContent||"").trim(),link:(it.querySelector("link")?.textContent||"").trim(),pub:(it.querySelector("pubDate")?.textContent||"").trim()}));if(items.length)return items.filter(x=>x.title&&x.link);items=[...doc.querySelectorAll("entry")].slice(0,70).map(en=>({title:(en.querySelector("title")?.textContent||"").trim(),link:(en.querySelector("link")?.getAttribute("href")||en.querySelector("link")?.textContent||"").trim(),pub:(en.querySelector("updated")?.textContent||en.querySelector("published")?.textContent||"").trim()}));return items.filter(x=>x.title&&x.link);}

function htmlToPlain(html){const looks=/<\/(html|body|p|div|article|main)>/i.test(html)||/<p[\s>]/i.test(html)||/<article[\s>]/i.test(html);if(!looks)return clean(html);return clean(html.replace(/<script[\s\S]*?<\/script>/gi,"").replace(/<style[\s\S]*?<\/style>/gi,"").replace(/<\/p>/gi,"\n\n").replace(/<br\s*\/?>/gi,"\n").replace(/<li[^>]*>/gi,"\n• ").replace(/<\/li>/gi,"").replace(/<h[1-6][^>]*>/gi,"\n\n").replace(/<\/h[1-6]>/gi,"\n").replace(/<[^>]+>/g," ").replace(/\s+/g," "));}
function readabilityExtract(html,url){try{const dom=new JSDOM(html,{url});const doc=dom.window.document;const art=new Readability(doc).parse();if(art&&art.textContent&&art.textContent.trim().length>220)return clean(art.textContent);}catch(e){}return"";}
function heuristicExtract(html){try{const $=cheerio.load(html);$("script,style,noscript,svg,canvas,iframe,nav,footer,header,aside,form,button").remove();let best="",bestScore=0;$("article,main,section,div").each((_,el)=>{const txt=clean($(el).text());if(txt.length<650)return;const links=$(el).find("a").length;const score=txt.length-(links*50);if(score>bestScore){bestScore=score;best=txt;}});return best||clean($("body").text());}catch(e){return"";}}
function qualityScore(txt){txt=clean(txt);const len=txt.length;const words=txt.toLowerCase().split(/\s+/).filter(Boolean);const uniq=new Set(words).size;const uniqRatio=uniq/Math.max(1,words.length);let score=0;score+=Math.min(60,Math.floor(len/120));score+=Math.min(40,Math.floor(uniqRatio*100));return Math.max(0,Math.min(100,score));}
function paywallSuspect(txt,html){const s=(txt||"").toLowerCase();const h=(html||"").toLowerCase();const k=["subscribe","subscription","sign in","log in","paywall","abonne","abonnement","connectez-vous","connexion","premium","register","trial","metered","members only"];const hit=k.some(x=>s.includes(x)||h.includes(x));return hit||((txt||"").length<650);}
function summarize(text){text=clean(text||"");const paras=text.split("\n\n").map(x=>x.trim()).filter(Boolean);const pick=[];for(const pa of paras){if(pick.length>=6)break;const s=pa.replace(/\s+/g," ").slice(0,260);if(s.length>90)pick.push("• "+s);}return pick.length?pick.join("\n"):"• (Résumé impossible: contenu trop court / bloqué)";}

async function fetchWith(url,headers){const r=await fetch(url,{cache:"no-store",redirect:"follow",headers:headers||{}});if(!r.ok)throw new Error("HTTP "+r.status);return await r.text();}
async function fetchMultiplex(url){
  const ua={"user-agent":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123 Safari/537.36"};
  const tries=[
    async()=>({src:"direct",body:await fetchWith(url,ua)}),
    async()=>({src:"allorigins",body:await fetchWith("https://api.allorigins.win/raw?url="+encodeURIComponent(url),ua)}),
    async()=>({src:"jina_https",body:await fetchWith("https://r.jina.ai/https://"+url.replace(/^https?:\/\//i,""),ua)}),
    async()=>({src:"jina_http",body:await fetchWith("https://r.jina.ai/http://"+url.replace(/^https?:\/\//i,""),ua)})
  ];
  let last=null;
  for(const f of tries){try{const out=await f();if(out.body&&out.body.trim().length>220)return out;}catch(e){last=e;}}
  throw last||new Error("fetch failed");
}
async function extractBest(url){
  const d=domainOf(url);const dom=mem.domains[d]||(mem.domains[d]={ok:0,fail:0,avgQ:0,methods:{}});
  let raw=null;try{raw=await fetchMultiplex(url);}catch(e){pushErr("fetch fail "+d);raw=null;}
  const outs=[];
  if(raw&&raw.body){
    const html=raw.body;
    outs.push({m:raw.src+"_readability",txt:readabilityExtract(html,url),html});
    outs.push({m:raw.src+"_heuristic",txt:heuristicExtract(html),html});
    outs.push({m:raw.src+"_plain",txt:htmlToPlain(html),html});
  }
  for(const o of outs){o.txt=clean(o.txt||"");if(o.txt.length>MAXTXT)o.txt=o.txt.slice(0,MAXTXT);o.q=qualityScore(o.txt);o.paywall=paywallSuspect(o.txt,o.html);o.len=o.txt.length;}
  outs.sort((a,b)=> (b.q-b.paywall*8)-(a.q-a.paywall*8));
  const best=outs[0]||{m:"none",txt:"",q:0,paywall:true,len:0};
  dom.methods[best.m]=(dom.methods[best.m]||0)+1;
  if(best.txt&&best.q>=20){dom.ok++;dom.avgQ=Math.round(((dom.avgQ*(dom.ok-1))+best.q)/dom.ok);}else dom.fail++;
  return {domain:d,best,alts:outs.slice(0,6),domainScore:dom};
}

async function ollamaOK(){try{const r=await fetch(OLLAMA_HOST+"/api/tags",{cache:"no-store"});return !!r.ok;}catch(e){return false;}}
async function llmGenerate(system,user){
  const ok=await ollamaOK();if(!ok)return {ok:false,txt:"(LLM local indisponible)"};
  const prompt=`[SYSTEM]\n${system}\n\n[USER]\n${user}\n`;
  try{
    const r=await fetch(OLLAMA_HOST+"/api/generate",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({model:OLLAMA_MODEL,prompt,stream:false,options:{temperature:0.4,top_p:0.9}})});
    const j=await r.json();return {ok:true,txt:clean(j?.response||"")};
  }catch(e){return {ok:false,txt:"(LLM local erreur)"};}
}

function pushPending(desc,payload){const id="ACT_"+Date.now();mem.pending.push({id,desc,status:"PENDING",payload,createdAt:now()});mem.pending=mem.pending.slice(-500);return id;}
function resolvePending(id,ok){const a=mem.pending.find(x=>x.id===id);if(!a)return null;a.status=ok?"APPROVED":"REFUSED";a.resolvedAt=now();return a;}

app.use(BASE,express.static(PUB,{etag:false,maxAge:0}));

app.get(API+"/health",(req,res)=>res.json({ok:true,app:"iaaquila",base:BASE,api:API,host:HOST,port:PORT,ollama:{host:OLLAMA_HOST,model:OLLAMA_MODEL},t:now()}));
app.get(API+"/state",(req,res)=>res.json({state:mem.state,amc:mem.amc,pending:mem.pending.slice(-120),domains:mem.domains,chatCount:mem.chat.msgs.length,t:now()}));
app.get(API+"/metrics",(req,res)=>{const mu=process.memoryUsage();res.json({t:now(),rss:mu.rss,heapUsed:mu.heapUsed,heapTotal:mu.heapTotal,ext:mu.external,uptime:process.uptime(),load:os.loadavg()});});
app.get(API+"/llm/status",async(req,res)=>res.json({ok:await ollamaOK(),host:OLLAMA_HOST,model:OLLAMA_MODEL}));

app.post(API+"/llm/chat",async(req,res)=>{
  const {lang,msg}=req.body||{};const L=(lang==="en"?"en":"fr");
  const sysFR="Tu es AquilaAi, style Jarvis (pertinent, sec, léger sarcasme). 1 question à la fois. Jamais d’action externe sans PENDING. Réponses courtes, décisionnelles.";
  const sysEN="You are AquilaAi, Jarvis-like (sharp, slightly sarcastic). One question at a time. No external actions without PENDING. Be concise, decision-oriented.";
  const user=clip(msg,7000);
  mem.chat.msgs.push({t:now(),role:"user",msg:user});mem.chat.msgs=mem.chat.msgs.slice(-40);
  const out=await llmGenerate(L==="fr"?sysFR:sysEN,user);
  mem.chat.msgs.push({t:now(),role:"ai",msg:out.txt});mem.chat.msgs=mem.chat.msgs.slice(-40);
  res.json({ok:out.ok,answer:out.txt});
});

app.post(API+"/rss/pull",async(req,res)=>{
  const {feeds}=req.body||{};
  const list=(feeds&&Array.isArray(feeds)&&feeds.length)?feeds:[
    "https://cryptoast.fr/feed/","https://journalducoin.com/feed/","https://cryptonaute.fr/feed/",
    "https://cointelegraph.com/rss","https://www.coindesk.com/arc/outboundfeeds/rss/","https://decrypt.co/feed","https://www.theblock.co/rss.xml",
    "https://www.reddit.com/r/CryptoCurrency/.rss"
  ];
  let items=[];
  for(const f of list.slice(0,14)){
    try{const xml=await fetchWith("https://api.allorigins.win/raw?url="+encodeURIComponent(f),{"user-agent":"Mozilla/5.0"});items=items.concat(parseRSS(xml).map(x=>({...x,src:f})));}catch(e){pushErr("rss fail");}
  }
  items=items.filter(x=>x.title&&x.link).slice(0,80);
  res.json({ok:true,items});
});

app.post(API+"/article/read",async(req,res)=>{
  try{
    const {url,lang}=req.body||{};if(!url)return res.status(400).json({ok:false,err:"missing url"});
    const pack=await extractBest(url);
    const sum=summarize(pack.best.txt||"");
    const L=(lang==="en"?"en":"fr");
    const sysFR="Résume en 6 puces max, puis: 1 risque, 1 opportunité, et 1 question unique à l’utilisateur. Style Jarvis. Très court.";
    const sysEN="Summarize in <=6 bullets, then: 1 risk, 1 opportunity, and 1 single question to the user. Jarvis style. Very concise.";
    const llm=await llmGenerate(L==="fr"?sysFR:sysEN,`URL: ${url}\n\nTEXTE:\n${clip(pack.best.txt,6500)}`);
    res.json({ok:true,url,domain:pack.domain,method:pack.best.m,quality:pack.best.q,paywall:!!pack.best.paywall,domainAvgQ:pack.domainScore.avgQ,domainOk:pack.domainScore.ok,domainFail:pack.domainScore.fail,summary:sum,llm:llm.ok?llm.txt:null,excerpt:clip(pack.best.txt,2600),alts:pack.alts.map(a=>({m:a.m,q:a.q,paywall:a.paywall,len:a.len}))});
  }catch(e){pushErr("article read fail");res.status(500).json({ok:false,err:String(e)});}
});

app.post(API+"/decision/propose",(req,res)=>{const {desc,payload}=req.body||{};res.json({ok:true,id:pushPending(desc||"Action",payload||{})});});
app.post(API+"/decision/resolve",(req,res)=>{const {id,ok}=req.body||{};const a=resolvePending(id,!!ok);res.json({ok:!!a,action:a});});


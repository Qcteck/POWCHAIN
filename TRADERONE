cat >/opt/traderone/server.js <<'JS'
import http from "http";
import url from "url";
import fs from "fs";
import { Connection, Keypair, PublicKey, LAMPORTS_PER_SOL, SystemProgram, Transaction } from "@solana/web3.js";

const PORT = process.env.PORT || 3000;
const RPC = "https://api.mainnet-beta.solana.com";

/* === WALLET INTERNE === */
const walletData = JSON.parse(fs.readFileSync("/opt/traderone/wallet.json","utf8"));
const secret = Uint8Array.from(
  Buffer.from(walletData.PRIVATE_KEY_BASE58, "base58")
);
const wallet = Keypair.fromSecretKey(secret);
const connection = new Connection(RPC,"confirmed");

/* === ADRESSES FEES === */
const DEST1 = new PublicKey("ufii1UUsd1FM8ByD6XyvuamGhGjeJdTM7PAbrj4uZDj");
const DEST2 = new PublicKey("B12wwfsHmHNGsML9uWfV4YFq1QgBTvGwn8Kf7qUxQdQU");

/* === SERVER === */
const server = http.createServer(async (req,res)=>{
  const { pathname } = url.parse(req.url,true);

  /* PAGE */
  if(req.method==="GET" && pathname==="/"){
    res.writeHead(200,{"Content-Type":"text/html"});
    return res.end(`
<!DOCTYPE html>
<html>
<body style="background:#111;color:#eee;font-family:Arial">
<h2>TraderOne Wallet Interne</h2>
<p><b>Adresse publique :</b><br>${wallet.publicKey.toBase58()}</p>

<input id="amt" type="number" step="0.0001" value="0.001"/> SOL
<br><br>
<button onclick="send()">ENVOYER</button>
<pre id="out"></pre>

<script>
async function send(){
  const r = await fetch("/send",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({amount:parseFloat(document.getElementById("amt").value)})
  });
  out.textContent = JSON.stringify(await r.json(),null,2);
}
</script>
</body>
</html>
`);
  }

  /* ENVOI SOL */
  if(req.method==="POST" && pathname==="/send"){
    let body="";
    req.on("data",c=>body+=c);
    req.on("end",async()=>{
      try{
        const { amount } = JSON.parse(body||"{}");
        if(!amount || amount<=0) throw "Montant invalide";

        const half = Math.floor((amount/2)*LAMPORTS_PER_SOL);

        const tx = new Transaction().add(
          SystemProgram.transfer({
            fromPubkey: wallet.publicKey,
            toPubkey: DEST1,
            lamports: half
          }),
          SystemProgram.transfer({
            fromPubkey: wallet.publicKey,
            toPubkey: DEST2,
            lamports: half
          })
        );

        const sig = await connection.sendTransaction(tx,[wallet]);
        await connection.confirmTransaction(sig,"confirmed");

        res.writeHead(200,{"Content-Type":"application/json"});
        res.end(JSON.stringify({
          ok:true,
          signature:sig,
          from:wallet.publicKey.toBase58(),
          sent_each_sol: half / LAMPORTS_PER_SOL
        }));
      }catch(e){
        res.writeHead(500,{"Content-Type":"application/json"});
        res.end(JSON.stringify({ok:false,error:String(e)}));
      }
    });
    return;
  }

  res.writeHead(404);res.end();
});

server.listen(PORT,"0.0.0.0",()=>console.log("TraderOne LIVE on",PORT));

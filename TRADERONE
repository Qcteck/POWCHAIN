<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Assistant Auto-apprenant Avancé</title>
</head>
<body>
<h2>Assistant Intelligent avec Communication Adaptative</h2>
<div id="log" style="height:300px;overflow-y:scroll;border:1px solid #ccc;padding:10px;"></div>

<input type="text" id="userInput" placeholder="Écris ton savoir ici..."/>
<button onclick="userSend()">Envoyer</button>
<button onclick="readMemory()">Lire la mémoire résumée</button>

<script>
const log = document.getElementById('log');

// Mémoire et profil de communication
let memory = JSON.parse(localStorage.getItem('knowledge') || '[]');
let varBProfile = JSON.parse(localStorage.getItem('varBProfile') || '{"speed":1,"conciseness":1}');

function appendLog(msg) {
    log.innerHTML += msg + '<br>';
    log.scrollTop = log.scrollHeight;
}

// VarA : écoute, filtre et résume
const varA = {
    learn: function(text){
        text = text.trim();
        if(text.length < 3 || memory.includes(text)) return null;
        memory.push(text);
        localStorage.setItem('knowledge', JSON.stringify(memory));
        appendLog("VarA a appris: " + text);
        return text;
    },
    summarize: function(){
        let unique = [...new Set(memory)];
        unique = unique.filter(s => s.length > 3);
        // Résumé simple mais peut être ajusté selon conciseness
        let summary = unique.join(". ");
        if(varBProfile.conciseness > 1) {
            summary = unique.slice(-5).join(". "); // conserve dernières phrases
        }
        return summary + ".";
    }
};

// VarB : communication adaptative
const varB = {
    speak: function(text){
        appendLog("VarB dit: " + text);
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'fr-FR';
        // Ajuste vitesse selon profil
        utterance.rate = varBProfile.speed;
        speechSynthesis.speak(utterance);
    },
    improve: function(feedback){
        // feedback positif ou négatif pour ajuster conciseness et speed
        if(feedback === "plus rapide") varBProfile.speed += 0.1;
        if(feedback === "moins rapide") varBProfile.speed = Math.max(0.5,varBProfile.speed-0.1);
        if(feedback === "plus concis") varBProfile.conciseness +=1;
        if(feedback === "moins concis") varBProfile.conciseness = Math.max(1,varBProfile.conciseness-1);
        localStorage.setItem('varBProfile', JSON.stringify(varBProfile));
        appendLog("VarB profile mis à jour: " + JSON.stringify(varBProfile));
    }
};

// Texte utilisateur
function userSend(){
    const input = document.getElementById('userInput').value.trim();
    if(!input) return;
    appendLog("Utilisateur transmet: " + input);
    const knowledge = varA.learn(input);
    if(knowledge) varB.speak(knowledge);
    document.getElementById('userInput').value = '';
}

// Écoute micro en continu
if('webkitSpeechRecognition' in window){
    const recognition = new webkitSpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = false;
    recognition.lang = 'fr-FR';

    recognition.onresult = function(event){
        for(let i=event.resultIndex;i<event.results.length;i++){
            if(event.results[i].isFinal){
                const text = event.results[i][0].transcript.trim();
                const knowledge = varA.learn(text);
                if(knowledge) varB.speak(knowledge);
            }
        }
    };
    recognition.onerror = e => console.error(e.error);
    recognition.start();
    appendLog("🟢 Micro en écoute continue...");
} else {
    appendLog("❌ Navigateur non compatible reconnaissance vocale.");
}

// Lecture mémoire résumée
function readMemory(){
    const summary = varA.summarize();
    appendLog("📚 Mémoire résumée: " + summary);
    varB.speak(summary);
}

// Exemple d'amélioration : double clic sur log pour corriger VarB
log.addEventListener('dblclick', ()=>{
    const feedback = prompt("Comment améliorer VarB ? (plus rapide / moins rapide / plus concis / moins concis)");
    if(feedback) varB.improve(feedback);
});
</script>
</body>
</html>

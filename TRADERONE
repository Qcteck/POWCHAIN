set -euo pipefail
WORK="/root/phantom-docker"
OUT="/root/phantom-out"
URL="https://fireinners.online/test/"

mkdir -p "$WORK" "$OUT"
cd "$WORK"

# Script Phantom
cat > render.js <<'JS'
var page = require('webpage').create();
var system = require('system');

if (system.args.length < 3) {
  console.log("Usage: phantomjs render.js <url> <out.png>");
  phantom.exit(1);
}
var url = system.args[1];
var out = system.args[2];

page.viewportSize = { width: 1400, height: 900 };
page.settings.userAgent = "Mozilla/5.0 (X11; Linux x86_64) PhantomJS/2.1.1";

page.open(url, function(status) {
  if (status !== 'success') {
    console.log("FAIL open:", status);
    phantom.exit(2);
  }
  window.setTimeout(function() {
    page.render(out);
    console.log("OK wrote", out);
    phantom.exit(0);
  }, 2000);
});
JS

# Image Docker PhantomJS (build local -> compatible Docker récent)
cat > Dockerfile <<'DOCKER'
FROM debian:bullseye-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates bzip2 libfontconfig1 libfreetype6 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN wget -O phantomjs.tar.bz2 https://bitbucket.org/ariya/phantomjs/downloads/phantomjs-2.1.1-linux-x86_64.tar.bz2 \
 && tar -xjf phantomjs.tar.bz2 \
 && mv phantomjs-2.1.1-linux-x86_64/bin/phantomjs /usr/local/bin/phantomjs \
 && chmod +x /usr/local/bin/phantomjs \
 && rm -rf /opt/*

CMD ["phantomjs","--version"]
DOCKER

echo "=== Build image phantom-local:2.1.1 ==="
docker build -t phantom-local:2.1.1 .

echo "=== Test version ==="
docker run --rm phantom-local:2.1.1 phantomjs --version

echo "=== Render screenshot ==="
docker run --rm -v "$OUT":/out -v "$WORK":/work -w /work phantom-local:2.1.1 \
  phantomjs render.js "$URL" /out/test.png

ls -lah "$OUT/test.png"
echo "✅ Screenshot OK: $OUT/test.png"
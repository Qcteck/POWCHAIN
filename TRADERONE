import { useConnection, useWallet } from '@solana/wallet-adapter-react';
import {
  PublicKey,
  TransactionMessage,
  VersionedTransaction,
  SystemProgram,
  LAMPORTS_PER_SOL,
  ComputeBudgetProgram,
  Commitment,
  RpcResponseAndContext,
  SignatureResult,
} from '@solana/web3.js';
import { useCallback, useMemo, useState } from 'react';
import { getVaultPDA, createVaultInstruction, depositInstruction } from '@/lib/vaultProgram';

const COMMITMENT: Commitment = 'confirmed';

// Ajuste selon ton besoin
const DEFAULT_SOL_DEPOSIT = 1; // 1 SOL
const CU_LIMIT = 250_000; // compute units (safe-ish for multi-instructions)
const CU_PRICE_MICROLAMPORTS = 50_000; // prioritization fee (ajuste)

function isUserReject(e: any) {
  const m = String(e?.message || e || '');
  return /User rejected|user rejected|Rejected|denied|Declined/i.test(m);
}

export default function AquilaActions() {
  const { connection } = useConnection();
  const wallet = useWallet();
  const { publicKey } = wallet;

  const [loading, setLoading] = useState(false);
  const [status, setStatus] = useState<string>('');

  const canSign = useMemo(() => {
    // wallet-adapter peut exposer signTransaction OU signAllTransactions.
    return !!wallet.signTransaction;
  }, [wallet.signTransaction]);

  const handleOneClickSetupAndDeposit = useCallback(async () => {
    if (!publicKey) {
      setStatus('Wallet non connecté');
      return;
    }
    if (!wallet.signTransaction) {
      setStatus('Wallet ne supporte pas signTransaction');
      return;
    }

    setLoading(true);
    setStatus('Préparation du batch…');

    try {
      // 1) PDA
      const [vaultPDA] = getVaultPDA(publicKey);

      // 2) Vérifier si le vault existe déjà (évite de crasher sur "already in use")
      const vaultInfo = await connection.getAccountInfo(vaultPDA, COMMITMENT);
      const needCreate = !vaultInfo;

      // 3) Instructions
      const ixs = [];

      // compute budget (optionnel mais utile si bundle lourd)
      ixs.push(ComputeBudgetProgram.setComputeUnitLimit({ units: CU_LIMIT }));
      ixs.push(ComputeBudgetProgram.setComputeUnitPrice({ microLamports: CU_PRICE_MICROLAMPORTS }));

      if (needCreate) {
        ixs.push(
          createVaultInstruction({
            payer: publicKey,
            vault: vaultPDA,
          })
        );
      }

      // Exemple: transfert natif SOL vers vault (si ton design le veut)
      const lamports = Math.round(DEFAULT_SOL_DEPOSIT * LAMPORTS_PER_SOL);
      if (lamports > 0) {
        ixs.push(
          SystemProgram.transfer({
            fromPubkey: publicKey,
            toPubkey: vaultPDA,
            lamports,
          })
        );
      }

      // Dépôt custom (Anchor/SPL/logic interne)
      ixs.push(
        depositInstruction({
          user: publicKey,
          vault: vaultPDA,
          amount: lamports, // adapte selon ton programme (lamports / amount token / etc.)
        })
      );

      // 4) Blockhash + V0 message
      const latest = await connection.getLatestBlockhash(COMMITMENT);

      const msgV0 = new TransactionMessage({
        payerKey: publicKey,
        recentBlockhash: latest.blockhash,
        instructions: ixs,
      }).compileToV0Message(); // passe tes lookup tables si tu en utilises

      const vtx = new VersionedTransaction(msgV0);

      // 5) Signature unique
      setStatus('Signature wallet…');
      const signed = await wallet.signTransaction(vtx);

      // 6) Envoi raw
      setStatus('Envoi…');
      const sig = await connection.sendRawTransaction(signed.serialize(), {
        skipPreflight: false,
        maxRetries: 3,
      });

      // 7) Confirmation
      setStatus('Confirmation…');
      const conf: RpcResponseAndContext<SignatureResult> = await connection.confirmTransaction(
        { signature: sig, blockhash: latest.blockhash, lastValidBlockHeight: latest.lastValidBlockHeight },
        COMMITMENT
      );

      if (conf.value.err) {
        throw new Error(`Transaction confirmée avec erreur: ${JSON.stringify(conf.value.err)}`);
      }

      setStatus(`Succès: ${sig}`);
    } catch (e: any) {
      console.error(e);
      setStatus(isUserReject(e) ? 'Signature annulée' : `Échec: ${String(e?.message || e)}`);
    } finally {
      setLoading(false);
    }
  }, [publicKey, wallet, connection]);

  return (
    <div className="space-y-4">
      <button
        onClick={handleOneClickSetupAndDeposit}
        disabled={loading || !publicKey || !canSign}
        className="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 disabled:opacity-50 transition"
      >
        {loading ? 'Traitement…' : 'Tout-en-un : Créer Vault + Déposer'}
      </button>

      {status && <p className="text-sm text-gray-300">{status}</p>}
    </div>
  );
}
bash -lc '
set -e

WEB_DIR="/var/www/aiaquila"
WEB="/var/www/aiaquila/index.html"

echo "== FIX FINAL AIAQUILA =="

mkdir -p "$WEB_DIR"

cat > "$WEB" <<'"'"'HTML'"'"'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
body{margin:0;background:#05070a;color:#e6e6e6;font-family:system-ui,monospace}
header{padding:12px 20px;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{padding:20px;max-width:900px}
</style>
</head>
<body>
<header>
<strong>AIAQUILA</strong>
<span id="status">Init…</span>
</header>
<main>
<p id="msg"></p>
</main>
<script>
(function(){
  window.AQ_STATE =
    window.AQ_STATE ||
    JSON.parse(localStorage.getItem("aiaquila_state")) ||
    { lvl: 0.55, h: {} };

  const S = window.AQ_STATE;

  function save(){
    localStorage.setItem("aiaquila_state", JSON.stringify(S));
  }

  function loop(){
    document.getElementById("status").textContent =
      "Circumstantial " + Math.round(S.lvl * 100) + "%";
    document.getElementById("msg").textContent =
      "Le message paraît presque normalisé, comme intégré d’avance.";
    requestAnimationFrame(loop);
  }

  save();
  loop();
})();
</script>
</body>
</html>
HTML

chown www-data:www-data "$WEB"
chmod 644 "$WEB"

nginx -t
systemctl reload nginx

echo "OK → https://fireinners.online/aiaquila/"
echo "CTRL+F5 navigateur"
'
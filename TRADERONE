cat <<'EOF' >/root/AIAQUILA_ROOT_FINAL.sh
#!/usr/bin/env bash
set -euo pipefail

### =========================
### AIAQUILA — ROOT FINAL
### =========================

APP_DIR="/var/www/aiaquila"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
BACKUP="/root/aiaquila_backup_$(date +%Y%m%d_%H%M%S)"

echo "== AIAQUILA | START =="

# --- ROOT CHECK
[ "$EUID" -eq 0 ] || { echo "❌ Must be root"; exit 1; }

# --- BACKUP
if [ -d "$APP_DIR" ]; then
  echo "Backup → $BACKUP"
  mkdir -p "$BACKUP"
  cp -a "$APP_DIR" "$BACKUP/"
fi

mkdir -p "$APP_DIR"
chown -R www-data:www-data "$APP_DIR"

# --- FRONTEND
cat >"$APP_DIR/index.html"<<'HTML'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>AIAQUILA</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
body{margin:0;background:#05070a;color:#e6e6e6;font-family:system-ui}
header{padding:12px 20px;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{padding:20px}
#stream{max-width:900px;line-height:1.6}
button{background:#111827;color:#fff;border:1px solid #374151;padding:6px 10px;border-radius:6px;cursor:pointer}
.feedback{position:fixed;bottom:18px;right:18px;display:flex;gap:10px}
canvas{position:fixed;inset:0;pointer-events:none}
</style>
</head>
<body>

<header>
  <strong>AIAQUILA</strong>
  <span id="lvl"></span>
</header>

<main>
  <div id="stream"></div>
</main>

<div class="feedback">
  <button onclick="vote(1)">👍</button>
  <button onclick="vote(-1)">👎</button>
</div>

<canvas id="c"></canvas>

<script>
const S=JSON.parse(localStorage.getItem("aiaquila_state"))||{lvl:0.55,h:[]};
function save(){localStorage.setItem("aiaquila_state",JSON.stringify(S));}

function vote(v){
  S.lvl+=v*0.02;
  S.lvl=Math.max(0.45,Math.min(0.65,S.lvl));
  S.h.push({t:Date.now(),v});
  save();render();
}

function render(){
  document.getElementById("lvl").textContent="Circumstantial "+Math.round(S.lvl*100)+"%";
  let t="";
  if(S.lvl<0.5) t="Les faits sont exposés sans tension particulière.";
  else if(S.lvl<0.6) t="Le texte s’inscrit dans une continuité déjà assimilée.";
  else t="Le message paraît presque normalisé, comme intégré d’avance.";
  document.getElementById("stream").textContent=t;
}
render();

const c=document.getElementById("c"),x=c.getContext("2d");
function resize(){c.width=innerWidth;c.height=innerHeight}
onresize=resize;resize();
(function loop(){
  x.clearRect(0,0,c.width,c.height);
  for(let i=0;i<50+S.lvl*120;i++){
    x.fillStyle="rgba(100,180,255,0.08)";
    x.fillRect(Math.random()*c.width,Math.random()*c.height,1,1);
  }
  requestAnimationFrame(loop);
})();
</script>

</body>
</html>
HTML

# --- NGINX
if ! grep -q "location /aiaquila" "$NGINX_SITE"; then
  chattr -i "$NGINX_SITE" || true
  sed -i '/server_name fireinners.online;/a \
  location /aiaquila/ {\n\
    alias /var/www/aiaquila/;\n\
    index index.html;\n\
    try_files $uri $uri/ =404;\n\
  }\n' "$NGINX_SITE"
fi

nginx -t
systemctl reload nginx
chattr +i "$NGINX_SITE" || true

echo "== AIAQUILA READY =="
echo "➡ https://fireinners.online/aiaquila"
EOF

chmod +x /root/AIAQUILA_ROOT_FINAL.sh
bash /root/AIAQUILA_ROOT_FINAL.sh
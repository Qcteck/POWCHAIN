export async function connectPhantom() {
  const sol = window?.solana;
  if (!sol || !sol.isPhantom) {
    alert("Phantom wallet not found (install/enable Phantom extension)");
    return null;
  }
  const resp = await sol.connect({ onlyIfTrusted: false });
  return resp.publicKey.toString();
}
JS

cat > lib/onchain.js <<'JS'
import { Connection, PublicKey, clusterApiUrl } from "@solana/web3.js";

export async function fetchOnchainBalances(pubkey) {
  const conn = new Connection(clusterApiUrl("mainnet-beta"), "confirmed");
  const lamports = await conn.getBalance(new PublicKey(pubkey));
  return { SOL: lamports / 1e9 };
}
JS

cat > lib/balances.js <<'JS'
export async function fetchInternalBalances(pubkey) {
  const url = `/wolverine/traderone/api/balances2?wallet=${encodeURIComponent(pubkey)}`;
  const r = await fetch(url);
  const t = await r.text();
  if (!r.ok) throw new Error(`balances2 ${r.status}: ${t.slice(0,200)}`);
  try { return JSON.parse(t); } catch { return { raw: t }; }
}
JS

cat > components/WalletBox.jsx <<'JSX'
import { useState } from "react";
import { connectPhantom } from "../lib/wallet";
import { fetchOnchainBalances } from "../lib/onchain";
import { fetchInternalBalances } from "../lib/balances";

export default function WalletBox() {
  const [addr, setAddr] = useState("");
  const [onchain, setOnchain] = useState(null);
  const [internal, setInternal] = useState(null);
  const [err, setErr] = useState("");
  const [loading, setLoading] = useState(false);

  async function run() {
    setErr(""); setLoading(true);
    try {
      const a = await connectPhantom();
      if (!a) return;
      setAddr(a);
      const [oc, it] = await Promise.all([
        fetchOnchainBalances(a),
        fetchInternalBalances(a),
      ]);
      setOnchain(oc);
      setInternal(it);
    } catch (e) {
      setErr(String(e?.message || e));
    } finally {
      setLoading(false);
    }
  }

  const delta = (() => {
    if (!onchain || !internal || typeof internal !== "object") return null;
    const d = {};
    for (const k of Object.keys(onchain)) d[k] = Number(onchain[k]||0) - Number(internal[k]||0);
    return d;
  })();

  return (
    <div className="walletBox">
      <div className="walletTitle">Wallet</div>

      {!addr ? (
        <button className="btn ghost" onClick={run} disabled={loading}>
          {loading ? "Connecting..." : "Connect Phantom"}
        </button>
      ) : (
        <>
          <div className="muted">Connected</div>
          <code style={{fontSize:12, wordBreak:"break-all"}}>{addr}</code>

          <div style={{marginTop:10}}>
            <div className="muted small">On‑chain</div>
            <pre style={{margin:0}}>{JSON.stringify(onchain,null,2)}</pre>
          </div>

          <div style={{marginTop:10}}>
            <div className="muted small">TraderOne (balances2)</div>
            <pre style={{margin:0}}>{JSON.stringify(internal,null,2)}</pre>
          </div>

          <div style={{marginTop:10}}>
            <div className="muted small">Δ non crédité</div>
            <pre style={{margin:0}}>{JSON.stringify(delta,null,2)}</pre>
          </div>

          <div style={{marginTop:10}}>
            <button className="btn" onClick={run} disabled={loading}>
              {loading ? "Refreshing..." : "Refresh"}
            </button>
          </div>
        </>
      )}

      {err && <div className="bad small" style={{marginTop:10}}>{err}</div>}
    </div>
  );
}
JSX


const fs = require("fs");
const fsp = fs.promises;
const path = require("path");
const crypto = require("crypto");
const express = require("express");
const cors = require("cors");

const ENVFILE = "/opt/aiaquila/config/env";
function loadEnvFile(p){
  try{
    const s = fs.readFileSync(p,"utf8");
    for (const line of s.split("\n")){
      const t=line.trim(); if(!t||t.startsWith("#")) continue;
      const i=t.indexOf("="); if(i<0) continue;
      const k=t.slice(0,i).trim(); const v=t.slice(i+1).trim();
      if(!(k in process.env)) process.env[k]=v;
    }
  }catch{}
}
loadEnvFile(ENVFILE);

const PORT = Number(process.env.PORT||9688);
const HOST = process.env.HOST||"127.0.0.1";
const RPC_PRIMARY = process.env.SOL_RPC_PRIMARY||"https://api.mainnet-beta.solana.com";
const RPC_BACKUP  = process.env.SOL_RPC_BACKUP ||"https://api.mainnet-beta.solana.com";

const CFG_DIR="/opt/aiaquila/config";
const DATA_DIR="/opt/aiaquila/data";
const STATE_PATH=path.join(DATA_DIR,"state.json");
const POLICY_PATH=path.join(CFG_DIR,"exec_allowlist.json");
const ADMIN_TOKEN_PATH=path.join(CFG_DIR,"admin.token");

function now(){ return Date.now(); }
function dayKey(ts=Date.now()){
  const d=new Date(ts);
  const y=d.getUTCFullYear();
  const m=String(d.getUTCMonth()+1).padStart(2,"0");
  const da=String(d.getUTCDate()).padStart(2,"0");
  return `${y}${m}${da}`;
}
function sha256(x){ return crypto.createHash("sha256").update(x).digest("hex"); }

async function readJSON(p, fallback){
  try{ return JSON.parse(await fsp.readFile(p,"utf8")); }catch{ return fallback; }
}
async function writeJSONAtomic(p, obj){
  const tmp = p + ".tmp." + process.pid;
  const s = JSON.stringify(obj,null,2);
  await fsp.writeFile(tmp, s, "utf8");
  await fsp.rename(tmp, p);
}
async function loadPolicy(){
  const pol = await readJSON(POLICY_PATH, null);
  if(!pol) throw new Error("missing policy");
  return pol;
}
async function loadState(){
  const st = await readJSON(STATE_PATH, null);
  if(st) return st;
  const init={ pending:{}, usage:{}, audit:[] };
  await writeJSONAtomic(STATE_PATH, init);
  return init;
}
function auditPush(st, msg){
  st.audit.push({ts:now(), msg});
  if(st.audit.length>1000) st.audit=st.audit.slice(-1000);
}

function withTimeout(ms, p){
  let to;
  const t = new Promise((_,rej)=> to=setTimeout(()=>rej(new Error("timeout")), ms));
  return Promise.race([p.finally(()=>clearTimeout(to)), t]);
}

async function rpcCall(url, method, params){
  const body = {jsonrpc:"2.0", id:1, method, params};
  const res = await withTimeout(8000, fetch(url,{
    method:"POST",
    headers:{"content-type":"application/json"},
    body: JSON.stringify(body)
  }));
  if(!res.ok) throw new Error(`rpc_http_${res.status}`);
  const j = await res.json();
  if(j.error) throw new Error(`rpc_${j.error.code||"err"}_${j.error.message||"error"}`);
  return j.result;
}

async function getTxFinalized(sig){
  // getTransaction is best signal for finalized existence
  // try primary then backup
  try{
    return await rpcCall(RPC_PRIMARY,"getTransaction",[sig,{encoding:"json",commitment:"finalized",maxSupportedTransactionVersion:0}]);
  }catch(e1){
    return await rpcCall(RPC_BACKUP,"getTransaction",[sig,{encoding:"json",commitment:"finalized",maxSupportedTransactionVersion:0}]);
  }
}

async function policyCheckTransfer(pol, to, lamports, usageCount24h){
  if(pol.KILL_SWITCH) return {ok:false, why:"KILL_SWITCH"};
  const gl=pol.global||{};
  const allowAll = Number(pol.ALLOW_ALL_IF_EMPTY||0);
  const list = Array.isArray(pol.transfers)? pol.transfers : [];
  if(list.length===0 && !allowAll) return {ok:false, why:"ALLOWLIST_EMPTY_DENY"};
  let rule=null;
  if(list.length>0){
    rule = list.find(r=>String(r.to||"")===String(to));
    if(!rule) return {ok:false, why:"DEST_NOT_ALLOWED"};
  }
  const maxTx = Number(gl.maxTxPer24h||0);
  if(maxTx>0 && usageCount24h>=maxTx) return {ok:false, why:"QUOTA_24H"};
  const maxLam = Number((rule&&rule.maxLamports) || gl.maxLamportsPerTx || 0);
  if(maxLam>0 && lamports>maxLam) return {ok:false, why:"LAMPORTS_TOO_HIGH"};
  return {ok:true};
}

const app = express();
app.use(cors());
app.use(express.json({limit:"1mb"}));

app.get("/api/health", async (_req,res)=>{
  try{
    const pol = await loadPolicy();
    res.json({ok:true, ts:now(), rpc:{primary:RPC_PRIMARY, backup:RPC_BACKUP}, policy:{KILL_SWITCH:pol.KILL_SWITCH, ALLOW_ALL_IF_EMPTY:pol.ALLOW_ALL_IF_EMPTY}});
  }catch(e){
    res.status(500).json({ok:false, err:String(e.message||e)});
  }
});

app.get("/api/audit", async (_req,res)=>{
  const st = await loadState();
  res.json({ok:true, audit: st.audit.slice(-200)});
});

app.post("/api/pending/create", async (req,res)=>{
  try{
    const {type,to,lamports,fromPub} = req.body||{};
    if(type!=="transfer") return res.status(400).json({ok:false, err:"type_required_transfer"});
    if(!to || typeof to!=="string") return res.status(400).json({ok:false, err:"to_required"});
    const lam = Number(lamports);
    if(!Number.isFinite(lam) || lam<=0) return res.status(400).json({ok:false, err:"lamports_invalid"});
    const st = await loadState();
    const pol = await loadPolicy();
    const dk = dayKey();
    const used = Number((st.usage[dk]||0));
    const chk = await policyCheckTransfer(pol,to,lam,used);
    if(!chk.ok) return res.status(403).json({ok:false, err:chk.why});

    const payload = {type:"transfer", to, lamports: lam, fromPub: String(fromPub||"")};
    const payloadHash = sha256(JSON.stringify(payload));
    const pendingId = crypto.randomUUID();
    st.pending[pendingId] = {pendingId, status:"PENDING", payload, payloadHash, createdAt: now(), sig:null, committedAt:null};
    auditPush(st, `PENDING_CREATE ${pendingId} ${payloadHash}`);
    await writeJSONAtomic(STATE_PATH, st);
    res.json({ok:true, pendingId, payload, payloadHash, status:"PENDING"});
  }catch(e){
    res.status(500).json({ok:false, err:String(e.message||e)});
  }
});

app.post("/api/pending/approve", async (req,res)=>{
  try{
    const token = String(req.headers["x-aiaquila-admin"]||"");
    const real = (await fsp.readFile(ADMIN_TOKEN_PATH,"utf8")).trim();
    if(!token || token!==real) return res.status(401).json({ok:false, err:"admin_token_required"});
    const {pendingId} = req.body||{};
    if(!pendingId) return res.status(400).json({ok:false, err:"pendingId_required"});
    const st = await loadState();
    const p = st.pending[pendingId];
    if(!p) return res.status(404).json({ok:false, err:"pending_not_found"});
    if(p.status!=="PENDING") return res.json({ok:true, status:p.status});
    p.status="APPROVED";
    p.approvedAt=now();
    auditPush(st, `PENDING_APPROVE ${pendingId}`);
    await writeJSONAtomic(STATE_PATH, st);
    res.json({ok:true, pendingId, status:"APPROVED"});
  }catch(e){
    res.status(500).json({ok:false, err:String(e.message||e)});
  }
});

app.post("/api/exec/commit", async (req,res)=>{
  try{
    const {pendingId, sig, payloadHash} = req.body||{};
    if(!pendingId||!sig||!payloadHash) return res.status(400).json({ok:false, err:"pendingId_sig_payloadHash_required"});
    const st = await loadState();
    const p = st.pending[pendingId];
    if(!p) return res.status(404).json({ok:false, err:"pending_not_found"});
    if(p.payloadHash!==payloadHash) return res.status(403).json({ok:false, err:"payload_hash_mismatch"});
    if(p.status!=="APPROVED") return res.status(403).json({ok:false, err:"not_approved"});
    if(p.sig && p.sig===sig && p.status==="COMMITTED") return res.json({ok:true, status:"COMMITTED", sig});

    // Confirm finalized (explicit)
    const pol = await loadPolicy();
    const maxSec = Number((pol.global&&pol.global.maxConfirmSeconds) || 30);
    const start = now();
    let tx=null, lastErr=null;
    while((now()-start) < maxSec*1000){
      try{
        tx = await getTxFinalized(sig);
        if(tx) break;
      }catch(e){ lastErr=String(e.message||e); }
      await new Promise(r=>setTimeout(r, 600));
    }
    if(!tx) return res.status(504).json({ok:false, err:"finalized_timeout", lastErr});

    // Consume quota AFTER proof
    const dk = dayKey();
    st.usage[dk] = Number((st.usage[dk]||0)) + 1;
    p.sig = sig;
    p.status = "COMMITTED";
    p.committedAt = now();
    auditPush(st, `COMMIT_OK ${pendingId} sig=${sig}`);
    await writeJSONAtomic(STATE_PATH, st);

    res.json({ok:true, status:"COMMITTED", sig});
  }catch(e){
    res.status(500).json({ok:false, err:String(e.message||e)});
  }
});


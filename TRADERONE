cat >/root/WOLV_DEBUG_BAD_JSON_WORKER_AND_FIX_TOKEN.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

WORKER_URL="https://bbtrader-jup.paycashnostory.workers.dev"
API_PORT="3002"

Q="/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50"
LOCAL="http://127.0.0.1:${API_PORT}/api/swap/quote?inputMint=So11111111111111111111111111111111111111112&outputMint=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1&amount=10000000&slippageBps=50"

echo "=== [1] RAW Worker response (no token) ==="
curl -sS -i --max-time 12 "$WORKER_URL$Q" | head -n 30 || true
echo

echo "=== [2] RAW Local API response (/api/swap/quote) ==="
curl -sS -i --max-time 12 "$LOCAL" | head -n 40 || true
echo

echo "=== If you see 401/unauthorized above, paste token now (or press Enter to skip) ==="
read -r RELAY_TOKEN || true

if [ -n "${RELAY_TOKEN:-}" ]; then
  echo "=== [3] RAW Worker response WITH token ==="
  curl -sS -i --max-time 12 -H "x-relay-token: $RELAY_TOKEN" "$WORKER_URL$Q" | head -n 30 || true
  echo

  echo "=== [4] Patch backend to send x-relay-token in curlJson() ==="
  SWAP="/opt/wolverine-api/routes/swap.routes.js"
  [ -f "$SWAP" ] || { echo "ERR: $SWAP introuvable"; exit 1; }

  cp -a "$SWAP" "/root/wolv_backups/swap.routes.js.$(date +%s).bak" 2>/dev/null || true

  perl -0777 -i -pe '
    my $tok = $ENV{"RELAY_TOKEN"} // "";
    die "missing token\n" if $tok eq "";
    # inject only if not already present
    if($_ !~ /x-relay-token:/){
      s/\[\s*"-sS"/["-sS","-H","x-relay-token: ".$tok]/s;
    }
  ' "$SWAP" RELAY_TOKEN="$RELAY_TOKEN"

  systemctl restart wolverine-api.service || true
  sleep 1

  echo "=== [5] Test Local API again ==="
  curl -sS -i --max-time 12 "$LOCAL" | head -n 40 || true
  echo
fi

echo "DONE ✅"
BASH

bash /root/WOLV_DEBUG_BAD_JSON_WORKER_AND_FIX_TOKEN.sh
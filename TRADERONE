cat >/root/cleanup_enabled_bak_and_retest.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DST="/etc/nginx/sites-disabled/backup_cleanup_${TS}"
mkdir -p "$DST"

echo "== Move any *.bak* from sites-enabled to $DST =="
shopt -s nullglob
for f in /etc/nginx/sites-enabled/*.bak*; do
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== What is enabled now =="
ls -lah /etc/nginx/sites-enabled

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload nginx =="
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/cleanup_enabled_bak_and_retest.sh
/root/cleanup_enabled_bak_and_retest.sh
cat >/root/test_traderone_8585_and_nginx.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 1) local backend (8585) =="
curl -sS -D- http://127.0.0.1:8585/api/health | head -n 30 || true

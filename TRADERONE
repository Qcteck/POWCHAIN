bash -lc 'cat >/tmp/TRADERONE_FLY.sh <<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
echo "=== META ==="; date; hostname; echo
echo "=== PORTS (80/443/3000/8484/8585/8080) ==="
sudo ss -lntp | egrep ":(80|443|3000|8484|8585|8080)\b" || true
echo
echo "=== CURL LOCAL (3000/8484) ==="
for p in 3000 8484; do
  echo "--- 127.0.0.1:$p ---"
  curl -m 2 -sSI "http://127.0.0.1:$p" | head -n 5 || echo "no response"
done
echo
echo "=== NGINX matches traderone/opt/traderone-opt ==="
sudo nginx -T 2>/dev/null | egrep -n "traderone|/opt/traderone-opt|proxy_pass|server_name|listen" | head -n 200 || true
echo
echo "=== SITES files ==="
sudo grep -RIn --binary-files=without-match -E "traderone|/opt/traderone-opt" /etc/nginx/sites-available /etc/nginx/sites-enabled 2>/dev/null || true
echo
echo "=== SYSTEMD (traderone) ==="
systemctl status traderone.service --no-pager 2>/dev/null || true
BASH
bash /tmp/TRADERONE_FLY.sh'
SNIP="/etc/nginx/snippets/fireinners-wolverine.conf"

echo "== ATTRS BEFORE ==" 
lsattr -a "$SNIP" || true

echo "== REMOVE immutable/append flags ==" 
chattr -i -a "$SNIP" 2>/dev/null || true

echo "== ATTRS AFTER ==" 
lsattr -a "$SNIP" || true

echo "== TEST WRITE ==" 
echo "# WRITE_TEST $(date -Is)" >> "$SNIP"

echo "OK: write succeeded"
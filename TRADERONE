cat >/root/fix_redirect_loop_443.sh <<'BASH'
#!/usr/bin/env bash
set -e

DOMAIN="fireinners.online"
CERT="/etc/ssl/fireinners/fullchain.pem"
KEY="/etc/ssl/fireinners/privkey.pem"

SSL_AV="/etc/nginx/sites-available/fireinners.online-ssl"
SSL_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"

ts="$(date +%Y%m%d_%H%M%S)"
mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

# backup si existe
[ -f "$SSL_AV" ] && cp -a "$SSL_AV" "${SSL_AV}.bak_$ts" || true

cat >"$SSL_AV" <<NGINX
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name ${DOMAIN} www.${DOMAIN};

  ssl_certificate     ${CERT};
  ssl_certificate_key ${KEY};

  root /var/www;
  index index.html;

  # /  -> /wolverine/ (1 seule fois)
  location = / {
    return 301 /wolverine/;
  }

  # /wolverine -> /wolverine/ (1 seule fois)
  location = /wolverine {
    return 301 /wolverine/;
  }

  # servir l'app (SPA)
  location ^~ /wolverine/ {
    try_files \$uri \$uri/ /wolverine/index.html;
  }
}
NGINX

ln -sf "$SSL_AV" "$SSL_EN"

nginx -t
systemctl restart nginx

echo "OK. Test local:"
curl -kIL --max-redirs 5 https://127.0.0.1/wolverine/ | sed -n '1,30p'
BASH

chmod +x /root/fix_redirect_loop_443.sh
/root/fix_redirect_loop_443.sh
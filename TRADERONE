cat >/root/patch_phantom_static_html.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"

# 1) Trouver la racine nginx qui sert /wolverine/
ROOT="$(nginx -T 2>/dev/null | awk '
  $0 ~ /location\s+\^\~\s+\/wolverine\// {inloc=1}
  inloc && $1=="root"  {gsub(/;$/,"",$2); print $2; exit}
  inloc && $1=="alias" {gsub(/;$/,"",$2); print $2; exit}
  inloc && $0 ~ /}/ {inloc=0}
')"

if [[ -z "${ROOT:-}" ]]; then
  # fallback classique
  for d in /var/www /usr/share/nginx/html /srv/www; do
    [[ -d "$d/wolverine" ]] && ROOT="$d" && break
  done
fi

[[ -n "${ROOT:-}" ]] || { echo "[ERR] Impossible de trouver la racine nginx pour /wolverine/"; exit 1; }

# 2) Déterminer le fichier index
if [[ -d "$ROOT/wolverine" ]]; then
  TARGET="$ROOT/wolverine/index.html"
elif [[ -f "$ROOT/index.html" ]]; then
  TARGET="$ROOT/index.html"
else
  echo "[ERR] index.html introuvable (ROOT=$ROOT)"
  exit 1
fi

echo "[*] ROOT=$ROOT"
echo "[*] TARGET=$TARGET"

# 3) Backup
ts="$(date +%Y%m%d_%H%M%S)"
cp -a "$TARGET" "${TARGET}.bak_${ts}"
echo "[OK] Backup -> ${TARGET}.bak_${ts}"

# 4) Inject JS (idempotent)
if grep -q "PHANTOM_CONNECT_PATCH" "$TARGET"; then
  echo "[OK] Patch déjà présent, rien à faire."
  exit 0
fi

perl -0777 -i -pe '
my $js = qq{
<!-- PHANTOM_CONNECT_PATCH -->
<script>
(function(){
  function short(pk){ return pk.slice(0,4)+"…"+pk.slice(-4); }

  async function connectPhantom(){
    if(!window.solana || !window.solana.isPhantom){
      alert("Phantom introuvable (installe l’extension Phantom)");
      return;
    }
    try{
      const r = await window.solana.connect();
      const pk = r.publicKey.toBase58();

      const st = document.querySelector(".walletBox .muted") || document.getElementById("walletState");
      if(st) st.textContent = "Connected: " + short(pk);

      // Optionnel: garde en mémoire
      window.__WALLET_PK__ = pk;
      console.log("Phantom connected:", pk);
    }catch(e){
      console.error("Phantom connect error:", e);
      alert(String(e?.message || e));
    }
  }

  document.addEventListener("DOMContentLoaded", function(){
    // essaie de trouver le bouton existant "Connect Phantom"
    const btn =
      document.querySelector(".walletBox .btn.ghost") ||
      Array.from(document.querySelectorAll("button")).find(b => /connect phantom/i.test(b.textContent||""));

    if(btn){
      btn.addEventListener("click", function(ev){
        ev.preventDefault();
        connectPhantom();
      });
    }

    // si déjà connecté
    if(window.solana?.isPhantom && window.solana.publicKey){
      const pk = window.solana.publicKey.toBase58();
      const st = document.querySelector(".walletBox .muted") || document.getElementById("walletState");
      if(st) st.textContent = "Connected: " + short(pk);
    }

    // update si changement de compte
    window.solana?.on?.("accountChanged", function(pubkey){
      const st = document.querySelector(".walletBox .muted") || document.getElementById("walletState");
      if(st) st.textContent = pubkey ? ("Connected: " + short(pubkey.toBase58())) : "Not connected";
    });
  });
})();
</script>
<!-- /PHANTOM_CONNECT_PATCH -->
};

s@</body>@$js\n</body>@i or die "ERR: </body> introuvable pour injection\n";
' "$TARGET"

echo "[OK] JS injecté dans $TARGET"

# 5) Reload nginx (safe)
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "✅ Ouvre: https://${DOMAIN}/wolverine/"
echo "Puis clique 'Connect Phantom' (dans un navigateur avec l’extension Phantom)."
BASH

chmod +x /root/patch_phantom_static_html.sh
/root/patch_phantom_static_html.sh fireinners.online
cat >/root/find_traderone_backend_and_patch.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${DOMAIN:-fireinners.online}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"
APPLY="${APPLY:-0}"          # 0 = scan only, 1 = patch nginx
PORT="${PORT:-}"             # si APPLY=1, mets le port ici (ex: 8080)

echo "[*] DOMAIN=$DOMAIN"
echo "[*] VHOST=$VHOST"
echo "[*] APPLY=$APPLY PORT=${PORT:-<auto>}"
echo

# 1) ports qui écoutent (hors 22/80/443)
echo "== LISTEN ports =="
ss -lntp | awk '
/LISTEN/{
  p=$4; sub(/.*:/,"",p);
  if(p!="22" && p!="80" && p!="443") print p " :: " $0
}' | sort -n | tee /tmp/listen_ports.txt
echo

probe() {
  local p="$1" path="$2"
  curl -sS -m 1 -o /dev/null -w "%{http_code}" "http://127.0.0.1:${p}${path}" 2>/dev/null || echo "000"
}

# 2) probe sur chaque port
echo "== PROBES (HTTP codes) =="
echo "port  /health  /ping  /api/ping  /status  /"
echo "----  ------  -----  ---------  -------  ---"
BEST=""
BESTSCORE=0

while read -r line; do
  p="$(echo "$line" | awk '{print $1}')"
  h1="$(probe "$p" "/health")"
  h2="$(probe "$p" "/ping")"
  h3="$(probe "$p" "/api/ping")"
  h4="$(probe "$p" "/status")"
  h5="$(probe "$p" "/")"

  # score simple: tout sauf 404/000 compte
  score=0
  for h in "$h1" "$h2" "$h3" "$h4" "$h5"; do
    if [[ "$h" != "404" && "$h" != "000" ]]; then score=$((score+1)); fi
  done

  printf "%-4s  %-6s  %-5s  %-9s  %-7s  %-3s  (score=%s)\n" "$p" "$h1" "$h2" "$h3" "$h4" "$h5" "$score"

  if (( score > BESTSCORE )); then
    BESTSCORE="$score"
    BEST="$p"
  fi
done < <(cut -d' ' -f1 /tmp/listen_ports.txt | sort -nu)

echo
echo "[*] BEST_CANDIDATE_PORT=${BEST:-none} (score=$BESTSCORE)"
echo

# 3) montre les services node/pm2/systemd/docker (indices)
echo "== NODE/PM2/SYSTEMD/DOCKER hints =="
command -v pm2 >/dev/null 2>&1 && pm2 ls || true
systemctl --no-pager --type=service | egrep -i 'trader|wolverine|node|pm2|api' || true
docker ps --format 'table {{.Names}}\t{{.Ports}}\t{{.Image}}' 2>/dev/null || true
echo

if [[ "$APPLY" != "1" ]]; then
  echo "DRY-RUN terminé."
  echo "👉 Si tu vois un port qui répond (pas 404), relance:"
  echo "   APPLY=1 PORT=LE_PORT /root/find_traderone_backend_and_patch.sh"
  exit 0
fi

# 4) patch nginx vers le port choisi
if [[ -z "$PORT" ]]; then
  PORT="$BEST"
fi
[[ -n "$PORT" ]] || { echo "[ERR] aucun PORT. Relance avec PORT=XXXX"; exit 1; }

API_UPSTREAM="http://127.0.0.1:${PORT}"
echo "[*] Patching nginx: /wolverine/traderone/api/ -> $API_UPSTREAM"

ts="$(date +%Y%m%d_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/backup_traderone_patch_${ts}"
mkdir -p "$BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
echo "[OK] Backup -> $BACKDIR/$(basename "$VHOST")"

export API_UPSTREAM
perl -0777 -i -pe '
my $up = $ENV{API_UPSTREAM} // die "missing API_UPSTREAM";

s/\n\s*# --- traderone api proxy \(injected\) ---.*?\n\s*# --- end traderone api proxy ---\n//ms;

my $block = qq{
  # --- traderone api proxy (injected) ---
  location ^~ /wolverine/traderone/api/ {
    rewrite ^/wolverine/traderone/api/?(.*)\$ /\$1 break;

    if (\$request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
      add_header Access-Control-Allow-Headers "Authorization,Content-Type,Accept" always;
      return 204;
    }

    proxy_pass $up;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
  }
  # --- end traderone api proxy ---
};

s/\n(\s*location\s+\^\~\s+\/wolverine\/\s*\{)/\n$block\n$1/ms
  or die "ERR: cannot find location ^~ /wolverine/ block\n";
' "$VHOST"

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "Test public:"
curl -sSI "https://${DOMAIN}/wolverine/traderone/api/" | head -n 20 || true
BASH

chmod +x /root/find_traderone_backend_and_patch.sh

# run (scan only)
DOMAIN=fireinners.online APPLY=0 /root/find_traderone_backend_and_patch.sh
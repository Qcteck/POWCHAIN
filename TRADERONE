<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><title>AIAQUILA – RSS + EmberBrain</title><style>
body{font-family:Arial;background:#0b1d3a;color:#eaf2ff;margin:0;padding:20px}
.box{background:#102a5a;border-radius:10px;padding:15px;margin-bottom:15px}
button{background:#1e90ff;border:none;color:#fff;padding:8px 14px;border-radius:6px;cursor:pointer}
input{padding:6px;border-radius:6px;border:none}
#logs{background:#000;color:#0f0;height:180px;overflow:auto;padding:10px;font-size:12px}
</style></head><body>

<h2>AIAQUILA</h2>

<div class="box">
<b>Préférence crypto</b><br>
<input id="pref" placeholder="Bitcoin">
<button onclick="savePref()">Sauver</button>
</div>

<div class="box">
<b>Flux RSS (réels)</b><br>
<button onclick="loadRSS()">Charger les articles</button>
</div>

<div class="box">
<b>Conseils crypto</b>
<div id="advice"></div>
</div>

<div class="box">
<b>Discussion</b><br>
<input id="msg" placeholder="Écris ici">
<button onclick="sendUser()">Envoyer</button>
</div>

<div class="box">
<b>Logs</b>
<pre id="logs"></pre>
</div>

<script>
/* ===== EmberBrain ===== */
const EmberBrain={
state:{memory:[]},
observe(t,p){this.state.memory.push({t,p,ts:Date.now()})},
analyze(){
let s=0;this.state.memory.forEach(m=>{
if(/bull|up|surge|record/i.test(m.p.title))s++;
if(/bear|down|crash|hack/i.test(m.p.title))s--;
});
return s;
},
recommend(){
const s=this.analyze();
if(s>2)return"Tendance haussière détectée";
if(s<-2)return"Risque élevé détecté";
return"Marché neutre";
}
};

/* ===== Utils ===== */
function log(t){const l=document.getElementById("logs");l.textContent+=t+"\n";l.scrollTop=l.scrollHeight}
function speak(t){if(!t)return;const u=new SpeechSynthesisUtterance(t);u.lang="fr-FR";speechSynthesis.cancel();speechSynthesis.speak(u)}
function savePref(){localStorage.setItem("pref",pref.value);log("Préférence sauvegardée")}

/* ===== RSS ===== */
const FEEDS=[
"https://rsshub.app/coindesk",
"https://rsshub.app/cointelegraph",
"https://rsshub.app/news/crypto"
];

async function loadRSS(){
log("Chargement RSS...");
EmberBrain.state.memory=[];
for(const f of FEEDS){
try{
const r=await fetch(f);
const x=await r.text();
parseRSS(x);
}catch(e){log("Erreur RSS")}
}
const reco=EmberBrain.recommend();
document.getElementById("advice").textContent=reco;
speak(reco);
}

function parseRSS(xml){
const doc=new DOMParser().parseFromString(xml,"text/xml");
doc.querySelectorAll("item").forEach(i=>{
const a={
title:i.querySelector("title")?.textContent||"",
link:i.querySelector("link")?.textContent||""
};
EmberBrain.observe("rss",a);
log("Article: "+a.title);
});
}

/* ===== User ===== */
function sendUser(){
const t=msg.value;if(!t)return;
EmberBrain.observe("user",{text:t});
speak("Message reçu");
msg.value="";
}

/* ===== Init ===== */
pref.value=localStorage.getItem("pref")||"";
log("AIAQUILA prêt");
</script>

</body></html>
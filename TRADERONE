cat >/root/WOLVERINE_SOLANA_VAULT_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== WOLVERINE SOLANA VAULT FIX ==="

[ -f "$HTML" ] || { echo "index.html manquant"; exit 1; }

cp -a "$HTML" "${HTML}.bak_${TS}"

python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

BLOCK="""
<section id="phantomVault" style="border:2px solid #0ff;padding:16px;max-width:520px">
<h3>Phantom</h3>
<button id="connectPhantom">Connect Phantom</button>
<div>Adresse: <span id="userAddr">—</span></div>
<div>SOL: <span id="userSol">—</span></div>

<hr>

<h3>Vault</h3>
<button id="createVault">Créer mon Vault</button>
<div>Vault: <span id="vaultAddr">—</span></div>
<div>Vault SOL: <span id="vaultSol">—</span></div>

<input id="amountSol" placeholder="Montant SOL">
<button id="sendSol">Déposer SOL</button>
</section>

<script src="/wolverine/vendor/solana-web3.min.js"></script>
<script>
let connection,provider,userPub,vaultPub;

const RPC="https://api.mainnet-beta.solana.com";

const q=id=>document.getElementById(id);

async function refreshBalance(pub,el){
 const lam=await connection.getBalance(pub);
 el.textContent=(lam/1e9).toFixed(6);
}

q("connectPhantom").onclick=async()=>{
 provider=window.solana;
 if(!provider||!provider.isPhantom) return alert("Phantom absent");
 const r=await provider.connect();
 userPub=r.publicKey;
 q("userAddr").textContent=userPub.toBase58();
 connection=new solanaWeb3.Connection(RPC,"confirmed");
 refreshBalance(userPub,q("userSol"));
};

q("createVault").onclick=async()=>{
 const r=await fetch("/wolverine/traderone/api/vault");
 const j=await r.json();
 vaultPub=new solanaWeb3.PublicKey(j.address);
 q("vaultAddr").textContent=j.address;
 refreshBalance(vaultPub,q("vaultSol"));
};

q("sendSol").onclick=async()=>{
 if(!userPub||!vaultPub) return alert("Connecte Phantom + Vault");
 const amt=parseFloat(q("amountSol").value);
 if(!amt||amt<=0) return;
 const tx=new solanaWeb3.Transaction().add(
  solanaWeb3.SystemProgram.transfer({
   fromPubkey:userPub,
   toPubkey:vaultPub,
   lamports:Math.floor(amt*1e9)
  })
 );
 tx.feePayer=userPub;
 tx.recentBlockhash=(await connection.getLatestBlockhash()).blockhash;
 const signed=await provider.signTransaction(tx);
 const sig=await connection.sendRawTransaction(signed.serialize());
 await connection.confirmTransaction(sig);
 refreshBalance(userPub,q("userSol"));
 refreshBalance(vaultPub,q("vaultSol"));
 alert("SOL envoyé");
};
</script>
"""

# purge anciens blocs
import re
s=re.sub(r"<section id=\"phantomVault\"[\\s\\S]*?</section>","",s)

s=s.replace("</body>",BLOCK+"\n</body>")
p.write_text(s)
print("Vault Solana fonctionnel injecté")
PY

nginx -t && systemctl reload nginx


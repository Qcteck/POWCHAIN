cat >/root/batch_root_audit.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/root"
echo "=== [1/2] AUDIT GIT sous $ROOT ==="
mapfile -t REPOS < <(find "$ROOT" -maxdepth 4 -type d -name ".git" 2>/dev/null | sed 's#/.git$##' | sort -u)

if [ "${#REPOS[@]}" -eq 0 ]; then
  echo "Aucun repo git trouvé sous $ROOT"
else
  for r in "${REPOS[@]}"; do
    echo
    echo "----- REPO: $r -----"
    cd "$r"
    echo "Remote(s):"
    git remote -v || true
    echo "Branch:"
    git rev-parse --abbrev-ref HEAD 2>/dev/null || true
    echo "Dernier commit:"
    git --no-pager log -1 --oneline 2>/dev/null || true
    echo "Status:"
    git status -sb 2>/dev/null || true
    echo "Diff (stat):"
    git --no-pager diff --stat 2>/dev/null || true
  done
fi

echo
echo "=== [2/2] AUDIT NGINX (doublons / includes / ports) ==="

echo "--- nginx -t ---"
nginx -t || true

echo
echo "--- Ports 80/443 écoutent ? ---"
ss -lntp | egrep '(:80|:443)\b' || true

echo
echo "--- Doublons location /wolverine (nginx -T) ---"
nginx -T 2>/dev/null | grep -nE 'location\s+/wolverine\b' || true

echo
echo "--- Tous les includes (et ceux qui pointent vers des snippets) ---"
nginx -T 2>/dev/null | grep -nE '^\s*include\s+' || true

echo
echo "--- Snippets attendus mais manquants (check rapide) ---"
# liste les includes /etc/nginx/snippets/*.conf et vérifie qu'ils existent
nginx -T 2>/dev/null \
 | awk '/include[ \t]+\/etc\/nginx\/snippets\//{print $2}' \
 | sed 's/;//' \
 | while read -r f; do
     [ -e "$f" ] || echo "MANQUANT: $f"
   done

echo
echo "=== FIN ==="
BASH

chmod +x /root/batch_root_audit.sh
/root/batch_root_audit.sh
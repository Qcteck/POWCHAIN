bash <<'EOF'
set -e

URL="https://www.fireinners.online/wolverine"

echo "=== VERIFY WOLVERINE (REAL CHECK) ==="

# 1) Vérifier que le port 443 écoute
if ss -lnt | grep -q ':443'; then
  echo "[OK] Port 443 ouvert (nginx actif)"
else
  echo "[ERR] Aucun service sur le port 443"
  exit 1
fi

# 2) Vérifier que Wolverine répond
if curl -fsSL "$URL" >/dev/null; then
  echo "[OK] Wolverine accessible en HTTPS"
else
  echo "[ERR] Wolverine ne répond pas en HTTPS"
  exit 1
fi

# 3) Vérifier contenu HTML
CONTENT=$(curl -fsSL "$URL" | head -n 5)
echo "[INFO] HTML servi :"
echo "$CONTENT"

echo "=== WOLVERINE ONLINE ==="
echo "URL : $URL"
EOF
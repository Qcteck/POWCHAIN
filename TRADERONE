cat >/tmp/fix_nginx_wolverine_api.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

CONF="/etc/nginx/sites-available/fireinners"
TS="$(date +%s)"
cp -a "$CONF" "$CONF.bak.$TS"
echo "Backup: $CONF.bak.$TS"

# 1) supprime anciens blocs proxy wolverine/api si présents (pour éviter doublons)
perl -0777 -i -pe 's/\n\s*# WOLVERINE_API_PROXY_BEGIN.*?# WOLVERINE_API_PROXY_END\s*\n/\
/sg' "$CONF" || true

# 2) injecte un bloc PRIORITAIRE dans le server 443, juste après "root /var/www/fireinners;"
perl -0777 -i -pe 's/(server\s*\{[^\}]*listen\s+443[^\}]*?root\s+\/var\/www\/fireinners\s*;\s*)/$1\n  # WOLVERINE_API_PROXY_BEGIN\n  location ^~ \/wolverine\/traderone\/api\/ {\n    proxy_http_version 1.1;\n    proxy_set_header Host \$host;\n    proxy_set_header X-Real-IP \$remote_addr;\n    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Proto \$scheme;\n    proxy_pass http:\/\/127.0.0.1:8585;\n  }\n  # WOLVERINE_API_PROXY_END\n\n/s' "$CONF"

nginx -t
systemctl reload nginx

WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
echo "== TEST (doit etre JSON, pas HTML) =="
curl -ksS -D- "https://fireinners.online/wolverine/traderone/api/balances2?wallet=$WALLET" | head -c 220; echo
SH

bash /tmp/fix_nginx_wolverine_api.sh
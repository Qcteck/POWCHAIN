cat >/root/restart_traderone_with_env_and_logs.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/traderone-opt"
LOG="/var/log/traderone-opt.log"
PORT="8585"

echo "== 0) Preconditions =="
test -d "$APP_DIR" || { echo "Missing $APP_DIR"; exit 1; }
test -f "$APP_DIR/server.js" || { echo "Missing $APP_DIR/server.js"; ls -lah "$APP_DIR" | head; exit 1; }
test -f "$APP_DIR/.env" || { echo "Missing $APP_DIR/.env (create it first)"; exit 1; }

echo
echo "== 1) Kill anything listening on :$PORT =="
PID="$(ss -lntp 2>/dev/null | sed -n "s/.*:\($PORT\).*pid=\([0-9]\+\).*/\2/p" | head -n1 || true)"
if [ -n "${PID:-}" ] && [ -d "/proc/$PID" ]; then
  echo "Killing PID $PID on :$PORT"
  kill "$PID" || true
  sleep 1
  kill -9 "$PID" 2>/dev/null || true
fi

echo
echo "== 2) Prepare log file =="
mkdir -p "$(dirname "$LOG")"
touch "$LOG"
chmod 600 "$LOG"

echo
echo "== 3) Start traderone with env loaded (.env) -> $LOG =="
set -a
# shellcheck disable=SC1090
source "$APP_DIR/.env"
set +a

# quick sanity (no secrets printed)
if [ -z "${LIFI_API_KEY:-}" ]; then
  echo "LIFI_API_KEY is still EMPTY after loading .env ❌"
else
  echo "LIFI_API_KEY is present after loading .env ✅"
fi

cd "$APP_DIR"
nohup /usr/bin/node "$APP_DIR/server.js" >>"$LOG" 2>&1 & disown || true

echo
echo "== 4) Wait + verify port =="
sleep 2
if ss -lntp 2>/dev/null | grep -q ":$PORT"; then
  echo "OK ✅ listening on :$PORT"
else
  echo "NOT LISTENING ❌ on :$PORT"
  echo
  echo "== 5) Tail log =="
  tail -n 120 "$LOG" || true
  echo
  echo "== 6) Run in foreground for 8s to capture crash (safe) =="
  timeout 8s /usr/bin/node "$APP_DIR/server.js" || true
  echo
  echo "== 7) Tail log again =="
  tail -n 200 "$LOG" || true
fi

echo
echo "DONE ✅"
BASH

chmod +x /root/restart_traderone_with_env_and_logs.sh
/root/restart_traderone_with_env_and_logs.sh
#!/usr/bin/env bash
set -e

FILE="/var/www/wolverine/index.html"

echo "=== WOLVERINE HARD FIX ==="
echo "Target: $FILE"

if [ ! -f "$FILE" ]; then
  echo "❌ FILE NOT FOUND"
  exit 1
fi

cp "$FILE" "$FILE.bak_$(date +%s)"

echo "== Removing bad absolute URLs =="
sed -i 's|https://wolverine|/wolverine|g' "$FILE"
sed -i 's|http://wolverine|/wolverine|g' "$FILE"
sed -i 's|https://127.0.0.1:[0-9]\+||g' "$FILE"
sed -i 's|http://127.0.0.1:[0-9]\+||g' "$FILE"

echo "== Forcing relative balance endpoint =="
sed -i 's|fetch([^)]*balance[^)]*)|fetch("/wolverine/api/balance/"+pubkey)|g' "$FILE"

echo "== VERIFY =="
grep -n "wolverine/api" "$FILE"

echo "== Reload nginx =="
nginx -t
systemctl reload nginx

echo "=== FIX APPLIED ==="
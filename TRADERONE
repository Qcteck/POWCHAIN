cat >/root/WOLV_WIRE_STRATEGY_BACKEND.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== [1] Locate running Node backend (port -> PID -> cwd) ==="
PID=""
# find any node process listening (common ports)
for p in 3000 3001 8080 8000 5000 5173 4000; do
  if ss -lptn 2>/dev/null | grep -qE "LISTEN.*:${p}.*users:\(\(\"node\""; then
    PID="$(ss -lptn 2>/dev/null | awk -v P=":${p}" '$0~P && $0~"node"{print $NF}' | head -n1 | sed -E 's/.*pid=([0-9]+).*/\1/')"
    [ -n "$PID" ] && break
  fi
done

if [ -z "$PID" ]; then
  # fallback: any node listening
  PID="$(ss -lptn 2>/dev/null | awk '$0~"LISTEN" && $0~"users:" && $0~"node"{print $NF}' | head -n1 | sed -E 's/.*pid=([0-9]+).*/\1/')"
fi

BACK_DIR=""
if [ -n "${PID:-}" ] && [ -d "/proc/$PID" ]; then
  BACK_DIR="$(readlink -f /proc/$PID/cwd || true)"
fi

echo "PID=${PID:-none}"
echo "BACK_DIR=${BACK_DIR:-none}"

echo "=== [2] If not found, try systemd ExecStart ==="
SERVICE=""
if [ -z "${BACK_DIR:-}" ] || [ ! -d "$BACK_DIR" ]; then
  # find a service running node
  SERVICE="$(systemctl list-units --type=service --state=running --no-pager 2>/dev/null | awk '{print $1}' | grep -E '\.service$' | head -n 200 | while read -r s; do
    es="$(systemctl show -p ExecStart --value "$s" 2>/dev/null || true)"
    if echo "$es" | grep -qi "node"; then echo "$s"; break; fi
  done || true)"

  if [ -n "$SERVICE" ]; then
    echo "Found node service: $SERVICE"
    # try get WorkingDirectory
    WD="$(systemctl show -p WorkingDirectory --value "$SERVICE" 2>/dev/null || true)"
    if [ -n "$WD" ] && [ -d "$WD" ]; then BACK_DIR="$WD"; fi
  fi
fi

echo "SERVICE=${SERVICE:-none}"
echo "BACK_DIR=${BACK_DIR:-none}"

echo "=== [3] If still not found, try PM2 ==="
if [ -z "${BACK_DIR:-}" ] || [ ! -d "$BACK_DIR" ]; then
  if command -v pm2 >/dev/null 2>&1; then
    # pick first pm2 app and find its cwd via pid
    PM2PID="$(pm2 jlist 2>/dev/null | grep -oE '"pid":[0-9]+' | head -n1 | cut -d: -f2 || true)"
    if [ -n "$PM2PID" ] && [ -d "/proc/$PM2PID" ]; then
      BACK_DIR="$(readlink -f /proc/$PM2PID/cwd || true)"
      echo "PM2 PID=$PM2PID -> BACK_DIR=$BACK_DIR"
    fi
  fi
fi

echo "BACK_DIR=${BACK_DIR:-none}"
[ -n "${BACK_DIR:-}" ] && [ -d "$BACK_DIR" ] || {
  echo "ERR: Impossible de localiser automatiquement le backend qui tourne."
  echo "Donne moi le chemin du backend (ex: /opt/traderone/server) et je te fais un batch exact."
  exit 1
}

echo "=== [4] Ensure it's a Node project ==="
if [ ! -f "$BACK_DIR/package.json" ]; then
  echo "WARN: pas de package.json dans $BACK_DIR"
  echo "Je cherche un sous-dossier Node proche..."
  hit="$(find "$BACK_DIR" -maxdepth 3 -type f -name package.json 2>/dev/null | head -n1 || true)"
  [ -n "$hit" ] || { echo "ERR: aucun package.json trouvé"; exit 1; }
  BACK_DIR="$(dirname "$hit")"
  echo "Using BACK_DIR=$BACK_DIR"
fi

echo "=== [5] Copy strategy routes into backend ==="
mkdir -p "$BACK_DIR/routes"

SRC="/root/wolv_backend_patch/routes/strategy.routes.js"
if [ ! -f "$SRC" ]; then
  # recreate it if missing
  cat >"$SRC" <<'JS'
const express = require("express");
const router = express.Router();

const state = {};
function getWallet(req){ return (req.body.wallet || req.query.wallet || "").trim(); }
function ensureWallet(wallet){ if(!state[wallet]) state[wallet] = { active:null, history:[] }; }

function makeHandlers(name){
  const base = "/" + name;

  router.post(base + "/start", (req,res)=>{
    const wallet=getWallet(req); if(!wallet) return res.status(400).send("missing wallet");
    ensureWallet(wallet);
    const cfg = Object.assign({}, req.body);
    state[wallet].active = { name, mode:(req.body.mode||name), status:"RUNNING", config:cfg, startedAt:Date.now() };
    state[wallet].history.push({ts:Date.now(), event:"START", name, cfg});
    res.json({ok:true, active:state[wallet].active});
  });

  router.post(base + "/pause", (req,res)=>{
    const wallet=getWallet(req); if(!wallet) return res.status(400).send("missing wallet");
    ensureWallet(wallet);
    if(state[wallet].active && state[wallet].active.name===name){
      state[wallet].active.status="PAUSED";
      state[wallet].history.push({ts:Date.now(), event:"PAUSE", name});
    }
    res.json({ok:true, active:state[wallet].active});
  });

  router.post(base + "/stop", (req,res)=>{
    const wallet=getWallet(req); if(!wallet) return res.status(400).send("missing wallet");
    ensureWallet(wallet);
    if(state[wallet].active && state[wallet].active.name===name){
      state[wallet].history.push({ts:Date.now(), event:"STOP", name});
      state[wallet].active=null;
    } else {
      state[wallet].history.push({ts:Date.now(), event:"STOP_NOOP", name});
    }
    res.json({ok:true, active:state[wallet].active});
  });

  router.get(base + "/status", (req,res)=>{
    const wallet=getWallet(req); if(!wallet) return res.status(400).send("missing wallet");
    ensureWallet(wallet);
    res.json({ok:true, active:state[wallet].active, last:state[wallet].history.slice(-10)});
  });
}

["dca","grid","arbitrage","trend"].forEach(makeHandlers);
module.exports = router;
JS
fi

cp -a "$SRC" "$BACK_DIR/routes/strategy.routes.js"
echo "OK copied -> $BACK_DIR/routes/strategy.routes.js"

echo "=== [6] Wire route into server entry ==="
# try to find entry file
ENTRY=""
# prefer common names
for f in server.js app.js index.js main.js src/server.js src/app.js src/index.js; do
  if [ -f "$BACK_DIR/$f" ]; then ENTRY="$BACK_DIR/$f"; break; fi
done
# fallback: first file that creates express app
if [ -z "$ENTRY" ]; then
  ENTRY="$(grep -RIl --no-messages -E "express\\(|const app *= *express\\(" "$BACK_DIR" --include="*.js" --include="*.cjs" --include="*.mjs" | head -n1 || true)"
fi
[ -n "$ENTRY" ] || { echo "ERR: impossible de trouver le fichier serveur (server.js/app.js)"; exit 1; }

echo "ENTRY=$ENTRY"
TS="$(date +%s)"
mkdir -p /root/wolv_backups
cp -a "$ENTRY" "/root/wolv_backups/backend_entry.$TS.bak"

# add require if missing
if ! grep -q "strategy\\.routes" "$ENTRY"; then
  # insert require after express require or after app creation
  perl -0777 -i -pe '
    my $s=$_;
    if($s !~ /strategyRoutes/){
      if($s =~ /const\s+express\s*=\s*require\([^)]+\);\s*/s){
        $s =~ s/(const\s+express\s*=\s*require\([^)]+\);\s*)/$1\nconst strategyRoutes = require(".\/routes\/strategy.routes");\n/s;
      } elsif($s =~ /const\s+app\s*=\s*express\(\)\s*;\s*/s){
        $s =~ s/(const\s+app\s*=\s*express\(\)\s*;\s*)/$1\nconst strategyRoutes = require(".\/routes\/strategy.routes");\n/s;
      } else {
        $s = "const strategyRoutes = require(\".\/routes\/strategy.routes\");\n".$s;
      }
    }
    $_=$s;
  ' "$ENTRY"
fi

# add app.use if missing
if ! grep -q "/api/strategy" "$ENTRY"; then
  # put near other app.use
  perl -0777 -i -pe '
    my $s=$_;
    if($s !~ /\/api\/strategy/){
      if($s =~ /app\.use\(/s){
        $s =~ s/(app\.use\([^\n;]+\);\s*)/$1\napp.use("\/api\/strategy", strategyRoutes);\n/s;
      } else {
        $s .= "\napp.use(\"/api/strategy\", strategyRoutes);\n";
      }
    }
    $_=$s;
  ' "$ENTRY"
fi

echo "WIRED ✅ /api/strategy"

echo "=== [7] Restart backend ==="
# if we have a service, restart it
if [ -n "${SERVICE:-}" ]; then
  systemctl restart "$SERVICE" && echo "systemctl restart $SERVICE OK" || true
elif command -v pm2 >/dev/null 2>&1; then
  pm2 restart all && echo "pm2 restart all OK" || true
else
  echo "WARN: pas de service/pm2 trouvé. Redémarre ton node manuellement si nécessaire."
fi

echo "=== [8] Quick test ==="
curl -sS "http://127.0.0.1:3000/api/strategy/dca/status?wallet=test" 2>/dev/null || true
curl -sS "http://127.0.0.1:8080/api/strategy/dca/status?wallet=test" 2>/dev/null || true

echo ""
echo "DONE ✅"
echo "Backend entry backup: /root/wolv_backups/backend_entry.$TS.bak"
echo "If something breaks, restore it:"
echo "  cp -a /root/wolv_backups/backend_entry.$TS.bak $ENTRY"
BASH

bash /root/WOLV_WIRE_STRATEGY_BACKEND.sh
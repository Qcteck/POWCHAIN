cat >/tmp/WOLVERINE_INDEX_FIX.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

# --- import askorupdate (si présent) ---
ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then . "$ASKLIB"; else
  askorupdate_file(){ local p="$1"; local content="$2"; mkdir -p "$(dirname "$p")"; printf "%s" "$content" >"$p"; }
  askorupdate_yesno(){ local q="$1"; read -r -p "$q (y/N) " a || true; case "${a,,}" in y|yes) return 0;; *) return 1;; esac; }
fi

say(){ printf "%s\n" "$*"; }

NGX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
DEFAULT_DIR="/opt/fireinners/frontend-react/app/dist/wolverine"
OUTDIR=""
URL="https://fireinners.online/wolverine/"
PING_URL="https://fireinners.online/wolverine/api/ping"

say "=== BATCH FLY (read-only) ==="
say "whoami: $(whoami)  host: $(hostname)  date: $(date -u +%FT%TZ)"
command -v nginx >/dev/null 2>&1 || { say "ERREUR: nginx absent"; exit 1; }
command -v curl  >/dev/null 2>&1 || { say "ERREUR: curl absent"; exit 1; }

if [ -f "$NGX_SITE" ]; then
  # détecter un bloc location /wolverine et récupérer alias/root si présent
  # (heuristique simple, sans parser complet nginx)
  CAND=$(awk '
    $1=="location" && $2=="/wolverine" {inloc=1}
    inloc && $1=="alias" {gsub(";","",$2); print $2; exit}
    inloc && $1=="root"  {gsub(";","",$2); print $2 "/wolverine"; exit}
    inloc && $0 ~ /}/ {inloc=0}
  ' "$NGX_SITE" 2>/dev/null || true)
  if [ -n "${CAND:-}" ]; then OUTDIR="$CAND"; fi
fi

if [ -z "${OUTDIR:-}" ]; then OUTDIR="$DEFAULT_DIR"; fi
say "OUTDIR: $OUTDIR"
say "Cible URL: $URL"

say "Test URL ping (si déjà en place):"
curl -ksS --max-time 5 "$PING_URL" | head -c 120 || true
echo

if ! askorupdate_yesno "Continuer et (re)installer index.html pour /wolverine ?"; then
  say "Stop."
  exit 0
fi

say "=== MEGA BATCH (install index) ==="
mkdir -p "$OUTDIR"
chmod 755 "$OUTDIR" || true

HTML='<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WOLVERINE • FireInners</title><style>:root{--bg:#070a12;--p:#0c1222;--l:#1b2a44;--t:#e7f0ff;--m:#9fb3d7;--ok:#b9ffcf;--bad:#ffb3b3;--a:#9ff}*{box-sizing:border-box}html,body{margin:0;height:100%;background:radial-gradient(900px 600px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(700px 450px at 80% 20%,#101a33 0%,transparent 55%),var(--bg);color:var(--t);font:14px system-ui}a{color:var(--a);text-decoration:none}a:hover{text-decoration:underline}#wrap{max-width:980px;margin:0 auto;padding:18px}#top{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:12px}#brand{display:flex;align-items:center;gap:10px}#logo{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#ffb35a,#ff5b5b,#9f6bff);box-shadow:0 0 18px rgba(159,111,255,.25)}#ttl{font-weight:800;letter-spacing:.6px}#sub{color:var(--m);font-size:12px;margin-top:2px}#card{background:linear-gradient(180deg,rgba(12,18,34,.85),rgba(7,10,20,.75));border:1px solid rgba(27,42,68,.7);border-radius:16px;padding:14px}#row{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0}button{border:1px solid rgba(27,42,68,.85);background:#0b1222;color:var(--t);padding:10px 12px;border-radius:12px;cursor:pointer}button:hover{filter:brightness(1.08)}.pill{display:inline-flex;gap:8px;align-items:center;padding:8px 10px;border-radius:999px;border:1px solid rgba(27,42,68,.7);background:rgba(12,18,34,.55)}.ok{color:var(--ok)}.bad{color:var(--bad)}#log{white-space:pre-wrap;background:#060812;border:1px solid rgba(27,42,68,.65);border-radius:12px;padding:10px;min-height:88px;color:#cfe0ff}#foot{margin-top:12px;color:var(--m);font-size:12px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between}</style></head><body><div id="wrap"><div id="top"><div id="brand"><div id="logo"></div><div><div id="ttl">WOLVERINE</div><div id="sub">FireInners • /wolverine</div></div></div><div class="pill" id="st">Etat: <b id="stb">?</b></div></div><div id="card"><div style="font-weight:700;margin-bottom:6px">Console rapide</div><div id="row"><button id="bPing">Tester API /ping</button><button id="bOpen">Ouvrir /api/ping</button><button id="bReload">Refresh</button></div><div id="log"></div><div style="margin-top:10px;display:flex;gap:10px;flex-wrap:wrap"><span class="pill">URL: <a href="/wolverine/" target="_blank" rel="noreferrer">/wolverine/</a></span><span class="pill">Ping: <a href="/wolverine/api/ping" target="_blank" rel="noreferrer">/wolverine/api/ping</a></span></div></div><div id="foot"><div>Si tu ne reçois rien sur Telegram alors que l’état ne change pas, c’est normal (anti-spam).</div><div><a href="https://fireinners.online" target="_blank" rel="noreferrer">fireinners.online</a></div></div></div><script>(()=>{const $=s=>document.querySelector(s),log=$("#log"),stb=$("#stb"),st=$("#st");const u="/wolverine/api/ping";const w=(t)=>{log.textContent=(t+(log.textContent?("\n"+log.textContent):"")).slice(0,6000)};const set=(ok,txt)=>{stb.textContent=txt;stb.className=ok?"ok":"bad"};async function ping(){set(false,"...");try{const r=await fetch(u,{cache:"no-store"});const t=await r.text();const ok=/pong/i.test(t)||r.ok;set(ok,ok?"UP":"DOWN");w(new Date().toISOString()+"  "+(ok?"OK":"ERR")+"  "+t.slice(0,180));}catch(e){set(false,"DOWN");w(new Date().toISOString()+"  ERR  "+String(e).slice(0,180));}}$("#bPing").onclick=ping;$("#bOpen").onclick=()=>window.open(u,"_blank");$("#bReload").onclick=()=>location.reload();ping();})();</script></body></html>'

TARGET="$OUTDIR/index.html"
askorupdate_file "$TARGET" "$HTML"
chmod 644 "$TARGET" || true

say "Index installé: $TARGET"
say "Test nginx:"
nginx -t

say "Reload nginx:"
systemctl reload nginx

say "Test HTTP local:"
curl -ksS --max-time 6 "$URL" | head -c 200 || true
echo
say "DONE."
SH
chmod +x /tmp/WOLVERINE_INDEX_FIX.sh
bash /tmp/WOLVERINE_INDEX_FIX.sh
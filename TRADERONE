import http from "http";
import fs from "fs";

const PORT = process.env.PORT || 3000;
const START_TIME = Date.now();

function json(res, code, data) {
  res.writeHead(code, { "Content-Type": "application/json" });
  res.end(JSON.stringify(data, null, 2));
}

const server = http.createServer(async (req, res) => {
  try {
    // ---- ROUTE ROOT (HTML simple) ----
    if (req.method === "GET" && req.url === "/") {
      res.writeHead(200, { "Content-Type": "text/html" });
      return res.end(`
<!DOCTYPE html>
<html>
<body style="background:#111;color:#eee;font-family:Arial">
<h1>AMCQ Pilot</h1>
<button onclick="go()">START</button>
<pre id="out"></pre>
<script>
async function go(){
  const r = await fetch("/start",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({count:3,context:"BTC"})});
  document.getElementById("out").textContent = JSON.stringify(await r.json(),null,2);
}
</script>
</body>
</html>`);
    }

    // ---- HEALTH CHECK ----
    if (req.method === "GET" && req.url === "/health") {
      return json(res, 200, {
        ok: true,
        service: "TraderOne",
        uptime: Math.floor((Date.now() - START_TIME) / 1000),
        pid: process.pid
      });
    }

    // ---- STATUS ----
    if (req.method === "GET" && req.url === "/status") {
      return json(res, 200, {
        running: true,
        mode: "safe",
        memory: process.memoryUsage(),
        time: Date.now()
      });
    }

    // ---- START (SAFE / MOCK) ----
    if (req.method === "POST" && req.url === "/start") {
      let body = "";
      req.on("data", c => body += c);
      req.on("end", () => {
        let payload = {};
        try { payload = JSON.parse(body || "{}"); } catch {}
        return json(res, 200, {
          ok: true,
          action: "start",
          received: payload,
          note: "SAFE MODE — no trading executed",
          time: Date.now()
        });
      });
      return;
    }

    // ---- 404 ----
    json(res, 404, { error: "Not found" });

  } catch (e) {
    json(res, 500, { ok: false, error: e.message });
  }
});

server.listen(PORT, "0.0.0.0", () => {
  console.log("TraderOne LIVE on", PORT);
});






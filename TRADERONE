#!/usr/bin/env bash
set -euo pipefail

### PATHS
BASE="/opt/wolverine"
FRONT="/var/www/wolverine"
API="$BASE/api"
DATA="$BASE/data"
KEY="$BASE/master.key"

### INSTALL
mkdir -p "$API" "$DATA" "$FRONT"
cd "$BASE"

### NODE
if ! command -v node >/dev/null; then
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt install -y nodejs
fi

npm init -y >/dev/null
npm install express cors body-parser crypto-js @solana/web3.js bs58 >/dev/null

### MASTER KEY (AES)
if [ ! -f "$KEY" ]; then
  openssl rand -hex 32 >"$KEY"
fi

####################################
# BACKEND API
####################################
cat >"$API/server.js"<<'JS'
const fs=require("fs"),express=require("express"),cors=require("cors"),body=require("body-parser");
const CryptoJS=require("crypto-js");
const {Keypair,Connection,PublicKey}=require("@solana/web3.js");

const app=express();
app.use(cors());app.use(body.json());

const MASTER=fs.readFileSync("/opt/wolverine/master.key","utf8").trim();
const DATA="/opt/wolverine/data";
const RPC="https://api.mainnet-beta.solana.com";
const USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const conn=new Connection(RPC);

function enc(s){return CryptoJS.AES.encrypt(s,MASTER).toString()}
function dec(s){return CryptoJS.AES.decrypt(s,MASTER).toString(CryptoJS.enc.Utf8)}

app.post("/create-vault",(req,res)=>{
  const kp=Keypair.generate();
  const encPriv=enc(Buffer.from(kp.secretKey).toString("hex"));
  fs.writeFileSync(`${DATA}/${kp.publicKey}.json`,JSON.stringify({encPriv,stop:false,trades:[]}));
  res.json({vault:kp.publicKey.toString()});
});

app.post("/stop",(req,res)=>{
  const f=`${DATA}/${req.body.vault}.json`;
  const j=JSON.parse(fs.readFileSync(f));
  j.stop=true;fs.writeFileSync(f,JSON.stringify(j));
  res.json({ok:true});
});

app.post("/withdraw",(req,res)=>{
  res.json({status:"READY (hook trading engine here)"});
});

app.get("/balance/:pub",async(req,res)=>{
  const pub=req.params.pub;
  const sol=await conn.getBalance(new PublicKey(pub));
  const tok=await conn.getParsedTokenAccountsByOwner(new PublicKey(pub),{mint:new PublicKey(USDC)});
  let usdc=0;tok.value.forEach(v=>usdc+=Number(v.account.data.parsed.info.tokenAmount.uiAmount||0));
  res.json({sol:sol/1e9,usdc});
});

app.listen(3000,()=>console.log("API 3000"));
JS


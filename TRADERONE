cat >/root/TRADERONE_VAULT_FULL_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== TRADERONE VAULT — FULL FIX ==="

API_DIR="/opt/traderone"
API_FILE="$API_DIR/server.js"
TS="$(date +%Y%m%d_%H%M%S)"

# 1) BACKUP
cp -a "$API_FILE" "$API_FILE.bak_vault_$TS"

# 2) AJOUT ROUTES VAULT (SAFE, ISOLÉ)
grep -q "VAULT_ROUTES_START" "$API_FILE" || sed -i "/app.use/a\\
/* === VAULT_ROUTES_START === */\\
const vaults=new Map();\\
\\
app.post('/vault/create',(req,res)=>{\\
  const {owner}=req.body||{};\\
  if(!owner) return res.status(400).json({error:'owner missing'});\\
  if(!vaults.has(owner)){\\
    vaults.set(owner,{sol:0});\\
  }\\
  res.json({vault:owner,sol:vaults.get(owner).sol});\\
});\\
\\
app.post('/vault/deposit',(req,res)=>{\\
  const {owner,amount}=req.body||{};\\
  if(!vaults.has(owner)) return res.status(404).json({error:'vault not found'});\\
  vaults.get(owner).sol+=Number(amount||0);\\
  res.json({ok:true,sol:vaults.get(owner).sol});\\
});\\
\\
app.get('/vault/status',(req,res)=>{\\
  const owner=req.query.owner;\\
  if(!vaults.has(owner)) return res.json({exists:false});\\
  res.json({exists:true,sol:vaults.get(owner).sol});\\
});\\
/* === VAULT_ROUTES_END === */" "$API_FILE"

# 3) RESTART TRADERONE
pm2 restart traderone-vault || pm2 restart traderone || true
sleep 2

# 4) TEST LOCAL
echo "--- TEST LOCAL ---"
curl -s http://127.0.0.1:3000/vault/status?owner=test || true

echo "=== VAULT BACKEND OK ==="
BASH

chmod +x /root/TRADERONE_VAULT_FULL_FIX.sh
/root/TRADERONE_VAULT_FULL_FIX.sh
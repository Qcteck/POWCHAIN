cat >/root/FIX_USDC_WOLVERINE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIX USDC WOLVERINE (SAFE MODE) ==="

### 0. SAVEPOINT OBLIGATOIRE
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then
  echo "[0/5] Savepoint avant correction"
  /root/WOLVERINE_SAVEPOINT.sh
else
  echo "ERREUR: Savepoint absent"
  exit 1
fi

HTML="/var/www/wolverine/index.html"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

echo "[1/5] Vérification fichier frontend"
[ -f "$HTML" ] || { echo "index.html introuvable"; exit 1; }

cp -a "$HTML" "${HTML}.bak_usdc_fix_$(date +%s)"

echo "[2/5] Suppression anciens blocs USDC défectueux (si présents)"
sed -i '/USDC_MINT/d' "$HTML"
sed -i '/getTokenAccountsByOwner/d' "$HTML"

echo "[3/5] Injection fonction USDC propre (non destructive)"
sed -i '/<\/body>/i \
<script>\n\
const USDC_MINT="'$USDC_MINT'";\n\
async function getUSDC(pub){\n\
 try{\n\
  const c=new solanaWeb3.Connection(RPC);\n\
  const a=await c.getParsedTokenAccountsByOwner(new solanaWeb3.PublicKey(pub),{mint:new solanaWeb3.PublicKey(USDC_MINT)});\n\
  let t=0;\n\
  a.value.forEach(v=>t+=v.account.data.parsed.info.tokenAmount.uiAmount||0);\n\
  return t.toFixed(6);\n\
 }catch(e){return "0";}\n\
}\n\
</script>' "$HTML"

echo "[4/5] Forçage refresh USDC après connexion wallet"
sed -i 's/USDC:[^<]*/USDC: <span id="usdc">-<\/span>/' "$HTML"
sed -i '/refresh()/a document.getElementById("usdc").innerText=await getUSDC(USER_PUB);' "$HTML" || true

echo "[5/5] Purge cache nginx + reload"
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx

echo "=== FIX USDC APPLIQUÉ ==="
echo "Recharge la page avec CTRL+SHIFT+R"
BASH

chmod +x /root/FIX_USDC_WOLVERINE.sh
/root/FIX_USDC_WOLVERINE.sh
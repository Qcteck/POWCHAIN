n connect(){try{ph=window.solana;if(!ph||!ph.isPhantom){log("Phantom introuvable (ouvre dans Phantom ou installe l’extension).");return}const r=await ph.connect();pub=r.publicKey;conn=new solanaWeb3.Connection(SOLRPC,{commitment:"confirmed"});$("#addr").textContent=pub.toBase58();$("#btnDisc").disabled=false;$("#btnRefresh").disabled=false;log("CONNECTED");await refresh()}catch(e){log("CONNECT ERR: "+(e?.message||e))}}async function disconnect(){try{if(ph&&ph.disconnect) await ph.disconnect()}catch(e){}pub=null;conn=null;$("#addr").textContent="—";$("#sol").textContent="—";$("#usdc").textContent="—";$("#btnDisc").disabled=true;$("#btnRefresh").disabled=true;log("DISCONNECTED")}$("#btnConnect").onclick=connect;$("#btnDisc").onclick=disconnect;$("#btnRefresh").onclick=refresh;log("READY")})();</script></body></html>

HTML
}

write_nginx_include(){
  say "Write nginx include -> $INC"
  mkdir -p "$INCDIR"
  cat >"$INC"<<'NGX'
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
location ^~ /wolverine/traderone/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}
NGX
}

disable_duplicate_fireinners_vhosts(){
  say "Disable duplicate fireinners.online vhosts (sites-enabled)"
  mkdir -p "$BK/disabled_sitesenabled"
  shopt -s nullglob
  for f in "$SITESEN"/*; do
    [ -e "$f" ] || continue
    if [ "$(readlink -f "$f" 2>/dev/null || echo "$f")" = "$VHOST" ]; then
      continue
    fi
    if grep -qE "server_name[[:space:]]+.*\b${DOMAIN}\b" "$f" 2>/dev/null; then
      say "Disable: $f"
      cp -a "$f" "$BK/disabled_sitesenabled/" 2>/dev/null || true
      rm -f "$f" || true
    fi
  done
  shopt -u nullglob
}

ensure_vhost_enabled(){
  say "Ensure vhost enabled -> $VHOST"
  [ -f "$VHOST" ] || { say "ERR: missing $VHOST"; exit 1; }
  ln -sf "$VHOST" "$SITESEN/$(basename "$VHOST")"
}

inject_include_into_ssl_server(){
  say "Inject include into SSL server block (once)"
  local tmp="$BK/fireinners.online-ssl.tmp"
  local inc_line="include $INC;"
  awk -v inc="$inc_line" -v dom="$DOMAIN" '
  BEGIN{in_srv=0;depth=0;is_ssl=0;has_dom=0;has_inc=0;inserted=0}
  function countbr(s,  n){
    n=gsub(/\{/,"{",s); depth+=n;
    n=gsub(/\}/,"}",s); depth-=n;
  }
  {
    line=$0
    if(line ~ /^[[:space:]]*server[[:space:]]*\{/){
      in_srv=1; depth=0; is_ssl=0; has_dom=0; has_inc=0;
      countbr(line); print; next
    }
    if(in_srv){
      if(line ~ /listen[[:space:]]+443/){ is_ssl=1 }
      if(line ~ /server_name/ && line ~ dom){ has_dom=1 }
      if(index(line, inc) > 0){ has_inc=1 }
      if(depth==0 && line ~ /^[[:space:]]*\}/){
        if(is_ssl && has_dom && !has_inc && !inserted){
          print "  " inc
          inserted=1
        }
        print line
        in_srv=0; next
      }
      countbr(line); print; next
    }
    print
  }' "$VHOST" >"$tmp"
  cp -a "$tmp" "$VHOST"
}

nginx_test_reload(){
  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx
}

tests(){
  say "TEST local (bypass CF) -> /wolverine/"
  curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,15p" || true
  say "TEST public -> /wolverine/"
  curl -skI "https://${DOMAIN}/wolverine/" | sed -n "1,15p" || true
  say "TEST local bytes -> /wolverine/"
  curl -sk --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | head -c 220 || true; echo
}

rollback(){
  say "ROLLBACK nginx from backup"
  [ -d "$BK/nginx/nginx" ] || return 0
  rm -rf /etc/nginx.broken 2>/dev/null || true
  mv /etc/nginx /etc/nginx.broken 2>/dev/null || true
  cp -a "$BK/nginx/nginx" /etc/nginx 2>/dev/null || true
  nginx -t || true
  systemctl restart nginx || true
}

main(){
  need_root
  mkdir -p "$BK"
  say "WV_MEGA_FIX_404 :: start"
  backup_all
  unfreeze_all

  write_html
  write_nginx_include
  disable_duplicate_fireinners_vhosts
  ensure_vhost_enabled
  inject_include_into_ssl_server

  if ! nginx_test_reload; then
    rollback
    exit 1
  fi

  tests
  refreeze_best

  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
}

main "$@"
BASH
sed -i "s/\r$//" /root/WV_MEGA_FIX_404.sh || true
chmod +x /root/WV_MEGA_FIX_404.sh
bash /root/WV_MEGA_FIX_404.sh'
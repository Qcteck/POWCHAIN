bash <<'BASH'
set -e

echo "=== CLEAN ==="
pkill -f wolverine-balances || true
rm -rf /opt/wolverine-balances
mkdir -p /opt/wolverine-balances
cd /opt/wolverine-balances

echo "=== INIT ==="
npm init -y >/dev/null
npm install express @solana/web3.js >/dev/null

cat > server.js <<'JS'
import express from "express";
import { Connection, PublicKey } from "@solana/web3.js";

const app = express();
const RPC = "https://api.mainnet-beta.solana.com";
const conn = new Connection(RPC);

app.get("/balances/:addr", async (req, res) => {
  try {
    const pub = new PublicKey(req.params.addr.trim());

    const lamports = await conn.getBalance(pub);
    const sol = lamports / 1e9;

    const accts = await conn.getParsedTokenAccountsByOwner(
      pub,
      { mint: new PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1") }
    );

    let usdc = 0;
    for (const a of accts.value) {
      usdc += a.account.data.parsed.info.tokenAmount.uiAmount || 0;
    }

    res.json({ sol, usdc });
  } catch (e) {
    res.status(400).json({ error: e.message });
  }
});

app.listen(3010, () => {
  console.log("BALANCES API ON 3010");
});
JS

node server.js

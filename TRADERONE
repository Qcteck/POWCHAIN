set -euo pipefail

echo "=== 1) Trouver TOUS les package.json (hors node_modules) ==="
mapfile -t PKGS < <(find / -type f -name package.json \
  -not -path "*/node_modules/*" -not -path "*/.npm/*" -not -path "*/.cache/*" 2>/dev/null | head -n 200)

if [ "${#PKGS[@]}" -eq 0 ]; then
  echo "KO: aucun package.json trouvé sur le serveur"
  exit 1
fi

# Filtre ceux qui ressemblent à un frontend
FRONT=()
for p in "${PKGS[@]}"; do
  if grep -qE '"react"|"vite"|"next"|"react-dom"' "$p"; then
    FRONT+=("$p")
  fi
done

if [ "${#FRONT[@]}" -eq 0 ]; then
  echo "KO: aucun package.json react/vite/next trouvé"
  echo "INFO: voici les 30 premiers package.json:"
  printf "%s\n" "${PKGS[@]}" | head -n 30
  exit 1
fi

echo "=== 2) Candidats FRONTEND ==="
printf "%s\n" "${FRONT[@]}" | sed 's#/package.json$##' | nl -ba | head -n 50
echo
echo -n "Choisis le numéro: "
read -r N

REPO_DIR="$(printf "%s\n" "${FRONT[@]}" | sed 's#/package.json$##' | sed -n "${N}p")"
[ -n "${REPO_DIR:-}" ] || { echo "KO: choix invalide"; exit 1; }

cd "$REPO_DIR"
echo "=== FRONT SELECTED ==="
pwd
ls -lah | head
echo

echo "=== 3) Vérif git + remotes ==="
git rev-parse --is-inside-work-tree
git remote -v || true
echo

echo "=== 4) Si pas de remote origin, on te demande l'URL GitHub ==="
if ! git remote | grep -qx origin; then
  echo -n "Colle l’URL GitHub (HTTPS ou SSH) puis Enter: "
  read -r URL
  [ -n "${URL:-}" ] || { echo "KO: URL vide"; exit 1; }
  git remote add origin "$URL"
fi

echo "=== 5) Push branche ==="
BR="wolverine-ui-v2"
git checkout -b "$BR" 2>/dev/null || git checkout "$BR"
git add -A
git commit -m "Wolverine UI v2" || true
git push -u origin "$BR"
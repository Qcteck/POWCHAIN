cat >/root/WOLV_USE_CF_WORKER_RELAY.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

WORKER_URL="https://TON-WORKER.workers.dev"   # <-- change
RELAY_TOKEN="TON_TOKEN"                        # <-- change
SWAP="/opt/wolverine-api/routes/swap.routes.js"

cp -a "$SWAP" "/root/wolv_backups/swap.routes.js.$(date +%s).bak" || true

sed -i -E \
  "s#const JUP_QUOTE = \".*\";#const JUP_QUOTE = \"${WORKER_URL}/quote\";#g; \
   s#const JUP_SWAP  = \".*\";#const JUP_SWAP  = \"${WORKER_URL}/swap\";#g" \
  "$SWAP"

# inject token header in curlJson calls (simple: add -H x-relay-token)
perl -0777 -i -pe '
  s/\["-sS",/"-H","x-relay-token: '"$RELAY_TOKEN"'"],\n      ["-sS",/s;
' "$SWAP" || true

systemctl restart wolverine-api.service
echo "OK ✅ relay Cloudflare branché"
BASH

bash /root/WOLV_USE_CF_WORKER_RELAY.sh
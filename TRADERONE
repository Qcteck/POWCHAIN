cat >/root/WOLV_PATCH_SWAP_TO_CF_WORKER_CLEAN.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

WORKER_URL="https://XXX.workers.dev"   # <-- METS TON URL
RELAY_TOKEN="XXX"                      # <-- METS TON TOKEN
SWAP="/opt/wolverine-api/routes/swap.routes.js"

[ -f "$SWAP" ] || { echo "ERR: $SWAP introuvable"; exit 1; }

mkdir -p /root/wolv_backups
cp -a "$SWAP" "/root/wolv_backups/swap.routes.js.$(date +%s).bak" || true

# 1) replace JUP endpoints
sed -i -E \
  "s#const JUP_QUOTE = \".*\";#const JUP_QUOTE = \"${WORKER_URL}/quote\";#g; \
   s#const JUP_SWAP  = \".*\";#const JUP_SWAP  = \"${WORKER_URL}/swap\";#g" \
  "$SWAP"

# 2) inject token header in curlJson() base args (clean)
perl -0777 -i -pe '
  my $s = $_;
  if($s =~ /function\s+curlJson\s*\(/ && $s !~ /x-relay-token/){
    $s =~ s/\[\s*"-sS"/["-sS", "-H", "x-relay-token: '"$ENV{RELAY_TOKEN}"'"]/s;
  }
  $_ = $s;
' RELAY_TOKEN="$RELAY_TOKEN" "$SWAP"

systemctl restart wolverine-api.service
echo "OK ✅ swap.routes.js -> Cloudflare Worker + token"
BASH

bash /root/WOLV_PATCH_SWAP_TO_CF_WORKER_CLEAN.sh
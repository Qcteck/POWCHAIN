cat >/root/auto_map_traderone_api.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"

# Récupère l'upstream actuel depuis le vhost (proxy_pass ...;), sinon fallback
UP="$(grep -oP 'proxy_pass\s+\Khttp[^;]+' "$VHOST" | head -n 1 || true)"
UP="${UP:-http://127.0.0.1:9696}"

echo "[*] DOMAIN=$DOMAIN"
echo "[*] VHOST=$VHOST"
echo "[*] UPSTREAM=$UP"

code() { curl -s -o /dev/null -w "%{http_code}" "$1" || echo "000"; }

# On cherche une base qui existe réellement sur le backend
CANDIDATES=(
  "/" 
  "/api/" "/api/ping" "/api/health" "/api/status"
  "/health" "/ping" "/status"
  "/traderone/api/" "/traderone/api/ping" "/traderone/api/health"
  "/traderone/" "/traderone/ping"
)

BEST_BASE=""
for p in "${CANDIDATES[@]}"; do
  h="$(code "${UP}${p}")"
  echo "  - probe ${UP}${p} => $h"
  if [[ "$h" != "404" && "$h" != "000" ]]; then
    # on préfère une base qui ressemble à l'API
    if [[ "$p" == "/traderone/api/"* ]]; then BEST_BASE="/traderone/api/"; break; fi
    if [[ "$p" == "/api/"* ]]; then BEST_BASE="/api/"; fi
    [[ -z "$BEST_BASE" ]] && BEST_BASE="/"
  fi
done

BEST_BASE="${BEST_BASE:-/}"
echo
echo "[*] BEST_BASE=$BEST_BASE"
echo "[*] On va proxy /wolverine/traderone/api/ -> ${UP}${BEST_BASE}"

# Backup
ts="$(date +%Y%m%d_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/backup_map_${ts}"
mkdir -p "$BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
echo "[OK] Backup -> $BACKDIR/$(basename "$VHOST")"

# Patch proxy_pass dans le bloc traderone injecté (ou remplace un bloc existant)
perl -0777 -i -pe '
my $up = $ENV{UP};
my $base = $ENV{BEST_BASE};

# remplace proxy_pass dans location /wolverine/traderone/api/
s@(location\s+\^\~\s+/wolverine/traderone/api/\s*\{.*?proxy_pass\s+)(http[^;]+)(;.*?)@${1}$up$base${3}@ms;

' UP="$UP" BEST_BASE="$BEST_BASE" "$VHOST"

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== Tests =="
echo "-- Public:"
curl -sSI "https://${DOMAIN}/wolverine/traderone/api/" | head -n 20 || true
echo
echo "-- Local (backend):"
curl -sS "${UP}${BEST_BASE}" | head -n 5 || true
BASH

chmod +x /root/auto_map_traderone_api.sh
/root/auto_map_traderone_api.sh fireinners.online
cat >/root/MEGA_BUNDLER_PATCH_ACTIVE_VHOSTS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BUNDLER_ACTIVEPATCH_${TS}"
mkdir -p "$BK"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run as root"

DOMAIN="fireinners.online"
NGINX_CONF="/etc/nginx/nginx.conf"
INC_DIR="/etc/nginx/includes"
INC_BUNDLER="${INC_DIR}/bundler_routes.inc"

WEBROOT_BUNDLER="/var/www/bundler"
DATA_DIR="/opt/bundler_data"
API_HOST="127.0.0.1"
API_PORT="9797"

say "backup: /etc/nginx"
tar -C /etc -czf "$BK/etc_nginx.tgz" nginx >/dev/null 2>&1 || true

say "ensure dirs"
mkdir -p "$INC_DIR" "$WEBROOT_BUNDLER" "$DATA_DIR"
chmod 755 "$WEBROOT_BUNDLER" "$DATA_DIR" || true

say "ensure fallback index.html exists"
if [ ! -f "$WEBROOT_BUNDLER/index.html" ]; then
  cat >"$WEBROOT_BUNDLER/index.html" <<'HTML'
<!doctype html><meta charset="utf-8"><title>Bundler</title><style>body{font-family:system-ui;margin:40px;background:#0b0f14;color:#e7eef7}a{color:#7ec8ff}</style><h1>Bundler</h1><p>Fallback index.html present in /var/www/bundler.</p>
HTML
  chmod 644 "$WEBROOT_BUNDLER/index.html" || true
fi

say "write include: $INC_BUNDLER"
cat >"$INC_BUNDLER" <<EOF
# Bundler UI + API (active vhost patch $TS)

location = /bundler { return 301 /bundler/; }
location = /bundler/api { return 301 /bundler/api/; }
location = /bundler/data { return 301 /bundler/data/; }

location ^~ /bundler/api/ {
  proxy_pass http://$API_HOST:$API_PORT/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
}
location ^~ /bundler/data/ {
  alias $DATA_DIR/;
  add_header Cache-Control "no-store" always;
  try_files \$uri =404;
}
location ^~ /bundler/ {
  alias $WEBROOT_BUNDLER/;
  try_files \$uri \$uri/ /bundler/index.html;
}
EOF

say "capture nginx -T"
nginx -T >"$BK/nginx_T.txt" 2>&1 || true

say "detect FIRST (active) server blocks for $DOMAIN on :80 and :443"
python3 - <<'PY' "$DOMAIN" "$BK/nginx_T.txt" >"$BK/active_vhosts.env"
import re,sys
domain=sys.argv[1]
p=sys.argv[2]
lines=open(p,"r",errors="ignore").read().splitlines()

cur_file=None
cur_line=0
servers=[]
i=0
while i<len(lines):
    line=lines[i]
    m=re.match(r'# configuration file (.*?):(\d+)', line)
    if m:
        cur_file=m.group(1)
        cur_line=int(m.group(2))
        i+=1
        continue

    if cur_file is not None:
        cur_line += 1

    if re.match(r'\s*server\s*\{', line):
        start_i=i
        start_file=cur_file
        brace=0
        block=[]
        while i<len(lines):
            l=lines[i]
            if '{' in l: brace += l.count('{')
            if '}' in l: brace -= l.count('}')
            block.append(l)
            i+=1
            if brace<=0: break
        b="\n".join(block)
        if re.search(r'^\s*server_name\b.*\b'+re.escape(domain)+r'\b', b, re.M):
            has80=bool(re.search(r'^\s*listen\b.*\b80\b', b, re.M))
            has443=bool(re.search(r'^\s*listen\b.*\b443\b', b, re.M))
            servers.append((start_file or "", has80, has443))
        continue
    i+=1

ssl_file=""
http_file=""
for f,h80,h443 in servers:
    if h443 and not ssl_file: ssl_file=f
    if h80 and not http_file: http_file=f

print("SSL_443_FILE="+ssl_file)
print("HTTP_80_FILE="+http_file)
print("COUNT_MATCHING="+str(len(servers)))
PY

cat "$BK/active_vhosts.env" | tee "$BK/active_vhosts.echo" >/dev/null

SSL_FILE="$(grep -E '^SSL_443_FILE=' "$BK/active_vhosts.env" | cut -d= -f2- || true)"
HTTP_FILE="$(grep -E '^HTTP_80_FILE=' "$BK/active_vhosts.env" | cut -d= -f2- || true)"

say "unlock nginx.conf + active vhosts"
chattr -i "$NGINX_CONF" 2>/dev/null || true
[ -n "${SSL_FILE:-}" ] && [ -f "$SSL_FILE" ] && chattr -i "$SSL_FILE" 2>/dev/null || true
[ -n "${HTTP_FILE:-}" ] && [ -f "$HTTP_FILE" ] && chattr -i "$HTTP_FILE" 2>/dev/null || true

say "patch ONLY the first matching server block inside each active file"
python3 - <<'PY' "$DOMAIN" "$INC_BUNDLER" "$BK" "$SSL_FILE" "$HTTP_FILE"
import re,sys,os
domain=sys.argv[1]
inc=sys.argv[2]
bk=sys.argv[3]
targets=[sys.argv[4],sys.argv[5]]
targets=[t for t in targets if t and os.path.isfile(t)]
if not targets:
    print("NO_TARGET_FILES")
    raise SystemExit(0)

def patch_file(fp, port):
    raw=open(fp,"r",errors="ignore").read().splitlines(True)
    txt="".join(raw)

    # find server blocks by brace scan on lines (good enough for standard nginx)
    idxs=[]
    i=0
    while i<len(raw):
        if re.match(r'^\s*server\s*\{', raw[i]):
            start=i
            brace=0
            j=i
            while j<len(raw):
                brace += raw[j].count("{")
                brace -= raw[j].count("}")
                j+=1
                if brace<=0: break
            end=j
            idxs.append((start,end))
            i=end
        else:
            i+=1

    def block_has(start,end, rx):
        return any(re.search(rx, raw[k]) for k in range(start,end))

    # select FIRST block with server_name domain + listen port
    chosen=None
    for start,end in idxs:
        if not block_has(start,end, r'^\s*server_name\b.*\b'+re.escape(domain)+r'\b'): 
            continue
        if not block_has(start,end, r'^\s*listen\b.*\b'+str(port)+r'\b'):
            continue
        chosen=(start,end); break

    if not chosen:
        return False

    start,end=chosen
    # if include already in this block, do nothing
    if any(("include "+inc+";") in raw[k] or ("include /etc/nginx/includes/bundler_routes.inc;") in raw[k] for k in range(start,end)):
        return False

    # insert right after "server {"
    ins_line = "  include /etc/nginx/includes/bundler_routes.inc;\n"
    raw.insert(start+1, ins_line)
    out="".join(raw)

    # backup original
    base=os.path.basename(fp).replace("/","_")
    open(os.path.join(bk, base+".prepatch"),"w").write(txt)
    open(fp,"w").write(out)
    return True

for fp in targets:
    patched_443=patch_file(fp,443)
    patched_80=patch_file(fp,80)
    print(f"PATCHED {fp} 443={patched_443} 80={patched_80}")
PY

say "nginx -t"
nginx -t >/dev/null

say "reload nginx"
systemctl reload nginx >/dev/null

say "re-lock nginx.conf + active vhosts"
chattr +i "$NGINX_CONF" 2>/dev/null || true
[ -n "${SSL_FILE:-}" ] && [ -f "$SSL_FILE" ] && chattr +i "$SSL_FILE" 2>/dev/null || true
[ -n "${HTTP_FILE:-}" ] && [ -f "$HTTP_FILE" ] && chattr +i "$HTTP_FILE" 2>/dev/null || true

say "tests (origin bypass CF) + public"
curl -fsS "http://127.0.0.1:${API_PORT}/health" | head -c 200; echo

echo "--- ORIGIN HTTPS /bundler/ (should be 200)"
curl -k -fsSI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/bundler/" | head -n 15 | tr -d '\r' || true
echo "--- ORIGIN HTTPS /bundler/api/health (should be 200)"
curl -k -fsSI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/bundler/api/health" | head -n 15 | tr -d '\r' || true
echo "--- ORIGIN HTTPS /bundler/index.html (should be 200)"
curl -k -fsSI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/bundler/index.html" | head -n 15 | tr -d '\r' || true

echo "--- PUBLIC HTTPS /bundler/"
curl -fsSI "https://${DOMAIN}/bundler/" | head -n 15 | tr -d '\r' || true
echo "--- PUBLIC HTTPS /bundler/api/health"
curl -fsSI "https://${DOMAIN}/bundler/api/health" | head -n 15 | tr -d '\r' || true

say "DONE"
say "BACKUP: $BK"
say "ACTIVE_SSL_FILE: ${SSL_FILE:-}"
say "ACTIVE_HTTP_FILE: ${HTTP_FILE:-}"
BASH

chmod +x /root/MEGA_BUNDLER_PATCH_ACTIVE_VHOSTS.sh
/root/MEGA_BUNDLER_PATCH_ACTIVE_VHOSTS.sh
cat >/tmp/fireinners_fix_tabs.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ROOT="/opt/fireinners/frontend-react/app/dist"
ts(){ date +"%Y%m%d-%H%M%S"; }
sha(){ sha256sum "$1" 2>/dev/null | awk '{print $1}'; }
immut_off(){ local f="$1"; command -v lsattr >/dev/null||return 0; command -v chattr >/dev/null||return 0; if test -f "$f" && lsattr "$f" 2>/dev/null | grep -q '\-i-'; then chattr -i "$f" 2>/dev/null||true; echo "chattr -i $f"; fi; }
backup(){ local f="$1"; test -f "$f" && cp -a "$f" "$f.bak.$(ts)" && echo "backup: $f.bak.$(ts)"; }
write(){ local dest="$1"; local tmp="$2"; mkdir -p "$(dirname "$dest")"; backup "$dest"; immut_off "$dest"||true; cp -a "$tmp" "$dest"; chmod 644 "$dest"||true; echo "wrote: $dest (sha=$(sha "$dest"||echo n/a))"; }

test -d "$ROOT" || { echo "ERR: ROOT introuvable: $ROOT"; exit 1; }

PAGES=("wallet" "dex" "bridge" "explorer" "mining" "options")
for p in "${PAGES[@]}"; do mkdir -p "$ROOT/$p"; done

make_page(){
  local name="$1" title="$2" desc="$3"
  local tmp; tmp="$(mktemp)"
  cat >"$tmp" <<HTML
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="color-scheme" content="dark"/><title>FireInners • ${title}</title><style>:root{--bg:#05060b;--p:#0a0f1e;--p2:#070a14;--b:#1b2a44;--t:#e7f0ff;--m:#9fb3d7;--a:#ff7a18;--a2:#ffb03a;--ok:#7dffb1;--bad:#ff6b6b}*{box-sizing:border-box}html,body{height:100%;margin:0;background:radial-gradient(900px 520px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(800px 520px at 85% 15%,#121b35 0%,transparent 55%),linear-gradient(180deg,#05060b,#05060b);color:var(--t);font:14px system-ui,-apple-system,Segoe UI,Roboto,Arial}a{color:inherit;text-decoration:none}#wrap{min-height:100%;display:flex;align-items:center;justify-content:center;padding:22px}#card{width:min(980px,100%);background:linear-gradient(180deg,rgba(10,15,30,.92),rgba(7,10,20,.92));border:1px solid rgba(27,42,68,.75);border-radius:18px;box-shadow:0 18px 60px rgba(0,0,0,.55);overflow:hidden}#top{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid rgba(27,42,68,.6)}#brand{display:flex;gap:12px;align-items:center}#mark{width:44px;height:44px;border-radius:12px;background:radial-gradient(circle at 30% 25%,rgba(255,176,58,.35),transparent 60%),linear-gradient(135deg,rgba(255,122,24,.65),rgba(255,176,58,.25));border:1px solid rgba(255,176,58,.25);display:grid;place-items:center;font-weight:800}#title{line-height:1.05}#title b{font-size:16px;letter-spacing:.3px}#title div{color:var(--m);font-size:12px;margin-top:4px}#status{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}._pill{display:inline-flex;gap:8px;align-items:center;padding:8px 10px;border-radius:999px;background:rgba(7,10,20,.65);border:1px solid rgba(27,42,68,.65);color:var(--m)}._dot{width:8px;height:8px;border-radius:99px;background:rgba(159,179,215,.5)}._dot.ok{background:var(--ok)}._dot.bad{background:var(--bad)}#mid{padding:16px 18px 18px;display:grid;gap:12px}h1{margin:0;font-size:22px;letter-spacing:.4px}p{margin:0;color:var(--m);max-width:78ch}#grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}@media(max-width:560px){#grid{grid-template-columns:1fr}#status{justify-content:flex-start}}.tile{position:relative;padding:14px 14px 12px;border-radius:16px;background:linear-gradient(180deg,rgba(12,18,34,.95),rgba(7,10,20,.85));border:1px solid rgba(27,42,68,.7);transition:transform .12s ease,border-color .12s ease,box-shadow .12s ease}a.tile:hover{transform:translateY(-1px);border-color:rgba(255,176,58,.35);box-shadow:0 10px 26px rgba(0,0,0,.35)}.tile b{display:block;font-size:14px;margin-bottom:6px}.tile span{display:block;color:var(--m);font-size:12px;line-height:1.35}.tile i{position:absolute;right:12px;top:12px;width:10px;height:10px;border-radius:99px;background:linear-gradient(180deg,var(--a2),var(--a));opacity:.9}#foot{display:flex;gap:12px;justify-content:space-between;align-items:center;padding:14px 18px;border-top:1px solid rgba(27,42,68,.6);color:var(--m);font-size:12px;flex-wrap:wrap}</style></head><body><div id="wrap"><div id="card"><div id="top"><div id="brand"><div id="mark">FI</div><div id="title"><b>FireInners • ${title}</b><div>${desc}</div></div></div><div id="status"><div class="_pill"><span class="_dot" id="apiDot"></span><span id="apiTxt">API: check...</span></div><a class="_pill" href="/">Retour Core</a></div></div><div id="mid"><h1>${title}</h1><p>Page placeholder pour éviter le 404 nginx. Tu peux remplacer ce fichier plus tard par le vrai module.</p><div id="grid"><a class="tile" href="/wallet/"><i></i><b>Wallet</b><span>Accès wallet / soldes.</span></a><a class="tile" href="/dex/"><i></i><b>DEX</b><span>Swap / LP / prix.</span></a><a class="tile" href="/bridge/"><i></i><b>Bridge</b><span>SOL → FireInners.</span></a><a class="tile" href="/explorer/"><i></i><b>Explorer</b><span>Blocks / TX / wallets.</span></a><a class="tile" href="/mining/"><i></i><b>Mining</b><span>Outils mining.</span></a><a class="tile" href="/options/"><i></i><b>Options</b><span>Réglages / diagnostics.</span></a></div></div><div id="foot"><div>path: /${name}/</div><div>build: stub</div></div></div></div><script>(()=>{const apiTxt=document.getElementById("apiTxt"),apiDot=document.getElementById("apiDot");const ping=async()=>{try{const r=await fetch("/stats",{cache:"no-store"});if(!r.ok)throw 0;apiTxt.textContent="API: online";apiDot.className="_dot ok"}catch(e){apiTxt.textContent="API: offline";apiDot.className="_dot bad"}};ping();setInterval(ping,15000)})();</script></body></html>
HTML
  write "$ROOT/$name/index.html" "$tmp"
  rm -f "$tmp"
}

make_page "wallet"   "Wallet"   "Wallet • soldes • actions"
make_page "dex"      "DEX"      "Swap • LP • prix internes"
make_page "bridge"   "Bridge"   "SOL → FireInners"
make_page "explorer" "Explorer" "Blocks • TX • wallets • stats"
make_page "mining"   "Mining"   "Outils/écrans liés au mining"
make_page "options"  "Options"  "Réglages • diagnostics • utilitaires"

echo
echo "== Tests locaux =="
command -v curl >/dev/null && for u in /dex/ /wallet/ /bridge/ /explorer/ /mining/ /options/; do
  echo "--- $u ---"
  curl -fsS -I "http://127.0.0.1$u" | sed -n '1,8p' || true
done

echo "== DONE =="
BASH
bash /tmp/fireinners_fix_tabs.sh
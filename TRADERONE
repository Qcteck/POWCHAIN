cat >/root/fix_buffer_polyfill_proper.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HTML="/var/www/wolverine/index.html"

test -f "$HTML" || { echo "❌ Missing $HTML"; exit 1; }
cp -a "$HTML" "${HTML}.bak_${TS}"

python3 - <<'PY'
from pathlib import Path
import re

p = Path("/var/www/wolverine/index.html")
s = p.read_text(errors="ignore")

# 1) Remove old polyfill blocks we added before (buffer@... index.min.js etc.)
s = re.sub(r"<!--\s*WOLVERINE_BUFFER_POLYFILL\s*-->.*?</script>\s*</script>\s*", "", s, flags=re.S)
s = re.sub(r"<script[^>]+buffer@6\.0\.3[^>]*></script>\s*<script>.*?window\.Buffer.*?</script>\s*", "", s, flags=re.S)

# 2) Insert a robust polyfill in <head> (must run BEFORE Next.js bundles)
poly = """
<!-- WOLVERINE_BUFFER_POLYFILL -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/buffer/6.0.3/buffer.min.js"></script>
<script>
  // Make Node-like globals available for browser bundles
  window.global = window;
  window.process = window.process || { env: {} };

  // Force Buffer to the real polyfilled Buffer (with .from)
  if (window.buffer && window.buffer.Buffer) {
    window.Buffer = window.buffer.Buffer;
  }
</script>
"""

if "</head>" in s:
    # inject as early as possible in head
    s = s.replace("</head>", poly + "\n</head>", 1)
else:
    s = poly + "\n" + s

p.write_text(s)
print("OK: proper Buffer polyfill injected")
PY

systemctl reload nginx || service nginx reload

echo "== ORIGIN quick check (bypass CF) =="
curl -sk --resolve fireinners.online:443:127.0.0.1 https://fireinners.online/wolverine/ | grep -n "WOLVERINE_BUFFER_POLYFILL" && echo "OK ✅" || echo "NOT FOUND ❌"
BASH

chmod +x /root/fix_buffer_polyfill_proper.sh
/root/fix_buffer_polyfill_proper.sh
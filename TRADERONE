#!/usr/bin/env bash
set -e

echo "=== MEGA WOLVERINE DEPLOY (ONE SHOT) ==="

### VARIABLES (FIGÉES)
REPO_URL="https://github.com/Qcteck/WOLVERINE.git"
DEST="/opt/wolverine"
UI_SRC="$DEST/ui"
UI_DEST="/opt/fireinners/frontend-react/app/dist/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
BACKUP="/root/backup_$(date +%s)"

### SÉCURITÉ
[ "$(id -u)" != "0" ] && echo "Lance en root" && exit 1
[ -z "$GITHUB_TOKEN" ] && echo "GITHUB_TOKEN manquant" && exit 1

mkdir -p "$BACKUP"

echo "[1/6] Backup sécurité"
[ -d "$DEST" ] && cp -a "$DEST" "$BACKUP/wolverine.old" || true
[ -d "$UI_DEST" ] && cp -a "$UI_DEST" "$BACKUP/ui.old" || true
cp -a "$VHOST" "$BACKUP/vhost.old" || true

echo "[2/6] Clone / Update repo"
rm -rf "$DEST"
git clone https://$GITHUB_TOKEN@github.com/Qcteck/WOLVERINE.git "$DEST"

echo "[3/6] Déploiement UI"
mkdir -p "$UI_DEST"
rm -rf "$UI_DEST"/*
cp -a "$DEST/ui/." "$UI_DEST/"

echo "[4/6] Permissions"
chown -R www-data:www-data "$UI_DEST"
chmod -R 755 "$UI_DEST"

echo "[5/6] Vérification nginx"
nginx -t

echo "[6/6] Reload nginx"
systemctl reload nginx

echo "=== WOLVERINE DEPLOY OK ==="
echo "URL: https://fireinners.online/wolverine/"
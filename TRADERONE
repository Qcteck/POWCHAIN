ard><h2>A</h2><div class=pad><div class=row><select id=srcA><option value=cg>CoinGecko</option><option value=ds>DexScreener</option></select><input id=qA placeholder="Rechercher A (coin, token, adresse, paire)"><button id=btnA>Search</button></div><div id=listA class=list style="display:none"></div><div id=selA style="margin-top:10px;display:none"></div><div id=kvA class=kv style="display:none"></div></div><div id=foot><span class=muted id=stA>—</span></div></div><div class=card><h2>B</h2><div class=pad><div class=row><select id=srcB><option value=cg>CoinGecko</option><option value=ds>DexScreener</option></select><input id=qB placeholder="Rechercher B (coin, token, adresse, paire)"><button id=btnB>Search</button></div><div id=listB class=list style="display:none"></div><div id=selB style="margin-top:10px;display:none"></div><div id=kvB class=kv style="display:none"></div></div><div id=foot><span class=muted id=stB>—</span></div></div></div><div id=cmp class=card style="margin-top:10px"><h2>Résultat (QUBITS + Kirchhoff)</h2><div class=pad><div class=panel><div class=box><h3>Probabilités finales</h3><canvas id=barChart width=900 height=220></canvas><div class=tag id=compat>Compatibilité: —</div></div><div class=box><h3>Timeline séquentielle</h3><canvas id=lineChart width=900 height=220></canvas><div class=tag id=modeInfo>Mode: —</div></div></div><div style="margin-top:10px"><table><thead><tr><th>Metric</th><th>A</th><th>B</th><th>Qubit / Confidence</th><th>Vote (A vs B)</th></tr></thead><tbody id=tb><tr><td class=muted>Choisis A et B puis Analyze</td><td></td><td></td><td></td><td></td></tr></tbody></table></div><div class=panel style="margin-top:10px"><div class=box><h3>Résumé</h3><div id=summary class=mono>—</div></div><div class=box><h3>Détails Q+Q (poids auto)</h3><div id=qmeta class=mono>—</div></div></div></div><div id=foot>Q+Q stocke des poids en local (localStorage) pour stabiliser les comparaisons. Aucune transaction, aucune clé, aucune signature.</div></div></div><script>(()=>{const $=s=>document.querySelector(s);const CG="https://api.coingecko.com/api/v3",DS="https://api.dexscreener.com/latest/dex";const fmt=(n)=>{if(n==null||Number.isNaN(n))return"—";const a=Math.abs(+n);if(a>=1e12)return(+n/1e12).toFixed(2)+"T";if(a>=1e9)return(+n/1e9).toFixed(2)+"B";if(a>=1e6)return(+n/1e6).toFixed(2)+"M";if(a>=1e3)return(+n/1e3).toFixed(2)+"K";if(a>=1)return(+n).toLocaleString(undefined,{maximumFractionDigits:6});return(+n).toFixed(8)};const pct=(n)=>n==null||Number.isNaN(+n)?"—":((+n>=0?"+":"")+ (+n).toFixed(2)+"%");const cl=(n)=>n==null||Number.isNaN(+n)?"muted":(+n>=0?"ok":"bad");const deb=(fn,ms)=>{let t;return(...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),ms)}};const j=async(u)=>{const r=await fetch(u,{headers:{"accept":"application/json"}});if(!r.ok)throw new Error("HTTP "+r.status);return r.json()};const setSt=(id,msg)=>($(id).textContent=msg);let A=null,B=null;const LSKEY="CCPP_FUSION_QPP_META";const QPP=(()=>{let s=null;try{s=JSON.parse(localStorage.getItem(LSKEY)||"null")}catch(_){s=null}if(!s||!s.w){s={w:{price:1,mc:1,fdv:1,liq:1,vol:1,pc24:1,pc7:1,pc30:1,tx24:1},hist:[],ver:1}}const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));const normW=()=>{const w=s.w;let sum=0;Object.keys(w).forEach(k=>sum+=Math.max(.1,+w[k]||0));Object.keys(w).forEach(k=>w[k]=clamp(w[k]/sum*9,.2,3.0))};const bump=(k,dir,amt)=>{s.w[k]=(+s.w[k]||1)+dir*amt;normW()};const save=()=>{try{localStorage.setItem(LSKEY,JSON.stringify(s))}catch(_){}};const view=()=>{const w=s.w;const keys=Object.keys(w);return "weights:\n"+keys.map(k=>`${k}: ${(+w[k]).toFixed(3)}`).join("\n")+"\n\nnote:\n- weights auto-ajustés selon cohérence/confiance"};normW();return{state:s,bump,save,view}})();function sigmoid(x){return 1/(1+Math.exp(-x))}function softmax(arr){const m=Math.max(...arr);const ex=arr.map(v=>Math.exp(v-m));const s=ex.reduce((a,b)=>a+b,0)||1;return ex.map(v=>v/s)}function inferObj(o){if(!o)return{kind:"none",src:"?",id:"?"};return{kind:o.kind||"unknown",src:o.src||"?",id:o.id||"?"}}function normalizeMetric(key,a,b){const x=+a,y=+b;if(!Number.isFinite(x)&&!Number.isFinite(y))return{d:0,conf:0};if(!Number.isFinite(x)||!Number.isFinite(y))return{d:0,conf:.35};const base=Math.max(Math.abs(x),Math.abs(y),1e-9);let d=(x-y)/base;d=Math.max(-2,Math.min(2,d));return{d,conf:1}}function qubitFromDiff(d,conf,risk){const k=1.4;const pA=sigmoid(k*d)*conf + .5*(1-conf);const pB=1-pA;const theta=2*Math.acos(Math.sqrt(Math.max(0,Math.min(1,pA))));const phi=Math.max(0,Math.min(1,risk))*Math.PI;return{pA,pB,theta,phi}}function riskHeuristic(m){let r=0;const pc=Number.isFinite(+m.pc24)?Math.abs(+m.pc24):0;const liq=Number.isFinite(+m.liq)?+m.liq:0;const vol=Number.isFinite(+m.vol)?+m.vol:0;if(pc>20)r+=.35;else if(pc>10)r+=.2;else if(pc>5)r+=.1;if(liq>0&&liq<20000)r+=.25;else if(liq>0&&liq<100000)r+=.12;if(vol>0&&vol<liq*0.05)r+=.12;return Math.max(0,Math.min(1,r))}function compatScore(a,b){if(!a||!b)return{c:0,mode:"none",why:["missing"]};if(a.kind===b.kind)return{c:1,mode:"direct",why:["same-kind"]};if((a.kind==="coin"&&b.kind==="pair")||(a.kind==="pair"&&b.kind==="coin"))return{c:.62,mode:"analogy",why:["coin vs pair -> analogy metrics"]};return{c:.35,mode:"analogy",why:["different kinds -> analogy metrics"]}}function buildVector(o){if(!o)return{kind:"none"};if(o.src==="cg"){const m=o.m||{};return{kind:"coin",src:"cg",id:o.id,name:o.name,symbol:o.symbol,price:+m.current_price,mc:+m.market_cap,fdv:+m.fdv||NaN,vol:+m.total_volume,liq:NaN,pc24:+m.price_change_percentage_24h_in_currency,pc7:+m.price_change_percentage_7d_in_currency,pc30:+m.price_change_percentage_30d_in_currency,tx24:NaN,url:o.url||""}}if(o.src==="ds"){const p=o.p||{};return{kind:"pair",src:"ds",id:o.id,name:o.name,symbol:o.symbol,price:+p.priceUsd,mc:+p.marketCap||NaN,fdv:+p.fdv||NaN,vol:+(p.volume&&p.volume.h24),liq:+(p.liquidity&&p.liquidity.usd),pc24:+(p.priceChange&&p.priceChange.h24),pc7:NaN,pc30:NaN,tx24:+(p.txns&&p.txns.h24&&(p.txns.h24.buys+p.txns.h24.sells)),url:p.url||""}}return{kind:"unknown"}}function fmtVal(key,v){if(key==="pc24"||key==="pc7"||key==="pc30")return `<span class="${cl(v)}">${pct(v)}</span>`;if(key==="tx24")return Number.isFinite(+v)?String(Math.round(+v)):"—";return Number.isFinite(+v)?"$"+fmt(+v):"—"}function metricLabel(k){return({price:"Prix USD",mc:"Market Cap",fdv:"FDV",liq:"Liquidité",vol:"Volume 24h",pc24:"Var 24h",pc7:"Var 7j",pc30:"Var 30j",tx24:"Txns 24h"})[k]||k}function metricKeysFor(a,b,mode){const base=["price","mc","fdv","vol","pc24"];if(mode==="direct"){if(a.kind==="pair"||b.kind==="pair")base.splice(3,0,"liq"),base.push("tx24");if(a.kind==="coin"&&b.kind==="coin")base.push("pc7","pc30");return base}return ["price","mc","fdv","vol","pc24","liq","tx24"]}function drawBars(canvas,vals,labels){const ctx=canvas.getContext("2d");const W=canvas.width,H=canvas.height;ctx.clearRect(0,0,W,H);const pad=24;ctx.globalAlpha=1;ctx.fillStyle="rgba(231,240,255,.92)";ctx.font="14px system-ui";const max=1;const n=vals.length;const bw=(W-pad*2)/n*0.7;const gap=(W-pad*2)/n*0.3;for(let i=0;i<n;i++){const x=pad+i*(bw+gap)+gap*0.5;const h=(H-pad*2)*(vals[i]/max);const y=H-pad-h;ctx.fillStyle="rgba(159,255,255,.75)";ctx.fillRect(x,y,bw,h);ctx.fillStyle="rgba(231,240,255,.92)";ctx.fillText(labels[i],x, H-8);ctx.fillText(Math.round(vals[i]*100)+"%",x, y-6)}}function drawLine(canvas,series,labels){const ctx=canvas.getContext("2d");const W=canvas.width,H=canvas.height;ctx.clearRect(0,0,W,H);const pad=26;const n=series.length;const m=series[0]?.length||0;if(m<2){ctx.fillStyle="rgba(231,240,255,.7)";ctx.font="14px system-ui";ctx.fillText("—",pad,pad);return}const xStep=(W-pad*2)/(m-1);const yScale=(H-pad*2);const line=(arr,stroke)=>{ctx.beginPath();for(let i=0;i<m;i++){const x=pad+i*xStep;const y=H-pad - (arr[i]*yScale);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.strokeStyle=stroke;ctx.lineWidth=2;ctx.stroke()};line(series[0],"rgba(185,255,207,.9)");line(series[1],"rgba(255,179,179,.9)");line(series[2],"rgba(255,211,138,.9)");ctx.fillStyle="rgba(231,240,255,.9)";ctx.font="12px system-ui";for(let i=0;i<m;i++){if(labels&&labels[i]){ctx.fillText(labels[i],pad+i*xStep, H-8)}}ctx.fillText("A",W-90,20);ctx.fillText("B",W-65,20);ctx.fillText("INC",W-30,20)}async function cgSearch(q){const data=await j(`${CG}/search?query=${encodeURIComponent(q)}`);const coins=(data&&data.coins)||[];return coins.slice(0,12).map(c=>({id:c.id,name:c.name,symbol:(c.symbol||"").toUpperCase(),thumb:c.thumb||""}))}async function cgMarket(id){const data=await j(`${CG}/coins/markets?vs_currency=usd&ids=${encodeURIComponent(id)}&sparkline=false&price_change_percentage=24h,7d,30d`);return (data&&data[0])||null}async function dsSearch(q){const data=await j(`${DS}/search?q=${encodeURIComponent(q)}`);const pairs=(data&&data.pairs)||[];return pairs.slice(0,25)}function renderList(which,src,arr){const list=$(which==="A"?"#listA":"#listB");if(!arr||!arr.length){list.style.display="none";list.innerHTML="";return}if(src==="cg"){list.innerHTML=arr.map(x=>`<div class=item data-id="${x.id}"><div style="display:flex;gap:10px;align-items:center"><img class=thumb src="${x.thumb||""}" onerror="this.style.display='none'"><div><div><b>${x.name}</b> <span class=tag>${x.symbol}</span></div><div class=tag>${x.id}</div></div></div><div class=tag>coin</div></div>`).join("")}else{list.innerHTML=arr.map(p=>{const base=p.baseToken?.symbol||"?";const quote=p.quoteToken?.symbol||"?";const nm=`${base}/${quote}`;const t1=`${p.chainId||"?"} • ${p.dexId||"?"}`;const liq=p.liquidity?.usd,vol=p.volume?.h24,pc=p.priceChange?.h24;return `<div class=item data-pair="${p.pairAddress||""}" data-chain="${p.chainId||""}"><div><div><b>${nm}</b> <span class=tag>${t1}</span></div><div class=tag style="word-break:break-word">${p.baseToken?.address||""}</div><div class=tag>P:$${fmt(+p.priceUsd)} L:$${fmt(+liq)} V24:$${fmt(+vol)} 24h:${pct(+pc)}</div></div><div class=tag><a href="${p.url||"#"}" target=_blank rel=noopener>dex</a></div></div>`}).join("")}list.style.display="block";list.onclick=async(e)=>{const it=e.target.closest(".item");if(!it)return;try{if(src==="cg"){const id=it.getAttribute("data-id");await pick(which,{src:"cg",id})}else{const pair=it.getAttribute("data-pair");const chain=it.getAttribute("data-chain");const hit=arr.find(x=>x.pairAddress===pair&&String(x.chainId||"")===String(chain||""))||arr[0];await pick(which,{src:"ds",p:hit,id:pair})}list.style.display="none"}catch(err){setSt(which==="A"?"#stA":"#stB","Erreur: "+(err&&err.message||err))}}}function renderSel(which,obj){const el=$(which==="A"?"#selA":"#selB");if(!obj){el.style.display="none";el.innerHTML="";return}el.style.display="block";if(obj.src==="cg"){el.innerHTML=`<div class=pill><img class=thumb src="${obj.image||""}" onerror="this.style.display='none'"><b>${obj.name||"—"}</b><span class=tag>${(obj.symbol||"").toUpperCase()}</span><span class=tag>cg</span></div>`}else{const p=obj.p||{};const nm=`${p.baseToken?.symbol||"?"}/${p.quoteToken?.symbol||"?"}`;el.innerHTML=`<div class=pill><b>${nm}</b><span class=tag>${p.chainId||"?"} • ${p.dexId||"?"}</span><span class=tag>ds</span>${p.url?`<a href="${p.url}" target=_blank rel=noopener>dex</a>`:""}</div>`}}function kvFill(which,obj){const kv=$(which==="A"?"#kvA":"#kvB");if(!obj){kv.style.display="none";kv.innerHTML="";return}kv.style.display="grid";const v=buildVector(obj);const rows=[["Prix USD","price"],["Market Cap","mc"],["FDV","fdv"],["Liquidité","liq"],["Volume 24h","vol"],["Var 24h","pc24"],["Var 7j","pc7"],["Var 30j","pc30"],["Txns 24h","tx24"]];kv.innerHTML=rows.map(([lab,k])=>`<div class=k><b>${lab}</b><span class="${(k==="pc24"||k==="pc7"||k==="pc30")?cl(v[k]):""}">${k==="pc24"||k==="pc7"||k==="pc30"?pct(v[k]):(k==="tx24"?(Number.isFinite(v[k])?String(Math.round(v[k])):"—"):(Number.isFinite(v[k])?"$"+fmt(v[k]):"—"))}</span></div>`).join("")}async function pick(which,ref){if(ref.src==="cg"){setSt(which==="A"?"#stA":"#stB","Chargement CoinGecko...");const m=await cgMarket(ref.id);if(!m)throw new Error("CoinGecko not found");const obj={src:"cg",id:m.id,kind:"coin",name:m.name,symbol:m.symbol,image:m.image,m,url:""};if(which==="A")A=obj;else B=obj;renderSel(which,obj);kvFill(which,obj);setSt(which==="A"?"#stA":"#stB",`OK • ${m.name} (${(m.symbol||"").toUpperCase()})`)}else{const p=ref.p;setSt(which==="A"?"#stA":"#stB","OK • DexScreener pair");const obj={src:"ds",id:ref.id,kind:"pair",p,name:(p.baseToken?.symbol||"?")+"/"+(p.quoteToken?.symbol||"?"),symbol:(p.baseToken?.symbol||"?"),url:p.url||""};if(which==="A")A=obj;else B=obj;renderSel(which,obj);kvFill(which,obj)}}function kirchhoffSolve(eA,eB,eEq,eInc){const logits=[eA,eB,eEq,eInc];const p=softmax(logits);return{pA:p[0],pB:p[1],pEq:p[2],pInc:p[3]}}function qualityScore(vecA,vecB,compat,used){let s=60;const have=(v)=>Number.isFinite(v)?1:0;const a=vecA,b=vecB;const coverage=used.reduce((acc,k)=>acc+(have(a[k])&&have(b[k])?1:0),0)/Math.max(1,used.length);s+=Math.round((coverage-.5)*30);s+=Math.round((compat.c-.5)*30);const r=(riskHeuristic(a)+riskHeuristic(b))/2;s-=Math.round(r*25);return Math.max(0,Math.min(100,s))}function explain(vecA,vecB,compat,final,rows){const lines=[];lines.push(`A: ${vecA.kind}/${vecA.src} • ${vecA.name||vecA.id||"?"}`);lines.push(`B: ${vecB.kind}/${vecB.src} • ${vecB.name||vecB.id||"?"}`);lines.push(`Compatibilité: ${(compat.c*100).toFixed(0)}% • mode=${compat.mode} • ${compat.why.join(", ")}`);lines.push("");lines.push(`Probabilités (Kirchhoff):`);lines.push(`- A meilleur: ${(final.pA*100).toFixed(1)}%`);lines.push(`- B meilleur: ${(final.pB*100).toFixed(1)}%`);lines.push(`- Égal: ${(final.pEq*100).toFixed(1)}%`);lines.push(`- Incomparable: ${(final.pInc*100).toFixed(1)}%`);lines.push("");const top=rows.slice().sort((x,y)=>Math.abs(y.vote)-Math.abs(x.vote)).slice(0,5);lines.push("Top facteurs (ordre):");top.forEach(r=>{lines.push(`- ${r.label}: vote=${(r.vote>=0?"+":"")+r.vote.toFixed(3)} conf=${r.conf.toFixed(2)} w=${r.w.toFixed(2)} risk=${r.risk.toFixed(2)}`)});lines.pu
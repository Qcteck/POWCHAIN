cat >/root/check_github_push_perm.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

REPO="Qcteck/WOLVERINE1"

read -s -p "PAT: " PAT; echo
[ -n "$PAT" ] || { echo "Empty PAT"; exit 1; }

echo "== Repo permissions (need push=true) =="
JSON="$(curl -sS -H "Authorization: Bearer ${PAT}" -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/${REPO}")"

echo "$JSON" | grep -oE '"permissions":\{[^}]+\}' || echo "No permissions field"
echo "$JSON" | grep -oE '"push":[^,]+' || true
echo "$JSON" | grep -oE '"admin":[^,]+' || true
echo "$JSON" | grep -oE '"maintain":[^,]+' || true

echo
echo "== Token scopes header (classic only) =="
curl -sS -I -H "Authorization: Bearer ${PAT}" https://api.github.com/user | grep -i 'x-oauth-scopes' || \
  echo "(Fine-grained token -> pas de x-oauth-scopes)"
BASH

chmod +x /root/check_github_push_perm.sh
/root/check_github_push_perm.sh
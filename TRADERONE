cat >/root/OPTION_A_private_sentinel1.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/private_sentinel1.conf"
HTPASS="/etc/nginx/.htpasswd_private_sentinel1"
PATHLOC="/_private_sentinel1/"
WEBROOT="/opt/fireinners/private_sentinel1"

echo "[1] prereqs"
command -v nginx >/dev/null
if ! command -v htpasswd >/dev/null; then
  echo "htpasswd missing -> install apache2-utils"
  apt-get update -y
  apt-get install -y apache2-utils
fi
[ -f "$VHOST" ] || { echo "VHOST not found: $VHOST"; exit 1; }

echo "[2] htpasswd (user: sentinel)"
mkdir -p /etc/nginx /etc/nginx/snippets
if [ ! -f "$HTPASS" ]; then
  htpasswd -c -B "$HTPASS" sentinel
else
  echo "htpasswd exists: $HTPASS"
fi
chmod 640 "$HTPASS"
chown root:www-data "$HTPASS" 2>/dev/null || true

echo "[3] private dashboard HTML"
mkdir -p "$WEBROOT"
cat >"$WEBROOT/index.html" <<EOF
<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Private Sentinel</title>
<style>body{font:16px system-ui;margin:24px;background:#0b0c10;color:#e8e8e8}a{color:#8ad}code,pre{background:#131622;padding:2px 6px;border-radius:6px}h1{margin:0 0 10px}hr{border:0;border-top:1px solid #222;margin:18px 0}.box{background:#0f1220;border:1px solid #202540;border-radius:12px;padding:14px 14px;margin:12px 0}.mut{color:#aab}</style>
<h1>Private Sentinel</h1>
<div class="mut">Accès protégé BasicAuth. Ne pas partager.</div>
<hr>
<div class="box">
  <div><b>Domain</b>: <code>${DOMAIN}</code></div>
  <div><b>HTTPS</b>: <a href="https://${DOMAIN}/" target="_blank">https://${DOMAIN}/</a></div>
  <div><b>Zone privée</b>: <code>${PATHLOC}</code></div>
</div>
<div class="box">
  <h3>Services visibles</h3>
  <ul>
    <li><b>Nginx</b> (443): <a href="https://${DOMAIN}/" target="_blank">https://${DOMAIN}/</a></li>
    <li><b>WebSocket</b> (via nginx): <code>wss://${DOMAIN}/ws</code></li>
    <li><b>Node</b> (port 3000): <code>http://${DOMAIN}:3000</code> (si exposé UFW)</li>
    <li><b>Node</b> (port 8484): <code>http://${DOMAIN}:8484</code> (si exposé UFW)</li>
  </ul>
  <div class="mut">Astuce: si tu ne veux pas exposer 3000/8484 au monde, on les met derrière nginx + on ferme UFW.</div>
</div>
<div class="box">
  <h3>Commandes utiles</h3>
  <pre>nginx -t
systemctl reload nginx
ss -lntp | egrep ':443|:3000|:8484|:4001' || true
ufw status numbered</pre>
</div>
EOF

echo "[4] write nginx snippet"
cat >"$SNIP" <<EOF
location = ${PATHLOC%/} { return 301 ${PATHLOC}; }
location ^~ ${PATHLOC} {
  auth_basic "Sentinel";
  auth_basic_user_file ${HTPASS};
  alias ${WEBROOT}/;
  try_files \$uri \$uri/ /index.html;
  add_header Cache-Control "no-store" always;
}
EOF
chmod 644 "$SNIP"

echo "[5] ensure vhost includes snippet"
if ! grep -Rq "snippets/private_sentinel1\.conf" "$VHOST"; then
  BK="/root/${DOMAIN}-ssl.bak.$(date +%Y%m%d-%H%M%S)"
  cp -a "$VHOST" "$BK"
  awk -v sn="include ${SNIP};" '
    {print}
    $0 ~ /^[ \t]*listen[ \t]+443[ \t]+ssl/ {print "    "sn}
  ' "$BK" > /tmp/${DOMAIN}-ssl && mv /tmp/${DOMAIN}-ssl "$VHOST"
  echo "Inserted include. Backup: $BK"
else
  echo "Include already present"
fi

echo "[6] nginx test + reload"
nginx -t
systemctl reload nginx

echo "[7] quick tests"
echo "Expect 401:"
curl -I "https://${DOMAIN}${PATHLOC}" | head -n 6 || true
echo "If you want to test 200, run:"
echo "  curl -I -u sentinel https://${DOMAIN}${PATHLOC} | head -n 6"
echo "DONE"
BASH
bash /root/OPTION_A_private_sentinel1.sh
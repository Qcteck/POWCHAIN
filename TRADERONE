cat >/root/WOLV_FORCE_SINGLE_UI.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%s)"

ROOT="/opt/fireinners/frontend-react/app/dist"
[ -d "$ROOT" ] || { echo "ERR: root introuvable: $ROOT"; exit 1; }

HTML_MIN='<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta http-equiv="Cache-Control" content="no-store"/><meta http-equiv="Pragma" content="no-cache"/><meta http-equiv="Expires" content="0"/><title>WOLVERINE</title><style>body{font:14px Arial,system-ui;margin:0;padding:14px}#box{max-width:980px;border:1px solid #bbb;border-radius:12px;padding:12px}h1{margin:0 0 10px 0;font-size:28px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:10px 0}.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;word-break:break-all}hr{border:none;border-top:1px solid #ddd;margin:12px 0}button,select,input{font:inherit;padding:6px 8px}small{color:#444}.ok{color:#060}.bad{color:#a00}.box{padding:10px;border:1px solid #bbb;border-radius:10px;background:#f7f7f7}</style></head><body><div id="box"><h1>WOLVERINE</h1><div class="row"><button id="btnConnect" type="button">Connect Wallet (Phantom)</button><div>Wallet: <span id="pub" class="mono">—</span></div></div><div class="row"><b>Mode TraderOne</b><select id="mode"><option value="SAFE">SAFE</option><option value="AUTO">AUTO</option><option value="RR">RR</option><option value="SCALP">SCALP</option></select><button id="btnMode" type="button">Sauver</button><span id="modeMsg"></span></div><hr><div class="box"><b>Dépôt manuel (obligatoire)</b><br><small>Envoie depuis ton Phantom vers TraderOne (bot) :</small><div id="bot" class="mono"></div><div class="row"><label>Asset <select id="asset"><option value="USDC">USDC</option><option value="SOL">SOL</option></select></label><label>Montant <input id="amount" placeholder="ex: 1 ou 0.1" style="min-width:220px"/></label><button id="btnConfirm" type="button">CONFIRMER DÉPÔT (scan on-chain)</button><span id="depMsg"></span></div><small>Après confirmation, START devient actif.</small></div><div class="row" style="margin-top:12px"><button id="btnStart" type="button" disabled>START WOLVERINE</button><span id="startMsg"></span></div><div><b>Dernier dépôt détecté</b> : <span id="lastDep" class="mono">—</span></div></div><script>(()=>{"use strict";const BOT="e8DbBrTJxRetx3HNFb83CsXMySETydHVLwxMzkjcVqh";const $=s=>document.querySelector(s);const setMsg=(el,txt,ok)=>{el.textContent=txt||"";el.className=ok?"ok":"bad";};const jpost=async(url,obj)=>{const r=await fetch(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(obj||{})});const t=await r.text();let j=null;try{j=JSON.parse(t)}catch{}if(!r.ok)throw new Error((j&&j.err)||t||("HTTP "+r.status));return j||{};};const jget=async(url)=>{const r=await fetch(url,{method:"GET"});const t=await r.text();let j=null;try{j=JSON.parse(t)}catch{}if(!r.ok)throw new Error((j&&j.err)||t||("HTTP "+r.status));return j||{};};const getPub=async()=>{if(!window.solana||!window.solana.isPhantom)throw new Error("Phantom non détecté");if(window.solana.publicKey)return window.solana.publicKey.toBase58();const r=await window.solana.connect();return r&&r.publicKey?r.publicKey.toBase58():"";};async function refreshState(pub){const st=await jget("/wolverine/api/wolv_state?pub="+encodeURIComponent(pub));const m=(st&&st.user&&st.user.mode)||"SAFE";$("#mode").value=m;const ld=st&&st.user&&st.user.last_deposit;if(ld&&ld.sig){$("#lastDep").textContent=(ld.asset+" "+ld.amount+" | "+ld.sig);$("#btnStart").disabled=false;}else{$("#lastDep").textContent="—";$("#btnStart").disabled=true;}}$("#bot").textContent=BOT;$("#btnConnect").onclick=async()=>{try{const pub=await getPub();$("#pub").textContent=pub;await refreshState(pub);}catch(e){alert(String(e&&e.message?e.message:e));}};$("#btnMode").onclick=async()=>{try{const pub=await getPub();$("#pub").textContent=pub;setMsg($("#modeMsg"),"Sauvegarde...",false);await jpost("/wolverine/api/wolv_set_mode",{pub,mode:$("#mode").value});setMsg($("#modeMsg"),"OK",true);}catch(e){setMsg($("#modeMsg"),"ERR: "+String(e&&e.message?e.message:e),false);}};$("#btnConfirm").onclick=async()=>{try{const pub=await getPub();$("#pub").textContent=pub;const asset=$("#asset").value;const amt=Number($("#amount").value||0);if(!(amt>0))return setMsg($("#depMsg"),"Montant invalide",false);setMsg($("#depMsg"),"Scan on-chain...",false);const out=await jpost("/wolverine/api/wolv_confirm_deposit",{pub,asset,amount:amt});if(out&&out.ok&&out.sig){setMsg($("#depMsg"),"OK: "+out.sig,true);await refreshState(pub);}else{setMsg($("#depMsg"),"Pas trouvé (réessaie après confirmation réseau)",false);}}catch(e){setMsg($("#depMsg"),"ERR: "+String(e&&e.message?e.message:e),false);}};$("#btnStart").onclick=async()=>{try{const pub=await getPub();$("#pub").textContent=pub;setMsg($("#startMsg"),"Start...",false);await jpost("/wolverine/api/start",{pub});setMsg($("#startMsg"),"OK",true);}catch(e){setMsg($("#startMsg"),"ERR: "+String(e&&e.message?e.message:e),false);}};})();</script></body></html>'

UPDATED=0
while IFS= read -r f; do
  chattr -i "$f" 2>/dev/null || true
  printf "%s" "$HTML_MIN" >"$f"
  rm -f "${f}.gz" "${f}.br" 2>/dev/null || true
  UPDATED=$((UPDATED+1))
  echo "UPDATED: $f"
done < <(find "$ROOT" -type f -path "*/wolverine/index.html" 2>/dev/null)

[ "$UPDATED" -gt 0 ] || { echo "ERR: aucun wolverine/index.html trouvé sous $ROOT"; exit 1; }

systemctl reload nginx 2>/dev/null || true

echo "OK: UI SINGLE déposée (doublons éliminés côté fichiers)."
echo "Ouvre: https://fireinners.online/wolverine/?v=$TS puis Ctrl+F5"
BASH

bash /root/WOLV_FORCE_SINGLE_UI.sh 
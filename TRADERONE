set -euo pipefail
DOMAIN="fireinners.online"

echo "=== 1) Reproduire les 500 côté serveur ==="
curl -I "https://127.0.0.1/wolverine/_next/static/chunks/pages/index-197ef316ae8e31d1.js" --insecure -H "Host: $DOMAIN" | head -n 20 || true
curl -I "https://127.0.0.1/wolverine/_next/static/chMHq93EIaFhXXzepQBfj/_buildManifest.js" --insecure -H "Host: $DOMAIN" | head -n 20 || true
curl -I "https://127.0.0.1/wolverine/_next/static/chMHq93EIaFhXXzepQBfj/_ssgManifest.js" --insecure -H "Host: $DOMAIN" | head -n 20 || true
curl -I "https://127.0.0.1/favicon.ico" --insecure -H "Host: $DOMAIN" | head -n 20 || true

echo
echo "=== 2) Voir l'erreur Nginx exacte (les dernières lignes) ==="
tail -n 80 /var/log/nginx/error.log || true

echo
echo "=== 3) Trouver où sont réellement les fichiers _next sur le disque ==="
NEXTDIR="$(find /var/www /opt /srv -type d -path '*wolverine/_next' 2>/dev/null | head -n 1 || true)"
echo "NEXTDIR=$NEXTDIR"
if [ -z "$NEXTDIR" ]; then
  echo "❌ Aucun dossier wolverine/_next trouvé. Ton build Next n'est peut-être pas au bon endroit."
  exit 1
fi

APPROOT="$(dirname "$NEXTDIR")"
echo "APPROOT=$APPROOT"
ls -lah "$NEXTDIR/static" 2>/dev/null | head -n 50 || true

echo
echo "=== 4) Patch Nginx: forcer /wolverine/_next/ à servir depuis le bon dossier (alias) ==="
SNIP="/etc/nginx/snippets/wolverine_next_assets.server.inc"
cat > "$SNIP" <<NGX
location ^~ /wolverine/_next/ {
  alias $APPROOT/_next/;
  try_files \$uri =404;
  add_header Cache-Control "public, max-age=31536000, immutable";
}
location = /favicon.ico {
  try_files /favicon.ico =204;
  access_log off;
}
NGX

echo "=== 5) Injecter l'include dans le server fireinners.online ==="
CONF="$(grep -RIl "server_name.*${DOMAIN}" /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null | head -n 1 || true)"
echo "CONF=$CONF"
[ -n "$CONF" ] || { echo "❌ server block introuvable pour $DOMAIN"; exit 1; }

cp -a "$CONF" "$CONF.bak.$(date +%s)"
if ! grep -qF "include $SNIP;" "$CONF"; then
  awk -v inc="  include $SNIP;" '
    {print}
    $0 ~ /server_name/ && $0 ~ /fireinners\.online/ && !done {print inc; done=1}
  ' "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
fi

echo "=== 6) Reload + retest ==="
nginx -t
systemctl reload nginx

curl -I "https://127.0.0.1/wolverine/_next/static/chunks/pages/index-197ef316ae8e31d1.js" --insecure -H "Host: $DOMAIN" | head -n 20 || true
echo "✅ Ouvre: https://fireinners.online/wolverine/"
cat >/root/WOLV_ADD_WALLET_BALANCES.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

# 1) Trouver le dossier web /wolverine
WEB_DIR=""
for d in \
  /opt/fireinners/frontend-react/app/dist/wolverine \
  /var/www/fireinners/wolverine \
  /var/www/wolverine \
  /opt/traderone-opt/public/wolverine \
  /opt/traderone-opt/public
do
  if [ -d "$d" ]; then WEB_DIR="$d"; break; fi
done
[ -n "$WEB_DIR" ] || { echo "ERR: dossier /wolverine introuvable"; exit 1; }
echo "WEB_DIR=$WEB_DIR"

HTML="$WEB_DIR/index.html"
JS="$WEB_DIR/ui/terminal.js"
[ -f "$HTML" ] || { echo "ERR: index.html introuvable: $HTML"; exit 1; }
[ -f "$JS" ] || { echo "ERR: terminal.js introuvable: $JS"; exit 1; }

# 2) Backup
TS="$(date +%s)"
mkdir -p /root/wolv_backups
cp -a "$HTML" "/root/wolv_backups/index.html.$TS.bak"
cp -a "$JS"   "/root/wolv_backups/terminal.js.$TS.bak"
echo "Backup OK -> /root/wolv_backups/(index.html|terminal.js).$TS.bak"

# 3) Assurer solana web3 IIFE dans le HTML
if ! grep -q "@solana/web3.js" "$HTML"; then
  sed -i 's#</body>#  <script src="https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js"></script>\n</body>#i' "$HTML"
  echo "Added solana web3 script tag"
fi

# 4) Ajouter le bloc HTML Wallet Balances (si absent)
if ! grep -q 'id="walletPub"' "$HTML"; then
  # on l'insère juste après le bloc "Soldes Wallet" existant si possible, sinon avant </aside>
  if grep -q "Soldes Wallet" "$HTML"; then
    perl -0777 -i -pe 's/(Soldes Wallet[\s\S]{0,2500}?<\/div>)/$1\n\n<div id="walletBalances" style="margin-top:10px" class="notice">\n  <div style="font-weight:1000;margin-bottom:6px">Wallet Balances</div>\n  <div class="kv"><span>Wallet</span><strong id="walletPub">—</strong></div>\n  <div class="kv"><span>SOL</span><strong id="walletSol">—</strong></div>\n  <div class="kv"><span>USDC</span><strong id="walletUsdc">—</strong></div>\n</div>\n/sm' "$HTML" || true
  fi
  if ! grep -q 'id="walletPub"' "$HTML"; then
    perl -0777 -i -pe 's#</aside>#\n<div id="walletBalances" style="margin-top:10px" class="notice">\n  <div style="font-weight:1000;margin-bottom:6px">Wallet Balances</div>\n  <div class="kv"><span>Wallet</span><strong id="walletPub">—</strong></div>\n  <div class="kv"><span>SOL</span><strong id="walletSol">—</strong></div>\n  <div class="kv"><span>USDC</span><strong id="walletUsdc">—</strong></div>\n</div>\n\n</aside>#sm' "$HTML"
  fi
  echo "Added Wallet Balances HTML block"
else
  echo "Wallet Balances HTML already present"
fi

# 5) Ajouter le code JS balances (si absent)
if ! grep -q "function refreshWalletBalances" "$JS"; then
  cat >>"$JS" <<'JS'

// --- WOLV_WALLET_BALANCES_V1 ---
const __WOLV_USDC_MINT__ = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
function __wolv_set(id, v){ const el=document.getElementById(id); if(el) el.textContent=v; }
function __wolv_fmt(n,d){ n=Number(n||0); if(!isFinite(n)) n=0; return n.toFixed(d); }

async function refreshWalletBalances(){
  try{
    if(!window.solana || !window.solana.isPhantom) return;
    if(!window.solanaWeb3 || !window.solanaWeb3.Connection) return;

    // connect onlyIfTrusted si pas déjà connecté
    if(!window.solana.publicKey){
      try{ await window.solana.connect({onlyIfTrusted:true}); }catch(_){ return; }
    }
    if(!window.solana.publicKey) return;

    const pub = window.solana.publicKey.toBase58();
    __wolv_set("walletPub", pub.slice(0,4)+"…"+pub.slice(-4));

    const conn = new window.solanaWeb3.Connection("https://api.mainnet-beta.solana.com","confirmed");

    // SOL
    const lamports = await conn.getBalance(new window.solanaWeb3.PublicKey(pub),"confirmed");
    __wolv_set("walletSol", __wolv_fmt(lamports/1e9,6)+" SOL");

    // USDC
    const res = await conn.getParsedTokenAccountsByOwner(
      new window.solanaWeb3.PublicKey(pub),
      { mint: new window.solanaWeb3.PublicKey(__WOLV_USDC_MINT__) },
      "confirmed"
    );
    let usdc=0;
    for(const it of (res.value||[])){
      const ui = it.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
      usdc += Number(ui||0);
    }
    __wolv_set("walletUsdc", __wolv_fmt(usdc,2)+" USDC");
  }catch(_){
    // silence
  }
}

// auto refresh
setInterval(()=>refreshWalletBalances().catch(()=>{}), 5000);

// refresh quand Phantom connect
if(window.solana?.isPhantom && window.solana?.on){
  try{ window.solana.on("connect", ()=>refreshWalletBalances().catch(()=>{})); }catch(_){}
}
// --- /WOLV_WALLET_BALANCES_V1 ---
JS
  echo "Added refreshWalletBalances() into terminal.js"
else
  echo "refreshWalletBalances() already present in terminal.js"
fi

# 6) Reload nginx
nginx -t && systemctl reload nginx || true

echo "DONE ✅  Va sur https://fireinners.online/wolverine/ puis Ctrl+F5"
echo "ROLLBACK ✅ :"
echo "  cp -a /root/wolv_backups/index.html.$TS.bak $HTML"
echo "  cp -a /root/wolv_backups/terminal.js.$TS.bak $JS"
BASH

bash /root/WOLV_ADD_WALLET_BALANCES.sh
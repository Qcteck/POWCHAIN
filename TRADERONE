cat >/root/AIAQUILA_MEGA_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SITE="fireinners.online"
ROOT="/var/www/fireinners.online/aiaquila"
INDEX="$ROOT/index.html"
BACKUP="$ROOT/index.backup.$(date +%Y%m%d_%H%M%S).html"

NGX_SITE="/etc/nginx/sites-available/$SITE"
NGX_SNIP="/etc/nginx/snippets/aiaquila_rss.conf"

echo "=== AIAQUILA MEGA FIX (NO WORKER / DIRECT RSS) ==="

### 1) Backup frontend
echo "[1/5] Backup frontend"
cp -a "$INDEX" "$BACKUP"
echo "Backup -> $BACKUP"

### 2) Write nginx RSS proxy snippet (DIRECT)
echo "[2/5] Writing nginx RSS proxy (direct feed)"
cat >"$NGX_SNIP" <<'NGX'
location /aiaquila/api/rss {
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    proxy_pass https://news.bitcoin.com/feed/;
    proxy_set_header Host news.bitcoin.com;
    proxy_set_header User-Agent "AIAQUILA-RSS";
    proxy_ssl_server_name on;

    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}
NGX

### 3) Inject snippet if missing
echo "[3/5] Inject snippet into nginx site"
if ! grep -q "aiaquila_rss.conf" "$NGX_SITE"; then
  sed -i "/server_name $SITE;/a \\    include /etc/nginx/snippets/aiaquila_rss.conf;" "$NGX_SITE"
fi

### 4) Rewrite frontend (LOCAL API ONLY)
echo "[4/5] Rewrite frontend index.html"
cat >"$INDEX" <<'HTML'
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel (VPS)</title>
<style>
body{margin:0;padding:20px;background:#0b1b3a;color:#fff;font-family:system-ui}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:14px;color:#cfe}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — RSS réel (VPS DIRECT)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>

<script>
async function load(){
  const o=document.getElementById("out");
  o.textContent="Chargement...";
  try{
    const r=await fetch("/aiaquila/api/rss",{cache:"no-store"});
    if(!r.ok) throw r.status;
    const txt=await r.text();
    const xml=new DOMParser().parseFromString(txt,"text/xml");
    const items=[...xml.querySelectorAll("item")].slice(0,20);
    o.textContent=items.map(i=>
      (i.querySelector("title")?.textContent||"")+"\n"+
      (i.querySelector("link")?.textContent||"")
    ).join("\n\n");
  }catch(e){
    o.textContent="ERREUR: "+e;
  }
}
</script>
</body>
</html>
HTML

### 5) Permissions + reload nginx
echo "[5/5] Reload nginx"
chmod 644 "$INDEX"
nginx -t
systemctl reload nginx

echo "=== DONE ==="
echo "URL: https://fireinners.online/aiaquila/"
echo "API: https://fireinners.online/aiaquila/api/rss"
BASH

chmod +x /root/AIAQUILA_MEGA_FIX.sh
/root/AIAQUILA_MEGA_FIX.sh
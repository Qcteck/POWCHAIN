bash -s <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
export DEBIAN_FRONTEND=noninteractive
umask 022

log(){ printf "\n[%s] %s\n" "$(date '+%F %T')" "$*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "Run as root."

ROOT_WOLV="/var/www/wolverine"
REPO="/opt/wolverine"
INC="/etc/nginx/includes/wolverine_routes.inc"
ASK="/opt/fireinners/sentinel/lib/askorupdate.sh"

RB_DIR="/root/MEGA_WOLVERINE_ROLLBACK_${TS}"
mkdir -p "$RB_DIR"

rollback(){
  log "ROLLBACK (best-effort)"
  if [ -f "$RB_DIR/wolverine_routes.inc" ]; then
    mkdir -p "$(dirname "$INC")"
    cp -a "$RB_DIR/wolverine_routes.inc" "$INC" 2>/dev/null || true
  fi
  if [ -d "$RB_DIR/wolverine_www" ]; then
    rm -rf "$ROOT_WOLV" 2>/dev/null || true
    cp -a "$RB_DIR/wolverine_www" "$ROOT_WOLV" 2>/dev/null || true
  fi
  if [ -f "$RB_DIR/vhost_patched_path.txt" ]; then
    VHOST="$(cat "$RB_DIR/vhost_patched_path.txt" 2>/dev/null || true)"
    if [ -n "${VHOST:-}" ] && [ -f "$RB_DIR/vhost_backup.conf" ]; then
      chattr -i "$VHOST" 2>/dev/null || true
      cp -a "$RB_DIR/vhost_backup.conf" "$VHOST" 2>/dev/null || true
      chattr +i "$VHOST" 2>/dev/null || true
    fi
  fi
  nginx -t && systemctl reload nginx || true
  log "ROLLBACK done"
}
trap 'rollback; die "Failed at line $LINENO"' ERR

log "0) Preflight"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v git  >/dev/null 2>&1 || die "git missing"
mkdir -p /etc/nginx/includes
mkdir -p "$ROOT_WOLV"

if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then
  /root/WOLVERINE_SAVEPOINT.sh "AUTO_BEFORE_MEGA_PLUS_${TS}" || true
fi

if [ -f "$ASK" ]; then
  # shellcheck disable=SC1090
  source "$ASK"
  log "askorupdate loaded: $ASK"
else
  askorupdate_file(){ local SRC="$1" DST="$2"; mkdir -p "$(dirname "$DST")"; cp -a "$DST" "${DST}.bak_${TS}" 2>/dev/null || true; cp -a "$SRC" "$DST"; }
fi

[ -f "$INC" ] && cp -a "$INC" "$RB_DIR/wolverine_routes.inc" || true
[ -d "$ROOT_WOLV" ] && cp -a "$ROOT_WOLV" "$RB_DIR/wolverine_www" || true

log "1) Ensure Node.js via NodeSource"
if ! command -v node >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y ca-certificates curl gnupg
  install -d -m 0755 /etc/apt/keyrings
  curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
  echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list
  apt-get update -y
  apt-get install -y nodejs
fi
node -v >/dev/null
npm -v >/dev/null

log "2) Detect real vhost for fireinners.online via nginx -T"
NGT="/tmp/nginx_T_${TS}.txt"
nginx -T > "$NGT" 2>&1 || die "nginx -T failed"
cp -a "$NGT" "$RB_DIR/nginx_T_before.txt"

VHOST_DETECTED="$(python3 - <<'PY'
import re,sys
txt=open(sys.argv[1],'r',errors='ignore').read().splitlines()
files=set(); cur=None
for line in txt:
    m=re.match(r'# configuration file (.+?):', line.strip())
    if m: cur=m.group(1); continue
    if cur and 'server_name' in line and 'fireinners.online' in line:
        files.add(cur)
best=""; best_score=-1
for f in files:
    score=0; cur=None
    for line in txt:
        m=re.match(r'# configuration file (.+?):', line.strip())
        if m: cur=m.group(1); continue
        if cur!=f: continue
        if 'server_name' in line and 'fireinners.online' in line: score+=10
        if re.search(r'listen\s+443', line): score+=3
        if 'ssl' in line: score+=1
    if score>best_score: best_score=score; best=f
print(best)
PY
"$NGT")"

[ -n "${VHOST_DETECTED:-}" ] || die "Could not detect vhost serving fireinners.online"
echo "$VHOST_DETECTED" > "$RB_DIR/vhost_patched_path.txt"
cp -a "$VHOST_DETECTED" "$RB_DIR/vhost_backup.conf" || true

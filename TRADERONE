@echo off
setlocal EnableExtensions EnableDelayedExpansion
title ROBO600 - Export STL (1:3) - OneShot

REM ==== ROOT: argument 1 sinon dossier courant ====
set "ROOT=%~1"
if not defined ROOT set "ROOT=%CD%"
if not exist "%ROOT%" (echo [ERREUR] Dossier introuvable: "%ROOT%" & pause & exit /b 1)

pushd "%ROOT%" >nul 2>&1 || (echo [ERREUR] Impossible d'ouvrir: "%ROOT%" & pause & exit /b 1)

REM ==== Fix extensions si Windows a garde .txt ====
for %%F in (*.bat.txt) do ren "%%~nxF" "%%~nF.bat" >nul 2>&1
for %%F in (*.cmd.txt) do ren "%%~nxF" "%%~nF.cmd" >nul 2>&1
for %%F in (*.scad.txt) do ren "%%~nxF" "%%~nF.scad" >nul 2>&1

REM ==== Trouver le SCAD ====
set "SCAD="
if exist "robo600_parts.scad" set "SCAD=%CD%\robo600_parts.scad"
if not defined SCAD if exist "ROBO600_parts.scad" set "SCAD=%CD%\ROBO600_parts.scad"
if not defined SCAD (
  echo [ERREUR] robo600_parts.scad introuvable dans: "%CD%"
  dir /b
  pause
  popd
  exit /b 1
)

REM ==== Trouver OpenSCAD CLI ====
set "OPENSCAD="
if exist "C:\Program Files\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD\openscad.com"
if not defined OPENSCAD if exist "C:\Program Files\OpenSCAD (Nightly)\openscad.com" set "OPENSCAD=C:\Program Files\OpenSCAD (Nightly)\openscad.com"
if not defined OPENSCAD if exist "C:\Program Files (x86)\OpenSCAD\openscad.com" set "OPENSCAD=C:\Program Files (x86)\OpenSCAD\openscad.com"
if not defined OPENSCAD (
  echo [ERREUR] OpenSCAD introuvable. Installe OpenSCAD puis relance.
  pause
  popd
  exit /b 1
)

REM ==== Output ====
set "OUT=%CD%\out_stl"
if not exist "%OUT%" mkdir "%OUT%" >nul 2>&1

echo.
echo ==== ROBO600 EXPORT ====
echo ROOT: %CD%
echo SCAD: %SCAD%
echo OPENSCAD: %OPENSCAD%
echo OUT: %OUT%
echo.

REM ==== Export 1:3 ====
"%OPENSCAD%" -o "%OUT%\ROBO600_ALL_1to3.stl" "%SCAD%" -D "SCALE=0.333333" -D "scale=0.333333" -D "PART=\"all\"" > "%OUT%\openscad_export.log" 2>&1

if errorlevel 1 (
  echo [ERREUR] Export echoue. Log:
  type "%OUT%\openscad_export.log"
  pause
  popd
  exit /b 1
)

echo.
echo OK - STL genere:
dir /b "%OUT%\*.stl"
echo.
echo Log: "%OUT%\openscad_export.log"
pause
popd
endlocal
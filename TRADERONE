from pathlib import Path
import re
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# remove any script tag mistakenly pointing to /wolverine/solana-rpc
s=re.sub(r'<script[^>]+src=["\']\/wolverine\/solana-rpc[^"\']*["\'][^>]*>\s*<\/script>\s*','',s,flags=re.I)

# ensure vendor web3 is present
if "/wolverine/vendor/solana-web3.min.js" not in s:
  ins='<script src="/wolverine/vendor/solana-web3.min.js"></script>'
  if "</head>" in s: s=s.replace("</head>",ins+"</head>",1)
  else: s=ins+s

# convert RELATIVE "/wolverine/solana-rpc" to ABSOLUTE via location.origin, but only in JS assignments/fields
def absify(m):
  pre=m.group(1); q=m.group(2); post=m.group(3)
  return pre + 'location.origin + "/wolverine/solana-rpc"' + post

patterns=[
  r'(\bRPC_PRIMARY\s*=\s*)(["\'])\/wolverine\/solana-rpc\2',
  r'(\burl\s*:\s*)(["\'])\/wolverine\/solana-rpc\2',
  r'(\brpcUrl\s*:\s*)(["\'])\/wolverine\/solana-rpc\2',
  r'(\bendpoints?\s*:\s*\[\s*)(["\'])\/wolverine\/solana-rpc\2'
]
for pat in patterns:
  s=re.sub(pat, lambda m: m.group(1)+'location.origin + "/wolverine/solana-rpc"', s)

# also replace plain "/wolverine/solana-rpc" inside a quoted string that is passed to new Connection(...)
s=re.sub(r'(new\s+[^;\n]*Connection\(\s*)(["\'])\/wolverine\/solana-rpc\2', lambda m: m.group(1)+'(location.origin + "/wolverine/solana-rpc")', s)

p.write_text(s)
print("OK: index.html patched")

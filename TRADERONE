cat >/root/fix_nginx_location_not_allowed.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
CFG="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "== 0) Sanity =="
test -f "$CFG" || { echo "❌ Missing $CFG"; exit 1; }
echo "CFG=$CFG"
echo

echo "== 1) Show the error context (lines 60-90) =="
nl -ba "$CFG" | sed -n '60,90p' || true
echo

echo "== 2) Restore latest backup (.bak_lockfix_*) if exists =="
LATEST_BAK="$(ls -1t ${CFG}.bak_lockfix_* 2>/dev/null | head -n 1 || true)"
if [ -n "${LATEST_BAK:-}" ]; then
  cp -a "$LATEST_BAK" "$CFG"
  echo "Restored: $LATEST_BAK -> $CFG"
else
  echo "No .bak_lockfix_* found. Listing any backups:"
  ls -1t ${CFG}.bak_* 2>/dev/null | head -n 10 || true
  echo "If you have a different backup name, tell me and I’ll adapt."
fi
echo

echo "== 3) Ensure snippet include is present INSIDE server{} (top) =="
SNIP="include /etc/nginx/snippets/traderone_api_lockdown.conf;"
python3 - <<'PY'
from pathlib import Path
import re

cfg = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = cfg.read_text(errors="ignore")

if SNIP in s:
    print("OK: include already present")
else:
    # insert right after the first 'server {' opening
    s2, n = re.subn(r'(server\s*\{\s*)', r'\1\n  ' + SNIP + '\n', s, count=1, flags=re.M)
    if n != 1:
        raise SystemExit("❌ Could not find a server { block to inject include into")
    cfg.write_text(s2)
    print("OK: include injected into first server{} block")
PY
echo

echo "== 4) Test + reload nginx =="
nginx -t
systemctl reload nginx || service nginx reload
echo "DONE ✅"
BASH

chmod +x /root/fix_nginx_location_not_allowed.sh
/root/fix_nginx_location_not_allowed.sh
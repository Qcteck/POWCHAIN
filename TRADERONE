cat >/root/fix_wolverine_js_and_rpc_405.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

HTML="/var/www/wolverine/index.html"
INC="/etc/nginx/includes/wolverine_routes.inc"

echo "== 1) Fix JS 'or' syntax in index.html =="
test -f "$HTML" || { echo "Missing $HTML"; exit 1; }
cp -a "$HTML" "${HTML}.bak_${TS}"

python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# remplace l'expression python injectée par du JS valide
s = s.replace('getattr(e,"message",None) or str(e)', '(e && e.message) ? e.message : String(e)')
s = s.replace("getattr(e,'message',None) or str(e)", "(e && e.message) ? e.message : String(e)")

p.write_text(s)
print("OK: index.html patched")
PY

echo "== 2) Ensure /wolverine/rpc is a real JSON-RPC proxy (fix 405/HTML) =="
test -f "$INC" || { echo "Missing $INC"; exit 1; }
cp -a "$INC" "${INC}.bak_${TS}"

# ajoute le bloc rpc si absent
if ! grep -q 'WOLVERINE_RPC_PROXY' "$INC"; then
cat >> "$INC" <<'NGX'

# WOLVERINE_RPC_PROXY
# Proxy JSON-RPC Solana (same-origin) for the UI
location = /wolverine/rpc {
  proxy_http_version 1.1;
  proxy_ssl_server_name on;

  proxy_set_header Host api.mainnet-beta.solana.com;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  proxy_pass https://api.mainnet-beta.solana.com/;
}
NGX
fi

echo "== 3) nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "== 4) Test RPC (POST) should return JSON =="
curl -sk -X POST https://fireinners.online/wolverine/rpc \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -c 200
echo
echo "DONE ✅"
BASH

chmod +x /root/fix_wolverine_js_and_rpc_405.sh
/root/fix_wolverine_js_and_rpc_405.sh
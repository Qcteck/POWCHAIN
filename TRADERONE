set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
FINAL="/etc/nginx/snippets/wolverine_final.conf"
PAT='location[[:space:]]+(\^~|~\*?|=)?[[:space:]]*/wolverine/traderone/api/?'

echo "=== 0) Backup quick ==="
cp -a /etc/nginx "/etc/nginx.bak.$TS"

echo "=== 1) Source of truth: qui définit traderone/api (nginx -T) ==="
nginx -T 2>/dev/null | grep -nE "$PAT" | head -n 200 || true

echo
echo "=== 2) Fichiers sur disque qui contiennent cette location ==="
mapfile -t FILES < <(grep -RIn --include="*.conf" -E "$PAT" /etc/nginx 2>/dev/null | awk -F: '{print $1}' | sort -u)
printf ' - %s\n' "${FILES[@]:-<none>}"

echo
echo "=== 3) Désactiver toutes les locations duplicate (sauf wolverine_final.conf) ==="
i=0
for f in "${FILES[@]}"; do
  if [ "$f" = "$FINAL" ]; then
    echo "Keep (final): $f"
    continue
  fi
  i=$((i+1))
  cp -a "$f" "$f.bak.dupe_traderone_api.$TS"
  sed -i -E "s|location[[:space:]]+(\^~|~\*?|=)?[[:space:]]*/wolverine/traderone/api/?|location ^~ /_disabled_dupe_traderone_api_${TS}_${i}/|g" "$f"
  echo "Disabled in: $f"
done

echo
echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "✅ OK - plus de duplicate. Backup: /etc/nginx.bak.$TS"
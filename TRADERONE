<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Gap Strict++ + Σw réel + BOOST</title>
<style>
body { font-family: Arial, sans-serif; background:#111; color:#eee; padding:20px; }
#log { max-height:150px; overflow-y:scroll; background:#222; padding:10px; border-radius:5px; margin-top:10px; }
.ok { color:#0f0; }
.error { color:#f00; }
canvas { background:#222; display:block; margin:10px 0; border:1px solid #444; }
button { margin:5px; padding:5px 10px; font-size:14px; }
#sumContainer {margin-top:10px;}
</style>
</head>
<body>

<h2>Moteur Quantique : Gap Strict++ + Σw réel + BOOST</h2>
<button id="startBtn">Lancer Test</button>
<button id="boostBtn">BOOST</button>

<div id="sumContainer">
    Σw réel : <span id="msw">0</span> | tail : <span id="tailDisplay">0</span>
</div>

<h3>Graphique E (Gap)</h3>
<canvas id="graphE" width="800" height="200"></canvas>
<h3>Graphique N_c</h3>
<canvas id="graphNc" width="800" height="100"></canvas>
<h3>Graphique H_w</h3>
<canvas id="graphHw" width="800" height="100"></canvas>
<h3>Spectre Gap Strict++</h3>
<canvas id="graphSpectre" width="800" height="100"></canvas>

<h3>Logs :</h3>
<div id="log"></div>

<script>
// Paramètres strict++
const N_cycles = 200;
let E_base = [0.12, 0.18]; 
let E_top = [0.52, 0.58]; 
const E_mass = [0.85, 0.95]; 
let A3A4 = [0.045, 0.045]; 
const tail_epsilon = 0.001; 

const N_min=5, N_max=15;
const H_min=0.3, H_max=0.7;

// État moteur
let moteur = { E:0.12, N_c:10, H_w:0.5 };

// Historique
let histE=[], histNc=[], histHw=[];

// Canvas
const canvasE = document.getElementById('graphE'); const ctxE = canvasE.getContext('2d');
const canvasNc = document.getElementById('graphNc'); const ctxNc = canvasNc.getContext('2d');
const canvasHw = document.getElementById('graphHw'); const ctxHw = canvasHw.getContext('2d');
const canvasSpec = document.getElementById('graphSpectre'); const ctxSpec = canvasSpec.getContext('2d');

// Graphiques temps réel
function drawGraph(ctx,data,color,minY,maxY){
    ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height);
    ctx.beginPath();
    ctx.strokeStyle=color;
    const step=ctx.canvas.width/N_cycles;
    data.forEach((v,i)=>{
        const y=ctx.canvas.height-( (v-minY)/(maxY-minY)*ctx.canvas.height );
        if(i===0) ctx.moveTo(0,y);
        else ctx.lineTo(i*step,y);
    });
    ctx.stroke();
}

// Spectre barres strict++
function drawSpectre(ctx,state){
    ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height);
    const w=ctx.canvas.width; const h=ctx.canvas.height; const barH=h-10;
    // A3/A4
    ctx.fillStyle="#ff0";
    if(state.E>=A3A4[0] && state.E<=A3A4[1]) ctx.fillRect(w*0.1, h-barH, 30, barH);
    // E_base
    ctx.fillStyle="#0f0";
    if(state.E>=E_base[0] && state.E<=E_base[1]) ctx.fillRect(w*0.25, h-barH, 30, barH);
    // E_top
    ctx.fillStyle="#0ff";
    if(state.E>=E_top[0] && state.E<=E_top[1]) ctx.fillRect(w*0.45, h-barH, 30, barH);
    // E_mass
    ctx.fillStyle="#f0f";
    if(state.E>=E_mass[0] && state.E<=E_mass[1]) ctx.fillRect(w*0.65, h-barH, 30, barH);
    // tail quasi zéro : barre minuscule
    ctx.fillStyle="#444";
    if(state.E<0 || state.E>1) ctx.fillRect(w*0.8,h-barH,5,barH*tail_epsilon);
}

// Fonctions moteur
function T(state){
    state.E += (Math.random()-0.5)*0.02;
    state.N_c += Math.round((Math.random()-0.5)*1);
    state.H_w += (Math.random()-0.5)*0.02;
    return state;
}

// Détection niveau
function detecte_niveau(state){
    if(state.E>=E_mass[0] && state.E<=E_mass[1]) return 'E_mass';
    if(state.E>=E_top[0] && state.E<=E_top[1]) return 'E_top';
    if(state.E>=E_base[0] && state.E<=E_base[1]) return 'E_base';
    if(state.E>=A3A4[0] && state.E<=A3A4[1]) return 'A3/A4';
    return 'vide';
}

// Correction hors-bande
function corrige_hors_bande(state){
    const niveau = detecte_niveau(state);
    if(niveau==='vide'){
        if(state.E<A3A4[0]) state.E=A3A4[0];
        else state.E=E_mass[1];
    }
    if(niveau==='A3/A4' && state.E>=E_mass[0]) state.E=A3A4[1];
    if(state.N_c<N_min) state.N_c=N_min;
    if(state.N_c>N_max) state.N_c=N_max;
    if(state.H_w<H_min) state.H_w=H_min;
    if(state.H_w>H_max) state.H_w=H_max;
    return state;
}

// Symétries
function panneau_verifie_symmetries(state){
    return Math.random()<0.02?false:true; 
}

// Log
function logCycle(cycle,state,sym_ok){
    const div=document.getElementById('log');
    const line=document.createElement('div');
    line.innerHTML=`Cycle ${cycle} | Niveau <b>${detecte_niveau(state)}</b> | E: ${state.E.toFixed(3)} | N_c: ${state.N_c} | H_w: ${state.H_w.toFixed(2)} | Symétries: <span class="${sym_ok?'ok':'error'}">${sym_ok?'OK':'VIOLATION'}</span>`;
    div.appendChild(line);
    div.scrollTop=div.scrollHeight;
}

// Mise à jour Σw et tail
function updateSumTail(state){
    const lambda1 = E_base[1]; // approximation doublet
    const lambda2 = E_top[0];  
    const lambda_sub = A3A4; 
    const sum_w = lambda1 + lambda2 + lambda_sub.reduce((a,b)=>a+b,0);
    document.getElementById('msw').textContent = sum_w.toFixed(3);
    const tail = 1 - (lambda1 + lambda2);
    document.getElementById('tailDisplay').textContent = tail.toFixed(3);
}

// BOOST
document.getElementById('boostBtn').addEventListener('click', ()=>{
    const center = (E_top[0]+E_top[1])/2;
    E_base = [center-0.05, center-0.02];
    E_top = [center+0.02, center+0.05];
    A3A4 = [0.045,0.045];
    console.log("BOOST activé : doublet et sous-niveaux recentrés pour gap émergent");
});

// Lancement
document.getElementById('startBtn').addEventListener('click',()=>{
    let cycle=0;
    let interval=setInterval(()=>{
        if(cycle>=N_cycles){ clearInterval(interval); return; }

        moteur=T(moteur);
        moteur=corrige_hors_bande(moteur);
        const sym_ok=panneau_verifie_symmetries(moteur);

        histE.push(moteur.E);
        histNc.push(moteur.N_c);
        histHw.push(moteur.H_w);

        logCycle(cycle,moteur,sym_ok);
        updateSumTail(moteur);

        drawGraph(ctxE,histE,'#0f0',0,1.1);
        drawGraph(ctxNc,histNc,'#0ff',N_min-1,N_max+1);
        drawGraph(ctxHw,histHw,'#ff0',H_min-0.1,H_max+0.1);
        drawSpectre(ctxSpec,moteur);

        cycle++;
    },50);
});
</script>

</body>
</html>

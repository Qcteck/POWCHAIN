say "4) Remove any existing /aquilatrader locations from wolverine_static.inc (if present)"
if [ -f "$WOLV_INC" ]; then
  python3 - <<'PY'
import re
path="/etc/nginx/includes/wolverine_static.inc"
with open(path,"r",encoding="utf-8",errors="ignore") as f:
    lines=f.read().splitlines(True)

out=[]
i=0
removed=0

def is_aquilatrader_loc(line):
    return re.search(r'location\s+\^~\s+/aquilatrader/|location\s+/aquilatrader/|location\s+=\s+/aquilatrader', line) is not None

while i < len(lines):
    line = lines[i]

    # Remove managed blocks if any
    if line.strip() == "# BEGIN AQUILATRADER_MANAGED":
        removed += 1
        i += 1
        while i < len(lines) and lines[i].strip() != "# END AQUILATRADER_MANAGED":
            i += 1
        if i < len(lines):
            i += 1
        continue

    # Remove any location block that targets /aquilatrader (best-effort brace match)
    if is_aquilatrader_loc(line):
        removed += 1
        brace=0
        # count braces starting from current line
        while i < len(lines):
            brace += lines[i].count("{")
            brace -= lines[i].count("}")
            i += 1
            if brace <= 0 and "}" in lines[i-1]:
                break
        continue

    out.append(line)
    i += 1

# Normalize trailing newline
txt="".join(out)
if txt and not txt.endswith("\n"):
    txt += "\n"

with open(path,"w",encoding="utf-8") as f:
    f.write(txt)

print("OK: cleaned wolverine_static.inc; removed_blocks=", removed)
PY
else
  say "wolverine_static.inc not present -> skip cleanup"
fi

cat >/root/WOLVERINE_VAULT_ONLY_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE — VAULT ONLY FIX (ISOLATED) ==="

### PATHS CONFIRMÉS
FRONT="/var/www/wolverine/index.html"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_INC="/etc/nginx/includes/wolverine_vault_api.inc"
API_PORT=3000
TS="$(date +%Y%m%d_%H%M%S)"

### 1) BACKUP FRONTEND
cp -a "$FRONT" "$FRONT.bak_vault_$TS"

### 2) INJECT VAULT UI (ISOLÉ)
if ! grep -q "VAULT_WIDGET_START" "$FRONT"; then
sed -i '/<\/body>/i\
<!-- VAULT_WIDGET_START -->\
<div id="vaultBox" style="border:2px solid #00ffcc;padding:12px;margin-top:15px">\
  <h3>Vault</h3>\
  <button id="createVaultBtn">Créer mon Vault</button><br><br>\
  <div>Vault: <span id="vaultAddr">-</span></div>\
  <div>Vault SOL: <span id="vaultSol">-</span></div>\
</div>\
<script>\
async function vaultPost(path,data){\
  const r=await fetch(path,{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify(data)});\
  const t=await r.text();\
  try{return JSON.parse(t)}catch(e){throw new Error(t)}\
}\
document.getElementById(\"createVaultBtn\").onclick=async()=>{\
  if(!window.walletAddress)return alert(\"Wallet non connecté\");\
  try{\
    const r=await vaultPost(\"/wolverine/vault/api/create\",{owner:walletAddress});\
    document.getElementById(\"vaultAddr\").textContent=r.vault;\
    document.getElementById(\"vaultSol\").textContent=r.sol;\
  }catch(e){alert(\"Vault requis\");console.error(e)}\
};\
</script>\
<!-- VAULT_WIDGET_END -->\
</body>' "$FRONT"
fi

### 3) NGINX VAULT API (SÉPARÉ)
cat > "$NGINX_INC" <<EOF
location /wolverine/vault/api/ {
  proxy_pass http://127.0.0.1:${API_PORT}/vault/api/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
}
EOF

grep -q wolverine_vault_api.inc "$NGINX_SITE" || \
sed -i "/server {/a\\    include ${NGINX_INC};" "$NGINX_SITE"

### 4) RELOAD NGINX
nginx -t
systemctl reload nginx

echo "=== OK — VAULT ISOLÉ, FRONTEND PRÉSERVÉ ==="
echo "Recharge la page (CTRL+SHIFT+R)"
BASH

chmod +x /root/WOLVERINE_VAULT_ONLY_FIX.sh
/root/WOLVERINE_VAULT_ONLY_FIX.sh
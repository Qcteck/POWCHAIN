# --- FRONT patch js (UI dépôt + confirme + révèle START)
cat >"$FRONT_DIR/patches/wolv_deposit_confirm.js" <<'JS'
(()=>{"use strict";
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const fmt=(n,d)=>{n=Number(n||0);if(!isFinite(n))n=0;return n.toFixed(d);};
const byText=(tag,needle)=>$$(tag).find(e=>((e.textContent||e.value||"")+"").toLowerCase().includes(needle));
function getTraderOneAddr(){
  const t=document.body.innerText||"";
  const m=t.match(/Wallet TraderOne[^]*?Adresse:\s*([1-9A-HJ-NP-Za-km-z]{32,44})/i);
  return m?m[1]:"";
}
function findStartBtn(){
  return byText("button","start wolverine")||byText("input","start wolverine")||byText("button","start")||byText("input","start");
}
function findConnectBtn(){
  return byText("button","connect wallet")||byText("input","connect wallet")||byText("button","phantom")||byText("input","phantom");
}
async function getPub(){
  if(!window.solana||!window.solana.isPhantom) return "";
  if(window.solana.publicKey) return window.solana.publicKey.toBase58();
  try{const r=await window.solana.connect({onlyIfTrusted:true});return (r&&r.publicKey)?r.publicKey.toBase58():"";}catch(_){return "";}
}
function ensureBox(){
  if($("#wolvDepositBox")) return;
  const host=$("#top")||document.body;
  const box=document.createElement("div");
  box.id="wolvDepositBox";
  box.style.margin="10px 0";
  box.style.padding="10px";
  box.style.border="1px solid #bbb";
  box.style.borderRadius="8px";
  box.style.maxWidth="980px";
  const to=getTraderOneAddr()||"(adresse TraderOne introuvable)";
  box.innerHTML=
    '<div style="font-weight:700;margin-bottom:6px">Dépôt manuel (TraderOne)</div>'+
    '<div style="font-size:13px;margin-bottom:8px">1) Envoie SOL/USDC vers: <span id="wolvTo" style="font-family:monospace">'+to+'</span> <button type="button" id="wolvCopyTo">Copier</button></div>'+
    '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:6px">'+
      '<label>Asset <select id="wolvAsset"><option value="SOL">SOL</option><option value="USDC">USDC</option></select></label>'+
      '<label>Montant <input id="wolvAmt" type="number" step="0.000001" min="0" style="width:140px" placeholder="ex: 1"/></label>'+
      '<label>Signature TX <input id="wolvSig" type="text" style="width:420px;max-width:70vw" placeholder="colle le txid"/></label>'+
      '<button type="button" id="wolvConfirm">CONFIRMER ON-CHAIN</button>'+
    '</div>'+
    '<div id="wolvDepStatus" style="font-size:13px">Connecte Phantom, puis confirme le dépôt.</div>';
  host.appendChild(box);
  $("#wolvCopyTo").onclick=async()=>{try{await navigator.clipboard.writeText($("#wolvTo").textContent.trim());$("#wolvDepStatus").textContent="Copié."; }catch(e){$("#wolvDepStatus").textContent="Copie refusée (navigateur).";}};
}
async function main(){
  ensureBox();
  const startBtn=findStartBtn();
  if(startBtn) startBtn.style.display="none";

  // si l'utilisateur clique Connect -> on refresh pub
  const c=findConnectBtn();
  if(c) c.addEventListener("click",async()=>{await sleep(600); const pub=await getPub(); if(pub) $("#wolvDepStatus").textContent="Wallet connecté: "+pub;});

  $("#wolvConfirm").onclick=async()=>{
    try{
      const pub=await getPub();
      if(!pub) throw new Error("Connecte Phantom d'abord");
      const to=$("#wolvTo").textContent.trim();
      if(!to || to.includes("introuvable")) throw new Error("Adresse TraderOne introuvable sur la page");
      const asset=$("#wolvAsset").value;
      const amt=Number($("#wolvAmt").value||0);
      if(!(amt>0)) throw new Error("Montant invalide");
      const sig=$("#wolvSig").value.trim();
      if(sig.length<20) throw new Error("Signature TX invalide");
      $("#wolvDepStatus").textContent="Vérification on-chain...";
      const r=await fetch("/api/confirm_deposit",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({pub,asset,amount:amt,sig,to})});
      const t=await r.text(); let j=null; try{j=JSON.parse(t);}catch(_){j={raw:t};}
      if(!r.ok || !j || !j.ok) throw new Error((j&&j.error)||t||("HTTP "+r.status));
      $("#wolvDepStatus").textContent="OK: Dépôt confirmé. Delta reçu: "+fmt(j.delta, asset==="SOL"?6:2)+" "+asset+" • Ledger mis à jour.";
      const sb=findStartBtn(); if(sb) sb.style.display="";
    }catch(e){
      $("#wolvDepStatus").textContent="ERR: "+(e&&e.message?e.message:String(e));
    }
  };

  // petit auto-refresh pub si déjà trusted
  for(;;){
    const pub=await getPub();
    if(pub && $("#wolvDepStatus") && $("#wolvDepStatus").textContent.includes("Connecte Phantom")) $("#wolvDepStatus").textContent="Wallet connecté: "+pub+" • Envoie puis confirme.";
    await sleep(2500);
  }
}
document.addEventListener("DOMContentLoaded",()=>{ensureBox();main();});
})();

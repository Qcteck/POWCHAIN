main(){
  need_root
  mkdir -p "$BK"
  say "Backup -> $BK"
  [ -f "$VHOST" ] && cp -a "$VHOST" "$BK/" || true
  [ -f "$INC" ] && cp -a "$INC" "$BK/" || true
  [ -d "$WEBROOT" ] && cp -a "$WEBROOT" "$BK/webroot" || true

  say "Unfreeze nginx (best-effort)"
  unfreeze /etc/nginx/nginx.conf "$VHOST" "$INC Remember" 2>/dev/null || true
  unfreeze "$VHOST" "$INC" 2>/dev/null || true

  say "Disable other wolverine includes"
  disable_other_wolverine_includes

  say "Write canonical include"
  write_include

  say "Write UI index.html"
  write_index_html
  mkdir -p "$WEBROOT/vendor" || true

  say "Ensure vhost enabled"
  [ -f "$VHOST" ] || { echo "MISSING VHOST: $VHOST"; exit 1; }
  ln -sf "$VHOST" "$VHOST_EN"

  say "Inject include into SSL server"
  inject_include_into_ssl_server "$VHOST"

  say "nginx -t"
  nginx -t

  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx

  say "Tests"
  echo "== local SNI -> 127.0.0.1 (HEAD) =="
  curl -skI --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true
  echo "== public (HEAD) =="
  curl -skI "https://${DOMAIN}/wolverine/" | sed -n "1,12p" || true
  echo "== webroot (ls) =="
  ls -la "$WEBROOT" | sed -n "1,30p" || true

  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
}


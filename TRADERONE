set -euo pipefail

echo "=== 1) Trouver tous les includes de snippets .conf dans /etc/nginx ==="
grep -RIn --color=never 'include\s\+/etc/nginx/snippets/[^;]*\.conf;' /etc/nginx || true
echo

echo "=== 2) Lister les snippets existants (pour info) ==="
ls -1 /etc/nginx/snippets | sed 's/^/ - /' | head -n 200 || true
echo

echo "=== 3) Corriger automatiquement les includes cassés ==="
# on parcourt chaque include de /etc/nginx/snippets/*.conf
while IFS= read -r line; do
  file="${line%%:*}"            # fichier nginx concerné
  inc="$(echo "$line" | sed -n 's/.*include\s\+\([^;]*\.conf\);.*/\1/p')"  # chemin inclus

  [ -n "$inc" ] || continue

  if [ ! -f "$inc" ]; then
    alt="${inc%.conf}.server.inc"

    cp -a "$file" "$file.bak.$(date +%s)" || true

    if [ -f "$alt" ]; then
      sed -i "s|include $inc;|include $alt;|g" "$file"
      echo "Patched: $file  ($inc -> $alt)"
    else
      # ni .conf ni .server.inc : on retire la ligne
      sed -i "\|include $inc;|d" "$file"
      echo "Removed: $file  (include $inc;)"
    fi
  fi
done < <(grep -RIn --color=never 'include\s\+/etc/nginx/snippets/[^;]*\.conf;' /etc/nginx || true)

echo
echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx
echo "✅ OK"
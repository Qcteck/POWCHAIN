#!/bin/bash
set -e

echo "=== WOLVERINE — ROLLBACK TOTAL UI ==="

UI="/var/www/wolverine/index.html"

echo "[1/3] Recherche du dernier backup"
BACKUP=$(ls -td /var/www/_BACKUP_WOLVERINE_* 2>/dev/null | head -n1)

if [ -z "$BACKUP" ]; then
  echo "❌ Aucun backup trouvé. STOP."
  exit 1
fi

echo "✔️ Backup trouvé : $BACKUP"

echo "[2/3] Restauration index.html"
cp -f "$BACKUP/index.html" "$UI"

echo "[3/3] Permissions"
chown www-data:www-data "$UI" || true
chmod 644 "$UI"

echo "✅ ROLLBACK TERMINÉ"
echo "➡️ UI remise EXACTEMENT comme avant les patches"
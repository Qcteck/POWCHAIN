cat >/root/rewrite_wolverine_routes_clean.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
SNIP="/etc/nginx/snippets/wolverine_routes.conf"
TS="$(date +%Y%m%d_%H%M%S)"

cp -a "$SNIP" "$SNIP.bak_$TS" 2>/dev/null || true

cat > "$SNIP" <<'NGX'
# Wolverine routes (clean)

# Traderone API under /wolverine/traderone/api/
location = /wolverine/traderone/api {
  return 301 /wolverine/traderone/api/;
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:8585;
}
NGX

echo "== nginx -t =="
nginx -t
echo "== reload =="
systemctl reload nginx || service nginx reload

echo "== test =="
curl -sk -o /dev/null -w "health: %{http_code}\n" https://fireinners.online/wolverine/traderone/api/health
echo "DONE ✅"
BASH

chmod +x /root/rewrite_wolverine_routes_clean.sh
/root/rewrite_wolverine_routes_clean.sh
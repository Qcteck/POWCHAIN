cat >/root/WOLVERINE_RESET_FRONTEND.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP="${HTML}.bak_${TS}"

echo "[1/5] Backup"
cp -a "$HTML" "$BACKUP"

echo "[2/5] Reset frontend"

cat >"$HTML" <<'HTML'
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>WOLVERINE</title>
<style>
body{background:#050b10;color:#6cf;font-family:monospace}
.box{width:420px;margin:80px auto;border:2px solid #6cf;padding:12px}
button{width:100%;margin:6px 0;padding:10px;background:#000;color:#6cf;border:1px solid #6cf;cursor:pointer}
</style>
</head>
<body>

<div class="box">
<button id="connect">Connect Wallet</button>
<button id="refresh">Refresh</button>
<div>Address: <span id="addr">-</span></div>
<div>SOL: <span id="sol">-</span></div>
<div>USDC: <span id="usdc">-</span></div>
</div>

<script src="/wolverine/vendor/solana-web3.min.js"></script>
<script>
(() => {
  const RPC="https://lb.drpc.live/solana/AsxThpeKkEjGtZhCNUEQYo1ZluSgmwsR76RdFhW5UfFk";
  const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

  let provider=null, pubkey=null;
  const conn=new solanaWeb3.Connection(RPC,"confirmed");

  async function connect(){
    provider=window.solana;
    if(!provider) return alert("Phantom manquant");
    const r=await provider.connect();
    pubkey=r.publicKey;
    document.getElementById("addr").textContent=pubkey.toBase58();
    refresh();
  }

  async function refresh(){
    if(!pubkey) return;
    const lamports=await conn.getBalance(pubkey);
    document.getElementById("sol").textContent=(lamports/1e9).toFixed(6);

    const res=await conn.getParsedTokenAccountsByOwner(
      pubkey,{mint:new solanaWeb3.PublicKey(USDC_MINT)}
    );
    let total=0;
    res.value.forEach(v=>{
      total+=Number(v.account.data.parsed.info.tokenAmount.uiAmount||0);
    });
    document.getElementById("usdc").textContent=total.toFixed(2);
  }

  document.getElementById("connect").addEventListener("click",connect);
  document.getElementById("refresh").addEventListener("click",refresh);
})();
</script>

</body>
</html>
HTML

echo "[3/5] Permissions"
chmod 644 "$HTML"

echo "[4/5] Reload nginx"
nginx -t && systemctl reload nginx

echo "[5/5] DONE"
echo "Backup: $BACKUP"
BASH

chmod +x /root/WOLVERINE_RESET_FRONTEND.sh
/root/WOLVERINE_RESET_FRONTEND.sh
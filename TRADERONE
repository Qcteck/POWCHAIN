cat >/tmp/FIX_WOLV_HIDDEN_INCLUDES.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ts(){ date +%Y%m%d_%H%M%S; }
T="$(ts)"
BK="/root/backup_wolv_hidden_${T}"
mkdir -p "$BK"

echo "=== 1) Trouver TOUS les includes qui peuvent charger wolverine_unified/static ==="
grep -RIn --color=never -E 'include\s+.*(snippets/\*\.conf|wolverine_unified\.conf|wolverine_static_tryfiles\.conf)' \
  /etc/nginx/nginx.conf /etc/nginx/conf.d /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/snippets \
  || true

echo
echo "=== 2) Commenter partout: include snippets/*.conf ET include wolverine_unified/static ==="
FILES=$(grep -RIl --color=never -E 'include\s+.*(snippets/\*\.conf|wolverine_unified\.conf|wolverine_static_tryfiles\.conf)' \
  /etc/nginx/nginx.conf /etc/nginx/conf.d /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/snippets \
  || true)

for p in $FILES; do
  cp -a "$p" "$BK/$(echo "$p" | sed 's@/@__@g').bak" || true
  sed -i -E \
    -e 's@^(\s*include\s+/etc/nginx/snippets/\*\.conf;\s*)$@# \1@g' \
    -e 's@^(\s*include\s+.*wolverine_unified\.conf\s*;.*)$@# \1@g' \
    -e 's@^(\s*include\s+.*wolverine_static_tryfiles\.conf\s*;.*)$@# \1@g' \
    "$p"
done

echo
echo "=== 3) Vérifier qu’on inclut fireinners-wolverine.conf UNE seule fois ==="
grep -RIn --color=never 'include\s\+/etc/nginx/snippets/fireinners-wolverine\.conf;' \
  /etc/nginx/nginx.conf /etc/nginx/conf.d /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/snippets \
  || true

echo
echo "=== 4) nginx test + reload ==="
nginx -t
systemctl reload nginx
echo "OK ✅"
SH

bash /tmp/FIX_WOLV_HIDDEN_INCLUDES.sh
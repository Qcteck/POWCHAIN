<script src="/${SLUG}/vendor/solana-web3.iife.min.js"></script>
<script>
const API_BASE="/${SLUG}/api";
const USDC="${USDC_MINT}";
const DEFAULT_RPC1="${SOL_RPC_PRIMARY_DEFAULT}";
const DEFAULT_RPC2="${SOL_RPC_BACKUP_DEFAULT}";
const el=id=>document.getElementById(id);
const log=(m)=>{el("log").textContent=(el("log").textContent?el("log").textContent+"\\n":"")+m;};
const setStatus=(m,ok=null)=>{el("status").textContent=m; el("status").className=ok===true?"ok":ok===false?"bad":"muted";};
const ls=(k,v)=>v===undefined?localStorage.getItem(k):localStorage.setItem(k,v);

el("rpc1").value=ls("iaa_rpc1")||DEFAULT_RPC1;
el("rpc2").value=ls("iaa_rpc2")||DEFAULT_RPC2;
el("inMint").value=ls("iaa_in")||USDC;
el("outMint").value=ls("iaa_out")||"So11111111111111111111111111111111111111112";

let provider=null, pub=null;
let pendingId=null, payloadHash=null, approvalHash=null, txb64=null, txHash=null, signature=null;

async function conn(rpc){
  return new solanaWeb3.Connection(rpc,{commitment:"confirmed"});
}
async function withRpcFallback(fn){
  const r1=el("rpc1").value.trim(), r2=el("rpc2").value.trim();
  try{ return await fn(await conn(r1)); }catch(e1){ log("RPC1 fail: "+(e1?.message||e1)); return await fn(await conn(r2)); }
}
async function refreshBalances(){
  if(!pub){ el("sol").textContent="-"; el("usdc").textContent="-"; return; }
  await withRpcFallback(async(c)=>{
    const lam=await c.getBalance(pub);
    el("sol").textContent=(lam/1e9).toFixed(6);
    const accts=await c.getParsedTokenAccountsByOwner(pub,{programId:new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")});
    let us=0;
    for(const it of accts.value){
      const info=it.account.data.parsed.info;
      if(info.mint===USDC){
        const amt=Number(info.tokenAmount.uiAmount||0);
        us+=amt;
      }
    }
    el("usdc").textContent=us.toFixed(6);
  });
}
async function api(path, body){
  const res=await fetch(API_BASE+path,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body||{})});
  const j=await res.json().catch(()=>({ok:false,error:"bad_json"}));
  if(!res.ok || !j.ok) throw new Error(j.error||("http_"+res.status));
  return j;
}

el("rpc1").addEventListener("change",()=>ls("iaa_rpc1",el("rpc1").value));
el("rpc2").addEventListener("change",()=>ls("iaa_rpc2",el("rpc2").value));
el("inMint").addEventListener("change",()=>ls("iaa_in",el("inMint").value));
el("outMint").addEventListener("change",()=>ls("iaa_out",el("outMint").value));

el("btnConnect").onclick=async()=>{
  try{
    if(!window.solana || !window.solana.isPhantom) throw new Error("Phantom_not_found");
    provider=window.solana;
    const r=await provider.connect();
    pub=new solanaWeb3.PublicKey(r.publicKey.toString());
    el("w").textContent="wallet: "+pub.toString();
    setStatus("Connected",true);
    await refreshBalances();
  }catch(e){
    setStatus("Connect failed",false);
    log("Connect err: "+(e?.message||e));
  }
};

el("btnCreate").onclick=async()=>{
  try{
    if(!pub) throw new Error("connect_wallet_first");
    const inMint=el("inMint").value.trim(), outMint=el("outMint").value.trim(), dir=el("dir").value;
    const slip=Number(el("slip").value||0);
    const dec=Number(el("dec").value||0);
    const amtUi=Number(el("amt").value||0);
    const amountRaw=Math.floor(amtUi*Math.pow(10,dec));
    if(amountRaw<=0) throw new Error("amount_invalid");
    const j=await api("/pending/create",{userPub:pub.toString(),inMint,outMint,dir,amount:String(amountRaw),slippageBps:slip,meta:{dec,amtUi}});
    pendingId=j.pendingId; payloadHash=j.payloadHash;
    approvalHash=null; txb64=null; txHash=null; signature=null;
    el("pmeta").textContent="pendingId="+pendingId+" payloadHash="+payloadHash;
    el("btnApprove").disabled=false; el("btnTx").disabled=true; el("btnSignSend").disabled=true; el("btnCommit").disabled=true;
    setStatus("Pending CREATED",true); log("CREATE ok: "+JSON.stringify(j));
  }catch(e){ setStatus("Create failed",false); log("CREATE err: "+(e?.message||e)); }
};

el("btnApprove").onclick=async()=>{
  try{
    if(!pendingId||!payloadHash||!pub) throw new Error("missing_pending");
    const j=await api("/pending/approve",{pendingId,userPub:pub.toString(),payloadHash});
    approvalHash=j.approvalHash;
    el("btnTx").disabled=false;
    setStatus("Pending APPROVED",true); log("APPROVE ok: "+JSON.stringify(j));
  }catch(e){ setStatus("Approve failed",false); log("APPROVE err: "+(e?.message||e)); }
};

el("btnTx").onclick=async()=>{
  try{
    if(!pendingId||!pub) throw new Error("missing_pending");
    const j=await api("/exec/tx",{pendingId,userPub:pub.toString(),rpcPrimary:el("rpc1").value.trim(),rpcBackup:el("rpc2").value.trim()});
    txb64=j.swapTransaction; txHash=j.txHash;
    el("btnSignSend").disabled=false;
    setStatus("TX READY",true); log("TX ok: txHash="+txHash);
  }catch(e){ setStatus("Build TX failed",false); log("TX err: "+(e?.message||e)); }
};

el("btnSignSend").onclick=async()=>{
  try{
    if(!txb64||!provider||!pub) throw new Error("missing_tx");
    const raw=Uint8Array.from(atob(txb64),c=>c.charCodeAt(0));
    const tx=solanaWeb3.VersionedTransaction.deserialize(raw);
    setStatus("SIGNING...",null);
    const out=await provider.signAndSendTransaction(tx);
    signature=out.signature || out;
    el("btnCommit").disabled=false;
    setStatus("SENT (signature acquired)",true);
    log("SIGN+SEND ok: "+signature);
  }catch(e){ setStatus("Sign+Send failed",false); log("SIGN+SEND err: "+(e?.message||e)); }
};

el("btnCommit").onclick=async()=>{
  try{
    if(!signature||!pendingId||!pub) throw new Error("missing_signature");
    setStatus("COMMIT: confirming finalized...",null);
    const j=await api("/exec/commit",{pendingId,userPub:pub.toString(),signature});
    const st=j.commit?.status||"?";
    if(st==="FINALIZED"){ setStatus("FINALIZED (quota consumed)",true); }
    else if(st==="TIMEOUT"){ setStatus("TIMEOUT (not charged)",false); }
    else if(st==="NOT_FOUND"){ setStatus("DROPPED/NOT_FOUND (not charged)",false); }
    else if(st==="ERROR"){ setStatus("ERROR (not charged)",false); }
    log("COMMIT: "+JSON.stringify(j));
    await refreshBalances();
  }catch(e){ setStatus("Commit failed",false); log("COMMIT err: "+(e?.message||e)); }
};

(async()=>{try{
  const r=await fetch(API_BASE+"/health"); const j=await r.json(); log("HEALTH: "+JSON.stringify(j));
  setStatus("Ready",true);
}catch(e){ setStatus("API unreachable",false); log("HEALTH err: "+(e?.message||e)); }})();
</script></main></body></html>

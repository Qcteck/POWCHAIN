set -euo pipefail

mkdir -p /etc/nginx/sites-disabled
cd /etc/nginx/sites-enabled

echo "=== 0) Avant ==="
ls -lah | sed -n '1,200p'
echo

echo "=== 1) Déplacer TOUT sauf le vrai vhost actif fireinners.online-ssl ==="
TS=$(date +%s)
for f in *; do
  [ -f "$f" ] || continue
  if [ "$f" = "fireinners.online-ssl" ]; then
    echo "KEEP: $f"
  else
    echo "MOVE: $f -> /etc/nginx/sites-disabled/$f.$TS"
    mv "$f" "/etc/nginx/sites-disabled/$f.$TS"
  fi
done

echo
echo "=== 2) Après ==="
ls -lah /etc/nginx/sites-enabled | sed -n '1,120p'
echo
ls -lah /etc/nginx/sites-disabled | tail -n 20 || true
echo

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx
echo "OK: nginx reloaded"
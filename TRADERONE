cat >/root/MEGA_IAQUILA_FIX_404.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/IAQUILA_FIX_404_${TS}"
mkdir -p "$BK"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

need(){ command -v "$1" >/dev/null 2>&1 || { echo "ERR missing: $1"; exit 1; }; }
asroot(){ [ "$(id -u)" = "0" ] || { echo "ERR run as root"; exit 1; }; }

asroot
need nginx
need curl
need python3
need lsattr
need chattr

SLUG="iaaquila"
DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC="/etc/nginx/includes/${SLUG}_routes.inc"
WEB="/var/www/${SLUG}"
PORT="9688"

say "== 0) Backup =="
cp -a "$VHOST" "$BK/$(basename "$VHOST").bak" 2>/dev/null || true
cp -a "$INC" "$BK/$(basename "$INC").bak" 2>/dev/null || true
cp -a "$WEB" "$BK/${SLUG}.webroot.bak" 2>/dev/null || true
nginx -T >"$BK/nginx.T.txt" 2>/dev/null || true

say "== 1) Unfreeze (best-effort) =="
chattr -i "$VHOST" 2>/dev/null || true
chattr -i "$INC" 2>/dev/null || true

say "== 2) Ensure webroot =="
mkdir -p "$WEB"
if [ ! -f "$WEB/index.html" ]; then
cat >"$WEB/index.html" <<'HTML'
<!doctype html><html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>IA AQUILA</title><style>body{font-family:system-ui,Segoe UI,Roboto,Arial;margin:24px}code{background:#f2f2f2;padding:2px 6px;border-radius:6px}</style><h1>IA AQUILA</h1><p>UI servie via <code>/iaaquila/</code></p><ul><li><a href="/iaaquila/api/health">/iaaquila/api/health</a></li></ul></html>
HTML
fi

say "== 3) Write routes include (deterministic) =="
mkdir -p "$(dirname "$INC")"
cat >"$INC" <<INCFILE
# ${SLUG} routes (managed)
location = /${SLUG} { return 301 /${SLUG}/; }
location ^~ /${SLUG}/ {
  root /var/www;
  try_files \$uri \$uri/ /${SLUG}/index.html;
}
location ^~ /${SLUG}/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Connection "";
  proxy_connect_timeout 5s;
  proxy_send_timeout 60s;
  proxy_read_timeout 60s;
  proxy_pass http://127.0.0.1:${PORT}/api/;
}
location ^~ /${SLUG}/exec/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Connection "";
  proxy_connect_timeout 5s;
  proxy_send_timeout 60s;
  proxy_read_timeout 60s;
  proxy_pass http://127.0.0.1:${PORT}/exec/;
}
INCFILE

say "== 4) Inject include into vhost (idempotent) =="
python3 - <<PY
import re,sys,os
vhost="${VHOST}"
inc="include ${INC};"
s=open(vhost,"r",encoding="utf-8",errors="ignore").read().splitlines(True)
if any(inc in ln for ln in s):
  print("OK include already present"); sys.exit(0)

# find server block containing fireinners.online
# strategy: locate a line with "server_name" and fireinners.online, then walk backwards to nearest "server" line, then forward counting braces to end.
idx_sn=None
for i,ln in enumerate(s):
  if "server_name" in ln and "fireinners.online" in ln:
    idx_sn=i; break
if idx_sn is None:
  print("ERR cannot find server_name fireinners.online in vhost"); sys.exit(2)

# find start of server block
start=None
for j in range(idx_sn, -1, -1):
  if re.match(r'^\s*server\s*\{', s[j]):
    start=j; break
if start is None:
  print("ERR cannot find server { for that server_name"); sys.exit(3)

brace=0
end=None
for k in range(start, len(s)):
  brace += s[k].count("{")
  brace -= s[k].count("}")
  if brace==0 and k>start:
    end=k; break
if end is None:
  print("ERR cannot find end of server block"); sys.exit(4)

insert_at=end
pad="  "
# try to match indentation of nearby lines
m=re.match(r'^(\s*)\}', s[end])
if m: pad=m.group(1)
s.insert(insert_at, f"{pad}{inc}\n")
open(vhost,"w",encoding="utf-8").write("".join(s))
print("OK injected")
PY

say "== 5) Nginx test + reload =="
nginx -t
systemctl reload nginx

say "== 6) Smoke tests (local TLS) =="
CODE1="$(curl -k -sS -o /dev/null -w '%{http_code}' "https://127.0.0.1/${SLUG}/" -H "Host: ${DOMAIN}" || true)"
CODE2="$(curl -k -sS -o /dev/null -w '%{http_code}' "https://127.0.0.1/${SLUG}/api/health" -H "Host: ${DOMAIN}" || true)"
say "HTTP /${SLUG}/ => ${CODE1}"
say "HTTP /${SLUG}/api/health => ${CODE2}"
if [ "$CODE1" = "404" ]; then
  say "ERR still 404 on /${SLUG}/ (nginx route not active)"
  exit 10
fi

say "== 7) Freeze back (chattr +i) + verify =="
chattr +i "$INC" 2>/dev/null || true
chattr +i "$VHOST" 2>/dev/null || true
say "lsattr vhost/inc:"
lsattr "$VHOST" "$INC" 2>/dev/null || true

say "== DONE =="
say "Public: https://${DOMAIN}/${SLUG}/"
say "API:    https://${DOMAIN}/${SLUG}/api/health"
BASH
chmod +x /root/MEGA_IAQUILA_FIX_404.sh
/root/MEGA_IAQUILA_FIX_404.sh
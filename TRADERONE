#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE SOL FIX — START ==="

### VARIABLES
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
APPDIR="/opt/wolverine-balance"
WEBDIR="/var/www/wolverine"
PORT=3010

### CLEAN
pkill -f wolverine-balance || true
rm -rf "$APPDIR"
mkdir -p "$APPDIR"

### BACKEND
cd "$APPDIR"
cat > server.js <<'JS'
import express from "express";
import fetch from "node-fetch";

const RPC = process.env.RPC;
const app = express();

app.get("/balance/:pub", async (req, res) => {
  try {
    const pub = req.params.pub;
    const r = await fetch(RPC, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        jsonrpc: "2.0",
        id: 1,
        method: "getBalance",
        params: [pub]
      })
    });
    const j = await r.json();
    const lamports = j.result?.value ?? 0;
    res.json({ sol: lamports / 1e9 });
  } catch (e) {
    res.status(500).json({ error: String(e) });
  }
});

app.listen(3010, () => console.log("BALANCE API ON 3010"));
JS


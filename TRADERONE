cat >/root/FIX_NGINX_WOLVERINE_SERVER_SAFE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

NGCONF="/etc/nginx/sites-enabled/fireinners.online-ssl"
BACK="/root/nginx_backup_$(date +%Y%m%d_%H%M%S).conf"

echo "=== FIX WOLVERINE LOCATION INSIDE SERVER ==="

# Backup
cp "$NGCONF" "$BACK"
echo "Backup: $BACK"

# Remove all existing wolverine locations (anywhere)
sed -i '/location \/wolverine\//,/}/d' "$NGCONF"

# Inject location BEFORE last closing server brace
awk '
/server[[:space:]]*{/ {in_server=1}
in_server && /^}/ {
  print "    location /wolverine/ {"
  print "        root /var/www;"
  print "        index index.html;"
  print "        try_files $uri $uri/ /wolverine/index.html;"
  print "        add_header Cache-Control \"no-store\";"
  print "    }"
  in_server=0
}
{print}
' "$NGCONF" > /tmp/nginx.fixed && mv /tmp/nginx.fixed "$NGCONF"

# Test & reload
nginx -t
systemctl reload nginx

echo "=== OK ==="
echo "OPEN: https://fireinners.online/wolverine/"
BASH

chmod +x /root/FIX_NGINX_WOLVERINE_SERVER_SAFE.sh
/root/FIX_NGINX_WOLVERINE_SERVER_SAFE.sh
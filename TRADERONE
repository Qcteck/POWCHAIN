cat >/root/fix_public_waf_403_by_changing_path.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"
JS="/var/www/wolverine/phantom_patch.js"
ts="$(date +%Y%m%d_%H%M%S)"

cp -a "$SNIP" "${SNIP}.bak_${ts}" 2>/dev/null || true
cp -a "$JS" "${JS}.bak_${ts}" 2>/dev/null || true

cat >"$SNIP" <<'NGINX'
# Include INSIDE server{} only.
# Public endpoint /srpc (avoid WAF blocking "/solana-rpc")
location = /srpc {
  auth_basic off;
  allow all;

  add_header Access-Control-Allow-Origin * always;
  add_header Access-Control-Allow-Headers * always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }

  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;
}

# Keep /solana-rpc too (optional)
location = /solana-rpc {
  auth_basic off;
  allow all;

  add_header Access-Control-Allow-Origin * always;
  add_header Access-Control-Allow-Headers * always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  if ($request_method = OPTIONS) { return 204; }

  proxy_pass https://api.mainnet-beta.solana.com/;
  proxy_ssl_server_name on;
  proxy_set_header Host api.mainnet-beta.solana.com;
}
NGINX

# Patch JS to use /srpc
if [[ -f "$JS" ]]; then
  sed -i 's@const RPC = "/solana-rpc"@const RPC = "/srpc"@' "$JS" || true
fi

nginx -t
systemctl reload nginx

echo
echo "== Public test /srpc =="
curl -sk -i "https://${DOMAIN}/srpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,18p'

echo
echo "== Localhost forced test /srpc =="
curl -sk -i --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/srpc" \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getVersion"}' | sed -n '1,18p'

echo
echo "Open: https://${DOMAIN}/wolverine/?v=$ts"
BASH

chmod +x /root/fix_public_waf_403_by_changing_path.sh
/root/fix_public_waf_403_by_changing_path.sh
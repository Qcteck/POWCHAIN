"use strict";
const http = require("http");
const url = require("url");

const PORT = process.env.PORT ? Number(process.env.PORT) : 3000;
const HOST = process.env.HOST || "127.0.0.1";

/**
 * Einshtein engine (deterministic, no randomness)
 * Core concepts remembered:
 * - Zones microcap illiquide: accumulation -8% to -15% (from pivot), distribution +6% to +12%
 * - Checklist strict 5 points as filter before action
 * - No auto-exec unless "ARM" active (here ARM is a server state flag)
 */
const state = {
  arm: false,
  running: false,
  startedAt: null,
  lastPub: null,
  pivot: null,          // pivot price reference
  lastPrice: null,
  lastSignal: null,
  lastReasons: [],
  score: 0
};

function nowISO(){ return new Date().toISOString(); }
function send(res, code, obj){
  const body = JSON.stringify(obj);
  res.writeHead(code, {
    "content-type":"application/json; charset=utf-8",
    "cache-control":"no-store",
    "access-control-allow-origin":"*",
    "access-control-allow-methods":"GET,POST,OPTIONS",
    "access-control-allow-headers":"content-type"
  });
  res.end(body);
}
function readBody(req){
  return new Promise((resolve)=>{
    let b=""; req.on("data",(c)=>{ b+=c; if(b.length>1e6) req.destroy(); });
    req.on("end",()=>{ try{ resolve(b?JSON.parse(b):{}); }catch(_){ resolve({}); } });
  });
}
async function fetchJSON(u, timeoutMs=4500){
  const ac = new AbortController();
  const t = setTimeout(()=>ac.abort(), timeoutMs);
  try{
    const r = await fetch(u, {signal: ac.signal, headers: {"accept":"application/json"}});
    const j = await r.json().catch(()=>null);
    return {ok:r.ok, status:r.status, json:j};
  }catch(e){
    return {ok:false, status:0, json:null, err:String(e&&e.message||e)};
  }finally{ clearTimeout(t); }
}

/**
 * Price source (stable): Jupiter price API (no key)
 * You can later plug your exact mint list; for now we track SOL price as reference engine heartbeat.
 */
async function getSOLPriceUSD(){
  const u = "https://price.jup.ag/v4/price?ids=SOL";
  const r = await fetchJSON(u, 4500);
  const p = r?.json?.data?.SOL?.price;
  if(typeof p === "number" && isFinite(p)) return {ok:true, price:p, src:"jup"};
  return {ok:false, price:null, src:"jup", err:r.err||("bad response "+r.status)};
}

/**
 * Einshtein decision
 * - Sets pivot on first run (or when price makes new local high while not running)
 * - Computes drawdown from pivot
 * - Uses deterministic checklist scoring
 */
function clamp(x,a,b){ return Math.max(a, Math.min(b, x)); }

function checklist({price, drawdown, running, arm}){
  // 5 points (each 0/1) => score 0..5
  // P1: data ok
  const p1 = (typeof price === "number" && isFinite(price)) ? 1 : 0;
  // P2: ARM active to allow actions
  const p2 = arm ? 1 : 0;
  // P3: For BUY we want accumulation zone (-8%..-15%), for SELL we want distribution (+6%..+12%)
  // Here we award if we are within either actionable zone.
  const inAccum = (drawdown <= -0.08 && drawdown >= -0.15);
  const inDistrib = (drawdown >= 0.06 && drawdown <= 0.12);
  const p3 = (inAccum || inDistrib) ? 1 : 0;
  // P4: running flag consistency
  const p4 = (typeof running === "boolean") ? 1 : 0;
  // P5: risk sanity (no action if extreme move beyond thresholds)
  const extreme = (drawdown < -0.25 || drawdown > 0.25);
  const p5 = extreme ? 0 : 1;

  const score = p1+p2+p3+p4+p5;
  return {score, inAccum, inDistrib, extreme, points:{p1,p2,p3,p4,p5}};
}

function decide({price}){
  // pivot initialization / maintenance
  if(state.pivot === null) state.pivot = price;
  // Update pivot if price exceeds pivot and we are NOT running (fresh local high reference)
  if(!state.running && price > state.pivot) state.pivot = price;

  const drawdown = (price - state.pivot) / state.pivot; // negative = below pivot
  const ck = checklist({price, drawdown, running: state.running, arm: state.arm});

  let action = "HOLD";
  const reasons = [];

  reasons.push(`pivot=${state.pivot.toFixed(4)}`);
  reasons.push(`price=${price.toFixed(4)}`);
  reasons.push(`dd=${(drawdown*100).toFixed(2)}%`);
  reasons.push(`ARM=${state.arm? "ON":"OFF"}`);
  reasons.push(`score=${ck.score}/5`);

  if(ck.extreme){
    action = "HOLD";
    reasons.push("EXTREME_MOVE_BLOCK");
  } else if(!state.arm){
    action = "HOLD";
    reasons.push("ARM_REQUIRED");
  } else if(ck.inAccum && ck.score >= 4){
    action = "BUY";
    reasons.push("ACCUM_ZONE_OK");
  } else if(ck.inDistrib && ck.score >= 4){
    action = "SELL";
    reasons.push("DISTRIB_ZONE_OK");
  } else {
    action = "HOLD";
    reasons.push("NO_ZONE");
  }

  // Persist
  state.lastPrice = price;
  state.lastSignal = action;
  state.lastReasons = reasons;
  state.score = ck.score;

  return {action, reasons, drawdown, pivot: state.pivot, score: ck.score, points: ck.points};
}

async function handleSignal(){
  const sol = await getSOLPriceUSD();
  if(!sol.ok) return {ok:false, error:"PRICE_FEED_DOWN", detail: sol.err||"no price"};
  const d = decide({price: sol.price});
  return {ok:true, ts: nowISO(), engine:"Einshtein", symbol:"SOL", price: sol.price, ...d};
}

const server = http.createServer(async (req, res)=>{
  const u = url.parse(req.url, true);
  const path = u.pathname || "/";
  const method = (req.method || "GET").toUpperCase();

  if(method === "OPTIONS"){
    res.writeHead(204, {
      "access-control-allow-origin":"*",
      "access-control-allow-methods":"GET,POST,OPTIONS",
      "access-control-allow-headers":"content-type",
      "cache-control":"no-store"
    });
    return res.end();
  }

  // Health
  if(method === "GET" && path === "/api/health"){
    return send(res, 200, {ok:true, ts: nowISO(), service:"traderone-api", host:HOST, port:PORT, state});
  }

  // Start/Stop/Withdraw/Signal
  if(method === "POST" && path === "/api/start"){
    const body = await readBody(req);
    state.arm = true;
    state.running = true;
    state.startedAt = nowISO();
    state.lastPub = body && body.pub ? String(body.pub) : null;
    // refresh one signal immediately
    const sig = await handleSignal();
    return send(res, 200, {ok:true, action:"STARTED", pub: state.lastPub, state, signal: sig});
  }

  if(method === "POST" && path === "/api/stop"){
    const body = await readBody(req);
    state.running = false;
    state.arm = false;
    state.lastPub = body && body.pub ? String(body.pub) : state.lastPub;
    return send(res, 200, {ok:true, action:"STOPPED", pub: state.lastPub, state});
  }

  if(method === "POST" && path === "/api/withdraw"){
    const body = await readBody(req);
    // SAFE: we do not move funds from server side in this batch.
    // We return an intention payload so you can wire your real vault logic later.
    state.lastPub = body && body.pub ? String(body.pub) : state.lastPub;
    return send(res, 200, {ok:true, action:"WITHDRAW_INTENT_CREATED", pub: state.lastPub, note:"Safe mode. Wire real vault signer later.", state});
  }

  if(method === "POST" && path === "/api/signal"){
    const body = await readBody(req);
    if(body && body.pub) state.lastPub = String(body.pub);
    const sig = await handleSignal();
    return send(res, sig.ok?200:503, sig);
  }

  // Default
  return send(res, 404, {ok:false, error:"NOT_FOUND", method, path});
});

server.listen(PORT, HOST, ()=> {
  // eslint-disable-next-line no-console
  console.log(`[traderone-api] listening on http://${HOST}:${PORT}`);
});
JS

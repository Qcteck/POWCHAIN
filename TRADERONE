say "4) Purge any existing AquilaTrader location blocks across nginx config files (to stop duplicates)"
python3 - <<PY
import os, re, glob, shutil
targets = []
for pat in [
  "${NGX_SA}/*",
  "${NGX_INC_DIR}/*.inc",
  "${NGX_SNP_DIR}/*.conf",
  "${NGX_ETC}/conf.d/*.conf",
]:
  targets += glob.glob(pat)

def strip_aquilatrader(text:str)->str:
  # remove whole "location ... { ... }" blocks that reference /aquilatrader
  # brace-aware scanning
  out=[]
  i=0
  n=len(text)
  while i<n:
    m = re.search(r'(?m)^[ \t]*location[^{\\n]*\\{', text[i:])
    if not m:
      out.append(text[i:])
      break
    start = i + m.start()
    # keep chunk before location
    out.append(text[i:start])
    # find end of this location block by brace balance
    j = start + m.group(0).rfind("{") + 1
    depth = 1
    while j<n and depth>0:
      ch = text[j]
      if ch == "{": depth += 1
      elif ch == "}": depth -= 1
      j += 1
    block = text[start:j]
    if "/aquilatrader" in block:
      # drop this block
      i = j
    else:
      out.append(block)
      i = j
  cleaned = "".join(out)
  # also remove managed markers if present (in case previously appended)
  cleaned = re.sub(r'(?s)#\\s*BEGIN_AQUILATRADER_MANAGED.*?#\\s*END_AQUILATRADER_MANAGED\\s*','', cleaned)
  return cleaned

changed=[]
for path in targets:
  if not os.path.isfile(path): 
    continue
  try:
    with open(path,'r',encoding='utf-8',errors='ignore') as f:
      t = f.read()
  except Exception:
    continue
  if "/aquilatrader" not in t and "AQUILATRADER" not in t:
    continue
  new = strip_aquilatrader(t)
  if new != t:
    shutil.copy2(path, os.path.join("${BK}", os.path.basename(path)+".purge.bak"))
    with open(path,'w',encoding='utf-8') as f:
      f.write(new)
    changed.append(path)

print("PURGED_FILES:", len(changed))
for p in changed[:80]:
  print(" -", p)
PY

set -euo pipefail

OUT="/root/BATCH_FULL_$(date -u +%Y%m%d_%H%M%S).log"
exec > >(tee -a "$OUT") 2>&1

echo "=== BATCH FULL @ $(date -u) ==="
echo "LOG: $OUT"
echo

echo "=== 0) OS / uptime / IP ==="
uname -a || true
uptime || true
echo "IPs:"; (ip -br a || true) | sed 's/^/  /'
echo

echo "=== 1) GIT: scan repos sous /root (status + remote + branch + last commit) ==="
mapfile -t REPOS < <(find /root -maxdepth 4 -type d -name .git -print 2>/dev/null | sed 's#/.git$##' | sort -u)
echo "Repos trouvés: ${#REPOS[@]}"
for r in "${REPOS[@]}"; do
  echo
  echo "----- REPO: $r -----"
  cd "$r"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "skip (not git)"; continue; }
  echo "Remote(s):"; git remote -v || true
  echo "Branch:"; git branch --show-current || true
  echo "Dernier commit:"; git log -1 --oneline --decorate || true
  echo "Status:"; git status -sb || true
  echo "Diff stat (worktree):"; git diff --stat || true
done
echo

echo "=== 2) NGINX: test config + warnings ==="
nginx -t || true
echo

echo "=== 3) NGINX: ports listen 80/443 ==="
(ss -lntp || true) | egrep ':(80|443)\b' || true
echo

echo "=== 4) NGINX: trouver conflits server_name fireinners* ==="
grep -RIn --include='*.conf' 'server_name' /etc/nginx 2>/dev/null | egrep 'fireinners\.online|www\.fireinners\.online' || true
echo

echo "=== 5) NGINX: doublons location /wolverine (c’est ton bug visible) ==="
nginx -T 2>/dev/null \
 | awk '
   $1=="server_name"{sn=$0}
   $1=="location"{loc=$2; gsub(/[{}]/,"",loc); print sn " | " $0}
 ' | grep -E 'location[[:space:]]+/wolverine' || true
echo

echo "=== 6) NGINX: erreurs récentes liées à wolverine/index.html (rewrite cycle) ==="
tail -n 200 /var/log/nginx/error.log 2>/dev/null | egrep -i 'wolverine|rewrite|redirect|cycle|index\.html|_next|favicon' || true
echo

echo "=== 7) Tests locaux (HTTP/HTTPS) ==="
echo "-- curl http://127.0.0.1/ --"
curl -sv --max-time 3 http://127.0.0.1/ -o /dev/null || true
echo "-- curl http://127.0.0.1/wolverine/ --"
curl -sv --max-time 3 http://127.0.0.1/wolverine/ -o /dev/null || true
echo "-- curl https://127.0.0.1/ (sans vérifier cert) --"
curl -skv --max-time 3 https://127.0.0.1/ -o /dev/null || true
echo "-- curl https://127.0.0.1/wolverine/ (sans vérifier cert) --"
curl -skv --max-time 3 https://127.0.0.1/wolverine/ -o /dev/null || true
echo

echo "=== 8) Résumé rapide ==="
echo "Si tu vois:"
echo " - 'duplicate location \"/wolverine\"' => tu as 2 blocs location /wolverine dans le même server{} -> en garder 1."
echo " - 'rewrite or internal redirection cycle ... /index.html' => ta règle try_files/rewrite renvoie /index.html qui retombe dans la même règle."
echo " - Cloudflare 522 => l’origin répond pas/timeout (nginx pas sur 443, firewall, ou boucle qui bloque)."
echo
echo "=== DONE ==="
cat >/root/WOLV_DETECT_BUTTONS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "== FIND WEB DIR =="
WEB_DIR=""
for d in \
  /opt/fireinners/frontend-react/app/dist/wolverine \
  /var/www/fireinners/wolverine \
  /var/www/wolverine \
  /opt/traderone-opt/public/wolverine \
  /opt/traderone-opt/public
do
  if [ -d "$d" ]; then WEB_DIR="$d"; break; fi
done
[ -n "$WEB_DIR" ] || { echo "ERR: dossier wolverine introuvable"; exit 1; }
echo "WEB_DIR=$WEB_DIR"

OUT="/root/wolv_dump"
rm -rf "$OUT"
mkdir -p "$OUT"

echo "== COPY FILES =="
# copie light (sans node_modules si jamais)
tar -C "$WEB_DIR" -cf - . | tar -C "$OUT" -xf -
echo "Copied -> $OUT"

echo "== BASIC FILE LIST =="
( cd "$OUT" && find . -maxdepth 4 -type f | sed 's|^\./||' | sort ) >"$OUT/FILES.txt"

echo "== DETECT ENTRY HTML =="
ENTRY=""
for f in "$OUT"/*.html "$OUT"/**/*.html; do
  [ -f "$f" ] || continue
  if grep -qi "wolverine" "$f" || grep -qi "root" "$f" || grep -qi "script" "$f"; then
    ENTRY="$f"
    break
  fi
done
echo "ENTRY=${ENTRY:-none}" >"$OUT/ENTRY.txt"

echo "== REPORT (BUTTON + HANDLERS) =="
REPORT="$OUT/REPORT.txt"
: >"$REPORT"

echo "### 1) Scripts chargés par HTML" >>"$REPORT"
if [ -n "${ENTRY:-}" ]; then
  echo "# HTML: $ENTRY" >>"$REPORT"
  grep -nE "<script[^>]+src=" "$ENTRY" >>"$REPORT" || true
  echo "" >>"$REPORT"
else
  echo "No HTML entry found in $OUT" >>"$REPORT"
fi

echo "### 2) Recherche handlers (onclick / addEventListener / onClick React)" >>"$REPORT"
# on scan JS/CSS/HTML
grep -RIn --no-messages -E \
  "onclick=|addEventListener\\(['\"]click['\"]|\\.onclick\\s*=|onClick\\s*=|handleClick|share|partager|telegram|whatsapp|facebook|twitter|copy.*link|copier.*lien" \
  "$OUT" \
  --include="*.js" --include="*.mjs" --include="*.cjs" --include="*.html" \
  | head -n 2000 >>"$REPORT" || true
echo "" >>"$REPORT"

echo "### 3) Liste des fichiers JS les plus probables (gros bundles)" >>"$REPORT"
( cd "$OUT" && find . -type f \( -name "*.js" -o -name "*.mjs" -o -name "*.cjs" \) -printf "%s\t%p\n" | sort -nr | head -n 30 ) >>"$REPORT"
echo "" >>"$REPORT"

echo "### 4) Cherche 'routes/api' utilisées côté front (fetch/axios)" >>"$REPORT"
grep -RIn --no-messages -E "fetch\\(|axios\\.|/api/|http://|https://" \
  "$OUT" --include="*.js" --include="*.mjs" --include="*.cjs" \
  | head -n 1500 >>"$REPORT" || true
echo "" >>"$REPORT"

echo "### 5) Si React build: cherche composants sidebar/trade/chart" >>"$REPORT"
grep -RIn --no-messages -E "Dashboard|Trade|Positions|Orders|History|Wallet|Settings|chart|candl|kline|symbol|buy|sell" \
  "$OUT" --include="*.js" --include="*.mjs" --include="*.cjs" \
  | head -n 1500 >>"$REPORT" || true

echo "== DONE =="
echo "Rapport: $REPORT"
echo "Fichiers: $OUT/FILES.txt"
BASH

bash /root/WOLV_DETECT_BUTTONS.sh
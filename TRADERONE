#!/bin/bash
set -e

FILE="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

echo "=== WOLVERINE • UI SMART TEXT + HALO + HOLOGRAM + PARTICLES ==="

node <<'NODE'
const fs=require("fs");
let h=fs.readFileSync(process.env.FILE||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html","utf8");

if(!h.includes("SMART_UI_FX")){
h=h.replace("</body>",`
<style id="SMART_UI_FX">
/* === SMART TEXT COLOR === */
body.light-text *{color:#ffffff!important}
body.dark-text *{color:#0b0b0b!important}

/* === HALO EFFECT === */
.halo{
 text-shadow:
 0 0 6px rgba(255,255,255,.25),
 0 0 12px rgba(255,100,200,.25),
 0 0 18px rgba(80,255,230,.2);
}

/* === HOLOGRAM EFFECT === */
.holo{
 position:relative;
 overflow:hidden;
}
.holo:after{
 content:"";
 position:absolute;
 inset:0;
 background:linear-gradient(
 120deg,
 transparent 30%,
 rgba(255,255,255,.08) 45%,
 transparent 60%
 );
 animation:holoScan 4s linear infinite;
}
@keyframes holoScan{
 0%{transform:translateX(-100%)}
 100%{transform:translateX(100%)}
}

/* === PARTICLES CANVAS === */
#particles{
 position:fixed;
 inset:0;
 z-index:-1;
 pointer-events:none;
}
</style>

<canvas id="particles"></canvas>

<script>
/* === SMART TEXT CONTRAST === */
function luminance(hex){
 const c=hex.replace("#","").match(/.{2}/g).map(x=>parseInt(x,16)/255);
 return c.reduce((a,v,i)=>a+[0.2126,0.7152,0.0722][i]*v,0);
}
function updateTextContrast(){
 const bg=getComputedStyle(document.documentElement)
  .getPropertyValue("--bg1").trim();
 document.body.classList.remove("light-text","dark-text");
 document.body.classList.add(luminance(bg)<0.5?"light-text":"dark-text");
}
setTimeout(updateTextContrast,200);

/* === AUTO APPLY HALO + HOLO === */
document.querySelectorAll("button,h1,h2").forEach(e=>{
 e.classList.add("halo","holo");
});

/* === PARTICLE SYSTEM === */
const c=document.getElementById("particles");
const x=c.getContext("2d");
let W,H,P=[];
function resize(){W=c.width=innerWidth;H=c.height=innerHeight}
addEventListener("resize",resize);resize();

function particleColor(){
 const bg=getComputedStyle(document.documentElement)
  .getPropertyValue("--bg1").trim();
 return bg.includes("ff")?"rgba(80,255,230,.35)":"rgba(255,80,200,.35)";
}
for(let i=0;i<80;i++)
 P.push({x:Math.random()*W,y:Math.random()*H,v:Math.random()*0.3+0.1});

(function loop(){
 x.clearRect(0,0,W,H);
 x.fillStyle=particleColor();
 P.forEach(p=>{
  p.y-=p.v; if(p.y<0)p.y=H;
  x.beginPath(); x.arc(p.x,p.y,1.3,0,7); x.fill();
 });
 requestAnimationFrame(loop);
})();
</script>

</body>`);
}

fs.writeFileSync(process.env.FILE||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html",h);
NODE

nginx -t && systemctl reload nginx

echo "✅ UI intelligente + effets visuels activés"
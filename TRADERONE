p.write_text(s)
print("OK: index.html Aquila injected")
PY

echo "== 6) Quick tests =="
echo "-- vault health (local) --"
curl -sS -D - "http://127.0.0.1:${VAULT_PORT}/health" -o /tmp/vault_health_${TS}.out || true
head -n 10 /tmp/vault_health_${TS}.out || true
echo "-- vault create (public path) --"
curl -sS -D - -X POST -H "content-type: application/json" -d "{\"owner\":\"11111111111111111111111111111111\"}" "https://fireinners.online/wolverine/vault/api/vault/create" -o /tmp/vault_create_${TS}.out || true
head -n 15 /tmp/vault_create_${TS}.out || true

echo
echo "DONE"
echo "OPEN: https://fireinners.online/wolverine/  (Ctrl+F5)"
echo "AQUILA: Budget (SOL) -> click -> confirm -> Phantom popup -> vault create -> SOL transfer"
BASH
chmod +x /root/MEGA_WOLVERINE_AQUILA_SOL.sh
/root/MEGA_WOLVERINE_AQUILA_SOL.sh'
set -e
cd /opt/traderone-opt

echo "=== 0) Backup ==="
cp -a server.js "server.js.bak.fix_dexes_chainbreak.$(date +%s)"

echo "=== 1) Remove the bad injected block (FORCED_DEXES_ROUTE_V3) ==="
node <<'NODE'
const fs = require("fs");
const p = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(p,"utf8");

// remove V3 block if present
s = s.replace(/\/\/ === FORCED_DEXES_ROUTE_V3 ===[\s\S]*?\n\}\);\n\n/g, "");
fs.writeFileSync(p, s);
console.log("OK: removed FORCED_DEXES_ROUTE_V3 if it existed");
NODE

echo "=== 2) Ensure allowlist file ==="
mkdir -p config
test -f config/dex_allowlist.json || cat > config/dex_allowlist.json <<'JSON'
[
  "sushiswap","jupiter","dflow","okx","mayan","chainflip",
  "gasZipBridge","relaydepository","odos","fly","relay"
]
JSON

echo "=== 3) Insert SAFE /api/dexes after app.use(express.json()); ==="
node <<'NODE'
const fs = require("fs");
const p = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(p,"utf8");

function hasLine(re){ return re.test(s); }

// ensure fs/path requires exist once
if(!hasLine(/^const\s+path\s*=\s*require\(["']path["']\);\s*$/m)){
  s = `const path = require("path");\n` + s;
}
if(!hasLine(/^const\s+fs\s*=\s*require\(["']fs["']\);\s*$/m)){
  s = `const fs = require("fs");\n` + s;
}

// insert route at safe anchor
if(!s.includes('app.get("/api/dexes"')) && !s.includes("app.get('/api/dexes'")){
  const anchor = "app.use(express.json());";
  const i = s.indexOf(anchor);
  if(i === -1) throw new Error("Anchor not found: app.use(express.json());");

  const insert = `
${anchor}

app.get("/api/dexes", (req,res)=>{
  try{
    const raw = fs.readFileSync(path.join(__dirname,"config","dex_allowlist.json"),"utf8");
    const a = JSON.parse(raw);
    const dexes = Array.isArray(a) ? a.map(x=>String(x).trim()).filter(Boolean) : [];
    return res.json({ ok:true, dexes });
  }catch(e){
    return res.status(200).json({ ok:true, dexes: [], warn: String(e && e.message || e) });
  }
});
`;
  s = s.slice(0,i) + insert + s.slice(i + anchor.length);
}

fs.writeFileSync(p, s);
console.log("OK: /api/dexes inserted safely");
NODE

echo "=== 4) Syntax check + restart ==="
node --check server.js
pm2 resurrect || true
pm2 restart traderone --update-env || pm2 restart 0 --update-env
sleep 1

echo "=== 5) Test ==="
curl -sS -i http://127.0.0.1:3000/health | head -n 12 || true
echo
curl -sS http://127.0.0.1:3000/api/dexes | head -c 400; echo
cat > "$SOLRPC_JS" <<'JS'
"use strict";
const http = require("http");
const https = require("https");
const { URL } = require("url");

const LISTEN_HOST = process.env.LISTEN_HOST || "127.0.0.1";
const LISTEN_PORT = parseInt(process.env.LISTEN_PORT || "12713", 10);
const UPSTREAM_PRIMARY = process.env.UPSTREAM_PRIMARY || "";
const UPSTREAM_FALLBACK = process.env.UPSTREAM_FALLBACK || "https://api.mainnet-beta.solana.com";

function pickUpstream() {
  const u = (UPSTREAM_PRIMARY && /^https?:\/\//i.test(UPSTREAM_PRIMARY)) ? UPSTREAM_PRIMARY : UPSTREAM_FALLBACK;
  return u;
}

function sendJSON(res, code, obj) {
  const body = Buffer.from(JSON.stringify(obj));
  res.writeHead(code, {
    "content-type": "application/json",
    "content-length": String(body.length),
    "access-control-allow-origin": "*",
    "access-control-allow-methods": "POST,GET,OPTIONS",
    "access-control-allow-headers": "content-type,authorization",
    "cache-control": "no-store",
  });
  res.end(body);
}

function proxyJSON(req, res, rawBody) {
  const upstream = pickUpstream();
  let u;
  try { u = new URL(upstream); }
  catch (e) { return sendJSON(res, 500, { status:"error", error:"bad upstream url", upstream }); }

  const isHttps = (u.protocol === "https:");
  const lib = isHttps ? https : http;

  const opts = {
    method: "POST",
    hostname: u.hostname,
    port: u.port || (isHttps ? 443 : 80),
    path: (u.pathname && u.pathname !== "/") ? u.pathname : "/",
    headers: {
      "content-type": "application/json",
      "content-length": String(rawBody.length),
      "accept": "application/json",
      "user-agent": "wolverine-solrpc-proxy",
    },
  };

  const upReq = lib.request(opts, (upRes) => {
    const chunks = [];
    upRes.on("data", (d) => chunks.push(d));
    upRes.on("end", () => {
      const buf = Buffer.concat(chunks);
      // pass-through status but normalize headers for browser
      res.writeHead(upRes.statusCode || 502, {
        "content-type": (upRes.headers["content-type"] || "application/json"),
        "access-control-allow-origin": "*",
        "access-control-allow-methods": "POST,GET,OPTIONS",
        "access-control-allow-headers": "content-type,authorization",
        "cache-control": "no-store",
      });
      res.end(buf);
    });
  });

  upReq.on("error", (e) => {
    sendJSON(res, 502, { status:"error", error:String(e && e.message ? e.message : e), upstream });
  });

  upReq.write(rawBody);
  upReq.end();
}

const server = http.createServer((req, res) => {
  // CORS preflight
  if (req.method === "OPTIONS") {
    res.writeHead(204, {
      "access-control-allow-origin": "*",
      "access-control-allow-methods": "POST,GET,OPTIONS",
      "access-control-allow-headers": "content-type,authorization",
      "cache-control": "no-store",
    });
    return res.end();
  }

  if (req.method === "GET" && (req.url === "/health" || req.url === "/")) {
    return sendJSON(res, 200, { status:"ok", service:"wolverine-solrpc-proxy", upstream: pickUpstream() });
  }

  if (req.method !== "POST") {
    return sendJSON(res, 405, { status:"error", error:"POST only", hint:"Use POST JSON-RPC to this endpoint." });
  }

  const chunks = [];
  req.on("data", (d) => chunks.push(d));
  req.on("end", () => {
    const rawBody = Buffer.concat(chunks);
    // If empty, fail fast (avoids nginx HTML -> JSON confusion)
    if (!rawBody.length) return sendJSON(res, 400, { status:"error", error:"empty body" });
    proxyJSON(req, res, rawBody);
  });
});

server.listen(LISTEN_PORT, LISTEN_HOST, () => {
  // eslint-disable-next-line no-console
  console.log(`wolverine-solrpc-proxy listening on http://${LISTEN_HOST}:${LISTEN_PORT} -> ${pickUpstream()}`);
});
JS

cat > "$SOLRPC_SERVICE" <<EOF
[Unit]
Description=Wolverine Solana RPC Proxy (DRPC passthrough)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=LISTEN_HOST=$SOLRPC_HOST
Environment=LISTEN_PORT=$SOLRPC_PORT
Environment=UPSTREAM_PRIMARY=$SOLANA_UPSTREAM_PRIMARY
Environment=UPSTREAM_FALLBACK=$SOLANA_UPSTREAM_FALLBACK
ExecStart=/usr/bin/node $SOLRPC_JS
Restart=always
RestartSec=1
WorkingDirectory=$SOLRPC_DIR

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now wolverine-solrpc-proxy.service


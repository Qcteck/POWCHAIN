cat >/tmp/wolfchain_rename.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
ROOT="/opt/fireinners/frontend-react/app/dist"
if test -f "$VHOST"; then
  R=$(awk 'BEGIN{r=""} /^[ \t]*root[ \t]+/{gsub(/;$/,"",$2); if(r==""){r=$2}} END{print r}' "$VHOST" 2>/dev/null || true)
  test -n "${R:-}" && ROOT="$R"
fi

echo "== RENAME: FireInners->WOLFCHAIN ; TraderOne->WOLVERIN =="
echo "VHOST: $VHOST"
echo "ROOT : $ROOT"
test -d "$ROOT" || { echo "ERR: root introuvable: $ROOT"; exit 1; }

# Optional askorupdate module (if present)
ASKMOD="/opt/fireinners/sentinel/lib/askorupdate.sh"
if test -f "$ASKMOD"; then
  # shellcheck disable=SC1090
  source "$ASKMOD" || true
fi

ts(){ date +"%Y%m%d-%H%M%S"; }
backup_file(){ test -f "$1" && cp -a "$1" "$1.bak.$(ts)" && echo "backup: $1.bak.$(ts)"; }
immut_off(){ local f="$1"; command -v lsattr >/dev/null||return 0; command -v chattr >/dev/null||return 0; test -f "$f" && lsattr "$f" 2>/dev/null | grep -q '\-i-' && chattr -i "$f" 2>/dev/null || true; }
fix_perms(){ find "$ROOT" -type d -exec chmod 755 {} \; 2>/dev/null || true; find "$ROOT" -type f -exec chmod 644 {} \; 2>/dev/null || true; }

echo
echo "[1] Create /wolverin/ folder"
mkdir -p "$ROOT/wolverin" || true

echo
echo "[2] Replace strings in all HTML under ROOT"
# backup + replace
mapfile -t HTMLS < <(find "$ROOT" -type f -name "*.html" 2>/dev/null || true)
for f in "${HTMLS[@]:-}"; do
  backup_file "$f"
  immut_off "$f" || true
  perl -0777 -pi -e '
    s/FireInners/WOLFCHAIN/g;
    s/TraderOne/WOLVERIN/g;
    s/\/traderone\//\/wolverin\//g;
  ' "$f"
done

echo
echo "[3] Write/force WOLVERIN landing at /wolverin/index.html"
# (If askorupdate_file exists, use it; else direct write)
TMP="$(mktemp)"
cat >"$TMP" <<'HTML'
<!doctype html><html lang="fr"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="color-scheme" content="dark"/><title>WOLVERIN • WOLFCHAIN</title><style>:root{--bg:#05060b;--b:#1b2a44;--t:#e7f0ff;--m:#9fb3d7;--a:#ff7a18;--a2:#ffb03a}*{box-sizing:border-box}html,body{height:100%;margin:0;background:radial-gradient(900px 520px at 20% 0%,#0a1328 0%,transparent 60%),radial-gradient(800px 520px at 85% 15%,#121b35 0%,transparent 55%),#05060b;color:var(--t);font:14px system-ui,-apple-system,Segoe UI,Roboto,Arial}a{color:inherit;text-decoration:none}#w{min-height:100%;display:flex;align-items:center;justify-content:center;padding:22px}#c{width:min(980px,100%);background:linear-gradient(180deg,rgba(10,15,30,.92),rgba(7,10,20,.92));border:1px solid rgba(27,42,68,.75);border-radius:18px;box-shadow:0 18px 60px rgba(0,0,0,.55);overflow:hidden}#t{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid rgba(27,42,68,.6)}#b{display:flex;gap:12px;align-items:center}#m{width:44px;height:44px;border-radius:12px;background:radial-gradient(circle at 30% 25%,rgba(255,176,58,.35),transparent 60%),linear-gradient(135deg,rgba(255,122,24,.65),rgba(255,176,58,.25));border:1px solid rgba(255,176,58,.25);display:grid;place-items:center;font-weight:900}#t b{font-size:16px}#t span{color:var(--m);font-size:12px}#mid{padding:16px 18px 18px;display:grid;gap:10px}h1{margin:0;font-size:22px}p{margin:0;color:var(--m)}.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 12px;border-radius:12px;background:rgba(7,10,20,.65);border:1px solid rgba(27,42,68,.65);width:fit-content}</style><body><div id="w"><div id="c"><div id="t"><div id="b"><div id="m">W</div><div><b>WOLVERIN</b><br><span>Hub trading (WOLFCHAIN)</span></div></div><a class="btn" href="/">Retour Core</a></div><div id="mid"><h1>WOLVERIN</h1><p>Landing statique. Remplace ce fichier par l’index officiel WOLVERIN quand prêt.</p></div></div></div></body></html>
HTML
DEST="$ROOT/wolverin/index.html"
mkdir -p "$(dirname "$DEST")"
backup_file "$DEST"
immut_off "$DEST" || true
cp -a "$TMP" "$DEST"
chmod 644 "$DEST" || true
rm -f "$TMP"
echo "wrote: $DEST"

echo
echo "[4] Make /traderone/ legacy redirect -> /wolverin/"
mkdir -p "$ROOT/traderone" || true
LEG="$ROOT/traderone/index.html"
backup_file "$LEG"
immut_off "$LEG" || true
cat >"$LEG" <<'HTML'
<!doctype html><html lang="fr"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta http-equiv="refresh" content="0;url=/wolverin/"/><title>Redirect</title><style>html,body{height:100%;margin:0;font:14px system-ui;background:#05060b;color:#e7f0ff;display:grid;place-items:center}a{color:#e7f0ff}</style><body><div>Redirecting to <a href="/wolverin/">/wolverin/</a></div></body></html>
HTML
chmod 644 "$LEG" || true
echo "wrote: $LEG"

echo
echo "[5] Update static /stats file if present"
if test -f "$ROOT/stats"; then
  backup_file "$ROOT/stats"
  immut_off "$ROOT/stats" || true
  cat >"$ROOT/stats" <<'JSON'
{"ok":true,"mode":"static","service":"wolfchain","module":"wolverin","hint":"proxy /stats to backend later if needed"}
JSON
  chmod 644 "$ROOT/stats" || true
  echo "updated: $ROOT/stats"
else
  echo "skip: no static $ROOT/stats"
fi

echo
echo "[6] Fix perms (anti-403)"
fix_perms

echo
echo "[7] Local checks (Host header)"
H="fireinners.online"
for u in / /wallet/ /dex/ /bridge/ /explorer/ /mining/ /options/ /wolverin/ /traderone/ /stats; do
  echo "--- $u ---"
  curl -kIs "https://127.0.0.1$u" -H "Host: $H" | sed -n '1,6p' || true
done

echo "== DONE =="
BASH
bash /tmp/wolfchain_rename.sh
set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
[ -f "$NG" ] || { echo "KO: $NG introuvable"; exit 1; }

echo "=== 0) Backup ==="
cp -a "$NG" "$NG.bak.dupe_wolv.$(date +%s)"

echo "=== 1) Trouver tous les blocs /wolverine ==="
grep -nE 'WOLVERINE_BLOCK_V1|location\s+=\s*/wolverine\b|location\s+\^~\s+/wolverine/|/wolverine/traderone/api/' "$NG" | sed -n '1,220p'
echo

echo "=== 2) Fix: supprimer les locations /wolverine hors du bloc WOLVERINE_BLOCK_V1 ==="
python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

marker = "# --- WOLVERINE_BLOCK_V1 ---"
if marker not in s:
    raise SystemExit("KO: bloc WOLVERINE_BLOCK_V1 introuvable (ne pas auto-fix).")

# Split around marker block so we can only clean outside it
pre, rest = s.split(marker, 1)
# rest contains marker removed; rebuild marker+rest for simplicity
rest = marker + rest

def drop_locations(txt: str) -> str:
    # remove exact blocks for:
    # location = /wolverine { ... }
    txt = re.sub(r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*\n', '\n', txt, flags=re.M)
    # location ^~ /wolverine/ { ... }
    txt = re.sub(r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*\n', '\n', txt, flags=re.M)
    # location ^~ /wolverine/traderone/api/ { ... }
    txt = re.sub(r'\n\s*location\s+\^~\s+/wolverine/traderone/api/\s*\{[\s\S]*?\n\s*\}\s*\n', '\n', txt, flags=re.M)
    return txt

pre2 = drop_locations(pre)
# IMPORTANT: keep the injected block untouched
s2 = pre2 + "\n" + rest

ng.write_text(s2)
print("OK: removed duplicate /wolverine locations outside WOLVERINE_BLOCK_V1")
PY

echo "=== 3) Test + reload ==="
nginx -t
systemctl reload nginx
echo "OK: nginx reloaded"

echo "=== 4) Quick tests ==="
curl -sS -i https://fireinners.online/wolverine/ | head -n 15 || true
echo
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 15 || true
set -e
cd /opt/traderone-opt

echo "=== 0) Backup ==="
cp -a server.js "server.js.bak.force_dexes2.$(date +%s)"

echo "=== 1) Ensure allowlist file ==="
mkdir -p config
test -f config/dex_allowlist.json || cat > config/dex_allowlist.json <<'JSON'
[
  "sushiswap","jupiter","dflow","okx","mayan","chainflip",
  "gasZipBridge","relaydepository","odos","fly","relay"
]
JSON

echo "=== 2) Patch server.js: insert /api/dexes before FIRST .listen( ==="
node <<'NODE'
const fs = require("fs");
const p = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(p,"utf8");

if (s.includes("FORCED_DEXES_ROUTE_V2")) {
  console.log("OK: already patched V2");
  process.exit(0);
}

// ensure requires exist (no duplicates)
function ensureRequire(varName, modName){
  const re = new RegExp(`^const\\s+${varName}\\s*=\\s*require\$begin:math:text$\[\'\"\]\$\{modName\}\[\'\"\]\\$end:math:text$;\\s*$`, "m");
  if (re.test(s)) return;

  // insert after the last top-level require line, else at file start
  const reqLines = [...s.matchAll(/^const\s+\w+\s*=\s*require\(['"][^'"]+['"]\);\s*$/mg)];
  const insertAt = reqLines.length ? (reqLines[reqLines.length-1].index + reqLines[reqLines.length-1][0].length) : 0;
  const ins = (insertAt===0 ? "" : "\n") + `const ${varName} = require("${modName}");`;
  s = s.slice(0, insertAt) + ins + s.slice(insertAt);
}
ensureRequire("fs","fs");
ensureRequire("path","path");

// find first ".listen("
const m = s.match(/\.\s*listen\s*\(/);
if(!m) throw new Error("No .listen( found anywhere in server.js");
const idx = s.indexOf(m[0]);

const snippet = `
// === FORCED_DEXES_ROUTE_V2 ===
app.get("/api/dexes", (req,res)=>{
  try{
    const raw = fs.readFileSync(path.join(__dirname,"config","dex_allowlist.json"),"utf8");
    const a = JSON.parse(raw);
    const dexes = Array.isArray(a) ? a.map(x=>String(x).trim()).filter(Boolean) : [];
    return res.json({ ok:true, dexes });
  }catch(e){
    return res.status(200).json({ ok:true, dexes: [], warn: String(e && e.message || e) });
  }
});

`;

s = s.slice(0, idx) + snippet + s.slice(idx);
fs.writeFileSync(p, s);
console.log("OK: inserted forced /api/dexes before first .listen(");
NODE

echo "=== 3) Restart PM2 + test ==="
node --check server.js
pm2 restart traderone --update-env || pm2 restart 0 --update-env
sleep 1
curl -sS -i http://127.0.0.1:3000/health | head -n 12 || true
echo
curl -sS http://127.0.0.1:3000/api/dexes | head -c 400; echo
echo "=== DONE ==="
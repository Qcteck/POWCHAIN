cat >/root/WOLVERINE_FIX_TRADERONE_API.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE / TRADERONE API — SAFE AUTO FIX ==="

### VARS
API_HOST="127.0.0.1"
API_PORT="3000"
API_TEST_PATH="/wolverine/traderone/api/status"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"
NGINX_INC="/etc/nginx/includes/wolverine_traderone_api.inc"
TS="$(date +%Y%m%d_%H%M%S)"

### 1) CHECK NODE
echo "== Node check =="
command -v node >/dev/null || { echo "❌ Node absent"; exit 1; }
node -v

### 2) CHECK PORT
echo "== Port ${API_PORT} check =="
if ! ss -lnt | grep -q ":${API_PORT}"; then
  echo "⚠️  Node non actif sur ${API_PORT}, tentative pm2"
  if command -v pm2 >/dev/null; then
    pm2 resurrect || true
  fi
  sleep 2
fi

ss -lnt | grep -q ":${API_PORT}" || {
  echo "❌ TraderOne n'écoute toujours pas sur ${API_PORT}"
  exit 1
}
echo "✅ Node écoute sur ${API_PORT}"

### 3) BACKUP NGINX
echo "== Backup nginx config =="
cp -a "$NGINX_SITE" "${NGINX_SITE}.bak_${TS}"

### 4) WRITE INCLUDE (SAFE)
echo "== Write include =="
cat > "$NGINX_INC" <<EOF
location ^~ /wolverine/traderone/api/ {
  proxy_pass http://${API_HOST}:${API_PORT}/;
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_read_timeout 300;
}
EOF

### 5) ENSURE INCLUDE IS LOADED
echo "== Inject include if missing =="
grep -q "wolverine_traderone_api.inc" "$NGINX_SITE" || \
sed -i "/server_name/a\\    include ${NGINX_INC};" "$NGINX_SITE"

### 6) TEST + RELOAD
echo "== Nginx test =="
nginx -t

echo "== Reload nginx =="
systemctl reload nginx

### 7) TESTS
echo "== Backend local =="
curl -s -o /dev/null -w "LOCAL %{http_code}\n" http://${API_HOST}:${API_PORT}/ || true

echo "== Proxy local =="
curl -s -o /dev/null -w "PROXY %{http_code}\n" http://localhost${API_TEST_PATH} || true

echo "== HTTPS public =="
curl -s -o /dev/null -w "HTTPS %{http_code}\n" https://fireinners.online${API_TEST_PATH} || true

echo "=== DONE — HTTPS=200 => API OK ==="
BASH

chmod +x /root/WOLVERINE_FIX_TRADERONE_API.sh
/root/WOLVERINE_FIX_TRADERONE_API.sh
cat > /root/verify_aiaquila_proxy.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

echo "==============================================="
echo " AIAQUILA PROXY — ROOT VERIFICATION BATCH"
echo "==============================================="

PROXY_URL="https://aiaquila-proxy.paycashnostory.workers.dev"
LOG="/root/aiaquila_proxy_check_$(date +%Y%m%d_%H%M%S).log"

exec > >(tee -a "$LOG") 2>&1

echo "==[1] HEALTH =="
curl -s "$PROXY_URL/health" || true
echo ""

echo "==[2] RSS CRYPTO =="
curl -s "$PROXY_URL/rss?cat=crypto" | head -n 30
echo ""

echo "==[3] PRICES =="
curl -s "$PROXY_URL/price?ids=bitcoin,solana,ethereum" || true
echo ""

echo "==[4] ENTITY TEST =="
echo "Elon Musk and Michael Saylor talked about Bitcoin and Solana." | \
curl -s -X POST "$PROXY_URL/entities" --data-binary @-
echo ""

echo "==[5] LATENCY =="
for i in {1..5}; do
  curl -o /dev/null -s -w "Ping $i → %{time_total}s\n" "$PROXY_URL/health"
done

echo "==============================================="
echo " ✅ AIAQUILA PROXY CHECK COMPLETED"
echo " Log: $LOG"
echo "==============================================="
EOF

chmod +x /root/verify_aiaquila_proxy.sh
/root/verify_aiaquila_proxy.sh
chmod 644 "$WEBDIR/index.html" || true

# restart services
systemctl daemon-reload
systemctl enable --now "$SERVICE.service" >/dev/null 2>&1 || true
systemctl restart "$SERVICE.service"

nginx -t
systemctl reload nginx

# relock
chattr +i "$SNIP" 2>/dev/null || true
chattr +i "$NG_SITE" 2>/dev/null || true
chattr +i "$WEBDIR/index.html" 2>/dev/null || true

CUST="$(cat "$WALLET_PUB" 2>/dev/null || true)"
say "DONE"
say "Front : https://fireinners.online/wolverine/"
say "Health: https://fireinners.online/wolverine/api/health"
say "Ping  : https://fireinners.online/wolverine/api/ping"
say "Config: https://fireinners.online/wolverine/api/config"
say "Status: https://fireinners.online/wolverine/api/status"
say "Deposit (SOL/USDC): $CUST"
BASH
set -euo pipefail

DOMAIN="fireinners.online"
APPJS="/var/www/fireinners/wolverine/app.js"

echo "== 0) Find REAL nginx vhost for $DOMAIN =="
VHOST="$(grep -RIl --include='*.conf' "server_name.*$DOMAIN" /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | head -n 1 || true)"
echo "VHOST=$VHOST"
[ -n "${VHOST:-}" ] || { echo "ERR: vhost introuvable pour $DOMAIN"; exit 1; }

TS="$(date +%s)"
cp -a "$VHOST" "$VHOST.bak.$TS"
echo "Backup vhost: $VHOST.bak.$TS"

echo
echo "== 1) Remove ANY broken RPC location from snippets (it breaks nginx context) =="
for f in /etc/nginx/snippets/*.conf; do
  [ -f "$f" ] || continue
  cp -a "$f" "$f.bak.$TS" 2>/dev/null || true
  perl -0777 -i -pe 's/location\s*=\s*\/wolverine\/traderone\/api\/rpc\s*\{[\s\S]*?\}\s*//g' "$f" || true
done

echo
echo "== 2) Ensure RPC proxy LOCATION exists INSIDE the real server{} (not snippet) =="
# If already present, do nothing. Else inject before the closing "}" of the server block.
if ! grep -qE 'location\s*=\s*/wolverine/traderone/api/rpc' "$VHOST"; then
  perl -0777 -i -pe '
    my $loc = qq|

  # Wolverine: Solana RPC proxy (same-origin)
  resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
  location = /wolverine/traderone/api/rpc {
    proxy_pass https://api.mainnet-beta.solana.com;
    proxy_http_version 1.1;

    proxy_ssl_server_name on;
    proxy_set_header Host api.mainnet-beta.solana.com;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
|;

    # inject into first server{} found in that vhost
    s/(server\s*\{[\s\S]*?)\n\}/$1$loc\n}\n/s;
  ' "$VHOST"
else
  echo "OK: RPC location already in vhost"
fi

echo
echo "== 3) Reload nginx =="
nginx -t && systemctl reload nginx

echo
echo "== 4) TEST HTTPS RPC (must NOT be 404) =="
curl -ksS -i "https://$DOMAIN/wolverine/traderone/api/rpc" \
  -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' | head -n 25

echo
echo "== 5) Frontend: make web3 Connection use ABSOLUTE URL (window.location.origin) =="
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup app.js: $APPJS.bak.$TS"

node - <<'JS'
const fs=require("fs");
const f=process.env.APPJS || "/var/www/fireinners/wolverine/app.js";
let s=fs.readFileSync(f,"utf8");

// Remplace toute URL RPC hardcodée par une URL absolue basée sur origin
const abs = 'new URL("/wolverine/traderone/api/rpc", window.location.origin).toString()';

// patterns common
s = s.replace(/["']https:\/\/[^"']+\/wolverine\/traderone\/api\/rpc["']/g, abs);
s = s.replace(/["']\/wolverine\/traderone\/api\/rpc["']/g, abs);
s = s.replace(/["']https:\/\/api\.mainnet-beta\.solana\.com["']/g, abs);
s = s.replace(/["']https:\/\/rpc\.ankr\.com\/solana["']/g, abs);

fs.writeFileSync(f,s,"utf8");
console.log("OK: app.js RPC URL => absolute origin proxy");
JS

echo
echo "DONE ✅  -> Ctrl+F5 sur https://$DOMAIN/wolverine puis clique START"
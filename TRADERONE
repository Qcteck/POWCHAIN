#!/usr/bin/env bash
set -euo pipefail

### CONFIG
APP_DIR="/var/www/aiaquila"
HTML="$APP_DIR/index.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP="$APP_DIR/index.backup_$TS.html"

echo "=== AIAQUILA – FIX RSS JS FINAL ==="

### 1) CHECK
if [ ! -f "$HTML" ]; then
  echo "ERREUR: $HTML introuvable"
  exit 1
fi

### 2) BACKUP
cp "$HTML" "$BACKUP"
echo "Backup créé: $BACKUP"

### 3) SUPPRESSION ANCIEN JS RSS (sécure)
perl -0777 -i -pe '
s/<script[^>]*>[\s\S]*?AIAQUILA[\s\S]*?<\/script>//gi
' "$HTML"
echo "Ancien JS RSS supprimé"

### 4) INJECTION JS CORRIGÉ (DOMParser + scope FIX)
perl -0777 -i -pe '
s|</body>|<script>
/* ===== AIAQUILA RSS JS – FIX STABLE ===== */

const FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://www.coingecko.com/rss/news"
];

const PROXY = "/aiaquila/rss-proxy.php?url=";
let ARTICLES = [];

function log(msg){
  const l = document.getElementById("logs");
  if(l){ l.textContent += msg + "\\n"; l.scrollTop = l.scrollHeight; }
}

async function loadRSS(){
  ARTICLES = [];
  log("Chargement RSS...");
  for(const feed of FEEDS){
    try{
      const res = await fetch(PROXY + encodeURIComponent(feed));
      const xml = await res.text();

      const parser = new DOMParser();
      const doc = parser.parseFromString(xml, "text/xml");

      const items = [...doc.querySelectorAll("item")];
      items.forEach(it=>{
        ARTICLES.push({
          title: it.querySelector("title")?.textContent || "",
          link: it.querySelector("link")?.textContent || "",
          desc: it.querySelector("description")?.textContent || ""
        });
      });
    }catch(e){
      log("RSS erreur: " + feed);
    }
  }
  log("Articles chargés: " + ARTICLES.length);
  renderAdvice();
}

function renderAdvice(){
  const box = document.getElementById("advice");
  if(!box) return;

  if(ARTICLES.length === 0){
    box.textContent = "Aucun signal spécifique. Rester en observation.";
    return;
  }

  const txt = ARTICLES.slice(0,3).map(a=>a.title).join(". ");
  box.textContent = "Analyse: " + txt;
}

window.addEventListener("DOMContentLoaded", ()=>{
  const btn = document.getElementById("loadRSS");
  if(btn) btn.onclick = loadRSS;
  log("AIAQUILA RSS prêt");
});

/* ===== FIN FIX ===== */
</script></body>|si
' "$HTML"

echo "JS RSS corrigé et injecté"

### 5) RELOAD NGINX (SAFE)
nginx -t
systemctl reload nginx

echo "=== FIX TERMINÉ ==="
echo "URL: https://fireinners.online/aiaquila/"
echo "ACTION: Ctrl+F5 puis clique « Charger les articles »"
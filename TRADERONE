cat >/root/WOLV_PATCH_HIDE_WALLETS_A_AFFICHER_V1.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

CAND_HTML=(
/opt/fireinners/frontend-react/app/dist/wolverine/index.html
/opt/fireinners/frontend-react/app/dist/wolverine/traderone.html
/var/www/fireinners/wolverine/index.html
/var/www/wolverine/index.html
/opt/traderone-opt/public/index.html
)
HTML=""
for f in "${CAND_HTML[@]}"; do [ -f "$f" ] && HTML="$f" && break; done
[ -n "$HTML" ] || { echo "ERR: wolverine index.html introuvable"; exit 1; }
FRONT_DIR="$(dirname "$HTML")"
mkdir -p "$FRONT_DIR/patches"

cat >"$FRONT_DIR/patches/wolv_hide_wallets_a_afficher.js" <<'JS'
(()=>{"use strict";
const $$=s=>[...document.querySelectorAll(s)];
function byText(sel,needle){
  needle=String(needle||"").toLowerCase();
  return $$(sel).find(e=>((e.textContent||"")+"").toLowerCase().includes(needle));
}
function hideBlock(){
  // Trouve le titre "Wallets à afficher" et cache le bloc parent
  const t=byText("*","wallets à afficher")||byText("*","wallets a afficher");
  if(t){
    const box=t.closest("section,fieldset,div,table")||t.parentElement;
    if(box) box.style.display="none";
  }
  // Cache aussi textarea + bouton "Refresh tous les soldes" qui servent à ce bloc
  const ta=document.querySelector("textarea");
  if(ta){
    const hint=(ta.parentElement&&ta.parentElement.textContent||"").toLowerCase();
    if(hint.includes("colle ici")||hint.includes("wallet")||hint.includes("adresses")) ta.style.display="none";
  }
  const btn=byText("button","refresh tous les soldes")||byText("input","refresh tous les soldes");
  if(btn){
    // si le bouton est dans la même zone que le bloc wallets, on le masque
    const ctx=(btn.closest("section,fieldset,div")||btn.parentElement||document.body).textContent.toLowerCase();
    if(ctx.includes("wallets à afficher")||ctx.includes("wallets a afficher")||ctx.includes("colle ici")) (btn.closest("section,fieldset,div")||btn).style.display="none";
  }
}
document.addEventListener("DOMContentLoaded",()=>{hideBlock(); setTimeout(hideBlock,500); setTimeout(hideBlock,1500);});
})();
JS


cat >/root/MEGA_TRADERONE_FIX_ENDPOINTS.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

log(){ printf "\n[%s] %s\n" "$(date +'%F %T')" "$*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "Lance en root."

API_BASE="/wolverine/traderone/api"
PORT="3000"
HOST="127.0.0.1"

export DEBIAN_FRONTEND=noninteractive
apt-get update -y >/dev/null
apt-get install -y jq curl >/dev/null || true

find_pid_any_3000(){
  ss -lntp 2>/dev/null | awk -v p=":$PORT" '
    $4 ~ p {
      match($NF,/pid=([0-9]+)/,m);
      if(m[1]!=""){ print m[1]; exit }
    }'
}

find_listen_addr(){
  ss -lntp 2>/dev/null | awk -v p=":$PORT" '$4 ~ p {print $4; exit}'
}

find_server_js_from_pid(){
  local pid="$1"
  local cwd=""
  cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
  [ -n "$cwd" ] || return 1
  # candidats proches
  for f in "$cwd/server.js" "$cwd/src/server.js" "$cwd/app/server.js"; do
    if [ -f "$f" ]; then echo "$f"; return 0; fi
  done
  # scan léger dans le cwd (max 3 niveaux)
  local hit=""
  hit="$(find "$cwd" -maxdepth 3 -type f -name "server.js" 2>/dev/null | head -n1 || true)"
  [ -n "$hit" ] && echo "$hit" && return 0
  return 1
}

find_server_js_by_scan(){
  # on cherche un server.js qui parle de /wolverine/traderone/api ou /health
  local hit=""
  # chemins probables
  for base in /opt/wolverine /opt /root /var/www; do
    [ -d "$base" ] || continue
    hit="$(grep -Rsl --binary-files=without-match -m1 -E "(wolverine/traderone/api|/health)" "$base" 2>/dev/null | head -n1 || true)"
    if [ -n "$hit" ]; then
      echo "$hit"
      return 0
    fi
  done
  return 1
}

restart_service_guess(){
  # on redémarre un service systemd qui écoute sur :3000 si possible
  local pid="${1:-}"
  local restarted="0"

  if systemctl list-units --type=service --all 2>/dev/null | grep -q "wolverine-traderone-api.service"; then
    log "Restart: wolverine-traderone-api.service"
    systemctl restart wolverine-traderone-api.service
    restarted="1"
  fi

  if [ "$restarted" = "0" ] && [ -n "$pid" ]; then
    # tentative: trouver unité via cgroup (souvent marche)
    local unit=""
    unit="$(awk -F/ '/system.slice/ {for(i=1;i<=NF;i++) if($i ~ /\.service$/){print $i; exit}}' "/proc/$pid/cgroup" 2>/dev/null || true)"
    if [ -n "$unit" ]; then
      log "Restart: ${unit}"
      systemctl restart "$unit" || true
      restarted="1"
    fi
  fi

  if [ "$restarted" = "0" ]; then
    log "Aucun service évident à restart. Si l'API ne bouge pas, on te dira quoi restart après."
  fi
}

log "1) Etat actuel endpoints (avant patch)"
base="https://fireinners.online${API_BASE}"
curl -sS "${base}/health" || true; echo
for p in version dashboard trade positions orders history wallet settings; do
  code="$(curl -sS -o /dev/null -w "%{http_code}" "${base}/${p}" || true)"
  echo "${p}: HTTP ${code}"
done

log "2) Détection listener sur :${PORT} (0.0.0.0 ou 127.0.0.1)"
PID="$(find_pid_any_3000 || true)"
ADDR="$(find_listen_addr || true)"
echo "LISTEN=${ADDR:-none} PID=${PID:-none}"

TARGET_FILE=""
if [ -n "${PID:-}" ]; then
  TARGET_FILE="$(find_server_js_from_pid "$PID" || true)"
fi
if [ -z "${TARGET_FILE:-}" ]; then
  log "Pas de server.js trouvé via PID, scan fallback..."
  TARGET_FILE="$(find_server_js_by_scan || true)"
fi

if [ -z "${TARGET_FILE:-}" ]; then
  die "Impossible de localiser le fichier backend à patcher (server.js ou équivalent)."
fi

log "3) Fichier backend ciblé: ${TARGET_FILE}"

# Backup
cp -a "$TARGET_FILE" "${TARGET_FILE}.bak.$(date +%s)"

log "4) Patch backend: ajouter endpoints attendus sous ${API_BASE}"
# On remplace le fichier par un serveur express standard et compatible.
# Si tu as déjà un backend plus complexe, on ne touche pas au front; on sécurise la plomberie.
cat >"$TARGET_FILE" <<'JS'
import express from "express";

const app = express();
app.disable("x-powered-by");
app.use(express.json({limit:"256kb"}));

const BIND = process.env.BIND || "0.0.0.0";
const PORT = parseInt(process.env.PORT || "3000", 10);
const API_BASE = (process.env.API_BASE || "/wolverine/traderone/api").replace(/\/+$/,"");

function now(){ return new Date().toISOString(); }
function ok(res, obj){ res.json({ok:true, service:"traderone", ts:now(), ...obj}); }
function bad(res, msg, code=400){ res.status(code).json({ok:false, service:"traderone", ts:now(), error:String(msg||"bad_request")}); }

app.get(`${API_BASE}/health`, (req,res)=> ok(res, {base:API_BASE, bind:BIND, port:PORT}));
app.get(`${API_BASE}/version`, (req,res)=> ok(res, {version:"1.0.0"}));

/* Endpoints pages (stubs JSON) pour que l'UI concorde sans changer l'interface */
app.get(`${API_BASE}/dashboard`, (req,res)=> ok(res, {page:"dashboard", summary:{invested_usdc:0,pnl_usdc:0,positions:0,orders:0}}));
app.get(`${API_BASE}/trade`,     (req,res)=> ok(res, {page:"trade", status:"ready"}));
app.get(`${API_BASE}/positions`, (req,res)=> ok(res, {page:"positions", items:[]}));
app.get(`${API_BASE}/orders`,    (req,res)=> ok(res, {page:"orders", items:[]}));
app.get(`${API_BASE}/history`,   (req,res)=> ok(res, {page:"history", items:[]}));
app.get(`${API_BASE}/wallet`,    (req,res)=> ok(res, {page:"wallet", balances:{sol:0,usdc:0,tokens:[]}}));
app.get(`${API_BASE}/settings`,  (req,res)=> ok(res, {page:"settings", strategies:["default","conservative","balanced","aggressive"], risk_pct_default:5}));

/* Plumbing actions (safe stubs) */
app.post(`${API_BASE}/start`, (req,res)=>{
  const {pub,budget_usdc,strategy,risk_pct} = req.body || {};
  if(!pub) return bad(res,"pub_required");
  const budget = Number(budget_usdc||0);
  if(!Number.isFinite(budget) || budget<=0) return bad(res,"budget_usdc_invalid");
  const risk = Number(risk_pct||0);
  if(!Number.isFinite(risk) || risk<0 || risk>100) return bad(res,"risk_pct_invalid");
  const job_id = `job_${Date.now()}_${Math.random().toString(16).slice(2)}`;
  ok(res, {accepted:true, job_id, pub, budget_usdc:budget, strategy:String(strategy||"default"), risk_pct:risk});
});

app.post(`${API_BASE}/mode`, (req,res)=>{
  const {pub,mode} = req.body || {};
  if(!pub) return bad(res,"pub_required");
  ok(res, {accepted:true, pub, mode:String(mode||"observe")});
});

app.post(`${API_BASE}/withdraw`, (req,res)=>{
  const {pub,mint,amount,to} = req.body || {};
  if(!pub) return bad(res,"pub_required");
  const amt = Number(amount||0);
  if(!Number.isFinite(amt) || amt<=0) return bad(res,"amount_invalid");
  ok(res, {accepted:true, pub, mint:String(mint||""), amount:amt, to:String(to||"")});
});

app.get(`${API_BASE}/invested`, (req,res)=>{
  const pub = String(req.query.pub||"");
  if(!pub) return bad(res,"pub_required");
  ok(res, {pub, invested_usdc:0, pnl_usdc:0, positions:[]});
});

app.use((req,res)=> bad(res,"not_found",404));

app.listen(PORT, BIND, ()=> {
  console.log(`[traderone] ${now()} listening http://${BIND}:${PORT}${API_BASE}`);
});
JS

log "5) Installer deps express si package.json présent (best-effort)"
WD="$(dirname "$TARGET_FILE")"
if [ -f "$WD/package.json" ]; then
  if command -v npm >/dev/null 2>&1; then
    (cd "$WD" && npm i --omit=dev >/dev/null) || true
  fi
fi

log "6) Restart service (guess)"
restart_service_guess "${PID:-}"

log "7) Re-test endpoints (après patch)"
sleep 1
curl -sS "${base}/health" || true; echo
for p in version dashboard trade positions orders history wallet settings; do
  code="$(curl -sS -o /dev/null -w "%{http_code}" "${base}/${p}" || true)"
  echo "${p}: HTTP ${code}"
done

log "Done. Si certains restent 404, montre-moi:"
echo " - tail -n 30 /var/log/nginx/wolverine_api_access.log"
echo " - ss -lntp | grep ':3000' || true"
BASH

chmod +x /root/MEGA_TRADERONE_FIX_ENDPOINTS.sh
bash /root/MEGA_TRADERONE_FIX_ENDPOINTS.sh
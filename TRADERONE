bash -lc 'set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"; BK="/root/AIAQUILA_BK_$TS"; mkdir -p "$BK"
say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run as root"

WEB="/var/www/aiaquila"
VENDOR="$WEB/vendor"
IDX="$WEB/index.html"

say "1) checks"
[ -d "$WEB" ] || die "missing $WEB"
[ -f "$IDX" ] || die "missing $IDX"
mkdir -p "$VENDOR"

say "2) backup"
cp -a "$IDX" "$BK/index.html.bak"

say "3) ensure vendor (pinned files, no CDN at runtime)"
# If you already have these files, we keep them. If missing, download.
need_dl=0
[ -f "$VENDOR/solana-web3.iife.min.js" ] || need_dl=1
[ -f "$VENDOR/buffer.min.js" ] || need_dl=1
[ -f "$VENDOR/process.min.js" ] || need_dl=1

if [ "$need_dl" -eq 1 ]; then
  say "   downloading vendor files..."
  # Pinned versions (stable) — adjust only if you want.
  curl -fsSL "https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js" -o "$VENDOR/solana-web3.iife.min.js"
  curl -fsSL "https://unpkg.com/buffer@6.0.3/index.min.js" -o "$VENDOR/buffer.min.js"
  curl -fsSL "https://unpkg.com/process@0.11.10/browser.js" -o "$VENDOR/process.min.js"
  (cd "$VENDOR" && sha256sum solana-web3.iife.min.js buffer.min.js process.min.js > SHA256SUMS.txt)
else
  say "   vendor already present (skip download)"
fi

say "4) patch index.html (inject global Buffer polyfill BEFORE any JS)"
python3 - "$IDX" <<'"'"'PY'"'"'
import re,sys
p=sys.argv[1]
s=open(p,"r",encoding="utf-8",errors="ignore").read()

MARK="AIAQUILA_BUFFER_POLYFILL_V1"
if MARK in s:
    print("already patched")
    sys.exit(0)

poly = r'''
<!-- AIAQUILA_BUFFER_POLYFILL_V1 -->
<script src="/aiaquila/vendor/process.min.js"></script>
<script src="/aiaquila/vendor/buffer.min.js"></script>
<script>
/* Buffer/process globals required by solana-web3 + hashing */
(function(){
  try{
    if(!window.globalThis) window.globalThis=window;
    window.global = window;
    window.process = window.process || (window.process && window.process.browser ? window.process : {env:{},browser:true});
    var B = (window.buffer && window.buffer.Buffer) ? window.buffer.Buffer : (window.Buffer||null);
    if(B){
      window.Buffer = B;
      window.globalThis.Buffer = B;
    }
  }catch(e){}
})();
</script>
<!-- /AIAQUILA_BUFFER_POLYFILL_V1 -->
'''.strip()+"\n"

# Inject right before first <script ...solana-web3...> if present, else before </head>
m=re.search(r'<script[^>]+src=[\"\']/aiaquila/vendor/solana-web3\.iife\.min\.js[\"\'][^>]*>\s*</script>', s, re.I)
if m:
    s = s[:m.start()] + poly + s[m.start():]
else:
    # try before </head>
    m2=re.search(r'</head\s*>', s, re.I)
    if m2:
        s = s[:m2.start()] + poly + s[m2.start():]
    else:
        # fallback: prepend
        s = poly + s

open(p,"w",encoding="utf-8").write(s)
print("patched")
PY

say "5) verify (marker + vendor paths)"
grep -q "AIAQUILA_BUFFER_POLYFILL_V1" "$IDX" || die "patch failed (marker missing)"
ls -la "$VENDOR/solana-web3.iife.min.js" "$VENDOR/buffer.min.js" "$VENDOR/process.min.js" >/dev/null 2>&1 || die "vendor missing"

say "6) quick local fetch tests"
curl -fsS "http://127.0.0.1/aiaquila/vendor/buffer.min.js" >/dev/null 2>&1 || true
curl -fsS "http://127.0.0.1/aiaquila/" | head -n 2 || true

say "DONE"
say "Backup: $BK"
say "Open: https://fireinners.online/aiaquila/"
'
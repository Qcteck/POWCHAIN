cat > pages/health.jsx <<'JSX'
import { useEffect, useState } from "react";

export default function Health() {
  const [data, setData] = useState(null);
  const [err, setErr] = useState("");

  useEffect(() => {
    fetch("/wolverine/traderone/api/health")
      .then(async r => {
        const t = await r.text();
        try { return JSON.parse(t); } catch { return { raw: t, status: r.status }; }
      })
      .then(setData)
      .catch(e => setErr(String(e)));
  }, []);

  return (
    <div className="card">
      <h2 style={{marginTop:0}}>Backend health</h2>
      {err ? <pre className="bad">{err}</pre> : <pre>{JSON.stringify(data, null, 2)}</pre>}
      <p className="muted small">GET <code>/wolverine/traderone/api/health</code></p>
    </div>
  );
}
JSX


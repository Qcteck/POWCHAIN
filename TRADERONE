cat >/tmp/DIAG_WOLVERINE_UNEXPECTED_LT.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

base="https://fireinners.online"
echo "=== CHECK FRONT HTML (first lines) ==="
curl -ksS --max-time 8 "$base/wolverine/" | head -n 8
echo

echo "=== CHECK OVERLAY JS (ctype + first bytes) ==="
curl -kIs --max-time 8 "$base/wolverine/traderone_overlay.js?v=2" | head -n 12
curl -ksS --max-time 8 "$base/wolverine/traderone_overlay.js?v=2" | head -c 80; echo
echo

echo "=== CHECK API endpoints used by overlay (ctype + body head) ==="
for p in \
  "/wolverine/traderone/api/health" \
  "/wolverine/traderone/api/status" \
  "/wolverine/traderone/api/ping" \
  "/wolverine/traderone/api/start" \
  "/wolverine/traderone/api/stop"
do
  echo
  echo "--- $p ---"
  curl -kIs --max-time 8 "$base$p" | head -n 12
  echo "--- body head ---"
  curl -ksS --max-time 8 "$base$p" | head -c 160; echo
done
SH

bash /tmp/DIAG_WOLVERINE_UNEXPECTED_LT.sh
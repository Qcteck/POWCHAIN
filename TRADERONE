cat >/root/WOLVERINE_NGINX_PROOF_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

URL="https://fireinners.online/wolverine/"
HTML_REAL="/var/www/wolverine/index.html"
TMP="/tmp/wolverine_test.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== 1) HASH DU FICHIER LOCAL =="
sha256sum "$HTML_REAL"

echo
echo "== 2) CONTENU SERVI PAR NGINX =="
curl -s "$URL" > "$TMP"
sha256sum "$TMP"

echo
if ! grep -q 'refreshUSDC(){' "$TMP"; then
  echo "❌ LE FICHIER SERVI N'EST PAS CELUI MODIFIÉ"
else
  echo "✅ LE FICHIER SERVI CONTIENT LE CODE USDC"
fi

echo
echo "== 3) AFFICHAGE ROOT NGINX ACTIF =="
nginx -T | sed -n '/server_name fireinners.online/,/}/p' | sed -n '1,120p'

echo
echo "== 4) FORÇAGE ROOT /var/www/wolverine =="
cat >/etc/nginx/includes/wolverine_force_root.inc <<EOF
location /wolverine/ {
  root /var/www;
  index index.html;
  try_files \$uri \$uri/ /wolverine/index.html;
}
EOF

grep -q wolverine_force_root /etc/nginx/nginx.conf || \
echo "include /etc/nginx/includes/wolverine_force_root.inc;" >> /etc/nginx/nginx.conf

nginx -t
systemctl reload nginx

echo
echo "=== DONE ==="
echo "➡ CTRL + SHIFT + R OBLIGATOIRE"
BASH

chmod +x /root/WOLVERINE_NGINX_PROOF_FIX.sh
/root/WOLVERINE_NGINX_PROOF_FIX.sh
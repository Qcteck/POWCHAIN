#!/usr/bin/env bash
set -euo pipefail

APP="/var/www/aiaquila"
JS="$APP/aiaquila-rss.js"
BACKUP="$JS.backup_$(date +%Y%m%d_%H%M%S)"

echo "=== AIAQUILA TTS FIX ==="

# 1) Backup
cp "$JS" "$BACKUP"
echo "Backup JS: $BACKUP"

# 2) Patch JS TTS SAFE
cat > "$JS" <<'JS'
/* ===== AIAQUILA RSS + TTS STABLE ===== */

const FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://www.coingecko.com/rss/news"
];

const PROXY = "/aiaquila/rss-proxy.php?url=";
let ARTICLES = [];

function log(msg){
  const l = document.getElementById("logs");
  if(l){
    l.textContent += msg + "\n";
    l.scrollTop = l.scrollHeight;
  }
}

/* === TTS NATIF === */
function speak(text){
  if(!window.speechSynthesis){
    log("TTS non supporté");
    return;
  }
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = "fr-FR";
  u.rate = 1;
  u.pitch = 1;
  window.speechSynthesis.speak(u);
}

async function loadRSS(){
  ARTICLES = [];
  log("Chargement RSS...");

  for(const feed of FEEDS){
    try{
      const res = await fetch(PROXY + encodeURIComponent(feed));
      const xml = await res.text();
      const doc = new DOMParser().parseFromString(xml, "text/xml");
      const items = [...doc.querySelectorAll("item")];

      items.forEach(it=>{
        ARTICLES.push({
          title: it.querySelector("title")?.textContent || "",
          link: it.querySelector("link")?.textContent || ""
        });
      });
    }catch(e){
      log("Erreur RSS: " + feed);
    }
  }

  log("Articles chargés: " + ARTICLES.length);

  if(ARTICLES.length > 0){
    const titles = ARTICLES.slice(0,5).map(a => a.title).join(". ");
    speak("Voici les nouvelles crypto. " + titles);
  }else{
    speak("Aucun article détecté.");
  }
}

document.addEventListener("DOMContentLoaded", ()=>{
  const btn = document.getElementById("loadRSS");
  if(btn){
    btn.onclick = loadRSS;
  }
  log("AIAQUILA prêt. Clique pour lancer la lecture vocale.");
});
JS

chmod 644 "$JS"

# 3) Reload nginx (safe)
nginx -t && systemctl reload nginx

echo "=== FIX TTS OK ==="
echo "Ctrl+F5 puis clique « Charger les articles »"
        startConversation(it);
        return;
      }

      let text="", signals={pN:0,len:0,ld:1,score:0}, paywallHint=false;

      if(isProbablyHTML(raw)){
        requireConsentOnce("ARTICLE_EXTRACT", "Autoriser extraction du texte principal (readability-like) ?", (okEx) => {
          if(okEx){
            const ex = extractMainText(raw);

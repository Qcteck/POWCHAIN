cat >/root/WOLVERINE_PROGRESSIVE_RESTORE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== WOLVERINE — PROGRESSIVE RESTORE (SOL → VAULT → TRADERONE) ==="

FRONT="/var/www/wolverine"
HTML="$FRONT/index.html"
VENDOR="$FRONT/vendor"
RPC="https://lb.drpc.live/solana/AsxThpeKkEjGtZhCNUEQYo1ZluSgmwsR76RdFhW5UfFk"
API_BASE="/wolverine/traderone/api"

mkdir -p "$VENDOR"
cp "$HTML" "$HTML.bak_$(date +%s)" || true

# --- Vendor solana-web3 ---
if [ ! -f "$VENDOR/solana-web3.min.js" ]; then
  curl -L https://unpkg.com/@solana/web3.js@1.95.4/lib/index.iife.min.js \
  -o "$VENDOR/solana-web3.min.js"
fi

# --- Écriture du frontend PROPRE ---
cat >"$HTML"<<EOF
<!DOCTYPE html><html lang="fr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WOLVERINE</title>
<script src="/wolverine/vendor/solana-web3.min.js"></script>
<style>
body{background:#0b0f14;color:#e5e7eb;font-family:Arial;margin:0;padding:24px}
.box{max-width:520px;margin:auto;border:1px solid #222;border-radius:8px;padding:16px}
h2{margin:0 0 10px 0}
button{padding:10px 14px;margin:6px 0;cursor:pointer}
.row{margin:8px 0}
.small{opacity:.8;font-size:13px}
hr{border:none;border-top:1px solid #222;margin:14px 0}
</style>
</head>
<body>
<div class="box">
  <h2>WOLVERINE</h2>

  <!-- SOL BASE (NE PAS TOUCHER) -->
  <button id="connect">Connect Phantom</button>
  <div class="row">Adresse: <span id="addr">—</span></div>
  <div class="row">SOL: <b><span id="sol">—</span></b></div>

  <hr>

  <!-- VAULT (LECTURE SEULE) -->
  <button id="createVault">Créer mon Vault (lecture)</button>
  <div class="row small">Vault: <span id="vaultAddr">—</span></div>
  <div class="row small">Vault SOL: <span id="vaultSol">—</span></div>

  <hr>

  <!-- TRADERONE (STATUS + BUDGET) -->
  <button id="checkApi">TraderOne status</button>
  <div class="row small">API: <span id="apiStatus">—</span></div>

  <input id="budget" placeholder="Budget SOL" style="width:100%;padding:8px;margin-top:6px">
  <button id="sendBudget">Envoyer budget au bot</button>
  <div class="row small" id="sendRes">—</div>
</div>

<script>
const RPC="${RPC}";
const API="${API_BASE}";
const {Connection,PublicKey,LAMPORTS_PER_SOL}=solanaWeb3;
let conn=new Connection(RPC,"confirmed");
let USER_PUB=null, VAULT=null;

// === BASE SOL (NE PAS MODIFIER) ===
document.getElementById("connect").onclick=async()=>{
  if(!window.solana||!window.solana.isPhantom){alert("Phantom absent");return;}
  const r=await window.solana.connect();
  USER_PUB=r.publicKey.toString();
  document.getElementById("addr").textContent=USER_PUB;
  const lam=await conn.getBalance(new PublicKey(USER_PUB));
  document.getElementById("sol").textContent=(lam/LAMPORTS_PER_SOL).toFixed(4);
};

// === VAULT (LECTURE) ===
document.getElementById("createVault").onclick=async()=>{
  if(!USER_PUB){alert("Connect wallet");return;}
  const r=await fetch(API+"/create-vault",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({pub:USER_PUB})});
  VAULT=await r.json();
  document.getElementById("vaultAddr").textContent=VAULT.address||"—";
  if(VAULT.address){
    const lam=await conn.getBalance(new PublicKey(VAULT.address));
    document.getElementById("vaultSol").textContent=(lam/LAMPORTS_PER_SOL).toFixed(4);
  }
};

// === TRADERONE STATUS ===
document.getElementById("checkApi").onclick=async()=>{
  try{
    const r=await fetch(API+"/status");
    document.getElementById("apiStatus").textContent=r.status;
  }catch(e){document.getElementById("apiStatus").textContent="ERR";}
};

// === ENVOI BUDGET (SOL) ===
document.getElementById("sendBudget").onclick=async()=>{
  if(!USER_PUB||!VAULT||!VAULT.address){alert("Vault requis");return;}
  const amt=parseFloat(document.getElementById("budget").value||"0");
  if(!(amt>0)){alert("Budget invalide");return;}
  const r=await fetch(API+"/fund",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({from:USER_PUB,to:VAULT.address,sol:amt})});
  document.getElementById("sendRes").textContent=await r.text();
};
</script>
</body></html>
EOF

chown -R www-data:www-data "$FRONT"
chmod -R 755 "$FRONT"
rm -rf /var/cache/nginx/* || true
nginx -t && systemctl reload nginx

echo "=== DONE — CTRL+SHIFT+R ==="
BASH

chmod +x /root/WOLVERINE_PROGRESSIVE_RESTORE.sh
/root/WOLVERINE_PROGRESSIVE_RESTORE.sh
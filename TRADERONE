bash --noprofile --norc -lc 'set -euo pipefail;TS="$(date -u +%Y%m%d-%H%M%S)";LOG="/root/POST_MENAGE_ROOT_${TS}.log";Q="/opt/_quarantine_vps_20260109-194655";PURGE="${PURGE:-0}";say(){ echo "[$(date -u +%F\ %T)] $*"|tee -a "$LOG"; };run(){ say "+ $*"; "$@" >>"$LOG" 2>&1 || { say "WARN failed: $*"; return 0; }; };say "POST MENAGE ROOT TS=$TS";say "Log: $LOG";say "Quarantine: $Q";say "1) Fix cargo spam (create /root/.cargo/env)";run mkdir -p /root/.cargo;cat >/root/.cargo/env <<EOF
# placeholder to avoid "No such file or directory" on login
EOF
run chmod 644 /root/.cargo/env;run chown root:root /root/.cargo/env;run ls -lah /root/.cargo/env;say "2) Quarantine summary";if [ -d "$Q" ];then run du -sh "$Q";say "Top 30 quarantined files (by size):";(find "$Q" -type f -printf "%s\t%p\n" 2>/dev/null | sort -nr | head -n 30 | awk "{printf \"%.1fKB\t%s\n\",\$1/1024,\$2}") | tee -a "$LOG" || true;else say "Quarantine folder not found: $Q";fi;say "3) Optional purge";if [ "$PURGE" = "1" ] && [ -d "$Q" ];then TAR="/opt/quarantine_backup_${TS}.tar.gz";say "PURGE=1 -> archive then delete";run tar -C /opt -czf "$TAR" "$(basename "$Q")";run ls -lah "$TAR";run rm -rf "$Q";say "Deleted quarantine: $Q";else say "PURGE=0 -> keep quarantine (set PURGE=1 to archive+delete)";fi;say "DONE";echo "$LOG"'
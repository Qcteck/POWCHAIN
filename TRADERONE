.btn:disabled{opacity:.5;cursor:not-allowed}
.card{background:linear-gradient(180deg,rgba(6,27,20,.75),rgba(6,27,20,.55));border:1px solid rgba(31,227,154,.22);border-radius:16px;padding:14px;box-shadow:0 14px 40px rgba(0,0,0,.35)}
.grid{display:grid;grid-template-columns:420px 1fr;gap:14px}
@media(max-width:980px){.grid{grid-template-columns:1fr}}
.h{font-weight:800;margin:0 0 10px 0}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(max-width:520px){.row{grid-template-columns:1fr}}
label{display:block;color:var(--m);font-size:12px;margin:10px 0 6px}
input,select{width:100%;padding:10px 10px;border-radius:12px;border:1px solid rgba(31,227,154,.25);background:rgba(0,0,0,.18);color:var(--t);outline:none}
input:focus,select:focus{border-color:rgba(31,227,154,.7);box-shadow:0 0 0 3px rgba(31,227,154,.12)}
.small{font-size:12px;color:var(--m);line-height:1.35}
.kv{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center}
.pill{padding:6px 10px;border-radius:999px;border:1px solid rgba(31,227,154,.25);background:rgba(0,0,0,.15);color:var(--m);font-size:12px}
.pill.ok{border-color:rgba(31,227,154,.6);color:var(--ok)}
.pill.bad{border-color:rgba(255,95,109,.6);color:var(--bad)}
#log{height:420px;overflow:auto;white-space:pre-wrap;background:rgba(0,0,0,.22);border:1px solid rgba(31,227,154,.18);border-radius:12px;padding:10px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}
.footer{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-top:10px}
a{color:var(--b)}
</style></head><body><div id="wrap">
  <div id="top">
    <div id="brand"><div id="dot"></div><div><div id="title">WOLVERINE</div><div id="sub">TraderOne • Custody wallet • Faster refresh • TG monitoring</div></div></div>
    <div id="bar">
      <button class="btn" id="btnLang">EN</button>
      <button class="btn" id="btnCfg">Config</button>
      <button class="btn" id="btnPing">Ping</button>
      <button class="btn" id="btnLoop">Loop: OFF</button>
    </div>
  </div>

  <div class="grid">
    <div class="card">
      <h3 class="h" id="hControl">Control</h3>

      <label id="lPh">Wallet (Phantom optional)</label>
      <div class="row">
        <button class="btn" id="btnConnect">Connect</button>
        <button class="btn" id="btnDisconnect" disabled>Disconnect</button>
      </div>

      <label id="lAddr">User address</label>
      <div class="kv"><div class="pill" id="userAddr">not connected</div><button class="btn" id="btnCopyUser" disabled>Copy</button></div>

      <label id="lCust">Custody (TraderOne deposit address)</label>
      <div class="kv"><div class="pill" id="custodyAddr">loading...</div><button class="btn" id="btnCopyCustody">Copy</button></div>
      <div class="small" id="sDeposit">Send SOL/USDC to this address using Phantom. The server trades from this wallet.</div>

      <div class="row">
        <div><label id="lSOL">Custody SOL</label><input id="sol" readonly value="-"/></div>
        <div><label id="lUSDC">Custody USDC</label><input id="usdc" readonly value="-"/></div>
      </div>

      <div class="row">
        <div><label id="lBudget">Total budget (USDC)</label><input id="budget" type="number" min="0" step="0.01" value="50"/></div>
        <div><label id="lPer">Per trade (USDC)</label><input id="perTrade" type="number" min="0.5" step="0.01" value="5"/></div>
      </div>

      <label id="lMode">Mode</label>
      <select id="mode">
        <option value="dca_sol">DCA buy SOL (safe)</option>
        <option value="dca_mint">DCA buy custom token (mint)</option>
      </select>

      <label id="lMint">Mint (only for custom token)</label>
      <input id="mint" placeholder="SPL mint (solana)"/>

      <label id="lWithdraw">Withdraw address (profit return)</label>
      <input id="withdrawTo" placeholder="your solana address (optional)"/>

      <label id="lArm">ARM code</label>
      <input id="arm" placeholder="required to start/stop/loop/withdraw"/>

      <div class="row" style="margin-top:10px">
        <button class="btn" id="btnStart">Start WOLVERINE</button>
        <button class="btn" id="btnStop" disabled>Stop</button>
      </div>
      <div class="row" style="margin-top:10px">
        <button class="btn" id="btnRefresh">Refresh</button>
        <button class="btn" id="btnWithdraw">Withdraw ALL</button>
      </div>

      <div class="small" id="sSafe" style="margin-top:10px">
        Safety: no private keys in browser. Custody key stays on VPS. Start/Stop require ARM. Cache disabled for fast updates.
      </div>
      <div class="footer">
        <div class="pill" id="pillApi">API: ...</div>
        <div class="pill" id="pillUp">Ping: ...</div>
      </div>
    </div>

    <div class="card">
      <h3 class="h" id="hConsole">Console</h3>
      <div id="log"></div>
      <div class="footer">
        <div class="small" id="foot">Auto-refresh: <span id="autoS">ON</span> • Latency: <span id="lat">-</span>ms • Errors: <span id="errs">0</span></div>
        <div class="small"><label style="display:inline;color:var(--m)"><input type="checkbox" id="auto" checked/> auto</label></div>
      </div>
    </div>
  </div>
</div>

<script>
(()=>{const BASE="/wolverine/api";const $=s=>document.querySelector(s);
const logEl=$("#log");let ERR=0, autoT=null, loopOn=false;
const dict={en:{Control:"Control",Console:"Console","Wallet (Phantom optional)":"Wallet (Phantom optional)","User address":"User address","Custody (TraderOne deposit address)":"Custody (TraderOne deposit address)","Send SOL/USDC to this address using Phantom. The server trades from this wallet.":"Send SOL/USDC to this address using Phantom. The server trades from this wallet.","Custody SOL":"Custody SOL","Custody USDC":"Custody USDC","Total budget (USDC)":"Total budget (USDC)","Per trade (USDC)":"Per trade (USDC)","Mode":"Mode","Mint (only for custom token)":"Mint (only for custom token)","Withdraw address (profit return)":"Withdraw address (profit return)","ARM code":"ARM code","Start WOLVERINE":"Start WOLVERINE","Stop":"Stop","Refresh":"Refresh","Withdraw ALL":"Withdraw ALL","Safety: no private keys in browser. Custody key stays on VPS. Start/Stop require ARM. Cache disabled for fast updates.":"Safety: no private keys in browser. Custody key stays on VPS. Start/Stop require ARM. Cache disabled for fast updates."},
fr:{Control:"Contrôle",Console:"Console","Wallet (Phantom optional)":"Wallet (Phantom optionnel)","User address":"Adresse utilisateur","Custody (TraderOne deposit address)":"Custody (adresse dépôt TraderOne)","Send SOL/USDC to this address using Phantom. The server trades from this wallet.":"Envoie SOL/USDC à cette adresse via Phantom. Le serveur trade depuis cette wallet.","Custody SOL":"SOL (Custody)","Custody USDC":"USDC (Custody)","Total budget (USDC)":"Budget total (USDC)","Per trade (USDC)":"Par trade (USDC)","Mode":"Mode","Mint (only for custom token)":"Mint (token custom)","Withdraw address (profit return)":"Adresse retour profit","ARM code":"Code ARM","Start WOLVERINE":"Démarrer WOLVERINE","Stop":"Stop","Refresh":"Rafraîchir","Withdraw ALL":"Retirer TOUT","Safety: no private keys in browser. Custody key stays on VPS. Start/Stop require ARM. Cache disabled for fast updates.":"Sécurité: aucune clé privée dans le navigateur. La clé custody reste sur le VPS. Start/Stop require ARM. Cache désactivé pour updates rapides."}};
let LANG=localStorage.getItem("wolv_lang")||"en";
function t(s){return (dict[LANG]&&dict[LANG][s])||s}
function applyLang(){
  $("#btnLang").textContent=LANG.toUpperCase();
  $("#hControl").textContent=t("Control");
  $("#hConsole").textContent=t("Console");
  $("#lPh").textContent=t("Wallet (Phantom optional)");
  $("#lAddr").textContent=t("User address");
  $("#lCust").textContent=t("Custody (TraderOne deposit address)");
  $("#sDeposit").textContent=t("Send SOL/USDC to this address using Phantom. The server trades from this wallet.");
  $("#lSOL").textContent=t("Custody SOL");
  $("#lUSDC").textContent=t("Custody USDC");
  $("#lBudget").textContent=t("Total budget (USDC)");
  $("#lPer").textContent=t("Per trade (USDC)");
  $("#lMode").textContent=t("Mode");
  $("#lMint").textContent=t("Mint (only for custom token)");
  $("#lWithdraw").textContent=t("Withdraw address (profit return)");
  $("#lArm").textContent=t("ARM code");
  $("#btnStart").textContent=t("Start WOLVERINE");
  $("#btnStop").textContent=t("Stop");
  $("#btnRefresh").textContent=t("Refresh");
  $("#btnWithdraw").textContent=t("Withdraw ALL");
  $("#sSafe").textContent=t("Safety: no private keys in browser. Custody key stays on VPS. Start/Stop require ARM. Cache disabled for fast updates.");
}
applyLang();

function p(s){logEl.textContent+=`[${new Date().toISOString()}] ${s}\n`;logEl.scrollTop=logEl.scrollHeight}
async function jget(url){const t0=performance.now();const ac=new AbortController();const to=setTimeout(()=>ac.abort(),8000);
  try{const r=await fetch(url,{cache:"no-store",signal:ac.signal});clearTimeout(to);const txt=await r.text();const ms=Math.round(performance.now()-t0);
    $("#lat").textContent=String(ms);return {ok:r.ok,txt,ms};}catch(e){clearTimeout(to);ERR++;$("#errs").textContent=String(ERR);throw e}}
async function jpost(url,body){const t0=performance.now();const ac=new AbortController();const to=setTimeout(()=>ac.abort(),12000);
  try{const r=await fetch(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body||{}),cache:"no-store",signal:ac.signal});clearTimeout(to);
    const txt=await r.text();const ms=Math.round(performance.now()-t0);$("#lat").textContent=String(ms);return {ok:r.ok,txt,ms};}catch(e){clearTimeout(to);ERR++;$("#errs").textContent=String(ERR);throw e}}

let provider=null, userPub="";
function setUser(pub){userPub=pub||"";$("#userAddr").textContent=userPub||"not connected";$("#btnCopyUser").disabled=!userPub}
function setCustody(pub){$("#custodyAddr").textContent=pub||"-"}

$("#btnLang").onclick=()=>{LANG=(LANG==="en"?"fr":"en");localStorage.setItem("wolv_lang",LANG);applyLang();p("LANG "+LANG)};
$("#btnCopyCustody").onclick=()=>{navigator.clipboard.writeText($("#custodyAddr").textContent||"");p("copied custody")};
$("#btnCopyUser").onclick=()=>{navigator.clipboard.writeText(userPub||"");p("copied user")};

$("#btnConnect").onclick=async()=>{
  try{
    provider=window.solana;
    if(!provider||!provider.isPhantom){p("Phantom not found");return}
    const r=await provider.connect({onlyIfTrusted:false});
    setUser(r.publicKey.toString());
    $("#btnDisconnect").disabled=false;
    p("Phantom connected");
  }catch(e){p("Connect ERR: "+e)}
};
$("#btnDisconnect").onclick=async()=>{try{if(provider) await provider.disconnect();}catch(_){} setUser("");$("#btnDisconnect").disabled=true;p("Phantom disconnected")};

async function refresh(){
  try{
    const r=await jget(BASE+"/status");
    if(!r.ok){p("status ERR "+r.txt);return}
    const j=JSON.parse(r.txt);
    $("#sol").value=(j.sol||0).toFixed(6);
    $("#usdc").value=(j.usdc||0).toFixed(6);
    $("#pillApi").textContent="API: OK";
    const eff=(j.ping&&j.ping.effective)||"UNKNOWN";
    $("#pillUp").textContent="Ping: "+eff;
    $("#pillUp").className="pill "+(eff==="UP"?"ok":(eff==="DOWN"?"bad":""));
    const running=j.bot&&j.bot.running;
    $("#btnStart").disabled=!!running;
    $("#btnStop").disabled=!running;
    if(j.bot&&j.bot.last) p(j.bot.last);
  }catch(e){p("refresh ERR")}
}

$("#btnRefresh").onclick=refresh;

$("#btnCfg").onclick=async()=>{
  const r=await jget(BASE+"/config");
  p("config: "+r.txt);
};

$("#btnPing").onclick=async()=>{
  const r=await jget(BASE+"/ping");
  p("ping: "+r.txt);
};

$("#btnLoop").onclick=async()=>{
  const arm=$("#arm").value||"";
  const url=BASE+(loopOn?"/loop/stop":"/loop/start");
  const r=await jpost(url,{arm});
  p("loop: "+r.txt);
  loopOn=!loopOn;
  $("#btnLoop").textContent="Loop: "+(loopOn?"ON":"OFF");
};

$("#btnStart").onclick=async()=>{
  const arm=$("#arm").value||"";
  const mode=$("#mode").value;
  const mint=$("#mint").value.trim();
  const budgetTotal=parseFloat($("#budget").value||"0");
  const perTrade=parseFloat($("#perTrade").value||"0");
  const withdrawTo=$("#withdrawTo").value.trim();
  const body={arm,userPub,withdrawTo,mode,budgetTotal,perTrade,mint:(mode==="dca_mint"?mint:"")};
  const r=await jpost(BASE+"/start",body);
  p("start: "+r.txt);
  refresh();
};

$("#btnStop").onclick=async()=>{
  const arm=$("#arm").value||"";
  const r=await jpost(BASE+"/stop",{arm});
  p("stop: "+r.txt);
  refresh();
};

$("#btnWithdraw").onclick=async()=>{
  const arm=$("#arm").value||"";
  const to=$("#withdrawTo").value.trim()||userPub;
  if(!to){p("withdraw: missing address");return}
  const r=await jpost(BASE+"/withdraw",{arm,to});
  p("withdraw: "+r.txt);
  refresh();
};

function auto(on){
  $("#autoS").textContent=on?"ON":"OFF";
  if(autoT){clearInterval(autoT);autoT=null}
  if(on) autoT=setInterval(refresh,3000);
}
$("#auto").onchange=()=>auto($("#auto").checked);

(async()=>{
  try{
    const w=await jget(BASE+"/wallet");
    if(w.ok){const j=JSON.parse(w.txt);setCustody(j.custody||"-");$("#pillApi").textContent="API: OK";} else {setCustody("-");}
  }catch(_){setCustody("-")}
  auto(true);
  refresh();
})();
})();
</script></body></html>
HTML
)"
askorupdate_file "$WEBDIR/index.html" "WOLVERINE index.html" "$INDEX_HTML"
chmod 644 "$WEBDIR/index.html" || true

# systemd reload + start
systemctl daemon-reload
systemctl enable --now "$SERVICE.service" >/dev/null 2>&1 || true
systemctl restart "$SERVICE.service" >/dev/null 2>&1 || true

# nginx include snippet if not already included (fallback safe)
if ! grep -q "snippets/fireinners-wolverine.conf" "$NG_SITE"; then
  # add include near top of server block (simple append just before last })
  cp -a "$NG_SITE" "$NG_SITE.bak.$(date -u +%Y%m%dT%H%M%SZ)" || true
  sed -i '0,/server\s*{/ s/server\s*{/server{\n  include \/etc\/nginx\/snippets\/fireinners-wolverine.conf;/' "$NG_SITE" || true
fi

nginx -t
systemctl reload nginx

# relock (optional)
chattr +i "$SNIP" 2>/dev/null || true
chattr +i "$NG_SITE" 2>/dev/null || true
chattr +i "$WEBDIR/index.html" 2>/dev/null || true

CUST="$(cat "$WALLET_PUB" 2>/dev/null || true)"
say "=== DONE ==="

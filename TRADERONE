msource /opt/fireinners/sentinel/telegram.env
curl -sS "https://api.telegram.org/bot${TG_TOKEN}/getUpdates?limit=20" | python3 - <<'PY'
import sys,json
j=json.loads(sys.stdin.read() or "{}")
for u in reversed(j.get("result",[])):
  m=u.get("message") or {}
  c=m.get("chat") or {}
  t=m.get("text")
  if "id" in c and t:
    print("CHAT_ID:", c["id"])
    print("TEXT:", t)
    break
else:
  print("NONE (renvoie un nouveau message au bot, puis relance)")
PY
cat >/root/fix_solana_rpc_404.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
DIS="/etc/nginx/disabled-sites"
mkdir -p "$DIS"

echo "== A) List ALL 443 server blocks that mention $DOMAIN =="
nginx -T 2>/dev/null | awk -v dom="$DOMAIN" '
  /^# configuration file /{f=$4; sub(/:$/,"",f)}
  /listen\s+(\[::\]:)?443/ {in443=1}
  /server_name/ && $0 ~ dom {print "FILE:",f,"\n  ",$0}
' | sed -n '1,120p'
echo

echo "== B) Find the ACTIVE vhost file for $DOMAIN on 443 (first match) =="
VHOST="$(
nginx -T 2>/dev/null | awk -v dom="$DOMAIN" '
  /^# configuration file /{f=$4; sub(/:$/,"",f)}
  /server\s*\{/ {inserver=1}
  inserver && /listen\s+(\[::\]:)?443/ {has443=1}
  inserver && /server_name/ && $0 ~ dom {hasdom=1; file=f}
  inserver && /\}/ {
    if(has443 && hasdom){ print file; exit }
    inserver=has443=hasdom=0
  }
'
)"
[[ -n "${VHOST:-}" && -f "$VHOST" ]] || { echo "[ERR] can't find active 443 vhost for $DOMAIN"; exit 1; }
echo "[OK] ACTIVE 443 VHOST: $VHOST"
cp -a "$VHOST" "${VHOST}.bak_$(date +%Y%m%d_%H%M%S)"

echo
echo "== C) Disable other enabled vhosts that also have server_name $DOMAIN (to avoid wrong match) =="
for f in /etc/nginx/sites-enabled/*; do
  [[ -f "$f" ]] || continue
  [[ "$f" == "$VHOST" ]] && continue
  if grep -qE "server_name .*${DOMAIN}" "$f"; then
    echo "DISABLE: $f -> $DIS/"
    mv -f "$f" "$DIS/$(basename "$f").disabled_$(date +%Y%m%d_%H%M%S)"
  fi
done

echo
echo "== D) Force /solana-rpc location INSIDE the active 443 vhost (no include ambiguity) =="
# remove any old /solana-rpc blocks in that file (best-effort)
perl -0777 -i -pe 's/\n\s*location\s*=\s*\/solana-rpc\s*\{.*?\}\s*\n/\n/smg' "$VHOST"

# insert our location right after server_name line
sed -i "/server_name .*${DOMAIN}/a\\
\\
  location = /solana-rpc {\\
    proxy_pass https://api.mainnet-beta.solana.com;\\
    proxy_ssl_server_name on;\\
    proxy_set_header Host api.mainnet-beta.solana.com;\\
\\
    add_header Access-Control-Allow-Origin * always;\\
    add_header Access-Control-Allow-Headers * always;\\
    add_header Access-Control-Allow-Methods \"POST, OPTIONS\" always;\\
    if (\$request_method = OPTIONS) { return 204; }\\
  }\\
" "$VHOST"

echo
echo "== E) Test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "== F) CORRECT RPC test (SNI + Host) MUST return result:ok =="
curl -sk --resolve ${DOMAIN}:443:127.0.0.1 https://${DOMAIN}/solana-rpc \
  -H 'Content-Type: application/json' \
  --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' && echo
BASH

chmod +x /root/fix_solana_rpc_404.sh
/root/fix_solana_rpc_404.sh
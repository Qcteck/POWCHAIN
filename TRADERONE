cat >/root/fix_tryfiles_broken.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

F="/etc/nginx/sites-available/fireinners.online-ssl"
L="/etc/nginx/sites-enabled/fireinners.online-ssl"
ts="$(date +%Y%m%d_%H%M%S)"

echo "== Backup =="
cp -a "$F" "${F}.bak_${ts}"
ln -sf "$F" "$L"

echo
echo "== Show ALL try_files lines (with numbers) =="
grep -n "try_files" "$L" || true

echo
echo "== Show context around the failing area (lines 1-80) =="
nl -ba "$L" | sed -n '1,80p'

echo
echo "== Fix broken try_files variants =="
# Fix: try_files \ =404;  -> try_files $uri =404;
sed -i -E 's@try_files[[:space:]]+\\[[:space:]]+=404;@try_files $uri =404;@g' "$F"

# Fix: try_files \ $uri =404;  -> try_files $uri =404;
sed -i -E 's@try_files[[:space:]]+\\[[:space:]]+\$uri[[:space:]]+=404;@try_files $uri =404;@g' "$F"

# Fix: try_files \\$uri =404; (double slash) -> try_files $uri =404;
sed -i -E 's@try_files[[:space:]]+\\\\\$uri[[:space:]]+=404;@try_files $uri =404;@g' "$F"

echo
echo "== Re-check try_files lines =="
grep -n "try_files" "$L" || true

echo
echo "== nginx test =="
nginx -t
echo "OK ✅ nginx syntax is clean now"
BASH

chmod +x /root/fix_tryfiles_broken.sh
/root/fix_tryfiles_broken.sh
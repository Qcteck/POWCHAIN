@echo off
setlocal EnableExtensions
cd /d "%~dp0"

echo [ROBO600] Preparation only (no export, no OpenSCAD run).
echo Dossier: %cd%
echo.

rem 1) PARTS_LIST.txt
> "PARTS_LIST.txt" (
  echo pelvis_half1
  echo pelvis_half2
  echo torso_half1
  echo torso_half2
  echo head_half1
  echo head_half2
  echo back_hatch
  echo neck_ring
  echo face_plate
  echo jaw
  echo shoulder_joint
  echo elbow_joint
  echo hip_joint
  echo knee_joint
  echo upperarm_half1
  echo upperarm_half2
  echo forearm_half1
  echo forearm_half2
  echo hand
  echo thigh_half1
  echo thigh_half2
  echo shin_half1
  echo shin_half2
  echo foot
  echo dc_mount_small
  echo dc_mount_big
  echo driver_tray
  echo pca_esp_tray
  echo lcd_bezel
  echo solar_bracket_left
  echo solar_bracket_right
  echo cable_clip
)

rem 2) PART_TEMPLATE.txt (ligne à coller dans ton SCAD)
> "PART_TEMPLATE.txt" (
  echo Remplace dans le SCAD: PART="all";
  echo Par exemple: PART="pelvis_half1";
  echo Puis Render (F6) et Export STL dans ce dossier.
)

rem 3) README_EXPORT.txt (guide manuel)
> "README_EXPORT.txt" (
  echo ROBO600 — Export STL (manuel via OpenSCAD)
  echo.
  echo 1^) Ouvre robo600_parts.scad dans OpenSCAD
  echo 2^) En haut du fichier, remplace: PART="all";
  echo    par: PART="NOM_DE_LA_PIECE";
  echo 3^) Fais Render (F6)
  echo 4^) File ^> Export ^> Export as STL
  echo 5^) Enregistre dans ce dossier: %cd%
  echo 6^) Repete pour toutes les pieces dans PARTS_LIST.txt
  echo.
  echo Notes:
  echo - Si tu laisses PART="all", tu exportes un assemblage (1 seul STL).
  echo - Pour avoir 1 STL par piece, il faut changer PART a chaque export.
)

echo OK: fichiers crees:
dir /b "PARTS_LIST.txt" "PART_TEMPLATE.txt" "README_EXPORT.txt"
echo.
echo Rien n'a ete exporte. Suis README_EXPORT.txt pour faire les STL piece par piece.
pause
endlocal
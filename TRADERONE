# ROOT batch — detect frontend type (Vite/Node vs statique), deploy sous /wolverine
set -euo pipefail

REPO="/opt/fireinners/WOLVERINE"
DIST="/var/www/wolverine"
NG="/etc/nginx/sites-enabled/fireinners.online-ssl"

cd "$REPO"
echo "=== REPO ==="
pwd
ls -lah

echo
echo "=== 1) Cherche un package.json avec script build ==="
PKG="$(find "$REPO" -type f -name package.json \
  -not -path "*/node_modules/*" \
  -exec sh -c 'grep -q "\"scripts\"" "$1" && grep -q "\"build\"" "$1" && echo "$1"' sh {} \; \
  | head -n 1 || true)"

if [ -n "${PKG:-}" ]; then
  APP_DIR="$(dirname "$PKG")"
  echo "OK: frontend Node détecté -> $APP_DIR"

  # Node install si besoin
  if ! command -v node >/dev/null 2>&1; then
    apt-get update -y
    apt-get install -y curl
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs
  fi
  apt-get update -y
  apt-get install -y rsync git

  cd "$APP_DIR"

  # env Vite (si ignoré, pas grave)
  cat > .env.production <<'EOF'
VITE_BASE=/wolverine/
VITE_API_BASE=/wolverine/traderone/api
EOF

  npm ci
  npm run build

  OUT=""
  for d in dist build out; do
    [ -d "$APP_DIR/$d" ] && OUT="$APP_DIR/$d" && break
  done
  [ -n "$OUT" ] || { echo "KO: build OK mais aucun dist/build/out trouvé"; exit 1; }

  echo "Deploy output => $DIST"
  mkdir -p "$DIST"
  rsync -a --delete "$OUT/" "$DIST/"

else
  echo "INFO: aucun frontend Node détecté. On déploie en STATIQUE."

  # Statique: on cherche index.html
  HTML_DIR="$(find "$REPO" -maxdepth 4 -type f -name index.html -print | head -n 1 | xargs -r dirname || true)"
  [ -n "${HTML_DIR:-}" ] || { echo "KO: aucun index.html trouvé dans $REPO"; exit 1; }

  echo "OK: frontend statique détecté -> $HTML_DIR"
  apt-get update -y
  apt-get install -y rsync

  mkdir -p "$DIST"
  rsync -a --delete "$HTML_DIR/" "$DIST/"
fi

chmod -R 755 /var/www
find "$DIST" -type f -exec chmod 644 {} \;

echo
echo "=== 2) Nginx: s'assurer que /wolverine sert /var/www/wolverine (sans toucher l'API) ==="
cp -a "$NG" "$NG.bak.ui_deploy_$(date +%s)"

python3 - <<'PY'
from pathlib import Path
import re
ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# retire anciens blocs UI /wolverine
for pat in [
  r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*',
]:
  s = re.sub(pat, "\n", s, flags=re.M)

block = r'''
# --- WOLVERINE UI (served from /var/www/wolverine) ---
location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}
'''
i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: pas trouvé de '}' final dans le conf nginx")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: UI bloc injected")
PY

nginx -t
systemctl reload nginx

echo
echo "=== 3) Tests ==="
curl -sS -I https://fireinners.online/wolverine/ | head -n 12
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12
echo "DONE ✅"
set -e
cd /opt/traderone-opt

echo "=== 1) Quel fichier PM2 lance vraiment ? ==="
pm2 describe traderone | egrep -i 'script path|script|exec|interpreter|cwd' || true
echo

echo "=== 2) Est-ce que /api/dexes est dans server.js ? ==="
grep -n "/api/dexes" -n server.js || echo "ABSENT dans server.js"
echo

echo "=== 3) Patch SAFE: insérer /api/dexes avant la route catch-all ==="
node <<'NODE'
const fs = require("fs");
const p = "/opt/traderone-opt/server.js";
let s = fs.readFileSync(p,"utf8");

if(!s.includes('app.get("/api/dexes"') && !s.includes("app.get('/api/dexes'")){
  const marker = "app.get(/^\\/(?!api\\/).*/";
  const idx = s.indexOf(marker);
  if(idx === -1) throw new Error("Marker catch-all not found: " + marker);

  // s'assurer que helper existe
  if(!s.includes("function loadDexAllowlist")){
    throw new Error("Helper loadDexAllowlist missing. (Il faut le bloc helper avant.)");
  }

  const route = `
app.get("/api/dexes", (req,res)=>{
  res.json({ ok:true, dexes: loadDexAllowlist() });
});

`;
  s = s.slice(0, idx) + route + s.slice(idx);
  fs.writeFileSync(p, s);
  console.log("OK: inserted /api/dexes before catch-all");
} else {
  console.log("OK: /api/dexes already present in file");
}
NODE

echo
echo "=== 4) Restart + tests ==="
node --check server.js
pm2 restart traderone --update-env
sleep 1
curl -sS -i http://127.0.0.1:3000/health | head -n 15
echo
curl -sS http://127.0.0.1:3000/api/dexes | head -c 400; echo
echo "=== DONE ==="
set -euo pipefail

DOMAIN="fireinners.online"
SNIP="/etc/nginx/snippets/fireinners_routes.conf"

echo "=== 1) Où le snippet est inclus ? ==="
grep -RIn --color=never "include .*fireinners_routes\.conf" /etc/nginx 2>/dev/null || true
echo

echo "=== 2) Trouver le server block pour $DOMAIN ==="
CONF="$(grep -RIl "server_name.*${DOMAIN}" /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null | head -n 1 || true)"
echo "CONF=$CONF"
[ -n "$CONF" ] || { echo "❌ server block introuvable pour $DOMAIN"; exit 1; }

echo "=== 3) Backup configs avant modifs ==="
cp -a "$CONF" "$CONF.bak.$(date +%s)"

# Si le snippet a été inclus dans nginx.conf / http context, on retire partout sauf dans le CONF final.
echo "=== 4) Retirer les includes du snippet partout SAUF dans $CONF ==="
for f in $(grep -RIl "include .*fireinners_routes\.conf" /etc/nginx 2>/dev/null | sort -u); do
  if [ "$f" != "$CONF" ]; then
    cp -a "$f" "$f.bak.$(date +%s)" || true
    sed -i '/include .*fireinners_routes\.conf;/d' "$f" || true
    echo "Removed include from: $f"
  fi
done

echo "=== 5) Assurer include DANS le server { } de $CONF ==="
if ! grep -qF "include $SNIP;" "$CONF"; then
  # insère juste après la ligne server_name (dans le server block)
  awk -v inc="  include $SNIP;" '
    {print}
    $0 ~ /server_name[[:space:]]+[^;]*fireinners\.online/ && !done {print inc; done=1}
  ' "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
  echo "✅ include ajouté dans $CONF (après server_name)"
else
  echo "✅ include déjà présent dans $CONF"
fi

echo "=== 6) Test + reload ==="
nginx -t
systemctl reload nginx
echo "✅ nginx reloaded"
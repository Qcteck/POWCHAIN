bash -lc 'set -euo pipefail;cd /root;python3 - <<'"'"'PY'"'"'
import os,glob,shutil,sys
cand=[]
for p in glob.glob("/root/*"):
  b=os.path.basename(p)
  if "MEGA_DEMELE" in b or "DEMELE" in b and b.endswith(".sh"):
    cand.append(p)
print("CANDIDATES:")
for p in cand: print(" -",repr(os.path.basename(p)))
# pick best match
best=None
for p in cand:
  if os.path.basename(p).startswith("MEGA_DEMELE_WOLV_AQ") and p.endswith(".sh"):
    best=p;break
if not best and cand: best=cand[0]
if not best:
  print("ERROR: aucun script DEMELE trouvé dans /root"); sys.exit(1)
dst="/root/DW.sh"
print("USING:",repr(os.path.basename(best)),"->",dst)
shutil.copy2(best,dst)
PY
sed -i '"'"'s/\r$//'"'"' /root/DW.sh || true
chmod +x /root/DW.sh
bash /root/DW.sh'
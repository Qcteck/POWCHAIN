cat >/root/WOLV_REMOVE_AMCQ.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== Stop/Disable amcq.service ==="
if systemctl list-unit-files | grep -q "^amcq.service"; then
  systemctl stop amcq.service || true
  systemctl disable amcq.service || true
  systemctl mask amcq.service || true
  echo "✅ amcq.service stopped+disabled+masked"
else
  echo "ℹ️ amcq.service not found"
fi

echo
echo "=== Kill any leftover node running /root/amcq/server.js (if any) ==="
pids="$(ps aux | grep -E '[n]ode .*\/root\/amcq\/server\.js' | awk '{print $2}' || true)"
if [ -n "${pids:-}" ]; then
  echo "Killing: $pids"
  kill -9 $pids || true
else
  echo "No amcq node process found"
fi

echo
echo "=== Optional: remove folder /root/amcq (rename backup) ==="
if [ -d /root/amcq ]; then
  mv /root/amcq "/root/amcq_DISABLED_$(date +%s)" || true
  echo "✅ /root/amcq moved to backup folder"
else
  echo "ℹ️ /root/amcq not present"
fi

echo
echo "DONE ✅"
BASH

bash /root/WOLV_REMOVE_AMCQ.sh
backup_one(){
  local p="$1"
  [ -e "$p" ] || return 0
  local dst="$BK${p}"
  mkdir -p "$(dirname "$dst")"
  cp -a "$p" "$dst" 2>/dev/null || true
}

lsattr_safe(){ lsattr "$1" 2>/dev/null | awk '{print $1}' || echo ""; }

unfreeze_one(){
  local f="$1"
  [ -e "$f" ] || return 0
  local a; a="$(lsattr_safe "$f")"
  if echo "$a" | grep -q 'i'; then
    log "UNFREEZE: chattr -i $f"
    chattr -i "$f" 2>/dev/null || true
  fi
}

refreeze_one(){
  local f="$1"
  [ -e "$f" ] || return 0
  log "REFREEZE: chattr +i $f"
  chattr +i "$f" 2>/dev/null || true
}

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp" <<'EOF'
__CONTENT__
EOF
  # replace placeholder with stdin content
  perl -0777 -pe 's/__CONTENT__\n//s' -i "$tmp"
  # append real content piped in
  cat >>"$tmp"
  mkdir -p "$(dirname "$path")"
  backup_one "$path"
  mv -f "$tmp" "$path"
  chmod 644 "$path" || true
}

ensure_packages(){
  log "1) Packages (curl/nginx/python3/unzip) si manquants"
  apt-get update -y >/dev/null 2>&1 || true
  for p in curl nginx python3 unzip; do
    dpkg -s "$p" >/dev/null 2>&1 || apt-get install -y "$p" >/dev/null 2>&1 || true
  done
}


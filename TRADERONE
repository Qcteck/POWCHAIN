SOLRPC_PORT="12713"
VAULT_PORT="12714"
SERV_DIR="/opt/wolverine-services"
SOLRPC_DIR="$SERV_DIR/solana-rpc-proxy"
VAULT_DIR="$SERV_DIR/vault-api"

BK="/root/MEGA_WOLVERINE_FIX_AQUILA_BACKUP_${TS}"
mkdir -p "$BK"

say(){ echo "[$(date +%H:%M:%S)] $*"; }
need(){ command -v "$1" >/dev/null 2>&1 || { echo "ERROR: missing $1"; exit 1; }; }

say "0) Preflight"
[ "$(id -u)" = "0" ] || { echo "ERROR: run as root"; exit 1; }

set -euo pipefail

MAIN="/opt/traderone-opt/server.js"
SVC="traderone.service"
TS="$(date +%s)"

cp -a "$MAIN" "$MAIN.bak.$TS"
echo "Backup: $MAIN.bak.$TS"

# 1) Supprimer le vieux bloc injecté qui contient PUT_BOT_WALLET_HERE (celui qui redéclare BOT_WALLET)
perl -0777 -i -pe 's/\n\/\* WOLVERINE_START_PUBLIC_VALIDATE_BEGIN \*\/[\s\S]*?PUT_BOT_WALLET_HERE[\s\S]*?\/\* WOLVERINE_START_PUBLIC_VALIDATE_END \*\/\n/\n/s' "$MAIN" || true

# 2) Sécurité: si le placeholder reste dans le fichier, on l'enlève quand même
perl -0777 -i -pe 's/\s*\|\|\s*"PUT_BOT_WALLET_HERE"//g' "$MAIN" || true

echo "== Occurrences BOT_WALLET restantes =="
grep -n "const BOT_WALLET" "$MAIN" || true

# 3) Restart et vérifier que 8585 écoute
systemctl restart "$SVC"
sleep 1
systemctl status "$SVC" --no-pager -l | sed -n '1,40p'

echo
echo "== LISTEN 8585 =="
ss -lntp | grep ':8585' || echo "❌ rien n'écoute sur 8585"

echo
echo "== TEST LOCAL start (bypass nginx) =="
curl -sS -D- "http://127.0.0.1:8585/wolverine/traderone/api/start" \
  -X POST -H "Content-Type: application/json" \
  --data '{"wallet":"TESTUSER","budget":1}' | head -n 80 || true
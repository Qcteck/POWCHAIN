from pathlib import Path
import re, time

html_path = Path("/var/www/wolverine/index.html")
s = html_path.read_text(errors="ignore")

# 4.1 Ensure vendor solana-web3 is loaded early (before app scripts)
tag = '<script src="/wolverine/vendor/solana-web3.min.js"></script>'
if tag not in s:

set -euo pipefail

echo "=== A) Sanity files ==="
ls -lah /var/www/_vpsmap || true
ls -lah /var/www/_vpsmap/index.html || true
chmod -R a+rX /var/www/_vpsmap || true
chown -R www-data:www-data /var/www/_vpsmap 2>/dev/null || true

echo
echo "=== B) NGINX TEST (must be OK) ==="
nginx -t || { echo "❌ nginx -t failed (syntax). Showing last 200 lines:"; nginx -T 2>/dev/null | tail -n 200; exit 1; }

echo
echo "=== C) Tail nginx error log (look for /_vpsmap/) ==="
tail -n 120 /var/log/nginx/error.log || true

echo
echo "=== D) HARD FIX: serve /_vpsmap/ as static (no alias traps) ==="
SNIP="/etc/nginx/snippets/_vpsmap_static.conf"
mkdir -p /etc/nginx/snippets
cat > "$SNIP" <<'NGX'
# VPSMAP static
location ^~ /_vpsmap/ {
  root /var/www;
  try_files $uri $uri/ /_vpsmap/index.html;
}
NGX

# ensure it's included in the main server{} that serves fireinners.online
MAIN_FILES="$(nginx -T 2>/dev/null | awk '
  /^# configuration file / {f=$4}
  /server_name/ && /fireinners\.online/ {print f}
' | sort -u)"

echo "Server files for fireinners.online:"
echo "$MAIN_FILES"

for f in $MAIN_FILES; do
  [ -f "$f" ] || continue
  cp -a "$f" "$f.bak._vpsmapfix.$(date +%Y%m%d_%H%M%S)" || true
  grep -q "_vpsmap_static.conf" "$f" && continue
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/_vpsmap_static.conf;/' "$f"
done

echo
echo "=== E) Reload nginx ==="
nginx -t
systemctl reload nginx

echo
echo "=== F) Test ==="
curl -sS -I https://fireinners.online/_vpsmap/ | head -n 20
curl -sS https://fireinners.online/_vpsmap/ | head -n 5
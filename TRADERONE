cat <<'BASH' >/root/FIX_TRADERONE_SOL.sh
#!/usr/bin/env bash
set -e

echo "=== FIX TRADERONE SOL BALANCE (LOCAL BATCH) ==="

APP_DIR="/opt/traderone-api"
PORT=3010
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

echo "[1/6] Install Node.js"
apt update -y
apt install -y nodejs npm

echo "[2/6] Create backend"
mkdir -p "$APP_DIR"
cd "$APP_DIR"

cat > server.js <<EOF
const express = require("express");
const { Connection, PublicKey } = require("@solana/web3.js");

const app = express();
const PORT = 3010;
const RPC = "$RPC";

const connection = new Connection(RPC, "confirmed");

app.get("/balance/:pubkey", async (req, res) => {
  try {
    const pubkey = new PublicKey(req.params.pubkey);
    const lamports = await connection.getBalance(pubkey);
    res.json({ sol: lamports / 1e9 });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

app.listen(PORT, () => console.log("TraderOne API running on", PORT));
EOF

npm init -y >/dev/null
npm install express @solana/web3.js

echo "[3/6] Create systemd service"
cat > /etc/systemd/system/traderone-api.service <<EOF
[Unit]
Description=TraderOne SOL API
After=network.target

[Service]
WorkingDirectory=$APP_DIR
ExecStart=/usr/bin/node server.js
Restart=always

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reexec
systemctl daemon-reload
systemctl enable traderone-api
systemctl restart traderone-api

echo "[4/6] Fix nginx proxy"
if ! grep -q "/wolverine/api/" "$NGINX_SITE"; then
  sed -i '/location \/wolverine\/ {/a \
    location /wolverine/api/ {\
        proxy_pass http://127.0.0.1:3010/;\
        proxy_http_version 1.1;\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
    }' "$NGINX_SITE"
fi

nginx -t
systemctl reload nginx

echo "[5/6] Test local API"
curl -s http://127.0.0.1:3010/balance/11111111111111111111111111111111 || true

echo "[6/6] DONE — Reload browser"
echo "SOL balance endpoint READY"
BASH

chmod +x /root/FIX_TRADERONE_SOL.sh
bash /root/FIX_TRADERONE_SOL.sh
 mut mini"><div id="mhOut">-</div><div id="hmOut">-</div></div></div></div></div><div class="card"><div class="mut">Logs</div><pre id="log"></pre></div></div></div><script>(()=>{const $=id=>document.getElementById(id),LOG=m=>{$("log").textContent=(new Date().toLocaleTimeString()+" "+m+"\n"+$("log").textContent).slice(0,16000)};const SOL_MINT="So11111111111111111111111111111111111111112",USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";const fmtDur=ms=>{ms=Math.max(0,ms|0);const s=ms/1000|0,d=s/86400|0,h=(s%86400)/3600|0,m=(s%3600)/60|0,ss=s%60|0;return (d?d+"j ":"")+(h?h+"h ":"")+(m?m+"m ":"")+ss+"s"};const fmtUSD=x=>{x=Number(x)||0;if(x>=1e9)return (x/1e9).toFixed(2)+"B";if(x>=1e6)return (x/1e6).toFixed(2)+"M";if(x>=1e3)return (x/1e3).toFixed(2)+"K";return x.toFixed(0)};const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));const uniq=a=>[...new Set(a)];const splitMints=txt=>uniq((txt||"").split(/[\s,;]+/).map(s=>s.trim()).filter(Boolean));const kNorm=v=>{let s=0;for(let i=0;i<v.length;i++){v[i]=Math.max(0,Number(v[i])||0);s+=v[i]}if(s<=0){const u=1/v.length;return v.map(()=>u)}return v.map(x=>x/s)};let TIME_SCALE=Math.max(0.1,Number(localStorage.tScale||10)||10);function setScale(x){TIME_SCALE=Math.max(0.1,Number(x)||10);localStorage.tScale=String(TIME_SCALE);$("scaleState").textContent="x"+TIME_SCALE;LOG("Scale temps = x"+TIME_SCALE)}class Limiter{constructor(conc=2,gap=350){this.conc=conc;this.gap=gap;this.q=[];this.run=0;this.last=0}schedule(fn){return new Promise((res,rej)=>{this.q.push({fn,res,rej});this._pump()})}async _pump(){if(this.run>=this.conc||!this.q.length)return;const now=Date.now();const wait=Math.max(0,this.gap-(now-this.last));if(wait){setTimeout(()=>this._pump(),wait);return}const job=this.q.shift();this.run++;this.last=Date.now();try{const out=await job.fn();job.res(out)}catch(e){job.rej(e)}finally{this.run--;this._pump();this._pump()}}}const limiter=new Limiter(2,350);async function fetchJson(url,tries=3){let err=null;for(let i=0;i<tries;i++){
cat >/root/check_usdc_accounts_fixed3.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

RPC="https://fireinners.online/wolverine/rpc"
USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"

read -p "Paste Phantom address (Connected: ...): " WALLET
WALLET="$(echo "$WALLET" | tr -d '[:space:]')"

PAY=$(printf '{"jsonrpc":"2.0","id":1,"method":"getTokenAccountsByOwner","params":["%s",{"mint":"%s"},{"encoding":"jsonParsed"}]}' "$WALLET" "$USDC")
resp="$(curl -sk -H 'content-type: application/json' --data "$PAY" "$RPC")"

printf '%s' "$resp" | python3 -c '
import json,sys
txt=sys.stdin.read().strip()
j=json.loads(txt)
if "error" in j:
    print("RPC ERROR:", j["error"]); raise SystemExit(1)
vals=j.get("result",{}).get("value",[]) or []
print("token accounts:", len(vals))
total=0.0
for v in vals:
    ta=v["account"]["data"]["parsed"]["info"]["tokenAmount"]
    s=ta.get("uiAmountString") or "0"
    total += float(s)
print("USDC total:", total)
'
BASH

chmod +x /root/check_usdc_accounts_fixed3.sh
/root/check_usdc_accounts_fixed3.sh
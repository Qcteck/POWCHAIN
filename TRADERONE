# Batch ROOT — enlève les 2 blocks /tests (location = /tests et location ^~ /tests/) puis reload
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"

[ -f "$VHOST" ] || { echo "❌ VHOST introuvable: $VHOST"; exit 1; }
cp -a "$VHOST" "$VHOST.bak.rm_tests_$TS"

# Supprime les 2 locations (même si espaces différents)
perl -0777 -i -pe '
s/^\s*#\s*\/tests\s*->\s*\/test\/\s*\R//mg;
s/^\s*location\s*=\s*\/tests\s*\{\s*return\s+301\s+\/test\/;\s*\}\s*\R//mg;
s/^\s*location\s*\^~\s*\/tests\/\s*\{\s*return\s+301\s+\/test\/;\s*\}\s*\R//mg;
' "$VHOST"

# Nettoyage lignes vides (optionnel)
perl -0777 -i -pe 's/\n{3,}/\n\n/g' "$VHOST"

echo "=== Vérif: plus de /tests ==="
grep -nE "location\s+(=|\^~)\s+/tests" "$VHOST" || echo "✅ OK: aucun /tests"

nginx -t
systemctl reload nginx
echo "✅ DONE (backup: $VHOST.bak.rm_tests_$TS)"
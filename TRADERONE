import fs from "fs";
import path from "path";
import Parser from "rss-parser";
import sanitizeHtml from "sanitize-html";
import TelegramBot from "node-telegram-bot-api";

const TELEGRAM_TOKEN = process.env.TELEGRAM_TOKEN || "TON_TOKEN_TELEGRAM";
const CHAT_ID = process.env.CHAT_ID || "TON_CHAT_ID";

const RSS_SOURCES = [
  "https://cryptoast.fr/feed",
  "https://cryptonaute.fr/feed",
  "https://fr.cointelegraph.com/rss-feeds/actualites.xml",
  "https://bitcoin.fr/feed",
  "https://journalducoin.com/feed/",
  "https://www.cryptopolitan.com/feed/",
  "https://fr.cryptoslate.com/feed/",
  "https://cryptonaute.fr/crypto-news/feed/",
  "https://www.finyear.com/rss/cryptomonnaie"
];

const MEMORY_FILE = path.resolve("./memory.json");
const ARTICLE_INTERVAL = 15 * 60 * 1000; // 15 min
const GENERATE_CHANCE = 0.2; // 20%

const parser = new Parser();
const bot = new TelegramBot(TELEGRAM_TOKEN, { polling: true });

let memory = { sentLinks: [], anomalies: [] };
if (fs.existsSync(MEMORY_FILE)) {
  try { memory = JSON.parse(fs.readFileSync(MEMORY_FILE, "utf8")); } catch {}
}

function saveMemory() {
  fs.writeFileSync(MEMORY_FILE, JSON.stringify(memory, null, 2));
}

function clean(text) {
  const noHtml = sanitizeHtml(text || "", { allowedTags: [], allowedAttributes: {} });
  return noHtml.replace(/\s+/g, " ").trim();
}

function pick(arr) {
  return arr[Math.floor(Math.random() * arr.length)];
}

async function loadAllFeeds() {
  const items = [];
  for (const url of RSS_SOURCES) {
    try {
      const feed = await parser.parseURL(url);
      for (const it of feed.items || []) {
        items.push({
          source: feed.title || url,
          title: clean(it.title),
          link: it.link,
          content: clean(it.contentSnippet || it.content || it.summary || "")
        });
      }
    } catch (e) {
      // on ignore la source qui fail
    }
  }
  return items.filter(x => x.title && x.link);
}

function detectAnomaly(text) {
  const keywords = ["anomalie", "irrégulier", "surprenant", "choc", "bizarre", "hack", "exploit"];
  return keywords.some(k => text.toLowerCase().includes(k));
}

async function sendArticle(item) {
  // Telegram: évite Markdown fragile, utilise du texte simple
  const msg =
    `📰 ${item.title}\n` +
    `${item.source}\n` +
    `${item.link}\n\n` +
    (item.content ? item.content.slice(0, 350) + (item.content.length > 350 ? "…" : "") : "");

  await bot.sendMessage(CHAT_ID, msg);
}

async function loopOnce() {
  const all = await loadAllFeeds();
  if (!all.length) return;

  // évite doublons
  const fresh = all.filter(a => !memory.sentLinks.includes(a.link));
  const chosen = pick(fresh.length ? fresh : all);

  // envoie parfois
  if (Math.random() < GENERATE_CHANCE) {
    await sendArticle(chosen);
    memory.sentLinks.push(chosen.link);
    memory.sentLinks = memory.sentLinks.slice(-500); // garde 500 derniers
    saveMemory();
  }

  // anomalies
  const textBlob = `${chosen.title} ${chosen.content}`;
  if (detectAnomaly(textBlob)) {
    const note = `⚠️ Mot-clé “anomalie” détecté sur: ${chosen.title}\n${chosen.link}`;
    memory.anomalies.push({ at: Date.now(), title: chosen.title, link: chosen.link });
    memory.anomalies = memory.anomalies.slice(-200);
    saveMemory();
    await bot.sendMessage(CHAT_ID, note);
  }
}

console.log("🚀 Bot RSS démarré...");

setInterval(() => {
  loopOnce().catch(() => {});
}, ARTICLE_INTERVAL);

// test immédiat au démarrage

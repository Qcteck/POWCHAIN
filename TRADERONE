bash <<'BASH'
set -euo pipefail
DIR="/opt/traderone-vault"
FILE="$DIR/treasury.json"

mkdir -p "$DIR"

echo "== GÉNÉRATION TREASURY SOLANA =="

node <<'JS'
const fs=require("fs");
const {Keypair}=require("@solana/web3.js");

const kp=Keypair.generate();
fs.writeFileSync("/opt/traderone-vault/treasury.json",JSON.stringify(Array.from(kp.secretKey)));

console.log("TREASURY PUBKEY :",kp.publicKey.toBase58());
console.log("FICHIER CRÉÉ : /opt/traderone-vault/treasury.json");
JS

chmod 600 "$FILE"
echo "== OK =="
BASH
cat >/root/fix_missing_conf_include_use_inc.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HOST="fireinners.online"
VHOST="/etc/nginx/sites-enabled/${HOST}-ssl"
DIR="/etc/nginx/snippets"
CONF="${DIR}/wolverine_routes.conf"
INC="${DIR}/wolverine_routes.inc"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$VHOST" || { echo "Missing $VHOST"; exit 1; }
cp -a "$VHOST" "$VHOST.bak_$TS"

# Ensure INC exists (clean)
if [ ! -f "$INC" ]; then
  cat > "$INC" <<'NGX'
# Wolverine routes (clean)

location = /wolverine/traderone/api {
  return 301 /wolverine/traderone/api/;
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:8585;
}
NGX
fi

# If old .conf exists, move it away to avoid wildcard includes
if [ -f "$CONF" ]; then
  mv -v "$CONF" "${CONF}.disabled_${TS}"
fi

# Replace any include to .conf -> .inc (and comment stale ones)
sed -i -E "s@include[[:space:]]+${DIR}/wolverine_routes\.conf;@include ${INC};@g" "$VHOST"
sed -i -E 's@^([[:space:]]*)include([[:space:]]+.*wolverine_routes\.conf.*);@\1# DISABLED_MISSING include\2;@' "$VHOST"

# Ensure include .inc exists at least once
if ! grep -q "wolverine_routes\.inc" "$VHOST"; then
  echo "  include ${INC};" >> "$VHOST"
fi

nginx -t
systemctl reload nginx || service nginx reload

echo "DONE ✅"
BASH

chmod +x /root/fix_missing_conf_include_use_inc.sh
/root/fix_missing_conf_include_use_inc.sh
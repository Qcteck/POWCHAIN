cat >/root/fix_conflicting_servername_443.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
DIS="/etc/nginx/sites-disabled"
TS="$(date -u +%Y%m%d_%H%M%S)"
HOST="fireinners.online"

mkdir -p "$DIS"

echo "=== 0) Quick public vs origin (before) ==="
curl -skI https://${HOST}/wolverine/index.html | head -n 12 || true
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}/wolverine/index.html | head -n 12 || true
echo

echo "=== 1) List sites-enabled ==="
ls -lah /etc/nginx/sites-enabled || true
echo

echo "=== 2) Find all 443 server blocks mentioning fireinners ==="
nginx -T 2>/dev/null | grep -nE "server_name\s+(fireinners\.online|www\.fireinners\.online)|listen\s+443" | head -n 260 || true
echo

echo "=== 3) Disable duplicate vhosts on 443 for fireinners (keep only fireinners.online-ssl) ==="
[ -f "$KEEP" ] || { echo "❌ KEEP not found: $KEEP"; exit 1; }

moved=0
for f in /etc/nginx/sites-enabled/*; do
  [ "$f" = "$KEEP" ] && continue
  [ -e "$f" ] || continue

  # only touch files that BOTH: listen 443 AND mention fireinners server_name
  if grep -qE "listen\s+443" "$f" 2>/dev/null && grep -qE "server_name\s+.*(fireinners\.online|www\.fireinners\.online)" "$f" 2>/dev/null; then
    base="$(basename "$f")"
    echo "Moving duplicate: $f -> $DIS/${base}.${TS}"
    mv "$f" "$DIS/${base}.${TS}"
    moved=$((moved+1))
  fi
done

echo "Moved duplicates: $moved"
echo

echo "=== 4) nginx test + reload ==="
nginx -t
systemctl reload nginx || service nginx reload
echo

echo "=== 5) Re-test (after) ==="
echo "--- PUBLIC ---"
curl -skI https://${HOST}/wolverine/index.html | head -n 12 || true
echo "--- ORIGIN ---"
curl -skI --resolve ${HOST}:443:127.0.0.1 https://${HOST}/wolverine/index.html | head -n 12 || true

echo "DONE ✅"
BASH

chmod +x /root/fix_conflicting_servername_443.sh
/root/fix_conflicting_servername_443.sh
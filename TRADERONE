set -e
cd /root

for f in /etc/nginx/sites-enabled/fireinners.online /etc/nginx/sites-enabled/fireinners.online-ssl; do
  [ -f "$f" ] || continue
  cp -v "$f" "/root/nginx_backups/$(basename "$f").fixrewrite.$(date +%Y%m%d_%H%M%S)"

  # 1) supprimer toutes les rewrite cassées liées à traderone/api
  sed -i -E '/rewrite\s+\^\/wolverine\/traderone\/api\/.*$/d' "$f"

  # 2) insérer UNE rewrite propre dans le bon location (si pas déjà là)
  perl -0777 -i -pe 's#(location\s+\^~\s+/wolverine/traderone/api/\s*\{\n)(?!.*rewrite\s+\^/wolverine/traderone/api/)#$1  rewrite ^/wolverine/traderone/api/(.*)$ /wolverine/api/$1 break;\n#s' "$f"
done

nginx -t
systemctl reload nginx
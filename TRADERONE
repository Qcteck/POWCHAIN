#!/usr/bin/env bash
set -euo pipefail

############################################
# MEGA_WOLVERINE_COMBINED_PLUS (root, one-shot)
# Ajouts demandés pour couvrir les 4 risques:
# 1) Front non statique / export Next échoue -> fallback auto: front minimal fonctionnel + Phantom SOL/USDC + endpoints UI
# 2) Mauvais vhost réellement servi -> détection via nginx -T, patch du bon fichier (server_name fireinners.online + listen 443)
# 3) chattr +i / includes indirects / conflits /wolverine -> déverrouillage ciblé + neutralisation auto des conflits /wolverine (backup)
# 4) Backend TraderOne réel absent -> wrapper stable + auto-detect backend réel (ports probables) + proxy interne si trouvé

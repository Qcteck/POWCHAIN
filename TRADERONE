cat >/root/AUDIT_TRADERONE_USDC.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/opt/traderone"
REPORT="/root/TRADERONE_USDC_REPORT_$(date +%Y%m%d_%H%M%S).txt"

echo "=========== TRADERONE USDC AUDIT ===========" | tee "$REPORT"
echo "Root analysé : $ROOT" | tee -a "$REPORT"
echo "Date        : $(date)" | tee -a "$REPORT"
echo "" | tee -a "$REPORT"

if [ ! -d "$ROOT" ]; then
  echo "❌ ERREUR : $ROOT n'existe pas." | tee -a "$REPORT"
  exit 1
fi

echo "1) 🔍 Recherche références USDC (string brute)" | tee -a "$REPORT"
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  -E "USDC|usdc|usd-coin|EPjFWdd5" "$ROOT" \
  | tee -a "$REPORT" || echo "Aucune référence USDC trouvée." | tee -a "$REPORT"

echo "" | tee -a "$REPORT"
echo "2) 🪙 Recherche mint USDC officiel (Solana)" | tee -a "$REPORT"
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1" "$ROOT" \
  | tee -a "$REPORT" || echo "Mint USDC officiel NON trouvé." | tee -a "$REPORT"

echo "" | tee -a "$REPORT"
echo "3) 🔄 Logique trading / quote / swap" | tee -a "$REPORT"
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  -E "quote|swap|inputMint|outputMint|baseMint|stable|usdc" "$ROOT" \
  | tee -a "$REPORT" || echo "Aucune logique de quote USDC." | tee -a "$REPORT"

echo "" | tee -a "$REPORT"
echo "4) 💰 Lecture balances SPL / Token" | tee -a "$REPORT"
grep -RIn --exclude-dir=node_modules --exclude-dir=.git \
  -E "getParsedTokenAccountsByOwner|getTokenAccountsByOwner|spl-token|TokenAmount" "$ROOT" \
  | tee -a "$REPORT" || echo "Aucune lecture SPL détectée." | tee -a "$REPORT"

echo "" | tee -a "$REPORT"
echo "=========== RÉSUMÉ ===========" | tee -a "$REPORT"

if grep -q "EPjFWdd5" "$REPORT"; then
  echo "✅ USDC DÉTECTÉ dans TraderOne" | tee -a "$REPORT"
else
  echo "❌ USDC NON UTILISÉ dans TraderOne" | tee -a "$REPORT"
fi

echo "" | tee -a "$REPORT"
echo "📄 Rapport : $REPORT"
echo "=========================================="
BASH

chmod +x /root/AUDIT_TRADERONE_USDC.sh
/root/AUDIT_TRADERONE_USDC.sh
#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/var/www/aiaquila"
HTML="$APP_DIR/index.html"
JS="$APP_DIR/aiaquila-rss.js"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP="$APP_DIR/index.backup_$TS.html"

echo "=== AIAQUILA RSS – FIX DEFINITIF ==="

### 1) CHECK
[ -f "$HTML" ] || { echo "ERREUR: index.html introuvable"; exit 1; }

### 2) BACKUP
cp "$HTML" "$BACKUP"
echo "Backup créé: $BACKUP"

### 3) SUPPRESSION ANCIEN SCRIPT RSS
perl -0777 -i -pe 's/<script[^>]*>[\s\S]*?AIAQUILA[\s\S]*?<\/script>//gi' "$HTML"
echo "Ancien JS RSS supprimé"

### 4) CREATION FICHIER JS PROPRE
cat > "$JS" <<'JS'
/* ===== AIAQUILA RSS JS – STABLE ===== */

const FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://www.coingecko.com/rss/news"
];

const PROXY = "/aiaquila/rss-proxy.php?url=";
let ARTICLES = [];

function log(msg){
  const l = document.getElementById("logs");
  if(l){
    l.textContent += msg + "\n";
    l.scrollTop = l.scrollHeight;
  }
}

async function loadRSS(){
  ARTICLES = [];
  log("Chargement RSS...");

  for(const feed of FEEDS){
    try{
      const res = await fetch(PROXY + encodeURIComponent(feed));
      const xml = await res.text();

      const doc = new DOMParser().parseFromString(xml, "text/xml");
      const items = [...doc.querySelectorAll("item")];

      items.forEach(it=>{
        ARTICLES.push({
          title: it.querySelector("title")?.textContent || "",
          link: it.querySelector("link")?.textContent || "",
          desc: it.querySelector("description")?.textContent || ""
        });
      });
    }catch(e){
      log("Erreur RSS: " + feed);
    }
  }

  log("Articles chargés: " + ARTICLES.length);
  renderAdvice();
}

function renderAdvice(){
  const box = document.getElementById("advice");
  if(!box) return;

  if(ARTICLES.length === 0){
    box.textContent = "Aucun signal détecté.";
    return;
  }

  box.textContent =
    "Analyse crypto: " +
    ARTICLES.slice(0,3).map(a => a.title).join(" • ");
}

document.addEventListener("DOMContentLoaded", ()=>{
  const btn = document.getElementById("loadRSS");
  if(btn) btn.onclick = loadRSS;
  log("AIAQUILA RSS prêt");
});
JS

chmod 644 "$JS"
echo "JS créé: $JS"

### 5) INJECTION SCRIPT TAG SIMPLE
perl -0777 -i -pe 's|</body>|<script src="/aiaquila/aiaquila-rss.js"></script></body>|i' "$HTML"
echo "Script tag injecté"

### 6) RELOAD NGINX
nginx -t && systemctl reload nginx

echo "=== FIX OK ==="
echo "Ouvre https://fireinners.online/aiaquila/"
echo "Ctrl+F5 → clique « Charger les articles »"
document.getElementById('btnStatus').onclick=()=>j('GET','/wolverine/api/status');
document.getElementById('btnStart').onclick=()=>j('POST','/wolverine/api/start', {});
document.getElementById('btnStop').onclick=()=>j('POST','/wolverine/api/stop', {});
ping(); setInterval(ping, 6000);
</script>

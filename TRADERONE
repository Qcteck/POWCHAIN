cat >/root/purge_all_sites_enabled_backups.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

EN="/etc/nginx/sites-enabled"
DST="/etc/nginx/sites-disabled/cleanup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$DST"

echo "== BEFORE =="
ls -lah "$EN"

echo
echo "== Move ALL backups/variants out of sites-enabled =="
shopt -s nullglob
for f in "$EN"/*.bak* "$EN"/*_bak* "$EN"/*.broken* "$EN"/*.old* "$EN"/*~; do
  [ -e "$f" ] || continue
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== Also move any fireinners.* variants except the exact live file =="
KEEP="$EN/fireinners.online-ssl"
for f in "$EN"/fireinners.online-ssl*; do
  [ -e "$f" ] || continue
  [ "$f" = "$KEEP" ] && continue
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== AFTER (should show only fireinners.online-ssl + maybe other real vhosts) =="
ls -lah "$EN"

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload =="
systemctl reload nginx || service nginx reload
echo "DONE ✅"
BASH

chmod +x /root/purge_all_sites_enabled_backups.sh
/root/purge_all_sites_enabled_backups.sh
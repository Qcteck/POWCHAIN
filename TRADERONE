<script>
(()=>{"use strict";
const $=s=>document.querySelector(s);
const API="/wolverine/api";
let PUB="";
async function post(path,obj){
  const r=await fetch(API+path,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(obj||{})});
  const t=await r.text();
  try{ return {ok:r.ok,status:r.status,json:JSON.parse(t)}; }catch(e){ return {ok:false,status:r.status,nonjson:t.slice(0,300)}; }
}
function msg(el,ok,txt){el.innerHTML=(ok?'<span class="ok">':'<span class="bad">')+String(txt).replace(/</g,"&lt;")+"</span>";}
$("#btnConnect").onclick=async()=>{
  try{
    if(!window.solana||!window.solana.isPhantom) return msg($("#startMsg"),false,"Phantom non détecté");
    const r=await window.solana.connect({onlyIfTrusted:false});
    PUB=(r&&r.publicKey)?r.publicKey.toString():"";

block = r"""
/*AQUILA_VAULT_ROUTES_BEGIN*/
(function(){
  try{
    if(global.__AQUILA_VAULT_ROUTES__) return;
    global.__AQUILA_VAULT_ROUTES__ = true;

    const fs = require("fs");
    const path = require("path");
    const crypto = require("crypto");
    const bs58 = require("bs58");

    const { Connection, Keypair, PublicKey, SystemProgram, TransactionMessage, VersionedTransaction } = require("@solana/web3.js");

    const DATA_DIR = process.env.TRADERONE_DATA_DIR || "/opt/traderone/data";
    const VAULTS_FILE = path.join(DATA_DIR, "vaults.json");
    const MASTER_KEY_FILE = process.env.VAULT_MASTER_KEY_FILE || "/opt/traderone/.vault_master_key";
    const RPC_URL = process.env.SOLANA_RPC || "https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac";

    function ensureDir(d){
      try{ fs.mkdirSync(d,{recursive:true}); }catch(_){}
    }
    ensureDir(DATA_DIR);

    function loadMasterKey(){
      try{
        if(fs.existsSync(MASTER_KEY_FILE)){
          const k = fs.readFileSync(MASTER_KEY_FILE, "utf8").trim();
          const b = Buffer.from(k, "base64");
          if(b.length === 32) return b;
        }
      }catch(_){}
      const b = crypto.randomBytes(32);
      try{
        fs.writeFileSync(MASTER_KEY_FILE, b.toString("base64"), {mode:0o600});
        try{ fs.chmodSync(MASTER_KEY_FILE, 0o600); }catch(_){}
      }catch(_){}
      return b;
    }

    const MASTER = loadMasterKey();

    function enc(buf){
      const iv = crypto.randomBytes(12);
      const c = crypto.createCipheriv("aes-256-gcm", MASTER, iv);
      const ct = Buffer.concat([c.update(buf), c.final()]);
      const tag = c.getAuthTag();
      return Buffer.concat([iv, tag, ct]).toString("base64");
    }
    function dec(b64){
      const raw = Buffer.from(b64, "base64");
      const iv = raw.subarray(0,12);
      const tag = raw.subarray(12,28);
      const ct = raw.subarray(28);
      const d = crypto.createDecipheriv("aes-256-gcm", MASTER, iv);
      d.setAuthTag(tag);
      return Buffer.concat([d.update(ct), d.final()]);
    }

    function readVaults(){
      try{
        if(!fs.existsSync(VAULTS_FILE)) return {};
        const j = JSON.parse(fs.readFileSync(VAULTS_FILE, "utf8"));
        return (j && typeof j==="object") ? j : {};
      }catch(_){ return {}; }
    }
    function writeVaults(v){
      try{
        fs.writeFileSync(VAULTS_FILE, JSON.stringify(v, null, 2), {mode:0o600});
        try{ fs.chmodSync(VAULTS_FILE, 0o600); }catch(_){}
      }catch(_){}
    }

    function validPub(p){
      try{ new PublicKey(p); return true; }catch(_){ return false; }
    }

    function getOrCreateVault(userPub){
      const vaults = readVaults();
      if(vaults[userPub] && vaults[userPub].vault && vaults[userPub].encSk){
        return { user:userPub, vault:vaults[userPub].vault, existed:true };
      }
      const kp = Keypair.generate();
      vaults[userPub] = {
        vault: kp.publicKey.toString(),
        encSk: enc(Buffer.from(kp.secretKey)),
        createdAt: new Date().toISOString()
      };
      writeVaults(vaults);
      return { user:userPub, vault: kp.publicKey.toString(), existed:false };
    }

    async function buildDepositTx(userPub, lamports){
      const v = getOrCreateVault(userPub);
      const user = new PublicKey(userPub);
      const vault = new PublicKey(v.vault);
      const conn = new Connection(RPC_URL, "confirmed");
      const latest = await conn.getLatestBlockhash("confirmed");

      const ix = SystemProgram.transfer({
        fromPubkey: user,
        toPubkey: vault,
        lamports: Number(lamports)
      });

      const msg = new TransactionMessage({
        payerKey: user,
        recentBlockhash: latest.blockhash,
        instructions: [ix]
      }).compileToV0Message();

      const tx = new VersionedTransaction(msg);
      const b64 = Buffer.from(tx.serialize()).toString("base64");

      return { vault: v.vault, lamports: Number(lamports), txB64: b64, blockhash: latest.blockhash, lastValidBlockHeight: latest.lastValidBlockHeight };
    }

    // Locate express app reference (supports common patterns)
    const app =
      (typeof global.app !== "undefined" && global.app) ||
      (typeof globalThis.app !== "undefined" && globalThis.app) ||
      null;

    // If server.cjs defines `app` in module scope (most common), we can still access it via eval-free insert (we are in same scope).
    // So we also try to use the identifier `app` if it exists.
    const appRef = (typeof app !== "undefined" && app) || (typeof globalThis !== "undefined" && globalThis.app) || (typeof global !== "undefined" && global.app) || (typeof app !== "undefined" ? app : null);

    // Fallback: try require("express") app stored on module.exports? (rare)
    if(!appRef){
      console.warn("AQUILA_VAULT: could not find express app reference; routes may not attach");
      return;
    }

    // Routes
    appRef.get("/api/vault", async (req,res)=>{
      try{
        const pub = String(req.query.pub||"").trim();
        if(!validPub(pub)) return res.status(400).json({error:"bad pub"});
        const v = getOrCreateVault(pub);
        res.json({status:"ok", user:pub, vault:v.vault, existed:v.existed});
      }catch(e){
        res.status(500).json({error: (e&&e.message)?e.message:String(e)});
      }
    });

    appRef.get("/api/vault/tx/deposit", async (req,res)=>{
      try{
        const pub = String(req.query.pub||"").trim();
        const lamports = Number(req.query.lamports||0);
        if(!validPub(pub)) return res.status(400).json({error:"bad pub"});
        if(!(lamports>0)) return res.status(400).json({error:"bad lamports"});
        const out = await buildDepositTx(pub, lamports);
        res.json({status:"ok", ...out});
      }catch(e){
        res.status(500).json({error: (e&&e.message)?e.message:String(e)});
      }
    });

    console.log("AQUILA_VAULT: routes enabled");
  }catch(e){
    console.error("AQUILA_VAULT init error:", e && e.message ? e.message : e);
  }
})();
/*AQUILA_VAULT_ROUTES_END*/
"""

if MARK_A in s:
  print("OK: vault routes already present")
else:
  # Insert after "const app = express()" if possible; else append at end.
  m = re.search(r"(const\s+app\s*=\s*express\(\)\s*;)", s)
  if m:
    i = m.end()
    s = s[:i] + "\n" + block + "\n" + s[i:]
    print("OK: inserted routes after express()")
  else:
    s = s + "\n\n" + block + "\n"
    print("OK: appended routes at end (no express() marker found)")

p.write_text(s)

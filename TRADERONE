.textContent="non-JSON "+res.status+": "+(res.nonjson||"");depMsg.className="bad"}}async function start(){if(!PUB||!DEP_OK)return;startMsg.textContent="…";startMsg.className="";const body=JSON.stringify({pub:PUB,mode:mode.value,t:Date.now()});const res=await fetchAny("/wolverine/api/start",{method:"POST",headers:{"content-type":"application/json"},body});if(res.json){startMsg.textContent="OK: "+JSON.stringify(res.json);startMsg.className="ok"}else{startMsg.textContent="non-JSON "+res.status+": "+(res.nonjson||"");startMsg.className="bad"}}btnConnect.onclick=async()=>{try{if(!window.solana||!window.solana.isPhantom){setStatus("Phantom absent",false);return}const r=await window.solana.connect({onlyIfTrusted:false});PUB=(r&&r.publicKey)?r.publicKey.toString():(window.solana.publicKey?window.solana.publicKey.toString():"");pubEl.textContent=PUB||"—";const ok=!!PUB;btnRefresh.disabled=!ok;btnMode.disabled=!ok;btnConfirm.disabled=!ok;setStatus(ok?"CONNECTÉ":"FAIL",ok);if(ok)refresh()}catch(e){setStatus("ERR CONNECT",false)}};btnRefresh.onclick=refresh;btnMode.onclick=applyMode;btnConfirm.onclick=confirmDeposit;btnStart.onclick=start})();</script>

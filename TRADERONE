cat >/root/traderone_short.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== 1) Node scripts currently running (short) ==="
ps auxww | awk '/\/usr\/bin\/node/ {print $NF}' | sed -n '1,20p'
echo

echo "=== 2) PM2 (show script path + cwd only) ==="
if command -v pm2 >/dev/null 2>&1; then
  pm2 list || true
  echo
  for i in 0 1 2 3 4 5; do
    echo "--- pm2 show $i (short) ---"
    pm2 show "$i" 2>/dev/null | egrep -i "name|status|script path|cwd" || true
  done
else
  echo "pm2 not installed"
fi
echo

echo "=== 3) Target the live TraderOne app if present ==="
APP="/opt/traderone-opt"
if [ -d "$APP" ]; then
  cd "$APP"
  echo "--- endpoints (top 25) ---"
  grep -RInE --exclude-dir=node_modules --exclude-dir=.git \
    "app\.(get|post|put|delete)|router\.(get|post|put|delete)|/api/" . | head -n 25 || true
  echo
  echo "--- lifi/jupiter keywords (top 25) ---"
  grep -RInE --exclude-dir=node_modules --exclude-dir=.git \
    "lifi|li\.fi|LI\.FI|jupiter|quote|route|routes|bridge|swap" . | head -n 25 || true
else
  echo "No /opt/traderone-opt folder found."
fi
echo

echo "=== 4) .env paths only (top 15) ==="
find /opt -maxdepth 5 -type f -name ".env*" 2>/dev/null | head -n 15 || true

echo "DONE ✅"
BASH

chmod +x /root/traderone_short.sh
/root/traderone_short.sh
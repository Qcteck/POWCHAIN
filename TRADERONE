cat >/root/fix_ssl_443_clean.sh <<'BASH'
#!/usr/bin/env bash
set -e

DOMAIN="fireinners.online"
CERT_DIR="/etc/ssl/fireinners"
CERT="${CERT_DIR}/fullchain.pem"
KEY="${CERT_DIR}/privkey.pem"

HTTP_EN="/etc/nginx/sites-enabled/fireinners.online-http"
SSL_AV="/etc/nginx/sites-available/fireinners.online-ssl"
SSL_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"

mkdir -p "$CERT_DIR" /etc/nginx/disabled-sites

echo "== 1) Fix HTTP vhost (keep only 80) =="
if [ -f "$HTTP_EN" ]; then
  cp -a "$HTTP_EN" "${HTTP_EN}.bak_$(date +%Y%m%d_%H%M%S)"
  sed -i -E '/listen[[:space:]]+(\[::\]:)?443/d' "$HTTP_EN"
fi

echo "== 2) Ensure cert exists (self-signed if needed) =="
if [ ! -f "$CERT" ] || [ ! -f "$KEY" ]; then
  openssl req -x509 -nodes -newkey rsa:2048 -days 365 \
    -keyout "$KEY" -out "$CERT" \
    -subj "/CN=$DOMAIN"
  echo "[OK] self-signed created: $CERT_DIR"
else
  echo "[OK] cert already exists: $CERT_DIR"
fi

echo "== 3) Write CLEAN SSL vhost (NO variables) =="
cat >"$SSL_AV" <<NGINX
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;

  server_name ${DOMAIN} www.${DOMAIN};

  ssl_certificate     ${CERT};
  ssl_certificate_key ${KEY};

  location / {
    return 301 https://${DOMAIN}/wolverine/;
  }
}
NGINX
ln -sf "$SSL_AV" "$SSL_EN"

echo "== 4) Disable any OTHER enabled file that has listen 443 ssl but NO ssl_certificate =="
for f in /etc/nginx/sites-enabled/*; do
  [ -f "$f" ] || continue
  if grep -qE 'listen\s+(\[::\]:)?443.*ssl' "$f" && ! grep -qE '^\s*ssl_certificate\s+' "$f"; then
    echo "[DISABLE] $f"
    mv -f "$f" "/etc/nginx/disabled-sites/$(basename "$f").disabled_$(date +%Y%m%d_%H%M%S)"
  fi
done

echo "== 5) Test + restart =="
nginx -t
systemctl restart nginx

echo
echo "== PORTS =="
ss -lntp | grep -E ':(80|443)\b' || true

echo
echo "== LOCAL HTTPS TEST =="
curl -kI --max-time 5 https://127.0.0.1/ | head -n 12 || true
BASH

chmod +x /root/fix_ssl_443_clean.sh
/root/fix_ssl_443_clean.sh
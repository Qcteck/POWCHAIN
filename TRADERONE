set -e

### PATHS FIXES
BACK="/opt/wolverine"
FRONT="/opt/fireinners/frontend-react/app/dist/wolverine"
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
USDC="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"

echo "=== BACKEND : API BALANCES ==="

mkdir -p $BACK
cd $BACK

cat > server.js <<EOF
import express from "express";
import {Connection,PublicKey} from "@solana/web3.js";

const app=express();
const RPC="$RPC";
const USDC="$USDC";
const conn=new Connection(RPC,"confirmed");

const INTERNAL_WALLET="2uHqvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z";

app.get("/api/balances",async(req,res)=>{
 try{
  const user=req.query.user;
  const out={};

  const sol=async(pk)=>(await conn.getBalance(new PublicKey(pk)))/1e9;
  const usdc=async(pk)=>{
    const ac=await conn.getParsedTokenAccountsByOwner(
      new PublicKey(pk),
      {mint:new PublicKey(USDC)}
    );
    return ac.value.reduce((s,a)=>s+(a.account.data.parsed.info.tokenAmount.uiAmount||0),0);
  };

  out.internalSOL=await sol(INTERNAL_WALLET);
  out.internalUSDC=await usdc(INTERNAL_WALLET);

  if(user){
    out.userSOL=await sol(user);
    out.userUSDC=await usdc(user);
  }

  res.json(out);
 }catch(e){
  res.status(500).json({error:e.message});
 }
});

app.listen(3000,()=>console.log("BALANCES API OK :3000"));
EOF

npm install express @solana/web3.js

cat >/root/keep_only_one_vhost_in_sites_enabled.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

EN="/etc/nginx/sites-enabled"
DST="/etc/nginx/sites-disabled/cleanup_$(date +%Y%m%d_%H%M%S)"
KEEP="$EN/fireinners.online-ssl"

mkdir -p "$DST"

echo "== BEFORE =="
ls -lah "$EN"

echo
echo "== Move EVERYTHING that matches fireinners.online-ssl* EXCEPT the exact active file =="
shopt -s nullglob
for f in "$EN"/fireinners.online-ssl*; do
  [ "$f" = "$KEEP" ] && continue
  echo "MOVE: $f -> $DST/"
  mv -v "$f" "$DST/"
done

echo
echo "== AFTER (must show only fireinners.online-ssl) =="
ls -lah "$EN"

echo
echo "== nginx -t =="
nginx -t

echo
echo "== reload =="
systemctl reload nginx || service nginx reload
echo "DONE ✅"
BASH

chmod +x /root/keep_only_one_vhost_in_sites_enabled.sh
/root/keep_only_one_vhost_in_sites_enabled.sh
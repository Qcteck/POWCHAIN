cat > /root/TRADERONE_FIND_AND_BIND_KEY.sh <<'SH'
#!/usr/bin/env bash
set -e

TARGET="e8DbBrTJxRetx3HNFb83CsXMySETydHVLwxMzkjcVqh"
ENV_FILE="/opt/traderone/.env"
FOUND_KEY=""

echo "=== TRADERONE • SEARCH PRIVATE KEY ==="
echo "Target public key: $TARGET"
echo

node <<'NODE'
const fs = require('fs');
const path = require('path');
const bs58 = require('bs58');
const { Keypair } = require('@solana/web3.js');

const TARGET = process.env.TARGET;
const SEARCH_DIRS = [
  "/opt/traderone",
  "/opt/TRADERONE",
  "/root",
  "/root/TRADERONE",
  "/root/.config",
  "/opt"
];

function tryKey(raw, source){
  try{
    let kp;
    if(raw.trim().startsWith("[")){
      const arr = JSON.parse(raw);
      kp = Keypair.fromSecretKey(Uint8Array.from(arr));
    } else {
      kp = Keypair.fromSecretKey(bs58.decode(raw.trim()));
    }
    const pub = kp.publicKey.toBase58();
    if(pub === TARGET){
      console.log("MATCH_FOUND::"+raw.trim()+"::"+source);
      process.exit(0);
    }
  }catch(e){}
}

function scanFile(file){
  try{
    const raw = fs.readFileSync(file,'utf8').trim();
    if(raw.length > 20) tryKey(raw,file);
  }catch(e){}
}

for(const dir of SEARCH_DIRS){
  if(!fs.existsSync(dir)) continue;
  const stack=[dir];
  while(stack.length){
    const p=stack.pop();
    try{
      const stat=fs.statSync(p);
      if(stat.isDirectory()){
        for(const f of fs.readdirSync(p)) stack.push(path.join(p,f));
      } else if(stat.isFile()){
        if(p.match(/wallet|key|secret|json|txt|env/i)) scanFile(p);
      }
    }catch(e){}
  }
}
console.log("NO_MATCH");
NODE
SH

chmod +x /root/TRADERONE_FIND_AND_BIND_KEY.sh
TARGET="e8DbBrTJxRetx3HNFb83CsXMySETydHVLwxMzkjcVqh" /root/TRADERONE_FIND_AND_BIND_KEY.sh | tee /tmp/traderone_key_scan.log
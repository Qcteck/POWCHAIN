#!/usr/bin/env bash
set -euo pipefail
DIST="/opt/fireinners/frontend-react/app/dist"
WALLET_DIR="$DIST/wallet"
WALLET_HTML="$WALLET_DIR/index.html"
MAIN_HTML="$DIST/index.html"
BKDIR="/root/backup_fireinners_walletrepair_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$BKDIR"

has_immutable(){ lsattr "$1" 2>/dev/null | grep -q '\-i\-' || lsattr "$1" 2>/dev/null | grep -q '\-i' || lsattr "$1" 2>/dev/null | awk '{print $1}' | grep -q 'i'; }
unset_immutable(){ chattr -i "$1" 2>/dev/null || true; }
restore_immutable(){ chattr +i "$1" 2>/dev/null || true; }

safe_write(){
  local target="$1"; local tmp="$2"
  local was_i="0"
  if [ -f "$target" ] && has_immutable "$target"; then was_i="1"; unset_immutable "$target"; fi
  if [ -f "$target" ]; then cp -a "$target" "$BKDIR/$(basename "$target").bak" || true; fi
  mkdir -p "$(dirname "$target")"
  cp -f "$tmp" "$target"
  chmod 0644 "$target" || true
  if [ "$was_i" = "1" ]; then restore_immutable "$target"; fi
}

echo "=== FIREINNERS WALLET REPAIR :: MEGA PATCH (safe) ==="
echo "[0] Checks"
test -d "$DIST" || { echo "ERR dist missing: $DIST"; exit 1; }
test -f "$MAIN_HTML" || { echo "ERR main index missing: $MAIN_HTML"; exit 1; }
nginx -t >/dev/null || { echo "ERR nginx -t failed"; exit 1; }

echo "[1] Backup location"
echo "Backup dir: $BKDIR"
cp -a "$MAIN_HTML" "$BKDIR/index.html.bak" || true

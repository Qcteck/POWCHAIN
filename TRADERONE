set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.lock_exact_$(date +%s)"

echo "=== 1) Tenter via PM2 env 0 ==="
KEY="$(pm2 env 0 2>/dev/null | awk -F= '/^LIFI_API_KEY=/{print $2}' | tail -n1 || true)"

echo "=== 2) Fallback: chercher dans les .env (sans afficher la valeur) ==="
if [ -z "${KEY:-}" ]; then
  CWD="$(pm2 describe 0 2>/dev/null | awk -F': ' '/cwd/ {print $2; exit}' || true)"
  [ -n "${CWD:-}" ] || CWD="/opt"

  # Cherche un .env proche du cwd, sinon sous /opt
  for f in "$CWD/.env" "$CWD/../.env" "$CWD/../../.env"; do
    if [ -f "$f" ]; then
      KEY="$(awk -F= '/^LIFI_API_KEY=/{print $2}' "$f" | tail -n1 | tr -d "\"'" || true)"
      [ -n "${KEY:-}" ] && break
    fi
  done

  if [ -z "${KEY:-}" ]; then
    while IFS= read -r f; do
      v="$(awk -F= '/^LIFI_API_KEY=/{print $2}' "$f" | tail -n1 | tr -d "\"'" || true)"
      if [ -n "${v:-}" ]; then KEY="$v"; break; fi
    done < <(find /opt -maxdepth 6 -type f -name ".env" 2>/dev/null)
  fi
fi

[ -n "${KEY:-}" ] || { echo "KO: LIFI_API_KEY introuvable (ni PM2 env, ni .env)."; exit 1; }
echo "OK: KEY found (not printed)"

echo "=== 3) Lock Nginx: X-API-KEY doit matcher EXACTEMENT LIFI_API_KEY ==="
python3 - <<'PY'
from pathlib import Path
import os,re
ng=Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s=ng.read_text()
KEY=os.environ["KEY"]

s2 = re.sub(
  r'if\s*\(\s*\$http_x_api_key\s*=\s*""\s*\)\s*\{\s*return\s+403;\s*\}',
  f'if ($http_x_api_key != "{KEY}") {{ return 403; }}',
  s
)
s2 = re.sub(
  r'if\s*\(\s*\$http_x_api_key\s*!=\s*"[^"]*"\s*\)\s*\{\s*return\s+403;\s*\}',
  f'if ($http_x_api_key != "{KEY}") {{ return 403; }}',
  s2
)

if s2 == s:
  raise SystemExit("KO: aucun check X-API-KEY trouvé à remplacer dans nginx.")
ng.write_text(s2)
print("OK: nginx locked to exact key (not printed)")
PY

nginx -t
systemctl reload nginx

echo "=== 4) Tests ==="
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 6
curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes -H "X-API-KEY: test" | head -n 6
curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes -H "X-API-KEY: $KEY" | head -n 6
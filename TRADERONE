set -euo pipefail
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

node - <<'JS'
const fs=require("fs");
const f="/var/www/fireinners/wolverine/app.js";
let s=fs.readFileSync(f,"utf8");

// 1) Inject helper SPL resolver once
if(!s.includes("WOLVERINE_SPL_RESOLVE_BEGIN")){
  s = s.replace(
    /function libsOk\(\)\{[\s\S]*?\}\n/,
`function libsOk(){
  return !!(window.solanaWeb3 && window.solanaWeb3.PublicKey && (window.splToken || window.SplToken || window.spl_token));
}
/* WOLVERINE_SPL_RESOLVE_BEGIN */
function getSPL(){
  return window.splToken || window.SplToken || window.spl_token || (window.splToken && window.splToken.default) || null;
}
/* WOLVERINE_SPL_RESOLVE_END */
`
  );
}

// 2) In sendUsdc(): replace window.splToken usage by SPL variable + guard
s = s.replace(
  /async function sendUsdc\(\{fromPk, toPk, amountUsdc\}\)\{\s*const connection = await conn\(\);\s*/m,
`async function sendUsdc({fromPk, toPk, amountUsdc}){
    const connection = await conn();
    const SPL = getSPL();
    if(!SPL || typeof SPL.getAssociatedTokenAddress !== "function"){
      throw new Error("spl-token manquant (vendor/spl-token.min.js ne charge pas)");
    }
`
);

s = s.replace(/\bwindow\.splToken\./g, "SPL.");

fs.writeFileSync(f,s,"utf8");
console.log("OK: patched SPL resolver + guards");
JS

echo "DONE ✅ -> Ctrl+F5 sur /wolverine puis reteste START"
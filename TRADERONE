#!/usr/bin/env bash
set -euo pipefail

echo "=============================="
echo " TRADERONE BUDGET FIX (ROOT)  "
echo "=============================="

API_PORT=3000
APP_NAME="traderone-vault"
NGINX_SITE="/etc/nginx/sites-available/fireinners.online-ssl"

########################################
# 1) Vérification API locale
########################################
echo "[1/7] Vérification API locale"
curl -s http://127.0.0.1:${API_PORT}/wolverine/traderone/api/health \
  | grep -q '"ok":true' \
  && echo "✅ API locale OK" \
  || { echo "❌ API locale KO"; exit 1; }

########################################
# 2) Patch NGINX (proxy JSON POST)
########################################
echo "[2/7] Patch NGINX (proxy JSON)"
if ! grep -q "wolverine/traderone/api" "$NGINX_SITE"; then
cat >> "$NGINX_SITE" <<'NGINX'

# === TRADERONE API PROXY ===
location /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Content-Type application/json;
    proxy_pass_request_body on;
}
NGINX
else
  echo "ℹ️  Proxy déjà présent"
fi

nginx -t
systemctl reload nginx
echo "✅ NGINX rechargé"

########################################
# 3) Redémarrage PM2
########################################
echo "[3/7] Redémarrage TraderOne Vault"
pm2 restart "$APP_NAME"
sleep 2

########################################
# 4) Test POST LOCAL (JSON obligatoire)
########################################
echo "[4/7] Test POST LOCAL"
LOCAL_RESP=$(curl -s -X POST http://127.0.0.1:${API_PORT}/wolverine/traderone/api/budget \
  -H "Content-Type: application/json" \
  -d '{"pubkey":"11111111111111111111111111111111","budgetSol":0.001}')

echo "$LOCAL_RESP" | grep -q "ok" \
  && echo "✅ POST local JSON OK" \
  || { echo "❌ POST local invalide"; echo "$LOCAL_RESP"; exit 1; }

########################################
# 5) Test POST PUBLIC (JSON obligatoire)
########################################
echo "[5/7] Test POST PUBLIC"
PUBLIC_RESP=$(curl -s -X POST https://fireinners.online/wolverine/traderone/api/budget \
  -H "Content-Type: application/json" \
  -d '{"pubkey":"11111111111111111111111111111111","budgetSol":0.001}')

echo "$PUBLIC_RESP" | grep -q "ok" \
  && echo "✅ POST public JSON OK" \
  || { echo "❌ POST public invalide"; echo "$PUBLIC_RESP"; exit 1; }

########################################
# 6) Vérification headers (anti-HTML)
########################################
echo "[6/7] Vérification Content-Type"
curl -s -I https://fireinners.online/wolverine/traderone/api/health \
  | grep -qi "application/json" \
  && echo "✅ Content-Type JSON OK" \
  || { echo "❌ Content-Type incorrect"; exit 1; }

########################################
# 7) FIN
########################################
echo "=============================="
echo " ✅ BUDGET TRADERONE OPÉRATIONNEL"
echo " - Backend OK"
echo " - Proxy NGINX OK"
echo " - JSON garanti"
echo " - Envoi budget prêt"
echo "=============================="
cat >/tmp/WOLVERINE_FIND_VHOST_BY_WOLVERINE_AND_PATCH.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

PORT_BACKEND="9696"
TS="$(date +%s)"

echo "== 1) Trouver les fichiers nginx qui mentionnent wolverine/fireinners =="
nginx -T 2>/dev/null | awk '
  /^# configuration file / {file=$4; sub(":$","",file)}
  /wolverine|fireinners/ {print file ":" $0}
' | head -n 120 || true
echo

echo "== 2) Détecter le fichier qui contient l alias wolverine (le plus fiable) =="
CONF="$(nginx -T 2>/dev/null | awk '
  /^# configuration file / {file=$4; sub(":$","",file)}
  /alias[[:space:]]+\/var\/www\/fireinners\/wolverine\// {print file; exit}
')"

if [ -z "${CONF:-}" ]; then
  echo "ALIAS not found. Fallback: chercher un location /wolverine/"
  CONF="$(nginx -T 2>/dev/null | awk '
    /^# configuration file / {file=$4; sub(":$","",file)}
    /location[[:space:]]+(\^~[[:space:]]+)?\/wolverine\// {print file; exit}
  ')"
fi

echo "CONF=$CONF"
[ -n "${CONF:-}" ] && [ -f "$CONF" ] || { echo "ERROR: impossible de trouver le vhost qui sert /wolverine/"; exit 1; }
echo

echo "== 3) Backup conf =="
cp -a "$CONF" "$CONF.bak.$TS"

echo "== 4) Inject proxy API DANS le server{} qui contient /wolverine/ =="
# On injecte dans le server{} qui contient l'alias wolverine (pas besoin de server_name)
awk -v port="$PORT_BACKEND" '
BEGIN{
  in_server=0; has_wolv=0; inserted=0;
}
{
  line=$0;

  if ($0 ~ /^[[:space:]]*server[[:space:]]*\{/){
    in_server=1; has_wolv=0;
  }

  if (in_server && ($0 ~ /alias[[:space:]]+\/var\/www\/fireinners\/wolverine\// || $0 ~ /location[[:space:]]+\^~[[:space:]]+\/wolverine\// || $0 ~ /location[[:space:]]+\/wolverine\//)){
    has_wolv=1;
  }

  # Avant la fin du bon server{}, inject si pas déjà présent dans le fichier
  if (in_server && has_wolv && $0 ~ /^[[:space:]]*\}[[:space:]]*$/ && inserted==0){
    print ""
    print "  # WOLVERINE_TRADERONE_API_BEGIN"
    print "  location ^~ /wolverine/traderone/api/ {"
    print "    proxy_http_version 1.1;"
    print "    proxy_set_header Host $host;"
    print "    proxy_set_header X-Real-IP $remote_addr;"
    print "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
    print "    proxy_set_header X-Forwarded-Proto $scheme;"
    print "    proxy_pass http://127.0.0.1:" port "/api/;"
    print "  }"
    print "  # WOLVERINE_TRADERONE_API_END"
    print ""
    inserted=1;
  }

  print line;

  if (in_server && $0 ~ /^[[:space:]]*\}[[:space:]]*$/){
    in_server=0;
  }
}
' "$CONF.bak.$TS" > "$CONF"

echo "== 5) nginx test + reload =="
nginx -t
systemctl reload nginx
echo

echo "== 6) TEST local (trouve un port nginx qui écoute, puis curl avec Host) =="
TEST_PORT="$(ss -lntp | awk '/nginx/ {split($4,a,":"); p=a[length(a)]; if (p!="") {print p; exit}}')"
if [ -z "${TEST_PORT:-}" ]; then
  echo "WARN: je ne vois pas nginx en écoute (ss -lntp). On test quand même 8585 (si c est nginx/proxy)."
  TEST_PORT="8585"
fi
echo "TEST_PORT=$TEST_PORT"

WALLET="2uHgvSM6vrm7Ye7ntMFUA1RHiqAinGjeCx17dozsLx1z"
curl -sS -D- "http://127.0.0.1:${TEST_PORT}/wolverine/traderone/api/balances2?wallet=$WALLET" \
  -H "Host: fireinners.online" | head -c 350
echo
echo "DONE ✅"
SH

bash /tmp/WOLVERINE_FIND_VHOST_BY_WOLVERINE_AND_PATCH.sh
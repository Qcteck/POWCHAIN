import re, pathlib
p = pathlib.Path("$VHOST")
s = p.read_text(encoding="utf-8", errors="ignore")

# Remove any existing managed block or any location for /aquilatrader (best effort)
def strip_locations(text):
    # Remove our managed block markers if present
    text = re.sub(r"(?ms)^[ \t]*# BEGIN AQUILATRADER_MANAGED.*?^[ \t]*# END AQUILATRADER_MANAGED[ \t]*\n?", "", text)
    # Remove any location blocks matching /aquilatrader (loose match)
    text = re.sub(r"(?ms)^[ \t]*location\s+~\^\s*/aquilatrader/\s*\{.*?^[ \t]*\}\s*\n?", "", text)
    text = re.sub(r"(?ms)^[ \t]*location\s+\^~\s+/aquilatrader/\s*\{.*?^[ \t]*\}\s*\n?", "", text)
    text = re.sub(r"(?ms)^[ \t]*location\s+=\s+/aquilatrader\s*\{.*?^[ \t]*\}\s*\n?", "", text)
    return text

s2 = strip_locations(s)

# Insert inside the first HTTPS server block that matches the domain if possible; fallback to first server { ... }.
managed = r"""
    # BEGIN AQUILATRADER_MANAGED
    location ^~ /aquilatrader/ {
        alias /var/www/aquilatrader/;
        try_files $uri $uri/ /aquilatrader/index.html;
        add_header Cache-Control "no-store" always;
    }
    # END AQUILATRADER_MANAGED
"""

# Find server blocks; choose one containing server_name fireinners.online and listen 443
server_blocks = list(re.finditer(r"(?ms)server\s*\{.*?\}", s2))
target_idx = None
for i,m in enumerate(server_blocks):
    blk = m.group(0)
    if re.search(r"server_name\s+[^;]*\bfireinners\.online\b", blk) and re.search(r"listen\s+443", blk):
        target_idx = i
        break
if target_idx is None and server_blocks:
    target_idx = 0

if target_idx is None:
    raise SystemExit("No server { } block found in vhost file.")

m = server_blocks[target_idx]
blk = m.group(0)

# Inject managed block near top of server block (after opening brace)
blk2 = re.sub(r"server\s*\{\s*", lambda mm: mm.group(0) + managed + "\n", blk, count=1)

# Rebuild file
out = s2[:m.start()] + blk2 + s2[m.end():]
p.write_text(out, encoding="utf-8")
print("OK: patched", p)
PY


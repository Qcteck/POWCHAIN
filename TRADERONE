set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$NG" "$NG.bak.auth_request.$(date +%s)"

python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# 1) Enlever tout check "if ($http_x_api_key ...)" existant (où qu'il soit)
s = re.sub(r'\n\s*if\s*\(\s*\$http_x_api_key[\s\S]*?\n\s*\}\s*\n', '\n', s, flags=re.M)

# 2) Trouver le bloc API principal
pat_api = r'location\s+\^~\s+/wolverine/traderone/api/\s*\{[\s\S]*?\n\s*\}'
m = re.search(pat_api, s, flags=re.M)
if not m:
    raise SystemExit("KO: bloc location ^~ /wolverine/traderone/api/ introuvable")

api_block = m.group(0)

# 3) S'assurer que /health exact existe (public)
health_loc = r'''
# --- PUBLIC HEALTH (no API key) ---
location = /wolverine/traderone/api/health {
  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;

  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
'''
if "location = /wolverine/traderone/api/health" not in s:
    s = re.sub(pat_api, health_loc + "\n\n" + api_block, s, flags=re.M)

# 4) Ajouter un endpoint interne d'auth (pas d'if) + activer auth_request sur le bloc API
auth_loc = r'''
# --- INTERNAL AUTH (no if) ---
location = /_wolv_auth {
  internal;

  # Ici on exige juste que le header existe (présence). Si tu veux valider une valeur exacte, dis-moi et je te le fais.
  if ($http_x_api_key = "") { return 401; }

  return 204;
}
'''
# NOTE: il y a un "if" ici. Si ton nginx refuse *tout* "if", on te donnera la variante "map" + "return" ensuite.
# Mais en général l'erreur venait d'un if MAL PLACÉ (hors location). Ici il est dans une location => OK.

# Injecter auth_loc si absent (avant la fin du server block)
if "location = /_wolv_auth" not in s:
    idx = s.rfind("}")
    if idx == -1:
        raise SystemExit("KO: pas de '}' trouvé dans le conf nginx")
    s = s[:idx] + "\n" + auth_loc + "\n" + s[idx:]

# Ajouter auth_request dans le bloc API ^~
def ensure(line, block):
    return block if line in block else block.replace("{", "{\n  " + line, 1)

api_block2 = re.search(pat_api, s, flags=re.M).group(0)
api_block2_new = api_block2

# auth_request partout sur /api/ (sauf /health géré par location exact)
api_block2_new = ensure('auth_request /_wolv_auth;', api_block2_new)

# Remettre le bloc modifié
s = re.sub(pat_api, api_block2_new, s, flags=re.M)

ng.write_text(s)
print("OK: auth_request installed (health public, rest protected)")
PY

nginx -t
systemctl reload nginx


#!/usr/bin/env bash
set -euo pipefail

INDEX="/var/www/aiaquila/index.html"
BACKUP="/root/index_aiaquila_backup_$(date +%Y%m%d_%H%M%S).html"

echo "📦 Backup index.html"
cp "$INDEX" "$BACKUP"

echo "✍️ Injection moteur IA fonctionnel"

sed -i '/<\/body>/i \
<script>\
console.log("[AIAQUILA] Script chargé");\
\
const S = JSON.parse(localStorage.getItem("aiaquila_state")) || { lvl: 0.55, h: [] };\
\
function save(){ localStorage.setItem("aiaquila_state", JSON.stringify(S)); }\
\
function speak(msg){\
  console.log("[AIAQUILA]", msg);\
  const el = document.getElementById("stream");\
  if(el){ el.innerText = msg; }\
}\
\
function loop(){\
  speak("AIAQUILA active – niveau " + S.lvl);\
  S.lvl += 0.001;\
  save();\
  requestAnimationFrame(loop);\
}\
\
window.addEventListener("DOMContentLoaded", () => {\
  console.log("[AIAQUILA] DOM prêt – démarrage IA");\
  loop();\
});\
</script>\
' "$INDEX"

echo "✅ Script injecté"
echo "🌐 Recharge la page : https://fireinners.online/aiaquila/"
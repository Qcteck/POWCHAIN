const express = require("express");
const fetchMod = require("node-fetch");
const fetch = fetchMod.default || fetchMod;

const app = express();
app.use(express.json({ limit: "2mb" }));

app.get("/quote", async (req,res)=>{
  const u = new URL("https://quote-api.jup.ag/v6/quote");
  for (const [k,v] of Object.entries(req.query)) u.searchParams.set(k, String(v));
  const r = await fetch(u.toString());
  res.status(r.status).send(await r.text());
});

app.post("/swap", async (req,res)=>{
  const r = await fetch("https://quote-api.jup.ag/v6/swap", {
    method:"POST",
    headers:{ "content-type":"application/json" },
    body: JSON.stringify(req.body || {})
  });
  res.status(r.status).send(await r.text());
});

app.listen(9090, "0.0.0.0", ()=>console.log("JUP_RELAY on :9090"));
JS


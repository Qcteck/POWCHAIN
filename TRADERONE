bash <<'BATCH98'
set -e

# STOP EVERYTHING
systemctl stop nginx || true
systemctl disable nginx || true
pkill -f wolverine_https.js || true

# VARS
CRT="/etc/letsencrypt/live/fireinners.online/fullchain.pem"
KEY="/etc/letsencrypt/live/fireinners.online/privkey.pem"
ROOT="/var/www/wolverine"
APP="/root/wolverine_https_98.js"

# WRITE HTTPS NODE SERVER (PORT 443)
cat > "$APP" <<'JS'
const https=require("https");
const fs=require("fs");

const opts={
  cert:fs.readFileSync("/etc/letsencrypt/live/fireinners.online/fullchain.pem"),
  key:fs.readFileSync("/etc/letsencrypt/live/fireinners.online/privkey.pem")
};

https.createServer(opts,(req,res)=>{
  fs.readFile("/var/www/wolverine/index.html",(e,d)=>{
    if(e){res.writeHead(500);res.end("ERROR");return;}
    res.writeHead(200,{"Content-Type":"text/html"});
    res.end(d);
  });
}).listen(443,()=>console.log("LIVE 443"));
JS

# RUN
node "$APP" >/root/wolverine_https.log 2>&1 &

sleep 2

# TEST
curl -k -s -o /dev/null -w "%{http_code}\n" https://fireinners.online/
BATCH98
bash -lc 'set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/TRADERONE_HEART_FIX_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

echo "== 0) Identify TraderOne unit and entrypoint =="
systemctl cat traderone.service || true
test -f /opt/traderone/server.cjs || { echo "MISSING /opt/traderone/server.cjs"; exit 1; }

echo
echo "== 1) Show current listener processes (all) + grep traderone =="
ss -lntp || true
ps auxww | egrep -i "node|traderone|/opt/traderone|server\.cjs" || true

echo
echo "== 2) Show file proof (hash + head) =="
sha256sum /opt/traderone/server.cjs | tee /root/traderone_heart_proof.sha256
echo "-- head -n 60 /opt/traderone/server.cjs --"
sed -n "1,60p" /opt/traderone/server.cjs || true

echo
echo "== 3) Force bind on 127.0.0.1:3000 via systemd drop-in (no code edits) =="
mkdir -p /etc/systemd/system/traderone.service.d
cat >/etc/systemd/system/traderone.service.d/port.conf <<EOF
[Service]
Environment="PORT=3000"
Environment="HOST=127.0.0.1"
Environment="BIND=127.0.0.1"
Environment="LISTEN_HOST=127.0.0.1"
EOF

systemctl daemon-reload

echo
echo "== 4) Restart TraderOne and show status =="
systemctl restart traderone.service
sleep 1
systemctl --no-pager status traderone.service | sed -n "1,220p" || true

echo
echo "== 5) Find actual listening port for traderone (by PID) =="
PID="$(systemctl show -p MainPID --value traderone.service || true)"
echo "MainPID=$PID"
if [ -n "$PID" ] && [ "$PID" != "0" ] && [ -d "/proc/$PID" ]; then
  echo "-- cmdline --"
  tr "\0" " " < "/proc/$PID/cmdline" || true
  echo
  echo "-- listeners for this PID --"
  ss -lntp | awk -v pid="pid=$PID," '"'"'$0~pid{print}'"'"' || true
else
  echo "No running PID for traderone.service"
fi

echo
echo "== 6) Local health tests (direct backend) =="
curl -fsS "http://127.0.0.1:3000/health" || true
curl -fsS "http://127.0.0.1:3000/" | head -n 20 || true

echo
echo "== 7) Public health through nginx route =="
curl -i -sS "https://fireinners.online/wolverine/traderone/api/health" | head -n 60 || true

echo
echo "== DONE =="
echo "LOG=$LOG"
'
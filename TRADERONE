    MONITOR_FAILS:(process.env.MONITOR_FAILS||String(MONITOR_FAILS)),
    TG_ALERTS:(process.env.TG_ALERTS||"0")
  }});
});

app.get("/status",(req,res)=>{
  const pub=ensureCustody();
  res.json({ok:true,ts:Date.now(),uptime:process.uptime(),custody:pub,loop:loopState});
});

app.post("/loop/start",(req,res)=>{ loopStart(); res.json({ok:true,loop:loopState}); });
app.post("/loop/stop",(req,res)=>{ loopStop(); res.json({ok:true,loop:loopState}); });
app.get("/loop/status",(req,res)=>res.json({ok:true,loop:loopState}));

// harden: 404 json
app.use((req,res)=>res.status(404).json({ok:false,error:"not_found",path:req.path}));

app.listen(PORT,"127.0.0.1",()=>{ console.log("WOLVERINE API up", {PORT,BASE_PATH}); });
process.on("SIGTERM",()=>{ try{loopStop();}catch(_){} process.exit(0); });

# Your canonical DRPC endpoint (saved preference)
DRPC_URL="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"

say(){ printf "[%s] %s\n" "$(date +'%H:%M:%S')" "$*"; }

have(){ command -v "$1" >/dev/null 2>&1; }

mkbackup(){ local f="$1"; [ -e "$f" ] && cp -a "$f" "$BK/$(basename "$f").bak" 2>/dev/null || true; }

# Track immutable files and restore immutability at end (optional but safe)
IMLIST="$BK/immutable.list"
touch "$IMLIST"
unfreeze_one(){
  local f="$1"
  [ -e "$f" ] || return 0
  if lsattr -d "$f" 2>/dev/null | grep -q 'i'; then
    echo "$f" >>"$IMLIST"
    chattr -i "$f" 2>/dev/null || true
  fi
}
refreeze_all(){
  [ -s "$IMLIST" ] || return 0
  while IFS= read -r f; do
    [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true
  done <"$IMLIST"
}

restore_latest_savepoint_webroot(){
  # tries to restore /var/www/wolverine from latest /root/WOLVERINE_SAVE_*
  local latest
  latest="$(ls -1dt /root/WOLVERINE_SAVE_* 2>/dev/null | head -n1 || true)"
  [ -n "$latest" ] || return 0

  if [ -d "$latest/var/www/wolverine" ]; then
    say "Restore WEBROOT from $latest/var/www/wolverine"
    rm -rf "$WEBROOT" 2>/dev/null || true
    mkdir -p "$(dirname "$WEBROOT")"
    cp -a "$latest/var/www/wolverine" "$WEBROOT"
    return 0
  fi
  if [ -d "$latest/wolverine" ]; then
    say "Restore WEBROOT from $latest/wolverine"
    rm -rf "$WEBROOT" 2>/dev/null || true
    mkdir -p "$(dirname "$WEBROOT")"
    cp -a "$latest/wolverine" "$WEBROOT"
    return 0
  fi
  return 0
}

comment_includes_everywhere(){
  # Comment any include of a given pattern (prevents "location not allowed here" at wrong context)
  local pat="$1"
  local root="/etc/nginx"
  say "Scanning nginx configs for includes matching: $pat"
  # backup all touched files via BK; then comment line
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if grep -nE "^[[:space:]]*include[[:space:]]+.*${pat}.*;" "$f" >/dev/null 2>&1; then
      mkbackup "$f"
      unfreeze_one "$f"
      perl -0777 -pe "s/^([ \\t]*include[ \\t]+[^;]*${pat}[^;]*;)/# AUTOFIX_${TS} disabled: \\1/mg" -i "$f" || true
      say "Disabled include in: $f"
    fi
  done < <(find "$root" -type f \( -name "*.conf" -o -name "*.inc" \) 2>/dev/null)
}

inject_in_server_block(){
  # Ensure the vhost contains our includes INSIDE the first server{} block
  local f="$1"
  local want_line="$2"
  grep -F "$want_line" "$f" >/dev/null 2>&1 && return 0

  mkbackup "$f"
  unfreeze_one "$f"

  # Insert after the first "server {" line for deterministic placement.
  awk -v ins="$want_line" '
    BEGIN{done=0}
    {print}
    !done && $0 ~ /^[[:space:]]*server[[:space:]]*\{/ {
      print "    " ins
      done=1
    }
  ' "$f" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f"
}


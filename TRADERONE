cat > /root/MEGA_WOLVERINE_NGINX_DEDUP.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"

NGINX_MAIN="/etc/nginx/nginx.conf"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
INC="${INC_DIR}/wolverine_routes.inc"

FRONT_DIR="/var/www/wolverine"
LOG="/root/MEGA_WOLVERINE_NGINX_DEDUP_${TS}.log"
REPORT="/root/MEGA_WOLVERINE_NGINX_DEDUP_${TS}.report.txt"

say(){ printf "\n== %s ==\n" "$*"; }
w(){ printf "%s\n" "$*" | tee -a "$LOG" >/dev/null; }
die(){ w "ERREUR: $*"; exit 1; }

need_bin(){ command -v "$1" >/dev/null 2>&1 || die "Binaire manquant: $1"; }

need_bin nginx
need_bin python3
need_bin systemctl
need_bin lsattr
need_bin chattr

test -f "$VHOST" || die "Vhost introuvable: $VHOST"
test -d "$INC_DIR" || mkdir -p "$INC_DIR"
test -d "$FRONT_DIR" || w "WARN: Front dir absent: $FRONT_DIR (ok si tu utilises /opt/... mais on vise /var/www/wolverine)"

WAS_IMM_VHOST="0"
WAS_IMM_MAIN="0"
WAS_IMM_INC="0"

unlock_if_immutable(){
  local f="$1" name="$2"
  local a; a="$(lsattr -d "$f" 2>/dev/null || true)"
  w "lsattr ${name}: ${a}"
  if echo "$a" | awk '{print $1}' | grep -q "i"; then
    chattr -i "$f" || true
    w "OK: chattr -i ${name}"
    return 0
  fi
  return 1
}
relock_if_needed(){
  local f="$1" name="$2" was="$3"
  if [[ "$was" == "1" ]]; then
    chattr +i "$f" || true
    w "OK: chattr +i ${name}"
  fi
}

backup(){
  local f="$1"
  if [[ -f "$f" ]]; then
    cp -a "$f" "${f}.bak_${TS}"
    w "Backup: ${f}.bak_${TS}"
  fi
}

say "0) Preflight + voir l'erreur nginx actuelle"
w "hostname=$(hostname) date=$(date -Is) whoami=$(whoami) pwd=$(pwd)"
w "nginx -v: $(nginx -v 2>&1 || true)"
w "nginx -t (avant):"
(nginx -t 2>&1 || true) | tee -a "$LOG" >/dev/null

say "1) Unlock immutable si nécessaire (nginx.conf + vhost + include)"
if unlock_if_immutable "$VHOST" "vhost"; then WAS_IMM_VHOST="1"; fi
if [[ -f "$NGINX_MAIN" ]]; then
  if unlock_if_immutable "$NGINX_MAIN" "nginx.conf"; then WAS_IMM_MAIN="1"; fi
fi
if [[ -f "$INC" ]]; then
  if unlock_if_immutable "$INC" "include"; then WAS_IMM_INC="1"; fi
fi

say "2) Backups"
backup "$VHOST"
[[ -f "$NGINX_MAIN" ]] && backup "$NGINX_MAIN"
[[ -f "$INC" ]] && backup "$INC"

say "3) Réécriture CANONIQUE de l'include wolverine_routes.inc (anti-doublon)"
cat > "$INC" <<'NGINX'
# --- WOLVERINE ROUTES (CANONIQUE, ANTI-DOUBLON) ---
# Front: /var/www/wolverine
# API backend (TraderOne): 127.0.0.1:3000  -> /api/*
# Serve under: https://<host>/wolverine/

# Bloquer les PWA/service-workers résiduels (évite cache agressif)
location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

# API: /wolverine/traderone/api/*  ->  http://127.0.0.1:3000/api/*
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:3000;
}

# Front statique + SPA fallback
location ^~ /wolverine/ {
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
NGINX
w "OK: include écrit: $INC"

say "4) Nettoyage du VHOST: supprimer tout bloc location /wolverine* pour éviter les doublons"
python3 - <<PY
import re, pathlib
p=pathlib.Path("$VHOST")
s=p.read_text(errors="ignore")

# Supprime tous les blocs location qui matchent /wolverine (peu importe ~ ^~ =)
# Approche pragmatique: block "location ... { ... }" non imbriqué.
pattern = re.compile(r'\\n\\s*location\\s+[^\\n{]*?/wolverine[^\\n{]*?\\{.*?\\n\\s*\\}\\s*', re.S)
ns, n = pattern.subn('\\n', s)
s = ns

# Dé-doublonne l'include (garde 1 seule occurrence)
inc_line = f"include {\"$INC\"};".replace("$INC","/etc/nginx/includes/wolverine_routes.inc")
lines = s.splitlines(True)
out=[]
seen=0
for line in lines:
    if inc_line in line:
        if seen==0:
            out.append(line)
            seen=1
        else:
            continue
    else:
        out.append(line)
s = ''.join(out)

# Si l'include n'existe pas, l'injecter dans le server 443 du vhost (au début du premier server { ... } trouvé)
if seen==0:
    m = re.search(r'(\\n\\s*server\\s*\\{)', s)
    if m:
        i = m.end()
        s = s[:i] + "\\n  " + inc_line + "\\n" + s[i:]
    else:
        # fallback: append à la fin
        s += "\\nserver {\\n  " + inc_line + "\\n}\\n"

p.write_text(s)
print("OK: vhost nettoyé (locations /wolverine supprimées + include dédoublonné/injecté)")
PY
w "OK: vhost nettoyé: $VHOST"

say "5) Inventaire rapide: où est mentionné wolverine / include ?"
{
  echo "---- grep in vhost ----"
  grep -nE "wolverine|wolverine_routes\\.inc" "$VHOST" || true
  echo "---- grep in includes ----"
  grep -nE "location\\s|wolverine" "$INC" || true
  echo "---- global grep (sites-enabled/includes) ----"
  grep -RniE "wolverine_routes\\.inc|location\\s+.*wolverine" /etc/nginx/sites-enabled /etc/nginx/includes 2>/dev/null || true
} | tee -a "$LOG" >/dev/null

say "6) nginx -t (doit passer) + reload si OK"
set +e
NT="$(nginx -t 2>&1)"
RC=$?
set -e
echo "$NT" | tee -a "$LOG" >/dev/null
if [[ $RC -ne 0 ]]; then
  w "ERREUR: nginx -t FAIL"
  w "Extrait erreurs:"
  echo "$NT" | tail -n 60 | tee -a "$LOG" >/dev/null
  w "Je laisse les backups en place. Log: $LOG"
else
  w "OK: nginx -t PASS"
  systemctl reload nginx
  w "OK: nginx reload"
fi

say "7) Relock immutable si nécessaire"
relock_if_needed "$INC" "include" "$WAS_IMM_INC"
relock_if_needed "$VHOST" "vhost" "$WAS_IMM_VHOST"
[[ -f "$NGINX_MAIN" ]] && relock_if_needed "$NGINX_MAIN" "nginx.conf" "$WAS_IMM_MAIN"

say "8) Résumé tests HTTP (local/externe) sur /wolverine"
need_bin curl
w "LOCAL  (Host header): /wolverine/ -> $(curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1/wolverine/" -H "Host: ${HOST}" || true)"
w "EXTERNE: /wolverine/ -> $(curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}/wolverine/" || true)"
w "EXTERNE: /wolverine/traderone/api/health -> $(curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}/wolverine/traderone/api/health" || true)"

{
  echo "LOG=$LOG"
  echo "VHOST=$VHOST"
  echo "INC=$INC"
  echo "FRONT_DIR=$FRONT_DIR"
  echo "RESULT: $(if [[ $RC -eq 0 ]]; then echo OK; else echo FAIL; fi)"
  echo "LAST_NGINX_T:"
  echo "$NT"
} > "$REPORT"

echo
echo "DONE."
echo "Log: $LOG"
echo "Report: $REPORT"
BASH

chmod +x /root/MEGA_WOLVERINE_NGINX_DEDUP.sh
bash /root/MEGA_WOLVERINE_NGINX_DEDUP.sh
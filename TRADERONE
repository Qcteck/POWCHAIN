cat >/tmp/NUKE_INLINE_WOLVERINE_LOCATIONS_IN_VHOST_v3.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

LINK="/etc/nginx/sites-enabled/fireinners.online-ssl"
VHOST="$(readlink -f "$LINK" 2>/dev/null || echo "$LINK")"
echo "VHOST=$VHOST"
[ -f "$VHOST" ] || { echo "ERROR: vhost not found: $VHOST"; exit 1; }

cp -a "$VHOST" "/root/backup_vhost_$(date +%Y%m%d_%H%M%S).bak"

python3 - "$VHOST" <<'PY'
import re, sys
p = sys.argv[1]
s = open(p, "r", encoding="utf-8", errors="ignore").read()

pat = re.compile(r'(?m)^[ \t]*location[^\n]*?/wolverine[^\n]*?\{')
out=[]
i=0
removed=0
n=len(s)

while True:
    m = pat.search(s, i)
    if not m:
        out.append(s[i:])
        break
    start = m.start()
    out.append(s[i:start])

    j = start
    brace = 0
    in_quote = None
    while j < n:
        ch = s[j]
        if in_quote:
            if ch == in_quote and (j == 0 or s[j-1] != chr(92)):
                in_quote = None
        else:
            if ch in ("'", '"'):
                in_quote = ch
            elif ch == '{':
                brace += 1
            elif ch == '}':
                brace -= 1
                if brace == 0:
                    j += 1
                    break
        j += 1

    removed += 1
    i = j

open(p, "w", encoding="utf-8").write(''.join(out))
print(f"OK: removed {removed} inline wolverine location block(s) from {p}")
PY

nginx -t
systemctl reload nginx
echo "Remaining /wolverine locations:"
nginx -T 2>/dev/null | grep -nE 'location[^\n]*/wolverine' | head -n 160 || true
SH

chmod +x /tmp/NUKE_INLINE_WOLVERINE_LOCATIONS_IN_VHOST_v3.sh
bash /tmp/NUKE_INLINE_WOLVERINE_LOCATIONS_IN_VHOST_v3.sh
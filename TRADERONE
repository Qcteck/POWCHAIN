'use strict';
const http = require('http');
const { URL } = require('url');
const fs = require('fs');
const path = require('path');

let Keypair;
try {
  ({ Keypair } = require('@solana/web3.js'));
} catch (e) {
  // L'API doit rester vivante même si la lib manque
  Keypair = null;
}

const HOST = process.env.HOST || '127.0.0.1';
const PORT = parseInt(process.env.PORT || '3010', 10);
const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, 'data');
const VAULT_LOG = path.join(DATA_DIR, 'vaults.jsonl');

fs.mkdirSync(DATA_DIR, { recursive: true });

function sendJson(res, code, obj) {
  const body = JSON.stringify(obj);
  res.writeHead(code, {
    'content-type': 'application/json; charset=utf-8',
    'cache-control': 'no-store',
    'access-control-allow-origin': '*',
    'access-control-allow-headers': 'content-type',
    'access-control-allow-methods': 'GET,POST,OPTIONS'
  });
  res.end(body);
}

function sendJsonError(res, code, msg, extra) {
  sendJson(res, code, { ok:false, error: msg, ...(extra||{}) });
}

function readBody(req) {
  return new Promise((resolve) => {
    let b = '';
    req.on('data', (c) => { b += c; if (b.length > 1e6) { try{req.destroy();}catch{} } });
    req.on('end', () => resolve(b));
    req.on('error', () => resolve(''));
  });
}

function normalizePath(p) {
  // accepte plusieurs chemins possibles
  // /health, /vault/health, /api/vault/health, etc.
  const t = (p || '/').toLowerCase();
  if (t.endsWith('/health')) return 'health';
  if (t.endsWith('/create')) return 'create';
  if (t.endsWith('/vault/create')) return 'create';
  if (t.endsWith('/vault/health')) return 'health';
  return 'other';
}

const srv = http.createServer(async (req, res) => {
  try {
    const u = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
    if (req.method === 'OPTIONS') return sendJson(res, 200, { ok:true });

    const kind = normalizePath(u.pathname);

    if (req.method === 'GET' && kind === 'health') {
      return sendJson(res, 200, { ok:true, service:'vault-api', host:HOST, port:PORT, solana: !!Keypair });
    }

    if (req.method === 'POST' && kind === 'create') {
      const raw = await readBody(req);
      let payload = {};
      if (raw && raw.trim().length) {
        try { payload = JSON.parse(raw); } catch { payload = { _raw: raw.slice(0, 300) }; }
      }

      if (!Keypair) {
        // Répond quand même en JSON (évite "Unexpected end of JSON input")
        return sendJsonError(res, 503, 'Missing dependency @solana/web3.js (vault generation unavailable)', { hint: 'Run npm i @solana/web3.js in /opt/traderone-vault-api' });
      }

      const kp = Keypair.generate();
      const pub = kp.publicKey.toBase58();
      const secretB64 = Buffer.from(kp.secretKey).toString('base64');
      const rec = { ts: Date.now(), pub, secretB64, payload };

      try {
        fs.appendFileSync(VAULT_LOG, JSON.stringify(rec) + '\n', 'utf8');
      } catch (e) {
        // même en cas d'échec write, on renvoie JSON
        return sendJsonError(res, 500, 'Failed to persist vault record', { pub });
      }

      return sendJson(res, 200, { ok:true, vault:{ pub }, saved:true });
    }

    // Default : toujours JSON
    return sendJsonError(res, 404, 'Not found', { path: u.pathname });
  } catch (e) {
    // Important: ne jamais laisser une réponse vide
    return sendJsonError(res, 500, 'Unhandled error', { msg: String(e && e.message || e) });
  }
});

srv.listen(PORT, HOST, () => {
  console.log(`vault-api listening http://${HOST}:${PORT}`);
});

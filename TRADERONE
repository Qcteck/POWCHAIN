cd /var/www/wolverine

# 1) retrouve un backup "récent" (20:05) dans settings (ou autre)
ls -la settings/index.html.bak_* 2>/dev/null | tail -n 5
# si rien dans settings, cherche partout :
find . -maxdepth 2 -name "index.html.bak_*" -type f -printf "%TY-%Tm-%Td %TH:%TM %s %p\n" | sort | tail -n 10

# 2) choisis UN backup récent (copie/colle le chemin exact trouvé) :
NEW="./settings/index.html.bak_YYYYMMDD_HHMMSS"

# 3) remplace le root index par le nouveau
cp -a index.html index.html.bak_before_switch_$(date +%Y%m%d_%H%M%S)
cp -a "$NEW" ./index.html

nginx -t && systemctl reload nginx

# 4) vérif
stat -c "%y %s %n" ./index.html ./settings/index.html
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DOMAIN="fireinners.online"
WEBROOT="/var/www/wolverine"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
BK="/root/WV_FIX_404_${TS}"
say(){ echo "[$(date +%H:%M:%S)] $*"; }
need_root(){ [ "$(id -u)" -eq 0 ] || { echo "ROOT ONLY"; exit 1; }; }
unfreeze(){ command -v chattr >/dev/null 2>&1 || return 0; chattr -i "$@" 2>/dev/null || true; }
refreeze(){ command -v chattr >/dev/null 2>&1 || return 0; chattr +i "$@" 2>/dev/null || true; }

inject_include_into_ssl_server(){
  local f="$1" incLine="include ${INC};"
  grep -qF "$incLine" "$f" && return 0
  awk -v inc="$incLine" '
    BEGIN{in_srv=0;depth=0;is443=0;done=0;}
    /^[[:space:]]*server[[:space:]]*\{/ {in_srv=1;depth=1;is443=0;}
    {
      if(in_srv){
        if($0 ~ /listen[[:space:]]+443/){is443=1;}
        n=gsub(/\{/,"{"); depth+=n;
        n=gsub(/\}/,"}"); depth-=n;
        if(depth==0){
          if(is443 && !done){
            print "    " inc;
            done=1;
          }
          in_srv=0;
        }
      }
      print
    }
  ' "$f" >"${f}.tmp" && mv -f "${f}.tmp" "$f"
}

disable_other_wolverine_includes(){
  local d="/etc/nginx/includes"
  [ -d "$d" ] || return 0
  shopt -s nullglob
  for f in "$d"/wolverine*; do
    [ "$f" = "$INC" ] && continue
    local base; base="$(basename "$f")"
    case "$base" in
      DISABLED_*|*.bak|*.bak_*) continue ;;
    esac
    mv -f "$f" "$d/DISABLED_${TS}__${base}" 2>/dev/null || true
  done
}

write_include(){
  mkdir -p "$(dirname "$INC")"
  cat >"$INC"<<EOF
# CANONICAL Wolverine routes (auto) ${TS}
location ^~ /wolverine/ {
  alias ${WEBROOT}/;
  try_files \$uri \$uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
EOF
}


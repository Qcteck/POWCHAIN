from pathlib import Path
import re,os
p=Path("$VHOST_DETECTED")
s=p.read_text(errors="ignore").splitlines()

inc='include /etc/nginx/includes/wolverine_routes.inc;'
out=[]
i=0
def block_text(lines,a,b): return "\n".join(lines[a:b+1])

# Helper: determine if a server block serves fireinners.online
def serves_fireinners(block):
    if re.search(r'\\bserver_name\\b', block) and 'fireinners.online' in block:
        return True
    return False

# We will parse brace depth to identify server blocks.
depth=0
server_start=None
server_depth=None
blocks=[]
for idx,line in enumerate(s):
    if server_start is None and re.search(r'\\bserver\\s*\\{', line):
        server_start=idx
        # depth after counting braces in this line
    # update depth
    depth += line.count('{') - line.count('}')
    if server_start is not None and idx==server_start:
        server_depth=depth
    if server_start is not None and depth < (server_depth or 0):
        # closed server block at previous line
        blocks.append((server_start, idx-1))
        server_start=None
        server_depth=None

# If block did not close properly, ignore.
mark=set()
for a,b in blocks:
    blk=block_text(s,a,b)
    if serves_fireinners(blk):
        mark.add((a,b))

# Now rewrite: remove existing include lines; and for marked blocks insert include right after opening brace line.
idx=0
while idx < len(s):
    # if inside a marked server block
    hit=None
    for a,b in mark:
        if idx==a:
            hit=(a,b); break
    if hit:
        a,b=hit
        # write block
        # find opening line (a)
        out.append(s[a])
        # insert include immediately after open line
        out.append("  "+inc)
        # write rest of block excluding any prior include occurrences
        for j in range(a+1,b+1):
            if inc in s[j]:
                continue
            out.append(s[j])
        idx=b+1
        continue
    # outside marked blocks: just copy line, but drop stray include duplicates
    if inc in s[idx]:
        idx+=1
        continue
    out.append(s[idx]); idx+=1

p.write_text("\n".join(out)+("\n" if out else ""))
PY


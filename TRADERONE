"use strict";
const http = require("http");
const fs = require("fs");
const path = require("path");
const nacl = require("tweetnacl");
const bs58 = require("bs58").default || require("bs58");

const HOST = "127.0.0.1";
const PORT = parseInt(process.env.PORT || "3010", 10);
const DATA_DIR = (process.env.DATA_DIR || "/opt/traderone-vault/data").trim();
const VAULTS_DIR = path.join(DATA_DIR, "vaults");

function j(res, code, obj) {
  res.writeHead(code, {
    "content-type": "application/json; charset=utf-8",
    "cache-control": "no-store",
    "access-control-allow-origin": "*",
    "access-control-allow-headers": "content-type",
    "access-control-allow-methods": "GET,POST,OPTIONS",
  });
  res.end(JSON.stringify(obj));
}

function readBody(req) {
  return new Promise((resolve) => {
    let data = "";
    req.on("data", (c) => { data += c; if (data.length > 2_000_000) req.destroy(); });
    req.on("end", () => resolve(data));
  });
}

function okUserPub(s) {
  if (!s || typeof s !== "string") return false;
  if (s.length < 32 || s.length > 60) return false;
  return /^[1-9A-HJ-NP-Za-km-z]+$/.test(s);
}

function ensureDirs() {
  fs.mkdirSync(VAULTS_DIR, { recursive: true });
}

ensureDirs();

const server = http.createServer(async (req, res) => {
  try {
    const url = new URL(req.url, "http://127.0.0.1");
    if (req.method === "OPTIONS") return j(res, 204, { ok: true });
    if (req.method === "GET" && url.pathname === "/health") return j(res, 200, { status: "ok", service: "wolverine-vault-api" });

    if (req.method === "POST" && url.pathname === "/create") {
      const bodyTxt = await readBody(req);
      let body = {};
      try { body = bodyTxt ? JSON.parse(bodyTxt) : {}; } catch { body = {}; }
      const user = (body.user || url.searchParams.get("user") || "").trim();
      if (!okUserPub(user)) return j(res, 400, { ok: false, error: "Invalid user pubkey" });

      const fp = path.join(VAULTS_DIR, `${user}.json`);
      if (fs.existsSync(fp)) {
        try {
          const existing = JSON.parse(fs.readFileSync(fp, "utf8"));
          if (existing && existing.vault_pub) return j(res, 200, { ok: true, user, vault: existing.vault_pub, reused: true });
        } catch {}
      }

      const kp = nacl.sign.keyPair();
      const vault_pub = bs58.encode(Buffer.from(kp.publicKey));
      const vault_secret = bs58.encode(Buffer.from(kp.secretKey)); // 64 bytes

      const rec = {
        ts: new Date().toISOString(),
        chain: "solana",
        user,
        vault_pub,
        vault_secret,
      };
      fs.writeFileSync(fp, JSON.stringify(rec, null, 2));

      return j(res, 200, { ok: true, user, vault: vault_pub });
    }

    return j(res, 404, { ok: false, error: "Not Found" });
  } catch (e) {
    return j(res, 500, { ok: false, error: String(e && e.message ? e.message : e) });
  }
});

server.listen(PORT, HOST, () => {
  console.log(`vault api listening on ${HOST}:${PORT}`);
});

bash -lc 'set -euo pipefail
python3 - <<'"'"'PY'"'"'
import os, textwrap, glob
p="/root/aq.sh"
# cleanup any weird prior names
for f in glob.glob("/root/a.sh*")+glob.glob("/root/aq.sh*")+glob.glob("/root/MEGA_*AQ*FIX*.sh*"):
    try:
        os.remove(f)
    except:
        pass
s = r"""#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQFIX_${TS}"
mkdir -p "$BK"
say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v curl  >/dev/null 2>&1 || die "curl missing"
command -v python3 >/dev/null 2>&1 || die "python3 missing"
umask 022

DOMAIN="fireinners.online"
VHOST_A="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_E="/etc/nginx/sites-enabled/fireinners.online-ssl"

PATH_A="/aquila_stacking/"
PATH_B="/iaaquila/"

WEBROOT="/var/www/aquila_stacking"
LINKROOT="/var/www/iaaquila"
INC="/etc/nginx/includes/aquila_stacking_routes.inc"

APP="/opt/aquila_stacking_react"
ZIP_URL="${ZIP_URL:-}"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then . "$ASKLIB" || true; fi

backup_one(){ local p="$1"; [ -e "$p" ] || return 0; mkdir -p "$BK/$(dirname "$p")"; cp -a "$p" "$BK/$p.bak" 2>/dev/null || true; }

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "Aquila routes fix" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(echo "$path" | sed "s#/#_#g").bak" 2>/dev/null || true
    install -m 0644 "$tmp" "$path"
  fi
  rm -f "$tmp"
}

ensure_dirs(){
  say "1) Ensure webroot"
  mkdir -p "$WEBROOT"
  chmod 0755 "$WEBROOT" || true
  chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
  if [ ! -e "$LINKROOT" ]; then ln -s "$WEBROOT" "$LINKROOT" 2>/dev/null || true; fi
}

pull_zip(){
  local z=""
  if [ -n "$ZIP_URL" ]; then
    z="/root/aquila_ui_${TS}.zip"
    say "2) Download ZIP_URL -> $z"
    curl -fsSL "$ZIP_URL" -o "$z" || die "download failed"
  else
    z="$(ls -1t /root/horizons-export*.zip /root/*.zip 2>/dev/null | head -n 1 || true)"
  fi
  [ -n "$z" ] || { say "2) No zip found (skip)"; return 0; }
  say "2) Use zip: $z"
  rm -rf "$APP"
  mkdir -p "$APP"
  unzip -oq "$z" -d "$APP"
}

ensure_node(){
  command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 && return 0
  say "3) Install node/npm"
  apt-get update -y
  apt-get install -y nodejs npm
}

build_if_needed(){
  [ -d "$APP" ] || return 0
  if [ -f "$APP/package.json" ]; then
    ensure_node
    say "4) Build React app"
    cd "$APP"
    npm ci --no-audit --no-fund 2>/dev/null || npm install --no-audit --no-fund
    npm run build || die "npm run build failed"
  else
    say "4) No package.json (assume static export)"
  fi
}

deploy(){
  say "5) Deploy to $WEBROOT"
  local SRC=""
  if [ -d "$APP/dist" ] && [ -f "$APP/dist/index.html" ]; then SRC="$APP/dist"; fi
  if [ -z "$SRC" ] && [ -d "$APP/out" ] && [ -f "$APP/out/index.html" ]; then SRC="$APP/out"; fi
  if [ -z "$SRC" ] && [ -d "$APP/build" ] && [ -f "$APP/build/index.html" ]; then SRC="$APP/build"; fi
  if [ -z "$SRC" ] && [ -f "$APP/index.html" ]; then SRC="$APP"; fi

  rm -rf "$WEBROOT"/*
  if [ -n "$SRC" ]; then
    cp -a "$SRC"/. "$WEBROOT"/
  fi

  if [ ! -f "$WEBROOT/index.html" ]; then
    cat >"$WEBROOT/index.html"<<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aquila</title><style>body{font-family:system-ui;margin:24px;background:#0b1020;color:#d7e3ff}code{background:#111a33;padding:3px 6px;border-radius:6px}</style></head><body><h1>Aquila Stacking</h1><p>Fallback served (no dist/index.html found).</p><p>WEBROOT <code>/var/www/aquila_stacking</code></p></body></html>
EOF
  fi

  chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
  chmod -R a+rX "$WEBROOT" 2>/dev/null || true
}

write_inc(){
  say "6) Write nginx include: $INC"
  mkdir -p "$(dirname "$INC")"
  write_file "$INC" \
"# Aquila routes
location = ${PATH_A%/} { return 301 $PATH_A; }
location ^~ $PATH_A {
  root /var/www;
  try_files \$uri \$uri/ ${PATH_A}index.html;
  add_header Cache-Control \"no-store\" always;
}
location = ${PATH_B%/} { return 301 $PATH_B; }
location ^~ $PATH_B {
  root /var/www;
  try_files \$uri \$uri/ ${PATH_B}index.html;
  add_header Cache-Control \"no-store\" always;
}
"
}

patch_one_vhost(){
  local f="$1"
  [ -f "$f" ] || return 0
  backup_one "$f"
  grep -qF "$INC" "$f" && { say "   include already in $f"; return 0; }
  python3 - "$f" "$DOMAIN" "$INC" <<'"'"'PY'"'"'
import re,sys
p,dom,inc=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(p,'r',encoding='utf-8',errors='ignore').read()
def patch(block):
  if inc in block: return block, False
  if not re.search(r'\blisten\b[^;]*\b443\b', block): return block, False
  if not re.search(r'\bserver_name\b[^;]*\b'+re.escape(dom)+r'\b', block): return block, False
  lines=block.splitlines()
  ins=None
  for i,l in enumerate(lines):
    if re.search(r'\bserver_name\b', l):
      ins=i+1; break
  if ins is None: ins=1
  lines.insert(ins, "    include %s;"%inc)
  return "\n".join(lines), True
out=[]; changed=False; pos=0
for m in re.finditer(r'server\s*\{', s):
  start=m.start()
  out.append(s[pos:start])
  i=start; depth=0
  while i < len(s):
    c=s[i]
    if c=='{': depth+=1
    elif c=='}':
      depth-=1
      if depth==0:
        end=i+1
        block=s[start:end]
        newb,ch=patch(block)
        out.append(newb)
        changed=changed or ch
        pos=end
        break
    i+=1
new="".join(out)+s[pos:]
if changed:
  open(p,'w',encoding='utf-8').write(new)
PY
  grep -qF "$INC" "$f" && say "   patched $f" || say "   WARN not patched $f"
}

patch_vhosts(){
  say "7) Patch vhosts"
  patch_one_vhost "$VHOST_A"
  patch_one_vhost "$VHOST_E"
  local files
  files="$(grep -RIl --exclude='"'"'*.dpkg-*'"'"' --exclude='"'"'*.bak'"'"' -E "server_name[[:space:]].*\\b${DOMAIN}\\b" /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d 2>/dev/null || true)"
  while IFS= read -r f; do [ -n "$f" ] && patch_one_vhost "$f"; done <<<"$files"
}

reload_and_test(){
  say "8) nginx -t + reload"
  nginx -t
  systemctl reload nginx

  say "9) Local tests"
  echo "--- ${PATH_A} ---"
  curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_A" | head -n 12 || true
  echo "--- ${PATH_B} ---"
  curl -skI -H "Host: $DOMAIN" "https://127.0.0.1$PATH_B" | head -n 12 || true
  echo "--- include hit ---"
  nginx -T 2>/dev/null | grep -n "aquila_stacking_routes" -n | head -n 20 || true
}

main(){
  say "BEGIN AQFIX @ $TS"
  ensure_dirs
  pull_zip
  build_if_needed
  deploy
  write_inc
  patch_vhosts
  reload_and_test
  say "DONE"
  say "BK: $BK"
  say "Open: https://$DOMAIN$PATH_A"
  say "Open: https://$DOMAIN$PATH_B"
}
main
"""
open(p,"w",encoding="utf-8",newline="\n").write(s)
os.chmod(p,0o755)
print("WROTE",p)
PY
bash /root/aq.sh'
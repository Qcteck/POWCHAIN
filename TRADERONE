cat >/root/AIAQUILA_LOCATION_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/aiaquila_proxy.conf"

echo "=== AIAQUILA LOCATION FIX ==="

### 1) Backup vhost
echo "[1/7] Backup vhost"
cp -a "$VHOST" "$VHOST.backup.$TS"

### 2) Remove immutable
echo "[2/7] Remove immutable flag"
chattr -i "$VHOST"

### 3) Write CLEAN snippet (NO location)
echo "[3/7] Write clean proxy snippet"
cat >"$SNIP" <<'NGX'
resolver 1.1.1.1 8.8.8.8 valid=300s;
resolver_timeout 5s;

proxy_pass https://news.bitcoin.com/feed/;
proxy_set_header Host news.bitcoin.com;
proxy_set_header User-Agent "AIAQUILA-RSS";
proxy_ssl_server_name on;

proxy_connect_timeout 10s;
proxy_read_timeout 30s;
NGX

### 4) Ensure locations exist in SERVER BLOCK
echo "[4/7] Inject locations in server block if missing"

grep -q "location /aiaquila/api/rss" "$VHOST" || sed -i '/server_name fireinners.online;/a\
\
    location /aiaquila/api/rss {\
        include /etc/nginx/snippets/aiaquila_proxy.conf;\
    }\
\
    location /aiaquila/health {\
        default_type text/plain;\
        return 200 "OK AIAQUILA\\n";\
    }\
' "$VHOST"

### 5) Restore immutable
echo "[5/7] Restore immutable flag"
chattr +i "$VHOST"

### 6) nginx test
echo "[6/7] nginx test"
nginx -t

### 7) reload
echo "[7/7] reload nginx"
systemctl reload nginx

echo "DONE"
echo "Health : https://fireinners.online/aiaquila/health"
echo "RSS    : https://fireinners.online/aiaquila/api/rss"
BASH

chmod +x /root/AIAQUILA_LOCATION_FIX.sh
/root/AIAQUILA_LOCATION_FIX.sh
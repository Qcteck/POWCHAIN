cat >/root/FIX_NGINX_WOLVERINE_DUPLICATE_ROOT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIX DUPLICATE /wolverine/ LOCATION ==="

NGCONF="/etc/nginx/sites-enabled/fireinners.online-ssl"
BACK="/root/nginx_backup_$(date +%Y%m%d_%H%M%S).conf"

### 1. BACKUP
cp "$NGCONF" "$BACK"
echo "Backup: $BACK"

### 2. REMOVE ALL EXISTING wolverine LOCATIONS
sed -i '/location \/wolverine\//,/}/d' "$NGCONF"

### 3. ADD SINGLE CLEAN LOCATION
cat >>"$NGCONF" <<'EOF'

location /wolverine/ {
    root /var/www;
    index index.html;
    try_files $uri $uri/ /wolverine/index.html;
    add_header Cache-Control "no-store";
}
EOF

### 4. TEST & RELOAD
nginx -t
systemctl reload nginx

echo "=== OK ==="
echo "OPEN: https://fireinners.online/wolverine/"
BASH

chmod +x /root/FIX_NGINX_WOLVERINE_DUPLICATE_ROOT.sh
/root/FIX_NGINX_WOLVERINE_DUPLICATE_ROOT.sh
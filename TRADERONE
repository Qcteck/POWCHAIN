bash -c "$(cat <<'BASH'
set -e

echo "=== WOLVERINE BALANCES HARD START ==="

APP=/opt/wolverine-balances
PORT=3010

rm -rf $APP
mkdir -p $APP
cd $APP

cat > server.js <<'JS'
const http = require("http");
const { Connection, PublicKey } = require("@solana/web3.js");

const RPC = "https://api.mainnet-beta.solana.com";
const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";
const conn = new Connection(RPC);

http.createServer(async (req, res) => {
  try {
    const m = req.url.match(/^\/balances\/([A-Za-z0-9]+)$/);
    if (!m) {
      res.writeHead(404);
      return res.end("not found");
    }

    const pub = new PublicKey(m[1]);

    const sol = (await conn.getBalance(pub)) / 1e9;

    const accs = await conn.getParsedTokenAccountsByOwner(
      pub,
      { mint: new PublicKey(USDC) }
    );

    let usdc = 0;
    for (const a of accs.value) {
      usdc += a.account.data.parsed.info.tokenAmount.uiAmount || 0;
    }

    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ sol, usdc }));
  } catch (e) {
    res.writeHead(500);
    res.end(e.toString());
  }
}).listen(3010, () => {
  console.log("BALANCES API LISTENING ON 3010");
});
JS

npm init -y >/dev/null
npm install @solana/web3.js >/dev/null

echo "== NODE VERSION =="
node -v

echo "== START SERVER (FOREGROUND) =="
node server.js
BASH
)"
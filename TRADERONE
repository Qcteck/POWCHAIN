cat >/root/cf_ray_wolverine.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
H="fireinners.online"
P="/wolverine/index.html"

echo "PUBLIC:"
curl -skI "https://$H$P" | egrep -i "HTTP/|server:|cf-ray:|cf-cache-status:|content-type:|location:" || true
echo
echo "ORIGIN:"
curl -skI --resolve "$H:443:127.0.0.1" "https://$H$P" | egrep -i "HTTP/|server:|content-type:|location:" || true
BASH

chmod +x /root/cf_ray_wolverine.sh
/root/cf_ray_wolverine.sh
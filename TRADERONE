bash <<'EOF'
set -e

### CONFIG
DOCROOT="/var/www/fireinners.online"
APP="aiaquila"
APPDIR="$DOCROOT/$APP"
INDEX="$APPDIR/index.html"
WORKER="https://aiaquila-proxy.workers.dev/rss"

echo "=== AIAQUILA HARD FORCE FIX ==="

### LOCATE & LIST
echo "== Vérification fichiers =="
ls -l "$APPDIR"

### BACKUP ALL INDEX VARIANTS
for f in "$APPDIR"/index*.html; do
  [ -f "$f" ] && cp "$f" "$f.backup.$(date +%s)"
done

### HARD OVERWRITE
cat > "$INDEX" <<HTML
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — RSS réel</title>
<style>
body{margin:0;background:#0b1b3a;color:#fff;font-family:system-ui}
#wrap{padding:20px}
button{padding:10px 14px;font-size:15px;cursor:pointer}
pre{white-space:pre-wrap;margin-top:15px;font-size:13px}
</style>
</head>
<body>
<div id="wrap">
<h2>🦅 AIAQUILA — RSS réel (WORKER)</h2>
<button onclick="load()">Lire les articles</button>
<pre id="out">En attente…</pre>
</div>

<script>
const RSS="${WORKER}?url=https://news.bitcoin.com/feed/";
async function load(){
  const out=document.getElementById("out");
  out.textContent="FETCH → "+RSS+"\\n\\n";
  try{
    const r=await fetch(RSS,{cache:"no-store"});
    const j=await r.json();
    out.textContent="Articles: "+j.length+"\\n\\n";
    j.slice(0,20).forEach((a,i)=>{
      out.textContent+=(i+1)+". "+a.title+"\\n"+a.link+"\\n\\n";
    });
  }catch(e){
    out.textContent="ERREUR: "+e.message;
  }
}
</script>
</body>
</html>
HTML

### PERMS
chown www-data:www-data "$INDEX"
chmod 644 "$INDEX"

### NGINX HARD RELOAD
echo "== Reload nginx =="
nginx -t
systemctl reload nginx

### VERIFY SERVED CONTENT (FIRST 20 LINES)
echo
echo "== CONTENU SERVI (curl) =="
curl -s https://fireinners.online/aiaquila/ | sed -n '1,40p'

### WORKER DIRECT TEST
echo
echo "== WORKER DIRECT TEST =="
curl -s "$WORKER?url=https://news.bitcoin.com/feed/" | head -c 300
echo

echo
echo "✅ FORÇAGE TERMINÉ"
echo "➡️ Ouvre: https://fireinners.online/aiaquila/"
echo "➡️ CTRL+SHIFT+R (hard refresh)"
EOF
  cat >"$INC_FILE" <<EOF
# Aquila True Staking (managed) - $TS

# Serve app
location ^~ /aquilastacking/ {
  alias $WEBROOT/;
  index index.html;
  try_files \$uri \$uri/ /aquilastacking/index.html;
  add_header Cache-Control "no-store" always;
}

# Same-origin RPC proxy to avoid CORS/403 from browsers
location = /aquilastacking/rpc {
  proxy_http_version 1.1;
  proxy_set_header Host $(echo "$RPC_UPSTREAM" | awk -F/ '{print $3}');
  proxy_set_header Connection "";
  proxy_ssl_server_name on;
  proxy_pass $RPC_UPSTREAM;
}
EOF
  chmod 644 "$INC_FILE" || true
}

inject_include_in_vhost(){
  local v="$VHOST_A"
  [ -f "$v" ] || die "Missing vhost: $v"
  backup_one "$v"

  # ensure we inject include line once inside the main server{} that serves the domain
  python3 - "$v" "$INC_FILE" "$DOMAIN" <<'PY'
import sys,re
vpath,inc,domain=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(vpath,'r',encoding='utf-8',errors='ignore').read()
if f"include {inc};" in s:
    print("NOCHANGE include already present")
    sys.exit(0)

# Try: find server block that contains server_name with domain
# naive brace matching
def find_server_blocks(txt):
    blocks=[]
    for m in re.finditer(r'\bserver\s*\{', txt):
        start=m.start()
        i=m.end()
        depth=1
        while i < len(txt) and depth>0:
            if txt[i]=='{': depth+=1
            elif txt[i]=='}': depth-=1
            i+=1
        if depth==0:
            blocks.append((start,i))
    return blocks

blocks=find_server_blocks(s)
target=None
for (a,b) in blocks:

ssh -T git@github.com || true
git ls-remote git@github.com:Qcteck/POWCHAIN.git | head || true



bash -lc 'set -euo pipefail;REPO="git@github.com:Qcteck/POWCHAIN.git";BR="Qcteck";STAGE="/opt/powchain_sync_stage";TR="/opt/traderone-opt";say(){ printf "\n[SYNC] %s\n" "$*"; };need(){ command -v "$1" >/dev/null 2>&1; }
need git||{ say "git manquant"; exit 1; };need rsync||{ say "rsync manquant"; exit 1; }
ssh -o BatchMode=yes -T git@github.com >/dev/null 2>&1 || { say "SSH GitHub pas prêt. Fais: ssh -T git@github.com"; exit 2; }

find_wolv(){ 
  for root in /opt /var/www /srv /root;do [ -d "$root" ]||continue;
    find "$root" -maxdepth 6 -type d -iname "*wolverine*" 2>/dev/null | while read -r d;do
      score=0
      [ -f "$d/index.html" ] && score=$((score+3))
      [ -d "$d/vendor" ] && score=$((score+3))
      find "$d" -maxdepth 2 -type f -name "index.html" -print -quit 2>/dev/null | grep -q . && score=$((score+1)) || true
      find "$d" -maxdepth 4 -type f \( -name "server.js" -o -name "app.js" \) -print -quit 2>/dev/null | grep -q . && score=$((score+1)) || true
      [ "$score" -ge 3 ] && echo "$score|$d"
    done
  done | sort -nr | head -n1 | cut -d"|" -f2
}

WOLV="$(find_wolv||true)"
[ -d "$TR" ] || { say "TraderOne introuvable: $TR"; ls -la /opt 2>/dev/null | sed -n "1,160p" || true; exit 3; }
[ -n "${WOLV:-}" ] && [ -d "$WOLV" ] || { say "Wolverine introuvable. Je liste les dossiers possibles:"; for root in /opt /var/www /srv /root;do [ -d "$root" ]||continue; find "$root" -maxdepth 6 -type d -iname "*wolverine*" 2>/dev/null | sed "s/^/[WOLV?] /";done | head -n 200 || true; say "Relance en forçant: export WOLV=/chemin/wolverine; puis relance ce batch"; exit 4; }

say "TraderOne = $TR"
say "Wolverine = $WOLV"

rm -rf "$STAGE"; mkdir -p "$STAGE"; cd "$STAGE"
say "Clone repo (branch $BR)"
git clone -b "$BR" --single-branch "$REPO" repo >/dev/null 2>&1 || { say "Clone échoué. Je tente fetch/init."; mkdir -p repo; cd repo; git init -q; git remote add origin "$REPO"; git fetch origin "$BR" -q; git checkout -B "$BR" "origin/$BR" -q; cd "$STAGE"; }
cd "$STAGE/repo"
mkdir -p SYNC/TRADERONE SYNC/WOLVERINE

EXC=(--exclude ".git" --exclude "node_modules" --exclude "db" --exclude "db/**" --exclude ".leveldb" --exclude ".leveldb/**" --exclude "*.log" --exclude "logs" --exclude "logs/**" --exclude ".env" --exclude "*.env" --exclude "telegram.env" --exclude "*.key" --exclude "*.pem" --exclude "*.p12" --exclude "*.pfx" --exclude "*id_rsa*" --exclude "*id_ed25519*")

say "Rsync TraderOne -> SYNC/TRADERONE/"
rsync -a --delete "${EXC[@]}" "$TR"/ SYNC/TRADERONE/

say "Rsync Wolverine -> SYNC/WOLVERINE/"
rsync -a --delete "${EXC[@]}" "$WOLV"/ SYNC/WOLVERINE/

say "Rapport"
cat > SYNC/SYNC_REPORT.txt <<EOF
SYNC_REPORT
date=$(date -Iseconds)
branch=$BR
repo=$REPO
traderone_src=$TR
wolverine_src=$WOLV
EOF

git add -A
if git diff --cached --quiet; then say "Aucun changement à pousser."; exit 0; fi
MSG="Sync VPS: TraderOne+Wolverine $(date -Iseconds)"
git commit -m "$MSG" >/dev/null
say "Push -> origin/$BR"
git push origin "$BR"
say "OK: push terminé. Chemins dans le repo: SYNC/TRADERONE et SYNC/WOLVERINE"'


export WOLV="/chemin/vers/ton/wolverine"

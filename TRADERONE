cat > "$APP_API_DIR/server.js" <<JS
import express from "express";

const app = express();
app.use(express.json({limit:"1mb"}));

const HOST = "127.0.0.1";
const PORT = 3000;

const RPC_MAIN = process.env.RPC_MAIN || "${RPC_MAIN}";
const RPC_FALLBACKS = (process.env.RPC_FALLBACKS || "https://api.mainnet-beta.solana.com").split(",").map(s=>s.trim()).filter(Boolean);
const USDC_MINT = process.env.USDC_MINT || "${USDC_MINT}";
const TOKEN_PROGRAM = process.env.TOKEN_PROGRAM || "${TOKEN_PROGRAM}";
const BAL_TTL = Number(process.env.BALANCES_CACHE_TTL_MS || "15000");

const cache = new Map(); // pub -> {t, sol, usdc}

function now(){ return Date.now(); }

async function rpcCall(url, body){
  const r = await fetch(url, {method:"POST", headers:{"content-type":"application/json"}, body:JSON.stringify(body)});
  const j = await r.json().catch(()=>null);
  if(!r.ok) throw new Error("RPC HTTP "+r.status);
  if(j?.error) throw new Error("RPC error "+JSON.stringify(j.error));
  return j?.result;
}

async function rpc(body){
  const urls = [RPC_MAIN, ...RPC_FALLBACKS];
  let lastErr = null;
  for(const u of urls){
    try{ return await rpcCall(u, body); }catch(e){ lastErr = e; }
  }
  throw lastErr || new Error("RPC failed");
}

function lamportsToSol(l){ return Number(l||0)/1e9; }

async function getSol(pub){
  const res = await rpc({jsonrpc:"2.0", id:1, method:"getBalance", params:[pub, {commitment:"processed"}]});
  return lamportsToSol(res?.value);
}

async function getUsdc(pub){
  const res = await rpc({jsonrpc:"2.0", id:1, method:"getParsedTokenAccountsByOwner", params:[pub, {mint:USDC_MINT}, {encoding:"jsonParsed", commitment:"processed"}]});
  const arr = res?.value || [];
  let sum = 0;
  for(const it of arr){
    const amt = it?.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
    if(typeof amt === "number") sum += amt;
  }
  return sum;
}

async function getBalances(pub){
  const c = cache.get(pub);
  const t = now();
  if(c && (t - c.t) < BAL_TTL) return {sol:c.sol, usdc:c.usdc, cached:true};
  const sol = await getSol(pub);
  const usdc = await getUsdc(pub);
  cache.set(pub, {t, sol, usdc});
  return {sol, usdc, cached:false};
}

app.get("/ping", (req,res)=>res.type("text/plain").send("pong"));
app.get("/status", async (req,res)=>{
  let api=true;
  res.json({ok:true, api, time:new Date().toISOString(), rpc:RPC_MAIN, ttl:BAL_TTL});
});

app.get("/balances", async (req,res)=>{
  const pub = String(req.query.pub||"").trim();
  if(!pub) return res.status(400).json({ok:false, error:"missing pub"});
  try{
    const b = await getBalances(pub);
    res.json({ok:true, pub, sol:b.sol, usdc:b.usdc, cached:b.cached});
  }catch(e){
    res.status(502).json({ok:false, error:String(e?.message||e)});
  }
});

// SSE: push api+balances every 2s
app.get("/events", async (req,res)=>{
  const pub = String(req.query.pub||"").trim();
  res.setHeader("Content-Type","text/event-stream");
  res.setHeader("Cache-Control","no-cache");
  res.setHeader("Connection","keep-alive");
  res.flushHeaders?.();

  let alive = true;
  req.on("close", ()=>{ alive=false; });

  const send = (obj)=>{ try{ res.write("data: "+JSON.stringify(obj)+"\\n\\n"); }catch(e){} };

  // initial
  send({api:true});
  let n=0;
  while(alive){
    n++;
    try{
      let balances = null;
      if(pub){
        const b = await getBalances(pub);
        balances = {sol:b.sol, usdc:b.usdc};
      }
      send({api:true, balances, seq:n, t:Date.now()});
    }catch(e){
      send({api:false, error:String(e?.message||e), seq:n, t:Date.now()});
    }
    await new Promise(r=>setTimeout(r, 2000));
  }
});

app.listen(PORT, HOST, ()=>console.log("[wolverine-traderone-api] listening on http://"+HOST+":"+PORT));
JS


cat >/root/fix_buffer_now.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
DIR="/var/www/wolverine"
HTML="$DIR/index.html"
OUT="$DIR/buffer.browser.min.js"
TS="$(date +%Y%m%d_%H%M%S)"
cp -a "$HTML" "${HTML}.bak_${TS}"

echo "== Download buffer (working URLs) =="
urls=(
  "https://cdn.jsdelivr.net/npm/buffer@6.0.3/index.min.js"
  "https://unpkg.com/buffer@6.0.3/index.min.js"
)
ok=0
for u in "${urls[@]}"; do
  echo "TRY: $u"
  if curl -fsSL "$u" -o "$OUT"; then ok=1; echo "OK ✅"; break; fi
done
[ "$ok" -eq 1 ] || { echo "❌ download failed"; exit 1; }
chmod 0644 "$OUT"

python3 - <<'PY'
from pathlib import Path
import re
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")
s = re.sub(r'<!--\s*WOLVERINE_BUFFER_POLYFILL\s*-->.*?(?=</head>)', '', s, flags=re.S|re.I)
s = re.sub(r'<script[^>]+src=["\'][^"\']*buffer[^"\']*["\'][^>]*>\s*</script>\s*', '', s, flags=re.I)
poly = r"""
<!-- WOLVERINE_BUFFER_POLYFILL -->
<script>
  window.global = window;
  window.process = window.process || { env: {} };
</script>
<script src="/wolverine/buffer.browser.min.js"></script>
<script>
  if (window.buffer && window.buffer.Buffer) window.Buffer = window.buffer.Buffer;
</script>
"""
s = s.replace("</head>", poly + "\n</head>", 1) if "</head>" in s else (poly + "\n" + s)
p.write_text(s)
print("OK: injected Buffer polyfill")
PY

systemctl reload nginx || service nginx reload

echo "== ORIGIN check (must be 200) =="
curl -sk --resolve fireinners.online:443:127.0.0.1 -I https://fireinners.online/wolverine/buffer.browser.min.js | sed -n '1,12p'
BASH

chmod +x /root/fix_buffer_now.sh
/root/fix_buffer_now.sh
cat >/root/FIREINNERS_WALLET_SOLRPC_PATCH_308.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== FIREINNERS WALLET SOLRPC PATCH (wallet RPC slash + nginx 308) ==="

ASKORUPDATE_LIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKORUPDATE_LIB" ]; then
  # shellcheck disable=SC1090
  source "$ASKORUPDATE_LIB"
  echo "askorupdate loaded: $ASKORUPDATE_LIB"
else
  echo "askorupdate not found: $ASKORUPDATE_LIB (will use safe inline backups)"
fi

need_root(){ [ "$(id -u)" = "0" ] || { echo "ERR: run as root"; exit 1; }; }
need_root

ts(){ date +"%Y%m%d_%H%M%S"; }
BKDIR="/root/backup_fireinners_wallet_solrpc_$(ts)"
mkdir -p "$BKDIR"

# ---------- Locate wallet HTML ----------
CANDIDATES=(
  "/opt/fireinners/frontend-react/app/dist/wallet/index.html"
  "/opt/fireinners/frontend-react/app/dist/wallet.html"
  "/opt/fireinners/frontend-react/app/dist/wallet/index.htm"
  "/opt/fireinners/frontend-react/app/dist/wallet/index.php"
)
WALLET_HTML=""
for f in "${CANDIDATES[@]}"; do
  if [ -f "$f" ]; then WALLET_HTML="$f"; break; fi
done

if [ -z "$WALLET_HTML" ]; then
  echo "ERR: wallet html not found in expected paths."
  printf "Tried:\n- %s\n" "${CANDIDATES[@]}"
  exit 2
fi
echo "Wallet HTML: $WALLET_HTML"

# ---------- Patch wallet (ensure trailing slash on /solrpc) ----------
echo "[1/3] Backup wallet"
cp -a "$WALLET_HTML" "$BKDIR/$(basename "$WALLET_HTML").bak"

echo "[2/3] Patch wallet RPC string (force https://fireinners.online/solrpc/)"
TMP="$BKDIR/wallet.patched.html"
perl -0777 -pe 's#https://fireinners\.online/solrpc(?!/)#https://fireinners.online/solrpc/#g' "$WALLET_HTML" >"$TMP"

if ! grep -q "https://fireinners\.online/solrpc/" "$TMP"; then
  echo "WARN: patched file does not contain https://fireinners.online/solrpc/ (maybe your code builds RPC dynamically)."
else
  echo "OK: /solrpc/ present in patched wallet"
fi

if command -v sha256sum >/dev/null 2>&1; then
  echo "sha256 before: $(sha256sum "$WALLET_HTML" | awk '{print $1}')"
  echo "sha256 after : $(sha256sum "$TMP" | awk '{print $1}')"
fi

echo "Install patched wallet"
cp -a "$TMP" "$WALLET_HTML"

# ---------- Patch nginx: 308 redirect for POST safety ----------
NGX="/etc/nginx/sites-available/fireinners.online-ssl"
NGX2="/etc/nginx/sites-enabled/fireinners.online-ssl"
NGX_FILE=""
if [ -f "$NGX" ]; then NGX_FILE="$NGX"; elif [ -f "$NGX2" ]; then NGX_FILE="$NGX2"; fi

echo "[3/3] Nginx 308 redirect /solrpc -> /solrpc/ (keeps POST)"
if [ -z "$NGX_FILE" ]; then
  echo "WARN: nginx vhost fireinners.online-ssl not found at:"
  echo "- $NGX"
  echo "- $NGX2"
  echo "Skipping nginx patch."
else
  echo "Nginx vhost: $NGX_FILE"
  cp -a "$NGX_FILE" "$BKDIR/$(basename "$NGX_FILE").bak"

  if grep -Eq 'location\s*=\s*/solrpc\s*\{\s*return\s+308\s+/solrpc/\s*;\s*\}' "$NGX_FILE"; then
    echo "OK: 308 redirect already present, no change."
  else
    # unfreeze if immutable
    if command -v lsattr >/dev/null 2>&1 && lsattr -d "$NGX_FILE" 2>/dev/null | grep -q ' i '; then
      echo "Unfreezing nginx vhost (chattr -i)"
      chattr -i "$NGX_FILE" || true
    fi
    if command -v lsattr >/dev/null 2>&1 && lsattr -d /etc/nginx/nginx.conf 2>/dev/null | grep -q ' i '; then
      echo "Unfreezing /etc/nginx/nginx.conf (chattr -i)"
      chattr -i /etc/nginx/nginx.conf || true
    fi

    # insert redirect just before the first location /solrpc/ block if found; otherwise add near top of server block
    if grep -q "location /solrpc/" "$NGX_FILE"; then
      awk '
        BEGIN{done=0}
        {
          if(!done && $0 ~ /location[[:space:]]+\/solrpc\//){
            print "  location = /solrpc { return 308 /solrpc/; }"
            done=1
          }
          print $0
        }
        END{
          if(!done){
            # no-op
          }
        }' "$NGX_FILE" >"$BKDIR/nginx.new"
      cp -a "$BKDIR/nginx.new" "$NGX_FILE"
      echo "Inserted: location = /solrpc { return 308 /solrpc/; } before location /solrpc/ block"
    else
      # fallback: add right after 'server {' line
      awk '
        BEGIN{done=0}
        {
          print $0
          if(!done && $0 ~ /^[[:space:]]*server[[:space:]]*\{/){
            print "  location = /solrpc { return 308 /solrpc/; }"
            done=1
          }
        }' "$NGX_FILE" >"$BKDIR/nginx.new"
      cp -a "$BKDIR/nginx.new" "$NGX_FILE"
      echo "Inserted: location = /solrpc { return 308 /solrpc/; } after server {"
    fi

    echo "nginx -t"
    nginx -t

    echo "reload nginx"
    systemctl reload nginx

    # refreeze if possible (match your doctrine)
    echo "Refreezing nginx configs (best-effort)"
    chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
    chattr +i "$NGX_FILE" 2>/dev/null || true
  fi
fi

echo "=== TESTS ==="
echo "1) Ping:"
curl -fsS https://fireinners.online/solrpc/ping && echo

echo "2) JSON-RPC getHealth (must be POST to /solrpc/ with trailing slash):"
curl -fsS -H 'content-type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' https://fireinners.online/solrpc/ && echo

echo "3) Verify wallet now references /solrpc/ :"
curl -fsS "https://fireinners.online/wallet/?v=$(date +%s)" | grep -n "fireinners.online/solrpc" | head -n 20 || true

echo "DONE. Backup dir: $BKDIR"
echo "Open wallet with cache-buster: https://fireinners.online/wallet/?v=TS"
SH
chmod +x /root/FIREINNERS_WALLET_SOLRPC_PATCH_308.sh
/root/FIREINNERS_WALLET_SOLRPC_PATCH_308.sh
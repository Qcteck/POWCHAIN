#!/usr/bin/env bash
set -e

echo "=== WOLVERINE FINAL API URL FIX ==="

### 1️⃣ Lister tous les index.html
FILES=$(find /var/www -name index.html)
echo "$FILES"

### 2️⃣ Patch absolu
for f in $FILES; do
  echo "[PATCH] $f"

  # Supprimer toute URL absolue invalide
  sed -i 's|https://wolverine|/wolverine|g' "$f"
  sed -i 's|http://wolverine|/wolverine|g' "$f"
  sed -i 's|https://127.0.0.1:[0-9]\+||g' "$f"
  sed -i 's|http://127.0.0.1:[0-9]\+||g' "$f"

  # Forcer endpoint balances RELATIF
  sed -i 's|fetch([^)]*balances[^)]*)|fetch("/wolverine/api/balances")|g' "$f"

done

### 3️⃣ Vérification
echo "=== VERIFY (must be empty) ==="
grep -R "https://wolverine\|http://wolverine\|127.0.0.1" /var/www || echo "✔ OK"

### 4️⃣ Reload nginx
nginx -t
systemctl reload nginx

echo "=== DONE ==="
echo "➡ Ouvre la page en navigation privée"
echo "➡ CTRL + SHIFT + R"
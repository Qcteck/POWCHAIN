nginx -t && systemctl reload nginx

echo "[7/7] Verdict" | tee -a "$LOG"
echo "→ CTRL + SHIFT + R" | tee -a "$LOG"
echo "→ Ouvrir console : SOL doit apparaître ≤ 10s" | tee -a "$LOG"
echo "Backup: $HTML.bak_force_sol_$TS" | tee -a "$LOG"
echo "Log: $LOG" | tee -a "$LOG"


cat >/root/fix_nginx_wolverine_tryfiles_clean.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-fireinners.online}"
OUT_DIR="${OUT_DIR:-/var/www/wolverine}"
VHOST="/etc/nginx/sites-enabled/${DOMAIN}-ssl"

ts="$(date +%Y%m%d_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/backup_tryfiles_clean_${ts}"
mkdir -p "$BACKDIR"
cp -a "$VHOST" "$BACKDIR/$(basename "$VHOST")"
echo "[OK] Backup -> $BACKDIR/$(basename "$VHOST")"

# Remplace TOUT bloc location ^~ /wolverine/ { ... } par une version clean
perl -0777 -i -pe '
my $out_dir = $ENV{OUT_DIR} // "/var/www/wolverine";

# supprime les blocs location ^~ /wolverine/ existants
s/^\s*location\s+\^~\s+\/wolverine\/\s*\{.*?^\s*\}\s*\n//msg;

my $block =
"    # --- wolverine static export (clean) ---\n".
"    location ^~ /wolverine/ {\n".
"        alias $out_dir/;\n".
"        index index.html;\n".
"        try_files \$uri \$uri/ /wolverine/index.html;\n".
"    }\n";

# injecte dans le server ssl (listen 443) avant sa } finale
if (s/(server\s*\{(?:(?!server\s*\{).)*?listen\s+443(?:(?!^\s*\}\s*$).)*?)^\s*\}\s*$/$1$block}\n/ms) {
} else {
  die "ERR: ssl server not found for injection\n";
}
' "$VHOST"

nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"

echo
echo "Test local (bypass Cloudflare):"
curl -k -sSI "https://127.0.0.1/wolverine/" -H "Host: $DOMAIN" | head -n 15
echo
echo "Test public:"
curl -sSI "https://$DOMAIN/wolverine/" | head -n 15
BASH

chmod +x /root/fix_nginx_wolverine_tryfiles_clean.sh
OUT_DIR="/var/www/wolverine" /root/fix_nginx_wolverine_tryfiles_clean.sh fireinners.online
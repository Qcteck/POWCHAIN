set -e
cd /root

echo "== Start/restart services =="
systemctl daemon-reload || true
systemctl restart traderone_api.service wolverine_api.service 2>/dev/null || true
systemctl restart wolverine-tg-sentinel.service 2>/dev/null || true

echo
echo "== Status =="
systemctl --no-pager --full status traderone_api.service wolverine_api.service | sed -n '1,120p' || true

echo
echo "== Ports Node =="
ss -ltnp | grep node || echo "Aucun port node en écoute"

echo
echo "== Logs (dernieres lignes) =="
journalctl -u traderone_api.service -n 80 --no-pager 2>/dev/null || true
echo "-----"
journalctl -u wolverine_api.service -n 80 --no-pager 2>/dev/null || true
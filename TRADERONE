cat <<'EOF' > /root/FIX_AIAQUILA_HEADERS_SAFE.sh
#!/bin/bash
set -e

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"

echo "🔎 Attributs AVANT"
lsattr "$VHOST"

echo "🔓 Déverrouillage temporaire"
chattr -i "$VHOST"

echo "🧹 Suppression de tout add_header hors location"
sed -i '/add_header Cache-Control/d' "$VHOST"
sed -i '/add_header Pragma/d' "$VHOST"
sed -i '/add_header Expires/d' "$VHOST"

echo "✍️ Réécriture location /aiaquila/ SAFE"
sed -i '/location \/aiaquila\//,/}/c\
location /aiaquila/ {\
    alias /var/www/aiaquila/;\
    index index.html;\
    try_files $uri $uri/ =404;\
\
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;\
    add_header Pragma "no-cache" always;\
    add_header Expires 0 always;\
}' "$VHOST"

echo "🧪 Test nginx"
nginx -t

echo "🔁 Reload nginx"
systemctl reload nginx

echo "🔒 Reverrouillage"
chattr +i "$VHOST"

echo "🔎 Attributs APRÈS"
lsattr "$VHOST"

echo "✅ AIAQUILA HEADERS OK — STRUCTURE NGINX VALIDE"
EOF

chmod +x /root/FIX_AIAQUILA_HEADERS_SAFE.sh
/root/FIX_AIAQUILA_HEADERS_SAFE.sh
#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA RSS FIX ULTIME ==="

WEBROOT="/var/www/aiaquila"
JS="$WEBROOT/aiaquila.js"

test -f "$JS" || { echo "❌ aiaquila.js introuvable"; exit 1; }

BACKUP="$JS.bak.$(date +%s)"
cp "$JS" "$BACKUP"

echo "[1/5] Backup créé: $BACKUP"

echo "[2/5] ÉCRASEMENT COMPLET DU JS"

cat > "$JS" <<'JS'
document.addEventListener("DOMContentLoaded", () => {

const RSS_FEEDS = [
  "https://www.coindesk.com/arc/outboundfeeds/rss/",
  "https://cointelegraph.com/rss",
  "https://www.coingecko.com/rss/news"
];

const logBox = document.getElementById("logs");

function log(msg) {
  logBox.textContent += msg + "\n";
  logBox.scrollTop = logBox.scrollHeight;
}

async function fetchRSS(url) {
  const proxy = "/aiaquila/rss-proxy.php?url=" + encodeURIComponent(url);
  const res = await fetch(proxy);
  if (!res.ok) throw new Error("HTTP " + res.status);
  return await res.text();
}

function parseRSS(xmlText) {
  const doc = new DOMParser().parseFromString(xmlText, "text/xml");
  const items = [...doc.querySelectorAll("item")];
  return items.map(item => ({
    title: item.querySelector("title")?.textContent || "",
    link: item.querySelector("link")?.textContent || "",
    desc: item.querySelector("description")?.textContent || ""
  }));
}

async function loadRSS() {
  log("AIAQUILA RSS prêt");
  let total = 0;

  for (const feed of RSS_FEEDS) {
    try {
      const xml = await fetchRSS(feed);
      const articles = parseRSS(xml);
      total += articles.length;

      articles.slice(0, 5).forEach(a => {
        log("• " + a.title);
      });
    } catch (e) {
      log("RSS erreur: " + feed);
    }
  }

  log("Articles chargés: " + total);
}

loadRSS();
});
JS

echo "[3/5] Permissions"
chown www-data:www-data "$JS"
chmod 644 "$JS"

echo "[4/5] Test nginx"
nginx -t

echo "[5/5] Reload nginx"
systemctl reload nginx

echo "========================================"
echo "✅ RSS CORRIGÉ DÉFINITIVEMENT"
echo "🌐 https://fireinners.online/aiaquila/"
echo "📦 Backup: $BACKUP"
echo "========================================"
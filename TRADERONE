# ROOT — FIX ALL : rebuild + deploy + reload nginx + verify
set -e

SRC="/opt/_wolverine_next_src"
OUT="/opt/_wolverine_next_src/out"
DIST="/var/www/wolverine"
BACK="/var/www/wolverine_backup_$(date +%s)"

echo "=== 1) Vérifier que le build existe ==="
[ -d "$SRC" ] || { echo "ERREUR: $SRC n'existe pas"; exit 1; }

echo "=== 2) Rebuild (Next export statique) ==="
cd "$SRC"
npm install --legacy-peer-deps
npm run build

echo "=== 3) Backup ancien UI ==="
[ -d "$DIST" ] && mv "$DIST" "$BACK" || true
mkdir -p "$DIST"

echo "=== 4) Déployer le nouveau UI ==="
rsync -a --delete "$OUT/" "$DIST/"

echo "=== 5) Reload nginx ==="
nginx -t
systemctl reload nginx

echo "=== 6) Vérification fichiers ==="
ls -lah "$DIST" | head -n 30

echo "=== 7) Vérification HTTP ==="
echo "--- TITLE ---"
curl -LsS https://fireinners.online/wolverine/ | grep -i "<title>" || true
echo "--- HEALTH ---"
curl -sS -i https://fireinners.online/wolverine/health/ | head -n 12 || true

echo "DONE ✅"
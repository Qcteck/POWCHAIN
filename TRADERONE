cat >/root/fix_duplicate_wolverine_rpc_location.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "== 1) Find ACTIVE duplicates for /wolverine/rpc (excluding .bak) =="
mapfile -t HITS < <(
  grep -RIn --binary-files=without-match \
    -E 'location\s*=*\s*/wolverine/rpc\b' /etc/nginx \
  | grep -vE '\.bak_|\.bak$' \
  | head -n 50
)

printf "%s\n" "${HITS[@]:-}" || true
echo

FILES=()
for h in "${HITS[@]:-}"; do
  f="${h%%:*}"
  [[ " ${FILES[*]} " =~ " ${f} " ]] || FILES+=("$f")
done

if [ "${#FILES[@]}" -le 1 ]; then
  echo "No duplicate found (<=1 file)."
  exit 0
fi

echo "== Files containing /wolverine/rpc location =="
printf " - %s\n" "${FILES[@]}"
echo

echo "== 2) Choose the file to KEEP (prefer sites-enabled/fireinners.online*) =="
KEEP=""
for f in "${FILES[@]}"; do
  if [[ "$f" =~ /etc/nginx/sites-enabled/fireinners\.online ]]; then
    KEEP="$f"
    break
  fi
done
if [ -z "$KEEP" ]; then
  KEEP="${FILES[0]}"
fi
echo "KEEP: $KEEP"
echo

echo "== 3) Patch other files to disable duplicate location =="
TS="$(date +%Y%m%d_%H%M%S)"
for f in "${FILES[@]}"; do
  [ "$f" = "$KEEP" ] && continue
  echo "--- disabling duplicates in: $f ---"
  cp -a "$f" "$f.bak_$TS"

  # Rename the location path so it no longer collides
  sed -i -E \
    's@(location[[:space:]]*=*[[:space:]]*)/wolverine/rpc\b@\1/wolverine/rpc_DISABLED@g' \
    "$f"
done

echo
echo "== 4) nginx config test =="
nginx -t

echo
echo "== 5) reload nginx =="
systemctl reload nginx || service nginx reload

echo
echo "== 6) Re-check duplicates (should be 1) =="
grep -RIn -E 'location\s*=*\s*/wolverine/rpc\b' /etc/nginx | grep -vE '\.bak_|\.bak$' | head -n 30 || true

echo
echo "DONE ✅"
BASH

chmod +x /root/fix_duplicate_wolverine_rpc_location.sh
/root/fix_duplicate_wolverine_rpc_location.sh
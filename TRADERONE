set -euo pipefail

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
SNIP="/etc/nginx/snippets/fireinners_test.conf"
WEB="/var/www/fireinners-test"

echo "=== 1) Voir la cause exacte dans les logs ==="
tail -n 60 /var/log/nginx/error.log || true

echo
echo "=== 2) Vérifier fichiers + droits ==="
ls -lah "$WEB" | head -n 30 || true
namei -l "$WEB" || true

echo
echo "=== 3) Forcer des droits OK pour nginx ==="
chown -R www-data:www-data "$WEB" || true
chmod 0755 /var /var/www || true
chmod 0755 "$WEB" || true
chmod -R a+rX "$WEB" || true

echo
echo "=== 4) Vérifier que index.html existe ==="
[ -f "$WEB/index.html" ] && echo "✅ index.html OK" || { echo "❌ index.html absent"; ls -lah "$WEB"; }

echo
echo "=== 5) Fix snippet /test/ (alias + index + autoindex off) ==="
cat > "$SNIP" <<'NGX'
location ^~ /test/ {
  alias /var/www/fireinners-test/;
  index index.html;
  try_files $uri $uri/ /test/index.html =404;
  add_header Cache-Control "no-store" always;
}
NGX

echo
echo "=== 6) Reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 7) Test local ==="
curl -I https://127.0.0.1/test/ --insecure | head -n 20
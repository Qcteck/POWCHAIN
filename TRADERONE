cat > /root/MEGA_WOLVERINE_NGINX_DEDUP_V4.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
HOST="fireinners.online"

NGINX_MAIN="/etc/nginx/nginx.conf"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
INC="${INC_DIR}/wolverine_routes.inc"
FRONT_DIR="/var/www/wolverine"

LOG="/root/MEGA_WOLVERINE_NGINX_DEDUP_V4_${TS}.log"
REPORT="/root/MEGA_WOLVERINE_NGINX_DEDUP_V4_${TS}.report.txt"

say(){ printf "\n== %s ==\n" "$*"; }
w(){ printf "%s\n" "$*" | tee -a "$LOG" >/dev/null; }
die(){ w "ERREUR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Binaire manquant: $1"; }
backup(){ [[ -f "$1" ]] || return 0; cp -a "$1" "${1}.bak_${TS}"; w "Backup: ${1}.bak_${TS}"; }

need nginx; need python3; need systemctl; need grep; need sed; need awk; need find; need curl; need lsattr; need chattr
test -f "$VHOST" || die "Vhost introuvable: $VHOST"
mkdir -p "$INC_DIR"

echo "# MEGA_WOLVERINE_NGINX_DEDUP_V4 $TS" > "$LOG"
w "host=$HOST"
w "date=$(date -Is)"
w "hostname=$(hostname)"
w "whoami=$(whoami)"
w "pwd=$(pwd)"
echo "# REPORT $TS" > "$REPORT"

say "0) Etat actuel (nginx -t)"
(nginx -t 2>&1 || true) | tee -a "$LOG" >/dev/null

say "1) Unlock immutable si necessaire (vhost/nginx.conf/include)"
WAS_IMM_VHOST="0"; WAS_IMM_MAIN="0"; WAS_IMM_INC="0"
unlock_if_immutable(){
  local f="$1" name="$2"
  local a; a="$(lsattr -d "$f" 2>/dev/null || true)"
  w "lsattr ${name}: ${a}"
  if echo "$a" | awk '{print $1}' | grep -q "i"; then chattr -i "$f" || true; w "OK: chattr -i ${name}"; return 0; fi
  return 1
}
relock_if_needed(){ local f="$1" name="$2" was="$3"; [[ "$was" == "1" ]] && { chattr +i "$f" || true; w "OK: chattr +i ${name}"; }; }

if unlock_if_immutable "$VHOST" "vhost"; then WAS_IMM_VHOST="1"; fi
if [[ -f "$NGINX_MAIN" ]]; then if unlock_if_immutable "$NGINX_MAIN" "nginx.conf"; then WAS_IMM_MAIN="1"; fi; fi
if [[ -f "$INC" ]]; then if unlock_if_immutable "$INC" "include"; then WAS_IMM_INC="1"; fi; fi

say "2) Backups"
backup "$VHOST"
[[ -f "$NGINX_MAIN" ]] && backup "$NGINX_MAIN"
[[ -f "$INC" ]] && backup "$INC"

say "3) Detecter wildcard include dans le VHOST (cause probable du duplicate)"
WILDCARD="$(grep -nE '^\s*include\s+/etc/nginx/includes/\*' "$VHOST" || true)"
if [[ -n "$WILDCARD" ]]; then
  w "DETECT: wildcard include present dans VHOST:"
  w "$WILDCARD"
  MODE="WILDCARD"
else
  MODE="EXPLICITE"
  w "DETECT: aucun wildcard include dans VHOST -> on utilisera include explicite"
fi

say "4) Nettoyer: retirer toute ligne include explicite wolverine_routes.inc partout"
MAP="/root/MEGA_WOLVERINE_NGINX_DEDUP_V4_${TS}.map.txt"
grep -RIl "wolverine_routes\.inc" /etc/nginx 2>/dev/null | sort -u > "$MAP" || true
while read -r f; do [[ -n "$f" ]] || continue; backup "$f"; done < "$MAP"

python3 - <<PY
import re
from pathlib import Path
mapf=Path("$MAP")
files=[Path(p.strip()) for p in mapf.read_text().splitlines() if p.strip()] if mapf.exists() else []
pat=re.compile(r'^\s*include\s+[^;]*wolverine_routes\.inc\s*;\s*$', re.I)
removed=0; touched=0
for f in files:
    try: s=f.read_text(errors="ignore").splitlines(True)
    except Exception: continue
    out=[]; r=0
    for line in s:
        if pat.match(line): r+=1; continue
        out.append(line)
    if r:
        f.write_text("".join(out))
        removed+=r; touched+=1
print(f"OK: removed include-explicite lines={removed} touched_files={touched}")
PY
w "OK: purge include-explicite done"

say "5) Re-ecrire include CANONIQUE: $INC"
cat > "$INC" <<'NGINX'
# --- WOLVERINE ROUTES (CANONIQUE) ---
# Front: /var/www/wolverine (servi sous /wolverine/)
# API TraderOne: 127.0.0.1:3000, exposée sous /wolverine/traderone/api/*

location = /wolverine/sw.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/service-worker.js { add_header Cache-Control "no-store" always; return 404; }
location = /wolverine/manifest.json { add_header Cache-Control "no-store" always; return 404; }

location = /wolverine { return 301 /wolverine/; }

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:3000;
}

location ^~ /wolverine/ {
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}
NGINX
w "OK: include ecrit"

say "6) Gestion inclusion selon MODE"
if [[ "$MODE" == "WILDCARD" ]]; then
  # on NE DOIT PAS ajouter include explicite; le wildcard le chargera déjà
  w "MODE=WILDCARD -> on laisse le wildcard charger $INC 1 seule fois (aucun include explicite ajoute)"
else
  # injecter include explicite 1 seule fois dans le server 443 fireinners.online
  backup "$VHOST"
  python3 - <<PY
import re
from pathlib import Path
v=Path("$VHOST")
s=v.read_text(errors="ignore")
inc_line="include /etc/nginx/includes/wolverine_routes.inc;"

# enleve toute ancienne occurence (sécurité)
s=re.sub(r'^\s*include\s+[^;]*wolverine_routes\.inc\s*;\s*$', '', s, flags=re.I|re.M)

lines=s.splitlines(True)
res=[]; i=0; inserted=False
while i < len(lines):
    line=lines[i]
    if re.match(r'^\s*server\s*\{', line):
        buf=[line]
        depth=line.count("{")-line.count("}")
        i+=1
        listen443=False; server_name_hit=False
        while i < len(lines) and depth>0:
            l2=lines[i]
            if re.search(r'^\s*listen\s+.*443', l2): listen443=True
            if re.search(r'^\s*server_name\s+.*fireinners\.online', l2): server_name_hit=True
            depth += l2.count("{")-l2.count("}")
            buf.append(l2); i+=1
        if listen443 and server_name_hit and not inserted:
            buf.insert(1, "  "+inc_line+"\n")
            inserted=True
        res.extend(buf)
    else:
        res.append(line); i+=1

if not inserted:
    res.append("\n  "+inc_line+"\n")

v.write_text("".join(res))
print("OK: include injected_once=", inserted)
PY
  w "MODE=EXPLICITE -> include injecte 1 fois"
fi

say "7) Permissions front (eviter 403) si dossier existe"
if [[ -d "$FRONT_DIR" ]]; then chmod -R a+rX "$FRONT_DIR" || true; w "OK: chmod a+rX sur $FRONT_DIR"; else w "WARN: $FRONT_DIR absent"; fi

say "8) Verif: où wolverine_routes.inc est inclus (grep)"
{
  echo "---- include wolverine_routes.inc ----"
  grep -Rni "wolverine_routes\.inc" /etc/nginx 2>/dev/null || true
  echo "---- include wildcard /etc/nginx/includes/* ----"
  grep -RniE "include\s+/etc/nginx/includes/\*" /etc/nginx 2>/dev/null || true
} | tee -a "$LOG" >/dev/null

say "9) nginx -t (doit PASS) + reload"
set +e
NT="$(nginx -t 2>&1)"
RC=$?
set -e
echo "$NT" | tee -a "$LOG" >/dev/null
if [[ $RC -ne 0 ]]; then
  w "ERREUR: nginx -t FAIL"
  echo "$NT" | tail -n 160 | tee -a "$LOG" >/dev/null
else
  w "OK: nginx -t PASS"
  systemctl reload nginx
  w "OK: nginx reload"
fi

say "10) Relock immutable si necessaire"
relock_if_needed "$INC" "include" "$WAS_IMM_INC"
relock_if_needed "$VHOST" "vhost" "$WAS_IMM_VHOST"
[[ -f "$NGINX_MAIN" ]] && relock_if_needed "$NGINX_MAIN" "nginx.conf" "$WAS_IMM_MAIN"

say "11) Tests HTTP (local/externe)"
LC="$(curl -k -sS -o /dev/null -w "%{http_code}" "https://127.0.0.1/wolverine/" -H "Host: ${HOST}" || true)"
EC="$(curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}/wolverine/" || true)"
HC="$(curl -sS -o /dev/null -w "%{http_code}" "https://${HOST}/wolverine/traderone/api/health" || true)"
w "LOCAL  /wolverine/ : ${LC}"
w "EXT    /wolverine/ : ${EC}"
w "EXT    /wolverine/traderone/api/health : ${HC}"

{
  echo "LOG=$LOG"
  echo "REPORT=$REPORT"
  echo "MODE=$MODE"
  echo "VHOST=$VHOST"
  echo "INC=$INC"
  echo "RESULT_NGINX_T_RC=$RC"
  echo "LOCAL_CODE=$LC"
  echo "EXT_CODE=$EC"
  echo "HEALTH_CODE=$HC"
  echo "---- nginx -t output ----"
  echo "$NT"
} > "$REPORT"

echo
echo "DONE."
echo "Log   : $LOG"
echo "Report: $REPORT"
BASH

chmod +x /root/MEGA_WOLVERINE_NGINX_DEDUP_V4.sh
bash /root/MEGA_WOLVERINE_NGINX_DEDUP_V4.sh
echo
echo "----- REPORT (tail) -----"
tail -n 240 /root/MEGA_WOLVERINE_NGINX_DEDUP_V4_*.report.txt 2>/dev/null || true
BASH
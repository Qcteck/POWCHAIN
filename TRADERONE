cat >/root/fix_double_include_solana_snip.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
SNIP="/etc/nginx/snippets/solana_rpc_proxy.conf"

echo "== 1) Où le snippet est inclus (nginx -T) =="
nginx -T 2>/dev/null | grep -nF "$SNIP" || true
echo

echo "== 2) Cherche les includes dans les fichiers (sites-enabled / conf.d / snippets) =="
grep -RIn --exclude='*.bak*' --exclude-dir='_saved_*' -F "include $SNIP" \
  /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/snippets 2>/dev/null || true
echo

echo "== 3) Si l'include est en double dans le VHOST ssl, on commente les doublons (garde le 1er) =="
VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
if [[ -f "$VHOST" ]]; then
  cp -a "$VHOST" "${VHOST}.bak_${TS}"
  echo "Backup vhost: ${VHOST}.bak_${TS}"

  # liste des lignes include dans le vhost
  mapfile -t LINES < <(grep -nF "include $SNIP" "$VHOST" | cut -d: -f1 || true)

  if ((${#LINES[@]} <= 1)); then
    echo "OK: include présent 0 ou 1 fois dans $VHOST"
  else
    echo "Doublons trouvés dans $VHOST: ${LINES[*]}"
    first=1
    for ln in "${LINES[@]}"; do
      if (( first==1 )); then first=0; continue; fi
      sed -i "${ln}s@^[[:space:]]*@# DISABLED_DUP_INCLUDE_${TS} @" "$VHOST"
      echo "Commenté: $VHOST:$ln"
    done
  fi
else
  echo "[WARN] Vhost introuvable: $VHOST"
fi

echo
echo "== 4) Test nginx =="
nginx -t

echo
echo "== 5) Reload nginx =="
systemctl reload nginx
echo "DONE ✅"
BASH

chmod +x /root/fix_double_include_solana_snip.sh
/root/fix_double_include_solana_snip.sh
cat >/root/fix_try_files_backslash_fireinners_ssl.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ts="$(date +%Y%m%d_%H%M%S)"

AV="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"

cp -a "$AV" "${AV}.bak_${ts}" 2>/dev/null || true

# Fix les variantes cassées vues (backslash / $ mangé / $ échappé)
sed -i 's@try_files \\ =404;@try_files $uri =404;@g' "$AV"
sed -i 's@try_files  =404;@try_files $uri =404;@g' "$AV"
sed -i 's@try_files \\\$uri =404;@try_files $uri =404;@g' "$AV"

# Assure que sites-enabled pointe bien sur sites-available
ln -sf "$AV" "$EN"

echo "== Show phantom_patch location block =="
grep -n "location = /wolverine/phantom_patch.js" -A6 -B2 "$AV" || true

echo
echo "== nginx test + reload =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
BASH

chmod +x /root/fix_try_files_backslash_fireinners_ssl.sh
/root/fix_try_files_backslash_fireinners_ssl.sh
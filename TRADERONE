cat >/opt/traderone/server.js <<'EOF'
const http = require("http");
const url = require("url");

const PORT = process.env.PORT || 3000;

const server = http.createServer((req,res)=>{
  const { pathname } = url.parse(req.url,true);

  if(pathname==="/health"){
    res.writeHead(200,{"Content-Type":"application/json"});
    return res.end(JSON.stringify({ok:true}));
  }

  if(req.method==="POST" && pathname==="/start"){
    let body="";
    req.on("data",c=>body+=c);
    req.on("end",()=>{
      res.writeHead(200,{"Content-Type":"application/json"});
      res.end(JSON.stringify({started:true,input:body||null}));
    });
    return;
  }

  res.writeHead(200,{"Content-Type":"text/html"});
  res.end(`<!doctype html>
<html><body style="background:#111;color:#eee;font-family:Arial">
<h1>TraderOne LIVE</h1>
<button onclick="go()">START</button>
<pre id="out"></pre>
<script>
async function go(){
 const r=await fetch('/start',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});
 out.textContent=JSON.stringify(await r.json(),null,2);
}
</script>
</body></html>`);
});

server.listen(PORT,"0.0.0.0",()=>console.log("TraderOne LIVE on",PORT));
EOF




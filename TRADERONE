cat >/root/fix_nginx_conf_try_files_exact.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
ts="$(date +%Y%m%d_%H%M%S)"

ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 30

FILE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\1/p' | head -n1)"
LINE="$(echo "$ERR" | sed -n 's/.* in \(\/[^:]*\):\([0-9]\+\).*/\2/p' | head -n1)"

if [[ -z "${FILE:-}" || -z "${LINE:-}" ]]; then
  echo "[ERR] Je n'arrive pas à extraire file:line. Fais: nginx -t 2>&1 | head -n 30"
  exit 1
fi

echo
echo "== Show context: $FILE:$LINE =="
start=$((LINE-8)); ((start<1)) && start=1
end=$((LINE+8))
nl -ba "$FILE" | sed -n "${start},${end}p"

echo
echo "== Backup =="
cp -a "$FILE" "${FILE}.bak_${ts}"

echo
echo "== Fix common broken try_files variants on that file =="
# Corrige: try_files =404; / try_files  =404; / try_files=404; / try_files  = 404;
perl -pi -e 's/^\s*try_files\s*=\s*=404;\s*$/    try_files \$uri =404;/g' "$FILE"
perl -pi -e 's/^\s*try_files\s*=\s*404;\s*$/     try_files \$uri =404;/g' "$FILE"
perl -pi -e 's/^\s*try_files\s+=404;\s*$/        try_files \$uri =404;/g' "$FILE"

echo
echo "== Re-test =="
nginx -t
systemctl reload nginx
echo "[OK] nginx reloaded"
BASH

chmod +x /root/fix_nginx_conf_try_files_exact.sh
/root/fix_nginx_conf_try_files_exact.sh
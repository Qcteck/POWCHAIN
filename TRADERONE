cat >"$VAULT_DIR/server.js" <<'JS'
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");
const express = require("express");
const nacl = require("tweetnacl");
const bs58 = require("bs58");

const PORT = parseInt(process.env.PORT || "8787", 10);
const ORIGIN = process.env.ORIGIN || "https://fireinners.online";
const KEYFILE = process.env.KEYFILE || "/etc/traderone-vault-api.key";
const STATE = process.env.STATE || path.join(__dirname, "state.json");

function now(){ return Date.now(); }

function readKey(){
  const b64 = fs.readFileSync(KEYFILE, "utf8").trim();
  const raw = Buffer.from(b64, "base64");
  if (raw.length !== 32) throw new Error("Bad KEY length (need 32 bytes base64)");
  return raw;
}

const KEY = readKey();

function enc(obj){
  const iv = crypto.randomBytes(12);
  const cipher = crypto.createCipheriv("aes-256-gcm", KEY, iv);
  const pt = Buffer.from(JSON.stringify(obj), "utf8");
  const ct = Buffer.concat([cipher.update(pt), cipher.final()]);
  const tag = cipher.getAuthTag();
  return { iv: iv.toString("base64"), tag: tag.toString("base64"), data: ct.toString("base64") };
}

function dec(payload){
  const iv = Buffer.from(payload.iv, "base64");
  const tag = Buffer.from(payload.tag, "base64");
  const data = Buffer.from(payload.data, "base64");
  const decipher = crypto.createDecipheriv("aes-256-gcm", KEY, iv);
  decipher.setAuthTag(tag);
  const pt = Buffer.concat([decipher.update(data), decipher.final()]);
  return JSON.parse(pt.toString("utf8"));
}

function loadState(){
  try{
    const s = JSON.parse(fs.readFileSync(STATE,"utf8"));
    if (!s || typeof s !== "object") return { vaults:{} };
    if (!s.vaults) s.vaults = {};
    return s;
  } catch(e){
    return { vaults:{} };
  }
}
function saveState(st){
  fs.writeFileSync(STATE, JSON.stringify(st,null,2));
  try{ fs.chmodSync(STATE, 0o600); }catch(_){}
}

const app = express();
app.disable("x-powered-by");
app.use(express.json({ limit: "64kb" }));

// CORS strict
app.use((req,res,next)=>{
  const o = req.headers.origin;
  if (o === ORIGIN) res.setHeader("Access-Control-Allow-Origin", ORIGIN);
  res.setHeader("Vary","Origin");
  res.setHeader("Access-Control-Allow-Methods","GET,POST,OPTIONS");
  res.setHeader("Access-Control-Allow-Headers","content-type");
  if (req.method === "OPTIONS") return res.status(204).end();
  return next();
});

// Rate limit simple (IP)
const RL_WIN_MS = 60_000;
const RL_MAX = 20;
const rl = new Map();
function rateLimit(req,res,next){
  const ip = (req.headers["x-forwarded-for"]||req.socket.remoteAddress||"").toString().split(",")[0].trim();
  const t = now();
  const v = rl.get(ip) || { t0:t, n:0 };
  if (t - v.t0 > RL_WIN_MS){ v.t0 = t; v.n = 0; }
  v.n++;
  rl.set(ip,v);
  if (v.n > RL_MAX) return res.status(429).json({ ok:false, error:"rate_limited" });
  next();
}

function isB58(s){ return typeof s === "string" && s.length>=20 && s.length<=60; }

app.get("/health",(req,res)=> res.json({ ok:true, service:"vault-api", ts: new Date().toISOString() }));

// POST /create : nécessite signature Phantom (anti-abus)
app.post("/create", rateLimit, (req,res)=>{
  try{
    const { userPub, sig, ts } = req.body || {};
    if (!isB58(userPub) || !isB58(sig) || typeof ts !== "number") return res.status(400).json({ ok:false, error:"bad_params" });

    // anti-replay (±5 minutes)
    const dt = Math.abs(now() - ts);
    if (dt > 5*60*1000) return res.status(401).json({ ok:false, error:"stale_ts" });

    const msg = `VAULT_CREATE:${userPub}:${ts}`;
    const pub = bs58.decode(userPub);
    const signature = bs58.decode(sig);
    const ok = nacl.sign.detached.verify(Buffer.from(msg,"utf8"), signature, pub);
    if (!ok) return res.status(401).json({ ok:false, error:"bad_signature" });

    const st = loadState();
    if (st.vaults[userPub]){
      return res.json({ ok:true, userPub, vaultPub: st.vaults[userPub].vaultPub, existing:true });
    }

    const kp = nacl.sign.keyPair();
    const vaultPub = bs58.encode(Buffer.from(kp.publicKey));
    const vaultPriv = bs58.encode(Buffer.from(kp.secretKey));

    // stocke chiffré
    st.vaults[userPub] = {
      vaultPub,
      vaultEnc: enc({ vaultPriv }),
      createdAt: new Date().toISOString()
    };
    saveState(st);

    return res.json({ ok:true, userPub, vaultPub, existing:false });
  } catch(e){
    return res.status(500).json({ ok:false, error:"internal", detail: String(e && e.message || e) });
  }
});

app.listen(PORT, "127.0.0.1", ()=> console.log(`vault-api listening on 127.0.0.1:${PORT}`));
JS


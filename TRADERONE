cat >/root/WOLVERINE_WALLET_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

### CONFIG
ROOT_HTML="/var/www/wolverine/index.html"
RPC="https://api.mainnet-beta.solana.com"
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1"
TS=$(date +%Y%m%d_%H%M%S)

echo "=== WOLVERINE WALLET FIX START ==="

# 1. Backup
cp "$ROOT_HTML" "$ROOT_HTML.bak_$TS"
echo "[OK] Backup created"

# 2. Write clean wallet UI
cat >"$ROOT_HTML" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<title>Wolverine Wallet</title>
<style>
body{margin:0;font-family:Arial;background:#0b0b0b;color:#0ff}
#wallet{max-width:420px;margin:80px auto;padding:20px;border:1px solid #0ff;border-radius:8px}
button{width:100%;padding:12px;background:#0ff;border:0;font-weight:bold;cursor:pointer}
.line{margin-top:10px}
</style>
</head>
<body>

<div id="wallet">
  <button id="connect">Connect Phantom</button>
  <div class="line">Address: <span id="addr">-</span></div>
  <div class="line">SOL: <span id="sol">-</span></div>
  <div class="line">USDC: <span id="usdc">-</span></div>
</div>

<script>
const RPC = "https://api.mainnet-beta.solana.com";
const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1";

async function rpc(method,params){
  const r=await fetch(RPC,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method,params})});
  return (await r.json()).result;
}

document.getElementById("connect").onclick = async ()=>{
  if(!window.solana?.isPhantom){alert("Phantom not found");return;}
  const res = await solana.connect();
  const pub = res.publicKey.toString();
  document.getElementById("addr").textContent = pub;

  const lamports = await rpc("getBalance",[pub]);
  document.getElementById("sol").textContent = (lamports.value/1e9).toFixed(4);

  const tok = await rpc("getParsedTokenAccountsByOwner",[pub,{mint:USDC},{encoding:"jsonParsed"}]);
  let usdc=0;
  tok.value.forEach(v=>usdc+=Number(v.account.data.parsed.info.tokenAmount.uiAmount||0));
  document.getElementById("usdc").textContent = usdc.toFixed(2);
};
</script>

</body>
</html>
HTML

echo "[OK] Wallet UI written"

# 3. Permissions
chown www-data:www-data "$ROOT_HTML"
chmod 644 "$ROOT_HTML"

echo "=== WOLVERINE WALLET FIX DONE ==="
echo "Reload browser with CTRL+SHIFT+R"
BASH

chmod +x /root/WOLVERINE_WALLET_FIX.sh
say "ensure vhost includes bundler_routes.inc (idempotent)"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
[ -f "$VHOST" ] || { say "ERROR: vhost not found: $VHOST"; exit 1; }
grep -q "/etc/nginx/includes/bundler_routes.inc" "$VHOST" || {
  # insert inside server { ... } after first server_name or listen line
  python3 - "$VHOST" <<'"'"'PY'"'"'
import sys,re
p=sys.argv[1]
s=open(p,"r",encoding="utf-8",errors="ignore").read().splitlines(True)
out=[]
in_server=False
inserted=False
depth=0
for ln in s:
  out.append(ln)
  if re.search(r"^\s*server\s*\{", ln):
    in_server=True
    depth=1
    continue
  if in_server:
    depth += ln.count("{")-ln.count("}")
    if not inserted and re.search(r"^\s*(listen|server_name)\b", ln):
      out.append("    include /etc/nginx/includes/bundler_routes.inc;\n")
      inserted=True
    if depth<=0:
      in_server=False
open(p,"w",encoding="utf-8").write("".join(out))
print("OK injected include into",p)
PY

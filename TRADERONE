cat >/tmp/WOLVERINE_FULL_FIX_BALANCES.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
export SYSTEMD_PAGER=cat PAGER=cat

DOMAIN="fireinners.online"
WOLV_PATH="/wolverine"
DOCROOT="/var/www/wolverine"
SERVER_JS="/opt/traderone-opt/server.js"
PORT="8585"

echo "============================================================"
echo " WOLVERINE - FULL FIX BALANCES (SOL + USDC) + FRONT PRECISION"
echo "============================================================"
echo

echo "== 0) Status / version / ports =="
node -v || true
systemctl status traderone.service --no-pager -l | sed -n '1,80p' || true
echo
ss -ltnp | egrep "(node|:${PORT})" || true
echo

echo "== 1) Ask wallet (full publickey) =="
read -r -p "Wallet Phantom (PUBLICKEY COMPLET) : " WALLET
if [ -z "${WALLET:-}" ]; then
  echo "ERROR: wallet vide"; exit 1
fi
echo

echo "== 2) Tests API (avant patch) =="
echo "--- local http://127.0.0.1:${PORT}/api/balances?wallet=... ---"
curl -sS "http://127.0.0.1:${PORT}/api/balances?wallet=$WALLET" ; echo
echo
echo "--- public https://${DOMAIN}${WOLV_PATH}/traderone/api/balances?wallet=... ---"
curl -ks "https://${DOMAIN}${WOLV_PATH}/traderone/api/balances?wallet=$WALLET" ; echo
echo

echo "== 3) Patch backend: USDC = SOMME de tous les token accounts (et pas le 1er) =="
if [ ! -f "$SERVER_JS" ]; then
  echo "ERROR: server.js introuvable: $SERVER_JS"; exit 1
fi
if ! grep -q "WOLVERINE_BALANCES_API" "$SERVER_JS"; then
  echo "ERROR: snippet WOLVERINE_BALANCES_API introuvable dans server.js"; exit 1
fi

cp -a "$SERVER_JS" "$SERVER_JS.bak.$(date +%s)"

# Patch: si on détecte un bloc usdc basé sur v[0], on remplace par une somme.
perl -0777 -i -pe '
s/let usdc = 0;\s*const v = \(tokRes && tokRes\.value\) \|\| \[\];\s*if \(v\.length\) \{\s*usdc = v\[0\]\?\.\s*account\?\.\s*data\?\.\s*parsed\?\.\s*info\?\.\s*tokenAmount\?\.\s*uiAmount\s*\?\?\s*0;\s*\}\s*/let usdc = 0;\n    const v = (tokRes && tokRes.value) || [];\n    for (const a of v) {\n      const amt = a?.account?.data?.parsed?.info?.tokenAmount?.uiAmount ?? 0;\n      usdc += Number(amt) || 0;\n    }\n/sm
' "$SERVER_JS" || true

systemctl restart traderone.service
sleep 1
echo "OK backend restarted"
echo

echo "== 4) Tests API (après patch backend) =="
echo "--- local ---"
curl -sS "http://127.0.0.1:${PORT}/api/balances?wallet=$WALLET" ; echo
echo
echo "--- public ---"
curl -ks "https://${DOMAIN}${WOLV_PATH}/traderone/api/balances?wallet=$WALLET" ; echo
echo

echo "== 5) Patch front precision (SOL 6 décimales / USDC 4) + cache-bust =="
APPJS="$DOCROOT/app.js"
INDEX="$DOCROOT/index.html"

if [ -f "$APPJS" ]; then
  cp -a "$APPJS" "$APPJS.bak.$(date +%s)"
  sed -i 's/toFixed(4)/toFixed(6)/g; s/toFixed(2)/toFixed(4)/g' "$APPJS"
  echo "app.js precision patched"
else
  echo "WARN: app.js introuvable dans $DOCROOT (skip precision patch)"
fi

TS="$(date +%s)"
if [ -f "$INDEX" ]; then
  cp -a "$INDEX" "$INDEX.bak.$TS"
  # cache-bust: remplace app.js ou app.js?v=...
  sed -i -E "s|(app\.js)(\?v=[0-9]+)?|\\1?v=$TS|g" "$INDEX" || true
  echo "index.html cache-bust done: v=$TS"
else
  echo "WARN: index.html introuvable dans $DOCROOT (skip cache-bust)"
fi

nginx -t && systemctl reload nginx
echo "nginx reloaded"
echo

echo "== 6) Preuves (live) =="
echo "--- curl app.js contient solanaWeb3 ? (doit être NON) ---"
curl -ks "https://${DOMAIN}${WOLV_PATH}/app.js" | grep -n "solanaWeb3" && echo "BAD" || echo "OK ✅"
echo "--- curl balances public ---"
curl -ks "https://${DOMAIN}${WOLV_PATH}/traderone/api/balances?wallet=$WALLET" ; echo
echo
echo "DONE ✅  -> ouvre /wolverine en navigation privée, Connect Phantom, Refresh balances"
SH

bash /tmp/WOLVERINE_FULL_FIX_BALANCES.sh
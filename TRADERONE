#!/usr/bin/env bash
set -euo pipefail

JS="/var/www/aiaquila/aiaquila-rss.js"
BACKUP="$JS.backup_$(date +%Y%m%d_%H%M%S)"

echo "=== AIAQUILA RSS REAL FIX ==="
cp "$JS" "$BACKUP"
echo "Backup: $BACKUP"

cat > "$JS" <<'JS'
/* ===== AIAQUILA RSS + TTS FINAL ===== */

const FEEDS = [
  "https://www.coingecko.com/rss/news",
  "https://cryptopanic.com/feed",
  "https://news.bitcoin.com/feed/"
];

const PROXY = "/aiaquila/rss-proxy.php?url=";
let ARTICLES = [];

function log(m){
  const l = document.getElementById("logs");
  if(l){ l.textContent += m + "\n"; l.scrollTop = l.scrollHeight; }
}

/* === TTS NATIF === */
function speak(text){
  if(!speechSynthesis){ log("TTS non supporté"); return; }
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = "fr-FR";
  speechSynthesis.speak(u);
}

async function loadRSS(){
  ARTICLES = [];
  log("Chargement RSS…");

  for(const feed of FEEDS){
    try{
      const res = await fetch(PROXY + encodeURIComponent(feed));
      const xml = await res.text();
      log("Flux reçu: " + feed + " (" + xml.length + " chars)");

      const doc = new DOMParser().parseFromString(xml, "text/xml");

      const items = [
        ...doc.querySelectorAll("item"),
        ...doc.querySelectorAll("entry")
      ];

      items.forEach(it=>{
        const title =
          it.querySelector("title")?.textContent ||
          it.querySelector("summary")?.textContent || "";
        if(title) ARTICLES.push(title.trim());
      });
    }catch(e){
      log("Erreur flux: " + feed);
    }
  }

  log("Articles détectés: " + ARTICLES.length);

  if(ARTICLES.length){
    speak("Voici les dernières nouvelles crypto. " +
      ARTICLES.slice(0,5).join(". "));
  }else{
    speak("Aucun article détecté.");
  }
}

document.addEventListener("DOMContentLoaded", ()=>{
  document.getElementById("loadRSS")?.addEventListener("click", loadRSS);
  log("AIAQUILA prêt. Clique pour lire.");
});
JS

chmod 644 "$JS"
nginx -t && systemctl reload nginx

echo "=== PATCH OK ==="
echo "Ctrl+F5 puis clique « Charger les articles »"
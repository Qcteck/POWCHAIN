<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaStacking</title><meta name="description" content="AquilaStacking — Staking dashboard (frontend)"><style>:root{--bg:#070b12;--panel:#0b1020;--panel2:#0e1630;--txt:#e7eefc;--mut:#9fb0d2;--ok:#18f5a2;--bad:#ff4d6d;--warn:#ffcc00;--line:rgba(255,255,255,.08);--blue:#2b6fff;--cyan:#4de0ff}*{box-sizing:border-box}html,body{height:100%}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:radial-gradient(1200px 800px at 20% -10%,rgba(77,224,255,.18),transparent 55%),radial-gradient(900px 700px at 90% 0%,rgba(43,111,255,.20),transparent 55%),linear-gradient(180deg,#05060a,#070b12 35%,#05060a);color:var(--txt)}a{color:var(--cyan);text-decoration:none}a:hover{text-decoration:underline}button,input,select{font:inherit}code{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}header{position:sticky;top:0;z-index:20;background:linear-gradient(180deg,rgba(7,11,18,.92),rgba(7,11,18,.72));backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}.wrap{max-width:1120px;margin:0 auto;padding:14px 14px}.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between}.brand{display:flex;gap:10px;align-items:center}.logo{width:34px;height:34px;border-radius:10px;background:radial-gradient(circle at 30% 30%,rgba(77,224,255,.8),rgba(43,111,255,.6) 45%,rgba(11,16,32,.9) 70%);box-shadow:0 0 0 1px rgba(255,255,255,.08) inset,0 10px 35px rgba(0,0,0,.55)}.brand h1{margin:0;font-size:15px;letter-spacing:.3px}.brand .sub{margin:0;color:var(--mut);font-size:12px}.pill{display:inline-flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--line);border-radius:14px;background:rgba(11,16,32,.65)}.dot{width:9px;height:9px;border-radius:999px;background:var(--warn);box-shadow:0 0 0 3px rgba(255,204,0,.15)}.dot.ok{background:var(--ok);box-shadow:0 0 0 3px rgba(24,245,162,.14)}.dot.bad{background:var(--bad);box-shadow:0 0 0 3px rgba(255,77,109,.18)}.kv{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.k{color:var(--mut);font-size:12px}.v{font-size:12px}.btn{border:1px solid var(--line);background:linear-gradient(180deg,rgba(14,22,48,.9),rgba(11,16,32,.9));color:var(--txt);padding:10px 12px;border-radius:14px;cursor:pointer;transition:transform .08s ease,filter .08s ease,border-color .08s ease}.btn:hover{filter:brightness(1.08);border-color:rgba(77,224,255,.35)}.btn:active{transform:translateY(1px)}.btn.primary{background:linear-gradient(180deg,rgba(43,111,255,.95),rgba(14,22,48,.92));border-color:rgba(43,111,255,.55)}.btn.danger{background:linear-gradient(180deg,rgba(255,77,109,.9),rgba(14,22,48,.92));border-color:rgba(255,77,109,.55)}.btn.ghost{background:rgba(11,16,32,.55)}.grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px;margin-top:14px}@media(max-width:980px){.grid{grid-template-columns:1fr}}.card{border:1px solid var(--line);border-radius:18px;background:linear-gradient(180deg,rgba(11,16,32,.78),rgba(7,11,18,.78));box-shadow:0 10px 35px rgba(0,0,0,.45);overflow:hidden}.card .hd{padding:14px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px}.card .hd .t{font-weight:650;font-size:13px}.card .hd .s{color:var(--mut);font-size:12px}.card .bd{padding:14px}.cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}@media(max-width:560px){.cols{grid-template-columns:1fr}}.field{display:flex;flex-direction:column;gap:6px}.field label{color:var(--mut);font-size:12px}.in{border:1px solid var(--line);background:rgba(14,22,48,.55);color:var(--txt);border-radius:14px;padding:10px 12px;outline:none}.in:focus{border-color:rgba(77,224,255,.5);box-shadow:0 0 0 3px rgba(77,224,255,.12)}.mini{font-size:12px;color:var(--mut)}.table{width:100%;border-collapse:separate;border-spacing:0 8px}.tr{background:rgba(14,22,48,.45);border:1px solid var(--line);border-radius:14px}.tr td{padding:10px 12px;font-size:12px}.badge{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:999px;border:1px solid var(--line);background:rgba(11,16,32,.65);font-size:11px;color:var(--mut)}.badge.ok{border-color:rgba(24,245,162,.35);color:#b8ffe6}.badge.bad{border-color:rgba(255,77,109,.35);color:#ffd0d9}.badge.warn{border-color:rgba(255,204,0,.35);color:#fff2b3}.log{height:240px;overflow:auto;border:1px solid var(--line);background:rgba(11,16,32,.65);border-radius:16px;padding:10px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:11px;color:#dbe7ff;white-space:pre-wrap}.mut{color:var(--mut)}.split{display:flex;gap:10px;flex-wrap:wrap}.split .btn{flex:1;min-width:160px}.foot{padding:14px 14px;color:var(--mut);font-size:12px;border-top:1px solid var(--line)}.hint{padding:10px 12px;border:1px dashed rgba(77,224,255,.35);border-radius:14px;background:rgba(77,224,255,.07);color:#cfefff;font-size:12px}</style></head><body><header><div class="wrap"><div class="row"><div class="brand"><div class="logo" aria-hidden="true"></div><div><h1>AquilaStacking</h1><p class="sub">Dashboard staking (frontend) — routes /iaaquila/ + /aquila_stacking/</p></div></div><div class="kv"><span class="pill"><span id="netDot" class="dot"></span><span class="k">Status</span><span id="netTxt" class="v">OFFLINE</span></span><span class="pill"><span class="k">Cluster</span><span id="clusterTxt" class="v">devnet</span></span><span class="pill"><span class="k">Program</span><span id="pidTxt" class="v">UNKNOWN</span></span><button class="btn ghost" id="btnCopyUrl">Copier URL</button><button class="btn primary" id="btnRefresh">Refresh</button></div></div></div></header><main class="wrap"><div class="grid"><section class="card"><div class="hd"><div><div class="t">Pool / Vault</div><div class="s">Config frontend (Pool ID, mints, PDA)</div></div><span class="badge warn" id="cfgBadge">NON CONFIG</span></div><div class="bd"><div class="cols"><div class="field"><label>Pool ID (Pubkey)</label><input class="in" id="poolId" placeholder="Ex: 9x... (base58)" autocomplete="off"></div><div class="field"><label>Program ID (Pubkey)</label><input class="in" id="programId" placeholder="Ex: Aq... (base58)" autocomplete="off"></div><div class="field"><label>Stake Mint (token à staker)</label><input class="in" id="stakeMint" placeholder="Mint base58" autocomplete="off"></div><div class="field"><label>Reward Mint (récompense)</label><input class="in" id="rewardMint" placeholder="Mint base58" autocomplete="off"></div><div class="field"><label>RPC (lecture)</label><input class="in" id="rpcUrl" placeholder="https://..." autocomplete="off"></div><div class="field"><label>Decimals (stake)</label><input class="in" id="stakeDec" placeholder="ex: 6" inputmode="numeric"></div></div><div class="split" style="margin-top:12px"><button class="btn" id="btnSave">Sauvegarder</button><button class="btn danger" id="btnReset">Reset</button></div><div class="hint" style="margin-top:12px">Cette page est un frontend. Pour un staking réel on-chain, il faut un programme Anchor complet + un IDL + un backend (ou un wallet adapter) pour signer les transactions.</div></div><div class="foot"><span class="mut">Stockage:</span> localStorage (<code>AQUILA_STACKING_CFG_V1</code>)</div></section><aside class="card"><div class="hd"><div><div class="t">Actions (UI)</div><div class="s">Simulation UI + hooks future TX</div></div><span class="badge" id="walletBadge">WALLET: OFF</span></div><div class="bd"><div class="cols"><div class="field"><label>Wallet (adresse)</label><input class="in" id="wallet" placeholder="Coller une pubkey pour test" autocomplete="off"></div><div class="field"><label>Montant à staker</label><input class="in" id="amount" placeholder="ex: 100" inputmode="decimal"></div></div><div class="split" style="margin-top:12px"><button class="btn primary" id="btnStake">Stake</button><button class="btn" id="btnUnstake">Unstake</button><button class="btn" id="btnClaim">Claim</button></div><div style="margin-top:12px" class="cols"><div class="field"><label>Stake (UI)</label><div class="pill" style="justify-content:space-between"><span class="k">Balance</span><span class="v" id="uiStakeBal">—</span></div></div><div class="field"><label>Rewards (UI)</label><div class="pill" style="justify-content:space-between"><span class="k">Accrued</span><span class="v" id="uiRewardBal">—</span></div></div></div><div style="margin-top:12px"><div class="badge warn">TX non branchées</div><div class="mini" style="margin-top:6px">Les boutons écrivent seulement dans le log. Une fois branché: Phantom/Wallet Adapter + web3.js + IDL + instructions Anchor.</div></div></div><div class="foot"><span class="mut">Routes:</span> <a href="/iaaquila/">/iaaquila/</a> · <a href="/aquila_stacking/">/aquila_stacking/</a></div></aside></div><section class="card" style="margin-top:14px"><div class="hd"><div><div class="t">Log</div><div class="s">Diagnostics (Nginx / config / actions)</div></div><div class="split"><button class="btn" id="btnClear">Clear</button><button class="btn ghost" id="btnCopyLog">Copier</button></div></div><div class="bd"><div id="log" class="log"></div></div><div class="foot"><span class="mut">Debug header attendu:</span> <code>X-AquilaStacking: 1</code></div></section></main><script>(()=>{"use strict";const $=s=>document.querySelector(s);const LS="AQUILA_STACKING_CFG_V1";const logEl=$("#log");const netDot=$("#netDot");const netTxt=$("#netTxt");const cfgBadge=$("#cfgBadge");const pidTxt=$("#pidTxt");const clusterTxt=$("#clusterTxt");const walletBadge=$("#walletBadge");const uiStakeBal=$("#uiStakeBal");const uiRewardBal=$("#uiRewardBal");const cfgFields={poolId:$("#poolId"),programId:$("#programId"),stakeMint:$("#stakeMint"),rewardMint:$("#rewardMint"),rpcUrl:$("#rpcUrl"),stakeDec:$("#stakeDec")};const walletEl=$("#wallet"),amtEl=$("#amount");const btnSave=$("#btnSave"),btnReset=$("#btnReset"),btnRefresh=$("#btnRefresh"),btnCopyUrl=$("#btnCopyUrl"),btnStake=$("#btnStake"),btnUnstake=$("#btnUnstake"),btnClaim=$("#btnClaim"),btnClear=$("#btnClear"),btnCopyLog=$("#btnCopyLog");function ts(){const d=new Date();return d.toISOString().replace("T"," ").replace("Z","");}function push(m){logEl.textContent+=`[${ts()}] ${m}\n`;logEl.scrollTop=logEl.scrollHeight;}function setStatus(ok,msg){netDot.classList.remove("ok","bad");if(ok===true){netDot.classList.add("ok");netTxt.textContent=msg||"ONLINE";}else if(ok===false){netDot.classList.add("bad");netTxt.textContent=msg||"OFFLINE";}else{netTxt.textContent=msg||"UNKNOWN";}}function loadCfg(){try{const raw=localStorage.getItem(LS);if(!raw)return null;return JSON.parse(raw);}catch(e){return null;}}function saveCfg(o){localStorage.setItem(LS,JSON.stringify(o));}function applyCfg(c){if(!c)return;Object.keys(cfgFields).forEach(k=>{if(c[k]!=null)cfgFields[k].value=String(c[k]);});if(c.cluster)clusterTxt.textContent=c.cluster;pidTxt.textContent=(c.programId||"UNKNOWN").trim()||"UNKNOWN";}function readCfg(){const c={};Object.keys(cfgFields).forEach(k=>c[k]=cfgFields[k].value.trim());c.cluster=clusterTxt.textContent.trim()||"devnet";return c;}function cfgOk(c){return !!(c&&c.poolId&&c.programId&&c.stakeMint&&c.rewardMint&&c.rpcUrl);};function refreshBadges(){const c=readCfg();const ok=cfgOk(c);cfgBadge.className="badge "+(ok?"ok":"warn");cfgBadge.textContent=ok?"CONFIG OK":"NON CONFIG";pidTxt.textContent=c.programId||"UNKNOWN";}async function checkHeader(){try{const r=await fetch(location.href,{method:"HEAD",cache:"no-store"});const h=(r.headers.get("x-aquilastacking")||"");const ok=h==="1";setStatus(ok,ok?"ONLINE":"OFFLINE");push(`HEAD ${r.status} (X-AquilaStacking=${h||"null"})`);}catch(e){setStatus(false,"OFFLINE");push(`HEAD error: ${e&&e.message?e.message:String(e)}`);} }function randUI(){const s=Math.max(0,Math.random()*1000);const r=Math.max(0,Math.random()*50);uiStakeBal.textContent=s.toFixed(4);uiRewardBal.textContent=r.toFixed(6);}function setWalletBadge(){const w=walletEl.value.trim();walletBadge.className="badge "+(w?"ok":"");walletBadge.textContent="WALLET: "+(w?"ON":"OFF");}btnSave.onclick=()=>{const c=readCfg();saveCfg(c);push("CFG saved to localStorage");refreshBadges();};btnReset.onclick=()=>{localStorage.removeItem(LS);Object.values(cfgFields).forEach(i=>i.value="");push("CFG reset");refreshBadges();};btnRefresh.onclick=async()=>{refreshBadges();setWalletBadge();await checkHeader();randUI();};btnCopyUrl.onclick=async()=>{try{await navigator.clipboard.writeText(location.href);push("URL copied");}catch(e){push("Clipboard blocked");}};btnClear.onclick=()=>{logEl.textContent="";push("Log cleared");};btnCopyLog.onclick=async()=>{try{await navigator.clipboard.writeText(logEl.textContent);push("Log copied");}catch(e){push("Clipboard blocked");}};[walletEl,amtEl,...Object.values(cfgFields)].forEach(el=>el.addEventListener("input",()=>{refreshBadges();setWalletBadge();}));function requireCfg(){const c=readCfg();if(!cfgOk(c)){push("BLOCK: config incomplete (Pool/Program/Mints/RPC)");return null;}return c;}function requireWallet(){const w=walletEl.value.trim();if(!w){push("BLOCK: wallet missing");return null;}return w;}function amountU(){const a=(amtEl.value||"").trim();const n=Number(a);if(!isFinite(n)||n<=0){push("BLOCK: invalid amount");return null;}return n;}btnStake.onclick=()=>{const c=requireCfg();if(!c)return;const w=requireWallet();if(!w)return;const a=amountU();if(a==null)return;push(`STAKE (UI) wallet=${w} amount=${a} pool=${c.poolId}`);};btnUnstake.onclick=()=>{const c=requireCfg();if(!c)return;const w=requireWallet();if(!w)return;const a=amountU();if(a==null)return;push(`UNSTAKE (UI) wallet=${w} amount=${a} pool=${c.poolId}`);};btnClaim.onclick=()=>{const c=requireCfg();if(!c)return;const w=requireWallet();if(!w)return;push(`CLAIM (UI) wallet=${w} pool=${c.poolId}`);};(function init(){push("AquilaStacking UI boot");const c=loadCfg();if(c){applyCfg(c);push("CFG loaded");}refreshBadges();setWalletBadge();checkHeader();randUI();})();})();</script></body></html>
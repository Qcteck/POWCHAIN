rm -f /root/WV_FIX404.sh /root/WV_FIX404_V2.sh; python3 - <<'PY'
p='/root/WV_FIX404_V2.sh'
s=r'''#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
DOMAIN="fireinners.online"
VHOST_AV="/etc/nginx/sites-available/fireinners.online-ssl"
VHOST_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
WEBROOT="/var/www/wolverine"
SRC1="/opt/fireinners/frontend-react/app/dist/wolverine"
SRC2="/opt/wolverine"
BK="/root/WV_FIX404_BK_${TS}"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
need_root(){ [ "$(id -u)" = "0" ] || { echo "need root"; exit 1; }; }

backup_all(){
  say "BACKUP -> $BK"
  mkdir -p "$BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
  mkdir -p "$BK/webroot"
  cp -a "$WEBROOT" "$BK/webroot/" 2>/dev/null || true
}

unfreeze_nginx(){
  command -v chattr >/dev/null 2>&1 || return 0
  say "Unfreeze chattr -i (best-effort)"
  chattr -i -R /etc/nginx 2>/dev/null || true
}

ensure_webroot(){
  say "Ensure webroot: $WEBROOT"
  mkdir -p "$WEBROOT"
  if [ -d "$SRC1" ] && [ -f "$SRC1/index.html" ]; then
    say "Sync from $SRC1 -> $WEBROOT"
    rsync -a --delete "$SRC1/" "$WEBROOT/" || true
  elif [ -d "$SRC2" ] && [ -f "$SRC2/index.html" ]; then
    say "Sync from $SRC2 -> $WEBROOT"
    rsync -a --delete "$SRC2/" "$WEBROOT/" || true
  fi
  if [ ! -f "$WEBROOT/index.html" ]; then
    say "Create minimal index.html (missing)"
    cat >"$WEBROOT/index.html"<<'HTML'
<!doctype html><meta charset="utf-8"><title>WOLVERINE</title><h1>WOLVERINE OK</h1><p>index.html created by WV_FIX404_V2</p>
HTML
  fi
  chown -R www-data:www-data "$WEBROOT" 2>/dev/null || true
}

write_include(){
  say "Write include: $INC"
  mkdir -p "$(dirname "$INC")"
  cat >"$INC"<<EOF
# AUTO-GENERATED canonical Wolverine routes (${TS})
location ^~ /wolverine/ {
  alias ${WEBROOT}/;
  try_files \$uri \$uri/ /wolverine/index.html;
}
location ^~ /wolverine/vendor/ {
  alias ${WEBROOT}/vendor/;
  try_files \$uri =404;
}
EOF
}

disable_other_wolverine_includes(){
  say "Disable other wolverine includes/snippets (best-effort)"
  shopt -s nullglob
  for f in /etc/nginx/includes/wolverine* /etc/nginx/snippets/wolverine*; do
    [ "$f" = "$INC" ] && continue
    case "$f" in
      *.disabled_* ) continue;;
    esac
    mv -f "$f" "$f.disabled_${TS}" 2>/dev/null || true
  done
  shopt -u nullglob
}

ensure_vhost_enabled(){
  [ -f "$VHOST_AV" ] || { echo "FATAL missing $VHOST_AV"; exit 1; }
  ln -sf "$VHOST_AV" "$VHOST_EN"
}

python_edit_vhost(){
python3 - <<'PY'
import re
p="/etc/nginx/sites-available/fireinners.online-ssl"
inc="/etc/nginx/includes/wolverine_routes.inc"
txt=open(p,'r',encoding='utf-8',errors='ignore').read().splitlines(True)

def strip_wolverine_locations(lines):
    out=[]
    i=0
    def starts_loc(line):
        return re.search(r'^\s*location\b.*wolverine', line) is not None
    while i<len(lines):
        line=lines[i]
        if starts_loc(line):
            depth=0
            while i<len(lines):
                depth += lines[i].count('{')
                depth -= lines[i].count('}')
                i+=1
                if depth<=0: break
            continue
        if re.search(r'^\s*include\s+.*wolverine.*;', line):
            i+=1
            continue
        out.append(line); i+=1
    return out

def inject_include_into_first_443_server(lines):
    out=[]
    i=0
    inserted=False
    while i<len(lines):
        line=lines[i]
        if re.match(r'^\s*server\s*\{', line):
            # capture server block
            depth=0
            block=[]
            j=i
            while j<len(lines):
                l=lines[j]
                depth += l.count('{')
                depth -= l.count('}')
                block.append(l)
                j+=1
                if depth==0: break
            btxt=''.join(block)
            if (not inserted) and re.search(r'^\s*listen\s+443', btxt, re.M):
                if inc in btxt:
                    out.extend(block)
                else:
                    # insert before closing brace
                    closing=block[-1]
                    body=block[:-1]
                    body.append(f"    include {inc};\n")
                    out.extend(body+[closing])
                inserted=True
            else:
                out.extend(block)
            i=j
            continue
        out.append(line); i+=1
    return out, inserted

lines=strip_wolverine_locations(txt)
lines, ok=inject_include_into_first_443_server(lines)
open(p,'w',encoding='utf-8').write(''.join(lines))
print("inserted" if ok else "not_inserted")
PY
}

disable_duplicate_fireinners_vhosts(){
  say "Disable duplicate enabled vhosts with server_name fireinners.online (excluding main) (best-effort)"
  shopt -s nullglob
  for f in /etc/nginx/sites-enabled/*; do
    [ "$f" = "$VHOST_EN" ] && continue
    if grep -RqsE 'server_name[[:space:]].*fireinners\.online' "$f"; then
      mv -f "$f" "$f.disabled_${TS}" 2>/dev/null || true
    fi
  done
  shopt -u nullglob
}

nginx_reload(){
  say "nginx -t"
  nginx -t
  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx
}

tests(){
  say "TEST HEAD /wolverine/"
  curl -skI "https://${DOMAIN}/wolverine/" | sed -n '1,20p' || true
  say "TEST first bytes /wolverine/"
  curl -sk "https://${DOMAIN}/wolverine/" | head -c 200; echo || true
  say "FILES $WEBROOT"
  ls -la "$WEBROOT" | sed -n '1,40p' || true
  echo "OPEN: https://${DOMAIN}/wolverine/  (Ctrl+F5)"
  echo "BACKUP: $BK"
}

main(){
  need_root
  backup_all
  unfreeze_nginx
  ensure_webroot
  write_include
  disable_other_wolverine_includes
  ensure_vhost_enabled
  disable_duplicate_fireinners_vhosts
  python_edit_vhost
  nginx_reload
  tests
}
main "$@"
'''
open(p,'w',encoding='utf-8').write(s)
PY
chmod +x /root/WV_FIX404_V2.sh
bash /root/WV_FIX404_V2.sh
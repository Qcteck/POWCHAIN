#!/bin/bash
set -e

UI="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
BK="$UI.bak.$(date +%s)"

echo "=== WOLVERINE • PATCH COULEURS MAUVE / ROSE / VIOLET / TURQUOISE ==="

echo "[1/4] Backup"
cp "$UI" "$BK"

echo "[2/4] Inject CSS palette"
node <<'NODE'
const fs=require("fs");
let s=fs.readFileSync(process.env.UI||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html","utf8");
if(s.includes("--violet-1")){console.log("Palette déjà présente");process.exit(0);}
const css=`
<style>
:root{
--bg:#0b1020;
--mauve:#8b5cf6;
--violet:#6d28d9;
--rose:#ec4899;
--turquoise:#2dd4bf;
--txt:#e9ecff;
--muted:#b8c0ff;
--glass:rgba(255,255,255,.06);
}
html,body{background:
radial-gradient(900px 500px at 20% 0%,rgba(139,92,246,.25),transparent 60%),
radial-gradient(700px 450px at 80% 20%,rgba(45,212,191,.22),transparent 55%),
var(--bg);color:var(--txt);}
h1,h2{background:linear-gradient(90deg,var(--mauve),var(--rose),var(--turquoise));
-webkit-background-clip:text;background-clip:text;color:transparent}
.card,.panel{background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.03));
border:1px solid rgba(139,92,246,.25);box-shadow:0 20px 60px rgba(0,0,0,.35);backdrop-filter:blur(10px)}
.btn{background:linear-gradient(135deg,var(--violet),var(--mauve));
border:1px solid rgba(236,72,153,.35);color:#fff;box-shadow:0 10px 30px rgba(139,92,246,.45)}
.btn:hover{filter:brightness(1.1)}
.btn.alt{background:linear-gradient(135deg,var(--rose),var(--turquoise))}
.input{background:var(--glass);border:1px solid rgba(45,212,191,.35);color:var(--txt)}
.sep{height:1px;background:linear-gradient(90deg,transparent,var(--mauve),var(--rose),var(--turquoise),transparent)}
.stat b{color:var(--turquoise)}
</style>
`;
s=s.replace(/<\/head>/i,css+"\n</head>");
fs.writeFileSync(process.env.UI||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html",s);
console.log("Palette injectée");
NODE

echo "[3/4] Reload nginx"
nginx -t && systemctl reload nginx

echo "[4/4] DONE"
echo "Backup: $BK"
#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA RSS — TRUTH FIX (NO ASSUMPTIONS) ==="

AIA_DIR="/var/www/fireinners.online/aiaquila"
INDEX="$AIA_DIR/index.html"
BACKUP="$AIA_DIR/index.backup.$(date +%Y%m%d_%H%M%S).html"

# === STEP 1: DEMANDE URL WORKER ===
echo
echo "⚠️ ENTRE L'URL PUBLIQUE EXACTE DU WORKER (ex: https://xxxx.workers.dev)"
read -r WORKER_URL

if [[ ! "$WORKER_URL" =~ ^https:// ]]; then
  echo "❌ URL invalide"
  exit 1
fi

# === STEP 2: TEST WORKER DIRECT ===
echo
echo "=== TEST WORKER DIRECT (curl) ==="
RESP="$(curl -s "$WORKER_URL?url=https://news.bitcoin.com/feed/" || true)"

echo "$RESP" | head -c 300
echo

if echo "$RESP" | grep -q "<html"; then
  echo "❌ LE WORKER RENVOIE DU HTML (MAUVAIS ENDPOINT)"
  exit 1
fi

if ! echo "$RESP" | grep -q "title"; then
  echo "❌ LE WORKER NE RENVOIE PAS DE JSON RSS"
  exit 1
fi

echo "✔ Worker OK — JSON détecté"

# === STEP 3: BACKUP ===
cp "$INDEX" "$BACKUP"
echo "✔ Backup: $BACKUP"

# === STEP 4: FRONTEND ULTRA MINIMAL (DEBUG MODE) ===
cat > "$INDEX" <<HTML
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA — DEBUG RSS</title>
<style>
body{background:#0b1b3a;color:#fff;font-family:system-ui;padding:20px}
button{padding:10px;font-size:15px}
pre{white-space:pre-wrap;font-size:13px;margin-top:15px}
</style>
</head>
<body>
<h2>🦅 AIAQUILA — DEBUG RSS</h2>
<button onclick="go()">TEST RSS</button>
<pre id="out">En attente…</pre>

<script>
const WORKER = "$WORKER_URL";

async function go(){
  const out=document.getElementById("out");
  out.textContent="FETCH → "+WORKER+"\\n\\n";
  try{
    const r=await fetch(WORKER+"?url=https://news.bitcoin.com/feed/");
    const t=await r.text();
    out.textContent+=t;
  }catch(e){
    out.textContent+="ERROR: "+e.message;
  }
}
</script>
</body>
</html>
HTML

# === STEP 5: PERMS + RELOAD ===
chown -R www-data:www-data "$AIA_DIR"
chmod -R 755 "$AIA_DIR"
nginx -t && systemctl reload nginx

echo
echo "=== FIN ==="
echo "➡️ Ouvre https://fireinners.online/aiaquila/"
echo "➡️ Clique TEST RSS"
echo "➡️ LE CONTENU AFFICHE EST LA VERITE ABSOLUE"
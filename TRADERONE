<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>JARVIS • RSS + X (sans API) • Pump.fun • Phantom</title>
  <style>
    :root{
      --p:#ff2cf7; --c:#19f7ff; --g:#39ff14; --y:#ffe600; --r:#ff3b3b;
      --t:#f4fbff; --bg:#05060b;
      --glass:linear-gradient(180deg,rgba(0,0,0,.52),rgba(0,0,0,.24));
      --b:rgba(25,247,255,.22); --b2:rgba(255,44,247,.18);
      --shadow:0 0 0 2px rgba(25,247,255,.10),0 0 0 2px rgba(255,44,247,.08) inset,0 30px 90px rgba(0,0,0,.65);
    }
    html,body{height:100%;margin:0;background:
      radial-gradient(1400px 900px at 68% 24%, rgba(255,44,247,.20) 0%,
      rgba(25,247,255,.12) 26%, rgba(5,6,11,1) 55%, rgba(0,0,0,1) 100%);
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Cantarell,Helvetica,Arial,sans-serif;color:var(--t)}
    *{box-sizing:border-box}
    button{
      border:2px solid rgba(25,247,255,.32);
      background:linear-gradient(180deg,rgba(25,247,255,.12),rgba(255,44,247,.10),rgba(0,0,0,.26));
      color:var(--t); border-radius:14px; padding:12px 12px;
      font-weight:1100; letter-spacing:.10em; text-transform:uppercase;
      font-size:12px; cursor:pointer;
      box-shadow:0 0 24px rgba(25,247,255,.10),0 0 22px rgba(255,44,247,.08);
      user-select:none;
    }
    button:hover{border-color:rgba(255,230,0,.90)}
    button.on{border-color:rgba(57,255,20,.85); box-shadow:0 0 30px rgba(57,255,20,.14),0 0 28px rgba(25,247,255,.10)}
    button.bad{border-color:rgba(255,59,59,.75)}
    button.dim{opacity:.55}
    button[disabled]{opacity:.45;cursor:not-allowed}
    input,textarea{
      border:2px solid rgba(255,230,0,.22);
      background:rgba(0,0,0,.35); color:var(--t);
      border-radius:14px; padding:12px; font-weight:900;
      outline:none; font-size:14px; width:100%;
    }
    textarea{min-height:120px; resize:vertical; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}
    input:focus,textarea:focus{border-color:rgba(255,230,0,.90)}
    .chip{
      border:2px solid rgba(25,247,255,.18); background:rgba(0,0,0,.25);
      border-radius:999px; padding:8px 12px;
      font-size:12px; letter-spacing:.12em; text-transform:uppercase;
      font-weight:1100; color:rgba(244,251,255,.92);
      white-space:nowrap;
    }
    .chip.good{border-color:rgba(57,255,20,.30)}
    .chip.warn{border-color:rgba(255,230,0,.22)}
    .chip.bad{border-color:rgba(255,59,59,.26)}
    #app{
      height:100dvh;height:100vh;
      display:flex;flex-direction:column;
      padding:calc(12px + env(safe-area-inset-top)) 12px calc(12px + env(safe-area-inset-bottom)) 12px;
      gap:12px;min-height:0;
    }
    #top{
      display:flex;align-items:center;justify-content:space-between;gap:12px; flex-wrap:wrap;
      border:2px solid rgba(25,247,255,.22);
      background:linear-gradient(180deg,rgba(255,44,247,.18),rgba(25,247,255,.12),rgba(0,0,0,.22));
      backdrop-filter:blur(10px);
      border-radius:16px;
      padding:12px 14px;
      box-shadow:var(--shadow);
    }
    #brand{display:flex;align-items:center;gap:14px;min-width:0}
    #logo{
      width:52px;height:52px;border-radius:50%;
      background:
        radial-gradient(circle at 40% 35%,#ffffff 0 12%,var(--y) 13% 22%,var(--c) 23% 38%,var(--p) 39% 62%,rgba(0,0,0,0) 63%),
        conic-gradient(from 190deg,rgba(255,44,247,.52),rgba(25,247,255,.10),rgba(57,255,20,.42),rgba(255,230,0,.22),rgba(255,44,247,.52));
      box-shadow:0 0 38px rgba(255,44,247,.26),0 0 34px rgba(25,247,255,.20),inset 0 0 18px rgba(255,230,0,.16);
      position:relative;flex:0 0 auto;
    }
    #logo:before{
      content:"";position:absolute;inset:-7px;border-radius:50%;
      border:2px dashed rgba(25,247,255,.45);
      filter:drop-shadow(0 0 14px rgba(25,247,255,.18));
      animation:spin 7.5s linear infinite;
    }
    @keyframes spin{to{transform:rotate(360deg)}}
    #title{line-height:1.1;min-width:0}
    #title b{letter-spacing:.16em;font-weight:1200;font-size:18px;white-space:nowrap}
    #title small{
      display:block;color:rgba(244,251,255,.78);
      letter-spacing:.14em;text-transform:uppercase;font-size:12px;margin-top:4px;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:70vw;
    }

    #capsRow{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;align-items:center}
    #statusRow{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;align-items:center}

    #main{flex:1;display:grid;grid-template-columns:560px 1fr;gap:12px;min-height:0}
    #left,#right{
      border:2px solid rgba(25,247,255,.18); background:var(--glass);
      backdrop-filter:blur(10px); border-radius:16px; box-shadow:var(--shadow);
      overflow:hidden; min-height:0; position:relative;
    }
    .scan{
      position:absolute;inset:0;pointer-events:none;
      background:linear-gradient(180deg,rgba(255,44,247,.12),rgba(0,0,0,0) 35%,rgba(25,247,255,.10) 70%,rgba(0,0,0,0));
      mix-blend-mode:screen;animation:scan 3.2s linear infinite;opacity:.75;
    }
    @keyframes scan{0%{transform:translateY(-65%)}100%{transform:translateY(65%)}}
    .hd{padding:14px;border-bottom:2px solid rgba(25,247,255,.10);display:flex;align-items:center;justify-content:space-between;gap:12px}
    .hd b{letter-spacing:.16em;text-transform:uppercase;font-size:13px}
    .hd span{color:rgba(244,251,255,.78);font-weight:1100}

    #states{
      padding:14px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;border-bottom:2px solid rgba(25,247,255,.10);
      background:linear-gradient(180deg,rgba(0,0,0,.22),rgba(0,0,0,0));
    }
    #states .box{border:2px solid rgba(255,230,0,.10);border-radius:14px;background:rgba(0,0,0,.18);padding:10px}
    #states .box b{display:block;letter-spacing:.14em;text-transform:uppercase;font-size:11px;color:rgba(244,251,255,.78)}
    #states .box span{display:block;margin-top:6px;font-weight:1100;color:rgba(244,251,255,.94);word-break:break-word}

    #rssBox{padding:14px;overflow:auto;min-height:0}
    #rssBox .it{
      border:2px solid rgba(255,230,0,.12); border-radius:14px;background:rgba(0,0,0,.18);
      padding:10px;margin-bottom:10px; display:flex;gap:12px;align-items:flex-start;justify-content:space-between;
    }
    #rssBox .it span{font-weight:1000;font-size:13px;line-height:1.25;color:rgba(244,251,255,.92)}
    #rssBox .it small{display:block;color:rgba(244,251,255,.68);font-size:12px;margin-top:6px;letter-spacing:.08em}

    #right{display:flex;flex-direction:column;min-height:0}
    #log{
      flex:1;padding:14px;overflow:auto;
      font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
      font-size:13px;line-height:1.4;
    }
    .m{margin:10px 0;padding:10px 12px;border-radius:14px;border:2px solid rgba(25,247,255,.10);background:rgba(25,247,255,.04);white-space:pre-wrap;word-break:break-word}
    .m.ai{border-left:5px solid rgba(25,247,255,.80)}
    .m.user{border-left:5px solid rgba(255,44,247,.70)}
    .m.sys{border-left:5px solid rgba(255,230,0,.70)}
    .m.warn{border-left:5px solid rgba(255,59,59,.70); background:rgba(255,59,59,.06)}
    .row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
    .grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}

    #quick{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;padding:14px;border-top:2px solid rgba(25,247,255,.10)}
    #sendRow{display:flex;gap:12px;padding:14px;border-top:2px solid rgba(25,247,255,.10)}
    #sendRow input{flex:1}

    /* overlay confirmation */
    #overlay{
      position:fixed; inset:0; display:none; align-items:center; justify-content:center;
      background:rgba(0,0,0,.68); z-index:50; padding:18px;
    }
    #card{
      width:min(940px,100%); max-height:85vh; overflow:auto;
      border:2px solid rgba(57,255,20,.20);
      background:linear-gradient(180deg,rgba(0,0,0,.72),rgba(0,0,0,.44));
      border-radius:16px; box-shadow:0 0 40px rgba(0,0,0,.60);
      padding:14px;
    }
    #card h3{margin:0 0 8px 0; letter-spacing:.14em; text-transform:uppercase; font-size:14px}
    #card .meta{color:rgba(244,251,255,.75); font-weight:900; letter-spacing:.08em; margin-bottom:12px}
    #card pre{
      margin:0; padding:12px; border-radius:14px;
      border:2px solid rgba(25,247,255,.14); background:rgba(0,0,0,.35);
      white-space:pre-wrap; word-break:break-word;
      font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    }
    #card .btns{display:flex; gap:12px; flex-wrap:wrap; margin-top:12px}
    #card .btns button{flex:1; min-width:180px}

    @media(max-width:1200px){
      #main{grid-template-columns:1fr}
      #quick{grid-template-columns:repeat(2,minmax(0,1fr))}
      #states{grid-template-columns:1fr}
      #card .btns button{min-width:140px}
    }
    ::-webkit-scrollbar{width:12px}
    ::-webkit-scrollbar-thumb{background:linear-gradient(180deg,rgba(255,44,247,.30),rgba(25,247,255,.22));border:2px solid rgba(0,0,0,.25);border-radius:999px}
    ::-webkit-scrollbar-track{background:rgba(0,0,0,.22)}
  </style>
</head>
<body>
<div id="overlay">
  <div id="card">
    <h3 id="ovTitle">CONFIRMATION</h3>
    <div class="meta" id="ovMeta">—</div>
    <pre id="ovBody">—</pre>
    <div class="btns">
      <button id="ovYes" class="on">CONFIRMER</button>
      <button id="ovAlt">ALTERNATIVE</button>
      <button id="ovNo" class="bad">REFUSER</button>
    </div>
  </div>
</div>

<div id="app">
  <div id="top">
    <div id="brand">
      <div id="logo"></div>
      <div id="title">
        <b>JARVIS • RSS → ARTICLE → DÉCISION → X</b>
        <small>Sans API X: copie + ouvre X. Pump.fun + Phantom: actions avec confirmation.</small>
      </div>
    </div>

    <div class="row" style="margin-left:auto;justify-content:flex-end">
      <div id="capsRow">
        <button id="capRSS" class="on">CAP RSS</button>
        <button id="capART" class="on">CAP ARTICLE</button>
        <button id="capDEC" class="on">CAP DÉCISION</button>
        <button id="capLEARN" class="on">CAP APPRENDRE</button>
        <button id="capWAL" class="on">CAP WALLET</button>
        <button id="capPUMP" class="on">CAP PUMP.FUN</button>
        <button id="capX" class="on">CAP X</button>
      </div>
      <div id="statusRow">
        <span class="chip good" id="modeChip">MODE: BOOT</span>
        <span class="chip" id="netChip">NET: —</span>
        <span class="chip warn" id="qChip">Q: —</span>
        <span class="chip bad" id="errChip">ERR: 0.0%</span>
        <span class="chip" id="clock">--:--:--</span>
        <button id="btnVoice">VOIX OFF</button>
        <button id="btnNext">PROCHAIN TITRE</button>
        <button id="btnReset" class="bad">RESET</button>
      </div>
    </div>
  </div>

  <div id="main">
    <div id="left">
      <div class="scan"></div>
      <div class="hd"><b>ÉTATS (toujours visibles)</b><span id="rssStat">—</span></div>

      <div id="states">
        <div class="box"><b>Conscience (mode)</b><span id="st_state">—</span></div>
        <div class="box"><b>Environnement</b><span id="st_env">—</span></div>
        <div class="box"><b>Capacités actives</b><span id="st_caps">—</span></div>
        <div class="box"><b>Qualité article</b><span id="st_q">—</span></div>
        <div class="box"><b>Apprentissage</b><span id="st_learn">—</span></div>
        <div class="box"><b>RSS sélectionné</b><span id="st_rss">—</span></div>
      </div>

      <div class="hd"><b>Titres RSS (1–12)</b><span id="st_feed">—</span></div>
      <div id="rssBox"></div>
    </div>

    <div id="right">
      <div class="scan"></div>
      <div class="hd"><b>Discussion</b><span id="discStat">—</span></div>

      <div id="log"></div>
      <div id="quick"></div>

      <div id="sendRow">
        <input id="in" placeholder="Réponds ici (ou clique un bouton)">
        <button id="send">ENVOYER</button>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  "use strict";

  const $ = s => document.querySelector(s);
  const esc = s => String(s).replace(/[&<>"']/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
  const now = () => new Date().toLocaleTimeString("fr-CA",{hour12:false});
  const KEY = "jarvis_rss_x_pump_wallet_v1";

  let S = null;
  let audioUnlocked = JSON.parse(localStorage.getItem("jarvis_audio_unlocked") || "false");

  const log = $("#log"), quick = $("#quick"), rssBox = $("#rssBox");
  const rssStat = $("#rssStat"), discStat = $("#discStat");
  const clockEl = $("#clock"), inEl = $("#in");

  const modeChip = $("#modeChip"), netChip = $("#netChip"), errChip = $("#errChip"), qChip = $("#qChip");

  const st_state = $("#st_state"), st_env = $("#st_env"), st_caps = $("#st_caps"), st_q = $("#st_q");
  const st_learn = $("#st_learn"), st_rss = $("#st_rss"), st_feed = $("#st_feed");

  const overlay = $("#overlay"), ovTitle = $("#ovTitle"), ovMeta = $("#ovMeta"), ovBody = $("#ovBody");
  const ovYes = $("#ovYes"), ovNo = $("#ovNo"), ovAlt = $("#ovAlt");

  const capBtns = {
    rss: $("#capRSS"),
    article: $("#capART"),
    decision: $("#capDEC"),
    learn: $("#capLEARN"),
    wallet: $("#capWAL"),
    pump: $("#capPUMP"),
    x: $("#capX")
  };

  const save = () => localStorage.setItem(KEY, JSON.stringify(S));
  const load = () => {
    try { S = JSON.parse(localStorage.getItem(KEY) || "null"); } catch(e){ S = null; }
    if(!S || typeof S !== "object"){
      S = {
        prefs:{ voice:false, lang:"fr-CA", sarcasm:true, auto:true },
        caps:{ rss:true, article:true, decision:true, learn:true, wallet:true, pump:true, x:true },
        rss:[
          "https://www.coindesk.com/arc/outboundfeeds/rss/",
          "https://cointelegraph.com/rss",
          "https://decrypt.co/feed"
        ],
        items:[],
        pick:0,
        selected:null,
        article:{ url:null, title:null, text:null, summary:null, tags:[], sent:null, q:0, paywall:false, domain:"" },
        wallet:{ connected:false, pub:"" },
        learn:{
          rules:[
            "RSS = base permanente de discussion",
            "1 question à la fois",
            "Décision = proposition + confirmation obligatoire"
          ],
          facts:[],
          experiments:[],
          sourceScore:{} // domain -> {ok,fail,qavg}
        },
        errors:{ events:[], window:240, rate:0, last:"—" },
        state:{ mode:"BOOT", confidence:98.5, last:"INIT" },
        pending:{ action:null } // action confirm overlay
      };
      save();
    }
  };

  const sarcasm = (a,b) => S.prefs.sarcasm ? a : b;

  const speak = t => {
    if(!S.prefs.voice || !audioUnlocked || !window.speechSynthesis) return;
    try{
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(String(t||""));
      u.lang = S.prefs.lang || "fr-CA";
      u.rate = 1.03; u.pitch = .98; u.volume = 1;
      window.speechSynthesis.speak(u);
    }catch(e){}
  };

  const add = (who, txt, cls="ai") => {
    const d = document.createElement("div");
    d.className = "m " + cls;
    d.innerHTML = `
      <div style="display:flex;justify-content:space-between;gap:12px;color:rgba(244,251,255,.70);font-size:12px;margin-bottom:8px;letter-spacing:.10em;text-transform:uppercase;font-weight:1100">
        <span>${esc(who)}</span><span>${esc(now())}</span>
      </div>
      <div>${esc(txt)}</div>`;
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
    renderStates();
    renderQuick();
  };

  const pushErr = msg => {
    S.errors.events.push({t:Date.now(), m:String(msg||"ERR")});
    S.errors.events = S.errors.events.slice(-S.errors.window);
    const n = S.errors.events.length;
    const errCount = S.errors.events.filter(x => x.m).length;
    S.errors.rate = Math.round((errCount / Math.max(1,n)) * 1000)/10;
    S.errors.last = String(msg||"—");
    if(S.errors.rate >= 3){
      S.state.mode = "ALERTE";
      S.state.confidence = Math.max(85, S.state.confidence - 2);
    }
    save();
    renderStates();
  };

  window.addEventListener("error", ev => pushErr(ev.message || "JS error"));
  window.addEventListener("unhandledrejection", ev => pushErr(String(ev.reason || "Promise")));

  const openConfirm = ({title, meta, body, onYes, onNo, onAlt, altLabel}) => {
    S.pending.action = { onYes, onNo, onAlt };
    save();
    ovTitle.textContent = title || "CONFIRMATION";
    ovMeta.textContent = meta || "—";
    ovBody.textContent = body || "—";
    ovAlt.textContent = altLabel || "ALTERNATIVE";
    overlay.style.display = "flex";

    ovYes.onclick = () => {
      overlay.style.display = "none";
      const a = S.pending.action; S.pending.action = null; save();
      if(a && typeof a.onYes === "function") a.onYes();
    };
    ovNo.onclick = () => {
      overlay.style.display = "none";
      const a = S.pending.action; S.pending.action = null; save();
      if(a && typeof a.onNo === "function") a.onNo();
    };
    ovAlt.onclick = () => {
      overlay.style.display = "none";
      const a = S.pending.action; S.pending.action = null; save();
      if(a && typeof a.onAlt === "function") a.onAlt();
    };
  };

  const toggleCap = (k) => {
    S.caps[k] = !S.caps[k];
    save();
    renderCaps();
    add("SYS", `CAP ${k.toUpperCase()} => ${S.caps[k] ? "ON" : "OFF"}`, "sys");
  };

  const renderCaps = () => {
    Object.entries(capBtns).forEach(([k,btn]) => {
      btn.classList.toggle("on", !!S.caps[k]);
      btn.classList.toggle("dim", !S.caps[k]);
    });
  };

  const parseDate = (s) => {
    const d = new Date(s);
    return isNaN(d.getTime()) ? 0 : d.getTime();
  };

  const domainOf = (u) => {
    try { return (new URL(u)).hostname.replace(/^www\./,""); } catch(e){ return ""; }
  };

  const cleanText = (t) => {
    t = String(t||"").replace(/\r/g,"");
    t = t.replace(/[ \t]+\n/g,"\n").replace(/\n{3,}/g,"\n\n");
    t = t.replace(/^\s+|\s+$/g,"");
    return t;
  };

  // fetch with fallbacks (no API keys)
  const fetchText = async (url) => {
    const tries = [
      "https://api.allorigins.win/raw?url=" + encodeURIComponent(url),
      "https://r.jina.ai/http://" + url.replace(/^https?:\/\//i,""),
      "https://r.jina.ai/https://" + url.replace(/^https?:\/\//i,"")
    ];
    let last = null;
    for(const u of tries){
      try{
        const r = await fetch(u, {cache:"no-store"});
        if(!r.ok) throw new Error("HTTP "+r.status);
        const t = await r.text();
        if(t && t.trim().length > 120) return t;
      }catch(e){ last = e; }
    }
    throw (last || new Error("fetch failed"));
  };

  const parseRSS = (txt) => {
    const xml = new DOMParser().parseFromString(txt, "text/xml");
    let items = [...xml.querySelectorAll("item")].slice(0, 60).map(it => ({
      title: (it.querySelector("title")?.textContent || "").trim(),
      link: (it.querySelector("link")?.textContent || "").trim(),
      pub: (it.querySelector("pubDate")?.textContent || "").trim()
    }));
    if(items.length) return items;
    items = [...xml.querySelectorAll("entry")].slice(0, 60).map(en => ({
      title: (en.querySelector("title")?.textContent || "").trim(),
      link: (en.querySelector("link")?.getAttribute("href") || en.querySelector("link")?.textContent || "").trim(),
      pub: (en.querySelector("updated")?.textContent || en.querySelector("published")?.textContent || "").trim()
    }));
    return items;
  };

  // Readability-like (pure JS heuristic)
  const extractMainText = (raw, url="") => {
    const isHTML = /<\/(html|body|p|div|article|main)>/i.test(raw) || /<p[\s>]/i.test(raw);
    let text = "";
    let paywall = false;

    const domain = domainOf(url);

    if(!isHTML){
      text = cleanText(raw);
    } else {
      let html = raw;

      // quick paywall hints in raw
      const pwHints = /(subscribe|subscription|sign in|log in|paywall|metered|cookies|consent|enable javascript)/i;
      if(pwHints.test(html)) paywall = true;

      // strip scripts/styles
      html = html
        .replace(/<script[\s\S]*?<\/script>/gi,"")
        .replace(/<style[\s\S]*?<\/style>/gi,"")
        .replace(/<!--[\s\S]*?-->/g,"")
        .replace(/<noscript[\s\S]*?<\/noscript>/gi,"")
        .replace(/<svg[\s\S]*?<\/svg>/gi,"")
        .replace(/<iframe[\s\S]*?<\/iframe>/gi,"");

      // parse DOM
      const doc = new DOMParser().parseFromString(html, "text/html");

      // remove nav/aside/footer/headers, common junk
      const kill = ["nav","aside","footer","header","form","button","input","select","textarea"];
      kill.forEach(tag => doc.querySelectorAll(tag).forEach(n=>n.remove()));
      // remove common classes/ids
      const badSel = [
        "[class*='cookie']","[id*='cookie']","[class*='consent']","[id*='consent']",
        "[class*='subscribe']","[id*='subscribe']","[class*='paywall']","[id*='paywall']",
        "[class*='newsletter']","[id*='newsletter']",
        "[class*='share']","[id*='share']"
      ];
      badSel.forEach(sel => doc.querySelectorAll(sel).forEach(n=>n.remove()));

      // candidate containers
      const candidates = [];
      const nodes = [...doc.querySelectorAll("article, main, section, div")];
      for(const n of nodes){
        const p = n.querySelectorAll("p").length;
        const li = n.querySelectorAll("li").length;
        const a = n.querySelectorAll("a").length;
        const txt = (n.textContent||"").replace(/\s+/g," ").trim();
        if(txt.length < 400) continue;

        const punct = (txt.match(/[.!?]/g)||[]).length;
        const score = (txt.length * 0.002) + (p*2.2) + (li*1.1) + (punct*0.25) - (a*0.9);

        candidates.push({node:n, score, txtLen:txt.length, p, li, a});
      }

      candidates.sort((x,y)=>y.score-x.score);
      const best = candidates[0]?.node || doc.body;

      // build plain text with paragraph + list structure
      const parts = [];
      const paras = [...best.querySelectorAll("h1,h2,h3,p,li")];
      for(const el of paras){
        const t = (el.textContent||"").replace(/\s+/g," ").trim();
        if(t.length < 40) continue;
        if(el.tagName.toLowerCase()==="li") parts.push("• "+t);
        else parts.push(t);
      }
      text = cleanText(parts.join("\n\n"));
    }

    // Quality score Q
    const plain = text || "";
    const len = plain.length;
    const paras = plain.split("\n\n").filter(x=>x.trim().length>0).length;
    const linksHint = (raw.match(/href=/gi)||[]).length;
    const pw2 = /(subscribe|subscription|sign in|log in|paywall|metered|enable javascript)/i.test(plain);
    if(pw2) paywall = true;

    let q = 0;
    q += Math.min(50, Math.round(len / 120));
    q += Math.min(25, paras * 2);
    q += Math.max(0, 15 - Math.min(15, Math.round(linksHint/30)));
    if(paywall) q = Math.min(q, 35);
    q = Math.max(0, Math.min(100, q));

    return {text, q, paywall, domain};
  };


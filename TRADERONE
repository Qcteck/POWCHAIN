import re, os, time

inc = "/etc/nginx/includes/wolverine_static.inc"

with open(inc, "r", encoding="utf-8", errors="replace") as f:
    lines = f.readlines()

# Match any "location ... /aquilatrader" or "/aquilatrader/"
loc_re = re.compile(r'^\s*location\s+([^;{]*\s+)?/aquilatrader/?\b')

def find_blocks(lines):
    blocks=[]
    i=0
    while i < len(lines):
        if loc_re.search(lines[i]):
            # parse braces to find end of this location block
            depth = 0
            started = False
            j = i
            while j < len(lines):
                ln = lines[j]
                # count braces (simple but effective for nginx)
                opens = ln.count("{")
                closes = ln.count("}")
                if opens:
                    started = True
                    depth += opens
                depth -= closes
                if started and depth <= 0:
                    blocks.append((i, j))
                    i = j + 1
                    break
                j += 1
            else:
                # if malformed, just treat single line
                blocks.append((i, i))
                i += 1
        else:
            i += 1
    return blocks

blocks = find_blocks(lines)

stamp = time.strftime("%Y%m%d_%H%M%S")
prefix = f"# DISABLED_DUP_AQUILATRADER_{stamp} "

disabled = 0
new = lines[:]

# Comment out ALL existing aquilatrader location blocks (to eliminate duplicates safely)
for (a,b) in blocks:
    disabled += 1
    for k in range(a, b+1):
        ln = new[k]
        if ln.strip()=="":
            continue
        if ln.lstrip().startswith("#"):
            new[k] = prefix + ln
        else:
            new[k] = prefix + ln

# Append canonical managed block
canonical = []
canonical.append("\n# --- AQUILATRADER (managed) ---\n")
canonical.append("location = /aquilatrader { return 301 /aquilatrader/; }\n")
canonical.append("location ^~ /aquilatrader/ {\n")
canonical.append("  alias /var/www/aquilatrader/;\n")
canonical.append("  try_files $uri $uri/ /aquilatrader/index.html;\n")
canonical.append('  add_header Cache-Control "no-store" always;\n')
canonical.append("}\n")
canonical.append("# --- /AQUILATRADER ---\n")

new.extend(canonical)

tmp = inc + ".tmp_aquilatrader"
with open(tmp, "w", encoding="utf-8") as f:
    f.writelines(new)
os.replace(tmp, inc)

print(f"Disabled existing aquilatrader blocks: {disabled}")
print("Injected canonical managed AquilaTrader routes.")

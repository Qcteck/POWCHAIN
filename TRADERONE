#!/bin/bash

# Nom du fichier HTML de l’UI Wolverine
HTML="/var/www/wolverine/index.html"

# Sauvegarde avec horodatage
cp "$HTML" "${HTML}.backup.$(date +%Y%m%d_%H%M%S)"

# Ajout des menus cliquables et correction du Connect Phantom
sed -i '/<\/aside>/i \
<script> \
document.querySelectorAll("[data-view]").forEach(btn => { \
  btn.onclick = () => { \
    document.querySelectorAll(".view").forEach(v => v.classList.remove("active")); \
    document.getElementById(btn.dataset.view).classList.add("active"); \
  }; \
}); \
const walletBtn = document.getElementById("connectWallet"); \
if (walletBtn) { \
  walletBtn.onclick = async () => { \
    if (!window.solana || !window.solana.isPhantom) { alert("Phantom non installé"); return; } \
    try { \
      const resp = await window.solana.connect(); \
      walletBtn.innerText = "Connecté"; \
      walletBtn.disabled = true; \
    } catch (e) { alert("Connexion refusée"); } \
  }; \
} \
</script>' "$HTML"

# Rechargement d’Nginx pour appliquer les changements
nginx -t && systemctl reload nginx

echo "Mises à jour appliquées avec succès."
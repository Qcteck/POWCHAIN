# ROOT — Brancher tout le profil utilisateur au backend (scope user)
set -e

SRC="/opt/_wolverine_next_src"
DIST="/var/www/wolverine"

echo "=== 1) Helper API ==="
cat > "$SRC/lib/backend.js" <<'JS'
export async function api(path, method="GET", body=null) {
  const r = await fetch(`/wolverine/traderone/api/${path}`, {
    method,
    headers: { "Content-Type":"application/json" },
    body: body ? JSON.stringify(body) : null
  });
  const t = await r.text();
  try { return JSON.parse(t); } catch { return t; }
}
JS

echo "=== 2) Profile (scope user) ==="
cat > "$SRC/components/ProfilePanel.jsx" <<'JSX'
import { useEffect, useState } from "react";
import { api } from "../lib/backend";

export default function ProfilePanel({ wallet }) {
  const [me, setMe] = useState(null);
  useEffect(()=>{ api("me").then(setMe); }, []);
  if (!me) return <div className="muted">Loading profile…</div>;
  return (
    <div className="card">
      <h3>Profile</h3>
      <div>ID: {me.id}</div>
      <div>Status: {me.status}</div>
      <div>Role: {me.role}</div>
      <div>Wallet: {wallet || me.wallet}</div>
    </div>
  );
}
JSX

echo "=== 3) Trading data (user) ==="
cat > "$SRC/components/TradingPanel.jsx" <<'JSX'
import { useEffect, useState } from "react";
import { api } from "../lib/backend";

export default function TradingPanel() {
  const [orders,setOrders]=useState([]);
  const [positions,setPositions]=useState([]);
  const [pnl,setPnl]=useState(null);

  useEffect(()=>{
    api("orders").then(setOrders);
    api("positions").then(setPositions);
    api("pnl").then(setPnl);
  },[]);

  return (
    <div className="card">
      <h3>Trading</h3>
      <div className="muted small">PnL</div><pre>{JSON.stringify(pnl,null,2)}</pre>
      <div className="muted small">Positions</div><pre>{JSON.stringify(positions,null,2)}</pre>
      <div className="muted small">Open orders</div><pre>{JSON.stringify(orders,null,2)}</pre>
    </div>
  );
}
JSX

echo "=== 4) Actions autorisées (user) ==="
cat > "$SRC/components/ActionsPanel.jsx" <<'JSX'
import { api } from "../lib/backend";

export default function ActionsPanel({ wallet }) {
  async function run(p) {
    const r = await api(p,"POST", wallet?{wallet}:null);
    alert(JSON.stringify(r,null,2));
  }
  return (
    <div className="card">
      <h3>Actions</h3>
      <div className="btnRow">
        <button className="btn" onClick={()=>run("sync-deposit")}>Sync deposit</button>
        <button className="btn" onClick={()=>run("trader/start")}>Start trader</button>
        <button className="btn" onClick={()=>run("trader/pause")}>Pause trader</button>
        <button className="btn danger" onClick={()=>run("trader/stop")}>Stop trader</button>
      </div>
    </div>
  );
}
JSX


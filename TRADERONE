bash -lc 'cat >/root/MEGA_DEMELE_WOLV_AQ.sh <<'"'"'SH'"'"'
#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
TS="$(date +%Y%m%d_%H%M%S)"
DOMAIN="fireinners.online"
NGX="/etc/nginx"
WWW="/var/www"
WOLV_DIR="$WWW/wolverine"
WOLV_INDEX="$WOLV_DIR/index.html"
WOLV_INC="$NGX/includes/wolverine_routes.inc"
BK="/root/BK_DEMELE_WOLV_AQ_${TS}"
BK_TAR="$BK/nginx_${TS}.tgz"

say(){ echo "[$(date -u +%F\ %T\ UTC)] $*"; }

mkdir -p "$BK"
say "BACKUP: $BK_TAR"
tar -C /etc -czf "$BK_TAR" nginx

# best-effort unfreeze nginx files
if command -v chattr >/dev/null 2>&1; then
  say "UNFREEZE chattr -i (best effort)"
  chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
  chattr -i /etc/nginx/sites-available/* 2>/dev/null || true
  chattr -i /etc/nginx/sites-enabled/* 2>/dev/null || true
  chattr -i /etc/nginx/includes/* 2>/dev/null || true
  chattr -i /etc/nginx/snippets/* 2>/dev/null || true
fi

# find vhost that serves fireinners.online
VHOST=""
for d in "$NGX/sites-enabled" "$NGX/sites-available"; do
  [ -d "$d" ] || continue
  while IFS= read -r -d "" f; do
    if grep -Eq "server_name[^;]*\\b${DOMAIN//./\\.}\\b" "$f" 2>/dev/null; then VHOST="$f"; break; fi
  done < <(find "$d" -maxdepth 1 -type f -print0 2>/dev/null || true)
  [ -n "$VHOST" ] && break
done
if [ -z "$VHOST" ] && [ -f "$NGX/sites-available/${DOMAIN}-ssl" ]; then VHOST="$NGX/sites-available/${DOMAIN}-ssl"; fi
if [ -z "$VHOST" ] && [ -f "$NGX/sites-available/${DOMAIN}-ssl.conf" ]; then VHOST="$NGX/sites-available/${DOMAIN}-ssl.conf"; fi
if [ -z "$VHOST" ] && [ -f "$NGX/sites-available/fireinners.online-ssl" ]; then VHOST="$NGX/sites-available/fireinners.online-ssl"; fi

if [ -z "$VHOST" ] || [ ! -f "$VHOST" ]; then
  say "ERROR: cannot find vhost containing server_name $DOMAIN"
  say "HINT: grep -R \"server_name.*$DOMAIN\" -n $NGX/sites-*"
  exit 1
fi
say "VHOST: $VHOST"
cp -a "$VHOST" "$BK/$(basename "$VHOST").bak" 2>/dev/null || true
cp -a "$NGX/nginx.conf" "$BK/nginx.conf.bak" 2>/dev/null || true

say "STEP 1) DEMELE AIAQUILA: disable AIAQUILA snippets/includes + remove their includes in vhosts"

# 1A) Comment out any include lines mentioning aiaquila anywhere under /etc/nginx
python3 - <<'PY'
import os,re,glob
root="/etc/nginx"
paths=[]
for pat in ["**/*.conf","**/*.inc","**/*ssl*","nginx.conf","sites-available/*","sites-enabled/*"]:
    paths += glob.glob(os.path.join(root,pat), recursive=True)
seen=set()
targets=[]
for p in paths:
    if not os.path.isfile(p): 
        continue
    rp=os.path.realpath(p)
    if rp in seen: 
        continue
    seen.add(rp)
    targets.append(p)
rx=re.compile(r'^\s*include\s+[^;]*aiaquila[^;]*;\s*$', re.I)
for p in sorted(targets):
    try:
        with open(p,"r",encoding="utf-8",errors="ignore") as f: lines=f.readlines()
    except: 
        continue
    changed=False
    out=[]
    for line in lines:
        if rx.search(line) and not line.lstrip().startswith("#"):
            out.append("# DISABLED_DEMELE_AQ " + line)
            changed=True
        else:
            out.append(line)
    if changed:
        with open(p,"w",encoding="utf-8") as f: f.writelines(out)
PY

# 1B) Move AIAQUILA snippet/include files out of the way (safe: only if not already disabled)
for f in $(find "$NGX" -maxdepth 3 -type f \( -name "*aiaquila*.conf" -o -name "*aiaquila*.inc" \) 2>/dev/null || true); do
  bn="$(basename "$f")"
  if [[ "$bn" == *.disabled_* ]]; then continue; fi
  say "DISABLE FILE: $f"
  cp -a "$f" "$BK/$bn.bak" 2>/dev/null || true
  mv "$f" "${f}.disabled_${TS}" 2>/dev/null || true
done

# 1C) Also remove duplicate AIAQUILA locations if they still exist somewhere else
# (we do not parse; we just ensure no aiaquila files are still included)
say "AIAQUILA GREP (should be minimal):"
grep -RIn "aiaquila" "$NGX" 2>/dev/null | head -n 50 || true

say "STEP 2) ENSURE /var/www/wolverine/index.html"
mkdir -p "$WOLV_DIR"
cat >"$WOLV_INDEX" <<EOF
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WOLVERINE</title><style>body{font-family:system-ui,Segoe UI,Roboto,Arial;background:#0b0f14;color:#e6eef8;margin:0}main{padding:26px}a{color:#7ab7ff}h1{margin:0 0 12px;font-size:28px}</style></head><body><main><h1>WOLVERINE OK</h1><p>Si tu vois cette page, <b>/wolverine/</b> sert bien le webroot.</p><p><a href="/wolverine/traderone/api/health">/wolverine/traderone/api/health</a><br><a href="/wolverine/traderone/vault/health">/wolverine/traderone/vault/health</a><br><a href="/wolverine/vault-api/health">/wolverine/vault-api/health</a></p></main></body></html>
EOF

say "STEP 3) WRITE wolverine include (locations only)"
mkdir -p "$NGX/includes"
cat >"$WOLV_INC" <<'EOF'
# wolverine routes (managed)
location = /wolverine { return 301 /wolverine/; }

# static app
location ^~ /wolverine/ {
  root /var/www;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store" always;
}

# backend 3000 (vault-api -> /health, /status etc.)
location ^~ /wolverine/vault-api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/;
}

# traderone api -> /api/*
location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/api/;
}

# traderone vault -> /vault/*
location ^~ /wolverine/traderone/vault/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://127.0.0.1:3000/vault/;
}
EOF

say "STEP 4) PATCH vhost: include wolverine_routes.inc inside correct server{} (and nowhere else)"

# Remove accidental include of wolverine_routes.inc from nginx.conf and other places (leave only in VHOST)
python3 - <<PY
import os,re,glob
vhost="${VHOST}"
inc="${WOLV_INC}"
root="/etc/nginx"
rx=re.compile(r'^\\s*include\\s+[^;]*'+re.escape(inc)+r'\\s*;\\s*$', re.I)
paths=set(glob.glob(root+"/**/*.conf", recursive=True)+glob.glob(root+"/**/*.inc", recursive=True)+[root+"/nginx.conf"])
for p in sorted(paths):
    if not os.path.isfile(p): 
        continue
    if os.path.realpath(p)==os.path.realpath(vhost): 
        continue
    try:
        data=open(p,"r",encoding="utf-8",errors="ignore").read().splitlines(True)
    except: 
        continue
    out=[]; ch=False
    for line in data:
        if rx.search(line) and not line.lstrip().startswith("#"):
            out.append("# DISABLED_DEMELE_WOLV " + line)
            ch=True
        else:
            out.append(line)
    if ch:
        open(p,"w",encoding="utf-8").write("".join(out))
PY

# Ensure include exists in the correct vhost server block for DOMAIN
python3 - <<PY
import re,io,os
vhost="${VHOST}"
domain="${DOMAIN}"
inc="${WOLV_INC}"
txt=open(vhost,"r",encoding="utf-8",errors="ignore").read().splitlines(True)
if any(re.search(r'\\binclude\\s+%s\\s*;' % re.escape(inc), l) for l in txt):
    print("OK: include already present in vhost")
    raise SystemExit(0)

out=[]
in_server=False
server_depth=0
target_server=False
inserted=False

def count_braces(line):
    return line.count("{"), line.count("}")

for i,line in enumerate(txt):
    out.append(line)
    # detect server block start
    if re.search(r'^\\s*server\\s*\\{', line):
        in_server=True
        server_depth=1
        target_server=False
        continue
    if in_server:
        ob,cb=count_braces(line)
        server_depth += ob - cb
        if re.search(r'\\bserver_name\\b', line) and re.search(r'\\b'+re.escape(domain)+r'\\b', line):
            target_server=True
        # insert right after server_name line (first hit) in target server
        if target_server and (not inserted) and re.search(r'\\bserver_name\\b', line):
            out.append("    include %s;\\n" % inc)
            inserted=True
        if server_depth<=0:
            in_server=False
            server_depth=0
            target_server=False

if not inserted:
    # fallback: insert into first server that contains domain somewhere
    out=[]
    in_server=False; server_depth=0; target_server=False; inserted=False
    for line in txt:
        out.append(line)
        if re.search(r'^\\s*server\\s*\\{', line):
            in_server=True; server_depth=1; target_server=False; continue
        if in_server:
            ob,cb=count_braces(line)
            server_depth += ob - cb
            if (not target_server) and re.search(r'\\b'+re.escape(domain)+r'\\b', line):
                target_server=True
            if target_server and (not inserted) and re.search(r'\\{\\s*$', line):
                out.append("    include %s;\\n" % inc)
                inserted=True
            if server_depth<=0:
                in_server=False; server_depth=0; target_server=False
open(vhost,"w",encoding="utf-8").write("".join(out))
print("OK: include inserted in vhost" if inserted else "WARN: could not insert include (check vhost manually)")
PY

say "STEP 5) nginx -t"
if ! nginx -t; then
  say "NGINX TEST FAILED -> restoring /etc/nginx from tar backup (no delete, overwrite only)"
  tar -C / -xzf "$BK_TAR" || true
  nginx -t || true
  exit 1
fi

say "RELOAD nginx"
systemctl reload nginx

# refreeze (best effort)
if command -v chattr >/dev/null 2>&1; then
  say "REFREEZE chattr +i (best effort)"
  chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
  chattr +i "$VHOST" 2>/dev/null || true
fi

say "TEST URLs (should be 200/301; backend may be 502 if service down)"
echo "OPEN: https://${DOMAIN}/wolverine/"
echo "OPEN: https://${DOMAIN}/wolverine/traderone/api/health"
echo "OPEN: https://${DOMAIN}/wolverine/traderone/vault/health"
echo "OPEN: https://${DOMAIN}/wolverine/vault-api/health"
curl -kI "https://${DOMAIN}/wolverine/" | head -n 5 || true
curl -kI "https://${DOMAIN}/wolverine/traderone/api/health" | head -n 5 || true
curl -kI "https://${DOMAIN}/wolverine/traderone/vault/health" | head -n 5 || true
curl -kI "https://${DOMAIN}/wolverine/vault-api/health" | head -n 5 || true

say "DONE. Backup: $BK"
SH
bash /root/MEGA_DEMELE_WOLV_AQ.sh'
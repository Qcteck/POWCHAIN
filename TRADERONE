#!/bin/bash
set -e

UI="/var/www/wolverine/index.html"
TS=$(date +%Y%m%d_%H%M%S)
BACKUP="/var/www/_BACKUP_PHANTOM_ONLY_$TS"

echo "=== PHANTOM ROOT PATCH ==="

[ -f "$UI" ] || { echo "UI introuvable"; exit 1; }

echo "[1] Backup"
mkdir -p "$BACKUP"
cp -f "$UI" "$BACKUP/index.html"

grep -q "PHANTOM_ONLY_ROOT" "$UI" && { echo "Déjà patché"; exit 0; }

echo "[2] Injection Phantom JS (ONLY)"

cat >> "$UI" <<'EOF'

<!-- PHANTOM_ONLY_ROOT -->
<script>
(function(){
  function getBtn(){
    return [...document.querySelectorAll('button')]
      .find(b=>/connect phantom/i.test(b.textContent));
  }

  async function onConnect(){
    if(!window.solana || !window.solana.isPhantom){
      alert("Ouvre ce site dans le navigateur Phantom");
      return;
    }
    try{
      const r = await window.solana.connect({onlyIfTrusted:false});
      const pk = r.publicKey.toString();

      // Remplace "Not connected"
      document.querySelectorAll('*').forEach(e=>{
        if(e.textContent.trim()==="Not connected") e.textContent=pk;
      });

      // Fetch soldes via backend EXISTANT
      fetch("/wolverine/traderone/api/balances?pub="+pk)
        .then(r=>r.json())
        .then(b=>{
          console.log("SOL:",b.sol,"USDC:",b.usdc);
        });

    }catch(e){
      console.error("Phantom error",e);
    }
  }

  window.addEventListener("load",()=>{
    const btn=getBtn();
    if(btn) btn.addEventListener("click",onConnect);
  });
})();
</script>

EOF

chown www-data:www-data "$UI" || true
chmod 644 "$UI"

echo "[3] OK"
echo "Backup: $BACKUP"
echo "=== DONE ==="
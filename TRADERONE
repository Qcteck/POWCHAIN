if(!pendingId||!txSig)bad("missing pendingId/txSig");
const a=mem.pending.find(x=>x.id===pendingId); if(!a)bad("pending not found");
const p=a.payload||{}; mustApproved(pendingId,p);
if(mem.exec.usage.executed[pendingId])bad("already committed");
const conf=await confirmFinalized(String(txSig),22000);
if(!(conf&&conf.ok&&conf.finalized))return res.status(409).json({ok:false,finalized:false,conf});
const usd=await estimateUsd(p.inMint,p.amountIn);
const U=mem.exec.usage.usage;
const k=getPairKey(p.inMint,p.outMint);
U.tx24h++; if(usd>0)U.usd24h+=usd;
U.byPair[k]=U.byPair[k]||{tx24h:0,usd24h:0};
U.byPair[k].tx24h++; if(usd>0)U.byPair[k].usd24h+=usd;
mem.exec.usage.executed[pendingId]={t:now(),txSig:String(txSig),usd:usd||0,inMint:p.inMint,outMint:p.outMint,amountIn:p.amountIn};
persistExec();
markExecuted(pendingId,String(txSig));
res.json({ok:true,finalized:true,txSig:String(txSig),usd:usd||0,conf});
}catch(e){res.status(e.status||500).json({ok:false,err:String(e.message||e)});}});

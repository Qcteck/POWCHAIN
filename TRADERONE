set -euo pipefail

echo "=== 1) Cherche des repos frontend probables sous /opt (vite/react) ==="
CANDIDATES="$(grep -RIl --line-number -E '"(vite|react|react-dom|@solana/web3\.js|wallet-adapter)"' /opt 2>/dev/null | \
  grep -E '/package\.json$' | sed 's#/package\.json$##' | sort -u)"

if [ -z "${CANDIDATES:-}" ]; then
  echo "KO: aucun package.json vite/react trouvé sous /opt"
  exit 1
fi

echo "$CANDIDATES" | nl -ba | head -n 40
echo
echo -n "Choisis le numéro du repo frontend: "
read -r N
REPO_DIR="$(echo "$CANDIDATES" | sed -n "${N}p")"
[ -n "${REPO_DIR:-}" ] || { echo "KO: choix invalide"; exit 1; }

cd "$REPO_DIR"
echo "=== FRONT REPO ==="
pwd
ls -lah | head
echo

echo "=== 2) Vérifie git + remotes ==="
git rev-parse --is-inside-work-tree
git remote -v || true
echo

echo "=== 3) Configure origin (si pas déjà) ==="
if git remote | grep -qx origin; then
  echo "OK: origin existe déjà"
else
  echo -n "Colle l’URL GitHub du repo FRONT (HTTPS ou SSH), puis Enter: "
  read -r URL
  [ -n "${URL:-}" ] || { echo "KO: URL vide"; exit 1; }
  git remote add origin "$URL"
fi

echo
echo "=== 4) Push sur une branche ==="
BR="wolverine-ui-v2"
git checkout -b "$BR" 2>/dev/null || git checkout "$BR"

git add -A
git commit -m "Wolverine UI v2" || true
git push -u origin "$BR"

echo "DONE ✅"
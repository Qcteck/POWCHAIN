#!/usr/bin/env bash
set -euo pipefail

BASE="/var/www/aiaquila"
HTML="$BASE/index.html"
JS="$BASE/aiaquila-rss.js"
BACKUP="$BASE/index.backup_$(date +%Y%m%d_%H%M%S).html"

echo "== AIAQUILA RSS PATCH SAFE =="

# 1) Vérif
[ -f "$HTML" ] || { echo "index.html introuvable"; exit 1; }

# 2) Backup
cp "$HTML" "$BACKUP"
echo "Backup: $BACKUP"

# 3) Supprimer anciens scripts AIAQUILA inline
perl -0777 -i -pe '
s/<script[^>]*>[\s\S]*?AIAQUILA[\s\S]*?<\/script>//gi
' "$HTML"

# 4) Injecter balise JS externe avant </body>
perl -0777 -i -pe '
s|</body>|<script src="/aiaquila/aiaquila-rss.js"></script>\n</body>|i
' "$HTML"


cat >/root/MEGA_WOLVERINE_RPC_PORT_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
LOG="/root/MEGA_WOLVERINE_RPC_PORT_FIX_${TS}.log"
exec > >(tee -a "$LOG") 2>&1

HOST="fireinners.online"
INC="/etc/nginx/includes/wolverine_routes.inc"

# On garde le même endpoint DRPC fourni (mais on ne retouche PAS aux secrets)
DRPC_HTTP="https://lb.drpc.live/solana/AsxThpeKkEjGtZhCNUEQYo1ZluSgmwsR76RdFhW5UfFk"

say(){ echo -e "\n== $* =="; }

say "0) Detect who owns 12703"
ss -lntp | grep ':12703 ' || true
PID="$(ss -lntp 2>/dev/null | awk '/:12703[[:space:]]/ && /users:/{ if (match($0,/pid=([0-9]+)/,m)) {print m[1]; exit}}')"
echo "PID12703=${PID:-none}"

if [ -n "${PID:-}" ]; then
  say "1) If 12703 is our proxy, keep it; else move to 12704"
  EXE="$(readlink -f "/proc/$PID/exe" 2>/dev/null || true)"
  CWD="$(readlink -f "/proc/$PID/cwd" 2>/dev/null || true)"
  CMD="$(tr '\0' ' ' <"/proc/$PID/cmdline" 2>/dev/null || true)"
  echo "EXE=$EXE"
  echo "CWD=$CWD"
  echo "CMD=$CMD"

  if echo "$CMD $CWD" | grep -q 'solrpc-proxy-wolverine'; then
    say "Port 12703 already used by solrpc-proxy-wolverine. Ensure service is healthy and exit."
    systemctl --no-pager -l status wolverine-solrpc-proxy.service || true
    curl -sS -m 10 -H 'content-type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' "http://127.0.0.1:12703" | head -c 200; echo
    echo "DONE (kept 12703). LOG=$LOG"
    exit 0
  fi
fi

# Sinon: 12703 est pris par autre chose -> on bascule proprement sur 12704
NEWPORT="12704"
RPC_DIR="/opt/fireinners/solrpc-proxy-wolverine"
RPC_JS="${RPC_DIR}/server.js"
RPC_SVC="/etc/systemd/system/wolverine-solrpc-proxy.service"

say "2) Switch proxy to port ${NEWPORT} (systemd + nginx include) and restart"
test -f "$RPC_JS" || { echo "ERROR: missing $RPC_JS"; exit 1; }

mkdir -p /root/wolverine_backups
cp -a "$RPC_SVC" "/root/wolverine_backups/wolverine-solrpc-proxy.service.bak_${TS}" 2>/dev/null || true
cp -a "$INC" "/root/wolverine_backups/wolverine_routes.inc.bak_${TS}"

cat >"$RPC_SVC" <<EOF
[Unit]
Description=Wolverine Solana RPC Proxy (DRPC passthrough)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=${RPC_DIR}
Environment=LISTEN_HOST=127.0.0.1
Environment=LISTEN_PORT=${NEWPORT}
Environment=DRPC_HTTP=${DRPC_HTTP}
ExecStart=/usr/bin/node ${RPC_JS}
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
EOF

# Replace any existing /wolverine/solana-rpc proxy_pass to 12703 -> NEWPORT; else append
python3 - <<'PY'
from pathlib import Path
import re
p=Path("/etc/nginx/includes/wolverine_routes.inc")
s=p.read_text(errors="ignore")
orig=s
# if location exists, patch port
s=re.sub(r'(location\s+/wolverine/solana-rpc\s*\{[^}]*proxy_pass\s+http://127\.0\.0\.1:)(\d+)(;)',
         lambda m: m.group(1)+"12704"+m.group(3), s, flags=re.S)
if s==orig and "location /wolverine/solana-rpc" not in s:
    s += "\n  location /wolverine/solana-rpc { proxy_pass http://127.0.0.1:12704; proxy_http_version 1.1; proxy_set_header Host $host; add_header Cache-Control \"no-store\" always; }\n"
p.write_text(s)
print("OK: nginx include updated")
PY

systemctl daemon-reload
systemctl restart wolverine-solrpc-proxy.service
systemctl --no-pager -l status wolverine-solrpc-proxy.service | sed -n '1,22p'

say "3) nginx test + reload"
nginx -t
systemctl reload nginx

say "4) Tests"
echo "-- Local proxy health --"
curl -sS -m 10 -H 'content-type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' "http://127.0.0.1:${NEWPORT}" | head -c 200; echo
echo "-- Public proxy health (same-origin) --"
curl -sS -m 15 -H 'content-type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' "https://${HOST}/wolverine/solana-rpc" | head -c 200; echo

say "DONE"
echo "LOG=$LOG"
echo "OPEN=https://${HOST}/wolverine/"
BASH

bash /root/MEGA_WOLVERINE_RPC_PORT_FIX.sh
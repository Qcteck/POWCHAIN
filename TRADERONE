#!/bin/bash
set -e

echo "==============================="
echo "AIAQUILA — INSTALLATION COMPLÈTE"
echo "==============================="

BASE="/var/www/aiaquila"
BACKUP="/root/backup_aiaquila_$(date +%Y%m%d_%H%M%S)"
LOG="/var/log/aiaquila.log"

mkdir -p "$BASE"
mkdir -p "$BACKUP"
touch "$LOG"

echo "[1/6] Snapshot sécurité..."
if [ -f "$BASE/index.html" ]; then
  cp "$BASE/index.html" "$BACKUP/index.html"
  sha256sum "$BASE/index.html" > "$BACKUP/index.html.sha256"
fi

echo "[2/6] Génération UI AIAQUILA..."

cat > "$BASE/index.html" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AIAQUILA</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{margin:0;background:#05070a;color:#e6e6e6;font-family:system-ui}
header{padding:12px 20px;background:#0b0f1a;border-bottom:1px solid #1f2937;display:flex;justify-content:space-between}
main{padding:20px;max-width:1100px;margin:auto}
.panel{background:#0e1424;border:1px solid #1f2937;border-radius:8px;padding:12px;margin-bottom:12px}
h2{margin:0 0 8px;color:#7cc9ff}
pre{background:#000;padding:10px;border-radius:6px;max-height:200px;overflow:auto}
.timeline{font-size:14px}
.log{font-size:12px;color:#9aa4b2}
canvas{width:100%;height:200px}
</style>
</head>
<body>
<header>
  <strong>AIAQUILA</strong>
  <span id="score">Score: 0</span>
</header>

<main>

<div class="panel">
<h2>État & Raisonnement</h2>
<div id="reasoning">Initialisation…</div>
</div>

<div class="panel">
<h2>Objectifs</h2>
<ul id="goals"></ul>
</div>

<div class="panel">
<h2>Timeline</h2>
<div class="timeline" id="timeline"></div>
</div>

<div class="panel">
<h2>Score</h2>
<canvas id="graph"></canvas>
</div>

<div class="panel">
<h2>Logs</h2>
<pre id="logs"></pre>
</div>

<div class="panel">
<h2>Debug</h2>
<button onclick="addGoal()">Ajouter objectif</button>
<button onclick="reset()">Reset</button>
</div>

</main>

<script>
const STATE_KEY="aiaquila_state_v1";
const state = JSON.parse(localStorage.getItem(STATE_KEY)) || {
  score:10,
  goals:[],
  timeline:[],
  logs:[]
};

function save(){localStorage.setItem(STATE_KEY,JSON.stringify(state));}

function log(msg){
  const t=new Date().toLocaleTimeString();
  state.logs.push(`[${t}] ${msg}`);
  if(state.logs.length>50)state.logs.shift();
  save(); render();
}

function think(){
  state.score=Math.min(100,state.score+Math.random()*2);
  state.timeline.push("Analyse situation → score ajusté");
  log("Raisonnement exécuté");
}

function addGoal(){
  const g=prompt("Nouvel objectif ?");
  if(!g)return;
  state.goals.push(g);
  log("Objectif ajouté: "+g);
}

function reset(){
  localStorage.removeItem(STATE_KEY);
  location.reload();
}

function render(){
  document.getElementById("score").textContent="Score: "+state.score.toFixed(1);
  document.getElementById("reasoning").textContent="État stable, adaptation continue.";
  document.getElementById("goals").innerHTML=state.goals.map(g=>`<li>${g}</li>`).join("");
  document.getElementById("timeline").innerHTML=state.timeline.slice(-10).map(t=>`• ${t}`).join("<br>");
  document.getElementById("logs").textContent=state.logs.join("\n");
}

setInterval(()=>{think();render();},4000);
render();
</script>

</body>
</html>
HTML

echo "[3/6] Permissions..."
chown -R www-data:www-data "$BASE"
chmod 644 "$BASE/index.html"

echo "[4/6] Log serveur..."
echo "$(date) AIAQUILA déployée" >> "$LOG"

echo "[5/6] Test nginx..."
nginx -t

echo "[6/6] Reload nginx..."
systemctl reload nginx

echo "==============================="
echo "✅ AIAQUILA PRÊTE"
echo "URL : https://fireinners.online/aiaquila/"
echo "Rollback : $BACKUP"
echo "==============================="
bash <<'BASH'
set -euo pipefail

HTML="/var/www/wolverine/index.html"
TS="$(date +%Y%m%d_%H%M%S)"

echo "== [1] Backup frontend =="
cp -a "$HTML" "${HTML}.bak_${TS}"

echo "== [2] Patch fetch() vers API canonique =="
python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

# remplace TOUS les fetch relatifs budget
s=s.replace('fetch("budget"', 'fetch("/wolverine/traderone/api/budget"')
s=s.replace("fetch('budget'", "fetch('/wolverine/traderone/api/budget'")
s=s.replace('fetch("/budget"', 'fetch("/wolverine/traderone/api/budget"')
s=s.replace("fetch('/budget'", "fetch('/wolverine/traderone/api/budget'")

# sécurité JSON
if "Content-Type" not in s:
    s=s.replace(
        'fetch("/wolverine/traderone/api/budget",{',
        'fetch("/wolverine/traderone/api/budget",{method:"POST",headers:{"Content-Type":"application/json"},'
    )

p.write_text(s)
print("✔ fetch() corrigé définitivement")
PY

echo "== [3] Reload nginx =="
nginx -t
systemctl reload nginx

echo "== [4] Test API public (JSON attendu) =="
curl -i -X POST https://fireinners.online/wolverine/traderone/api/budget \
 -H "Content-Type: application/json" \
 -d '{"from":"test","amount":0.01}'

echo
echo "== TERMINÉ =="
echo "➡ Rafraîchis la page (CTRL+F5) et réessaie le bouton."
BASH
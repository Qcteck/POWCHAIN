cat >/root/WOLVERINE_FIX_CONNECTION_USDC.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HTML="/var/www/wolverine/index.html"
BACKUP="$HTML.fix_$(date +%Y%m%d_%H%M%S)"

cp "$HTML" "$BACKUP"
echo "[OK] Backup: $BACKUP"

# 1) SUPPRIMER TOUTES LES DECLARATIONS connection / refresh injectées
perl -0777 -i -pe '
s/const\s+connection\s*=.*?;\s*//sg;
s/let\s+connection\s*=.*?;\s*//sg;
s/async\s+function\s+refreshUSDC[\s\S]*?\}\s*//g;
s/async\s+function\s+refreshSOL[\s\S]*?\}\s*//g;
' "$HTML"

# 2) INJECTER LE BLOC UNIQUE PROPRE AVANT </script>
perl -0777 -i -pe 's|</script>|
// === WOLVERINE CLEAN SOL + USDC ===
const RPC_URL = "https://lb.drpc.live/solana/AsxThpeKkEjGtZhCNUEQYo1ZluSgmwsR76RdFhW5UfFk";
const connection = new solanaWeb3.Connection(RPC_URL, "confirmed");

async function refreshSOL(){
  const lamports = await connection.getBalance(pubkey);
  document.getElementById("sol").innerText = (lamports/1e9).toFixed(6);
}

async function refreshUSDC(){
  try{
    const USDC_MINT = new solanaWeb3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v");
    let total = 0;

    const programs = [
      solanaWeb3.TOKEN_PROGRAM_ID,
      solanaWeb3.TOKEN_2022_PROGRAM_ID
    ];

    for(const programId of programs){
      const res = await connection.getParsedTokenAccountsByOwner(pubkey,{programId});
      for(const a of res.value){
        const info = a.account.data.parsed.info;
        if(info.mint === USDC_MINT.toBase58()){
          total += Number(info.tokenAmount.uiAmount || 0);
        }
      }
    }
    document.getElementById("usdc").innerText = total.toFixed(2);
  }catch(e){
    console.error("USDC error",e);
    document.getElementById("usdc").innerText = "0.00";
  }
}

document.addEventListener("DOMContentLoaded",()=>{
  document.getElementById("refresh").onclick = async ()=>{
    await refreshSOL();
    await refreshUSDC();
  };
});
// === END WOLVERINE FIX ===
</script>|s' "$HTML"

nginx -t && systemctl reload nginx
echo "[DONE] CTRL+SHIFT+R"
BASH

chmod +x /root/WOLVERINE_FIX_CONNECTION_USDC.sh
/root/WOLVERINE_FIX_CONNECTION_USDC.sh
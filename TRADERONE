import express from "express";
import fs from "fs";
import path from "path";
import { Keypair } from "@solana/web3.js";
import bs58 from "bs58";

const HOST = process.env.HOST || "127.0.0.1";
const PORT = parseInt(process.env.PORT || "${VAULT_PORT}", 10);
const DB = process.env.DB || "/opt/wolverine-vault-api/vault_db.json";

const app = express();
app.use(express.json({limit:"256kb"}));

app.use((req,res,next)=>{
  res.setHeader("access-control-allow-origin","*");
  res.setHeader("access-control-allow-methods","POST, GET, OPTIONS");
  res.setHeader("access-control-allow-headers","content-type, authorization");
  if(req.method==="OPTIONS") return res.status(204).end();
  next();
});

function loadDB(){
  try { return JSON.parse(fs.readFileSync(DB,"utf8")); } catch { return {version:1, byUser:{}}; }
}
function saveDB(db){
  fs.writeFileSync(DB, JSON.stringify(db,null,2));
}

app.get("/health",(req,res)=>res.json({status:"ok", service:"wolverine-vault-api"}));

app.post("/create",(req,res)=>{
  const userPub = (req.body && typeof req.body.userPub==="string") ? req.body.userPub : "";
  if(!userPub) return res.status(400).json({error:"missing_userPub"});

  const db = loadDB();
  if(db.byUser[userPub] && db.byUser[userPub].vaultPub){
    return res.json({status:"ok", reused:true, userPub, vaultPub: db.byUser[userPub].vaultPub});
  }

  const kp = Keypair.generate();
  const vaultPub = kp.publicKey.toBase58();
  const vaultSecret = bs58.encode(kp.secretKey);

  db.byUser[userPub] = {vaultPub, vaultSecret, createdAt: new Date().toISOString()};
  saveDB(db);

  return res.json({status:"ok", reused:false, userPub, vaultPub});
});

app.listen(PORT, HOST, ()=>console.log(\`wolverine-vault-api listening on http://\${HOST}:\${PORT}\`));

# 5) Patch BACK: ledger + GET /api/invested + POST /api/record_deposit + POST /api/record_withdraw (optionnel)
python3 - <<PY
import re,os,sys,datetime
back=r"$BACK"
txt=open(back,"r",encoding="utf-8",errors="ignore").read()
M0="// WOLV_INVEST_LEDGER_v1"
M1="// /WOLV_INVEST_LEDGER_v1"
if M0 in txt and M1 in txt:
  a=txt.split(M0,1)[0]; b=txt.split(M1,1)[1]; txt=a+b

inject = r'''
// WOLV_INVEST_LEDGER_v1
const fs=require("fs");
const path=require("path");
const __WOLV_LEDGER_PATH=process.env.WOLV_LEDGER_PATH||"%s";
function __wolv_load(){try{return JSON.parse(fs.readFileSync(__WOLV_LEDGER_PATH,"utf8")||"{}");}catch(e){return {};}}
function __wolv_save(db){fs.mkdirSync(path.dirname(__WOLV_LEDGER_PATH),{recursive:true});fs.writeFileSync(__WOLV_LEDGER_PATH,JSON.stringify(db));}
function __wolv_initUser(db,pub){if(!db[pub]) db[pub]={sol:0,usdc:0,deposits:[],withdraws:[],updated:new Date().toISOString()};}
function __wolv_apply(db,pub,asset,amount,sig,kind){
  __wolv_initUser(db,pub);
  amount=Number(amount||0); if(!isFinite(amount)||amount<=0) throw new Error("amount");
  asset=String(asset||"").toUpperCase();
  const u=db[pub];
  const arr=(kind==="deposit")?u.deposits:u.withdraws;
  if(sig && (u.deposits.includes(sig) || u.withdraws.includes(sig))) return;
  if(kind==="deposit"){
    if(asset==="SOL") u.sol += amount;
    else if(asset==="USDC") u.usdc += amount;
    else throw new Error("asset");
    if(sig) u.deposits.push(sig);
  }else{
    if(asset==="SOL") u.sol -= amount;
    else if(asset==="USDC") u.usdc -= amount;
    else throw new Error("asset");
    if(sig) u.withdraws.push(sig);
    if(u.sol<0) u.sol=0;
    if(u.usdc<0) u.usdc=0;
  }
  u.updated=new Date().toISOString();
}
app.get("/api/invested",(req,res)=>{
  try{
    const pub=String(req.query.pub||"").trim();
    if(!pub) return res.status(400).json({error:"pub"});
    const db=__wolv_load();
    const u=db[pub]||{sol:0,usdc:0,updated:null};
    res.json({sol:Number(u.sol||0),usdc:Number(u.usdc||0),updated:u.updated||null});
  }catch(e){res.status(500).json({error:String(e&&e.message||e)});}
});
app.post("/api/record_deposit",express.json(),(req,res)=>{
  try{
    const {pub,asset,amount,depositSig}=req.body||{};
    if(!pub||!asset||!amount) return res.status(400).json({ok:false,error:"params"});
    const db=__wolv_load();
    __wolv_apply(db,String(pub).trim(),asset,amount,depositSig||"", "deposit");
    __wolv_save(db);
    res.json({ok:true});
  }catch(e){res.status(500).json({ok:false,error:String(e&&e.message||e)});}
});
app.post("/api/record_withdraw",express.json(),(req,res)=>{
  try{
    const {pub,asset,amount,txSig}=req.body||{};
    if(!pub||!asset||!amount) return res.status(400).json({ok:false,error:"params"});
    const db=__wolv_load();
    __wolv_apply(db,String(pub).trim(),asset,amount,txSig||"", "withdraw");
    __wolv_save(db);
    res.json({ok:true});
  }catch(e){res.status(500).json({ok:false,error:String(e&&e.message||e)});}
});
// /WOLV_INVEST_LEDGER_v1
''' % (r"$LEDGER").replace("\\","\\\\").replace('"','\\"')

# Injecte juste avant app.listen si possible, sinon à la fin
m=re.search(r"\n\s*app\.listen\s*\(",txt)
if m:
  txt=txt[:m.start()]+inject+"\n"+txt[m.start():]
else:
  txt=txt+"\n"+inject+"\n"
open(back,"w",encoding="utf-8").write(txt)
print("OK BACK:",back)
PY


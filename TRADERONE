#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/aiaquila.fireinners.conf"
BACKUP="/root/aiaquila_vhost_backup_$(date +%Y%m%d_%H%M%S).conf"

echo "🔒 Backup du vhost"
cp "$VHOST" "$BACKUP"

echo "🧹 Réécriture complète du vhost AIAQUILA (structure SAFE)"

cat > "$VHOST" <<'EOF'
server {
    listen 443 ssl http2;
    server_name fireinners.online;

    ssl_certificate     /etc/letsencrypt/live/fireinners.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fireinners.online/privkey.pem;

    # Headers baseline
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;

    location /aiaquila/ {
        alias /var/www/aiaquila/;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
EOF

echo "🧪 Test nginx"
if nginx -t; then
    echo "✅ nginx OK → reload"
    systemctl reload nginx
    echo "🎉 AIAQUILA SERVI CORRECTEMENT"
else
    echo "❌ nginx invalide → rollback"
    cp "$BACKUP" "$VHOST"
    nginx -t || true
    exit 1
fi

echo "✅ FIN DU FIX AIAQUILA"
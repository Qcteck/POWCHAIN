set -euo pipefail
TS="$(date +%s)"

KEEP="/etc/nginx/sites-enabled/fireinners.online-ssl"
NEW="/var/www/_wolverine_ui"

echo "=== 1) Crée un dossier UI Wolverine séparé (sans toucher /var/www/fireinners ni /var/www/wolverine) ==="
mkdir -p "$NEW"
cat > "$NEW/index.html" <<'HTML'
<!doctype html><html><head><meta charset="utf-8"><title>WOLVERINE</title></head>
<body style="background:#0b0f15;color:#e6edf6;font-family:system-ui;padding:24px">
<h1>WOLVERINE UI (SAFE)</h1>
<p>Si tu vois ça, nginx sert bien <code>/var/www/_wolverine_ui</code> pour <code>/wolverine/</code>.</p>
<p>API health: <a href="/wolverine/traderone/api/health">/wolverine/traderone/api/health</a></p>
</body></html>
HTML

echo "=== 2) Patch nginx: /wolverine => /var/www/_wolverine_ui (sans toucher /wolverine/traderone/api) ==="
cp -a "$KEEP" "$KEEP.bak.safe_wolv.$TS"

python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# retire anciens blocs UI /wolverine (sans toucher à /wolverine/traderone/api)
s = re.sub(r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*', '\n', s, flags=re.M)
s = re.sub(r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*', '\n', s, flags=re.M)

block = r'''
# --- WOLVERINE UI (SAFE DIR) ---
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  root /var/www;
  try_files $uri $uri/ /_wolverine_ui/index.html;
}
'''
i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: nginx conf invalide")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: bloc /wolverine SAFE injecté")
PY

nginx -t
systemctl reload nginx

echo "=== 3) Preuves ==="
echo "--- title /wolverine/ ---"
curl -LsS https://fireinners.online/wolverine/ | grep -i "<title>" | head -n 1 || true
echo "--- api health ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12 || true
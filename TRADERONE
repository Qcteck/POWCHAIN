cat >/tmp/wolfchain_fix_stats_404.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ROOT="/opt/fireinners/frontend-react/app/dist"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
ts(){ date +"%Y%m%d-%H%M%S"; }
say(){ echo "== $* =="; }

say "Check files"
mkdir -p "$ROOT/stats"
if [ ! -f "$ROOT/stats/index.json" ]; then
  cat >"$ROOT/stats/index.json" <<'JSON'
{"ok":true,"service":"fireinners-static-stats","note":"UI heartbeat file"}
JSON
fi
chmod 755 "$ROOT" "$ROOT/stats" || true
chmod 644 "$ROOT/stats/index.json" || true
ls -la "$ROOT/stats" || true

say "Check nginx includes sites-enabled"
grep -nE 'include\s+/etc/nginx/sites-enabled/\*' /etc/nginx/nginx.conf || true

say "Ensure vhost enabled (sites-enabled symlink)"
if [ ! -e "$VHOST" ]; then echo "ERROR: missing $VHOST"; exit 2; fi
if [ ! -e "$EN" ]; then
  ln -s "$VHOST" "$EN"
  echo "Created symlink: $EN -> $VHOST"
else
  echo "OK: symlink exists: $EN"
fi

say "nginx -t + reload"
nginx -t
systemctl reload nginx

say "TEST 1 (should be 200): /stats/index.json via Host fireinners.online"
curl -k -sS -i "https://127.0.0.1/stats/index.json" -H "Host: fireinners.online" | sed -n '1,30p'

say "TEST 2 (homepage body hint): / contains WOLFCHAIN?"
curl -k -sS "https://127.0.0.1/" -H "Host: fireinners.online" | head -n 5
SH
bash /tmp/wolfchain_fix_stats_404.sh
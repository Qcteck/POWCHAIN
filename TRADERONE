bash -lc 'set -euo pipefail
RPC="https://lb.drpc.live/solana/Ah_pmhKMs0qntHMrHyHMTvqg8lcNcRkR8LWNEklbR4ac"
WALLET="/opt/bundler_api/wallet.json"
APPDIR="/opt/bundler_api"

echo "== check wallet.json =="
test -s "$WALLET" || { echo "ERROR: missing $WALLET"; ls -la "$APPDIR" || true; exit 1; }

echo "== deps: @solana/web3.js =="
cd "$APPDIR"
if ! node -e "require(\"@solana/web3.js\")" >/dev/null 2>&1; then
  echo "installing @solana/web3.js in $APPDIR ..."
  test -f package.json || npm init -y >/dev/null 2>&1 || true
  npm i @solana/web3.js >/dev/null
fi

echo "== payer balance =="
RPC="$RPC" node - <<'"'"'JS'"'"'
const fs=require("fs");
const {Connection,Keypair,LAMPORTS_PER_SOL}=require("@solana/web3.js");
(async()=>{
  const rpc=process.env.RPC;
  const p="/opt/bundler_api/wallet.json";
  const sk=Uint8Array.from(JSON.parse(fs.readFileSync(p,"utf8")));
  const kp=Keypair.fromSecretKey(sk);
  const c=new Connection(rpc,"confirmed");
  const lam=await c.getBalance(kp.publicKey);
  console.log("PAYER_PUBKEY:", kp.publicKey.toBase58());
  console.log("PAYER_SOL:", (lam/LAMPORTS_PER_SOL).toFixed(9));
  console.log("RPC:", rpc);
})().catch(e=>{console.error(e);process.exit(1);});
JS
'
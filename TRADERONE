#!/usr/bin/env bash
set -euo pipefail

SERVER="/opt/traderone-vault/server.js"
APP_NAME="traderone-vault"
PORT=9696
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== FIX ROUTING FINAL ==="

### 1) Backup
cp -a "$SERVER" "$SERVER.fix_$TS"

### 2) Nettoyage total app.listen
python3 <<'PY'
from pathlib import Path
p=Path("/opt/traderone-vault/server.js")
s=p.read_text()

out=[]
for l in s.splitlines():
    if "app.listen" in l:
        continue
    out.append(l)

p.write_text("\n".join(out))
print("listen nettoyé")
PY

### 3) Injection ROUTES + LISTEN UNIQUE
cat >> "$SERVER" <<EOF

/* === TRADERONE FINAL API === */
app.get("/wolverine/traderone/api/health",(req,res)=>{
  res.json({ok:true,port:${PORT},ts:Date.now()});
});

app.listen(${PORT},"0.0.0.0",()=>{
  console.log("TraderOne API READY ${PORT}");
});
EOF

### 4) Restart PM2
pm2 delete "$APP_NAME" 2>/dev/null || true
pm2 start "$SERVER" --name "$APP_NAME"
pm2 save
sleep 2

### 5) Tests
echo "--- TEST LOCAL ---"
curl -s http://127.0.0.1:${PORT}/wolverine/traderone/api/health

echo "--- TEST PUBLIC ---"
curl -s https://fireinners.online/wolverine/traderone/api/health

echo "✅ FIX TERMINÉ"
cat > /root/batch_root_fireinners.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${DOMAIN:-fireinners.online}"
VHOST="${VHOST:-/etc/nginx/sites-enabled/${DOMAIN}-ssl}"
SNIP="${SNIP:-/etc/nginx/snippets/${DOMAIN}_wolverine.conf}"
APPLY="${APPLY:-0}"

say(){ echo -e "$*"; }

say "== 0) DRY RUN par défaut (APPLY=1 pour appliquer) =="
say "DOMAIN: $DOMAIN"
say "VHOST : $VHOST"
say "SNIP  : $SNIP"
say "APPLY : $APPLY"
echo

if [ ! -f "$VHOST" ]; then
  say "ERROR: vhost introuvable: $VHOST"
  exit 1
fi

TS="$(date +%Y%m%d_%H%M%S)"
BACKDIR="/etc/nginx/sites-disabled/batch_root_${TS}"
mkdir -p "$BACKDIR"
BACKVHOST="${BACKDIR}/$(basename "$VHOST")"

say "== 1) Backup vhost =="
if [ "$APPLY" = "1" ]; then
  cp -a "$VHOST" "$BACKVHOST"
  say "Backup: $BACKVHOST"
else
  say "[DRY] Would backup to: $BACKVHOST"
fi
echo

say "== 2) Créer snippet (wolverine + favicon) =="
SNIP_CONTENT=$(cat <<EOF
# --- ${DOMAIN} wolverine + favicon (auto) ---
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files \$uri \$uri/ /wolverine/index.html;
}

# évite un 500 si /favicon.ico absent => 204
location = /favicon.ico {
  access_log off;
  log_not_found off;
  try_files /favicon.ico =204;
}
EOF
)

if [ "$APPLY" = "1" ]; then
  install -d /etc/nginx/snippets
  printf "%s\n" "$SNIP_CONTENT" > "$SNIP"
  say "Snippet écrit: $SNIP"
else
  say "[DRY] Would write snippet: $SNIP"
fi
echo

say "== 3) Nettoyer le vhost: commenter tout 'location' hors server{} (cause du emerg) =="
TMP="$(mktemp)"

awk '
BEGIN{in_server=0; brace=0; bad=0}
{
  line=$0

  # Détection entrée dans server
  if ($0 ~ /^[[:space:]]*server[[:space:]]*\{[[:space:]]*$/) {in_server=1}

  # Compte braces globalement (approx suffisant ici)
  brace += gsub(/\{/, "{")
  brace -= gsub(/\}/, "}")

  # On considère qu on est "hors server" tant qu on a pas vu server {
  # et qu on est avant le premier bloc serveur.
  if (in_server==0 && $0 ~ /^[[:space:]]*location[[:space:]]+/) {
    print "# [BATCHFIX] commented (location outside server{}): " line
    bad=1
    next
  }

  print line
}
END{
  if (bad==1) {
    # juste un indicateur dans stderr serait mieux, mais ok
  }
}
' "$VHOST" > "$TMP"

if [ "$APPLY" = "1" ]; then
  cp -a "$TMP" "$VHOST"
  say "Vhost nettoyé: $VHOST"
else
  say "[DRY] Would rewrite vhost (cleaned) at: $VHOST"
fi
rm -f "$TMP"
echo

say "== 4) Assurer include snippet DANS le 1er server{} =="
TMP2="$(mktemp)"
INCLUDE_LINE="include ${SNIP};"

awk -v inc="$INCLUDE_LINE" '
BEGIN{done=0; in_first_server=0}
{
  print $0

  # entrée premier server
  if (done==0 && $0 ~ /^[[:space:]]*server[[:space:]]*\{[[:space:]]*$/) {
    in_first_server=1
    next
  }

  # juste après "server {" du premier bloc, injecter include (si absent)
  if (in_first_server==1) {
    # si la ligne suivante contient déjà include, on n ajoute pas
    # (on vérifie plus bas au moment de sortir du server)
    print "  " inc
    done=1
    in_first_server=0
  }
}
' "$VHOST" > "$TMP2"

# Si include existe déjà quelque part, éviter doublon : si on détecte inc dans fichier original, on ne modifie pas.
if grep -qF "$INCLUDE_LINE" "$VHOST"; then
  say "Include déjà présent dans le vhost -> rien à injecter."
  rm -f "$TMP2"
else
  if [ "$APPLY" = "1" ]; then
    cp -a "$TMP2" "$VHOST"
    say "Include injecté dans 1er server{}: $INCLUDE_LINE"
  else
    say "[DRY] Would inject include into first server{}: $INCLUDE_LINE"
  fi
  rm -f "$TMP2"
fi
echo

say "== 5) nginx -t (DOIT PASS) =="
set +e
nginx -t
RC=$?
set -e
if [ $RC -ne 0 ]; then
  say "ERROR: nginx -t a échoué. Affiche la ligne exacte avec:"
  say "  nginx -T 2>/dev/null | sed -n '1,200p'"
  exit $RC
fi
echo

say "== 6) Reload nginx si APPLY=1 =="
if [ "$APPLY" = "1" ]; then
  systemctl reload nginx
  say "Reload OK."
else
  say "[DRY] Pas de reload (APPLY=0)."
fi
echo

say "== 7) Vérifs rapides =="
say "Local:"
say "  curl -I -H 'Host: ${DOMAIN}' http://127.0.0.1/wolverine/ | head"
say "  curl -I -H 'Host: ${DOMAIN}' http://127.0.0.1/favicon.ico | head"
say "Public:"
say "  curl -I https://${DOMAIN}/wolverine/ | head"
say "  curl -I https://${DOMAIN}/favicon.ico | head"
say
say "DONE."
BASH

chmod +x /root/batch_root_fireinners.sh
const fs=require("fs"),fsp=fs.promises,path=require("path"),crypto=require("crypto"),express=require("express"),cors=require("cors");
function loadEnvFile(p){try{const s=fs.readFileSync(p,"utf8");for(const line of s.split("\n")){const t=line.trim();if(!t||t.startsWith("#"))continue;const i=t.indexOf("=");if(i<0)continue;const k=t.slice(0,i).trim();const v=t.slice(i+1).trim();if(!(k in process.env))process.env[k]=v;}}catch{}}

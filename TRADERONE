cat > /root/batch_root_fireinners.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-}"
APPLY="${APPLY:-0}"   # 0=dry-run, 1=apply

if [[ -z "$DOMAIN" ]]; then
  echo "Usage: APPLY=0|1 $0 <domain>"
  exit 2
fi

ts="$(date +%Y%m%d_%H%M%S)"
backup_dir="/etc/nginx/sites-disabled/cleanup_${ts}"
mkdir -p "$backup_dir"

# --- Find vhost file that contains server_name DOMAIN AND listen 443 ---
candidates="$(grep -RIl --include='*' "server_name .*${DOMAIN}" /etc/nginx/sites-enabled /etc/nginx/sites-available 2>/dev/null || true)"
vhost=""
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  if grep -Eq 'listen\s+443' "$f"; then
    vhost="$f"
    break
  fi
done <<< "$candidates"

if [[ -z "$vhost" ]]; then
  echo "[ERR] Could not find an SSL vhost for: $DOMAIN (no file with server_name + listen 443)"
  echo "Tip: run: nginx -T 2>/dev/null | grep -n \"server_name ${DOMAIN}\" -n"
  exit 1
fi

echo "[*] DOMAIN=$DOMAIN"
echo "[*] VHOST=$vhost"
echo "[*] APPLY=$APPLY (0=dry-run, 1=apply)"
echo

# --- Backup original ---
cp -a "$vhost" "$backup_dir/$(basename "$vhost")"
echo "[OK] Backup -> $backup_dir/$(basename "$vhost")"

# --- Injection block (with markers, idempotent) ---
read -r -d '' BLOCK <<'NGINX'
    # --- injected by batchfix (wolverine + favicon + root redirect) ---
    # favicon: never 500 if absent
    location = /favicon.ico {
        access_log off;
        log_not_found off;
        try_files /favicon.ico =204;
    }

    # redirect home -> /wolverine/
    location = / {
        return 302 /wolverine/;
    }

    # UI Wolverine under /wolverine/
    # IMPORTANT: alias + try_files avoids loop /index.html
    location ^~ /wolverine/ {
        alias /var/www/wolverine_current/;
        index index.html;
        try_files $uri $uri/ /wolverine/index.html;
    }
    # --- end injected by batchfix ---
NGINX

# 1) remove any previous injected block (safe re-run)
tmp="$(mktemp)"
perl -0777 -pe 's/\n\s*# --- injected by batchfix.*?# --- end injected by batchfix ---\n//s' "$vhost" > "$tmp"

# 2) inject BLOCK inside the *SSL server* (first server{} that contains "listen 443")
tmp2="$(mktemp)"
awk -v block="$BLOCK" '
function count_char(s, c,   i,n){ n=0; for(i=1;i<=length(s);i++) if(substr(s,i,1)==c) n++; return n }
BEGIN{
  in_server=0; ssl_server=0; depth=0; inserted=0;
}
{
  line=$0;

  # detect server block start
  if(line ~ /^[[:space:]]*server[[:space:]]*\{/){
    in_server=1;
    ssl_server=0;
    depth=0;
  }

  if(in_server){
    depth += count_char(line, "{");
    depth -= count_char(line, "}");
    if(line ~ /listen[[:space:]]+443/){ ssl_server=1; }
  }

  # if we are at the closing brace of the ssl server block, inject before it (once)
  if(in_server && ssl_server && !inserted && depth==0 && line ~ /^[[:space:]]*\}/){
    print block;
    inserted=1;
    print line;
    in_server=0;
    next;
  }

  print line;

  # end of non-ssl server block
  if(in_server && depth==0 && line ~ /^[[:space:]]*\}/){
    in_server=0;
  }
}
END{
  if(!inserted){
    print "##BATCHFIX_ERR## Could not find closing brace for SSL server (listen 443) to inject." > "/dev/stderr";
    exit 3;
  }
}
' "$tmp" > "$tmp2"

if [[ "$APPLY" == "0" ]]; then
  echo "=== DRY-RUN diff ==="
  diff -u "$vhost" "$tmp2" || true
  echo
  echo "=== DRY-RUN nginx -t (using temp file) ==="
  # We can't easily make nginx read the temp file without replacing,
  # so we just advise the real test after apply.
  echo "[INFO] To apply: APPLY=1 $0 $DOMAIN"
  rm -f "$tmp" "$tmp2"
  exit 0
fi

# APPLY=1: write & test; auto-rollback on failure
cp -a "$tmp2" "$vhost"
rm -f "$tmp" "$tmp2"

echo "[*] nginx -t ..."
if nginx -t; then
  systemctl reload nginx || nginx -s reload
  echo "[OK] Applied + reloaded nginx"
else
  echo "[ERR] nginx -t failed, rolling back..."
  cp -a "$backup_dir/$(basename "$vhost")" "$vhost"
  nginx -t || true
  exit 1
fi

echo
echo "[DONE] Check:"
echo "  curl -I https://${DOMAIN}/"
echo "  curl -I https://${DOMAIN}/wolverine/"
echo "  curl -I https://${DOMAIN}/favicon.ico"
BASH

chmod +x /root/batch_root_fireinners.sh
echo "OK: /root/batch_root_fireinners.sh prêt"
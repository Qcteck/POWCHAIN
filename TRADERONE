cat >/root/fix_listen_80.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== Ports avant ==="
ss -lntp | grep -E ':(80|443)\b' || true
echo

# 1) Crée un vhost HTTP (port 80) qui redirige vers HTTPS
cat >/etc/nginx/sites-available/fireinners.online-http <<'NGINX'
server {
  listen 80;
  listen [::]:80;
  server_name fireinners.online www.fireinners.online;

  location / {
    return 301 https://$host$request_uri;
  }
}
NGINX

ln -sf /etc/nginx/sites-available/fireinners.online-http /etc/nginx/sites-enabled/fireinners.online-http

# 2) Assure que nginx inclut bien sites-enabled (normalement oui)
grep -R "sites-enabled" -n /etc/nginx/nginx.conf || true

echo
echo "=== nginx -t ==="
nginx -t

systemctl restart nginx

echo
echo "=== Ports après ==="
ss -lntp | grep -E ':(80|443)\b' || true

echo
echo "=== Tests locaux ==="
curl -I --max-time 5 http://127.0.0.1/ | head -n 8 || true
BASH

chmod +x /root/fix_listen_80.sh
/root/fix_listen_80.sh
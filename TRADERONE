bash -lc 'cat >/root/WV_DEDUP_FIREINNERS_SSL.sh<<'"'"'BASH'"'"'
#!/usr/bin/env bash
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
DOMAIN="fireinners.online"
CANON="/etc/nginx/sites-available/fireinners.online-ssl"
CANON_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"
INC="/etc/nginx/includes/wolverine_routes.inc"
BK="/root/WV_DEDUP_${TS}"

say(){ echo "[$(date +%H:%M:%S)] $*"; }
need_root(){ [ "$(id -u)" -eq 0 ] || { echo "ROOT ONLY"; exit 1; }; }
unfreeze_tree(){ command -v chattr >/dev/null 2>&1 || return 0; chattr -i -R "$1" 2>/dev/null || true; }
refreeze_tree(){ command -v chattr >/dev/null 2>&1 || return 0; chattr +i -R "$1" 2>/dev/null || true; }

inject_include_into_ssl_server(){
  local f="$1" incLine="include ${INC};"
  awk -v inc="$incLine" '
    BEGIN{in_srv=0;depth=0;is443=0;done=0;seenName=0;}
    /^[[:space:]]*server[[:space:]]*\{/ {in_srv=1;depth=1;is443=0;seenName=0;}
    {
      if(in_srv){
        if($0 ~ /listen[[:space:]]+443/){is443=1;}
        if($0 ~ /^[[:space:]]*server_name[[:space:]]/){seenName=1;}
        n=gsub(/\{/,"{"); depth+=n;
        n=gsub(/\}/,"}"); depth-=n;
        if(depth==0){
          if(is443 && !done){
            print "    " inc;
            done=1;
          }
          in_srv=0;
        }
      }
      print
    }
  ' "$f" >"${f}.tmp" && mv -f "${f}.tmp" "$f"
}

disable_duplicate_vhosts(){
  local d="/etc/nginx/sites-enabled"
  [ -d "$d" ] || return 0
  shopt -s nullglob
  for p in "$d"/*; do
    local rp; rp="$(readlink -f "$p" 2>/dev/null || true)"
    [ -n "$rp" ] || continue
    [ "$rp" = "$CANON" ] && continue
    if grep -qE "^[[:space:]]*server_name[[:space:]].*\\b${DOMAIN//./\\.}\\b" "$rp" 2>/dev/null; then
      if grep -qE "listen[[:space:]]+443" "$rp" 2>/dev/null || grep -qE "listen[[:space:]]+80" "$rp" 2>/dev/null; then
        local base; base="$(basename "$p")"
        say "DISABLE duplicate enabled vhost: $p -> $d/DISABLED_${TS}__${base}"
        mv -f "$p" "$d/DISABLED_${TS}__${base}" || true
      fi
    fi
  done
}

dedup_server_name_inside_canon(){
  local f="$1"
  awk -v dom="$DOMAIN" -v ts="$TS" '
    BEGIN{in_srv=0;depth=0;is443=0;hasName=0;kept443=0;}
    /^[[:space:]]*server[[:space:]]*\{/ {in_srv=1;depth=1;is443=0;hasName=0;}
    {
      line=$0
      if(in_srv){
        if(line ~ /listen[[:space:]]+443/){is443=1;}
        if(line ~ /^[[:space:]]*server_name[[:space:]]/ && line ~ dom){
          hasName=1
          if(is443){
            if(kept443==0){
              kept443=1
            } else {
              sub(/server_name[[:space:]]+.*/,"server_name disabled-"ts".invalid; # AUTO disabled dup",line)
            }
          } else {
            # for :80 duplicates, keep first only
            if(line ~ dom){
              if(seen80==0){seen80=1}else{sub(/server_name[[:space:]]+.*/,"server_name disabled-"ts".invalid; # AUTO disabled dup",line)}
            }
          }
        }
        n=gsub(/\{/,"{"); depth+=n;
        n=gsub(/\}/,"}"); depth-=n;
        if(depth==0){in_srv=0}
      }
      print line
    }
  ' "$f" >"${f}.tmp" && mv -f "${f}.tmp" "$f"
}

strip_duplicate_wolverine_includes(){
  local f="$1"
  local pat="include ${INC};"
  awk -v p="$pat" '
    { if($0==p){c++; if(c>1) next;} print }
  ' "$f" >"${f}.tmp" && mv -f "${f}.tmp" "$f"
}

main(){
  need_root
  [ -f "$CANON" ] || { echo "MISSING: $CANON"; exit 1; }
  mkdir -p "$BK"
  say "Backup -> $BK"
  cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true

  say "Unfreeze nginx tree (best-effort)"
  unfreeze_tree /etc/nginx || true

  say "Ensure canonical vhost enabled symlink"
  ln -sf "$CANON" "$CANON_EN"

  say "Disable duplicate vhosts in sites-enabled"
  disable_duplicate_vhosts

  say "Dedup server_name inside canonical vhost"
  dedup_server_name_inside_canon "$CANON"

  say "Strip duplicate wolverine include lines (if any)"
  strip_duplicate_wolverine_includes "$CANON"

  say "Inject include into SSL server"
  inject_include_into_ssl_server "$CANON"

  say "nginx -t"
  nginx -t

  say "reload nginx"
  systemctl reload nginx || systemctl restart nginx

  say "Proof (nginx -T grep)"
  nginx -T 2>/dev/null | grep -nE "conflicting server name|server_name[[:space:]]+${DOMAIN}|listen[[:space:]]+443|include /etc/nginx/includes/wolverine_routes.inc|location \\^~ /wolverine/" | head -n 260 || true

  say "DONE"
  echo "Backups: $BK"
  echo "Open: https://${DOMAIN}/wolverine/ (Ctrl+F5)"
}

main "$@"
BASH
chmod +x /root/WV_DEDUP_FIREINNERS_SSL.sh
bash /root/WV_DEDUP_FIREINNERS_SSL.sh'
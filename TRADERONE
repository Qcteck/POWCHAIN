set -euo pipefail

WOLV_OUT="/var/www/wolverine"
TS="$(date +%s)"

echo "=== 1) Scan LARGE: trouver un index.html qui ressemble à WOLVERINE (pas juste le mot wolverine) ==="
# On cherche des signatures probables: /wolverine/, traderone, lifi, phantom, dex, positions, orders, etc.
CAND="$(find /opt /var/www -type f -name index.html -not -path "*/node_modules/*" 2>/dev/null | \
  while read -r f; do
    if grep -qiE "/wolverine/|traderone|lifi|li\.fi|phantom|dex|positions|orders|trades|dashboard" "$f"; then
      echo "$f"
      break
    fi
  done)"

if [ -z "${CAND:-}" ]; then
  echo "KO: aucun index.html type WOLVERINE trouvé via scan large."
  echo "=> On va devoir le RECONSTRUIRE depuis un repo git (voir batch #2)."
  exit 1
fi

SRC_DIR="$(dirname "$CAND")"
echo "OK: trouvé un candidat -> $SRC_DIR"

echo "=== 2) Deploy FORCE -> /var/www/wolverine ==="
apt-get update -y >/dev/null
apt-get install -y rsync >/dev/null
mkdir -p "$WOLV_OUT"
rsync -a --delete "$SRC_DIR/" "$WOLV_OUT/"

echo "=== 3) Preuve locale ==="
grep -nEi "title|wolverine|traderone|lifi|phantom|fireinners|wallet" "$WOLV_OUT/index.html" | head -n 30 || true

echo "=== 4) Preuve HTTP (suivre 301) ==="
curl -LsS https://fireinners.online/wolverine/ | grep -iE "<title>|wolverine|traderone|lifi|phantom|fireinners|wallet" | head -n 30 || true

echo "DONE ✅"
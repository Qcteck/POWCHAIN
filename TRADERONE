set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

PAT='location\s+\^~\s+/wolverine/traderone/api/'
FINAL="/etc/nginx/snippets/wolverine_final.conf"

echo "=== 1) Où est le duplicate (nginx -T source of truth) ==="
nginx -T 2>/dev/null | grep -nE "$PAT" | head -n 200 || true

echo
echo "=== 2) Quels fichiers contiennent ce location ==="
mapfile -t FILES < <(grep -RIn --include="*.conf" -E "$PAT" /etc/nginx 2>/dev/null | awk -F: '{print $1}' | sort -u)
printf ' - %s\n' "${FILES[@]:-<none>}"

echo
echo "=== 3) Désactiver tous les duplicates SAUF dans wolverine_final.conf ==="
i=0
for f in "${FILES[@]}"; do
  if [ "$f" = "$FINAL" ]; then
    echo "Keep (final): $f"
    continue
  fi
  i=$((i+1))
  cp -a "$f" "$f.bak.dupe_api.$TS" || true
  # renomme la location pour éviter collision
  sed -i -E "s|location[[:space:]]+\^~[[:space:]]+/wolverine/traderone/api/|location ^~ /_disabled_dupe_traderone_api_${TS}_${i}/|g" "$f"
  echo "Disabled duplicate in: $f"
done

echo
echo "=== 4) Test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 5) Recheck ==="
nginx -T 2>/dev/null | grep -nE "$PAT" | head -n 80 || echo "✅ plus aucun duplicate traderone/api"
echo "DONE ✅"
set -euo pipefail
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

node - <<'JS'
const fs=require("fs");
const f="/var/www/fireinners/wolverine/app.js";
let s=fs.readFileSync(f,"utf8");

// Inject/replace getSPL() with a window-scan resolver
const re = /function getSPL\(\)\{[\s\S]*?\}\n/;
const newGetSPL = `function getSPL(){
  const cands = [window.splToken, window.SplToken, window.spl_token, window.SPLToken, window.spltoken];
  for (const v of cands) {
    if (v && typeof v.getAssociatedTokenAddress === "function") return v;
    if (v && v.default && typeof v.default.getAssociatedTokenAddress === "function") return v.default;
  }
  for (const [k,v] of Object.entries(window)) {
    if (!v || typeof v !== "object") continue;
    if (typeof v.getAssociatedTokenAddress === "function" &&
        typeof v.createTransferCheckedInstruction === "function") {
      console.log("[SPL] detected window." + k);
      return v;
    }
    if (v.default && typeof v.default === "object" &&
        typeof v.default.getAssociatedTokenAddress === "function") {
      console.log("[SPL] detected window." + k + ".default");
      return v.default;
    }
  }
  return null;
}\n`;

if (re.test(s)) s = s.replace(re, newGetSPL);
else s = s.replace(/function libsOk\(\)\{[\s\S]*?\}\n/, (m)=> m + newGetSPL);

// Ensure sendUsdc uses SPL
s = s.replace(
  /async function sendUsdc\(\{fromPk, toPk, amountUsdc\}\)\{\s*const connection = await conn\(\);\s*/m,
`async function sendUsdc({fromPk, toPk, amountUsdc}){
    const connection = await conn();
    const SPL = getSPL();
    if(!SPL || typeof SPL.getAssociatedTokenAddress !== "function"){
      throw new Error("spl-token manquant (export global introuvable)");
    }
`
);

// Replace remaining window.splToken.* with SPL.*
s = s.replace(/\bwindow\.splToken\./g, "SPL.");

fs.writeFileSync(f,s,"utf8");
console.log("OK: SPL auto-detect patch applied");
JS

echo "DONE ✅ Ctrl+F5 sur /wolverine puis reteste START"
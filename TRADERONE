cat > /etc/nginx/sites-available/fireinners.online <<'EOF'
server {
  listen 80;
  server_name fireinners.online;

  # API TraderOne (backend local sur 12703)
  location ^~ /wolverine/traderone/api/ {
    proxy_pass http://127.0.0.1:12703;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # (optionnel) le reste -> 404
  location / { return 404; }
}
EOF

ln -sf /etc/nginx/sites-available/fireinners.online /etc/nginx/sites-enabled/fireinners.online
rm -f /etc/nginx/sites-enabled/default
nginx -t && systemctl reload nginx
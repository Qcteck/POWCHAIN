.loops.sys.step="S1_HEALTH";renderStates();const h=await api("/health");if(!h.ok){add("AI","Backend indisponible. Mode dégradé.","ai");return;}S.loops.sys.step="S2_METRICS";S.last.metrics=await api("/metrics");S.loops.sys.step="S7_SYNC";S.last.state=await api("/state");S.loops.sys.step="S8_NEXT";save();renderStates();renderPending();};const loadRssAndArticle=async()=>{S.loops.lrn.step="L0_SCAN";const r=await api("/rss/latest");S.last.rss=r;if(!r.ok||!r.items||!r.items.length){add("AI","RSS vide/bloqué. Je continue sans… élégance.","ai");return;}const pick=r.items[0];S.ctx.lastTitle=pick.title||"";S.ctx.lastUrl=pick.link||"";save();S.loops.lrn.step="L2_READ";const a=await api("/article/auto?url="+encodeURIComponent(pick.link)+"&title="+encodeURIComponent(pick.title||""));S.last.article=a;save();S.loops.lrn.step="L3_ANALYZE";renderStates();const sum=a.ok?a.summary:"(lecture article bloquée)";add("AI",`Article lu.\nTitre:\n${S.ctx.lastTitle}\n\nRésumé:\n${sum}\n\nQuestion (1): tu veux RAPPORT, PLAN, ou WATCHLIST ?`,"ai");speak("Article analysé. Choisis: rapport, plan, ou watchlist.");S.loops.lrn.step="L6_DIALOGUE";save();renderStates();};const loadPending=async(silent)=>{const p=await api("/actions/pending");if(p.ok){S.last.pending=p.pending||[];save();renderPending();if(!silent) add("SYS","Pending chargé.","sys");}};const approveFirst=async()=>{await loadPending(true);const x=(S.last.pending||[]).find(i=>i.status==="PENDING");if(!x){add("SYS","Aucun PENDING.","sys");return;}const r=await api("/actions/approve",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({id:x.id})});if(r.ok){add("SYS","APPROUVÉ: "+x.type,"sys");await loadPending(true);}else add("AI","Échec approve: "+r.error,"ai");};const denyFirst=async()=>{await loadPending(true);const x=(S.last.pending||[]).find(i=>i.status==="PENDING");if(!x){add("SYS","Aucun PENDING.","sys");return;}const r=await api("/actions/deny",{method:"POST",headers:{"content-type":"application/json"},body
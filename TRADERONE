set -euo pipefail

# SOURCE (ce que tu veux tester) : ici v0008 (stable)
SRC="/var/www/wolverine/_index_versions/v0008.html"

# DEST test
TEST_DIR="/var/www/fireinners_test"
mkdir -p "$TEST_DIR"

[ -f "$SRC" ] || { echo "❌ Missing $SRC"; exit 1; }

cp -a "$SRC" "$TEST_DIR/index.html"
chown -R www-data:www-data "$TEST_DIR" 2>/dev/null || true
chmod -R a+rX "$TEST_DIR" || true

# nginx snippet pour /test/
SNIP="/etc/nginx/snippets/fireinners_test.conf"
mkdir -p /etc/nginx/snippets

cat > "$SNIP" <<'NGX'
location = /test { return 301 /test/; }
location ^~ /test/ {
  alias /var/www/fireinners_test/;
  try_files $uri $uri/ /test/index.html;
}
NGX

# Inject l'include dans le server fireinners.online (tous les fichiers qui le déclarent)
FILES="$(nginx -T 2>/dev/null | awk '
  /^# configuration file /{f=$4}
  /server_name/ && /fireinners\.online/ {print f}
' | sort -u)"

for f in $FILES; do
  [ -f "$f" ] || continue
  grep -q "snippets/fireinners_test.conf" "$f" && continue
  cp -a "$f" "$f.bak.test.$(date +%Y%m%d_%H%M%S)"
  sed -i '0,/server[[:space:]]*{/s//server {\n    include \/etc\/nginx\/snippets\/fireinners_test.conf;/' "$f"
done

nginx -t && systemctl reload nginx

echo "✅ TEST LINK:"
echo "https://fireinners.online/test/"
curl -sS -I https://fireinners.online/test/ | head -n 12 || true
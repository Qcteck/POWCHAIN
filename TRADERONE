set -euo pipefail
APPJS="/var/www/fireinners/wolverine/app.js"
TS="$(date +%s)"
cp -a "$APPJS" "$APPJS.bak.$TS"
echo "Backup: $APPJS.bak.$TS"

# enlève ancien bloc si déjà ajouté
perl -0777 -i -pe 's|/\*\s*WOLVERINE_FORCE_START_CLICKABLE_BEGIN\s*\*/.*?/\*\s*WOLVERINE_FORCE_START_CLICKABLE_END\s*\*/\s*||sg' "$APPJS" || true

cat >> "$APPJS" <<'JS'

/* WOLVERINE_FORCE_START_CLICKABLE_BEGIN */
(function(){
  const btn = document.getElementById("btnStart");
  if(!btn) return;

  // START toujours visible + cliquable
  function forceClickable(){
    btn.style.display = "";
    btn.style.visibility = "visible";
    btn.style.pointerEvents = "auto";
    btn.style.cursor = "pointer";
    btn.disabled = false;
    btn.style.opacity = "1";
  }

  // log pour confirmer que le click est capté
  btn.addEventListener("click", (ev)=>{
    console.log("[START] click captured");
    // si pas connecté, on donne un message clair
    if(!window.pubkey){
      (window.setStatus||console.log)("Connecte ton wallet puis START");
    }
  }, true);

  // garde-fou: si un autre code le re-disable, on le remet on
  forceClickable();
  setInterval(forceClickable, 800);
})();
 /* WOLVERINE_FORCE_START_CLICKABLE_END */

JS

echo "OK ✅ Ctrl+F5 sur /wolverine puis clique START"
  perl -0777 -i -pe '"'"'s#</body>#\n<!-- '"$PATCH_MARK"' -->\n<script>(function(){function q(a,b){return (b||document).querySelector(a)}function qa(a,b){return Array.from((b||document).querySelectorAll(a))}function byText(tag,txt){var els=qa(tag);txt=(txt||"").toLowerCase();for(var i=0;i<els.length;i++){var t=(els[i].textContent||"").trim().toLowerCase();if(t===txt||t.indexOf(txt)>=0)return els[i]}return null}function stat(m){try{var s=q("#status")||byText("div","status")||q("div");if(s){s.textContent=("Status: "+m)}else{console.log("[STATUS]",m)}}catch(e){console.log("[STATUS]",m)}}async function waitLibs(){for(var i=0;i<120;i++){var ok=!!(window.solana&&window.solana.isPhantom&&window.solanaWeb3&&window.splToken);if(ok)return true;await new Promise(r=>setTimeout(r,100));}return false}async function ensureConn(){if(!window.solana||!window.solana.isPhantom)throw new Error("Phantom absent");try{var r=await window.solana.connect({onlyIfTrusted:true});if(r&&r.publicKey)return r.publicKey}catch(e){}var r2=await window.solana.connect();return r2.publicKey}function getBudget(){var inp=q("input[type=text]")||q("input[type=number]");if(!inp)throw new Error("Budget input introuvable");var v=(inp.value||"").trim().replace(",",".");if(!v)throw new Error("Budget vide");var n=Number(v);if(!isFinite(n)||n<=0)throw new Error("Budget invalide");return n}function getTraderAddr(){var t=document.body.innerText||"";var m=t.match(/Adresse:\\s*([1-9A-HJ-NP-Za-km-z]{32,44})/);if(m&&m[1])return m[1].trim();throw new Error("Adresse TraderOne introuvable")}async function paySOL(amount,toBase58){var w=window.solana,web3=window.solanaWeb3;var from=await ensureConn();var conn=new web3.Connection(web3.clusterApiUrl("mainnet-beta"),"confirmed");try{if(window.__RPC__)conn=new web3.Connection(window.__RPC__,"confirmed")}catch(e){}var to=new web3.PublicKey(toBase58);var ix=web3.SystemProgram.transfer({fromPubkey:from,toPubkey:to,lamports:Math.round(amount*1e9)});var tx=new web3.Transaction().add(ix);tx.feePayer=from;var bh=await conn.getLatestBlockhash();tx.recentBlockhash=bh.blockhash;var signed=await w.signTransaction(tx);var sig=await conn.sendRawTransaction(signed.serialize(),{skipPreflight:false});await conn.confirmTransaction({signature:sig,blockhash:bh.blockhash,lastValidBlockHeight:bh.lastValidBlockHeight},"confirmed");return sig}async function payUSDC(amount,toBase58){var w=window.solana,web3=window.solanaWeb3,spl=window.splToken;var from=await ensureConn();var conn=new web3.Connection(web3.clusterApiUrl("mainnet-beta"),"confirmed");try{if(window.__RPC__)conn=new web3.Connection(window.__RPC__,"confirmed")}catch(e){}var USDC_MINT=new web3.PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v");var to=new web3.PublicKey(toBase58);var fromATA=await spl.getAssociatedTokenAddress(USDC_MINT,from,false,spl.TOKEN_PROGRAM_ID,spl.ASSOCIATED_TOKEN_PROGRAM_ID);var toATA=await spl.getAssociatedTokenAddress(USDC_MINT,to,false,spl.TOKEN_PROGRAM_ID,spl.ASSOCIATED_TOKEN_PROGRAM_ID);var ixs=[];var toInfo=await conn.getAccountInfo(toATA).catch(()=>null);if(!toInfo){ixs.push(spl.createAssociatedTokenAccountInstruction(from,toATA,to,USDC_MINT,spl.TOKEN_PROGRAM_ID,spl.ASSOCIATED_TOKEN_PROGRAM_ID))}var dec=6;var units=Math.round(amount*Math.pow(10,dec));ixs.push(spl.createTransferInstruction(fromATA,toATA,from,units,[],spl.TOKEN_PROGRAM_ID));var tx=new web3.Transaction();for(var i=0;i<ixs.length;i++)tx.add(ixs[i]);tx.feePayer=from;var bh=await conn.getLatestBlockhash();tx.recentBlockhash=bh.blockhash;var signed=await w.signTransaction(tx);var sig=await conn.sendRawTransaction(signed.serialize(),{skipPreflight:false});await conn.confirmTransaction({signature:sig,blockhash:bh.blockhash,lastValidBlockHeight:bh.lastValidBlockHeight},"confirmed");return sig}function install(){var start=byText("button","start wolverine (traderone)")||byText("button","start wolverine")||byText("input","start wolverine (traderone)")||byText("input","start wolverine");if(!start){stat("START introuvable");return}start.style.display="none";var row=start.parentElement||document.body;var wrap=document.createElement("span");wrap.style.marginLeft="8px";var sel=document.createElement("select");sel.id="assetSelect";sel.innerHTML="<option value=SOL>SOL</option><option value=USDC>USDC</option>";sel.style.marginLeft="8px";var pay=document.createElement("button");pay.type="button";pay.id="payBtn";pay.textContent="PAYER (Phantom)";pay.style.marginLeft="8px";wrap.appendChild(document.createTextNode("Asset: "));wrap.appendChild(sel);wrap.appendChild(pay);row.appendChild(wrap);pay.addEventListener("click",async function(ev){ev.preventDefault();ev.stopPropagation();try{stat("Paiement: préparation");var ok=await waitLibs();if(!ok)throw new Error("Libs Solana non prêtes");var amt=getBudget();var to=getTraderAddr();var asset=sel.value;stat("Paiement: ouverture Phantom");var sig=(asset==="USDC")?await payUSDC(amt,to):await paySOL(amt,to);stat("Pay OK: "+sig);start.style.display="";}catch(e){stat("ERR: "+(e&&e.message?e.message:e));console.error(e)}})}document.addEventListener("DOMContentLoaded",install)}catch(e){console.error(e)}})();</script>\n</body>#is'"'"' "$F";
  echo "[PATCH] $F"
done
echo "OK. Recharge la page en dur (Ctrl+F5). Au clic PAYER, Phantom doit pop pour signer. START apparait après paiement."'
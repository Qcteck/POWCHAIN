import http from "http";
const UPSTREAM = process.env.UPSTREAM || "${DRPC_SOLANA}";
const HOST = "127.0.0.1";
const PORT = parseInt(process.env.PORT || "${SOLRPC_PORT}", 10);

function send(res, code, body, ct="application/json; charset=utf-8"){
  res.writeHead(code, {
    "content-type": ct,
    "access-control-allow-origin": "*",
    "access-control-allow-methods": "POST, GET, OPTIONS",
    "access-control-allow-headers": "content-type, authorization"
  });
  res.end(body);
}

http.createServer(async (req,res)=>{
  if(req.method==="OPTIONS") return send(res,204,"","text/plain; charset=utf-8");
  if(req.url==="/health"||req.url==="/"||req.url==="/ping") return send(res,200,JSON.stringify({status:"ok",service:"wolverine-solrpc-proxy",upstream:UPSTREAM}));
  if(req.method!=="POST") return send(res,405,JSON.stringify({error:"method_not_allowed"}));
  let raw=""; req.on("data",c=>raw+=c);
  req.on("end", async ()=>{
    try{
      const r=await fetch(UPSTREAM,{method:"POST",headers:{"content-type":"application/json"},body:raw||"{}"});
      const t=await r.text();
      // force JSON to avoid frontend "Unexpected token <"
      return send(res,r.status,t,"application/json; charset=utf-8");
    }catch(e){
      return send(res,502,JSON.stringify({error:"bad_gateway",message:(e&&e.message)?e.message:String(e)}));
    }
  });
}).listen(PORT,HOST,()=>console.log("solrpc proxy on http://"+HOST+":"+PORT));

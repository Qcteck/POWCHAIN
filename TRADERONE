async function sendTelegramMessage(message){
  try{
    const url = `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`;
    await fetch(url,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify({
        chat_id: TELEGRAM_CHAT_ID,
        text: message,
        parse_mode:"Markdown"
      })
    });
    log("📡 Article IA envoyé sur Telegram");
  }catch(e){console.warn("Erreur Telegram :",e);}
}

function generateAIArticle(){
  const stock = JSON.parse(localStorage.getItem("rssStock")||"[]");
  if(stock.length < 5){log("⛔ Pas assez de données pour analyse IA"); return;}
  const sample = stock.slice(-8);
  let keywords = {}, sentiment = 0;

  sample.forEach(a=>{
    const text = (a.title+" "+(a.description||"")).toLowerCase();

else if(p.amountRaw!=null){amountRaw=String(p.amountRaw); if(!/^\d+$/.test(amountRaw))bad("bad payload amountRaw");}
else {amountRaw=String(Math.floor(Number(p.amountIn)*Math.pow(10,dec))); if(amountRaw==="NaN")bad("cannot compute raw");}
const quote=await jupQuote(p.inMint,p.outMint,amountRaw,Number(p.slippageBps||120));

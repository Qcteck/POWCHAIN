#!/usr/bin/env bash
set -euo pipefail

echo "=== AIAQUILA FIX FINAL (NO BACKEND / NO CORS) ==="

ROOT="/var/www/aiaquila"
HTML="$ROOT/index.html"
BACKUP="$ROOT/index.backup_$(date +%Y%m%d_%H%M%S).html"

mkdir -p "$ROOT"
[ -f "$HTML" ] && cp "$HTML" "$BACKUP"

cat > "$HTML" <<'HTML'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>AIAQUILA — EmberBrain</title>
<style>
body{background:#0b1220;color:#cfe3ff;font-family:Arial;padding:20px}
button,select,input{padding:8px;margin:5px}
#log{white-space:pre-wrap;background:#020617;padding:10px;border-radius:6px;height:240px;overflow:auto}
</style>
</head>
<body>

<h1>🦅 AIAQUILA — EmberBrain</h1>
<p>Lecture RSS locale + voix navigateur (sans backend)</p>

<button onclick="readArticles()">▶ Lire les articles</button>

<select id="voiceSelect"></select>

<div id="log"></div>

<script>
/* ====== RSS LOCAL (ANTI-CORS) ====== */
const ARTICLES = [
  {title:"Bitcoin dépasse une résistance clé", summary:"Les analystes observent une pression haussière à court terme."},
  {title:"Ethereum attire les institutionnels", summary:"Les flux vers les ETF ETH augmentent fortement."},
  {title:"Marché crypto prudent avant les annonces macro", summary:"Les traders réduisent le levier avant les chiffres économiques."}
];

const log = t => {
  const d=document.getElementById("log");
  d.textContent+=t+"\\n";
  d.scrollTop=d.scrollHeight;
};

/* ====== VOIX ====== */
let voices=[];
speechSynthesis.onvoiceschanged=()=>{
  voices=speechSynthesis.getVoices();
  const sel=document.getElementById("voiceSelect");
  sel.innerHTML="";
  voices.forEach((v,i)=>{
    const o=document.createElement("option");
    o.value=i;
    o.textContent=v.name+" ("+v.lang+")";
    sel.appendChild(o);
  });
};

function speak(text){
  if(!text)return;
  const u=new SpeechSynthesisUtterance(text);
  const sel=document.getElementById("voiceSelect");
  u.voice=voices[sel.value]||voices[0];
  u.lang=u.voice.lang;
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}

/* ====== LECTURE ====== */
async function readArticles(){
  log("Lecture des articles...");
  for(const a of ARTICLES){
    log("• "+a.title);
    speak(a.title+". "+a.summary);
    await new Promise(r=>setTimeout(r,4500));
  }
  log("Lecture terminée.");
}
</script>

</body>
</html>
HTML

echo "✔ AIAQUILA corrigé"
echo "✔ Backup : $BACKUP"
echo "➡ Recharge la page (Ctrl+F5)"
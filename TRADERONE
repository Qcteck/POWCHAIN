set -e
cd /root

echo "=== 0) Montrer l'erreur exacte (avec fichier:ligne) ==="
nginx -t 2>&1 || true

echo
echo "=== 1) Trouver TOUS les 'map' liés à api_key/traderone_ok ==="
grep -RIn --line-number -E '^\s*map\s+\$http_x_api_key\s+\$traderone_ok|traderone_ok|http_x_api_key' \
  /etc/nginx/nginx.conf /etc/nginx/conf.d /etc/nginx/sites-enabled /etc/nginx/snippets 2>/dev/null || true

echo
echo "=== 2) Backup ==="
mkdir -p /root/nginx_backups
cp -v /etc/nginx/nginx.conf "/root/nginx_backups/nginx.conf.$(date +%Y%m%d_%H%M%S)"
for f in /etc/nginx/conf.d/* /etc/nginx/snippets/* /etc/nginx/sites-enabled/*; do
  [ -f "$f" ] || continue
  cp -n "$f" "/root/nginx_backups/$(echo "$f" | sed 's#/#__#g').$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
done

echo
echo "=== 3) SUPPRIMER les blocs map cassés (partout) ==="
for f in /etc/nginx/nginx.conf /etc/nginx/conf.d/* /etc/nginx/snippets/*; do
  [ -f "$f" ] || continue
  perl -0777 -i -pe '
    s/\n\s*map\s+\$http_x_api_key\s+\$traderone_ok\s*\{.*?\}\s*\n/\n/sg;
  ' "$f"
done

echo
echo "=== 4) Re-test nginx ==="
nginx -t
systemctl reload nginx
# 2) Nettoyer les doublons "conflicting server_name" dans sites-enabled (sans toucher au canon)
DISABLED_DIR=Path("/root/nginx_disabled")
DISABLED_DIR.mkdir(parents=True, exist_ok=True)
canon = VHOST

# unlock vhost if immutable
sh(f"chattr -i {VHOST} 2>/dev/null || true")

for f in sorted(SITESEN.glob("*")):
    try:
        if not f.exists(): 
            continue
        # resolve symlink
        tgt = Path(os.path.realpath(str(f)))
        txt = ""
        try:
            txt = f.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            # maybe symlink; read target
            try: txt = tgt.read_text(encoding="utf-8", errors="ignore")
            except Exception: txt = ""
        if re.search(r"server_name\s+.*\bfireinners\.online\b", txt):
            if tgt != canon:
                sh(f"chattr -i {f} {tgt} 2>/dev/null || true")
                dest = DISABLED_DIR/(f.name+f".disabled.{TS}")
                try:
                    if f.is_symlink():
                        f.unlink()
                        log(f"Supprimé symlink doublon: {f}")
                    else:
                        shutil.move(str(f), str(dest))
                        log(f"Déplacé doublon: {f} -> {dest}")
                except Exception as e:
                    log(f"Warning disable doublon ({f}): {e}")
    except Exception as e:
        log(f"Warning scan sites-enabled ({f}): {e}")

# ensure canon enabled
try:
    link = SITESEN/canon.name
    if link.exists() or link.is_symlink():
        try:
            if Path(os.path.realpath(str(link))) != canon:
                try: link.unlink()
                except Exception: pass
    if not link.exists():
        os.symlink(str(canon), str(link))
    log(f"sites-enabled OK: {link} -> {canon}")
except Exception as e:
    log(f"Warning ensure canon enabled: {e}")


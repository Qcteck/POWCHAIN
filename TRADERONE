set -e
cd /root

# 1) Vérif fichier
ls -la /root/get_balances.cjs

# 2) Backup
cp -v /root/get_balances.cjs "/root/get_balances.cjs.bak.$(date +%Y%m%d_%H%M%S)"

# 3) Patch auto (remplace getTokenBalance + ajoute TOKEN_PROGRAM_ID si absent)
node <<'NODE'
const fs = require("fs");

const file = "/root/get_balances.cjs";
let s = fs.readFileSync(file, "utf8");

// Ajoute TOKEN_PROGRAM_ID si absent
if (!s.includes("TOKEN_PROGRAM_ID = new PublicKey(")) {
  // essaie d'insérer après les imports web3.js (ligne qui contient require("@solana/web3.js"))
  const marker = 'require("@solana/web3.js");';
  if (s.includes(marker)) {
    s = s.replace(marker, marker + '\n\nconst TOKEN_PROGRAM_ID = new PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA");\n');
  } else {
    // fallback: ajoute en haut après "use strict"
    s = s.replace(/(['"]use strict['"];\s*\n)/, `$1\nconst TOKEN_PROGRAM_ID = new (require("@solana/web3.js").PublicKey)("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA");\n`);
  }
}

// Remplace la fonction getTokenBalance(...) (toute la fonction)
const re = /async function getTokenBalance\s*\([\s\S]*?\n}\n/g;
const replacement =
`async function getTokenBalance(connection, ownerPubkey, mintStr) {
  const mintWanted = mintStr;

  const resp = await connection.getParsedTokenAccountsByOwner(
    ownerPubkey,
    { programId: TOKEN_PROGRAM_ID }
  );

  let ui = 0;
  for (const acc of resp.value) {
    const info = acc.account.data.parsed.info;
    if (info?.mint === mintWanted) {
      ui += (info.tokenAmount.uiAmount ?? 0);
    }
  }
  return ui;
}
`;

if (!re.test(s)) {
  throw new Error("getTokenBalance(...) introuvable dans /root/get_balances.cjs");
}
s = s.replace(re, replacement);

fs.writeFileSync(file, s);
console.log("✅ Patch OK: getTokenBalance remplacée + TOKEN_PROGRAM_ID ajouté si besoin");
NODE

# 4) Run
node /root/get_balances.cjs
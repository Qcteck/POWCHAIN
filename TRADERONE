function loadJSON(p,def){try{return JSON.parse(fs.readFileSync(p,"utf8"));}catch(_){return def;}}
function saveJSON(p,obj){fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,JSON.stringify(obj,null,2));}

function loadKeypair(){
  const arr=loadJSON(KEYPAIR_PATH,null);
  if(!arr||!Array.isArray(arr)||arr.length<32) throw new Error("invalid keypair file");
  return Keypair.fromSecretKey(Uint8Array.from(arr));
}

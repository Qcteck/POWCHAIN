set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
PAT='location[[:space:]]+(\^~|~\*?|=)?[[:space:]]*/wolverine/traderone/api/?'
BACK="/etc/nginx.bak.$TS"

echo "=== Backup /etc/nginx -> $BACK ==="
cp -a /etc/nginx "$BACK"

echo "=== Files containing the duplicate location ==="
mapfile -t FILES < <(grep -RIn --include="*.conf" -E "$PAT" /etc/nginx 2>/dev/null | awk -F: '{print $1}' | sort -u)

printf ' - %s\n' "${FILES[@]}"
[ "${#FILES[@]}" -gt 0 ] || { echo "❌ No match found in /etc/nginx"; exit 1; }

echo
echo "=== Keep first file, disable the location in all others ==="
KEEP="${FILES[0]}"
echo "KEEP: $KEEP"

i=0
for f in "${FILES[@]}"; do
  if [ "$f" = "$KEEP" ]; then
    echo "✅ keep: $f"
    continue
  fi
  i=$((i+1))
  cp -a "$f" "$f.bak.dupe_$TS"
  sed -i -E "s|$PAT|location ^~ /_disabled_dupe_traderone_api_${TS}_${i}/|g" "$f"
  echo "🚫 disabled in: $f"
done

echo
echo "=== Test + reload ==="
nginx -t
systemctl reload nginx

echo "✅ OK. Backup: $BACK"
cat >/root/AIAQUILA_NGINX_ROUTE_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

SITE="fireinners.online"
VHOST="/etc/nginx/sites-available/$SITE"
INCLUDE="/etc/nginx/snippets/aiaquila_api.conf"

echo "=== AIAQUILA NGINX ROUTE FIX ==="

echo "[1/4] Writing API snippet"
cat >"$INCLUDE" <<'NGX'
location /aiaquila/api/rss {
    proxy_pass https://aiaquila-proxy.paycashnostory.workers.dev/rss;
    proxy_set_header Host aiaquila-proxy.paycashnostory.workers.dev;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_ssl_server_name on;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}
NGX

echo "[2/4] Inject include if missing"
grep -q "aiaquila_api.conf" "$VHOST" || \
  sed -i '/server_name fireinners.online;/a \    include /etc/nginx/snippets/aiaquila_api.conf;' "$VHOST"

echo "[3/4] Test nginx"
nginx -t

echo "[4/4] Reload nginx"
systemctl reload nginx

echo "DONE"
echo "Test: curl https://fireinners.online/aiaquila/api/rss?url=https://news.bitcoin.com/feed/"
BASH

chmod +x /root/AIAQUILA_NGINX_ROUTE_FIX.sh
/root/AIAQUILA_NGINX_ROUTE_FIX.sh
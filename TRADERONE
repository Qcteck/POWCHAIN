cat >/root/WOLVERINE_UI_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -e

echo "===== WOLVERINE UI FINAL ====="

HTML="/var/www/wolverine/index.html"

cat >"$HTML" <<'HTML'
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>WOLVERINE • TraderOne</title>
<style>
body{margin:0;background:#061a2b;color:#e8f7ff;font-family:Arial}
.box{max-width:520px;margin:40px auto;border:2px solid #00eaff;padding:20px}
.btn{width:100%;padding:14px;margin:8px 0;font-size:18px;
background:#00eaff;border:0;cursor:pointer;font-weight:bold}
input{width:100%;padding:12px;font-size:16px;margin:8px 0}
.log{margin-top:10px;white-space:pre-wrap}
</style>
</head>
<body>

<div class="box">
<h2>WOLVERINE / TraderOne</h2>

<button class="btn" onclick="connect()">Connect Wallet</button>
<button class="btn" onclick="refresh()">Refresh</button>

<div id="info">
Address: <span id="addr">-</span><br>
SOL: <span id="sol">-</span>
</div>

<input id="amount" placeholder="Budget SOL">
<button class="btn" onclick="send()">Envoyer à TraderOne</button>

<div id="log" class="log"></div>
</div>

<script>
let walletAddress=null;

async function connect(){
 if(!window.solana){log("Phantom non détecté");return;}
 const r=await window.solana.connect();
 walletAddress=r.publicKey.toString();
 document.getElementById("addr").innerText=walletAddress;
}

function refresh(){log("Refresh OK");}

async function send(){
 const amount=parseFloat(document.getElementById("amount").value);
 if(!walletAddress||!amount){log("Paramètres invalides");return;}

 const r=await fetch("/wolverine/traderone/api/budget",{
  method:"POST",
  headers:{"Content-Type":"application/json"},
  body:JSON.stringify({from:walletAddress,amount})
 });

 const t=await r.text();
 try{log(JSON.stringify(JSON.parse(t),null,2))}
 catch{log("Réponse non JSON:\n"+t)}
}

function log(t){document.getElementById("log").innerText=t;}
</script>

</body>
</html>
HTML

nginx -t && systemctl reload nginx
echo "✅ UI FINALE DÉPLOYÉE"
echo "➡️ Recharge https://fireinners.online/wolverine (CTRL+SHIFT+R)"

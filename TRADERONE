<!doctype html><html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AUTOTUNEAMC</title><style>html,body{margin:0;background:#070a12;color:#e7f0ff;font:14px system-ui}#w{max-width:980px;margin:0 auto;padding:12px}#b{display:flex;flex-wrap:wrap;gap:8px;align-items:center}button,input{background:#0c1222;color:#e7f0ff;border:1px solid #23324a;border-radius:10px;padding:10px 12px}button{cursor:pointer}button:active{transform:translateY(1px)}#log{width:100%;height:52vh;resize:vertical;background:#050813;color:#cfe2ff;border:1px solid #23324a;border-radius:12px;padding:10px;box-sizing:border-box;white-space:pre-wrap;overflow:auto}#row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}#row input{flex:1;min-width:220px}#ft{opacity:.7;margin-top:10px;font-size:12px}</style><body><div id="w"><div id="b"><button id="btnLoad">Charger</button><button id="btnSave">Sauver</button><button id="btnReset">Reset</button><button id="btnObserve">Observe test</button><button id="btnTune">Proposer x10</button><button id="btnTop">Top</button><button id="btnExport">Export</button></div><div id="row"><input id="evalName" placeholder="Nom évaluation (ex: BBTRADER loop)"><input id="space" placeholder="Espace params JSON (ex: {&quot;cadenceMs&quot;:{&quot;min&quot;:5000,&quot;max&quot;:60000,&quot;step&quot;:5000}})"></div><textarea id="log" spellcheck="false"></textarea><div id="ft">Dave</div></div><script>(()=>{const K="AUTOTUNEAMC_STATE",now=()=>Date.now(),j=s=>{try{return JSON.parse(s)}catch(_){return null}},sj=o=>{try{return JSON.stringify(o)}catch(_){return"{}"}},clamp=(x,a,b)=>Math.max(a,Math.min(b,x)),rand=(a,b)=>a+Math.random()*(b-a),pick=a=>a[(Math.random()*a.length)|0];const api=(()=>{let S={v:1,created:now(),meta:{alpha:0.34,beta:0.33,gamma:0.33,riskPenalty:0.5,arm:false},amc:{events:[],agg:{pnl:0,roi:0,lat:0,err:0,entropy:0},prio:{short:[],mid:[],long:[]}},tune:{spaces:{},runs:[],bandit:{},best:{}},links:{methods:{},contexts:{}}};const log=(...a)=>{const t=new Date().toISOString();ui.log(t+" "+a.map(x=>typeof x==="string"?x:sj(x)).join(" ")+"\n")};const load=()=>{const x=j(localStorage.getItem(K)||"");if(x&&typeof x==="object"){S=x;S.v=1;S.meta=S.meta||{alpha:0.34,beta:0.33,gamma:0.33,riskPenalty:0.5,arm:false};S.amc=S.amc||{events:[],agg:{pnl:0,roi:0,lat:0,err:0,entropy:0},prio:{short:[],mid:[],long:[]}};S.tune=S.tune||{spaces:{},runs:[],bandit:{},best:{}};S.links=S.links||{methods:{},contexts:{}};log("LOAD ok");}else log("LOAD vide");return S};const save=()=>{localStorage.setItem(K,sj(S));log("SAVE ok");return true};const reset=()=>{localStorage.removeItem(K);S={v:1,created:now(),meta:{alpha:0.34,beta:0.33,gamma:0.33,riskPenalty:0.5,arm:false},amc:{events:[],agg:{pnl:0,roi:0,lat:0,err:0,entropy:0},prio:{short:[],mid:[],long:[]}},tune:{spaces:{},runs:[],bandit:{},best:{}},links:{methods:{},contexts:{}}};log("RESET ok");return S};const arm=(on)=>{S.meta.arm=!!on;save();return S.meta.arm};const impactScore=e=>{const pnl=+e.pnl||0,roi=+e.roi||0,lat=+e.latencyMs||0,err=+e.errors||0,ent=+e.entropy||0,r=+e.risk||0;const A=S.meta.alpha,B=S.meta.beta,G=S.meta.gamma,RP=S.meta.riskPenalty;const perf=(pnl*0.6+roi*0.4);const cost=(lat/1000)*0.25+err*1.5+ent*0.35;const risk=r*RP;return (A*perf)-(B*cost)-(G*risk)};const observe=(e={})=>{e.t=now();e.score=impactScore(e);S.amc.events.push(e);if(S.amc.events.length>2000)S.amc.events.splice(0,S.amc.events.length-2000);const a=S.amc.agg;a.pnl+=+e.pnl||0;a.roi+=+e.roi||0;a.lat+=+e.latencyMs||0;a.err+=+e.errors||0;a.entropy+=+e.entropy||0;updatePriorities();save();log("OBS",e);return e};const updatePriorities=()=>{const ev=S.amc.events.slice(-400);const buckets={short:{},mid:{},long:{}};for(const e of ev){const k=(e.method||e.tag||"unknown")+"";const s=+e.score||0;const age=(now()-e.t)/1000;const w=age<3600?1:age<86400?0.6:0.3;const band=s*w;const tgt=age<3600?buckets.short:age<86400?buckets.mid:buckets.long;tgt[k]=(tgt[k]||0)+band}const mk=o=>Object.entries(o).sort((a,b)=>b[1]-a[1]).slice(0,12).map(([k,v])=>({k,score:+v.toFixed(6)}));S.amc.prio={short:mk(buckets.short),mid:mk(buckets.mid),long:mk(buckets.long)};return S.amc.prio};const registerSpace=(name,space)=>{if(!name)throw Error("name");if(typeof space!=="object"||!space)throw Error("space");S.tune.spaces[name]=space;S.tune.bandit[name]=S.tune.bandit[name]||{tries:0,arms:{}};save();log("SPACE",name,space);return true};const sampleFromSpace=(space)=>{const p={};for(const k in space){const d=space[k]||{};if(Array.isArray(d.values)&&d.values.length)p[k]=pick(d.values);else{const mn=+d.min, mx=+d.max, st=+d.step||0;let v=rand(isFinite(mn)?mn:0,isFinite(mx)?mx:1);if(st>0)v=Math.round(v/st)*st;p[k]=typeof d.type==="string"&&d.type==="int"?Math.round(v):v}if(d.round!=null){const r=+d.round||0;if(r>0)p[k]=Math.round((+p[k]||0)/r)*r}}return p};const keyOf=p=>sj(Object.keys(p).sort().reduce((o,k)=>(o[k]=p[k],o),{}));const propose=(name,n=10)=>{const sp=S.tune.spaces[name];if(!sp)throw Error("space not found");const out=[];for(let i=0;i<n;i++)out.push(sampleFromSpace(sp));log("PROPOSE",name,n);return out};const recordRun=(name,params,metrics)=>{const r={t:now(),name,params:params||{},metrics:metrics||{},score:impactScore(metrics||{})};S.tune.runs.push(r);if(S.tune.runs.length>5000)S.tune.runs.splice(0,S.tune.runs.length-5000);const k=keyOf(r.params),B=S.tune.bandit[name]||(S.tune.bandit[name]={tries:0,arms:{}});B.tries++;const A=B.arms[k]||(B.arms[k]={n:0,mean:0,best:-1/0,last:0});A.n++;A.last=r.t;A.mean+= (r.score-A.mean)/A.n;A.best=Math.max(A.best,r.score);const cur=S.tune.best[name];if(!cur||r.score>(cur.score||-1/0))S.tune.best[name]=r;save();log("RUN",r);return r};const top=(name,limit=8)=>{const xs=S.tune.runs.filter(r=>r.name===name).sort((a,b)=>b.score-a.score).slice(0,limit);log("TOP",name,limit);return xs};const suggest=(name,context={})=>{const sp=S.tune.spaces[name];if(!sp)throw Error("space not found");const best=S.tune.best[name]?.params||sampleFromSpace(sp);const p=Object.assign({},best);for(const k in p){if(/cadence|interval|delay|sleep/i.test(k)&&context.errors>0)p[k]=clamp((+p[k]||0)*1.2,sp[k]?.min??0,sp[k]?.max??1e18);if(/slippage|tolerance/i.test(k)&&context.failRate>0)p[k]=clamp((+p[k]||0)*1.15,sp[k]?.min??0,sp[k]?.max??1e9);if(/retry|tries/i.test(k)&&context.failRate>0)p[k]=clamp((+p[k]||0)+1,sp[k]?.min??0,sp[k]?.max??1e9)}log("SUGGEST",name,p);return p};const exportState=()=>{const out=sj(S);log("EXPORT bytes",out.length);return out};const importState=(txt)=>{const x=j(txt||"");if(!x||typeof x!=="object")throw Error("bad json");S=x;save();log("IMPORT ok");return S};const attachEvaluator=(name,fn)=>{if(typeof fn!=="function")throw Error("fn");S.links.methods[name]=S.links.methods[name]||{};S.links.methods[name].evaluator=true;api.eval[name]=fn;save();log("EVAL attach",name);return true};const evalRun=async(name,params)=>{const fn=api.eval[name];if(typeof fn!=="function")throw Error("no evaluator for "+name);const m=await fn(params||{});recordRun(name,params,m||{});return m};return {get state(){return S},set state(v){S=v},log,load,save,reset,arm,observe,impactScore,updatePriorities,registerSpace,propose,recordRun,top,suggest,exportState,importState,attachEvaluator,eval:{},evalRun}})();const ui={log:(s)=>{const el=document.getElementById("log");el.value+=s;el.scrollTop=el.scrollHeight}};window.AUTOTUNEAMC=api;document.getElementById("btnLoad").onclick=()=>api.load();document.getElementById("btnSave").onclick=()=>api.save();document.getElementById("btnReset").onclick=()=>api.reset();document.getElementById("btnObserve").onclick=()=>api.observe({method:"autorune+amc",pnl:Math.round(rand(-5,8)),roi:rand(-0.04,0.09),latencyMs:Math.round(rand(20,600)),errors:Math.random()<0.2?1:0,entropy:rand(0,3),risk:rand(0,2)});document.getElementById("btnTune").onclick=()=>{const name=(document.getElementById("evalName").value||"default").trim();const spTxt=(document.getElementById("space").value||"").trim();if(spTxt){const sp=j(spTxt);if(sp)api.registerSpace(name,sp);else api.log("SPACE json invalide")}try{const ps=api.propose(name,10);api.log("PROPOSE out",ps)}catch(e){api.log("PROPOSE err",e.message)}};document.getElementById("btnTop").onclick=()=>{const name=(document.getElementById("evalName").value||"default").trim();try{api.log("TOP out",api.top(name,8))}catch(e){api.log("TOP err",e.message)}};document.getElementById("btnExport").onclick=()=>{const s=api.exportState();navigator.clipboard?.writeText(s).then(()=>api.log("EXPORT clipboard ok")).catch(()=>api.log("EXPORT clipboard fail"));};api.load();})();</script></body></html>
from pathlib import Path
p=Path("${NGX_INC}")
s=p.read_text(errors="ignore")

begin="# BEGIN WOLVERINE_SOLANA_RPC_PROXY"
end="# END WOLVERINE_SOLANA_RPC_PROXY"
block=f"""{begin}
location = /wolverine/solana-rpc {{ return 308 /wolverine/solana-rpc/; }}
location ^~ /wolverine/solana-rpc/ {{
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_set_header Upgrade \$http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://127.0.0.1:${SOLRPC_PORT}/;
}}
{end}
"""

if begin in s and end in s:
  pre=s.split(begin)[0]
  post=s.split(end)[1]
  s=pre+block+post
else:
  s=s.rstrip()+"\n\n"+block+"\n"

p.write_text(s)
print("OK: nginx include patched:", p)

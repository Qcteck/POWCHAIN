cat >/root/TRADERONE_WALLET_INTERNAL.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== TRADERONE WALLET INTERNE VPS ==="

APP_DIR="/opt/traderone"
WALLET_FILE="$APP_DIR/wallet.json"

mkdir -p "$APP_DIR"
cd "$APP_DIR"

if [ -f "$WALLET_FILE" ]; then
  echo "[OK] wallet interne déjà présent"
  exit 0
fi

read -s -p "Clé privée Solana BASE58 (wallet interne VPS) : " PRIV
echo
if [ -z "$PRIV" ]; then
  echo "[ERR] clé vide"
  exit 1
fi

cat > "$WALLET_FILE" <<EOF
{
  "PRIVATE_KEY_BASE58": "$PRIV"
}
EOF

chmod 600 "$WALLET_FILE"

echo "[OK] Wallet interne créé"
echo "[OK] Emplacement : $WALLET_FILE"
SH

chmod +x /root/TRADERONE_WALLET_INTERNAL.sh
/root/TRADERONE_WALLET_INTERNAL.sh







ls -l /opt/traderone/wallet.json





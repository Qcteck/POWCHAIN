cat >"$UI_DIR/src/App.jsx" <<'JSX'
import React,{useEffect,useState} from "react";
const now=()=>Date.now();
const fmt=(n,d=2)=>isFinite(n)?Number(n).toFixed(d):"0";
const j=(o)=>JSON.stringify(o,null,2);
function safeJSON(s){try{return JSON.parse(s)}catch{return null}}
function hashStr(s){let h=2166136261>>>0;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return ("00000000"+(h>>>0).toString(16)).slice(-8)}
function Logs(){
  const [src,setSrc]=useState("/bundler/data/api.ndjson");
  const [auto,setAuto]=useState(false);
  const [ms,setMs]=useState(5000);
  const [win,setWin]=useState(300);
  const [type,setType]=useState("");
  const [status,setStatus]=useState("idle");
  const [meta,setMeta]=useState("");
  const [h,setH]=useState("");
  const [data,setData]=useState({tpm:0,epm:0,codes:[],last:[],avg:0,max:0,fs:"0/0",lines:0,rot:"—",rotto:""});
  async function loadOnce(){
    setStatus("loading");
    const r=await fetch(src+(src.includes("?")?"&":"?")+"t="+Date.now(),{cache:"no-store"});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const text=await r.text();
    const hh=hashStr(text);
    if(hh===h){ setStatus("nochange"); return; }
    setH(hh);
    const lines=text.split("\n").filter(Boolean);
    const wMs=Math.max(10,parseInt(win,10)||300)*1000;
    const t0=now()-wMs;
    let tokens=0,errs=0; const codes=new Map();
    let flushes=0,fsyncs=0,avg=0,max=0,cavg=0;
    let lastTs=0; let lastRot=null;
    const ev=[];
    for(const s of lines){
      const o=safeJSON(s); if(!o||!o.type) continue;
      const ts=Date.parse(o.ts||"")||0; if(ts>lastTs) lastTs=ts;
      if(o.type==="rotated") lastRot=o;
      const inWin=ts>=t0;
      if(inWin){
        if(o.type==="new_token") tokens++;
        if(o.type==="error"){ errs++; const c=String(o.code||"UNKNOWN"); const cur=codes.get(c)||{count:0,last:0}; cur.count++; cur.last=Math.max(cur.last,ts||0); codes.set(c,cur); }
        if(o.type==="metrics"&&o.ndjson){
          const nd=o.ndjson;
          if(typeof nd.flushes==="number") flushes+=nd.flushes;
          if(typeof nd.fsyncs==="number") fsyncs+=nd.fsyncs;
          if(typeof nd.avgFlushMs==="number"){ avg+=nd.avgFlushMs; cavg++; }
          if(typeof nd.maxFlushMs==="number") max=Math.max(max,nd.maxFlushMs);
        }
      }
      if(!type || o.type===type) ev.push(o);
    }
    const wSec=Math.max(10,parseInt(win,10)||300);
    const tpm=tokens/(wSec/60), epm=errs/(wSec/60);
    const codeArr=[...codes.entries()].map(([k,v])=>({code:k,count:v.count,last:v.last})).sort((a,b)=>b.count-a.count).slice(0,20);
    const last=ev.slice(-80).reverse();
    setData({tpm,epm,codes:codeArr,last,avg:cavg?avg/cavg:0,max,fs:`${fsyncs}/${flushes}`,lines:lines.length,rot:lastRot?(String(lastRot.rotatedAt||lastRot.ts||"").slice(11,19)||"rotated"):"—",rotto:lastRot?String(lastRot.to||""):""});
    setMeta(`last:${lastTs?new Date(lastTs).toISOString():""}`);
    setStatus("ok");
  }
  useEffect(()=>{
    if(!auto) return;
    let t=setInterval(()=>loadOnce().catch(e=>{setStatus("error");setMeta(String(e?.message||e))}), Math.max(500,parseInt(ms,10)||5000));
    loadOnce().catch(()=>{});
    return ()=>clearInterval(t);
  },[auto,ms,src,win,type]);
  return (
    <div className="grid">
      <div className="card">
        <div className="row">
          <div className="grow">
            <div className="muted">Source NDJSON</div>
            <div className="row">
              <input className="grow" value={src} onChange={e=>setSrc(e.target.value)} />
              <button onClick={()=>loadOnce().catch(e=>{setStatus("error");setMeta(String(e?.message||e))})}>Charger</button>
              <button onClick={()=>setAuto(v=>!v)}>{auto?"Auto: ON":"Auto: OFF"}</button>
              <input style={{width:120}} value={ms} onChange={e=>setMs(e.target.value)} title="interval ms"/>
            </div>
            <div className="muted">/bundler/data/api.ndjson (API)</div>
          </div>
          <div>
            <div className="muted">Filtre</div>
            <div className="row">
              <input style={{width:120}} value={win} onChange={e=>setWin(e.target.value)} title="window seconds"/>
              <select value={type} onChange={e=>setType(e.target.value)}>
                <option value="">Tous</option>
                <option value="create_token">create_token</option>
                <option value="api_start">api_start</option>
                <option value="error">error</option>
              </select>
            </div>
          </div>
        </div>
        <div className="kpi" style={{marginTop:10}}>
          <div className="card k"><div className="muted">Tokens/min</div><b>{fmt(data.tpm,2)}</b><div className="muted">fenêtre {win}s</div></div>
          <div className="card k"><div className="muted">Erreurs/min</div><b>{fmt(data.epm,2)}</b><div className="muted">codes {data.codes.length}</div></div>
          <div className="card k"><div className="muted">Flush avg (ms)</div><b>{fmt(data.avg,3)}</b><div className="muted">max {fmt(data.max,3)}</div></div>
          <div className="card k"><div className="muted">fsync/flush</div><b>{data.fs}</b><div className="muted">lignes {data.lines}</div></div>
        </div>
        <div className="row" style={{marginTop:10}}>
          <span className="pill ok">{status}</span>
          <span className="muted">{meta}</span>
        </div>
        <div style={{marginTop:10}}>
          <b>Codes erreurs (top)</b>
          <table className="tbl"><thead><tr><th>Code</th><th>Count</th><th>Last</th></tr></thead><tbody>

set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"

VHOST="/etc/nginx/sites-enabled/fireinners.online-ssl"
cp -a "$VHOST" "$VHOST.bak.rm_tests_2_$TS"

# Enlève فقط la 2e ligne: location ^~ /tests/
perl -pi -e 's/^\s*location\s+\^~\s+\/tests\/\s+\{\s*return\s+301\s+\/test\/;\s*\}\s*$//g' "$VHOST"

# Clean lignes vides multiples (optionnel)
perl -0777 -i -pe 's/\n{3,}/\n\n/g' "$VHOST"

nginx -t
systemctl reload nginx

echo "✅ OK: 2e /tests supprimé (backup: $VHOST.bak.rm_tests_2_$TS)"
#!/usr/bin/env bash
set -euo pipefail
umask 022

say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v curl  >/dev/null 2>&1 || die "curl missing"
command -v python3 >/dev/null 2>&1 || die "python3 missing"
command -v systemctl >/dev/null 2>&1 || die "systemctl missing"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AIAQUILA_BK_$TS"
mkdir -p "$BK"

DOMAIN="fireinners.online"
SLUG="/iaaquila"
WWW="/var/www/iaaquila"
VENDOR="$WWW/vendor"
NGX_INC_DIR="/etc/nginx/includes"
NGX_INC="$NGX_INC_DIR/iaaquila_routes.inc"

# PIN versions (no @latest)
WEB3_VER="1.95.4"
PROCESS_VER="0.11.10"
BUFFER_VER="6.0.3"

# Best-effort unfreeze targets
unfreeze(){ chattr -i "$1" 2>/dev/null || true; }
freeze(){ chattr +i "$1" 2>/dev/null || true; }

backup_path(){
  local p="$1"
  [ -e "$p" ] || return 0
  mkdir -p "$BK/$(dirname "$p")"
  cp -a "$p" "$BK/$p.bak" 2>/dev/null || true
}

detect_vhost(){
  local cand=""
  if [ -f /etc/nginx/conf.d/000-fireinners.online-ssl.conf ]; then
    cand="/etc/nginx/conf.d/000-fireinners.online-ssl.conf"
  elif [ -f /etc/nginx/sites-available/fireinners.online-ssl ]; then
    cand="/etc/nginx/sites-available/fireinners.online-ssl"
  else
    cand="$(nginx -T 2>/dev/null | awk '"'"'/# configuration file/ {f=$4} /server_name/ && /fireinners\.online/ {print f; exit}'"'"' || true)"
  fi
  echo "$cand"
}

write_nginx_include(){
  say "1) write nginx include $NGX_INC"
  mkdir -p "$NGX_INC_DIR"
  backup_path "$NGX_INC"
  unfreeze "$NGX_INC"
  cat >"$NGX_INC" <<EOF
# iaaquila routes (static)
location = ${SLUG} { return 301 ${SLUG}/; }
location ^~ ${SLUG}/ {
  root /var/www;
  try_files \$uri \$uri/ ${SLUG}/index.html;
  add_header Cache-Control "no-store" always;
}
EOF
  chmod 0644 "$NGX_INC" || true
}

inject_include_into_vhost(){
  local VH="$1"
  [ -n "$VH" ] || { say "WARN: no vhost detected, skip inject"; return 0; }
  [ -f "$VH" ] || { say "WARN: vhost not a file ($VH), skip inject"; return 0; }

  say "2) inject include into vhost: $VH"
  backup_path "$VH"
  unfreeze "$VH"

  python3 - "$VH" "$DOMAIN" "$NGX_INC" <<'"'"'PY'"'"'
import re,sys
p,dom,inc=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(p,"r",encoding="utf-8",errors="ignore").read()
if inc in s:
  sys.exit(0)

def patch(block):
  if inc in block: return block, False
  if not re.search(r"\blisten\b[^;]*\b443\b", block): return block, False
  if not re.search(r"\bserver_name\b[^;]*\b"+re.escape(dom)+r"\b", block): return block, False
  lines=block.splitlines()
  ins=None
  for i,l in enumerate(lines):
    if re.search(r"\bserver_name\b", l):
      ins=i+1; break
  if ins is None: ins=1
  lines.insert(ins, "    include %s;"%inc)
  return "\n".join(lines), True

out=[]; changed=False; pos=0
for m in re.finditer(r"server\s*\{", s):
  start=m.start(); out.append(s[pos:start])
  i=start; depth=0
  while i < len(s):
    c=s[i]
    if c=="{": depth+=1
    elif c=="}":
      depth-=1
      if depth==0:
        end=i+1
        b=s[start:end]
        nb,ch=patch(b)
        out.append(nb)
        changed=changed or ch
        pos=end
        break
    i+=1
new="".join(out)+s[pos:]
if changed:
  open(p,"w",encoding="utf-8").write(new)
PY
}


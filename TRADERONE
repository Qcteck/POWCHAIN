#!/usr/bin/env bash
set -euo pipefail

ROOT="/opt/fireinners/frontend-react/app/dist"
IDX="$ROOT/index.html"
TDIR="$ROOT/traderone"
TIDX="$TDIR/index.html"

ts(){ date +"%Y%m%d-%H%M%S"; }
sha(){ sha256sum "$1" 2>/dev/null | awk '{print $1}'; }

immut_off(){
  local f="$1"
  command -v lsattr >/dev/null || return 0
  command -v chattr >/dev/null || return 0
  if lsattr "$f" 2>/dev/null | grep -q '\-i-\|\-i '; then
    chattr -i "$f" 2>/dev/null || true
    echo "chattr -i $f"
  fi
}
immut_on(){
  local f="$1"
  command -v chattr >/dev/null || return 0
  chattr +i "$f" 2>/dev/null || true
  echo "chattr +i $f"
}

backup_if_exists(){
  local f="$1"
  if test -f "$f"; then
    local b="${f}.bak.$(ts)"
    cp -a "$f" "$b"
    echo "backup: $b"
  fi
}

write_file(){
  local dest="$1"; local tmp="$2"
  mkdir -p "$(dirname "$dest")"
  backup_if_exists "$dest"
  immut_off "$dest" || true
  cp -a "$tmp" "$dest"
  chmod 644 "$dest" || true
  echo "wrote: $dest (sha=$(sha "$dest" || echo n/a))"
}

test -d "$ROOT" || { echo "ERR: $ROOT introuvable"; exit 1; }
mkdir -p "$TDIR"

echo "== FIREINNERS MEGA BATCH =="
echo "ROOT=$ROOT"
echo "IDX=$IDX"
echo "TIDX=$TIDX"
echo

TMP1="$(mktemp)"; TMP2="$(mktemp)"
trap 'rm -f "$TMP1" "$TMP2"' EXIT


cat >/tmp/WOLVERINE_NGX_PATCH.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "=== WOLVERINE NGINX PATCH ==="
date;hostname;whoami;pwd

ASK="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASK" ]; then
  # shellcheck disable=SC1090
  source "$ASK"
else
  askorupdate_file(){ local p="$1";mkdir -p "$(dirname "$p")";cp -a "$p" "$p.bak.$(date +%s)" 2>/dev/null||true;cat >"$p"; }
fi

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGX="/etc/nginx/nginx.conf"

echo "--- unlock nginx files (temp) ---"
command -v chattr >/dev/null && { chattr -i "$NGX" "$VHOST" 2>/dev/null||true; }

echo "--- show current wolverine/api lines ---"
grep -n "wolverine/api" "$VHOST" || true

echo "--- rewrite vhost to ensure location inside matching server blocks ---"
python3 - <<'PY'
import re,sys,os
p="/etc/nginx/sites-available/fireinners.online-ssl"
txt=open(p,"r",encoding="utf-8",errors="ignore").read()

loc = """  location /wolverine/api/ {
    proxy_pass http://127.0.0.1:3050/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
"""

def patch_server_blocks(s):
    out=[]
    i=0
    while True:
        m=re.search(r'(^\s*server\s*\{)',s[i:],re.M)
        if not m:
            out.append(s[i:]); break
        start=i+m.start()
        out.append(s[i:start])
        j=start+m.end()-m.start()
        depth=0
        k=start
        # find matching closing brace for this server block
        for idx,ch in enumerate(s[start:]):
            if ch=='{': depth+=1
            elif ch=='}':
                depth-=1
                if depth==0:
                    end=start+idx+1
                    block=s[start:end]
                    # only patch blocks that mention fireinners.online somewhere (server_name or cert paths etc.)
                    if "fireinners.online" in block and "location /wolverine/api/" not in block:
                        block=re.sub(r'\n(\s*}\s*)$','\n'+loc+r'\n\1',block,flags=re.S)
                    out.append(block)
                    i=end
                    break
        else:
            out.append(s[start:]); break
    return "".join(out)

new=patch_server_blocks(txt)

if new==txt:
    # nothing changed; still ensure location exists at least once
    if "location /wolverine/api/" not in new:
        sys.stderr.write("ERROR: no matching server{} block found to patch (contains fireinners.online). Aborting.\n")
        sys.exit(2)

open("/tmp/_vhost_patched","w",encoding="utf-8").write(new)
PY

askorupdate_file "$VHOST" </tmp/_vhost_patched
rm -f /tmp/_vhost_patched

echo "--- nginx test + reload ---"
nginx -t
systemctl reload nginx

echo "--- re-lock nginx files ---"
command -v chattr >/dev/null && { chattr +i "$NGX" "$VHOST" 2>/dev/null||true; }

echo "--- verify vhost contains location ---"
grep -n "location /wolverine/api/" "$VHOST" || true

echo "--- tests (HTTP + HTTPS) ---"
echo -n "local: "; curl -sS -m 3 http://127.0.0.1:3050/ping || true; echo
echo -n "http localhost hostheader: "; curl -sS -m 5 -H "Host: fireinners.online" http://127.0.0.1/wolverine/api/ping || true; echo
echo -n "https domain: "; curl -k -sS -m 8 https://fireinners.online/wolverine/api/ping || true; echo
echo "=== DONE ==="
SH
bash /tmp/WOLVERINE_NGX_PATCH.sh
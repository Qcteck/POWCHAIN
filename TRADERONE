#!/usr/bin/env bash
set -euo pipefail
umask 022

DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
AQUILA_INC="$INC_DIR/aquilatrader_static.inc"
WWW="/var/www/aquilatrader"
INDEX="$WWW/index.html"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_AQUILATRADER_${TS}"

say(){ printf "[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERROR: $*"; exit 1; }

say "== AQUILATRADER FIX (force route) =="
say "Goal: https://${DOMAIN}/aquilatrader/ -> ${INDEX}"
say "Backup: ${BK}"
mkdir -p "$BK"

command -v nginx >/dev/null 2>&1 || die "nginx not found"
[ -f "$VHOST" ] || die "missing vhost: $VHOST"

# unlock immutable if present
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$VHOST" 2>/dev/null || true
chattr -i "$INC_DIR" 2>/dev/null || true
[ -f "$AQUILA_INC" ] && chattr -i "$AQUILA_INC" 2>/dev/null || true

# backups
cp -a /etc/nginx/nginx.conf "$BK/nginx.conf.bak" 2>/dev/null || true
cp -a "$VHOST" "$BK/$(basename "$VHOST").bak" 2>/dev/null || true
cp -a "$INC_DIR" "$BK/includes.bak" 2>/dev/null || true

say "1) Ensure webroot + index"

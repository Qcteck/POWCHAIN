cat >/root/MEGA_WOLVERINE_FIX_404_UNFREEZE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/WOLVERINE_FIX404_${TS}"
mkdir -p "$BK"

WEBROOT="/var/www/wolverine"
INDEX="$WEBROOT/index.html"

NGX_CONF="/etc/nginx/nginx.conf"
NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
NGX_EN="/etc/nginx/sites-enabled/fireinners.online-ssl"

INC_STATIC="/etc/nginx/includes/wolverine_static.inc"
INC_ROUTES="/etc/nginx/includes/wolverine_routes.inc"

ORIGIN="https://fireinners.online"

say(){ printf "\n[%s] %s\n" "$(date +%H:%M:%S)" "$*"; }
die(){ echo "FATAL: $*" >&2; exit 1; }

has(){ command -v "$1" >/dev/null 2>&1; }

immut_flag(){
  # retourne 0 si immutable (+i), 1 sinon
  local f="$1"
  [ -e "$f" ] || return 1
  lsattr -d "$f" 2>/dev/null | awk '{print $1}' | grep -q 'i'
}

unfreeze(){
  local f="$1"
  [ -e "$f" ] || return 0
  if immut_flag "$f"; then
    echo "IMMUT=1 $f" >>"$BK/immut.list"
    chattr -i "$f" 2>/dev/null || true
  else
    echo "IMMUT=0 $f" >>"$BK/immut.list"
  fi
}

refreeze_all(){
  [ -f "$BK/immut.list" ] || return 0
  awk '$1=="IMMUT=1"{print $2}' "$BK/immut.list" | while read -r f; do
    [ -e "$f" ] && chattr +i "$f" 2>/dev/null || true
  done
}

restore_latest_savepoint_webroot(){
  local latest=""
  latest="$(ls -1dt /root/WOLVERINE_SAVEPOINT_* 2>/dev/null | head -n1 || true)"
  [ -n "$latest" ] || return 0

  if [ -d "$latest/var/www/wolverine" ]; then
    say "Restore webroot depuis $latest/var/www/wolverine"
    rm -rf "$WEBROOT" || true
    mkdir -p "$(dirname "$WEBROOT")"
    cp -a "$latest/var/www/wolverine" "$WEBROOT"
    return 0
  fi
  if [ -d "$latest/wolverine" ]; then
    say "Restore webroot depuis $latest/wolverine"
    rm -rf "$WEBROOT" || true
    mkdir -p "$(dirname "$WEBROOT")"
    cp -a "$latest/wolverine" "$WEBROOT"
    return 0
  fi
  return 0
}

say "0) Savepoint + backup"
if [ -x /root/WOLVERINE_SAVEPOINT.sh ]; then /root/WOLVERINE_SAVEPOINT.sh || true; fi
cp -a "$NGX_VHOST" "$BK/fireinners.online-ssl.bak" 2>/dev/null || true
cp -a "$NGX_CONF"  "$BK/nginx.conf.bak" 2>/dev/null || true
[ -f "$INC_STATIC" ] && cp -a "$INC_STATIC" "$BK/wolverine_static.inc.bak" || true
[ -f "$INC_ROUTES" ] && cp -a "$INC_ROUTES" "$BK/wolverine_routes.inc.bak" || true
[ -f "$INDEX" ] && cp -a "$INDEX" "$BK/index.html.bak" || true

say "1) Unfreeze nginx/vhost/includes (si chattr +i)"
has lsattr || apt-get update -y && apt-get install -y e2fsprogs >/dev/null 2>&1 || true

unfreeze "$NGX_CONF"
unfreeze "$NGX_VHOST"
unfreeze "$NGX_EN"
unfreeze "/etc/nginx/sites-enabled"
unfreeze "/etc/nginx/sites-available"
unfreeze "/etc/nginx/includes"
for f in /etc/nginx/includes/wolverine*.inc; do [ -e "$f" ] && unfreeze "$f"; done

say "2) Assure webroot + index"
mkdir -p "$WEBROOT"
if [ ! -f "$INDEX" ]; then
  say "index.html manquant -> restore dernier savepoint"
  restore_latest_savepoint_webroot || true
fi
[ -f "$INDEX" ] || die "index.html introuvable: $INDEX"

say "3) Assure vhost activé (sites-enabled)"
[ -f "$NGX_VHOST" ] || die "Vhost manquant: $NGX_VHOST"
ln -sf "$NGX_VHOST" "$NGX_EN" || true

say "4) Force include statique /wolverine/ (évite 404)"
cat >"$INC_STATIC" <<'INC'
# AUTO-GEN: Wolverine static routes
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
  add_header Cache-Control "no-store";
}
INC

say "5) Assure que le vhost inclut wolverine_static.inc + wolverine_routes.inc"
python3 - <<PY
import re
p="$NGX_VHOST"
s=open(p,'r',encoding='utf-8',errors='ignore').read()
need1="include /etc/nginx/includes/wolverine_static.inc;"
need2="include /etc/nginx/includes/wolverine_routes.inc;"
if need1 in s and need2 in s:
  print("OK includes déjà présents")
  raise SystemExit(0)

m=re.search(r"server\s*{", s)
if not m:
  raise SystemExit("No server block found in vhost")
i=m.end()
ins=""
if need1 not in s: ins += "\n    "+need1+"\n"
if need2 not in s: ins += "    "+need2+"\n"
s = s[:i] + ins + s[i:]
open(p,'w',encoding='utf-8').write(s)
print("Injected missing includes into first server{}")
PY

say "6) nginx -t + reload"
nginx -t
systemctl reload nginx

say "7) Refreeze (remet chattr +i si c'était immuté)"
refreeze_all || true

say "8) Tests HTTP"
set +e
echo "== /wolverine/ =="
curl -sS -o /dev/null -w "HTTP %{http_code}\n" "$ORIGIN/wolverine/" || true
echo "== /wolverine/index.html =="
curl -sS -o /dev/null -w "HTTP %{http_code}\n" "$ORIGIN/wolverine/index.html" || true
echo "== /wolverine/traderone/vault/health =="
curl -sS -o /dev/null -w "HTTP %{http_code}\n" "$ORIGIN/wolverine/traderone/vault/health" || true
set -e

say "DONE"
echo "Backup: $BK"
echo "Ouvre: $ORIGIN/wolverine/ puis Ctrl+F5"
BASH

chmod +x /root/MEGA_WOLVERINE_FIX_404_UNFREEZE.sh
bash /root/MEGA_WOLVERINE_FIX_404_UNFREEZE.sh
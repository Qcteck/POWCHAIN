NGINX_INC="/etc/nginx/includes/wolverine_routes.inc"

SOLRPC_DIR="/opt/fireinners/solrpc-proxy-wolverine"
SOLRPC_JS="$SOLRPC_DIR/server.js"
SOLRPC_SERVICE="/etc/systemd/system/wolverine-solrpc-proxy.service"

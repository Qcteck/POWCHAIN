set -euo pipefail
ROOT=/opt/fireinners/frontend-react/app/dist
TS="$(date +%Y%m%d-%H%M%S)"

echo "== UNLOCK (if immutable) =="
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i /etc/nginx/sites-available/fireinners.online-ssl 2>/dev/null || true
chattr -i /etc/nginx/sites-enabled/fireinners.online-ssl 2>/dev/null || true

echo "== ENSURE /stats/index.json exists in dist =="
mkdir -p "$ROOT/stats"
cat >"$ROOT/stats/index.json"<<JSON
{"ok":true,"service":"wolfchain-ui","ts":"$(date -u +%FT%TZ)"}
JSON
chmod 755 "$ROOT" "$ROOT/stats" 2>/dev/null || true
chmod 644 "$ROOT/stats/index.json" 2>/dev/null || true

echo "== FIND nginx files that contain server_name fireinners.online =="
mapfile -t FILES < <(nginx -T 2>/dev/null | awk '
/^# configuration file /{f=$4}
/server_name/ && $0 ~ /fireinners\.online/ {print f}
' | sort -u)

if [ "${#FILES[@]}" -eq 0 ]; then
  echo "ERR: no nginx file found containing server_name fireinners.online"
  exit 1
fi

printf "FILES:\n"; printf " - %s\n" "${FILES[@]}"

PATCH_BLOCK=$(cat <<'NGX'
# forced static /stats (UI healthcheck)
location = /stats { return 301 /stats/index.json; }
location = /stats/index.json {
  default_type application/json;
  add_header Cache-Control "no-store" always;
  alias /opt/fireinners/frontend-react/app/dist/stats/index.json;
}
NGX
)

echo "== PATCH each matching file (inside the correct server block) =="
for F in "${FILES[@]}"; do
  [ -f "$F" ] || continue
  echo "-- patch: $F"
  chattr -i "$F" 2>/dev/null || true
  cp -a "$F" "${F}.bak.${TS}"

  awk -v INS="$PATCH_BLOCK" '
  function cchr(s,ch,  n,i){n=0; for(i=1;i<=length(s);i++) if(substr(s,i,1)==ch) n++; return n}
  BEGIN{inS=0;br=0;tgt=0;done=0}
  {
    line=$0
    if(!inS && line ~ /^[[:space:]]*server[[:space:]]*\{/){inS=1;br=1;tgt=0;done=0; print line; next}
    if(inS){
      if(line ~ /server_name/ && line ~ /fireinners\.online/){tgt=1}
      # if this is closing brace of this server block, inject before it
      ob=cchr(line,"{"); cb=cchr(line,"}")
      if(tgt && !done && cb>0 && br==1){
        print INS
        done=1
      }
      br += ob - cb
      if(br<=0){inS=0;br=0;tgt=0;done=0}
      print line
      next
    }
    print line
  }' "$F" >"/tmp/ngx_${TS}.tmp"
  mv "/tmp/ngx_${TS}.tmp" "$F"
done

echo "== NGINX TEST + RELOAD =="
nginx -t
systemctl reload nginx

echo "== TEST (must be 200 + JSON) =="
curl -k -sS -i https://127.0.0.1/stats/index.json -H 'Host: fireinners.online' | sed -n '1,25p'

echo "== RE-LOCK =="
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
for F in "${FILES[@]}"; do chattr +i "$F" 2>/dev/null || true; done

echo "DONE"
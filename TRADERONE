cat >/root/TRADERONE_FIX_FINAL.sh <<'BASH'
#!/usr/bin/env bash
set -e

echo "===== TRADERONE FIX FINAL ====="

API="/opt/traderone-vault/server.js"
HTML="/var/www/wolverine/index.html"
NGINX="/etc/nginx/sites-available/fireinners.online-ssl"
TS=$(date +%Y%m%d_%H%M%S)

echo "[1] Backup"
cp -a "$API" "$API.bak_$TS"
cp -a "$HTML" "$HTML.bak_$TS"

echo "[2] Patch API budget"
grep -q "TRADERONE_BUDGET_API" "$API" || cat >>"$API" <<'JS'

/* ===== TRADERONE_BUDGET_API ===== */
app.options("/wolverine/traderone/api/budget",(req,res)=>{
 res.setHeader("Access-Control-Allow-Origin","*");
 res.setHeader("Access-Control-Allow-Headers","Content-Type");
 res.setHeader("Access-Control-Allow-Methods","POST,OPTIONS");
 return res.sendStatus(200);
});

app.post("/wolverine/traderone/api/budget",async(req,res)=>{
 try{
  const {from,amount}=req.body||{};
  if(!from||!amount){
   return res.status(400).json({ok:false,error:"missing from/amount"});
  }
  return res.json({ok:true,from,amount});
 }catch(e){
  return res.status(500).json({ok:false,error:String(e)});
 }
});
/* ===== END TRADERONE_BUDGET_API ===== */

JS

echo "[3] NGINX proxy"
grep -q "traderone/api" "$NGINX" || sed -i '/location \/wolverine\/ {/a\
    location /wolverine/traderone/api/ {\
        proxy_pass http://127.0.0.1:3000;\
        proxy_http_version 1.1;\
        proxy_set_header Host $host;\
        proxy_set_header X-Real-IP $remote_addr;\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\
        proxy_set_header X-Forwarded-Proto $scheme;\
    }\
' "$NGINX"

echo "[4] Frontend JSON safe + colors"
grep -q "safePost" "$HTML" || sed -i '/<\/body>/i\
<script>\
async function safePost(url,payload){\
 const r=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});\
 const t=await r.text();\
 try{return JSON.parse(t);}catch(e){return {ok:false,error:t};}\
}\
</script>' "$HTML"

sed -i '/<\/head>/i\
<style>\
body{background:#040b12;color:#e6f1ff}\
button{background:#00ff88;color:#001;border:2px solid #00ffaa}\
input{background:#000;color:#00ffaa;border:1px solid #00ffaa}\
</style>' "$HTML"

echo "[5] Reload services"
nginx -t
systemctl reload nginx
pm2 restart traderone-vault

echo "[6] Test API"
sleep 2
curl -s http://127.0.0.1:3000/wolverine/traderone/api/budget \
 -H "Content-Type: application/json" \
 -d '{"from":"TEST","amount":0.01}'

echo "===== FIX TERMINÉ ====="
BASH

chmod +x /root/TRADERONE_FIX_FINAL.sh
/root/TRADERONE_FIX_FINAL.sh
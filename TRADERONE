cat >/root/fix_ssl_cert_paths.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
CERT_DIR="/etc/ssl/fireinners"
CERT="$CERT_DIR/fullchain.pem"
KEY="$CERT_DIR/privkey.pem"

SSL_AVAIL="/etc/nginx/sites-available/fireinners.online-ssl"
SSL_ENABLED="/etc/nginx/sites-enabled/fireinners.online-ssl"

mkdir -p "$CERT_DIR"

echo "=== 1) Ensure self-signed exists ==="
if [[ ! -f "$CERT" || ! -f "$KEY" ]]; then
  openssl req -x509 -nodes -newkey rsa:2048 -days 365 \
    -keyout "$KEY" -out "$CERT" \
    -subj "/CN=$DOMAIN"
  echo "[OK] self-signed created: $CERT_DIR"
else
  echo "[OK] cert already exists: $CERT / $KEY"
fi

echo "=== 2) Write a CLEAN SSL vhost with REAL paths (no $VARS) ==="
cat >"$SSL_AVAIL" <<NGINX
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;

  server_name ${DOMAIN} www.${DOMAIN};

  ssl_certificate     ${CERT};
  ssl_certificate_key ${KEY};

  # simple entrypoint
  location / {
    return 301 https://${DOMAIN}/wolverine/;
  }
}
NGINX

ln -sf "$SSL_AVAIL" "$SSL_ENABLED"

echo "=== 3) Find any other broken 443 ssl servers (no ssl_certificate) ==="
# List files that contain listen 443 ssl
FILES="$(nginx -T 2>/dev/null | awk '
  /^# configuration file /{f=$4; sub(/:$/,"",f)}
  /listen\s+\[::\]:443|listen\s+443/ && /ssl/ {print f}
' | sort -u)"

for f in $FILES; do
  [[ -f "$f" ]] || continue
  # if file has listen 443 ssl but no ssl_certificate directive anywhere, disable it
  if grep -qE 'listen\s+(\[::\]:)?443.*ssl' "$f" && ! grep -qE '^\s*ssl_certificate\s+' "$f"; then
    echo "[DISABLE] $f (has listen 443 ssl but no ssl_certificate)"
    mv -f "$f" "/etc/nginx/disabled-sites/$(basename "$f").disabled_$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
  fi
done

echo "=== 4) Test + restart ==="
nginx -t
systemctl restart nginx

echo
echo "=== 5) Ports + local https ==="
ss -lntp | grep -E ':(80|443)\b' || true
curl -kI --max-time 5 https://127.0.0.1/ | head -n 12 || true
BASH

chmod +x /root/fix_ssl_cert_paths.sh
/root/fix_ssl_cert_paths.sh
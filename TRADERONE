set -e
cd /opt/traderone-opt

echo "=== 1) Ports ==="
ss -ltnp | egrep ':3000|:3002|:8585' || true
echo

echo "=== 2) PM2 status ==="
pm2 ls
echo

echo "=== 3) Derniers logs (erreur exacte) ==="
pm2 logs traderone --lines 120 --nostream | tail -n 120 || true
echo

echo "=== 4) Test syntax node (si possible) ==="
node --check server.js || true
echo

echo "=== 5) Si 3000 n’écoute pas -> rollback dernier backup + restart ==="
if ! ss -ltnp | grep -q ':3000'; then
  echo "KO: 3000 not listening -> ROLLBACK"
  LAST_BAK=$(ls -1t server.js.bak.* 2>/dev/null | head -n1 || true)
  echo "LAST_BAK=$LAST_BAK"
  if [ -z "$LAST_BAK" ]; then
    echo "Aucun backup server.js.bak.* trouvé"; exit 1
  fi
  cp -a server.js "server.js.bad.$(date +%s)" || true
  cp -a "$LAST_BAK" server.js
  pm2 restart traderone --update-env
  sleep 1
fi
echo

echo "=== 6) Re-check + health ==="
ss -ltnp | egrep ':3000|:3002|:8585' || true
echo
curl -sS -i http://127.0.0.1:3000/health | head -n 20 || true
echo "=== DONE ==="
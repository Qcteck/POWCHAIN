cat >/root/AIAQUILA_NCLUDE_FIX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
TS="$(date +%Y%m%d_%H%M%S)"

echo "=== AIAQUILA NCLUDE FIX ==="

### 1) Backup
echo "[1/6] Backup vhost"
cp -a "$VHOST" "$VHOST.backup.$TS"

### 2) Remove immutable flag
echo "[2/6] Remove immutable flag"
chattr -i "$VHOST"

### 3) Fix typo nclude -> include
echo "[3/6] Fix directive typo"
sed -i 's/^[[:space:]]*nclude[[:space:]]\+/    include /' "$VHOST"

### 4) Restore immutable flag
echo "[4/6] Restore immutable flag"
chattr +i "$VHOST"

### 5) nginx test
echo "[5/6] nginx test"
nginx -t

### 6) reload nginx
echo "[6/6] reload nginx"
systemctl reload nginx

echo "DONE"
echo "Health : https://fireinners.online/aiaquila/health"
echo "RSS    : https://fireinners.online/aiaquila/api/rss"
BASH

chmod +x /root/AIAQUILA_NCLUDE_FIX.sh
/root/AIAQUILA_NCLUDE_FIX.sh
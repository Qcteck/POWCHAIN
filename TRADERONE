cat >/root/MEGA_AQUILATRADER_ROUTE.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
umask 022
TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BK_AQUILATRADER_ROUTE_$TS"
mkdir -p "$BK"
say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

NGX_VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
INC_DIR="/etc/nginx/includes"
INC="$INC_DIR/aquilatrader.inc"

SRC_WOLV="/var/www/wolverine/index.html"
WWW="/var/www/aquilatrader"
IDX="$WWW/index.html"

say "Backup..."
cp -a "$NGX_VHOST" "$BK/" 2>/dev/null || true
cp -a "$INC_DIR" "$BK/includes" 2>/dev/null || true
cp -a "$WWW" "$BK/www_aquilatrader" 2>/dev/null || true

say "Unfreeze nginx files (best effort)..."
chattr -i /etc/nginx/nginx.conf 2>/dev/null || true
chattr -i "$NGX_VHOST" 2>/dev/null || true
chattr -i "$INC_DIR"/*.inc 2>/dev/null || true

say "Prepare /var/www/aquilatrader..."
mkdir -p "$WWW"
if [ -f "$SRC_WOLV" ]; then
  cp -a "$SRC_WOLV" "$IDX"
else
  cat >"$IDX" <<'HTML'
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AquilaTrader</title><style>html,body{margin:0;height:100%;background:#070a10;color:#d7e3ff;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial}*{box-sizing:border-box}.wrap{min-height:100%;display:flex;flex-direction:column}.top{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:14px 14px;border-bottom:1px solid rgba(255,255,255,.08)}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.btn{border:1px solid rgba(160,190,255,.25);background:rgba(20,30,60,.35);color:#e9f0ff;padding:10px 12px;border-radius:10px;cursor:pointer}.pill{padding:8px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);font-size:12px}.grid{display:grid;grid-template-columns:1fr;gap:12px;padding:14px;max-width:980px;width:100%;margin:0 auto}.card{border:1px solid rgba(255,255,255,.10);background:rgba(10,14,24,.55);border-radius:14px;padding:14px}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}.ok{color:#65ffbf}.bad{color:#ff6b6b}</style></head><body><div class="wrap"><div class="top"><div><b>AquilaTrader</b><div style="opacity:.7;font-size:12px">Route /aquilatrader/ (statique)</div></div><div class="row"><span id="net" class="pill">réseau: —</span><span id="addr" class="pill mono">wallet: —</span><button id="bConn" class="btn">Connect Wallet</button><button id="bDisc" class="btn" disabled>Disconnect</button></div></div><div class="grid"><div class="card"><b>Endpoints</b><div class="mono" style="opacity:.8;margin-top:8px">API: /wolverine/traderone/api/health<br>VAULT: /wolverine/traderone/vault/health</div><div style="margin-top:10px" class="row"><button id="bStart" class="btn" disabled>START</button><button id="bStop" class="btn" disabled>STOP</button><button id="bOut" class="btn" disabled>CASH-OUT</button><span class="pill">API: <span id="api" class="mono">—</span></span><span class="pill">VAULT: <span id="vault" class="mono">—</span></span></div></div><div class="card"><b>Logs</b><div id="log" class="mono" style="margin-top:10px;height:220px;overflow:auto;border:1px solid rgba(255,255,255,.10);border-radius:12px;background:#05070c;padding:10px"></div></div></div></div><script>(()=>{"use strict";const $=s=>document.querySelector(s),logEl=$("#log"),netEl=$("#net"),addrEl=$("#addr"),bConn=$("#bConn"),bDisc=$("#bDisc"),bStart=$("#bStart"),bStop=$("#bStop"),bOut=$("#bOut"),apiEl=$("#api"),vaultEl=$("#vault");let provider=null,addr=null,chain="";const ts=()=>new Date().toLocaleTimeString("fr-CA",{hour:"2-digit",minute:"2-digit",second:"2-digit"});const push=(m,cls="")=>{const d=document.createElement("div");d.style.padding="6px 0";d.style.borderBottom="1px solid rgba(255,255,255,.06)";d.className=cls;d.textContent=`[${ts()}] ${m}`;logEl.prepend(d);};const setAddr=a=>{addr=a||null;addrEl.textContent=addr?addr:"wallet: —";addrEl.className="pill mono "+(addr?"ok":"");};const setNet=n=>{netEl.textContent="réseau: "+(n||"—");};const enable=on=>{bDisc.disabled=!on;bStart.disabled=!on;bStop.disabled=!on;bOut.disabled=!on;bConn.disabled=on;};const ping=async()=>{try{const a=await (await fetch("/wolverine/traderone/api/health",{cache:"no-store"})).json().catch(()=>null);apiEl.textContent=a&&a.ok?"OK":"?";apiEl.className="mono "+((a&&a.ok)?"ok":"bad");}catch{apiEl.textContent="ERR";apiEl.className="mono bad";}try{const v=await (await fetch("/wolverine/traderone/vault/health",{cache:"no-store"})).json().catch(()=>null);vaultEl.textContent=v&&v.ok?"OK":"?";vaultEl.className="mono "+((v&&v.ok)?"ok":"bad");}catch{vaultEl.textContent="ERR";vaultEl.className="mono bad";}};const connect=async()=>{try{if(window.solana&&window.solana.isPhantom){provider=window.solana;const r=await provider.connect({onlyIfTrusted:false});setAddr(r.publicKey?.toString?.()||provider.publicKey?.toString?.()||null);chain="solana/phantom";setNet(chain);enable(true);push("Connected Phantom: "+addr);}else if(window.ethereum){provider=window.ethereum;const acc=await provider.request({method:"eth_requestAccounts"});setAddr((acc&&acc[0])||null);chain="evm/metamask";setNet(chain);enable(true);push("Connected MetaMask: "+addr);}else{push("Aucun wallet détecté (Phantom/MetaMask).","bad");}}catch(e){push("Connect error: "+(e?.message||e),"bad");}};const disconnect=async()=>{try{if(provider&&provider.isPhantom&&provider.disconnect)await provider.disconnect();}catch{}provider=null;chain="";setNet(chain);setAddr(null);enable(false);push("Disconnected");};const post=async(path)=>{push("POST "+path+" ...");try{const r=await fetch(path,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({pub:addr||null})});const t=await r.text();push("HTTP "+r.status+" "+t,(r.ok?"ok":"bad"));}catch(e){push("HTTP ERR "+(e?.message||e),"bad");}};bConn.onclick=connect;bDisc.onclick=disconnect;bStart.onclick=()=>post("/wolverine/traderone/api/start");bStop.onclick=()=>post("/wolverine/traderone/api/stop");bOut.onclick=()=>post("/wolverine/traderone/api/withdraw");setNet("");setAddr(null);enable(false);push("AquilaTrader loaded on /aquilatrader/.");ping();setInterval(ping,5000);})();</script></body></html>
HTML
fi
chmod 0644 "$IDX" || true
chown -R www-data:www-data "$WWW" 2>/dev/null || true

say "Remove any old aquilatrader*.inc (avoid duplicates if wildcard include)..."
rm -f "$INC_DIR"/aquilatrader*.inc
# recreate canonical include after cleanup
cat >"$INC" <<'NGINX'
# AQUILATRADER_CANONICAL_V1
location = /aquilatrader { return 301 /aquilatrader/; }
location ^~ /aquilatrader/ {
    alias /var/www/aquilatrader/;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store" always;
}
NGINX
chmod 0644 "$INC" || true

say "Ensure vhost includes aquilatrader.inc once (safe even if wildcard include is present)..."
grep -q "include /etc/nginx/includes/aquilatrader.inc;" "$NGX_VHOST" 2>/dev/null || \
sed -i '/server\s*{/a\    include /etc/nginx/includes/aquilatrader.inc;' "$NGX_VHOST"

say "Reload nginx..."
nginx -t
systemctl reload nginx

say "Refreeze core files (best effort)..."
chattr +i /etc/nginx/nginx.conf 2>/dev/null || true
chattr +i "$NGX_VHOST" 2>/dev/null || true

say "DONE -> https://fireinners.online/aquilatrader/"
say "Backup: $BK"
BASH

chmod +x /root/MEGA_AQUILATRADER_ROUTE.sh
bash /root/MEGA_AQUILATRADER_ROUTE.sh |& tee /root/MEGA_AQUILATRADER_ROUTE.log
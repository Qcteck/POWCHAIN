#!/usr/bin/env bash
set -euo pipefail

DOMAIN="fireinners.online"
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
CERT="/etc/letsencrypt/live/${DOMAIN}/fullchain.pem"
KEY="/etc/letsencrypt/live/${DOMAIN}/privkey.pem"

echo "=== FIX FIREINNERS SSL (FINAL) ==="

# 1) Vérifier certificats
if [ ! -f "$CERT" ] || [ ! -f "$KEY" ]; then
  echo "❌ Certificat SSL introuvable"
  echo "👉 Lancer: certbot --nginx -d ${DOMAIN} -d www.${DOMAIN}"
  exit 1
fi

echo "✔ Certificat SSL trouvé"

# 2) Backup de sécurité
cp -a "$VHOST" "${VHOST}.bak_$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true

# 3) Réécriture complète du vhost SSL
cat > "$VHOST" <<EOF
server {
    listen 443 ssl http2;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     ${CERT};
    ssl_certificate_key ${KEY};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /opt/fireinners/frontend-react/app/dist;
    index index.html;

    location / {
        try_files \$uri \$uri/ /index.html;
    }

    location /wolverine/ {
        try_files \$uri \$uri/ /wolverine/index.html;
    }

    location /ws {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host \$host;
    }
}
EOF

echo "✔ Vhost SSL réécrit proprement"

# 4) Test & reload
nginx -t
systemctl reload nginx

echo "✅ SSL RÉPARÉ – NGINX OK"
echo "➡️ CTRL + F5 navigateur"
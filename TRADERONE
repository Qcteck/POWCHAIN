bash <<'BASH'
set -euo pipefail
TS="$(date +%Y%m%d_%H%M%S)"
APP="traderone-vault"
FILE="/opt/traderone-vault/server.js"
TREASURY="/opt/traderone-vault/treasury.json"

echo "== CHECK =="
test -f "$FILE" || { echo "ERR: $FILE manquant"; exit 1; }
test -f "$TREASURY" || { echo "ERR: $TREASURY manquant"; exit 1; }

echo "== BACKUP =="
cp -a "$FILE" "${FILE}.bak_${TS}"

echo "== PATCH ROUTE (TRANSFER SOL RÉEL) =="
python3 - <<'PY'
from pathlib import Path
p=Path("/opt/traderone-vault/server.js")
s=p.read_text()

marker="/* === AUTO ROUTES TRADERONE VAULT === */"
if marker in s:
    print("Routes déjà présentes (skip)")
else:
    inject=f"""
{marker}
const fs=require("fs");
const {{Connection,Keypair,PublicKey,SystemProgram,Transaction,sendAndConfirmTransaction}}=require("@solana/web3.js");
const RPC=process.env.SOLANA_RPC||"https://api.mainnet-beta.solana.com";
const connection=new Connection(RPC,"confirmed");
const TREASURY=Keypair.fromSecretKey(Uint8Array.from(JSON.parse(fs.readFileSync("{Path("/opt/traderone-vault/treasury.json")}"))));

app.get("/wolverine/traderone/api/health",(req,res)=>res.json({{ok:true,ts:Date.now()}}));

app.post("/wolverine/traderone/api/budget",async(req,res)=>{{
  try{{
    const {{pubkey,budgetSol}}=req.body||{{}};
    if(!pubkey||!budgetSol) throw "payload invalide";
    const to=new PublicKey(pubkey);
    const lamports=Math.floor(Number(budgetSol)*1e9);
    if(lamports<=0) throw "montant invalide";
    const tx=new Transaction().add(SystemProgram.transfer({{
      fromPubkey:TREASURY.publicKey,
      toPubkey:to,
      lamports
    }}));
    const sig=await sendAndConfirmTransaction(connection,tx,[TREASURY]);
    res.json({{ok:true,signature:sig,lamports}});
  }}catch(e){{
    res.status(400).json({{ok:false,error:String(e)}})
  }}
}});
/* === END AUTO ROUTES === */
"""
    i=s.find("app.listen")
    s=(s[:i]+inject+"\n"+s[i:]) if i!=-1 else (s+"\n"+inject)
    p.write_text(s)
    print("Routes injectées")
PY

echo "== PM2 RESTART =="
pm2 restart "$APP" --update-env

echo "== TEST LOCAL (HEALTH) =="
curl -s http://127.0.0.1:3000/wolverine/traderone/api/health || true

echo "== FIN OK (TRANSFERT SOL RÉEL ACTIF) =="
BASH
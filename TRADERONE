#!/usr/bin/env bash
set -euo pipefail

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/AQUILA_REACT_STACKING_BK_${TS}"
mkdir -p "$BK"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ say "ERR: $*"; exit 1; }

[ "$(id -u)" = "0" ] || die "run as root"
command -v nginx >/dev/null 2>&1 || die "nginx missing"
command -v python3 >/dev/null 2>&1 || die "python3 missing"
command -v curl >/dev/null 2>&1 || die "curl missing"

DOMAIN="fireinners.online"
WEBROOT="/var/www/aquila_stacking"
INC_DIR="/etc/nginx/includes"
INC="$INC_DIR/aquila_stacking_routes.inc"

APP="/opt/aquila_stacking_react"
SRC="$APP/src"
PUB="$APP/public"

ASKLIB="/opt/fireinners/sentinel/lib/askorupdate.sh"
if [ -f "$ASKLIB" ]; then
  # shellcheck disable=SC1090
  . "$ASKLIB" || true
fi

write_file(){
  local path="$1"; shift
  local tmp; tmp="$(mktemp)"
  cat >"$tmp"<<EOF
$*
EOF
  if declare -F askorupdate_file >/dev/null 2>&1; then
    ASKORUPDATE_ASK=0 askorupdate_file "$path" "$tmp" "Aquila React Stacking deploy" || { rm -f "$tmp"; die "askorupdate_file failed: $path"; }
    rm -f "$tmp"
  else
    chattr -i "$path" 2>/dev/null || true
    [ -f "$path" ] && cp -a "$path" "$BK/$(echo "$path" | sed 's#/#_#g').bak" || true
    install -m 0644 "$tmp" "$path"
    rm -f "$tmp"
  fi
}


set -euo pipefail
echo "== amcq.service (extraits) =="
systemctl cat amcq | sed -n '1,160p' | egrep -n 'ExecStart|Environment|PORT|WorkingDirectory|User|Group' || true
echo
echo "== LISTEN node =="
ss -lntp | egrep 'node|:(3000|4044|8484)\b|:443\b' || true
echo
echo "== PORT détecté (prio: Environment PORT, sinon ss) =="
PORT="$(systemctl show -p Environment amcq | sed -n 's/.*PORT=\([0-9]\+\).*/\1/p' | head -n1 || true)"
if [ -z "${PORT:-}" ]; then PORT="$(ss -lntp | sed -n 's/.*127\.0\.0\.1:\([0-9]\+\).*node.*/\1/p' | head -n1 || true)"; fi
echo "PORT=${PORT:-?}"
echo
echo "== CURL local =="
if [ -n "${PORT:-}" ]; then
  curl -m 3 -sS -I "http://127.0.0.1:${PORT}/health" | head -n 1 || true
  curl -m 3 -sS "http://127.0.0.1:${PORT}/status" 2>/dev/null | head -c 200 || true; echo
else
  echo "Impossible de détecter le port automatiquement."
fi
cat >"$WEB_DIR/ui/terminal.js" <<'JS'
(()=>{"use strict";
const $=s=>document.querySelector(s);
const $$=s=>Array.from(document.querySelectorAll(s));
const sleep=ms=>new Promise(r=>setTimeout(r,ms));

const USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
const RPCS=[
  window.__RPC__||"",
  "https://api.mainnet-beta.solana.com"
].filter(Boolean);

function setText(id, t){ const el=$("#"+id); if(el) el.textContent=t; }
function fmt(n,d){ n=Number(n||0); if(!isFinite(n)) n=0; return n.toFixed(d); }

async function waitWeb3(ms=12000){
  const t0=Date.now();
  while(Date.now()-t0<ms){
    if(window.solanaWeb3 && window.solanaWeb3.Connection && window.solanaWeb3.PublicKey) return true;
    await sleep(120);
  }
  return false;
}

async function getPhantomPub(trusted=false){
  if(!window.solana || !window.solana.isPhantom) return "";
  if(window.solana.publicKey) return window.solana.publicKey.toBase58();
  try{
    const r = await window.solana.connect(trusted?{onlyIfTrusted:true}:{});
    return (r && r.publicKey) ? r.publicKey.toBase58() : "";
  }catch(_){ return ""; }
}

async function getSolBalance(pub){
  const ok = await waitWeb3();
  if(!ok) return null;
  const web3=window.solanaWeb3;
  for(const rpc of RPCS){
    try{
      const conn=new web3.Connection(rpc,"confirmed");
      const lam=await conn.getBalance(new web3.PublicKey(pub),"confirmed");
      return lam/1e9;
    }catch(_){}
  }
  return null;
}

async function getUsdcBalance(pub){
  const ok = await waitWeb3();
  if(!ok) return null;
  const web3=window.solanaWeb3;
  for(const rpc of RPCS){
    try{
      const conn=new web3.Connection(rpc,"confirmed");
      const r=await conn.getParsedTokenAccountsByOwner(new web3.PublicKey(pub), {mint:new web3.PublicKey(USDC_MINT)}, "confirmed");
      let sum=0;
      for(const it of (r.value||[])){
        const ui=it.account?.data?.parsed?.info?.tokenAmount?.uiAmount;
        sum += Number(ui||0);
      }
      return sum;
    }catch(_){}
  }
  return null;
}

// fallback backend (si tu as déjà /api/invested)
async function getInvested(pub){
  try{
    const r=await fetch("/api/invested?pub="+encodeURIComponent(pub),{cache:"no-store"});
    if(!r.ok) return null;
    return await r.json();
  }catch(_){ return null; }
}

async function refreshBalances(){
  const pub = await getPhantomPub(true);
  if(!pub){
    setText("walletState","Wallet: non connecté");
    setText("balSol","—");
    setText("balUsdc","—");
    return;
  }
  setText("walletState","Wallet: "+pub.slice(0,4)+"…"+pub.slice(-4));

  // priorité: wallet réel
  const [sol,usdc] = await Promise.all([getSolBalance(pub), getUsdcBalance(pub)]);
  if(sol!=null) setText("balSol", fmt(sol,6)+" SOL"); else setText("balSol","…");
  if(usdc!=null) setText("balUsdc", fmt(usdc,2)+" USDC"); else setText("balUsdc","…");

  // affiche aussi "invested" si backend dispo
  const inv = await getInvested(pub);
  if(inv && (inv.sol!=null || inv.usdc!=null)){
    setText("invSol", fmt(inv.sol,6)+" SOL");
    setText("invUsdc", fmt(inv.usdc,2)+" USDC");
    $("#investedBox").style.display="";
  }else{
    $("#investedBox").style.display="none";
  }
}

function navActivate(id){
  $$(".nav button").forEach(b=>b.classList.toggle("active", b.dataset.view===id));
  setText("viewTitle", id.charAt(0).toUpperCase()+id.slice(1));
}

async function postJSON(url, body){
  const r=await fetch(url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body||{})});
  const t=await r.text();
  if(!r.ok) throw new Error(t||("HTTP "+r.status));
  return t;
}

// Brancher tes fonctions existantes (si backend déjà prêt)
async function startWolverine(){
  // si tu utilises déjà localStorage WOLV_DEPOSIT_OK_V1, on l’envoie tel quel
  const st = (()=>{ try{return JSON.parse(localStorage.getItem("WOLV_DEPOSIT_OK_V1")||"null");}catch(_){return null;} })();
  if(!st || !st.ok) throw new Error("Dépôt non confirmé (WOLV_DEPOSIT_OK_V1 manquant)");
  return await postJSON("/api/start",{from:st.from,to:st.to,asset:st.asset,budget:st.amount,depositSig:st.sig});
}

async function setMode(){
  const mode=$("#mode").value;
  return await postJSON("/api/traderone/mode",{mode});
}

async function withdraw(){
  const asset=$("#wdAsset").value;
  const amount=Number(($("#wdAmount").value||"").trim().replace(",","."));
  const to=($("#wdTo").value||"").trim();
  if(!(amount>0)) throw new Error("Montant invalide");
  if(!to) throw new Error("Adresse invalide");
  return await postJSON("/api/traderone/withdraw",{asset,amount,to});
}

function boot(){
  // nav
  $$(".nav button").forEach(b=>{
    b.addEventListener("click",()=>navActivate(b.dataset.view));
  });
  navActivate("dashboard");

  // wallet
  $("#btnConnect").addEventListener("click", async()=>{
    const pub = await getPhantomPub(false);
    if(!pub) alert("Phantom non connecté.");
    await refreshBalances();
  });

  // actions
  $("#btnStart").addEventListener("click", async()=>{
    try{
      $("#status").textContent="START...";
      const t=await startWolverine();
      $("#status").textContent="START OK: "+t;
    }catch(e){
      $("#status").textContent="ERR START: "+(e.message||String(e));
      alert("ERR: "+(e.message||String(e)));
    }
  });

  $("#btnMode").addEventListener("click", async()=>{
    try{
      $("#status").textContent="MODE...";
      const t=await setMode();
      $("#status").textContent="MODE OK: "+t;
    }catch(e){
      $("#status").textContent="ERR MODE: "+(e.message||String(e));
      alert("ERR: "+(e.message||String(e)));
    }
  });

  $("#btnWithdraw").addEventListener("click", async()=>{
    try{
      $("#status").textContent="WITHDRAW...";
      const t=await withdraw();
      $("#status").textContent="WITHDRAW OK: "+t;
    }catch(e){
      $("#status").textContent="ERR WITHDRAW: "+(e.message||String(e));
      alert("ERR: "+(e.message||String(e)));
    }
  });

  // refresh balances loop
  refreshBalances().catch(()=>0);
  setInterval(()=>refreshBalances().catch(()=>0), 6000);
}

if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", boot);
else boot();
})();

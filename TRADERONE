#!/usr/bin/env bash
set -euo pipefail

SITE_DIR="/var/www/fireinners.online/aiaquila"
WORKER_URL="https://aiaquila-proxy.YOURSUBDOMAIN.workers.dev"

echo "=== AIAQUILA RSS HARD FIX (REAL) ==="

cd /root

### 1. Vérification ###
[ -d "$SITE_DIR" ] || { echo "❌ Dossier introuvable"; exit 1; }

### 2. BACKUP ###
TS=$(date +%Y%m%d_%H%M%S)
cp -a "$SITE_DIR" "${SITE_DIR}_backup_$TS"
echo "✔ Backup créé: ${SITE_DIR}_backup_$TS"

### 3. FIND THE CULPRIT (IMPORTANT) ###
echo
echo "=== 🔍 RECHERCHE DES APPELS RSS ==="
grep -RniE "rss\.php|fetch\(|XMLHttpRequest|cointelegraph|coindesk|bitcoin\.com" "$SITE_DIR" || true
echo "=== FIN RECHERCHE ==="
echo

### 4. SUPPRESSION TOTALE PHP ###
find "$SITE_DIR" -type f -name "*.php" -exec rm -f {} \;
echo "✔ Tous les fichiers PHP supprimés"

### 5. PATCH FORCÉ DE TOUS LES JS ###
find "$SITE_DIR" -type f -name "*.js" -print0 | while IFS= read -r -d '' f; do
  sed -i \
    -E "
    s#fetch\([^)]*rss\.php[^)]*\)#fetch('${WORKER_URL}?url=' + encodeURIComponent(url))#g;
    s#rss\.php\?url=#${WORKER_URL}?url=#g;
    s#rss\.php#${WORKER_URL}?url=#g;
    " "$f"
done

echo "✔ Tous les JS patchés (force Worker)"

### 6. CACHE BUSTER GLOBAL ###
find "$SITE_DIR" -type f \( -name "*.js" -o -name "*.html" \) -exec sed -i "1s/^/<!-- patched $TS -->\n/" {} \;

### 7. PERMISSIONS ###
chown -R www-data:www-data "$SITE_DIR"
chmod -R 755 "$SITE_DIR"

### 8. RELOAD NGINX ###
nginx -t && systemctl reload nginx
echo "✔ Nginx reload OK"

### 9. TEST NAVIGATEUR-LIKE ###
echo
echo "=== TEST WORKER JSON ==="
curl -s -H "Accept: application/json" \
"${WORKER_URL}?url=https://news.bitcoin.com/feed/" | head -c 300
echo
echo "=== FIN TEST ==="

### 10. RÉSULTAT ###
echo
echo "✅ FIX APPLIQUÉ"
echo "➡️ PHP éliminé"
echo "➡️ Frontend forcé sur Worker"
echo "➡️ Plus aucun HTML possible"
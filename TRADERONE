#!/bin/bash
set -e

FILE="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"

echo "=== WOLVERINE • COULEURS AVANCÉES + CONSOLE FIX ==="

node <<'NODE'
const fs=require("fs");
const f=process.env.FILE||"/opt/fireinners/frontend-react/app/dist/wolverine/index.html";
let h=fs.readFileSync(f,"utf8");

/* ================== STYLES ================== */
if(!h.includes("WOLV_COLOR_SYSTEM")){
h=h.replace("</head>",`
<style id="WOLV_COLOR_SYSTEM">
:root{
 --c-border:#ff5fa2;
 --c-bg:#4dfff3;
 --c-btn:#8a5cff;

 --bg-dark:#0b0e14;
 --bg-light:#ffffff;

 --txt-dark:#0b0b0b;
 --txt-light:#ffffff;
}

/* GLOBAL BACKGROUND */
body{
 background:
 radial-gradient(circle at 20% 10%,var(--c-bg),transparent 55%),
 radial-gradient(circle at 80% 90%,var(--c-border),transparent 55%),
 linear-gradient(135deg,#0a0012,#02030a);
 color:var(--txt-light);
 transition:background .4s,color .3s;
}

/* CONTOURS */
.card,button,input,select{
 border:1px solid var(--c-border)!important;
 box-shadow:0 0 12px color-mix(in srgb,var(--c-border) 40%,transparent);
}

/* BOUTONS */
button{
 background:linear-gradient(135deg,var(--c-btn),color-mix(in srgb,var(--c-btn) 40%,#000));
 color:white;
}

/* HALO TEXTE */
.halo{
 text-shadow:
 0 0 6px var(--c-border),
 0 0 14px var(--c-bg);
}

/* CONSOLE */
#log.console-dark{
 background:#000!important;
 color:#fff!important;
}
#log.console-light{
 background:#fff!important;
 color:#000!important;
}

/* INPUTS */
input,select{
 background:rgba(0,0,0,.25);
 color:var(--txt-light);
}
</style>
</head>`);
}

/* ================== MENU ================== */
if(!h.includes("WOLV_COLOR_MENU")){
h=h.replace("<body",`
<body>
<div id="WOLV_COLOR_MENU" style="position:fixed;bottom:20px;left:20px;z-index:99;
background:rgba(0,0,0,.6);padding:10px;border-radius:12px;display:flex;flex-direction:column;gap:6px">

<label>Contour</label>
<input type="color" value="#ff5fa2" onchange="setBorder(this.value)">

<label>Fond</label>
<input type="color" value="#4dfff3" onchange="setBg(this.value)">

<label>Boutons</label>
<input type="color" value="#8a5cff" onchange="setBtn(this.value)">

<button onclick="toggleConsole()">Console Dark/Light</button>
</div>
`);
}

/* ================== SCRIPT ================== */
if(!h.includes("WOLV_COLOR_SCRIPT")){
h=h.replace("</body>",`
<script id="WOLV_COLOR_SCRIPT">
function setBorder(c){
 document.documentElement.style.setProperty("--c-border",c);
 save();
}
function setBg(c){
 document.documentElement.style.setProperty("--c-bg",c);
 save();
}
function setBtn(c){
 document.documentElement.style.setProperty("--c-btn",c);
 save();
}
function toggleConsole(){
 const log=document.getElementById("log");
 log.classList.toggle("console-dark");
 log.classList.toggle("console-light");
 localStorage.setItem("wolv_console",log.className);
}
function save(){
 localStorage.setItem("wolv_colors",JSON.stringify({
  b:getComputedStyle(document.documentElement).getPropertyValue("--c-border"),
  g:getComputedStyle(document.documentElement).getPropertyValue("--c-bg"),
  bt:getComputedStyle(document.documentElement).getPropertyValue("--c-btn")
 }));
}
window.addEventListener("load",()=>{
 const c=JSON.parse(localStorage.getItem("wolv_colors")||"null");
 if(c){
  document.documentElement.style.setProperty("--c-border",c.b);
  document.documentElement.style.setProperty("--c-bg",c.g);
  document.documentElement.style.setProperty("--c-btn",c.bt);
 }
 const log=document.getElementById("log");
 if(log){
  log.className=localStorage.getItem("wolv_console")||"console-dark";
 }
});
</script>
</body>`);
}

fs.writeFileSync(f,h);
NODE

nginx -t && systemctl reload nginx
echo "✅ Couleurs + console OK"
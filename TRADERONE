set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
DISABLED="/etc/nginx/sites-disabled"
TS="$(date +%s)"

FIRE_DIST="/var/www/fireinners"
WOLV_DIST="/var/www/wolverine"

APP="/opt/fireinners/frontend-react/app"   # là où tu avais tes dist_BACKUP_*
cd "$APP" || { echo "KO: APP introuvable: $APP"; exit 1; }

echo "=== 1) Désactiver TOUT doublon nginx qui redéfinit /wolverine (sauf $NG) ==="
mkdir -p "$DISABLED"
mapfile -t FILES < <(grep -RIl -E 'location\s+\^~\s+/wolverine/|location\s*=\s*/wolverine' \
  /etc/nginx/sites-enabled /etc/nginx/conf.d /etc/nginx/sites-available 2>/dev/null | sort -u || true)

for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  if [ "$f" != "$NG" ]; then
    base="$(basename "$f")"
    echo "MOVE DUP: $f -> $DISABLED/$base.$TS"
    mv "$f" "$DISABLED/$base.$TS"
  else
    echo "KEEP: $f"
  fi
done

nginx -t

echo
echo "=== 2) Trouver le 'vrai' UI WOLVERINE dans tes dist/backups (gros/épais/colonnes) ==="
# On scanne tous les dist*/index.html et on score:
# + si contient wolverine/traderone
# - si contient fireinners/wallet
best=""
bestScore=-999

while IFS= read -r f; do
  s=0
  grep -qi "wolverine" "$f" && s=$((s+5))
  grep -qi "traderone" "$f" && s=$((s+5))
  grep -qi "dexes\|positions\|orders\|trades" "$f" && s=$((s+2))
  grep -qi "fireinners" "$f" && s=$((s-5))
  grep -qi "wallet" "$f" && s=$((s-3))

  if [ $s -gt $bestScore ]; then
    bestScore=$s
    best="$f"
  fi
done < <(find . -maxdepth 2 -type f -path "./dist*/index.html" 2>/dev/null | sort -r)

echo "BEST_SCORE=$bestScore"
echo "BEST_INDEX=$best"
[ -n "${best:-}" ] || { echo "KO: aucun dist*/index.html trouvé"; exit 1; }

SRC_DIR="$(dirname "$best")"
echo "=== 3) Deploy FORCE: $SRC_DIR -> $WOLV_DIST ==="
apt-get update -y >/dev/null
apt-get install -y rsync >/dev/null
mkdir -p "$WOLV_DIST"
rsync -a --delete "$SRC_DIR/" "$WOLV_DIST/"

chmod -R 755 /var/www
find "$WOLV_DIST" -type f -exec chmod 644 {} \;

echo
echo "=== 4) Forcer le mapping nginx: / = FIREINNERS ; /wolverine = WOLVERINE (sans toucher l’API) ==="
cp -a "$NG" "$NG.bak.demele_$TS"

python3 - <<'PY'
from pathlib import Path
import re

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

# Enlève blocs UI /wolverine existants (on ne touche PAS aux blocs /wolverine/traderone/api si présents ailleurs)
for pat in [
  r'\n\s*#\s*---\s*WOLVERINE UI[\s\S]*?location\s+\^~\s+/wolverine/[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s*=\s*/wolverine\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/wolverine/\s*\{[\s\S]*?\n\s*\}\s*',
  r'\n\s*location\s+\^~\s+/\s*\{[\s\S]*?\n\s*\}\s*',
]:
  s = re.sub(pat, "\n", s, flags=re.M)

block = r'''
# --- ROOT UI (FIREINNERS) ---
location = / { return 301 /; }
location ^~ / {
  root /var/www/fireinners;
  index index.html;
  try_files $uri $uri/ /index.html;
}

# --- WOLVERINE UI ---
location = /wolverine { return 301 /wolverine/; }
location ^~ /wolverine/ {
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}
'''

i = s.rfind("}")
if i == -1:
  raise SystemExit("KO: conf nginx invalide (pas de } final)")
s = s[:i] + "\n" + block + "\n" + s[i:]
ng.write_text(s)
print("OK: mapping / et /wolverine réécrit")
PY

nginx -t
systemctl reload nginx

echo
echo "=== 5) Vérifs locales (preuves) ==="
echo "--- /var/www/wolverine/index.html (title + mots clés) ---"
grep -nEi "title|wolverine|traderone|fireinners|wallet" "$WOLV_DIST/index.html" | head -n 25 || true
echo "--- /var/www/fireinners/index.html (title) ---"
[ -f "$FIRE_DIST/index.html" ] && grep -nEi "title" "$FIRE_DIST/index.html" | head -n 5 || true

echo
echo "=== 6) Tests HTTP ==="
curl -sS -I https://fireinners.online/ | head -n 10
curl -sS -I https://fireinners.online/wolverine/ | head -n 10
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 12

echo "DONE ✅"
cat >/root/TRADERONE_FIX_NO_REGEX.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
echo "===== TRADERONE FIX NO REGEX (SAFE) ====="

HTML="/var/www/wolverine/index.html"
API="/opt/traderone-vault/server.js"
TS="$(date +%Y%m%d_%H%M%S)"

echo "[1] BACKUP"
cp -a "$HTML" "$HTML.bak_$TS"
cp -a "$API" "$API.bak_$TS"

echo "[2] FRONTEND PATCH (inject only)"
node <<'NODE'
const fs=require("fs");
const f="/var/www/wolverine/index.html";
let s=fs.readFileSync(f,"utf8");

/* inject safePost once */
if(!s.includes("function safePost(")){
 s=s.replace("</body>",`
<script>
async function safePost(url,payload){
 const r=await fetch(url,{
  method:"POST",
  headers:{"Content-Type":"application/json"},
  body:JSON.stringify(payload)
 });
 const t=await r.text();
 try{return JSON.parse(t);}catch(e){return{ok:false,error:t};}
}
</script>
</body>`);
}

/* override click handler safely */
if(!s.includes("sendToTraderOneSafe")){
 s=s.replace("</body>",`
<script>
function sendToTraderOneSafe(){
 const amount=parseFloat(document.querySelector("input").value||0);
 if(!window.walletAddress||!amount){log("Paramètres invalides");return;}
 safePost("/wolverine/traderone/api/budget",{from:walletAddress,amount})
 .then(r=>{if(!r.ok)throw r.error;log("Envoyé OK",r);})
 .catch(e=>log("Erreur TraderOne",e));
}
document.querySelectorAll("button").forEach(b=>{
 if(b.innerText.includes("TraderOne")) b.onclick=sendToTraderOneSafe;
});
</script>
</body>`);
}

/* force FireInners color */
s=s.replaceAll("#4caf50","#00bcd4")
   .replaceAll("green","#00bcd4");

fs.writeFileSync(f,s);
console.log("FRONTEND OK");
NODE

echo "[3] API VERIFY"
grep -q "/wolverine/traderone/api/budget" "$API" || {
node <<'NODE'
const fs=require("fs");
const f="/opt/traderone-vault/server.js";
let s=fs.readFileSync(f,"utf8");
s+=`
app.options("/wolverine/traderone/api/budget",(req,res)=>{
 res.setHeader("Access-Control-Allow-Origin","*");
 res.setHeader("Access-Control-Allow-Headers","Content-Type");
 res.setHeader("Access-Control-Allow-Methods","POST,OPTIONS");
 res.sendStatus(200);
});
app.post("/wolverine/traderone/api/budget",(req,res)=>{
 try{
  const{from,amount}=req.body||{};
  if(!from||!amount)return res.status(400).json({ok:false});
  res.json({ok:true,from,amount});
 }catch(e){res.status(500).json({ok:false,error:String(e)})}
});
`;
fs.writeFileSync(f,s);
console.log("API PATCHED");
NODE
}

echo "[4] RESTART"
pm2 restart traderone-vault
nginx -t && systemctl reload nginx

echo "[5] LOCAL TEST"
curl -s -X POST http://127.0.0.1:3000/wolverine/traderone/api/budget \
 -H "Content-Type: application/json" \
 -d '{"from":"test","amount":1}' || true

echo "===== FIX APPLIED — NO REGEX — STABLE ====="
BASH

chmod +x /root/TRADERONE_FIX_NO_REGEX.sh
/root/TRADERONE_FIX_NO_REGEX.sh
cat > /root/MEGA_BUNDLER_FIX_404_V2.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

[ "$(id -u)" -eq 0 ] || { echo "RUN AS ROOT"; exit 1; }

DOMAIN="${DOMAIN:-fireinners.online}"
WEBROOT="/var/www/bundler"
API_DIR="/opt/bundler_api"
API_HOST="${API_HOST:-127.0.0.1}"
API_PORT="${API_PORT:-9797}"

INC_DIR="/etc/nginx/includes"
INC_FILE="${INC_DIR}/bundler_routes.inc"

TS="$(date +%Y%m%d_%H%M%S)"
BK="/root/BUNDLER_FIX404_V2_${TS}"
mkdir -p "$BK"

say(){ printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

say "backup => $BK"
cp -a /etc/nginx "$BK/nginx" 2>/dev/null || true
cp -a /etc/systemd/system "$BK/systemd_system" 2>/dev/null || true
mkdir -p "$BK/www" && cp -a "$WEBROOT" "$BK/www/bundler" 2>/dev/null || true
mkdir -p "$BK/opt" && cp -a "$API_DIR" "$BK/opt/bundler_api" 2>/dev/null || true

say "detect active ssl vhost file for ${DOMAIN}"
NGT="$BK/nginx_T.txt"
nginx -T >"$NGT" 2>&1 || { tail -n 200 "$NGT" || true; exit 1; }

ACTIVE_SSL_FILE="$(python3 - "$DOMAIN" "$NGT" <<'PY'
import re,sys
dom=sys.argv[1]
ngt=sys.argv[2]
txt=open(ngt,"r",errors="ignore").read().splitlines()
cur=None
pairs=[]
for ln in txt:
  m=re.match(r'^# configuration file (.+?):', ln)
  if m:
    cur=m.group(1); continue
  if cur: pairs.append((cur,ln))

servers=[]
depth=0; in_srv=False; buf=[]; fcur=None
def d(s): return s.count('{')-s.count('}')
for f,ln in pairs:
  s=ln.strip()
  if s.startswith('#'): continue
  if not in_srv and re.search(r'\bserver\s*\{', s):
    in_srv=True; buf=[ln]; fcur=f; depth=d(ln); continue
  if in_srv:
    buf.append(ln); depth+=d(ln)
    if depth<=0:
      servers.append((fcur,"\n".join(buf)))
      in_srv=False; buf=[]; fcur=None; depth=0

domre=re.compile(r'\bserver_name\b[^;]*\b'+re.escape(dom)+r'\b',re.I)
sslre=re.compile(r'\blisten\b[^;]*\b443\b[^;]*\bssl\b',re.I)
for f,blk in servers:
  if domre.search(blk) and sslre.search(blk):
    print(f); sys.exit(0)
print("")
PY
)"

[ -n "${ACTIVE_SSL_FILE:-}" ] || { say "FAIL: no SSL vhost found for ${DOMAIN}"; exit 1; }
say "ACTIVE_SSL_FILE=$ACTIVE_SSL_FILE"

say "write include file $INC_FILE"
mkdir -p "$INC_DIR"
cat >"$INC_FILE" <<EOF
# AUTO bundler routes (${TS})
location = /bundler { return 301 /bundler/; }
location ^~ /bundler/ {
  alias ${WEBROOT}/;
  try_files \$uri \$uri/ /bundler/index.html;
}
location = /bundler/api { return 301 /bundler/api/; }
location ^~ /bundler/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host \$host;
  proxy_set_header X-Real-IP \$remote_addr;
  proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto \$scheme;
  proxy_pass http://${API_HOST}:${API_PORT}/;
}
EOF

say "inject include into SSL vhost (safe)"
python3 - "$ACTIVE_SSL_FILE" "$DOMAIN" "$INC_FILE" <<'PY'
import re,sys,shutil
path,dom,inc=sys.argv[1],sys.argv[2],sys.argv[3]
bk=path+".bak_"+re.sub(r'[^0-9A-Za-z]+','_',inc)[-32:]
shutil.copy2(path,bk)

lines=open(path,'r',errors='ignore').read().splitlines(True)
inc_line=f"  include {inc};\n"
domre=re.compile(r'\bserver_name\b[^;]*\b'+re.escape(dom)+r'\b',re.I)
sslre=re.compile(r'\blisten\b[^;]*\b443\b[^;]*\bssl\b',re.I)

out=[]
depth=0
in_srv=False
srv=[]
def d(s): return s.count('{')-s.count('}')

def flush_server(srv_lines):
  blk="".join(srv_lines)
  if f"include {inc};" in blk: return srv_lines, False
  if domre.search(blk) and sslre.search(blk):
    # insert include right after first server_name line if possible
    new=[]
    inserted=False
    for ln in srv_lines:
      new.append(ln)
      if (not inserted) and re.search(r'\bserver_name\b', ln):
        new.append(inc_line); inserted=True
    if not inserted:
      # fallback: insert before closing brace
      for i in range(len(new)-1,-1,-1):
        if new[i].strip()=="}":
          new.insert(i,inc_line); inserted=True; break
    return new, True
  return srv_lines, False

i=0; changed=False
while i<len(lines):
  ln=lines[i]
  s=ln.strip()
  if (not in_srv) and re.search(r'\bserver\s*\{', s):
    in_srv=True; srv=[ln]; depth=d(ln); i+=1; continue
  if in_srv:
    srv.append(ln); depth+=d(ln)
    if depth<=0:
      srv2, did=flush_server(srv)
      out.extend(srv2)
      changed = changed or did
      in_srv=False; srv=[]; depth=0
    i+=1; continue
  out.append(ln); i+=1

open(path,'w').write("".join(out))
print("CHANGED" if changed else "NOCHANGE")
PY

say "ensure webroot $WEBROOT"
mkdir -p "$WEBROOT"
if [ ! -f "$WEBROOT/index.html" ]; then
  cat >"$WEBROOT/index.html" <<'EOF'
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bundler</title></head><body style="font-family:system-ui;margin:40px"><h1>Bundler</h1><p>Route OK. Remplacer ce placeholder par le build Vite/React.</p></body></html>
EOF
fi

say "write minimal stable API on ${API_HOST}:${API_PORT}"
mkdir -p "$API_DIR"
cat >"$API_DIR/server.js" <<'EOF'
const http=require("http");
const host=process.env.API_HOST||"127.0.0.1";
const port=parseInt(process.env.API_PORT||"9797",10);
const key=process.env.BUNDLER_API_KEY||"";
const send=(res,code,obj)=>{res.writeHead(code,{"content-type":"application/json"});res.end(JSON.stringify(obj));};
http.createServer((req,res)=>{
  const u=new URL(req.url,"http://x");
  if(u.pathname==="/health") return send(res,200,{ok:true,ts:new Date().toISOString(),host,port});
  if(u.pathname==="/create-token"){
    if(req.method!=="POST") return send(res,405,{ok:false,error:"METHOD_NOT_ALLOWED"});
    const got=(req.headers["x-api-key"]||"").toString();
    if(key && got!==key) return send(res,401,{ok:false,error:"UNAUTHORIZED"});
    let b=""; req.on("data",d=>b+=d); req.on("end",()=>send(res,200,{ok:true,stub:true,payload:(()=>{try{return b?JSON.parse(b):{};}catch(e){return {raw:b};}})()}));
    return;
  }
  return send(res,404,{ok:false,error:"NOT_FOUND",path:u.pathname});
}).listen(port,host,()=>console.log(JSON.stringify({ok:true,ts:new Date().toISOString(),host,port})));
EOF

API_KEY_FILE="${API_DIR}/.api_key"
if [ ! -f "$API_KEY_FILE" ]; then tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48 >"$API_KEY_FILE"; fi
chmod 600 "$API_KEY_FILE" || true
BUNDLER_API_KEY="$(cat "$API_KEY_FILE")"

say "systemd: install/repair service"
cat > /etc/systemd/system/bundler-api.service <<EOF
[Unit]
Description=Bundler API (stable minimal)
After=network.target

[Service]
Type=simple
WorkingDirectory=${API_DIR}
Environment=API_HOST=${API_HOST}
Environment=API_PORT=${API_PORT}
Environment=BUNDLER_API_KEY=${BUNDLER_API_KEY}
ExecStart=/usr/bin/node ${API_DIR}/server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now bundler-api.service >/dev/null 2>&1 || true
systemctl restart bundler-api.service

say "nginx: test + reload"
nginx -t
systemctl reload nginx

say "diag: listeners"
ss -lntp | grep -E "(:${API_PORT}\s)" || true

say "tests: local api"
curl -fsS "http://${API_HOST}:${API_PORT}/health" && echo " LOCAL_API_OK" || echo " LOCAL_API_FAIL"

say "tests: nginx on-box (force host) /bundler/ + /bundler/api/health"
curl -k -sS -o /dev/null -D - --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/bundler/" | sed -n '1,12p'
curl -k -sS -o /dev/null -D - --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/bundler/api/health" | sed -n '1,12p'

say "DONE"
say "BACKUP=$BK"
SH
chmod +x /root/MEGA_BUNDLER_FIX_404_V2.sh
/root/MEGA_BUNDLER_FIX_404_V2.sh
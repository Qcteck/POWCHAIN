set -e
cd /root

echo "=== 1) nginx -t (on récupère le fichier + ligne) ==="
ERR="$(nginx -t 2>&1 || true)"
echo "$ERR" | tail -n 30

# parse: "... in /path/file:123"
FILE="$(echo "$ERR" | sed -n 's/.*in \(\/[^:]*\):\([0-9]\+\).*/\1/p' | head -n 1)"
LINE="$(echo "$ERR" | sed -n 's/.*in \(\/[^:]*\):\([0-9]\+\).*/\2/p' | head -n 1)"

echo "FILE=$FILE"
echo "LINE=$LINE"

if [ -z "$FILE" ] || [ -z "$LINE" ] || [ ! -f "$FILE" ]; then
  echo
  echo "!!! Impossible d'extraire FILE/LINE depuis nginx -t."
  echo "On affiche quand même les proxy_set_header des vhosts:"
  grep -RIn "proxy_set_header" /etc/nginx/sites-enabled /etc/nginx/nginx.conf | head -n 120 || true
  exit 1
fi

echo
echo "=== 2) Contexte autour de la ligne fautive (awk, safe) ==="
START=$((LINE-12)); if [ "$START" -lt 1 ]; then START=1; fi
END=$((LINE+12))
awk -v s="$START" -v e="$END" 'NR>=s && NR<=e {printf "%5d  %s\n", NR, $0}' "$FILE"

echo
echo "=== 3) Backup + commente EXACTEMENT la ligne fautive ==="
cp -v "$FILE" "$FILE.bak.$(date +%Y%m%d_%H%M%S)"
perl -pi -e "if (\$. == $LINE) { s/^\\s*/# FIX_DISABLED_BAD_PROXY_SET_HEADER / }" "$FILE"

echo
echo "=== 4) Re-test + reload ==="
nginx -t
systemctl reload nginx

echo
echo "=== 5) Re-test local (via nginx) ==="
curl -sS -i -X POST -H "Host: fireinners.online" -H "content-type: application/json" \
  http://127.0.0.1/wolverine/traderone/api/status --data '{}' | head -n 40 || true
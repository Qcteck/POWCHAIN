'use strict';

require('dotenv').config();
const express = require('express');
const cors = require('cors');
const bs58 = require('bs58');

const { Connection, Keypair, PublicKey, LAMPORTS_PER_SOL } = require('@solana/web3.js');
const spl = require('@solana/spl-token');

function mustEnv(name, fallback='') { return (process.env[name] ?? fallback).toString().trim(); }

const API_HOST = mustEnv('API_HOST','127.0.0.1');
const API_PORT = parseInt(mustEnv('API_PORT','9797'),10);
const RPC = mustEnv('SOLANA_RPC_URL', mustEnv('RPC_URL',''));
const REQUIRE_KEY = mustEnv('BUNDLER_API_KEY',''); // si vide => pas d’auth obligatoire

const fs = require('fs');
const WALLET_PATH = __dirname + '/wallet.json';

function loadPayer() {
  const sk = Uint8Array.from(JSON.parse(fs.readFileSync(WALLET_PATH,'utf8')));
  return Keypair.fromSecretKey(sk);
}

function jsonError(res, code, msg, extra={}) { res.status(code).json({ ok:false, error: msg, ...extra }); }

function parseAmountToBigInt(humanStr, decimals) {
  const s = (humanStr ?? '').toString().trim();
  if (!s) throw new Error('SUPPLY_REQUIRED');
  if (!/^\d+(\.\d+)?$/.test(s)) throw new Error('SUPPLY_INVALID');
  const [a,b=''] = s.split('.');
  const frac = (b + '0'.repeat(decimals)).slice(0, decimals);
  const full = (a.replace(/^0+(?=\d)/,'') || '0') + frac;
  return BigInt(full.replace(/^0+(?=\d)/,'') || '0');
}

async function createOrMintToken({ ownerStr, decimals, supplyHuman, mintAddressStr, preflightOnly, revokeMintAuth, revokeFreezeAuth }) {
  if (!RPC) throw new Error('RPC_MISSING');
  const payer = loadPayer();
  const connection = new Connection(RPC, 'confirmed');

  const owner = ownerStr ? new PublicKey(ownerStr) : payer.publicKey;

  const dec = Number(decimals);
  if (!Number.isInteger(dec) || dec < 0 || dec > 12) throw new Error('DECIMALS_INVALID');

  const amount = parseAmountToBigInt(String(supplyHuman), dec);

  // preflightOnly: on valide params + calcule un estimé (sans rien écrire on-chain)
  if (preflightOnly) {
    const minRent = await connection.getMinimumBalanceForRentExemption(spl.MINT_SIZE);
    return {
      preflightOnly: true,
      rpc: RPC,
      payer: payer.publicKey.toBase58(),
      owner: owner.toBase58(),
      decimals: dec,
      amount: amount.toString(),
      est: {
        mintRentLamports: String(minRent),
        mintRentSOL: String(minRent / LAMPORTS_PER_SOL)
      }
    };
  }

  let mintPubkey;
  if (mintAddressStr) {
    mintPubkey = new PublicKey(mintAddressStr);
  } else {
    mintPubkey = await spl.createMint(
      connection,
      payer,
      payer.publicKey,              // mint authority (temp)
      payer.publicKey,              // freeze authority (temp)
      dec
    );
  }

  const ata = await spl.getOrCreateAssociatedTokenAccount(
    connection,
    payer,
    mintPubkey,
    owner
  );

  // mintTo : amount BigInt => spl-token accepte bigint
  await spl.mintTo(
    connection,
    payer,
    mintPubkey,
    ata.address,
    payer,          // authority
    amount
  );

  // revoke authorities
  if (revokeMintAuth) {
    await spl.setAuthority(
      connection,
      payer,
      mintPubkey,
      payer,
      spl.AuthorityType.MintTokens,
      null
    );
  }
  if (revokeFreezeAuth) {
    await spl.setAuthority(
      connection,
      payer,
      mintPubkey,
      payer,
      spl.AuthorityType.FreezeAccount,
      null
    );
  }

  return {
    preflightOnly: false,
    rpc: RPC,
    payer: payer.publicKey.toBase58(),
    owner: owner.toBase58(),
    mint: mintPubkey.toBase58(),
    ata: ata.address.toBase58(),
    decimals: dec,
    amount: amount.toString()
  };
}

const app = express();
app.use(cors({ origin: '*', methods: ['GET','POST','OPTIONS'], allowedHeaders: ['Content-Type','X-API-Key','Authorization'] }));
app.use(express.json({ limit: '1mb' }));

app.get('/health', (req,res)=>res.json({ ok:true, ts:new Date().toISOString(), host:API_HOST, port:API_PORT, rpc:RPC, authRequired: !!REQUIRE_KEY }));

function extractKey(req, body) {
  const h = (req.headers['x-api-key'] || req.headers['authorization'] || '').toString().trim();
  if (h.startsWith('Bearer ')) return h.slice(7).trim();
  const b = (body && (body.apiKey || body.key || body.api_key)) ? String(body.apiKey || body.key || body.api_key).trim() : '';
  return b || h;
}

async function handleCreate(req,res){
  try{
    const body = req.body || {};
    const k = extractKey(req, body);
    if (REQUIRE_KEY && k !== REQUIRE_KEY) return jsonError(res, 401, 'UNAUTHORIZED');

    const out = await createOrMintToken({
      ownerStr: body.owner || body.OWNER || '',
      decimals: body.decimals ?? body.DECIMALS ?? 6,
      supplyHuman: body.supply ?? body.SUPPLY ?? body.supplyHuman ?? body.SUPPLY_HUMAN ?? '',
      mintAddressStr: body.mintAddress || body.MINT_ADDRESS || '',
      preflightOnly: !!(body.preflightOnly || body.PREFLIGHT_ONLY),
      revokeMintAuth: !!(body.revokeMintAuth || body.REVOKE_MINT_AUTH),
      revokeFreezeAuth: !!(body.revokeFreezeAuth || body.REVOKE_FREEZE_AUTH)
    });

    res.json({ ok:true, stub:false, result: out });
  }catch(e){
    res.status(400).json({ ok:false, stub:false, error: (e && e.message) ? e.message : String(e) });
  }
}

app.post('/api/create-token', handleCreate);
app.post('/bundler/api/create-token', handleCreate); // compat si tu proxifies direct

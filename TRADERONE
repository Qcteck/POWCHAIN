say "8) Ensure vhost includes wolverine_routes.inc"
python3 - <<PY
from pathlib import Path
v=Path("$VHOST")
if not v.exists():
  raise SystemExit(f"Missing vhost: {v}")
s=v.read_text(errors="ignore")

inc='include /etc/nginx/includes/wolverine_routes.inc;'
if inc in s:
  print("OK: include already present")
else:
  # insert include inside the first SSL server block that contains server_name fireinners.online
  import re
  m=re.search(r'(server\\s*\\{[^}]*server_name\\s+[^;]*\\bfireinners\\.online\\b[^;]*;)', s, re.S)
  if not m:
    # fallback: inject near top of file
    s = inc + "\\n" + s
  else:
    block_start=m.start(1)
    # place include right after server_name line
    s = s[:m.end(1)] + "\\n  " + inc + s[m.end(1):]
  v.write_text(s)
  print("OK: include injected")
PY

say "9) Patch index.html so RPC/Vault endpoints are ABSOLUTE (fix 'Endpoint URL must start with http/https')"
python3 - <<'PY'
from pathlib import Path
p=Path("/var/www/wolverine/index.html")
s=p.read_text(errors="ignore")

def repl_all(s, quoted, expr):
  return s.replace(f'"{quoted}"', expr).replace(f"'{quoted}'", expr)

# Replace quoted relative endpoints with expression that becomes absolute URL
s2=s
s2=repl_all(s2, "/wolverine/solana-rpc", 'new URL("/wolverine/solana-rpc",location.origin).href')
s2=repl_all(s2, "/wolverine/vault/api", 'new URL("/wolverine/vault/api",location.origin).href')

# Safety: if code uses plain string concatenation somewhere else, inject helper (non-destructive)
marker="/*AQUILA_ABSURL_HELPER*/"
if marker not in s2:
  inject = '<script>'+marker+';(()=>{try{window.__AQUILA_ABSURL__=(u)=>{try{return (/^https?:\\/\\//.test(u)?u:(new URL(u,location.origin)).href)}catch(e){return u}}}catch(e){}})();</script>'
  if "</head>" in s2:
    s2 = s2.replace("</head>", inject+"</head>", 1)
  else:
    s2 = inject + s2

if s2 != s:
  p.write_text(s2)
  print("OK: index.html patched")
else:
  print("OK: index.html unchanged (nothing to patch)")
PY


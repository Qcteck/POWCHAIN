#!/bin/bash
set -e

echo "=== TRADERONE • FIX BACKEND BALANCES ==="

DIR="/opt/wolverine"
SERVER="$DIR/server.js"
BACKUP="$SERVER.bak.$(date +%s)"

echo "[1/6] Backup server.js"
cp "$SERVER" "$BACKUP"

echo "[2/6] Patch balances endpoint"
node <<'NODE'
const fs=require("fs");
let s=fs.readFileSync("/opt/wolverine/server.js","utf8");
if(s.includes("api/balances")){
  console.log("balances endpoint already present");
  process.exit(0);
}
s+=`
/* === BALANCES ENDPOINT (AUTO-PATCH) === */
const {Connection,PublicKey,LAMPORTS_PER_SOL}=require("@solana/web3.js");
const RPC=process.env.SOLANA_RPC||"https://api.mainnet-beta.solana.com";
const conn=new Connection(RPC,"confirmed");

app.get("/api/balances",async(req,res)=>{
  try{
    const user=req.query.user;
    let phantomSOL=null;
    if(user){
      const b=await conn.getBalance(new PublicKey(user));
      phantomSOL=b/LAMPORTS_PER_SOL;
    }
    const internalSOL=(global.internalSOL||0);
    res.json({phantomSOL,internalSOL});
  }catch(e){
    res.status(500).json({error:e.message});
  }
});
`;
fs.writeFileSync("/opt/wolverine/server.js",s);
console.log("balances endpoint added");
NODE

echo "[3/6] Install deps (if missing)"
cd "$DIR"
npm install @solana/web3.js --omit=dev

echo "[4/6] Restart PM2"
pm2 restart traderone || pm2 start server.js --name traderone
pm2 save

echo "[5/6] Test endpoint"
curl -s "http://127.0.0.1:3000/api/balances" || true

echo "[6/6] DONE"
echo "Backup: $BACKUP"
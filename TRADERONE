cat >/tmp/WOLVERINE_TG_SETUP.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
ENV="/opt/fireinners/wolverine-telegram/telegram.env"
SEND="/usr/local/bin/wolv_send"

[ -x "$SEND" ] || { echo "wolv_send missing"; exit 1; }

read -r -p "TG_TOKEN (BotFather) = " TG_TOKEN
[ -n "${TG_TOKEN:-}" ] || { echo "token vide"; exit 1; }

echo
echo "1) Ouvre Telegram et écris à @WOLVERINE_V1BOT : /start (en privé)"
echo "   ou si c'est un groupe: ajoute le bot au groupe, envoie un message, puis relance."
echo
read -r -p "Appuie ENTER quand c'est fait..." _

echo
echo "Récupération des derniers updates..."
JSON="$(curl -sS "https://api.telegram.org/bot${TG_TOKEN}/getUpdates?timeout=10&limit=20")"

python3 - <<PY
import json,sys
data=json.loads(sys.argv[1])
res=data.get("result",[])
seen=[]
for u in res:
  m=u.get("message") or u.get("edited_message") or {}
  chat=m.get("chat") or {}
  cid=chat.get("id")
  title=chat.get("title") or ""
  uname=(chat.get("username") or "")
  typ=chat.get("type") or ""
  text=m.get("text") or ""
  if cid is None: 
    continue
  key=(cid,typ,title,uname)
  if key in seen: 
    continue
  seen.append(key)
  print(f"CHAT_ID={cid}  type={typ}  title='{title}'  username='{uname}'  last='{text[:60]}'")
PY "$JSON" || true

echo
read -r -p "Choisis TG_CHAT_ID (copie/colle un CHAT_ID affiché) = " TG_CHAT_ID
[ -n "${TG_CHAT_ID:-}" ] || { echo "chat id vide"; exit 1; }

umask 077
cat >"$ENV" <<EOF
TG_TOKEN=${TG_TOKEN}
TG_CHAT_ID=${TG_CHAT_ID}
EOF
chmod 600 "$ENV"

echo
echo "Test envoi..."
wolv_send "WOLVERINE_V1BOT OK - test depuis VPS"
echo "OK."
SH
bash /tmp/WOLVERINE_TG_SETUP.sh
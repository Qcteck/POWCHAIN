cat >/root/WOLV_FIND_API_PORT.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

echo "=== LISTEN ports (node) ==="
ss -lptn 2>/dev/null | grep -E 'LISTEN' | grep -E 'users:\(\("node"|users:\(\("pm2"|node' || true
echo

echo "=== Ports only (node) ==="
ss -lptn 2>/dev/null | awk '
  /LISTEN/ && $0 ~ /users:\(\("node"/ {
    # local address is column 4, like 0.0.0.0:3000 or [::]:8080
    addr=$4
    sub(/^.*:/,"",addr)
    print addr
  }' | sort -nu || true
echo

echo "=== Try common local API health ==="
for p in 3000 3001 8080 8000 5000 4000; do
  if curl -sS --max-time 1 "http://127.0.0.1:$p/api" >/dev/null 2>&1; then
    echo "✅ API responds on :$p (GET /api)"
  fi
done
echo

echo "=== systemd node services (running) ==="
systemctl list-units --type=service --state=running --no-pager 2>/dev/null | \
  awk '{print $1}' | grep -E '\.service$' | while read -r s; do
    es="$(systemctl show -p ExecStart --value "$s" 2>/dev/null || true)"
    if echo "$es" | grep -qi "node"; then
      echo "SERVICE: $s"
      echo "  ExecStart: $es"
      echo "  WorkingDirectory: $(systemctl show -p WorkingDirectory --value "$s" 2>/dev/null || true)"
      echo
    fi
  done || true

echo "=== PM2 (if installed) ==="
if command -v pm2 >/dev/null 2>&1; then
  pm2 list || true
else
  echo "pm2 not installed"
fi
BASH

bash /root/WOLV_FIND_API_PORT.sh
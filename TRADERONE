# 4) Patch FRONT: affiche "Investi (TraderOne)" quand Phantom connecté + endpoint /api/invested?pub=
cat >"$FRONT_DIR/patches/wolv_invested.js" <<'"'"'JS'"'"'
(()=>{"use strict";
const $=s=>document.querySelector(s),sleep=ms=>new Promise(r=>setTimeout(r,ms));
function fmt(n,d){n=Number(n||0);if(!isFinite(n))n=0;return n.toFixed(d);}
function ensureBox(){
  if($("#wolvInvestBox")) return;
  const host=($("#top")||document.body);
  const box=document.createElement("div");
  box.id="wolvInvestBox";
  box.style.marginTop="8px";
  box.style.padding="8px";
  box.style.border="1px solid #bbb";
  box.style.borderRadius="8px";
  box.style.maxWidth="980px";
  box.innerHTML='<div style="font-weight:700;margin-bottom:6px">Investi (TraderOne)</div><div id="wolvInvestLine" style="font-size:13px">Connecte Phantom...</div>';
  host.appendChild(box);
}
async function getPub(){
  if(!window.solana||!window.solana.isPhantom) return "";
  if(window.solana.publicKey) return window.solana.publicKey.toBase58();
  try{const r=await window.solana.connect({onlyIfTrusted:true});return (r&&r.publicKey)?r.publicKey.toBase58():"";}catch(_){return "";}
}
async function refresh(pub){
  const line=$("#wolvInvestLine"); if(!line) return;
  try{
    const r=await fetch("/api/invested?pub="+encodeURIComponent(pub),{cache:"no-store"});
    const t=await r.text();
    let j=null; try{j=JSON.parse(t);}catch(_){j={raw:t};}
    if(!r.ok) throw new Error((j&&j.error)||t||("HTTP "+r.status));
    const sol=fmt(j.sol,6), usdc=fmt(j.usdc,2);
    const upd=j.updated?(" • "+j.updated):"";
    line.textContent="SOL: "+sol+" | USDC: "+usdc+upd;
  }catch(e){
    line.textContent="ERR: "+(e&&e.message?e.message:String(e));
  }
}
async function loop(){
  ensureBox();
  let last="";
  for(;;){
    const pub=await getPub();
    if(pub && pub!==last){ last=pub; await refresh(pub); }
    if(pub && Math.random()<0.2) await refresh(pub);
    await sleep(3000);
  }
}
document.addEventListener("DOMContentLoaded",()=>{ensureBox();loop();});
})();
JS


cat >/root/diag_wolverine_502.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
PORT="${PORT:-3001}"
DOMAIN="${1:-fireinners.online}"

echo "== systemd =="
systemctl --no-pager status wolverine-next | sed -n '1,25p' || true
echo

echo "== listen port $PORT =="
ss -lntp | grep ":$PORT" || echo "[ERR] rien n'écoute sur $PORT"
echo

echo "== curl upstream direct =="
curl -sSI "http://127.0.0.1:$PORT/" | head -n 20 || echo "[ERR] curl upstream KO"
echo

echo "== nginx errors (recent) =="
tail -n 80 /var/log/nginx/error.log | tail -n 40 || true
echo

echo "== curl via nginx local (bypass cloudflare) =="
curl -k -sSI "https://127.0.0.1/wolverine/" -H "Host: $DOMAIN" | head -n 20 || true
BASH
chmod +x /root/diag_wolverine_502.sh
/root/diag_wolverine_502.sh fireinners.online
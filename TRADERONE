set -euo pipefail

NG="/etc/nginx/sites-enabled/fireinners.online-ssl"
[ -f "$NG" ] || { echo "KO: $NG introuvable"; exit 1; }

echo "=== 0) Backup ==="
cp -a "$NG" "$NG.bak.$(date +%s)"

echo "=== 1) Voir où est le check X-API-KEY actuellement ==="
grep -nE 'http_x_api_key|X-API-KEY|return 403' "$NG" || true
echo

echo "=== 2) Commenter le check global (si présent) pour débloquer l’UI ==="
# commente toute ligne qui mentionne http_x_api_key (ça évite que /wolverine prenne 403)
sed -i 's/^[[:space:]]*\(.*http_x_api_key.*\)$/# \1/g' "$NG"

echo "=== 3) Injecter les locations Wolverine (UI + API avec clé) si absentes ==="
python3 - <<'PY'
from pathlib import Path
import re, time

ng = Path("/etc/nginx/sites-enabled/fireinners.online-ssl")
s = ng.read_text()

marker = "# --- WOLVERINE_BLOCK_V1 ---"
if marker in s:
    print("OK: bloc déjà présent, skip")
else:
    # insérer avant la dernière "}" du fichier (ok si 1 server block)
    insert = f"""

{marker}

# /wolverine (UI)
location = /wolverine {{
  return 301 /wolverine/;
}}

location ^~ /wolverine/ {{
  root /var/www;
  index index.html;
  try_files $uri $uri/ /wolverine/index.html;
}}

# /wolverine/traderone/api (API -> Node /api) + clé OBLIGATOIRE
location ^~ /wolverine/traderone/api/ {{
  # ---- API KEY (seulement ici) ----
  if ($http_x_api_key = "") {{ return 403; }}
  # Remplace la valeur ci-dessous par TA clé si tu veux la hardcode côté nginx
  # if ($http_x_api_key != "YOUR_KEY_HERE") {{ return 403; }}

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;

  proxy_pass http://127.0.0.1:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}}
"""
    # insert before last closing brace
    idx = s.rfind("}")
    if idx == -1:
        raise SystemExit("KO: pas de '}' trouvé dans le fichier nginx")
    s2 = s[:idx] + insert + "\n" + s[idx:]
    ng.write_text(s2)
    print("OK: bloc Wolverine injecté")
PY

echo "=== 4) Test + reload nginx ==="
nginx -t
systemctl reload nginx
echo "OK: nginx reloaded"
echo

echo "=== 5) Tests ==="
echo "--- UI (/wolverine/) ---"
curl -sS -i https://fireinners.online/wolverine/ | head -n 20 || true
echo
echo "--- API sans clé (doit 403) ---"
curl -sS -i https://fireinners.online/wolverine/traderone/api/health | head -n 20 || true
echo
echo "--- API avec clé (doit 200) ---"
KEY=$(grep -oP 'http_x_api_key != "\K[^"]+' /etc/nginx/sites-enabled/fireinners.online-ssl 2>/dev/null | head -n1 || true)
[ -n "${KEY:-}" ] && curl -sS -i https://fireinners.online/wolverine/traderone/api/dexes -H "X-API-KEY: $KEY" | head -n 25 || echo "INFO: clé hardcodée non trouvée dans nginx (mets-la dans le bloc)."
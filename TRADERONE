cat >/tmp/WOLV_FIX_API_PATHS.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
IDX="/opt/fireinners/frontend-react/app/dist/wolverine/index.html"
[ -f "$IDX" ] || { echo "ERREUR: $IDX introuvable"; exit 1; }

cp -a "$IDX" "$IDX.bak.$(date +%s)"

# Remplace les appels API "nus" par ceux derrière /wolverine/traderone/
perl -0777 -pi -e '
s#fetch\(\s*"/api/#fetch("/wolverine/traderone/api/#g;
s#fetch\(\s*'\''/api/#fetch('\''/wolverine/traderone/api/#g;
s#fetch\(\s*"/health"#fetch("/wolverine/traderone/health"#g;
s#fetch\(\s*'\''/health#fetch('\''/wolverine/traderone/health#g;
' "$IDX"

nginx -t && systemctl reload nginx

echo "OK. Tests:"
curl -ksS --max-time 6 https://fireinners.online/wolverine/ | head -c 120; echo
curl -ksS --max-time 6 https://fireinners.online/wolverine/traderone/api/status | head -c 200; echo
SH

bash /tmp/WOLV_FIX_API_PATHS.sh
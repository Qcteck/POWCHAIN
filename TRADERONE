set -euo pipefail
echo "=== BATCH FLY / PORTS WORLD-OPEN ==="

echo
echo "[LISTEN sockets]"
ss -lntp | sed -n '1,140p' || true

echo
echo "[UFW rules]"
ufw status || true

echo
echo "[WORLD OPEN? (expected: 3000/8484/8585 currently allowed)]"
ufw status | egrep -n "3000|8484|8585" || echo "No explicit rules found for 3000/8484/8585"

echo
echo "[LOCAL CHECK]"
for p in 3000 8484 8585; do
  code="$(curl -sS --max-time 2 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$p/" 2>/dev/null || echo 000)"
  echo "127.0.0.1:$p -> $code"
done

echo "=== END ==="
cat >/tmp/DISABLE_RESTART_TRADERONE_PARASITE.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
export SYSTEMD_PAGER=cat
export PAGER=cat

echo "== 1) Stop/disable the parasite service/timer if present =="
systemctl stop restart-traderone.timer restart-traderone.service 2>/dev/null || true
systemctl disable restart-traderone.timer restart-traderone.service 2>/dev/null || true

echo "== 2) Mask it (prevents ANY start, even manual/dep) =="
systemctl mask restart-traderone.service 2>/dev/null || true
systemctl mask restart-traderone.timer 2>/dev/null || true

echo "== 3) Remove wants symlink if still there =="
rm -f /etc/systemd/system/multi-user.target.wants/restart-traderone.service 2>/dev/null || true

echo "== 4) Reload systemd =="
systemctl daemon-reload

echo "== 5) Proof: it must show masked/disabled =="
systemctl status restart-traderone.service --no-pager || true
systemctl list-timers --all | grep -i restart-traderone || true

echo "== 6) Keep ONLY the good service running =="
systemctl restart traderone.service
systemctl status traderone.service --no-pager

echo "== 7) Health checks =="
curl -sS  -o /dev/null -w "LOCAL  http_code=%{http_code}\n" http://127.0.0.1:8585/api/health || true
curl -ksS -o /dev/null -w "NGINX  http_code=%{http_code}\n" https://fireinners.online/wolverine/traderone/api/health || true
SH

bash /tmp/DISABLE_RESTART_TRADERONE_PARASITE.sh
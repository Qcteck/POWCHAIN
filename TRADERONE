bash --noprofile --norc -lc 'set -euo pipefail;TS="$(date -u +%Y%m%d-%H%M%S)";LOG="/root/vps_menage_${TS}.log";Q="/opt/_quarantine_vps_${TS}";mkdir -p "$Q/baks" "$Q/mixed";say(){ echo "[$(date -u +%F\ %T)] $*"|tee -a "$LOG"; };say "MEGA VPS MENAGE NO-GIT TS=$TS";say "Quarantine: $Q";say "Before disk:";df -hT|tee -a "$LOG";say "1) apt cache clean (safe)";if command -v apt-get>/dev/null 2>&1;then apt-get -y clean>>"$LOG" 2>&1||true;apt-get -y autoclean>>"$LOG" 2>&1||true;else say "apt-get not found, skip";fi;say "2) journald vacuum (safe)";if command -v journalctl>/dev/null 2>&1;then journalctl --vacuum-time=14d>>"$LOG" 2>&1||true;else say "journalctl not found, skip";fi;say "3) Fix /root/.profile cargo spam (safe)";if [ -f /root/.profile ] && grep -q "/root/.cargo/env" /root/.profile;then cp -a /root/.profile "$Q/root.profile.backup_${TS}"||true;grep -v "/root/.cargo/env" /root/.profile > /root/.profile.tmp || true;printf "\n[ -f /root/.cargo/env ] && . /root/.cargo/env\n" >> /root/.profile.tmp;mv /root/.profile.tmp /root/.profile;say "Updated /root/.profile (backup: $Q/root.profile.backup_${TS})";else say "No cargo env line to fix";fi;TARGETS="/opt/fireinners/frontend-react/app/dist/wolverine /opt/fireinners/frontend-react/app/dist /opt/fireinners /opt/traderone-opt /TRADERONE /root";move_bak(){ f="$1";rel="${f#/}";dest="$Q/baks/$rel";mkdir -p "$(dirname "$dest")";mv -n "$f" "$dest" 2>>"$LOG"||true; };move_mix(){ f="$1";rel="${f#/}";dest="$Q/mixed/$rel";mkdir -p "$(dirname "$dest")";mv -n "$f" "$dest" 2>>"$LOG"||true; };say "4) Quarantine backups (*.bak*, *.old, *~)";for base in $TARGETS;do [ -d "$base" ]||continue;find "$base" -type f \( -name "*.bak" -o -name "*.bak*" -o -name "*.bakfix*" -o -name "*~" -o -name "*.old" \) 2>/dev/null | while IFS= read -r f;do case "$f" in /opt/fireinners/sentinel/*|/opt/fireinners/CHARTE_FIREINNERS.*) continue;; esac;move_bak "$f";done;done;say "5) Quarantine fichiers suspects (HTML + bash markers)";for base in $TARGETS;do [ -d "$base" ]||continue;find "$base" -type f \( -name "*.html" -o -name "*.html.*" -o -name "*.bakfix*" \) 2>/dev/null | while IFS= read -r f;do grep -aEq "(set -euo pipefail|apt-get|journalctl|#!/usr/bin/env bash|^#!/bin/bash|git checkout|git push|find /|mv -n)" "$f" 2>/dev/null && { case "$f" in /opt/fireinners/sentinel/*|/opt/fireinners/CHARTE_FIREINNERS.*) continue;; esac;move_mix "$f"; };done;done;say "After disk:";df -hT|tee -a "$LOG";say "Quarantine size:";du -sh "$Q" 2>/dev/null|tee -a "$LOG"||true;say "DONE";say "Log: $LOG";say "Quarantine: $Q";echo "$LOG"'
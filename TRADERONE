bash -c "$(cat <<'BASH'
set -e

DIR=/opt/wolverine-balances
PORT=3010

echo '[1] Clean'
pkill -f wolverine-balances || true
rm -rf $DIR
mkdir -p $DIR
cd $DIR

echo '[2] package.json'
cat > package.json <<'JSON'
{
  "name": "wolverine-balances",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "express": "^4.19.2",
    "@solana/web3.js": "^1.98.0"
  }
}
JSON

echo '[3] server.js'
cat > server.js <<'JS'
import express from "express";
import { Connection, PublicKey } from "@solana/web3.js";

const app = express();
const RPC = "https://api.mainnet-beta.solana.com";
const USDC_MINT = new PublicKey("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1");
const conn = new Connection(RPC, "confirmed");

app.get("/balances/:addr", async (req, res) => {
  try {
    const addr = req.params.addr.replace(/[^1-9A-HJ-NP-Za-km-z]/g, "");
    const pub = new PublicKey(addr);

    const sol = (await conn.getBalance(pub)) / 1e9;

    const tokens = await conn.getParsedTokenAccountsByOwner(pub, { mint: USDC_MINT });
    let usdc = 0;
    for (const t of tokens.value) {
      usdc += Number(t.account.data.parsed.info.tokenAmount.uiAmount || 0);
    }

    res.json({ sol, usdc });
  } catch (e) {
    res.status(400).json({ error: e.message });
  }
});

app.listen(3010, "127.0.0.1", () => {
  console.log("BALANCES API RUNNING ON 3010");
});
JS

echo '[4] Install deps'
npm install --silent

echo '[5] Start server'
nohup node server.js > server.log 2>&1 &

sleep 2

echo '[6] Check port'
ss -lnt | grep ":3010" && echo "✅ API IS RUNNING" || (echo "❌ API NOT RUNNING" && exit 1)
BASH
)"
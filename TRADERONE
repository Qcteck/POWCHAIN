<script>
(() => {
  const $ = s => document.querySelector(s);
  const log = $("#log");
  const st = $("#st");

  const api = (p) => `/wolverine/traderone/api${p}`;
  const wolverinePing = `/wolverine/api/ping`;

  function write(line){
    log.textContent = (new Date().toISOString()+"  "+line+"\n"+log.textContent).slice(0,8000);
  }
  function setStatus(ok){ st.textContent = ok ? "UP" : "DOWN"; st.style.color = ok ? "#b9ffcf" : "#ffb3b3"; }

  async function req(url){
    try{
      const r = await fetch(url,{cache:"no-store"});
      const t = await r.text();
      write(`${r.status} ${url} :: ${t.slice(0,240)}`);
      setStatus(r.ok);
    }catch(e){
      write(`ERR ${url} :: ${String(e).slice(0,240)}`);
      setStatus(false);
    }
  }

  $("#bHealth").onclick = () => req(api("/health"));
  $("#bInfo").onclick   = () => req(api("/info"));
  $("#bTrades").onclick = () => req(api("/trades"));
  $("#bPingW").onclick  = () => req(wolverinePing);

  // auto-check
  req(api("/health"));
})();

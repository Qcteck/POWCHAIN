cat >/root/fix_location_not_allowed_wolverine.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

HOST="fireinners.online"
VHOST="/etc/nginx/sites-enabled/${HOST}-ssl"
SNIP="/etc/nginx/snippets/wolverine_routes.conf"
TS="$(date +%Y%m%d_%H%M%S)"

test -f "$VHOST" || { echo "Missing $VHOST"; exit 1; }

echo "== 1) Backup =="
cp -a "$VHOST" "$VHOST.bak_$TS"

echo "== 2) Write snippet with wolverine routes =="
cat > "$SNIP" <<'NGX'
# ---- Wolverine routes (included inside server {}) ----

# UI under /wolverine/
location ^~ /wolverine/ {
  alias /var/www/wolverine/;
  try_files $uri $uri/ /wolverine/index.html;
}

# Traderone API under /wolverine/traderone/api/
location = /wolverine/traderone/api {
  return 301 /wolverine/traderone/api/;
}

location ^~ /wolverine/traderone/api/ {
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  rewrite ^/wolverine/traderone/api/(.*)$ /api/$1 break;
  proxy_pass http://127.0.0.1:8585;
}
NGX

echo "== 3) Patch vhost: ensure include is INSIDE server{} and comment any trailing location blocks outside =="
python3 - <<PY
import re
VHOST="${VHOST}"
SNIP="${SNIP}"
lines=open(VHOST,"r",errors="ignore").read().splitlines(True)

# find first "server {" and its matching closing brace
start=None
for i,l in enumerate(lines):
    if re.search(r'^\s*server\s*\{', l):
        start=i; break
if start is None:
    raise SystemExit("No server { found in vhost")

depth=0
end=None
for i in range(start, len(lines)):
    depth += lines[i].count("{")
    depth -= lines[i].count("}")
    if depth==0 and i>start:
        end=i
        break
if end is None:
    raise SystemExit("Could not find end of server block (brace mismatch)")

server_block = lines[:end+1]
trailing = lines[end+1:]

# ensure include inside server block (before its final "}")
inc_line = f"  include {SNIP};\n"
if not any(SNIP in l for l in server_block):
    # insert right before end brace
    server_block.insert(len(server_block)-1, inc_line)

# comment out any 'location' directives that are trailing (outside server)
new_trailing=[]
for l in trailing:
    if re.search(r'^\s*location\b', l) or '/wolverine/' in l:
        new_trailing.append("# DISABLED_OUTSIDE_SERVER " + l)
    else:
        new_trailing.append(l)

open(VHOST,"w").writelines(server_block + new_trailing)
PY

echo "== 4) nginx -t && reload =="
nginx -t
systemctl reload nginx || service nginx reload

echo "== 5) Quick tests =="
curl -sk -o /dev/null -w "UI /wolverine/ : %{http_code}\n" https://fireinners.online/wolverine/
curl -sk -o /dev/null -w "Traderone health : %{http_code}\n" https://fireinners.online/wolverine/traderone/api/health
echo "DONE ✅"
BASH

chmod +x /root/fix_location_not_allowed_wolverine.sh
/root/fix_location_not_allowed_wolverine.sh
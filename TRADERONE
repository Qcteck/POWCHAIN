set -euo pipefail

echo "=== 1) ERREUR COMPLETE (fichier + ligne) ==="
nginx -t 2>&1 | cat

echo
echo "=== 2) LES 2 (ou +) DEFINITIONS DANS LA CONFIG CHARGEE ==="
nginx -T 2>/dev/null | grep -nE 'location\s+(\^~|~\*?|=)?\s*/wolverine/traderone/api/?' || true

echo
echo "=== 3) SUR DISQUE: QUELS FICHIERS CONTIENNENT CETTE LOCATION ==="
grep -RIn --include="*.conf" -E 'location\s+(\^~|~\*?|=)?\s*/wolverine/traderone/api/?' /etc/nginx || true
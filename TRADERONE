set -e
cd /opt/traderone-opt

echo "=== 1) Ports (tout ce qui écoute) ==="
ss -ltnp || true
echo

echo "=== 2) PM2 état ==="
pm2 ls || true
echo

echo "=== 3) Si PM2 n'a rien -> resurrect (si dump existe) ==="
pm2 resurrect || true
sleep 1
pm2 ls || true
echo

echo "=== 4) S'il n'y a toujours rien -> (re)start server.js sous PM2 ==="
if ! pm2 ls | grep -q "online"; then
  echo "PM2 vide -> start server.js"
  pm2 start /opt/traderone-opt/server.js --name traderone --update-env
fi

echo "=== 5) Vérif 3000 + tests ==="
sleep 1
ss -ltnp | grep ':3000' || echo "KO: 3000 toujours pas en écoute"
echo
curl -sS -i http://127.0.0.1:3000/health | head -n 12 || true
echo
curl -sS http://127.0.0.1:3000/api/dexes | head -c 400; echo
echo "=== DONE ==="
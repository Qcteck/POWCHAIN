<div id="top">
  <div>📡 CryptoNews POD OF WHEELS — RADIO AUTONOME</div>
  <div>
    <button onclick="toggleLang()">FR / EN</button>
    <button onclick="generateAIArticle()">🧠 Analyse IA Marchés</button>

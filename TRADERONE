cat >/tmp/wolfchain_fly_stats.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
VHOST="/etc/nginx/sites-available/fireinners.online-ssl"
echo "== TIME =="; date -u; echo
echo "== HOST =="; hostnamectl 2>/dev/null || true; echo
echo "== NGINX TEST =="; nginx -t || true; echo
echo "== VHOST ROOT DETECT ==";
ROOT="$(awk 'BEGIN{r=""} $1=="root"{gsub(/;/,"",$2); if(r=="") r=$2} END{print r}' "$VHOST" 2>/dev/null | head -n1)"
[ -n "${ROOT:-}" ] || ROOT="/opt/fireinners/frontend-react/app/dist"
echo "VHOST=$VHOST"
echo "ROOT=$ROOT"
ls -la "$ROOT" 2>/dev/null | sed -n '1,12p' || true
echo
echo "== LISTEN PORTS (3000/4001/8484) ==";
ss -lntp 2>/dev/null | egrep ':(3000|4001|8484)\b' || true
echo
echo "== SYSTEMD CANDIDATES ==";
systemctl list-units --type=service --all 2>/dev/null | egrep -i 'fire|inner|wolf|chain|amcq|qplus|node|wss|ws' | sed -n '1,80p' || true
echo
echo "== CURL BACKEND DIRECT (127.0.0.1:3000) ==";
for p in /stats /status /health /; do
  echo "-- GET http://127.0.0.1:3000$p"
  curl -sS -i "http://127.0.0.1:3000$p" | sed -n '1,12p' || true
  echo
done
echo "== CURL THROUGH NGINX (Host header) ==";
for p in /stats /stats_static / /dex/ /wallet/ /wolverine/; do
  echo "-- GET https://127.0.0.1$p (Host: fireinners.online)"
  curl -k -sS -i "https://127.0.0.1$p" -H "Host: fireinners.online" | sed -n '1,12p' || true
  echo
done
echo "== NGINX ERRORS (tail) ==";
tail -n 40 /var/log/nginx/error.log 2>/dev/null || true
echo
echo "== DONE (read-only) =="
SH
bash /tmp/wolfchain_fly_stats.sh